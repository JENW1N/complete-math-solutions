  rw [primePatternWeight_empty]
  calc
    _ ≤ ∏ p ∈ P, exp (-(1 / (p : ℝ))) := by
      apply Finset.prod_le_prod
      · intro p hp
        have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (hP p hp).one_le
        have hp0 : (0 : ℝ) < p := by exact_mod_cast (hP p hp).pos
        exact sub_nonneg.mpr ((div_le_one hp0).mpr hp1)
      · intro p _
        have h := Real.add_one_le_exp (-(1 / (p : ℝ)))
        linarith
    _ = _ := by rw [← exp_sum, sum_neg_distrib]

noncomputable def primeBandHitWeight (P : Finset ℕ) : ℝ :=
  ∑ T ∈ P.powerset with T.Nonempty, primePatternWeight P T

theorem primeBandHitWeight_eq (P : Finset ℕ) :
    primeBandHitWeight P = 1 - primePatternWeight P ∅ := by
  classical
  have hfilter : P.powerset.filter (fun T ↦ T.Nonempty) = P.powerset.erase ∅ := by
    ext T
    simp [Finset.nonempty_iff_ne_empty, and_comm]
  unfold primeBandHitWeight
  rw [hfilter]
  have h := sum_erase_add P.powerset (primePatternWeight P)
    (mem_powerset.mpr (empty_subset P))
  rw [sum_primePatternWeight] at h
  linarith

theorem primeBandHitWeight_lower {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {m : ℝ}
    (hmass : m ≤ ∑ p ∈ P, 1 / (p : ℝ)) :
    1 - exp (-m) ≤ primeBandHitWeight P := by
  rw [primeBandHitWeight_eq]
  have h := primePatternWeight_empty_le_exp hP
  have hexp : exp (-(∑ p ∈ P, 1 / (p : ℝ))) ≤ exp (-m) :=
    exp_le_exp.mpr (neg_le_neg hmass)
  linarith

end Erdos859Verification

