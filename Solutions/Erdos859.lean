    (hP : ∀ q ∈ P, q.Prime) {p : ℕ} (hpP : p ∈ P)
    (hSprefix : S ⊆ fordPrimePrefix P p) {y : ℝ} (hy : 0 < y)
    (hw : FordStoppingWitness y p S) :
    fordStoppingLogThreshold y S ≤ log (p : ℝ) := by
