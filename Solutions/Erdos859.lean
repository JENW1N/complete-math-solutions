/-- Natural densities are subadditive under a finite cover, even when the
covering sets overlap. -/
theorem density_le_sum_of_finite_cover {A : Set ℕ} {d : ℝ}
    {I : Finset ℕ} {B : ℕ → Set ℕ} {e : ℕ → ℝ}
    (hA : A.HasDensity d) (hB : ∀ j ∈ I, (B j).HasDensity (e j))
    (hcover : ∀ n ∈ A, ∃ j ∈ I, n ∈ B j) :
    d ≤ ∑ j ∈ I, e j := by
  classical
  have hsum := tendsto_finsetSum I hB
  apply le_of_tendsto_of_tendsto' hA hsum
  intro N
  rw [partialDensity_eq_indicator_mean]
  simp_rw [partialDensity_eq_indicator_mean, ← sum_div]
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg N)
  rw [sum_comm]
  apply sum_le_sum
  intro n _
  have hnonneg (j : ℕ) : 0 ≤ (B j).indicator (fun _ ↦ (1 : ℝ)) n := by
    by_cases hn : n ∈ B j <;> simp [hn]
  by_cases hn : n ∈ A
  · obtain ⟨j, hj, hnj⟩ := hcover n hn
    rw [Set.indicator_of_mem hn]
    calc
      (1 : ℝ) = (B j).indicator (fun _ ↦ (1 : ℝ)) n := by
        rw [Set.indicator_of_mem hnj]
      _ ≤ ∑ j ∈ I, (B j).indicator (fun _ ↦ (1 : ℝ)) n :=
        single_le_sum (fun i _ ↦ hnonneg i) hj
  · rw [Set.indicator_of_notMem hn]
    exact sum_nonneg (fun j _ ↦ hnonneg j)

/-- A divisor between the endpoints of a finite chain crosses some consecutive
pair of endpoints.  No monotonicity assumption is needed in this direction. -/
theorem divisorIntervalSet_chain_cover (a : ℕ → ℕ) (J : ℕ) :
    ∀ n ∈ DivisorIntervalSet (a J) (a 0),
      ∃ j ∈ range J, n ∈ DivisorIntervalSet (a (j + 1)) (a j) := by
  induction J with
  | zero =>
    rintro n ⟨d, hlo, hhi, _⟩
    exact False.elim (not_lt_of_ge hhi hlo)
  | succ J ih =>
    rintro n ⟨d, hlo, hhi, hd⟩
    by_cases hm : a J < d
    · obtain ⟨j, hj, hnj⟩ := ih n ⟨d, hm, hhi, hd⟩
      exact ⟨j, mem_range.mpr (lt_trans (mem_range.mp hj) (Nat.lt_succ_self J)), hnj⟩
    · exact ⟨J, mem_range.mpr (Nat.lt_succ_self J), d, hlo, le_of_not_gt hm, hd⟩

theorem divisorIntervalDensity_le_sum_chain (a : ℕ → ℕ) (J : ℕ) :
    divisorIntervalDensity (a J) (a 0) ≤
      ∑ j ∈ range J, divisorIntervalDensity (a (j + 1)) (a j) :=
  density_le_sum_of_finite_cover (divisorInterval_hasDensity _ _)
    (fun _ _ ↦ divisorInterval_hasDensity _ _) (divisorIntervalSet_chain_cover a J)

/-- Exact integer division gives the half-open dyadic cover, including all
rounding at the endpoints. -/
theorem divisorIntervalDensity_le_sum_dyadic (t J : ℕ) :
