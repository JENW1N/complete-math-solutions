        (∏ i, primeLogOddsIntensity lam (x i).val /
          (∑ p ∈ P, primeLogOddsIntensity lam p)) * (if Good (tupleSupport x) then 1 else 0)) =
      ∑ x ∈ univ.filter (fun x : Fin n → P ↦ Function.Injective x ∧ Good (tupleSupport x)),
