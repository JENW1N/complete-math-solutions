          sum_le_sum (fun p hp ↦ hatom p (mem_filter.mp hp).1)
        _ = alpha * ((P.filter (fun p ↦ p ∣ m)).card : ℝ) := by simp [mul_comm]
        _ ≤ _ := mul_le_mul_of_nonneg_left
          (card_large_prime_divisors_le (hD m hm).1 hv hP hlog) halpha
    _ ≤ ∑ _m ∈ D, alpha * (log (T : ℝ) / v) := by
      apply sum_le_sum
      intro m hm
      apply mul_le_mul_of_nonneg_left _ halpha
      exact div_le_div_of_nonneg_right
        (log_le_log (by exact_mod_cast (hD m hm).1)
          (by exact_mod_cast (hD m hm).2)) hv.le
    _ = _ := by simp; ring

