def powerfulPartNumber (H : Finset ℕ) (a : ℕ → ℕ) : ℕ := ∏ p ∈ H, p ^ a p

noncomputable def fixedPowerfulCappedMass (P H : Finset ℕ) (cap a : ℕ → ℕ) : ℝ :=
