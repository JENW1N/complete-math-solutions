    simp only [sum_filter, w, finiteProductWeight, mul_ite, mul_one, mul_zero, ite_and]
  rw [ht] at hc
  have hcoeff : 0 ≤ exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
      (∑ p ∈ P, primeLogOddsIntensity lam p) ^ n / (n.factorial : ℝ) := by positivity
  have h := (mul_le_mul_of_nonneg_left hg hcoeff).trans hc
  simpa only [sum_filter, mul_ite, mul_one, mul_zero, ite_and] using h

