def signedCoordinateFlip {ι : Type*} [DecidableEq ι] (i : ι) (c : ι → ℤ) : ι → ℤ :=
  fun j ↦ if j = i then -c j else c j

theorem signedCoordinateFlip_involutive {ι : Type*} [DecidableEq ι] (i : ι) :
    Function.Involutive (signedCoordinateFlip i) := by
  intro c
  funext j
  by_cases h : j = i <;> simp [signedCoordinateFlip, h]

theorem signedCoordinateFlip_mem {ι : Type*} [Fintype ι] [DecidableEq ι]
    (i : ι) {H : ℕ} {c : ι → ℤ} (hc : c ∈ signedCoefficientBox ι H) :
    signedCoordinateFlip i c ∈ signedCoefficientBox ι H := by
  apply mem_signedCoefficientBox.mpr
  intro j
  have hj := mem_signedCoefficientBox.mp hc j
  by_cases h : j = i <;> simpa [signedCoordinateFlip, h] using hj

theorem signedCoefficientBox_sum_flip {ι : Type*} [Fintype ι] [DecidableEq ι]
    (H : ℕ) (i : ι) (F : (ι → ℤ) → ℝ) :
    (∑ c ∈ signedCoefficientBox ι H, F (signedCoordinateFlip i c)) =
      ∑ c ∈ signedCoefficientBox ι H, F c :=
  sum_nbij' (signedCoordinateFlip i) (signedCoordinateFlip i)
    (fun _ hc ↦ signedCoordinateFlip_mem i hc) (fun _ hc ↦ signedCoordinateFlip_mem i hc)
    (fun c _ ↦ signedCoordinateFlip_involutive i c)
    (fun c _ ↦ signedCoordinateFlip_involutive i c) (fun _ _ ↦ rfl)

theorem signedCoefficientBox_coordinate_sum_zero {ι : Type*} [Fintype ι]
    (H : ℕ) (i : ι) :
    (∑ c ∈ signedCoefficientBox ι H, (c i : ℝ)) = 0 := by
  classical
  have h := signedCoefficientBox_sum_flip H i (fun c ↦ (c i : ℝ))
  simp [signedCoordinateFlip] at h
  linarith

theorem signedCoefficientBox_crossMoment_zero {ι : Type*} [Fintype ι]
    (H : ℕ) {i j : ι} (hij : i ≠ j) :
    (∑ c ∈ signedCoefficientBox ι H, (c i : ℝ) * (c j : ℝ)) = 0 := by
  classical
  have h := signedCoefficientBox_sum_flip H i (fun c ↦ (c i : ℝ) * (c j : ℝ))
  simp [signedCoordinateFlip, hij.symm] at h
  linarith

theorem signedCoefficientBox_linear_sum_zero {ι : Type*} [Fintype ι]
    (H : ℕ) (t : ι → ℝ) :
    (∑ c ∈ signedCoefficientBox ι H, ∑ i, (c i : ℝ) * t i) = 0 := by
  rw [sum_comm]
  simp_rw [← sum_mul, signedCoefficientBox_coordinate_sum_zero, zero_mul]
  exact sum_const_zero

/-- All mixed terms cancel exactly; no properness condition is needed. -/
theorem signedCoefficientBox_secondMoment_diagonal {ι : Type*} [Fintype ι]
    (H : ℕ) (t : ι → ℝ) :
    (∑ c ∈ signedCoefficientBox ι H, (∑ i, (c i : ℝ) * t i) ^ 2) =
      ∑ i, (∑ c ∈ signedCoefficientBox ι H, (c i : ℝ) ^ 2) * t i ^ 2 := by
  classical
  calc
    _ = ∑ c ∈ signedCoefficientBox ι H,
        ∑ i, ∑ j, ((c i : ℝ) * (c j : ℝ)) * (t i * t j) := by
      apply sum_congr rfl
      intro c _
      rw [sq, sum_mul_sum]
      apply sum_congr rfl
      intro i _
      apply sum_congr rfl
      intro j _
      ring
    _ = ∑ i, ∑ j, (∑ c ∈ signedCoefficientBox ι H,
        (c i : ℝ) * (c j : ℝ)) * (t i * t j) := by
      rw [sum_comm]
      apply sum_congr rfl
      intro i _
      rw [sum_comm]
      simp only [sum_mul]
    _ = _ := by
      apply sum_congr rfl
      intro i _
      rw [sum_eq_single i]
      · simp only [sq]
      · intro j _ hji
        rw [signedCoefficientBox_crossMoment_zero H hji.symm, zero_mul]
      · simp

theorem signedCoefficientBox_coordinate_square_sum_le {ι : Type*} [Fintype ι]
    (H : ℕ) (i : ι) :
    (∑ c ∈ signedCoefficientBox ι H, (c i : ℝ) ^ 2) ≤
      (((2 * H + 1) ^ Fintype.card ι : ℕ) : ℝ) * (H : ℝ) ^ 2 := by
