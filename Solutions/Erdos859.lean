      (∑ p ∈ P, primeLogOddsIntensity lam p) ^ n / (n.factorial : ℝ) *
        (1 - beta - (n : ℝ) ^ 2 * alpha) ≤
      ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n ∧ Good T), primeTiltWeight P lam T := by
  classical
  let w : P → ℝ := fun p ↦ primeLogOddsIntensity lam p.val /
    ∑ q ∈ P, primeLogOddsIntensity lam q
  have hw (p : P) : 0 ≤ w p :=
    div_nonneg (primeLogOddsIntensity_le_odds hlam (hP p.val p.property)).1 hM.le
  have hnorm : ∑ p, w p = 1 := by
    simp only [w, ← sum_div, Finset.sum_coe_sort]
    exact div_self hM.ne'
  have hg := finite_iid_injective_good_probability_lower n w
    (fun x ↦ Good (tupleSupport x)) halpha hw hnorm
    (fun p ↦ hatom p.val p.property) hbad
  have hc := primeTilt_count_lower_from_intensity_marks hP hlam n
    (fun T ↦ if Good T then 1 else 0) (fun T _ ↦ by split_ifs <;> norm_num) hM
