        rw [filter_insert, if_neg (not_lt.mpr (hmax q hq).le)]
      rw [sum_powerset_insert hp, ih, sum_insert hp, hpfilter]
      have heq : (∑ q ∈ P, ∑ R ∈ ((insert p P).filter (fun r ↦ r < q)).powerset,
          f (insert q R)) =
          ∑ q ∈ P, ∑ R ∈ (P.filter (fun r ↦ r < q)).powerset, f (insert q R) :=
        sum_congr rfl fun q hq ↦ by rw [hqfilter q hq]
      rw [heq]
