theorem log_ceil_exp_bounds {s : ℝ} (hs : 0 ≤ s) :
    s ≤ log (⌈exp s⌉₊ : ℝ) ∧ log (⌈exp s⌉₊ : ℝ) ≤ s + log 2 := by
  have he := Nat.le_ceil (exp s)
  have hz : (0 : ℝ) < ⌈exp s⌉₊ := (exp_pos s).trans_le he
  refine ⟨(le_log_iff_exp_le hz).mpr he, ?_⟩
  have hexp : 1 ≤ exp s := one_le_exp hs
