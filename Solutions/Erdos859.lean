    {α : Type*} [Fintype α] [DecidableEq α] (n : ℕ) (w : α → ℝ)
    (Good : (Fin n → α) → Prop) [DecidablePred Good]
    {a b : ℝ} (ha : 0 ≤ a) (hw : ∀ y, 0 ≤ w y)
    (hnorm : ∑ y, w y = 1) (hatom : ∀ y, w y ≤ a)
    (hbad : (∑ x : Fin n → α, finiteProductWeight (fun _ ↦ w) x *
      (if Good x then 0 else 1)) ≤ b) :
    1 - b - (n : ℝ) ^ 2 * a ≤
      ∑ x ∈ univ.filter (fun x : Fin n → α ↦ Function.Injective x ∧ Good x),
        finiteProductWeight (fun _ ↦ w) x := by
  classical
  apply finite_good_intersection_lower (finiteProductWeight (fun _ ↦ w))
    Good Function.Injective (finiteProductWeight_nonneg (fun _ ↦ hw))
    (sum_finiteProductWeight _ (fun _ ↦ hnorm)) hbad
  have he (x : Fin n → α) :
      (if Function.Injective x then (0 : ℝ) else 1) =
      (if ∃ i j : Fin n, i ≠ j ∧ x i = x j then 1 else 0) := by
    by_cases hx : Function.Injective x
    · have hnot : ¬ ∃ i j : Fin n, i ≠ j ∧ x i = x j := by
        rintro ⟨i, j, hij, heq⟩
        exact hij (hx heq)
      simp [hx, hnot]
    · obtain ⟨i, j, heq, hij⟩ := Function.not_injective_iff.mp hx
      simp [hx, show ∃ i j : Fin n, i ≠ j ∧ x i = x j from ⟨i, j, hij, heq⟩]
