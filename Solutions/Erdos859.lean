  have hfirst : 0 ≤ ∏ p ∈ H, cappedPrimeValuationWeight p (cap p) (a p) :=
    prod_nonneg (fun p hp ↦ cappedPrimeValuationWeight_nonneg (hP p (hH hp)) _ _)
