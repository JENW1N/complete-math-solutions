    have hb2 : (1 - b) ^ 2 ≤ 2 * (1 + b ^ 2) := by nlinarith [sq_nonneg (b + 1)]
    have hm := mul_le_mul_of_nonneg_left hsq (show (0 : ℝ) ≤ j + 2 by positivity)
    have hm2 := mul_le_mul_of_nonneg_right hb2
