section

/- The occupancy ballot condition as an event of actual finite prime subsets. -/

namespace Erdos859Verification

open Finset Real

noncomputable def primeSubsetBinCount {n : ℕ} (P : Finset ℕ) (bin : P → Fin n)
    (T : Finset ℕ) (j : Fin n) : ℕ := by
  classical
  exact (univ.filter (fun p : P ↦ p.val ∈ T ∧ bin p = j)).card

def primeSubsetBallot {n : ℕ} (P : Finset ℕ) (bin : P → Fin n)
    (T : Finset ℕ) : Prop := CyclicBallot (primeSubsetBinCount P bin T)

theorem primeSubsetBinCount_tupleSupport {n : ℕ} {P : Finset ℕ}
    (bin : P → Fin n) (x : Fin n → P) (hx : Function.Injective x) (j : Fin n) :
    primeSubsetBinCount P bin (tupleSupport x) j = occupancyCount (fun i ↦ bin (x i)) j := by
  classical
  have heq : univ.filter (fun p : P ↦ p.val ∈ tupleSupport x ∧ bin p = j) =
      (univ.filter (fun i : Fin n ↦ bin (x i) = j)).image x := by
    ext p
    constructor
    · intro hp
      obtain ⟨i, _, hi⟩ := mem_image.mp (mem_filter.mp hp).2.1
      have hip : x i = p := Subtype.ext hi
      exact mem_image.mpr ⟨i, mem_filter.mpr ⟨mem_univ i,
        hip.symm ▸ (mem_filter.mp hp).2.2⟩, hip⟩
    · intro hp
      obtain ⟨i, hi, rfl⟩ := mem_image.mp hp
      exact mem_filter.mpr ⟨mem_univ _, mem_image.mpr ⟨i, mem_univ i, rfl⟩,
        (mem_filter.mp hi).2⟩
  unfold primeSubsetBinCount
  rw [heq, card_image_of_injective _ hx]
  simp [occupancyCount]

theorem primeSubsetBallot_tupleSupport_iff {n : ℕ} {P : Finset ℕ}
    (bin : P → Fin n) (x : Fin n → P) (hx : Function.Injective x) :
    primeSubsetBallot P bin (tupleSupport x) ↔
      CyclicBallot (occupancyCount (fun i ↦ bin (x i))) := by
  have heq : primeSubsetBinCount P bin (tupleSupport x) =
      occupancyCount (fun i ↦ bin (x i)) :=
    funext (primeSubsetBinCount_tupleSupport bin x hx)
  simp only [primeSubsetBallot, heq]

theorem finite_good_weight_minus_discarded {α : Type*} [Fintype α]
    (w : α → ℝ) (Good Keep : α → Prop) [DecidablePred Good] [DecidablePred Keep]
    (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ univ.filter Good, w x) - (∑ x ∈ univ.filter (fun x ↦ ¬ Keep x), w x) ≤
      ∑ x ∈ univ.filter (fun x ↦ Keep x ∧ Good x), w x := by
  classical
  rw [sum_filter, sum_filter, sum_filter, ← sum_sub_distrib]
  apply sum_le_sum
  intro x _
  by_cases hg : Good x <;> by_cases hk : Keep x <;> simp [hg, hk, hw x]

theorem finite_iid_unnormalized_duplicate_bound
    {α : Type*} [Fintype α] [DecidableEq α] (n : ℕ) (w : α → ℝ)
    (hw : ∀ x, 0 ≤ w x) {M alpha : ℝ} (hM : 0 < M)
    (hnorm : ∑ x, w x = M) (halpha : 0 ≤ alpha)
    (hatom : ∀ x, w x / M ≤ alpha) :
    (∑ x ∈ univ.filter (fun x : Fin n → α ↦ ¬ Function.Injective x), ∏ i, w (x i)) ≤
      M ^ n * ((n : ℝ) ^ 2 * alpha) := by
  classical
  have hnorm' : ∑ x, w x / M = 1 := by rw [← sum_div, hnorm, div_self hM.ne']
  have hd := finite_iid_duplicate_probability_le n (fun x ↦ w x / M) halpha
    (fun x ↦ div_nonneg (hw x) hM.le) hnorm' hatom
  have he (x : Fin n → α) :
      (∃ i j : Fin n, i ≠ j ∧ x i = x j) ↔ ¬ Function.Injective x := by
    rw [Function.not_injective_iff]
    aesop
  simp_rw [he] at hd
  have hp (x : Fin n → α) : finiteProductWeight (fun (_ : Fin n) y ↦ w y / M) x =
      (∏ i, w (x i)) / M ^ n := by
    rw [finiteProductWeight, prod_div_distrib]
    simp
  simp_rw [hp, mul_ite, mul_one, mul_zero] at hd
  rw [← sum_filter, ← sum_div] at hd
  have h := (div_le_iff₀ (pow_pos hM n)).mp hd
  simpa only [mul_comm] using h

theorem primeTilt_ballot_count_lower {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (bin : P → Fin n) {M L alpha : ℝ}
    (hM : 0 < M) (hMsum : ∑ p ∈ P, primeLogOddsIntensity lam p = M)
    (halpha : 0 ≤ alpha)
    (hatom : ∀ p ∈ P, primeLogOddsIntensity lam p / M ≤ alpha)
    (hballot : L ≤ ∑ x : Fin n → P with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
      ∏ i, primeLogOddsIntensity lam (x i).val) :
    exp (-M) / (n.factorial : ℝ) * (L - M ^ n * ((n : ℝ) ^ 2 * alpha)) ≤
      primeTiltGoodCountMass P lam n (primeSubsetBallot P bin) := by
  classical
  let w : P → ℝ := fun p ↦ primeLogOddsIntensity lam p.val
  have hw (p : P) : 0 ≤ w p := (primeLogOddsIntensity_le_odds hlam (hP p.val p.property)).1
  have hnorm : ∑ p, w p = M := by simpa only [w, Finset.sum_coe_sort] using hMsum
  have hd := finite_iid_unnormalized_duplicate_bound n w hw hM hnorm halpha
    (fun p ↦ hatom p.val p.property)
  have hg := finite_good_weight_minus_discarded (fun x : Fin n → P ↦ ∏ i, w (x i))
    (fun x ↦ CyclicBallot (occupancyCount (fun i ↦ bin (x i)))) Function.Injective
    (fun x ↦ prod_nonneg (fun i _ ↦ hw (x i)))
  have hl : L - M ^ n * ((n : ℝ) ^ 2 * alpha) ≤
      ∑ x ∈ univ.filter (fun x : Fin n → P ↦ Function.Injective x ∧
        CyclicBallot (occupancyCount (fun i ↦ bin (x i)))), ∏ i, w (x i) := by
    exact (sub_le_sub hballot hd).trans hg
  have hcount := primeTilt_count_lower_from_unnormalized_marks hP hlam n
    (primeLogOddsIntensity lam) (fun T ↦ if primeSubsetBallot P bin T then 1 else 0)
    (fun p hp ↦ (primeLogOddsIntensity_le_odds hlam (hP p hp)).1)
    (fun p hp ↦ (primeLogOddsIntensity_le_odds hlam (hP p hp)).2)
    (fun T _ ↦ by split_ifs <;> norm_num)
  rw [hMsum] at hcount
  have ht :
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, primeLogOddsIntensity lam (x i).val) *
          (if primeSubsetBallot P bin (tupleSupport x) then 1 else 0)) =
      ∑ x ∈ univ.filter (fun x : Fin n → P ↦ Function.Injective x ∧
        CyclicBallot (occupancyCount (fun i ↦ bin (x i)))), ∏ i, w (x i) := by
    rw [sum_filter, sum_filter]
    apply sum_congr rfl
    intro x _
    by_cases hx : Function.Injective x
    · simp only [hx, if_true, true_and, primeSubsetBallot_tupleSupport_iff bin x hx,
        mul_ite, mul_one, mul_zero, w]
    · simp only [hx, if_false, false_and]
  rw [ht] at hcount
  have h := (mul_le_mul_of_nonneg_left hl (by positivity : 0 ≤ exp (-M) / (n.factorial : ℝ))).trans hcount
  simpa only [primeTiltGoodCountMass, sum_filter, mul_ite, mul_one, mul_zero, ite_and] using h

