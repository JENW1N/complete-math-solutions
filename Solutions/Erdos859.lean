    [Fintype ι] [DecidableEq ι] [Fintype κ] [LinearOrder κ]
    {α : ι → Type*} [∀ i, Fintype (α i)]
    (band : ι → κ) (w mark : ∀ i, α i → ℝ) (c : κ → ℝ) (h : ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hc : ∀ j, 0 ≤ c j) (hh : 0 ≤ h)
