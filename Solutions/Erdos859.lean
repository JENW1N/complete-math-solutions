/-- The prime-set reverse barrier supplies exactly the coordinate-count
hypotheses of the independent-mark collision bound, including the top band
and the empty family of bands. -/
theorem dyadicCountCoordinate_barrier_conditions {A v : ℝ} {k D : ℕ}
    {T : Finset ℕ} (hA : 0 < A) (hv : 1 < v)
    (hgood : ¬ ReverseCountBarrierFailure k v D (dyadicPrimeTail A k) T) :
    0 < v - 1 ∧
      (∀ j : Fin k, (1 + (v - 1)) * ((k - 1 - j.val : ℕ) : ℝ) - (D : ℝ) ≤
        (((univ : Finset (DyadicCountCoordinate A k T)).filter
          (fun i ↦ j < dyadicCountCoordinateBand i)).card : ℝ)) ∧
      (k : ℝ) - (D : ℝ) ≤ Fintype.card (DyadicCountCoordinate A k T) := by
  have htail (ell : ℕ) (hell : ell < k) :
      v * (ell + 1 : ℕ) - (D : ℝ) < (T ∩ dyadicPrimeTail A k ell).card := by
    apply lt_of_not_ge
    intro h
    exact hgood ⟨ell, Finset.mem_range.mpr hell, h⟩
  refine ⟨sub_pos.mpr hv, ?_, ?_⟩
  · intro j
    by_cases hj : j.val + 1 < k
    · have hell : k - 2 - j.val < k := by omega
      have hlength : k - 2 - j.val + 1 = k - 1 - j.val := by omega
      have ht := (htail (k - 2 - j.val) hell).le
      rw [hlength] at ht
      rw [dyadicCountCoordinate_card_above_tail hA T j hj]
      have heq : 1 + (v - 1) = v := by ring
      rw [heq]
      exact ht
    · have hlength : k - 1 - j.val = 0 := by omega
      rw [hlength]
      simp only [Nat.cast_zero, mul_zero, zero_sub]
      exact (neg_nonpos.mpr (Nat.cast_nonneg D)).trans (Nat.cast_nonneg _)
  · by_cases hk : k = 0
    · subst k
      simp only [Nat.cast_zero, zero_sub]
      exact (neg_nonpos.mpr (Nat.cast_nonneg D)).trans (Nat.cast_nonneg _)
    · have hkpos : 0 < k := Nat.pos_of_ne_zero hk
      have ht := (htail (k - 1) (by omega)).le
      rw [dyadicPrimeTail_full hkpos, Nat.sub_add_cancel hkpos] at ht
      rw [dyadicCountCoordinate_card hA]
      have hvk : (k : ℝ) ≤ v * (k : ℝ) := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right hv.le (Nat.cast_nonneg k)
      exact (sub_le_sub_right hvk (D : ℝ)).trans ht

end Erdos859Verification

