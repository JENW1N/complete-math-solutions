        ext q
        simp only [mem_filter, mem_insert]
        constructor
        · rintro ⟨rfl | hq, hlt⟩
          · exact False.elim ((lt_irrefl _) hlt)
          · exact hq
        · intro hq
          exact ⟨Or.inr hq, hmax q hq⟩
