/- Inlined development module: FiniteReweighting.lean -/

section

/- Quantitative comparison of conditioned and reweighted finite laws. -/

open Finset

namespace Erdos859Verification

theorem finite_normalized_reweight_bound {α : Type*} [Fintype α]
    (S : Finset α) (w H F : α → ℝ) {a b : ℝ}
    (ha : 0 < a) (hb : 0 ≤ b) (hw : ∀ x, 0 ≤ w x) (hF : ∀ x, 0 ≤ F x)
    (hHlow : ∀ x ∈ S, 1 ≤ H x) (hHhigh : ∀ x ∈ S, H x ≤ b)
    (hmass : a ≤ ∑ x ∈ S, w x) :
    (∑ x ∈ S, w x * H x * F x) / (∑ x ∈ S, w x * H x) ≤
      (b / a) * ∑ x, w x * F x := by
  have hden : a ≤ ∑ x ∈ S, w x * H x := hmass.trans (sum_le_sum fun x hx ↦
    le_mul_of_one_le_right (hw x) (hHlow x hx))
  have hE : 0 ≤ ∑ x, w x * F x := sum_nonneg (fun x _ ↦ mul_nonneg (hw x) (hF x))
  have hnum : (∑ x ∈ S, w x * H x * F x) ≤ b * ∑ x, w x * F x := by
    calc
      _ ≤ ∑ x ∈ S, b * (w x * F x) := by
        apply sum_le_sum
        intro x hx
        calc
          _ = H x * (w x * F x) := by ring
          _ ≤ _ := mul_le_mul_of_nonneg_right (hHhigh x hx) (mul_nonneg (hw x) (hF x))
      _ ≤ ∑ x, b * (w x * F x) :=
        sum_le_sum_of_subset_of_nonneg (subset_univ S)
          (fun x _ _ ↦ mul_nonneg hb (mul_nonneg (hw x) (hF x)))
      _ = _ := (mul_sum _ _ _).symm
  calc
    _ ≤ (b * ∑ x, w x * F x) / (∑ x ∈ S, w x * H x) :=
      div_le_div_of_nonneg_right hnum (ha.trans_le hden).le
    _ ≤ (b * ∑ x, w x * F x) / a :=
      div_le_div_of_nonneg_left (mul_nonneg hb hE) ha hden
    _ = _ := by ring

/-- Conditioning on an event of mass at least three quarters and reweighting
by a factor between one and three halves inflates nonnegative expectations
by at most two. -/
theorem finite_normalized_reweight_le_two {α : Type*} [Fintype α]
    (S : Finset α) (w H F : α → ℝ)
    (hw : ∀ x, 0 ≤ w x) (hF : ∀ x, 0 ≤ F x)
    (hHlow : ∀ x ∈ S, 1 ≤ H x) (hHhigh : ∀ x ∈ S, H x ≤ 3 / 2)
    (hmass : (3 : ℝ) / 4 ≤ ∑ x ∈ S, w x) :
    (∑ x ∈ S, w x * H x * F x) / (∑ x ∈ S, w x * H x) ≤
      2 * ∑ x, w x * F x := by
  have h := finite_normalized_reweight_bound S w H F
    (by norm_num : (0 : ℝ) < 3 / 4) (by norm_num : (0 : ℝ) ≤ 3 / 2)
    hw hF hHlow hHhigh hmass
  norm_num at h
  exact h

theorem finite_weighted_markov {α : Type*} (S : Finset α) (w F : α → ℝ)
    {t : ℝ} (ht : 0 < t) (hw : ∀ x ∈ S, 0 ≤ w x) (hF : ∀ x ∈ S, 0 ≤ F x) :
    (∑ x ∈ S with t ≤ F x, w x) ≤ (∑ x ∈ S, w x * F x) / t := by
  classical
  apply (le_div_iff₀ ht).mpr
  rw [sum_mul]
  calc
    _ ≤ ∑ x ∈ S with t ≤ F x, w x * F x := by
      apply sum_le_sum
      intro x hx
      exact mul_le_mul_of_nonneg_left (mem_filter.mp hx).2 (hw x (mem_filter.mp hx).1)
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
      (fun x hx _ ↦ mul_nonneg (hw x hx) (hF x hx))

end Erdos859Verification

end

/- Inlined development module: PrimeReverseBarrier.lean -/

section

/- A uniform finite reverse-count barrier from marginal Chernoff bounds. -/

open Finset Real

namespace Erdos859Verification

/-- A finite union bound for arbitrary nonnegative weights.  Neither
independence nor disjointness of the events is required. -/
theorem finite_weighted_union_bound (S : Finset (Finset ℕ)) (I : Finset ℕ)
    (w : Finset ℕ → ℝ) (hw : ∀ T ∈ S, 0 ≤ w T)
    (F : ℕ → Finset ℕ → Prop) [DecidableRel F] :
    (∑ T ∈ S.filter (fun T ↦ ∃ ell ∈ I, F ell T), w T) ≤
      ∑ ell ∈ I, ∑ T ∈ S.filter (F ell), w T := by
  simp only [sum_filter]
  rw [sum_comm]
  apply sum_le_sum
  intro T hT
  have hnonneg (ell : ℕ) : 0 ≤ if F ell T then w T else 0 := by
    split_ifs
    · exact hw T hT
    · exact le_rfl
  split_ifs with h
  · obtain ⟨ell, hell, hF⟩ := h
    calc
      w T = if F ell T then w T else 0 := by rw [if_pos hF]
      _ ≤ ∑ ell ∈ I, if F ell T then w T else 0 :=
        single_le_sum (fun ell _ ↦ hnonneg ell) hell
  · exact sum_nonneg (fun ell _ ↦ hnonneg ell)

/-- One restricted lower tail is exponentially small in the number of
terminal bands, provided its mean has the corresponding linear lower bound. -/
theorem primeTiltWeight_linear_barrier_failure_le {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) {lam : ℝ} (hlam : 0 < lam)
    (v mu theta : ℝ) (ht : 0 ≤ theta) (D ell : ℕ)
    (hmean : mu * (ell + 1 : ℕ) ≤ ∑ p ∈ B, primeTiltSelectionProbability lam p) :
    (∑ T ∈ P.powerset.filter
        (fun T ↦ ((T ∩ B).card : ℝ) ≤ v * (ell + 1 : ℕ) - D),
      primeTiltWeight P lam T) ≤
      exp (-theta * (D : ℝ)) *
        exp (theta * v + mu * (exp (-theta) - 1)) ^ (ell + 1) := by
  have hneg : exp (-theta) - 1 ≤ 0 := by
    exact sub_nonpos.mpr (exp_le_one_iff.mpr (neg_nonpos.mpr ht))
  calc
    _ ≤ exp ((exp (-theta) - 1) *
        (∑ p ∈ B, primeTiltSelectionProbability lam p) -
          (-theta) * (v * (ell + 1 : ℕ) - D)) :=
      primeTiltWeight_restricted_count_lower_tail hP hB hlam
        (v * (ell + 1 : ℕ) - D) (-theta) (neg_nonpos.mpr ht)
    _ ≤ exp ((exp (-theta) - 1) * (mu * (ell + 1 : ℕ)) -
          (-theta) * (v * (ell + 1 : ℕ) - D)) := by
      apply exp_le_exp.mpr
      exact sub_le_sub_right (mul_le_mul_of_nonpos_left hmean hneg) _
    _ = _ := by
      rw [← exp_nat_mul, ← exp_add]
      congr 1
      ring

/-- Failure of a reverse-count barrier at one of the finitely many scales.
Using a nonstrict inequality makes this event slightly larger than the strict
failure event and simplifies subsequent applications. -/
abbrev ReverseCountBarrierFailure (k : ℕ) (v : ℝ) (D : ℕ)
    (B : ℕ → Finset ℕ) (T : Finset ℕ) : Prop :=
  ∃ ell ∈ range k, ((T ∩ B ell).card : ℝ) ≤ v * (ell + 1 : ℕ) - D

/-- A single offset makes every finite family of linearly growing restricted
counts satisfy the reverse barrier with probability at least `1 - err`.
The subsets may overlap arbitrarily. -/
theorem exists_uniform_reverse_count_barrier {v mu err : ℝ}
    (hv : 0 < v) (hvm : v < mu) (herr : 0 < err) :
    ∃ D : ℕ, ∀ (P : Finset ℕ) (lam : ℝ),
      (∀ p ∈ P, p.Prime) → 0 < lam →
      ∀ (k : ℕ) (B : ℕ → Finset ℕ),
        (∀ ell < k, B ell ⊆ P) →
        (∀ ell < k, mu * (ell + 1 : ℕ) ≤
          ∑ p ∈ B ell, primeTiltSelectionProbability lam p) →
        (∑ T ∈ P.powerset.filter (ReverseCountBarrierFailure k v D B),
          primeTiltWeight P lam T) ≤ err := by
  obtain ⟨theta, ht, hR1⟩ := exists_positive_chernoff_rate hv hvm
  let R : ℝ := exp (theta * v + mu * (exp (-theta) - 1))
  have hR0 : 0 < R := exp_pos _
  obtain ⟨D, hD⟩ := exists_geometric_tail_offset ht hR0 hR1 herr
  refine ⟨D, fun P lam hP hlam k B hB hmean ↦ ?_⟩
  calc
    _ ≤ ∑ ell ∈ range k,
        ∑ T ∈ P.powerset.filter
            (fun T ↦ ((T ∩ B ell).card : ℝ) ≤ v * (ell + 1 : ℕ) - D),
          primeTiltWeight P lam T :=
      finite_weighted_union_bound P.powerset (range k) (primeTiltWeight P lam)
        (fun T _ ↦ (primeTiltWeight_pos hP hlam T).le) _
    _ ≤ ∑ ell ∈ range k, exp (-theta * (D : ℝ)) * R ^ (ell + 1) := by
      apply sum_le_sum
      intro ell hell
      exact primeTiltWeight_linear_barrier_failure_le hP (hB ell (mem_range.mp hell))
        hlam v mu theta ht.le D ell (hmean ell (mem_range.mp hell))
    _ = exp (-theta * (D : ℝ)) * ∑ ell ∈ range k, R ^ (ell + 1) := by rw [mul_sum]
    _ ≤ err := hD k

end Erdos859Verification

end

