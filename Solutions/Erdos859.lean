theorem primeMarkRegularityCutoff_pos : 0 < primeMarkRegularityCutoff := by
  unfold primeMarkRegularityCutoff
  apply lt_min
  · positivity [log_pos (by norm_num : (1 : ℝ) < 2)]
  · positivity [log_pos (by norm_num : (1 : ℝ) < 3 / 2)]

noncomputable def primeBandCountRegularity {ι : Type*} [Fintype ι]
    (a : ι → ℝ) (n : ι → ℕ) : ℝ := ∑ j, (n j : ℝ) ^ 2 * exp (-a j)

theorem primeLogMarkWeight_atom_bound {a : ℝ} (ha : log 2 ≤ a)
    (hlarge : 4 * mertensErrorConstant ≤ a * log 2)
    (p : primeLogWindow a (2 * a)) :
    primeLogMarkWeight a (2 * a) p ≤ (2 / log 2) * exp (-a) := by
  have hp := mem_primeLogWindow.mp p.property
  have hp0 : (0 : ℝ) < (p : ℕ) := by exact_mod_cast hp.1.pos
  have hlog : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hmass := primeLogWindowMass_dyadic_lower ha hlarge
  have hmass0 : 0 < primeLogWindowMass a (2 * a) := (half_pos hlog).trans_le hmass
  have hrecip : 1 / ((p : ℕ) : ℝ) ≤ exp (-a) := by
    rw [exp_neg, ← one_div]
    apply one_div_le_one_div_of_le (exp_pos a)
    calc
      exp a ≤ exp (log ((p : ℕ) : ℝ)) := exp_le_exp.mpr hp.2.1.le
      _ = _ := exp_log hp0
  unfold primeLogMarkWeight
  calc
    _ ≤ exp (-a) / primeLogWindowMass a (2 * a) :=
      div_le_div_of_nonneg_right hrecip hmass0.le
    _ ≤ exp (-a) / (log 2 / 2) :=
      div_le_div_of_nonneg_left (exp_pos _).le (half_pos hlog) hmass
    _ = _ := by ring

theorem primeBandCountRegularity_linear_le {ι : Type*} [Fintype ι]
    (a : ι → ℝ) (n : ι → ℕ) :
    (∑ j, (n j : ℝ) * exp (-a j)) ≤ primeBandCountRegularity a n := by
  apply sum_le_sum
  intro j _
  apply mul_le_mul_of_nonneg_right _ (exp_pos _).le
  rcases (n j).eq_zero_or_pos with hz | hp
  · simp [hz]
  · have hn : 1 ≤ (n j : ℝ) := by exact_mod_cast hp
    nlinarith [sq_nonneg ((n j : ℝ) - 1)]

