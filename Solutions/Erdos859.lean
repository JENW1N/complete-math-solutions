noncomputable def intervalSmoothingKernel (d x y : ℝ) : ℝ :=
  (Set.Icc x (x + d)).indicator (fun _ ↦ 1 / d) y

noncomputable def finiteIntervalSmoothing {ι : Type*} [Fintype ι]
    (w atom : ι → ℝ) (d y : ℝ) : ℝ :=
  ∑ i, w i * intervalSmoothingKernel d (atom i) y

theorem intervalSmoothingKernel_nonneg {d : ℝ} (hd : 0 ≤ d) (x y : ℝ) :
    0 ≤ intervalSmoothingKernel d x y := by
  unfold intervalSmoothingKernel
  exact Set.indicator_nonneg (fun _ _ ↦ by positivity) y

theorem integrable_intervalSmoothingKernel (d x : ℝ) :
    Integrable (intervalSmoothingKernel d x) := by
  apply (integrable_indicator_iff measurableSet_Icc).mpr
  exact integrableOn_const (by simp [Real.volume_Icc])

theorem integral_intervalSmoothingKernel {d : ℝ} (hd : 0 < d) (x : ℝ) :
    (∫ y, intervalSmoothingKernel d x y) = 1 := by
  unfold intervalSmoothingKernel
  rw [integral_indicator_const _ measurableSet_Icc,
    Real.volume_real_Icc_of_le (by linarith : x ≤ x + d)]
  simp [smul_eq_mul, hd.ne']

theorem intervalSmoothingKernel_mul (d x z y : ℝ) :
    intervalSmoothingKernel d x y * intervalSmoothingKernel d z y =
      (Set.Icc x (x + d) ∩ Set.Icc z (z + d)).indicator
        (fun _ ↦ (1 / d : ℝ) * (1 / d)) y := by
  exact (Set.inter_indicator_mul _ _ _).symm

theorem integrable_intervalSmoothingKernel_mul (d x z : ℝ) :
    Integrable (fun y ↦ intervalSmoothingKernel d x y * intervalSmoothingKernel d z y) := by
  simp_rw [intervalSmoothingKernel_mul, Set.Icc_inter_Icc]
  apply (integrable_indicator_iff measurableSet_Icc).mpr
  exact integrableOn_const (by simp [Real.volume_Icc])

/-- The overlap of two equal-length intervals is the positive part of
their length minus the distance between their starting points. -/
theorem intervalSmoothing_overlap_length (d x z : ℝ) :
    min (x + d) (z + d) - max x z = d - |x - z| := by
  rcases le_total x z with hxz | hzx
  · rw [min_eq_left (show x + d ≤ z + d by linarith), max_eq_right hxz,
      abs_of_nonpos (sub_nonpos.mpr hxz)]
    ring
  · rw [min_eq_right (show z + d ≤ x + d by linarith), max_eq_left hzx,
      abs_of_nonneg (sub_nonneg.mpr hzx)]
    ring

theorem integral_intervalSmoothingKernel_mul (d x z : ℝ) :
    (∫ y, intervalSmoothingKernel d x y * intervalSmoothingKernel d z y) =
      max (d - |x - z|) 0 / d ^ 2 := by
  simp_rw [intervalSmoothingKernel_mul]
  rw [integral_indicator_const _ (measurableSet_Icc.inter measurableSet_Icc),
    Set.Icc_inter_Icc, Real.volume_real_Icc]
  change max (min (x + d) (z + d) - max x z) 0 * (1 / d * (1 / d)) = _
  rw [intervalSmoothing_overlap_length]
  ring

theorem integrable_finiteIntervalSmoothing {ι : Type*} [Fintype ι]
    (w atom : ι → ℝ) (d : ℝ) : Integrable (finiteIntervalSmoothing w atom d) := by
  exact integrable_finsetSum univ (fun i _ ↦
    (integrable_intervalSmoothingKernel d (atom i)).const_mul (w i))

theorem finiteIntervalSmoothing_nonneg {ι : Type*} [Fintype ι]
    (w atom : ι → ℝ) {d : ℝ} (hd : 0 ≤ d) (hw : ∀ i, 0 ≤ w i) (y : ℝ) :
    0 ≤ finiteIntervalSmoothing w atom d y := by
  exact sum_nonneg (fun i _ ↦ mul_nonneg (hw i) (intervalSmoothingKernel_nonneg hd _ _))

