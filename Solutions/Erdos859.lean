section

/- An actual Mertens nonselection factor for complete finite prime universes. -/

namespace Erdos859Verification

open Finset Real

def FordCompletePrimeUniverse (P : Finset ℕ) : Prop :=
  ∀ p ∈ P, ∀ q < p, q.Prime → q ∈ P

def fordPrimesUpTo (N : ℕ) : Finset ℕ := (range (N+1)).filter Nat.Prime

theorem fordPrimesUpTo_prime (N : ℕ) : ∀ p ∈ fordPrimesUpTo N, p.Prime :=
  fun _ hp ↦ (mem_filter.mp hp).2

theorem fordPrimesUpTo_complete (N : ℕ) : FordCompletePrimeUniverse (fordPrimesUpTo N) := by
  intro p hp q hqp hq
  exact mem_filter.mpr ⟨mem_range.mpr (hqp.trans (mem_range.mp (mem_filter.mp hp).1)), hq⟩

theorem fordPrimePrefix_eq_all_below {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hcomplete : FordCompletePrimeUniverse P)
    {p : ℕ} (hp : p ∈ P) :
    fordPrimePrefix P p = (range p).filter Nat.Prime := by
  ext q
  simp only [fordPrimePrefix, mem_filter, mem_range]
  exact ⟨fun h ↦ ⟨h.2, hP q h.1⟩, fun h ↦ ⟨hcomplete p hp q h.1 h.2, h.1⟩⟩

theorem prime_reciprocal_sum_below {p : ℕ} (hp : p.Prime) :
    (∑ q ∈ (range p).filter Nat.Prime, 1 / (q : ℝ)) =
      primeReciprocalSum (p : ℝ) - 1 / (p : ℝ) := by
  have hset : insert p ((range p).filter Nat.Prime) = (Ioc 0 p).filter Nat.Prime := by
    ext q
    simp only [mem_insert, mem_filter, mem_range, mem_Ioc]
    constructor
    · rintro (rfl | ⟨hqp, hq⟩)
      · exact ⟨⟨hp.pos, le_rfl⟩, hp⟩
      · exact ⟨⟨hq.pos, hqp.le⟩, hq⟩
    · rintro ⟨⟨_, hqp⟩, hq⟩
      rcases lt_or_eq_of_le hqp with hlt | heq
      · exact Or.inr ⟨hlt, hq⟩
      · exact Or.inl heq
  have hpnot : p ∉ (range p).filter Nat.Prime := by simp
  have hsum := congrArg (fun S : Finset ℕ ↦ ∑ q ∈ S, 1/(q:ℝ)) hset
  rw [sum_insert hpnot] at hsum
  unfold primeReciprocalSum
  simp only [Nat.floor_natCast]
  linarith

noncomputable def fordPrefixMertensConstant : ℝ :=
  exp (-PrimeMertens.M + mertensErrorConstant / log 2 + 1)

theorem fordPrefixMertensConstant_pos : 0 < fordPrefixMertensConstant := exp_pos _

/-- Completeness is essential: this is proved for every prime below the
stopping prime, rather than postulated for an arbitrary sparse family. -/
theorem primePatternWeight_prefix_empty_upper {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hcomplete : FordCompletePrimeUniverse P)
    {p : ℕ} (hpP : p ∈ P) :
    primePatternWeight (fordPrimePrefix P p) ∅ ≤
      fordPrefixMertensConstant / log (p : ℝ) := by
  have hp := hP p hpP
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hl2 : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hlog2 : log 2 ≤ log (p : ℝ) := log_le_log (by norm_num) hp2
  have hlp : 0 < log (p : ℝ) := hl2.trans_le hlog2
  have hM := (abs_le.mp (primeReciprocalSum_estimate hp2)).1
  have herr : mertensErrorConstant / log (p : ℝ) ≤ mertensErrorConstant / log 2 :=
    div_le_div_of_nonneg_left mertensErrorConstant_pos.le hl2 hlog2
  have hrecip : 1 / (p : ℝ) ≤ 1 := (div_le_one hp0).mpr (by linarith)
  have hsum : log (log (p : ℝ)) + PrimeMertens.M - mertensErrorConstant / log 2 - 1 ≤
      ∑ q ∈ fordPrimePrefix P p, 1 / (q : ℝ) := by
    rw [fordPrimePrefix_eq_all_below hP hcomplete hpP, prime_reciprocal_sum_below hp]
    linarith
  calc
    _ ≤ exp (-(∑ q ∈ fordPrimePrefix P p, 1 / (q : ℝ))) :=
      primePatternWeight_empty_le_exp (fun q hq ↦ hP q (mem_filter.mp hq).1)
    _ ≤ exp (-log (log (p : ℝ)) + (-PrimeMertens.M + mertensErrorConstant / log 2 + 1)) :=
      exp_le_exp.mpr (by linarith)
    _ = _ := by
      rw [exp_add, exp_neg, exp_log hlp]
      unfold fordPrefixMertensConstant
      ring


