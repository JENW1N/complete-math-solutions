    (signedCoefficientBox ι H).card = (2 * H + 1) ^ Fintype.card ι := by
  classical
  have hcard : (Icc (-(H : ℤ)) (H : ℤ)).card = 2 * H + 1 := by
    rw [Int.card_Icc]
    omega
  simp [signedCoefficientBox, Fintype.card_piFinset, hcard]

