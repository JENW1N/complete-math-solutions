/- Inlined development module: PrimePairQuantileCoupling.lean -/

section

/- Independent prime pairs inherit exact difference laws and bounded
displacement from the single-mark quantile coupling. -/

namespace Erdos859Verification

open Real MeasureTheory

def pairCoupledDifference (z : (ℝ × ℝ) × (ℝ × ℝ)) : ℝ × ℝ :=
  (z.1.1 - z.2.1, z.1.2 - z.2.2)

theorem measurable_pairCoupledDifference : Measurable pairCoupledDifference := by
  unfold pairCoupledDifference
  fun_prop

noncomputable def pairDifferenceCoupling (μ : Measure (ℝ × ℝ)) : Measure (ℝ × ℝ) :=
  Measure.map pairCoupledDifference (μ.prod μ)

theorem pairDifferenceCoupling_fst (μ : Measure (ℝ × ℝ)) [SFinite μ] :
    Measure.map Prod.fst (pairDifferenceCoupling μ) =
      Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2) ((Measure.map Prod.fst μ).prod (Measure.map Prod.fst μ)) := by
  unfold pairDifferenceCoupling
  rw [Measure.map_map measurable_fst measurable_pairCoupledDifference,
    Measure.map_prod_map μ μ measurable_fst measurable_fst,
    Measure.map_map (by fun_prop) (measurable_fst.prodMap measurable_fst)]
  rfl

theorem pairDifferenceCoupling_snd (μ : Measure (ℝ × ℝ)) [SFinite μ] :
    Measure.map Prod.snd (pairDifferenceCoupling μ) =
      Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2) ((Measure.map Prod.snd μ).prod (Measure.map Prod.snd μ)) := by
  unfold pairDifferenceCoupling
  rw [Measure.map_map measurable_snd measurable_pairCoupledDifference,
    Measure.map_prod_map μ μ measurable_snd measurable_snd,
    Measure.map_map (by fun_prop) (measurable_snd.prodMap measurable_snd)]
  rfl

theorem pairDifferenceCoupling_displacement (μ : Measure (ℝ × ℝ)) [IsProbabilityMeasure μ]
    {r : ℝ} (hr : μ {z | |z.1 - z.2| ≤ r} = 1) :
    pairDifferenceCoupling μ {z | |z.1 - z.2| ≤ 2 * r} = 1 := by
  have hm : MeasurableSet {z : ℝ × ℝ | |z.1 - z.2| ≤ 2 * r} := by measurability
  rw [pairDifferenceCoupling, Measure.map_apply measurable_pairCoupledDifference hm]
  apply le_antisymm prob_le_one
  have hg : μ.prod μ ({z : ℝ × ℝ | |z.1 - z.2| ≤ r} ×ˢ {z : ℝ × ℝ | |z.1 - z.2| ≤ r}) = 1 := by
    rw [Measure.prod_prod, hr, one_mul]
  rw [← hg]
  apply measure_mono
  intro z hz
  change |(z.1.1 - z.2.1) - (z.1.2 - z.2.2)| ≤ 2 * r
  have hid : (z.1.1 - z.2.1) - (z.1.2 - z.2.2) =
      (z.1.1 - z.1.2) - (z.2.1 - z.2.2) := by ring
  rw [hid]
  have hz1 : |z.1.1 - z.1.2| ≤ r := hz.1
  have hz2 : |z.2.1 - z.2.2| ≤ r := hz.2
  exact (abs_sub _ _).trans (by linarith)

theorem finiteQuantileCoupling_isProbability (P : Finset ℝ) (a : ℝ → ℝ) {Q : ℝ → ℝ}
    (hQ : Measurable Q) : IsProbabilityMeasure (finiteQuantileCoupling P a Q) := by
  let : IsProbabilityMeasure (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
    finiteQuantile_uniform_isProbability
  exact Measure.isProbabilityMeasure_map ((measurable_finiteQuantile P a).prodMk hQ).aemeasurable

noncomputable def primeLogOddsPairQuantileCoupling (lam u w : ℝ) : Measure (ℝ × ℝ) :=
  pairDifferenceCoupling (primeLogOddsQuantileCoupling lam u w)

noncomputable def primeReciprocalOddsPairQuantileCoupling (u w : ℝ) : Measure (ℝ × ℝ) :=
  pairDifferenceCoupling (primeReciprocalOddsQuantileCoupling u w)

theorem primeLogOddsPairQuantileCoupling_properties {lam u w : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u)
    (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w) :
    Measure.map Prod.fst (primeLogOddsPairQuantileCoupling lam u w) =
        Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
          ((primeLogOddsLogLaw lam u w).prod (primeLogOddsLogLaw lam u w)) ∧
      Measure.map Prod.snd (primeLogOddsPairQuantileCoupling lam u w) =
        translationShiftLaw (logUniformPairDensity u w) ∧
      primeLogOddsPairQuantileCoupling lam u w
        {z | |z.1 - z.2| ≤ 32 * primeLogOddsErrorConstant} = 1 := by
  let : IsProbabilityMeasure (primeLogOddsQuantileCoupling lam u w) :=
    finiteQuantileCoupling_isProbability _ _ (measurable_logUniformQuantile u w)
  have h := primeLogOddsQuantileCoupling_properties hlam hlam2 hu hw hwu hlarge
  constructor
  · rw [primeLogOddsPairQuantileCoupling, pairDifferenceCoupling_fst, h.1]
  · constructor
    · rw [primeLogOddsPairQuantileCoupling, pairDifferenceCoupling_snd, h.2.1,
        logUniformPairDensity_map_eq hw hwu]
    · have hb := pairDifferenceCoupling_displacement _ h.2.2
      simpa only [primeLogOddsPairQuantileCoupling,
        show 2 * (16 * primeLogOddsErrorConstant) = 32 * primeLogOddsErrorConstant by ring] using hb

theorem primeReciprocalOddsPairQuantileCoupling_properties {u w : ℝ}
    (hu : log 2 ≤ u) (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w) :
    Measure.map Prod.fst (primeReciprocalOddsPairQuantileCoupling u w) =
        Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
          ((primeReciprocalOddsLogLaw u w).prod (primeReciprocalOddsLogLaw u w)) ∧
      Measure.map Prod.snd (primeReciprocalOddsPairQuantileCoupling u w) =
        translationShiftLaw (logUniformPairDensity u w) ∧
      primeReciprocalOddsPairQuantileCoupling u w
        {z | |z.1 - z.2| ≤ 32 * primeLogOddsErrorConstant} = 1 := by
  let : IsProbabilityMeasure (primeReciprocalOddsQuantileCoupling u w) :=
    finiteQuantileCoupling_isProbability _ _ (measurable_logUniformQuantile u w)
  have h := primeReciprocalOddsQuantileCoupling_properties hu hw hwu hlarge
  constructor
  · rw [primeReciprocalOddsPairQuantileCoupling, pairDifferenceCoupling_fst, h.1]
  · constructor
    · rw [primeReciprocalOddsPairQuantileCoupling, pairDifferenceCoupling_snd, h.2.1,
        logUniformPairDensity_map_eq hw hwu]
    · have hb := pairDifferenceCoupling_displacement _ h.2.2
      simpa only [primeReciprocalOddsPairQuantileCoupling,
        show 2 * (16 * primeLogOddsErrorConstant) = 32 * primeLogOddsErrorConstant by ring] using hb

