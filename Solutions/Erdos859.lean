def fordPowerfulSquare (n : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors, p ^ (n.factorization p / 2 - n.factorization p % 2)

def fordPowerfulCube (n : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors, p ^ (n.factorization p % 2)

theorem ford_powerful_exponent (e : ℕ) (he : e ≠ 1) :
    (e / 2 - e % 2) * 2 + (e % 2) * 3 = e := by omega

