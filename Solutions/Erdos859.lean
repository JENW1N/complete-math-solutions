        (tendsto_natCast_atTop_atTop (R := ℝ))
  simpa only [coreGlobalBallotCorrection, add_div, mul_div_assoc, zero_add, mul_zero] using
    ((coreBallot_error_div_tendsto lam).add
      (tendsto_const_div_atTop_nhds_zero_nat (1 : ℝ))).add (hlog.const_mul 2)

theorem coreGlobalBallot_main_eq_exp {k : ℕ} (hk : 0 < k) (lam : ℝ) :
    coreGlobalBallotMain lam k =
