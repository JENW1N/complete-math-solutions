    (lam : ℝ) (x : Fin n → P) : ℝ :=
  finiteProductWeight (fun _ p ↦ primeLogOddsIntensity lam p.val /
    ∑ q ∈ P, primeLogOddsIntensity lam q) x

theorem primeIntensityTupleWeight_normalized {P : Finset ℕ}
    {lam : ℝ} (hM : 0 < ∑ p ∈ P, primeLogOddsIntensity lam p) (n : ℕ) :
    (∑ x : Fin n → P, primeIntensityTupleWeight lam x) = 1 := by
  apply sum_finiteProductWeight
  intro i
  rw [← sum_div]
  simp only [Finset.sum_coe_sort]
  exact div_self hM.ne'

theorem primeTilt_good_count_lower {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (n : ℕ) (Good : Finset ℕ → Prop) [DecidablePred Good]
    (hM : 0 < ∑ p ∈ P, primeLogOddsIntensity lam p)
    {alpha beta : ℝ} (halpha : 0 ≤ alpha)
    (hatom : ∀ p ∈ P, primeLogOddsIntensity lam p /
      (∑ q ∈ P, primeLogOddsIntensity lam q) ≤ alpha)
    (hbad : (∑ x : Fin n → P, primeIntensityTupleWeight lam x *
      (if Good (tupleSupport x) then 0 else 1)) ≤ beta) :
