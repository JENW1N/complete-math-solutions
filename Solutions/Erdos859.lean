theorem coreSuffix_family_probability_lower {ι : Type*} [Fintype ι] [DecidableEq ι]
    (label : ι → ℕ) (hinj : Function.Injective label)
    {A B eta lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (heta : 0 < eta) (heta2 : eta ≤ log 2)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ eta * B) :
    (∏ i, exp (-(lam * (log 2 + 2 * primeLogOddsErrorConstant / (A + B * 2 ^ label i)))) *
      (lam * eta * B * 2 ^ label i / (2 * (A + B * 2 ^ label i)))) ≤
      ∑ T ∈ (primeBandUnion (fun i ↦ virtualPrimeBand A B (label i))).powerset.filter
        (fun T ↦ ∀ i, (T ∩ virtualPrimeBand A B (label i)).card = 1 ∧
          T ∩ virtualPrimeBand A B (label i) ⊆ coreSuffixPrimeBand A B eta (label i)),
        primeTiltWeight (primeBandUnion (fun i ↦ virtualPrimeBand A B (label i))) lam T := by
  classical
  have hdis : Pairwise (fun i j ↦ Disjoint (virtualPrimeBand A B (label i))
      (virtualPrimeBand A B (label j))) := fun _ _ hij ↦ virtualPrimeBand_disjoint hB (fun h ↦ hij (hinj h))
  rw [prime_tilt_disjoint_singleIn_product
    (fun i ↦ virtualPrimeBand A B (label i)) (fun i ↦ coreSuffixPrimeBand A B eta (label i)) hdis]
  apply prod_le_prod
  · intro i _
    positivity
  · intro i _
    exact coreSuffix_singleIn_probability_lower hA hB hbase heta heta2 hlam hlam2 hlarge (label i)

