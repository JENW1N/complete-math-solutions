/- Inlined development module: FordOrderedSimplex.lean -/

section

/- Exact volumes of ordered cubes, including zero-dimensional simplices.
The cube is decomposed into permutation chambers whose overlaps are null. -/

open MeasureTheory Set
open scoped ENNReal

namespace Erdos859Verification

def fordOrderedSimplex (k : ℕ) (t : ℝ) : Set (Fin k → ℝ) :=
  Icc (fun _ ↦ 0) (fun _ ↦ t) ∩ {x | Monotone x}

def fordOrderedChamber {k : ℕ} (t : ℝ) (σ : Equiv.Perm (Fin k)) : Set (Fin k → ℝ) :=
  (fun x ↦ x ∘ σ) ⁻¹' fordOrderedSimplex k t

theorem fordOrderedSimplex_measurable (k : ℕ) (t : ℝ) :
    MeasurableSet (fordOrderedSimplex k t) :=
  measurableSet_Icc.inter isClosed_monotone.measurableSet

theorem ford_permute_measurePreserving {k : ℕ} (σ : Equiv.Perm (Fin k)) :
    MeasurePreserving (fun x : Fin k → ℝ ↦ x ∘ σ) volume volume := by
  exact (volume_measurePreserving_piCongrLeft (fun _ : Fin k ↦ ℝ) σ).symm

theorem fordOrderedChamber_measurable {k : ℕ} (t : ℝ) (σ : Equiv.Perm (Fin k)) :
    MeasurableSet (fordOrderedChamber t σ) :=
  (fordOrderedSimplex_measurable k t).preimage (ford_permute_measurePreserving σ).measurable

theorem fordOrderedChamber_volume {k : ℕ} (t : ℝ) (σ : Equiv.Perm (Fin k)) :
    volume (fordOrderedChamber t σ) = volume (fordOrderedSimplex k t) :=
  (ford_permute_measurePreserving σ).measure_preimage
    (fordOrderedSimplex_measurable k t).nullMeasurableSet

/-- Equal distinct coordinates form a proper linear subspace, hence a null set. -/
theorem ford_coordinate_tie_null {k : ℕ} {i j : Fin k} (hij : i ≠ j) :
    volume {x : Fin k → ℝ | x i = x j} = 0 := by
  let f : (Fin k → ℝ) →ₗ[ℝ] ℝ :=
    (LinearMap.proj i : (Fin k → ℝ) →ₗ[ℝ] ℝ) - LinearMap.proj j
  have hf : f.ker ≠ ⊤ := by
    intro htop
    have hmem : (Pi.single i 1 : Fin k → ℝ) ∈ f.ker := by rw [htop]; trivial
    have hzero : f (Pi.single i 1) = 0 := hmem
    simp [f, hij.symm] at hzero
  have hset : {x : Fin k → ℝ | x i = x j} = (f.ker : Set (Fin k → ℝ)) := by
    ext x
    simp [f, sub_eq_zero]
  rw [hset]
  exact Measure.addHaar_submodule (volume : Measure (Fin k → ℝ)) f.ker hf

theorem fordOrderedChamber_pairwise_aedisjoint (k : ℕ) (t : ℝ) :
    Pairwise (fun σ τ : Equiv.Perm (Fin k) ↦
      AEDisjoint volume (fordOrderedChamber t σ) (fordOrderedChamber t τ)) := by
  intro σ τ hne
  obtain ⟨i, hi⟩ : ∃ i, σ i ≠ τ i := by
    by_contra! h
    exact hne (Equiv.ext h)
  apply measure_mono_null _ (ford_coordinate_tie_null hi)
  intro x hx
  have hmσ : Monotone (x ∘ σ) := hx.1.2
  have hmτ : Monotone (x ∘ τ) := hx.2.2
  exact congrFun (Tuple.unique_monotone hmσ hmτ) i

theorem fordOrderedChamber_iUnion (k : ℕ) (t : ℝ) :
    (⋃ σ : Equiv.Perm (Fin k), fordOrderedChamber t σ) =
      Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ t) := by
  ext x
  constructor
  · intro hx
    obtain ⟨σ, hσ⟩ := mem_iUnion.mp hx
    constructor
    · intro i
      simpa only [Function.comp_apply, Equiv.apply_symm_apply] using hσ.1.1 (σ.symm i)
    · intro i
      simpa only [Function.comp_apply, Equiv.apply_symm_apply] using hσ.1.2 (σ.symm i)
  · intro hx
    refine mem_iUnion.mpr ⟨Tuple.sort x, ?_⟩
    exact ⟨⟨fun i ↦ hx.1 _, fun i ↦ hx.2 _⟩, Tuple.monotone_sort x⟩

/-- Each of the `k!` ordered chambers has the same volume, and together they form the cube. -/
theorem fordOrderedSimplex_volume_mul_factorial (k : ℕ) (t : ℝ) :
    (k.factorial : ℝ≥0∞) * volume (fordOrderedSimplex k t) = ENNReal.ofReal t ^ k := by
  have h := measure_iUnion₀ (fordOrderedChamber_pairwise_aedisjoint k t)
    (fun σ ↦ (fordOrderedChamber_measurable t σ).nullMeasurableSet)
  rw [fordOrderedChamber_iUnion] at h
  simp only [fordOrderedChamber_volume, tsum_fintype, Finset.sum_const,
    Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul] at h
  rw [Real.volume_Icc_pi] at h
  simpa only [sub_zero, Finset.prod_const, Finset.card_univ, Fintype.card_fin] using h.symm

/-- The ordered simplex has its exact factorial volume, with no probabilistic assumptions. -/
theorem fordOrderedSimplex_volume (k : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    volume (fordOrderedSimplex k t) = ENNReal.ofReal (t ^ k / (k.factorial : ℝ)) := by
  have hfac : (k.factorial : ℝ≥0∞) ≠ 0 := by exact_mod_cast k.factorial_ne_zero
  rw [ENNReal.ofReal_div_of_pos (by positivity : (0 : ℝ) < k.factorial),
    ENNReal.ofReal_pow ht, ENNReal.ofReal_natCast]
  exact (ENNReal.eq_div_iff hfac (by finiteness)).mpr
    (fordOrderedSimplex_volume_mul_factorial k t)

end Erdos859Verification

