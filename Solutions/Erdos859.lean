    _ ≤ _ := exp_le_exp.mpr (by nlinarith)

theorem coreGlobalBallot_duplicate_eventually_le_half_main (lam : ℝ) :
    ∀ᶠ k : ℕ in atTop, coreGlobalBallotDuplicateError k ≤
