/- Inlined development module: TranslationHoleFilling.lean -/

section

/- Lebesgue autocorrelation and quadratic filling of holes by a random shift. -/

open MeasureTheory Real
open scoped ENNReal

namespace Erdos859Verification

/-- Translation by `g`, written as a preimage to make measurability explicit. -/
def realTranslateSet (E : Set ℝ) (g : ℝ) : Set ℝ := (fun x ↦ x - g) ⁻¹' E

theorem measurableSet_realTranslateSet {E : Set ℝ} (hE : MeasurableSet E) (g : ℝ) :
    MeasurableSet (realTranslateSet E g) :=
  hE.preimage (measurable_id.sub measurable_const)

noncomputable def translationOverlap (E : Set ℝ) (g : ℝ) : ℝ :=
  volume.real (E ∩ realTranslateSet E g)

theorem translationOverlap_nonneg (E : Set ℝ) (g : ℝ) : 0 ≤ translationOverlap E g :=
  measureReal_nonneg

theorem translationOverlap_eq_convolution {E : Set ℝ} (hE : MeasurableSet E) :
    translationOverlap E = convolution (E.indicator (fun _ ↦ (1 : ℝ)))
      (fun x ↦ E.indicator (fun _ ↦ (1 : ℝ)) (-x))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
  classical
  funext g
  have hs := hE.inter (measurableSet_realTranslateSet hE g)
  rw [translationOverlap, ← integral_indicator_one hs, convolution_def]
  apply integral_congr_ae
  filter_upwards [] with x
  by_cases hx : x ∈ E <;> by_cases hxg : x - g ∈ E <;>
    simp [realTranslateSet, hx, hxg, neg_sub]

/-- The overlap function is integrable for every measurable set of finite measure. -/
theorem integrable_translationOverlap {E : Set ℝ} (hE : MeasurableSet E)
    (hfinite : volume E ≠ ∞) : Integrable (translationOverlap E) := by
  have hf : Integrable (E.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hfinite).integrable_indicator hE
  rw [translationOverlap_eq_convolution hE]
  exact hf.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hf.comp_neg

/-- Integrating the autocorrelation gives the square of the missing measure. -/
theorem integral_translationOverlap {E : Set ℝ} (hE : MeasurableSet E)
    (hfinite : volume E ≠ ∞) :
    (∫ g : ℝ, translationOverlap E g) = (volume.real E) ^ 2 := by
  have hf : Integrable (E.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hfinite).integrable_indicator hE
  rw [translationOverlap_eq_convolution hE,
    integral_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hf hf.comp_neg,
    integral_neg_eq_self]
  simp only [integral_indicator hE, setIntegral_const,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul, mul_one, pow_two]

/-- Missing points after adjoining one translate to the covered set. -/
noncomputable def remainingHoleMeasure (A I : Set ℝ) (g : ℝ) : ℝ :=
  volume.real (I \ (A ∪ realTranslateSet A g))

theorem remainingHoleMeasure_nonneg (A I : Set ℝ) (g : ℝ) :
    0 ≤ remainingHoleMeasure A I g := measureReal_nonneg

theorem measurable_remainingHoleMeasure {A I : Set ℝ}
    (hA : MeasurableSet A) (hI : MeasurableSet I) :
    Measurable (remainingHoleMeasure A I) := by
  let S : Set (ℝ × ℝ) := {z | z.2 ∈ I ∧ z.2 ∉ A ∧ z.2 - z.1 ∉ A}
  have hS : MeasurableSet S :=
    (hI.preimage measurable_snd).inter
      ((hA.compl.preimage measurable_snd).inter
        (hA.compl.preimage (measurable_snd.sub measurable_fst)))
  have heq : remainingHoleMeasure A I = fun g ↦ volume.real (Prod.mk g ⁻¹' S) := by
    funext g
    apply congrArg volume.real
    ext x
    simp only [S, realTranslateSet, Set.mem_preimage, Set.mem_ofPred_eq,
      Set.mem_sdiff, Set.mem_union, not_or]
  rw [heq]
  exact (measurable_measure_prodMk_left hS).ennreal_toReal

/-- A hole surviving a shift in the trimmed interval gives two holes in the
original interval. This deterministic inclusion keeps the boundary exact. -/
theorem remainingHoleMeasure_trim_le {A : Set ℝ} {a b w g : ℝ}
    (hw : 0 ≤ w) (hg : g ∈ Set.Icc (-w) w) :
    remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g ≤
      translationOverlap (Set.Icc a b \ A) g := by
  apply measureReal_mono
  · intro x hx
    obtain ⟨hxI, hxA⟩ := hx
    have hnotA : x ∉ A := (not_or.mp hxA).1
    have hnotAg : x - g ∉ A := (not_or.mp hxA).2
    refine ⟨⟨⟨?_, ?_⟩, hnotA⟩, ⟨⟨?_, ?_⟩, hnotAg⟩⟩
    all_goals linarith [hxI.1, hxI.2, hg.1, hg.2]
  · exact measure_ne_top_of_subset
      (Set.inter_subset_left.trans Set.sdiff_subset) isCompact_Icc.measure_ne_top

/-- Quadratic hole filling for a nonnegative shift density supported in
`[-w,w]` and bounded by `2 / w`. Both the expectation and its integrability
are proved from the density and the measurable covered set. -/
theorem translation_hole_filling {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w) :
    Integrable (fun g ↦ f g * remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g) ∧
      (∫ g : ℝ, f g * remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g) ≤
        2 * (volume.real (Set.Icc a b \ A)) ^ 2 / w := by
  let E := Set.Icc a b \ A
  have hE : MeasurableSet E := measurableSet_Icc.diff hA
  have hfinite : volume E ≠ ∞ :=
    measure_ne_top_of_subset Set.sdiff_subset isCompact_Icc.measure_ne_top
  have hcoeff : 0 ≤ (2 : ℝ) / w := (div_pos (by norm_num) hw).le
  have hmajor : ∀ g, f g * remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g ≤
      (2 / w) * translationOverlap E g := by
    intro g
    by_cases hg : g ∈ Set.Icc (-w) w
    · exact mul_le_mul (hfbound g) (remainingHoleMeasure_trim_le hw.le hg)
        (remainingHoleMeasure_nonneg _ _ _) hcoeff
    · rw [hfsupp g hg, zero_mul]
      exact mul_nonneg hcoeff (translationOverlap_nonneg E g)
  have hnonneg : ∀ g, 0 ≤ f g * remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g :=
    fun g ↦ mul_nonneg (hf0 g) (remainingHoleMeasure_nonneg _ _ _)
  have hupper := (integrable_translationOverlap hE hfinite).const_mul (2 / w)
  have hlower := hupper.mono_nonneg
    (hf.mul (measurable_remainingHoleMeasure hA measurableSet_Icc)).aestronglyMeasurable
    (Filter.Eventually.of_forall hnonneg) (Filter.Eventually.of_forall hmajor)
  refine ⟨hlower, ?_⟩
  calc
    _ ≤ ∫ g : ℝ, (2 / w) * translationOverlap E g :=
      integral_mono hlower hupper hmajor
    _ = (2 / w) * (volume.real E) ^ 2 := by
      rw [integral_const_mul, integral_translationOverlap hE hfinite]
    _ = _ := by ring

noncomputable def translationShiftLaw (f : ℝ → ℝ) : Measure ℝ :=
  volume.withDensity (fun g ↦ ENNReal.ofReal (f g))

theorem translationShiftLaw_isProbability (f : ℝ → ℝ)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    IsProbabilityMeasure (translationShiftLaw f) := by
  constructor
  rw [translationShiftLaw, withDensity_apply _ MeasurableSet.univ,
    Measure.restrict_univ]
  exact hmass

/-- The same estimate as an expectation under the shift's density measure. -/
theorem translation_hole_filling_withDensity {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w) :
    Integrable (remainingHoleMeasure A (Set.Icc (a + w) (b - w))) (translationShiftLaw f) ∧
      (∫ g : ℝ, remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g
        ∂ translationShiftLaw f) ≤ 2 * (volume.real (Set.Icc a b \ A)) ^ 2 / w := by
  have hmain := translation_hole_filling hA hw hf hf0 hfsupp hfbound (a := a) (b := b)
  have hfinite : ∀ᵐ g : ℝ ∂ volume, ENNReal.ofReal (f g) < ∞ :=
    Filter.Eventually.of_forall (fun g ↦ ENNReal.ofReal_lt_top)
  have hreal : ∀ g, (ENNReal.ofReal (f g)).toReal = f g :=
    fun g ↦ ENNReal.toReal_ofReal (hf0 g)
  constructor
  · rw [translationShiftLaw, integrable_withDensity_iff hf.ennreal_ofReal hfinite]
    simpa only [hreal, mul_comm] using hmain.1
  · rw [translationShiftLaw,
      integral_withDensity_eq_integral_toReal_smul hf.ennreal_ofReal hfinite]
    simpa only [hreal, smul_eq_mul] using hmain.2

/-- Markov's inequality for the actual shifted-hole random variable. -/
theorem translation_hole_filling_tail_bound {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w) {r : ℝ} (hr : 0 < r) :
    (translationShiftLaw f).real {g | r ≤
      remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g} ≤
      (2 * (volume.real (Set.Icc a b \ A)) ^ 2 / w) / r := by
  have hmain := translation_hole_filling_withDensity hA hw hf hf0 hfsupp hfbound
    (a := a) (b := b)
  have hmarkov := mul_meas_ge_le_integral_of_nonneg
    (Filter.Eventually.of_forall (remainingHoleMeasure_nonneg A (Set.Icc (a + w) (b - w))))
    hmain.1 r
  apply (le_div_iff₀ hr).mpr
  simpa only [mul_comm] using hmarkov.trans hmain.2

end Erdos859Verification

end

/- Inlined development module: TranslationHoleIteration.lean -/

section

/- Successful translations and the doubly exponential quadratic-hole recurrence. -/

open MeasureTheory Real
open scoped ENNReal

namespace Erdos859Verification

/-- The exact exponent retained by the quadratic recurrence. -/
def quadraticHoleExponent (n : ℕ) : ℕ := 3 * 2 ^ n + n + 7

theorem quadraticHole_step_identity (n : ℕ) :
    (2 : ℝ) ^ (n + 6) * (1 / (2 : ℝ) ^ quadraticHoleExponent n) ^ 2 =
      1 / (2 : ℝ) ^ quadraticHoleExponent (n + 1) := by
  have he : quadraticHoleExponent (n + 1) + (n + 6) = quadraticHoleExponent n * 2 := by
    simp only [quadraticHoleExponent, pow_succ]
    omega
  have hp : (2 : ℝ) ^ quadraticHoleExponent (n + 1) * (2 : ℝ) ^ (n + 6) =
      ((2 : ℝ) ^ quadraticHoleExponent n) ^ 2 := by
    rw [← pow_add, he, pow_mul]
  have hpos : 0 < (2 : ℝ) ^ quadraticHoleExponent n := by positivity
  have hpos' : 0 < (2 : ℝ) ^ quadraticHoleExponent (n + 1) := by positivity
  field_simp
  nlinarith

/-- A stronger closed bound includes the unused linear part of the exponent. -/
theorem quadraticHole_recurrence_strong {e : ℕ → ℝ}
    (he : ∀ n, 0 ≤ e n) (hzero : e 0 ≤ 1 / (2 : ℝ) ^ 10)
    (hstep : ∀ n, e (n + 1) ≤ (2 : ℝ) ^ (n + 6) * (e n) ^ 2) :
    ∀ n, e n ≤ 1 / (2 : ℝ) ^ quadraticHoleExponent n := by
  intro n
  induction n with
  | zero => simpa only [quadraticHoleExponent, pow_zero, Nat.mul_one, Nat.add_zero] using hzero
  | succ n ih =>
      calc
        e (n + 1) ≤ (2 : ℝ) ^ (n + 6) * (e n) ^ 2 := hstep n
        _ ≤ (2 : ℝ) ^ (n + 6) * (1 / (2 : ℝ) ^ quadraticHoleExponent n) ^ 2 :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (he n) ih 2) (by positivity)
        _ = _ := quadraticHole_step_identity n

/-- The manuscript's normalized holes decrease doubly exponentially. -/
theorem quadraticHole_recurrence {e : ℕ → ℝ}
    (he : ∀ n, 0 ≤ e n) (hzero : e 0 ≤ 1 / (2 : ℝ) ^ 10)
    (hstep : ∀ n, e (n + 1) ≤ (2 : ℝ) ^ (n + 6) * (e n) ^ 2) :
    ∀ n, e n ≤ 1 / (2 : ℝ) ^ (3 * 2 ^ n) := by
  intro n
  apply (quadraticHole_recurrence_strong he hzero hstep n).trans
  exact one_div_le_one_div_of_le (by positivity)
    (pow_le_pow_right₀ (by norm_num) (by dsimp [quadraticHoleExponent]; omega))

theorem translationShiftLaw_outside_support {f : ℝ → ℝ} {w : ℝ}
    (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0) :
    translationShiftLaw f (Set.Icc (-w) w)ᶜ = 0 := by
  rw [translationShiftLaw, withDensity_apply _ measurableSet_Icc.compl]
  apply setLIntegral_eq_zero measurableSet_Icc.compl
  intro g hg
  simp only [hfsupp g hg, ENNReal.ofReal_zero, Pi.zero_apply]

/-- First-moment selection supplies a shift in the allowed interval, including
when the original missing measure is zero. The factor two is stronger than
the factor four needed in the recurrence. -/
theorem exists_successful_hole_shift {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    ∃ g ∈ Set.Icc (-w) w,
      remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g ≤
        2 * (volume.real (Set.Icc a b \ A)) ^ 2 / w := by
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hmain := translation_hole_filling_withDensity hA hw hf hf0 hfsupp hfbound
    (a := a) (b := b)
  obtain ⟨g, hg, hgood⟩ := exists_notMem_null_le_integral hmain.1
    (translationShiftLaw_outside_support hfsupp)
  exact ⟨g, by simpa only [Set.mem_compl_iff, not_not] using hg, hgood.trans hmain.2⟩

theorem exists_successful_hole_shift_four {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    ∃ g ∈ Set.Icc (-w) w,
      remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g ≤
        4 * (volume.real (Set.Icc a b \ A)) ^ 2 / w := by
  obtain ⟨g, hg, hgood⟩ := exists_successful_hole_shift hA hw hf hf0 hfsupp hfbound hmass
    (a := a) (b := b)
  refine ⟨g, hg, hgood.trans ?_⟩
  apply div_le_div_of_nonneg_right _ hw.le
  nlinarith [sq_nonneg (volume.real (Set.Icc a b \ A))]

/-- Width at the transition from step `n` to step `n + 1`; the manuscript
labels this transition by `i = n + 1`. -/
noncomputable def quadraticHoleWidth (ell : ℝ) (n : ℕ) : ℝ := ell / (2 : ℝ) ^ (n + 4)

theorem quadraticHoleWidth_pos {ell : ℝ} (hell : 0 < ell) (n : ℕ) :
    0 < quadraticHoleWidth ell n := by
  unfold quadraticHoleWidth
  positivity

/-- Dividing physical missing measure by `ell` gives exactly the coefficient
used in the normalized quadratic recurrence. -/
theorem quadraticHole_step_normalize {ell b b' : ℝ} (hell : 0 < ell) (n : ℕ)
    (hstep : b' ≤ 4 * b ^ 2 / quadraticHoleWidth ell n) :
    b' / ell ≤ (2 : ℝ) ^ (n + 6) * (b / ell) ^ 2 := by
  apply (div_le_div_of_nonneg_right hstep hell.le).trans_eq
  rw [quadraticHoleWidth, show n + 6 = (n + 4) + 2 by omega, pow_add]
  norm_num
  field_simp
  simp only [pow_add]
  norm_num
  ring

/-- The same doubly exponential estimate for physical missing measures. -/
theorem quadraticHole_actual_recurrence {ell : ℝ} (hell : 0 < ell) {b : ℕ → ℝ}
    (hb : ∀ n, 0 ≤ b n) (hzero : b 0 ≤ ell / (2 : ℝ) ^ 10)
    (hstep : ∀ n, b (n + 1) ≤ 4 * (b n) ^ 2 / quadraticHoleWidth ell n) :
    ∀ n, b n ≤ ell / (2 : ℝ) ^ (3 * 2 ^ n) := by
  have hzero' : b 0 / ell ≤ 1 / (2 : ℝ) ^ 10 := by
    apply (div_le_iff₀ hell).mpr
    simpa only [div_eq_mul_inv, one_mul, mul_comm] using hzero
  have hnormalized := quadraticHole_recurrence
    (fun n ↦ div_nonneg (hb n) hell.le) hzero'
    (fun n ↦ quadraticHole_step_normalize hell n (hstep n))
  intro n
  have hn := (div_le_iff₀ hell).mp (hnormalized n)
  simpa only [div_eq_mul_inv, one_mul, mul_comm] using hn

noncomputable def quadraticHoleTrim (ell : ℝ) (n : ℕ) : ℝ :=
  ∑ i ∈ Finset.range n, quadraticHoleWidth ell i

theorem quadraticHoleTrim_zero (ell : ℝ) : quadraticHoleTrim ell 0 = 0 := by
  simp only [quadraticHoleTrim, Finset.range_zero, Finset.sum_empty]

theorem quadraticHoleTrim_succ (ell : ℝ) (n : ℕ) :
    quadraticHoleTrim ell (n + 1) = quadraticHoleTrim ell n + quadraticHoleWidth ell n :=
  Finset.sum_range_succ _ n

/-- A certificate retaining the actual finite sequence of union-with-translate steps. -/
inductive QuadraticHoleRefinement (ell : ℝ) (A : Set ℝ) : ℕ → Set ℝ → Prop where
  | initial : QuadraticHoleRefinement ell A 0 A
  | step {n : ℕ} {S : Set ℝ} (hprev : QuadraticHoleRefinement ell A n S)
      (g : ℝ) (hg : g ∈ Set.Icc (-quadraticHoleWidth ell n) (quadraticHoleWidth ell n)) :
      QuadraticHoleRefinement ell A (n + 1) (S ∪ realTranslateSet S g)

/-- Any finite number of refinement steps can be realized by allowed shifts.
The statement retains the generated covered set and the exact trimmed interval. -/
theorem exists_finite_quadratic_hole_refinement {ell : ℝ} (hell : 0 < ell)
    {A : Set ℝ} (hA : MeasurableSet A) {a b : ℝ}
    (hstart : volume.real (Set.Icc a b \ A) ≤ ell / (2 : ℝ) ^ 10)
    (f : ℕ → ℝ → ℝ) (hf : ∀ n, Measurable (f n)) (hf0 : ∀ n g, 0 ≤ f n g)
    (hfsupp : ∀ n g, g ∉ Set.Icc (-quadraticHoleWidth ell n) (quadraticHoleWidth ell n) →
      f n g = 0)
    (hfbound : ∀ n g, f n g ≤ 2 / quadraticHoleWidth ell n)
    (hmass : ∀ n, (∫⁻ g : ℝ, ENNReal.ofReal (f n g)) = 1) :
    ∀ n : ℕ, ∃ S : Set ℝ, MeasurableSet S ∧ QuadraticHoleRefinement ell A n S ∧
      volume.real (Set.Icc (a + quadraticHoleTrim ell n) (b - quadraticHoleTrim ell n) \ S) ≤
        ell / (2 : ℝ) ^ quadraticHoleExponent n := by
  intro n
  induction n with
  | zero =>
      refine ⟨A, hA, QuadraticHoleRefinement.initial, ?_⟩
      simpa only [quadraticHoleTrim_zero, add_zero, sub_zero,
        quadraticHoleExponent, pow_zero, Nat.mul_one, Nat.add_zero] using hstart
  | succ n ih =>
      obtain ⟨S, hS, hpath, hholes⟩ := ih
      obtain ⟨g, hg, hnew⟩ := exists_successful_hole_shift_four hS
        (quadraticHoleWidth_pos hell n) (hf n) (hf0 n) (hfsupp n) (hfbound n) (hmass n)
        (a := a + quadraticHoleTrim ell n) (b := b - quadraticHoleTrim ell n)
      refine ⟨S ∪ realTranslateSet S g, hS.union (measurableSet_realTranslateSet hS g),
        QuadraticHoleRefinement.step hpath g hg, ?_⟩
      have hold : volume.real
          (Set.Icc (a + quadraticHoleTrim ell n) (b - quadraticHoleTrim ell n) \ S) / ell ≤
          1 / (2 : ℝ) ^ quadraticHoleExponent n := by
        apply (div_le_iff₀ hell).mpr
        simpa only [div_eq_mul_inv, one_mul, mul_comm] using hholes
      have hnewnorm := quadraticHole_step_normalize hell n hnew
      have hbound : remainingHoleMeasure S
          (Set.Icc ((a + quadraticHoleTrim ell n) + quadraticHoleWidth ell n)
            ((b - quadraticHoleTrim ell n) - quadraticHoleWidth ell n)) g / ell ≤
          1 / (2 : ℝ) ^ quadraticHoleExponent (n + 1) := by
        apply hnewnorm.trans
        calc
          _ ≤ (2 : ℝ) ^ (n + 6) * (1 / (2 : ℝ) ^ quadraticHoleExponent n) ^ 2 :=
            mul_le_mul_of_nonneg_left
              (pow_le_pow_left₀ (div_nonneg measureReal_nonneg hell.le) hold 2) (by positivity)
          _ = _ := quadraticHole_step_identity n
      have hphysical := (div_le_iff₀ hell).mp hbound
      have haeq : a + quadraticHoleTrim ell (n + 1) =
          (a + quadraticHoleTrim ell n) + quadraticHoleWidth ell n := by
        rw [quadraticHoleTrim_succ]
        ring
      have hbeq : b - quadraticHoleTrim ell (n + 1) =
          (b - quadraticHoleTrim ell n) - quadraticHoleWidth ell n := by
        rw [quadraticHoleTrim_succ]
        ring
      rw [haeq, hbeq]
      simpa only [remainingHoleMeasure, div_eq_mul_inv, one_mul, mul_comm] using hphysical

end Erdos859Verification

end

/- Inlined development module: TranslationInitialCoverage.lean -/

section

/- Initial coverage by translations with a uniformly positive density. -/

open MeasureTheory Real
open scoped ENNReal

namespace Erdos859Verification

noncomputable def crossTranslationOverlap (E B : Set ℝ) (g : ℝ) : ℝ :=
  volume.real (E ∩ realTranslateSet B g)

theorem measurable_crossTranslationOverlap {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) :
    Measurable (crossTranslationOverlap E B) := by
  let S : Set (ℝ × ℝ) := {z | z.2 ∈ E ∧ z.2 - z.1 ∈ B}
  have hS : MeasurableSet S := (hE.preimage measurable_snd).inter
    (hB.preimage (measurable_snd.sub measurable_fst))
  have heq : crossTranslationOverlap E B = fun g ↦ volume.real (Prod.mk g ⁻¹' S) := rfl
  rw [heq]
  exact (measurable_measure_prodMk_left hS).ennreal_toReal

theorem crossTranslationOverlap_eq_convolution {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) :
    crossTranslationOverlap E B = convolution (E.indicator (fun _ ↦ (1 : ℝ)))
      (fun x ↦ B.indicator (fun _ ↦ (1 : ℝ)) (-x))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
  classical
  funext g
  have hs := hE.inter (measurableSet_realTranslateSet hB g)
  rw [crossTranslationOverlap, ← integral_indicator_one hs, convolution_def]
  apply integral_congr_ae
  filter_upwards [] with x
  by_cases hx : x ∈ E <;> by_cases hxg : x - g ∈ B <;>
    simp [realTranslateSet, hx, hxg, neg_sub]

theorem integrable_crossTranslationOverlap {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B)
    (hEfin : volume E ≠ ∞) (hBfin : volume B ≠ ∞) :
    Integrable (crossTranslationOverlap E B) := by
  have he : Integrable (E.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hEfin).integrable_indicator hE
  have hb : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hBfin).integrable_indicator hB
  rw [crossTranslationOverlap_eq_convolution hE hB]
  exact he.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hb.comp_neg

theorem integral_crossTranslationOverlap {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B)
    (hEfin : volume E ≠ ∞) (hBfin : volume B ≠ ∞) :
    (∫ g : ℝ, crossTranslationOverlap E B g) = volume.real E * volume.real B := by
  have he : Integrable (E.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hEfin).integrable_indicator hE
  have hb : Integrable (B.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hBfin).integrable_indicator hB
  rw [crossTranslationOverlap_eq_convolution hE hB,
    integral_convolution (ContinuousLinearMap.lsmul ℝ ℝ) he hb.comp_neg,
    integral_neg_eq_self]
  simp only [integral_indicator hE, integral_indicator hB, setIntegral_const,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul, mul_one]

theorem crossTranslationOverlap_le {E B : Set ℝ} (hEfin : volume E ≠ ∞) (g : ℝ) :
    crossTranslationOverlap E B g ≤ volume.real E :=
  measureReal_mono Set.inter_subset_left hEfin

theorem crossTranslationOverlap_zero_outside {E B : Set ℝ} {L g : ℝ}
    (hEI : E ⊆ Set.Icc 0 L) (hBI : B ⊆ Set.Icc 0 L)
    (hg : g ∉ Set.Icc (-L) L) : crossTranslationOverlap E B g = 0 := by
  have hs : E ∩ realTranslateSet B g = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro x hx
    have hxE := hEI hx.1
    have hxB := hBI hx.2
    apply hg
    constructor <;> linarith [hxE.1, hxE.2, hxB.1, hxB.2]
  simp only [crossTranslationOverlap, hs, measureReal_empty]

theorem missing_after_translate_eq {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) (hEfin : volume E ≠ ∞) (g : ℝ) :
    volume.real (E \ realTranslateSet B g) = volume.real E - crossTranslationOverlap E B g := by
  have hs : E \ realTranslateSet B g = E \ (E ∩ realTranslateSet B g) := by
    ext x
    simp only [Set.mem_sdiff, Set.mem_inter_iff]
    tauto
  rw [hs]
  exact measureReal_sdiff Set.inter_subset_left
    (hE.inter (measurableSet_realTranslateSet hB g)) hEfin

/-- Exact contraction of missing measure. No independence or expectation
bound is assumed: the estimate follows from the density lower bound and
the cross-correlation integral. -/
theorem initialCoverage_expectation_contraction {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) {L c : ℝ}
    (hEI : E ⊆ Set.Icc 0 L) (hBI : B ⊆ Set.Icc 0 L)
    {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hflower : ∀ g ∈ Set.Icc (-L) L, c / L ≤ f g)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    Integrable (fun g ↦ volume.real (E \ realTranslateSet B g)) (translationShiftLaw f) ∧
      (∫ g : ℝ, volume.real (E \ realTranslateSet B g) ∂ translationShiftLaw f) ≤
        (1 - c * volume.real B / L) * volume.real E := by
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hEfin : volume E ≠ ∞ := measure_ne_top_of_subset hEI isCompact_Icc.measure_ne_top
  have hBfin : volume B ≠ ∞ := measure_ne_top_of_subset hBI isCompact_Icc.measure_ne_top
  have hmeas := measurable_crossTranslationOverlap hE hB
  have hcross : Integrable (crossTranslationOverlap E B) (translationShiftLaw f) :=
    (integrable_const (volume.real E)).mono_nonneg hmeas.aestronglyMeasurable
      (Filter.Eventually.of_forall (fun _ ↦ measureReal_nonneg))
      (Filter.Eventually.of_forall (crossTranslationOverlap_le hEfin))
  have hfinite : ∀ᵐ g : ℝ ∂ volume, ENNReal.ofReal (f g) < ∞ :=
    Filter.Eventually.of_forall (fun _ ↦ ENNReal.ofReal_lt_top)
  have hreal : ∀ g, (ENNReal.ofReal (f g)).toReal = f g :=
    fun g ↦ ENNReal.toReal_ofReal (hf0 g)
  have hweighted : Integrable (fun g ↦ f g * crossTranslationOverlap E B g) := by
    have h := (integrable_withDensity_iff hf.ennreal_ofReal hfinite).mp hcross
    simpa only [hreal, mul_comm] using h
  have hlow : (c / L) * (volume.real E * volume.real B) ≤
      ∫ g : ℝ, crossTranslationOverlap E B g ∂ translationShiftLaw f := by
    rw [translationShiftLaw,
      integral_withDensity_eq_integral_toReal_smul hf.ennreal_ofReal hfinite]
    simp only [hreal, smul_eq_mul]
    calc
      _ = ∫ g : ℝ, (c / L) * crossTranslationOverlap E B g := by
        rw [integral_const_mul, integral_crossTranslationOverlap hE hB hEfin hBfin]
      _ ≤ _ := by
        apply integral_mono ((integrable_crossTranslationOverlap hE hB hEfin hBfin).const_mul _)
          hweighted
        intro g
        change (c / L) * crossTranslationOverlap E B g ≤ f g * crossTranslationOverlap E B g
        by_cases hg : g ∈ Set.Icc (-L) L
        · exact mul_le_mul_of_nonneg_right (hflower g hg) measureReal_nonneg
        · rw [crossTranslationOverlap_zero_outside hEI hBI hg]
          simp only [mul_zero, le_refl]
  have hconst : Integrable (fun _ : ℝ ↦ volume.real E) (translationShiftLaw f) := integrable_const _
  have heq : (fun g ↦ volume.real (E \ realTranslateSet B g)) =
      fun g ↦ volume.real E - crossTranslationOverlap E B g :=
    funext (missing_after_translate_eq hE hB hEfin)
  rw [heq]
  refine ⟨hconst.sub hcross, ?_⟩
  rw [integral_sub hconst hcross, integral_const, probReal_univ, one_smul]
  calc
    _ ≤ volume.real E - (c / L) * (volume.real E * volume.real B) := sub_le_sub_left hlow _
    _ = _ := by ring

theorem exists_initialCoverage_shift {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) {L c rho : ℝ}
    (hEI : E ⊆ Set.Icc 0 L) (hBI : B ⊆ Set.Icc 0 L)
    (hL : 0 < L) (hc : 0 < c) (hrho : 0 < rho)
    (hBvol : rho * L ≤ volume.real B) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hflower : ∀ g ∈ Set.Icc (-L) L, c / L ≤ f g)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    ∃ g ∈ Set.Icc (-L) L,
      volume.real (E \ realTranslateSet B g) ≤ (1 - c * rho) * volume.real E := by
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hEfin : volume E ≠ ∞ := measure_ne_top_of_subset hEI isCompact_Icc.measure_ne_top
  by_cases hzero : volume.real E = 0
  · refine ⟨0, ⟨by linarith, hL.le⟩, ?_⟩
    have hle := measureReal_mono (Set.sdiff_subset (s := E) (t := realTranslateSet B 0)) hEfin
    simpa only [hzero, mul_zero] using hle
  have hEpos : 0 < volume.real E := lt_of_le_of_ne measureReal_nonneg (Ne.symm hzero)
  have hmain := initialCoverage_expectation_contraction hE hB hEI hBI hf hf0 hflower hmass
  obtain ⟨g, hg⟩ := exists_le_integral hmain.1
  have hprob : c * rho ≤ c * volume.real B / L := by
    apply (le_div_iff₀ hL).mpr
    nlinarith [mul_le_mul_of_nonneg_left hBvol hc.le]
  have hgood : volume.real (E \ realTranslateSet B g) ≤ (1 - c * rho) * volume.real E :=
    (hg.trans hmain.2).trans
      (mul_le_mul_of_nonneg_right (sub_le_sub_left hprob 1) measureReal_nonneg)
  refine ⟨g, ?_, hgood⟩
  by_contra hout
  have heq := missing_after_translate_eq hE hB hEfin g
  rw [crossTranslationOverlap_zero_outside hEI hBI hout, sub_zero] at heq
  rw [heq] at hgood
  have hpos := mul_pos (mul_pos hc hrho) hEpos
  nlinarith

/-- A finite list of translations of the same base set, retaining every
translation's allowed range. -/
inductive InitialCoverageByTranslates (L : ℝ) (B : Set ℝ) : ℕ → Set ℝ → Prop where
  | initial : InitialCoverageByTranslates L B 0 B
  | step {n : ℕ} {A : Set ℝ} (hprev : InitialCoverageByTranslates L B n A)
      (g : ℝ) (hg : g ∈ Set.Icc (-L) L) :
      InitialCoverageByTranslates L B (n + 1) (A ∪ realTranslateSet B g)

theorem InitialCoverageByTranslates.base_subset {L : ℝ} {B A : Set ℝ} {n : ℕ}
    (h : InitialCoverageByTranslates L B n A) : B ⊆ A := by
  induction h with
  | initial => exact Set.Subset.rfl
  | step _ _ _ ih => exact ih.trans Set.subset_union_left

/-- Finite initial coverage with its exact geometric error bound. -/
theorem exists_initialCoverage_finite {L c rho : ℝ} (hL : 0 < L)
    (hc : 0 < c) (hrho : 0 < rho) (hprod : c * rho < 1)
    {B : Set ℝ} (hB : MeasurableSet B) (hBI : B ⊆ Set.Icc 0 L)
    (hBvol : rho * L ≤ volume.real B) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hflower : ∀ g ∈ Set.Icc (-L) L, c / L ≤ f g)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    ∀ n : ℕ, ∃ A : Set ℝ, MeasurableSet A ∧ InitialCoverageByTranslates L B n A ∧
      volume.real (Set.Icc 0 L \ A) ≤ (1 - c * rho) ^ n * L := by
  intro n
  induction n with
  | zero =>
      refine ⟨B, hB, InitialCoverageByTranslates.initial, ?_⟩
      have hle := measureReal_mono (μ := volume) (Set.sdiff_subset (s := Set.Icc 0 L) (t := B))
        isCompact_Icc.measure_ne_top
      simpa only [volume_real_Icc_of_le hL.le, sub_zero, pow_zero, one_mul] using hle
  | succ n ih =>
      obtain ⟨A, hA, hpath, hholes⟩ := ih
      obtain ⟨g, hg, hnew⟩ := exists_initialCoverage_shift (measurableSet_Icc.diff hA) hB
        Set.sdiff_subset hBI hL hc hrho hBvol hf hf0 hflower hmass
      refine ⟨A ∪ realTranslateSet B g, hA.union (measurableSet_realTranslateSet hB g),
        InitialCoverageByTranslates.step hpath g hg, ?_⟩
      have heq : Set.Icc 0 L \ (A ∪ realTranslateSet B g) =
          (Set.Icc 0 L \ A) \ realTranslateSet B g := by
        ext x
        simp only [Set.mem_sdiff, Set.mem_union, not_or]
        tauto
      rw [heq]
      calc
        _ ≤ (1 - c * rho) * volume.real (Set.Icc 0 L \ A) := hnew
        _ ≤ (1 - c * rho) * ((1 - c * rho) ^ n * L) :=
          mul_le_mul_of_nonneg_left hholes (by linarith)
        _ = _ := by rw [pow_succ]; ring

/-- A number of initial translates depending only on `c` and `rho` leaves
at most `2^-10` of the interval uncovered, uniformly in its length and base set. -/
theorem exists_uniform_initialCoverage_steps {c rho : ℝ}
    (hc : 0 < c) (hrho : 0 < rho) (hprod : c * rho < 1) :
    ∃ n : ℕ, ∀ L : ℝ, 0 < L → ∀ B : Set ℝ,
      MeasurableSet B → B ⊆ Set.Icc 0 L → rho * L ≤ volume.real B →
      ∀ f : ℝ → ℝ, Measurable f → (∀ g, 0 ≤ f g) →
      (∀ g ∈ Set.Icc (-L) L, c / L ≤ f g) →
      (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1 →
      ∃ A : Set ℝ, MeasurableSet A ∧ InitialCoverageByTranslates L B n A ∧
        volume.real (Set.Icc 0 L \ A) ≤ L / (2 : ℝ) ^ 10 := by
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (by positivity : (0 : ℝ) < 1 / (2 : ℝ) ^ 10)
    (by nlinarith [mul_pos hc hrho] : 1 - c * rho < 1)
  refine ⟨n, ?_⟩
  intro L hL B hB hBI hBvol f hf hf0 hflower hmass
  obtain ⟨A, hA, hpath, hholes⟩ :=
    exists_initialCoverage_finite hL hc hrho hprod hB hBI hBvol hf hf0 hflower hmass n
  refine ⟨A, hA, hpath, hholes.trans ?_⟩
  simpa only [div_eq_mul_inv, one_mul, mul_comm] using
    mul_le_mul_of_nonneg_right hn.le hL.le

/-- Each point of the interval is hit with the probability predicted by the
base-set measure and the density lower bound. -/
theorem initialCoverage_point_probability {B : Set ℝ} (hB : MeasurableSet B)
    {L c x : ℝ} (hBI : B ⊆ Set.Icc 0 L) (hx : x ∈ Set.Icc 0 L)
    {f : ℝ → ℝ} (hf : Measurable f) (hf0 : ∀ g, 0 ≤ f g)
    (hflower : ∀ g ∈ Set.Icc (-L) L, c / L ≤ f g)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    c * volume.real B / L ≤ (translationShiftLaw f).real {g | x ∈ realTranslateSet B g} := by
  classical
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  let H : Set ℝ := {g | x ∈ realTranslateSet B g}
  have hH : MeasurableSet H := hB.preimage (measurable_const.sub measurable_id)
  have hHI : H ⊆ Set.Icc (-L) L := by
    intro g hg
    have hb := hBI hg
    constructor <;> linarith [hx.1, hx.2, hb.1, hb.2]
  have hHfin : volume H ≠ ∞ := measure_ne_top_of_subset hHI isCompact_Icc.measure_ne_top
  have hi : Integrable (H.indicator (fun _ ↦ (1 : ℝ))) :=
    (integrableOn_const (C := (1 : ℝ)) hHfin).integrable_indicator hH
  have hiLaw : Integrable (H.indicator (fun _ ↦ (1 : ℝ))) (translationShiftLaw f) :=
    (integrable_const _).indicator hH
  have hfinite : ∀ᵐ g : ℝ ∂ volume, ENNReal.ofReal (f g) < ∞ :=
    Filter.Eventually.of_forall (fun _ ↦ ENNReal.ofReal_lt_top)
  have hreal : ∀ g, (ENNReal.ofReal (f g)).toReal = f g :=
    fun g ↦ ENNReal.toReal_ofReal (hf0 g)
  have hweighted : Integrable (fun g ↦ f g * H.indicator (fun _ ↦ (1 : ℝ)) g) := by
    have h := (integrable_withDensity_iff hf.ennreal_ofReal hfinite).mp hiLaw
    simpa only [hreal, mul_comm] using h
  have heq : H.indicator (fun _ ↦ (1 : ℝ)) =
      fun g ↦ B.indicator (fun _ ↦ (1 : ℝ)) (x - g) := by
    funext g
    by_cases hg : x - g ∈ B <;> simp [H, realTranslateSet, hg]
  have hIntegral : (∫ g : ℝ, H.indicator (fun _ ↦ (1 : ℝ)) g) = volume.real B := by
    rw [heq, integral_sub_left_eq_self]
    simpa only [smul_eq_mul, mul_one] using integral_indicator_const (μ := volume) (1 : ℝ) hB
  have hIntegralLaw : (∫ g : ℝ, f g * H.indicator (fun _ ↦ (1 : ℝ)) g) =
      (translationShiftLaw f).real H := by
    have h := integral_withDensity_eq_integral_toReal_smul hf.ennreal_ofReal hfinite
      (H.indicator (fun _ ↦ (1 : ℝ)))
    simp only [hreal, smul_eq_mul] at h
    rw [← h]
    simpa only [translationShiftLaw, smul_eq_mul, mul_one] using
      integral_indicator_const (μ := translationShiftLaw f) (1 : ℝ) hH
  calc
    _ = (c / L) * volume.real B := by ring
    _ = ∫ g : ℝ, (c / L) * H.indicator (fun _ ↦ (1 : ℝ)) g := by
      rw [integral_const_mul, hIntegral]
    _ ≤ ∫ g : ℝ, f g * H.indicator (fun _ ↦ (1 : ℝ)) g := by
      apply integral_mono (hi.const_mul _) hweighted
      intro g
      change (c / L) * H.indicator (fun _ ↦ (1 : ℝ)) g ≤
        f g * H.indicator (fun _ ↦ (1 : ℝ)) g
      by_cases hg : g ∈ H
      · simpa only [Set.indicator_of_mem hg, mul_one] using hflower g (hHI hg)
      · simp only [Set.indicator_of_notMem hg, mul_zero, le_refl]
    _ = _ := hIntegralLaw

end Erdos859Verification

end

/- Inlined development module: LogUniformPairDensity.lean -/

section

/- Concrete logarithmic mark densities and their pair-difference laws. -/

open MeasureTheory Real
open scoped ENNReal

namespace Erdos859Verification

noncomputable def logUniformDensity (u w v : ℝ) : ℝ :=
  (Set.Icc u (u + w)).indicator (fun v ↦ 1 / (v * log (1 + w / u))) v

theorem measurable_logUniformDensity (u w : ℝ) : Measurable (logUniformDensity u w) := by
  unfold logUniformDensity
  exact (measurable_const.div (measurable_id.mul measurable_const)).indicator measurableSet_Icc

theorem logUniform_log_bounds {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    0 < log (1 + w / u) ∧ w / (u + w) ≤ log (1 + w / u) ∧
      log (1 + w / u) ≤ w / u := by
  have hu : 0 < u := hw.trans_le hwu
  have hr : 0 < w / u := div_pos hw hu
  have harg : 0 < 1 + w / u := by linarith
  refine ⟨log_pos (by linarith), ?_, ?_⟩
  · have h := one_sub_inv_le_log_of_pos harg
    have heq : 1 - (1 + w / u)⁻¹ = w / (u + w) := by
      field_simp
      ring
    rwa [heq] at h
  · have h := log_le_sub_one_of_pos harg
    linarith

theorem logUniformDensity_bounds {u w v : ℝ} (hw : 0 < w) (hwu : w ≤ u)
    (hv : v ∈ Set.Icc u (u + w)) :
    1 / (2 * w) ≤ logUniformDensity u w v ∧ logUniformDensity u w v ≤ 2 / w := by
  have hu : 0 < u := hw.trans_le hwu
  obtain ⟨hlog, hlo, hhi⟩ := logUniform_log_bounds hw hwu
  have hden : 0 < v * log (1 + w / u) := mul_pos (hu.trans_le hv.1) hlog
  have hdenhi : v * log (1 + w / u) ≤ 2 * w := by
    have h := (le_div_iff₀ hu).mp hhi
    nlinarith [mul_le_mul_of_nonneg_right (show v ≤ 2 * u by linarith [hv.2]) hlog.le]
  have hdenlo : w / 2 ≤ v * log (1 + w / u) := by
    have h := (div_le_iff₀ (add_pos hu hw)).mp hlo
    nlinarith [mul_le_mul_of_nonneg_right (show u + w ≤ 2 * v by linarith [hv.1]) hlog.le]
  simp only [logUniformDensity, Set.indicator_of_mem hv]
  constructor
  · exact one_div_le_one_div_of_le hden hdenhi
  · calc
      _ ≤ 1 / (w / 2) := one_div_le_one_div_of_le (half_pos hw) hdenlo
      _ = _ := by field_simp

theorem logUniformDensity_nonneg {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) (v : ℝ) :
    0 ≤ logUniformDensity u w v := by
  by_cases hv : v ∈ Set.Icc u (u + w)
  · exact (by positivity : (0 : ℝ) ≤ 1 / (2 * w)).trans (logUniformDensity_bounds hw hwu hv).1
  · simp only [logUniformDensity, Set.indicator_of_notMem hv, le_refl]

theorem logUniformDensity_le {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) (v : ℝ) :
    logUniformDensity u w v ≤ 2 / w := by
  by_cases hv : v ∈ Set.Icc u (u + w)
  · exact (logUniformDensity_bounds hw hwu hv).2
  · simp only [logUniformDensity, Set.indicator_of_notMem hv]
    positivity

theorem logUniformDensity_eq_zero {u w v : ℝ} (hv : v ∉ Set.Icc u (u + w)) :
    logUniformDensity u w v = 0 := Set.indicator_of_notMem hv _

theorem integrable_logUniformDensity {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    Integrable (logUniformDensity u w) := by
  have hmajor : Integrable ((Set.Icc u (u + w)).indicator (fun _ ↦ (2 : ℝ) / w)) :=
    (integrableOn_const isCompact_Icc.measure_ne_top).integrable_indicator measurableSet_Icc
  apply hmajor.mono_nonneg (measurable_logUniformDensity u w).aestronglyMeasurable
    (Filter.Eventually.of_forall (logUniformDensity_nonneg hw hwu))
  filter_upwards [] with v
  by_cases hv : v ∈ Set.Icc u (u + w)
  · simpa only [Set.indicator_of_mem hv] using logUniformDensity_le hw hwu v
  · simp only [logUniformDensity_eq_zero hv, Set.indicator_of_notMem hv, le_refl]

theorem integral_logUniformDensity {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    (∫ v : ℝ, logUniformDensity u w v) = 1 := by
  have hu : 0 < u := hw.trans_le hwu
  have hlog := (logUniform_log_bounds hw hwu).1
  have hfun : (fun v : ℝ ↦ 1 / (v * log (1 + w / u))) =
      fun v ↦ (1 / log (1 + w / u)) * (1 / v) := by funext v; ring
  unfold logUniformDensity
  rw [integral_indicator measurableSet_Icc, hfun, integral_const_mul,
    integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le (by linarith : u ≤ u + w),
    integral_one_div_of_pos hu (add_pos hu hw)]
  have hr : (u + w) / u = 1 + w / u := by field_simp
  rw [hr]
  simp only [one_div, inv_mul_cancel₀ hlog.ne']

theorem lintegral_logUniformDensity {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    (∫⁻ v : ℝ, ENNReal.ofReal (logUniformDensity u w v)) = 1 := by
  rw [← ofReal_integral_eq_lintegral_ofReal (integrable_logUniformDensity hw hwu)
    (Filter.Eventually.of_forall (logUniformDensity_nonneg hw hwu)),
    integral_logUniformDensity hw hwu, ENNReal.ofReal_one]

/-- Density of the difference of two independent draws from `f`. -/
noncomputable def pairDifferenceDensity (f : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ x : ℝ, f x * f (x - t)

theorem pairDifferenceDensity_eq_convolution (f : ℝ → ℝ) :
    pairDifferenceDensity f = convolution f (fun x ↦ f (-x))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
  funext t
  simp only [pairDifferenceDensity, convolution_def, ContinuousLinearMap.lsmul_apply,
    smul_eq_mul, neg_sub]

theorem measurable_pairDifferenceDensity {f : ℝ → ℝ} (hf : Measurable f) :
    Measurable (pairDifferenceDensity f) := by
  exact ((hf.comp measurable_snd).mul
    (hf.comp (measurable_snd.sub measurable_fst))).stronglyMeasurable.integral_prod_right'.measurable

theorem pairDifferenceDensity_nonneg {f : ℝ → ℝ} (hf0 : ∀ x, 0 ≤ f x) (t : ℝ) :
    0 ≤ pairDifferenceDensity f t := integral_nonneg (fun x ↦ mul_nonneg (hf0 x) (hf0 (x - t)))

theorem integrable_pairDifferenceDensity {f : ℝ → ℝ} (hf : Integrable f) :
    Integrable (pairDifferenceDensity f) := by
  rw [pairDifferenceDensity_eq_convolution]
  exact hf.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hf.comp_neg

theorem integral_pairDifferenceDensity {f : ℝ → ℝ} (hf : Integrable f) :
    (∫ t : ℝ, pairDifferenceDensity f t) = (∫ x : ℝ, f x) ^ 2 := by
  rw [pairDifferenceDensity_eq_convolution,
    integral_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hf hf.comp_neg,
    integral_neg_eq_self]
  simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul, pow_two]

theorem integrable_pairDifference_integrand {f : ℝ → ℝ} (hfm : Measurable f)
    (hfi : Integrable f) (hf0 : ∀ x, 0 ≤ f x) {M : ℝ} (hM : ∀ x, f x ≤ M) (t : ℝ) :
    Integrable (fun x ↦ f x * f (x - t)) := by
  apply (hfi.mul_const M).mono_nonneg
    (hfm.mul (hfm.comp (measurable_id.sub measurable_const))).aestronglyMeasurable
    (Filter.Eventually.of_forall (fun x ↦ mul_nonneg (hf0 x) (hf0 (x - t))))
  exact Filter.Eventually.of_forall (fun x ↦ mul_le_mul_of_nonneg_left (hM (x - t)) (hf0 x))

theorem pairDifferenceDensity_le {f : ℝ → ℝ} (hfm : Measurable f)
    (hfi : Integrable f) (hf0 : ∀ x, 0 ≤ f x) (hnorm : (∫ x : ℝ, f x) = 1)
    {M : ℝ} (hM : ∀ x, f x ≤ M) (t : ℝ) : pairDifferenceDensity f t ≤ M := by
  calc
    _ ≤ ∫ x : ℝ, f x * M := integral_mono
      (integrable_pairDifference_integrand hfm hfi hf0 hM t) (hfi.mul_const M)
      (fun x ↦ mul_le_mul_of_nonneg_left (hM (x - t)) (hf0 x))
    _ = _ := by rw [integral_mul_const, hnorm, one_mul]

theorem pairDifferenceDensity_eq_zero_outside {f : ℝ → ℝ} {u w t : ℝ}
    (hsupp : ∀ x, x ∉ Set.Icc u (u + w) → f x = 0)
    (ht : t ∉ Set.Icc (-w) w) : pairDifferenceDensity f t = 0 := by
  have hzero : (fun x ↦ f x * f (x - t)) = fun _ ↦ (0 : ℝ) := by
    funext x
    by_cases hx : x ∈ Set.Icc u (u + w)
    · have hxt : x - t ∉ Set.Icc u (u + w) := by
        intro hxt
        apply ht
        constructor <;> linarith [hx.1, hx.2, hxt.1, hxt.2]
      rw [hsupp (x - t) hxt, mul_zero]
    · rw [hsupp x hx, zero_mul]
  rw [pairDifferenceDensity, hzero, integral_zero]

/-- Interval lower bounds on a density give a triangular lower bound on its
pair-difference density. -/
theorem pairDifferenceDensity_interval_lower {f : ℝ → ℝ} {u w : ℝ} (hw : 0 < w)
    (hfm : Measurable f) (hfi : Integrable f) (hf0 : ∀ x, 0 ≤ f x)
    (hupper : ∀ x, f x ≤ 2 / w)
    (hlower : ∀ x ∈ Set.Icc u (u + w), 1 / (2 * w) ≤ f x) (t : ℝ) :
    max (w - |t|) 0 / (4 * w ^ 2) ≤ pairDifferenceDensity f t := by
  have hlo : ∀ x, intervalSmoothingKernel w u x / 2 ≤ f x := by
    intro x
    by_cases hx : x ∈ Set.Icc u (u + w)
    · simpa only [intervalSmoothingKernel, Set.indicator_of_mem hx, div_div, mul_comm] using hlower x hx
    · simpa only [intervalSmoothingKernel, Set.indicator_of_notMem hx, zero_div] using hf0 x
  have hkernel : ∀ x, intervalSmoothingKernel w (u + t) x = intervalSmoothingKernel w u (x - t) := by
    intro x
    have hm : x ∈ Set.Icc (u + t) (u + t + w) ↔ x - t ∈ Set.Icc u (u + w) := by
      constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]
    simp only [intervalSmoothingKernel, Set.indicator_apply, hm]
  calc
    _ = (1 / 4 : ℝ) * (∫ x : ℝ,
        intervalSmoothingKernel w u x * intervalSmoothingKernel w (u + t) x) := by
      rw [integral_intervalSmoothingKernel_mul]
      have he : u - (u + t) = -t := by ring
      rw [he, abs_neg]
      ring
    _ = ∫ x : ℝ, (1 / 4 : ℝ) *
        (intervalSmoothingKernel w u x * intervalSmoothingKernel w (u + t) x) :=
      (integral_const_mul _ _).symm
    _ ≤ _ := by
      apply integral_mono ((integrable_intervalSmoothingKernel_mul w u (u + t)).const_mul _)
        (integrable_pairDifference_integrand hfm hfi hf0 hupper t)
      intro x
      change (1 / 4 : ℝ) * (intervalSmoothingKernel w u x * intervalSmoothingKernel w (u + t) x) ≤
        f x * f (x - t)
      rw [hkernel]
      have h := mul_le_mul (hlo x) (hlo (x - t))
        (div_nonneg (intervalSmoothingKernel_nonneg hw.le u (x - t)) (by norm_num)) (hf0 x)
      nlinarith

theorem translationShiftLaw_map_neg (f : ℝ → ℝ) :
    (translationShiftLaw f).map Neg.neg = translationShiftLaw (fun x ↦ f (-x)) := by
  classical
  apply Measure.ext
  intro S hS
  simp only [translationShiftLaw]
  rw [Measure.map_apply measurable_neg hS, withDensity_apply _ (hS.preimage measurable_neg),
    withDensity_apply _ hS, ← lintegral_indicator (hS.preimage measurable_neg), ← lintegral_indicator hS]
  have heq : ((Neg.neg ⁻¹' S).indicator (fun x ↦ ENNReal.ofReal (f x))) =
      fun x ↦ S.indicator (fun y ↦ ENNReal.ofReal (f (-y))) (-x) := by
    funext x
    by_cases hx : -x ∈ S <;> simp [hx]
  rw [heq, lintegral_neg_eq_self]

/-- The density is the pushforward of the product law under subtraction. -/
theorem pairDifferenceDensity_map_eq {f : ℝ → ℝ} (hfm : Measurable f)
    (hfi : Integrable f) (hf0 : ∀ x, 0 ≤ f x) (hnorm : (∫ x : ℝ, f x) = 1)
    {M : ℝ} (hM : ∀ x, f x ≤ M) :
    (translationShiftLaw f |>.prod (translationShiftLaw f)).map (fun z : ℝ × ℝ ↦ z.1 - z.2) =
      translationShiftLaw (pairDifferenceDensity f) := by
  have hmass : (∫⁻ x : ℝ, ENNReal.ofReal (f x)) = 1 := by
    rw [← ofReal_integral_eq_lintegral_ofReal hfi (Filter.Eventually.of_forall hf0),
      hnorm, ENNReal.ofReal_one]
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hprod := Measure.map_prod_map (translationShiftLaw f) (translationShiftLaw f)
    measurable_id (measurable_neg : Measurable (Neg.neg : ℝ → ℝ))
  simp only [Measure.map_id] at hprod
  have hdiff : (translationShiftLaw f |>.prod (translationShiftLaw f)).map
      (fun z : ℝ × ℝ ↦ z.1 - z.2) =
      Measure.conv (translationShiftLaw f) ((translationShiftLaw f).map Neg.neg) := by
    rw [Measure.conv, hprod, Measure.map_map (by fun_prop) (by fun_prop)]
    congr 1
  have hdensity : lconvolution (fun x ↦ ENNReal.ofReal (f x))
      (fun x ↦ ENNReal.ofReal (f (-x))) volume =
      fun t ↦ ENNReal.ofReal (pairDifferenceDensity f t) := by
    funext t
    rw [lconvolution_def, pairDifferenceDensity,
      ofReal_integral_eq_lintegral_ofReal (integrable_pairDifference_integrand hfm hfi hf0 hM t)
        (Filter.Eventually.of_forall (fun x ↦ mul_nonneg (hf0 x) (hf0 (x - t))))]
    apply lintegral_congr
    intro x
    have he : -(-x + t) = x - t := by ring
    rw [he, ENNReal.ofReal_mul (hf0 x)]
  rw [hdiff, translationShiftLaw_map_neg]
  change Measure.conv (volume.withDensity (fun x ↦ ENNReal.ofReal (f x)))
    (volume.withDensity (fun x ↦ ENNReal.ofReal (f (-x)))) = _
  have hnegm : Measurable (fun x ↦ ENNReal.ofReal (f (-x))) :=
    (hfm.comp measurable_neg).ennreal_ofReal
  rw [conv_withDensity_eq_lconvolution hfm.ennreal_ofReal hnegm, hdensity]
  rfl

noncomputable def logUniformPairDensity (u w : ℝ) : ℝ → ℝ :=
  pairDifferenceDensity (logUniformDensity u w)

theorem logUniformPairDensity_properties {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    Measurable (logUniformPairDensity u w) ∧
      (∀ t, 0 ≤ logUniformPairDensity u w t) ∧
      (∫⁻ t : ℝ, ENNReal.ofReal (logUniformPairDensity u w t)) = 1 ∧
      (∀ t, t ∉ Set.Icc (-w) w → logUniformPairDensity u w t = 0) ∧
      (∀ t, logUniformPairDensity u w t ≤ 2 / w) ∧
      (∀ t, max (w - |t|) 0 / (4 * w ^ 2) ≤ logUniformPairDensity u w t) := by
  have hm := measurable_logUniformDensity u w
  have hi := integrable_logUniformDensity hw hwu
  have h0 := logUniformDensity_nonneg hw hwu
  have h1 := integral_logUniformDensity hw hwu
  have hu := logUniformDensity_le hw hwu
  refine ⟨measurable_pairDifferenceDensity hm, pairDifferenceDensity_nonneg h0, ?_,
    (fun _ ht ↦ pairDifferenceDensity_eq_zero_outside (fun _ hx ↦ logUniformDensity_eq_zero hx) ht),
    pairDifferenceDensity_le hm hi h0 h1 hu, ?_⟩
  · change (∫⁻ t : ℝ, ENNReal.ofReal (pairDifferenceDensity (logUniformDensity u w) t)) = 1
    rw [← ofReal_integral_eq_lintegral_ofReal (integrable_pairDifferenceDensity hi)
      (Filter.Eventually.of_forall (pairDifferenceDensity_nonneg h0)),
      integral_pairDifferenceDensity hi, h1, one_pow, ENNReal.ofReal_one]
  · exact pairDifferenceDensity_interval_lower hw hm hi h0 hu
      (fun _ hx ↦ (logUniformDensity_bounds hw hwu hx).1)

theorem logUniformPairDensity_initial_lower {u L t : ℝ} (hL : 0 < L) (hu : 4 * L ≤ u)
    (ht : |t| ≤ L) : 3 / (64 * L) ≤ logUniformPairDensity u (4 * L) t := by
  have h := (logUniformPairDensity_properties (by positivity : (0 : ℝ) < 4 * L) hu).2.2.2.2.2 t
  apply le_trans _ h
  have hnonneg : 0 ≤ 4 * L - |t| := by linarith
  rw [max_eq_left hnonneg]
  apply (div_le_div_iff₀ (by positivity : (0 : ℝ) < 64 * L)
    (by positivity : (0 : ℝ) < 4 * (4 * L) ^ 2)).mpr
  nlinarith [sq_nonneg L]

theorem logUniformPairDensity_map_eq {u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    (translationShiftLaw (logUniformDensity u w) |>.prod (translationShiftLaw (logUniformDensity u w))).map
      (fun z : ℝ × ℝ ↦ z.1 - z.2) = translationShiftLaw (logUniformPairDensity u w) :=
  pairDifferenceDensity_map_eq (measurable_logUniformDensity u w)
    (integrable_logUniformDensity hw hwu) (logUniformDensity_nonneg hw hwu)
    (integral_logUniformDensity hw hwu) (logUniformDensity_le hw hwu)

end Erdos859Verification

end

