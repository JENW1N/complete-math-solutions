section

/- Exact stopping-prime localization under the finite prime-pattern law. -/

namespace Erdos859Verification

open Finset Real MeasureTheory
open scoped Classical

def fordPrimePrefix (P : Finset ℕ) (p : ℕ) : Finset ℕ := P.filter (fun q ↦ q < p)

def FordRadicalDivisorEvent (y : ℝ) (T : Finset ℕ) : Prop :=
  ∃ U ⊆ T, y < ∏ q ∈ U, (q : ℝ) ∧ (∏ q ∈ U, (q : ℝ)) ≤ 2*y

def FordStoppingWitness (y : ℝ) (p : ℕ) (S : Finset ℕ) : Prop :=
  ∃ U ⊆ S, y < (p : ℝ) * ∏ q ∈ U, (q : ℝ) ∧
    (p : ℝ) * (∏ q ∈ U, (q : ℝ)) ≤ 2*y

/-- Select the largest prime of the witnessing subset; the prefix retains
all selected smaller primes, including those not used by this witness. -/
theorem radical_event_stopping_witness {P T : Finset ℕ} (hTP : T ⊆ P)
    {y : ℝ} (hy : 1 ≤ y) (h : FordRadicalDivisorEvent y T) :
    ∃ p ∈ P, p ∈ T ∧ FordStoppingWitness y p (T ∩ fordPrimePrefix P p) := by
  obtain ⟨U, hUT, hlo, hhi⟩ := h
  have hUne : U.Nonempty := by
    by_contra he
    have he := not_nonempty_iff_eq_empty.mp he
    simp only [he, prod_empty] at hlo
    linarith
  let p := U.max' hUne
  have hpU : p ∈ U := max'_mem U hUne
  have hpT : p ∈ T := hUT hpU
  refine ⟨p, hTP hpT, hpT, U.erase p, ?_, ?_, ?_⟩
  · intro q hq
    obtain ⟨hqp, hqU⟩ := mem_erase.mp hq
    have hqp' : q < p := lt_of_le_of_ne (le_max' U q hqU) hqp
    exact mem_inter.mpr ⟨hUT hqU, mem_filter.mpr ⟨hTP (hUT hqU), hqp'⟩⟩
  · rwa [mul_prod_erase U (fun q : ℕ ↦ (q : ℝ)) hpU]
  · rwa [mul_prod_erase U (fun q : ℕ ↦ (q : ℝ)) hpU]

theorem primePattern_expectation_restrict {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, primePatternWeight P T * F (T ∩ B)) =
      ∑ U ∈ B.powerset, primePatternWeight B U * F U := by
  simpa only [primeTiltWeight, primeTiltNormalizer, sub_self, zero_div,
    add_zero, prod_const_one, one_pow, mul_one, div_one] using
    prime_tilt_expectation_restrict hP hB (by norm_num : (0 : ℝ) < 1) F

theorem primePatternWeight_insert_selected {Q S : Finset ℕ} {p : ℕ}
    (hpQ : p ∉ Q) :
    primePatternWeight (insert p Q) (insert p S) =
      (1 / (p : ℝ)) * primePatternWeight Q S := by
  unfold primePatternWeight
  rw [prod_insert hpQ]
  simp only [mem_insert_self, if_true]
  congr 1
  apply prod_congr rfl
  intro q hq
  have hqp : q ≠ p := fun he ↦ hpQ (he ▸ hq)
  simp only [mem_insert, hqp, false_or]

/-- The coordinates above the stopping prime integrate out exactly. -/
theorem primePattern_selected_prefix_expectation {P Q : Finset ℕ} {p : ℕ}
    (hP : ∀ q ∈ P, q.Prime) (hQ : Q ⊆ P) (hpP : p ∈ P) (hpQ : p ∉ Q)
    (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, primePatternWeight P T *
      (if p ∈ T then F (T ∩ Q) else 0)) =
