      (hS.preimage (ford_permute_measurePreserving σ).measurable)

def fordCubeBarrier (k : ℕ) (u v : ℝ) : Set (Fin k → ℝ) :=
  Icc (fun _ ↦ 0) (fun _ ↦ 1) ∩ {x | fordSortedTuple x ∈ fordBarrier k u v}

def fordCubeBarrierChamber {k : ℕ} (u v : ℝ) (σ : Equiv.Perm (Fin k)) : Set (Fin k → ℝ) :=
  (fun x ↦ x ∘ σ) ⁻¹' fordBarrierGood k 1 u v

theorem fordCubeBarrier_measurable (k : ℕ) (u v : ℝ) :
    MeasurableSet (fordCubeBarrier k u v) :=
  measurableSet_Icc.inter ((fordBarrier_measurable k u v).preimage (fordSortedTuple_measurable k))

theorem fordCubeBarrierChamber_measurable {k : ℕ} (u v : ℝ) (σ : Equiv.Perm (Fin k)) :
    MeasurableSet (fordCubeBarrierChamber u v σ) :=
  (fordBarrierGood_measurable k 1 u v).preimage (ford_permute_measurePreserving σ).measurable

theorem fordCubeBarrierChamber_volume {k : ℕ} (u v : ℝ) (σ : Equiv.Perm (Fin k)) :
    volume (fordCubeBarrierChamber u v σ) = volume (fordBarrierGood k 1 u v) :=
  (ford_permute_measurePreserving σ).measure_preimage
    (fordBarrierGood_measurable k 1 u v).nullMeasurableSet

theorem fordCubeBarrierChamber_pairwise_aedisjoint (k : ℕ) (u v : ℝ) :
    Pairwise (fun σ τ : Equiv.Perm (Fin k) ↦
      AEDisjoint volume (fordCubeBarrierChamber u v σ) (fordCubeBarrierChamber u v τ)) := by
  intro σ τ hστ
  exact (fordOrderedChamber_pairwise_aedisjoint k 1 hστ).mono
    (fun _ hx ↦ hx.1) (fun _ hx ↦ hx.1)

theorem fordCubeBarrierChamber_iUnion (k : ℕ) (u v : ℝ) :
    (⋃ σ : Equiv.Perm (Fin k), fordCubeBarrierChamber u v σ) = fordCubeBarrier k u v := by
  ext x
  constructor
  · intro hx
    obtain ⟨σ, hσ⟩ := mem_iUnion.mp hx
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · intro i
      simpa only [Function.comp_apply, Equiv.apply_symm_apply] using hσ.1.1.1 (σ.symm i)
    · intro i
      simpa only [Function.comp_apply, Equiv.apply_symm_apply] using hσ.1.1.2 (σ.symm i)
    · change fordSortedTuple x ∈ fordBarrier k u v
      rw [fordSortedTuple_eq_of_monotone x σ hσ.1.2]
      exact hσ.2
  · intro hx
    refine mem_iUnion.mpr ⟨Tuple.sort x, ⟨?_, Tuple.monotone_sort x⟩, hx.2⟩
    exact ⟨fun i ↦ hx.1.1 _, fun i ↦ hx.1.2 _⟩

/-- The sorted cube event has exactly `k!` times its ordered-simplex volume. -/
theorem fordCubeBarrier_volume (k : ℕ) (u v : ℝ) :
    volume (fordCubeBarrier k u v) =
      (k.factorial : ℝ≥0∞) * volume (fordBarrierGood k 1 u v) := by
  rw [← fordCubeBarrierChamber_iUnion,
    measure_iUnion₀ (fordCubeBarrierChamber_pairwise_aedisjoint k u v)
      (fun σ ↦ (fordCubeBarrierChamber_measurable u v σ).nullMeasurableSet)]
  simp only [fordCubeBarrierChamber_volume, tsum_fintype, Finset.sum_const,
    Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]

theorem fordCubeBarrier_volume_toReal (k : ℕ) (u v : ℝ) :
    (volume (fordCubeBarrier k u v)).toReal =
      (k.factorial : ℝ) * (volume (fordBarrierGood k 1 u v)).toReal := by
  rw [fordCubeBarrier_volume, ENNReal.toReal_mul, ENNReal.toReal_natCast]

/-- Since the unit cube has volume one, this is the actual uniform-cube probability bound. -/
theorem fordCubeBarrier_probability_bound {k : ℕ} (hk : 0 < k) {u v w : ℝ}
    (hu : 0 ≤ u) (hw : 0 ≤ w) (hrel : v = (k : ℝ) + w - u) :
    (volume (fordCubeBarrier k u v)).toReal ≤ 36 * (u + 1) * (w + 1) ^ 2 / k := by
  rw [fordCubeBarrier_volume_toReal]
  exact fordBarrier_bound hk hu hw hrel

noncomputable def fordCubeDeficit {k : ℕ} (v : ℝ) (x : Fin k → ℝ) : ℝ := by
  classical
  exact (insert 0 (Finset.univ.image fun i : Fin k ↦
    v * fordSortedTuple x i - ((i.val : ℝ) + 1))).min' (by simp)

theorem le_fordCubeDeficit_iff {k : ℕ} (v a : ℝ) (x : Fin k → ℝ) :
    a ≤ fordCubeDeficit v x ↔ a ≤ 0 ∧
      ∀ i, a ≤ v * fordSortedTuple x i - ((i.val : ℝ) + 1) := by
  classical
  unfold fordCubeDeficit
  rw [Finset.le_min'_iff]
  simp

theorem fordCubeDeficit_nonpos {k : ℕ} (v : ℝ) (x : Fin k → ℝ) :
    fordCubeDeficit v x ≤ 0 :=
  ((le_fordCubeDeficit_iff v (fordCubeDeficit v x) x).mp le_rfl).1

theorem fordCubeDeficit_le_coordinate {k : ℕ} (v : ℝ) (x : Fin k → ℝ) (i : Fin k) :
    fordCubeDeficit v x ≤ v * fordSortedTuple x i - ((i.val : ℝ) + 1) :=
  ((le_fordCubeDeficit_iff v (fordCubeDeficit v x) x).mp le_rfl).2 i

theorem fordCubeDeficit_measurable (k : ℕ) (v : ℝ) :
    Measurable (fordCubeDeficit v : (Fin k → ℝ) → ℝ) := by
  apply measurable_of_Ici
  intro a
  have heq : (fordCubeDeficit v : (Fin k → ℝ) → ℝ) ⁻¹' Ici a =
      {x | a ≤ 0} ∩ {x | ∀ i, a ≤ v * fordSortedTuple x i - ((i.val : ℝ) + 1)} := by
    ext x
    exact le_fordCubeDeficit_iff v a x
  rw [heq]
  apply (measurableSet_le measurable_const measurable_const).inter
  simp only [ofPred_forall]
  exact MeasurableSet.iInter fun i ↦ measurableSet_le measurable_const
    ((measurable_const.mul ((measurable_pi_apply i).comp
      (fordSortedTuple_measurable k))).sub measurable_const)

theorem fordCubeDeficit_le_min {k : ℕ} (hk : 0 < k) {v : ℝ} (hv : 0 ≤ v)
    {x : Fin k → ℝ} (hx : x ∈ Icc (fun _ ↦ 0) (fun _ ↦ 1)) :
    fordCubeDeficit v x ≤ min 0 (v - k) := by
  apply le_min (fordCubeDeficit_nonpos v x)
  cases k with
  | zero => omega
  | succ k =>
    have h := fordCubeDeficit_le_coordinate v x (Fin.last k)
    have htop : fordSortedTuple x (Fin.last k) ≤ 1 := hx.2 _
    have hm := mul_le_mul_of_nonneg_left htop hv
    simp only [Fin.val_last, Nat.cast_add, Nat.cast_one] at h ⊢
    linarith

theorem fordCubeDeficit_tail_eq {k : ℕ} (v : ℝ) {s : ℝ} (hs : 0 ≤ s) :
    (Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ 1) ∩ {x | -s ≤ fordCubeDeficit v x}) =
      fordCubeBarrier k s v := by
  ext x
  simp only [mem_inter_iff, mem_ofPred_eq, le_fordCubeDeficit_iff, fordCubeBarrier,
    fordBarrier]
  have hs' : -s ≤ 0 := by linarith
  simp only [hs', true_and]
  constructor
  · rintro ⟨hx, h⟩
    exact ⟨hx, fun i ↦ by linarith [h i]⟩
  · rintro ⟨hx, h⟩
    exact ⟨hx, fun i ↦ by linarith [h i]⟩

/-- Tail bound at every nonnegative level where the Ford parameter `w` is nonnegative. -/
theorem fordCubeDeficit_tail_bound {k : ℕ} (hk : 0 < k) {v s : ℝ}
    (hs : 0 ≤ s) (hw : 0 ≤ s + v - k) :
    (volume (Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ 1) ∩
      {x | -s ≤ fordCubeDeficit v x})).toReal ≤
        36 * (s + 1) * (s + v - k + 1) ^ 2 / k := by
  rw [fordCubeDeficit_tail_eq v hs]
  exact fordCubeBarrier_probability_bound hk hs hw (by ring)

theorem fordCubeDeficit_tail_empty {k : ℕ} (hk : 0 < k) {v s : ℝ}
    (hv : 0 ≤ v) (hs : s < (k : ℝ) - v) :
    (Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ 1) ∩
      {x | -s ≤ fordCubeDeficit v x}) = ∅ := by
  apply eq_empty_iff_forall_notMem.mpr
  intro x hx
  have h := (fordCubeDeficit_le_min hk hv hx.1).trans (min_le_right _ _)
  have ht : -s ≤ fordCubeDeficit v x := hx.2
  linarith

theorem ford_unitCube_volume (k : ℕ) :
    volume (Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ 1)) = 1 := by
  rw [Real.volume_Icc_pi]
  simp

end Erdos859Verification

end

/- Inlined development module: PrimePairDivisorSupport.lean -/

section

/- Actual prime-pair difference cubes embed, after a fixed translation,
in the logarithmic subset-sum and divisor supports of the selected primes. -/

namespace Erdos859Verification

open Finset Real MeasureTheory

def primePairLabel {ι : Type*} (p q : ι → ℕ) (z : ι × Bool) : ℕ :=
  if z.2 then p z.1 else q z.1

/-- Labels from different coordinates are distinct. Reusing the same label
within one pair is harmless because a bit chooses only one label per pair. -/
def PairCoordinateSeparated {ι : Type*} (p q : ι → ℕ) : Prop :=
  ∀ x y : ι × Bool, primePairLabel p q x = primePairLabel p q y → x.1 = y.1

theorem pairCoordinateSeparated_of_injective {ι : Type*} {p q : ι → ℕ}
    (h : Function.Injective (primePairLabel p q)) : PairCoordinateSeparated p q :=
  fun _ _ heq ↦ congrArg Prod.fst (h heq)

def primePairLabels {ι : Type*} [Fintype ι] (p q : ι → ℕ) : Finset ℕ :=
  univ.image p ∪ univ.image q

def primePairChoice {ι : Type*} [Fintype ι] (p q : ι → ℕ) (b : ι → Bool) : Finset ℕ :=
  univ.image (fun i ↦ primePairLabel p q (i, b i))

theorem primePairChoice_subset {ι : Type*} [Fintype ι] (p q : ι → ℕ) (b : ι → Bool) :
    primePairChoice p q b ⊆ primePairLabels p q := by
  intro r hr
  obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hr
  cases hb : b i
  · exact Finset.mem_union_right _ (mem_image_of_mem q (mem_univ i))
  · exact Finset.mem_union_left _ (mem_image_of_mem p (mem_univ i))

theorem primePairChoice_log_sum {ι : Type*} [Fintype ι] {p q : ι → ℕ}
    (hsep : PairCoordinateSeparated p q) (b : ι → Bool) :
    (∑ r ∈ primePairChoice p q b, log (r : ℝ)) =
      (∑ i, log (q i : ℝ)) + ∑ i, if b i then log (p i : ℝ) - log (q i : ℝ) else 0 := by
  rw [primePairChoice, sum_image (fun i _ j _ hij ↦ hsep (i, b i) (j, b j) hij)]
  calc
    _ = ∑ i, (log (q i : ℝ) + if b i then log (p i : ℝ) - log (q i : ℝ) else 0) := by
      apply sum_congr rfl
      intro i _
      cases b i <;> simp [primePairLabel]
    _ = _ := sum_add_distrib

/-- The `+e` translation compensates for the negative side of symmetric
thickening, yielding the one-sided interval width `d + 2e`. -/
theorem prime_pair_thickened_support_subset {ι : Type*} [Fintype ι]
    {p q : ι → ℕ} {C : Finset ℕ} (hsep : PairCoordinateSeparated p q)
    (hcore : Disjoint C (primePairLabels p q)) (d e : ℝ) :
    realTranslateSet
      (finiteThickenedTranslateSupport (primeSubsetSumSupport C d) univ
        (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e)
      ((∑ i, log (q i : ℝ)) + e) ⊆
        primeSubsetSumSupport (C ∪ primePairLabels p q) (d + 2 * e) := by
  classical
  intro z hz
  change z - ((∑ i, log (q i : ℝ)) + e) ∈
    finiteSubsetTranslateSupport (realSupportThickening (primeSubsetSumSupport C d) e)
      univ (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) at hz
  obtain ⟨J, _, a, ha, herror⟩ := mem_finiteSubsetTranslateSupport.mp hz
  let b : ι → Bool := fun i ↦ decide (i ∈ J)
  have hbits : (∑ i, if b i then log (p i : ℝ) - log (q i : ℝ) else 0) =
      ∑ i ∈ J, (log (p i : ℝ) - log (q i : ℝ)) := by
    simp only [b, decide_eq_true_eq]
    rw [← sum_filter]
    simp
  rw [← hbits] at herror
  obtain ⟨U, hUC, hUa⟩ := mem_primeSubsetSumSupport.mp ha
  have hV := primePairChoice_subset p q b
  have hdis : Disjoint U (primePairChoice p q b) := hcore.mono hUC hV
  refine mem_primeSubsetSumSupport.mpr
    ⟨U ∪ primePairChoice p q b, union_subset_union hUC hV, ?_⟩
  rw [sum_union hdis, primePairChoice_log_sum hsep b]
  have he := abs_le.mp herror
  constructor <;> linarith [hUa.1, hUa.2, he.1, he.2]

theorem prime_pair_subset_translate_support {ι : Type*} [Fintype ι]
    {p q : ι → ℕ} {C : Finset ℕ} (hsep : PairCoordinateSeparated p q)
    (hcore : Disjoint C (primePairLabels p q)) (d : ℝ) :
    realTranslateSet
      (finiteSubsetTranslateSupport (primeSubsetSumSupport C d) univ
        (fun i ↦ log (p i : ℝ) - log (q i : ℝ)))
      (∑ i, log (q i : ℝ)) ⊆ primeSubsetSumSupport (C ∪ primePairLabels p q) d := by
  simpa only [finiteThickenedTranslateSupport, realSupportThickening_zero,
    add_zero, mul_zero] using prime_pair_thickened_support_subset hsep hcore d 0

theorem prime_pair_thickened_support_subset_of_injective {ι : Type*} [Fintype ι]
    {p q : ι → ℕ} {C : Finset ℕ} (hinj : Function.Injective (primePairLabel p q))
    (hcore : Disjoint C (primePairLabels p q)) (d e : ℝ) :
    realTranslateSet
      (finiteThickenedTranslateSupport (primeSubsetSumSupport C d) univ
        (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e)
      ((∑ i, log (q i : ℝ)) + e) ⊆
        primeSubsetSumSupport (C ∪ primePairLabels p q) (d + 2 * e) :=
  prime_pair_thickened_support_subset (pairCoordinateSeparated_of_injective hinj) hcore d e

theorem prime_pair_thickened_support_subset_divisors {ι : Type*} [Fintype ι]
    {p q : ι → ℕ} {C : Finset ℕ} (hsep : PairCoordinateSeparated p q)
    (hcore : Disjoint C (primePairLabels p q))
    (hprime : ∀ r ∈ C ∪ primePairLabels p q, r.Prime) (d e : ℝ) :
    realTranslateSet
      (finiteThickenedTranslateSupport (primeSubsetSumSupport C d) univ
        (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e)
      ((∑ i, log (q i : ℝ)) + e) ⊆
        divisorLogSupport (∏ r ∈ C ∪ primePairLabels p q, r) (d + 2 * e) :=
  (prime_pair_thickened_support_subset hsep hcore d e).trans
    (primeSubsetSumSupport_subset_divisorLogSupport hprime _)

theorem pairCoordinateSeparated_of_disjoint_sets {ι : Type*}
    {T : ι → Finset ℕ} {p q : ι → ℕ}
    (hdis : Pairwise (fun i j ↦ Disjoint (T i) (T j)))
    (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i) : PairCoordinateSeparated p q := by
  have hm (x : ι × Bool) : primePairLabel p q x ∈ T x.1 := by
    cases hx : x.2 <;> simp only [primePairLabel, hx, Bool.false_eq_true, if_false, if_true]
    · exact hq x.1
    · exact hp x.1
  intro x y heq
  by_contra hne
  exact Finset.disjoint_left.mp (hdis hne) (hm x) (heq ▸ hm y)

theorem primePairLabels_subset_bandUnion {ι : Type*} [Fintype ι]
    {T : ι → Finset ℕ} {p q : ι → ℕ} (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i) :
    primePairLabels p q ⊆ primeBandUnion T := by
  intro r hr
  rcases Finset.mem_union.mp hr with hr | hr
  · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hr
    exact mem_biUnion.mpr ⟨i, mem_univ i, hp i⟩
  · obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hr
    exact mem_biUnion.mpr ⟨i, mem_univ i, hq i⟩

/-- This version applies directly to witnesses from disjoint selected bands;
the two witnesses within an individual band may coincide. -/
theorem selected_pair_support_subset_divisors {ι : Type*} [Fintype ι]
    {T : ι → Finset ℕ} {p q : ι → ℕ} {C : Finset ℕ}
    (hdis : Pairwise (fun i j ↦ Disjoint (T i) (T j)))
    (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i)
    (hcore : Disjoint C (primeBandUnion T))
    (hprime : ∀ r ∈ C ∪ primeBandUnion T, r.Prime) (d e : ℝ) :
    realTranslateSet
      (finiteThickenedTranslateSupport (primeSubsetSumSupport C d) univ
        (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e)
      ((∑ i, log (q i : ℝ)) + e) ⊆
        divisorLogSupport (∏ r ∈ C ∪ primeBandUnion T, r) (d + 2 * e) := by
  have hlabels := primePairLabels_subset_bandUnion hp hq
  exact ((prime_pair_thickened_support_subset (pairCoordinateSeparated_of_disjoint_sets hdis hp hq)
    (hcore.mono Set.Subset.rfl hlabels) d e).trans
      (primeSubsetSumSupport_mono (union_subset_union Set.Subset.rfl hlabels) _)).trans
        (primeSubsetSumSupport_subset_divisorLogSupport hprime _)

theorem finiteThickenedTranslateSupport_mono_base {ι : Type*}
    {A B : Set ℝ} (hAB : A ⊆ B) (P : Finset ι) (x : ι → ℝ) (e : ℝ) :
    finiteThickenedTranslateSupport A P x e ⊆ finiteThickenedTranslateSupport B P x e := by
  intro z hz
  obtain ⟨J, hJ, a, ha, herr⟩ := mem_finiteThickenedTranslateSupport.mp hz
  exact mem_finiteThickenedTranslateSupport.mpr ⟨J, hJ, a, hAB ha, herr⟩

theorem selected_base_pair_support_subset_divisors {ι : Type*} [Fintype ι]
    {T : ι → Finset ℕ} {p q : ι → ℕ} {C : Finset ℕ} {B : Set ℝ} {d e : ℝ}
    (hB : B ⊆ primeSubsetSumSupport C d)
    (hdis : Pairwise (fun i j ↦ Disjoint (T i) (T j)))
    (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i)
    (hcore : Disjoint C (primeBandUnion T))
    (hprime : ∀ r ∈ C ∪ primeBandUnion T, r.Prime) :
    realTranslateSet
      (finiteThickenedTranslateSupport B univ (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e)
      ((∑ i, log (q i : ℝ)) + e) ⊆
        divisorLogSupport (∏ r ∈ C ∪ primeBandUnion T, r) (d + 2 * e) := by
  intro z hz
  apply selected_pair_support_subset_divisors hdis hp hq hcore hprime d e
  exact finiteThickenedTranslateSupport_mono_base hB _ _ _ hz

theorem volume_realTranslateSet {A : Set ℝ} (hA : MeasurableSet A) (t : ℝ) :
    volume (realTranslateSet A t) = volume A := by
  rw [realTranslateSet, ← Measure.map_apply (f := fun x : ℝ ↦ x - t) (by fun_prop) hA]
  simpa only [sub_eq_add_neg] using
    congrArg (fun mu : Measure ℝ ↦ mu A) (map_add_right_eq_self volume (-t))

theorem realTranslateSet_Icc (a b t : ℝ) :
    realTranslateSet (Set.Icc a b) t = Set.Icc (a + t) (b + t) := by
  ext z
  change (a ≤ z - t ∧ z - t ≤ b) ↔ (a + t ≤ z ∧ z ≤ b + t)
  constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

theorem translated_missing_measure_le {A D I : Set ℝ}
    (hA : MeasurableSet A) (hI : MeasurableSet I) (hIfin : volume I ≠ ⊤) (t : ℝ)
    (hsub : realTranslateSet A t ⊆ D) :
    volume.real (realTranslateSet I t \ D) ≤ volume.real (I \ A) := by
  have hfin : volume (realTranslateSet (I \ A) t) ≠ ⊤ := by
    rw [volume_realTranslateSet (hI.diff hA)]
    exact measure_ne_top_of_subset Set.sdiff_subset hIfin
  calc
    _ ≤ volume.real (realTranslateSet (I \ A) t) := by
      apply measureReal_mono _ hfin
      intro z hz
      exact ⟨hz.1, fun ha ↦ hz.2 (hsub ha)⟩
    _ = _ := congrArg ENNReal.toReal (volume_realTranslateSet (hI.diff hA) t)

theorem selected_pair_divisor_missing_le {ι : Type*} [Fintype ι]
    {T : ι → Finset ℕ} {p q : ι → ℕ} {C : Finset ℕ}
    (hdis : Pairwise (fun i j ↦ Disjoint (T i) (T j)))
    (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i)
    (hcore : Disjoint C (primeBandUnion T))
    (hprime : ∀ r ∈ C ∪ primeBandUnion T, r.Prime) (d e a b : ℝ) :
    volume.real (Set.Icc (a + ((∑ i, log (q i : ℝ)) + e))
      (b + ((∑ i, log (q i : ℝ)) + e)) \
      divisorLogSupport (∏ r ∈ C ∪ primeBandUnion T, r) (d + 2 * e)) ≤
        volume.real (Set.Icc a b \ finiteThickenedTranslateSupport
          (primeSubsetSumSupport C d) univ (fun i ↦ log (p i : ℝ) - log (q i : ℝ)) e) := by
  have h := translated_missing_measure_le (I := Set.Icc a b)
    (measurableSet_finiteThickenedTranslateSupport (isCompact_primeSubsetSumSupport C d) _ _ _)
    measurableSet_Icc isCompact_Icc.measure_ne_top ((∑ i, log (q i : ℝ)) + e)
    (selected_pair_support_subset_divisors hdis hp hq hcore hprime d e)
  simpa only [realTranslateSet_Icc] using h

theorem selected_base_pair_divisor_missing_le {ι : Type*} [Fintype ι]
    {T : ι → Finset ℕ} {p q : ι → ℕ} {C : Finset ℕ} {B : Set ℝ} {d e : ℝ}
    (hB : IsCompact B) (hBC : B ⊆ primeSubsetSumSupport C d)
    (hdis : Pairwise (fun i j ↦ Disjoint (T i) (T j)))
    (hp : ∀ i, p i ∈ T i) (hq : ∀ i, q i ∈ T i)
    (hcore : Disjoint C (primeBandUnion T))
    (hprime : ∀ r ∈ C ∪ primeBandUnion T, r.Prime) (a b : ℝ) :
    volume.real (Set.Icc (a + ((∑ i, log (q i : ℝ)) + e))
      (b + ((∑ i, log (q i : ℝ)) + e)) \
