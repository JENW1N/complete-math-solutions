section

/- Exact finite expectations and normalizers for prime tilting. -/

open Filter Finset
open scoped Topology

namespace Erdos859Verification

theorem primePattern_mem_iff {P T : Finset ℕ} (hT : T ⊆ P) (n : ℕ) :
    n ∈ PrimePatternSet P T ↔ P.filter (fun p ↦ p ∣ n) = T := by
  constructor
  · intro h
    apply Finset.ext
    intro p
    constructor
    · intro hp
      exact (h p (mem_filter.mp hp).1).mp (mem_filter.mp hp).2
    · intro hp
      exact mem_filter.mpr ⟨hT hp, (h p (hT hp)).mpr hp⟩
  · intro h p hp
    constructor
    · intro hd
      rw [← h]
      exact mem_filter.mpr ⟨hp, hd⟩
    · intro ht
      rw [← h] at ht
      exact (mem_filter.mp ht).2

theorem primePatternWeight_split {P T : Finset ℕ} (hT : T ⊆ P) :
    primePatternWeight P T =
      (∏ p ∈ T, 1 / (p : ℝ)) * ∏ p ∈ P \ T, (1 - 1 / (p : ℝ)) := by
  classical
  unfold primePatternWeight
  rw [prod_ite]
  have hyes : P.filter (fun p ↦ p ∈ T) = T := by
    ext p
    simp only [mem_filter]
    exact and_iff_right_of_imp (fun hp ↦ hT hp)
  have hno : P.filter (fun p ↦ p ∉ T) = P \ T := by
    ext p
    simp
  rw [hyes, hno]

/-- An arbitrary observable on the selected finite prime set has exactly
the expectation dictated by the product Bernoulli weights. -/
theorem tendsto_mean_prime_observable {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (F : Finset ℕ → ℝ) :
    Tendsto (fun N : ℕ ↦
      (∑ n ∈ range N, F (P.filter (fun p ↦ p ∣ n))) / N)
      atTop (𝓝 (∑ T ∈ P.powerset, primePatternWeight P T * F T)) := by
  classical
  have hdecomp (n : ℕ) : F (P.filter (fun p ↦ p ∣ n)) =
      ∑ T ∈ P.powerset, (PrimePatternSet P T).indicator (fun _ ↦ (1 : ℝ)) n * F T := by
    rw [sum_eq_single (P.filter (fun p ↦ p ∣ n))]
    · have hn : n ∈ PrimePatternSet P (P.filter (fun p ↦ p ∣ n)) :=
        (primePattern_mem_iff (filter_subset _ _) n).mpr rfl
      simp [hn]
    · intro T hT hne
      have hn : n ∉ PrimePatternSet P T := by
        rw [primePattern_mem_iff (mem_powerset.mp hT) n]
        exact fun heq ↦ hne heq.symm
      simp [hn]
    · intro hn
      exact False.elim (hn (mem_powerset.mpr (filter_subset _ _)))
  have heach : ∀ T ∈ P.powerset,
      Tendsto (fun N : ℕ ↦
        ((∑ n ∈ range N, (PrimePatternSet P T).indicator (fun _ ↦ (1 : ℝ)) n) / N) * F T)
        atTop (𝓝 (primePatternWeight P T * F T)) := by
    intro T _
    have ht := primePattern_hasDensity hP T
    change Tendsto (fun N ↦ (PrimePatternSet P T).partialDensity Set.univ N)
      atTop (𝓝 (primePatternWeight P T)) at ht
    simp_rw [partialDensity_eq_indicator_mean] at ht
    exact ht.mul_const (F T)
  convert tendsto_finsetSum P.powerset heach using 1
  funext N
  simp only [hdecomp, sum_div, div_mul_eq_mul_div, sum_mul]
  rw [sum_comm]

theorem primePatternWeight_pos {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (T : Finset ℕ) : 0 < primePatternWeight P T := by
  apply prod_pos
  intro p hp
  have hp0 : (0 : ℝ) < p := by exact_mod_cast (hP p hp).pos
  have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
  split_ifs
  · positivity
  · exact sub_pos.mpr ((div_lt_one hp0).mpr hp1)

noncomputable def primeTiltNormalizer (P : Finset ℕ) (lam : ℝ) : ℝ :=
  ∏ p ∈ P, (1 + (lam - 1) / (p : ℝ))

/-- Exact moment generating identity, valid before taking any asymptotic
or making any approximation to the prime distribution. -/
theorem primePatternWeight_moment (P : Finset ℕ) (lam : ℝ) :
    ∑ T ∈ P.powerset, primePatternWeight P T * lam ^ T.card =
      primeTiltNormalizer P lam := by
  classical
  unfold primeTiltNormalizer
  have heq (p : ℕ) : 1 + (lam - 1) / (p : ℝ) =
      lam / (p : ℝ) + (1 - 1 / (p : ℝ)) := by ring
  simp_rw [heq]
  rw [prod_add]
  apply sum_congr rfl
  intro T hT
  rw [primePatternWeight_split (mem_powerset.mp hT)]
  simp only [prod_div_distrib, prod_const, one_pow]
  ring

theorem sum_primePatternWeight (P : Finset ℕ) :
    ∑ T ∈ P.powerset, primePatternWeight P T = 1 := by
  simpa [primeTiltNormalizer] using primePatternWeight_moment P 1

theorem primeTiltNormalizer_pos {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    0 < primeTiltNormalizer P lam := by
  apply prod_pos
  intro p hp
  have hp0 : (0 : ℝ) < p := by exact_mod_cast (hP p hp).pos
  have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
  have heq : 1 + (lam - 1) / (p : ℝ) = (lam + p - 1) / p := by
    field_simp
    ring
  rw [heq]
  apply div_pos _ hp0
  linarith

noncomputable def primeTiltWeight (P : Finset ℕ) (lam : ℝ) (T : Finset ℕ) : ℝ :=
  primePatternWeight P T * lam ^ T.card / primeTiltNormalizer P lam

theorem sum_primeTiltWeight {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    ∑ T ∈ P.powerset, primeTiltWeight P lam T = 1 := by
  simp only [primeTiltWeight, ← sum_div, primePatternWeight_moment]
  exact div_self (primeTiltNormalizer_pos hP hlam).ne'

end Erdos859Verification

