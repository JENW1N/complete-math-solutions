  unfold finiteMarkCDF finiteRealAtomWeight
  rw [sum_fiberwise_eq_sum_filter]
  congr 1
  ext i
  simp only [Finset.mem_filter]
  constructor
  · exact fun ⟨hi, _, hv⟩ ↦ ⟨hi, hv⟩
  · exact fun ⟨hi, hv⟩ ↦ ⟨hi, mem_image_of_mem f hi, hv⟩

noncomputable def finiteIndexedMarkLaw {ι : Type*} (P : Finset ι) (a : ι → ℝ) (f : ι → ℝ) : Measure ℝ :=
