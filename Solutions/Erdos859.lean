  apply sum_eq_zero
  intro i _
  have hi : y ∉ Set.Icc (atom i) (atom i + d) := by
    intro h
    exact hy (Set.mem_iUnion.mpr ⟨i, h⟩)
  simp [intervalSmoothingKernel, hi]

/-- Cauchy--Schwarz in a form suited to a normalized density with finite support measure. -/
theorem normalized_density_support_measure {f : ℝ → ℝ} {S : Set ℝ}
    (hf : Integrable f) (hf2 : Integrable (fun y ↦ f y ^ 2))
    (hf0 : ∀ y, 0 ≤ f y) (hnorm : (∫ y, f y) = 1)
    (hS : MeasurableSet S) (hfin : volume S ≠ ⊤)
    (hsupport : ∀ y ∉ S, f y = 0) :
    1 ≤ volume.real S * (∫ y, f y ^ 2) := by
  let g : ℝ → ℝ := S.indicator (fun _ ↦ 1)
  have hg0 : ∀ y, 0 ≤ g y := Set.indicator_nonneg (fun _ _ ↦ zero_le_one)
  have hgf : (fun y ↦ f y * g y) = f := by
    funext y
    by_cases hy : y ∈ S
    · simp [g, hy]
    · simp [g, hy, hsupport y hy]
  have hg2 : (fun y ↦ g y ^ 2) = g := by
    funext y
    by_cases hy : y ∈ S <;> simp [g, hy]
  have hgint : (∫ y, g y) = volume.real S := by
    simp [g, integral_indicator_const, hS]
  have hfLp : MemLp f (ENNReal.ofReal (2 : ℝ)) := by
    simpa using (memLp_two_iff_integrable_sq hf.aestronglyMeasurable).mpr hf2
  have hgLp : MemLp g (ENNReal.ofReal (2 : ℝ)) :=
    memLp_indicator_const _ hS 1 (Or.inr hfin)
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg Real.HolderConjugate.two_two
    (Filter.Eventually.of_forall hf0) (Filter.Eventually.of_forall hg0) hfLp hgLp
  simp only [Real.rpow_two, ← Real.sqrt_eq_rpow] at hholder
  rw [hgf, hnorm, hg2, hgint] at hholder
  have hsquare := (one_le_sq_iff₀ (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))).mpr
    hholder
  have henergy : 0 ≤ ∫ y, f y ^ 2 := integral_nonneg (fun _ ↦ sq_nonneg _)
  simpa only [mul_pow, Real.sq_sqrt henergy, Real.sq_sqrt measureReal_nonneg, mul_comm] using
    hsquare

theorem finiteIntervalSmoothing_support_measure {ι : Type*} [Fintype ι]
    (w atom : ι → ℝ) {d : ℝ} (hd : 0 < d)
    (hw : ∀ i, 0 ≤ w i) (hnorm : ∑ i, w i = 1) :
