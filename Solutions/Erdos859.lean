  have hlog : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hscale : A ≤ A * (2 : ℝ) ^ j :=
    le_mul_of_one_le_right (hlog.le.trans ha) (one_le_pow₀ (by norm_num))
  exact ⟨ha.trans hscale,
    hlarge.trans (mul_le_mul_of_nonneg_right hscale hlog.le)⟩

