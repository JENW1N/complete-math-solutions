theorem finite_good_intersection_lower {α : Type*} [Fintype α]
    (w : α → ℝ) (Good Keep : α → Prop) [DecidablePred Good] [DecidablePred Keep]
    (hw : ∀ x, 0 ≤ w x) (hnorm : ∑ x, w x = 1) {b c : ℝ}
