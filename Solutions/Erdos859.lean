      apply prod_congr rfl
      intro p hp
      by_cases hpH : p ∈ H
      · simp [powerfulCompletionExponent, hpH]
      · simpa only [powerfulCompletionExponent, if_neg hpH] using
          cappedPrimeValuationWeight_low_factor (hP p hp) (hcap p hp) (p ∈ T)
