    (coreBallotScale k * log 2)) * exp (-(coreBallotShift k + coreBallotScale k))

noncomputable def coreGlobalBallotProbability (lam : ℝ) (k : ℕ) : ℝ :=
  virtualPrimeBallotMass (coreBallotShift k) (coreBallotScale k) lam k

noncomputable def coreGlobalBallotCorrection (lam : ℝ) (k : ℕ) : ℝ :=
  coreBallotError lam k + 1 + 2 * log (k : ℝ)

theorem coreGlobalBallot_correction_div_tendsto (lam : ℝ) :
