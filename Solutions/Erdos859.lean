  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hs := one_le_sqrt.mpr hkR
  linarith [(coreBallotHeadCount_sqrt_bounds k).2]

theorem coreBallot_ratio_eventually_le_pow_head :
    ∀ᶠ k in atTop, coreBallotShift k / coreBallotScale k ≤
      (2 : ℝ) ^ coreBallotHeadCount k := by
  have hlog2 : 0 < log (2 : ℝ) := log_pos (by norm_num)
  filter_upwards [(tendsto_const_add_log_nat_div_sqrt (log 10)).eventually_lt_const hlog2,
    eventually_gt_atTop 0] with k hsmall hk
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hs : 0 < sqrt (k : ℝ) := sqrt_pos.mpr hkR
  have hsmall' := (div_lt_iff₀ hs).mp hsmall
  have hceil := mul_le_mul_of_nonneg_right (coreBallotHeadCount_sqrt_bounds k).1 hlog2.le
  have hbound : 10 * (k : ℝ) ≤ (2 : ℝ) ^ coreBallotHeadCount k := by
    apply (log_le_log_iff (by positivity) (by positivity)).mp
    rw [log_mul (by norm_num) hkR.ne', log_pow]
    nlinarith
  exact (coreBallotShift_div_scale_le k).trans hbound

theorem coreBallot_log_ratio_upper {k : ℕ} (hk : 0 < k) :
    log (1 + coreBallotShift k / coreBallotScale k) ≤ log 11 + log (k : ℝ) := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  have hquot : 0 ≤ coreBallotShift k / coreBallotScale k :=
