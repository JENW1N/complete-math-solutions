section

/- Consecutive actual prime blocks, their exact law, and every endpoint anchor. -/

namespace Erdos859Verification

open Finset Real

noncomputable def coreMultiBlockBand (A B : ℝ) (h b : ℕ) : Finset ℕ :=
  virtualPrimeUniverse A (B * 2 ^ (b * h)) h

theorem coreMultiBlockBand_eq_window {A B : ℝ} (hB : 0 < B) (h b : ℕ) :
    coreMultiBlockBand A B h b =
      primeLogWindow (A + B * 2 ^ (b * h)) (A + B * 2 ^ ((b + 1) * h)) := by
  rw [coreMultiBlockBand, virtualPrimeUniverse_eq_window (by positivity : 0 < B * (2 : ℝ) ^ (b * h))]
  simp only [Nat.add_mul, one_mul, pow_add, mul_assoc]

theorem coreMultiBlockBand_disjoint {A B : ℝ} (hB : 0 < B) (h : ℕ) :
    Pairwise (fun b c ↦ Disjoint (coreMultiBlockBand A B h b) (coreMultiBlockBand A B h c)) := by
  intro b c hbc
  rw [coreMultiBlockBand_eq_window hB, coreMultiBlockBand_eq_window hB]
  apply disjoint_left.mpr
  intro p hpb hpc
  obtain ⟨_, hb0, hb1⟩ := mem_primeLogWindow.mp hpb
  obtain ⟨_, hc0, hc1⟩ := mem_primeLogWindow.mp hpc
  rcases lt_or_gt_of_ne hbc with hbc | hcb
  · have hp : (2 : ℝ) ^ ((b + 1) * h) ≤ 2 ^ (c * h) :=
      pow_le_pow_right₀ (by norm_num) (Nat.mul_le_mul_right h (by omega))
    nlinarith
  · have hp : (2 : ℝ) ^ ((c + 1) * h) ≤ 2 ^ (b * h) :=
      pow_le_pow_right₀ (by norm_num) (Nat.mul_le_mul_right h (by omega))
    nlinarith

theorem coreMultiBlockBand_union_range {A B : ℝ} (hB : 0 < B) (r h : ℕ) :
    (range r).biUnion (coreMultiBlockBand A B h) = virtualPrimeUniverse A B (r * h) := by
  induction r with
  | zero => simp [virtualPrimeUniverse]
  | succ r ih =>
    rw [range_add_one, biUnion_insert, ih, union_comm]
    simp only [virtualPrimeUniverse_eq_window hB, coreMultiBlockBand_eq_window hB]
    apply primeLogWindow_union_adjacent
    · have hp : (1 : ℝ) ≤ 2 ^ (r * h) := one_le_pow₀ (by norm_num)
      nlinarith
    · have hp : (2 : ℝ) ^ (r * h) ≤ 2 ^ ((r + 1) * h) :=
        pow_le_pow_right₀ (by norm_num) (Nat.mul_le_mul_right h (by omega))
      nlinarith

theorem coreMultiBlockBand_union {A B : ℝ} (hB : 0 < B) (r h : ℕ) :
    primeBandUnion (fun b : Fin r ↦ coreMultiBlockBand A B h b.val) =
      virtualPrimeUniverse A B (r * h) := by
  rw [← coreMultiBlockBand_union_range hB r h]
  ext p
  constructor
  · intro hp
    obtain ⟨b, _, hpb⟩ := mem_biUnion.mp hp
    exact mem_biUnion.mpr ⟨b.val, mem_range.mpr b.isLt, hpb⟩
  · intro hp
    obtain ⟨b, hb, hpb⟩ := mem_biUnion.mp hp
    exact mem_biUnion.mpr ⟨⟨b, mem_range.mp hb⟩, mem_univ _, hpb⟩

theorem coreMultiBlockBand_subset_universe {A B : ℝ} (hB : 0 < B)
    {r b : ℕ} (hbr : b < r) (h : ℕ) :
    coreMultiBlockBand A B h b ⊆ virtualPrimeUniverse A B (r * h) := by
  rw [← coreMultiBlockBand_union_range hB]
  intro p hp
  exact mem_biUnion.mpr ⟨b, mem_range.mpr hbr, hp⟩

def CoreMultiBlockEvent (A B eta : ℝ) (n K r : ℕ) (T : Finset ℕ) : Prop :=
  ∀ b : Fin r, CoreBlockEvent A (B * 2 ^ (b.val * (n + K))) eta n K
    (T ∩ coreMultiBlockBand A B (n + K) b.val)

noncomputable def coreMultiBlockEventMass (A B eta lam : ℝ) (n K r : ℕ) : ℝ := by
  classical
  exact ∑ T ∈ (virtualPrimeUniverse A B (r * (n + K))).powerset.filter
    (CoreMultiBlockEvent A B eta n K r), primeTiltWeight (virtualPrimeUniverse A B (r * (n + K))) lam T

theorem coreMultiBlockEventMass_factorization {A B : ℝ} (hB : 0 < B)
    (eta lam : ℝ) (n K r : ℕ) :
    coreMultiBlockEventMass A B eta lam n K r =
      ∏ b : Fin r, coreBlockEventMass A (B * 2 ^ (b.val * (n + K))) eta lam n K := by
  classical
  have hdis : Pairwise (fun b c : Fin r ↦ Disjoint (coreMultiBlockBand A B (n + K) b.val)
      (coreMultiBlockBand A B (n + K) c.val)) :=
    fun _ _ hbc ↦ coreMultiBlockBand_disjoint hB _ (fun h ↦ hbc (Fin.ext h))
  have h := prime_tilt_disjoint_band_events_product
    (fun b : Fin r ↦ coreMultiBlockBand A B (n + K) b.val) hdis lam
    (fun b ↦ CoreBlockEvent A (B * 2 ^ (b.val * (n + K))) eta n K)
  rw [coreMultiBlockBand_union hB] at h
  convert h using 1
  ·
    simp only [coreMultiBlockEventMass, CoreMultiBlockEvent, sum_filter]
    apply sum_congr rfl
    intro T _
    by_cases ht : ∀ b : Fin r, CoreBlockEvent A (B * 2 ^ (b.val * (n + K))) eta n K
      (T ∩ coreMultiBlockBand A B (n + K) b.val)
    · simp only [ht]
    · simp only [ht, if_false]
  · apply prod_congr rfl
    intro b _
    simp only [coreBlockEventMass, coreMultiBlockBand, sum_filter]

theorem coreMultiBlockEvent_card {A B eta : ℝ} {n K r : ℕ} {T : Finset ℕ}
    (hB : 0 < B) (hT : T ⊆ virtualPrimeUniverse A B (r * (n + K)))
    (hevent : CoreMultiBlockEvent A B eta n K r T) : T.card = r * (n + K) := by
  have hdis : Pairwise (fun b c : Fin r ↦ Disjoint (coreMultiBlockBand A B (n + K) b.val)
      (coreMultiBlockBand A B (n + K) c.val)) :=
    fun _ _ hbc ↦ coreMultiBlockBand_disjoint hB _ (fun h ↦ hbc (Fin.ext h))
  have hsub : T ⊆ primeBandUnion (fun b : Fin r ↦ coreMultiBlockBand A B (n + K) b.val) := by
    rwa [coreMultiBlockBand_union hB]
  rw [card_primeBand_intersections _ hdis hsub]
  have hc (b : Fin r) : (T ∩ coreMultiBlockBand A B (n + K) b.val).card = n + K :=
    coreBlockEvent_card (by positivity : 0 < B * (2 : ℝ) ^ (b.val * (n + K)))
      inter_subset_right (hevent b)
  simp only [hc, sum_const, card_univ, Fintype.card_fin, smul_eq_mul]

theorem coreMultiBlockEvent_log_sum_le {A B eta eps : ℝ} {n K r : ℕ} {T : Finset ℕ}
    (hB : 0 < B) (hh : 0 < n + K)
    (hT : T ⊆ virtualPrimeUniverse A B (r * (n + K)))
    (hevent : CoreMultiBlockEvent A B eta n K r T)
    (hsize : (n : ℝ) ≤ eps * (2 : ℝ) ^ K) :
    (∑ p ∈ T, log (p : ℝ)) ≤ (r * (n + K) : ℕ) * A +
      B * (exp eta + eps) * (2 : ℝ) ^ (r * (n + K)) / (1 - ((2 : ℝ) ^ (n + K))⁻¹) := by
  have heps : 0 ≤ eps := nonneg_of_mul_nonneg_left
    ((Nat.cast_nonneg n).trans hsize) (by positivity : (0 : ℝ) < 2 ^ K)
  have hdis : Pairwise (fun b c : Fin r ↦ Disjoint (coreMultiBlockBand A B (n + K) b.val)
      (coreMultiBlockBand A B (n + K) c.val)) :=
    fun _ _ hbc ↦ coreMultiBlockBand_disjoint hB _ (fun h ↦ hbc (Fin.ext h))
  have hsub : T ⊆ primeBandUnion (fun b : Fin r ↦ coreMultiBlockBand A B (n + K) b.val) := by
    rwa [coreMultiBlockBand_union hB]
  have hb (b : Fin r) : (∑ p ∈ T ∩ coreMultiBlockBand A B (n + K) b.val, log (p : ℝ)) ≤
      (n + K : ℕ) * A + B * (exp eta + eps) * (2 : ℝ) ^ ((b.val + 1) * (n + K)) := by
    have h := coreBlockEvent_log_sum_le (by positivity : 0 < B * (2 : ℝ) ^ (b.val * (n + K)))
      inter_subset_right (hevent b) hsize
    have hpow : (2 : ℝ) ^ ((b.val + 1) * (n + K)) =
        (2 : ℝ) ^ (b.val * (n + K)) * (2 : ℝ) ^ (n + K) := by
      rw [Nat.add_mul, one_mul, pow_add]
    have heq : (B * (2 : ℝ) ^ (b.val * (n + K))) * (exp eta + eps) * (2 : ℝ) ^ (n + K) =
        B * (exp eta + eps) * (2 : ℝ) ^ ((b.val + 1) * (n + K)) := by rw [hpow]; ring
    rw [heq] at h
    exact h
  have hgeom : (∑ b : Fin r, (2 : ℝ) ^ ((b.val + 1) * (n + K))) ≤
      (2 : ℝ) ^ (r * (n + K)) / (1 - ((2 : ℝ) ^ (n + K))⁻¹) := by
    rw [Fin.sum_univ_eq_sum_range (fun b : ℕ ↦ (2 : ℝ) ^ ((b + 1) * (n + K)))]
    exact core_block_geometric_sum_le r hh
  calc
    _ = ∑ b : Fin r, ∑ p ∈ T ∩ coreMultiBlockBand A B (n + K) b.val, log (p : ℝ) :=
      sum_primeBand_intersections _ hdis hsub _
    _ ≤ ∑ b : Fin r, ((n + K : ℕ) * A + B * (exp eta + eps) * (2 : ℝ) ^ ((b.val + 1) * (n + K))) :=
      sum_le_sum (fun b _ ↦ hb b)
    _ = (r * (n + K) : ℕ) * A + B * (exp eta + eps) *
        ∑ b : Fin r, (2 : ℝ) ^ ((b.val + 1) * (n + K)) := by
      rw [sum_add_distrib]
      simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_mul]
      rw [← mul_sum]
      ring
    _ ≤ (r * (n + K) : ℕ) * A + B * (exp eta + eps) *
        ((2 : ℝ) ^ (r * (n + K)) / (1 - ((2 : ℝ) ^ (n + K))⁻¹)) :=
      add_le_add le_rfl (mul_le_mul_of_nonneg_left hgeom (by positivity))
    _ = _ := by ring

theorem CoreMultiBlockEvent.restrictBlocks {A B eta : ℝ} {n K r s : ℕ} {T : Finset ℕ}
    (hevent : CoreMultiBlockEvent A B eta n K r T) (hB : 0 < B) (hs : s ≤ r) :
    CoreMultiBlockEvent A B eta n K s (T ∩ virtualPrimeUniverse A B (s * (n + K))) := by
  intro b
  have hbsub := coreMultiBlockBand_subset_universe (A := A) hB b.isLt (n + K)
  have heq : (T ∩ virtualPrimeUniverse A B (s * (n + K))) ∩ coreMultiBlockBand A B (n + K) b.val =
      T ∩ coreMultiBlockBand A B (n + K) b.val := by
    rw [inter_assoc, inter_eq_right.mpr hbsub]
  rw [heq]
  exact hevent ⟨b.val, b.isLt.trans_le hs⟩

/-- Every completed block gives an actual selected-prime prefix anchor. -/
theorem coreMultiBlockEvent_endpoint_bounds {A B eta eps : ℝ} {n K r s : ℕ} {T : Finset ℕ}
    (hB : 0 < B) (hh : 0 < n + K) (hs : s ≤ r)
    (hevent : CoreMultiBlockEvent A B eta n K r T)
    (hsize : (n : ℝ) ≤ eps * (2 : ℝ) ^ K) :
    (T ∩ virtualPrimeUniverse A B (s * (n + K))).card = s * (n + K) ∧
      (∑ p ∈ T ∩ virtualPrimeUniverse A B (s * (n + K)), log (p : ℝ)) ≤
        (s * (n + K) : ℕ) * A + B * (exp eta + eps) * (2 : ℝ) ^ (s * (n + K)) /
          (1 - ((2 : ℝ) ^ (n + K))⁻¹) := by
  have hpref := hevent.restrictBlocks hB hs
  exact ⟨coreMultiBlockEvent_card hB inter_subset_right hpref,
    coreMultiBlockEvent_log_sum_le hB hh inter_subset_right hpref hsize⟩

theorem coreMultiBlockEventMass_lower_of_blocks {A B eta lam : ℝ}
    (hB : 0 < B) (n K r : ℕ) (L : Fin r → ℝ) (hL0 : ∀ b, 0 ≤ L b)
    (hL : ∀ b, L b ≤ coreBlockEventMass A (B * 2 ^ (b.val * (n + K))) eta lam n K) :
    (∏ b, L b) ≤ coreMultiBlockEventMass A B eta lam n K r := by
  rw [coreMultiBlockEventMass_factorization hB]
  exact prod_le_prod (fun b _ ↦ hL0 b) (fun b _ ↦ hL b)

/-- The head parameter is supplied separately for every translated block.
This is a finite product bound and asserts no uniform-parameter rate. -/
theorem coreMultiBlockEventMass_explicit_lower {n : ℕ} (hn : 0 < n) (K r : ℕ)
    {A B eta lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (heta : 0 < eta) (heta2 : eta ≤ log 2)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ eta * B)
    (J : Fin r → ℕ) (hAB : ∀ b, A / (B * 2 ^ (b.val * (n + K))) ≤ (2 : ℝ) ^ J b) :
    (∏ b : Fin r,
      max 0 (coreBlockPrefixLower A (B * 2 ^ (b.val * (n + K))) lam n (J b)) *
        coreBlockSuffixLower A (B * 2 ^ (b.val * (n + K))) eta lam n K) ≤
      coreMultiBlockEventMass A B eta lam n K r := by
  apply coreMultiBlockEventMass_lower_of_blocks hB n K r
  · intro b
    exact mul_nonneg (le_max_left _ _) (coreBlockSuffixLower_nonneg hA
      (by positivity : 0 < B * (2 : ℝ) ^ (b.val * (n + K))) heta.le (by linarith) n K)
  · intro b
    have hp : (1 : ℝ) ≤ 2 ^ (b.val * (n + K)) := one_le_pow₀ (by norm_num)
    have hBB : B ≤ B * (2 : ℝ) ^ (b.val * (n + K)) := by
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hp hB.le
    have hlargeB : 4 * primeLogOddsErrorConstant ≤ eta * (B * (2 : ℝ) ^ (b.val * (n + K))) :=
      hlarge.trans (mul_le_mul_of_nonneg_left hBB heta.le)
    exact coreBlockEventMass_explicit_lower hn K hA (by positivity)
      (hbase.trans (add_le_add le_rfl hBB)) heta heta2 hlam hlam2 hlargeB (hAB b)

end Erdos859Verification

