/-- Small coordinate phases force the real part of the uniform box transform
to remain large, with a dimension-free quadratic loss. -/
theorem signedCoefficientBox_cos_lower {ι : Type*} [Fintype ι]
    (H : ℕ) (t : ι → ℝ) :
