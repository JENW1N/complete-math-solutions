theorem fordDeficit_layer_probability_bound {k : ℕ} (hk : 0 < k) (v : ℝ) (j : ℕ) :
    volume (Icc (fun _ : Fin k ↦ (0 : ℝ)) (fun _ ↦ 1) ∩
