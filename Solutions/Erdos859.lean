section

/- A reserve coin turns bounded residue representatives into an interval. -/

open Finset

namespace Erdos859Verification

theorem coin_interval_of_residue_cover {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] (w : ι → ℕ) {C Z t : ℕ}
    (hcover : ∀ x : ZMod r, ∃ c : ι → ℕ, (∀ i, c i ≤ C) ∧
      (∑ i, c i * w i : ℕ) = x)
    (htlo : C * ∑ i, w i ≤ t) (hthi : t ≤ Z * r) :
    ∃ b : ℕ, ∃ c : ι → ℕ, b ≤ Z ∧ (∀ i, c i ≤ C) ∧
      t = r * b + ∑ i, c i * w i := by
  obtain ⟨c, hc, hresidue⟩ := hcover (t : ZMod r)
  let z : ℕ := ∑ i, c i * w i
  have hz : z ≤ t := (bounded_coin_value_le w hc).trans htlo
  have hmod : z ≡ t [MOD r] := (ZMod.natCast_eq_natCast_iff z t r).mp hresidue
  have hdiv : r ∣ t - z := hmod.dvd'
  refine ⟨(t - z) / r, c, ?_, hc, ?_⟩
  · calc
      _ ≤ (Z * r) / r := Nat.div_le_div_right ((Nat.sub_le t z).trans hthi)
      _ = Z := Nat.mul_div_cancel Z (NeZero.pos r)
  · rw [Nat.mul_div_cancel' hdiv]
    exact (Nat.sub_add_cancel hz).symm

theorem coin_interval_real_bounds {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] (w : ι → ℕ) {C Z t : ℕ}
    (hcover : ∀ x : ZMod r, ∃ c : ι → ℕ, (∀ i, c i ≤ C) ∧
      (∑ i, c i * w i : ℕ) = x)
    (hsize : 4 * C * ∑ i, w i ≤ Z * r)
    (htlo : (Z : ℝ) * r / 4 ≤ t) (hthi : (t : ℝ) ≤ 3 * Z * r / 4) :
    ∃ b : ℕ, ∃ c : ι → ℕ, b ≤ Z ∧ (∀ i, c i ≤ C) ∧
      t = r * b + ∑ i, c i * w i := by
  apply coin_interval_of_residue_cover w hcover
  · have hs : (4 : ℝ) * C * (∑ i, w i : ℕ) ≤ Z * r := by exact_mod_cast hsize
    have h : (C : ℝ) * (∑ i, w i : ℕ) ≤ t := by nlinarith
    exact_mod_cast h
  · have h : (t : ℝ) ≤ (Z : ℝ) * r := by
      have hn : (0 : ℝ) ≤ (Z : ℝ) * r := by positivity
      nlinarith
    exact_mod_cast h

/-- Embed a reserve coin and a disjoint finite set of other coins in one
bounded coefficient function on the natural numbers. -/
theorem finite_coin_coefficient_extension (S : Finset ℕ) {r b C Z : ℕ}
    (hr : r ∉ S) (hb : b ≤ Z) (hCZ : C ≤ Z) (c : S → ℕ)
    (hc : ∀ i, c i ≤ C) :
    ∃ f : ℕ → ℕ, (∀ d, f d ≤ Z) ∧
      (∀ d, d ∉ insert r S → f d = 0) ∧
      (∑ d ∈ insert r S, d * f d) = r * b + ∑ i : S, c i * (i : ℕ) := by
  classical
  let f : ℕ → ℕ := fun d ↦ if d = r then b else if hd : d ∈ S then c ⟨d, hd⟩ else 0
  refine ⟨f, ?_, ?_, ?_⟩
  · intro d
    dsimp [f]
    split_ifs with h h'
    · exact hb
    · exact (hc ⟨d, h'⟩).trans hCZ
    · exact Nat.zero_le _
  · intro d hd
    have hne : d ≠ r := by intro h; subst d; exact hd (mem_insert_self _ _)
    have hnot : d ∉ S := fun h ↦ hd (mem_insert_of_mem h)
    simp only [f, if_neg hne, dif_neg hnot]
  · rw [sum_insert hr]
    have hfr : f r = b := by simp [f]
    rw [hfr]
    congr 1
    rw [← sum_attach]
    change (∑ i : S, (i : ℕ) * f i) = _
    apply sum_congr rfl
    intro i _
    have hi : (i : ℕ) ≠ r := by intro h; exact hr (h ▸ i.property)
    simp only [f, if_neg hi, dif_pos i.property, mul_comm]

end Erdos859Verification

