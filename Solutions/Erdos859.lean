noncomputable def primeTiltLikelihood (P : Finset ℕ) (lam : ℝ) (T : Finset ℕ) : ℝ :=
  lam ^ T.card / primeTiltNormalizer P lam

/-- Exact likelihood moment under the original finite Bernoulli law. -/
theorem primeTiltLikelihood_moment {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) (q : ℝ) :
    (∑ T ∈ P.powerset, primePatternWeight P T * primeTiltLikelihood P lam T ^ q) =
      primeTiltNormalizer P (lam ^ q) / primeTiltNormalizer P lam ^ q := by
  unfold primeTiltLikelihood
  have hZ := primeTiltNormalizer_pos hP hlam
  have heach (T : Finset ℕ) :
      primePatternWeight P T * (lam ^ T.card / primeTiltNormalizer P lam) ^ q =
        (primePatternWeight P T * (lam ^ q) ^ T.card) / primeTiltNormalizer P lam ^ q := by
    rw [Real.div_rpow (pow_nonneg hlam.le _) hZ.le,
      ← Real.rpow_pow_comm hlam.le]
    ring
  simp_rw [heach]
  rw [← sum_div, primePatternWeight_moment]

/-- Fully finite Hölder transfer to the actual density. The remaining
construction must supply a large tilted expectation on the left. -/
theorem prime_tilt_density_transfer {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (t : ℕ) (F : Finset ℕ → ℝ)
    (hF0 : ∀ T, 0 ≤ F T) (hF1 : ∀ T, F T ≤ 1)
    (hsupport : ∀ T ∈ P.powerset, 0 < F T →
      (∏ p ∈ T, p) ∈ Erdos859.DivisorSumSet t)
    {lam q : ℝ} (hlam : 0 < lam) (hq : 1 ≤ q) :
