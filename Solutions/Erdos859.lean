theorem finite_product_bad_coordinate_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)]
    (w : ∀ i, α i → ℝ) (bad : ∀ i, α i → Prop) [∀ i, DecidablePred (bad i)]
    (a : ι → ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hbad : ∀ i, (∑ y, w i y * (if bad i y then 1 else 0)) ≤ a i) :
    (∑ x : ∀ i, α i, finiteProductWeight w x *
      (if ∃ i, bad i (x i) then 1 else 0)) ≤ ∑ i, a i := by
  classical
  calc
    _ ≤ ∑ i, ∑ x : ∀ i, α i,
        finiteProductWeight w x * (if bad i (x i) then 1 else 0) := by
      simpa only [mem_univ, true_and] using
        finite_weighted_union_bound_general univ univ (finiteProductWeight w)
          (fun x _ ↦ finiteProductWeight_nonneg hw x) (fun i x ↦ bad i (x i))
    _ ≤ _ := by
      apply sum_le_sum
      intro i _
      apply finite_product_section_bound w (fun x ↦ if bad i (x i) then 1 else 0)
        i (a i) hw hnorm
      intro z
      simpa only [Equiv.piSplitAt_symm_apply, dite_true] using hbad i

theorem finite_iid_not_injective_probability_le {α : Type*}
    [Fintype α] [DecidableEq α] (n : ℕ) (w : α → ℝ) {a : ℝ} (ha : 0 ≤ a)
    (hw : ∀ y, 0 ≤ w y) (hnorm : ∑ y, w y = 1) (hatom : ∀ y, w y ≤ a) :
    (∑ x : Fin n → α, finiteProductWeight (fun _ ↦ w) x *
      (if ¬ Function.Injective x then 1 else 0)) ≤ (n : ℝ) ^ 2 * a := by
  classical
  have hevent (x : Fin n → α) :
      (¬ Function.Injective x) ↔ ∃ i j : Fin n, i ≠ j ∧ x i = x j := by
    constructor
    · intro h
      by_contra hn
      apply h
      intro i j hij
      by_contra hne
      exact hn ⟨i, j, hne, hij⟩
    · rintro ⟨i, j, hne, hij⟩ h
      exact hne (h hij)
  simpa only [hevent] using finite_iid_duplicate_probability_le n w ha hw hnorm hatom

theorem finite_band_iid_duplicate_probability_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]
    (n : ι → ℕ) (w : ∀ i, α i → ℝ) (a : ι → ℝ)
    (ha : ∀ i, 0 ≤ a i) (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hatom : ∀ i y, w i y ≤ a i) :
    (∑ x : ∀ i, Fin (n i) → α i,
      finiteProductWeight (fun i ↦ finiteProductWeight (fun _ : Fin (n i) ↦ w i)) x *
        (if ∃ i, ¬ Function.Injective (x i) then 1 else 0)) ≤
      ∑ i, (n i : ℝ) ^ 2 * a i := by
  apply finite_product_bad_coordinate_le
    (fun i ↦ finiteProductWeight (fun _ : Fin (n i) ↦ w i))
    (fun _ x ↦ ¬ Function.Injective x) (fun i ↦ (n i : ℝ) ^ 2 * a i)
  · intro i
    exact finiteProductWeight_nonneg (fun _ ↦ hw i)
  · intro i
    exact sum_finiteProductWeight _ (fun _ ↦ hnorm i)
  · intro i
    exact finite_iid_not_injective_probability_le (n i) (w i) (ha i) (hw i) (hnorm i)
      (hatom i)

/-- The loss is summed over all bands before normalizing. It does not
multiply a fixed conditioning loss once per band. -/
theorem finite_band_iid_distinct_mass_lower {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)] [∀ i, DecidableEq (α i)]
    (n : ι → ℕ) (w : ∀ i, α i → ℝ) (a : ι → ℝ)
    (ha : ∀ i, 0 ≤ a i) (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hatom : ∀ i y, w i y ≤ a i) :
    1 - (∑ i, (n i : ℝ) ^ 2 * a i) ≤
      ∑ x : ∀ i, Fin (n i) → α i with ∀ i, Function.Injective (x i),
        finiteProductWeight (fun i ↦ finiteProductWeight (fun _ : Fin (n i) ↦ w i)) x := by
  classical
  let W := finiteProductWeight (fun i ↦ finiteProductWeight (fun _ : Fin (n i) ↦ w i))
  have hbad := finite_band_iid_duplicate_probability_le n w a ha hw hnorm hatom
  have hnorm' : (∑ x : ∀ i, Fin (n i) → α i, W x) = 1 :=
    sum_finiteProductWeight _ (fun i ↦ sum_finiteProductWeight _ (fun _ ↦ hnorm i))
  have hsplit := sum_filter_add_sum_filter_not univ
    (fun x : ∀ i, Fin (n i) → α i ↦ ∃ i, ¬ Function.Injective (x i)) W
  simp only [mul_ite, mul_one, mul_zero, ← sum_filter] at hbad
  simp only [not_exists, not_not] at hsplit
  change _ ≤ _ at hbad
  rw [hnorm'] at hsplit
  linarith

end Erdos859Verification

