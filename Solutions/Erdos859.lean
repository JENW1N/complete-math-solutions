    Tendsto (fun k : ℕ ↦ log (log (seedScale k : ℝ)) / k) atTop (𝓝 0) := by
  have hloglim : Tendsto (fun k : ℕ ↦ log (k : ℝ) / k) atTop (𝓝 0) := by
    have hnat : Tendsto (fun k : ℕ ↦ (k : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
    simpa only [Function.comp_def, pow_one, one_mul, add_zero] using
      (tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero).comp hnat
  have hlim : Tendsto (fun k : ℕ ↦ log 3 / k + 3 * (log (k : ℝ) / k))
      atTop (𝓝 0) := by
    simpa using (tendsto_const_div_atTop_nhds_zero_nat (log 3)).add (hloglim.const_mul 3)
  have hbound : ∀ᶠ k : ℕ in atTop,
      0 ≤ log (log (seedScale k : ℝ)) / k ∧
      log (log (seedScale k : ℝ)) / k ≤ log 3 / k + 3 * (log (k : ℝ) / k) := by
    filter_upwards [eventually_gt_atTop 0] with k hk
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have hpow : (1 : ℝ) ≤ (k : ℝ) ^ 3 := one_le_pow₀ hk1
    have hlog := log_ceil_exp_bounds (show 0 ≤ 2 * (k : ℝ) ^ 3 by positivity)
    change 2 * (k : ℝ) ^ 3 ≤ log (seedScale k : ℝ) ∧
      log (seedScale k : ℝ) ≤ 2 * (k : ℝ) ^ 3 + log 2 at hlog
    have hlogpos : 0 < log (seedScale k : ℝ) := by linarith [hlog.1]
    have hlo : 1 ≤ log (seedScale k : ℝ) := by linarith [hlog.1]
    have hlog2 : log (2 : ℝ) ≤ 1 := by
      have h := log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
      linarith
    have hhi : log (seedScale k : ℝ) ≤ 3 * (k : ℝ) ^ 3 := by linarith [hlog.2]
    have hloghi := (log_le_log_iff hlogpos (by positivity)).mpr hhi
    rw [log_mul (by norm_num : (3 : ℝ) ≠ 0) (pow_ne_zero 3 hkR.ne'), log_pow] at hloghi
    norm_num only [Nat.cast_ofNat] at hloghi
    refine ⟨div_nonneg (log_nonneg hlo) hkR.le, ?_⟩
    have hd := div_le_div_of_nonneg_right hloghi hkR.le
    calc
      _ ≤ (log 3 + 3 * log (k : ℝ)) / k := hd
      _ = log 3 / k + 3 * (log (k : ℝ) / k) := by ring
  exact squeeze_zero' (hbound.mono fun _ h ↦ h.1) (hbound.mono fun _ h ↦ h.2) hlim

/-- For the explicit scale `ceil(exp(2*k^3))`, the seed loses no exponential
rate, uniformly for any sequence of prime universes containing its bands. -/
theorem tendsto_seedScale_cost (P : ℕ → Finset ℕ)
    (hP : ∀ k p, p ∈ P k → p.Prime) {lam : ℝ} (hlam : 1 ≤ lam)
    (hB : ∀ᶠ k in atTop,
