theorem primeBandUnion_dyadic (A : ℝ) (k : ℕ) :
    primeBandUnion (fun j : Fin k ↦ dyadicPrimeBand A j.val) = dyadicPrimeUniverse A k := by
  ext p
  constructor
  · intro hp
    obtain ⟨j, _, hpj⟩ := Finset.mem_biUnion.mp hp
    exact Finset.mem_biUnion.mpr ⟨j.val, Finset.mem_range.mpr j.isLt, hpj⟩
  · intro hp
    obtain ⟨j, hj, hpj⟩ := Finset.mem_biUnion.mp hp
    exact Finset.mem_biUnion.mpr ⟨⟨j, Finset.mem_range.mp hj⟩, Finset.mem_univ _, hpj⟩

theorem primeBandCountRegularity_dyadic (A : ℝ) (k : ℕ) (T : Finset ℕ) :
    primeBandCountRegularity (fun j : Fin k ↦ A * (2 : ℝ) ^ j.val)
      (fun j ↦ (T ∩ dyadicPrimeBand A j.val).card) =
      primeCountRegularity A k (dyadicPrimeBand A) T := by
  simpa only [primeBandCountRegularity, primeCountRegularity, neg_mul] using
    Fin.sum_univ_eq_sum_range
      (fun j : ℕ ↦ ((T ∩ dyadicPrimeBand A j).card : ℝ) ^ 2 * exp (-(A * (2 : ℝ) ^ j))) k

/-- The finite fiber of all selections having the same band counts as `T`. -/
noncomputable def dyadicCountFiber (A : ℝ) (k : ℕ) (T : Finset ℕ) : Finset (Finset ℕ) :=
  (dyadicPrimeUniverse A k).powerset.filter
    (fun U ↦ ∀ j : Fin k, (U ∩ dyadicPrimeBand A j.val).card = (T ∩ dyadicPrimeBand A j.val).card)

/-- Within a regular count fiber, small canonical subset-sum support has
conditional weight at most `2 / L`.  The factor two is paid once for the
complete tuple law across all bands. -/
theorem dyadicPrime_conditional_bad_support_weight_le {A b d v L lam : ℝ}
    {k D : ℕ} {T : Finset ℕ} (ha : log 2 ≤ A)
    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d)
    (hv : 1 < v) (hL : 0 < L) (hlam : 0 < lam)
    (hgood : ¬ ReverseCountBarrierFailure k v D (dyadicPrimeTail A k) T)
    (hreg : primeCountRegularity A k (dyadicPrimeBand A) T ≤ primeMarkRegularityCutoff) :
    (∑ U ∈ dyadicCountFiber A k T with
      volume.real (primeSubsetSumSupport U d) <
        (A * (2 : ℝ) ^ k) / (L * dyadicPrimeEnergyConstant b (v - 1) (D : ℝ)),
      primeTiltWeight (dyadicPrimeUniverse A k) lam U) /
      (∑ U ∈ dyadicCountFiber A k T, primeTiltWeight (dyadicPrimeUniverse A k) lam U) ≤ 2 / L := by
  classical
  let P : Fin k → Finset ℕ := fun j ↦ dyadicPrimeBand A j.val
  let n : Fin k → ℕ := fun j ↦ (T ∩ P j).card
  let a : Fin k → ℝ := fun j ↦ A * (2 : ℝ) ^ j.val
  let M : Fin k → ℝ := fun j ↦ primeLogWindowMass (a j) (2 * a j)
  let threshold : ℝ := (A * (2 : ℝ) ^ k) /
    (L * dyadicPrimeEnergyConstant b (v - 1) (D : ℝ))
  let F : (Fin k → Finset ℕ) → ℝ := fun U ↦
    if volume.real (primeSubsetSumSupport (primeBandUnion U) d) < threshold then 1 else 0
  let w := fun i : DyadicCountCoordinate A k T ↦
    dyadicPrimeMarkWeight A (dyadicCountCoordinateBand i).val
  let mark := fun (i : DyadicCountCoordinate A k T)
    (p : DyadicPrimeMark A (dyadicCountCoordinateBand i).val) ↦ log (p : ℕ)
  let H : DyadicCountPrimeMarks A k T → ℝ := fun x ↦
    if volume.real (finiteIntervalSupport (finiteSubsetSumAtom mark x) d) < threshold then 1 else 0
  let G : BandTuple P n → ℝ := fun x ↦ H (bandTupleSigmaEquiv P n x)
  have hA : 0 < A := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha
  have hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)) := by
    intro i j hij
    apply dyadicPrimeBand_pairwise_disjoint hA
    exact fun h ↦ hij (Fin.ext h)
  have hP : ∀ j p, p ∈ P j → p.Prime := fun j ↦ dyadicPrimeBand_prime A j.val
  have haBand : ∀ j, log 2 ≤ a j :=
    fun j ↦ (dyadicPrimeMark_scale_conditions ha hlarge j.val).1
  have hlargeBand : ∀ j, 4 * mertensErrorConstant ≤ a j * log 2 :=
    fun j ↦ (dyadicPrimeMark_scale_conditions ha hlarge j.val).2
  have hM : ∀ j, 0 < M j := by
    intro j
    exact (half_pos (log_pos (by norm_num : (1 : ℝ) < 2))).trans_le
      (primeLogWindowMass_dyadic_lower (haBand j) (hlargeBand j))
  have hreg' : primeBandCountRegularity a n ≤ primeMarkRegularityCutoff := by
    rw [show primeBandCountRegularity a n =
      primeCountRegularity A k (dyadicPrimeBand A) T from primeBandCountRegularity_dyadic A k T]
    exact hreg
  have hratio := regular_primeBand_likelihood_bound a n hreg'
  have hmass := regular_primeBand_distinct_mass a n haBand hlargeBand hreg'
  have hG : ∀ x, 0 ≤ G x := by
    intro x
    dsimp [G, H]
    split_ifs <;> norm_num
  have hmatch : ∀ x ∈ distinctBandTuples P n, F (bandTupleSupport x) = G x := by
    intro x hx
    have hx' : BandTupleDistinct x := by simpa only [distinctBandTuples,
      Finset.mem_filter, Finset.mem_univ, true_and] using hx
    have hs := distinct_bandTuple_subsetSum_support hdis x hx' d
    exact congrArg (fun S : Set ℝ ↦ if volume.real S < threshold then (1 : ℝ) else 0) hs.symm
  have hlog : ∀ j p, p ∈ P j → a j ≤ log (p : ℝ) := by
    intro j p hp
    exact (mem_dyadicPrimeBand.mp hp).2.1.le
  have hc := ambient_primeTilt_fixedCounts_expectation_le_two_iid_extension
    P hdis hP hlam M hM n F G hG hmatch a hlog hratio hmass
  have hIid : (∑ x : BandTuple P n, bandReciprocalTupleWeight M x * G x) ≤ 1 / L := by
    have hsum : (∑ x : BandTuple P n, bandReciprocalTupleWeight M x * G x) =
        ∑ x : DyadicCountPrimeMarks A k T, finiteProductWeight w x * H x := by
      calc
        _ = ∑ x : BandTuple P n,
            finiteProductWeight w (bandTupleSigmaEquiv P n x) * H (bandTupleSigmaEquiv P n x) := by
          apply sum_congr rfl
          intro x _
          rw [bandReciprocalTupleWeight_eq_sigma]
          rfl
        _ = _ := (bandTupleSigmaEquiv P n).sum_comp (fun x ↦ finiteProductWeight w x * H x)
    rw [hsum]
    have hi := dyadicCountPrimeMark_bad_support_weight_le ha hlarge hb hd hscale hv hL hgood
    simpa only [H, w, mark, threshold, sum_filter, mul_ite, mul_one, mul_zero] using hi
  have hUnion : primeBandUnion P = dyadicPrimeUniverse A k := primeBandUnion_dyadic A k
  rw [hUnion] at hc
  have hc' : (∑ U ∈ dyadicCountFiber A k T,
      primeTiltWeight (dyadicPrimeUniverse A k) lam U * F (fun j ↦ U ∩ P j)) /
      (∑ U ∈ dyadicCountFiber A k T, primeTiltWeight (dyadicPrimeUniverse A k) lam U) ≤
      2 * ∑ x : BandTuple P n, bandReciprocalTupleWeight M x * G x := by
    simpa only [dyadicCountFiber, P, n, Finset.sum_filter] using hc
  have hnum : (∑ U ∈ dyadicCountFiber A k T,
      primeTiltWeight (dyadicPrimeUniverse A k) lam U * F (fun j ↦ U ∩ P j)) =
      ∑ U ∈ dyadicCountFiber A k T with volume.real (primeSubsetSumSupport U d) < threshold,
        primeTiltWeight (dyadicPrimeUniverse A k) lam U := by
    rw [sum_filter]
    apply sum_congr rfl
    intro U hU
    have hUsub : U ⊆ primeBandUnion P := by
      rw [hUnion]
      have hU' := hU
      simp only [dyadicCountFiber, Finset.mem_filter, Finset.mem_powerset] at hU'
      exact hU'.1
    have hu : primeBandUnion (fun j ↦ U ∩ P j) = U := primeBand_intersections_union P hUsub
    dsimp [F]
    rw [hu]
    split_ifs <;> simp
  rw [hnum] at hc'
  exact hc'.trans ((mul_le_mul_of_nonneg_left hIid (by norm_num)).trans_eq (by ring))

end Erdos859Verification

