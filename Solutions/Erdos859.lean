section

/- A deterministic cyclic ballot lemma and its finite weighted consequence. -/

open Finset

namespace Erdos859Verification

/-- Start a zero-sum periodic walk after a maximal partial sum. -/
theorem periodic_zero_sum_exists_nonpos_prefix {n : ℕ} (hn : 0 < n)
    (f : ℕ → ℤ) (hp : Function.Periodic f n) (hs : ∑ i ∈ range n, f i = 0) :
    ∃ r < n, ∀ k ≤ n, (∑ i ∈ range k, f (r + i)) ≤ 0 := by
  let s : ℕ → ℤ := fun k ↦ ∑ i ∈ range k, f i
  obtain ⟨r, hr, hmax⟩ := (range n).exists_max_image s ⟨0, mem_range.mpr hn⟩
  refine ⟨r, mem_range.mp hr, ?_⟩
  intro k hk
  have hsplit : s (r + k) = s r + ∑ i ∈ range k, f (r + i) := sum_range_add f r k
  have hbound : s (r + k) ≤ s r := by
    by_cases hsmall : r + k < n
    · exact hmax (r + k) (mem_range.mpr hsmall)
    · have ht : r + k - n < n := by have := mem_range.mp hr; omega
      have heq : s (r + k) = s (r + k - n) := by
        have he : r + k = n + (r + k - n) := by omega
        conv_lhs => rw [he]
        dsimp only [s]
        rw [sum_range_add]
        simp only [hs, zero_add]
        exact sum_congr rfl (fun i _ ↦ by simpa only [Nat.add_comm] using hp i)
      rw [heq]
      exact hmax _ (mem_range.mpr ht)
  omega

def cyclicRotate {n : ℕ} {α : Type*} (r : Fin n) (x : Fin n → α) : Fin n → α :=
  fun i ↦ x (finCycle r i)

def CyclicBallot {n : ℕ} (x : Fin n → ℕ) : Prop :=
  ∀ k ≤ n, (∑ i : Fin n with i.val < k, x i) ≤ k

theorem sum_cyclicRotate_prefix {n k : ℕ} (hn : 0 < n) (hk : k ≤ n)
    (x : Fin n → ℕ) (r : Fin n) :
    (∑ i : Fin n with i.val < k, cyclicRotate r x i) =
      ∑ j ∈ range k, x ⟨(r.val + j) % n, Nat.mod_lt _ hn⟩ := by
  classical
  apply sum_bij (fun i _ ↦ i.val)
  · intro i hi
    exact mem_range.mpr (mem_filter.mp hi).2
  · intro i _ j _ hij
    exact Fin.ext hij
  · intro j hj
    have hjn : j < n := (mem_range.mp hj).trans_le hk
    exact ⟨⟨j, hjn⟩, mem_filter.mpr ⟨mem_univ _, mem_range.mp hj⟩, rfl⟩
  · intro i _
    change x (finCycle r i) = x ⟨(r.val + i.val) % n, Nat.mod_lt _ hn⟩
    congr 1
    apply Fin.ext
    change (i.val + r.val) % n = (r.val + i.val) % n
    rw [Nat.add_comm]

/-- Every natural tuple whose total equals its length has a cyclic rotation
whose every prefix contains at most its length in total mass. -/
theorem exists_cyclic_ballot {n : ℕ} (hn : 0 < n) (x : Fin n → ℕ)
    (hsum : ∑ i, x i = n) : ∃ r : Fin n, CyclicBallot (cyclicRotate r x) := by
  let f : ℕ → ℤ := fun j ↦ (x ⟨j % n, Nat.mod_lt _ hn⟩ : ℤ) - 1
  have hp : Function.Periodic f n := by
    intro j
    simp [f]
  have hs : (∑ j ∈ range n, f j) = 0 := by
    rw [← Fin.sum_univ_eq_sum_range f n]
    have hf (i : Fin n) : f i.val = (x i : ℤ) - 1 := by
      simp only [f, Nat.mod_eq_of_lt i.isLt]
    simp_rw [hf]
    rw [sum_sub_distrib]
    simp only [← Nat.cast_sum, hsum, sum_const, card_univ, Fintype.card_fin,
      nsmul_eq_mul, mul_one, sub_self]
  obtain ⟨r, hr, hprefix⟩ := periodic_zero_sum_exists_nonpos_prefix hn f hp hs
  refine ⟨⟨r, hr⟩, ?_⟩
  intro k hk
  rw [sum_cyclicRotate_prefix hn hk]
  have h := hprefix k hk
  dsimp only [f] at h
  rw [sum_sub_distrib] at h
  simp only [sum_const, card_range, nsmul_eq_mul, mul_one] at h
  exact_mod_cast (sub_nonpos.mp h)

def cyclicRotateEquiv {n : ℕ} {α : Type*} (r : Fin n) : Equiv.Perm (Fin n → α) where
  toFun := cyclicRotate r
  invFun x i := x ((finCycle r).symm i)
  left_inv x := by
    ext i
    change x (finCycle r ((finCycle r).symm i)) = x i
    rw [Equiv.apply_symm_apply]
  right_inv x := by
    ext i
    change x ((finCycle r).symm (finCycle r i)) = x i
    rw [Equiv.symm_apply_apply]

theorem sum_cyclicRotate {n : ℕ} (x : Fin n → ℕ) (r : Fin n) :
    (∑ i, cyclicRotate r x i) = ∑ i, x i := Equiv.sum_comp (finCycle r) x

/-- Finite weighted covering by permutations. Stabilizers cause no loss:
no assertion that every orbit has the same cardinality is needed. -/
theorem weighted_permutation_cover {α ι : Type*} [DecidableEq α] [Fintype ι]
    (S : Finset α) (e : ι → Equiv.Perm α) (W : α → ℝ) (Good : α → Prop)
    [DecidablePred Good]
    (hS : ∀ r x, e r x ∈ S ↔ x ∈ S)
    (hW : ∀ x ∈ S, 0 ≤ W x)
    (hinv : ∀ r x, x ∈ S → W (e r x) = W x)
    (hcover : ∀ x ∈ S, ∃ r, Good (e r x)) :
    (∑ x ∈ S, W x) ≤ (Fintype.card ι : ℝ) * ∑ x ∈ S with Good x, W x := by
  classical
  have hinner (r : ι) :
      (∑ x ∈ S, if Good (e r x) then W x else 0) = ∑ x ∈ S with Good x, W x := by
    rw [sum_filter]
    apply sum_bij (fun x _ ↦ e r x)
    · intro x hx
      exact (hS r x).mpr hx
    · intro x _ y _ hxy
      exact (e r).injective hxy
    · intro y hy
      refine ⟨(e r).symm y, ?_, (e r).apply_symm_apply y⟩
      exact (hS r _).mp (by simpa using hy)
    · intro x hx
      rw [hinv r x hx]
  calc
    _ ≤ ∑ x ∈ S, ∑ r : ι, if Good (e r x) then W x else 0 := by
      apply sum_le_sum
      intro x hx
      obtain ⟨r, hr⟩ := hcover x hx
      have hnonneg (i : ι) : 0 ≤ if Good (e i x) then W x else 0 := by
        split_ifs <;> first | exact hW x hx | exact le_rfl
      simpa only [if_pos hr] using single_le_sum (fun i _ ↦ hnonneg i) (mem_univ r)
    _ = ∑ r : ι, ∑ x ∈ S, if Good (e r x) then W x else 0 := sum_comm
    _ = _ := by simp only [hinner, sum_const, card_univ, nsmul_eq_mul]

/-- Among tuples of total mass `n`, every rotation-invariant nonnegative
weight assigns at least a `1/n` fraction to the ballot event. -/
theorem cyclic_ballot_weight_lower {n : ℕ} (hn : 0 < n)
    (S : Finset (Fin n → ℕ)) (W : (Fin n → ℕ) → ℝ)
    (hS : ∀ r x, cyclicRotate r x ∈ S ↔ x ∈ S)
    (hW : ∀ x ∈ S, 0 ≤ W x)
    (hinv : ∀ r x, x ∈ S → W (cyclicRotate r x) = W x)
    (htotal : ∀ x ∈ S, ∑ i, x i = n) :
    (∑ x ∈ S, W x) / n ≤ ∑ x ∈ S with CyclicBallot x, W x := by
  have h := weighted_permutation_cover S cyclicRotateEquiv W CyclicBallot
    hS hW hinv (fun x hx ↦ exists_cyclic_ballot hn x (htotal x hx))
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  rw [div_le_iff₀ hnR]
  simpa only [Fintype.card_fin, mul_comm] using h

theorem cyclic_ballot_conditional_weight_lower {n : ℕ} (hn : 0 < n)
    (S : Finset (Fin n → ℕ)) (W : (Fin n → ℕ) → ℝ)
    (hS : ∀ r x, cyclicRotate r x ∈ S ↔ x ∈ S)
    (hW : ∀ x ∈ S, 0 ≤ W x)
    (hinv : ∀ r x, x ∈ S → W (cyclicRotate r x) = W x) :
    (∑ x ∈ S with (∑ i, x i) = n, W x) / n ≤
      ∑ x ∈ S with (∑ i, x i) = n ∧ CyclicBallot x, W x := by
  classical
  have h := cyclic_ballot_weight_lower hn (S.filter (fun x ↦ (∑ i, x i) = n)) W
    (fun r x ↦ by simp only [mem_filter, hS, sum_cyclicRotate])
    (fun x hx ↦ hW x (mem_filter.mp hx).1)
    (fun r x hx ↦ hinv r x (mem_filter.mp hx).1)
    (fun _ hx ↦ (mem_filter.mp hx).2)
  simpa only [filter_filter] using h

theorem cyclic_ballot_conditional_probability_lower {n : ℕ} (hn : 0 < n)
    (S : Finset (Fin n → ℕ)) (W : (Fin n → ℕ) → ℝ)
    (hS : ∀ r x, cyclicRotate r x ∈ S ↔ x ∈ S)
    (hW : ∀ x ∈ S, 0 ≤ W x)
    (hinv : ∀ r x, x ∈ S → W (cyclicRotate r x) = W x)
    (hmass : 0 < ∑ x ∈ S with (∑ i, x i) = n, W x) :
    1 / (n : ℝ) ≤
      (∑ x ∈ S with (∑ i, x i) = n ∧ CyclicBallot x, W x) /
        (∑ x ∈ S with (∑ i, x i) = n, W x) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  apply (div_le_div_iff₀ hnR hmass).mpr
  simpa only [one_mul] using (div_le_iff₀ hnR).mp
    (cyclic_ballot_conditional_weight_lower hn S W hS hW hinv)

theorem cyclic_ballot_card_lower {n : ℕ} (hn : 0 < n)
    (S : Finset (Fin n → ℕ))
    (hS : ∀ r x, cyclicRotate r x ∈ S ↔ x ∈ S)
    (htotal : ∀ x ∈ S, ∑ i, x i = n) :
    (S.card : ℝ) / n ≤ (S.filter CyclicBallot).card := by
  simpa using cyclic_ballot_weight_lower hn S (fun _ ↦ 1) hS
    (fun _ _ ↦ zero_le_one) (fun _ _ _ ↦ rfl) htotal

end Erdos859Verification

