      (3 * ((3 : ℝ) / 2) ^ j)) atTop (𝓝 0) := tendsto_const_nhds.div_atTop ha
  apply tendsto_sub_nhds_zero_iff.mp
  apply squeeze_zero_norm' _ he
  apply Filter.Eventually.of_forall
  intro j
  have hpow : 1 ≤ ((3 : ℝ) / 2) ^ j := one_le_pow₀ (by norm_num)
  have hlog2 : log (2 : ℝ) ≤ 1 := by
    have := log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
