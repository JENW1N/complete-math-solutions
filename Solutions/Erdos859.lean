  rw [tupleSupport, prod_image]
  intro i _ j _ hij
  exact hx (Subtype.ext hij)

noncomputable def tupleSupportFiberEquiv {α : Type*} [DecidableEq α]
    {P T : Finset α} {n : ℕ} (hTP : T ⊆ P) (hT : T.card = n) :
    {x : Fin n → P // Function.Injective x ∧ tupleSupport x = T} ≃ (Fin n ↪ T) := by
  classical
  have hsurj (e : Fin n ↪ T) : Function.Surjective e :=
    ((Fintype.bijective_iff_injective_and_card e).mpr
      ⟨e.injective, by simp [hT]⟩).2
  refine
    { toFun := fun x ↦
        { toFun := fun i ↦ ⟨(x.val i).val, ?_⟩
          inj' := ?_ }
      invFun := fun e ↦ ⟨fun i ↦ ⟨(e i).val, hTP (e i).property⟩, ?_, ?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · have hm : (x.val i).val ∈ tupleSupport x.val :=
      mem_image.mpr ⟨i, mem_univ i, rfl⟩
    exact (congrArg (fun S : Finset α ↦ (x.val i).val ∈ S) x.property.2).mp hm
  · intro i j hij
    apply x.property.1
    apply Subtype.ext
    exact congrArg (fun z : T ↦ z.val) hij
  · intro i j hij
    apply e.injective
    apply Subtype.ext
    exact congrArg (fun z : P ↦ z.val) hij
  · ext p
    constructor
    · intro hp
      obtain ⟨i, _, rfl⟩ := mem_image.mp hp
      exact (e i).property
    · intro hp
      obtain ⟨i, hi⟩ := hsurj e ⟨p, hp⟩
      exact mem_image.mpr ⟨i, mem_univ i, congrArg Subtype.val hi⟩
  · intro x
    apply Subtype.ext
    funext i
    rfl
  · intro e
    apply Function.Embedding.ext
    intro i
    rfl

theorem card_tupleSupport_fiber {α : Type*} [DecidableEq α]
    {P T : Finset α} {n : ℕ} (hTP : T ⊆ P) (hT : T.card = n) :
    (univ.filter (fun x : Fin n → P ↦ Function.Injective x ∧ tupleSupport x = T)).card =
      n.factorial := by
  classical
  have h := Fintype.card_congr (tupleSupportFiberEquiv hTP hT)
  simpa only [Fintype.card_subtype, Fintype.card_embedding_eq, Fintype.card_coe,
    Fintype.card_fin, hT, Nat.descFactorial_self] using h

theorem sum_injective_tuple_support {α : Type*} [DecidableEq α]
    (P : Finset α) (n : ℕ) (G : Finset α → ℝ) :
    (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop), G (tupleSupport x)) =
      (n.factorial : ℝ) * ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), G T := by
  classical
  let S := univ.filter (Function.Injective : (Fin n → P) → Prop)
  let Q := P.powerset.filter (fun T ↦ T.card = n)
  have hmap : ∀ x ∈ S, tupleSupport x ∈ Q := by
    intro x hx
    exact mem_filter.mpr ⟨mem_powerset.mpr (tupleSupport_subset x),
      card_tupleSupport x (mem_filter.mp hx).2⟩
  change (∑ x ∈ S, G (tupleSupport x)) = (n.factorial : ℝ) * ∑ T ∈ Q, G T
  calc
    _ = ∑ T ∈ Q, ∑ x ∈ S.filter (fun x ↦ tupleSupport x = T), G T :=
      (sum_fiberwise_of_maps_to' hmap G).symm
    _ = ∑ T ∈ Q, (n.factorial : ℝ) * G T := by
      apply sum_congr rfl
      intro T hT
      have heq : S.filter (fun x ↦ tupleSupport x = T) =
          univ.filter (fun x : Fin n → P ↦ Function.Injective x ∧ tupleSupport x = T) := by
        ext x
        simp [S]
      have hc : (S.filter (fun x ↦ tupleSupport x = T)).card = n.factorial := by
        rw [heq]
        exact card_tupleSupport_fiber (mem_powerset.mp (mem_filter.mp hT).1)
          (mem_filter.mp hT).2
      simp only [sum_const, hc, nsmul_eq_mul]
    _ = _ := (mul_sum _ _ _).symm

theorem sum_injective_tuple_product {α : Type*} [DecidableEq α]
    (P : Finset α) (n : ℕ) (w : α → ℝ) (F : Finset α → ℝ) :
    (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
      (∏ i, w (x i).val) * F (tupleSupport x)) =
      (n.factorial : ℝ) * ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n),
        (∏ p ∈ T, w p) * F T := by
  calc
    _ = ∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ p ∈ tupleSupport x, w p) * F (tupleSupport x) := by
      apply sum_congr rfl
      intro x hx
      rw [prod_tupleSupport x (mem_filter.mp hx).2]
    _ = _ := sum_injective_tuple_support P n (fun T ↦ (∏ p ∈ T, w p) * F T)

theorem injective_tuple_product_expectation {α : Type*} [DecidableEq α]
    (P : Finset α) (n : ℕ) (w : α → ℝ) (F : Finset α → ℝ) :
    (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, w (x i).val) * F (tupleSupport x)) /
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop), ∏ i, w (x i).val) =
      (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), (∏ p ∈ T, w p) * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), ∏ p ∈ T, w p) := by
  have hden := sum_injective_tuple_product P n w (fun _ ↦ 1)
  simp only [mul_one] at hden
  rw [sum_injective_tuple_product, hden]
  exact mul_div_mul_left _ _ (by exact_mod_cast (Nat.factorial_ne_zero n))

theorem primeTilt_fixedCard_expectation_eq_ordered_odds {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (n : ℕ) (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T) =
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, 1 / (((x i).val : ℝ) - 1)) * F (tupleSupport x)) /
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          ∏ i, 1 / (((x i).val : ℝ) - 1)) := by
  rw [primeTilt_fixedCard_expectation_eq_odds hP hlam]
  exact (injective_tuple_product_expectation P n (fun p ↦ 1 / ((p : ℝ) - 1)) F).symm

noncomputable def reciprocalTupleWeight {P : Finset ℕ} {n : ℕ}
    (M : ℝ) (x : Fin n → P) : ℝ :=
  finiteProductWeight (fun _ p ↦ (1 / (p.val : ℝ)) / M) x

noncomputable def primeTupleOddsRatio {P : Finset ℕ} {n : ℕ}
    (x : Fin n → P) : ℝ := ∏ i, (x i).val / (((x i).val : ℝ) - 1)

theorem reciprocalTupleWeight_mul_oddsRatio {P : Finset ℕ} {n : ℕ}
    (hP : ∀ p ∈ P, p.Prime) (M : ℝ) (x : Fin n → P) :
    reciprocalTupleWeight M x * primeTupleOddsRatio x =
      (∏ i, 1 / (((x i).val : ℝ) - 1)) / M ^ n := by
  unfold reciprocalTupleWeight finiteProductWeight primeTupleOddsRatio
  rw [← prod_mul_distrib]
  calc
    _ = ∏ i, (1 / (((x i).val : ℝ) - 1)) / M := by
      apply prod_congr rfl
      intro i _
      have hp0 : ((x i).val : ℝ) ≠ 0 := by
        exact_mod_cast (hP (x i).val (x i).property).ne_zero
      field_simp
    _ = _ := by rw [prod_div_distrib]; simp

theorem reweighted_reciprocalTuple_expectation {P : Finset ℕ} {n : ℕ}
    (hP : ∀ p ∈ P, p.Prime) {M : ℝ} (hM : M ≠ 0) (F : Finset ℕ → ℝ) :
    (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        reciprocalTupleWeight M x * primeTupleOddsRatio x * F (tupleSupport x)) /
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          reciprocalTupleWeight M x * primeTupleOddsRatio x) =
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, 1 / (((x i).val : ℝ) - 1)) * F (tupleSupport x)) /
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          ∏ i, 1 / (((x i).val : ℝ) - 1)) := by
  have hnum :
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          reciprocalTupleWeight M x * primeTupleOddsRatio x * F (tupleSupport x)) =
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          (∏ i, 1 / (((x i).val : ℝ) - 1)) * F (tupleSupport x)) / M ^ n := by
    rw [sum_div]
    apply sum_congr rfl
    intro x _
    rw [reciprocalTupleWeight_mul_oddsRatio hP]
    ring
  have hden :
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          reciprocalTupleWeight M x * primeTupleOddsRatio x) =
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          ∏ i, 1 / (((x i).val : ℝ) - 1)) / M ^ n := by
    simp_rw [reciprocalTupleWeight_mul_oddsRatio hP]
    rw [sum_div]
  rw [hnum, hden]
  exact div_div_div_cancel_right₀ (pow_ne_zero n hM) _ _

theorem primeTilt_fixedCard_expectation_eq_reweighted_tuples {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam M : ℝ} (hlam : 0 < lam) (hM : M ≠ 0)
    (n : ℕ) (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T) =
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        reciprocalTupleWeight M x * primeTupleOddsRatio x * F (tupleSupport x)) /
        (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
          reciprocalTupleWeight M x * primeTupleOddsRatio x) := by
  rw [primeTilt_fixedCard_expectation_eq_ordered_odds hP hlam]
  exact (reweighted_reciprocalTuple_expectation hP hM F).symm

theorem primeTupleOddsRatio_bounds {P : Finset ℕ} {n : ℕ} {a : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hlarge : ∀ p ∈ P, a ≤ Real.log (p : ℝ))
    (x : Fin n → P) (hx : Function.Injective x) :
    1 ≤ primeTupleOddsRatio x ∧
      primeTupleOddsRatio x ≤ Real.exp (2 * (n : ℝ) * Real.exp (-a)) := by
  have h := prime_odds_ratio_bounds
    (fun p hp ↦ hP p (tupleSupport_subset x hp))
    (fun p hp ↦ hlarge p (tupleSupport_subset x hp))
  rw [prod_tupleSupport x hx, card_tupleSupport x hx] at h
  exact h

theorem primeTilt_fixedCard_expectation_le_two_iid {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam M a : ℝ} (hlam : 0 < lam) (hM : 0 < M)
    (n : ℕ) (F : Finset ℕ → ℝ) (hF : ∀ T, 0 ≤ F T)
    (hlarge : ∀ p ∈ P, a ≤ Real.log (p : ℝ))
    (hratio : Real.exp (2 * (n : ℝ) * Real.exp (-a)) ≤ 3 / 2)
    (hmass : (3 : ℝ) / 4 ≤
      ∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop), reciprocalTupleWeight M x) :
    (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T) ≤
      2 * ∑ x : Fin n → P, reciprocalTupleWeight M x * F (tupleSupport x) := by
  rw [primeTilt_fixedCard_expectation_eq_reweighted_tuples hP hlam hM.ne']
  apply finite_normalized_reweight_le_two _ _ _ _
  · intro x
    unfold reciprocalTupleWeight
    exact finiteProductWeight_nonneg (fun _ _ ↦ by positivity) x
  · intro x
    exact hF (tupleSupport x)
  · intro x hx
    exact (primeTupleOddsRatio_bounds hP hlarge x (mem_filter.mp hx).2).1
  · intro x hx
    exact (primeTupleOddsRatio_bounds hP hlarge x (mem_filter.mp hx).2).2.trans hratio
  · exact hmass

end Erdos859Verification

end

/- Inlined development module: PrimeDyadicBarrier.lean -/

section

/- Concrete dyadic prime bands and their uniform reverse-count barrier. -/

open Finset Filter Real
open scoped Topology

namespace Erdos859Verification

noncomputable def dyadicPrimeBand (A : ℝ) (j : ℕ) : Finset ℕ :=
  primeLogWindow (A * (2 : ℝ) ^ j) (2 * (A * (2 : ℝ) ^ j))

noncomputable def dyadicPrimeUniverse (A : ℝ) (k : ℕ) : Finset ℕ :=
  (range k).biUnion (dyadicPrimeBand A)

/-- The union of the top `ell + 1` bands when `ell < k`. -/
noncomputable def dyadicPrimeTail (A : ℝ) (k ell : ℕ) : Finset ℕ :=
  (Ico (k - (ell + 1)) k).biUnion (dyadicPrimeBand A)

theorem mem_dyadicPrimeBand {A : ℝ} {j p : ℕ} :
    p ∈ dyadicPrimeBand A j ↔ p.Prime ∧
      A * (2 : ℝ) ^ j < log (p : ℝ) ∧ log (p : ℝ) ≤ 2 * (A * (2 : ℝ) ^ j) :=
  mem_primeLogWindow

theorem dyadicPrimeBand_prime (A : ℝ) (j : ℕ) :
    ∀ p ∈ dyadicPrimeBand A j, p.Prime := fun _ hp ↦ (mem_dyadicPrimeBand.mp hp).1

theorem dyadicPrimeBand_pairwise_disjoint {A : ℝ} (hA : 0 < A) :
    Pairwise (fun i j : ℕ ↦ Disjoint (dyadicPrimeBand A i) (dyadicPrimeBand A j)) := by
  have hstep {i j : ℕ} (hij : i < j) :
      Disjoint (dyadicPrimeBand A i) (dyadicPrimeBand A j) := by
    apply Finset.disjoint_left.mpr
    intro p hpi hpj
    have hi := (mem_dyadicPrimeBand.mp hpi).2.2
    have hj := (mem_dyadicPrimeBand.mp hpj).2.1
    have hpow : (2 : ℝ) ^ (i + 1) ≤ 2 ^ j :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_of_lt hij)
    have hsep : 2 * (A * (2 : ℝ) ^ i) ≤ A * (2 : ℝ) ^ j := by
      calc
        _ = A * (2 : ℝ) ^ (i + 1) := by rw [pow_succ]; ring
        _ ≤ _ := mul_le_mul_of_nonneg_left hpow hA.le
    exact (not_lt_of_ge (hi.trans hsep)) hj
  intro i j hij
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact hstep hij
  · exact (hstep hji).symm

theorem dyadicPrimeUniverse_prime (A : ℝ) (k : ℕ) :
    ∀ p ∈ dyadicPrimeUniverse A k, p.Prime := by
  intro p hp
  obtain ⟨j, _, hpj⟩ := Finset.mem_biUnion.mp hp
  exact dyadicPrimeBand_prime A j p hpj

theorem dyadicPrimeBand_subset_universe {A : ℝ} {k j : ℕ} (hj : j < k) :
    dyadicPrimeBand A j ⊆ dyadicPrimeUniverse A k := by
  intro p hp
  exact Finset.mem_biUnion.mpr ⟨j, Finset.mem_range.mpr hj, hp⟩

theorem dyadicPrimeTail_subset_universe (A : ℝ) (k ell : ℕ) :
    dyadicPrimeTail A k ell ⊆ dyadicPrimeUniverse A k := by
  intro p hp
  obtain ⟨j, hj, hpj⟩ := Finset.mem_biUnion.mp hp
  exact dyadicPrimeBand_subset_universe (Finset.mem_Ico.mp hj).2 hpj

theorem dyadicPrimeTail_full {A : ℝ} {k : ℕ} (hk : 0 < k) :
    dyadicPrimeTail A k (k - 1) = dyadicPrimeUniverse A k := by
  have hk1 : k - 1 + 1 = k := Nat.sub_add_cancel hk
  simp only [dyadicPrimeTail, hk1, Nat.sub_self, Nat.Ico_zero_eq_range, dyadicPrimeUniverse]

theorem sum_dyadicPrimeTail {A : ℝ} (hA : 0 < A) (k ell : ℕ) (f : ℕ → ℝ) :
    (∑ p ∈ dyadicPrimeTail A k ell, f p) =
      ∑ j ∈ Ico (k - (ell + 1)) k, ∑ p ∈ dyadicPrimeBand A j, f p := by
  apply sum_biUnion
  intro i _ j _ hij
  exact dyadicPrimeBand_pairwise_disjoint hA hij

/-- Counts add exactly across the bands; their half-open endpoints cause no
duplicate prime at an adjacent boundary. -/
theorem card_inter_dyadicPrimeBands {A : ℝ} (hA : 0 < A)
    (I : Finset ℕ) (T : Finset ℕ) :
    (T ∩ I.biUnion (dyadicPrimeBand A)).card =
      ∑ j ∈ I, (T ∩ dyadicPrimeBand A j).card := by
  have heq : T ∩ I.biUnion (dyadicPrimeBand A) =
      I.biUnion (fun j ↦ T ∩ dyadicPrimeBand A j) := by
    ext p
    simp only [Finset.mem_inter, Finset.mem_biUnion]
    aesop
  rw [heq]
  apply card_biUnion
  intro i _ j _ hij
  exact (dyadicPrimeBand_pairwise_disjoint hA hij).mono inter_subset_right inter_subset_right

theorem card_inter_dyadicPrimeTail {A : ℝ} (hA : 0 < A) (k ell : ℕ) (T : Finset ℕ) :
    (T ∩ dyadicPrimeTail A k ell).card =
      ∑ j ∈ Ico (k - (ell + 1)) k, (T ∩ dyadicPrimeBand A j).card :=
  card_inter_dyadicPrimeBands hA _ _

theorem card_inter_dyadicPrimeUniverse {A : ℝ} (hA : 0 < A) (k : ℕ) (T : Finset ℕ) :
    (T ∩ dyadicPrimeUniverse A k).card =
      ∑ j ∈ range k, (T ∩ dyadicPrimeBand A j).card :=
  card_inter_dyadicPrimeBands hA _ _

/-- A lower mean bound on each band adds to the correct linear lower bound
on every terminal union of bands. -/
theorem dyadicPrimeTail_mean_lower {A lam mu : ℝ} (hA : 0 < A) {k ell : ℕ}
    (hell : ell < k)
    (hmean : ∀ j < k, mu ≤ ∑ p ∈ dyadicPrimeBand A j, primeTiltSelectionProbability lam p) :
    mu * (ell + 1 : ℕ) ≤
      ∑ p ∈ dyadicPrimeTail A k ell, primeTiltSelectionProbability lam p := by
  rw [sum_dyadicPrimeTail hA]
  have hcard : (Ico (k - (ell + 1)) k).card = ell + 1 := by
    rw [Nat.card_Ico, Nat.sub_sub_self (Nat.succ_le_of_lt hell)]
  calc
    _ = ∑ _j ∈ Ico (k - (ell + 1)) k, mu := by simp [hcard, mul_comm]
    _ ≤ _ := sum_le_sum (fun j hj ↦ hmean j (Finset.mem_Ico.mp hj).2)

/-- Once the bottom band is high enough, the sharp mean bounds hold
simultaneously for every band above it. -/
theorem exists_dyadicPrimeBand_mean_cutoff {lam : ℝ}
    (hlam : 1 ≤ lam) (hcritical : 1 < lam * log 2) :
    ∃ A0 : ℝ, 0 < A0 ∧ ∀ A : ℝ, A0 ≤ A → ∀ j : ℕ,
      (lam * log 2 + 1) / 2 ≤
          (∑ p ∈ dyadicPrimeBand A j, primeTiltSelectionProbability lam p) ∧
      (∑ p ∈ dyadicPrimeBand A j, primeTiltSelectionProbability lam p) ≤ lam * log 2 + 1 := by
  obtain ⟨a0, ha0⟩ := eventually_atTop.mp
    (eventually_primeLogWindow_tilt_mean_bounds hlam hcritical)
  refine ⟨max a0 1, lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) (le_max_right _ _), ?_⟩
  intro A hA j
  have hA0 : 0 ≤ A := (by norm_num : (0 : ℝ) ≤ 1).trans ((le_max_right _ _).trans hA)
  have hbase : a0 ≤ A * (2 : ℝ) ^ j := by
    calc
      a0 ≤ A := (le_max_left _ _).trans hA
      _ = A * 1 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)) hA0
  exact ha0 _ hbase

/-- Every supercritical prime tilt has a fixed reverse-count speed above one.
The same offset and cutoff work for all finite numbers of bands and for any
larger ambient prime universe. -/
theorem exists_dyadic_prime_reverse_barrier {lam err : ℝ}
    (hcritical : 1 < lam * log 2) (herr : 0 < err) :
    ∃ v : ℝ, 1 < v ∧ ∃ D : ℕ, ∃ A0 : ℝ, 0 < A0 ∧
      ∀ A : ℝ, A0 ≤ A → ∀ k : ℕ, ∀ P : Finset ℕ,
        (∀ p ∈ P, p.Prime) → dyadicPrimeUniverse A k ⊆ P →
        (∑ T ∈ P.powerset.filter
            (ReverseCountBarrierFailure k v D (dyadicPrimeTail A k)),
          primeTiltWeight P lam T) ≤ err := by
  have hlog0 : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hlog1 : log (2 : ℝ) < 1 := by
    have h := log_lt_sub_one_of_pos (by norm_num : (0 : ℝ) < 2) (by norm_num : (2 : ℝ) ≠ 1)
    linarith
  have hlam : 1 ≤ lam := by
    by_contra h
    have hm := mul_lt_mul_of_pos_right (lt_of_not_ge h) hlog0
    linarith
  let mu : ℝ := (lam * log 2 + 1) / 2
  let v : ℝ := (lam * log 2 + 3) / 4
  have hv : 1 < v := by dsimp [v]; linarith
  have hvm : v < mu := by dsimp [v, mu]; linarith
  obtain ⟨D, hD⟩ := exists_uniform_reverse_count_barrier (zero_lt_one.trans hv) hvm herr
  obtain ⟨A0, hA0, hmeans⟩ := exists_dyadicPrimeBand_mean_cutoff hlam hcritical
  refine ⟨v, hv, D, A0, hA0, ?_⟩
  intro A hA k P hP hUP
  apply hD P lam hP (zero_lt_one.trans_le hlam) k (dyadicPrimeTail A k)
  · intro ell _
    exact (dyadicPrimeTail_subset_universe A k ell).trans hUP
  · intro ell hell
    exact dyadicPrimeTail_mean_lower (hA0.trans_le hA) hell
      (fun j _ ↦ (hmeans A hA j).1)

end Erdos859Verification

end

/- Inlined development module: SubsetSumSmoothing.lean -/

section

/- Fair subset sums connect the finite collision and smoothing estimates. -/

open Finset Real MeasureTheory

namespace Erdos859Verification

noncomputable def finiteSubsetSumAtom {ι : Type*} [Fintype ι]
    {α : ι → Type*} (mark : ∀ i, α i → ℝ) (x : ∀ i, α i) (b : ι → Bool) : ℝ :=
  ∑ i, if b i then mark i (x i) else 0

theorem finiteSubsetSumAtom_sub {ι : Type*} [Fintype ι]
    {α : ι → Type*} (mark : ∀ i, α i → ℝ) (x : ∀ i, α i) (b b' : ι → Bool) :
    finiteSubsetSumAtom mark x b - finiteSubsetSumAtom mark x b' =
      ∑ i, fairBitDifference (b i) (b' i) * mark i (x i) := by
  unfold finiteSubsetSumAtom
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro i _
  cases b i <;> cases b' i <;> simp [fairBitDifference]

noncomputable def finiteSubsetSumEnergy {ι : Type*} [Fintype ι] [DecidableEq ι]
