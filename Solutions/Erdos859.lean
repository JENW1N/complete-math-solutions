  simpa only [card_range, mem_range, PracticalSeedPattern] using h

theorem PracticalSeedPattern.seed_primes {N : ℕ} {T : Finset ℕ}
    (h : PracticalSeedPattern N T) : ({2, 3, 5, 7} : Finset ℕ) ⊆ T := by
  have hsingle {p : ℕ} (hp : (T ∩ {p}).Nonempty) : p ∈ T := by
    obtain ⟨q, hq⟩ := hp
    obtain ⟨hqT, hqp⟩ := mem_inter.mp hq
    simpa only [mem_singleton.mp hqp] using hqT
  have h2 : 2 ∈ T := hsingle (h 0 (by omega))
  have h3 : 3 ∈ T := hsingle (h 1 (by omega))
  have h5 : 5 ∈ T := hsingle (h 2 (by omega))
  have h7 : 7 ∈ T := hsingle (h 3 (by omega))
  simpa only [insert_subset_iff, singleton_subset_iff] using And.intro h2 ⟨h3, h5, h7⟩

theorem PracticalSeedPattern.prime_windows {N : ℕ} {T : Finset ℕ}
    (h : PracticalSeedPattern N T) (j : ℕ) (hj : j < N) :
    (T ∩ practicalPrimeBand j).Nonempty := by
  exact h (j + 4) (by omega)

end Erdos859Verification

