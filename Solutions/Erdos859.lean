/- Inlined development module: FiniteResidueCovering.lean -/

section

/- Fourier criteria for a finite collection of sums to cover every residue. -/

open Finset

namespace Erdos859Verification

theorem addChar_map_finset_sum {A ι : Type*} [AddCommMonoid A]
    (ψ : AddChar A ℂ) (s : Finset ι) (f : ι → A) :
    ψ (∑ i ∈ s, f i) = ∏ i ∈ s, ψ (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih => simp only [sum_insert hi, prod_insert hi, AddChar.map_add_eq_mul, ih]

noncomputable def residueCharacterMean {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] (v : Ω → ZMod r) (a : ZMod r) : ℂ :=
  (∑ z, ZMod.stdAddChar (a * v z)) / (Fintype.card Ω : ℂ)

theorem residueCharacterMean_zero {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (v : Ω → ZMod r) :
    residueCharacterMean v 0 = 1 := by
  have hc : (Fintype.card Ω : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  simp [residueCharacterMean, hc]

theorem residueCharacterMean_missing {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] (v : Ω → ZMod r) {x : ZMod r}
    (hx : ∀ z, v z ≠ x) :
    (∑ a : ZMod r, residueCharacterMean v a * ZMod.stdAddChar (-(a * x))) = 0 := by
  simp only [residueCharacterMean, div_mul_eq_mul_div, ← sum_div]
  suffices (∑ a : ZMod r, (∑ z, ZMod.stdAddChar (a * v z)) *
      ZMod.stdAddChar (-(a * x))) = 0 by rw [this, zero_div]
  simp only [sum_mul, ← AddChar.map_add_eq_mul]
  rw [sum_comm]
  apply sum_eq_zero
  intro z _
  have hn : v z - x ≠ 0 := sub_ne_zero.mpr (hx z)
  have h := AddChar.sum_eq_zero_of_ne_one (ZMod.isPrimitive_stdAddChar r hn)
  simp only [AddChar.mulShift_apply] at h
  convert h using 1
  apply sum_congr rfl
  intro a _
  congr 1
  ring

/-- If the total nonconstant Fourier mass is less than one, every residue is
represented. The proof uses exact finite character orthogonality. -/
theorem residue_cover_of_fourier_mass_lt_one {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (v : Ω → ZMod r)
    (hfourier : (∑ a ∈ (univ : Finset (ZMod r)).erase 0,
      ‖residueCharacterMean v a‖) < 1) :
    Function.Surjective v := by
  classical
  intro x
  by_contra hx
  have hn : ∀ z, v z ≠ x := by simpa only [not_exists] using hx
  have hsum := residueCharacterMean_missing v hn
  have hsplit := sum_erase_add (univ : Finset (ZMod r))
    (fun a ↦ residueCharacterMean v a * ZMod.stdAddChar (-(a * x))) (mem_univ 0)
  rw [hsum, residueCharacterMean_zero] at hsplit
  simp only [zero_mul, neg_zero, AddChar.map_zero_eq_one, mul_one] at hsplit
  have hsumneg : (∑ a ∈ (univ : Finset (ZMod r)).erase 0,
      residueCharacterMean v a * ZMod.stdAddChar (-(a * x))) = -1 := by
    linear_combination hsplit
  have hnorm := norm_sum_le ((univ : Finset (ZMod r)).erase 0)
    (fun a ↦ residueCharacterMean v a * ZMod.stdAddChar (-(a * x)))
  rw [hsumneg] at hnorm
  simp only [norm_neg, norm_one, norm_mul, ZMod.stdAddChar_apply,
    Circle.norm_coe, mul_one] at hnorm
  exact (not_lt_of_ge hnorm) hfourier

theorem residueCharacterMean_sum_copies {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] (v : Ω → ZMod r) (L : ℕ) (a : ZMod r) :
    residueCharacterMean (fun z : Fin L → Ω ↦ ∑ i, v (z i)) a =
      residueCharacterMean v a ^ L := by
  classical
  unfold residueCharacterMean
  simp only [mul_sum, addChar_map_finset_sum]
  rw [← Fintype.sum_pow (fun z : Ω ↦ ZMod.stdAddChar (a * v z)) L]
  simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow, div_pow]

/-- Repeated sums amplify any uniform Fourier contraction. -/
theorem residue_cover_sum_copies {r : ℕ} [NeZero r]
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (v : Ω → ZMod r)
    {q : ℝ}
    (hcontract : ∀ a : ZMod r, a ≠ 0 → ‖residueCharacterMean v a‖ ≤ q)
    {L : ℕ} (hsmall : ((r : ℝ) - 1) * q ^ L < 1) :
    Function.Surjective (fun z : Fin L → Ω ↦ ∑ i, v (z i)) := by
  apply residue_cover_of_fourier_mass_lt_one
  calc
    _ ≤ ∑ _a ∈ (univ : Finset (ZMod r)).erase 0, q ^ L := by
      apply sum_le_sum
      intro a ha
      rw [residueCharacterMean_sum_copies, norm_pow]
      exact pow_le_pow_left₀ (norm_nonneg _) (hcontract a (mem_erase.mp ha).1) L
    _ = ((r : ℝ) - 1) * q ^ L := by
      rw [sum_const, nsmul_eq_mul, card_erase_of_mem (mem_univ 0), card_univ, ZMod.card]
      rw [Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr (NeZero.ne r)), Nat.cast_one]
    _ < 1 := hsmall

end Erdos859Verification

end

/- Inlined development module: FiniteCoinSums.lean -/

section

/- Repeated Boolean coin sums give bounded nonnegative integer coefficients. -/

open Finset

namespace Erdos859Verification

def booleanCoinValue {r : ℕ} [NeZero r] {ι : Type*} [Fintype ι]
    (w : ι → ℕ) (c : ι → Bool) : ZMod r :=
  ∑ i, if c i then (w i : ZMod r) else 0

theorem booleanCoin_copies_coefficients {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] (w : ι → ℕ) {L : ℕ}
    (z : Fin L → ι → Bool) :
    ∃ c : ι → ℕ, (∀ i, c i ≤ L) ∧
      (∑ j, booleanCoinValue w (z j)) = ∑ i, (c i : ZMod r) * (w i : ZMod r) := by
  classical
  let c : ι → ℕ := fun i ↦ ∑ j : Fin L, if z j i then 1 else 0
  refine ⟨c, ?_, ?_⟩
  · intro i
    calc
      c i ≤ ∑ _j : Fin L, 1 := by
        apply sum_le_sum
        intro j _
        cases z j i <;> norm_num
      _ = L := by simp
  · unfold booleanCoinValue
    rw [sum_comm]
    apply sum_congr rfl
    intro i _
    simp only [c, Nat.cast_sum, sum_mul]
    apply sum_congr rfl
    intro j _
    cases z j i <;> simp

theorem bounded_coin_coefficients_of_copies_surjective {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] (w : ι → ℕ) {L : ℕ}
    (hcover : Function.Surjective (fun z : Fin L → ι → Bool ↦
      ∑ j, booleanCoinValue (r := r) w (z j))) :
    ∀ x : ZMod r, ∃ c : ι → ℕ, (∀ i, c i ≤ L) ∧
      (∑ i, c i * w i : ℕ) = x := by
  intro x
  obtain ⟨z, hz⟩ := hcover x
  obtain ⟨c, hc, hvalue⟩ := booleanCoin_copies_coefficients (r := r) w z
  refine ⟨c, hc, ?_⟩
  push_cast
  exact hvalue.symm.trans hz

theorem bounded_coin_coefficients_of_fourier_contraction {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (w : ι → ℕ) {q : ℝ}
    (hcontract : ∀ a : ZMod r, a ≠ 0 →
      ‖residueCharacterMean (booleanCoinValue w) a‖ ≤ q)
    {L : ℕ} (hsmall : ((r : ℝ) - 1) * q ^ L < 1) :
    ∀ x : ZMod r, ∃ c : ι → ℕ, (∀ i, c i ≤ L) ∧
      (∑ i, c i * w i : ℕ) = x :=
  bounded_coin_coefficients_of_copies_surjective w
    (residue_cover_sum_copies (booleanCoinValue w) hcontract hsmall)

theorem bounded_coin_value_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {c : ι → ℕ} {L : ℕ} (hc : ∀ i, c i ≤ L) :
    (∑ i, c i * w i) ≤ L * ∑ i, w i := by
  rw [mul_sum]
  exact sum_le_sum (fun i _ ↦ Nat.mul_le_mul_right (w i) (hc i))

end Erdos859Verification

