theorem stopping_witness_mem_support {S : Finset ℕ}
    (hS : ∀ q ∈ S, q.Prime) {p : ℕ} (hp : p.Prime) {y : ℝ} (hy : 0 < y)
    (hw : FordStoppingWitness y p S) :
    log (p : ℝ) ∈ finiteIntervalSupport (fordStoppingAtom y S) (log 2) := by
  obtain ⟨U, hUS, hlo, hhi⟩ := hw
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hU0 : 0 < ∏ q ∈ U, (q : ℝ) := prod_pos fun q hq ↦ by
    exact_mod_cast (hS q (hUS hq)).pos
  have hlogs : log (∏ q ∈ U, (q : ℝ)) = ∑ q ∈ U, log (q : ℝ) :=
    log_prod (fun q hq ↦ by exact_mod_cast (hS q (hUS hq)).ne_zero)
  have hl := log_lt_log hy hlo
  have hh := log_le_log (mul_pos hp0 hU0) hhi
  rw [log_mul hp0.ne' hU0.ne', hlogs] at hl hh
  rw [log_mul (by norm_num : (2 : ℝ) ≠ 0) hy.ne'] at hh
  apply Set.mem_iUnion.mpr
  refine ⟨⟨U, mem_powerset.mpr hUS⟩, ?_⟩
  change log y - (∑ q ∈ U, log (q : ℝ)) ≤ log (p : ℝ) ∧
    log (p : ℝ) ≤ log y - (∑ q ∈ U, log (q : ℝ)) + log 2
  constructor <;> linarith

theorem fordLogDenominator_pos {S : Finset ℕ} (hS : ∀ q ∈ S, q.Prime)
    {y : ℝ} (hy : 1 < y) : 0 < fordLogDenominator y S := by
