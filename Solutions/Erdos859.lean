    (weight : ∀ i, α i → ℝ) (E : ∀ i, α i → Prop) [∀ i, DecidablePred (E i)]
    (bound : ι → ℝ) (hw : ∀ i y, 0 ≤ weight i y)
    (hbound : ∀ i, (∑ y, weight i y * (if E i y then 1 else 0)) ≤ bound i) :
    (∑ x : ∀ i, α i, finiteProductWeight weight x *
      (if ∀ i, E i (x i) then 1 else 0)) ≤ ∏ i, bound i := by
  rw [finite_product_conjunction_eq]
  exact prod_le_prod (fun i _ ↦ sum_nonneg (fun y _ ↦ mul_nonneg (hw i y)
    (by split_ifs <;> norm_num))) (fun i _ ↦ hbound i)

/-- The coordinate sets and laws may differ.  Normalization is unnecessary
for this weighted estimate; normalized weights give its probability form. -/
theorem independent_prime_residue_conjunction_le {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    {q a : ℕ} (hcop : Nat.Coprime a q) (S : Finset (Fin q))
    {B : ℝ} (hB : 0 ≤ B)
    (hres : ∀ i r, (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤ B) :
    (∑ x : (i : Fin m) → P i,
      finiteProductWeight (fun i p ↦ weight i p.val) x *
        (if ∀ i, ∃ r ∈ S, Nat.ModEq q ((x i).val * a) r.val then 1 else 0)) ≤
      ((S.card : ℝ) * B) ^ m := by
  classical
  have h := finite_product_conjunction_le (fun i (p : P i) ↦ weight i p.val)
    (fun i (p : P i) ↦ ∃ r ∈ S, Nat.ModEq q (p.val * a) r.val)
    (fun _ ↦ (S.card : ℝ) * B) (fun i p ↦ hw i p.val p.property) (by
      intro i
      have hi := finite_weighted_mul_residues_le (P i) (weight i) hcop hB
        (hw i) (hres i) S
      rw [sum_coe_sort (P i) (fun p ↦ weight i p *
        (if ∃ r ∈ S, Nat.ModEq q (p * a) r.val then 1 else 0))]
      simpa only [sum_filter, mul_ite, mul_one, mul_zero] using hi)
  simp only [prod_const, card_univ, Fintype.card_fin] at h
  convert h using 1
  apply sum_congr rfl
  intro x _
  by_cases hx : ∀ i, ∃ r ∈ S, Nat.ModEq q ((x i).val * a) r.val
  · simp only [if_pos hx]
  · simp only [if_neg hx]

/-- Sum the independent mark bound over all admissible reduced numerators
and denominators.  The cover may come from any deterministic phase argument. -/
theorem independent_prime_rational_union_bound {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (J : Finset ℕ) (S : ∀ q, Finset (Fin q)) (C B : ℕ → ℝ)
    (hB : ∀ q ∈ J, 0 ≤ B q)
    (hcard : ∀ q ∈ J, ((S q).card : ℝ) ≤ C q)
    (hres : ∀ i q, q ∈ J → ∀ r,
      (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤ B q)
    (Bad : ((i : Fin m) → P i) → Prop) [DecidablePred Bad]
    (hcover : ∀ x, Bad x → ∃ q ∈ J, ∃ a ∈ S q,
      Nat.Coprime a.val q ∧ ∀ i, ∃ r ∈ S q, Nat.ModEq q ((x i).val * a.val) r.val) :
    (∑ x : (i : Fin m) → P i,
      finiteProductWeight (fun i p ↦ weight i p.val) x * (if Bad x then 1 else 0)) ≤
      ∑ q ∈ J, C q * (C q * B q) ^ m := by
  classical
  let E : (Sigma Fin) → ((i : Fin m) → P i) → Prop := fun qa x ↦
    Nat.Coprime qa.2.val qa.1 ∧
      ∀ i, ∃ r ∈ S qa.1, Nat.ModEq qa.1 ((x i).val * qa.2.val) r.val
  have hwprod (x : (i : Fin m) → P i) :
      0 ≤ finiteProductWeight (fun i p ↦ weight i p.val) x :=
    finiteProductWeight_nonneg (fun i p ↦ hw i p.val p.property) x
  have hC (q : ℕ) (hq : q ∈ J) : 0 ≤ C q :=
    (Nat.cast_nonneg _).trans (hcard q hq)
  have hpair (qa : Sigma Fin) (hqa : qa ∈ J.sigma S) :
      (∑ x : (i : Fin m) → P i,
        finiteProductWeight (fun i p ↦ weight i p.val) x * (if E qa x then 1 else 0)) ≤
        (C qa.1 * B qa.1) ^ m := by
    have hq := (mem_sigma.mp hqa).1
    by_cases hcop : Nat.Coprime qa.2.val qa.1
    · have hr := (independent_prime_residue_conjunction_le P weight hw hcop (S qa.1)
        (hB qa.1 hq) (fun i r ↦ hres i qa.1 hq r)).trans
        (pow_le_pow_left₀ (mul_nonneg (Nat.cast_nonneg _) (hB qa.1 hq))
          (mul_le_mul_of_nonneg_right (hcard qa.1 hq) (hB qa.1 hq)) m)
      have heq : (∑ x : (i : Fin m) → P i,
          finiteProductWeight (fun i p ↦ weight i p.val) x * (if E qa x then 1 else 0)) =
          ∑ x : (i : Fin m) → P i,
            finiteProductWeight (fun i p ↦ weight i p.val) x *
              (if ∀ i, ∃ r ∈ S qa.1, Nat.ModEq qa.1 ((x i).val * qa.2.val) r.val then 1 else 0) := by
        apply sum_congr rfl
        intro x _
        have he : E qa x ↔ ∀ i, ∃ r ∈ S qa.1,
            Nat.ModEq qa.1 ((x i).val * qa.2.val) r.val := and_iff_right hcop
        simp only [he]
      rw [heq]
      exact hr
    · simp only [E, hcop, false_and, if_false, mul_zero, sum_const_zero]
      exact pow_nonneg (mul_nonneg (hC qa.1 hq) (hB qa.1 hq)) m
  calc
    _ ≤ ∑ x : (i : Fin m) → P i,
        finiteProductWeight (fun i p ↦ weight i p.val) x *
          (if ∃ qa ∈ J.sigma S, E qa x then 1 else 0) := by
      apply sum_le_sum
      intro x _
      apply mul_le_mul_of_nonneg_left _ (hwprod x)
      by_cases hx : Bad x
      · obtain ⟨q, hq, a, ha, hcop, hmarks⟩ := hcover x hx
        have he : ∃ qa ∈ J.sigma S, E qa x :=
          ⟨⟨q, a⟩, mem_sigma.mpr ⟨hq, ha⟩, hcop, hmarks⟩
        simp only [if_pos hx, if_pos he, le_refl]
      · simp only [if_neg hx]
        split_ifs <;> norm_num
    _ ≤ ∑ qa ∈ J.sigma S, ∑ x : (i : Fin m) → P i,
        finiteProductWeight (fun i p ↦ weight i p.val) x * (if E qa x then 1 else 0) :=
      finite_weighted_union_bound_general univ (J.sigma S)
        (finiteProductWeight (fun i p ↦ weight i p.val)) (fun x _ ↦ hwprod x) E
    _ ≤ ∑ qa ∈ J.sigma S, (C qa.1 * B qa.1) ^ m :=
      sum_le_sum hpair
    _ = ∑ q ∈ J, ((S q).card : ℝ) * (C q * B q) ^ m := by
      rw [sum_sigma]
      simp
    _ ≤ _ := sum_le_sum (fun q hq ↦ mul_le_mul_of_nonneg_right (hcard q hq)
      (pow_nonneg (mul_nonneg (hC q hq) (hB q hq)) m))

/-- Proper cubes give the concrete numerator and residue count required
by the independent union bound. -/
theorem proper_cube_independent_rational_union_bound {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H)
    {Y : ℝ} (hY : 0 < Y) (hYH : 32 * (H : ℝ) ≤ Y)
    (hW : 0 < ∑ i, w i) (hscale : 2 ≤ Y * ∑ i, (w i : ℝ))
    {m : ℕ} (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (J : Finset ℕ) (hq : ∀ q ∈ J, 0 < q)
    (S : ∀ q, Finset (Fin q))
    (hS : ∀ q ∈ J, ∀ a ∈ S q, ∃ x : AddCircle (1 : ℝ),
      cubePhaseSquare w x ≤ (1 / Y) ^ 2 ∧
        dist (circleRationalGridPoint q a) x ≤ 1 / (q : ℝ))
    (B : ℕ → ℝ) (hB : ∀ q ∈ J, 0 ≤ B q)
    (hres : ∀ i q, q ∈ J → ∀ r,
      (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤ B q)
    (Bad : ((i : Fin m) → P i) → Prop) [DecidablePred Bad]
    (hcover : ∀ x, Bad x → ∃ q ∈ J, ∃ a ∈ S q,
      Nat.Coprime a.val q ∧ ∀ i, ∃ r ∈ S q, Nat.ModEq q ((x i).val * a.val) r.val) :
    (∑ x : (i : Fin m) → P i,
      finiteProductWeight (fun i p ↦ weight i p.val) x * (if Bad x then 1 else 0)) ≤
      ∑ q ∈ J, (6 * ((q : ℝ) + Y * ∑ i, (w i : ℝ)) /
        (2 * (H : ℝ) + 1) ^ Fintype.card ι) *
        ((6 * ((q : ℝ) + Y * ∑ i, (w i : ℝ)) /
          (2 * (H : ℝ) + 1) ^ Fintype.card ι) * B q) ^ m := by
  exact independent_prime_rational_union_bound P weight hw J S _ B hB
    (fun q hqJ ↦ proper_cube_near_grid_card_le w hproper hY hYH hW hscale
      (hq q hqJ) (S q) (hS q hqJ)) hres Bad hcover

/-- The numerical denominator sum on one multiplicative block.  Allowing
real endpoints also covers blocks starting at a nonintegral anchor. -/
theorem rational_phase_block_sum_le {Q R M G Pmin : ℝ}
    (hQ : 0 < Q) (hR : 0 ≤ R) (hM : 0 < M) (hG : 0 ≤ G) (hPmin : 0 < Pmin)
    {m : ℕ} (hm : 1 ≤ m) (J : Finset ℕ)
    (hcard : (J.card : ℝ) ≤ 2 * Q)
    (hrange : ∀ q ∈ J, Q ≤ (q : ℝ) ∧ (q : ℝ) ≤ 2 * Q) :
    (∑ q ∈ J, (6 * ((q : ℝ) + R) / M) *
      ((6 * ((q : ℝ) + R) / M) * (G / (q : ℝ) * (1 + (q : ℝ) / Pmin))) ^ m) ≤
      12 * (6 * G) ^ m * (1 + 2 * Q / Pmin) ^ m * (2 * Q + R) ^ (m + 1) /
        (M ^ (m + 1) * Q ^ (m - 1)) := by
  have hC0 : 0 ≤ 6 * (2 * Q + R) / M := by positivity
  have hB0 : 0 ≤ G / Q * (1 + 2 * Q / Pmin) := by positivity
  have hterm (q : ℕ) (hq : q ∈ J) :
      (6 * ((q : ℝ) + R) / M) *
        ((6 * ((q : ℝ) + R) / M) * (G / (q : ℝ) * (1 + (q : ℝ) / Pmin))) ^ m ≤
      (6 * (2 * Q + R) / M) *
        ((6 * (2 * Q + R) / M) * (G / Q * (1 + 2 * Q / Pmin))) ^ m := by
    have hC : 6 * ((q : ℝ) + R) / M ≤ 6 * (2 * Q + R) / M := by
      gcongr
      exact (hrange q hq).2
    have hB : G / (q : ℝ) * (1 + (q : ℝ) / Pmin) ≤
        G / Q * (1 + 2 * Q / Pmin) := by
      apply mul_le_mul
        (div_le_div_of_nonneg_left hG hQ (hrange q hq).1)
        (add_le_add le_rfl (div_le_div_of_nonneg_right (hrange q hq).2 hPmin.le))
        (by positivity) (by positivity)
    have hmul := mul_le_mul hC hB (by positivity) hC0
    exact mul_le_mul hC (pow_le_pow_left₀ (by positivity) hmul m) (by positivity) hC0
  calc
    _ ≤ ∑ _q ∈ J, (6 * (2 * Q + R) / M) *
        ((6 * (2 * Q + R) / M) * (G / Q * (1 + 2 * Q / Pmin))) ^ m :=
      sum_le_sum hterm
    _ = (J.card : ℝ) * ((6 * (2 * Q + R) / M) *
        ((6 * (2 * Q + R) / M) * (G / Q * (1 + 2 * Q / Pmin))) ^ m) := by simp
    _ ≤ (2 * Q) * ((6 * (2 * Q + R) / M) *
        ((6 * (2 * Q + R) / M) * (G / Q * (1 + 2 * Q / Pmin))) ^ m) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg hC0 (pow_nonneg (mul_nonneg hC0 hB0) m))
    _ = _ := by
      cases m with
      | zero => omega
      | succ n =>
        simp only [Nat.add_sub_cancel, pow_succ, mul_pow, div_pow]
        field_simp
        ring

theorem nat_dyadic_interval_card_le {Q : ℕ} (hQ : 0 < Q) :
    ((Icc Q (2 * Q)).card : ℝ) ≤ 2 * (Q : ℝ) := by
  have h : (Icc Q (2 * Q)).card ≤ 2 * Q := by rw [Nat.card_Icc]; omega
  exact_mod_cast h

/-- The rational union bound with its uniform block prefactor 12. -/
theorem independent_prime_rational_block_bound {m : ℕ} (hm : 1 ≤ m)
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    {Q R M G Pmin : ℝ}
    (hQ : 0 < Q) (hR : 0 ≤ R) (hM : 0 < M) (hG : 0 ≤ G) (hPmin : 0 < Pmin)
    (J : Finset ℕ) (hJcard : (J.card : ℝ) ≤ 2 * Q)
    (hrange : ∀ q ∈ J, Q ≤ (q : ℝ) ∧ (q : ℝ) ≤ 2 * Q)
    (S : ∀ q, Finset (Fin q))
    (hcard : ∀ q ∈ J, ((S q).card : ℝ) ≤ 6 * ((q : ℝ) + R) / M)
    (hres : ∀ i q, q ∈ J → ∀ r,
      (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤
        G / (q : ℝ) * (1 + (q : ℝ) / Pmin))
    (Bad : ((i : Fin m) → P i) → Prop) [DecidablePred Bad]
    (hcover : ∀ x, Bad x → ∃ q ∈ J, ∃ a ∈ S q,
      Nat.Coprime a.val q ∧ ∀ i, ∃ r ∈ S q, Nat.ModEq q ((x i).val * a.val) r.val) :
    (∑ x : (i : Fin m) → P i,
      finiteProductWeight (fun i p ↦ weight i p.val) x * (if Bad x then 1 else 0)) ≤
      12 * (6 * G) ^ m * (1 + 2 * Q / Pmin) ^ m * (2 * Q + R) ^ (m + 1) /
        (M ^ (m + 1) * Q ^ (m - 1)) := by
  exact (independent_prime_rational_union_bound P weight hw J S
    (fun q ↦ 6 * ((q : ℝ) + R) / M)
    (fun q ↦ G / (q : ℝ) * (1 + (q : ℝ) / Pmin))
    (fun _ _ ↦ by positivity) hcard hres Bad hcover).trans
      (rational_phase_block_sum_le hQ hR hM hG hPmin hm J hJcard hrange)

end Erdos859Verification

end

