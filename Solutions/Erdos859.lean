      obtain ⟨x, hx⟩ := ih
      refine ⟨Fin.snoc x g, ?_⟩
      rw [← finiteBitTranslateSupport_eq_subsetSupport, finiteBitTranslateSupport_snoc,
        finiteBitTranslateSupport_eq_subsetSupport]
      intro z hz
      rcases hz with hz | hz
      · exact Or.inl (hx hz)
      · exact Or.inr (finiteSubsetTranslateSupport_base_subset B univ x hz)

theorem InitialCoverageByTranslates.coupled_missing_transfer {L : ℝ} {B A : Set ℝ}
    {n : ℕ} (h : InitialCoverageByTranslates L B n A) :
    ∃ x : Fin n → ℝ, A ⊆ finiteSubsetTranslateSupport B univ x ∧
      ∀ (y : Fin n → ℝ) (e : ℝ), 0 ≤ e → (∀ i, |y i - x i| ≤ e) →
      ∀ a b : ℝ,
        volume.real (Set.Icc a b \ finiteThickenedTranslateSupport B univ y ((n : ℝ) * e)) ≤
          volume.real (Set.Icc a b \ A) := by
  obtain ⟨x, hx⟩ := h.exists_shift_tuple_subset
  refine ⟨x, hx, ?_⟩
  intro y e he hxy a b
  have hb := finThickenedTranslateSupport_missing_Icc (A := B) (d := 0) (a := a) (b := b) he hxy
  have hb' : volume.real (Set.Icc a b \ finiteThickenedTranslateSupport B univ y ((n : ℝ) * e)) ≤
      volume.real (Set.Icc a b \ finiteSubsetTranslateSupport B univ x) := by
    simpa only [zero_add, finiteThickenedTranslateSupport, realSupportThickening_zero] using hb
  apply hb'.trans
  apply measureReal_mono _ (measure_ne_top_of_subset Set.sdiff_subset isCompact_Icc.measure_ne_top)
  exact Set.sdiff_subset_sdiff_right hx

