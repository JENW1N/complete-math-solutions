    (T : Finset ℕ) (lam : ℝ) :
    primeTiltWeight P lam T =
      primeTiltWeight B lam (T ∩ B) * primeTiltWeight (P \ B) lam (T \ B) := by
  simp only [primeTiltWeight, primePatternWeight_split_universe hB T,
    primeTiltNormalizer_split_universe hB lam]
  rw [← card_inter_add_card_sdiff T B, pow_add]
