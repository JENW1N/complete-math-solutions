  primeLogWindow (A + B * 2 ^ j) (A + B * 2 ^ (j + 1))

noncomputable def virtualPrimeUniverse (A B : ℝ) (n : ℕ) : Finset ℕ :=
  (range n).biUnion (virtualPrimeBand A B)

noncomputable def virtualPrimeRelativeError (B : ℝ) : ℝ :=
  2 * primeLogOddsErrorConstant / (B * log 2)

theorem virtualCoreBin_lower_fraction {A B : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (j : ℕ) :
    log 2 * B * 2 ^ j / (A + B * 2 ^ j) ≤ virtualCoreBin A B j := by
  have hp : (0 : ℝ) < 2 ^ j := by positivity
  have hd : 0 < A + B * 2 ^ j := by positivity
  have hd' : 0 < 1 + (A / B) / (2 : ℝ) ^ j := by positivity
  have he : log 2 * B * 2 ^ j / (A + B * 2 ^ j) =
      log 2 / (1 + (A / B) / (2 : ℝ) ^ j) := by
    field_simp
    ring
  rw [he]
  exact virtualCoreBin_lower hA hB j

theorem virtualCoreBin_absorb_error {A B C : ℝ}
    (hA : 0 ≤ A) (hB : 0 < B) (hC : 0 ≤ C) (j : ℕ) :
    2 * C / (A + B * 2 ^ j) ≤
      (2 * C / (B * log 2)) * virtualCoreBin A B j := by
  have hlog : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hd : 0 < A + B * 2 ^ j := by positivity
  have hp : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
  calc
    _ ≤ (2 * C * 2 ^ j) / (A + B * 2 ^ j) :=
      div_le_div_of_nonneg_right (by nlinarith) hd.le
    _ = (2 * C / (B * log 2)) * (log 2 * B * 2 ^ j / (A + B * 2 ^ j)) := by
      field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_left (virtualCoreBin_lower_fraction hA hB j) (by positivity)

