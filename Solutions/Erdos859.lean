section

/- A phase gap for divisor coins gives an actual interval of representable targets. -/

open Finset

namespace Erdos859Verification

theorem phaseGap_practical_mem_divisorSumSet {n b r Z t : ℕ} [NeZero r]
    (hb : Nat.IsPractical b) (hb0 : b ≠ 0) (hn0 : n ≠ 0)
    (hcop : Nat.Coprime b n) (hZb : Z ≤ b)
    (S : Finset ℕ) (hS : S ⊆ n.divisors) (hr : r ∈ n.divisors) (hrS : r ∉ S)
    {Y : ℝ} (hY : 0 < Y)
    (hphase : ∀ a : ℕ, 0 < a → a < r → 1 / Y ^ 2 ≤
      cubePhaseSquare (fun d : S ↦ (d : ℕ))
        (((a : ℝ) / r : ℝ) : AddCircle (1 : ℝ)))
    (hCZ : bernoulliResidueLength r Y ≤ Z)
    (hsize : 4 * bernoulliResidueLength r Y * ∑ d ∈ S, d ≤ Z * r)
    (htlo : (Z : ℝ) * r / 4 ≤ t) (hthi : (t : ℝ) ≤ 3 * Z * r / 4) :
    b * n ∈ Erdos859.DivisorSumSet t := by
  classical
  have hcover := bounded_coin_coefficients_of_no_small_rational_phase
    (fun d : S ↦ (d : ℕ)) hY hphase
  have hsize' : 4 * bernoulliResidueLength r Y * (∑ d : S, (d : ℕ)) ≤ Z * r := by
    change 4 * bernoulliResidueLength r Y * (∑ d ∈ S.attach, (d : ℕ)) ≤ Z * r
    rwa [Finset.sum_attach S (fun d : ℕ ↦ d)]
  obtain ⟨q, c, hq, hc, htarget⟩ :=
    coin_interval_real_bounds (fun d : S ↦ (d : ℕ)) hcover hsize' htlo hthi
  obtain ⟨f, hf, hfzero, hsum⟩ := finite_coin_coefficient_extension S hrS hq hCZ c hc
  have hsub : insert r S ⊆ n.divisors := insert_subset hr hS
  have heq : (∑ d ∈ n.divisors, d * f d) = t := by
    calc
      _ = ∑ d ∈ insert r S, d * f d := by
        symm
        apply sum_subset hsub
        intro d _ hd
        rw [hfzero d hd, mul_zero]
      _ = r * q + ∑ d : S, c d * (d : ℕ) := hsum
      _ = t := htarget.symm
  have hrep := bounded_coefficients_mem_divisorSumSet hb hb0 hn0 hcop f
    (fun d _ ↦ (hf d).trans hZb)
  simpa only [heq] using hrep

end Erdos859Verification

