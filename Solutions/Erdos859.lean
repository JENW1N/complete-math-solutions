section

/- Exact first and second count moments for the finite tilted prime law. -/

open Finset Real

namespace Erdos859Verification

theorem primeTiltWeight_singleton_selected {p : ℕ} (hp : p.Prime)
    {lam : ℝ} (hlam : 0 < lam) :
    primeTiltWeight {p} lam {p} = primeTiltSelectionProbability lam p := by
  have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hd : (p : ℝ) + lam - 1 ≠ 0 := by linarith
  have hden : 1 + (lam - 1) / (p : ℝ) = ((p : ℝ) + lam - 1) / p := by
    field_simp
    ring
  simp only [primeTiltWeight, primePatternWeight, primeTiltNormalizer,
    prod_singleton, mem_singleton, ite_true, card_singleton, pow_one, hden,
    primeTiltSelectionProbability]
  field_simp [hp0, hd]

theorem primeTiltWeight_singleton_unselected {p : ℕ} (hp : p.Prime)
    {lam : ℝ} (hlam : 0 < lam) :
    primeTiltWeight {p} lam ∅ = 1 - primeTiltSelectionProbability lam p := by
  have hs := sum_primeTiltWeight (P := {p})
    (fun q hq ↦ by simpa only [mem_singleton.mp hq] using hp) hlam
  have hsum : primeTiltWeight {p} lam ∅ + primeTiltWeight {p} lam {p} = 1 := by
    change (∑ T ∈ (insert p (∅ : Finset ℕ)).powerset, primeTiltWeight {p} lam T) = 1 at hs
    rw [sum_powerset_insert (by simp : p ∉ (∅ : Finset ℕ))] at hs
    simpa using hs
  rw [primeTiltWeight_singleton_selected hp hlam] at hsum
  linarith

/-- Adjoining one prime gives the exact Bernoulli recursion for every
observable that depends on the number of selected primes. -/
theorem prime_tilt_card_observable_insert {P : Finset ℕ} {p : ℕ}
    (hpP : p ∉ P) (hp : p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (G : ℕ → ℝ) :
    (∑ T ∈ (insert p P).powerset, primeTiltWeight (insert p P) lam T * G T.card) =
      (1 - primeTiltSelectionProbability lam p) *
        (∑ T ∈ P.powerset, primeTiltWeight P lam T * G T.card) +
      primeTiltSelectionProbability lam p *
        (∑ T ∈ P.powerset, primeTiltWeight P lam T * G (T.card + 1)) := by
  rw [sum_powerset_insert hpP, mul_sum, mul_sum]
  congr 1
  · apply sum_congr rfl
    intro T hT
    have hTP : T ⊆ P := mem_powerset.mp hT
    have hw := primeTiltWeight_split_universe (subset_insert p P) T lam
    simp only [insert_sdiff_cancel hpP, inter_eq_left.mpr hTP,
      sdiff_eq_empty_iff_subset.mpr hTP] at hw
    rw [hw, primeTiltWeight_singleton_unselected hp hlam]
    ring
  · apply sum_congr rfl
    intro T hT
    have hTP : T ⊆ P := mem_powerset.mp hT
    have hpT : p ∉ T := fun h ↦ hpP (hTP h)
    have hw := primeTiltWeight_split_universe (subset_insert p P) (insert p T) lam
    simp only [insert_sdiff_cancel hpP, insert_inter_of_notMem hpP,
      inter_eq_left.mpr hTP, insert_sdiff_of_notMem T hpP,
      sdiff_eq_empty_iff_subset.mpr hTP, insert_empty_eq] at hw
    rw [hw, primeTiltWeight_singleton_selected hp hlam, card_insert_of_notMem hpT]
    ring

theorem primeTiltWeight_count_add_one_mean {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * ((T.card + 1 : ℕ) : ℝ)) =
      (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ)) + 1 := by
  simp only [Nat.cast_add, Nat.cast_one, mul_add, mul_one, sum_add_distrib,
    sum_primeTiltWeight hP hlam]

theorem primeTiltWeight_count_add_one_second_moment {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * ((T.card + 1 : ℕ) : ℝ) ^ 2) =
      (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ) ^ 2) +
        2 * (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ)) + 1 := by
  calc
    _ = ∑ T ∈ P.powerset,
        ((primeTiltWeight P lam T * (T.card : ℝ) ^ 2) +
          2 * (primeTiltWeight P lam T * (T.card : ℝ)) + primeTiltWeight P lam T) := by
      apply sum_congr rfl
      intro T _
      push_cast
      ring
    _ = _ := by
      rw [sum_add_distrib, sum_add_distrib, ← mul_sum, sum_primeTiltWeight hP hlam]

/-- The first moment is the sum of the effective prime probabilities, and
the second moment is its square plus the sum of the Bernoulli variances. -/
theorem primeTiltWeight_count_first_second_moment {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ)) =
        (∑ p ∈ P, primeTiltSelectionProbability lam p) ∧
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ) ^ 2) =
        (∑ p ∈ P, primeTiltSelectionProbability lam p) ^ 2 +
          ∑ p ∈ P, primeTiltSelectionProbability lam p *
            (1 - primeTiltSelectionProbability lam p) := by
  revert hP
  induction P using Finset.induction_on with
  | empty =>
    intro _
    simp
  | @insert p P hpP ih =>
    intro hP
    have hp : p.Prime := hP p (mem_insert_self p P)
    have hPrest : ∀ q ∈ P, q.Prime := fun q hq ↦ hP q (mem_insert_of_mem hq)
    obtain ⟨ih1, ih2⟩ := ih hPrest
    constructor
    · rw [prime_tilt_card_observable_insert hpP hp hlam (fun n ↦ (n : ℝ)),
        primeTiltWeight_count_add_one_mean hPrest hlam, ih1, sum_insert hpP]
      ring
    · rw [prime_tilt_card_observable_insert hpP hp hlam (fun n ↦ (n : ℝ) ^ 2),
        primeTiltWeight_count_add_one_second_moment hPrest hlam, ih1, ih2,
        sum_insert hpP, sum_insert hpP]
      ring

theorem primeTiltWeight_count_mean {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ)) =
      ∑ p ∈ P, primeTiltSelectionProbability lam p :=
  (primeTiltWeight_count_first_second_moment hP hlam).1

theorem primeTiltWeight_count_second_moment_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * (T.card : ℝ) ^ 2) ≤
      (∑ p ∈ P, primeTiltSelectionProbability lam p) ^ 2 +
        ∑ p ∈ P, primeTiltSelectionProbability lam p := by
  rw [(primeTiltWeight_count_first_second_moment hP hlam).2]
  apply add_le_add le_rfl
  apply sum_le_sum
  intro p hp
  have hq := (primeTiltSelectionProbability_pos_lt_one (hP p hp) hlam).1.le
  nlinarith [sq_nonneg (primeTiltSelectionProbability lam p)]

theorem primeTiltWeight_restricted_count_mean {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * ((T ∩ B).card : ℝ)) =
      ∑ p ∈ B, primeTiltSelectionProbability lam p := by
  rw [prime_tilt_expectation_restrict hP hB hlam (fun U ↦ (U.card : ℝ))]
  exact primeTiltWeight_count_mean (fun p hp ↦ hP p (hB hp)) hlam

theorem primeTiltWeight_restricted_count_second_moment_le {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * ((T ∩ B).card : ℝ) ^ 2) ≤
      (∑ p ∈ B, primeTiltSelectionProbability lam p) ^ 2 +
        ∑ p ∈ B, primeTiltSelectionProbability lam p := by
  rw [prime_tilt_expectation_restrict hP hB hlam (fun U ↦ (U.card : ℝ) ^ 2)]
  exact primeTiltWeight_count_second_moment_le (fun p hp ↦ hP p (hB hp)) hlam

end Erdos859Verification

end

/- Inlined development module: FiniteBitCollision.lean -/

section

/- Exact fair-bit agreement probabilities for finite collision arguments. -/

open Finset

namespace Erdos859Verification

noncomputable def fairBitWeight (ι : Type*) [Fintype ι] : ℝ :=
  1 / (2 : ℝ) ^ Fintype.card ι

noncomputable def fairBitPairMean {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F : (ι → Bool) → (ι → Bool) → ℝ) : ℝ :=
  ∑ b, ∑ b', fairBitWeight ι * fairBitWeight ι * F b b'

theorem fairBitWeight_nonneg (ι : Type*) [Fintype ι] : 0 ≤ fairBitWeight ι := by
  unfold fairBitWeight
  positivity

theorem fairBitWeight_eq_prod (ι : Type*) [Fintype ι] :
    fairBitWeight ι = ∏ _i : ι, (1 / 2 : ℝ) := by
  simp [fairBitWeight]

theorem sum_fairBitWeight (ι : Type*) [Fintype ι] [DecidableEq ι] :
    (∑ _b : ι → Bool, fairBitWeight ι) = 1 := by
  have hnorm : ∀ _i : ι, ∑ _b : Bool, (1 / 2 : ℝ) = 1 := by
    intro i
    norm_num
  simpa only [finiteProductWeight, ← fairBitWeight_eq_prod] using
    sum_finiteProductWeight (fun (_i : ι) (_b : Bool) ↦ (1 / 2 : ℝ)) hnorm

/-- For a fixed bit vector, agreement on a finite set has probability
the reciprocal of two raised to the number of constrained coordinates. -/
theorem fairBit_agreement_probability {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : Finset ι) (b : ι → Bool) :
    (∑ b' : ι → Bool, fairBitWeight ι *
      (if ∀ i ∈ B, b i = b' i then 1 else 0)) = 1 / (2 : ℝ) ^ B.card := by
  classical
  rw [fairBitWeight_eq_prod]
  simp_rw [← Fintype.prod_boole, ← prod_mul_distrib]
  rw [← Fintype.prod_sum
    (fun (i : ι) (u : Bool) ↦ (1 / 2 : ℝ) * (if i ∈ B → b i = u then 1 else 0))]
  have hsum : ∀ i : ι,
      (∑ u : Bool, (1 / 2 : ℝ) * (if i ∈ B → b i = u then 1 else 0)) =
        if i ∈ B then (1 / 2 : ℝ) else 1 := by
    intro i
    by_cases hi : i ∈ B
    · cases b i <;> simp [hi]
    · simp [hi]
  simp_rw [hsum]
  rw [Fintype.prod_ite_mem]
  simp

/-- The exact probability that two independent fair bit vectors agree on `B`. -/
theorem fairBitPair_agreement_probability {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : Finset ι) :
    fairBitPairMean (fun b b' ↦ if ∀ i ∈ B, b i = b' i then 1 else 0) =
      1 / (2 : ℝ) ^ B.card := by
  classical
  unfold fairBitPairMean
  calc
    _ = ∑ b : ι → Bool, fairBitWeight ι *
        (∑ b' : ι → Bool, fairBitWeight ι *
          (if ∀ i ∈ B, b i = b' i then 1 else 0)) := by
      apply sum_congr rfl
      intro b _
      rw [mul_sum]
      apply sum_congr rfl
      intro b' _
      ring
    _ = ∑ _b : ι → Bool, fairBitWeight ι * (1 / (2 : ℝ) ^ B.card) := by
      simp_rw [fairBit_agreement_probability]
    _ = _ := by rw [← sum_mul, sum_fairBitWeight, one_mul]

theorem fairBitPair_equality_probability {ι : Type*} [Fintype ι] [DecidableEq ι] :
    fairBitPairMean (fun b b' : ι → Bool ↦ if b = b' then 1 else 0) =
      1 / (2 : ℝ) ^ Fintype.card ι := by
  simpa only [mem_univ, forall_true_left, funext_iff, card_univ] using
    fairBitPair_agreement_probability (univ : Finset ι)

theorem fairBitPairMean_eq_sum_div {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F : (ι → Bool) → (ι → Bool) → ℝ) :
    fairBitPairMean F = (∑ p : (ι → Bool) × (ι → Bool), F p.1 p.2) /
      (4 : ℝ) ^ Fintype.card ι := by
  have hw : fairBitWeight ι * fairBitWeight ι = 1 / (4 : ℝ) ^ Fintype.card ι := by
    unfold fairBitWeight
    rw [div_mul_div_comm, ← mul_pow]
    norm_num
  simp only [fairBitPairMean, hw, Fintype.sum_prod_type, sum_div, one_div_mul_eq_div]

/-- An explicit normalized cardinality version of the agreement probability. -/
theorem fairBitPair_agreement_card_ratio {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : Finset ι) :
    (((univ : Finset ((ι → Bool) × (ι → Bool))).filter
      (fun p ↦ ∀ i ∈ B, p.1 i = p.2 i)).card : ℝ) /
        (4 : ℝ) ^ Fintype.card ι = 1 / (2 : ℝ) ^ B.card := by
  classical
  simpa only [fairBitPairMean_eq_sum_div, sum_boole] using
    fairBitPair_agreement_probability B

theorem fairBitPairMean_mono {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F G : (ι → Bool) → (ι → Bool) → ℝ} (h : ∀ b b', F b b' ≤ G b b') :
    fairBitPairMean F ≤ fairBitPairMean G := by
  apply sum_le_sum
  intro b _
  apply sum_le_sum
  intro b' _
  exact mul_le_mul_of_nonneg_left (h b b')
    (mul_nonneg (fairBitWeight_nonneg ι) (fairBitWeight_nonneg ι))

theorem fairBitPairMean_add {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F G : (ι → Bool) → (ι → Bool) → ℝ) :
    fairBitPairMean (fun b b' ↦ F b b' + G b b') =
      fairBitPairMean F + fairBitPairMean G := by
  simp only [fairBitPairMean, mul_add, sum_add_distrib]

theorem fairBitPairMean_const_mul {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F : (ι → Bool) → (ι → Bool) → ℝ) (c : ℝ) :
    fairBitPairMean (fun b b' ↦ c * F b b') = c * fairBitPairMean F := by
  unfold fairBitPairMean
  simp_rw [← mul_assoc, mul_comm (fairBitWeight ι * fairBitWeight ι) c, mul_assoc]
  simp only [← mul_sum]

theorem fairBitPairMean_sum {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    (F : κ → (ι → Bool) → (ι → Bool) → ℝ) :
    fairBitPairMean (fun b b' ↦ ∑ j, F j b b') = ∑ j, fairBitPairMean (F j) := by
  unfold fairBitPairMean
  simp only [mul_sum]
  calc
    _ = ∑ b, ∑ j, ∑ b', fairBitWeight ι * fairBitWeight ι * F j b b' := by
      apply sum_congr rfl
      intro b _
      exact sum_comm
    _ = _ := sum_comm

/-- A cover by agreement events bounds the mean of an arbitrary cost.
Only the covering costs must be nonnegative. -/
theorem fairBitPair_cover_bound {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    (F : (ι → Bool) → (ι → Bool) → ℝ) (B : κ → Finset ι) (c : κ → ℝ) (d : ℝ)
    (hc : ∀ j, 0 ≤ c j) (hdiag : ∀ b, F b b ≤ d)
    (hcover : ∀ b b', b ≠ b' →
      ∃ j, (∀ i ∈ B j, b i = b' i) ∧ F b b' ≤ c j) :
    fairBitPairMean F ≤ d / (2 : ℝ) ^ Fintype.card ι +
      ∑ j, c j / (2 : ℝ) ^ (B j).card := by
  classical
  have hind : ∀ (b b' : ι → Bool) j, 0 ≤ c j *
      (if ∀ i ∈ B j, b i = b' i then (1 : ℝ) else 0) := by
    intro b b' j
    split_ifs <;> simp [hc j]
  have hpoint : ∀ b b', F b b' ≤
      d * (if b = b' then 1 else 0) +
        ∑ j, c j * (if ∀ i ∈ B j, b i = b' i then 1 else 0) := by
    intro b b'
    by_cases heq : b = b'
    · subst b'
      rw [if_pos rfl, mul_one]
      exact (hdiag b).trans (le_add_of_nonneg_right
        (sum_nonneg (fun j _ ↦ hind b b j)))
    · obtain ⟨j, hj, hF⟩ := hcover b b' heq
      simp only [if_neg heq, mul_zero, zero_add]
      calc
        F b b' ≤ c j := hF
        _ = c j * (if ∀ i ∈ B j, b i = b' i then 1 else 0) := by
          rw [if_pos hj, mul_one]
        _ ≤ _ := single_le_sum (fun k _ ↦ hind b b' k) (mem_univ j)
  calc
    fairBitPairMean F ≤ fairBitPairMean (fun b b' ↦
        d * (if b = b' then 1 else 0) +
          ∑ j, c j * (if ∀ i ∈ B j, b i = b' i then 1 else 0)) :=
      fairBitPairMean_mono hpoint
    _ = _ := by
      rw [fairBitPairMean_add, fairBitPairMean_const_mul, fairBitPair_equality_probability,
        fairBitPairMean_sum]
      simp_rw [fairBitPairMean_const_mul, fairBitPair_agreement_probability]
      simp only [mul_one_div]

/-- Classifying unequal bit vectors by their highest differing band gives
the reciprocal-power collision bound. -/
theorem fairBitPair_highest_band_bound {ι κ : Type*}
    [Fintype ι] [DecidableEq ι] [Fintype κ] [LinearOrder κ]
    (band : ι → κ) (F : (ι → Bool) → (ι → Bool) → ℝ) (c : κ → ℝ) (d : ℝ)
    (hc : ∀ j, 0 ≤ c j) (hdiag : ∀ b, F b b ≤ d)
    (hhighest : ∀ b b' j, (∃ i, band i = j ∧ b i ≠ b' i) →
      (∀ i, j < band i → b i = b' i) → F b b' ≤ c j) :
    fairBitPairMean F ≤ d / (2 : ℝ) ^ Fintype.card ι +
      ∑ j, c j / (2 : ℝ) ^ (univ.filter (fun i ↦ j < band i)).card := by
  classical
  apply fairBitPair_cover_bound F (fun j ↦ univ.filter (fun i ↦ j < band i)) c d hc hdiag
  intro b b' hne
  let D : Finset ι := univ.filter (fun i ↦ b i ≠ b' i)
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
  have hD : D.Nonempty := ⟨i, by simpa [D] using hi⟩
  obtain ⟨m, hm, hmax⟩ := D.exists_max_image band hD
  have hdiff : b m ≠ b' m := (mem_filter.mp hm).2
  have hagree : ∀ i, band m < band i → b i = b' i := by
    intro i hmi
    by_contra hdiffi
    have hiD : i ∈ D := by simp [D, hdiffi]
    exact (not_lt_of_ge (hmax i hiD)) hmi
  refine ⟨band m, ?_, hhighest b b' (band m) ⟨m, rfl, hdiff⟩ hagree⟩
  intro i hi
  exact hagree i (mem_filter.mp hi).2

def fairBitDifference (b b' : Bool) : ℝ :=
  (if b then 1 else 0) - (if b' then 1 else 0)

