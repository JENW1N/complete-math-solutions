/-- Clipping a covering interval at the threshold never increases its length. -/
theorem prime_clipped_cover_interval_mass_upper (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {v d : ℝ} (hv : log 2 ≤ v) (hd : 0 ≤ d) (c : ℝ) :
    (∑ p ∈ P.filter (fun p : ℕ ↦ log (p : ℝ) ∈ Set.Icc (max v (c - d)) (c + 2*d)),
      1 / (p : ℝ)) ≤ (3*d + 2*mertensErrorConstant + 1) / v := by
  classical
  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  have hnum : 0 ≤ 3*d + 2*mertensErrorConstant + 1 := by
    positivity [mertensErrorConstant_pos]
  by_cases horder : max v (c-d) ≤ c+2*d
  · calc
      _ ≤ (c+2*d-max v (c-d)+2*mertensErrorConstant+1) / max v (c-d) :=
        prime_closed_log_interval_mass_upper P hP (hv.trans (le_max_left _ _)) horder
      _ ≤ (3*d+2*mertensErrorConstant+1) / max v (c-d) :=
        div_le_div_of_nonneg_right (by linarith [le_max_right v (c-d)])
          (hv0.le.trans (le_max_left _ _))
      _ ≤ _ := div_le_div_of_nonneg_left hnum hv0 (le_max_left _ _)
  · have hempty : P.filter
        (fun p : ℕ ↦ log (p : ℝ) ∈ Set.Icc (max v (c-d)) (c+2*d)) = ∅ := by
      apply filter_eq_empty_iff.mpr
      intro p _ hp
      exact horder (hp.1.trans hp.2)
    rw [hempty, sum_empty]
    exact div_nonneg hnum hv0.le

/-- This estimate is uniform in the finite prime universe and in all atom
locations. Its cost is proportional to support volume, not the number of atoms. -/
theorem prime_finiteIntervalSupport_mass_upper {ι : Type*} [Fintype ι]
    (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) (atom : ι → ℝ)
    {v d : ℝ} (hv : log 2 ≤ v) (hd : 0 < d) :
    (∑ p ∈ P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ) ∧
      log (p : ℝ) ∈ finiteIntervalSupport atom d), 1 / (p : ℝ)) ≤
      ((3*d + 2*mertensErrorConstant + 1) / d) *
        volume.real (finiteIntervalSupport atom d) / v := by
  classical
  obtain ⟨J, _hatoms, _hsep, _hnet, hcover, hcard⟩ :=
    exists_finiteIntervalSupport_packing atom hd
  let covered : ℝ → ℕ → Prop := fun c p ↦
    log (p : ℝ) ∈ Set.Icc (max v (c-d)) (c+2*d)
  have hunion :
      (∑ p ∈ P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ) ∧
        log (p : ℝ) ∈ finiteIntervalSupport atom d), 1 / (p : ℝ)) ≤
      ∑ c ∈ J, ∑ p ∈ P.filter (covered c), 1 / (p : ℝ) := by
    simp only [sum_filter]
    rw [sum_comm]
    apply sum_le_sum
    intro p _
    by_cases hp : v ≤ log (p : ℝ) ∧ log (p : ℝ) ∈ finiteIntervalSupport atom d
    · rw [if_pos hp]
      obtain ⟨c, hc, hpc⟩ := Set.mem_iUnion₂.mp (hcover hp.2)
      have hpc' : covered c p := ⟨max_le hp.1 hpc.1, hpc.2⟩
      have h := single_le_sum (f := fun c ↦ if covered c p then 1/(p:ℝ) else 0)
        (fun _ _ ↦ by split_ifs <;> positivity) hc
      simpa only [if_pos hpc'] using h
    · rw [if_neg hp]
      exact sum_nonneg (fun _ _ ↦ by split_ifs <;> positivity)
  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  have hconst : 0 ≤ (3*d+2*mertensErrorConstant+1)/v := by
    positivity [mertensErrorConstant_pos]
  calc
    _ ≤ ∑ c ∈ J, ∑ p ∈ P.filter (covered c), 1/(p:ℝ) := hunion
    _ ≤ ∑ _c ∈ J, (3*d+2*mertensErrorConstant+1)/v :=
      sum_le_sum (fun c _ ↦ prime_clipped_cover_interval_mass_upper P hP hv hd.le c)
    _ = (J.card : ℝ) * ((3*d+2*mertensErrorConstant+1)/v) := by simp
    _ ≤ (volume.real (finiteIntervalSupport atom d)/d) *
        ((3*d+2*mertensErrorConstant+1)/v) := mul_le_mul_of_nonneg_right hcard hconst
    _ = _ := by ring


