/- Inlined development module: PairTranslationStability.lean -/

section

/- Deterministic stability of finite translated supports under coupled shifts. -/

namespace Erdos859Verification

open Finset Real MeasureTheory
open scoped ENNReal

theorem abs_subset_sum_sub_le {ι : Type*} {P S : Finset ι} {x y : ι → ℝ} {e : ℝ}
    (hSP : S ⊆ P) (he : 0 ≤ e) (hxy : ∀ i ∈ P, |y i - x i| ≤ e) :
    |(∑ i ∈ S, x i) - ∑ i ∈ S, y i| ≤ (P.card : ℝ) * e := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ S, |x i - y i| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i ∈ S, e := sum_le_sum (fun i hi ↦ by rw [abs_sub_comm]; exact hxy i (hSP hi))
    _ = (S.card : ℝ) * e := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (by exact_mod_cast card_le_card hSP) he

theorem abs_fin_subset_sum_sub_le {n : ℕ} {x y : Fin n → ℝ} {e : ℝ}
    (he : 0 ≤ e) (hxy : ∀ i, |y i - x i| ≤ e) (S : Finset (Fin n)) :
    |(∑ i ∈ S, x i) - ∑ i ∈ S, y i| ≤ (n : ℝ) * e := by
  simpa only [card_univ, Fintype.card_fin] using
    abs_subset_sum_sub_le (P := univ) (subset_univ S) he (fun i _ ↦ hxy i)

noncomputable def finiteSubsetTranslateSupport {ι : Type*} (A : Set ℝ) (P : Finset ι)
    (x : ι → ℝ) : Set ℝ :=
  ⋃ S : P.powerset, realTranslateSet A (∑ i ∈ (S : Finset ι), x i)

theorem mem_finiteSubsetTranslateSupport {ι : Type*} {A : Set ℝ} {P : Finset ι}
    {x : ι → ℝ} {z : ℝ} :
    z ∈ finiteSubsetTranslateSupport A P x ↔
      ∃ S : Finset ι, S ⊆ P ∧ z - (∑ i ∈ S, x i) ∈ A := by
  constructor
  · intro hz
    obtain ⟨S, hS⟩ := Set.mem_iUnion.mp hz
    exact ⟨S.val, mem_powerset.mp S.property, hS⟩
  · rintro ⟨S, hS, hz⟩
    exact Set.mem_iUnion.mpr ⟨⟨S, mem_powerset.mpr hS⟩, hz⟩

theorem measurableSet_finiteSubsetTranslateSupport {ι : Type*} {A : Set ℝ}
    (hA : MeasurableSet A) (P : Finset ι) (x : ι → ℝ) :
    MeasurableSet (finiteSubsetTranslateSupport A P x) :=
  MeasurableSet.iUnion (fun _ ↦ measurableSet_realTranslateSet hA _)

def realSupportThickening (A : Set ℝ) (d : ℝ) : Set ℝ :=
  {z | ∃ a ∈ A, |z - a| ≤ d}

theorem realSupportThickening_zero (A : Set ℝ) : realSupportThickening A 0 = A := by
  ext z
  constructor
  · rintro ⟨a, ha, hza⟩
    have heq : z = a := sub_eq_zero.mp (abs_nonpos_iff.mp hza)
    simpa only [heq] using ha
  · intro hz
    exact ⟨z, hz, by simp⟩

theorem isCompact_realSupportThickening {A : Set ℝ} (hA : IsCompact A) (d : ℝ) :
    IsCompact (realSupportThickening A d) := by
  have hi : realSupportThickening A d =
      (fun q : ℝ × ℝ ↦ q.1 + q.2) '' (A ×ˢ Set.Icc (-d) d) := by
    ext z
    constructor
    · rintro ⟨a, ha, hza⟩
      refine ⟨(a, z - a), ⟨ha, ?_⟩, by simp⟩
      exact abs_le.mp hza
    · rintro ⟨⟨a, b⟩, ⟨ha, hb⟩, rfl⟩
      exact ⟨a, ha, by simpa only [add_sub_cancel_left] using abs_le.mpr hb⟩
  rw [hi]
  exact (hA.prod isCompact_Icc).image (by fun_prop)

theorem measurableSet_realSupportThickening {A : Set ℝ} (hA : IsCompact A) (d : ℝ) :
    MeasurableSet (realSupportThickening A d) :=
  (isCompact_realSupportThickening hA d).measurableSet

noncomputable def finiteThickenedTranslateSupport {ι : Type*} (A : Set ℝ)
    (P : Finset ι) (x : ι → ℝ) (d : ℝ) : Set ℝ :=
  finiteSubsetTranslateSupport (realSupportThickening A d) P x

theorem mem_finiteThickenedTranslateSupport {ι : Type*} {A : Set ℝ} {P : Finset ι}
    {x : ι → ℝ} {d z : ℝ} :
    z ∈ finiteThickenedTranslateSupport A P x d ↔
      ∃ S : Finset ι, S ⊆ P ∧ ∃ a ∈ A, |z - a - (∑ i ∈ S, x i)| ≤ d := by
  rw [finiteThickenedTranslateSupport, mem_finiteSubsetTranslateSupport]
  constructor
  · rintro ⟨S, hS, a, ha, hdist⟩
    refine ⟨S, hS, a, ha, ?_⟩
    have hid : z - a - (∑ i ∈ S, x i) = z - (∑ i ∈ S, x i) - a := by ring
    rw [hid]
    exact hdist
  · rintro ⟨S, hS, a, ha, hdist⟩
    refine ⟨S, hS, a, ha, ?_⟩
    have hid : z - (∑ i ∈ S, x i) - a = z - a - (∑ i ∈ S, x i) := by ring
    rw [hid]
    exact hdist

theorem measurableSet_finiteThickenedTranslateSupport {ι : Type*} {A : Set ℝ}
    (hA : IsCompact A) (P : Finset ι) (x : ι → ℝ) (d : ℝ) :
    MeasurableSet (finiteThickenedTranslateSupport A P x d) :=
  measurableSet_finiteSubsetTranslateSupport (measurableSet_realSupportThickening hA d) P x

theorem finiteThickenedTranslateSupport_stability {ι : Type*} {A : Set ℝ}
    {P : Finset ι} {x y : ι → ℝ} {e d : ℝ} (he : 0 ≤ e)
    (hxy : ∀ i ∈ P, |y i - x i| ≤ e) :
    finiteThickenedTranslateSupport A P x d ⊆
      finiteThickenedTranslateSupport A P y (d + (P.card : ℝ) * e) := by
  intro z hz
  obtain ⟨S, hS, a, ha, hdist⟩ := mem_finiteThickenedTranslateSupport.mp hz
  refine mem_finiteThickenedTranslateSupport.mpr ⟨S, hS, a, ha, ?_⟩
  have hsum := abs_subset_sum_sub_le hS he hxy
  have hid : z - a - (∑ i ∈ S, y i) =
      (z - a - (∑ i ∈ S, x i)) + ((∑ i ∈ S, x i) - (∑ i ∈ S, y i)) := by ring
  rw [hid]
  exact (abs_add_le _ _).trans (add_le_add hdist hsum)

theorem finiteThickenedTranslateSupport_missing_mono {ι : Type*} {A I : Set ℝ}
    {P : Finset ι} {x y : ι → ℝ} {e d : ℝ} (he : 0 ≤ e)
    (hxy : ∀ i ∈ P, |y i - x i| ≤ e) (hI : volume I ≠ ∞) :
    volume.real (I \ finiteThickenedTranslateSupport A P y (d + (P.card : ℝ) * e)) ≤
      volume.real (I \ finiteThickenedTranslateSupport A P x d) := by
  apply measureReal_mono _ (measure_ne_top_of_subset Set.sdiff_subset hI)
  exact Set.sdiff_subset_sdiff_right (finiteThickenedTranslateSupport_stability he hxy)

theorem finThickenedTranslateSupport_stability {n : ℕ} {A : Set ℝ}
    {x y : Fin n → ℝ} {e d : ℝ} (he : 0 ≤ e) (hxy : ∀ i, |y i - x i| ≤ e) :
    finiteThickenedTranslateSupport A univ x d ⊆
      finiteThickenedTranslateSupport A univ y (d + (n : ℝ) * e) := by
  simpa only [card_univ, Fintype.card_fin] using
    finiteThickenedTranslateSupport_stability (A := A) (P := univ) (d := d) he (fun i _ ↦ hxy i)

theorem finThickenedTranslateSupport_missing_Icc {n : ℕ} {A : Set ℝ}
    {x y : Fin n → ℝ} {e d a b : ℝ} (he : 0 ≤ e) (hxy : ∀ i, |y i - x i| ≤ e) :
    volume.real (Set.Icc a b \ finiteThickenedTranslateSupport A univ y (d + (n : ℝ) * e)) ≤
      volume.real (Set.Icc a b \ finiteThickenedTranslateSupport A univ x d) := by
  simpa only [card_univ, Fintype.card_fin] using
    finiteThickenedTranslateSupport_missing_mono (A := A) (I := Set.Icc a b)
      (P := univ) (d := d) he (fun i _ ↦ hxy i) isCompact_Icc.measure_ne_top

theorem finiteThickenedTranslateSupport_pair_error {n : ℕ} {A : Set ℝ}
    {x y : Fin n → ℝ} {d : ℝ}
    (hxy : ∀ i, |y i - x i| ≤ 32 * primeLogOddsErrorConstant) :
    finiteThickenedTranslateSupport A univ x d ⊆
      finiteThickenedTranslateSupport A univ y (d + 32 * primeLogOddsErrorConstant * n) := by
  have hC := primeLogOddsErrorConstant_pos
  have h := finThickenedTranslateSupport_stability (A := A) (d := d) (by positivity) hxy
  convert h using 1
  congr 1
  ring

noncomputable def finiteBitTranslateSupport {n : ℕ} (A : Set ℝ) (x : Fin n → ℝ) : Set ℝ :=
  ⋃ b : Fin n → Bool, realTranslateSet A (∑ i, if b i then x i else 0)

theorem finiteBitTranslateSupport_eq_subsetSupport {n : ℕ} (A : Set ℝ) (x : Fin n → ℝ) :
    finiteBitTranslateSupport A x = finiteSubsetTranslateSupport A univ x := by
  classical
  ext z
  constructor
  · intro hz
    obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hz
    refine mem_finiteSubsetTranslateSupport.mpr ⟨univ.filter (fun i ↦ b i), filter_subset _ _, ?_⟩
    change z - (∑ i, if b i then x i else 0) ∈ A at hb
    simpa only [sum_filter] using hb
  · intro hz
    obtain ⟨S, _, hS⟩ := mem_finiteSubsetTranslateSupport.mp hz
    apply Set.mem_iUnion.mpr
    refine ⟨fun i ↦ decide (i ∈ S), ?_⟩
    change z - (∑ i : Fin n, if decide (i ∈ S) then x i else 0) ∈ A
    have hs : (∑ i : Fin n, if decide (i ∈ S) then x i else 0) = ∑ i ∈ S, x i := by
      simp only [decide_eq_true_eq]
      rw [← sum_filter]
      simp
    rwa [hs]

theorem finiteBitTranslateSupport_zero (A : Set ℝ) (x : Fin 0 → ℝ) :
    finiteBitTranslateSupport A x = A := by
  ext z
  constructor
  · intro hz
    obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hz
    simpa only [realTranslateSet, Fin.sum_univ_zero, sub_zero, Set.mem_preimage] using hb
  · intro hz
    refine Set.mem_iUnion.mpr ⟨fun _ ↦ false, ?_⟩
    simpa only [realTranslateSet, Fin.sum_univ_zero, sub_zero, Set.mem_preimage] using hz

theorem finiteBitTranslateSupport_snoc {n : ℕ} (A : Set ℝ) (x : Fin n → ℝ) (g : ℝ) :
    finiteBitTranslateSupport A (Fin.snoc x g) =
      finiteBitTranslateSupport A x ∪ realTranslateSet (finiteBitTranslateSupport A x) g := by
  classical
  have hsum (b : Fin (n + 1) → Bool) :
      (∑ i : Fin (n + 1), if b i then Fin.snoc x g i else 0) =
        (∑ i : Fin n, if b i.castSucc then x i else 0) + if b (Fin.last n) then g else 0 := by
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
  ext z
  constructor
  · intro hz
    obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hz
    change z - (∑ i, if b i then Fin.snoc x g i else 0) ∈ A at hb
    rw [hsum b] at hb
    cases hl : b (Fin.last n)
    · apply Or.inl
      apply Set.mem_iUnion.mpr
      refine ⟨fun i ↦ b i.castSucc, ?_⟩
      change z - (∑ i : Fin n, if b i.castSucc then x i else 0) ∈ A
      simpa only [hl, Bool.false_eq_true, if_false, add_zero] using hb
    · apply Or.inr
      change z - g ∈ finiteBitTranslateSupport A x
      apply Set.mem_iUnion.mpr
      refine ⟨fun i ↦ b i.castSucc, ?_⟩
      change z - g - (∑ i : Fin n, if b i.castSucc then x i else 0) ∈ A
      have hid : z - g - (∑ i : Fin n, if b i.castSucc then x i else 0) =
          z - ((∑ i : Fin n, if b i.castSucc then x i else 0) + g) := by ring
      rw [hid]
      simpa only [hl, if_true] using hb
  · rintro (hz | hz)
    · obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hz
      apply Set.mem_iUnion.mpr
      refine ⟨Fin.snoc b false, ?_⟩
      change z - _ ∈ A
      rw [hsum]
      change z - (∑ i : Fin n, if b i then x i else 0) ∈ A at hb
      simpa only [Fin.snoc_castSucc, Fin.snoc_last, Bool.false_eq_true, if_false, add_zero] using hb
    · change z - g ∈ finiteBitTranslateSupport A x at hz
      obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hz
      apply Set.mem_iUnion.mpr
      refine ⟨Fin.snoc b true, ?_⟩
      change z - _ ∈ A
      rw [hsum]
      simp only [Fin.snoc_castSucc, Fin.snoc_last, if_true]
      have hid : z - ((∑ i, if b i then x i else 0) + g) =
          z - g - (∑ i, if b i then x i else 0) := by ring
      rw [hid]
      exact hb

/-- An existing quadratic-refinement certificate retains a finite shift
tuple whose complete subset-translation support is the certified set. -/
theorem QuadraticHoleRefinement.exists_shift_tuple {ell : ℝ} {A S : Set ℝ} {n : ℕ}
    (h : QuadraticHoleRefinement ell A n S) :
    ∃ x : Fin n → ℝ, S = finiteSubsetTranslateSupport A univ x := by
  induction h with
  | initial =>
      refine ⟨fun i ↦ Fin.elim0 i, ?_⟩
      rw [← finiteBitTranslateSupport_eq_subsetSupport, finiteBitTranslateSupport_zero]
  | step _ g _ ih =>
      obtain ⟨x, hx⟩ := ih
      refine ⟨Fin.snoc x g, ?_⟩
      rw [← finiteBitTranslateSupport_eq_subsetSupport, finiteBitTranslateSupport_snoc,
        finiteBitTranslateSupport_eq_subsetSupport, ← hx]

theorem QuadraticHoleRefinement.coupled_missing_transfer {ell : ℝ} {A S : Set ℝ}
    {n : ℕ} (h : QuadraticHoleRefinement ell A n S) :
    ∃ x : Fin n → ℝ, S = finiteSubsetTranslateSupport A univ x ∧
      ∀ (y : Fin n → ℝ) (e : ℝ), 0 ≤ e → (∀ i, |y i - x i| ≤ e) →
      ∀ a b : ℝ,
        volume.real (Set.Icc a b \ finiteThickenedTranslateSupport A univ y ((n : ℝ) * e)) ≤
          volume.real (Set.Icc a b \ S) := by
  obtain ⟨x, hx⟩ := h.exists_shift_tuple
  refine ⟨x, hx, ?_⟩
  intro y e he hxy a b
  have hb := finThickenedTranslateSupport_missing_Icc (A := A) (d := 0) (a := a) (b := b) he hxy
  simpa only [zero_add, finiteThickenedTranslateSupport, realSupportThickening_zero, ← hx] using hb

theorem finiteSubsetTranslateSupport_base_subset {ι : Type*} (A : Set ℝ)
    (P : Finset ι) (x : ι → ℝ) : A ⊆ finiteSubsetTranslateSupport A P x := by
  intro z hz
  refine mem_finiteSubsetTranslateSupport.mpr ⟨∅, empty_subset P, ?_⟩
  simpa only [sum_empty, sub_zero] using hz

/-- Initial coverage only uses individual translates. The full subset cube
contains all of them, so its missing measure can only be smaller. -/
theorem InitialCoverageByTranslates.exists_shift_tuple_subset {L : ℝ} {B A : Set ℝ} {n : ℕ}
