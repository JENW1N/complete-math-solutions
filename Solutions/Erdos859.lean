/- Exact finite tilted-prime probabilities for the early suffix-bin event. -/

namespace Erdos859Verification

open Finset Real

noncomputable def primeTiltSingleInMass (P S : Finset ℕ) (lam : ℝ) : ℝ :=
  ∑ T ∈ P.powerset.filter (fun T ↦ T.card = 1 ∧ T ⊆ S), primeTiltWeight P lam T

theorem sum_singleton_subsets {P S : Finset ℕ} (hS : S ⊆ P) (f : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset.filter (fun T ↦ T.card = 1 ∧ T ⊆ S), f T) = ∑ p ∈ S, f {p} := by
  classical
  symm
  apply sum_bij (fun p _ ↦ {p})
  · intro p hp
    exact mem_filter.mpr ⟨mem_powerset.mpr (singleton_subset_iff.mpr (hS hp)),
      card_singleton p, singleton_subset_iff.mpr hp⟩
  · intro p _ q _ hpq
    exact singleton_injective hpq
  · intro T hT
    obtain ⟨p, rfl⟩ := card_eq_one.mp (mem_filter.mp hT).2.1
    exact ⟨p, singleton_subset_iff.mp (mem_filter.mp hT).2.2, rfl⟩
  · intro p _
    rfl

theorem primeTiltSingleInMass_eq {P S : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hS : S ⊆ P) {lam : ℝ} (hlam : 0 < lam) :
    primeTiltSingleInMass P S lam =
      exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) * ∑ p ∈ S, lam / ((p : ℝ) - 1) := by
  rw [primeTiltSingleInMass, sum_singleton_subsets hS, mul_sum]
  apply sum_congr rfl
  intro p hp
  rw [primeTiltWeight_eq_empty_mul_tilted_odds hP (singleton_subset_iff.mpr (hS hp)),
    primeTiltWeight_empty_eq_exp_neg_intensity hP hlam, prod_singleton]

theorem primeTiltSingleInMass_intensity_lower {P S : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hS : S ⊆ P) {lam : ℝ} (hlam : 0 < lam) :
    exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
      (∑ p ∈ S, primeLogOddsIntensity lam p) ≤ primeTiltSingleInMass P S lam := by
  rw [primeTiltSingleInMass_eq hP hS hlam]
  exact mul_le_mul_of_nonneg_left
    (sum_le_sum (fun p hp ↦ (primeLogOddsIntensity_le_odds hlam (hP p (hS hp))).2))
    (exp_pos _).le

theorem primeTiltSingleInMass_nonneg {P S : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    0 ≤ primeTiltSingleInMass P S lam :=
  sum_nonneg (fun T _ ↦ (primeTiltWeight_pos hP hlam T).le)

/-- Exact independence for arbitrary events on disjoint finite prime bands. -/
theorem prime_tilt_disjoint_band_events_product {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (lam : ℝ) (E : ι → Finset ℕ → Prop) [∀ i, DecidablePred (E i)] :
    (∑ T ∈ (primeBandUnion P).powerset.filter (fun T ↦ ∀ i, E i (T ∩ P i)),
      primeTiltWeight (primeBandUnion P) lam T) =
      ∏ i, ∑ T ∈ (P i).powerset.filter (E i), primeTiltWeight (P i) lam T := by
  classical
  have h := prime_tilt_expectation_primeBand_partition P hdis lam
    (fun U ↦ if ∀ i, E i (U i) then 1 else 0)
  simp only [mul_ite, mul_one, mul_zero, ← sum_filter] at h
  rw [h]
  simp only [sum_filter]
  have he (U : ι → Finset ℕ) :
      (if ∀ i, E i (U i) then ∏ i, primeTiltWeight (P i) lam (U i) else 0) =
        ∏ i, primeTiltWeight (P i) lam (U i) * (if E i (U i) then (1 : ℝ) else 0) := by
    rw [prod_mul_distrib, prod_boole]
    simp only [mem_univ, forall_true_left, mul_ite, mul_one, mul_zero]
  simp_rw [he]
  symm
  simpa only [primeBandSelections, mul_ite, mul_one, mul_zero] using
    prod_univ_sum (fun i ↦ (P i).powerset)
      (fun i T ↦ primeTiltWeight (P i) lam T * (if E i T then (1 : ℝ) else 0))

theorem prime_tilt_disjoint_singleIn_product {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P S : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j))) (lam : ℝ) :
    (∑ T ∈ (primeBandUnion P).powerset.filter
      (fun T ↦ ∀ i, (T ∩ P i).card = 1 ∧ T ∩ P i ⊆ S i),
      primeTiltWeight (primeBandUnion P) lam T) = ∏ i, primeTiltSingleInMass (P i) (S i) lam := by
  classical
  exact prime_tilt_disjoint_band_events_product P hdis lam (fun i T ↦ T.card = 1 ∧ T ⊆ S i)

theorem shifted_exp_log_lower {A t : ℝ} (hA : 0 ≤ A) (ht : 0 < t) (eta : ℝ) :
    eta * t / (A + t) ≤ log ((A + t * exp eta) / (A + t)) := by
  have hd : 0 < A + t := by positivity
  have hx : 0 ≤ t / (A + t) := div_nonneg ht.le hd.le
  have hx1 : t / (A + t) ≤ 1 := (div_le_one hd).mpr (by linarith)
  have hc := strictConcaveOn_log_Ioi.concaveOn.2
    (show (1 : ℝ) ∈ Set.Ioi 0 by norm_num)
    (show exp eta ∈ Set.Ioi 0 from exp_pos eta)
    (show 0 ≤ 1 - t / (A + t) by linarith) hx
    (by ring : 1 - t / (A + t) + t / (A + t) = 1)
  simp only [smul_eq_mul, log_one, mul_zero, zero_add, log_exp] at hc
  have he : (1 - t / (A + t)) * 1 + (t / (A + t)) * exp eta =
      (A + t * exp eta) / (A + t) := by field_simp; ring
  rw [he] at hc
  simpa only [div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm] using hc

theorem shifted_exp_log_upper {A t eta : ℝ} (hA : 0 ≤ A) (ht : 0 < t) (heta : 0 ≤ eta) :
    log ((A + t * exp eta) / (A + t)) ≤ eta := by
  have he : 1 ≤ exp eta := one_le_exp_iff.mpr heta
  have hr : (A + t * exp eta) / (A + t) ≤ exp eta := by
    apply (div_le_iff₀ (by positivity : 0 < A + t)).mpr
    nlinarith
  simpa only [log_exp] using log_le_log (by positivity) hr

noncomputable def coreSuffixPrimeBand (A B eta : ℝ) (j : ℕ) : Finset ℕ :=
  primeLogWindow (A + B * 2 ^ j) (A + B * exp eta * 2 ^ j)

theorem coreSuffixPrimeBand_subset {A B eta : ℝ} (hB : 0 < B) (heta : eta ≤ log 2) (j : ℕ) :
    coreSuffixPrimeBand A B eta j ⊆ virtualPrimeBand A B j := by
  intro p hp
  obtain ⟨hp, hlo, hhi⟩ := mem_primeLogWindow.mp hp
  have he : exp eta ≤ 2 := by simpa only [exp_log (by norm_num : (0 : ℝ) < 2)] using exp_le_exp.mpr heta
  apply mem_primeLogWindow.mpr
  refine ⟨hp, hlo, hhi.trans ?_⟩
  rw [pow_succ]
  have ht : 0 ≤ B * (2 : ℝ) ^ j := by positivity
  nlinarith

theorem prime_intensity_window_eq_normalized {lam : ℝ} (hlam : 0 < lam) (u v : ℝ) :
    (∑ p ∈ primeLogWindow u v, primeLogOddsIntensity lam p) =
      lam * primeNormalizedLogOddsWindowMass lam u v := by
  unfold primeNormalizedLogOddsWindowMass
  rw [mul_sum]
  apply sum_congr rfl
  intro p _
  field_simp

/-- Quantitative error before imposing a minimum width. -/
theorem coreSuffix_intensity_lower_error {A B eta lam : ℝ}
    (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B) (heta : 0 ≤ eta)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (j : ℕ) :
    lam * (eta * B * 2 ^ j / (A + B * 2 ^ j) -
      2 * primeLogOddsErrorConstant / (A + B * 2 ^ j)) ≤
      ∑ p ∈ coreSuffixPrimeBand A B eta j, primeLogOddsIntensity lam p := by
  have hp : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
