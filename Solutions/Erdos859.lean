    (hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G) :
    translationShiftLaw (logUniformPairDensity u w) E ≤
      (Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
        ((primeLogOddsLogLaw lam u w).prod (primeLogOddsLogLaw lam u w))) G := by
  let : IsProbabilityMeasure (primeLogOddsQuantileCoupling lam u w) :=
    finiteQuantileCoupling_isProbability _ _ (measurable_logUniformQuantile u w)
  let : IsProbabilityMeasure (primeLogOddsPairQuantileCoupling lam u w) :=
    pairDifferenceCoupling_isProbability _
  have h := primeLogOddsPairQuantileCoupling_properties hlam hlam2 hu hw hwu hlarge
  simpa only [h.1, h.2.1] using
    coupling_robust_event_le _ h.2.2 hE hG hrobust

theorem primeReciprocalOddsPair_event_transfer {u w : ℝ}
    (hu : log 2 ≤ u) (hw : 0 < w) (hwu : w ≤ u)
    (hlarge : 8 * primeLogOddsErrorConstant ≤ w)
    {E G : Set ℝ} (hE : MeasurableSet E) (hG : MeasurableSet G)
    (hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G) :
    translationShiftLaw (logUniformPairDensity u w) E ≤
      (Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
        ((primeReciprocalOddsLogLaw u w).prod (primeReciprocalOddsLogLaw u w))) G := by
  let : IsProbabilityMeasure (primeReciprocalOddsQuantileCoupling u w) :=
    finiteQuantileCoupling_isProbability _ _ (measurable_logUniformQuantile u w)
  let : IsProbabilityMeasure (primeReciprocalOddsPairQuantileCoupling u w) :=
    pairDifferenceCoupling_isProbability _
  have h := primeReciprocalOddsPairQuantileCoupling_properties hu hw hwu hlarge
  simpa only [h.1, h.2.1] using
    coupling_robust_event_le _ h.2.2 hE hG hrobust

theorem finiteIndexedMarkLaw_difference_apply {ι : Type*} (P : Finset ι)
    (a : ι → ℝ) (f : ι → ℝ) {G : Set ℝ} [DecidablePred (· ∈ G)]
    (hG : MeasurableSet G) :
    (Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
      ((finiteIndexedMarkLaw P a f).prod (finiteIndexedMarkLaw P a f))) G =
      ∑ p ∈ P, ∑ q ∈ P, ENNReal.ofReal (a p) * ENNReal.ofReal (a q) *
        (if f p - f q ∈ G then 1 else 0) := by
  classical
  let : SFinite (finiteIndexedMarkLaw P a f) := by
    unfold finiteIndexedMarkLaw
    rw [← Finset.sum_coe_sort, ← Measure.sum_fintype]
    infer_instance
  rw [Measure.map_apply (by fun_prop) hG, Measure.prod_apply (hG.preimage (by fun_prop))]
  simp only [finiteIndexedMarkLaw, lintegral_finsetSum_measure, lintegral_smul_measure,
    smul_eq_mul, lintegral_dirac, Measure.coe_finsetSum, Finset.sum_apply,
    Measure.smul_apply, mul_sum]
  apply sum_congr rfl
  intro p _
  apply sum_congr rfl
  intro q _
  rw [Measure.dirac_apply' _ ((hG.preimage (by fun_prop)).preimage measurable_prodMk_left)]
  simp only [Set.indicator_apply, Set.mem_preimage, Pi.one_apply]
  ring

theorem finiteIndexedMarkLaw_difference_real {ι : Type*} {P : Finset ι}
    {a : ι → ℝ} (ha : ∀ p ∈ P, 0 ≤ a p) (f : ι → ℝ)
    {G : Set ℝ} [DecidablePred (· ∈ G)] (hG : MeasurableSet G) :
    ((Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
      ((finiteIndexedMarkLaw P a f).prod (finiteIndexedMarkLaw P a f))) G).toReal =
      ∑ p ∈ P, ∑ q ∈ P, a p * a q * (if f p - f q ∈ G then 1 else 0) := by
  classical
  rw [finiteIndexedMarkLaw_difference_apply P a f hG]
  have ht (p q : ι) : ENNReal.ofReal (a p) * ENNReal.ofReal (a q) *
      (if f p - f q ∈ G then 1 else 0) ≠ ∞ := by
    split_ifs
    · simpa only [mul_one] using ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    · simp
  rw [ENNReal.toReal_sum (fun p _ ↦ ENNReal.sum_ne_top.mpr (fun q _ ↦ ht p q))]
  apply sum_congr rfl
  intro p hp
  rw [ENNReal.toReal_sum (fun q _ ↦ ht p q)]
  apply sum_congr rfl
  intro q hq
  simp only [ENNReal.toReal_mul, ENNReal.toReal_ofReal (ha p hp),
    ENNReal.toReal_ofReal (ha q hq)]
  split_ifs <;> simp

theorem finiteIndexedMarkLaw_difference_ne_top {ι : Type*} (P : Finset ι)
    (a : ι → ℝ) (f : ι → ℝ) {G : Set ℝ} (hG : MeasurableSet G) :
    (Measure.map (fun z : ℝ × ℝ ↦ z.1 - z.2)
      ((finiteIndexedMarkLaw P a f).prod (finiteIndexedMarkLaw P a f))) G ≠ ∞ := by
  classical
  rw [finiteIndexedMarkLaw_difference_apply P a f hG]
  apply ENNReal.sum_ne_top.mpr
  intro p _
  apply ENNReal.sum_ne_top.mpr
  intro q _
  split_ifs
  · simpa only [mul_one] using ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
  · simp

theorem primeLogOddsPair_event_finite_lower {lam u w rho : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u)
    (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w)
    {E G : Set ℝ} [DecidablePred (· ∈ G)] (hE : MeasurableSet E) (hG : MeasurableSet G)
    (hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G)
    (hrho : rho ≤ (translationShiftLaw (logUniformPairDensity u w) E).toReal) :
    rho ≤ ∑ p ∈ primeLogWindow u (u + w), ∑ q ∈ primeLogWindow u (u + w),
      primeLogOddsMarkWeight lam u (u + w) p * primeLogOddsMarkWeight lam u (u + w) q *
        (if log (p : ℝ) - log (q : ℝ) ∈ G then 1 else 0) := by
  have h := primeLogOddsPair_event_transfer hlam hlam2 hu hw hwu hlarge hE hG hrobust
  have hn := primeLogOddsMark_additive_normalized hlam hlam2 hu hw hwu hlarge
  have ht := ENNReal.toReal_mono (finiteIndexedMarkLaw_difference_ne_top _ _ _ hG) h
  rw [finiteIndexedMarkLaw_difference_real hn.1 _ hG] at ht
  exact hrho.trans ht

theorem primeReciprocalOddsPair_event_finite_lower {u w rho : ℝ}
    (hu : log 2 ≤ u) (hw : 0 < w) (hwu : w ≤ u)
    (hlarge : 8 * primeLogOddsErrorConstant ≤ w)
    {E G : Set ℝ} [DecidablePred (· ∈ G)] (hE : MeasurableSet E) (hG : MeasurableSet G)
    (hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G)
    (hrho : rho ≤ (translationShiftLaw (logUniformPairDensity u w) E).toReal) :
    rho ≤ ∑ p ∈ primeLogWindow u (u + w), ∑ q ∈ primeLogWindow u (u + w),
      primeReciprocalOddsMarkWeight u (u + w) p * primeReciprocalOddsMarkWeight u (u + w) q *
        (if log (p : ℝ) - log (q : ℝ) ∈ G then 1 else 0) := by
  have h := primeReciprocalOddsPair_event_transfer hu hw hwu hlarge hE hG hrobust
  have hn := primeReciprocalOddsMarkWeight_normalized hu hw hwu hlarge
  have ht := ENNReal.toReal_mono (finiteIndexedMarkLaw_difference_ne_top _ _ _ hG) h
  rw [finiteIndexedMarkLaw_difference_real (fun p hp ↦ (hn.1 p hp).le) _ hG] at ht
  exact hrho.trans ht

theorem finite_pair_tuple_sum {α : Type*} [Fintype α] (a : α → ℝ) (F : α → α → ℝ) :
    (∑ x : Fin 2 → α, finiteProductWeight (fun _ ↦ a) x * F (x 0) (x 1)) =
      ∑ p, ∑ q, a p * a q * F p q := by
  classical
  rw [← Fintype.sum_prod_type' (fun p q ↦ a p * a q * F p q)]
  apply Fintype.sum_equiv (finTwoArrowEquiv α)
  intro x
  simp only [finiteProductWeight, Fin.prod_univ_two, finTwoArrowEquiv_apply]
  rfl

def PrimeSubsetPairEvent (G : Set ℝ) (T : Finset ℕ) : Prop :=
  ∃ p ∈ T, ∃ q ∈ T, log (p : ℝ) - log (q : ℝ) ∈ G

theorem primeSubsetPairEvent_tupleSupport {P : Finset ℕ} {G : Set ℝ}
    (x : Fin 2 → P) (hx : log ((x 0).val : ℝ) - log ((x 1).val : ℝ) ∈ G) :
    PrimeSubsetPairEvent G (tupleSupport x) :=
  ⟨(x 0).val, mem_image_of_mem _ (mem_univ 0),
    (x 1).val, mem_image_of_mem _ (mem_univ 1), hx⟩

theorem primeIntensityPair_bad_subset_le {P : Finset ℕ} {lam rho : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hlam : 0 < lam)
    (hM : 0 < ∑ p ∈ P, primeLogOddsIntensity lam p)
    {G : Set ℝ} [DecidablePred (· ∈ G)] [DecidablePred (PrimeSubsetPairEvent G)]
    (hgood : rho ≤ ∑ p ∈ P, ∑ q ∈ P,
      (primeLogOddsIntensity lam p / ∑ r ∈ P, primeLogOddsIntensity lam r) *
        (primeLogOddsIntensity lam q / ∑ r ∈ P, primeLogOddsIntensity lam r) *
          (if log (p : ℝ) - log (q : ℝ) ∈ G then 1 else 0)) :
    (∑ x : Fin 2 → P, primeIntensityTupleWeight lam x *
      (if PrimeSubsetPairEvent G (tupleSupport x) then 0 else 1)) ≤ 1 - rho := by
  classical
  let a : P → ℝ := fun p ↦ primeLogOddsIntensity lam p.val /
    ∑ r ∈ P, primeLogOddsIntensity lam r
  have ha (p : P) : 0 ≤ a p :=
    div_nonneg (primeLogOddsIntensity_le_odds hlam (hP p.val p.property)).1 hM.le
  have hw (x : Fin 2 → P) : 0 ≤ primeIntensityTupleWeight lam x :=
    finiteProductWeight_nonneg (fun _ ↦ ha) x
  have hsum : (∑ x : Fin 2 → P, primeIntensityTupleWeight lam x *
      (if log ((x 0).val : ℝ) - log ((x 1).val : ℝ) ∈ G then 1 else 0)) =
      ∑ p ∈ P, ∑ q ∈ P,
        (primeLogOddsIntensity lam p / ∑ r ∈ P, primeLogOddsIntensity lam r) *
          (primeLogOddsIntensity lam q / ∑ r ∈ P, primeLogOddsIntensity lam r) *
            (if log (p : ℝ) - log (q : ℝ) ∈ G then 1 else 0) := by
    calc
      _ = ∑ p : P, ∑ q : P, a p * a q *
          (if log (p.val : ℝ) - log (q.val : ℝ) ∈ G then 1 else 0) :=
        finite_pair_tuple_sum a (fun p q : P ↦
          if log (p.val : ℝ) - log (q.val : ℝ) ∈ G then 1 else 0)
      _ = _ := by
        let F : ℕ → ℕ → ℝ := fun p q ↦
          (primeLogOddsIntensity lam p / ∑ r ∈ P, primeLogOddsIntensity lam r) *
            (primeLogOddsIntensity lam q / ∑ r ∈ P, primeLogOddsIntensity lam r) *
              (if log (p : ℝ) - log (q : ℝ) ∈ G then 1 else 0)
        change (∑ p : P, ∑ q : P, F p.val q.val) = ∑ p ∈ P, ∑ q ∈ P, F p q
        rw [Finset.sum_coe_sort P (fun p : ℕ ↦ ∑ q : P, F p q.val)]
        apply sum_congr rfl
        intro p _
        exact Finset.sum_coe_sort P (F p)
  have hp (x : Fin 2 → P) :
      primeIntensityTupleWeight lam x *
        (if PrimeSubsetPairEvent G (tupleSupport x) then 0 else 1) +
      primeIntensityTupleWeight lam x *
        (if log ((x 0).val : ℝ) - log ((x 1).val : ℝ) ∈ G then 1 else 0) ≤
      primeIntensityTupleWeight lam x := by
    by_cases hx : log ((x 0).val : ℝ) - log ((x 1).val : ℝ) ∈ G
    · simp [hx, primeSubsetPairEvent_tupleSupport x hx]
    · simp only [hx, ↓reduceIte, mul_zero, add_zero]
      split_ifs <;> simp [hw x]
  have hs := sum_le_sum (fun x (_ : x ∈ univ) ↦ hp x)
  rw [sum_add_distrib, primeIntensityTupleWeight_normalized hM 2, hsum] at hs
  linarith

/-- A robust continuous event supplies two distinct selected primes. The
duplicate correction is explicit; the selected-subset law is the tilted law. -/
theorem primeTilt_broad_robust_pair_lower {lam u eps rho eta : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u)
    (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * primeLogOddsErrorConstant ≤ eps * u)
    {E G : Set ℝ} [DecidablePred (· ∈ G)] [DecidablePred (PrimeSubsetPairEvent G)]
    (hE : MeasurableSet E) (hG : MeasurableSet G)
    (hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G)
    (hrho : rho ≤ (translationShiftLaw (logUniformPairDensity u (eps * u)) E).toReal)
    (heta : 0 ≤ eta) (hmargin : eta ≤ rho - 64 * exp (-u) / eps) :
    eta * exp (-5 * eps) * (eps / 4) ^ 2 / 2 ≤
      ∑ T ∈ (primeLogWindow u ((1 + eps) * u)).powerset.filter
        (fun T ↦ T.card = 2 ∧ PrimeSubsetPairEvent G T),
        primeTiltWeight (primeLogWindow u ((1 + eps) * u)) lam T := by
  classical
  have hu0 : 0 < u := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hu
  have hw : 0 < eps * u := mul_pos heps hu0
  have hwu : eps * u ≤ u := mul_le_of_le_one_left hu0.le heps1
  have hlarge' : 8 * mertensErrorConstant ≤ eps * u := by
    unfold primeLogOddsErrorConstant at hlarge
    linarith
  have hend : u + eps * u = (1 + eps) * u := by ring
  have hgood := primeLogOddsPair_event_finite_lower hlam hlam2 hu hw hwu hlarge
    hE hG hrobust hrho
  rw [hend] at hgood
  have hM : 0 < ∑ p ∈ primeLogWindow u ((1 + eps) * u), primeLogOddsIntensity lam p :=
    (by positivity : 0 < eps / 4).trans_le
      (primeLogOddsIntensity_broad_mass_lower hlam hlam2 hu heps heps1 hlarge')
  have hbad := primeIntensityPair_bad_subset_le
    (fun p hp ↦ (mem_primeLogWindow.mp hp).1) (by linarith : 0 < lam) hM hgood
  have hm : eta ≤ 1 - (1 - rho) - (2 : ℝ) ^ 2 * (16 * exp (-u) / eps) := by
    convert hmargin using 1
    ring
  have h := primeTilt_broad_good_count_lower hlam hlam2 hu heps heps1 hlarge'
    2 (PrimeSubsetPairEvent G) heta hm hbad
  norm_num only [Nat.factorial_succ, Nat.factorial_zero, Nat.cast_ofNat] at h
  exact h

end Erdos859Verification

