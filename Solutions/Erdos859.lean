          (fun _ _ ↦ by split_ifs <;> positivity [primePatternWeight_pos hP T]) hpP
        simpa only [if_pos (And.intro hpT hw)] using h
      · rw [if_neg hgood]
        exact sum_nonneg (fun _ _ ↦ by split_ifs <;> positivity [primePatternWeight_pos hP T])
