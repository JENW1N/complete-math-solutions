independence or localization estimate is assumed. -/
theorem radical_event_mass_le_stopping_sum {P : Finset ℕ}
    (hP : ∀ q ∈ P, q.Prime) {y : ℝ} (hy : 1 ≤ y) :
    (∑ T ∈ P.powerset.filter (FordRadicalDivisorEvent y), primePatternWeight P T) ≤
