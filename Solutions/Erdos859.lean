        (1 - 2 * Real.pi ^ 2 * (∑ i, (c i : ℝ) * t i) ^ 2)) ≤
      ∑ c ∈ signedCoefficientBox ι H, cos (2 * Real.pi * ∑ i, (c i : ℝ) * t i) := by
    apply sum_le_sum
