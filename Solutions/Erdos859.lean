    (E := circleClosedNeighborhood F d) (by
    intro i hi y hy
    refine ⟨x i, hF i hi, ?_⟩
    have hxy : dist (x i) y < r := by simpa only [mem_ball, dist_comm] using hy
    exact hxy.le.trans (min_le_left _ _))
  have hbound : (S.card : ℝ) ≤
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) / (2 * r) :=
    (le_div_iff₀ (by positivity : 0 < 2 * r)).mpr h
  have hcoeff : 1 / (2 * r) ≤ 1 / d + 1 / delta := by
    rcases le_total d (delta / 2) with hle | hle
    · have hrEq : r = d := min_eq_left hle
      rw [hrEq]
      have hrecip : 1 / (2 * d) ≤ 1 / d := one_div_le_one_div_of_le hd (by linarith)
      have hpos : 0 ≤ 1 / delta := by positivity
      linarith
    · have hrEq : r = delta / 2 := min_eq_right hle
      rw [hrEq]
      have hpos : 0 ≤ 1 / d := by positivity
      have heq : 1 / (2 * (delta / 2)) = 1 / delta := by ring
      rw [heq]
      linarith
  exact hbound.trans (by
    simpa only [div_eq_mul_inv, one_div, mul_comm, one_mul, mul_one] using
      mul_le_mul_of_nonneg_right hcoeff (measureReal_nonneg :
        0 ≤ AddCircle.haarAddCircle.real (circleClosedNeighborhood F d)))

noncomputable def circleRationalGridPoint (q : ℕ) (a : Fin q) : AddCircle (1 : ℝ) :=
  a.val • (((1 : ℝ) / q : ℝ) : AddCircle (1 : ℝ))

theorem circleRationalGridPoint_eq_div (q : ℕ) (a : Fin q) :
    circleRationalGridPoint q a = (((a.val : ℝ) / q : ℝ) : AddCircle (1 : ℝ)) := by
  unfold circleRationalGridPoint
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul, mul_one_div]

theorem circleRationalGridPoint_injective {q : ℕ} (hq : 0 < q) :
    Function.Injective (circleRationalGridPoint q) := by
  intro a b hab
  apply Fin.ext
  apply nsmul_injOn_Iio_addOrderOf (x := (((1 : ℝ) / q : ℝ) : AddCircle (1 : ℝ)))
    (by simpa only [Set.mem_Iio, AddCircle.addOrderOf_period_div hq] using a.isLt)
    (by simpa only [Set.mem_Iio, AddCircle.addOrderOf_period_div hq] using b.isLt)
  exact hab

theorem circle_torsion_dist_lower {q : ℕ} (hq : 0 < q)
    {x y : AddCircle (1 : ℝ)} (hx : q • x = 0) (hy : q • y = 0) (hxy : x ≠ y) :
    1 / (q : ℝ) ≤ dist x y := by
  have hzero : q • (x - y) = 0 := by rw [nsmul_sub, hx, hy, sub_self]
  have hfin : IsOfFinAddOrder (x - y) :=
    isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨q, hq, hzero⟩
  have hord : addOrderOf (x - y) ≤ q :=
    Nat.le_of_dvd hq (addOrderOf_dvd_iff_nsmul_eq_zero.mpr hzero)
  have hnorm := AddCircle.le_add_order_smul_norm_of_isOfFinAddOrder hfin (sub_ne_zero.mpr hxy)
  have hsmul : addOrderOf (x - y) • ‖x - y‖ ≤ q • ‖x - y‖ :=
    nsmul_le_nsmul_left (norm_nonneg _) hord
  simp only [nsmul_eq_mul] at hnorm hsmul
  rw [dist_eq_norm]
  exact (div_le_iff₀ (by exact_mod_cast hq : (0 : ℝ) < q)).mpr (by nlinarith)

theorem circleRationalGridPoint_separated {q : ℕ} (hq : 0 < q) :
    ∀ a b : Fin q, a ≠ b → 1 / (q : ℝ) ≤ dist (circleRationalGridPoint q a) (circleRationalGridPoint q b) := by
  have hz (a : Fin q) : q • circleRationalGridPoint q a = 0 := by
    unfold circleRationalGridPoint
    rw [smul_comm]
    have h := addOrderOf_nsmul_eq_zero (((1 : ℝ) / q : ℝ) : AddCircle (1 : ℝ))
    rw [AddCircle.addOrderOf_period_div hq] at h
    rw [h, smul_zero]
  intro a b hab
  exact circle_torsion_dist_lower hq (hz a) (hz b)
    (fun h ↦ hab (circleRationalGridPoint_injective hq h))

theorem circleRationalGrid_card_neighborhood_le {q : ℕ} (hq : 0 < q)
    (S : Finset (Fin q)) {d : ℝ} (hd : 0 < d) (hdhalf : d ≤ 1 / 2)
    (F : Set (AddCircle (1 : ℝ))) (hF : ∀ a ∈ S, circleRationalGridPoint q a ∈ F) :
    (S.card : ℝ) ≤ ((q : ℝ) + 1 / d) *
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have h := circle_separated_card_neighborhood_le S (circleRationalGridPoint q)
    (by positivity : 0 < 1 / (q : ℝ)) hd hdhalf
    (fun a _ b _ hab ↦ circleRationalGridPoint_separated hq a b hab) F hF
  simpa only [one_div_one_div, add_comm] using h

/-- A maximal separated subfamily of finitely many points covers them all. -/
theorem exists_finite_separated_cover {α X : Type*} [PseudoMetricSpace X]
    (S : Finset α) (x : α → X) {d : ℝ} (hd : 0 < d) :
    ∃ J : Finset α, J ⊆ S ∧
      (∀ i ∈ J, ∀ j ∈ J, i ≠ j → d ≤ dist (x i) (x j)) ∧
      ∀ i ∈ S, ∃ j ∈ J, dist (x i) (x j) < d := by
  classical
  let Sep : Finset α → Prop :=
    fun J ↦ ∀ i ∈ J, ∀ j ∈ J, i ≠ j → d ≤ dist (x i) (x j)
  let : DecidablePred Sep := fun _ ↦ Classical.propDecidable _
  let A := S.powerset.filter Sep
  have hA : A.Nonempty := ⟨∅, by simp [A, Sep]⟩
  obtain ⟨J, hJ, hmax⟩ := A.exists_max_image Finset.card hA
  obtain ⟨hJS, hsep⟩ := mem_filter.mp hJ
  change ∀ i ∈ J, ∀ j ∈ J, i ≠ j → d ≤ dist (x i) (x j) at hsep
  have hsub : J ⊆ S := mem_powerset.mp hJS
  refine ⟨J, hsub, hsep, ?_⟩
  intro i hi
  by_contra hn
  push Not at hn
  have hiJ : i ∉ J := by
    intro h
    have hdist := hn i h
    simp only [dist_self] at hdist
    linarith
  have hnew : insert i J ∈ A := by
    apply mem_filter.mpr
    refine ⟨mem_powerset.mpr (insert_subset hi hsub), ?_⟩
    change ∀ a ∈ insert i J, ∀ b ∈ insert i J, a ≠ b → d ≤ dist (x a) (x b)
    intro a ha b hb hab
    rcases mem_insert.mp ha with hai | haJ
    · subst a
      rcases mem_insert.mp hb with hbi | hbJ
      · exact False.elim (hab hbi.symm)
      · exact hn b hbJ
    · rcases mem_insert.mp hb with hbi | hbJ
      · simpa only [hbi, dist_comm] using hn a haJ
      · exact hsep a haJ b hbJ hab
  have hc := hmax (insert i J) hnew
  rw [card_insert_of_notMem hiJ] at hc
  omega

/-- Grid points may be moved to nearby witnesses before packing.  This handles
rational arcs meeting a phase set, rather than only grid points in the set. -/
theorem circle_separated_near_card_le {α : Type*} (S : Finset α)
    (g x : α → AddCircle (1 : ℝ)) {delta d e : ℝ}
    (hdelta : 0 < delta) (hdelta1 : delta ≤ 1)
    (hd : 0 < d) (hdhalf : d ≤ 1 / 2) (he : 0 ≤ e)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → delta ≤ dist (g i) (g j))
    (F : Set (AddCircle (1 : ℝ))) (hF : ∀ i ∈ S, x i ∈ F)
    (hnear : ∀ i ∈ S, dist (g i) (x i) ≤ e) :
    (S.card : ℝ) ≤ ((2 * (d + e) / delta + 1) / d) *
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
  classical
  obtain ⟨J, hJS, hJsep, hcover⟩ := exists_finite_separated_cover S x hd
  have hmeasure : (J.card : ℝ) * d ≤
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
    have h := circle_separated_balls_bound J x (r := d / 2) (by positivity) (by linarith)
      (by simpa only [mul_div_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0)] using hJsep)
      (E := circleClosedNeighborhood F d) (by
        intro j hj y hy
        refine ⟨x j, hF j (hJS hj), ?_⟩
        have hxy : dist (x j) y < d / 2 := by simpa only [mem_ball, dist_comm] using hy
        linarith)
    simpa only [mul_div_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0)] using h
  let B : α → Finset α := fun j ↦ S.filter (fun i ↦ dist (g i) (x j) ≤ d + e)
  have hsub : S ⊆ J.biUnion B := by
    intro i hi
    obtain ⟨j, hj, hij⟩ := hcover i hi
    apply mem_biUnion.mpr
    refine ⟨j, hj, mem_filter.mpr ⟨hi, ?_⟩⟩
    have htriangle := dist_triangle (g i) (x i) (x j)
    have hclose := hnear i hi
    linarith
  have hlocal (j : α) : ((B j).card : ℝ) ≤ 2 * (d + e) / delta + 1 := by
    apply circle_separated_card_in_ball_le (B j) g hdelta hdelta1 (by positivity)
      (fun i hi l hl hil ↦ hsep i (mem_filter.mp hi).1 l (mem_filter.mp hl).1 hil) (x j)
    intro i hi
    exact (mem_filter.mp hi).2
  have hcount : (S.card : ℝ) ≤ (J.card : ℝ) * (2 * (d + e) / delta + 1) := by
    calc
      _ ≤ ∑ j ∈ J, ((B j).card : ℝ) := by
        exact_mod_cast (card_le_card hsub).trans card_biUnion_le
      _ ≤ ∑ _j ∈ J, (2 * (d + e) / delta + 1) :=
        sum_le_sum (fun j _ ↦ hlocal j)
      _ = _ := by simp; ring
  have hC : 0 ≤ 2 * (d + e) / delta + 1 := by positivity
  have h1 := mul_le_mul_of_nonneg_right hcount hd.le
  have h2 := mul_le_mul_of_nonneg_left hmeasure hC
  have heq : (((2 * (d + e) / delta + 1) / d) *
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d)) * d =
        (2 * (d + e) / delta + 1) *
          AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
    field_simp
  nlinarith only [h1, h2, heq, hd]

theorem circleRationalGrid_near_card_neighborhood_le {q : ℕ} (hq : 0 < q)
    (S : Finset (Fin q)) {d : ℝ} (hd : 0 < d) (hdhalf : d ≤ 1 / 2)
    (F : Set (AddCircle (1 : ℝ)))
    (hnear : ∀ a ∈ S, ∃ x ∈ F, dist (circleRationalGridPoint q a) x ≤ 1 / (q : ℝ)) :
    (S.card : ℝ) ≤ (2 * (q : ℝ) + 3 / d) *
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
  classical
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  let x : Fin q → AddCircle (1 : ℝ) := fun a ↦
    if ha : a ∈ S then (hnear a ha).choose else 0
  have hx (a : Fin q) (ha : a ∈ S) :
      x a ∈ F ∧ dist (circleRationalGridPoint q a) (x a) ≤ 1 / (q : ℝ) := by
    simpa only [x, dif_pos ha] using (hnear a ha).choose_spec
  have h := circle_separated_near_card_le S (circleRationalGridPoint q) x
    (by positivity : 0 < 1 / (q : ℝ)) (by simpa using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1) hq1)
    hd hdhalf (by positivity : 0 ≤ 1 / (q : ℝ))
    (fun a _ b _ hab ↦ circleRationalGridPoint_separated hq a b hab)
    F (fun a ha ↦ (hx a ha).1) (fun a ha ↦ (hx a ha).2)
  have heq : (2 * (d + 1 / (q : ℝ)) / (1 / (q : ℝ)) + 1) / d =
      2 * (q : ℝ) + 3 / d := by field_simp; ring
  rwa [heq] at h

end Erdos859Verification

