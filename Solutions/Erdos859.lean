def finiteIntervalSupport {ι : Type*} (atom : ι → ℝ) (d : ℝ) : Set ℝ :=
  ⋃ i, Set.Icc (atom i) (atom i + d)

theorem isCompact_finiteIntervalSupport {ι : Type*} [Fintype ι]
    (atom : ι → ℝ) (d : ℝ) : IsCompact (finiteIntervalSupport atom d) :=
  isCompact_iUnion (fun _ ↦ isCompact_Icc)

