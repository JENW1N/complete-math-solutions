theorem coreArithmeticCoverage_eventually {eta C : ℝ}
    (heta : (501 / 500 : ℝ) * exp eta < 5 / 4) (hC : 100 ≤ C) (r₀ : ℕ) :
    ∀ᶠ s in atTop, ∀ T past core high : Finset ℕ,
      ∀ q : Fin (r₀ + corePairDepth s) → ℕ,
      T ⊆ coreGlobalPrimeUniverse s → past ⊆ coreBasePairUniverse C r₀ s →
      CorePastCertificate eta C r₀ s past core q →
      high ⊆ primeLogWindow (corePairHighStart C r₀ s q) (corePairHighEndpoint C r₀ s q) →
      high.card = corePhaseMarkCount (coreRateTotalLength s) →
      CoreHighPrimePhaseGood core (corePhaseParameter (coreRateTotalLength s))
        (coreHighWindowHorizon s (corePairHighStart C r₀ s q)) high →
      ∀ seed : ℕ, Nat.IsPractical seed → seed ≠ 0 →
        bernoulliSeedScale (coreRateTotalLength s) ≤ seed →
        Nat.Coprime seed (∏ p ∈ past ∪ high, p) →
        seed * (∏ p ∈ past ∪ high, p) ∣ ∏ p ∈ T, p →
        (C * corePairScale s / 4) /
          (8 * (coreMeshGap s + log 4) * (1 + coreGlobalLogHorizon (coreRateTotalLength s))) ≤
          primeTargetAverageObservable (coreGlobalTargetHorizon s) (fun t ↦ 1 / (t : ℝ)) T := by
  have hC0 : 0 ≤ C := by linarith
  filter_upwards [coreMeshGap_eventually_small, coreMesh_missing_eventually_lt hC0,
    coreMesh_divisor_budget_eventually hC r₀, coreMesh_target_horizon_eventually hC r₀,
    corePastCertificate_divisor_phase_localizes_eventually heta hC r₀,
    corePastCertificate_coefficient_cost_eventually r₀] with s hgap hmissing hbudget hhorizon hlocal hcost
  intro T past core high q hT hpast hcert hhigh hcard hgood seed hseed hseed0 hZseed hcop hdiv
  have hTprime : ∀ p ∈ T, p.Prime :=
    fun p hp ↦ coreGlobalPrimeUniverse_allprime s p (hT hp)
  have hprime : ∀ p ∈ past ∪ high, p.Prime := by
    intro p hp
    rcases mem_union.mp hp with hp | hp
    · exact coreBasePairUniverse_prime C r₀ s p (hpast hp)
    · exact (mem_primeLogWindow.mp (hhigh hp)).1
  have hn0 : (∏ p ∈ past ∪ high, p) ≠ 0 :=
    prod_ne_zero_iff.mpr (fun p hp ↦ (hprime p hp).ne_zero)
  have hq : ∀ i, q i ∈ corePairWindow C r₀ s i.val :=
    fun i ↦ (mem_inter.mp (hcert.selected i)).2
  have hne : high.Nonempty := card_pos.mp
    (by rw [hcard]; exact corePhaseMarkCount_pos (coreRateTotalLength_pos s))
  have hbasic := coreMesh_basic_bounds hC hgap
  have hY : (2 : ℝ) < bernoulliPhaseScale (coreRateTotalLength s) := by exact_mod_cast hbasic.1
  have hCX : 0 ≤ C * corePairScale s := mul_nonneg hC0 (corePairScale_pos s).le
  have hdiff :
      (corePairLocation r₀ s q + 3 * (C * corePairScale s) / 4) -
        (corePairLocation r₀ s q + C * corePairScale s / 2) = C * corePairScale s / 4 := by ring
  have hcoverage := smallHoles_primeTargetAverage_lower
    (T := T) (H := coreGlobalTargetHorizon s) (n := ∏ p ∈ past ∪ high, p)
    (seed := seed) (Z := bernoulliSeedScale (coreRateTotalLength s))
    hTprime hseed hseed0 hn0 hcop hZseed hdiv
    (A := corePairLocation r₀ s q + C * corePairScale s / 8)
    (B := corePairLocation r₀ s q + 7 * (C * corePairScale s) / 8)
    (a := corePairLocation r₀ s q + C * corePairScale s / 2)
    (b := corePairLocation r₀ s q + 3 * (C * corePairScale s) / 4)
    (d := corePairSupportThickness s) (h := coreMeshMargin s)
    (x₀ := log ((coreHighWindowHorizon s (corePairHighStart C r₀ s q) : ℝ) / 2))
    (Y := bernoulliPhaseScale (coreRateTotalLength s))
    (U := coreGlobalLogHorizon (coreRateTotalLength s))
    (corePairSupportThickness_nonneg s) (coreMeshMargin_pos s) hY
    ((hcert.rough_holes hprime).trans_lt hmissing)
    (by linarith) (by linarith)
    (by rw [hdiff]; exact hbasic.2.1)
    (coreMesh_start_margin hC q hgap) hbasic.2.2.1
    (fun r hr hrlo _ c _ _ hphase ↦
      hlocal past core high q hcert hhigh hne hgood r hr hrlo _ hphase)
    (fun r hr hrlo hrhi ↦ hcost eta C past core high q hcert hprime hcard.le r
      (Nat.pos_of_mem_divisors hr) (hbudget q hq r hrlo hrhi))
    (fun r _ hrlo hrhi ↦ (hhorizon q hq r hrlo hrhi).1)
    (fun r _ hrlo hrhi ↦ (hhorizon q hq r hrlo hrhi).2)
    ((by positivity : (0 : ℝ) ≤ 2 ^ coreRateTotalLength s).trans (coreGlobalLogHorizon_ge_pow s))
    (fun t ht ↦ (mem_coreGlobalTargetHorizon.mp ht).1)
    (fun t ht ↦ (mem_coreGlobalTargetHorizon.mp ht).2.2)
  simpa only [hdiff, coreMeshGap] using hcoverage

theorem coreArithmeticCoverage_exponential_eventually {eta C eps : ℝ}
    (heta : (501 / 500 : ℝ) * exp eta < 5 / 4) (hC : 100 ≤ C) (heps : 0 < eps) (r₀ : ℕ) :
    ∀ᶠ s in atTop, ∀ T past core high : Finset ℕ,
      ∀ q : Fin (r₀ + corePairDepth s) → ℕ,
      T ⊆ coreGlobalPrimeUniverse s → past ⊆ coreBasePairUniverse C r₀ s →
      CorePastCertificate eta C r₀ s past core q →
