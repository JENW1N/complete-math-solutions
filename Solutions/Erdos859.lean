/-- A closed interval is enlarged by one on its left to handle possible
prime atoms at the endpoint. The estimate is uniform in its location. -/
theorem primeLogWindow_interval_mass_upper {a b u h : ℝ}
    (ha : log 2 ≤ a) (hh : 0 ≤ h) :
    (∑ p ∈ (primeLogWindow a b).filter (fun p : ℕ ↦ u ≤ log (p : ℝ) ∧ log (p : ℝ) ≤ u + h),
      1 / (p : ℝ)) ≤ (h + 1 + 2 * mertensErrorConstant) / a := by
  classical
  let Q := (primeLogWindow a b).filter (fun p : ℕ ↦ u ≤ log (p : ℝ) ∧ log (p : ℝ) ≤ u + h)
  change (∑ p ∈ Q, 1 / (p : ℝ)) ≤ _
  have ha0 : 0 < a := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha
  have hnum : 0 ≤ h + 1 + 2 * mertensErrorConstant := by positivity [mertensErrorConstant_pos]
  by_cases hQ : Q.Nonempty
