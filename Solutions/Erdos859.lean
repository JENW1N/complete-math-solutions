    by_cases heq : log (p : ℝ) = a
    · simp [heq, hab]
    · by_cases hi : a < log (p : ℝ) ∧ log (p : ℝ) ≤ b
      · simp [heq, hi, hi.1.le]
      · have hn : ¬(a ≤ log (p : ℝ) ∧ log (p : ℝ) ≤ b) := by
          intro hh
          exact hi ⟨lt_of_le_of_ne hh.1 (Ne.symm heq), hh.2⟩
