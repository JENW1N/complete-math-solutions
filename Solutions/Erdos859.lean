    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hp : p.Prime) :
    1 / (p : ℝ) ≤ primeLogOddsIntensity lam p ∧
      primeLogOddsIntensity lam p ≤ 4 / (p : ℝ) := by
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp0 : (0 : ℝ) < p := by linarith
  have hden : 0 < (p : ℝ) - 1 := by linarith
  have hx : 0 < 1 + lam / ((p : ℝ) - 1) := by positivity
