noncomputable def primeOddsWeight (T : Finset ℕ) : ℝ :=
  ∏ p ∈ T, 1 / ((p : ℝ) - 1)

theorem primePatternWeight_eq_empty_mul_odds {P T : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hT : T ⊆ P) :
    primePatternWeight P T = primePatternWeight P ∅ * primeOddsWeight T := by
  classical
  have hfilter : P.filter (fun p ↦ p ∈ T) = T := by
    ext p
    simp only [mem_filter]
    exact and_iff_right_of_imp (fun hp ↦ hT hp)
  have hprod : (∏ p ∈ P, if p ∈ T then 1 / ((p : ℝ) - 1) else 1) = primeOddsWeight T := by
    rw [prod_ite]
    simp only [hfilter, prod_const_one, mul_one, primeOddsWeight]
  rw [← hprod]
  unfold primePatternWeight
  simp only [Finset.notMem_empty, if_false]
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro p hp
  have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast (hP p hp).ne_zero
  have hp1 : (p : ℝ) - 1 ≠ 0 := by
    have h := (hP p hp).one_lt
    exact sub_ne_zero.mpr (by exact_mod_cast Nat.ne_of_gt h)
  by_cases hpt : p ∈ T
  · simp only [if_pos hpt]
    field_simp
  · simp only [if_neg hpt, mul_one]

theorem primeTiltWeight_fixedCard_factorization {P T : Finset ℕ} {n : ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hT : T ⊆ P) (hcard : T.card = n) (lam : ℝ) :
    primeTiltWeight P lam T =
      (primePatternWeight P ∅ * lam ^ n / primeTiltNormalizer P lam) * primeOddsWeight T := by
  rw [primeTiltWeight, primePatternWeight_eq_empty_mul_odds hP hT, hcard]
  ring

/-- Conditioning on the number of selected primes removes the tilt
parameter exactly. No iid assertion is made about the conditioned law. -/
theorem primeTilt_fixedCard_expectation_eq_odds {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (n : ℕ) (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T) =
      (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeOddsWeight T * F T) /
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeOddsWeight T) := by
  classical
  let K := primePatternWeight P ∅ * lam ^ n / primeTiltNormalizer P lam
  have hK : 0 < K := div_pos (mul_pos (primePatternWeight_pos hP ∅) (pow_pos hlam n))
    (primeTiltNormalizer_pos hP hlam)
  have hw : ∀ T ∈ P.powerset.filter (fun T ↦ T.card = n),
      primeTiltWeight P lam T = K * primeOddsWeight T := by
    intro T hT
    exact primeTiltWeight_fixedCard_factorization hP
      (mem_powerset.mp (mem_filter.mp hT).1) (mem_filter.mp hT).2 lam
  have hnum : (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T) =
      K * (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeOddsWeight T * F T) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro T hT
    rw [hw T hT, mul_assoc]
  have hden : (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T) =
      K * (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeOddsWeight T) := by
    rw [mul_sum]
    exact sum_congr rfl hw
  rw [hnum, hden, mul_div_mul_left _ _ hK.ne']

theorem log_prime_odds_ratio_le {p : ℕ} (hp : p.Prime) :
    log ((p : ℝ) / ((p : ℝ) - 1)) ≤ 2 / (p : ℝ) := by
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp0 : (0 : ℝ) < p := by linarith
  have hd : 0 < (p : ℝ) - 1 := by linarith
  have h := log_le_sub_one_of_pos (div_pos hp0 hd)
  have heq : (p : ℝ) / ((p : ℝ) - 1) - 1 = 1 / ((p : ℝ) - 1) := by field_simp; ring
  rw [heq] at h
  exact h.trans ((div_le_div_iff₀ hd hp0).mpr (by linarith))

/-- The density ratio between reciprocal odds and reciprocal weights is
close to one when all selected primes are large. -/
theorem prime_odds_ratio_bounds {T : Finset ℕ} {a : ℝ}
    (hT : ∀ p ∈ T, p.Prime) (hlarge : ∀ p ∈ T, a ≤ log (p : ℝ)) :
    1 ≤ (∏ p ∈ T, (p : ℝ) / ((p : ℝ) - 1)) ∧
      (∏ p ∈ T, (p : ℝ) / ((p : ℝ) - 1)) ≤ exp (2 * (T.card : ℝ) * exp (-a)) := by
  have hp0 (p : ℕ) (hp : p ∈ T) : (0 : ℝ) < p := by exact_mod_cast (hT p hp).pos
  have hd (p : ℕ) (hp : p ∈ T) : 0 < (p : ℝ) - 1 := by
    have h : (1 : ℝ) < p := by exact_mod_cast (hT p hp).one_lt
    linarith
  refine ⟨one_le_prod (fun p hp ↦ (one_le_div (hd p hp)).mpr (by linarith)), ?_⟩
  apply (log_le_iff_le_exp (prod_pos fun p hp ↦ div_pos (hp0 p hp) (hd p hp))).mp
  rw [log_prod (fun p hp ↦ (div_pos (hp0 p hp) (hd p hp)).ne')]
  calc
    _ ≤ ∑ _p ∈ T, 2 * exp (-a) := by
      apply sum_le_sum
      intro p hp
      have hrecip : 1 / (p : ℝ) ≤ exp (-a) := by
        rw [exp_neg, ← one_div]
        exact one_div_le_one_div_of_le (exp_pos a) ((le_log_iff_exp_le (hp0 p hp)).mp (hlarge p hp))
      calc
        _ ≤ 2 / (p : ℝ) := log_prime_odds_ratio_le (hT p hp)
        _ = 2 * (1 / (p : ℝ)) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left hrecip (by norm_num)
    _ = _ := by simp; ring

end Erdos859Verification

