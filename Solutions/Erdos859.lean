noncomputable def coreGlobalBallotMain (lam : ℝ) (k : ℕ) : ℝ :=
  exp (-(k : ℝ) * coreGlobalBallotRate lam - coreBallotError lam k) /
    (exp 1 * (k : ℝ) ^ 2)

noncomputable def coreGlobalBallotDuplicateError (k : ℕ) : ℝ :=
