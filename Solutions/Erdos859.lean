theorem coreBallotScale_pos (k : ℕ) : 0 < coreBallotScale k := by
  unfold coreBallotScale
  positivity

theorem coreBallotScale_ge_nat (k : ℕ) : (k : ℝ) ≤ coreBallotScale k := by
  unfold coreBallotScale
