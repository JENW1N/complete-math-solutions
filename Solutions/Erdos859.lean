  have hk : (1 : ℝ) ≤ coreRateTotalLength s := by exact_mod_cast coreRateTotalLength_pos s
  have hk0 : (0 : ℝ) < coreRateTotalLength s := by linarith
  have hk3 : 1 ≤ (coreRateTotalLength s : ℝ) ^ 3 := one_le_pow₀ hk
  have hX := corePairScale_pos s
  have hX1 : 1 ≤ corePairScale s :=
    (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)).trans (corePairScale_lower s)
  have hlog : 0 < log (4 : ℝ) := log_pos (by norm_num)
  have hloghi : log (4 : ℝ) ≤ 3 := by
    have h := log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 4)
    norm_num at h
    exact h
  have hstep : coreMeshGap s + log 4 ≤ 4 * (coreRateTotalLength s : ℝ) ^ 3 := by nlinarith
  have hstep0 := add_pos (coreMeshGap_pos s) hlog
  have hH : 1 + coreGlobalLogHorizon (coreRateTotalLength s) ≤
      2 * (coreRateTotalLength s : ℝ) ^ 3 * corePairScale s := by
    change 1 + (coreRateTotalLength s : ℝ) ^ 3 * corePairScale s ≤ _
    nlinarith
  have hH0 : 0 < 1 + coreGlobalLogHorizon (coreRateTotalLength s) := by
    change 0 < 1 + (coreRateTotalLength s : ℝ) ^ 3 * corePairScale s
    positivity
  have hden : 8 * (coreMeshGap s + log 4) * (1 + coreGlobalLogHorizon (coreRateTotalLength s)) ≤
      64 * (coreRateTotalLength s : ℝ) ^ 6 * corePairScale s := by
    calc
      _ ≤ 8 * (4 * (coreRateTotalLength s : ℝ) ^ 3) *
          (2 * (coreRateTotalLength s : ℝ) ^ 3 * corePairScale s) := by gcongr
      _ = _ := by ring
  have hden0 : 0 < 8 * (coreMeshGap s + log 4) *
      (1 + coreGlobalLogHorizon (coreRateTotalLength s)) := by positivity
  calc
    _ = (corePairScale s / 4) / (64 * (coreRateTotalLength s : ℝ) ^ 6 * corePairScale s) := by
      field_simp [hk0.ne', hX.ne']
      norm_num
    _ ≤ (corePairScale s / 4) /
        (8 * (coreMeshGap s + log 4) * (1 + coreGlobalLogHorizon (coreRateTotalLength s))) :=
      div_le_div_of_nonneg_left (by positivity) hden0 hden
    _ ≤ _ := by
      unfold coreMeshHarmonicFactor
      apply div_le_div_of_nonneg_right _ hden0.le
      nlinarith

theorem coreMesh_polynomial_cost_eventually {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ s in atTop, exp (-eps * (coreRateTotalLength s : ℝ)) ≤
      1 / (256 * (coreRateTotalLength s : ℝ) ^ 6) := by
  have hlog := isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp coreRateTotalLength_real_tendsto
  have hconst := coreRateTotalLength_real_tendsto.const_div_atTop (log (256 : ℝ))
  have hlim := hconst.add (hlog.const_mul 6)
  simp only [mul_zero, add_zero] at hlim
  filter_upwards [hlim.eventually_lt_const heps] with s hs
  have hk : (0 : ℝ) < coreRateTotalLength s := by exact_mod_cast coreRateTotalLength_pos s
  have h : log (256 : ℝ) + 6 * log (coreRateTotalLength s : ℝ) <
      eps * (coreRateTotalLength s : ℝ) := by
    apply (div_lt_iff₀ hk).mp
    simpa only [Function.comp_def, id_eq, add_div, mul_div_assoc] using hs
  apply (le_log_iff_exp_le (by positivity : (0 : ℝ) < 1 / (256 * (coreRateTotalLength s : ℝ) ^ 6))).mp
  rw [one_div, log_inv, log_mul (by norm_num : (256 : ℝ) ≠ 0) (by positivity), log_pow]
  norm_num only [Nat.cast_ofNat]
  linarith

theorem coreMeshHarmonicFactor_eventually_exponential_lower {C eps : ℝ}
    (hC : 100 ≤ C) (heps : 0 < eps) :
    ∀ᶠ s in atTop, exp (-eps * (coreRateTotalLength s : ℝ)) ≤ coreMeshHarmonicFactor C s := by
  filter_upwards [coreMeshGap_eventually_small, coreMesh_polynomial_cost_eventually heps] with s hg hs
  exact hs.trans (coreMeshHarmonicFactor_polynomial_lower hC hg)

end Erdos859Verification

