theorem finiteRealAtomWeight_nonneg {ι : Type*} {P : Finset ι} {a : ι → ℝ}
    (ha : ∀ i ∈ P, 0 ≤ a i) (f : ι → ℝ) (x : ℝ) :
    0 ≤ finiteRealAtomWeight P a f x :=
  sum_nonneg (fun i hi ↦ ha i (Finset.mem_filter.mp hi).1)

theorem sum_finiteRealAtomWeight {ι : Type*} (P : Finset ι) (a : ι → ℝ) (f : ι → ℝ) :
    (∑ x ∈ P.image f, finiteRealAtomWeight P a f x) = ∑ i ∈ P, a i := by
  classical
  exact sum_fiberwise_of_maps_to (fun i hi ↦ mem_image_of_mem f hi) a

theorem finiteRealAtomWeight_cdf {ι : Type*} (P : Finset ι) (a : ι → ℝ) (f : ι → ℝ) (v : ℝ) :
    finiteMarkCDF (P.image f) (finiteRealAtomWeight P a f) v =
      ∑ i ∈ P.filter (fun i ↦ f i ≤ v), a i := by
