theorem primeSubsetSumSupport_insert_cover (T : Finset ℕ) (p : ℕ) (d : ℝ) :
    primeSubsetSumSupport (insert p T) d ⊆
      primeSubsetSumSupport T d ∪
        (fun x : ℝ ↦ log (p : ℝ) + x) '' primeSubsetSumSupport T d := by
  intro y hy
  obtain ⟨U, hU, hy⟩ := mem_primeSubsetSumSupport.mp hy
  by_cases hp : p ∈ U
  · right
    have herase : U.erase p ⊆ T := by
      intro q hq
      have hqp := (mem_erase.mp hq).1
      exact (mem_insert.mp (hU (mem_erase.mp hq).2)).resolve_left hqp
    have hsum := sum_erase_add U (fun q ↦ log (q : ℝ)) hp
    refine ⟨y - log (p : ℝ), mem_primeSubsetSumSupport.mpr ⟨U.erase p, herase, ?_⟩,
      by ring⟩
    exact ⟨by linarith [hy.1], by linarith [hy.2]⟩
  · left
    exact mem_primeSubsetSumSupport.mpr ⟨U,
      fun q hq ↦ (mem_insert.mp (hU hq)).resolve_left (by
        intro hqp
        subst q
        exact hp hq), hy⟩

theorem primeSubsetSumSupport_measure_insert_le (T : Finset ℕ) (p : ℕ) (d : ℝ) :
    volume.real (primeSubsetSumSupport (insert p T) d) ≤
      2 * volume.real (primeSubsetSumSupport T d) := by
  have hcompact : IsCompact (primeSubsetSumSupport T d ∪
      (fun x : ℝ ↦ log (p : ℝ) + x) '' primeSubsetSumSupport T d) :=
    (isCompact_primeSubsetSumSupport T d).union
    ((isCompact_primeSubsetSumSupport T d).image
      (continuous_const.add continuous_id))
  have htranslate : volume.real
      ((fun x : ℝ ↦ log (p : ℝ) + x) '' primeSubsetSumSupport T d) =
      volume.real (primeSubsetSumSupport T d) := by
    simp only [Measure.real, Set.image_add_left, measure_preimage_add]
  calc
    _ ≤ volume.real (primeSubsetSumSupport T d ∪
        (fun x : ℝ ↦ log (p : ℝ) + x) '' primeSubsetSumSupport T d) :=
      measureReal_mono (primeSubsetSumSupport_insert_cover T p d) hcompact.measure_ne_top
    _ ≤ volume.real (primeSubsetSumSupport T d) + volume.real
        ((fun x : ℝ ↦ log (p : ℝ) + x) '' primeSubsetSumSupport T d) :=
      measureReal_union_le _ _
    _ = _ := by rw [htranslate]; ring

