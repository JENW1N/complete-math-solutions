/- Inlined development module: PrimePowerfulAggregation.lean -/

section

/- Finite powerful-part aggregation for actual capped-state divisor events. -/

namespace Erdos859Verification

open Finset
open scoped Classical

noncomputable def finiteRadicalEventMass (P : Finset ℕ) (y : ℝ) : ℝ :=
  ∑ T∈P.powerset.filter (FordRadicalDivisorEvent y),primePatternWeight P T

noncomputable def fordDivisorRadicalObservable (B : ℕ) (y : ℝ) (T : Finset ℕ) : ℝ :=
  ∑ f∈B.divisors,if FordRadicalDivisorEvent (y/(f:ℝ)) T then 1 else 0

theorem fordRadicalIndicator_monotone (y : ℝ) :
    Monotone (fun T : Finset ℕ ↦ if FordRadicalDivisorEvent y T then (1:ℝ) else 0) := by
  intro S T hST
  dsimp only
  by_cases hS : FordRadicalDivisorEvent y S
  · obtain ⟨U,hUS,hlo,hhi⟩ := hS
    have hT : FordRadicalDivisorEvent y T := ⟨U,hUS.trans hST,hlo,hhi⟩
    rw [if_pos (show FordRadicalDivisorEvent y S from ⟨U,hUS,hlo,hhi⟩), if_pos hT]
  · simp only [if_neg hS]
    split_ifs <;> norm_num

theorem fordDivisorRadicalObservable_nonneg (B : ℕ) (y : ℝ) (T : Finset ℕ) :
    0 ≤ fordDivisorRadicalObservable B y T :=
  sum_nonneg (fun _ _ ↦ by split_ifs <;> norm_num)

theorem fordDivisorRadicalObservable_monotone (B : ℕ) (y : ℝ) :
    Monotone (fordDivisorRadicalObservable B y) := by
  intro S T hST
  exact sum_le_sum (fun f _ ↦ fordRadicalIndicator_monotone (y/(f:ℝ)) hST)

theorem prime_expectation_divisorRadicalObservable (P : Finset ℕ) (B : ℕ) (y : ℝ) :
    (∑ T∈P.powerset,primePatternWeight P T * fordDivisorRadicalObservable B y T) =
      ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ)) := by
  simp only [fordDivisorRadicalObservable, mul_sum]
  rw [sum_comm]
  simp only [finiteRadicalEventMass, sum_filter, mul_ite, mul_one, mul_zero]

theorem cappedPowerfulFiber_divisor_event_le {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p)
    {B : ℕ} (hB : B∈cappedPowerfulValues P cap) (y : ℝ) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦ cappedStatePowerfulPart P cap e=B),
      if FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)
        then cappedPrimeStateWeight P cap e else 0) ≤
      (1/(B:ℝ)) * ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ)) := by
  calc
    _ ≤ ∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦ cappedStatePowerfulPart P cap e=B),
        cappedPrimeStateWeight P cap e * fordDivisorRadicalObservable B y (cappedStateSingletons P cap e) := by
      apply sum_le_sum
      intro e he
      by_cases hE : FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)
      · rw [if_pos hE]
        obtain ⟨f,hf,hgood⟩ := cappedState_powerful_divisor_split hP cap e hE
        rw [(mem_filter.mp he).2] at hf
        have hobs : 1 ≤ fordDivisorRadicalObservable B y (cappedStateSingletons P cap e) := by
          have h := single_le_sum
            (f := fun f : ℕ ↦ if FordRadicalDivisorEvent (y/(f:ℝ)) (cappedStateSingletons P cap e) then (1:ℝ) else 0)
            (fun _ _ ↦ by split_ifs <;> norm_num) hf
          simpa only [fordDivisorRadicalObservable, if_pos hgood] using h
        simpa only [mul_one] using mul_le_mul_of_nonneg_left hobs (cappedPrimeStateWeight_nonneg hP cap e)
      · rw [if_neg hE]
        exact mul_nonneg (cappedPrimeStateWeight_nonneg hP cap e)
          (fordDivisorRadicalObservable_nonneg _ _ _)
    _ ≤ (1/(B:ℝ)) * ∑ T∈P.powerset,primePatternWeight P T * fordDivisorRadicalObservable B y T :=
      cappedPowerfulFiber_expectation_le hP cap hcap hB _
        (fordDivisorRadicalObservable_monotone B y) (fordDivisorRadicalObservable_nonneg B y)
    _ = _ := by rw [prime_expectation_divisorRadicalObservable]

theorem cappedState_divisor_event_mass_le {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p) (y : ℝ) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦
      FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)),cappedPrimeStateWeight P cap e) ≤
      ∑ B∈cappedPowerfulValues P cap, (1/(B:ℝ)) *
        ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ)) := by
  rw [sum_filter]
  rw [← sum_fiberwise_of_maps_to
    (fun e (_ : e∈(univ : Finset (CappedPrimeState P cap))) ↦
      show cappedStatePowerfulPart P cap e∈cappedPowerfulValues P cap from mem_image.mpr ⟨e,mem_univ _,rfl⟩)]
  exact sum_le_sum (fun B hB ↦ cappedPowerfulFiber_divisor_event_le hP cap hcap hB y)

/-- Large powerful parts use total fiber mass, avoiding a divisor-count
factor in the tail. -/
theorem cappedState_divisor_event_mass_truncated {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p) (y L : ℝ) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦
      FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)),cappedPrimeStateWeight P cap e) ≤
      (∑ B∈(cappedPowerfulValues P cap).filter (fun B : ℕ ↦ (B:ℝ)≤L),
        (1/(B:ℝ)) * ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ))) +
      ∑ B∈(cappedPowerfulValues P cap).filter (fun B : ℕ ↦ L<(B:ℝ)),1/(B:ℝ) := by
  rw [sum_filter]
  rw [← sum_fiberwise_of_maps_to
    (fun e (_ : e∈(univ : Finset (CappedPrimeState P cap))) ↦
      show cappedStatePowerfulPart P cap e∈cappedPowerfulValues P cap from mem_image.mpr ⟨e,mem_univ _,rfl⟩)]
  calc
    _ ≤ ∑ B∈cappedPowerfulValues P cap,
        if (B:ℝ)≤L then (1/(B:ℝ))*∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ))
        else 1/(B:ℝ) := by
      apply sum_le_sum
      intro B hB
      by_cases hsmall : (B:ℝ)≤L
      · rw [if_pos hsmall]
        exact cappedPowerfulFiber_divisor_event_le hP cap hcap hB y
      · rw [if_neg hsmall]
        apply le_trans _ (cappedPowerfulFiber_mass_le hP cap hcap hB)
        exact sum_le_sum (fun e _ ↦ by
          split_ifs
          · rfl
          · exact cappedPrimeStateWeight_nonneg hP cap e)
    _ = _ := by
      simp only [sum_filter, ←sum_add_distrib]
      apply sum_congr rfl
      intro B _
      by_cases hsmall : (B:ℝ)≤L
      · simp [hsmall, not_lt_of_ge hsmall]
      · simp [hsmall, lt_of_not_ge hsmall]

theorem cappedState_divisor_event_mass_truncated_tail {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p)
    (y : ℝ) {L : ℝ} (hL : 0<L) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦
      FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)),cappedPrimeStateWeight P cap e) ≤
      (∑ B∈(cappedPowerfulValues P cap).filter (fun B : ℕ ↦ (B:ℝ)≤L),
        (1/(B:ℝ)) * ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ))) +
      fordPowerfulTailConstant / L ^ (1/4:ℝ) :=
  (cappedState_divisor_event_mass_truncated hP cap hcap y L).trans
    (add_le_add_right (ford_powerful_reciprocal_tail_sum_le _ hL
      (cappedPowerfulValues_powerful hP cap)) _)


end Erdos859Verification

