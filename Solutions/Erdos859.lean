  · intro b
    simp only [fairBitDifference_self, zero_mul, sum_const_zero, abs_zero, if_pos hh,
      mul_one]
    exact (sum_finiteProductWeight w hnorm).le
  · intro b b' j hdiff _hagree
    obtain ⟨i, hi, hne⟩ := hdiff
    have hbound := finite_product_sum_smallBall w mark
      (fun k ↦ fairBitDifference (b k) (b' k)) i h (c (band i)) 0
      hw hnorm (fairBitDifference_sign hne) (hsmall i)
    simpa only [sub_zero, hi] using hbound

