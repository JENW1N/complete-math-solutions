      ∑ p ∈ virtualPrimeBand A B j, primeLogOddsIntensity lam p := by
    unfold primeNormalizedLogOddsWindowMass virtualPrimeBand
    rw [mul_sum]
    apply sum_congr rfl
    intro p _
    field_simp
  rw [he] at hm
  simpa only [mul_assoc] using hm

