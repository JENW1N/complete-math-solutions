  intro n m h
  apply Subtype.ext
  have h1 := congrArg Prod.fst h
  have h2 := congrArg Prod.snd h
  change fordPowerfulSquare n.val = fordPowerfulSquare m.val at h1
  change fordPowerfulCube n.val = fordPowerfulCube m.val at h2
