theorem prime_tilt_adaptive_window_expectation {P A : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hA : A ⊆ P) {lam : ℝ} (hlam : 0 < lam)
    (Q : Finset ℕ → Finset ℕ) (hQ : ∀ S ⊆ A, Q S ⊆ P \ A)
    (F : Finset ℕ → Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * F (T ∩ A) (T ∩ Q (T ∩ A))) =
      ∑ S ∈ A.powerset, primeTiltWeight A lam S *
        ∑ U ∈ (Q S).powerset, primeTiltWeight (Q S) lam U * F S U := by
  have hinter (T : Finset ℕ) : T ∩ Q (T ∩ A) = (T \ A) ∩ Q (T ∩ A) := by
    ext p
    constructor
    · intro hp
      obtain ⟨hpT, hpQ⟩ := mem_inter.mp hp
      have hpA := (mem_sdiff.mp (hQ _ inter_subset_right hpQ)).2
      exact mem_inter.mpr ⟨mem_sdiff.mpr ⟨hpT, hpA⟩, hpQ⟩
    · intro hp
      obtain ⟨hpT, hpQ⟩ := mem_inter.mp hp
      exact mem_inter.mpr ⟨(mem_sdiff.mp hpT).1, hpQ⟩
  calc
    _ = ∑ T ∈ P.powerset,
        primeTiltWeight A lam (T ∩ A) * primeTiltWeight (P \ A) lam (T \ A) *
          F (T ∩ A) ((T \ A) ∩ Q (T ∩ A)) := by
      apply sum_congr rfl
      intro T _
      rw [primeTiltWeight_split_universe hA, hinter T]
    _ = ∑ S ∈ A.powerset, ∑ V ∈ (P \ A).powerset,
        primeTiltWeight A lam S * primeTiltWeight (P \ A) lam V * F S (V ∩ Q S) :=
      sum_powerset_split_subset hA
        (fun S V ↦ primeTiltWeight A lam S * primeTiltWeight (P \ A) lam V * F S (V ∩ Q S))
    _ = _ := by
      apply sum_congr rfl
      intro S hS
      rw [show (∑ V ∈ (P \ A).powerset,
          primeTiltWeight A lam S * primeTiltWeight (P \ A) lam V * F S (V ∩ Q S)) =
          primeTiltWeight A lam S * ∑ V ∈ (P \ A).powerset,
            primeTiltWeight (P \ A) lam V * F S (V ∩ Q S) by
        simp only [mul_sum, mul_assoc]]
      rw [prime_tilt_expectation_restrict (fun p hp ↦ hP p (mem_sdiff.mp hp).1)
        (hQ S (mem_powerset.mp hS)) hlam]

/-- Choosing the next window after seeing the past costs no independence
factor: its variables are fresh, and the exact conditional law is unchanged. -/
theorem prime_tilt_adaptive_window_event_lower {P A : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hA : A ⊆ P) {lam : ℝ} (hlam : 0 < lam)
    (Q : Finset ℕ → Finset ℕ) (hQ : ∀ S ⊆ A, Q S ⊆ P \ A)
    (Good : Finset ℕ → Prop) (Step : Finset ℕ → Finset ℕ → Prop) {c : ℝ}
    (hstep : ∀ S ⊆ A, Good S →
      c ≤ ∑ U ∈ (Q S).powerset.filter (Step S), primeTiltWeight (Q S) lam U) :
    c * (∑ S ∈ A.powerset.filter Good, primeTiltWeight A lam S) ≤
      ∑ T ∈ P.powerset.filter (fun T ↦ Good (T ∩ A) ∧ Step (T ∩ A) (T ∩ Q (T ∩ A))),
        primeTiltWeight P lam T := by
  have heq := prime_tilt_adaptive_window_expectation hP hA hlam Q hQ
    (fun S U ↦ if Good S ∧ Step S U then 1 else 0)
  simp only [mul_ite, mul_one, mul_zero, ← sum_filter] at heq
  rw [heq, sum_filter, mul_sum]
  apply sum_le_sum
  intro S hS
  have hSsub := mem_powerset.mp hS
  by_cases hg : Good S
  · simp only [hg, true_and, if_true]
    simpa only [mul_comm] using mul_le_mul_of_nonneg_left (hstep S hSsub hg)
      (primeTiltWeight_pos (fun p hp ↦ hP p (hA hp)) hlam S).le
  · simp only [hg, false_and, filter_false, sum_empty, if_false, mul_zero, le_refl]

theorem prime_tilt_adaptive_success_lower {P A : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hA : A ⊆ P) {lam : ℝ} (hlam : 0 < lam)
    (Q : Finset ℕ → Finset ℕ) (hQ : ∀ S ⊆ A, Q S ⊆ P \ A)
    (Good : Finset ℕ → Prop) (Step : Finset ℕ → Finset ℕ → Prop)
    (Success : Finset ℕ → Prop) {c : ℝ}
    (hstep : ∀ S ⊆ A, Good S →
      c ≤ ∑ U ∈ (Q S).powerset.filter (Step S), primeTiltWeight (Q S) lam U)
    (himp : ∀ T ⊆ P, Good (T ∩ A) → Step (T ∩ A) (T ∩ Q (T ∩ A)) → Success T) :
    c * (∑ S ∈ A.powerset.filter Good, primeTiltWeight A lam S) ≤
      ∑ T ∈ P.powerset.filter Success, primeTiltWeight P lam T := by
  apply (prime_tilt_adaptive_window_event_lower hP hA hlam Q hQ Good Step hstep).trans
  apply sum_le_sum_of_subset_of_nonneg
  · intro T hT
    obtain ⟨hT, hgood, hnext⟩ := mem_filter.mp hT
    exact mem_filter.mpr ⟨hT, himp T (mem_powerset.mp hT) hgood hnext⟩
  · intro T _ _
    exact (primeTiltWeight_pos hP hlam T).le

