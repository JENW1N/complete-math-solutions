section

/- Lower bounds for the actual tilted subset law from independent finite marks.

The log-odds intensities are subweights of the reciprocal odds.  Distinct ordered
marks therefore give an exact factorial-counting lower bound, without asserting
that conditioning a Bernoulli subset on its cardinality makes its points iid.
-/

namespace Erdos859Verification

open Finset Real

theorem normalized_injective_tuple_sum {α : Type*} [DecidableEq α]
    (P : Finset α) (n : ℕ) (w : α → ℝ) (F : Finset α → ℝ)
    {M : ℝ} (hM : M ≠ 0) :
    M ^ n / (n.factorial : ℝ) *
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, w (x i).val / M) * F (tupleSupport x)) =
      ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n),
        (∏ p ∈ T, w p) * F T := by
  have ht (x : Fin n → P) : (∏ i, w (x i).val / M) =
      (∏ i, w (x i).val) / M ^ n := by
    rw [prod_div_distrib]
    simp
  simp_rw [ht, div_mul_eq_mul_div]
  rw [← sum_div, sum_injective_tuple_product]
  have hf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  field_simp

theorem primeTiltWeight_empty_eq_exp_neg_intensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    primeTiltWeight P lam ∅ = exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) := by
  have hp0 (p : ℕ) (hp : p ∈ P) : (p : ℝ) ≠ 0 := by
    exact_mod_cast (hP p hp).ne_zero
  have hd (p : ℕ) (hp : p ∈ P) : 0 < (p : ℝ) - 1 := by
    have h : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    linarith
  have hx (p : ℕ) (hp : p ∈ P) : 0 < 1 + lam / ((p : ℝ) - 1) := by
    exact add_pos_of_pos_of_nonneg zero_lt_one (div_nonneg hlam.le (hd p hp).le)
  unfold primeTiltWeight primePatternWeight primeTiltNormalizer
  simp only [Finset.notMem_empty, if_false, card_empty, pow_zero, mul_one]
  rw [← prod_div_distrib, exp_neg, exp_sum, ← prod_inv_distrib]
  apply prod_congr rfl
  intro p hp
  rw [primeLogOddsIntensity, exp_log (hx p hp)]
  have hd' := (hd p hp).ne'
  have hn : 1 + (lam - 1) / (p : ℝ) ≠ 0 := by
    have heq : 1 + (lam - 1) / (p : ℝ) =
        ((p : ℝ) - 1 + lam) / p := by field_simp [hp0 p hp]; ring
    rw [heq]
    exact (div_pos (by linarith [hd p hp]) (by exact_mod_cast (hP p hp).pos)).ne'
  rw [← one_div]
  apply (div_eq_div_iff hn (hx p hp).ne').mpr
  field_simp [hp0 p hp, hd']
  ring

theorem primeTiltWeight_eq_empty_mul_tilted_odds {P T : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hT : T ⊆ P) (lam : ℝ) :
    primeTiltWeight P lam T =
      primeTiltWeight P lam ∅ * ∏ p ∈ T, lam / ((p : ℝ) - 1) := by
  rw [primeTiltWeight_fixedCard_factorization hP hT rfl]
  simp only [primeTiltWeight, card_empty, pow_zero, mul_one,
    primeOddsWeight, prod_div_distrib, prod_const, one_pow]
  ring

theorem primeTilt_count_lower_from_subweights {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (n : ℕ) (w : ℕ → ℝ) (F : Finset ℕ → ℝ)
    (hw : ∀ p ∈ P, 0 ≤ w p)
    (hodds : ∀ p ∈ P, w p ≤ lam / ((p : ℝ) - 1))
    (hF : ∀ T ∈ P.powerset.filter (fun T ↦ T.card = n), 0 ≤ F T)
    (hM : 0 < ∑ p ∈ P, w p) :
    exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
      (∑ p ∈ P, w p) ^ n / (n.factorial : ℝ) *
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, w (x i).val / (∑ p ∈ P, w p)) * F (tupleSupport x)) ≤
      ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T := by
  have heq := normalized_injective_tuple_sum P n w F hM.ne'
  calc
    _ = exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
        ((∑ p ∈ P, w p) ^ n / (n.factorial : ℝ) *
          (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
            (∏ i, w (x i).val / (∑ p ∈ P, w p)) * F (tupleSupport x))) := by ring
    _ = exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
        (∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), (∏ p ∈ T, w p) * F T) := by
      rw [heq]
    _ ≤ _ := by
      rw [mul_sum]
      apply sum_le_sum
      intro T hT
      have hTP := mem_powerset.mp (mem_filter.mp hT).1
      rw [primeTiltWeight_eq_empty_mul_tilted_odds hP hTP,
        primeTiltWeight_empty_eq_exp_neg_intensity hP hlam]
      rw [← mul_assoc]
      apply mul_le_mul_of_nonneg_right _ (hF T hT)
      apply mul_le_mul_of_nonneg_left _ (exp_pos _).le
      exact prod_le_prod (fun p hp ↦ hw p (hTP hp)) (fun p hp ↦ hodds p (hTP hp))

theorem primeLogOddsIntensity_le_odds {lam : ℝ} {p : ℕ}
    (hlam : 0 < lam) (hp : p.Prime) :
    0 ≤ primeLogOddsIntensity lam p ∧
      primeLogOddsIntensity lam p ≤ lam / ((p : ℝ) - 1) := by
  have hd : 0 < (p : ℝ) - 1 := by
    have h : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    linarith
  have hx : 0 < lam / ((p : ℝ) - 1) := div_pos hlam hd
  constructor
  · exact log_nonneg (by linarith)
  · have h := log_le_sub_one_of_pos (by linarith : 0 < 1 + lam / ((p : ℝ) - 1))
    simpa only [primeLogOddsIntensity, add_sub_cancel_left] using h

theorem primeTilt_count_lower_from_intensity_marks {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (n : ℕ) (F : Finset ℕ → ℝ)
    (hF : ∀ T ∈ P.powerset.filter (fun T ↦ T.card = n), 0 ≤ F T)
    (hM : 0 < ∑ p ∈ P, primeLogOddsIntensity lam p) :
    exp (-(∑ p ∈ P, primeLogOddsIntensity lam p)) *
      (∑ p ∈ P, primeLogOddsIntensity lam p) ^ n / (n.factorial : ℝ) *
      (∑ x ∈ univ.filter (Function.Injective : (Fin n → P) → Prop),
        (∏ i, primeLogOddsIntensity lam (x i).val /
          (∑ p ∈ P, primeLogOddsIntensity lam p)) * F (tupleSupport x)) ≤
      ∑ T ∈ P.powerset.filter (fun T ↦ T.card = n), primeTiltWeight P lam T * F T :=
  primeTilt_count_lower_from_subweights hP hlam n (primeLogOddsIntensity lam) F
    (fun p hp ↦ (primeLogOddsIntensity_le_odds hlam (hP p hp)).1)
    (fun p hp ↦ (primeLogOddsIntensity_le_odds hlam (hP p hp)).2) hF hM

end Erdos859Verification

