theorem tendsto_neg_log_div_of_polylog_lower {Z : ℕ → ℕ} {p : ℕ → ℝ}
    {c C : ℝ} (hc : 0 < c)
    (hZ : ∀ᶠ n in atTop, 210 < Z n)
    (hlower : ∀ᶠ n in atTop, c / (log (Z n : ℝ)) ^ C ≤ p n)
    (hupper : ∀ᶠ n in atTop, p n ≤ 1)
    (hscale : Tendsto (fun n : ℕ ↦ log (log (Z n : ℝ)) / n) atTop (𝓝 0)) :
    Tendsto (fun n : ℕ ↦ -log (p n) / n) atTop (𝓝 0) := by
  have hlim : Tendsto (fun n : ℕ ↦ -log c / n + C * (log (log (Z n : ℝ)) / n))
      atTop (𝓝 0) := by
    simpa using (tendsto_const_div_atTop_nhds_zero_nat (-log c)).add (hscale.const_mul C)
  have hbound : ∀ᶠ n in atTop, 0 ≤ -log (p n) / n ∧
      -log (p n) / n ≤ -log c / n + C * (log (log (Z n : ℝ)) / n) := by
    filter_upwards [hZ, hlower, hupper, eventually_gt_atTop 0] with n hnZ hlo hhi hn
    have hnR : (0 : ℝ) < n := by exact_mod_cast hn
    have hlog : 0 < log (Z n : ℝ) := by linarith [four_lt_log_of_gt_210 hnZ]
    have hden := rpow_pos_of_pos hlog C
    have hlowpos := div_pos hc hden
    have hp : 0 < p n := hlowpos.trans_le hlo
    have hloglow := (log_le_log_iff hlowpos hp).mpr hlo
    rw [log_div hc.ne' hden.ne', log_rpow hlog] at hloglow
    refine ⟨div_nonneg (neg_nonneg.mpr (log_nonpos hp.le hhi)) hnR.le, ?_⟩
    have hd := div_le_div_of_nonneg_right (neg_le_neg hloglow) hnR.le
    calc
      _ ≤ -(log c - C * log (log (Z n : ℝ))) / n := hd
      _ = -log c / n + C * (log (log (Z n : ℝ)) / n) := by ring
  exact squeeze_zero' (hbound.mono fun _ h ↦ h.1) (hbound.mono fun _ h ↦ h.2) hlim

noncomputable def practicalSeedTiltProbability (Z : ℕ) (P : Finset ℕ) (lam : ℝ) : ℝ :=
  ∑ T ∈ P.powerset, primeTiltWeight P lam T * practicalSeedIndicator Z T

theorem practicalSeedTiltProbability_le_one {P : Finset ℕ}
