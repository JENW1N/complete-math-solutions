  rw [inv_div, log_div hy.ne' hx.ne'] at hlog
  have hstep : q / y ≤ log y - log x := by
    calc
      q / y ≤ (y - x) / y := div_le_div_of_nonneg_right hgap hy.le
      _ = 1 - x / y := by field_simp
      _ ≤ log y - log x := hlog
  calc
    1 / y = (q / y) / q := by field_simp
    _ ≤ (log y - log x) / q := div_le_div_of_nonneg_right hstep hq.le

theorem sum_reciprocal_le_of_spacing (s : Finset ℕ) {L U q : ℝ}
    (hL : 0 < L) (hq : 0 < q) (hLU : L ≤ U)
    (hbound : ∀ n ∈ s, L ≤ (n : ℝ) ∧ (n : ℝ) ≤ U)
    (hgap : ∀ m ∈ s, ∀ n ∈ s, m < n → q ≤ (n : ℝ) - (m : ℝ)) :
    (∑ n ∈ s, 1 / (n : ℝ)) ≤ 1 / L + log (U / L) / q := by
