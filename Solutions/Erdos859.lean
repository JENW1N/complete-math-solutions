/- Uniform weak Mertens estimates for normalized logarithmic prime odds. -/

namespace Erdos859Verification

open Finset Real

/-- The normalized logarithmic intensity differs positively from `1 / p`. -/
theorem primeLogOddsIntensity_normalized_correction {lam : ℝ} {p : ℕ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hp : p.Prime) :
    0 ≤ primeLogOddsIntensity lam p / lam - 1 / (p : ℝ) ∧
      primeLogOddsIntensity lam p / lam - 1 / (p : ℝ) ≤
        1 / ((p : ℝ) * ((p : ℝ) - 1)) := by
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  have hp0 : (0 : ℝ) < p := by linarith
  have hd : 0 < (p : ℝ) - 1 := by linarith
  have hl : 0 < lam := by linarith
  have hsharp := le_log_one_add_of_nonneg (div_nonneg hl.le hd.le)
  have hden : 0 < 2 * (p : ℝ) + lam - 2 := by linarith
  have hid : 2 * (lam / ((p : ℝ) - 1)) /
      (lam / ((p : ℝ) - 1) + 2) = 2 * lam / (2 * (p : ℝ) + lam - 2) := by
    field_simp
    ring
  rw [hid] at hsharp
  have hlow : lam / (p : ℝ) ≤ primeLogOddsIntensity lam p := by
    apply le_trans _ hsharp
    apply (div_le_div_iff₀ hp0 hden).mpr
    nlinarith
  have hu : primeLogOddsIntensity lam p ≤ lam / ((p : ℝ) - 1) := by
    have h := log_le_sub_one_of_pos (by positivity : 0 < 1 + lam / ((p : ℝ) - 1))
    unfold primeLogOddsIntensity
    linarith
  constructor
  · apply sub_nonneg.mpr
    apply (le_div_iff₀ hl).mpr
    simpa only [one_div_mul_eq_div] using hlow
  · calc
      _ ≤ (lam / ((p : ℝ) - 1)) / lam - 1 / (p : ℝ) :=
        sub_le_sub_right (div_le_div_of_nonneg_right hu hl.le) _
      _ = _ := by field_simp; ring

/-- A nonnegative sequence bounded by the telescoping reciprocal kernel
has a quantitative finite tail estimate. -/
theorem sum_reciprocal_correction_tail_le {f : ℕ → ℝ}
    (hf : ∀ n, 2 ≤ n → f n ≤ 1 / ((n : ℝ) * ((n : ℝ) - 1)))
    {N : ℕ} (hN : 1 ≤ N) (m : ℕ) :
    (∑ n ∈ range m, f (n + (N + 1))) ≤
      1 / (N : ℝ) - 1 / ((N : ℝ) + m) := by
  induction m with
  | zero => simp
  | succ m ih =>
      rw [sum_range_succ]
      have hNm : 0 < (N : ℝ) + m := by exact_mod_cast (by omega : 0 < N + m)
      have hnext := hf (m + (N + 1)) (by omega)
      have hid : 1 / (((m + (N + 1) : ℕ) : ℝ) *
          (((m + (N + 1) : ℕ) : ℝ) - 1)) =
          1 / ((N : ℝ) + m) - 1 / ((N : ℝ) + (m + 1)) := by
        calc
          _ = 1 / (((N : ℝ) + m + 1) * ((N : ℝ) + m)) := by
            congr 1
            push_cast
            ring
          _ = _ := by
            field_simp [hNm.ne', (by linarith : (N : ℝ) + m + 1 ≠ 0)]
            ring
      rw [hid] at hnext
      push_cast
      linarith

theorem summable_reciprocal_correction {f : ℕ → ℝ} (hf0 : ∀ n, 0 ≤ f n)
    (hf : ∀ n, 2 ≤ n → f n ≤ 1 / ((n : ℝ) * ((n : ℝ) - 1))) :
    Summable f := by
  have hs : Summable (fun n ↦ f (n + 2)) := by
    apply summable_of_sum_range_le (c := 1) (fun n ↦ hf0 _)
    intro m
    have h := sum_reciprocal_correction_tail_le hf (N := 1) (by omega) m
    norm_num only [Nat.cast_one, one_div_one] at h
    exact h.trans (sub_le_self _ (by positivity))
  exact (summable_nat_add_iff 2).mp hs

theorem tsum_reciprocal_correction_tail_le {f : ℕ → ℝ} (hf0 : ∀ n, 0 ≤ f n)
    (hf : ∀ n, 2 ≤ n → f n ≤ 1 / ((n : ℝ) * ((n : ℝ) - 1)))
    {N : ℕ} (hN : 1 ≤ N) :
    (∑' n : ℕ, f (n + (N + 1))) ≤ 1 / (N : ℝ) := by
  apply Real.tsum_le_of_sum_range_le (fun n ↦ hf0 _)
  intro m
  exact (sum_reciprocal_correction_tail_le hf hN m).trans
    (sub_le_self _ (by positivity))

noncomputable def primeLogOddsCorrection (lam : ℝ) (p : ℕ) : ℝ :=
  if p.Prime then primeLogOddsIntensity lam p / lam - 1 / (p : ℝ) else 0

theorem primeLogOddsCorrection_bounds {lam : ℝ} (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) :
    (∀ p, 0 ≤ primeLogOddsCorrection lam p) ∧
      ∀ p, 2 ≤ p → primeLogOddsCorrection lam p ≤
        1 / ((p : ℝ) * ((p : ℝ) - 1)) := by
  constructor
  · intro p
    by_cases hp : p.Prime
    · simpa only [primeLogOddsCorrection, if_pos hp] using
        (primeLogOddsIntensity_normalized_correction hlam hlam2 hp).1
    · simp only [primeLogOddsCorrection, if_neg hp, le_refl]
  · intro p hp2
    by_cases hp : p.Prime
    · simpa only [primeLogOddsCorrection, if_pos hp] using
        (primeLogOddsIntensity_normalized_correction hlam hlam2 hp).2
    · simp only [primeLogOddsCorrection, if_neg hp]
      have hp2' : (2 : ℝ) ≤ p := by exact_mod_cast hp2
      exact one_div_nonneg.mpr (mul_nonneg (Nat.cast_nonneg p) (by linarith))

theorem summable_primeLogOddsCorrection {lam : ℝ} (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) :
    Summable (primeLogOddsCorrection lam) :=
  summable_reciprocal_correction (primeLogOddsCorrection_bounds hlam hlam2).1
    (primeLogOddsCorrection_bounds hlam hlam2).2

noncomputable def primeLogOddsMertensConstant (lam : ℝ) : ℝ :=
  PrimeMertens.M + ∑' p : ℕ, primeLogOddsCorrection lam p

noncomputable def primeLogOddsErrorConstant : ℝ := mertensErrorConstant + 2

theorem primeLogOddsErrorConstant_pos : 0 < primeLogOddsErrorConstant := by
  unfold primeLogOddsErrorConstant
  linarith [mertensErrorConstant_pos]

theorem primeLogOddsCorrection_partial_tail {lam : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) {N : ℕ} (hN : 1 ≤ N) :
    |(∑ p ∈ range (N + 1), primeLogOddsCorrection lam p) -
      ∑' p : ℕ, primeLogOddsCorrection lam p| ≤ 1 / (N : ℝ) := by
  have hb := primeLogOddsCorrection_bounds hlam hlam2
  have hs := (summable_primeLogOddsCorrection hlam hlam2).sum_add_tsum_nat_add (N + 1)
  have htail := tsum_reciprocal_correction_tail_le hb.1 hb.2 hN
  have ht0 : 0 ≤ ∑' n : ℕ, primeLogOddsCorrection lam (n + (N + 1)) :=
    tsum_nonneg (fun n ↦ hb.1 _)
  have hid : (∑ p ∈ range (N + 1), primeLogOddsCorrection lam p) -
      ∑' p : ℕ, primeLogOddsCorrection lam p =
      -(∑' n : ℕ, primeLogOddsCorrection lam (n + (N + 1))) := by linarith
  rw [hid, abs_neg, abs_of_nonneg ht0]
  exact htail

theorem sum_Ioc_zero_eq_sum_range_of_zero {f : ℕ → ℝ} (hf : f 0 = 0) (N : ℕ) :
    (∑ p ∈ Ioc 0 N, f p) = ∑ p ∈ range (N + 1), f p := by
  apply sum_subset
  · intro p hp
    simp only [Finset.mem_Ioc, Finset.mem_range] at hp ⊢
    omega
  · intro p hp hnot
    have hpN := Finset.mem_range.mp hp
    have hp0 : p = 0 := by
      simp only [Finset.mem_Ioc] at hnot
      omega
    simpa only [hp0] using hf

noncomputable def primeNormalizedLogOddsSum (lam x : ℝ) : ℝ :=
  ∑ p ∈ (Ioc 0 ⌊x⌋₊).filter Nat.Prime, primeLogOddsIntensity lam p / lam

theorem primeNormalizedLogOddsSum_eq (lam x : ℝ) :
    primeNormalizedLogOddsSum lam x = primeReciprocalSum x +
      ∑ p ∈ range (⌊x⌋₊ + 1), primeLogOddsCorrection lam p := by
  have hr : primeReciprocalSum x =
      ∑ p ∈ range (⌊x⌋₊ + 1), if p.Prime then 1 / (p : ℝ) else 0 := by
    unfold primeReciprocalSum
    rw [sum_filter]
    exact sum_Ioc_zero_eq_sum_range_of_zero (by norm_num) _
  have ho : primeNormalizedLogOddsSum lam x =
      ∑ p ∈ range (⌊x⌋₊ + 1), if p.Prime then primeLogOddsIntensity lam p / lam else 0 := by
    unfold primeNormalizedLogOddsSum
    rw [sum_filter]
    exact sum_Ioc_zero_eq_sum_range_of_zero (by norm_num) _
  rw [hr, ho, ← sum_add_distrib]
  apply sum_congr rfl
  intro p _
  by_cases hp : p.Prime
  · simp only [primeLogOddsCorrection, if_pos hp]
    ring
  · simp only [primeLogOddsCorrection, if_neg hp, add_zero]

/-- The weak Mertens constant is uniform throughout the tilt interval `[1,2]`. -/
theorem primeNormalizedLogOddsSum_estimate {lam v : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hv : log 2 ≤ v) :
    |primeNormalizedLogOddsSum lam (exp v) - log v - primeLogOddsMertensConstant lam| ≤
      primeLogOddsErrorConstant / v := by
  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  have hev : 2 ≤ exp v := (log_le_iff_le_exp (by norm_num : (0 : ℝ) < 2)).mp hv
  have hf := Nat.div_two_lt_floor (by linarith : 1 ≤ exp v)
  have hN0 : (0 : ℝ) < ⌊exp v⌋₊ := by linarith [exp_pos v]
  have hN : 1 ≤ ⌊exp v⌋₊ := by
    have : 0 < ⌊exp v⌋₊ := by exact_mod_cast hN0
    omega
  have htail := primeLogOddsCorrection_partial_tail hlam hlam2 hN
  have hrec := primeReciprocalSum_estimate hev
  rw [log_exp] at hrec
  have hscale : 1 / (⌊exp v⌋₊ : ℝ) ≤ 2 / v := by
    apply (div_le_div_iff₀ hN0 hv0).mpr
    linarith [add_one_le_exp v]
  rw [primeNormalizedLogOddsSum_eq, primeLogOddsMertensConstant]
  have hid : primeReciprocalSum (exp v) +
      (∑ p ∈ range (⌊exp v⌋₊ + 1), primeLogOddsCorrection lam p) - log v -
      (PrimeMertens.M + ∑' p : ℕ, primeLogOddsCorrection lam p) =
      (primeReciprocalSum (exp v) - log v - PrimeMertens.M) +
      ((∑ p ∈ range (⌊exp v⌋₊ + 1), primeLogOddsCorrection lam p) -
        ∑' p : ℕ, primeLogOddsCorrection lam p) := by ring
  rw [hid]
  calc
    _ ≤ |primeReciprocalSum (exp v) - log v - PrimeMertens.M| +
        |(∑ p ∈ range (⌊exp v⌋₊ + 1), primeLogOddsCorrection lam p) -
          ∑' p : ℕ, primeLogOddsCorrection lam p| := abs_add_le _ _
    _ ≤ mertensErrorConstant / v + 2 / v := add_le_add hrec (htail.trans hscale)
    _ = _ := by unfold primeLogOddsErrorConstant; ring

noncomputable def primeNormalizedLogOddsWindowMass (lam u v : ℝ) : ℝ :=
  ∑ p ∈ primeLogWindow u v, primeLogOddsIntensity lam p / lam

theorem primeNormalizedLogOddsWindowMass_eq_sub {u v : ℝ} (huv : u ≤ v) (lam : ℝ) :
    primeNormalizedLogOddsWindowMass lam u v =
      primeNormalizedLogOddsSum lam (exp v) - primeNormalizedLogOddsSum lam (exp u) := by
  have h := sum_Ioc_consecutive
    (fun p : ℕ ↦ if p.Prime then primeLogOddsIntensity lam p / lam else 0)
    (Nat.zero_le ⌊exp u⌋₊) (Nat.floor_mono (exp_le_exp.mpr huv))
  simp only [← sum_filter] at h
  unfold primeNormalizedLogOddsWindowMass primeLogWindow primeNormalizedLogOddsSum
  linarith

theorem primeNormalizedLogOddsWindowMass_estimate {lam u v : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u) (huv : u ≤ v) :
    |primeNormalizedLogOddsWindowMass lam u v - log (v / u)| ≤
      2 * primeLogOddsErrorConstant / u := by
  have hu0 : 0 < u := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hu
  have hv0 : 0 < v := hu0.trans_le huv
  have heu := primeNormalizedLogOddsSum_estimate hlam hlam2 hu
  have hev := primeNormalizedLogOddsSum_estimate hlam hlam2 (hu.trans huv)
  rw [primeNormalizedLogOddsWindowMass_eq_sub huv, log_div hv0.ne' hu0.ne']
  have hid : primeNormalizedLogOddsSum lam (exp v) - primeNormalizedLogOddsSum lam (exp u) -
      (log v - log u) =
      (primeNormalizedLogOddsSum lam (exp v) - log v - primeLogOddsMertensConstant lam) -
      (primeNormalizedLogOddsSum lam (exp u) - log u - primeLogOddsMertensConstant lam) := by ring
  rw [hid]
  calc
    _ ≤ |primeNormalizedLogOddsSum lam (exp v) - log v - primeLogOddsMertensConstant lam| +
        |primeNormalizedLogOddsSum lam (exp u) - log u - primeLogOddsMertensConstant lam| :=
      abs_sub _ _
    _ ≤ primeLogOddsErrorConstant / v + primeLogOddsErrorConstant / u := add_le_add hev heu
    _ ≤ primeLogOddsErrorConstant / u + primeLogOddsErrorConstant / u :=
      add_le_add (div_le_div_of_nonneg_left primeLogOddsErrorConstant_pos.le hu0 huv) le_rfl
    _ = _ := by ring

theorem primeNormalizedLogOddsWindowMass_nonneg {lam : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (u v : ℝ) :
    0 ≤ primeNormalizedLogOddsWindowMass lam u v := by
  apply sum_nonneg
  intro p hp
  have h := (primeLogOddsIntensity_normalized_correction hlam hlam2
    (mem_primeLogWindow.mp hp).1).1
  linarith [show 0 ≤ 1 / (p : ℝ) by positivity]

theorem primeNormalizedLogOddsWindowMass_mono {lam u v z : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hvz : v ≤ z) :
    primeNormalizedLogOddsWindowMass lam u v ≤ primeNormalizedLogOddsWindowMass lam u z := by
  apply sum_le_sum_of_subset_of_nonneg
  · intro p hp
    obtain ⟨hp, hlu, hlv⟩ := mem_primeLogWindow.mp hp
    exact mem_primeLogWindow.mpr ⟨hp, hlu, hlv.trans hvz⟩
  · intro p hp _
    have h := (primeLogOddsIntensity_normalized_correction hlam hlam2
      (mem_primeLogWindow.mp hp).1).1
    linarith [show 0 ≤ 1 / (p : ℝ) by positivity]

theorem primeNormalizedLogOddsWindowMass_broad_bounds {lam u w : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u)
    (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w) :
    w / (4 * u) ≤ primeNormalizedLogOddsWindowMass lam u (u + w) ∧
      primeNormalizedLogOddsWindowMass lam u (u + w) ≤ 5 * w / (4 * u) := by
  have hu0 : 0 < u := hw.trans_le hwu
  obtain ⟨_, hloglo, hloghi⟩ := logUniform_log_bounds hw hwu
  have hloglo' : w / (2 * u) ≤ log (1 + w / u) :=
    (div_le_div_of_nonneg_left hw.le (add_pos hu0 hw) (by linarith : u + w ≤ 2 * u)).trans hloglo
  have herr : 2 * primeLogOddsErrorConstant / u ≤ w / (4 * u) := by
    calc
      _ ≤ (w / 4) / u := div_le_div_of_nonneg_right (by linarith) hu0.le
      _ = _ := by ring
  have he := primeNormalizedLogOddsWindowMass_estimate hlam hlam2 hu (by linarith : u ≤ u + w)
  have hid : (u + w) / u = 1 + w / u := by field_simp
  rw [hid] at he
  have helo := (abs_le.mp he).1
  have hehi := (abs_le.mp he).2
  constructor
  · have hid' : w / (2 * u) - w / (4 * u) = w / (4 * u) := by ring
    linarith
  · have hid' : w / u + w / (4 * u) = 5 * w / (4 * u) := by ring
    linarith

/-- A normalization identity keeps the CDF error to twice the unnormalized
error divided by the continuous total mass. -/
theorem normalized_cdf_error_le {a b s h delta : ℝ}
    (ha0 : 0 ≤ a) (has : a ≤ s) (hs : 0 < s) (hh : 0 < h)
    (hab : |a - b| ≤ delta) (hsh : |s - h| ≤ delta) :
    |a / s - b / h| ≤ 2 * delta / h := by
  have hd : 0 ≤ delta := (abs_nonneg _).trans hab
  have hq0 : 0 ≤ a / s := div_nonneg ha0 hs.le
  have hq1 : a / s ≤ 1 := (div_le_one hs).mpr has
  have hid : a / s - b / h = ((a - b) - (a / s) * (s - h)) / h := by
    field_simp
    ring
  rw [hid, abs_div, abs_of_pos hh]
  apply div_le_div_of_nonneg_right _ hh.le
  calc
    _ ≤ |a - b| + |(a / s) * (s - h)| := abs_sub _ _
    _ = |a - b| + (a / s) * |s - h| := by rw [abs_mul, abs_of_nonneg hq0]
    _ ≤ delta + (a / s) * delta := add_le_add hab (mul_le_mul_of_nonneg_left hsh hq0)
    _ ≤ 2 * delta := by nlinarith

theorem primeNormalizedLogOddsWindowMass_cdf_estimate {lam u w v : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u)
    (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w)
    (huv : u ≤ v) (hvw : v ≤ u + w) :
    |primeNormalizedLogOddsWindowMass lam u v /
        primeNormalizedLogOddsWindowMass lam u (u + w) -
      log (v / u) / log (1 + w / u)| ≤ 8 * primeLogOddsErrorConstant / w := by
  have hC := primeLogOddsErrorConstant_pos
  have hu0 : 0 < u := hw.trans_le hwu
  obtain ⟨hh, hloglo, _⟩ := logUniform_log_bounds hw hwu
  have hloglo' : w / (2 * u) ≤ log (1 + w / u) :=
    (div_le_div_of_nonneg_left hw.le (add_pos hu0 hw) (by linarith : u + w ≤ 2 * u)).trans hloglo
  have hmass := (primeNormalizedLogOddsWindowMass_broad_bounds hlam hlam2 hu hw hwu hlarge).1
  have hmass0 : 0 < primeNormalizedLogOddsWindowMass lam u (u + w) :=
    (by positivity : 0 < w / (4 * u)).trans_le hmass
  have he := primeNormalizedLogOddsWindowMass_estimate hlam hlam2 hu (by linarith : u ≤ u + w)
  have hid : (u + w) / u = 1 + w / u := by field_simp
  rw [hid] at he
  have h := normalized_cdf_error_le (primeNormalizedLogOddsWindowMass_nonneg hlam hlam2 u v)
    (primeNormalizedLogOddsWindowMass_mono hlam hlam2 hvw) hmass0 hh
    (primeNormalizedLogOddsWindowMass_estimate hlam hlam2 hu huv) he
  calc
    _ ≤ 2 * (2 * primeLogOddsErrorConstant / u) / log (1 + w / u) := h
    _ ≤ 2 * (2 * primeLogOddsErrorConstant / u) / (w / (2 * u)) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) hloglo'
    _ = _ := by field_simp; ring

