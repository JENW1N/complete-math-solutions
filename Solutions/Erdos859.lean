/- Inlined development module: TiltAsymptotics.lean -/

section

/- Asymptotic likelihood cost on increasing families of logarithmic bands. -/

open Filter Real Finset
open scoped Topology

namespace Erdos859Verification

/-- The lower logarithmic endpoint may vary arbitrarily above `log 2`.
The main term depends only on the number of dyadic logarithmic bands. -/
theorem tendsto_log_primeWindowTilt_div (A : ℕ → ℝ)
    (hA : ∀ n, log 2 ≤ A n) {lam : ℝ} (hlam : 1 ≤ lam) :
    Tendsto (fun n : ℕ ↦
      log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) / n)
      atTop (𝓝 ((lam - 1) * log 2)) := by
  let C : ℝ := (lam - 1) ^ 2 * reciprocalSquareBound +
    (lam - 1) * (2 * mertensErrorConstant / log 2)
  have hlog2 : 0 < log 2 := log_pos (by norm_num)
  have hbound (n : ℕ) :
      |log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) -
        (n : ℝ) * ((lam - 1) * log 2)| ≤ C := by
    have hAn : 0 < A n := hlog2.trans_le (hA n)
    have hab : A n ≤ A n * (2 : ℝ) ^ n :=
      le_mul_of_one_le_right hAn.le (one_le_pow₀ (by norm_num))
    have h := log_primeWindowTilt_error (hA n) hab hlam
    have hr : A n * (2 : ℝ) ^ n / A n = (2 : ℝ) ^ n := by field_simp
    rw [hr, log_pow] at h
    have herr : 2 * mertensErrorConstant / A n ≤ 2 * mertensErrorConstant / log 2 :=
      div_le_div_of_nonneg_left (by positivity [mertensErrorConstant_pos]) hlog2 (hA n)
    calc
      _ = |log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) -
          (lam - 1) * ((n : ℝ) * log 2)| := by congr 1; ring
      _ ≤ (lam - 1) ^ 2 * reciprocalSquareBound +
          (lam - 1) * (2 * mertensErrorConstant / A n) := h
      _ ≤ C := add_le_add le_rfl (mul_le_mul_of_nonneg_left herr (sub_nonneg.mpr hlam))
  have hzero : Tendsto (fun n : ℕ ↦
      log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) / n -
        (lam - 1) * log 2) atTop (𝓝 0) := by
    apply squeeze_zero_norm' _ (tendsto_const_div_atTop_nhds_zero_nat C)
    filter_upwards [eventually_gt_atTop 0] with n hn
    have hnR : (0 : ℝ) < n := by exact_mod_cast hn
    have heq : log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) / n -
        (lam - 1) * log 2 =
        (log (primeTiltNormalizer (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam) -
          (n : ℝ) * ((lam - 1) * log 2)) / n := by field_simp
    rw [Real.norm_eq_abs, heq, abs_div, abs_of_pos hnR]
    exact div_le_div_of_nonneg_right (hbound n) hnR.le
  exact tendsto_sub_nhds_zero_iff.mp hzero

/-- The exact likelihood moment has the exponential cost used in the
manuscript's Hölder calculation. -/
theorem tendsto_log_primeTiltLikelihood_moment_div (A : ℕ → ℝ)
    (hA : ∀ n, log 2 ≤ A n) {lam q : ℝ} (hlam : 1 ≤ lam) (hq : 0 ≤ q) :
    Tendsto (fun n : ℕ ↦
      log (∑ T ∈ (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)).powerset,
        primePatternWeight (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) T *
          primeTiltLikelihood (primeLogWindow (A n) (A n * (2 : ℝ) ^ n)) lam T ^ q) / n)
      atTop (𝓝 ((lam ^ q - 1 - q * (lam - 1)) * log 2)) := by
  have hlam0 : 0 < lam := zero_lt_one.trans_le hlam
  have hpow : 1 ≤ lam ^ q := Real.one_le_rpow hlam hq
  have h1 := tendsto_log_primeWindowTilt_div A hA hpow
  have h2 := (tendsto_log_primeWindowTilt_div A hA hlam).const_mul q
  have h := h1.sub h2
  convert h using 1
  · funext n
    let P := primeLogWindow (A n) (A n * (2 : ℝ) ^ n)
    have hP : ∀ p ∈ P, p.Prime := primeLogWindow_prime _ _
    have hZ := primeTiltNormalizer_pos hP hlam0
    have hZq := primeTiltNormalizer_pos hP (Real.rpow_pos_of_pos hlam0 q)
    change log (∑ T ∈ P.powerset, primePatternWeight P T * primeTiltLikelihood P lam T ^ q) / n =
      log (primeTiltNormalizer P (lam ^ q)) / n - q * (log (primeTiltNormalizer P lam) / n)
    rw [primeTiltLikelihood_moment hP hlam0, log_div hZq.ne'
      (Real.rpow_pos_of_pos hZ q).ne', log_rpow hZ]
    ring
  · apply congrArg nhds
    ring

end Erdos859Verification

