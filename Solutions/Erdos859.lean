theorem coreSeedPastHigh_coverage_eventually {eta c C rho eps : ℝ}
    (heta : (501 / 500 : ℝ) * exp eta < 5 / 4) (hC : 100 ≤ C) (heps : 0 < eps) (r₀ : ℕ) :
    ∀ᶠ s : ℕ in atTop, ∀ T ⊆ coreGlobalPrimeUniverse s,
      CoreSeedRoughEvent s (coreRoughPrimeUniverse s) (CorePastHighEvent eta c C rho r₀ s) T →
        exp (-eps * (coreRateTotalLength s : ℝ)) ≤
          primeTargetAverageObservable (coreGlobalTargetHorizon s) (fun t ↦ 1 / (t : ℝ)) T := by
  filter_upwards [coreArithmeticCoverage_exponential_eventually heta hC heps r₀] with s hcover
  intro T hT hgood
  let U := T ∩ coreRoughPrimeUniverse s
  obtain ⟨core, q, hcert, hmark⟩ := hgood.2.2
  let past := U ∩ coreBasePairUniverse C r₀ s
  let high := U ∩ corePairHighWindow C r₀ s q
  have hsmall : past ∪ high ⊆ U := union_subset inter_subset_left inter_subset_left
  have hdivsmall : (∏ p ∈ past ∪ high, p) ∣ ∏ p ∈ U, p :=
    prod_dvd_prod_of_subset _ _ id hsmall
  obtain ⟨seed, hseed, hZseed, _hseedhi, hcop, hdiv⟩ := coreSeed_practical_factor
    (filter_subset _ _) (fun _ hp ↦ (mem_filter.mp hp).2) hgood.1
  have hseed0 : seed ≠ 0 := ((bernoulliSeedScale_pos (coreRateTotalLength s)).trans_le hZseed).ne'
  exact hcover T past core high q hT inter_subset_right hcert inter_subset_right
    hmark.1 hmark.2 seed hseed hseed0 hZseed (hcop.of_dvd_right hdivsmall)
    ((Nat.mul_dvd_mul_left seed hdivsmall).trans hdiv)

theorem coreGlobalHarmonicExpectation_lower {lam : ℝ}
    (hlam : criticalTilt < lam) (hlam2 : lam < 2) :
    ∀ eps : ℝ, 0 < eps → ∀ᶠ s : ℕ in atTop,
      exp (-(corePrefixRate lam + eps) * (coreRateTotalLength s : ℝ)) ≤
        coreGlobalHarmonicExpectation lam s := by
  have hlam1 : 1 ≤ lam := (one_lt_criticalTilt.trans hlam).le
  have hcritical : 1 < lam * log 2 := (div_lt_iff₀ log_two_pos).mp hlam
  obtain ⟨c, _hc, C, hC, rho, _hrho, _hrho2, _hrhoC, r₀, _hstart, hmass⟩ :=
    corePastHigh_event_probability_lower coreAnchor_eta_choice.1 coreAnchor_eta_choice.2.1
      hcritical coreAnchor_eta_choice.2.2 hlam1 hlam2.le
  apply coreGlobalHarmonicExpectation_eventually_of_seed_rough hlam1 coreRoughPrimeUniverse
    (fun s ↦ CorePastHighEvent (1 / 1000) c C rho r₀ s)
    (fun _ ↦ filter_subset _ _) (fun _ _ hp ↦ (mem_filter.mp hp).2) hmass
  intro eps heps
  exact coreSeedPastHigh_coverage_eventually coreAnchor_eta_choice.2.2 hC heps r₀

