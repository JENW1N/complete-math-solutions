  · funext N
    simp only [sum_sub_distrib, div_eq_mul_inv]
    ring
  · simp

/-- If a finite-prime observable is supported on represented targets,
its exact Bernoulli expectation is a lower bound for the target density. -/
theorem prime_observable_le_divisorDensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (t : ℕ) (F : Finset ℕ → ℝ)
    (hF1 : ∀ T, F T ≤ 1)
    (hsupport : ∀ T ∈ P.powerset, 0 < F T →
      (∏ p ∈ T, p) ∈ Erdos859.DivisorSumSet t) :
    (∑ T ∈ P.powerset, primePatternWeight P T * F T) ≤ divisorDensity t := by
  classical
  let f : ℕ → ℝ := fun n ↦ if n = 0 then 0 else F (P.filter (fun p ↦ p ∣ n))
  have hmean := tendsto_mean_congr_eventually (tendsto_mean_prime_observable hP F)
    (show (fun n ↦ F (P.filter (fun p ↦ p ∣ n))) =ᶠ[atTop] f by
      filter_upwards [eventually_gt_atTop 0] with n hn
      simp [f, hn.ne'])
  have hdensity := divisorSumSet_hasDensity t
  change Tendsto (fun N ↦ (Erdos859.DivisorSumSet t).partialDensity Set.univ N)
    atTop (𝓝 (divisorDensity t)) at hdensity
