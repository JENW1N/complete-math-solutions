section

/- The deterministic occupancy estimate for the subset envelope. -/

open Finset Real MeasureTheory
open scoped ENNReal

namespace Erdos859Verification

noncomputable def fordBinOccupancy {k : ℕ} (v : ℝ) (x : Fin k → ℝ) (b : ℕ) : ℕ :=
  (univ.filter fun i ↦ ⌊v * x i⌋₊ = b).card

theorem ford_exp_log_two_nat (j : ℕ) : exp (log 2 * (j : ℝ)) = (2 : ℝ) ^ j := by
  rw [mul_comm, exp_nat_mul, exp_log (by norm_num)]

theorem ford_floor_weight_sum {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (y : ι → ℝ) {t R : ℝ} (ht : 0 ≤ t) (hR : 0 ≤ R)
    (hyt : ∀ i ∈ s, y i ≤ t)
    (hocc : ∀ b : ℕ, ((s.filter fun i ↦ ⌊y i⌋₊ = b).card : ℝ) ≤ R) :
    (∑ i ∈ s, exp (log 2 * y i)) ≤ 4 * R * exp (log 2 * t) := by
  have hlog : 0 ≤ log (2 : ℝ) := log_nonneg (by norm_num)
  have hmap : ∀ i ∈ s, ⌊y i⌋₊ ∈ range (⌊t⌋₊ + 1) := by
    intro i hi
    exact mem_range.mpr (Nat.lt_succ_of_le (Nat.floor_mono (hyt i hi)))
  calc
    _ = ∑ b ∈ range (⌊t⌋₊ + 1), ∑ i ∈ s.filter (fun i ↦ ⌊y i⌋₊ = b),
        exp (log 2 * y i) := (sum_fiberwise_of_maps_to hmap _).symm
    _ ≤ ∑ b ∈ range (⌊t⌋₊ + 1), R * (2 : ℝ) ^ (b + 1) := by
      apply sum_le_sum
      intro b _
      calc
        _ ≤ ∑ _i ∈ s.filter (fun i ↦ ⌊y i⌋₊ = b), (2 : ℝ) ^ (b + 1) := by
          apply sum_le_sum
          intro i hi
          have hiy : y i ≤ (b : ℝ) + 1 := by
            simpa only [(mem_filter.mp hi).2] using (Nat.lt_floor_add_one (y i)).le
          rw [← ford_exp_log_two_nat]
          exact exp_le_exp.mpr (mul_le_mul_of_nonneg_left (by exact_mod_cast hiy) hlog)
        _ = ((s.filter fun i ↦ ⌊y i⌋₊ = b).card : ℝ) * (2 : ℝ) ^ (b + 1) := by
          rw [sum_const, nsmul_eq_mul]
        _ ≤ R * (2 : ℝ) ^ (b + 1) :=
          mul_le_mul_of_nonneg_right (hocc b) (by positivity)
    _ ≤ 4 * R * (2 : ℝ) ^ ⌊t⌋₊ := by
      simp_rw [pow_succ]
      rw [← mul_sum]
      rw [← sum_mul, geom_sum_eq (by norm_num : (2 : ℝ) ≠ 1)]
      norm_num only [show (2 : ℝ) - 1 = 1 by norm_num, div_one, pow_succ]
      nlinarith
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      rw [← ford_exp_log_two_nat]
      exact exp_le_exp.mpr (mul_le_mul_of_nonneg_left (Nat.floor_le ht) hlog)

theorem fordSubsetEnvelope_occupancy_coordinate {k : ℕ} {v R : ℝ}
    (hv : 0 ≤ v) (hR : 0 ≤ R) (x : Fin k → ℝ) (hx : ∀ i, 0 ≤ x i)
    (hocc : ∀ b : ℕ, (fordBinOccupancy v x b : ℝ) ≤ R) (j : Fin k) :
    fordSubsetEnvelope (fun i ↦ log 2 * (v * x i)) ≤
      (4 * R + 1) * exp (log 2 * (v * fordSortedTuple x j - ((j.val : ℝ) + 1))) := by
  classical
  let I := (Iic j).image (Tuple.sort x)
  have hcard : I.card = j.val + 1 := by
    rw [card_image_of_injective _ (Tuple.sort x).injective]
    exact Fin.card_Iic j
  have ht : 0 ≤ v * fordSortedTuple x j := mul_nonneg hv (hx _)
  have hsum := ford_floor_weight_sum I (fun i ↦ v * x i) ht hR (by
    intro i hi
    obtain ⟨a, ha, rfl⟩ := mem_image.mp hi
    exact mul_le_mul_of_nonneg_left (Tuple.monotone_sort x (mem_Iic.mp ha)) hv) (by
    intro b
    apply le_trans _ (hocc b)
    exact_mod_cast card_le_card (show I.filter (fun i ↦ ⌊v * x i⌋₊ = b) ⊆
        univ.filter (fun i ↦ ⌊v * x i⌋₊ = b) from
      fun i hi ↦ mem_filter.mpr ⟨mem_univ i, (mem_filter.mp hi).2⟩))
  have he : 1 ≤ exp (log 2 * (v * fordSortedTuple x j)) :=
    one_le_exp_iff.mpr (mul_nonneg (log_nonneg (by norm_num)) ht)
  calc
    _ ≤ (1 + ∑ i ∈ I, exp (log 2 * (v * x i))) / (2 : ℝ) ^ I.card :=
      fordSubsetEnvelope_le _ I
    _ ≤ ((4 * R + 1) * exp (log 2 * (v * fordSortedTuple x j))) /
        (2 : ℝ) ^ I.card := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      nlinarith
    _ = _ := by
      rw [hcard, mul_sub, exp_sub]
      have hexp : exp (log 2 * ((j.val : ℝ) + 1)) = (2 : ℝ) ^ (j.val + 1) := by
        simpa only [Nat.cast_add, Nat.cast_one] using ford_exp_log_two_nat (j.val + 1)
      rw [hexp]
      ring

/-- Bounded bin occupancy controls the envelope by the actual sorted deficit. -/
theorem fordSubsetEnvelope_le_deficit {k : ℕ} {v R : ℝ}
    (hv : 0 ≤ v) (hR : 0 ≤ R) (x : Fin k → ℝ) (hx : ∀ i, 0 ≤ x i)
    (hocc : ∀ b : ℕ, (fordBinOccupancy v x b : ℝ) ≤ R) :
    fordSubsetEnvelope (fun i ↦ log 2 * (v * x i)) ≤
      (4 * R + 1) * exp (log 2 * fordCubeDeficit v x) := by
  classical
  have hm := min'_mem (insert 0 (univ.image fun i : Fin k ↦
      v * fordSortedTuple x i - ((i.val : ℝ) + 1))) (by simp)
  change fordCubeDeficit v x ∈ insert 0 (univ.image fun i : Fin k ↦
      v * fordSortedTuple x i - ((i.val : ℝ) + 1)) at hm
  rcases mem_insert.mp hm with hzero | hcoord
  · rw [hzero, mul_zero, exp_zero, mul_one]
    exact (fordSubsetEnvelope_le_one _).trans (by linarith)
  · obtain ⟨j, _, hj⟩ := mem_image.mp hcoord
    rw [← hj]
    exact fordSubsetEnvelope_occupancy_coordinate hv hR x hx hocc j

/-- The elementary endpoint bound requires no occupancy hypothesis. -/
theorem fordSubsetEnvelope_le_endpoint {k : ℕ} {v : ℝ} (hv : 0 ≤ v)
    (x : Fin k → ℝ) (hx : ∀ i, x i ≤ 1) :
    fordSubsetEnvelope (fun i ↦ log 2 * (v * x i)) ≤
      min 1 (((k : ℝ) + 1) * exp (log 2 * (v - k))) := by
  apply le_min (fordSubsetEnvelope_le_one _)
  have he : 1 ≤ exp (log 2 * v) :=
    one_le_exp_iff.mpr (mul_nonneg (log_nonneg (by norm_num)) hv)
  have hsum : (∑ i : Fin k, exp (log 2 * (v * x i))) ≤ k * exp (log 2 * v) := by
    calc
      _ ≤ ∑ _i : Fin k, exp (log 2 * v) := by
        apply sum_le_sum
        intro i _
        apply exp_le_exp.mpr
        exact mul_le_mul_of_nonneg_left (by nlinarith [hx i]) (log_nonneg (by norm_num))
      _ = _ := by simp
  calc
    _ ≤ (1 + ∑ i : Fin k, exp (log 2 * (v * x i))) / (2 : ℝ) ^ k := by
      simpa only [card_univ, Fintype.card_fin] using fordSubsetEnvelope_le
        (fun i ↦ log 2 * (v * x i)) univ
    _ ≤ (((k : ℝ) + 1) * exp (log 2 * v)) / (2 : ℝ) ^ k := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      nlinarith
    _ = _ := by
      rw [mul_sub, exp_sub, ford_exp_log_two_nat]
      ring

end Erdos859Verification

