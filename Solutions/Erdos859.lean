    (prod_pos (fun p hp ↦ prime_low_valuation_mass_pos (hP p (mem_sdiff.mp hp).1)))

theorem fixedPowerfulCappedMass_le_reciprocal {P H : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hH : H ⊆ P) (cap a : ℕ → ℕ) :
