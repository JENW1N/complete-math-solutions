theorem corePairWindow_endpoint_order {C : ℝ} (hC : 0<C) (r₀ s : ℕ) {i j : ℕ} (hij : i<j) :
    corePairWindowStart C s i+corePairWindowWidth C r₀ s i<corePairWindowStart C s j := by
  have hijR : (i:ℝ)+1≤j := by exact_mod_cast hij
  have hD : 2*C<corePairSpacing C := by unfold corePairSpacing; linarith
  have hgap : (i:ℝ)+1+1≤(j:ℝ)+1 := by linarith
  have hcoef := mul_le_mul_of_nonneg_left hgap (corePairSpacing_pos hC).le
  have hstep := mul_lt_mul_of_pos_right hD (corePairScale_pos s)
  have hscale := mul_le_mul_of_nonneg_right hcoef (corePairScale_pos s).le
  have hwidth := corePairWindowWidth_upper hC r₀ s i
