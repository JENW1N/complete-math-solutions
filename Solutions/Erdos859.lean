theorem primePhaseArcEvent_mono {m : ℕ} {P : Fin m → Finset ℕ}
    {F F' : Set (AddCircle (1 : ℝ))} {J J' : Finset ℕ} {U : ℝ}
    (hF : F ⊆ F') (hJ : J ⊆ J') {x : (i : Fin m) → P i}
    (hx : primePhaseArcEvent F J U x) : primePhaseArcEvent F' J' U x := by
  obtain ⟨alpha, halpha, q, hq, a, hcop, harc, hmarks⟩ := hx
  exact ⟨alpha, hF halpha, q, hJ hq, a, hcop, harc, fun i ↦ hF (hmarks i)⟩

/-- Dirichlet approximation and the weight-one norm bound place each bad
phase in the small-denominator set or one member of the fixed finite cover. -/
theorem primeFarPhaseEvent_finite_cover {β : Type*} {m : ℕ} {P : Fin m → Finset ℕ}
    (F : Set (AddCircle (1 : ℝ))) {Y : ℝ} (hY : 0 < Y) {U : ℕ} (hU : 2 < U)
    (hF : ∀ alpha ∈ F, ‖alpha‖ ≤ 1 / Y)
    (Jsmall : Finset ℕ) (blocks : Finset β)
    (J : β → Finset ℕ) (Fblock : β → Set (AddCircle (1 : ℝ)))
    (hFblock : ∀ b ∈ blocks, F ⊆ Fblock b)
    (hcover : ∀ q : ℕ, 2 ≤ q → q ≤ U → Y / 2 < (q : ℝ) →
      q ∈ Jsmall ∨ ∃ b ∈ blocks, q ∈ J b)
    {x : (i : Fin m) → P i} (hx : primeFarPhaseEvent F (U : ℝ) x) :
    primePhaseArcEvent F Jsmall (U : ℝ) x ∨
      ∃ b ∈ blocks, primePhaseArcEvent (Fblock b) (J b) (U : ℝ) x := by
  obtain ⟨alpha, halpha, hfar, hmarks⟩ := hx
  obtain ⟨q, hq, hqU, a, hcop, harc⟩ :=
    unitCircle_exists_nontrivial_reduced_grid_approx alpha (by omega) hfar
  have hhalf := reduced_arc_denominator_gt_half hY (by exact_mod_cast hU) hq a hcop
    (hF alpha halpha) harc
  rcases hcover q hq hqU hhalf with hsmall | ⟨b, hb, hqb⟩
  · exact Or.inl ⟨alpha, halpha, q, hsmall, a, hcop, harc, hmarks⟩
  · exact Or.inr ⟨b, hb, alpha, hFblock b hb halpha, q, hqb, a, hcop, harc,
      fun i ↦ hFblock b hb (hmarks i)⟩

/-- This is a union bound for the actual finite product of mark weights.
No independence of the overlapping phase events is asserted. -/
theorem independentPrimeFarPhaseMass_le_finite_arc_cover {β : Type*} {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (F : Set (AddCircle (1 : ℝ))) (U : ℝ) (Jsmall : Finset ℕ)
    (blocks : Finset β) (J : β → Finset ℕ) (Fblock : β → Set (AddCircle (1 : ℝ)))
    (hcover : ∀ x : (i : Fin m) → P i, primeFarPhaseEvent F U x →
      primePhaseArcEvent F Jsmall U x ∨ ∃ b ∈ blocks, primePhaseArcEvent (Fblock b) (J b) U x) :
    independentPrimeFarPhaseMass P weight F U ≤
      independentPrimePhaseArcMass P weight F Jsmall U +
        ∑ b ∈ blocks, independentPrimePhaseArcMass P weight (Fblock b) (J b) U := by
  classical
  let W : ((i : Fin m) → P i) → ℝ := finiteProductWeight (fun i p ↦ weight i p.val)
  have hW (x : (i : Fin m) → P i) : 0 ≤ W x :=
    finiteProductWeight_nonneg (fun i p ↦ hw i p.val p.property) x
  let E : β → ((i : Fin m) → P i) → Prop :=
    fun b x ↦ primePhaseArcEvent (Fblock b) (J b) U x
  have hpoint (x : (i : Fin m) → P i) :
      W x * (if primeFarPhaseEvent F U x then 1 else 0) ≤
        W x * (if primePhaseArcEvent F Jsmall U x then 1 else 0) +
          W x * (if ∃ b ∈ blocks, E b x then 1 else 0) := by
    by_cases hx : primeFarPhaseEvent F U x
    · rcases hcover x hx with hs | hb
      · rw [if_pos hx, if_pos hs, mul_one]
        exact le_add_of_nonneg_right (mul_nonneg (hW x) (by split_ifs <;> norm_num))
      · have he : ∃ b ∈ blocks, E b x := hb
        rw [if_pos hx, if_pos he, mul_one]
        exact le_add_of_nonneg_left (mul_nonneg (hW x) (by split_ifs <;> norm_num))
    · rw [if_neg hx, mul_zero]
      exact add_nonneg (mul_nonneg (hW x) (by split_ifs <;> norm_num))
        (mul_nonneg (hW x) (by split_ifs <;> norm_num))
  have hsplit : independentPrimeFarPhaseMass P weight F U ≤
      independentPrimePhaseArcMass P weight F Jsmall U +
        ∑ x : (i : Fin m) → P i, W x * (if ∃ b ∈ blocks, E b x then 1 else 0) := by
    unfold independentPrimeFarPhaseMass independentPrimePhaseArcMass
    rw [← sum_add_distrib]
    exact sum_le_sum (fun x _ ↦ hpoint x)
  apply hsplit.trans
  apply add_le_add le_rfl
  exact finite_weighted_union_bound_general univ blocks W (fun x _ ↦ hW x) E

theorem independentPrimeFarPhaseMass_denominator_cover_le {β : Type*} {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (F : Set (AddCircle (1 : ℝ))) {Y : ℝ} (hY : 0 < Y) {U : ℕ} (hU : 2 < U)
    (hF : ∀ alpha ∈ F, ‖alpha‖ ≤ 1 / Y)
    (Jsmall : Finset ℕ) (blocks : Finset β)
    (J : β → Finset ℕ) (Fblock : β → Set (AddCircle (1 : ℝ)))
    (hFblock : ∀ b ∈ blocks, F ⊆ Fblock b)
    (hcover : ∀ q : ℕ, 2 ≤ q → q ≤ U → Y / 2 < (q : ℝ) →
      q ∈ Jsmall ∨ ∃ b ∈ blocks, q ∈ J b) :
    independentPrimeFarPhaseMass P weight F (U : ℝ) ≤
      independentPrimePhaseArcMass P weight F Jsmall (U : ℝ) +
        ∑ b ∈ blocks, independentPrimePhaseArcMass P weight (Fblock b) (J b) (U : ℝ) :=
  independentPrimeFarPhaseMass_le_finite_arc_cover P weight hw F (U : ℝ) Jsmall blocks J Fblock
    (fun _ hx ↦ primeFarPhaseEvent_finite_cover F hY hU hF Jsmall blocks J Fblock hFblock hcover hx)

theorem sum_phase_block_decay_le {β : Type*} (blocks : Finset β) (M : β → ℝ)
    {M0 G : ℝ} (hM0 : 0 < M0) (hG : 0 ≤ G) (hM : ∀ b ∈ blocks, M0 ≤ M b) (m : ℕ) :
    (∑ b ∈ blocks, (1000 : ℝ) ^ (m + 1) * G ^ m * M b ^ (-(m : ℝ) / 2)) ≤
      (blocks.card : ℝ) * (1000 : ℝ) ^ (m + 1) * G ^ m * M0 ^ (-(m : ℝ) / 2) := by
  have hexp : -(m : ℝ) / 2 ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (Nat.cast_nonneg m)) (by norm_num)
  calc
    _ ≤ ∑ _b ∈ blocks, (1000 : ℝ) ^ (m + 1) * G ^ m * M0 ^ (-(m : ℝ) / 2) :=
      sum_le_sum (fun b hb ↦ mul_le_mul_of_nonneg_left
        (rpow_le_rpow_of_nonpos hM0 (hM b hb) hexp) (by positivity))
    _ = _ := by simp; ring

/-- Assemble explicit small-denominator and block estimates.  The cover is
fixed, so only its cardinality enters the common-anchor bound. -/
theorem independentPrimeFarPhaseMass_finite_decay_le {β : Type*} {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (F : Set (AddCircle (1 : ℝ))) {Y : ℝ} (hY : 0 < Y) {U : ℕ} (hU : 2 < U)
    (hF : ∀ alpha ∈ F, ‖alpha‖ ≤ 1 / Y)
    (Jsmall : Finset ℕ) (blocks : Finset β)
    (J : β → Finset ℕ) (Fblock : β → Set (AddCircle (1 : ℝ)))
    (hFblock : ∀ b ∈ blocks, F ⊆ Fblock b)
    (hcover : ∀ q : ℕ, 2 ≤ q → q ≤ U → Y / 2 < (q : ℝ) →
      q ∈ Jsmall ∨ ∃ b ∈ blocks, q ∈ J b)
    {G Q0 M0 : ℝ} (hG : 0 ≤ G) (hM0 : 0 < M0) (M : β → ℝ)
    (hM : ∀ b ∈ blocks, M0 ≤ M b)
    (hsmall : independentPrimePhaseArcMass P weight F Jsmall (U : ℝ) ≤ Q0 ^ 2 * (16 * G / Y) ^ m)
    (hblock : ∀ b ∈ blocks,
      independentPrimePhaseArcMass P weight (Fblock b) (J b) (U : ℝ) ≤
        (1000 : ℝ) ^ (m + 1) * G ^ m * M b ^ (-(m : ℝ) / 2)) :
    independentPrimeFarPhaseMass P weight F (U : ℝ) ≤
      Q0 ^ 2 * (16 * G / Y) ^ m +
        (blocks.card : ℝ) * (1000 : ℝ) ^ (m + 1) * G ^ m * M0 ^ (-(m : ℝ) / 2) := by
  apply (independentPrimeFarPhaseMass_denominator_cover_le P weight hw F hY hU hF
    Jsmall blocks J Fblock hFblock hcover).trans
  apply add_le_add hsmall
  exact (sum_le_sum hblock).trans (sum_phase_block_decay_le blocks M hM0 hG hM m)

