/- Inlined development module: DivisorDyadicParameters.lean -/

section

/- A logarithmic dyadic depth with every endpoint above the square-root scale. -/

open Finset Filter Real
open scoped Topology

namespace Erdos859Verification

noncomputable def divisorDyadicDepth (t : ℕ) : ℕ := ⌈log (log (t : ℝ)) / log 2⌉₊

noncomputable def divisorDyadicDepthConstant : ℝ := 1 / log 2 + 1

theorem divisorDyadicDepthConstant_pos : 0 < divisorDyadicDepthConstant := by
  unfold divisorDyadicDepthConstant
  have : 0 < log (2 : ℝ) := log_pos (by norm_num)
  positivity

theorem divisorDyadicDepth_power_bounds {t : ℕ} (ht : 0 < log (t : ℝ))
    (hloglog : 0 ≤ log (log (t : ℝ))) :
    log (t : ℝ) ≤ (2 : ℝ) ^ divisorDyadicDepth t ∧
      (2 : ℝ) ^ divisorDyadicDepth t < 2 * log (t : ℝ) := by
  have hl : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hlo := (div_le_iff₀ hl).mp (Nat.le_ceil (log (log (t : ℝ)) / log 2))
  have hhi := mul_lt_mul_of_pos_right
    (Nat.ceil_lt_add_one (div_nonneg hloglog hl.le)) hl
  have hexp : exp ((divisorDyadicDepth t : ℝ) * log 2) = (2 : ℝ) ^ divisorDyadicDepth t := by
    rw [exp_nat_mul, exp_log (by norm_num : (0 : ℝ) < 2)]
  constructor
  · have h := exp_le_exp.mpr hlo
    rw [exp_log ht] at h
    change log (t : ℝ) ≤ exp ((divisorDyadicDepth t : ℝ) * log 2) at h
    rwa [hexp] at h
  · have harg : (divisorDyadicDepth t : ℝ) * log 2 < log (log (t : ℝ)) + log 2 := by
      dsimp only [divisorDyadicDepth]
      calc
        _ < (log (log (t : ℝ)) / log 2 + 1) * log 2 := hhi
        _ = _ := by field_simp
    have h := exp_lt_exp.mpr harg
    rw [hexp, exp_add, exp_log ht, exp_log (by norm_num : (0 : ℝ) < 2)] at h
    simpa only [mul_comm] using h

theorem divisorDyadicDepth_loglog_bound {t : ℕ} (hloglog : 1 ≤ log (log (t : ℝ))) :
    (divisorDyadicDepth t : ℝ) ≤ divisorDyadicDepthConstant * log (log (t : ℝ)) := by
  have hl : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have h := Nat.ceil_lt_add_one (div_nonneg (by linarith : 0 ≤ log (log (t : ℝ))) hl.le)
  change (⌈log (log (t : ℝ)) / log 2⌉₊ : ℝ) ≤ _
  unfold divisorDyadicDepthConstant
  calc
    _ ≤ log (log (t : ℝ)) / log 2 + 1 := h.le
    _ ≤ log (log (t : ℝ)) / log 2 + log (log (t : ℝ)) := add_le_add le_rfl hloglog
    _ = _ := by ring

theorem divisorDyadicParameters_eventually :
    ∀ᶠ t : ℕ in atTop, 0 < t ∧ 1 ≤ log (log (t : ℝ)) ∧
      (divisorDyadicDepth t : ℝ) ≤ divisorDyadicDepthConstant * log (log (t : ℝ)) ∧
      log (t : ℝ) ≤ (2 : ℝ) ^ divisorDyadicDepth t ∧
      sqrt (t : ℝ) ≤ ((t / 2 ^ divisorDyadicDepth t : ℕ) : ℝ) := by
  have hloglog : Tendsto (fun t : ℕ ↦ log (log (t : ℝ))) atTop atTop :=
    tendsto_log_atTop.comp (tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)
  have hsmall := ((isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 2)).bound
    (by norm_num : (0 : ℝ) < 1 / 4))
  filter_upwards [eventually_ge_atTop 4, hloglog.eventually_ge_atTop 1,
    tendsto_natCast_atTop_atTop.eventually hsmall] with t ht hLL hsmallt
  have htr : (4 : ℝ) ≤ t := by exact_mod_cast ht
  have htpos : (0 : ℝ) < t := by linarith
  have hlog : 0 < log (t : ℝ) := log_pos (by linarith)
  have hpowers := divisorDyadicDepth_power_bounds hlog (by linarith)
  have hsqrt : 1 ≤ sqrt (t : ℝ) := (Real.one_le_sqrt).mpr (by linarith)
  have hsq := sq_sqrt htpos.le
  have hlogsmall : 4 * log (t : ℝ) ≤ sqrt (t : ℝ) := by
    rw [Real.norm_eq_abs, abs_of_pos hlog, Real.norm_eq_abs,
      abs_of_nonneg (rpow_nonneg htpos.le _), ← sqrt_eq_rpow] at hsmallt
    linarith
  have hceil : (⌈sqrt (t : ℝ)⌉₊ : ℝ) ≤ 2 * sqrt (t : ℝ) := by
    have h := Nat.ceil_lt_add_one (sqrt_nonneg (t : ℝ))
    linarith
  have hprod : (⌈sqrt (t : ℝ)⌉₊ : ℝ) * (2 : ℝ) ^ divisorDyadicDepth t ≤ (t : ℝ) := by
    have hm := mul_le_mul hceil hpowers.2.le (by positivity : 0 ≤ (2 : ℝ) ^ divisorDyadicDepth t)
      (by positivity : 0 ≤ 2 * sqrt (t : ℝ))
    have hs := mul_le_mul_of_nonneg_left hlogsmall (sqrt_nonneg (t : ℝ))
    nlinarith only [hm, hs, hsq]
  have hdiv : ⌈sqrt (t : ℝ)⌉₊ ≤ t / 2 ^ divisorDyadicDepth t := by
    apply (Nat.le_div_iff_mul_le (by positivity : 0 < 2 ^ divisorDyadicDepth t)).mpr
    exact_mod_cast hprod
  refine ⟨by omega, hLL, divisorDyadicDepth_loglog_bound hLL, hpowers.1, ?_⟩
  exact (Nat.le_ceil (sqrt (t : ℝ))).trans (by exact_mod_cast hdiv)

