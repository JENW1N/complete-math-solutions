theorem primeCapped_powerful_mass_eq {P H : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hH : H ⊆ P) (cap a : ℕ → ℕ)
    (hcap : ∀ p ∈ P, 2 ≤ cap p) :
