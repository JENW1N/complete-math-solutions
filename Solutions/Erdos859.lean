section

/- Actual capped-state divisor events are bounded by the canonical powerful convolution. -/

namespace Erdos859Verification

open Finset
open scoped Classical

theorem finiteRadicalEventMass_le_canonical {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) {y : ℝ} (hy : 0≤y) :
    finiteRadicalEventMass P y ≤ fordRadicalMass y :=
  radical_mass_le_canonical hP hy

theorem cappedState_divisor_event_mass_le_powerfulConvolution {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p)
    {y : ℝ} (hy : 0≤y) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦
      FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)),cappedPrimeStateWeight P cap e) ≤
      fordPowerfulConvolution (cappedPowerfulValues P cap) y := by
  unfold fordPowerfulConvolution
  rw [sum_ite]
  simp only [not_le]
  apply (cappedState_divisor_event_mass_truncated hP cap hcap y (Real.sqrt y)).trans
  apply add_le_add _ le_rfl
  apply sum_le_sum
  intro B _
  calc
    (1/(B:ℝ)) * ∑ f∈B.divisors,finiteRadicalEventMass P (y/(f:ℝ)) ≤
        (1/(B:ℝ)) * ∑ f∈B.divisors,fordRadicalMass (y/(f:ℝ)) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact sum_le_sum (fun f _ ↦ finiteRadicalEventMass_le_canonical hP
        (div_nonneg hy (Nat.cast_nonneg f)))
    _ = _ := by ring

theorem cappedState_divisor_event_mass_eventual_upper :
    ∀ᶠ y : ℝ in Filter.atTop, ∀ (P : Finset ℕ) (cap : ℕ → ℕ),
      (∀ p∈P,p.Prime) → (∀ p∈P,2≤cap p) →
      (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦
        FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)),cappedPrimeStateWeight P cap e) ≤
        fordPowerfulConvolutionEnvelope y := by
  filter_upwards [fordPowerfulConvolution_eventual_upper, Filter.eventually_ge_atTop 0]
    with y hconvolution hy
  intro P cap hP hcap
  exact (cappedState_divisor_event_mass_le_powerfulConvolution hP cap hcap hy).trans
    (hconvolution _ (cappedPowerfulValues_powerful hP cap))


