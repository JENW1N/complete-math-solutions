/- Inlined development module: PrimeCorrelation.lean -/

section

/- Positive association of the original and tilted finite prime laws. -/

open Finset
open scoped FinsetFamily

namespace Erdos859Verification

theorem primePatternWeight_modular (P S T : Finset ℕ) :
    primePatternWeight P S * primePatternWeight P T =
      primePatternWeight P (S ∩ T) * primePatternWeight P (S ∪ T) := by
  classical
  unfold primePatternWeight
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro p _
  by_cases hS : p ∈ S <;> by_cases hT : p ∈ T <;> simp [hS, hT, mul_comm]

/-- The powerset form of FKG, stated directly for finite expectations. -/
theorem powerset_positive_association (P : Finset ℕ) (w f g : Finset ℕ → ℝ)
    (hw : ∀ T, 0 ≤ w T) (hf0 : ∀ T, 0 ≤ f T) (hg0 : ∀ T, 0 ≤ g T)
    (hf : Monotone f) (hg : Monotone g)
    (hmod : ∀ S T, w S * w T ≤ w (S ∩ T) * w (S ∪ T))
    (hnorm : ∑ T ∈ P.powerset, w T = 1) :
    (∑ T ∈ P.powerset, w T * f T) * (∑ T ∈ P.powerset, w T * g T) ≤
      ∑ T ∈ P.powerset, w T * (f T * g T) := by
  have h := P.four_functions_theorem
    (f₁ := fun T ↦ w T * f T) (f₂ := fun T ↦ w T * g T)
    (f₃ := w) (f₄ := fun T ↦ w T * (f T * g T))
    (fun T ↦ mul_nonneg (hw T) (hf0 T))
    (fun T ↦ mul_nonneg (hw T) (hg0 T)) hw
    (fun T ↦ mul_nonneg (hw T) (mul_nonneg (hf0 T) (hg0 T)))
    (fun {S} _ {T} _ ↦ show (w S * f S) * (w T * g T) ≤
      w (S ∩ T) * (w (S ∪ T) * (f (S ∪ T) * g (S ∪ T))) from ?_)
    (𝒜 := P.powerset) (ℬ := P.powerset) subset_rfl subset_rfl
  · simpa only [powerset_infs_powerset_self, powerset_sups_powerset_self,
      hnorm, one_mul] using h
  · calc
      _ = (w S * w T) * (f S * g T) := by ring
      _ ≤ (w (S ∩ T) * w (S ∪ T)) * (f (S ∪ T) * g (S ∪ T)) :=
        mul_le_mul (hmod S T)
          (mul_le_mul (hf subset_union_left) (hg subset_union_right) (hg0 T) (hf0 _))
          (mul_nonneg (hf0 S) (hg0 T)) (mul_nonneg (hw _) (hw _))
      _ = _ := by ring

theorem prime_positive_association {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (f g : Finset ℕ → ℝ)
    (hf0 : ∀ T, 0 ≤ f T) (hg0 : ∀ T, 0 ≤ g T)
    (hf : Monotone f) (hg : Monotone g) :
    (∑ T ∈ P.powerset, primePatternWeight P T * f T) *
      (∑ T ∈ P.powerset, primePatternWeight P T * g T) ≤
      ∑ T ∈ P.powerset, primePatternWeight P T * (f T * g T) :=
  powerset_positive_association P (primePatternWeight P) f g
    (fun T ↦ (primePatternWeight_pos hP T).le) hf0 hg0 hf hg
    (fun S T ↦ (primePatternWeight_modular P S T).le) (sum_primePatternWeight P)

theorem primeTiltWeight_modular (P S T : Finset ℕ) (lam : ℝ) :
    primeTiltWeight P lam S * primeTiltWeight P lam T =
      primeTiltWeight P lam (S ∩ T) * primeTiltWeight P lam (S ∪ T) := by
  unfold primeTiltWeight
  have hcard : S.card + T.card = (S ∩ T).card + (S ∪ T).card := by
    have := card_union_add_card_inter S T
    omega
  calc
    _ = (primePatternWeight P S * primePatternWeight P T) * lam ^ (S.card + T.card) /
      primeTiltNormalizer P lam ^ 2 := by rw [pow_add]; ring
    _ = (primePatternWeight P (S ∩ T) * primePatternWeight P (S ∪ T)) *
      lam ^ ((S ∩ T).card + (S ∪ T).card) / primeTiltNormalizer P lam ^ 2 := by
        rw [primePatternWeight_modular, hcard]
    _ = _ := by rw [pow_add]; ring

theorem primeTilt_positive_association {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) (f g : Finset ℕ → ℝ)
    (hf0 : ∀ T, 0 ≤ f T) (hg0 : ∀ T, 0 ≤ g T)
    (hf : Monotone f) (hg : Monotone g) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * f T) *
      (∑ T ∈ P.powerset, primeTiltWeight P lam T * g T) ≤
      ∑ T ∈ P.powerset, primeTiltWeight P lam T * (f T * g T) := by
  apply powerset_positive_association P (primeTiltWeight P lam) f g
    _ hf0 hg0 hf hg (fun S T ↦ (primeTiltWeight_modular P S T lam).le)
    (sum_primeTiltWeight hP hlam)
  intro T
  exact div_nonneg (mul_nonneg (primePatternWeight_pos hP T).le (pow_nonneg hlam.le _))
    (primeTiltNormalizer_pos hP hlam).le

end Erdos859Verification

