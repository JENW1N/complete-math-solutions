    ∃ T ∈ P.powerset, dyadicCountVector A k T = n ∧ ¬ DyadicCountFailure A k v r0 D T
  have hevent (T : Finset ℕ) (hT : T ∈ P.powerset) :
      Good (dyadicCountVector A k T) ↔ ¬ DyadicCountFailure A k v r0 D T := by
    constructor
    · rintro ⟨S, _hS, hST, hgood⟩
