theorem coreBallot_head_error_div_upper {k : ℕ} (hk : 0 < k) :
    (coreBallotHeadCount k : ℝ) * log (1 + coreBallotShift k / coreBallotScale k) / k ≤
      2 * ((log 11 + log (k : ℝ)) / sqrt (k : ℝ)) := by
  have hquot : 0 ≤ coreBallotShift k / coreBallotScale k :=
    div_nonneg (coreBallotShift_nonneg k) (coreBallotScale_pos k).le
  have hl : 0 ≤ log (1 + coreBallotShift k / coreBallotScale k) := log_nonneg (by linarith)
  have hm := mul_le_mul (coreBallotHeadCount_le_two_sqrt hk) (coreBallot_log_ratio_upper hk)
    hl (by positivity)
  calc
    _ ≤ (2 * sqrt (k : ℝ) * (log 11 + log (k : ℝ))) / k :=
      div_le_div_of_nonneg_right hm (Nat.cast_nonneg k)
    _ = 2 * (log 11 + log (k : ℝ)) * (sqrt (k : ℝ) / k) := by ring
    _ = _ := by rw [sqrt_div_self']; ring

theorem coreBallot_head_error_div_tendsto :
    Tendsto (fun k : ℕ ↦ (coreBallotHeadCount k : ℝ) *
      log (1 + coreBallotShift k / coreBallotScale k) / k) atTop (𝓝 0) := by
  have hlim : Tendsto (fun k : ℕ ↦ 2 * ((log 11 + log (k : ℝ)) / sqrt (k : ℝ)))
      atTop (𝓝 0) := by
    simpa using (tendsto_const_add_log_nat_div_sqrt (log 11)).const_mul 2
  apply squeeze_zero' _ _ hlim
  · exact Eventually.of_forall fun k ↦ div_nonneg
      (mul_nonneg (Nat.cast_nonneg _) (log_nonneg (by
        have h := div_nonneg (coreBallotShift_nonneg k) (coreBallotScale_pos k).le
        linarith))) (Nat.cast_nonneg k)
  · exact (eventually_gt_atTop 0).mono fun _ hk ↦ coreBallot_head_error_div_upper hk

theorem coreBallot_relative_error_tendsto :
    Tendsto (fun k ↦ virtualPrimeRelativeError (coreBallotScale k)) atTop (𝓝 0) := by
  have h := (coreBallotScale_tendsto.const_div_atTop (2 * primeLogOddsErrorConstant)).div_const (log 2)
  simpa only [virtualPrimeRelativeError, div_div, zero_div] using h

noncomputable def coreBallotError (lam : ℝ) (k : ℕ) : ℝ :=
  2 * lam * primeLogOddsErrorConstant / (coreBallotShift k + coreBallotScale k) +
    (coreBallotHeadCount k : ℝ) * log (1 + coreBallotShift k / coreBallotScale k) + 2 +
      2 * k * virtualPrimeRelativeError (coreBallotScale k)

/-- Every displayed correction to the finite ballot rate is `o(k)`.
The result holds for every fixed real tilt; later applications restrict it to `[1,2]`. -/
theorem coreBallot_error_div_tendsto (lam : ℝ) :
    Tendsto (fun k : ℕ ↦ coreBallotError lam k / k) atTop (𝓝 0) := by
  have hnat : Tendsto (fun k : ℕ ↦ (k : ℝ)) atTop atTop := tendsto_natCast_atTop_atTop
  have hfirst := (coreBallotShift_add_scale_tendsto.const_div_atTop
    (2 * lam * primeLogOddsErrorConstant)).div_atTop hnat
  have hlast : Tendsto (fun k : ℕ ↦
