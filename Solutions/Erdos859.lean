/-- The zero-threshold case follows from almost-everywhere vanishing, so no
positive missing-measure assumption is needed. -/
theorem nonnegative_half_success_probability {mu : Measure ℝ} [IsProbabilityMeasure mu]
    {H : ℝ → ℝ} (hH : Measurable H) (hH0 : ∀ x, 0 ≤ H x)
    (hHi : Integrable H mu) {R : ℝ} (hR : 0 ≤ R)
    (hmean : (∫ x, H x ∂mu) ≤ R / 2) :
    (1 : ℝ) / 2 ≤ mu.real {x | H x ≤ R} := by
  have hgood : MeasurableSet {x | H x ≤ R} := measurableSet_le hH measurable_const
  by_cases hzero : R = 0
  · have hi0 : (∫ x, H x ∂mu) = 0 := by
      apply le_antisymm _ (integral_nonneg hH0)
      simpa only [hzero, zero_div] using hmean
    have hae := (integral_eq_zero_iff_of_nonneg hH0 hHi).mp hi0
    have he : {x | H x ≤ R} ∈ ae mu := by
      filter_upwards [hae] with x hx
      simp only [hx, Pi.zero_apply, hzero, le_refl]
    have hp := (mem_ae_iff_prob_eq_one hgood).mp he
    simp only [Measure.real, hp, ENNReal.toReal_one]
    norm_num
  · have hRpos : 0 < R := lt_of_le_of_ne hR (Ne.symm hzero)
    have hm := mul_meas_ge_le_integral_of_nonneg
      (Filter.Eventually.of_forall hH0) hHi R
    have htail : mu.real {x | R ≤ H x} ≤ (1 : ℝ) / 2 := by
      nlinarith [hm.trans hmean]
    have hcomp : mu.real {x | H x ≤ R}ᶜ ≤ mu.real {x | R ≤ H x} := by
      apply measureReal_mono _ (measure_ne_top _ _)
      intro x hx
      change ¬ H x ≤ R at hx
      exact (lt_of_not_ge hx).le
    have hsum := probReal_add_probReal_compl (μ := mu) hgood
    linarith

theorem translation_hole_filling_success_probability {A : Set ℝ} (hA : MeasurableSet A)
    {a b w : ℝ} (hw : 0 < w) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hfsupp : ∀ g, g ∉ Set.Icc (-w) w → f g = 0)
    (hfbound : ∀ g, f g ≤ 2 / w)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    (1 : ℝ) / 2 ≤ (translationShiftLaw f).real
      {g | remainingHoleMeasure A (Set.Icc (a + w) (b - w)) g ≤
        4 * (volume.real (Set.Icc a b \ A)) ^ 2 / w} := by
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hmain := translation_hole_filling_withDensity hA hw hf hf0 hfsupp hfbound
    (a := a) (b := b)
  apply nonnegative_half_success_probability
    (measurable_remainingHoleMeasure hA measurableSet_Icc)
    (remainingHoleMeasure_nonneg _ _) hmain.1 (by positivity)
  convert hmain.2 using 1
  ring

theorem logUniformPair_hole_success_probability {A : Set ℝ} (hA : MeasurableSet A)
    {a b u w : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    (1 : ℝ) / 2 ≤ (translationShiftLaw (logUniformPairDensity u w)).real
