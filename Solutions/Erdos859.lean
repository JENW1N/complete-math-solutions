    have hwindow := mem_primeLogWindow.mp (hsub hp)
    have hab : max a (u - 1) ≤ u + h := hwindow.2.1.le.trans hwindow.2.2
    have hlow : a ≤ max a (u - 1) := le_max_left _ _
    have hwidth : u + h - max a (u - 1) + 2 * mertensErrorConstant ≤
        h + 1 + 2 * mertensErrorConstant := by
