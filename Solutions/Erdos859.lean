    cappedPrimeValuationWeight p cap e ≤ 1/(p:ℝ)^e := by
  unfold cappedPrimeValuationWeight
  split_ifs
  · rfl
  · exact div_le_div_of_nonneg_right (sub_le_self _ (by positivity)) (by positivity)

