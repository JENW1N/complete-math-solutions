        ((2 * H + 1) ^ Fintype.card ι : ℕ) := by
  classical
  unfold integerSetFourierMean
  rw [proper_signedCubeValueSet_card w hproper]
  congr 1
  simp only [integerSetFourierSum, ContinuousMap.sum_apply, signedCubeValueSet]
  apply sum_image
  intro c hc c' hc' heq
  exact hproper c c' (mem_signedCoefficientBox.mp hc) (mem_signedCoefficientBox.mp hc') heq

end Erdos859Verification

