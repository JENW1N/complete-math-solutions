  obtain ⟨eta, heta, hetac, hsmall⟩ := hfinite N
  refine ⟨eta, heta, hetac, fun n ↦ ?_⟩
  by_cases hn : n < N
  · exact hsmall n hn
  · exact hetac.trans (hN n (by omega))

