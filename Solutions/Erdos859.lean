section

/- Deterministic coverage of real phase arcs by finite rational residue events. -/

namespace Erdos859Verification

open Finset Real

noncomputable def circleNearGrid (F : Set (AddCircle (1 : ℝ))) (q : ℕ) : Finset (Fin q) := by
  classical
  exact univ.filter (fun a ↦ ∃ x ∈ F, dist (circleRationalGridPoint q a) x ≤ 1 / (q : ℝ))

theorem mem_circleNearGrid {F : Set (AddCircle (1 : ℝ))} {q : ℕ} {a : Fin q} :
    a ∈ circleNearGrid F q ↔ ∃ x ∈ F, dist (circleRationalGridPoint q a) x ≤ 1 / (q : ℝ) := by
  classical
  simp only [circleNearGrid, mem_filter, mem_univ, true_and]

def circleGridMul {q : ℕ} (hq : 0 < q) (p : ℕ) (a : Fin q) : Fin q :=
  ⟨(p * a.val) % q, Nat.mod_lt _ hq⟩

theorem circleRationalGridPoint_mul {q : ℕ} (hq : 0 < q) (p : ℕ) (a : Fin q) :
    circleRationalGridPoint q (circleGridMul hq p a) = p • circleRationalGridPoint q a := by
  unfold circleRationalGridPoint circleGridMul
  rw [← mul_nsmul]
  have h := mod_addOrderOf_nsmul (((1 : ℝ) / q : ℝ) : AddCircle (1 : ℝ)) (p * a.val)
  rw [AddCircle.addOrderOf_period_div hq] at h
  simpa only [Nat.mul_comm] using h

theorem circleGridMul_modEq {q : ℕ} (hq : 0 < q) (p : ℕ) (a : Fin q) :
    Nat.ModEq q (p * a.val) (circleGridMul hq p a).val := by
  change (p * a.val) % q = ((p * a.val) % q) % q
  rw [Nat.mod_mod]

theorem unitCircle_dist_nsmul_le (p : ℕ) (x y : AddCircle (1 : ℝ)) :
    dist (p • x) (p • y) ≤ (p : ℝ) * dist x y := by
  rw [dist_eq_norm, dist_eq_norm, ← nsmul_sub]
  exact norm_nsmul_le

theorem mem_circleNearGrid_of_arc {F : Set (AddCircle (1 : ℝ))}
    {U : ℝ} (hU : 1 ≤ U) {q : ℕ} (hq : 0 < q) (a : Fin q)
    {alpha : AddCircle (1 : ℝ)} (halpha : alpha ∈ F)
    (harc : dist alpha (circleRationalGridPoint q a) ≤ 1 / ((q : ℝ) * U)) :
    a ∈ circleNearGrid F q := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  apply mem_circleNearGrid.mpr
  refine ⟨alpha, halpha, ?_⟩
  rw [dist_comm]
  apply harc.trans
  apply one_div_le_one_div_of_le hqR
  nlinarith

theorem circleGridMul_mem_circleNearGrid_of_arc {F : Set (AddCircle (1 : ℝ))}
    {U : ℝ} (hU : 1 ≤ U) {q : ℕ} (hq : 0 < q) (a : Fin q)
    {p : ℕ} (hp : (p : ℝ) ≤ U) {alpha : AddCircle (1 : ℝ)}
    (hpalpha : p • alpha ∈ F)
    (harc : dist alpha (circleRationalGridPoint q a) ≤ 1 / ((q : ℝ) * U)) :
    circleGridMul hq p a ∈ circleNearGrid F q := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hU0 : 0 < U := by linarith
  apply mem_circleNearGrid.mpr
  refine ⟨p • alpha, hpalpha, ?_⟩
  rw [circleRationalGridPoint_mul]
  calc
    _ ≤ (p : ℝ) * dist (circleRationalGridPoint q a) alpha := unitCircle_dist_nsmul_le _ _ _
    _ ≤ (p : ℝ) * (1 / ((q : ℝ) * U)) :=
      mul_le_mul_of_nonneg_left (by simpa only [dist_comm] using harc) (Nat.cast_nonneg p)
    _ ≤ U * (1 / ((q : ℝ) * U)) := mul_le_mul_of_nonneg_right hp (by positivity)
    _ = 1 / (q : ℝ) := by field_simp

def primePhaseArcEvent {m : ℕ} {P : Fin m → Finset ℕ}
    (F : Set (AddCircle (1 : ℝ))) (J : Finset ℕ) (U : ℝ)
    (x : (i : Fin m) → P i) : Prop :=
  ∃ alpha ∈ F, ∃ q ∈ J, ∃ a : Fin q, Nat.Coprime a.val q ∧
    dist alpha (circleRationalGridPoint q a) ≤ 1 / ((q : ℝ) * U) ∧
      ∀ i, (x i).val • alpha ∈ F

theorem primePhaseArcEvent_residue_cover {m : ℕ} (P : Fin m → Finset ℕ)
    (F : Set (AddCircle (1 : ℝ))) (J : Finset ℕ) {U : ℝ} (hU : 1 ≤ U)
    (hq : ∀ q ∈ J, 0 < q) (hP : ∀ i p, p ∈ P i → (p : ℝ) ≤ U)
    (x : (i : Fin m) → P i) (hx : primePhaseArcEvent F J U x) :
    ∃ q ∈ J, ∃ a ∈ circleNearGrid F q, Nat.Coprime a.val q ∧
      ∀ i, ∃ r ∈ circleNearGrid F q, Nat.ModEq q ((x i).val * a.val) r.val := by
  obtain ⟨alpha, halpha, q, hqJ, a, hcop, harc, hmarks⟩ := hx
  refine ⟨q, hqJ, a, mem_circleNearGrid_of_arc hU (hq q hqJ) a halpha harc, hcop, ?_⟩
  intro i
  exact ⟨circleGridMul (hq q hqJ) (x i).val a,
    circleGridMul_mem_circleNearGrid_of_arc hU (hq q hqJ) a
      (hP i (x i).val (x i).property) (hmarks i) harc,
    circleGridMul_modEq (hq q hqJ) (x i).val a⟩

noncomputable def independentPrimePhaseArcMass {m : ℕ} (P : Fin m → Finset ℕ)
    (weight : Fin m → ℕ → ℝ) (F : Set (AddCircle (1 : ℝ))) (J : Finset ℕ) (U : ℝ) : ℝ := by
  classical
  exact ∑ x : (i : Fin m) → P i, finiteProductWeight (fun i p ↦ weight i p.val) x *
    (if primePhaseArcEvent F J U x then 1 else 0)

theorem independentPrimePhaseArcMass_le {m : ℕ}
    (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (F : Set (AddCircle (1 : ℝ))) (J : Finset ℕ) {U : ℝ} (hU : 1 ≤ U)
    (hq : ∀ q ∈ J, 0 < q) (hP : ∀ i p, p ∈ P i → (p : ℝ) ≤ U)
    (C B : ℕ → ℝ) (hB : ∀ q ∈ J, 0 ≤ B q)
    (hcard : ∀ q ∈ J, ((circleNearGrid F q).card : ℝ) ≤ C q)
    (hres : ∀ i q, q ∈ J → ∀ r,
      (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤ B q) :
    independentPrimePhaseArcMass P weight F J U ≤ ∑ q ∈ J, C q * (C q * B q) ^ m := by
  classical
  exact independent_prime_rational_union_bound P weight hw J (circleNearGrid F) C B hB hcard hres
    (primePhaseArcEvent F J U) (primePhaseArcEvent_residue_cover P F J hU hq hP)

theorem proper_cube_independentPhaseArcMass_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H)
    {Y : ℝ} (hY : 0 < Y) (hYH : 32 * (H : ℝ) ≤ Y)
    (hW : 0 < ∑ i, w i) (hscale : 2 ≤ Y * ∑ i, (w i : ℝ))
    {m : ℕ} (P : Fin m → Finset ℕ) (weight : Fin m → ℕ → ℝ)
    (hw : ∀ i p, p ∈ P i → 0 ≤ weight i p)
    (J : Finset ℕ) {U : ℝ} (hU : 1 ≤ U)
    (hq : ∀ q ∈ J, 0 < q) (hP : ∀ i p, p ∈ P i → (p : ℝ) ≤ U)
    (B : ℕ → ℝ) (hB : ∀ q ∈ J, 0 ≤ B q)
    (hres : ∀ i q, q ∈ J → ∀ r,
      (∑ p ∈ (P i).filter (fun p ↦ Nat.ModEq q p r), weight i p) ≤ B q) :
    independentPrimePhaseArcMass P weight {alpha | cubePhaseSquare w alpha ≤ (1 / Y) ^ 2} J U ≤
