theorem ford_powerful_divisor_reciprocal_summable :
    Summable (fun n : ℕ ↦ if FordPowerful n then (n.divisors.card : ℝ) / n else 0) := by
  classical
  apply Summable.of_nonneg_of_le (fun _ ↦ by split_ifs <;> positivity)
      (fun n ↦ ?_) (ford_powerful_indicator_rpow_summable.mul_left ((768 : ℝ) ^ 4))
  by_cases hn : FordPowerful n
  · simpa only [if_pos hn] using ford_divisor_reciprocal_bound hn.1
  · simp only [if_neg hn, mul_zero, le_refl]

noncomputable def fordPowerfulTailConstant : ℝ :=
  1 + ∑' n : ℕ, if FordPowerful n then (n : ℝ) ^ (-3 / 4 : ℝ) else 0

theorem fordPowerfulTailConstant_pos : 0 < fordPowerfulTailConstant := by
  have h : 0 ≤ ∑' n : ℕ, if FordPowerful n then (n : ℝ) ^ (-3 / 4 : ℝ) else 0 :=
    tsum_nonneg (fun _ ↦ by split_ifs <;> positivity)
  unfold fordPowerfulTailConstant
  linarith

