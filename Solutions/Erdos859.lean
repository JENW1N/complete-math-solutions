theorem divisorSumSet_of_dvd {t m n : ℕ} (hmn : m ∣ n) (hn : n ≠ 0)
    (hm : m ∈ Erdos859.DivisorSumSet t) : n ∈ Erdos859.DivisorSumSet t := by
  obtain ⟨S, hS, hsum⟩ := hm
  refine ⟨S, ?_, hsum⟩
  intro d hd
  exact Nat.mem_divisors.mpr ⟨dvd_trans (Nat.mem_divisors.mp (hS hd)).1 hmn, hn⟩

theorem tendsto_mean_congr_eventually {f g : ℕ → ℝ} {a : ℝ}
    (hf : Tendsto (fun N : ℕ ↦ (∑ n ∈ range N, f n) / N) atTop (𝓝 a))
    (hfg : f =ᶠ[atTop] g) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ range N, g n) / N) atTop (𝓝 a) := by
  have hdiff : Tendsto (fun n ↦ g n - f n) atTop (𝓝 0) := by
    apply tendsto_const_nhds.congr'
