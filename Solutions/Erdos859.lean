  by_cases hS : HasPracticalSeed Z (∏ p ∈ S, p)
  · have hT := hS.of_dvd (Finset.prod_dvd_prod_of_subset S T (fun p ↦ p) hST)
    rw [if_pos hS, if_pos hT]
