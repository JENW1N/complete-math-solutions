      ∑ j ∈ range J,
        divisorIntervalDensity (t / 2 ^ (j + 1)) (t / 2 ^ j) := by
  simpa using divisorIntervalDensity_le_sum_chain (fun j ↦ t / 2 ^ j) J

/-- A singleton divisor condition has its usual reciprocal density. -/
theorem divisorCondition_hasDensity {d : ℕ} (hd : 0 < d) :
    {n : ℕ | d ∣ n}.HasDensity (1 / (d : ℝ)) := by
  apply hasDensity_of_indicator_mean (tendsto_mean_dvd_indicator hd)
  exact Filter.Eventually.of_forall (fun n ↦ by simp [Set.indicator_apply])

/-- Rounding a real dyadic interval can add one integer at its upper end.
This lemma separates that one divisor from an exact integer-ratio interval. -/
theorem divisorIntervalDensity_le_double_add {y z : ℕ} (hz : z ≤ 2 * y + 1) :
    divisorIntervalDensity y z ≤
      divisorIntervalDensity y (2 * y) + 1 / ((2 * y + 1 : ℕ) : ℝ) := by
  classical
  let B : ℕ → Set ℕ := fun j ↦
    if j = 0 then DivisorIntervalSet y (2 * y) else {n : ℕ | 2 * y + 1 ∣ n}
  let e : ℕ → ℝ := fun j ↦
    if j = 0 then divisorIntervalDensity y (2 * y) else 1 / ((2 * y + 1 : ℕ) : ℝ)
  have hB : ∀ j ∈ ({0, 1} : Finset ℕ), (B j).HasDensity (e j) := by
    intro j hj
    simp only [mem_insert, mem_singleton] at hj
    rcases hj with rfl | rfl
    · simpa [B, e] using divisorInterval_hasDensity y (2 * y)
    · simpa [B, e] using divisorCondition_hasDensity (by omega : 0 < 2 * y + 1)
  have hc : ∀ n ∈ DivisorIntervalSet y z,
      ∃ j ∈ ({0, 1} : Finset ℕ), n ∈ B j := by
    rintro n ⟨d, hlo, hhi, hd⟩
    by_cases hdy : d ≤ 2 * y
    · exact ⟨0, by simp, by simpa [B] using (show n ∈ DivisorIntervalSet y (2 * y)
          from ⟨d, hlo, hdy, hd⟩)⟩
    · have heq : d = 2 * y + 1 := by omega
      exact ⟨1, by simp, by simpa [B, heq] using hd⟩
  simpa [e] using density_le_sum_of_finite_cover (divisorInterval_hasDensity y z) hB hc

theorem nat_dyadic_quotient_le_double_add (t j : ℕ) :
    t / 2 ^ j ≤ 2 * (t / 2 ^ (j + 1)) + 1 := by
  rw [pow_succ, ← Nat.div_div_eq_div_mul]
  omega

/-- The general divisor interval reduces to fixed-ratio natural intervals and
an explicit harmless correction for every rounded endpoint. -/
theorem divisorIntervalDensity_le_sum_fixed_ratio (t J : ℕ) :
    divisorIntervalDensity (t / 2 ^ J) t ≤
      ∑ j ∈ range J,
        (divisorIntervalDensity (t / 2 ^ (j + 1)) (2 * (t / 2 ^ (j + 1))) +
          1 / ((2 * (t / 2 ^ (j + 1)) + 1 : ℕ) : ℝ)) := by
  apply (divisorIntervalDensity_le_sum_dyadic t J).trans
  exact sum_le_sum (fun j _ ↦ divisorIntervalDensity_le_double_add
    (nat_dyadic_quotient_le_double_add t j))

/-- Combine the exact small-divisor estimate with the finite dyadic reduction.
No analytic divisor-interval bound is assumed here. -/
theorem divisorDensity_le_sum_fixed_ratio (t J : ℕ) (ht : 0 < t) :
    divisorDensity t ≤
      (∑ j ∈ range J,
        (divisorIntervalDensity (t / 2 ^ (j + 1)) (2 * (t / 2 ^ (j + 1))) +
          1 / ((2 * (t / 2 ^ (j + 1)) + 1 : ℕ) : ℝ))) +
        ((t / 2 ^ J : ℕ) : ℝ) / t := by
  exact (divisorDensity_le_intervalDensity_add t (t / 2 ^ J) ht).trans
    (add_le_add (divisorIntervalDensity_le_sum_fixed_ratio t J) le_rfl)

theorem nat_dyadic_quotient_antitone (t : ℕ) : Antitone (fun j : ℕ ↦ t / 2 ^ j) := by
  intro i j hij
  exact Nat.div_le_div_left (Nat.pow_le_pow_right (by omega : 0 < 2) hij) (by positivity)

/-- All rounded-endpoint corrections are bounded using the lowest dyadic
endpoint. -/
theorem sum_dyadic_endpoint_correction_le (t J : ℕ) :
    (∑ j ∈ range J, 1 / ((2 * (t / 2 ^ (j + 1)) + 1 : ℕ) : ℝ)) ≤
      (J : ℝ) / ((2 * (t / 2 ^ J) + 1 : ℕ) : ℝ) := by
  calc
    _ ≤ ∑ _j ∈ range J, 1 / ((2 * (t / 2 ^ J) + 1 : ℕ) : ℝ) := by
      apply sum_le_sum
      intro j hj
      apply one_div_le_one_div_of_le (by positivity)
      exact_mod_cast Nat.add_le_add_right
        (Nat.mul_le_mul_left 2 (nat_dyadic_quotient_antitone t (mem_range.mp hj))) 1
    _ = _ := by simp [div_eq_mul_inv]

theorem dyadic_small_divisor_error_le (t J : ℕ) (ht : 0 < t) :
    ((t / 2 ^ J : ℕ) : ℝ) / t ≤ 1 / (2 : ℝ) ^ J := by
  have htR : (0 : ℝ) < t := by exact_mod_cast ht
  calc
    _ ≤ ((t : ℝ) / ((2 ^ J : ℕ) : ℝ)) / t :=
      div_le_div_of_nonneg_right Nat.cast_div_le htR.le
    _ = _ := by push_cast; field_simp

/-- A uniform fixed-ratio estimate on the finitely many dyadic endpoints
implies the needed upper estimate, with both discretization errors explicit. -/
theorem divisorDensity_le_of_uniform_fixed_ratio (t J : ℕ) (ht : 0 < t)
    (B : ℝ)
    (hB : ∀ j < J,
      divisorIntervalDensity (t / 2 ^ (j + 1)) (2 * (t / 2 ^ (j + 1))) ≤ B) :
    divisorDensity t ≤ (J : ℝ) * B +
      (J : ℝ) / ((2 * (t / 2 ^ J) + 1 : ℕ) : ℝ) + 1 / (2 : ℝ) ^ J := by
  have hsum : (∑ j ∈ range J,
      divisorIntervalDensity (t / 2 ^ (j + 1)) (2 * (t / 2 ^ (j + 1)))) ≤
        (J : ℝ) * B := by
    calc
      _ ≤ ∑ _j ∈ range J, B := sum_le_sum (fun j hj ↦ hB j (mem_range.mp hj))
      _ = _ := by simp
  calc
    _ ≤ _ := divisorDensity_le_sum_fixed_ratio t J ht
    _ = (∑ j ∈ range J,
        divisorIntervalDensity (t / 2 ^ (j + 1)) (2 * (t / 2 ^ (j + 1)))) +
        (∑ j ∈ range J, 1 / ((2 * (t / 2 ^ (j + 1)) + 1 : ℕ) : ℝ)) +
        ((t / 2 ^ J : ℕ) : ℝ) / t := by rw [sum_add_distrib]
    _ ≤ _ := add_le_add (add_le_add hsum (sum_dyadic_endpoint_correction_le t J))
