theorem primeTilt_broad_good_count_lower {lam v eps : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hv : log 2 ≤ v) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * mertensErrorConstant ≤ eps * v)
    (n : ℕ) (Good : Finset ℕ → Prop) [DecidablePred Good] {beta eta : ℝ}
    (heta : 0 ≤ eta)
    (hmargin : eta ≤ 1 - beta - (n : ℝ) ^ 2 * (16 * exp (-v) / eps))
    (hbad : (∑ x : Fin n → primeLogWindow v ((1 + eps) * v),
