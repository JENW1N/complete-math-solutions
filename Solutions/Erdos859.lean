theorem integral_finiteIntervalSmoothing_sq_le_collision {ι : Type*} [Fintype ι]
    (w atom : ι → ℝ) {d : ℝ} (hd : 0 < d) (hw : ∀ i, 0 ≤ w i) :
    (∫ y, finiteIntervalSmoothing w atom d y ^ 2) ≤
