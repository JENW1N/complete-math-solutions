    intro p hp hpn
    apply (hp.pow_dvd_iff_le_factorization hn.1).mpr
    have hpos := hp.factorization_pos_of_dvd hn.1 hpn
    have hne := hn.2 p
    omega
  · rintro ⟨hn, h⟩
    refine ⟨hn, ?_⟩
    intro p he
    have hp : p.Prime := by
      by_contra hnot
      have hz := Nat.factorization_eq_zero_of_not_prime n hnot
      omega
    have hpn : p ∣ n := by
      by_contra hnot
      have hz := Nat.factorization_eq_zero_of_not_dvd hnot
      omega
    have htwo := (hp.pow_dvd_iff_le_factorization hn).mp (h p hp hpn)
