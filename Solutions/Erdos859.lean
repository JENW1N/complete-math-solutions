section

/- Reciprocal-prime mass on the logarithmic windows used by the construction. -/

namespace Erdos859Verification

open Real Finset Filter
open scoped Topology

noncomputable def mertensErrorConstant : ℝ := log 4 + 6 + PrimeMertens.E₁

theorem mertensErrorConstant_pos : 0 < mertensErrorConstant := by
  have := PrimeMertens.E₁.nonneg
  have : 0 ≤ log 4 := log_nonneg (by norm_num)
  unfold mertensErrorConstant
  linarith

noncomputable def primeReciprocalSum (x : ℝ) : ℝ :=
  ∑ p ∈ Ioc 0 ⌊x⌋₊ with p.Prime, 1 / (p : ℝ)

theorem primeReciprocalSum_estimate {x : ℝ} (hx : 2 ≤ x) :
    |primeReciprocalSum x - log (log x) - PrimeMertens.M| ≤
      mertensErrorConstant / log x :=
  PrimeMertens.E₂p.abs_le hx

theorem primeReciprocalSum_sub {x y : ℝ} (hxy : x ≤ y) :
    (∑ p ∈ Ioc ⌊x⌋₊ ⌊y⌋₊ with p.Prime, 1 / (p : ℝ)) =
      primeReciprocalSum y - primeReciprocalSum x := by
  have h := sum_Ioc_consecutive (fun p : ℕ ↦ if p.Prime then 1 / (p : ℝ) else 0)
    (Nat.zero_le ⌊x⌋₊) (Nat.floor_mono hxy)
  simp only [← sum_filter] at h
  unfold primeReciprocalSum
  linarith

theorem primeReciprocalInterval_estimate {x y : ℝ}
    (hx : 2 ≤ x) (hxy : x ≤ y) :
    |(∑ p ∈ Ioc ⌊x⌋₊ ⌊y⌋₊ with p.Prime, 1 / (p : ℝ)) -
      log (log y / log x)| ≤
      mertensErrorConstant / log x + mertensErrorConstant / log y := by
  have hxlog : 0 < log x := log_pos (by linarith)
  have hylog : 0 < log y := log_pos (by linarith)
  rw [primeReciprocalSum_sub hxy, log_div hylog.ne' hxlog.ne']
  have heq : primeReciprocalSum y - primeReciprocalSum x -
      (log (log y) - log (log x)) = PrimeMertens.E₂p y - PrimeMertens.E₂p x := by
    unfold PrimeMertens.E₂p primeReciprocalSum
    ring
  rw [heq]
  calc
    _ ≤ |PrimeMertens.E₂p y| + |PrimeMertens.E₂p x| := abs_sub _ _
    _ ≤ _ := by
      have := PrimeMertens.E₂p.abs_le hx
      have := PrimeMertens.E₂p.abs_le (hx.trans hxy)
      change |PrimeMertens.E₂p y| + |PrimeMertens.E₂p x| ≤
        (log 4 + 6 + PrimeMertens.E₁) / log x +
        (log 4 + 6 + PrimeMertens.E₁) / log y
      linarith

noncomputable def primeLogWindowMass (a b : ℝ) : ℝ :=
  ∑ p ∈ Ioc ⌊exp a⌋₊ ⌊exp b⌋₊ with p.Prime, 1 / (p : ℝ)

/-- A fixed ratio of logarithmic endpoints has asymptotically constant
prime reciprocal mass, with an explicit error. -/
theorem primeLogWindowMass_estimate {a b : ℝ}
    (ha : log 2 ≤ a) (hab : a ≤ b) :
    |primeLogWindowMass a b - log (b / a)| ≤ 2 * mertensErrorConstant / a := by
  have ha0 : 0 < a := lt_of_lt_of_le (log_pos (by norm_num)) ha
  have hxa : 2 ≤ exp a := by
    rw [← exp_log (by norm_num : (0 : ℝ) < 2)]
    exact exp_le_exp.mpr ha
  have h := primeReciprocalInterval_estimate hxa (exp_le_exp.mpr hab)
  simp only [log_exp] at h
  calc
    _ ≤ mertensErrorConstant / a + mertensErrorConstant / b := h
    _ ≤ _ := by
      have hdiv : mertensErrorConstant / b ≤ mertensErrorConstant / a :=
        div_le_div_of_nonneg_left mertensErrorConstant_pos.le ha0 hab
      calc
        _ ≤ mertensErrorConstant / a + mertensErrorConstant / a := add_le_add le_rfl hdiv
        _ = 2 * mertensErrorConstant / a := by ring

end Erdos859Verification

