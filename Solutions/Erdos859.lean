has thickened subset-sum support of measure comparable to the top log scale. -/
theorem dyadicPrimeMark_positive_support {ι : Type*}
    [Fintype ι] [DecidableEq ι] {k : ℕ} (band : ι → Fin k)
    {A b d eps D : ℝ} (ha : log 2 ≤ A)
    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d) (heps : 0 < eps)
    (hbarrier : ∀ j : Fin k,
      (1 + eps) * ((k - 1 - j.val : ℕ) : ℝ) - D ≤
        ((univ.filter (fun i ↦ j < band i)).card : ℝ))
    (htotal : (k : ℝ) - D ≤ Fintype.card ι) :
    (1 : ℝ) / 2 ≤
      ∑ x : ∀ i, DyadicPrimeMark A (band i).val with
        (A * (2 : ℝ) ^ k) / (2 * dyadicPrimeEnergyConstant b eps D) ≤
          volume.real (finiteIntervalSupport
            (finiteSubsetSumAtom
              (fun i (p : DyadicPrimeMark A (band i).val) ↦ log (p : ℕ)) x) d),
        finiteProductWeight (fun i ↦ dyadicPrimeMarkWeight A (band i).val) x := by
  classical
  let mark := fun i (p : DyadicPrimeMark A (band i).val) ↦ log (p : ℕ)
  let w := fun i ↦ dyadicPrimeMarkWeight A (band i).val
  let X : ℝ := A * (2 : ℝ) ^ k
  let C : ℝ := dyadicPrimeEnergyConstant b eps D
  have hX : 0 < X := by
    dsimp [X]
    positivity [(log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha]
  have hC : 0 < C := dyadicPrimeEnergyConstant_pos hb heps
  have hW : ∀ x : ∀ i, DyadicPrimeMark A (band i).val, 0 ≤ finiteProductWeight w x :=
    finiteProductWeight_nonneg
      (fun i ↦ (dyadicPrimeMarkWeight_normalized ha hlarge (band i).val).1)
  have hnorm : (∑ x : ∀ i, DyadicPrimeMark A (band i).val, finiteProductWeight w x) = 1 :=
    sum_finiteProductWeight w
      (fun i ↦ (dyadicPrimeMarkWeight_normalized ha hlarge (band i).val).2)
  have henergy : (∑ x : ∀ i, DyadicPrimeMark A (band i).val,
      finiteProductWeight w x * finiteSubsetSumEnergy mark x d) ≤ C / X :=
    dyadicPrimeMark_expected_energy_bound band ha hlarge hb hd hscale heps hbarrier htotal
  have hgood := finite_support_good_weight_ge univ (finiteProductWeight w)
    (fun x ↦ finiteSubsetSumEnergy mark x d)
    (fun x ↦ volume.real (finiteIntervalSupport (finiteSubsetSumAtom mark x) d))
    (show (0 : ℝ) < 2 by norm_num) (div_pos hC hX)
    (fun x _ ↦ hW x) (fun x _ ↦ finiteSubsetSumEnergy_nonneg mark x d)
    (fun _ _ ↦ measureReal_nonneg)
    (fun x _ ↦ finiteSubsetSum_support_energy mark x (zero_lt_one.trans_le hd))
    hnorm henergy
  have hthreshold : 1 / (2 * (C / X)) = X / (2 * C) := by
    field_simp
  norm_num only [hthreshold] at hgood
  exact hgood

theorem finiteSubsetSumAtom_nonneg {ι : Type*} [Fintype ι]
    {α : ι → Type*} (mark : ∀ i, α i → ℝ) (x : ∀ i, α i)
    (hmark : ∀ i, 0 ≤ mark i (x i)) (b : ι → Bool) :
    0 ≤ finiteSubsetSumAtom mark x b := by
  apply sum_nonneg
  intro i _
  split_ifs
  · exact hmark i
  · exact le_rfl

theorem finiteSubsetSumAtom_le_total {ι : Type*} [Fintype ι]
    {α : ι → Type*} (mark : ∀ i, α i → ℝ) (x : ∀ i, α i)
    (hmark : ∀ i, 0 ≤ mark i (x i)) (b : ι → Bool) :
    finiteSubsetSumAtom mark x b ≤ ∑ i, mark i (x i) := by
  apply sum_le_sum
  intro i _
  split_ifs
  · exact le_rfl
  · exact hmark i

theorem finiteSubsetSumSupport_subset_Icc {ι : Type*} [Fintype ι]
    {α : ι → Type*} (mark : ∀ i, α i → ℝ) (x : ∀ i, α i)
    (hmark : ∀ i, 0 ≤ mark i (x i)) (d : ℝ) :
    finiteIntervalSupport (finiteSubsetSumAtom mark x) d ⊆
      Set.Icc 0 ((∑ i, mark i (x i)) + d) :=
  finiteIntervalSupport_subset_Icc _ d 0 _ (finiteSubsetSumAtom_nonneg mark x hmark)
    (fun b ↦ add_le_add (finiteSubsetSumAtom_le_total mark x hmark b) le_rfl)

end Erdos859Verification

