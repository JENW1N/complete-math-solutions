noncomputable def fordLogDenominator (x : ℝ) (S : Finset ℕ) : ℝ :=
  log (((S.sup id : ℕ) : ℝ) + x / (∏ p ∈ S, (p : ℝ)))

theorem fordLogDenominator_mark {P S : Finset ℕ} (hS : S ⊆ P)
    (hP : ∀ p ∈ P, p.Prime) {x : ℝ} (hx : 0 ≤ x) {p : ℕ} (hp : p ∈ S) :
    log (p : ℝ) ≤ fordLogDenominator x S := by
  have hprod : 0 < ∏ q ∈ S, (q : ℝ) := prod_pos fun q hq ↦ by
    exact_mod_cast (hP q (hS hq)).pos
  have hmax : (p : ℝ) ≤ ((S.sup id : ℕ) : ℝ) := by
    exact_mod_cast (Finset.le_sup (f := id) hp)
  apply log_le_log (by exact_mod_cast (hP p (hS hp)).pos)
  exact hmax.trans (le_add_of_nonneg_right (div_nonneg hx hprod.le))

theorem fordLogDenominator_sum {P S : Finset ℕ} (hS : S ⊆ P)
    (hP : ∀ p ∈ P, p.Prime) {x : ℝ} (hx : 0 < x) :
    log x ≤ fordLogDenominator x S + ∑ p ∈ S, log (p : ℝ) := by
  have hprod : 0 < ∏ q ∈ S, (q : ℝ) := prod_pos fun q hq ↦ by
    exact_mod_cast (hP q (hS hq)).pos
  have hlow : x / (∏ q ∈ S, (q : ℝ)) ≤ ((S.sup id : ℕ) : ℝ) + x / (∏ q ∈ S, (q : ℝ)) :=
    le_add_of_nonneg_left (Nat.cast_nonneg _)
  have hlog := log_le_log (div_pos hx hprod) hlow
  rw [log_div hx.ne' hprod.ne', log_prod (fun q hq ↦ by
    exact_mod_cast (hP q (hS hq)).ne_zero)] at hlog
  change log x ≤ log (((S.sup id : ℕ) : ℝ) + x / (∏ q ∈ S, (q : ℝ))) + ∑ q ∈ S, log (q : ℝ)
  linarith

/-- The logarithmic denominator in the largest-prime localization is now
removed at an explicit uniform constant cost. -/
theorem fordSupport_actual_denominator_reduction {P : Finset ℕ} {x : ℝ}
    (hx : 2 ≤ x) (hP : ∀ p ∈ P, p.Prime) (hPx : ∀ p ∈ P, (p : ℝ) ≤ x) (d : ℝ) :
    insertionWeightedSum P fordPrimeOdds
      (fun S ↦ volume.real (primeSubsetSumSupport S d) / fordLogDenominator x S ^ 2) ≤
      ((16 + 32 * fordFourthMomentConstant * fordLogMomentConstant) / (log x) ^ 2) *
        insertionWeightedSum P fordPrimeOdds (fun S ↦ volume.real (primeSubsetSumSupport S d)) :=
  fordSupport_denominator_reduction hx hP hPx d (fordLogDenominator x)
    (fun _ hS _ hp ↦ fordLogDenominator_mark hS hP (by linarith) hp)
    (fun _ hS ↦ fordLogDenominator_sum hS hP (by linarith))

