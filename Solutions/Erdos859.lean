theorem proper_cube_exact_grid_card_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H)
    {Y : ℝ} (hY : 0 < Y) (hYH : 32 * (H : ℝ) ≤ Y)
    (hW : 0 < ∑ i, w i) (hscale : 2 ≤ Y * ∑ i, (w i : ℝ))
    {q : ℕ} (hq : 0 < q) (S : Finset (Fin q))
    (hS : ∀ a ∈ S, cubePhaseSquare w (circleRationalGridPoint q a) ≤ (1 / Y) ^ 2) :
    (S.card : ℝ) ≤ 2 * ((q : ℝ) + Y * ∑ i, (w i : ℝ)) /
      (2 * (H : ℝ) + 1) ^ Fintype.card ι := by
  have hWR : (0 : ℝ) < ∑ i, (w i : ℝ) := by exact_mod_cast hW
  have hd : 0 < 1 / (Y * ∑ i, (w i : ℝ)) := by positivity
  have hdhalf : 1 / (Y * ∑ i, (w i : ℝ)) ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) hscale
  have h := circleRationalGrid_card_neighborhood_le hq S hd hdhalf
    {x | cubePhaseSquare w x ≤ (1 / Y) ^ 2} hS
  have hm := proper_cube_smallPhase_neighborhood_measure w hproper hY hYH hW
  change AddCircle.haarAddCircle.real
    (circleClosedNeighborhood {x | cubePhaseSquare w x ≤ (1 / Y) ^ 2}
      (1 / (Y * ∑ i, (w i : ℝ)))) ≤ _ at hm
  have hM : 0 < (2 * (H : ℝ) + 1) ^ Fintype.card ι := by positivity
  calc
    _ ≤ ((q : ℝ) + Y * ∑ i, (w i : ℝ)) *
        (16 / (9 * (2 * (H : ℝ) + 1) ^ Fintype.card ι)) := by
      apply h.trans
      simpa only [one_div_one_div] using mul_le_mul_of_nonneg_left hm
        (show 0 ≤ (q : ℝ) + 1 / (1 / (Y * ∑ i, (w i : ℝ))) by positivity)
    _ ≤ _ := by
      apply (le_div_iff₀ hM).mpr
      have heq : (((q : ℝ) + Y * ∑ i, (w i : ℝ)) *
          (16 / (9 * (2 * (H : ℝ) + 1) ^ Fintype.card ι))) *
            (2 * (H : ℝ) + 1) ^ Fintype.card ι =
          (16 / 9) * ((q : ℝ) + Y * ∑ i, (w i : ℝ)) := by field_simp
      rw [heq]
      have hn : 0 ≤ (q : ℝ) + Y * ∑ i, (w i : ℝ) := by positivity
      nlinarith

theorem proper_cube_near_grid_card_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H)
    {Y : ℝ} (hY : 0 < Y) (hYH : 32 * (H : ℝ) ≤ Y)
    (hW : 0 < ∑ i, w i) (hscale : 2 ≤ Y * ∑ i, (w i : ℝ))
    {q : ℕ} (hq : 0 < q) (S : Finset (Fin q))
    (hS : ∀ a ∈ S, ∃ x : AddCircle (1 : ℝ),
      cubePhaseSquare w x ≤ (1 / Y) ^ 2 ∧
        dist (circleRationalGridPoint q a) x ≤ 1 / (q : ℝ)) :
    (S.card : ℝ) ≤ 6 * ((q : ℝ) + Y * ∑ i, (w i : ℝ)) /
