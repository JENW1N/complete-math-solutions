    apply (show Tendsto (fun k ↦ 2 * virtualPrimeRelativeError (coreBallotScale k))
      atTop (𝓝 0) by simpa using coreBallot_relative_error_tendsto.const_mul 2).congr'
    filter_upwards [eventually_gt_atTop 0] with k hk
    have hkR : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
    field_simp
