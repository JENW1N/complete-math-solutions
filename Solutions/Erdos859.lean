    have hm := mul_le_mul_of_nonneg_right hlin (sq_nonneg ((j : ℝ) + 2))
    have hm2 := mul_le_mul_of_nonneg_right hb2
      (pow_nonneg (show (0 : ℝ) ≤ j + 2 by positivity) 3)
    nlinarith only [hm, hm2]
  · have hb0 : b ≤ 0 := le_of_not_ge hb
    rw [max_eq_left hb0]
    have hlin : (j : ℝ) + 2 - b ≤ (1 - b) * ((j : ℝ) + 2) := by nlinarith
    have hsq : ((j : ℝ) + 2 - b) ^ 2 ≤ ((1 - b) * ((j : ℝ) + 2)) ^ 2 :=
