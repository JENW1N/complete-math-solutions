  have hWR : (0 : ℝ) < ∑ i, (w i : ℝ) := by exact_mod_cast hW
  have hd : 0 < 1 / (Y * ∑ i, (w i : ℝ)) := by positivity
  have hdhalf : 1 / (Y * ∑ i, (w i : ℝ)) ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) hscale
  have h := circleRationalGrid_near_card_neighborhood_le hq S hd hdhalf
    {x | cubePhaseSquare w x ≤ (1 / Y) ^ 2} hS
  have hm := proper_cube_smallPhase_neighborhood_measure w hproper hY hYH hW
  change AddCircle.haarAddCircle.real
    (circleClosedNeighborhood {x | cubePhaseSquare w x ≤ (1 / Y) ^ 2}
      (1 / (Y * ∑ i, (w i : ℝ)))) ≤ _ at hm
  have hM : 0 < (2 * (H : ℝ) + 1) ^ Fintype.card ι := by positivity
  have hmul := mul_le_mul_of_nonneg_left hm
    (show 0 ≤ 2 * (q : ℝ) + 3 / (1 / (Y * ∑ i, (w i : ℝ))) by positivity)
  have hid : 3 / (1 / (Y * ∑ i, (w i : ℝ))) = 3 * (Y * ∑ i, (w i : ℝ)) := by
    simp only [div_eq_mul_inv, one_mul, inv_inv]
  rw [hid] at hmul
  calc
    _ ≤ (2 * (q : ℝ) + 3 * (Y * ∑ i, (w i : ℝ))) *
        (16 / (9 * (2 * (H : ℝ) + 1) ^ Fintype.card ι)) := by
      exact h.trans (by simpa only [hid] using hmul)
    _ ≤ _ := by
      apply (le_div_iff₀ hM).mpr
      have heq : ((2 * (q : ℝ) + 3 * (Y * ∑ i, (w i : ℝ))) *
          (16 / (9 * (2 * (H : ℝ) + 1) ^ Fintype.card ι))) *
            (2 * (H : ℝ) + 1) ^ Fintype.card ι =
          (16 / 9) * (2 * (q : ℝ) + 3 * (Y * ∑ i, (w i : ℝ))) := by field_simp
      rw [heq]
      have hn : 0 ≤ Y * ∑ i, (w i : ℝ) := by positivity
      have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg q
      nlinarith

/-- A reduced numerator permutes residue fibers; this proof needs no chosen inverse. -/
theorem finite_weighted_mul_residue_le (P : Finset ℕ) (weight : ℕ → ℝ)
    {a q : ℕ} (hcop : Nat.Coprime a q) {B : ℝ} (hB : 0 ≤ B)
    (hw : ∀ p ∈ P, 0 ≤ weight p)
    (hres : ∀ r : ℕ, (∑ p ∈ P.filter (fun p ↦ Nat.ModEq q p r), weight p) ≤ B)
    (r : ℕ) :
    (∑ p ∈ P.filter (fun p ↦ Nat.ModEq q (p * a) r), weight p) ≤ B := by
  classical
  by_cases hex : ∃ p ∈ P, Nat.ModEq q (p * a) r
  · obtain ⟨p₀, hp₀, hr₀⟩ := hex
    apply le_trans _ (hres p₀)
    apply sum_le_sum_of_subset_of_nonneg
    · intro p hp
      refine mem_filter.mpr ⟨(mem_filter.mp hp).1, ?_⟩
      exact Nat.ModEq.cancel_right_of_coprime hcop.symm.gcd_eq_one
        ((mem_filter.mp hp).2.trans hr₀.symm)
    · intro p hp _
      exact hw p (mem_filter.mp hp).1
  · have hempty : P.filter (fun p ↦ Nat.ModEq q (p * a) r) = ∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro p hp
      exact hex ⟨p, (mem_filter.mp hp).1, (mem_filter.mp hp).2⟩
    simpa only [hempty, sum_empty] using hB

theorem finite_weighted_mul_residues_le (P : Finset ℕ) (weight : ℕ → ℝ)
    {a q : ℕ} (hcop : Nat.Coprime a q) {B : ℝ} (hB : 0 ≤ B)
    (hw : ∀ p ∈ P, 0 ≤ weight p)
    (hres : ∀ r : ℕ, (∑ p ∈ P.filter (fun p ↦ Nat.ModEq q p r), weight p) ≤ B)
    (S : Finset (Fin q)) :
    (∑ p ∈ P.filter (fun p ↦ ∃ r ∈ S, Nat.ModEq q (p * a) r.val), weight p) ≤
      (S.card : ℝ) * B := by
  classical
  have hu := finite_weighted_union_bound_general P S weight hw
    (fun r p ↦ Nat.ModEq q (p * a) r.val)
  simp only [mul_ite, mul_one, mul_zero, ← sum_filter] at hu
  calc
    _ ≤ ∑ r ∈ S, ∑ p ∈ P.filter (fun p ↦ Nat.ModEq q (p * a) r.val), weight p := hu
    _ ≤ ∑ _r ∈ S, B := sum_le_sum (fun r _ ↦
      finite_weighted_mul_residue_le P weight hcop hB hw hres r.val)
    _ = _ := by simp

theorem primeLogOddsMark_broad_residue_upper {lam v eps : ℝ} {q a : ℕ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hv : log 2 ≤ v) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * mertensErrorConstant ≤ eps * v) (hq : 0 < q) :
    (∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ Nat.ModEq q p a),
      primeLogOddsMarkWeight lam v ((1 + eps) * v) p) ≤
        16 * v / (q : ℝ) + 16 * exp (-v) / eps := by
  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  have hvb : v ≤ (1 + eps) * v := by nlinarith
  have hmass := primeLogOddsIntensity_broad_mass_lower hlam hlam2 hv heps heps1 hlarge
  have hmasspos : 0 < ∑ p ∈ primeLogWindow v ((1 + eps) * v), primeLogOddsIntensity lam p :=
    (by positivity : 0 < eps / 4).trans_le hmass
  have hnum : (∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ Nat.ModEq q p a),
      primeLogOddsIntensity lam p) ≤ 4 * (exp (-v) + ((1 + eps) * v - v) / (q : ℝ)) := by
    calc
      _ ≤ ∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ Nat.ModEq q p a),
          4 / (p : ℝ) := sum_le_sum (fun p hp ↦
            (primeLogOddsIntensity_bounds hlam hlam2 (mem_primeLogWindow.mp (mem_filter.mp hp).1).1).2)
      _ = 4 * ∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ Nat.ModEq q p a),
          1 / (p : ℝ) := by simp only [mul_one_div, mul_sum]
      _ ≤ _ := mul_le_mul_of_nonneg_left (primeLogWindow_residue_mass_upper hq hvb) (by norm_num)
  simp only [primeLogOddsMarkWeight, ← sum_div]
  calc
    _ ≤ (4 * (exp (-v) + ((1 + eps) * v - v) / (q : ℝ))) /
        (∑ p ∈ primeLogWindow v ((1 + eps) * v), primeLogOddsIntensity lam p) :=
      div_le_div_of_nonneg_right hnum hmasspos.le
    _ ≤ (4 * (exp (-v) + ((1 + eps) * v - v) / (q : ℝ))) / (eps / 4) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) hmass
    _ = _ := by field_simp; ring

theorem proper_cube_near_grid_logOddsMark_weight_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H)
    {Y : ℝ} (hY : 0 < Y) (hYH : 32 * (H : ℝ) ≤ Y)
    (hW : 0 < ∑ i, w i) (hscale : 2 ≤ Y * ∑ i, (w i : ℝ))
    {q a : ℕ} (hq : 0 < q) (hcop : Nat.Coprime a q) (S : Finset (Fin q))
    (hS : ∀ r ∈ S, ∃ x : AddCircle (1 : ℝ),
      cubePhaseSquare w x ≤ (1 / Y) ^ 2 ∧
        dist (circleRationalGridPoint q r) x ≤ 1 / (q : ℝ))
