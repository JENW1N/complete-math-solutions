      intro p hp
      obtain ⟨hpband, hpinterval⟩ := mem_filter.mp hp
      obtain ⟨hpprime, hpa, _hpb⟩ := mem_primeLogWindow.mp hpband
      exact mem_primeLogWindow.mpr ⟨hpprime, max_lt hpa (by linarith [hpinterval.1]),
        hpinterval.2⟩
