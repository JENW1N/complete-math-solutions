/- Inlined development module: PrimePartitionLaw.lean -/

section

/- Exact factorization of the selected-prime law over disjoint finite bands. -/

open Finset

namespace Erdos859Verification

def primeBandUnion {ι : Type*} [Fintype ι] (P : ι → Finset ℕ) : Finset ℕ :=
  univ.biUnion P

def primeBandSelections {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) : Finset (ι → Finset ℕ) :=
  Fintype.piFinset (fun j ↦ (P j).powerset)

theorem mem_primeBandSelections {ι : Type*} [Fintype ι] [DecidableEq ι]
    {P : ι → Finset ℕ} {U : ι → Finset ℕ} :
    U ∈ primeBandSelections P ↔ ∀ j, U j ⊆ P j := by
  simp [primeBandSelections]

theorem primeBand_intersections_union {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) {T : Finset ℕ} (hT : T ⊆ primeBandUnion P) :
    univ.biUnion (fun j ↦ T ∩ P j) = T := by
  ext p
  constructor
  · intro hp
    obtain ⟨j, _, hj⟩ := mem_biUnion.mp hp
    exact (mem_inter.mp hj).1
  · intro hp
    obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp (hT hp)
    exact mem_biUnion.mpr ⟨j, hj, mem_inter.mpr ⟨hp, hpj⟩⟩

theorem primeBand_union_subset {ι : Type*} [Fintype ι]
    {P U : ι → Finset ℕ} (hU : ∀ j, U j ⊆ P j) :
    univ.biUnion U ⊆ primeBandUnion P := by
  intro p hp
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  exact mem_biUnion.mpr ⟨j, hj, hU j hpj⟩

theorem primeBand_union_inter {ι : Type*} [Fintype ι]
    {P U : ι → Finset ℕ} (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (hU : ∀ j, U j ⊆ P j) (j : ι) :
    univ.biUnion U ∩ P j = U j := by
  classical
  ext p
  constructor
  · intro hp
    obtain ⟨hpU, hpP⟩ := mem_inter.mp hp
    obtain ⟨i, _, hpi⟩ := mem_biUnion.mp hpU
    have hij : i = j := by
      by_contra hne
      exact disjoint_left.mp (hdis hne) (hU i hpi) hpP
    subst i
    exact hpi
  · intro hp
    exact mem_inter.mpr ⟨mem_biUnion.mpr ⟨j, mem_univ j, hp⟩, hU j hp⟩

/-- Intersection with the bands and union of band selections are inverse
reindexings of the two finite configuration spaces. -/
theorem sum_powerset_primeBand_partition {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (F : (ι → Finset ℕ) → ℝ) :
    (∑ T ∈ (primeBandUnion P).powerset, F (fun j ↦ T ∩ P j)) =
      ∑ U ∈ primeBandSelections P, F U := by
  classical
  apply sum_bij (fun T _ ↦ fun j ↦ T ∩ P j)
  · intro T _
    exact mem_primeBandSelections.mpr (fun _ ↦ inter_subset_right)
  · intro S hS T hT heq
    have hu := congrArg (fun U : ι → Finset ℕ ↦ univ.biUnion U) heq
    simpa only [primeBand_intersections_union P (mem_powerset.mp hS),
      primeBand_intersections_union P (mem_powerset.mp hT)] using hu
  · intro U hU
    have hsub := mem_primeBandSelections.mp hU
    refine ⟨univ.biUnion U, mem_powerset.mpr (primeBand_union_subset hsub), ?_⟩
    funext j
    exact primeBand_union_inter hdis hsub j
  · intro T _
    rfl

theorem primePatternWeight_primeBand_partition {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (T : Finset ℕ) :
    primePatternWeight (primeBandUnion P) T =
      ∏ j, primePatternWeight (P j) (T ∩ P j) := by
  unfold primePatternWeight primeBandUnion
  rw [prod_biUnion (fun i _ j _ hij ↦ hdis hij)]
  apply prod_congr rfl
  intro j _
  apply prod_congr rfl
  intro p hp
  simp [hp]

theorem primeTiltNormalizer_primeBand_partition {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (lam : ℝ) :
    primeTiltNormalizer (primeBandUnion P) lam = ∏ j, primeTiltNormalizer (P j) lam := by
  exact prod_biUnion (fun i _ j _ hij ↦ hdis hij)

theorem card_primeBand_intersections {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    {T : Finset ℕ} (hT : T ⊆ primeBandUnion P) :
    T.card = ∑ j, (T ∩ P j).card := by
  calc
    T.card = (univ.biUnion (fun j ↦ T ∩ P j)).card :=
      congrArg Finset.card (primeBand_intersections_union P hT).symm
    _ = _ := card_biUnion (fun i _ j _ hij ↦
      Disjoint.mono inter_subset_right inter_subset_right (hdis hij))

/-- The exact tilted weight factors over a disjoint band partition. This
identity is algebraic and needs no primality or positivity hypotheses. -/
theorem primeTiltWeight_primeBand_partition {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    {T : Finset ℕ} (hT : T ⊆ primeBandUnion P) (lam : ℝ) :
    primeTiltWeight (primeBandUnion P) lam T =
      ∏ j, primeTiltWeight (P j) lam (T ∩ P j) := by
  simp only [primeTiltWeight, prod_div_distrib, prod_mul_distrib]
  rw [primePatternWeight_primeBand_partition P hdis,
    primeTiltNormalizer_primeBand_partition P hdis,
    card_primeBand_intersections P hdis hT, prod_pow_eq_pow_sum]

/-- The ambient selected-prime law is exactly the product of the per-band
laws, for every observable of the vector of band intersections. -/
theorem prime_tilt_expectation_primeBand_partition {ι : Type*}
    [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (lam : ℝ) (F : (ι → Finset ℕ) → ℝ) :
    (∑ T ∈ (primeBandUnion P).powerset, primeTiltWeight (primeBandUnion P) lam T *
      F (fun j ↦ T ∩ P j)) =
        ∑ U ∈ primeBandSelections P, (∏ j, primeTiltWeight (P j) lam (U j)) * F U := by
  calc
    _ = ∑ T ∈ (primeBandUnion P).powerset,
        (∏ j, primeTiltWeight (P j) lam (T ∩ P j)) * F (fun j ↦ T ∩ P j) := by
      apply sum_congr rfl
      intro T hT
      rw [primeTiltWeight_primeBand_partition P hdis (mem_powerset.mp hT)]
    _ = _ := sum_powerset_primeBand_partition P hdis
      (fun U ↦ (∏ j, primeTiltWeight (P j) lam (U j)) * F U)

theorem primeBandSelections_filter_card {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) :
    (primeBandSelections P).filter (fun U ↦ ∀ j, (U j).card = n j) =
      Fintype.piFinset (fun j ↦ (P j).powerset.filter (fun T ↦ T.card = n j)) := by
  classical
  ext U
  simp [primeBandSelections, forall_and]

/-- The partition identity with an entire prescribed vector of band counts.
The right-hand domain is definitionally the `bandCardSelections` domain
used by the fixed-count tuple comparison. -/
theorem prime_tilt_fixedCounts_expectation_partition {ι : Type*}
    [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    (lam : ℝ) (n : ι → ℕ) (F : (ι → Finset ℕ) → ℝ) :
    (∑ T ∈ (primeBandUnion P).powerset.filter (fun T ↦ ∀ j, (T ∩ P j).card = n j),
      primeTiltWeight (primeBandUnion P) lam T * F (fun j ↦ T ∩ P j)) =
        ∑ U ∈ Fintype.piFinset (fun j ↦ (P j).powerset.filter (fun T ↦ T.card = n j)),
          (∏ j, primeTiltWeight (P j) lam (U j)) * F U := by
  classical
  rw [← primeBandSelections_filter_card]
  simp only [sum_filter]
  simpa only [mul_ite, mul_zero] using prime_tilt_expectation_primeBand_partition P hdis lam
    (fun U ↦ if ∀ j, (U j).card = n j then F U else 0)

end Erdos859Verification

end

