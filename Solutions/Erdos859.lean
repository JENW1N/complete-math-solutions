/- Elementary lower bounds for the cost of prescribing a finite mark count. -/

namespace Erdos859Verification

open Real

theorem broad_count_cost_lower {eps : ℝ} (heps : 0 < eps) {n : ℕ} (hn : 0 < n) :
    exp (-5 * eps - (n : ℝ) * log (4 * n / eps)) ≤
      exp (-5 * eps) * (eps / 4) ^ n / (n.factorial : ℝ) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hf : (0 : ℝ) < n.factorial := by exact_mod_cast Nat.factorial_pos n
  have hep : 0 < eps / 4 := by positivity
  have hfac : log (n.factorial : ℝ) ≤ (n : ℝ) * log n := by
    have hpow : (n.factorial : ℝ) ≤ (n : ℝ) ^ n := by exact_mod_cast Nat.factorial_le_pow n
    simpa only [log_pow] using log_le_log hf hpow
  have hid : 4 * (n : ℝ) / eps = n / (eps / 4) := by ring
  apply (log_le_log_iff (exp_pos _) (by positivity)).mp
  rw [log_exp, log_div (by positivity) hf.ne',
    log_mul (exp_pos _).ne' (pow_pos hep n).ne', log_exp, log_pow,
    hid, log_div hnR.ne' hep.ne']
  nlinarith

end Erdos859Verification

