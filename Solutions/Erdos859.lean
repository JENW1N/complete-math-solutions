noncomputable def seedScale (k : ℕ) : ℕ := ⌈exp (2 * (k : ℝ) ^ 3)⌉₊

theorem eventually_seedScale_gt : ∀ᶠ k in atTop, 210 < seedScale k := by
  filter_upwards [eventually_gt_atTop 210] with k hk
