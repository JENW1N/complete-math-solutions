      primeLogOddsQuantileCoupling lam u w {z | |z.1 - z.2| ≤ 16 * primeLogOddsErrorConstant} = 1 := by
  have hn := primeLogOddsAtomWeight_normalized hlam hlam2 hu hw hwu hlarge
  have hm := finiteQuantile_logUniform_coupling_marginals hn.1 hn.2 hw hwu
  refine ⟨?_, hm.2, ?_⟩
  · exact hm.1.trans (finiteMarkLaw_aggregate
      (primeLogOddsMark_additive_normalized hlam hlam2 hu hw hwu hlarge).1 _)
  · exact finiteQuantile_logUniform_coupling_displacement hn.1 hn.2 hw hwu
      (fun _ hx ↦ primeLogAtomSet_mem hx)
      (fun _ hv ↦ primeLogOddsAtomWeight_cdf hlam hlam2 hu hw hwu hlarge hv)

theorem primeReciprocalOddsQuantileCoupling_properties {u w : ℝ}
    (hu : log 2 ≤ u) (hw : 0 < w) (hwu : w ≤ u) (hlarge : 8 * primeLogOddsErrorConstant ≤ w) :
    Measure.map Prod.fst (primeReciprocalOddsQuantileCoupling u w) = primeReciprocalOddsLogLaw u w ∧
      Measure.map Prod.snd (primeReciprocalOddsQuantileCoupling u w) =
        translationShiftLaw (logUniformDensity u w) ∧
