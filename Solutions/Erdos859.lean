        dyadicPrimeUniverse A (k + 1) =
            dyadicPrimeUniverse A k ∪ dyadicPrimeBand A k := by
          simp only [dyadicPrimeUniverse, Finset.range_add_one, Finset.biUnion_insert,
            Finset.union_comm]
