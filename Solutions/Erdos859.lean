    rcases le_or_gt (log (p : ℝ)) b with hpb | hpb
    · exact Or.inl ⟨hp, hpa, hpb⟩
    · exact Or.inr ⟨hp, hpb, hpc⟩

theorem dyadicPrimeUniverse_eq_primeLogWindow {A : ℝ} (hA : 0 ≤ A) (k : ℕ) :
    dyadicPrimeUniverse A k = primeLogWindow A (A * (2 : ℝ) ^ k) := by
  induction k with
  | zero =>
      ext p
      simp only [dyadicPrimeUniverse, Finset.range_zero, Finset.biUnion_empty,
        Finset.notMem_empty, mem_primeLogWindow, pow_zero, mul_one]
      constructor
      · intro hp
