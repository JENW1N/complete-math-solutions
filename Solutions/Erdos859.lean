theorem finite_weighted_union_bound_general {α ι : Type*}
    (S : Finset α) (I : Finset ι) (w : α → ℝ) (hw : ∀ x ∈ S, 0 ≤ w x)
    (E : ι → α → Prop) [DecidableRel E] :
    (∑ x ∈ S, w x * (if ∃ i ∈ I, E i x then 1 else 0)) ≤
      ∑ i ∈ I, ∑ x ∈ S, w x * (if E i x then 1 else 0) := by
  rw [sum_comm]
  apply sum_le_sum
  intro x hx
  have hnonneg (i : ι) : 0 ≤ w x * (if E i x then 1 else 0) := by
    split_ifs <;> simp_all
  by_cases he : ∃ i ∈ I, E i x
  · obtain ⟨i, hi, hix⟩ := he
    rw [if_pos ⟨i, hi, hix⟩, mul_one]
    calc
      _ = w x * (if E i x then 1 else 0) := by rw [if_pos hix, mul_one]
      _ ≤ _ := single_le_sum (fun j _ ↦ hnonneg j) hi
  · rw [if_neg he, mul_zero]
    exact sum_nonneg (fun i _ ↦ hnonneg i)

theorem finite_product_equal_coordinates_le {ι α : Type*}
    [Fintype ι] [DecidableEq ι] [Fintype α] [DecidableEq α]
    (w : ι → α → ℝ) (i j : ι) (hij : i ≠ j) (a : ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hatom : ∀ y, w i y ≤ a) :
    (∑ x : ι → α, finiteProductWeight w x * (if x i = x j then 1 else 0)) ≤ a := by
  apply finite_product_section_bound w (fun x ↦ if x i = x j then 1 else 0) i a hw hnorm
  intro z
  have hji : j ≠ i := Ne.symm hij
  simpa [Equiv.piSplitAt_symm_apply, hji] using hatom (z ⟨j, hji⟩)

/-- A quadratic bound is sufficient for the regular-count event; it avoids
any conditioning on distinctness during the concentration calculation. -/
theorem finite_iid_duplicate_probability_le {α : Type*} [Fintype α] [DecidableEq α]
    (n : ℕ) (w : α → ℝ) {a : ℝ} (ha : 0 ≤ a)
    (hw : ∀ y, 0 ≤ w y) (hnorm : ∑ y, w y = 1) (hatom : ∀ y, w y ≤ a) :
    (∑ x : Fin n → α, finiteProductWeight (fun _ ↦ w) x *
      (if ∃ i j : Fin n, i ≠ j ∧ x i = x j then 1 else 0)) ≤ (n : ℝ) ^ 2 * a := by
  classical
  let I : Finset (Fin n × Fin n) := univ.filter (fun ij ↦ ij.1 ≠ ij.2)
  have hevent (x : Fin n → α) :
      (∃ i j : Fin n, i ≠ j ∧ x i = x j) ↔ ∃ ij ∈ I, x ij.1 = x ij.2 := by
    constructor
    · rintro ⟨i, j, hij, heq⟩
      exact ⟨(i, j), by simp [I, hij], heq⟩
    · rintro ⟨⟨i, j⟩, hij, heq⟩
      exact ⟨i, j, (mem_filter.mp hij).2, heq⟩
  simp_rw [hevent]
  calc
    _ ≤ ∑ ij ∈ I, ∑ x : Fin n → α, finiteProductWeight (fun _ ↦ w) x *
        (if x ij.1 = x ij.2 then 1 else 0) :=
      finite_weighted_union_bound_general univ I (finiteProductWeight (fun _ ↦ w))
        (fun x _ ↦ finiteProductWeight_nonneg (fun _ ↦ hw) x) _
    _ ≤ ∑ _ij ∈ I, a := by
      apply sum_le_sum
      intro ij hij
      exact finite_product_equal_coordinates_le (fun _ ↦ w) ij.1 ij.2
        (mem_filter.mp hij).2 a (fun _ ↦ hw) (fun _ ↦ hnorm) hatom
    _ ≤ ∑ _ij : Fin n × Fin n, a :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ ↦ ha)
    _ = _ := by simp [pow_two]

end Erdos859Verification

end

