ballot count to arbitrary independent mark weights. -/
theorem finite_bin_ballot_weight_lower {n : ℕ} (hn : 0 < n)
    {α : Type*} [Fintype α] (weight : α → ℝ) (bin : α → Fin n)
    {a : ℝ} (ha : 0 ≤ a) (hbin : ∀ j, a ≤ finiteBinMass weight bin j) :
    ((n : ℝ) * a) ^ n / n ≤
      ∑ x : Fin n → α with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
        ∏ i, weight (x i) := by
  classical
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hpow : (0 : ℝ) < (n : ℝ) ^ n := pow_pos hnR n
  have hprob := uniform_occupancy_ballot_probability_lower hn
  unfold uniformOccupancyBallotProbability at hprob
  have hcard : (n : ℝ) ^ n / n ≤
      ((univ.filter (fun y : Fin n → Fin n ↦ CyclicBallot (occupancyCount y))).card : ℝ) := by
    apply (div_le_iff₀ hnR).mpr
    simpa only [one_mul] using (div_le_div_iff₀ hnR hpow).mp hprob
  rw [finite_bin_ballot_pushforward]
  calc
    _ = ((n : ℝ) ^ n / n) * a ^ n := by rw [mul_pow]; ring
    _ ≤ ((univ.filter (fun y : Fin n → Fin n ↦ CyclicBallot (occupancyCount y))).card : ℝ) *
        a ^ n := mul_le_mul_of_nonneg_right hcard (pow_nonneg ha n)
    _ = ∑ y : Fin n → Fin n with CyclicBallot (occupancyCount y), a ^ n := by simp
    _ ≤ _ := by
      apply sum_le_sum
      intro y _
      have h := prod_le_prod (s := (univ : Finset (Fin n)))
        (f := fun _ ↦ a) (g := fun i ↦ finiteBinMass weight bin (y i))
        (fun _ _ ↦ ha) (fun i _ ↦ hbin (y i))
      simpa using h

theorem finite_bin_ballot_probability_bounds {n : ℕ} (hn : 0 < n)
    {α : Type*} [Fintype α] (weight : α → ℝ) (bin : α → Fin n)
    (hweight : ∀ p, 0 ≤ weight p) (hnorm : ∑ p, weight p = 1)
    {a : ℝ} (ha : 0 < a) (hbin : ∀ j, a ≤ finiteBinMass weight bin j) :
    ((n : ℝ) * a) ^ n / n ≤
      (∑ x : Fin n → α with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
        ∏ i, weight (x i)) ∧
    (∑ x : Fin n → α with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
        ∏ i, weight (x i)) ≤ 1 := by
  classical
  refine ⟨finite_bin_ballot_weight_lower hn weight bin ha.le hbin, ?_⟩
  calc
    _ ≤ ∑ x : Fin n → α, ∏ i, weight (x i) :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
        (fun x _ _ ↦ prod_nonneg (fun i _ ↦ hweight (x i)))
    _ = ∏ _i : Fin n, ∑ p, weight p := (Fintype.prod_sum (fun (_ : Fin n) p ↦ weight p)).symm
    _ = 1 := by simp only [hnorm, prod_const_one]

end Erdos859Verification

