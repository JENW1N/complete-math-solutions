            by exact_mod_cast le_max' s n hn⟩
        have hgap' : ∀ m ∈ s, ∀ n ∈ s, m < n → q ≤ (n : ℝ) - (m : ℝ) := by
          intro m hm n hn hmn
          exact hgap m (mem_insert_of_mem hm) n (mem_insert_of_mem hn) hmn
        have hi := ih hbL hbound' hgap'
        have hstep := reciprocal_le_log_sub_div hb0 ha0 hq
          (hgap b (mem_insert_of_mem hb) a (mem_insert_self a s) hba)
        calc
          1 / (a : ℝ) + ∑ n ∈ s, 1 / (n : ℝ)
              ≤ (log (a : ℝ) - log (b : ℝ)) / q +
