/-- A support smaller than the reciprocal threshold forces a large energy. -/
theorem energy_large_of_support_small {V E t : ℝ}
    (hV : 0 ≤ V) (ht : 0 < t) (hVE : 1 ≤ V * E) (hsmall : V < 1 / t) :
    t ≤ E := by
  by_contra hE
  have hEt : E ≤ t := (lt_of_not_ge hE).le
  have hprod : V * E ≤ V * t := mul_le_mul_of_nonneg_left hEt hV
  have hstrict : V * t < 1 := (lt_div_iff₀ ht).mp hsmall
  linarith

/-- A finite weighted Markov bound, combined with `1 ≤ size * energy`.
The ambient weights need not be normalized, so this also applies on a
restricted good-configuration event. -/
theorem finite_support_bad_weight_le {β : Type*} (S : Finset β)
    (W E V : β → ℝ) {L R : ℝ} (hL : 0 < L) (hR : 0 < R)
    (hW : ∀ b ∈ S, 0 ≤ W b) (hE : ∀ b ∈ S, 0 ≤ E b)
    (hV : ∀ b ∈ S, 0 ≤ V b) (hVE : ∀ b ∈ S, 1 ≤ V b * E b)
    (haverage : (∑ b ∈ S, W b * E b) ≤ R) :
    (∑ b ∈ S with V b < 1 / (L * R), W b) ≤ 1 / L := by
  classical
  have hLR : 0 < L * R := mul_pos hL hR
  have hsub : (S.filter (fun b ↦ V b < 1 / (L * R))) ⊆
      S.filter (fun b ↦ L * R ≤ E b) := by
    intro b hb
    obtain ⟨hbS, hbsmall⟩ := mem_filter.mp hb
    exact mem_filter.mpr ⟨hbS,
      energy_large_of_support_small (hV b hbS) hLR (hVE b hbS) hbsmall⟩
  calc
    _ ≤ ∑ b ∈ S with L * R ≤ E b, W b :=
      sum_le_sum_of_subset_of_nonneg hsub (fun b hb _ ↦ hW b (mem_filter.mp hb).1)
    _ ≤ (∑ b ∈ S, W b * E b) / (L * R) :=
      finite_weighted_markov S W E hLR hW hE
    _ ≤ R / (L * R) := div_le_div_of_nonneg_right haverage hLR.le
    _ = 1 / L := by field_simp [hL.ne', hR.ne']

/-- The large-support event retains all ambient mass apart from `1/L`. -/
theorem finite_support_good_weight_ge_mass {β : Type*} (S : Finset β)
    (W E V : β → ℝ) {L R : ℝ} (hL : 0 < L) (hR : 0 < R)
    (hW : ∀ b ∈ S, 0 ≤ W b) (hE : ∀ b ∈ S, 0 ≤ E b)
    (hV : ∀ b ∈ S, 0 ≤ V b) (hVE : ∀ b ∈ S, 1 ≤ V b * E b)
    (haverage : (∑ b ∈ S, W b * E b) ≤ R) :
    (∑ b ∈ S, W b) - 1 / L ≤
      ∑ b ∈ S with 1 / (L * R) ≤ V b, W b := by
  classical
  have hbad := finite_support_bad_weight_le S W E V hL hR hW hE hV hVE haverage
  have hsplit := sum_filter_add_sum_filter_not S (fun b ↦ V b < 1 / (L * R)) W
  simp only [not_lt] at hsplit
  linarith

theorem finite_support_good_weight_ge {β : Type*} (S : Finset β)
    (W E V : β → ℝ) {L R : ℝ} (hL : 0 < L) (hR : 0 < R)
    (hW : ∀ b ∈ S, 0 ≤ W b) (hE : ∀ b ∈ S, 0 ≤ E b)
    (hV : ∀ b ∈ S, 0 ≤ V b) (hVE : ∀ b ∈ S, 1 ≤ V b * E b)
    (hnorm : ∑ b ∈ S, W b = 1) (haverage : (∑ b ∈ S, W b * E b) ≤ R) :
