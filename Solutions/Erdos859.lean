below `p`. Their sum costs only a factor two inside the logarithm. -/
theorem stopping_witness_denominator_le {P S : Finset ℕ}
    (hP : ∀ q ∈ P, q.Prime) {p : ℕ} (hpP : p ∈ P)
    (hSprefix : S ⊆ fordPrimePrefix P p) {y : ℝ} (hy : 0 < y)
    (hw : FordStoppingWitness y p S) :
    fordLogDenominator y S ≤ 2 * log (p : ℝ) := by
  have hSP : S ⊆ P := hSprefix.trans (filter_subset _ _)
  have hp := hP p hpP
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hprod0 : 0 < ∏ q ∈ S, (q : ℝ) := prod_pos fun q hq ↦ by
    exact_mod_cast (hP q (hSP hq)).pos
  obtain ⟨U, hUS, hlo, _hhi⟩ := hw
  have hprod : (∏ q ∈ U, (q : ℝ)) ≤ ∏ q ∈ S, (q : ℝ) :=
    prod_le_prod_of_subset_of_one_le hUS (fun q _ ↦ Nat.cast_nonneg q)
      (fun q hq _ ↦ by exact_mod_cast (hP q (hSP hq)).one_le)
