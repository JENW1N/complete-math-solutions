def coreRateBlockLength (s : ℕ) : ℕ := 2 ^ s
def coreRateSuffixLength (s : ℕ) : ℕ := 2 * s + 4
def coreRatePrefixLength (s : ℕ) : ℕ := coreRateBlockLength s - coreRateSuffixLength s
def coreRateBlockCount (s : ℕ) : ℕ := 2 ^ (4 * coreRateBlockLength s)
def coreRateTotalLength (s : ℕ) : ℕ := coreRateBlockLength s * coreRateBlockCount s
def coreRateHead (s : ℕ) : ℕ := 10 * coreRateBlockLength s

theorem coreRateBlockLength_pos (s : ℕ) : 0 < coreRateBlockLength s := by
  unfold coreRateBlockLength
  positivity

theorem coreRateBlockCount_pos (s : ℕ) : 0 < coreRateBlockCount s := by
  unfold coreRateBlockCount
  positivity

theorem coreRateTotalLength_pos (s : ℕ) : 0 < coreRateTotalLength s :=
  Nat.mul_pos (coreRateBlockLength_pos s) (coreRateBlockCount_pos s)

theorem coreRateBlockLength_le_total (s : ℕ) : coreRateBlockLength s ≤ coreRateTotalLength s := by
  unfold coreRateTotalLength
  simpa only [Nat.mul_one] using Nat.mul_le_mul_left (coreRateBlockLength s)
    (coreRateBlockCount_pos s)

theorem coreRateBlockLength_tendsto : Tendsto coreRateBlockLength atTop atTop :=
  tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℕ) < 2)

theorem coreRateTotalLength_tendsto : Tendsto coreRateTotalLength atTop atTop :=
  tendsto_atTop_mono coreRateBlockLength_le_total coreRateBlockLength_tendsto

theorem coreRateBlockLength_real_tendsto :
    Tendsto (fun s ↦ (coreRateBlockLength s : ℝ)) atTop atTop :=
  (tendsto_natCast_atTop_atTop (R := ℝ)).comp coreRateBlockLength_tendsto

theorem coreRateTotalLength_real_tendsto :
    Tendsto (fun s ↦ (coreRateTotalLength s : ℝ)) atTop atTop :=
  (tendsto_natCast_atTop_atTop (R := ℝ)).comp coreRateTotalLength_tendsto

theorem coreRateSuffix_fraction_tendsto :
    Tendsto (fun s ↦ (coreRateSuffixLength s : ℝ) / coreRateBlockLength s) atTop (𝓝 0) := by
  have hs : Tendsto (fun s : ℕ ↦ (s : ℝ) / (2 : ℝ) ^ s) atTop (𝓝 0) := by
    simpa only [pow_one] using tendsto_pow_const_div_const_pow_of_one_lt 1 (by norm_num : (1 : ℝ) < 2)
  have hconst := coreRateBlockLength_real_tendsto.const_div_atTop (4 : ℝ)
  convert (hs.const_mul 2).add hconst using 1 <;>
    simp only [coreRateSuffixLength, coreRateBlockLength, Nat.cast_add, Nat.cast_mul,
      Nat.cast_ofNat, Nat.cast_pow, add_div, mul_div_assoc, mul_zero, zero_add]

theorem coreRateLength_eventually_split :
    ∀ᶠ s : ℕ in atTop, 0 < coreRatePrefixLength s ∧
      coreRatePrefixLength s + coreRateSuffixLength s = coreRateBlockLength s := by
  filter_upwards [coreRateSuffix_fraction_tendsto.eventually_lt_const (by norm_num : (0 : ℝ) < 1)] with s hs
  have hH : (0 : ℝ) < coreRateBlockLength s := by exact_mod_cast coreRateBlockLength_pos s
  have hKH : coreRateSuffixLength s < coreRateBlockLength s := by
    exact_mod_cast (div_lt_one hH).mp hs
  exact ⟨Nat.sub_pos_of_lt hKH, Nat.sub_add_cancel hKH.le⟩

theorem coreRatePrefix_fraction_tendsto :
    Tendsto (fun s ↦ (coreRatePrefixLength s : ℝ) / coreRateBlockLength s) atTop (𝓝 1) := by
  have hlim := (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (1 : ℝ)) atTop (𝓝 1)).sub coreRateSuffix_fraction_tendsto
  simp only [sub_zero] at hlim
  apply hlim.congr'
  filter_upwards [coreRateLength_eventually_split] with s hs
  have hsplit : (coreRatePrefixLength s : ℝ) + coreRateSuffixLength s = coreRateBlockLength s := by
    exact_mod_cast hs.2
  have hH : (coreRateBlockLength s : ℝ) ≠ 0 := by exact_mod_cast (coreRateBlockLength_pos s).ne'
  field_simp
  linarith

theorem coreRate_length_div_count_tendsto :
    Tendsto (fun s ↦ (coreRateBlockLength s : ℝ) / coreRateBlockCount s) atTop (𝓝 0) := by
  have h := (tendsto_pow_const_div_const_pow_of_one_lt 1 (by norm_num : (1 : ℝ) < 16)).comp
    coreRateBlockLength_tendsto
  simpa only [Function.comp_def, pow_one, coreRateBlockCount, Nat.cast_pow, Nat.cast_ofNat,
    pow_mul, show (2 : ℝ) ^ 4 = 16 by norm_num] using h

theorem coreRate_squared_length_div_total_tendsto :
    Tendsto (fun s ↦ (coreRateBlockLength s : ℝ) ^ 2 / coreRateTotalLength s) atTop (𝓝 0) := by
  apply coreRate_length_div_count_tendsto.congr'
  exact Eventually.of_forall fun s ↦ by
    have hH : (coreRateBlockLength s : ℝ) ≠ 0 := by exact_mod_cast (coreRateBlockLength_pos s).ne'
    simp only [coreRateTotalLength, Nat.cast_mul]
    field_simp

theorem coreRateHead_eventually_le_global :
    ∀ᶠ s : ℕ in atTop, coreRateHead s ≤ coreBallotHeadCount (coreRateTotalLength s) := by
  filter_upwards [coreRate_length_div_count_tendsto.eventually_lt_const
    (by norm_num : (0 : ℝ) < 1 / 100)] with s hs
  have hR : (0 : ℝ) < coreRateBlockCount s := by exact_mod_cast coreRateBlockCount_pos s
  have hH : (0 : ℝ) < coreRateBlockLength s := by exact_mod_cast coreRateBlockLength_pos s
  have hsmall := (div_lt_iff₀ hR).mp hs
  have hsq : (coreRateHead s : ℝ) ^ 2 ≤ coreRateTotalLength s := by
    simp only [coreRateHead, coreRateTotalLength, Nat.cast_mul, Nat.cast_ofNat]
    nlinarith [mul_pos hH (show 0 < (coreRateBlockCount s : ℝ) - 100 * coreRateBlockLength s by linarith)]
  have hle : (coreRateHead s : ℝ) ≤ sqrt (coreRateTotalLength s : ℝ) :=
    (le_sqrt (by positivity) (by positivity)).mpr hsq
  exact_mod_cast hle.trans (coreBallotHeadCount_sqrt_bounds (coreRateTotalLength s)).1

theorem coreRate_ratio_le_pow_head (s : ℕ) :
    coreBallotShift (coreRateTotalLength s) / coreBallotScale (coreRateTotalLength s) ≤
      (2 : ℝ) ^ coreRateHead s := by
  have hH : 1 ≤ coreRateBlockLength s := coreRateBlockLength_pos s
  have hpow : coreRateBlockLength s ≤ 2 ^ coreRateBlockLength s :=
    (coreRateBlockLength s).lt_two_pow_self.le
  have hten : 10 ≤ 2 ^ (5 * coreRateBlockLength s) := by
    calc
      10 ≤ 2 ^ (5 : ℕ) := by norm_num
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbound : 10 * coreRateTotalLength s ≤ 2 ^ coreRateHead s := by
    calc
      _ ≤ 2 ^ (5 * coreRateBlockLength s) * (2 ^ coreRateBlockLength s * 2 ^ (4 * coreRateBlockLength s)) := by
        unfold coreRateTotalLength coreRateBlockCount
        exact Nat.mul_le_mul hten (Nat.mul_le_mul_right _ hpow)
      _ = _ := by
        rw [← pow_add, ← pow_add]
        congr 1
        unfold coreRateHead
        omega
  exact (coreBallotShift_div_scale_le (coreRateTotalLength s)).trans (by exact_mod_cast hbound)

theorem coreRate_endpoint_epsilon_tendsto :
    Tendsto (fun s ↦ (coreRatePrefixLength s : ℝ) / (2 : ℝ) ^ coreRateSuffixLength s)
      atTop (𝓝 0) := by
  have hgeom := (tendsto_pow_atTop_nhds_zero_of_lt_one
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 : ℝ) / 2 < 1)).const_mul (1 / 16 : ℝ)
  apply squeeze_zero (fun s ↦ by positivity) (fun s ↦ ?_) (by simpa only [mul_zero] using hgeom)
  have hnH : (coreRatePrefixLength s : ℝ) ≤ coreRateBlockLength s := by
    exact_mod_cast Nat.sub_le (coreRateBlockLength s) (coreRateSuffixLength s)
  calc
    _ ≤ (coreRateBlockLength s : ℝ) / (2 : ℝ) ^ coreRateSuffixLength s :=
      div_le_div_of_nonneg_right hnH (by positivity)
    _ = (1 / 16 : ℝ) * (1 / 2 : ℝ) ^ s := by
      simp only [coreRateBlockLength, coreRateSuffixLength, Nat.cast_pow, Nat.cast_ofNat,
        pow_add, pow_mul, div_pow, one_pow]
      rw [show (2 : ℝ) ^ 2 = 2 * 2 by norm_num, mul_pow]
      field_simp
      ring

theorem coreRate_endpoint_budget_tendsto (eta : ℝ) :
    Tendsto (fun s ↦ (exp eta + (coreRatePrefixLength s : ℝ) / (2 : ℝ) ^ coreRateSuffixLength s) /
      (1 - ((2 : ℝ) ^ coreRateBlockLength s)⁻¹)) atTop (𝓝 (exp eta)) := by
  have hgeom := (tendsto_pow_atTop_nhds_zero_of_lt_one
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 : ℝ) / 2 < 1)).comp coreRateBlockLength_tendsto
  have hinv : Tendsto (fun s ↦ ((2 : ℝ) ^ coreRateBlockLength s)⁻¹) atTop (𝓝 0) := by
    simpa only [Function.comp_def, div_pow, one_pow, one_div, inv_pow] using hgeom
  simpa only [add_zero, sub_zero, div_one] using!
    (tendsto_const_nhds.add coreRate_endpoint_epsilon_tendsto).div (tendsto_const_nhds.sub hinv) (by norm_num : (1 : ℝ) - 0 ≠ 0)

end Erdos859Verification

end

