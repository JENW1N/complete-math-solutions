  nlinarith [pow_nonneg (Nat.cast_nonneg (α := ℝ) k) 3, Nat.cast_nonneg (α := ℝ) k]

theorem coreBallot_base_large (k : ℕ) : log 2 ≤ coreBallotShift k + coreBallotScale k := by
  have hlog : log (2 : ℝ) ≤ 1 := by
    have h := log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h
