    n = fordPowerfulSquare n ^ 2 * fordPowerfulCube n ^ 3 := by
  nth_rw 1 [Nat.prod_primeFactors_pow_factorization hn.1]
  change (∏ p ∈ n.primeFactors, p ^ n.factorization p) =
    (∏ p ∈ n.primeFactors, p ^ (n.factorization p / 2 - n.factorization p % 2)) ^ 2 *
      (∏ p ∈ n.primeFactors, p ^ (n.factorization p % 2)) ^ 3
  rw [← prod_pow, ← prod_pow, ← prod_mul_distrib]
  apply prod_congr rfl
  intro p _
