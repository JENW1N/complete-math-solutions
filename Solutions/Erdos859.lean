/- Inlined development module: PrimePatterns.lean -/

section

/- Exact finite prime-divisibility laws for the lower-bound construction. -/

open Filter Finset
open scoped Topology

namespace Erdos859Verification

theorem primeProduct_dvd_iff {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) (n : ℕ) :
    (∏ p ∈ P, p) ∣ n ↔ ∀ p ∈ P, p ∣ n := by
  induction P using Finset.induction_on with
  | empty => simp
  | @insert p P hp ih =>
    have hprime : p.Prime := hP p (mem_insert_self p P)
    have hP' : ∀ q ∈ P, q.Prime := fun q hq ↦ hP q (mem_insert_of_mem hq)
    have hcop : Nat.Coprime p (∏ q ∈ P, q) := by
      apply Nat.Coprime.prod_right
      intro q hq
      apply (Nat.coprime_primes hprime (hP' q hq)).mpr
      intro heq
      exact hp (heq ▸ hq)
    rw [prod_insert hp]
    constructor
    · intro hd q hq
      rcases mem_insert.mp hq with rfl | hq
      · exact dvd_trans (dvd_mul_right q _) hd
      · exact (ih hP').mp (dvd_trans (dvd_mul_left _ p) hd) q hq
    · intro hd
      exact hcop.mul_dvd_of_dvd_of_dvd (hd p (mem_insert_self p P))
        ((ih hP').mpr (fun q hq ↦ hd q (mem_insert_of_mem hq)))

theorem primeProduct_indicator {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) (n : ℕ) :
    (∏ p ∈ P, if p ∣ n then (1 : ℝ) else 0) =
      if (∏ p ∈ P, p) ∣ n then 1 else 0 := by
  classical
  by_cases hall : ∀ p ∈ P, p ∣ n
  · rw [if_pos ((primeProduct_dvd_iff hP n).mpr hall)]
    exact prod_eq_one (fun p hp ↦ if_pos (hall p hp))
  · rw [if_neg (mt (primeProduct_dvd_iff hP n).mp hall)]
    push Not at hall
    obtain ⟨p, hp, hpn⟩ := hall
    exact prod_eq_zero hp (if_neg hpn)

/-- All multilinear prime-divisibility moments factor with Bernoulli
parameters `1/p`. This is a limit over integers, with no probabilistic
independence assumption. -/
theorem tendsto_mean_prime_product {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (a b : ℕ → ℝ) :
    Tendsto (fun N : ℕ ↦
      (∑ n ∈ range N, ∏ p ∈ P, (a p * (if p ∣ n then (1 : ℝ) else 0) + b p)) / N)
      atTop (𝓝 (∏ p ∈ P, (a p / (p : ℝ) + b p))) := by
  classical
  have hexpand (n : ℕ) :
      (∏ p ∈ P, (a p * (if p ∣ n then (1 : ℝ) else 0) + b p)) =
        ∑ S ∈ P.powerset, (∏ p ∈ S, a p) * (∏ p ∈ P \ S, b p) *
          (if (∏ p ∈ S, p) ∣ n then 1 else 0) := by
    rw [prod_add]
    apply sum_congr rfl
    intro S hS
    have hprime : ∀ p ∈ S, p.Prime :=
      fun p hp ↦ hP p (mem_powerset.mp hS hp)
    rw [prod_mul_distrib, primeProduct_indicator hprime]
    ring
  have heach : ∀ S ∈ P.powerset,
      Tendsto (fun N : ℕ ↦ (∏ p ∈ S, a p) * (∏ p ∈ P \ S, b p) *
        ((∑ n ∈ range N, if (∏ p ∈ S, p) ∣ n then (1 : ℝ) else 0) / N))
        atTop (𝓝 ((∏ p ∈ S, a p) * (∏ p ∈ P \ S, b p) *
          (1 / (∏ p ∈ S, p : ℕ)))) := by
    intro S hS
    apply Tendsto.const_mul
    exact tendsto_mean_dvd_indicator
      (prod_pos (fun p hp ↦ (hP p (mem_powerset.mp hS hp)).pos))
  have hsum := tendsto_finsetSum P.powerset heach
  convert hsum using 1
  · funext N
    simp only [hexpand, sum_div, mul_div_assoc, mul_sum]
    rw [sum_comm]
  · apply congrArg nhds
    rw [prod_add]
    apply sum_congr rfl
    intro S _
    simp only [prod_div_distrib, Nat.cast_prod]
    ring

/-- An arbitrary pair of real weights at each prime has the corresponding
product expectation. -/
theorem tendsto_mean_prime_choices {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (u v : ℕ → ℝ) :
    Tendsto (fun N : ℕ ↦
      (∑ n ∈ range N, ∏ p ∈ P, if p ∣ n then u p else v p) / N)
      atTop (𝓝 (∏ p ∈ P, (u p / (p : ℝ) + v p * (1 - 1 / (p : ℝ))))) := by
  convert tendsto_mean_prime_product hP (fun p ↦ u p - v p) v using 1
  · funext N
    congr 1
    apply sum_congr rfl
    intro n _
    apply prod_congr rfl
    intro p _
    split_ifs <;> ring
  · apply congrArg nhds
    apply prod_congr rfl
    intro p _
    ring

/-- Integers with exactly the prescribed prime divisibility pattern on `P`. -/
def PrimePatternSet (P T : Finset ℕ) : Set ℕ :=
  {n | ∀ p ∈ P, p ∣ n ↔ p ∈ T}

noncomputable def primePatternWeight (P T : Finset ℕ) : ℝ :=
  ∏ p ∈ P, if p ∈ T then 1 / (p : ℝ) else 1 - 1 / (p : ℝ)

/-- The exact finite Bernoulli law, proved from densities of multiples. -/
theorem primePattern_hasDensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (T : Finset ℕ) :
    (PrimePatternSet P T).HasDensity (primePatternWeight P T) := by
  classical
  have hmean := tendsto_mean_prime_choices hP
    (fun p ↦ if p ∈ T then (1 : ℝ) else 0)
    (fun p ↦ if p ∈ T then (0 : ℝ) else 1)
  have hw : (∏ p ∈ P,
      ((if p ∈ T then (1 : ℝ) else 0) / p +
        (if p ∈ T then (0 : ℝ) else 1) * (1 - 1 / p))) =
      primePatternWeight P T := by
    apply prod_congr rfl
    intro p _
    split_ifs <;> simp
  rw [hw] at hmean
  apply hasDensity_of_indicator_mean hmean
  apply Filter.Eventually.of_forall
  intro n
  simp only [Set.indicator_apply, PrimePatternSet, Set.mem_ofPred_eq]
  rw [← Finset.prod_boole]
  apply prod_congr rfl
  intro p _
  by_cases hp : p ∣ n <;> by_cases hT : p ∈ T <;> simp [hp, hT]

end Erdos859Verification

