energy is small. The finite atom type may depend on the configuration. -/
theorem finiteIntervalSupport_bad_weight_le {β : Type*} [Fintype β]
    {α : β → Type*} [∀ b, Fintype (α b)]
    (W : β → ℝ) (w atom : ∀ b, α b → ℝ) {d L R : ℝ}
    (hd : 0 < d) (hL : 0 < L) (hR : 0 < R)
    (hW : ∀ b, 0 ≤ W b) (hw : ∀ b i, 0 ≤ w b i) (hnorm : ∀ b, ∑ i, w b i = 1)
