/- Inlined development module: PhaseBlockDecay.lean -/

section

/- Uniform algebraic decay of rational phase blocks at proper-cube anchors. -/

namespace Erdos859Verification

open Real

noncomputable def rationalPhaseBlockBound (m : ℕ) (G M R Q Pmin : ℝ) : ℝ :=
  12 * (6 * G) ^ m * (1 + 2 * Q / Pmin) ^ m * (2 * Q + R) ^ (m + 1) /
    (M ^ (m + 1) * Q ^ (m - 1))

theorem phaseBlock_coefficient_le (m : ℕ) {c : ℝ} (hc : 0 ≤ c) (hc1 : c ≤ 1000) :
    36 * c ^ m ≤ (1000 : ℝ) ^ (m + 1) := by
  calc
    _ ≤ (1000 : ℝ) * 1000 ^ m :=
      mul_le_mul (by norm_num) (pow_le_pow_left₀ hc hc1 m) (pow_nonneg hc m) (by norm_num)
    _ = _ := by rw [pow_succ]; ring

theorem phaseBlock_power_ratio {M : ℝ} (hM : 0 < M) (u : ℝ) (k l n : ℕ) :
    (M ^ u) ^ k / (M ^ l * M ^ n) =
      M ^ (u * (k : ℝ) - ((l : ℝ) + (n : ℝ))) := by
  rw [← rpow_mul_natCast hM.le, ← rpow_natCast M l, ← rpow_natCast M n,
    ← rpow_add hM, ← rpow_sub hM]

theorem phaseBlock_cancel_powers {M Q : ℝ} (hM : 0 < M) (hQ : 0 < Q)
    {m : ℕ} (hm : 1 ≤ m) :
    Q ^ (m + 1) / (M ^ (m + 1) * Q ^ (m - 1)) = Q ^ 2 / M ^ (m + 1) := by
  cases m with
  | zero => omega
  | succ n =>
    simp only [Nat.add_sub_cancel, pow_succ]
    field_simp

/-- Separate the harmless numerical coefficient from the decisive scale ratio. -/
theorem rationalPhaseBlockBound_le_scale {m : ℕ} {G M R Q Pmin V : ℝ}
    (hG : 0 ≤ G) (hM : 0 < M) (hR : 0 ≤ R) (hQ : 0 < Q)
    (hQP : Q ≤ Pmin) (hQV : Q ≤ V) (hRV : R ≤ V) :
    rationalPhaseBlockBound m G M R Q Pmin ≤
      (36 * (54 : ℝ) ^ m * G ^ m) * (V ^ (m + 1) / (M ^ (m + 1) * Q ^ (m - 1))) := by
  have hP : 0 < Pmin := hQ.trans_le hQP
  have hV : 0 < V := hQ.trans_le hQV
  have hB : 1 + 2 * Q / Pmin ≤ 3 := by
    have h := (div_le_one hP).mpr hQP
    rw [mul_div_assoc]
    linarith
  have hN : 2 * Q + R ≤ 3 * V := by linarith
  unfold rationalPhaseBlockBound
  calc
    _ ≤ 12 * (6 * G) ^ m * 3 ^ m * (3 * V) ^ (m + 1) /
        (M ^ (m + 1) * Q ^ (m - 1)) := by gcongr
    _ = _ := by
      rw [show (54 : ℝ) = 6 * 3 * 3 by norm_num]
      simp only [mul_pow, pow_succ]
      ring

theorem phaseBlock_small_Q_ratio_le {M Q : ℝ} (hM : 1 < M) (hMQ : M ≤ Q)
    {m : ℕ} (hm : 8 ≤ m) :
    (M ^ (5 / 4 : ℝ)) ^ (m + 1) / (M ^ (m + 1) * Q ^ (m - 1)) ≤
      M ^ (-(m : ℝ) / 2) := by
  have hM0 : 0 < M := by linarith
  have hm1 : 1 ≤ m := by omega
  have hmR : (8 : ℝ) ≤ m := by exact_mod_cast hm
  calc
    _ ≤ (M ^ (5 / 4 : ℝ)) ^ (m + 1) / (M ^ (m + 1) * M ^ (m - 1)) := by
      apply div_le_div_of_nonneg_left (by positivity) (by positivity)
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hM0.le hMQ (m - 1)) (by positivity)
    _ = M ^ ((5 / 4 : ℝ) * ((m : ℝ) + 1) - (((m : ℝ) + 1) + ((m : ℝ) - 1))) := by
      rw [phaseBlock_power_ratio hM0, Nat.cast_add, Nat.cast_one, Nat.cast_sub hm1, Nat.cast_one]
    _ ≤ _ := rpow_le_rpow_of_exponent_le hM.le (by linarith)

theorem phaseBlock_large_Q_ratio_le {M Q a : ℝ} (hM : 1 < M) (hQ : 0 < Q)
    (hQa : Q ≤ M ^ a) {m : ℕ} (hm : 8 ≤ m) (hma : 8 * a ≤ (m : ℝ)) :
    Q ^ (m + 1) / (M ^ (m + 1) * Q ^ (m - 1)) ≤ M ^ (-(m : ℝ) / 2) := by
  have hM0 : 0 < M := by linarith
  have hmR : (8 : ℝ) ≤ m := by exact_mod_cast hm
  rw [phaseBlock_cancel_powers hM0 hQ (by omega)]
  calc
    _ ≤ (M ^ a) ^ 2 / M ^ (m + 1) :=
      div_le_div_of_nonneg_right (pow_le_pow_left₀ hQ.le hQa 2) (by positivity)
    _ = M ^ (2 * a - ((m : ℝ) + 1)) := by
      rw [← rpow_mul_natCast hM0.le, ← rpow_natCast M (m + 1), ← rpow_sub hM0]
      congr 1
      push_cast
      ring
    _ ≤ _ := rpow_le_rpow_of_exponent_le hM.le (by linarith)

/-- Middle blocks and the final range below the least prime mark share
the decay `M^(-m/2)`. -/
theorem rationalPhaseBlockBound_below_prime_le {m : ℕ} {G M R Q Pmin a : ℝ}
    (hG : 0 ≤ G) (hM : 1 < M) (hR : 0 ≤ R) (hRscale : R ≤ M ^ (5 / 4 : ℝ))
    (hMQ : M ≤ Q) (hQa : Q ≤ M ^ a) (hQP : Q ≤ Pmin)
    (hm : 8 ≤ m) (hma : 8 * a ≤ (m : ℝ)) :
    rationalPhaseBlockBound m G M R Q Pmin ≤
      (1000 : ℝ) ^ (m + 1) * G ^ m * M ^ (-(m : ℝ) / 2) := by
  have hM0 : 0 < M := by linarith
  have hQ : 0 < Q := hM0.trans_le hMQ
  have hscale : rationalPhaseBlockBound m G M R Q Pmin ≤
      (36 * (54 : ℝ) ^ m * G ^ m) * M ^ (-(m : ℝ) / 2) := by
    rcases le_total Q (M ^ (5 / 4 : ℝ)) with hsmall | hlarge
    · exact (rationalPhaseBlockBound_le_scale hG hM0 hR hQ hQP hsmall hRscale).trans
        (mul_le_mul_of_nonneg_left (phaseBlock_small_Q_ratio_le hM hMQ hm) (by positivity))
    · exact (rationalPhaseBlockBound_le_scale hG hM0 hR hQ hQP le_rfl (hRscale.trans hlarge)).trans
        (mul_le_mul_of_nonneg_left (phaseBlock_large_Q_ratio_le hM hQ hQa hm hma) (by positivity))
  apply hscale.trans
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right (phaseBlock_coefficient_le m (by norm_num : (0 : ℝ) ≤ 54) (by norm_num))
      (pow_nonneg hG m)) (rpow_nonneg hM0.le _)

/-- Once the denominator exceeds the least mark scale, isolate the ratio
`Q/Pmin` that replaces the bounded progression factor. -/
theorem rationalPhaseBlockBound_le_high_ratio {m : ℕ} {G M R Q Pmin : ℝ}
    (hG : 0 ≤ G) (hM : 0 < M) (hR : 0 ≤ R) (hP : 0 < Pmin)
    (hPQ : Pmin ≤ Q) (hRP : R ≤ Pmin) (hm : 1 ≤ m) :
    rationalPhaseBlockBound m G M R Q Pmin ≤
      (36 * (54 : ℝ) ^ m * G ^ m) * (Q ^ 2 * (Q / Pmin) ^ m / M ^ (m + 1)) := by
  have hQ : 0 < Q := hP.trans_le hPQ
  have hB : 1 + 2 * Q / Pmin ≤ 3 * (Q / Pmin) := by
    have h := (one_le_div hP).mpr hPQ
    rw [mul_div_assoc]
    linarith
  have hN : 2 * Q + R ≤ 3 * Q := by linarith
  unfold rationalPhaseBlockBound
  calc
    _ ≤ 12 * (6 * G) ^ m * (3 * (Q / Pmin)) ^ m * (3 * Q) ^ (m + 1) /
        (M ^ (m + 1) * Q ^ (m - 1)) := by gcongr
    _ = (36 * (54 : ℝ) ^ m * G ^ m) * (Q / Pmin) ^ m *
        (Q ^ (m + 1) / (M ^ (m + 1) * Q ^ (m - 1))) := by
      rw [show (54 : ℝ) = 6 * 3 * 3 by norm_num]
      simp only [mul_pow, pow_succ]
      ring
    _ = _ := by rw [phaseBlock_cancel_powers hM hQ hm]; ring

theorem phaseBlock_above_prime_ratio_le {M Q Pmin U a : ℝ}
    (hM : 1 < M) (hQ : 0 < Q) (hP : 0 < Pmin)
    (hQU : Q ≤ U) (hUa : U ≤ M ^ a)
    (hPlower : U / (2 * M ^ (1 / 8 : ℝ)) ≤ Pmin)
    {m : ℕ} (hm : 8 ≤ m) (hma : 8 * a ≤ (m : ℝ)) :
    Q ^ 2 * (Q / Pmin) ^ m / M ^ (m + 1) ≤
      (2 : ℝ) ^ m * M ^ (-(m : ℝ) / 2) := by
  have hM0 : 0 < M := by linarith
  have hmR : (8 : ℝ) ≤ m := by exact_mod_cast hm
  have hratio : Q / Pmin ≤ 2 * M ^ (1 / 8 : ℝ) := by
    apply (div_le_iff₀ hP).mpr
    have h := (div_le_iff₀ (show 0 < 2 * M ^ (1 / 8 : ℝ) by positivity)).mp hPlower
    nlinarith
  calc
    _ ≤ (M ^ a) ^ 2 * (2 * M ^ (1 / 8 : ℝ)) ^ m / M ^ (m + 1) :=
      div_le_div_of_nonneg_right
        (mul_le_mul (pow_le_pow_left₀ hQ.le (hQU.trans hUa) 2)
          (pow_le_pow_left₀ (div_nonneg hQ.le hP.le) hratio m)
          (pow_nonneg (div_nonneg hQ.le hP.le) m) (sq_nonneg _)) (by positivity)
    _ = (2 : ℝ) ^ m * ((M ^ a) ^ 2 * (M ^ (1 / 8 : ℝ)) ^ m / M ^ (m + 1)) := by
      rw [mul_pow]
      ring
    _ = (2 : ℝ) ^ m * M ^ (a * 2 + (1 / 8 : ℝ) * (m : ℝ) - ((m : ℝ) + 1)) := by
      rw [← rpow_mul_natCast hM0.le, ← rpow_mul_natCast hM0.le,
        ← rpow_add hM0, ← rpow_natCast M (m + 1), ← rpow_sub hM0]
      norm_num
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le hM.le (by linarith)) (by positivity)

/-- Large denominators retain the same decay, using the high-prime window's
lower endpoint `U/(2M^(1/8))`. -/
theorem rationalPhaseBlockBound_above_prime_le {m : ℕ} {G M R Q Pmin U a : ℝ}
    (hG : 0 ≤ G) (hM : 1 < M) (hR : 0 ≤ R) (hP : 0 < Pmin)
    (hPQ : Pmin ≤ Q) (hRP : R ≤ Pmin) (hQU : Q ≤ U) (hUa : U ≤ M ^ a)
    (hPlower : U / (2 * M ^ (1 / 8 : ℝ)) ≤ Pmin)
    (hm : 8 ≤ m) (hma : 8 * a ≤ (m : ℝ)) :
    rationalPhaseBlockBound m G M R Q Pmin ≤
      (1000 : ℝ) ^ (m + 1) * G ^ m * M ^ (-(m : ℝ) / 2) := by
  have hM0 : 0 < M := by linarith
  have hQ : 0 < Q := hP.trans_le hPQ
  calc
    _ ≤ (36 * (54 : ℝ) ^ m * G ^ m) * (Q ^ 2 * (Q / Pmin) ^ m / M ^ (m + 1)) :=
      rationalPhaseBlockBound_le_high_ratio hG hM0 hR hP hPQ hRP (by omega)
    _ ≤ (36 * (54 : ℝ) ^ m * G ^ m) * ((2 : ℝ) ^ m * M ^ (-(m : ℝ) / 2)) :=
      mul_le_mul_of_nonneg_left (phaseBlock_above_prime_ratio_le hM hQ hP hQU hUa hPlower hm hma)
        (by positivity)
    _ = (36 * (108 : ℝ) ^ m * G ^ m) * M ^ (-(m : ℝ) / 2) := by
      rw [show (108 : ℝ) = 54 * 2 by norm_num, mul_pow]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (phaseBlock_coefficient_le m (by norm_num : (0 : ℝ) ≤ 108) (by norm_num))
        (pow_nonneg hG m)) (rpow_nonneg hM0.le _)

