section

/- Quantitative upper and lower reciprocal mass bounds for prime windows. -/

open Real

namespace Erdos859Verification

theorem primeLogWindowMass_upper {a b : ℝ}
    (ha : log 2 ≤ a) (hab : a ≤ b) :
    primeLogWindowMass a b ≤ (b - a + 2 * mertensErrorConstant) / a := by
  have ha0 : 0 < a := lt_of_lt_of_le (log_pos (by norm_num)) ha
  have hb0 : 0 < b := ha0.trans_le hab
  have hlog : log (b / a) ≤ (b - a) / a := by
    have h := log_le_sub_one_of_pos (div_pos hb0 ha0)
    convert h using 1
    field_simp
  have h := (abs_le.mp (primeLogWindowMass_estimate ha hab)).2
  calc
    _ ≤ log (b / a) + 2 * mertensErrorConstant / a := by linarith
    _ ≤ (b - a) / a + 2 * mertensErrorConstant / a := add_le_add hlog le_rfl
    _ = _ := by ring

/-- On every sufficiently high dyadic logarithmic band the reciprocal mass
is bounded below uniformly. -/
theorem primeLogWindowMass_dyadic_lower {a : ℝ}
    (ha : log 2 ≤ a) (hlarge : 4 * mertensErrorConstant ≤ a * log 2) :
    log 2 / 2 ≤ primeLogWindowMass a (2 * a) := by
  have ha0 : 0 < a := lt_of_lt_of_le (log_pos (by norm_num)) ha
  have h := primeLogWindowMass_estimate ha (show a ≤ 2 * a by linarith)
  have hr : 2 * a / a = (2 : ℝ) := by field_simp
  rw [hr] at h
  have herr : 2 * mertensErrorConstant / a ≤ log 2 / 2 := by
    apply (div_le_iff₀ ha0).mpr
    nlinarith
  have hlow := (abs_le.mp h).1
  linarith

end Erdos859Verification

