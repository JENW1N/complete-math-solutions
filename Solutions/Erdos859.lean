  rw [← mul_prod_erase univ (fun j ↦ w j (x j)) (mem_univ i)]
  congr 1
  exact prod_subtype (univ.erase i) (by intro j; simp) (fun j ↦ w j (x j))

/-- The complete product expectation is bounded once every section in one
coordinate is bounded. Coordinate types may depend on the index. -/
theorem finite_product_section_bound {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)]
    (w : ∀ i, α i → ℝ) (F : (∀ i, α i) → ℝ) (i : ι) (c : ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hsection : ∀ z : ∀ j : {j : ι // j ≠ i}, α j,
      ∑ y, w i y * F ((Equiv.piSplitAt i α).symm (y, z)) ≤ c) :
    (∑ x : ∀ i, α i, finiteProductWeight w x * F x) ≤ c := by
  classical
  let v : (∀ j : {j : ι // j ≠ i}, α j) → ℝ :=
    fun z ↦ ∏ j : {j : ι // j ≠ i}, w j (z j)
  have hv : ∀ z, 0 ≤ v z := fun z ↦
    prod_nonneg (fun (j : {j : ι // j ≠ i}) _ ↦ hw j (z j))
  have hvnorm : ∑ z, v z = 1 := sum_finiteProductWeight
    (fun j : {j : ι // j ≠ i} ↦ w j) (fun j ↦ hnorm j)
  have heq : (∑ x : ∀ i, α i, finiteProductWeight w x * F x) =
      ∑ z, ∑ y, v z * w i y * F ((Equiv.piSplitAt i α).symm (y, z)) := by
    rw [← (Equiv.piSplitAt i α).symm.sum_comp
      (fun x ↦ finiteProductWeight w x * F x), Fintype.sum_prod_type, sum_comm]
    apply sum_congr rfl
    intro z _
    apply sum_congr rfl
    intro y _
    rw [finiteProductWeight_split w i]
    have hrest : (∏ j : {j : ι // j ≠ i},
        w j ((Equiv.piSplitAt i α).symm (y, z) j)) = v z := by
      apply prod_congr rfl
      intro j _
      simp [Equiv.piSplitAt_symm_apply, j.property]
    rw [hrest]
    simp [Equiv.piSplitAt_symm_apply, mul_comm]
  rw [heq]
  exact finite_weighted_section_bound v (w i)
    (fun z y ↦ F ((Equiv.piSplitAt i α).symm (y, z))) c hv hvnorm hsection

/-- A sign and a translation preserve a uniform one-dimensional small-ball bound. -/
theorem finite_weighted_affine_smallBall {α : Type*} [Fintype α]
    (w mark : α → ℝ) (h c s t e : ℝ) (he : e = 1 ∨ e = -1)
    (hsmall : ∀ u : ℝ,
      ∑ y, w y * (if |mark y - u| ≤ h then 1 else 0) ≤ c) :
    (∑ y, w y * (if |e * mark y + s - t| ≤ h then 1 else 0)) ≤ c := by
  classical
  rcases he with rfl | rfl
  · convert hsmall (t - s) using 1
    apply sum_congr rfl
    intro y _
    have heq : 1 * mark y + s - t = mark y - (t - s) := by ring
    rw [heq]
  · convert hsmall (s - t) using 1
    apply sum_congr rfl
    intro y _
    have heq : -1 * mark y + s - t = -(mark y - (s - t)) := by ring
    rw [heq, abs_neg]

/-- A coordinate with a uniform small-ball bound controls any observable
whose sections in that coordinate are signed translates of its mark. -/
theorem finite_product_smallBall_of_affine_sections
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)]
    (w : ∀ i, α i → ℝ) (F : (∀ i, α i) → ℝ) (i : ι)
    (mark : α i → ℝ) (h c t : ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hsmall : ∀ u : ℝ,
      ∑ y, w i y * (if |mark y - u| ≤ h then 1 else 0) ≤ c)
    (haffine : ∀ z : ∀ j : {j : ι // j ≠ i}, α j,
      ∃ s e : ℝ, (e = 1 ∨ e = -1) ∧
        ∀ y, F ((Equiv.piSplitAt i α).symm (y, z)) = e * mark y + s) :
    (∑ x : ∀ i, α i, finiteProductWeight w x *
      (if |F x - t| ≤ h then 1 else 0)) ≤ c := by
  classical
  apply finite_product_section_bound w (fun x ↦ if |F x - t| ≤ h then 1 else 0)
    i c hw hnorm
  intro z
  obtain ⟨s, e, he, hF⟩ := haffine z
  simp_rw [hF]
  exact finite_weighted_affine_smallBall (w i) mark h c s t e he hsmall

theorem finite_sum_split {ι : Type*} [Fintype ι] [DecidableEq ι]
    (f : ι → ℝ) (i : ι) :
    (∑ j, f j) = f i + ∑ j : {j : ι // j ≠ i}, f j := by
  rw [← add_sum_erase univ f (mem_univ i)]
  congr 1
  exact sum_subtype (univ.erase i) (by intro j; simp) f

/-- In a signed sum of independent finite marks, one coefficient equal to
`1` or `-1` transfers that coordinate's concentration bound to the sum. -/
theorem finite_product_sum_smallBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    {α : ι → Type*} [∀ i, Fintype (α i)]
    (w mark : ∀ i, α i → ℝ) (coeff : ι → ℝ) (i : ι) (h c t : ℝ)
    (hw : ∀ i y, 0 ≤ w i y) (hnorm : ∀ i, ∑ y, w i y = 1)
    (hcoeff : coeff i = 1 ∨ coeff i = -1)
    (hsmall : ∀ u : ℝ,
      ∑ y, w i y * (if |mark i y - u| ≤ h then 1 else 0) ≤ c) :
    (∑ x : ∀ i, α i, finiteProductWeight w x *
      (if |(∑ j, coeff j * mark j (x j)) - t| ≤ h then 1 else 0)) ≤ c := by
  classical
  apply finite_product_smallBall_of_affine_sections w
    (fun x ↦ ∑ j, coeff j * mark j (x j)) i (mark i) h c t hw hnorm hsmall
  intro z
  refine ⟨∑ j : {j : ι // j ≠ i}, coeff j * mark j (z j), coeff i, hcoeff, ?_⟩
  intro y
  rw [finite_sum_split _ i]
  simp only [Equiv.piSplitAt_symm_apply]
  congr 1
  apply sum_congr rfl
  intro j _
  simp [j.property]

/-- The checked reciprocal-prime estimate in the finite-type interface used
by the product concentration lemmas. -/
theorem primeLogMark_subtype_smallBall {a u h : ℝ} (ha : Real.log 2 ≤ a)
    (hlarge : 4 * mertensErrorConstant ≤ a * Real.log 2) (hh : 0 ≤ h) :
    (∑ p : primeLogWindow a (2 * a), primeLogMarkWeight a (2 * a) p *
      (if |Real.log (p : ℕ) - u| ≤ h then 1 else 0)) ≤
        ((4 + 4 * mertensErrorConstant) / Real.log 2) * ((h + 1) / a) := by
  classical
  let f : ℕ → ℝ := fun p ↦ primeLogMarkWeight a (2 * a) p *
    (if |Real.log (p : ℝ) - u| ≤ h then 1 else 0)
  change (∑ p : primeLogWindow a (2 * a), f p) ≤ _
  rw [sum_coe_sort]
  simpa only [f, mul_ite, mul_one, mul_zero, ← sum_filter] using
    primeLogMark_smallBall (u := u) ha hlarge hh

end Erdos859Verification

