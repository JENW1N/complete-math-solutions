section

/- A finite separated cover whose size is paid for by interval-support volume. -/

namespace Erdos859Verification

open Finset MeasureTheory

def finiteStartIntervalSupport (S : Finset ℝ) (d : ℝ) : Set ℝ :=
  ⋃ a ∈ S, Set.Icc a (a + d)

theorem isCompact_finiteStartIntervalSupport (S : Finset ℝ) (d : ℝ) :
    IsCompact (finiteStartIntervalSupport S d) :=
  S.isCompact_biUnion (fun _ _ ↦ isCompact_Icc)

/-- Greedily keep a new point precisely when it is farther than `d` from
every point already kept. The final set covers all starting points. -/
theorem exists_finite_separated_net (S : Finset ℝ) {d : ℝ} (hd : 0 ≤ d) :
    ∃ J ⊆ S,
      (∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) ∧
      ∀ a ∈ S, ∃ b ∈ J, |a - b| ≤ d := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨∅, by simp, by simp, by simp⟩
  | @insert a S ha ih =>
    obtain ⟨J, hJS, hsep, hcover⟩ := ih
    by_cases hnear : ∃ b ∈ J, |a - b| ≤ d
    · refine ⟨J, hJS.trans (subset_insert a S), hsep, ?_⟩
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hx
      · exact hnear
      · exact hcover x hx
    · have hfar : ∀ b ∈ J, d < |a - b| := by
        intro b hb
        exact lt_of_not_ge (fun h ↦ hnear ⟨b, hb, h⟩)
      refine ⟨insert a J, insert_subset_insert a hJS, ?_, ?_⟩
      · intro x hx y hy hxy
        rcases Finset.mem_insert.mp hx with hxa | hxJ
        · subst x
          rcases Finset.mem_insert.mp hy with hya | hyJ
          · exact (hxy hya.symm).elim
          · exact hfar y hyJ
        · rcases Finset.mem_insert.mp hy with hya | hyJ
          · subst y
            simpa only [abs_sub_comm] using hfar x hxJ
          · exact hsep x hxJ y hyJ hxy
      · intro x hx
        rcases Finset.mem_insert.mp hx with hxa | hxS
        · subst x
          exact ⟨a, mem_insert_self a J, by simpa using hd⟩
        · obtain ⟨b, hb, hxb⟩ := hcover x hxS
          exact ⟨b, mem_insert_of_mem hb, hxb⟩

theorem separated_start_intervals_disjoint {J : Finset ℝ} {d : ℝ}
    (hsep : ∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) :
    Set.PairwiseDisjoint (J : Set ℝ) (fun a ↦ Set.Icc a (a + d)) := by
  intro a ha b hb hab
  apply Set.disjoint_left.mpr
  intro x hx hy
  have hdist : |a - b| ≤ d := abs_le.mpr ⟨by linarith [hx.2, hy.1],
    by linarith [hx.1, hy.2]⟩
  exact (not_le_of_gt (hsep a ha b hb hab)) hdist

theorem separated_start_intervals_volume {J : Finset ℝ} {d : ℝ} (hd : 0 ≤ d)
    (hsep : ∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) :
    volume.real (finiteStartIntervalSupport J d) = (J.card : ℝ) * d := by
  unfold finiteStartIntervalSupport
  rw [measureReal_biUnion_finset (separated_start_intervals_disjoint hsep)
    (fun _ _ ↦ measurableSet_Icc) (fun _ _ ↦ isCompact_Icc.measure_ne_top)]
  simp only [Real.volume_real_Icc, add_sub_cancel_left, max_eq_left hd,
    sum_const, nsmul_eq_mul]

theorem separated_start_card_mul_le {S J : Finset ℝ} {d : ℝ} (hd : 0 ≤ d)
    (hJS : J ⊆ S) (hsep : ∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) :
    (J.card : ℝ) * d ≤ volume.real (finiteStartIntervalSupport S d) := by
  rw [← separated_start_intervals_volume hd hsep]
  apply measureReal_mono _ (isCompact_finiteStartIntervalSupport S d).measure_ne_top
  intro x hx
  obtain ⟨a, ha, hax⟩ := Set.mem_iUnion₂.mp hx
  exact Set.mem_iUnion₂.mpr ⟨a, hJS ha, hax⟩

theorem start_interval_net_covers {S J : Finset ℝ} {d : ℝ}
    (hcover : ∀ a ∈ S, ∃ b ∈ J, |a - b| ≤ d) :
    finiteStartIntervalSupport S d ⊆ ⋃ b ∈ J, Set.Icc (b - d) (b + 2 * d) := by
  intro x hx
  obtain ⟨a, ha, hax⟩ := Set.mem_iUnion₂.mp hx
  obtain ⟨b, hb, hab⟩ := hcover a ha
  obtain ⟨hablo, habhi⟩ := abs_le.mp hab
  exact Set.mem_iUnion₂.mpr ⟨b, hb, by constructor <;> linarith [hax.1, hax.2]⟩

/-- A length-`d` interval support admits a cover by `3d` intervals, one
per selected starting point, with at most support-volume divided by `d` members. -/
theorem exists_interval_support_packing (S : Finset ℝ) {d : ℝ} (hd : 0 < d) :
    ∃ J ⊆ S,
      (∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) ∧
      (∀ a ∈ S, ∃ b ∈ J, |a - b| ≤ d) ∧
      (finiteStartIntervalSupport S d ⊆ ⋃ b ∈ J, Set.Icc (b - d) (b + 2 * d)) ∧
      (J.card : ℝ) * d ≤ volume.real (finiteStartIntervalSupport S d) := by
  obtain ⟨J, hJS, hsep, hcover⟩ := exists_finite_separated_net S hd.le
  exact ⟨J, hJS, hsep, hcover, start_interval_net_covers hcover,
    separated_start_card_mul_le hd.le hJS hsep⟩

theorem finiteIntervalSupport_eq_start_image {ι : Type*} [Fintype ι]
    (atom : ι → ℝ) (d : ℝ) :
    finiteIntervalSupport atom d = finiteStartIntervalSupport (univ.image atom) d := by
  classical
  ext x
  constructor
  · intro hx
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    exact Set.mem_iUnion₂.mpr ⟨atom i, mem_image.mpr ⟨i, mem_univ i, rfl⟩, hi⟩
  · intro hx
    obtain ⟨a, ha, hax⟩ := Set.mem_iUnion₂.mp hx
    obtain ⟨i, _, rfl⟩ := mem_image.mp ha
    exact Set.mem_iUnion.mpr ⟨i, hax⟩

/-- The packing statement permits repeated original atoms: the centers are
selected from their finite image, so duplicates do not cost extra intervals. -/
theorem exists_finiteIntervalSupport_packing {ι : Type*} [Fintype ι]
    (atom : ι → ℝ) {d : ℝ} (hd : 0 < d) :
    ∃ J : Finset ℝ,
      (∀ b ∈ J, ∃ i, atom i = b) ∧
      (∀ a ∈ J, ∀ b ∈ J, a ≠ b → d < |a - b|) ∧
      (∀ i, ∃ b ∈ J, |atom i - b| ≤ d) ∧
      (finiteIntervalSupport atom d ⊆ ⋃ b ∈ J, Set.Icc (b - d) (b + 2 * d)) ∧
      (J.card : ℝ) ≤ volume.real (finiteIntervalSupport atom d) / d := by
  classical
  obtain ⟨J, hJS, hsep, hcover, hsub, hvol⟩ :=
    exists_interval_support_packing (univ.image atom) hd
  rw [← finiteIntervalSupport_eq_start_image atom d] at hsub hvol
  refine ⟨J, ?_, hsep, ?_, hsub, (le_div_iff₀ hd).mpr hvol⟩
  · intro b hb
    obtain ⟨i, _, hi⟩ := mem_image.mp (hJS hb)
    exact ⟨i, hi⟩
  · intro i
    exact hcover (atom i) (mem_image.mpr ⟨i, mem_univ i, rfl⟩)


end Erdos859Verification

