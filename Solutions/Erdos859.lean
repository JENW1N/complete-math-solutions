theorem exists_practicalSeed_tilted_polylog_lower :
    ∃ c : ℝ, 0 < c ∧ ∃ C : ℝ, 0 < C ∧ ∀ Z : ℕ, 210 < Z →
      ∀ P : Finset ℕ, (∀ p ∈ P, p.Prime) →
        practicalSeedPrimeUniverse (seedWindowCount Z) ⊆ P →
        ∀ lam : ℝ, 1 ≤ lam →
          c / (log (Z : ℝ)) ^ C ≤
