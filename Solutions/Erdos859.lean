  ext x
  simp only [finiteIntervalSupport, Set.mem_iUnion, Set.mem_preimage, Set.mem_Icc]
  constructor <;> rintro ⟨i, hlo, hhi⟩ <;>
    exact ⟨i, by constructor <;> linarith⟩

theorem finiteIntervalSupport_reflection_volume {ι : Type*} [Fintype ι]
    (atom : ι → ℝ) (d t : ℝ) :
    volume.real (finiteIntervalSupport (fun i ↦ t-atom i) d) =
      volume.real (finiteIntervalSupport atom d) := by
  rw [finiteIntervalSupport_reflection, Measure.real,
