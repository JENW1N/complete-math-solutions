/-- Split a finite subset into its part inside `B` and its part outside `B`.
This is an exact reindexing of the powerset, with no probability assumptions. -/
theorem sum_powerset_split_subset {P B : Finset ℕ} (hB : B ⊆ P)
    (G : Finset ℕ → Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, G (T ∩ B) (T \ B)) =
      ∑ U ∈ B.powerset, ∑ V ∈ (P \ B).powerset, G U V := by
  rw [← sum_product']
  apply sum_bij (fun T _ ↦ (T ∩ B, T \ B))
  · intro T hT
    apply mem_product.mpr
    constructor
    · exact mem_powerset.mpr inter_subset_right
    · apply mem_powerset.mpr
      intro p hp
      exact mem_sdiff.mpr ⟨mem_powerset.mp hT (mem_sdiff.mp hp).1,
        (mem_sdiff.mp hp).2⟩
  · intro S _ T _ h
    have heq := congrArg (fun UV : Finset ℕ × Finset ℕ ↦ UV.2 ∪ UV.1) h
    simpa only [sdiff_union_inter] using heq
  · rintro ⟨U, V⟩ hUV
    obtain ⟨hU, hV⟩ := mem_product.mp hUV
    have hUB : U ⊆ B := mem_powerset.mp hU
    have hVD : V ⊆ P \ B := mem_powerset.mp hV
    refine ⟨U ∪ V, mem_powerset.mpr ?_, ?_⟩
    · intro p hp
      rcases mem_union.mp hp with hp | hp
      · exact hB (hUB hp)
      · exact (mem_sdiff.mp (hVD hp)).1
    · apply Prod.ext
      · apply Finset.ext
        intro p
        simp only [Finset.mem_inter, Finset.mem_union]
        constructor
        · rintro ⟨hp | hp, hpB⟩
          · exact hp
          · exact False.elim ((mem_sdiff.mp (hVD hp)).2 hpB)
        · intro hp
          exact ⟨Or.inl hp, hUB hp⟩
      · apply Finset.ext
        intro p
        simp only [Finset.mem_sdiff, Finset.mem_union]
        constructor
        · rintro ⟨hp | hp, hpB⟩
          · exact False.elim (hpB (hUB hp))
          · exact hp
        · intro hp
          exact ⟨Or.inr hp, (mem_sdiff.mp (hVD hp)).2⟩
  · intro T _
    rfl

