noncomputable def signedCubeValueSet {ι : Type*} [Fintype ι]
    (w : ι → ℕ) (H : ℕ) : Finset ℤ :=
  (signedCoefficientBox ι H).image (signedCubeValue w)

theorem zero_mem_signedCubeValueSet {ι : Type*} [Fintype ι] (w : ι → ℕ) (H : ℕ) :
    0 ∈ signedCubeValueSet w H := by
  classical
  apply mem_image.mpr
  refine ⟨fun _ ↦ 0, mem_signedCoefficientBox.mpr (fun _ ↦ by simp), ?_⟩
  simp [signedCubeValue]

theorem proper_signedCubeValueSet_card {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H) :
    (signedCubeValueSet w H).card = (2 * H + 1) ^ Fintype.card ι := by
  rw [signedCubeValueSet, card_image_of_injOn]
  · exact card_signedCoefficientBox ι H
  · intro c hc c' hc' heq
    exact hproper c c' (mem_signedCoefficientBox.mp hc) (mem_signedCoefficientBox.mp hc') heq

noncomputable def integerSetFourierSum (S : Finset ℤ) : C(AddCircle (1 : ℝ), ℂ) :=
  ∑ n ∈ S, fourier n

theorem integerSetFourierSum_energy (S : Finset ℤ) :
    (∫ x : AddCircle (1 : ℝ), ‖integerSetFourierSum S x‖ ^ 2 ∂ AddCircle.haarAddCircle) =
      (S.card : ℝ) := by
  have horth := (orthonormal_fourier (T := (1 : ℝ))).inner_sum
    (fun _ : ℤ ↦ (1 : ℂ)) (fun _ : ℤ ↦ (1 : ℂ)) S
  have hmap : ContinuousMap.toLp 2 AddCircle.haarAddCircle ℂ (integerSetFourierSum S) =
      ∑ n ∈ S, fourierLp (T := (1 : ℝ)) 2 n := by
    simp only [integerSetFourierSum, map_sum, fourierLp]
  have hcomplex : (∫ x : AddCircle (1 : ℝ),
      integerSetFourierSum S x * conj (integerSetFourierSum S x) ∂ AddCircle.haarAddCircle) =
      (S.card : ℂ) := by
    rw [← ContinuousMap.inner_toLp, hmap]
    simpa only [one_smul, map_one, mul_one, sum_const, nsmul_eq_mul, mul_one] using horth
  simp only [Complex.mul_conj', ← Complex.ofReal_pow] at hcomplex
  exact_mod_cast hcomplex

noncomputable def integerSetFourierMean (S : Finset ℤ) (x : AddCircle (1 : ℝ)) : ℂ :=
  integerSetFourierSum S x / (S.card : ℂ)

theorem integerSetFourierMean_energy {S : Finset ℤ} (hS : S.Nonempty) :
    (∫ x : AddCircle (1 : ℝ), ‖integerSetFourierMean S x‖ ^ 2 ∂ AddCircle.haarAddCircle) =
      1 / (S.card : ℝ) := by
  have hcard : (S.card : ℝ) ≠ 0 := by exact_mod_cast card_ne_zero.mpr hS
  simp only [integerSetFourierMean, norm_div, Complex.norm_natCast, div_pow]
  rw [integral_div, integerSetFourierSum_energy]
  field_simp

theorem proper_signedCubeFourier_energy {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H) :
    (∫ x : AddCircle (1 : ℝ), ‖integerSetFourierMean (signedCubeValueSet w H) x‖ ^ 2
      ∂ AddCircle.haarAddCircle) = 1 / (2 * (H : ℝ) + 1) ^ Fintype.card ι := by
  rw [integerSetFourierMean_energy ⟨0, zero_mem_signedCubeValueSet w H⟩,
    proper_signedCubeValueSet_card w hproper]
  push_cast
  rfl

