theorem signedCoefficientBox_secondMoment_le {ι : Type*} [Fintype ι]
    (H : ℕ) (t : ι → ℝ) :
    (∑ c ∈ signedCoefficientBox ι H, (∑ i, (c i : ℝ) * t i) ^ 2) /
