      (fun S ↦ volume.real (primeSubsetSumSupport S d) / D S ^ 2) ≤
      ((16 + 32 * fordFourthMomentConstant * fordLogMomentConstant) / (log x) ^ 2) *
        insertionWeightedSum P fordPrimeOdds (fun S ↦ volume.real (primeSubsetSumSupport S d)) := by
  have hlx : 0 < log x := log_pos (by linarith)
  let f : Finset ℕ → ℝ := fun S ↦ volume.real (primeSubsetSumSupport S d)
  let bad : Finset ℕ → ℝ := fun S ↦ if D S < log x / 4 then f S / D S ^ 2 else 0
  have hpoint (S : Finset ℕ) : f S / D S ^ 2 ≤ (16 / (log x) ^ 2) * f S + bad S := by
    have hf : 0 ≤ f S := measureReal_nonneg
    by_cases hsmall : D S < log x / 4
    · simp only [bad, if_pos hsmall]
      have hnonneg : 0 ≤ (16 / (log x) ^ 2) * f S := by positivity
      linarith
    · have hD : log x / 4 ≤ D S := le_of_not_gt hsmall
      have hsq : (log x) ^ 2 / 16 ≤ D S ^ 2 := by nlinarith
      simp only [bad, if_neg hsmall, add_zero]
      calc
        _ ≤ f S / ((log x) ^ 2 / 16) :=
          div_le_div_of_nonneg_left hf (by positivity) hsq
        _ = _ := by ring
