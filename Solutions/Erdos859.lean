noncomputable def finiteBinMass {α β : Type*} [Fintype α] [DecidableEq β]
    (weight : α → ℝ) (bin : α → β) (j : β) : ℝ :=
  ∑ p with bin p = j, weight p

/-- Each label tuple has precisely the product of its bin masses as its
total preimage weight. No normalization or positivity is required. -/
theorem finite_bin_tuple_fiber {ι α β : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype α] [Fintype β] [DecidableEq β]
    (weight : α → ℝ) (bin : α → β) (y : ι → β) :
    (∑ x : ι → α with (fun i ↦ bin (x i)) = y, ∏ i, weight (x i)) =
      ∏ i, finiteBinMass weight bin (y i) := by
  classical
  simp only [finiteBinMass, sum_filter]
  rw [Fintype.prod_sum]
  apply sum_congr rfl
  intro x _
  rw [Fintype.prod_ite_zero]
  simp only [funext_iff]

/-- Exact pushforward of the product law through a finite binning map,
valid for every event on ordered labels. -/
theorem finite_bin_event_pushforward {ι α β : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype α] [Fintype β] [DecidableEq β]
    (weight : α → ℝ) (bin : α → β) (Good : (ι → β) → Prop)
    [DecidablePred Good] :
    (∑ x : ι → α with Good (fun i ↦ bin (x i)), ∏ i, weight (x i)) =
      ∑ y : ι → β with Good y, ∏ i, finiteBinMass weight bin (y i) := by
  classical
  simp_rw [← finite_bin_tuple_fiber]
  symm
  simpa only [mem_filter, mem_univ, true_and] using
    sum_fiberwise_eq_sum_filter (univ : Finset (ι → α))
      (univ.filter Good) (fun x i ↦ bin (x i)) (fun x ↦ ∏ i, weight (x i))

theorem finite_bin_ballot_pushforward {n : ℕ} {α : Type*} [Fintype α]
    (weight : α → ℝ) (bin : α → Fin n) :
    (∑ x : Fin n → α with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
      ∏ i, weight (x i)) =
      ∑ y : Fin n → Fin n with CyclicBallot (occupancyCount y),
        ∏ i, finiteBinMass weight bin (y i) :=
  finite_bin_event_pushforward weight bin (fun y ↦ CyclicBallot (occupancyCount y))

