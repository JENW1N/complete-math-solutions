  classical
  have hp (x : α) : w x ≤
      (if Keep x ∧ Good x then w x else 0) +
      w x * (if Good x then 0 else 1) + w x * (if Keep x then 0 else 1) := by
    by_cases hg : Good x <;> by_cases hk : Keep x <;> simp [hg, hk, hw x]
  have hs := sum_le_sum (fun x (_ : x ∈ (univ : Finset α)) ↦ hp x)
  rw [sum_add_distrib, sum_add_distrib, hnorm, ← sum_filter] at hs
  linarith

