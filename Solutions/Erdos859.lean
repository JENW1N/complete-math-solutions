    (x : α → AddCircle (1 : ℝ)) {delta R : ℝ}
    (hdelta : 0 < delta) (hdelta1 : delta ≤ 1) (hR : 0 ≤ R)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → delta ≤ dist (x i) (x j))
