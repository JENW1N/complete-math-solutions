    (hP : ∀ p ∈ P, p.Prime) (hlog : ∀ p ∈ P, v ≤ log (p : ℝ))
    (hw : ∀ p ∈ P, 0 ≤ w p) (hatom : ∀ p ∈ P, w p ≤ alpha)
    (hD : ∀ m ∈ D, 0 < m ∧ m ≤ T)
    (hbad : ∀ p ∈ P, Bad p → ∃ m ∈ D, p ∣ m) :
    (∑ p ∈ P.filter Bad, w p) ≤
      (alpha / v) * (D.card : ℝ) * log (T : ℝ) := by
  classical
  calc
    _ ≤ ∑ p ∈ P.filter (fun p ↦ ∃ m ∈ D, p ∣ m), w p := by
      apply sum_le_sum_of_subset_of_nonneg
      · intro p hp
        exact mem_filter.mpr ⟨(mem_filter.mp hp).1,
          hbad p (mem_filter.mp hp).1 (mem_filter.mp hp).2⟩
      · intro p hp _
        exact hw p (mem_filter.mp hp).1
