  ext p
  simp only [Finset.mem_union, mem_primeLogWindow]
  constructor
  · rintro (⟨hp, hpa, hpb⟩ | ⟨hp, hpb, hpc⟩)
    · exact ⟨hp, hpa, hpb.trans hbc⟩
    · exact ⟨hp, hab.trans_lt hpb, hpc⟩
