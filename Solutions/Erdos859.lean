section

/- Adaptive quadratic hole filling under finite independent prime-subset laws. -/

namespace Erdos859Verification

open Finset Real MeasureTheory

theorem sum_piFinset_snoc {α : Type*} [DecidableEq α]
    (S : ℕ → Finset α) (n : ℕ) (F : (Fin (n + 1) → α) → ℝ) :
    (∑ x ∈ Fintype.piFinset (fun i : Fin (n + 1) ↦ S i.val), F x) =
      ∑ x ∈ Fintype.piFinset (fun i : Fin n ↦ S i.val), ∑ y ∈ S n, F (Fin.snoc x y) := by
  classical
  have he := Finset.filter_piFinset_eq_map_snocEquiv
    (fun i : Fin (n + 1) ↦ S i.val) (fun _ ↦ True)
  simp only [filter_true] at he
  rw [he, sum_map, sum_product, sum_comm]
  rfl

theorem finite_adaptive_prefix_lower {α : Type*} [DecidableEq α]
    (S : ℕ → Finset α) (w : ℕ → α → ℝ) (c : ℕ → ℝ)
    (Good : (n : ℕ) → (Fin n → α) → Prop) [∀ n, DecidablePred (Good n)]
    (hw : ∀ i x, x ∈ S i → 0 ≤ w i x)
    (hzero : ∀ x, Good 0 x) (n : ℕ)
    (hc : ∀ i < n, 0 ≤ c i)
    (hstep : ∀ i < n, ∀ x ∈ Fintype.piFinset (fun j : Fin i ↦ S j.val), Good i x →
      c i ≤ ∑ y ∈ S i, w i y * (if Good (i + 1) (Fin.snoc x y) then 1 else 0)) :
    (∏ i ∈ range n, c i) ≤
      ∑ x ∈ Fintype.piFinset (fun i : Fin n ↦ S i.val),
        (∏ i, w i.val (x i)) * (if Good n x then 1 else 0) := by
  classical
  induction n with
  | zero => simp [hzero]
  | succ n ih =>
    have hi := ih (fun i hi ↦ hc i (by omega)) (fun i hi ↦ hstep i (by omega))
    rw [prod_range_succ]
    apply (mul_le_mul_of_nonneg_right hi (hc n (by omega))).trans
    rw [sum_mul, sum_piFinset_snoc]
    apply sum_le_sum
    intro x hx
    have hweight : 0 ≤ ∏ i : Fin n, w i.val (x i) :=
      prod_nonneg (fun i _ ↦ hw i.val (x i) (Fintype.mem_piFinset.mp hx i))
    have hfactor : (∑ y ∈ S n, (∏ i : Fin (n + 1), w i.val ((Fin.snoc x y : Fin (n + 1) → α) i)) *
        (if Good (n + 1) (Fin.snoc x y) then 1 else 0)) =
        (∏ i : Fin n, w i.val (x i)) *
          (∑ y ∈ S n, w n y * (if Good (n + 1) (Fin.snoc x y) then 1 else 0)) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      rw [Fin.prod_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last, mul_assoc]
    rw [hfactor]
    by_cases hg : Good n x
    · rw [if_pos hg, mul_one]
      exact mul_le_mul_of_nonneg_left (hstep n (by omega) x hx hg) hweight
    · rw [if_neg hg, mul_zero, zero_mul]
      exact mul_nonneg hweight (sum_nonneg (fun y hy ↦ mul_nonneg (hw n y hy)
        (by split_ifs <;> norm_num)))

theorem isCompact_realTranslateSet {A : Set ℝ} (hA : IsCompact A) (g : ℝ) :
    IsCompact (realTranslateSet A g) := by
  have heq : realTranslateSet A g = (fun x : ℝ ↦ x + g) '' A := by
    ext z
    constructor
    · intro hz
      exact ⟨z - g, hz, sub_add_cancel z g⟩
    · rintro ⟨x, hx, rfl⟩
      simpa only [realTranslateSet, Set.mem_preimage, add_sub_cancel_right] using hx
  rw [heq]
  exact hA.image (by fun_prop)

def quadraticHoleInterval (ell a b : ℝ) (n : ℕ) : Set ℝ :=
  Set.Icc (a + quadraticHoleTrim ell n) (b - quadraticHoleTrim ell n)

theorem quadraticHoleInterval_succ (ell a b : ℝ) (n : ℕ) :
    quadraticHoleInterval ell a b (n + 1) =
      Set.Icc ((a + quadraticHoleTrim ell n) + quadraticHoleWidth ell n)
        ((b - quadraticHoleTrim ell n) - quadraticHoleWidth ell n) := by
  simp only [quadraticHoleInterval, quadraticHoleTrim_succ, add_assoc, sub_add_eq_sub_sub]

inductive PrimePairHolePath (ell e a b : ℝ) (A : Set ℝ) :
    (n : ℕ) → (Fin n → Finset ℕ) → Set ℝ → Prop where
  | initial (x : Fin 0 → Finset ℕ) : PrimePairHolePath ell e a b A 0 x A
  | step {n : ℕ} {x : Fin n → Finset ℕ} {S : Set ℝ}
      (hpath : PrimePairHolePath ell e a b A n x S)
      {T : Finset ℕ} (hcard : T.card = 2) {p q : ℕ} (hp : p ∈ T) (hq : q ∈ T)
      (hholes : volume.real (quadraticHoleInterval ell a b (n + 1) \
        realSupportThickening (S ∪ realTranslateSet S (log (p : ℝ) - log (q : ℝ))) e) ≤
        4 * (volume.real (quadraticHoleInterval ell a b n \ S)) ^ 2 / quadraticHoleWidth ell n) :
      PrimePairHolePath ell e a b A (n + 1) (Fin.snoc x T)
        (realSupportThickening (S ∪ realTranslateSet S (log (p : ℝ) - log (q : ℝ))) e)

theorem PrimePairHolePath.isCompact {ell e a b : ℝ} {A S : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairHolePath ell e a b A n x S)
    (hA : IsCompact A) : IsCompact S := by
  induction h with
  | initial => exact hA
  | step _ _ _ _ _ ih =>
    exact isCompact_realSupportThickening (ih.union (isCompact_realTranslateSet ih _)) _

theorem PrimePairHolePath.counts {ell e a b : ℝ} {A S : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairHolePath ell e a b A n x S) :
    ∀ i, (x i).card = 2 := by
  induction h with
  | initial => exact fun i ↦ Fin.elim0 i
  | step _ hcard _ _ _ ih =>
    apply Fin.lastCases
    · simpa only [Fin.snoc_last] using hcard
    · intro i
      simpa only [Fin.snoc_castSucc] using ih i

theorem PrimePairHolePath.hole_bound {ell e a b : ℝ} {A S : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairHolePath ell e a b A n x S)
    (hell : 0 < ell) (hstart : volume.real (Set.Icc a b \ A) ≤ ell / (2 : ℝ) ^ 10) :
    volume.real (quadraticHoleInterval ell a b n \ S) ≤
      ell / (2 : ℝ) ^ quadraticHoleExponent n := by
  induction h with
  | initial =>
    simpa only [quadraticHoleInterval, quadraticHoleTrim_zero, add_zero, sub_zero,
      quadraticHoleExponent, pow_zero, Nat.mul_one, Nat.add_zero] using hstart
  | @step n x S hp T hc p q hpm hqm hh ih =>
    have hold : volume.real (quadraticHoleInterval ell a b n \ S) / ell ≤
        1 / (2 : ℝ) ^ quadraticHoleExponent n := by
      apply (div_le_iff₀ hell).mpr
      simpa only [div_eq_mul_inv, one_mul, mul_comm] using ih
    have hnew := quadraticHole_step_normalize hell n hh
    have hbound := hnew.trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (div_nonneg measureReal_nonneg hell.le) hold 2) (by positivity))
    rw [quadraticHole_step_identity n] at hbound
    have hphys := (div_le_iff₀ hell).mp hbound
    simpa only [div_eq_mul_inv, one_mul, mul_comm] using hphys

theorem thickening_subset_finiteThickenedTranslateSupport {A S : Set ℝ}
    {ι : Type*} {P : Finset ι} {x : ι → ℝ} {d e : ℝ}
    (hS : S ⊆ finiteThickenedTranslateSupport A P x d) :
    realSupportThickening S e ⊆ finiteThickenedTranslateSupport A P x (d + e) := by
  intro z hz
  obtain ⟨t, ht, hzt⟩ := hz
  obtain ⟨J, hJ, a, ha, hta⟩ := mem_finiteThickenedTranslateSupport.mp (hS ht)
  refine mem_finiteThickenedTranslateSupport.mpr ⟨J, hJ, a, ha, ?_⟩
  have hid : z - a - (∑ i ∈ J, x i) = (z - t) + (t - a - (∑ i ∈ J, x i)) := by ring
  rw [hid]
  exact (abs_add_le _ _).trans (by linarith)

theorem finiteThickenedTranslateSupport_snoc {n : ℕ} (A : Set ℝ) (x : Fin n → ℝ) (g d : ℝ) :
    finiteThickenedTranslateSupport A univ (Fin.snoc x g) d =
      finiteThickenedTranslateSupport A univ x d ∪
        realTranslateSet (finiteThickenedTranslateSupport A univ x d) g := by
  simpa only [finiteThickenedTranslateSupport, finiteBitTranslateSupport_eq_subsetSupport] using
    finiteBitTranslateSupport_snoc (realSupportThickening A d) x g

theorem thickened_refinement_step_subset {A S : Set ℝ} {n : ℕ}
    {x : Fin n → ℝ} {d e g : ℝ}
    (hS : S ⊆ finiteThickenedTranslateSupport A univ x d) :
    realSupportThickening (S ∪ realTranslateSet S g) e ⊆
      finiteThickenedTranslateSupport A univ (Fin.snoc x g) (d + e) := by
  rw [realSupportThickening_union_translate, finiteThickenedTranslateSupport_snoc]
  have ht := thickening_subset_finiteThickenedTranslateSupport (e := e) hS
  exact Set.union_subset_union ht (fun _ hz ↦ ht hz)

theorem PrimePairHolePath.geometry {ell e a b : ℝ} {A S : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairHolePath ell e a b A n x S) :
    ∃ g : Fin n → ℝ,
      (∀ i, ∃ p ∈ x i, ∃ q ∈ x i, g i = log (p : ℝ) - log (q : ℝ)) ∧
      S ⊆ finiteThickenedTranslateSupport A univ g ((n : ℝ) * e) := by
  induction h with
  | initial x =>
    let g : Fin 0 → ℝ := fun i ↦ Fin.elim0 i
    refine ⟨g, fun i ↦ Fin.elim0 i, ?_⟩
    have hz := finiteBitTranslateSupport_zero A g
    rw [finiteBitTranslateSupport_eq_subsetSupport] at hz
    simpa only [Nat.cast_zero, zero_mul, finiteThickenedTranslateSupport,
      realSupportThickening_zero, hz] using Set.Subset.refl A
  | @step n x S hpath T hc p q hp hq hh ih =>
    obtain ⟨g, hg, hS⟩ := ih
    refine ⟨Fin.snoc g (log (p : ℝ) - log (q : ℝ)), ?_, ?_⟩
    · apply Fin.lastCases
      · simpa only [Fin.snoc_last] using ⟨p, hp, q, hq, rfl⟩
      · intro i
        simpa only [Fin.snoc_castSucc] using hg i
    · have ht := thickened_refinement_step_subset (e := e)
        (g := log (p : ℝ) - log (q : ℝ)) hS
      convert ht using 1
      congr 1
      push_cast
      ring

def PrimePairHoleSuccess (ell e a b : ℝ) (A : Set ℝ) (n : ℕ)
    (x : Fin n → Finset ℕ) : Prop := ∃ S, PrimePairHolePath ell e a b A n x S

theorem PrimePairHoleSuccess.mesh {ell e a b : ℝ} {A : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairHoleSuccess ell e a b A n x)
    (hell : 0 < ell) (hstart : volume.real (Set.Icc a b \ A) ≤ ell / (2 : ℝ) ^ 10) :
    (∀ i, (x i).card = 2) ∧ ∃ g : Fin n → ℝ,
      (∀ i, ∃ p ∈ x i, ∃ q ∈ x i, g i = log (p : ℝ) - log (q : ℝ)) ∧
      volume.real (quadraticHoleInterval ell a b n \
        finiteThickenedTranslateSupport A univ g ((n : ℝ) * e)) ≤
          ell / (2 : ℝ) ^ quadraticHoleExponent n := by
  obtain ⟨S, hpath⟩ := h
  obtain ⟨g, hg, hS⟩ := hpath.geometry
  refine ⟨hpath.counts, g, hg, ?_⟩
  apply le_trans _ (hpath.hole_bound hell hstart)
  exact measureReal_mono (Set.sdiff_subset_sdiff_right hS)
    (measure_ne_top_of_subset Set.sdiff_subset isCompact_Icc.measure_ne_top)

noncomputable def primePairStepCost (eps eta : ℝ) : ℝ :=
  eta * exp (-5 * eps) * (eps / 4) ^ 2 / 2

def PrimePairHoleWindowConditions (ell : ℝ) (u eps eta : ℕ → ℝ) (n : ℕ) : Prop :=
  ∀ i < n, log 2 ≤ u i ∧ 0 < eps i ∧ eps i ≤ 1 ∧
    8 * primeLogOddsErrorConstant ≤ eps i * u i ∧ 0 ≤ eta i ∧
    eta i ≤ (1 : ℝ) / 2 - 64 * exp (-u i) / eps i ∧
    eps i * u i = quadraticHoleWidth ell i

theorem primeTilt_independent_adaptive_hole_filling
    {A : Set ℝ} (hA : IsCompact A) {ell a b lam : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (u eps eta : ℕ → ℝ) (n : ℕ)
    (hwin : PrimePairHoleWindowConditions ell u eps eta n) :
    (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
      ∑ x ∈ primeBandSelections (fun i : Fin n ↦ primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)),
        (∏ i, primeTiltWeight (primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)) lam (x i)) *
          (if PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A n x then 1 else 0) := by
  classical
  let P : ℕ → Finset ℕ := fun i ↦ primeLogWindow (u i) ((1 + eps i) * u i)
  change (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
    ∑ x ∈ Fintype.piFinset (fun i : Fin n ↦ (P i.val).powerset),
      (∏ i, primeTiltWeight (P i.val) lam (x i)) *
        (if PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A n x then 1 else 0)
  apply finite_adaptive_prefix_lower (fun i ↦ (P i).powerset)
    (fun i T ↦ primeTiltWeight (P i) lam T) (fun i ↦ primePairStepCost (eps i) (eta i))
    (PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A)
  · intro i T _
    exact (primeTiltWeight_pos (fun p hp ↦ (mem_primeLogWindow.mp hp).1)
      (by linarith : 0 < lam) T).le
  · intro x
    exact ⟨A, PrimePairHolePath.initial x⟩
  · intro i hi
    have heta := (hwin i hi).2.2.2.2.1
    unfold primePairStepCost
    positivity
  · intro i hi x _ hx
    obtain ⟨S, hpath⟩ := hx
    obtain ⟨hui, hepsi, hepsi1, hlarge, hetai, hmargin, hwidth⟩ := hwin i hi
    let ai := a + quadraticHoleTrim ell i
    let bi := b - quadraticHoleTrim ell i
    let StepGood : Finset ℕ → Prop := fun T ↦ T.card = 2 ∧
      PrimePairHoleFillingEvent S (Set.Icc (ai + eps i * u i) (bi - eps i * u i))
        (32 * primeLogOddsErrorConstant)
        (4 * (volume.real (Set.Icc ai bi \ S)) ^ 2 / (eps i * u i)) T
    have hlocal : primePairStepCost (eps i) (eta i) ≤
        ∑ T ∈ (P i).powerset.filter StepGood, primeTiltWeight (P i) lam T :=
      primeTilt_two_prime_hole_filling (hpath.isCompact hA) hlam hlam2 hui
        hepsi hepsi1 hlarge hetai hmargin
    have hext (T : Finset ℕ) (hT : StepGood T) :
        PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A (i + 1) (Fin.snoc x T) := by
      obtain ⟨hcard, p, hp, q, hq, hholes⟩ := hT
      refine ⟨_, PrimePairHolePath.step hpath hcard hp hq ?_⟩
      rw [quadraticHoleInterval_succ]
      simpa only [ai, bi, hwidth, quadraticHoleInterval] using hholes
    apply hlocal.trans
    rw [sum_filter]
    apply sum_le_sum
    intro T _
    have hwT : 0 ≤ primeTiltWeight (P i) lam T :=
      (primeTiltWeight_pos (fun p hp ↦ (mem_primeLogWindow.mp hp).1)
        (by linarith : 0 < lam) T).le
    change (if StepGood T then primeTiltWeight (P i) lam T else 0) ≤
      primeTiltWeight (P i) lam T *
        (if PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A (i + 1)
          (Fin.snoc x T) then 1 else 0)
    by_cases hT : StepGood T
    · simp only [if_pos hT, if_pos (hext T hT), mul_one, le_refl]
    · simp only [if_neg hT]
      exact mul_nonneg hwT (by split_ifs <;> norm_num)

theorem primeTilt_ambient_adaptive_hole_filling
    {A : Set ℝ} (hA : IsCompact A) {ell a b lam : ℝ}
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (u eps eta : ℕ → ℝ) (n : ℕ)
    (hwin : PrimePairHoleWindowConditions ell u eps eta n)
    (hdis : Pairwise (fun i j : Fin n ↦
      Disjoint (primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))
        (primeLogWindow (u j.val) ((1 + eps j.val) * u j.val)))) :
    (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
      ∑ T ∈ (primeBandUnion (fun i : Fin n ↦
        primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))).powerset,
        primeTiltWeight (primeBandUnion (fun i : Fin n ↦
          primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))) lam T *
          (if PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A n
            (fun i ↦ T ∩ primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)) then 1 else 0) := by
  classical
  rw [prime_tilt_expectation_primeBand_partition _ hdis lam
    (fun x ↦ if PrimePairHoleSuccess ell (32 * primeLogOddsErrorConstant) a b A n x then 1 else 0)]
  exact primeTilt_independent_adaptive_hole_filling hA hlam hlam2 u eps eta n hwin

theorem primeBandSelections_weights_normalized {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (hP : ∀ i p, p ∈ P i → p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ x ∈ primeBandSelections P, ∏ i, primeTiltWeight (P i) lam (x i)) = 1 := by
  classical
  rw [primeBandSelections, ← prod_univ_sum]
  simp only [sum_primeTiltWeight (hP _) hlam, prod_const_one]

end Erdos859Verification

