    intro j
    by_cases hj : ∃ i, f i = j
    · obtain ⟨i, rfl⟩ := hj
      simpa only [hf.extend_apply] using hc i
    · rw [Function.extend_apply' _ _ _ hj]
      simp only [abs_zero, Int.natCast_nonneg]
  intro c c' hc hc' heq
  have hext := hproper (Function.extend f c (fun _ ↦ 0)) (Function.extend f c' (fun _ ↦ 0))
    (hbound c hc) (hbound c' hc') (by
      rw [signedCubeValue_extend_injective f hf, signedCubeValue_extend_injective f hf]
      exact heq)
