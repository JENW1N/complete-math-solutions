  have ha0 : 0 < a := hlog2.trans_le ha
  have hmass := primeLogWindowMass_dyadic_lower ha hlarge
  have hmasspos : 0 < primeLogWindowMass a (2 * a) := (half_pos hlog2).trans_le hmass
  have hfilter : (primeLogWindow a (2 * a)).filter (fun p : ℕ ↦ |log (p : ℝ) - u| ≤ h) =
      (primeLogWindow a (2 * a)).filter
        (fun p : ℕ ↦ u - h ≤ log (p : ℝ) ∧ log (p : ℝ) ≤ (u - h) + 2 * h) := by
    apply filter_congr
