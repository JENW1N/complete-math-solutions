  intro p hpi hpj
  obtain ⟨_, hilo, hihi⟩ := mem_primeLogWindow.mp hpi
  obtain ⟨_, hjlo, hjhi⟩ := mem_primeLogWindow.mp hpj
  rcases lt_or_gt_of_ne hij with hij | hij
  · have hp : (2 : ℝ) ^ (i + 1) ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) (by omega)
    nlinarith
  · have hp : (2 : ℝ) ^ (j + 1) ≤ 2 ^ i := pow_le_pow_right₀ (by norm_num) (by omega)
    nlinarith

theorem virtualPrimeBand_subset_universe (A B : ℝ) {n j : ℕ} (hj : j < n) :
    virtualPrimeBand A B j ⊆ virtualPrimeUniverse A B n := by
  intro p hp
  exact mem_biUnion.mpr ⟨j, mem_range.mpr hj, hp⟩

