    {H : ℕ} (hc : ∀ i, |c i| ≤ (H : ℤ)) :
    |signedCubeValue w c| ≤ (H : ℤ) * ((∑ i, w i : ℕ) : ℤ) := by
  calc
    _ ≤ ∑ i, |c i * (w i : ℤ)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, (H : ℤ) * (w i : ℤ) := by
      apply sum_le_sum
      intro i _
      rw [abs_mul, abs_of_nonneg (Int.natCast_nonneg _)]
      exact mul_le_mul_of_nonneg_right (hc i) (Int.natCast_nonneg _)
    _ = _ := by rw [← mul_sum, Nat.cast_sum]

