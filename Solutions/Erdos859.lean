theorem exponential_residue_mass_lt_one {r L : ℕ} [NeZero r]
    {u : ℝ} (hL : Real.log (2 * (r : ℝ)) ≤ u * (L : ℝ)) :
    ((r : ℝ) - 1) * Real.exp (-u) ^ L < 1 := by
  have hr : (1 : ℝ) ≤ r := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne r)
  have hrpos : (0 : ℝ) < 2 * (r : ℝ) := by linarith
  have he : Real.exp (-u) ^ L ≤ 1 / (2 * (r : ℝ)) := by
    rw [← Real.exp_nat_mul]
    calc
      _ ≤ Real.exp (-Real.log (2 * (r : ℝ))) := Real.exp_le_exp.mpr (by nlinarith)
      _ = _ := by rw [Real.exp_neg, Real.exp_log hrpos, one_div]
  calc
    _ ≤ ((r : ℝ) - 1) * (1 / (2 * (r : ℝ))) :=
      mul_le_mul_of_nonneg_left he (by linarith)
    _ < 1 := by rw [mul_one_div, div_lt_iff₀ hrpos]; linarith

noncomputable def bernoulliResidueLength (r : ℕ) (Y : ℝ) : ℕ :=
  ⌈Y ^ 2 * Real.log (2 * (r : ℝ))⌉₊

theorem bernoulliResidueLength_sufficient {r : ℕ} [NeZero r]
    {Y : ℝ} (hY : 0 < Y) :
    ((r : ℝ) - 1) * Real.exp (-(2 / Y ^ 2)) ^ bernoulliResidueLength r Y < 1 := by
  have hr : (1 : ℝ) ≤ r := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne r)
  have hlog : 0 ≤ Real.log (2 * (r : ℝ)) := Real.log_nonneg (by linarith)
  have hceil : Y ^ 2 * Real.log (2 * (r : ℝ)) ≤ (bernoulliResidueLength r Y : ℝ) :=
    Nat.le_ceil _
  apply exponential_residue_mass_lt_one
  rw [div_mul_eq_mul_div]
  apply (le_div_iff₀ (sq_pos_of_pos hY)).mpr
  have hp := mul_nonneg (sq_nonneg Y) hlog
  nlinarith

theorem bernoulliResidueLength_le {r : ℕ} [NeZero r] (Y : ℝ) :
    (bernoulliResidueLength r Y : ℝ) ≤ Y ^ 2 * Real.log (2 * (r : ℝ)) + 1 := by
  have hr : (1 : ℝ) ≤ r := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne r)
  exact (Nat.ceil_lt_add_one (mul_nonneg (sq_nonneg Y)
    (Real.log_nonneg (by linarith)))).le

theorem bounded_coin_coefficients_of_exponential_contraction {r : ℕ} [NeZero r]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (w : ι → ℕ)
    {Y : ℝ} (hY : 0 < Y)
