abbrev CappedPrimeState (P : Finset ℕ) (cap : ℕ → ℕ) := ∀ p : P, Fin (cap p.val + 1)

def cappedPrimeStateExtend (P : Finset ℕ) (cap : ℕ → ℕ)
    (e : CappedPrimeState P cap) (p : ℕ) : ℕ :=
  if hp : p ∈ P then (e ⟨p, hp⟩).val else 0

def actualCappedPrimeState (P : Finset ℕ) (cap : ℕ → ℕ) (n : ℕ) : CappedPrimeState P cap :=
  fun p ↦ ⟨cappedPrimeValuation p.val (cap p.val) n, Nat.lt_succ_of_le (cappedPrimeValuation_le _ _ _)⟩

theorem cappedPrimeStateExtend_mem {P : Finset ℕ} {cap : ℕ → ℕ}
    (e : CappedPrimeState P cap) {p : ℕ} (hp : p ∈ P) :
    cappedPrimeStateExtend P cap e p = (e ⟨p, hp⟩).val := by
  simp only [cappedPrimeStateExtend, dif_pos hp]

theorem cappedPrimeStateExtend_le {P : Finset ℕ} {cap : ℕ → ℕ}
    (e : CappedPrimeState P cap) {p : ℕ} (hp : p ∈ P) :
    cappedPrimeStateExtend P cap e p ≤ cap p := by
  rw [cappedPrimeStateExtend_mem e hp]
  exact Nat.le_of_lt_succ (e ⟨p, hp⟩).isLt

noncomputable def cappedPrimeStateWeight (P : Finset ℕ) (cap : ℕ → ℕ)
    (e : CappedPrimeState P cap) : ℝ := primeCappedPatternWeight P cap (cappedPrimeStateExtend P cap e)

theorem cappedPrimeStateWeight_nonneg {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    (cap : ℕ → ℕ) (e : CappedPrimeState P cap) : 0 ≤ cappedPrimeStateWeight P cap e :=
  prod_nonneg fun p hp ↦ cappedPrimeValuationWeight_nonneg (hP p hp) _ _

theorem actualCappedPrimeState_fiber {P : Finset ℕ} (cap : ℕ → ℕ)
    (e : CappedPrimeState P cap) :
    {n : ℕ | actualCappedPrimeState P cap n = e} =
      PrimeCappedValuationPatternSet P cap (cappedPrimeStateExtend P cap e) := by
  ext n
  rw [primeCappedValuationPattern_mem_iff P cap _ (fun p hp ↦ cappedPrimeStateExtend_le e hp) n]
  constructor
  · intro h p hp
    have he := congrArg (fun s : CappedPrimeState P cap ↦ (s ⟨p, hp⟩).val) h
    simpa only [actualCappedPrimeState, cappedPrimeStateExtend_mem e hp] using he
  · intro h
    funext p
    apply Fin.ext
    simpa only [actualCappedPrimeState, cappedPrimeStateExtend_mem e p.property] using h p.val p.property

theorem actualCappedPrimeState_fiber_hasDensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (cap : ℕ → ℕ) (e : CappedPrimeState P cap) :
    {n : ℕ | actualCappedPrimeState P cap n = e}.HasDensity (cappedPrimeStateWeight P cap e) := by
  rw [actualCappedPrimeState_fiber]
  exact primeCappedValuationPattern_hasDensity hP cap _ (fun p hp ↦ cappedPrimeStateExtend_le e hp)

theorem tendsto_mean_cappedPrimeState_observable {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (cap : ℕ → ℕ) (F : CappedPrimeState P cap → ℝ) :
    Tendsto (fun N : ℕ ↦ (∑ n ∈ range N, F (actualCappedPrimeState P cap n)) / N)
      atTop (𝓝 (∑ e : CappedPrimeState P cap, cappedPrimeStateWeight P cap e * F e)) := by
  have hdecomp (n : ℕ) : F (actualCappedPrimeState P cap n) =
      ∑ e : CappedPrimeState P cap,
        {m : ℕ | actualCappedPrimeState P cap m = e}.indicator (fun _ ↦ (1 : ℝ)) n * F e := by
    simp only [Set.indicator_apply, Set.mem_ofPred_eq]
    rw [sum_eq_single (actualCappedPrimeState P cap n)]
    · simp
    · intro e _ hne
      simp only [if_neg (Ne.symm hne), zero_mul]
    · simp
  have heach : ∀ e ∈ (univ : Finset (CappedPrimeState P cap)),
      Tendsto (fun N : ℕ ↦
        ((∑ n ∈ range N, {m : ℕ | actualCappedPrimeState P cap m = e}.indicator
          (fun _ ↦ (1 : ℝ)) n) / N) * F e) atTop (𝓝 (cappedPrimeStateWeight P cap e * F e)) := by
    intro e _
    have he := actualCappedPrimeState_fiber_hasDensity hP cap e
    change Tendsto (fun N ↦ {m : ℕ | actualCappedPrimeState P cap m = e}.partialDensity Set.univ N)
      atTop (𝓝 (cappedPrimeStateWeight P cap e)) at he
    simp_rw [partialDensity_eq_indicator_mean] at he
    exact he.mul_const (F e)
  convert tendsto_finsetSum univ heach using 1
  funext N
  simp only [hdecomp, sum_div, div_mul_eq_mul_div, sum_mul]
  rw [sum_comm]

theorem actualCappedPrimeState_event_hasDensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (cap : ℕ → ℕ) (E : CappedPrimeState P cap → Prop) :
    {n : ℕ | E (actualCappedPrimeState P cap n)}.HasDensity
      (∑ e ∈ univ.filter E, cappedPrimeStateWeight P cap e) := by
  have h := tendsto_mean_cappedPrimeState_observable hP cap (fun e ↦ if E e then 1 else 0)
  have heq : (∑ e : CappedPrimeState P cap, cappedPrimeStateWeight P cap e * (if E e then 1 else 0)) =
      ∑ e ∈ univ.filter E, cappedPrimeStateWeight P cap e := by
    simp only [mul_ite, mul_one, mul_zero, sum_filter]
  rw [heq] at h
  apply hasDensity_of_indicator_mean h
  exact Eventually.of_forall fun n ↦ by simp only [Set.indicator_apply, Set.mem_ofPred_eq]

def cappedPrimeStateProduct (P : Finset ℕ) (cap : ℕ → ℕ) (e : CappedPrimeState P cap) : ℕ :=
  ∏ p ∈ P, p ^ cappedPrimeStateExtend P cap e p

theorem cappedPrimeStateProduct_actual (P : Finset ℕ) (cap : ℕ → ℕ) (n : ℕ) :
    cappedPrimeStateProduct P cap (actualCappedPrimeState P cap n) = cappedPrimeProduct P cap n := by
  apply prod_congr rfl
  intro p hp
  simp only [cappedPrimeStateExtend_mem _ hp, actualCappedPrimeState]

theorem divisorIntervalDensity_eq_cappedState_sum {P : Finset ℕ} {cap : ℕ → ℕ} {y z : ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hcomplete : ∀ p, p.Prime → p ≤ z → p ∈ P)
    (hcap : ∀ p ∈ P, z ≤ cap p) :
    divisorIntervalDensity y z =
      ∑ e ∈ univ.filter (fun e : CappedPrimeState P cap ↦
        cappedPrimeStateProduct P cap e ∈ DivisorIntervalSet y z), cappedPrimeStateWeight P cap e := by
  have h := actualCappedPrimeState_event_hasDensity hP cap
    (fun e ↦ cappedPrimeStateProduct P cap e ∈ DivisorIntervalSet y z)
  have hset : {n : ℕ | cappedPrimeStateProduct P cap (actualCappedPrimeState P cap n) ∈
      DivisorIntervalSet y z} = DivisorIntervalSet y z := by
    ext n
    rw [Set.mem_ofPred_eq, cappedPrimeStateProduct_actual]
    exact (divisorInterval_mem_iff_capped hP hcomplete hcap).symm
  rw [hset] at h
  exact tendsto_nhds_unique (divisorInterval_hasDensity y z) h

end Erdos859Verification

end

/- Inlined development module: PrimeExtensionCertificates.lean -/

section

/- Actual tilted-law bounds for subset-and-fresh-prime failure certificates. -/

open Finset Real

namespace Erdos859Verification

theorem primeTiltWeight_all_selected {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (lam : ℝ) :
    primeTiltWeight P lam P = ∏ p ∈ P, primeTiltSelectionProbability lam p := by
  have hpat : primePatternWeight P P = ∏ p ∈ P, 1 / (p : ℝ) := by
    unfold primePatternWeight
    apply prod_congr rfl
    intro p hp
    simp only [hp, if_true]
  calc
    _ = ∏ p ∈ P, ((1 / (p : ℝ)) * lam) / (1 + (lam - 1) / (p : ℝ)) := by
      simp only [prod_div_distrib, prod_mul_distrib, prod_const, primeTiltWeight, hpat,
        primeTiltNormalizer]
    _ = _ := by
      apply prod_congr rfl
      intro p hp
      have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast (hP p hp).ne_zero
      unfold primeTiltSelectionProbability
      field_simp
      ring

/-- Inclusion of a fixed prime subset has exactly the product of its tilted
Bernoulli inclusion probabilities. -/
theorem prime_tilt_superset_mass {P S : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hS : S ⊆ P) {lam : ℝ} (hlam : 0 < lam) :
    (∑ T ∈ P.powerset.filter (fun T ↦ S ⊆ T), primeTiltWeight P lam T) =
      ∏ p ∈ S, primeTiltSelectionProbability lam p := by
  classical
  have h := prime_tilt_event_restrict hP hS hlam (fun U ↦ U = S)
  have hfilter : P.powerset.filter (fun T ↦ S ⊆ T) =
      P.powerset.filter (fun T ↦ T ∩ S = S) := by
    ext T
    simp only [mem_filter, inter_eq_right]
  rw [hfilter, h]
  simp only [filter_eq', mem_powerset_self, if_true, sum_singleton]
  exact primeTiltWeight_all_selected (fun p hp ↦ hP p (hS hp)) lam

theorem finite_filtered_weighted_union_bound {α ι : Type*}
    (S : Finset α) (I : Finset ι) (w : α → ℝ) (hw : ∀ x ∈ S, 0 ≤ w x)
    (E : ι → α → Prop) [DecidableRel E] :
    (∑ x ∈ S.filter (fun x ↦ ∃ i ∈ I, E i x), w x) ≤
      ∑ i ∈ I, ∑ x ∈ S.filter (E i), w x := by
  classical
  simpa only [sum_filter, mul_ite, mul_one, mul_zero] using
    finite_weighted_union_bound_general S I w hw E

def PrimeExtensionCertificate (P : Finset ℕ) (Bad : Finset ℕ → ℕ → Prop)
    (T : Finset ℕ) : Prop :=
  ∃ S ∈ P.powerset, ∃ p ∈ P, p ∉ S ∧ Bad S p ∧ insert p S ⊆ T

theorem prime_extension_certificate_mass_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (Bad : Finset ℕ → ℕ → Prop) [DecidableRel Bad] :
    (∑ T ∈ P.powerset.filter (PrimeExtensionCertificate P Bad), primeTiltWeight P lam T) ≤
      ∑ S ∈ P.powerset, (∏ q ∈ S, primeTiltSelectionProbability lam q) *
        ∑ p ∈ P.filter (fun p ↦ p ∉ S ∧ Bad S p), primeTiltSelectionProbability lam p := by
  classical
  have heq : P.powerset.filter (PrimeExtensionCertificate P Bad) =
      P.powerset.filter (fun T ↦ ∃ S ∈ P.powerset,
        ∃ p ∈ P.filter (fun p ↦ p ∉ S ∧ Bad S p), insert p S ⊆ T) := by
    ext T
    simp only [mem_filter, PrimeExtensionCertificate]
    aesop
  rw [heq]
  apply (finite_filtered_weighted_union_bound P.powerset P.powerset (primeTiltWeight P lam)
    (fun T _ ↦ (primeTiltWeight_pos hP hlam T).le)
    (fun S T ↦ ∃ p ∈ P.filter (fun p ↦ p ∉ S ∧ Bad S p), insert p S ⊆ T)).trans
  apply sum_le_sum
  intro S hS
  apply (finite_filtered_weighted_union_bound P.powerset (P.filter (fun p ↦ p ∉ S ∧ Bad S p))
    (primeTiltWeight P lam) (fun T _ ↦ (primeTiltWeight_pos hP hlam T).le)
    (fun p T ↦ insert p S ⊆ T)).trans
  apply le_of_eq
  rw [mul_sum]
  apply sum_congr rfl
  intro p hp
  obtain ⟨hpP, hpS, _⟩ := mem_filter.mp hp
  rw [prime_tilt_superset_mass hP (insert_subset hpP (mem_powerset.mp hS)) hlam, prod_insert hpS]
  ring

theorem prime_tilt_inclusion_product_sum_le_exp {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) :
    (∑ S ∈ P.powerset, ∏ p ∈ S, primeTiltSelectionProbability lam p) ≤
      exp (∑ p ∈ P, primeTiltSelectionProbability lam p) := by
  rw [← prod_one_add, exp_sum]
  apply prod_le_prod
  · intro p hp
    linarith [(primeTiltSelectionProbability_pos_lt_one (hP p hp) hlam).1]
  · intro p _
    linarith [add_one_le_exp (primeTiltSelectionProbability lam p)]

/-- Summing all possible proper histories costs one exponential inclusion
moment. This theorem uses the exact prime-subset law, without conditioning. -/
theorem prime_extension_certificate_mass_le_exp {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (Bad : Finset ℕ → ℕ → Prop) [DecidableRel Bad] {eps : ℝ} (heps : 0 ≤ eps)
    (hfailure : ∀ S ∈ P.powerset,
      (∑ p ∈ P.filter (fun p ↦ p ∉ S ∧ Bad S p), primeTiltSelectionProbability lam p) ≤ eps) :
    (∑ T ∈ P.powerset.filter (PrimeExtensionCertificate P Bad), primeTiltWeight P lam T) ≤
      exp (∑ p ∈ P, primeTiltSelectionProbability lam p) * eps := by
  apply (prime_extension_certificate_mass_le hP hlam Bad).trans
  calc
    _ ≤ ∑ S ∈ P.powerset, (∏ q ∈ S, primeTiltSelectionProbability lam q) * eps := by
      apply sum_le_sum
      intro S hS
      exact mul_le_mul_of_nonneg_left (hfailure S hS) (prod_nonneg (fun q hq ↦
        (primeTiltSelectionProbability_pos_lt_one (hP q (mem_powerset.mp hS hq)) hlam).1.le))
    _ = (∑ S ∈ P.powerset, ∏ q ∈ S, primeTiltSelectionProbability lam q) * eps := (sum_mul _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right (prime_tilt_inclusion_product_sum_le_exp hP hlam) heps

end Erdos859Verification

end

/- Inlined development module: CoreProperExtensionBound.lean -/

section

/- Uniform arithmetic failure bounds at the actual Bernoulli prime probabilities. -/

open Finset Real

namespace Erdos859Verification

theorem primeTiltSelectionProbability_le_two_div {p : ℕ} (hp : p.Prime)
    {lam : ℝ} (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) :
    primeTiltSelectionProbability lam p ≤ 2 / (p : ℝ) := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hlam0 : 0 ≤ lam := by linarith
  unfold primeTiltSelectionProbability
  exact (div_le_div_of_nonneg_left hlam0 hp0 (by linarith)).trans
    (div_le_div_of_nonneg_right hlam2 hp0.le)

theorem primeTiltSelectionProbability_atom_le {p : ℕ} (hp : p.Prime)
    {lam v : ℝ} (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hlog : v ≤ log (p : ℝ)) :
    primeTiltSelectionProbability lam p ≤ 2 * exp (-v) := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hpv : exp v ≤ p := (le_log_iff_exp_le hp0).mp hlog
  have hrec : 1 / (p : ℝ) ≤ exp (-v) := by
    rw [exp_neg, ← one_div]
    exact one_div_le_one_div_of_le (exp_pos _) hpv
  exact (primeTiltSelectionProbability_le_two_div hp hlam hlam2).trans (by
    simpa only [mul_one_div] using mul_le_mul_of_nonneg_left hrec (by norm_num : (0 : ℝ) ≤ 2))

theorem primeTiltSelectionProbability_le_intensity {p : ℕ} (hp : p.Prime)
    {lam : ℝ} (hlam : 0 < lam) :
    primeTiltSelectionProbability lam p ≤ primeLogOddsIntensity lam p := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hden : 0 < (p : ℝ) - 1 := by linarith
  have hden' : 0 < (p : ℝ) + lam - 1 := by linarith
  have hid : primeTiltSelectionProbability lam p = 1 - (1 + lam / ((p : ℝ) - 1))⁻¹ := by
    unfold primeTiltSelectionProbability
    field_simp
    ring
  rw [hid]
  exact one_sub_inv_le_log_of_pos (by positivity)

theorem log_divisorCube_difference_bound {S : Finset ℕ}
    (hS : ∀ p ∈ S, p.Prime) {H k : ℕ} (hH : 0 < H) (hcard : S.card ≤ k)
    {V : ℝ} (hV : 0 ≤ V) (hlog : ∀ p ∈ S, log (p : ℝ) ≤ V) :
    log ((2 * H * ∏ p ∈ S, (1 + p) : ℕ) : ℝ) ≤ log ((2 * H : ℕ) : ℝ) + 2 * k * V := by
  have hH0 : (0 : ℝ) < (2 * H : ℕ) := by exact_mod_cast (Nat.mul_pos (by norm_num : 0 < 2) hH)
  have hp0 : (0 : ℝ) < (∏ p ∈ S, (1 + p) : ℕ) := by positivity
  rw [Nat.cast_mul, log_mul hH0.ne' hp0.ne', Nat.cast_prod, log_prod (fun p _ ↦ by positivity)]
  apply add_le_add le_rfl
  calc
    _ ≤ ∑ _p ∈ S, 2 * V := by
      apply sum_le_sum
      intro p hp
      have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (hS p hp).two_le
      have hplog : log (((1 + p : ℕ) : ℝ)) ≤ 2 * log (p : ℝ) := by
        have h := log_le_log (by positivity : (0 : ℝ) < ((1 + p : ℕ) : ℝ))
          (show ((1 + p : ℕ) : ℝ) ≤ (p : ℝ) ^ 2 by push_cast; nlinarith)
        simpa only [log_pow, Nat.cast_ofNat] using h
      exact hplog.trans (mul_le_mul_of_nonneg_left (hlog p hp) (by norm_num))
    _ ≤ _ := by
      simp only [sum_const, nsmul_eq_mul]
      have hc : (S.card : ℝ) ≤ k := by exact_mod_cast hcard
      nlinarith [mul_le_mul_of_nonneg_right hc hV]

def RankedImproperExtension (A B : ℝ) (k H : ℕ) (S : Finset ℕ) (p : ℕ) : Prop :=
  S.card ≤ k ∧ IsProperSignedCube (divisorCubeWeight S) H ∧
    ¬ IsProperSignedCube (divisorCubeWeight (insert p S)) H ∧
    A + B * (2 : ℝ) ^ S.card ≤ log (p : ℝ)

theorem ranked_improper_extension_weight_le {P S : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hSP : S ⊆ P)
    {A B V lam : ℝ} {k H : ℕ} (hA : 0 < A) (hB : 0 < B) (hV : 0 ≤ V)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hH : 0 < H)
    (hcap : log ((4 * H + 1 : ℕ) : ℝ) ≤ B) (hlog : ∀ p ∈ P, log (p : ℝ) ≤ V) :
    (∑ p ∈ P.filter (fun p ↦ p ∉ S ∧ RankedImproperExtension A B k H S p),
      primeTiltSelectionProbability lam p) ≤
      (2 / A) * exp (-A) * (log ((2 * H : ℕ) : ℝ) + 2 * k * V) := by
  classical
  have hlam0 : 0 < lam := by linarith
  let L : ℝ := log ((2 * H : ℕ) : ℝ) + 2 * k * V
  have hL : 0 ≤ L := by
    exact add_nonneg (log_nonneg (by exact_mod_cast (show 1 ≤ 2 * H by omega))) (by positivity)
  by_cases hs : S.card ≤ k ∧ IsProperSignedCube (divisorCubeWeight S) H
  · let v : ℝ := A + B * (2 : ℝ) ^ S.card
    let D : Finset ℕ := positiveSignedCubeDifferences (divisorCubeWeight S) H
    let T : ℕ := 2 * H * ∏ p ∈ S, (1 + p)
    let W : ℝ := (2 : ℝ) ^ S.card * log ((4 * H + 1 : ℕ) : ℝ)
    have hv : 0 < v := by dsimp [v]; positivity
    have hvA : A ≤ v := by exact le_add_of_nonneg_right (by positivity)
    have hP' (p : ℕ) (hp : p ∈ P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ))) : p.Prime :=
      hP p (mem_filter.mp hp).1
    have hlog' (p : ℕ) (hp : p ∈ P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ))) : v ≤ log (p : ℝ) :=
      (mem_filter.mp hp).2
    have hraw := finite_prime_extension_failure_weight_le
      (P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ))) D (primeTiltSelectionProbability lam)
      (fun p ↦ p ∉ S ∧ ¬ IsProperSignedCube (divisorCubeWeight (insert p S)) H)
      hv (show 0 ≤ 2 * exp (-v) by positivity) hP' hlog'
      (fun p hp ↦ (primeTiltSelectionProbability_pos_lt_one (hP' p hp) hlam0).1.le)
      (fun p hp ↦ primeTiltSelectionProbability_atom_le (hP' p hp) hlam hlam2 (hlog' p hp))
      (fun _ hm ↦ positive_divisorCube_difference_bounds S H hm)
      (fun p hp hb ↦ notproper_divisorCube_insert_dvd_difference S hs.2 hb.1 (hP' p hp).ne_zero hb.2)
    have hcount : (D.card : ℝ) ≤ exp W := by
      calc
        _ ≤ (((4 * H + 1) ^ (2 ^ S.card) : ℕ) : ℝ) := by
          exact_mod_cast positive_divisorCube_differences_card_le S H
        _ = _ := by
          dsimp [W]
          rw [show (2 : ℝ) ^ S.card = ((2 ^ S.card : ℕ) : ℝ) by norm_cast,
            exp_nat_mul, exp_log (by positivity)]
          norm_cast
    have hsize0 : log (T : ℝ) ≤ L :=
      log_divisorCube_difference_bound (fun p hp ↦ hP p (hSP hp)) hH hs.1 hV (fun p hp ↦ hlog p (hSP hp))
    have hsize : log (T : ℝ) ≤ (L / A) * v := by
      apply hsize0.trans
      calc
        L = (L / A) * A := by field_simp
        _ ≤ _ := mul_le_mul_of_nonneg_left hvA (div_nonneg hL hA.le)
    have hgap : W - v ≤ -A := by
      dsimp [W, v]
      nlinarith [mul_le_mul_of_nonneg_right hcap (by positivity : 0 ≤ (2 : ℝ) ^ S.card)]
    have hbound := prime_extension_divisor_bound_le_exp D hv (by norm_num : (0 : ℝ) < 1)
      (by norm_num : (0 : ℝ) ≤ 2) hcount hsize hgap
    have hfilter : P.filter (fun p ↦ p ∉ S ∧ RankedImproperExtension A B k H S p) =
        (P.filter (fun p : ℕ ↦ v ≤ log (p : ℝ))).filter
          (fun p ↦ p ∉ S ∧ ¬ IsProperSignedCube (divisorCubeWeight (insert p S)) H) := by
      ext p
      simp only [mem_filter, RankedImproperExtension, hs.1, hs.2, true_and, v]
      aesop
    rw [hfilter]
    apply hraw.trans
    dsimp [L] at hbound
    convert hbound using 1 <;> first | rfl | ring
  · have hzero : (∑ p ∈ P.filter (fun p ↦ p ∉ S ∧ RankedImproperExtension A B k H S p),
        primeTiltSelectionProbability lam p) = 0 := by
      apply sum_eq_zero
      intro p hp
      exact False.elim (hs ⟨(mem_filter.mp hp).2.2.1, (mem_filter.mp hp).2.2.2.1⟩)
    rw [hzero]
    change 0 ≤ (2 / A) * exp (-A) * L
    positivity

/-- An explicit absolute error bound in the actual finite tilted-prime law. -/
theorem ranked_improper_certificate_mass_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime)
    {A B V lam : ℝ} {k H : ℕ} (hA : 0 < A) (hB : 0 < B) (hV : 0 ≤ V)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hH : 0 < H)
    (hcap : log ((4 * H + 1 : ℕ) : ℝ) ≤ B) (hlog : ∀ p ∈ P, log (p : ℝ) ≤ V) :
    (∑ T ∈ P.powerset.filter (PrimeExtensionCertificate P (RankedImproperExtension A B k H)),
