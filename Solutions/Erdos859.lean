    (w atom : ι → ℝ) {d : ℝ} (hd : 0 < d) (hnorm : ∑ i, w i = 1) :
    (∫ y, finiteIntervalSmoothing w atom d y) = 1 := by
  unfold finiteIntervalSmoothing
  rw [integral_finsetSum univ (fun i _ ↦
    (integrable_intervalSmoothingKernel d (atom i)).const_mul (w i))]
  simp_rw [integral_const_mul, integral_intervalSmoothingKernel hd, mul_one]
