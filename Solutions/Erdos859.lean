    (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (j : ℕ) :
    (lam * (1 - virtualPrimeRelativeError B)) * virtualCoreBin A B j ≤
      ∑ p ∈ virtualPrimeBand A B j, primeLogOddsIntensity lam p := by
