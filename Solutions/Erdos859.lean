  let C : ℝ := (2 : ℝ) ^ (D + 1) / (A * (2 : ℝ) ^ k)
  have hq0 : 0 < q := rpow_pos_of_pos (by norm_num) _
  have hq1 : q < 1 := rpow_lt_one_of_one_lt_of_neg (by norm_num) (neg_neg_of_pos heps)
  have hC : 0 ≤ C := by positivity
  have heach (r : ℕ) (hr : r < k) :
      (2 : ℝ) ^ (-s r) / (A * (2 : ℝ) ^ (k - 1 - r)) ≤ C * q ^ r := by
    have hpow : (2 : ℝ) ^ (-s r) ≤ (2 : ℝ) ^ (D - (1 + eps) * (r : ℝ)) :=
      rpow_le_rpow_of_exponent_le (by norm_num) (by linarith [hs r hr])
