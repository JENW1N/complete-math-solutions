section

/- Simultaneous fixed-count laws on finitely many prime bands. -/

namespace Erdos859Verification

open Finset Real

noncomputable def bandCardSelections {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) : Finset (ι → Finset ℕ) := by
  classical
  exact Fintype.piFinset (fun j ↦ (P j).powerset.filter (fun T ↦ T.card = n j))

abbrev BandTuple {ι : Type*} (P : ι → Finset ℕ) (n : ι → ℕ) :=
  ∀ j, Fin (n j) → P j

def bandTupleSigmaEquiv {ι : Type*} (P : ι → Finset ℕ) (n : ι → ℕ) :
    BandTuple P n ≃ ((ji : Sigma (fun j ↦ Fin (n j))) → P ji.1) where
  toFun x ji := x ji.1 ji.2
  invFun y j i := y ⟨j, i⟩
  left_inv _ := rfl
  right_inv y := by funext ⟨j, i⟩; rfl

def bandTupleSupport {ι : Type*} {P : ι → Finset ℕ} {n : ι → ℕ}
    (x : BandTuple P n) : ι → Finset ℕ := fun j ↦ tupleSupport (x j)

abbrev BandTupleDistinct {ι : Type*} {P : ι → Finset ℕ} {n : ι → ℕ}
    (x : BandTuple P n) : Prop := ∀ j, Function.Injective (x j)

noncomputable def distinctBandTuples {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) : Finset (BandTuple P n) := by
  classical
  exact univ.filter BandTupleDistinct

theorem mem_bandCardSelections {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} {T : ι → Finset ℕ} :
    T ∈ bandCardSelections P n ↔ ∀ j, T j ⊆ P j ∧ (T j).card = n j := by
  classical
  simp [bandCardSelections]

theorem bandCardSelections_eq_piFinset {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) :
    bandCardSelections P n =
      Fintype.piFinset (fun j ↦ (P j).powerset.filter (fun T ↦ T.card = n j)) := by
  ext T
  simp [bandCardSelections]

theorem card_bandTupleSupport_fiber {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} {T : ι → Finset ℕ}
    (hT : ∀ j, T j ⊆ P j ∧ (T j).card = n j) :
    ((distinctBandTuples P n).filter (fun x ↦ bandTupleSupport x = T)).card =
      ∏ j, (n j).factorial := by
  classical
  have heq : (distinctBandTuples P n).filter (fun x ↦ bandTupleSupport x = T) =
      univ.filter (fun x : BandTuple P n ↦
        ∀ j, Function.Injective (x j) ∧ tupleSupport (x j) = T j) := by
    ext x
    simp [distinctBandTuples, bandTupleSupport, funext_iff, forall_and]
  rw [heq]
  have hcard := Fintype.card_congr
    (Equiv.subtypePiEquivPi (p := fun j (x : Fin (n j) → P j) ↦
      Function.Injective x ∧ tupleSupport x = T j))
  simp only [Fintype.card_subtype, Fintype.card_pi] at hcard
  rw [hcard]
  apply prod_congr rfl
  intro j _
  exact card_tupleSupport_fiber (hT j).1 (hT j).2

theorem sum_distinct_bandTuple_support {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) (G : (ι → Finset ℕ) → ℝ) :
    (∑ x ∈ distinctBandTuples P n, G (bandTupleSupport x)) =
      (∏ j, ((n j).factorial : ℝ)) * ∑ T ∈ bandCardSelections P n, G T := by
  classical
  have hmap : ∀ x ∈ distinctBandTuples P n, bandTupleSupport x ∈ bandCardSelections P n := by
    intro x hx
    apply mem_bandCardSelections.mpr
    intro j
    exact ⟨tupleSupport_subset (x j), card_tupleSupport (x j) ((mem_filter.mp hx).2 j)⟩
  calc
    _ = ∑ T ∈ bandCardSelections P n,
        ∑ x ∈ (distinctBandTuples P n).filter (fun x ↦ bandTupleSupport x = T), G T :=
      (sum_fiberwise_of_maps_to' hmap G).symm
    _ = ∑ T ∈ bandCardSelections P n, (∏ j, ((n j).factorial : ℝ)) * G T := by
      apply sum_congr rfl
      intro T hT
      rw [sum_const, nsmul_eq_mul, card_bandTupleSupport_fiber (mem_bandCardSelections.mp hT),
        Nat.cast_prod]
    _ = _ := (mul_sum _ _ _).symm

theorem distinct_bandTuple_product_expectation {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (n : ι → ℕ) (w : ι → ℕ → ℝ) (F : (ι → Finset ℕ) → ℝ) :
    (∑ x ∈ distinctBandTuples P n, (∏ j, ∏ i, w j (x j i).val) * F (bandTupleSupport x)) /
        (∑ x ∈ distinctBandTuples P n, ∏ j, ∏ i, w j (x j i).val) =
      (∑ T ∈ bandCardSelections P n, (∏ j, ∏ p ∈ T j, w j p) * F T) /
        (∑ T ∈ bandCardSelections P n, ∏ j, ∏ p ∈ T j, w j p) := by
  classical
  have hw (x : BandTuple P n) (hx : x ∈ distinctBandTuples P n) :
      (∏ j, ∏ i, w j (x j i).val) = ∏ j, ∏ p ∈ bandTupleSupport x j, w j p := by
    apply prod_congr rfl
    intro j _
    exact (prod_tupleSupport (x j) ((mem_filter.mp hx).2 j) (w j)).symm
  have hsum (G : (ι → Finset ℕ) → ℝ) :
      (∑ x ∈ distinctBandTuples P n,
        (∏ j, ∏ i, w j (x j i).val) * G (bandTupleSupport x)) =
      (∏ j, ((n j).factorial : ℝ)) *
        ∑ T ∈ bandCardSelections P n, (∏ j, ∏ p ∈ T j, w j p) * G T := by
    calc
      _ = ∑ x ∈ distinctBandTuples P n,
          (∏ j, ∏ p ∈ bandTupleSupport x j, w j p) * G (bandTupleSupport x) := by
        apply sum_congr rfl
        intro x hx
        rw [hw x hx]
      _ = _ := sum_distinct_bandTuple_support P n (fun T ↦ (∏ j, ∏ p ∈ T j, w j p) * G T)
  have hden := hsum (fun _ ↦ 1)
  simp only [mul_one] at hden
  rw [hsum, hden]
  exact mul_div_mul_left _ _ (prod_ne_zero_iff.mpr fun j _ ↦
    by exact_mod_cast Nat.factorial_ne_zero (n j))

noncomputable def bandReciprocalTupleWeight {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} (M : ι → ℝ) (x : BandTuple P n) : ℝ :=
  ∏ j, reciprocalTupleWeight (M j) (x j)

noncomputable def bandTupleOddsRatio {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} (x : BandTuple P n) : ℝ :=
  ∏ j, primeTupleOddsRatio (x j)

theorem bandReciprocalTupleWeight_eq_sigma {ι : Type*} [Fintype ι] [DecidableEq ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} (M : ι → ℝ) (x : BandTuple P n) :
    bandReciprocalTupleWeight M x =
      finiteProductWeight (fun (ji : Sigma (fun j ↦ Fin (n j))) (p : P ji.1) ↦
        (1 / (p.val : ℝ)) / M ji.1)
        (bandTupleSigmaEquiv P n x) := by
  simp [bandReciprocalTupleWeight, reciprocalTupleWeight, finiteProductWeight,
    Fintype.prod_sigma, bandTupleSigmaEquiv]

theorem bandTuple_reweight_eq_odds {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ}
    (hP : ∀ j p, p ∈ P j → p.Prime) (M : ι → ℝ) (x : BandTuple P n) :
    bandReciprocalTupleWeight M x * bandTupleOddsRatio x =
      (∏ j, ∏ i, 1 / (((x j i).val : ℝ) - 1)) / (∏ j, M j ^ n j) := by
  unfold bandReciprocalTupleWeight bandTupleOddsRatio
  rw [← prod_mul_distrib]
  simp_rw [reciprocalTupleWeight_mul_oddsRatio (hP _)]
  rw [prod_div_distrib]

theorem bandTilt_fixedCounts_expectation_eq_reweighted_tuples {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} (hP : ∀ j p, p ∈ P j → p.Prime)
    {lam : ℝ} (hlam : 0 < lam) (M : ι → ℝ) (hM : ∀ j, M j ≠ 0)
    (n : ι → ℕ) (F : (ι → Finset ℕ) → ℝ) :
    (∑ T ∈ bandCardSelections P n, (∏ j, primeTiltWeight (P j) lam (T j)) * F T) /
        (∑ T ∈ bandCardSelections P n, ∏ j, primeTiltWeight (P j) lam (T j)) =
      (∑ x ∈ distinctBandTuples P n,
        bandReciprocalTupleWeight M x * bandTupleOddsRatio x * F (bandTupleSupport x)) /
        (∑ x ∈ distinctBandTuples P n, bandReciprocalTupleWeight M x * bandTupleOddsRatio x) := by
  classical
  let K : ℝ := ∏ j, primePatternWeight (P j) ∅ * lam ^ n j / primeTiltNormalizer (P j) lam
  have hK : 0 < K := prod_pos fun j _ ↦ div_pos
    (mul_pos (primePatternWeight_pos (hP j) ∅) (pow_pos hlam (n j)))
    (primeTiltNormalizer_pos (hP j) hlam)
  have hfactor (T : ι → Finset ℕ) (hT : T ∈ bandCardSelections P n) :
      (∏ j, primeTiltWeight (P j) lam (T j)) = K * ∏ j, primeOddsWeight (T j) := by
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro j _
    exact primeTiltWeight_fixedCard_factorization (hP j)
      ((mem_bandCardSelections.mp hT) j).1 ((mem_bandCardSelections.mp hT) j).2 lam
  have hsum (G : (ι → Finset ℕ) → ℝ) :
      (∑ T ∈ bandCardSelections P n, (∏ j, primeTiltWeight (P j) lam (T j)) * G T) =
        K * ∑ T ∈ bandCardSelections P n, (∏ j, primeOddsWeight (T j)) * G T := by
    rw [mul_sum]
    apply sum_congr rfl
    intro T hT
    rw [hfactor T hT, mul_assoc]
  have hden := hsum (fun _ ↦ 1)
  simp only [mul_one] at hden
  rw [hsum, hden, mul_div_mul_left _ _ hK.ne']
  change (∑ T ∈ bandCardSelections P n, (∏ j, ∏ p ∈ T j, 1 / ((p : ℝ) - 1)) * F T) /
      (∑ T ∈ bandCardSelections P n, ∏ j, ∏ p ∈ T j, 1 / ((p : ℝ) - 1)) = _
