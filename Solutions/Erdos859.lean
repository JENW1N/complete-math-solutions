section

/- Lower bounds for simultaneous increasing prime events. -/

open Finset

namespace Erdos859Verification

theorem powerset_positive_association_prod (P I : Finset ℕ)
    (w : Finset ℕ → ℝ) (F : ℕ → Finset ℕ → ℝ)
    (hw : ∀ T, 0 ≤ w T) (hF0 : ∀ i T, 0 ≤ F i T)
    (hF : ∀ i, Monotone (F i))
    (hmod : ∀ S T, w S * w T ≤ w (S ∩ T) * w (S ∪ T))
    (hnorm : ∑ T ∈ P.powerset, w T = 1) :
    (∏ i ∈ I, ∑ T ∈ P.powerset, w T * F i T) ≤
      ∑ T ∈ P.powerset, w T * ∏ i ∈ I, F i T := by
  induction I using Finset.induction_on with
  | empty => simp [hnorm]
  | @insert i I hi ih =>
    simp_rw [prod_insert hi]
    calc
      _ ≤ (∑ T ∈ P.powerset, w T * F i T) *
          (∑ T ∈ P.powerset, w T * ∏ j ∈ I, F j T) :=
        mul_le_mul_of_nonneg_left ih (sum_nonneg (fun T _ ↦ mul_nonneg (hw T) (hF0 i T)))
      _ ≤ _ := by
        apply powerset_positive_association P w (F i) (fun T ↦ ∏ j ∈ I, F j T)
          hw (hF0 i) (fun T ↦ prod_nonneg (fun j _ ↦ hF0 j T)) (hF i) _ hmod hnorm
        intro S T hST
        exact prod_le_prod (fun j _ ↦ hF0 j S) (fun j _ ↦ hF j hST)

/-- Hitting all the bands costs at most the product of the separate costs.
The bands need not be disjoint for this lower bound. -/
theorem prime_joint_band_hit_lower {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (I : Finset ℕ) (B : ℕ → Finset ℕ)
    (hB : ∀ i ∈ I, B i ⊆ P) :
    (∏ i ∈ I, primeBandHitWeight (B i)) ≤
      ∑ T ∈ P.powerset, primePatternWeight P T *
        (if ∀ i ∈ I, (T ∩ B i).Nonempty then (1 : ℝ) else 0) := by
  classical
  calc
    _ = ∏ i ∈ I, ∑ T ∈ P.powerset,
        primePatternWeight P T * primeBandHitIndicator (B i) T := by
      apply prod_congr rfl
      intro i hi
      exact (primeBandHitIndicator_expectation hP (hB i hi)).symm
    _ ≤ ∑ T ∈ P.powerset, primePatternWeight P T *
        ∏ i ∈ I, primeBandHitIndicator (B i) T :=
      powerset_positive_association_prod P I (primePatternWeight P)
        (fun i ↦ primeBandHitIndicator (B i)) (fun T ↦ (primePatternWeight_pos hP T).le)
        (fun i ↦ primeBandHitIndicator_nonneg (B i))
        (fun i ↦ primeBandHitIndicator_monotone (B i))
        (fun S T ↦ (primePatternWeight_modular P S T).le) (sum_primePatternWeight P)
    _ = _ := by simp only [primeBandHitIndicator, prod_boole]

theorem prime_joint_band_hit_lower_pow {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (I : Finset ℕ) (B : ℕ → Finset ℕ)
    (hB : ∀ i ∈ I, B i ⊆ P) {eta : ℝ} (heta : 0 ≤ eta)
    (hband : ∀ i ∈ I, eta ≤ primeBandHitWeight (B i)) :
    eta ^ I.card ≤
      ∑ T ∈ P.powerset, primePatternWeight P T *
        (if ∀ i ∈ I, (T ∩ B i).Nonempty then (1 : ℝ) else 0) := by
  calc
    _ = ∏ _i ∈ I, eta := (prod_const eta).symm
    _ ≤ ∏ i ∈ I, primeBandHitWeight (B i) := prod_le_prod (fun _ _ ↦ heta) hband
    _ ≤ _ := prime_joint_band_hit_lower hP I B hB

end Erdos859Verification

