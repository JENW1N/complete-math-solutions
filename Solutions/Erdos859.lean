theorem mass_bound_of_conditional_ratio {a b q : ℝ}
    (ha : 0 ≤ a) (hab : a ≤ b) (hcond : 0 < b → a / b ≤ q) :
    a ≤ q * b := by
  by_cases hb : b = 0
  · rw [hb, mul_zero]
    exact hab.trans_eq hb
  · have hbpos : 0 < b := lt_of_le_of_ne (ha.trans hab) (Ne.symm hb)
    exact (div_le_iff₀ hbpos).mp (hcond hbpos)

theorem sum_good_fiber_weights {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (f : α → β) (Good : β → Prop) [DecidablePred Good] (w : α → ℝ) :
    (∑ b ∈ (S.image f).filter Good, ∑ x ∈ S.filter (fun x ↦ f x = b), w x) =
      ∑ x ∈ S.filter (fun x ↦ Good (f x)), w x := by
  have h := sum_fiberwise_eq_sum_filter S ((S.image f).filter Good) f w
  have heq : S.filter (fun x ↦ f x ∈ (S.image f).filter Good) =
      S.filter (fun x ↦ Good (f x)) := by
    ext x
    by_cases hx : x ∈ S
    · simp only [mem_filter, hx, mem_image_of_mem f hx, true_and]
    · simp [hx]
  rwa [heq] at h

theorem sum_good_bad_fiber_weights {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (f : α → β) (Good : β → Prop) [DecidablePred Good]
    (Bad : α → Prop) [DecidablePred Bad] (w : α → ℝ) :
    (∑ b ∈ (S.image f).filter Good,
      ∑ x ∈ S.filter (fun x ↦ f x = b ∧ Bad x), w x) =
      ∑ x ∈ S.filter (fun x ↦ Good (f x) ∧ Bad x), w x := by
  have h := sum_fiberwise_eq_sum_filter (S.filter Bad) ((S.image f).filter Good) f w
  have hfiber (b : β) : (S.filter Bad).filter (fun x ↦ f x = b) =
      S.filter (fun x ↦ f x = b ∧ Bad x) := by
    ext x
    simp [and_left_comm, and_assoc, and_comm]
  have heq : (S.filter Bad).filter (fun x ↦ f x ∈ (S.image f).filter Good) =
      S.filter (fun x ↦ Good (f x) ∧ Bad x) := by
    ext x
    by_cases hx : x ∈ S
    · simp only [mem_filter, hx, mem_image_of_mem f hx, true_and, and_comm]
    · simp [hx]
  simp_rw [hfiber] at h
  rwa [heq] at h

theorem finite_good_bad_mass_le_good_mass {α β : Type*}
    [DecidableEq α] [DecidableEq β]
    (S : Finset α) (w : α → ℝ) (hw : ∀ x ∈ S, 0 ≤ w x)
    (f : α → β) (Good : β → Prop) [DecidablePred Good]
    (Bad : α → Prop) [DecidablePred Bad] {q : ℝ}
    (hcond : ∀ b ∈ S.image f, Good b →
      0 < ∑ x ∈ S.filter (fun x ↦ f x = b), w x →
      (∑ x ∈ S.filter (fun x ↦ f x = b ∧ Bad x), w x) /
        (∑ x ∈ S.filter (fun x ↦ f x = b), w x) ≤ q) :
    (∑ x ∈ S.filter (fun x ↦ Good (f x) ∧ Bad x), w x) ≤
      q * ∑ x ∈ S.filter (fun x ↦ Good (f x)), w x := by
  rw [← sum_good_bad_fiber_weights S f Good Bad w,
    ← sum_good_fiber_weights S f Good w, mul_sum]
  apply sum_le_sum
  intro b hb
  apply mass_bound_of_conditional_ratio
  · exact sum_nonneg (fun x hx ↦ hw x (mem_filter.mp hx).1)
  · apply sum_le_sum_of_subset_of_nonneg
    · intro x hx
      exact mem_filter.mpr ⟨(mem_filter.mp hx).1, (mem_filter.mp hx).2.1⟩
    · intro x hx _
      exact hw x (mem_filter.mp hx).1
  · exact hcond b (mem_filter.mp hb).1 (mem_filter.mp hb).2

