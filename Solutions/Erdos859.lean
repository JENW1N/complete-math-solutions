section

/- Explicit exponential and polynomial moments for insertion-bounded weights. -/

open Finset Real

namespace Erdos859Verification

theorem insertion_exp_chord {v : ℝ} (hv : 0 ≤ v) (hv1 : v ≤ 1) :
    exp v - 1 ≤ (exp 1 - 1) * v := by
  have h := convexOn_exp.2 (Set.mem_univ (0 : ℝ)) (Set.mem_univ (1 : ℝ))
    (sub_nonneg.mpr hv1) hv (show (1 - v) + v = 1 by ring)
  simp only [smul_eq_mul, mul_zero, zero_add, mul_one, exp_zero] at h
  linarith

theorem insertion_exp_factor_le {c w v : ℝ} (hc : 0 ≤ c) (hw : 0 ≤ w)
    (hv : 0 ≤ v) (hv1 : v ≤ 1) :
    (1 + c * w * exp v) / (1 + c * w) ≤ exp (c * (exp 1 - 1) * w * v) := by
  have ht := insertion_exp_chord hv hv1
  have he : 0 ≤ exp 1 - 1 := sub_nonneg.mpr (one_le_exp (by norm_num))
  have hd : 0 < 1 + c * w := by positivity
  calc
    _ ≤ 1 + c * (exp 1 - 1) * w * v := by
      apply (div_le_iff₀ hd).mpr
      have hmul := mul_le_mul_of_nonneg_left ht (mul_nonneg hc hw)
      have hquadratic : 0 ≤ c * (exp 1 - 1) * w * v * (c * w) := by positivity
      nlinarith only [hmul, hquadratic]
    _ ≤ _ := by simpa only [add_comm] using add_one_le_exp (c * (exp 1 - 1) * w * v)

theorem insertionWeightedSum_exp_identity {α : Type*} (P : Finset α)
    (w v : α → ℝ) (f : Finset α → ℝ) :
    insertionWeightedSum P w (fun S ↦ f S * exp (∑ p ∈ S, v p)) =
      insertionWeightedSum P (fun p ↦ w p * exp (v p)) f := by
  unfold insertionWeightedSum
  apply sum_congr rfl
  intro S _
  dsimp only
  rw [exp_sum, prod_mul_distrib]
  ring

/-- The total mass is retained on the right, so zero normalizers cause no exception. -/
theorem insertionWeightedSum_exp_moment {α : Type*} [DecidableEq α]
    (P : Finset α) (w v : α → ℝ) {c : ℝ} (hc : 0 ≤ c)
    (hw : ∀ p, 0 ≤ w p) (hv : ∀ p, 0 ≤ v p) (hv1 : ∀ p ∈ P, v p ≤ 1)
    (f : Finset α → ℝ) (hf : ∀ S, 0 ≤ f S)
    (hgrowth : ∀ S p, f (insert p S) ≤ c * f S) :
    insertionWeightedSum P w (fun S ↦ f S * exp (∑ p ∈ S, v p)) ≤
      insertionWeightedSum P w f * exp (c * (exp 1 - 1) * ∑ p ∈ P, w p * v p) := by
  rw [insertionWeightedSum_exp_identity]
  apply (insertionWeightedSum_product_domination P w (fun p ↦ exp (v p)) hc hw
    (fun p ↦ one_le_exp (hv p)) f hf hgrowth).trans
  apply mul_le_mul_of_nonneg_left _ (insertionWeightedSum_nonneg P hw hf)
  calc
    _ ≤ ∏ p ∈ P, exp (c * (exp 1 - 1) * w p * v p) := by
      apply prod_le_prod
      · intro p _
        exact div_nonneg (add_nonneg zero_le_one
          (mul_nonneg (mul_nonneg hc (hw p)) (exp_pos _).le))
          (add_nonneg zero_le_one (mul_nonneg hc (hw p)))
      · intro p hp
        exact insertion_exp_factor_le hc (hw p) (hv p) (hv1 p hp)
    _ = _ := by
      rw [← exp_sum]
      congr 1
      rw [mul_sum]
      apply sum_congr rfl
      intro p _
      ring

theorem insertionWeightedSum_power_moment {α : Type*} [DecidableEq α]
    (P : Finset α) (w v : α → ℝ) {c : ℝ} (hc : 0 ≤ c)
    (hw : ∀ p, 0 ≤ w p) (hv : ∀ p, 0 ≤ v p) (hv1 : ∀ p ∈ P, v p ≤ 1)
    (f : Finset α → ℝ) (hf : ∀ S, 0 ≤ f S)
    (hgrowth : ∀ S p, f (insert p S) ≤ c * f S) (r : ℕ) :
    insertionWeightedSum P w (fun S ↦ f S * (∑ p ∈ S, v p) ^ r) ≤
      (r.factorial : ℝ) * insertionWeightedSum P w f *
        exp (c * (exp 1 - 1) * ∑ p ∈ P, w p * v p) := by
  have hfac : (0 : ℝ) < r.factorial := by exact_mod_cast Nat.factorial_pos r
  calc
    _ ≤ insertionWeightedSum P w
        (fun S ↦ (r.factorial : ℝ) * (f S * exp (∑ p ∈ S, v p))) := by
      apply insertionWeightedSum_mono P hw
      intro S
      have h := (div_le_iff₀ hfac).mp
        (pow_div_factorial_le_exp (∑ p ∈ S, v p) (sum_nonneg fun p _ ↦ hv p) r)
      have hm := mul_le_mul_of_nonneg_left h (hf S)
      nlinarith only [hm]
    _ = (r.factorial : ℝ) * insertionWeightedSum P w
        (fun S ↦ f S * exp (∑ p ∈ S, v p)) := insertionWeightedSum_const_mul _ _ _ _
    _ ≤ _ := by
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
        (insertionWeightedSum_exp_moment P w v hc hw hv hv1 f hf hgrowth) hfac.le

end Erdos859Verification

