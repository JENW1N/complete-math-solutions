/- A successful finite seed event provides a large practical divisor. -/

open Finset Real

namespace Erdos859Verification

theorem practicalChainProduct_coprime_next {p : ℕ → ℕ} {N j : ℕ}
    (hprime : ∀ i < N, (p i).Prime)
    (hlo : ∀ i < N, 3 * ((3 : ℝ) / 2) ^ i ≤ log (p i))
    (hhi : ∀ i < N, log (p i) ≤ 4 * ((3 : ℝ) / 2) ^ i) (hj : j < N) :
    Nat.Coprime (practicalChainProduct p j) (p j) := by
  have h7 : 7 < p j := by
    have hpow : (1 : ℝ) ≤ ((3 : ℝ) / 2) ^ j := one_le_pow₀ (by norm_num)
    have hlog : log (7 : ℝ) < log (p j) := by
      have := hlo j hj
      linarith [log_seven_lt_three]
    exact Nat.cast_lt.mp ((log_lt_log_iff (by norm_num)
      (by exact_mod_cast (hprime j hj).pos)).mp hlog)
  apply Nat.Coprime.mul_left (coprime_210_of_prime_gt_seven (hprime j hj) h7)
  apply Nat.Coprime.prod_left
  intro i hi
  exact (Nat.coprime_primes (hprime i ((mem_range.mp hi).trans hj)) (hprime j hj)).mpr
    (prime_window_strictMono hprime hlo hhi (mem_range.mp hi) hj).ne

theorem practicalChainProduct_dvd {p : ℕ → ℕ} {N n : ℕ}
    (hprime : ∀ i < N, (p i).Prime)
    (hlo : ∀ i < N, 3 * ((3 : ℝ) / 2) ^ i ≤ log (p i))
    (hhi : ∀ i < N, log (p i) ≤ 4 * ((3 : ℝ) / 2) ^ i)
    (hseed : 210 ∣ n) (hpdiv : ∀ i < N, p i ∣ n) :
    ∀ j ≤ N, practicalChainProduct p j ∣ n := by
  intro j
  induction j with
  | zero => simpa [practicalChainProduct] using fun _ : 0 ≤ N ↦ hseed
  | succ j ih =>
    intro hj
    rw [practicalChainProduct_succ]
    exact (practicalChainProduct_coprime_next hprime hlo hhi (by omega)).mul_dvd_of_dvd_of_dvd
      (ih (by omega)) (hpdiv j (by omega))

def HasPracticalSeed (Z n : ℕ) : Prop :=
  ∃ b : ℕ, Nat.IsPractical b ∧ Z ≤ b ∧ b < Z ^ 2 ∧ b ∣ n

noncomputable def practicalSeedIndicator (Z : ℕ) (T : Finset ℕ) : ℝ :=
  {U : Finset ℕ | HasPracticalSeed Z (∏ p ∈ U, p)}.indicator (fun _ ↦ (1 : ℝ)) T

/-- Select one prime from each hit band and stop the practical chain as
soon as it crosses `Z`. Its entire product divides the sampled prime product. -/
theorem PracticalSeedPattern.hasPracticalSeed {N Z : ℕ} {T : Finset ℕ}
    (h : PracticalSeedPattern N T) (hZ : 210 < Z)
    (hlarge : log (Z : ℝ) ≤ 4 * ((3 : ℝ) / 2) ^ N) :
    HasPracticalSeed Z (∏ p ∈ T, p) := by
  classical
  have hex : ∀ j : ℕ, ∃ p : ℕ, N ≤ j ∨ (p ∈ T ∧ p ∈ practicalPrimeBand j) := by
    intro j
    by_cases hj : j < N
    · obtain ⟨p, hp⟩ := h.prime_windows j hj
      exact ⟨p, Or.inr (mem_inter.mp hp)⟩
    · exact ⟨2, Or.inl (Nat.le_of_not_gt hj)⟩
  choose p hp0 using hex
  have hp : ∀ j < N, p j ∈ T ∧ p j ∈ practicalPrimeBand j :=
    fun j hj ↦ (hp0 j).resolve_left (not_le_of_gt hj)
  have hprime : ∀ j < N, (p j).Prime :=
    fun j hj ↦ (mem_practicalPrimeBand.mp (hp j hj).2).1
  have hlo : ∀ j < N, 3 * ((3 : ℝ) / 2) ^ j ≤ log (p j) :=
    fun j hj ↦ (mem_practicalPrimeBand.mp (hp j hj).2).2.1.le
  have hhi : ∀ j < N, log (p j) ≤ 4 * ((3 : ℝ) / 2) ^ j :=
    fun j hj ↦ (mem_practicalPrimeBand.mp (hp j hj).2).2.2
  have hseed : 210 ∣ ∏ p ∈ T, p := by
    have hd := Finset.prod_dvd_prod_of_subset ({2, 3, 5, 7} : Finset ℕ) T (fun q ↦ q)
      h.seed_primes
    norm_num at hd
    exact hd
  have hpdiv : ∀ j < N, p j ∣ ∏ q ∈ T, q :=
    fun j hj ↦ Finset.dvd_prod_of_mem (fun q ↦ q) (hp j hj).1
  obtain ⟨j, hj, hpractical, hlow, hhigh, _⟩ :=
    exists_practicalSeed_from_windows hprime hlo hhi hZ hlarge
  exact ⟨practicalChainProduct p (j + 1), hpractical, hlow, hhigh,
    practicalChainProduct_dvd hprime hlo hhi hseed hpdiv (j + 1) (by omega)⟩

/-- A quantitative, unconditional finite probability lower bound for a
practical seed, with the geometric horizon specified explicitly. -/
theorem exists_practicalSeed_weight_lower :
    ∃ eta : ℝ, 0 < eta ∧ eta < 1 ∧ ∀ N Z : ℕ, 210 < Z →
      log (Z : ℝ) ≤ 4 * ((3 : ℝ) / 2) ^ N →
      eta ^ (N + 4) ≤
        ∑ T ∈ (practicalSeedPrimeUniverse N).powerset,
          primePatternWeight (practicalSeedPrimeUniverse N) T *
            practicalSeedIndicator Z T := by
  classical
  obtain ⟨eta, heta, heta1, hbound⟩ := exists_practicalSeedPattern_weight_lower
  refine ⟨eta, heta, heta1, fun N Z hZ hlarge ↦ (hbound N).trans ?_⟩
  apply sum_le_sum
  intro T _
  simp only [practicalSeedIndicator, Set.indicator_apply, Set.mem_ofPred_eq]
  by_cases hpat : PracticalSeedPattern N T
  · rw [if_pos hpat, if_pos (hpat.hasPracticalSeed hZ hlarge)]
  · simp only [if_neg hpat, mul_zero]
    have hw : 0 ≤ primePatternWeight (practicalSeedPrimeUniverse N) T :=
      (primePatternWeight_pos (practicalSeedPrimeUniverse_prime N) T).le
    split_ifs <;> simp_all

end Erdos859Verification

