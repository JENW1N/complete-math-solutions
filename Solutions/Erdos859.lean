section

/- Uniform logarithmic estimates for the finite prime-tilt normalizer. -/

open Finset Real

namespace Erdos859Verification

theorem abs_log_one_add_sub_le_sq {x : ℝ} (hx : 0 ≤ x) :
    |log (1 + x) - x| ≤ x ^ 2 := by
  have hpos : 0 < 1 + x := by linarith
  have hu := log_le_sub_one_of_pos hpos
  have hl := one_sub_inv_le_log_of_pos hpos
  have hidentity : 1 - (1 + x)⁻¹ - (x - x ^ 2) = x ^ 3 / (1 + x) := by
    field_simp
    ring
  have hr : 0 ≤ 1 - (1 + x)⁻¹ - (x - x ^ 2) := by
    rw [hidentity]
    positivity
  exact abs_le.mpr ⟨by linarith, by nlinarith [sq_nonneg x]⟩

noncomputable def reciprocalSquareBound : ℝ := ∑' n : ℕ, 1 / (n : ℝ) ^ 2

theorem reciprocalSquareBound_nonneg : 0 ≤ reciprocalSquareBound :=
  tsum_nonneg (fun n ↦ by positivity)

theorem sum_reciprocalSquare_le (P : Finset ℕ) :
    (∑ p ∈ P, 1 / (p : ℝ) ^ 2) ≤ reciprocalSquareBound :=
  (Real.summable_one_div_nat_pow.mpr (by norm_num : 1 < (2 : ℕ))).sum_le_tsum
    P (fun _ _ ↦ by positivity)

/-- The product normalizer has a logarithm equal to its linear prime sum,
up to a constant independent of the finite prime set. -/
theorem log_primeTiltNormalizer_error (P : Finset ℕ) {lam : ℝ} (hlam : 1 ≤ lam) :
    |log (primeTiltNormalizer P lam) - (lam - 1) * ∑ p ∈ P, 1 / (p : ℝ)| ≤
      (lam - 1) ^ 2 * reciprocalSquareBound := by
  have hu (p : ℕ) : 0 ≤ (lam - 1) / (p : ℝ) :=
    div_nonneg (sub_nonneg.mpr hlam) (Nat.cast_nonneg p)
  have hf (p : ℕ) (_hp : p ∈ P) : 1 + (lam - 1) / (p : ℝ) ≠ 0 := by
    have := hu p
    linarith
  unfold primeTiltNormalizer
  rw [Real.log_prod hf]
  simp only [mul_sum, mul_one_div]
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ P, |log (1 + (lam - 1) / (p : ℝ)) - (lam - 1) / p| :=
      abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ P, ((lam - 1) / (p : ℝ)) ^ 2 :=
      sum_le_sum (fun p _ ↦ abs_log_one_add_sub_le_sq (hu p))
    _ = (lam - 1) ^ 2 * ∑ p ∈ P, 1 / (p : ℝ) ^ 2 := by
      simp only [mul_sum, div_pow, mul_one_div]
    _ ≤ _ := mul_le_mul_of_nonneg_left (sum_reciprocalSquare_le P) (sq_nonneg _)

noncomputable def primeLogWindow (a b : ℝ) : Finset ℕ :=
  (Ioc ⌊exp a⌋₊ ⌊exp b⌋₊).filter Nat.Prime

theorem primeLogWindow_prime (a b : ℝ) : ∀ p ∈ primeLogWindow a b, p.Prime :=
  fun _ hp ↦ (mem_filter.mp hp).2

theorem log_primeWindowTilt_error {a b lam : ℝ}
    (ha : log 2 ≤ a) (hab : a ≤ b) (hlam : 1 ≤ lam) :
    |log (primeTiltNormalizer (primeLogWindow a b) lam) - (lam - 1) * log (b / a)| ≤
      (lam - 1) ^ 2 * reciprocalSquareBound +
        (lam - 1) * (2 * mertensErrorConstant / a) := by
  have hsplit : log (primeTiltNormalizer (primeLogWindow a b) lam) -
      (lam - 1) * log (b / a) =
      (log (primeTiltNormalizer (primeLogWindow a b) lam) -
        (lam - 1) * primeLogWindowMass a b) +
      (lam - 1) * (primeLogWindowMass a b - log (b / a)) := by ring
  rw [hsplit]
  calc
    _ ≤ |log (primeTiltNormalizer (primeLogWindow a b) lam) -
          (lam - 1) * primeLogWindowMass a b| +
        |(lam - 1) * (primeLogWindowMass a b - log (b / a))| := abs_add_le _ _
    _ ≤ _ := by
      rw [abs_mul, abs_of_nonneg (sub_nonneg.mpr hlam)]
      exact add_le_add (log_primeTiltNormalizer_error (primeLogWindow a b) hlam)
        (mul_le_mul_of_nonneg_left (primeLogWindowMass_estimate ha hab)
          (sub_nonneg.mpr hlam))

end Erdos859Verification

