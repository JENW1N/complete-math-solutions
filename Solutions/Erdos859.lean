theorem prime_tilt_expectation_restrict {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) {lam : ℝ} (hlam : 0 < lam)
    (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * F (T ∩ B)) =
      ∑ U ∈ B.powerset, primeTiltWeight B lam U * F U := by
  calc
    _ = ∑ T ∈ P.powerset,
        primeTiltWeight B lam (T ∩ B) * primeTiltWeight (P \ B) lam (T \ B) *
          F (T ∩ B) := by
      apply sum_congr rfl
      intro T _
      rw [primeTiltWeight_split_universe hB]
