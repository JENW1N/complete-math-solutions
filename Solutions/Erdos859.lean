  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hden : exp (1 + 2 * log (k : ℝ)) = exp 1 * (k : ℝ) ^ 2 := by
    rw [exp_add, show (2 : ℝ) * log (k : ℝ) = (2 : ℕ) * log (k : ℝ) by norm_num,
      exp_nat_mul, exp_log hkR]
