noncomputable def cappedPowerfulValues (P : Finset ℕ) (cap : ℕ → ℕ) : Finset ℕ :=
  univ.image (cappedStatePowerfulPart P cap)

theorem cappedPowerfulValues_powerful {P : Finset ℕ} (hP : ∀ p∈P,p.Prime)
    (cap : ℕ → ℕ) : ∀ B∈cappedPowerfulValues P cap, FordPowerful B := by
  intro B hB
  obtain ⟨e,_,rfl⟩ := mem_image.mp hB
  exact powerfulExponentPart_powerful hP _

theorem cappedStatePowerfulPart_primeFactors_subset {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (e : CappedPrimeState P cap) :
    (cappedStatePowerfulPart P cap e).primeFactors ⊆ P := by
  rw [cappedStatePowerfulPart, powerfulExponentPart_primeFactors hP]
  exact filter_subset _ _

theorem cappedStateSingletons_subset_complement {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (e : CappedPrimeState P cap) :
    cappedStateSingletons P cap e ⊆ P \ (cappedStatePowerfulPart P cap e).primeFactors := by
  rw [cappedStatePowerfulPart, powerfulExponentPart_primeFactors hP]
  exact singletonExponentSet_subset_complement _ _

theorem cappedState_reconstruct {P : Finset ℕ} (hP : ∀ p∈P,p.Prime)
    (cap : ℕ → ℕ) (e : CappedPrimeState P cap) {p : ℕ} (hp : p∈P) :
    cappedPrimeStateExtend P cap e p =
      powerfulCompletionExponent (cappedStatePowerfulPart P cap e).primeFactors
        (cappedStatePowerfulPart P cap e).factorization (cappedStateSingletons P cap e) p :=
  powerfulExponent_reconstruct hP _ hp

theorem cappedStateWeight_eq_powerful_completion {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (e : CappedPrimeState P cap) :
    cappedPrimeStateWeight P cap e = primeCappedPatternWeight P cap
      (powerfulCompletionExponent (cappedStatePowerfulPart P cap e).primeFactors
        (cappedStatePowerfulPart P cap e).factorization (cappedStateSingletons P cap e)) := by
  apply prod_congr rfl
  intro p hp
  rw [cappedState_reconstruct hP cap e hp]

/-- Unique factorization recovers all heavy exponents from `B`; the remaining
state is exactly its singleton set. Thus no state multiplicity is lost. -/
theorem cappedState_eq_of_powerful_singletons_eq {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) {e f : CappedPrimeState P cap}
    (hB : cappedStatePowerfulPart P cap e = cappedStatePowerfulPart P cap f)
    (hT : cappedStateSingletons P cap e = cappedStateSingletons P cap f) : e=f := by
  funext p
  apply Fin.ext
  have he := cappedState_reconstruct hP cap e p.property
  have hf := cappedState_reconstruct hP cap f p.property
  rw [hB,hT] at he
  have hv := he.trans hf.symm
  rw [cappedPrimeStateExtend_mem e p.property,cappedPrimeStateExtend_mem f p.property] at hv
  exact hv

theorem cappedState_powerful_divisor_split {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (e : CappedPrimeState P cap)
    {y : ℝ} (h : FordRealDivisorEvent y (cappedPrimeStateProduct P cap e)) :
    ∃ f∈(cappedStatePowerfulPart P cap e).divisors,
      FordRadicalDivisorEvent (y/(f:ℝ)) (cappedStateSingletons P cap e) :=
  prime_exponent_divisor_split hP _ h

theorem cappedPowerfulFiber_expectation_le {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p)
    {B : ℕ} (hB : B∈cappedPowerfulValues P cap) (F : Finset ℕ → ℝ)
    (hF : Monotone F) (hF0 : ∀ T,0≤F T) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦ cappedStatePowerfulPart P cap e = B),
      cappedPrimeStateWeight P cap e * F (cappedStateSingletons P cap e)) ≤
      (1/(B:ℝ)) * ∑ T∈P.powerset,primePatternWeight P T * F T := by
  obtain ⟨e₀,_,he₀⟩ := mem_image.mp hB
  have hHP : B.primeFactors ⊆ P := by
    rw [←he₀]
    exact cappedStatePowerfulPart_primeFactors_subset hP cap e₀
  let A := univ.filter (fun e : CappedPrimeState P cap ↦ cappedStatePowerfulPart P cap e = B)
  let Q := P \ B.primeFactors
  let G : Finset ℕ → ℝ := fun T ↦ primeCappedPatternWeight P cap
    (powerfulCompletionExponent B.primeFactors B.factorization T) * F T
  have hmap : ∀ e∈A, cappedStateSingletons P cap e ∈ Q.powerset := by
    intro e he
    apply mem_powerset.mpr
    have h := cappedStateSingletons_subset_complement hP cap e
    simpa only [(mem_filter.mp he).2] using h
  have hinj : Set.InjOn (cappedStateSingletons P cap) (A : Set (CappedPrimeState P cap)) := by
    intro e he f hf hT
    exact cappedState_eq_of_powerful_singletons_eq hP cap
      ((mem_filter.mp he).2.trans (mem_filter.mp hf).2.symm) hT
  have hG0 : ∀ T,0≤G T := by
    intro T
    exact mul_nonneg (prod_nonneg (fun p hp ↦ cappedPrimeValuationWeight_nonneg (hP p hp) _ _)) (hF0 T)
  change (∑ e∈A,cappedPrimeStateWeight P cap e * F (cappedStateSingletons P cap e)) ≤ _
  calc
    _ = ∑ e∈A,G (cappedStateSingletons P cap e) := by
      apply sum_congr rfl
      intro e he
      rw [cappedStateWeight_eq_powerful_completion hP cap e]
      simp only [(mem_filter.mp he).2, G]
    _ = ∑ T∈A.image (cappedStateSingletons P cap),G T := by rw [sum_image hinj]
    _ ≤ ∑ T∈Q.powerset,G T :=
      sum_le_sum_of_subset_of_nonneg (by
        intro T hT
        obtain ⟨e,he,rfl⟩ := mem_image.mp hT
        exact hmap e he) (fun T _ _ ↦ hG0 T)
    _ ≤ (1/(powerfulPartNumber B.primeFactors B.factorization : ℝ)) *
        ∑ T∈P.powerset,primePatternWeight P T * F T :=
      primeCapped_powerful_expectation_le hP hHP cap B.factorization hcap F hF hF0
    _ = _ := by
      have hB0 : B≠0 := (cappedPowerfulValues_powerful hP cap B hB).1
      rw [powerfulPartNumber, ← Nat.prod_primeFactors_pow_factorization hB0]

theorem cappedPowerfulFiber_mass_le {P : Finset ℕ}
    (hP : ∀ p∈P,p.Prime) (cap : ℕ → ℕ) (hcap : ∀ p∈P,2≤cap p)
    {B : ℕ} (hB : B∈cappedPowerfulValues P cap) :
    (∑ e∈univ.filter (fun e : CappedPrimeState P cap ↦ cappedStatePowerfulPart P cap e = B),
      cappedPrimeStateWeight P cap e) ≤ 1/(B:ℝ) := by
  simpa only [mul_one, sum_primePatternWeight] using
    cappedPowerfulFiber_expectation_le hP cap hcap hB (fun _ ↦ 1)
      (fun _ _ _ ↦ le_rfl) (fun _ ↦ zero_le_one)


end Erdos859Verification

