/-- The support threshold can be traded against any failure budget `1 / L`.
This form permits a later comparison of the iid mark law with the exact
conditional prime law. -/
theorem dyadicPrimeMark_bad_support_weight_le {ι : Type*}
    [Fintype ι] [DecidableEq ι] {k : ℕ} (band : ι → Fin k)
    {A b d eps D L : ℝ} (ha : log 2 ≤ A)
    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d)
    (heps : 0 < eps) (hL : 0 < L)
    (hbarrier : ∀ j : Fin k,
      (1 + eps) * ((k - 1 - j.val : ℕ) : ℝ) - D ≤
        ((univ.filter (fun i ↦ j < band i)).card : ℝ))
    (htotal : (k : ℝ) - D ≤ Fintype.card ι) :
    (∑ x : ∀ i, DyadicPrimeMark A (band i).val with
      volume.real (finiteIntervalSupport
        (finiteSubsetSumAtom
          (fun i (p : DyadicPrimeMark A (band i).val) ↦ log (p : ℕ)) x) d) <
        (A * (2 : ℝ) ^ k) / (L * dyadicPrimeEnergyConstant b eps D),
      finiteProductWeight (fun i ↦ dyadicPrimeMarkWeight A (band i).val) x) ≤ 1 / L := by
  classical
  let mark := fun i (p : DyadicPrimeMark A (band i).val) ↦ log (p : ℕ)
  let w := fun i ↦ dyadicPrimeMarkWeight A (band i).val
  let X : ℝ := A * (2 : ℝ) ^ k
  let C : ℝ := dyadicPrimeEnergyConstant b eps D
  have hX : 0 < X := by
    dsimp [X]
    positivity [(log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha]
  have hC : 0 < C := dyadicPrimeEnergyConstant_pos hb heps
  have hW : ∀ x : ∀ i, DyadicPrimeMark A (band i).val, 0 ≤ finiteProductWeight w x :=
    finiteProductWeight_nonneg
      (fun i ↦ (dyadicPrimeMarkWeight_normalized ha hlarge (band i).val).1)
  have henergy : (∑ x : ∀ i, DyadicPrimeMark A (band i).val,
      finiteProductWeight w x * finiteSubsetSumEnergy mark x d) ≤ C / X :=
    dyadicPrimeMark_expected_energy_bound band ha hlarge hb hd hscale heps hbarrier htotal
  have hbad := finite_support_bad_weight_le univ (finiteProductWeight w)
    (fun x ↦ finiteSubsetSumEnergy mark x d)
    (fun x ↦ volume.real (finiteIntervalSupport (finiteSubsetSumAtom mark x) d))
    hL (div_pos hC hX) (fun x _ ↦ hW x)
    (fun x _ ↦ finiteSubsetSumEnergy_nonneg mark x d)
    (fun _ _ ↦ measureReal_nonneg)
    (fun x _ ↦ finiteSubsetSum_support_energy mark x (zero_lt_one.trans_le hd)) henergy
  have hthreshold : 1 / (L * (C / X)) = X / (L * C) := by field_simp
  rw [hthreshold] at hbad
  exact hbad

/-- Independent prime marks indexed by the selected count in each band. -/
abbrev DyadicCountPrimeMarks (A : ℝ) (k : ℕ) (T : Finset ℕ) : Type :=
  ∀ i : DyadicCountCoordinate A k T, DyadicPrimeMark A (dyadicCountCoordinateBand i).val

/-- The reverse barrier for an actual selected prime set gives the iid
expected-energy bound for its count-vector coordinate type. -/
theorem dyadicCountPrimeMark_expected_energy_bound {A b d v : ℝ} {k D : ℕ}
    {T : Finset ℕ} (ha : log 2 ≤ A)
    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d) (hv : 1 < v)
    (hgood : ¬ ReverseCountBarrierFailure k v D (dyadicPrimeTail A k) T) :
    (∑ x : DyadicCountPrimeMarks A k T,
      finiteProductWeight (fun i : DyadicCountCoordinate A k T ↦
        dyadicPrimeMarkWeight A (dyadicCountCoordinateBand i).val) x *
        finiteSubsetSumEnergy
          (fun i (p : DyadicPrimeMark A (dyadicCountCoordinateBand i).val) ↦ log (p : ℕ)) x d) ≤
      dyadicPrimeEnergyConstant b (v - 1) (D : ℝ) / (A * (2 : ℝ) ^ k) := by
  have hA : 0 < A := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha
  obtain ⟨heps, hbarrier, htotal⟩ := dyadicCountCoordinate_barrier_conditions hA hv hgood
  exact dyadicPrimeMark_expected_energy_bound
    (dyadicCountCoordinateBand (A := A) (k := k) (T := T))
    ha hlarge hb hd hscale heps hbarrier htotal

/-- Arbitrarily small iid bad-support weight, for the count vector of an
actual prime selection satisfying the reverse barrier. -/
theorem dyadicCountPrimeMark_bad_support_weight_le {A b d v L : ℝ} {k D : ℕ}
    {T : Finset ℕ} (ha : log 2 ≤ A)
    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d) (hv : 1 < v) (hL : 0 < L)
    (hgood : ¬ ReverseCountBarrierFailure k v D (dyadicPrimeTail A k) T) :
    (∑ x : DyadicCountPrimeMarks A k T with
      volume.real (finiteIntervalSupport
        (finiteSubsetSumAtom
          (fun i (p : DyadicPrimeMark A (dyadicCountCoordinateBand i).val) ↦ log (p : ℕ)) x) d) <
        (A * (2 : ℝ) ^ k) / (L * dyadicPrimeEnergyConstant b (v - 1) (D : ℝ)),
      finiteProductWeight (fun i : DyadicCountCoordinate A k T ↦
        dyadicPrimeMarkWeight A (dyadicCountCoordinateBand i).val) x) ≤ 1 / L := by
  have hA : 0 < A := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le ha
  obtain ⟨heps, hbarrier, htotal⟩ := dyadicCountCoordinate_barrier_conditions hA hv hgood
  exact dyadicPrimeMark_bad_support_weight_le
    (dyadicCountCoordinateBand (A := A) (k := k) (T := T))
    ha hlarge hb hd hscale heps hL hbarrier htotal

