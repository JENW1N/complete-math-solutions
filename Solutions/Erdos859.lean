section

/- Exact finite laws of capped prime valuations, derived from divisibility densities. -/

namespace Erdos859Verification

open Finset Filter Real
open scoped Topology Classical

theorem primePowerProduct_dvd_iff {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    (e : ℕ → ℕ) (n : ℕ) :
    (∏ p ∈ P, p ^ e p) ∣ n ↔ ∀ p ∈ P, p ^ e p ∣ n := by
  induction P using Finset.induction_on with
  | empty => simp
  | @insert p P hp ih =>
    have hpprime := hP p (mem_insert_self p P)
    have hP' : ∀ q ∈ P, q.Prime := fun q hq ↦ hP q (mem_insert_of_mem hq)
    have hcop : Nat.Coprime (p ^ e p) (∏ q ∈ P, q ^ e q) := by
      apply Nat.Coprime.prod_right
      intro q hq
      apply Nat.Coprime.pow
      exact (Nat.coprime_primes hpprime (hP' q hq)).mpr (fun he ↦ hp (he ▸ hq))
    rw [prod_insert hp]
    constructor
    · intro hd q hq
      rcases mem_insert.mp hq with rfl | hq
      · exact dvd_trans (dvd_mul_right _ _) hd
      · exact (ih hP').mp (dvd_trans (dvd_mul_left _ _) hd) q hq
    · intro hd
      exact hcop.mul_dvd_of_dvd_of_dvd (hd p (mem_insert_self p P))
        ((ih hP').mpr (fun q hq ↦ hd q (mem_insert_of_mem hq)))

theorem primePowerProduct_indicator {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    (e : ℕ → ℕ) (n : ℕ) :
    (∏ p ∈ P, if p ^ e p ∣ n then (1:ℝ) else 0) =
      if (∏ p ∈ P, p ^ e p) ∣ n then 1 else 0 := by
  by_cases hall : ∀ p ∈ P, p ^ e p ∣ n
  · rw [if_pos ((primePowerProduct_dvd_iff hP e n).mpr hall)]
    exact prod_eq_one (fun p hp ↦ if_pos (hall p hp))
  · rw [if_neg (mt (primePowerProduct_dvd_iff hP e n).mp hall)]
    push Not at hall
    obtain ⟨p, hp, hpn⟩ := hall
    exact prod_eq_zero hp (if_neg hpn)

theorem prod_powerset_choice {P S : Finset ℕ} (hS : S ⊆ P) (f g : ℕ → ℝ) :
    (∏ p ∈ P, if p ∈ S then f p else g p) =
      (∏ p ∈ S, f p) * ∏ p ∈ P \ S, g p := by
  rw [prod_ite]
  have hyes : P.filter (fun p ↦ p ∈ S) = S := by
    ext p
    simp only [mem_filter]
    exact and_iff_right_of_imp (fun hp ↦ hS hp)
  have hno : P.filter (fun p ↦ p ∉ S) = P \ S := by ext p; simp
  rw [hyes, hno]

/-- Each coordinate may test either of two prime powers. This exact moment
identity supplies capped-valuation independence without assuming it. -/
theorem tendsto_mean_prime_power_choices {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (e f : ℕ → ℕ) (a b : ℕ → ℝ) :
    Tendsto (fun N : ℕ ↦
      (∑ n ∈ range N, ∏ p ∈ P,
        (a p * (if p ^ e p ∣ n then (1:ℝ) else 0) +
          b p * (if p ^ f p ∣ n then (1:ℝ) else 0))) / N)
      atTop (𝓝 (∏ p ∈ P, (a p / (p:ℝ) ^ e p + b p / (p:ℝ) ^ f p))) := by
  let k : Finset ℕ → ℕ → ℕ := fun S p ↦ if p ∈ S then e p else f p
  let c : Finset ℕ → ℝ := fun S ↦ ∏ p ∈ P, if p ∈ S then a p else b p
  have hexpand (n : ℕ) :
      (∏ p ∈ P, (a p * (if p ^ e p ∣ n then (1:ℝ) else 0) +
        b p * (if p ^ f p ∣ n then (1:ℝ) else 0))) =
      ∑ S ∈ P.powerset, c S * (if (∏ p ∈ P, p ^ k S p) ∣ n then 1 else 0) := by
    rw [prod_add]
    apply sum_congr rfl
    intro S hS
    rw [← primePowerProduct_indicator hP (k S) n]
    dsimp only [c]
    rw [← prod_mul_distrib, ← prod_powerset_choice (mem_powerset.mp hS)]
    apply prod_congr rfl
    intro p _
    dsimp [k]
    split_ifs <;> rfl
  have heach : ∀ S ∈ P.powerset,
      Tendsto (fun N : ℕ ↦ c S *
        ((∑ n ∈ range N, if (∏ p ∈ P, p ^ k S p) ∣ n then (1:ℝ) else 0) / N))
        atTop (𝓝 (c S * (1 / ((∏ p ∈ P, p ^ k S p : ℕ):ℝ)))) := by
    intro S _
    exact (tendsto_mean_dvd_indicator
      (prod_pos (fun p hp ↦ pow_pos (hP p hp).pos _))).const_mul (c S)
  have hsum := tendsto_finsetSum P.powerset heach
  convert hsum using 1
  · funext N
    simp only [hexpand, sum_div, mul_div_assoc, mul_sum]
    rw [sum_comm]
  · apply congrArg nhds
    rw [prod_add]
    apply sum_congr rfl
    intro S hS
    rw [← prod_powerset_choice (mem_powerset.mp hS)]
    dsimp [c]
    simp only [Nat.cast_prod, Nat.cast_pow, mul_one_div, ← prod_div_distrib]
    apply prod_congr rfl
    intro p _
    dsimp [k]
    split_ifs <;> rfl

def PrimeCappedValuationPatternSet (P : Finset ℕ) (cap e : ℕ → ℕ) : Set ℕ :=
  {n | ∀ p ∈ P, p ^ e p ∣ n ∧ (e p < cap p → ¬ p ^ (e p + 1) ∣ n)}

noncomputable def cappedPrimeValuationWeight (p cap e : ℕ) : ℝ :=
  if e = cap then 1 / (p:ℝ)^e else (1-1/(p:ℝ)) / (p:ℝ)^e

noncomputable def primeCappedPatternWeight (P : Finset ℕ) (cap e : ℕ → ℕ) : ℝ :=
  ∏ p ∈ P, cappedPrimeValuationWeight p (cap p) (e p)

theorem cappedPrimeValuationWeight_eq {p c e : ℕ} (hp : p.Prime) (he : e ≤ c) :
    cappedPrimeValuationWeight p c e =
      1/(p:ℝ)^e + (if e<c then -1 else 0) / (p:ℝ)^(e+1) := by
  have hp0 : (p:ℝ) ≠ 0 := by exact_mod_cast hp.ne_zero
  by_cases hlt : e<c
  · rw [cappedPrimeValuationWeight, if_neg (Nat.ne_of_lt hlt), if_pos hlt, pow_succ]
    field_simp
    ring
  · have heq : e=c := le_antisymm he (Nat.le_of_not_gt hlt)
    simp [cappedPrimeValuationWeight, heq]

/-- Exact joint density, including the terminal atom `p^(-cap)` that
contains every valuation at or above the cap. -/
theorem primeCappedValuationPattern_hasDensity {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (cap e : ℕ → ℕ) (he : ∀ p ∈ P, e p ≤ cap p) :
    (PrimeCappedValuationPatternSet P cap e).HasDensity (primeCappedPatternWeight P cap e) := by
  have hm := tendsto_mean_prime_power_choices hP e (fun p ↦ e p+1)
    (fun _ ↦ 1) (fun p ↦ if e p < cap p then -1 else 0)
  have hweight :
      (∏ p ∈ P, (1/(p:ℝ)^e p + (if e p<cap p then -1 else 0)/(p:ℝ)^(e p+1))) =
        primeCappedPatternWeight P cap e :=
    prod_congr rfl (fun p hp ↦ (cappedPrimeValuationWeight_eq (hP p hp) (he p hp)).symm)
  rw [hweight] at hm
  apply hasDensity_of_indicator_mean hm
  apply Filter.Eventually.of_forall
  intro n
  simp only [Set.indicator_apply, PrimeCappedValuationPatternSet, Set.mem_ofPred_eq]
  rw [← Finset.prod_boole]
  apply prod_congr rfl
  intro p _
  have hnext : p^(e p+1) ∣ n → p^e p ∣ n :=
    fun h ↦ dvd_trans (pow_dvd_pow p (Nat.le_succ (e p))) h
  by_cases hb : p^e p ∣ n <;> by_cases hn : p^(e p+1) ∣ n <;>
    by_cases hc : e p < cap p <;> simp_all

def cappedPrimeValuation (p cap n : ℕ) : ℕ :=
  Nat.findGreatest (fun e ↦ p^e ∣ n) cap

theorem cappedPrimeValuation_le (p cap n : ℕ) : cappedPrimeValuation p cap n ≤ cap :=
  Nat.findGreatest_le cap

theorem cappedPrimeValuation_eq_iff (p cap n e : ℕ) (he : e ≤ cap) :
    cappedPrimeValuation p cap n = e ↔
      p^e ∣ n ∧ (e<cap → ¬p^(e+1) ∣ n) := by
  unfold cappedPrimeValuation
  constructor
  · intro h
    have hd : p ^ Nat.findGreatest (fun k ↦ p^k ∣ n) cap ∣ n :=
      Nat.findGreatest_spec (P := fun k ↦ p^k ∣ n) (m := 0) (Nat.zero_le cap) (by simp)
    rw [h] at hd
    refine ⟨hd, ?_⟩
    intro hlt
    exact (Nat.findGreatest_eq_iff.mp h).2.2 (Nat.lt_succ_self e) (Nat.succ_le_iff.mpr hlt)
  · rintro ⟨hd, hnext⟩
    apply Nat.findGreatest_eq_iff.mpr
    refine ⟨he, fun _ ↦ hd, ?_⟩
    intro k hek hk hkn
    exact hnext (hek.trans_le hk) (dvd_trans (pow_dvd_pow p (Nat.succ_le_iff.mpr hek)) hkn)

theorem primeCappedValuationPattern_mem_iff (P : Finset ℕ) (cap e : ℕ → ℕ)
