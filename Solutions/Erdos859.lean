  have hplus : (p:ℝ)+1≠0 := by positivity
  by_cases hb : b
  · simp only [if_pos hb, cappedPrimeValuationWeight, if_neg (show (1:ℕ)≠cap by omega), pow_one]
    field_simp
    ring
  · simp only [if_neg hb, cappedPrimeValuationWeight, if_neg (show (0:ℕ)≠cap by omega),
