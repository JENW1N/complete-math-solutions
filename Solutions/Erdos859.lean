theorem nonnegative_contraction_success_probability {mu : Measure ℝ} [IsProbabilityMeasure mu]
    {H : ℝ → ℝ} (hH : Measurable H) (hH0 : ∀ x, 0 ≤ H x)
    (hHi : Integrable H mu) {d b : ℝ} (_hd : 0 ≤ d) (hd1 : d ≤ 1) (hb : 0 ≤ b)
    (hmean : (∫ x, H x ∂mu) ≤ (1 - d) * b) :
    d / 2 ≤ mu.real {x | H x ≤ (1 - d / 2) * b} := by
  let R := (1 - d / 2) * b
  have hgood : MeasurableSet {x | H x ≤ R} := measurableSet_le hH measurable_const
  by_cases hb0 : b = 0
  · have hi0 : (∫ x, H x ∂mu) = 0 := by
      apply le_antisymm _ (integral_nonneg hH0)
      simpa only [hb0, mul_zero] using hmean
    have hae := (integral_eq_zero_iff_of_nonneg hH0 hHi).mp hi0
    have he : {x | H x ≤ R} ∈ ae mu := by
      filter_upwards [hae] with x hx
      simp only [hx, Pi.zero_apply, R, hb0, mul_zero, le_refl]
    have hp := (mem_ae_iff_prob_eq_one hgood).mp he
    change d / 2 ≤ mu.real {x | H x ≤ R}
    rw [Measure.real, hp, ENNReal.toReal_one]
    linarith
  · have hbpos : 0 < b := lt_of_le_of_ne hb (Ne.symm hb0)
    have hRpos : 0 < R := mul_pos (by linarith) hbpos
    have hm := mul_meas_ge_le_integral_of_nonneg (Filter.Eventually.of_forall hH0) hHi R
    have hscalar : (1 - d) * b ≤ R * (1 - d / 2) := by
      dsimp [R]
      nlinarith [mul_nonneg (sq_nonneg d) hb]
    have htail : mu.real {x | R ≤ H x} ≤ 1 - d / 2 := by
      have ht := (hm.trans hmean).trans hscalar
      nlinarith
    have hcomp : mu.real {x | H x ≤ R}ᶜ ≤ mu.real {x | R ≤ H x} := by
      apply measureReal_mono _ (measure_ne_top _ _)
      intro x hx
      change ¬ H x ≤ R at hx
      exact (lt_of_not_ge hx).le
    have hsum := probReal_add_probReal_compl (μ := mu) hgood
    change d / 2 ≤ mu.real {x | H x ≤ R}
    linarith

theorem logUniformPairDensity_two_length_lower {u L t : ℝ}
    (hL : 0 < L) (hu : 2 * L ≤ u) (ht : t ∈ Set.Icc (-L) L) :
    (1 / 16 : ℝ) / L ≤ logUniformPairDensity u (2 * L) t := by
  have hf := (logUniformPairDensity_properties (by positivity : (0 : ℝ) < 2 * L) hu).2.2.2.2.2 t
  have ht' : |t| ≤ L := abs_le.mpr ht
  apply le_trans _ hf
  rw [max_eq_left (by linarith : 0 ≤ 2 * L - |t|)]
  have hden : 0 < 4 * (2 * L) ^ 2 := by positivity
  apply (div_le_div_iff₀ hL hden).mpr
  nlinarith [mul_le_mul_of_nonneg_left ht' hL.le]

theorem initialCoverage_success_probability {E B : Set ℝ}
    (hE : MeasurableSet E) (hB : MeasurableSet B) {L c rho : ℝ}
    (hEI : E ⊆ Set.Icc 0 L) (hBI : B ⊆ Set.Icc 0 L)
    (hL : 0 < L) (hc : 0 ≤ c) (hrho : 0 ≤ rho) (hprod : c * rho ≤ 1)
    (hBvol : rho * L ≤ volume.real B) {f : ℝ → ℝ} (hf : Measurable f)
    (hf0 : ∀ g, 0 ≤ f g) (hflower : ∀ g ∈ Set.Icc (-L) L, c / L ≤ f g)
    (hmass : (∫⁻ g : ℝ, ENNReal.ofReal (f g)) = 1) :
    c * rho / 2 ≤ (translationShiftLaw f).real
      {g | volume.real (E \ realTranslateSet B g) ≤ (1 - c * rho / 2) * volume.real E} := by
  let : IsProbabilityMeasure (translationShiftLaw f) := translationShiftLaw_isProbability f hmass
  have hEfin : volume E ≠ ∞ := measure_ne_top_of_subset hEI isCompact_Icc.measure_ne_top
  have hm : Measurable (fun g ↦ volume.real (E \ realTranslateSet B g)) := by
    have heq : (fun g ↦ volume.real (E \ realTranslateSet B g)) =
        fun g ↦ volume.real E - crossTranslationOverlap E B g :=
      funext (missing_after_translate_eq hE hB hEfin)
    rw [heq]
    exact measurable_const.sub (measurable_crossTranslationOverlap hE hB)
  have hmain := initialCoverage_expectation_contraction hE hB hEI hBI hf hf0 hflower hmass
  have hlow : c * rho ≤ c * volume.real B / L := by
    apply (le_div_iff₀ hL).mpr
    nlinarith [mul_le_mul_of_nonneg_left hBvol hc]
  apply nonnegative_contraction_success_probability hm (fun _ ↦ measureReal_nonneg)
    hmain.1 (mul_nonneg hc hrho) hprod measureReal_nonneg
  exact hmain.2.trans (mul_le_mul_of_nonneg_right (sub_le_sub_left hlow 1) measureReal_nonneg)

theorem base_coverage_fraction_le_one {B : Set ℝ} {rho L : ℝ}
    (hL : 0 < L) (hBI : B ⊆ Set.Icc 0 L) (hBvol : rho * L ≤ volume.real B) : rho ≤ 1 := by
  have hb := measureReal_mono (μ := volume) hBI isCompact_Icc.measure_ne_top
  rw [volume_real_Icc_of_le hL.le, sub_zero] at hb
  nlinarith

noncomputable def baseTranslateHole (A B I : Set ℝ) (g : ℝ) : ℝ :=
  volume.real (I \ (A ∪ realTranslateSet B g))

theorem baseTranslateHole_eq (A B I : Set ℝ) (g : ℝ) :
    baseTranslateHole A B I g = volume.real ((I \ A) \ realTranslateSet B g) := by
  unfold baseTranslateHole
  apply congrArg volume.real
  ext x
  simp only [Set.mem_sdiff, Set.mem_union, not_or]
  tauto

theorem measurable_baseTranslateHole {A B I : Set ℝ}
    (hA : MeasurableSet A) (hB : MeasurableSet B) (hI : MeasurableSet I)
    (hIfin : volume I ≠ ∞) : Measurable (baseTranslateHole A B I) := by
  have heq : baseTranslateHole A B I = fun g ↦
      volume.real (I \ A) - crossTranslationOverlap (I \ A) B g := by
    funext g
    rw [baseTranslateHole_eq, missing_after_translate_eq (hI.diff hA) hB
      (measure_ne_top_of_subset Set.sdiff_subset hIfin)]
  rw [heq]
  exact measurable_const.sub (measurable_crossTranslationOverlap (hI.diff hA) hB)

theorem logUniformPair_initial_success_probability {A B : Set ℝ}
    (hA : MeasurableSet A) (hB : MeasurableSet B) {L rho u : ℝ}
    (hL : 0 < L) (hrho : 0 ≤ rho) (hBI : B ⊆ Set.Icc 0 L)
    (hBvol : rho * L ≤ volume.real B) (hu : 2 * L ≤ u) :
    rho / 32 ≤ (translationShiftLaw (logUniformPairDensity u (2 * L))).real
      {g | baseTranslateHole A B (Set.Icc 0 L) g ≤
        (1 - rho / 32) * volume.real (Set.Icc 0 L \ A)} := by
  have hrho1 := base_coverage_fraction_le_one hL hBI hBvol
  have hf := logUniformPairDensity_properties (by positivity : (0 : ℝ) < 2 * L) hu
  have h := initialCoverage_success_probability (measurableSet_Icc.diff hA) hB
    Set.sdiff_subset hBI hL (c := 1 / 16) (by norm_num) hrho (by linarith)
    hBvol hf.1 hf.2.1 (fun g hg ↦ logUniformPairDensity_two_length_lower hL hu hg) hf.2.2.1
  simpa only [baseTranslateHole_eq, show (1 / 16 : ℝ) * rho / 2 = rho / 32 by ring] using h

theorem baseTranslateHole_thickened_shift_le {A B I : Set ℝ} {x y e : ℝ}
    (hxy : |y - x| ≤ e) (hIfin : volume I ≠ ∞) :
    baseTranslateHole A (realSupportThickening B e) I y ≤ baseTranslateHole A B I x := by
  apply measureReal_mono _ (measure_ne_top_of_subset Set.sdiff_subset hIfin)
  apply Set.sdiff_subset_sdiff_right
  apply Set.union_subset_union_right
  intro z hz
  refine ⟨z - x, hz, ?_⟩
  have hid : z - y - (z - x) = x - y := by ring
  rw [hid, abs_sub_comm]
  exact hxy

def PrimePairInitialEvent (A B : Set ℝ) (L rho e : ℝ) (T : Finset ℕ) : Prop :=
  ∃ p ∈ T, ∃ q ∈ T,
    baseTranslateHole A (realSupportThickening B e) (Set.Icc 0 L)
      (log (p : ℝ) - log (q : ℝ)) ≤ (1 - rho / 32) * volume.real (Set.Icc 0 L \ A)

theorem primeTilt_initial_coverage_step {A B : Set ℝ} (hA : IsCompact A) (hB : IsCompact B)
    {L rho lam u eps eta : ℝ} (hL : 0 < L) (hrho : 0 ≤ rho)
    (hBI : B ⊆ Set.Icc 0 L) (hBvol : rho * L ≤ volume.real B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (hu : log 2 ≤ u) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * primeLogOddsErrorConstant ≤ eps * u) (hwidth : eps * u = 2 * L)
    (heta : 0 ≤ eta) (hmargin : eta ≤ rho / 32 - 64 * exp (-u) / eps) :
    primePairStepCost eps eta ≤
      ∑ T ∈ (primeLogWindow u ((1 + eps) * u)).powerset.filter (fun T ↦ T.card = 2 ∧
        PrimePairInitialEvent A B L rho (32 * primeLogOddsErrorConstant) T),
        primeTiltWeight (primeLogWindow u ((1 + eps) * u)) lam T := by
  classical
  let R := (1 - rho / 32) * volume.real (Set.Icc 0 L \ A)
  let E : Set ℝ := {x | baseTranslateHole A B (Set.Icc 0 L) x ≤ R}
  let G : Set ℝ := {y | baseTranslateHole A (realSupportThickening B (32 * primeLogOddsErrorConstant))
    (Set.Icc 0 L) y ≤ R}
  have hE : MeasurableSet E := measurableSet_le
    (measurable_baseTranslateHole hA.measurableSet hB.measurableSet measurableSet_Icc
      isCompact_Icc.measure_ne_top) measurable_const
  have hG : MeasurableSet G := measurableSet_le
    (measurable_baseTranslateHole hA.measurableSet (measurableSet_realSupportThickening hB _)
      measurableSet_Icc isCompact_Icc.measure_ne_top) measurable_const
  have hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G := by
    intro x hx y hxy
    exact (baseTranslateHole_thickened_shift_le hxy isCompact_Icc.measure_ne_top).trans hx
  have hu0 : 0 < u := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hu
  have hwu : 2 * L ≤ u := hwidth.symm ▸ mul_le_of_le_one_left hu0.le heps1
  have hprob : rho / 32 ≤
      (translationShiftLaw (logUniformPairDensity u (eps * u)) E).toReal := by
    rw [hwidth]
    exact logUniformPair_initial_success_probability hA.measurableSet hB.measurableSet
      hL hrho hBI hBvol hwu
  have h := primeTilt_broad_robust_pair_lower hlam hlam2 hu heps heps1 hlarge
    hE hG hrobust hprob heta hmargin
  exact h

inductive PrimePairInitialPath (L rho e : ℝ) (B : Set ℝ) :
    (n : ℕ) → (Fin n → Finset ℕ) → Set ℝ → Prop where
  | initial (x : Fin 0 → Finset ℕ) : PrimePairInitialPath L rho e B 0 x B
  | step {n : ℕ} {x : Fin n → Finset ℕ} {A : Set ℝ}
      (hpath : PrimePairInitialPath L rho e B n x A)
      {T : Finset ℕ} (hcard : T.card = 2) {p q : ℕ} (hp : p ∈ T) (hq : q ∈ T)
      (hholes : baseTranslateHole A (realSupportThickening B e) (Set.Icc 0 L)
        (log (p : ℝ) - log (q : ℝ)) ≤ (1 - rho / 32) * volume.real (Set.Icc 0 L \ A)) :
      PrimePairInitialPath L rho e B (n + 1) (Fin.snoc x T)
        (A ∪ realTranslateSet (realSupportThickening B e) (log (p : ℝ) - log (q : ℝ)))

theorem PrimePairInitialPath.isCompact {L rho e : ℝ} {A B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialPath L rho e B n x A)
    (hB : IsCompact B) : IsCompact A := by
  induction h with
  | initial => exact hB
  | step _ _ _ _ _ ih =>
    exact ih.union (isCompact_realTranslateSet (isCompact_realSupportThickening hB _) _)

theorem PrimePairInitialPath.base_subset {L rho e : ℝ} {A B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialPath L rho e B n x A) : B ⊆ A := by
  induction h with
  | initial => exact Set.Subset.rfl
  | step _ _ _ _ _ ih => exact ih.trans Set.subset_union_left

theorem PrimePairInitialPath.counts {L rho e : ℝ} {A B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialPath L rho e B n x A) :
    ∀ i, (x i).card = 2 := by
  induction h with
  | initial => exact fun i ↦ Fin.elim0 i
  | step _ hc _ _ _ ih =>
    apply Fin.lastCases
    · simpa only [Fin.snoc_last] using hc
    · intro i
      simpa only [Fin.snoc_castSucc] using ih i

theorem PrimePairInitialPath.hole_bound {L rho e : ℝ} {A B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialPath L rho e B n x A)
    (hL : 0 ≤ L) (hrho : rho ≤ 32) :
    volume.real (Set.Icc 0 L \ A) ≤ (1 - rho / 32) ^ n * L := by
  induction h with
  | initial =>
    have hh := measureReal_mono (μ := volume)
      (Set.sdiff_subset (s := Set.Icc 0 L) (t := B)) isCompact_Icc.measure_ne_top
    simpa only [volume_real_Icc_of_le hL, sub_zero, pow_zero, one_mul] using hh
  | @step n x A hp T hc p q hpm hqm hh ih =>
    have hb := hh.trans (mul_le_mul_of_nonneg_left ih (by linarith : 0 ≤ 1 - rho / 32))
    simpa only [baseTranslateHole, pow_succ, mul_left_comm, mul_assoc] using hb

theorem PrimePairInitialPath.geometry {L rho e : ℝ} {A B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialPath L rho e B n x A) (he : 0 ≤ e) :
    ∃ g : Fin n → ℝ,
      (∀ i, ∃ p ∈ x i, ∃ q ∈ x i, g i = log (p : ℝ) - log (q : ℝ)) ∧
      A ⊆ finiteThickenedTranslateSupport B univ g e := by
  induction h with
  | initial x =>
    let g : Fin 0 → ℝ := fun i ↦ Fin.elim0 i
    refine ⟨g, fun i ↦ Fin.elim0 i, ?_⟩
    have hz := finiteBitTranslateSupport_zero (realSupportThickening B e) g
    rw [finiteBitTranslateSupport_eq_subsetSupport] at hz
    change B ⊆ finiteSubsetTranslateSupport (realSupportThickening B e) univ g
    rw [hz]
    intro z hzB
    exact ⟨z, hzB, by simpa only [sub_self, abs_zero] using he⟩
  | @step n x A hpath T hc p q hp hq hh ih =>
    obtain ⟨g, hg, hA⟩ := ih
    refine ⟨Fin.snoc g (log (p : ℝ) - log (q : ℝ)), ?_, ?_⟩
    · apply Fin.lastCases
      · simpa only [Fin.snoc_last] using ⟨p, hp, q, hq, rfl⟩
      · intro i
        simpa only [Fin.snoc_castSucc] using hg i
    · rw [finiteThickenedTranslateSupport_snoc]
      apply Set.union_subset_union hA
      intro z hz
      apply mem_finiteSubsetTranslateSupport.mpr
      refine ⟨∅, empty_subset _, ?_⟩
      change z - (log (p : ℝ) - log (q : ℝ)) ∈ realSupportThickening B e at hz
      simpa only [sum_empty, sub_zero] using hz

def PrimePairInitialSuccess (L rho e : ℝ) (B : Set ℝ) (n : ℕ)
    (x : Fin n → Finset ℕ) : Prop := ∃ A, PrimePairInitialPath L rho e B n x A

def PrimePairInitialWindowConditions (L rho : ℝ) (u eps eta : ℕ → ℝ) (n : ℕ) : Prop :=
  ∀ i < n, log 2 ≤ u i ∧ 0 < eps i ∧ eps i ≤ 1 ∧
    8 * primeLogOddsErrorConstant ≤ eps i * u i ∧ 0 ≤ eta i ∧
    eta i ≤ rho / 32 - 64 * exp (-u i) / eps i ∧ eps i * u i = 2 * L

theorem primeTilt_independent_initial_coverage {B : Set ℝ} (hB : IsCompact B)
    {L rho lam : ℝ} (hL : 0 < L) (hrho : 0 ≤ rho)
    (hBI : B ⊆ Set.Icc 0 L) (hBvol : rho * L ≤ volume.real B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (u eps eta : ℕ → ℝ) (n : ℕ)
    (hwin : PrimePairInitialWindowConditions L rho u eps eta n) :
    (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
      ∑ x ∈ primeBandSelections (fun i : Fin n ↦ primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)),
        (∏ i, primeTiltWeight (primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)) lam (x i)) *
          (if PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B n x then 1 else 0) := by
  classical
  let P : ℕ → Finset ℕ := fun i ↦ primeLogWindow (u i) ((1 + eps i) * u i)
  change (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
    ∑ x ∈ Fintype.piFinset (fun i : Fin n ↦ (P i.val).powerset),
      (∏ i, primeTiltWeight (P i.val) lam (x i)) *
        (if PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B n x then 1 else 0)
  apply finite_adaptive_prefix_lower (fun i ↦ (P i).powerset)
    (fun i T ↦ primeTiltWeight (P i) lam T) (fun i ↦ primePairStepCost (eps i) (eta i))
    (PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B)
  · intro i T _
    exact (primeTiltWeight_pos (fun p hp ↦ (mem_primeLogWindow.mp hp).1)
      (by linarith : 0 < lam) T).le
  · intro x
    exact ⟨B, PrimePairInitialPath.initial x⟩
  · intro i hi
    have heta := (hwin i hi).2.2.2.2.1
    unfold primePairStepCost
    positivity
  · intro i hi x _ hx
    obtain ⟨A, hpath⟩ := hx
    obtain ⟨hui, hepsi, hepsi1, hlarge, hetai, hmargin, hwidth⟩ := hwin i hi
    let StepGood : Finset ℕ → Prop := fun T ↦ T.card = 2 ∧
      PrimePairInitialEvent A B L rho (32 * primeLogOddsErrorConstant) T
    have hlocal : primePairStepCost (eps i) (eta i) ≤
        ∑ T ∈ (P i).powerset.filter StepGood, primeTiltWeight (P i) lam T :=
      primeTilt_initial_coverage_step (hpath.isCompact hB) hB hL hrho hBI hBvol
        hlam hlam2 hui hepsi hepsi1 hlarge hwidth hetai hmargin
    have hext (T : Finset ℕ) (hT : StepGood T) :
        PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B (i + 1) (Fin.snoc x T) := by
      obtain ⟨hc, p, hp, q, hq, hh⟩ := hT
      exact ⟨_, PrimePairInitialPath.step hpath hc hp hq hh⟩
    apply hlocal.trans
    rw [sum_filter]
    apply sum_le_sum
    intro T _
    have hwT : 0 ≤ primeTiltWeight (P i) lam T :=
      (primeTiltWeight_pos (fun p hp ↦ (mem_primeLogWindow.mp hp).1)
        (by linarith : 0 < lam) T).le
    change (if StepGood T then primeTiltWeight (P i) lam T else 0) ≤
      primeTiltWeight (P i) lam T * (if PrimePairInitialSuccess L rho
        (32 * primeLogOddsErrorConstant) B (i + 1) (Fin.snoc x T) then 1 else 0)
    by_cases hT : StepGood T
    · simp only [if_pos hT, if_pos (hext T hT), mul_one, le_refl]
    · simp only [if_neg hT]
      exact mul_nonneg hwT (by split_ifs <;> norm_num)

theorem primeTilt_ambient_initial_coverage {B : Set ℝ} (hB : IsCompact B)
    {L rho lam : ℝ} (hL : 0 < L) (hrho : 0 ≤ rho)
    (hBI : B ⊆ Set.Icc 0 L) (hBvol : rho * L ≤ volume.real B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (u eps eta : ℕ → ℝ) (n : ℕ)
    (hwin : PrimePairInitialWindowConditions L rho u eps eta n)
    (hdis : Pairwise (fun i j : Fin n ↦
      Disjoint (primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))
        (primeLogWindow (u j.val) ((1 + eps j.val) * u j.val)))) :
    (∏ i ∈ range n, primePairStepCost (eps i) (eta i)) ≤
      ∑ T ∈ (primeBandUnion (fun i : Fin n ↦
        primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))).powerset,
        primeTiltWeight (primeBandUnion (fun i : Fin n ↦
          primeLogWindow (u i.val) ((1 + eps i.val) * u i.val))) lam T *
          (if PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B n
            (fun i ↦ T ∩ primeLogWindow (u i.val) ((1 + eps i.val) * u i.val)) then 1 else 0) := by
  classical
  rw [prime_tilt_expectation_primeBand_partition _ hdis lam
    (fun x ↦ if PrimePairInitialSuccess L rho (32 * primeLogOddsErrorConstant) B n x then 1 else 0)]
  exact primeTilt_independent_initial_coverage hB hL hrho hBI hBvol hlam hlam2 u eps eta n hwin

theorem exists_prime_initial_coverage_length {rho : ℝ} (hrho : 0 < rho) :
    ∃ n : ℕ, (1 - rho / 32) ^ n ≤ 1 / (2 : ℝ) ^ 10 := by
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (by positivity : (0 : ℝ) < 1 / (2 : ℝ) ^ 10)
    (by linarith : 1 - rho / 32 < 1)
  exact ⟨n, hn.le⟩

theorem PrimePairInitialSuccess.small_holes {L rho e : ℝ} {B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialSuccess L rho e B n x)
    (hB : IsCompact B) (hL : 0 ≤ L) (hrho : rho ≤ 32)
    (hn : (1 - rho / 32) ^ n ≤ 1 / (2 : ℝ) ^ 10) :
    ∃ A, IsCompact A ∧ B ⊆ A ∧ PrimePairInitialPath L rho e B n x A ∧
      volume.real (Set.Icc 0 L \ A) ≤ L / (2 : ℝ) ^ 10 := by
  obtain ⟨A, hp⟩ := h
  refine ⟨A, hp.isCompact hB, hp.base_subset, hp, (hp.hole_bound hL hrho).trans ?_⟩
  simpa only [div_eq_mul_inv, one_mul, mul_comm] using mul_le_mul_of_nonneg_right hn hL

theorem PrimePairInitialSuccess.mesh {L rho e : ℝ} {B : Set ℝ}
    {n : ℕ} {x : Fin n → Finset ℕ} (h : PrimePairInitialSuccess L rho e B n x)
    (hL : 0 ≤ L) (hrho : rho ≤ 32) (he : 0 ≤ e) :
    (∀ i, (x i).card = 2) ∧ ∃ g : Fin n → ℝ,
      (∀ i, ∃ p ∈ x i, ∃ q ∈ x i, g i = log (p : ℝ) - log (q : ℝ)) ∧
      volume.real (Set.Icc 0 L \ finiteThickenedTranslateSupport B univ g e) ≤
        (1 - rho / 32) ^ n * L := by
  obtain ⟨A, hp⟩ := h
  obtain ⟨g, hg, hA⟩ := hp.geometry he
  refine ⟨hp.counts, g, hg, ?_⟩
  apply le_trans _ (hp.hole_bound hL hrho)
  exact measureReal_mono (Set.sdiff_subset_sdiff_right hA)
    (measure_ne_top_of_subset Set.sdiff_subset isCompact_Icc.measure_ne_top)

end Erdos859Verification

end

/- Inlined development module: FordOrderedCrossing.lean -/

section

/- Measurable first-crossing cells for an ordered affine barrier. -/

open MeasureTheory Set
open scoped ENNReal

namespace Erdos859Verification

def fordOrderedInterval (k : ℕ) (a b : ℝ) : Set (Fin k → ℝ) :=
  Icc (fun _ ↦ a) (fun _ ↦ b) ∩ {x | Monotone x}

theorem fordOrderedInterval_measurable (k : ℕ) (a b : ℝ) :
    MeasurableSet (fordOrderedInterval k a b) :=
  measurableSet_Icc.inter isClosed_monotone.measurableSet

theorem fordOrderedInterval_translate (k : ℕ) (a b : ℝ) :
    fordOrderedInterval k a b =
      (fun x : Fin k → ℝ ↦ x - (fun _ ↦ a)) ⁻¹' fordOrderedSimplex k (b - a) := by
  ext x
  constructor
  · intro hx
    refine ⟨⟨fun i ↦ ?_, fun i ↦ ?_⟩, ?_⟩
    · exact sub_nonneg.mpr (hx.1.1 i)
    · exact sub_le_sub_right (hx.1.2 i) a
    · intro i j hij
      exact sub_le_sub_right (hx.2 hij) a
  · intro hx
    refine ⟨⟨fun i ↦ ?_, fun i ↦ ?_⟩, ?_⟩
    · exact sub_nonneg.mp (hx.1.1 i)
    · exact (sub_le_sub_iff_right a).mp (hx.1.2 i)
    · intro i j hij
      exact (sub_le_sub_iff_right a).mp (hx.2 hij)

theorem fordOrderedInterval_volume (k : ℕ) {a b : ℝ} (hab : a ≤ b) :
    volume (fordOrderedInterval k a b) =
      ENNReal.ofReal ((b - a) ^ k / (k.factorial : ℝ)) := by
  rw [fordOrderedInterval_translate]
  rw [(measurePreserving_sub_right (volume : Measure (Fin k → ℝ)) (fun _ ↦ a)).measure_preimage
    (fordOrderedSimplex_measurable k (b - a)).nullMeasurableSet]
  exact fordOrderedSimplex_volume k (sub_nonneg.mpr hab)

def fordBarrier (k : ℕ) (u v : ℝ) : Set (Fin k → ℝ) :=
  {x | ∀ i, (i.val : ℝ) + 1 - u ≤ v * x i}

def fordBarrierGood (k : ℕ) (T u v : ℝ) : Set (Fin k → ℝ) :=
  fordOrderedSimplex k T ∩ fordBarrier k u v

def fordFirstCrossing {k : ℕ} (T u v : ℝ) (l : Fin k) : Set (Fin k → ℝ) :=
  fordOrderedSimplex k T ∩ {x | v * x l < (l.val : ℝ) + 1 - u ∧
    ∀ i, i < l → (i.val : ℝ) + 1 - u ≤ v * x i}

theorem fordBarrier_measurable (k : ℕ) (u v : ℝ) :
    MeasurableSet (fordBarrier k u v) := by
  unfold fordBarrier
  simp only [ofPred_forall]
  exact MeasurableSet.iInter fun i ↦ measurableSet_le measurable_const
    (measurable_const.mul (measurable_pi_apply i))

theorem fordBarrierGood_measurable (k : ℕ) (T u v : ℝ) :
    MeasurableSet (fordBarrierGood k T u v) :=
  (fordOrderedSimplex_measurable k T).inter (fordBarrier_measurable k u v)

theorem fordFirstCrossing_measurable {k : ℕ} (T u v : ℝ) (l : Fin k) :
    MeasurableSet (fordFirstCrossing T u v l) := by
  have hprior : MeasurableSet {x : Fin k → ℝ | ∀ i, i < l →
      (i.val : ℝ) + 1 - u ≤ v * x i} := by
    simp only [ofPred_forall]
    exact MeasurableSet.iInter fun i ↦ MeasurableSet.iInter fun _ ↦
      measurableSet_le measurable_const (measurable_const.mul (measurable_pi_apply i))
  exact (fordOrderedSimplex_measurable k T).inter
    ((measurableSet_lt (measurable_const.mul (measurable_pi_apply l)) measurable_const).inter hprior)

theorem fordFirstCrossing_pairwise_disjoint (k : ℕ) (T u v : ℝ) :
    Pairwise (fun i j : Fin k ↦ Disjoint (fordFirstCrossing T u v i)
      (fordFirstCrossing T u v j)) := by
  intro i j hij
  apply disjoint_left.mpr
  intro x hxi hxj
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact (not_lt_of_ge (hxj.2.2 i hij)) hxi.2.1
  · exact (not_lt_of_ge (hxi.2.2 j hji)) hxj.2.1

theorem fordFirstCrossing_iUnion (k : ℕ) (T u v : ℝ) :
    (⋃ l : Fin k, fordFirstCrossing T u v l) =
      fordOrderedSimplex k T \ fordBarrier k u v := by
  classical
  ext x
  constructor
  · intro hx
    obtain ⟨l, hl⟩ := mem_iUnion.mp hx
    exact ⟨hl.1, fun hg ↦ (not_lt_of_ge (hg l)) hl.2.1⟩
  · rintro ⟨hx, hbad⟩
    change ¬ ∀ i : Fin k, (i.val : ℝ) + 1 - u ≤ v * x i at hbad
    push Not at hbad
    let S := Finset.univ.filter fun i : Fin k ↦ v * x i < (i.val : ℝ) + 1 - u
    have hS : S.Nonempty := by
      obtain ⟨i, hi⟩ := hbad
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩⟩
    let l := S.min' hS
    have hl : l ∈ S := Finset.min'_mem S hS
    refine mem_iUnion.mpr ⟨l, hx, (Finset.mem_filter.mp hl).2, ?_⟩
    intro i hil
    by_contra! hi
    have hiS : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩
    exact (not_le_of_gt hil) (Finset.min'_le S i hiS)

/-- The ordered bad region is an actual finite disjoint sum of measurable crossing cells. -/
theorem fordFirstCrossing_volume_sum (k : ℕ) (T u v : ℝ) :
    volume (fordOrderedSimplex k T \ fordBarrier k u v) =
      ∑ l : Fin k, volume (fordFirstCrossing T u v l) := by
  rw [← fordFirstCrossing_iUnion]
  rw [measure_iUnion (fordFirstCrossing_pairwise_disjoint k T u v)
    (fordFirstCrossing_measurable T u v), tsum_fintype]

theorem fordBarrier_volume_decomposition (k : ℕ) {T : ℝ} (hT : 0 ≤ T) (u v : ℝ) :
    volume (fordBarrierGood k T u v) +
      ∑ l : Fin k, volume (fordFirstCrossing T u v l) =
        ENNReal.ofReal (T ^ k / (k.factorial : ℝ)) := by
  rw [← fordFirstCrossing_volume_sum]
  rw [fordBarrierGood, measure_inter_add_sdiff _ (fordBarrier_measurable k u v)]
  exact fordOrderedSimplex_volume k hT

/-- Lebesgue measure splits exactly at any chosen coordinate. -/
theorem ford_volume_insertNth {n : ℕ} (l : Fin (n + 1)) {S : Set (Fin (n + 1) → ℝ)}
    (hS : MeasurableSet S) :
    volume S = ∫⁻ t : ℝ, volume {x : Fin n → ℝ | l.insertNth t x ∈ S} := by
  have hp : MeasurePreserving (fun z : ℝ × (Fin n → ℝ) ↦
      (l.insertNth z.1 z.2 : Fin (n + 1) → ℝ))
      volume volume :=
    (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) l).symm
  rw [← hp.measure_preimage hS.nullMeasurableSet, Measure.volume_eq_prod,
    Measure.prod_apply (hS.preimage hp.measurable)]
  rfl

theorem fordFirstCrossing_volume_slice {n : ℕ} (T u v : ℝ) (l : Fin (n + 1)) :
    volume (fordFirstCrossing T u v l) =
      ∫⁻ t : ℝ, volume {x : Fin n → ℝ | l.insertNth t x ∈ fordFirstCrossing T u v l} :=
  ford_volume_insertNth l (fordFirstCrossing_measurable T u v l)

theorem fordFirstCrossing_slice_empty {n : ℕ} (T u v t : ℝ) (l : Fin (n + 1))
    (ht : ¬ (0 ≤ t ∧ t ≤ T ∧ v * t < (l.val : ℝ) + 1 - u)) :
    {x : Fin n → ℝ | l.insertNth t x ∈ fordFirstCrossing T u v l} = ∅ := by
  apply eq_empty_iff_forall_notMem.mpr
  intro x hx
  apply ht
  have hzero := hx.1.1.1 l
  have hupper := hx.1.1.2 l
  have hfail := hx.2.1
  simpa only [Fin.insertNth_apply_same] using And.intro hzero (And.intro hupper hfail)

/-- Concatenation is a measure-preserving equivalence of the two coordinate blocks. -/
theorem ford_append_measurePreserving (l m : ℕ) :
    MeasurePreserving (fun z : (Fin l → ℝ) × (Fin m → ℝ) ↦ Fin.append z.1 z.2)
      volume volume := by
  let e := (MeasurableEquiv.sumPiEquivProdPi (fun _ : Fin l ⊕ Fin m ↦ ℝ)).symm
  let f := MeasurableEquiv.piCongrLeft (fun _ : Fin (l + m) ↦ ℝ) finSumFinEquiv
  have hp := (volume_measurePreserving_piCongrLeft (fun _ : Fin (l + m) ↦ ℝ)
    finSumFinEquiv).comp
      (volume_measurePreserving_sumPiEquivProdPi_symm (fun _ : Fin l ⊕ Fin m ↦ ℝ))
  have heq : (fun z : (Fin l → ℝ) × (Fin m → ℝ) ↦ Fin.append z.1 z.2) = f ∘ e := by
    funext z i
    refine Fin.addCases (fun j ↦ ?_) (fun j ↦ ?_) i
    · simp [f, e, MeasurableEquiv.coe_piCongrLeft,
        Equiv.piCongrLeft_apply, finSumFinEquiv]
      rfl
    · simp [f, e, MeasurableEquiv.coe_piCongrLeft,
        Equiv.piCongrLeft_apply, finSumFinEquiv]
      rfl
  rw [heq]
  exact hp

theorem ford_monotone_append_iff {l m : ℕ} (p : Fin l → ℝ) (q : Fin m → ℝ) :
    Monotone (Fin.append p q) ↔ Monotone p ∧ Monotone q ∧ ∀ i j, p i ≤ q j := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      simpa using h (show Fin.castAdd m i ≤ Fin.castAdd m j from hij)
    · intro i j hij
      have hh : Fin.natAdd l i ≤ Fin.natAdd l j := by
        change l + i.val ≤ l + j.val
        exact Nat.add_le_add_left hij l
      simpa using h hh
    · intro i j
      have hh : Fin.castAdd m i ≤ Fin.natAdd l j := by
        change i.val ≤ l + j.val
        omega
      simpa using h hh
  · rintro ⟨hp, hq, hpq⟩ i
    refine Fin.addCases (fun a ↦ ?_) (fun a ↦ ?_) i
    · intro j
      refine Fin.addCases (fun b h ↦ ?_) (fun b _ ↦ ?_) j
      · simpa using hp h
      · simpa using hpq a b
    · intro j
      refine Fin.addCases (fun b h ↦ ?_) (fun b h ↦ ?_) j
      · change l + a.val ≤ b.val at h
        omega
      · have hab : a ≤ b := by
          change l + a.val ≤ l + b.val at h
          exact Nat.le_of_add_le_add_left h
        simpa using hq hab

theorem ford_monotone_cons_iff {m : ℕ} (t : ℝ) (q : Fin m → ℝ) :
    Monotone (Fin.cons t q) ↔ Monotone q ∧ ∀ j, t ≤ q j := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro i j hij
      simpa using h (Fin.succ_le_succ_iff.mpr hij)
    · intro j
      simpa using h (show (0 : Fin (m + 1)) ≤ j.succ from Fin.zero_le _)
  · rintro ⟨hq, htq⟩ i
    refine Fin.cases (fun j _ ↦ ?_) (fun a j ↦ ?_) i
    · exact Fin.cases (le_refl t) (fun b ↦ by simpa using htq b) j
    · refine Fin.cases (fun h ↦ ?_) (fun b h ↦ ?_) j
      · have hh : a.val + 1 ≤ 0 := h
        omega
      · simpa using hq (Fin.succ_le_succ_iff.mp h)

/-- The ordered slice has exactly its constrained left block and free right block. -/
theorem ford_splice_simplex_iff {l m : ℕ} (p : Fin l → ℝ) (q : Fin m → ℝ) (t T : ℝ) :
    Fin.append p (Fin.cons t q) ∈ fordOrderedSimplex (l + (m + 1)) T ↔
      0 ≤ t ∧ t ≤ T ∧ p ∈ fordOrderedSimplex l t ∧ q ∈ fordOrderedInterval m t T := by
  constructor
  · intro hx
    have hm := (ford_monotone_append_iff p (Fin.cons t q)).mp hx.2
    have hmq := (ford_monotone_cons_iff t q).mp hm.2.1
    refine ⟨?_, ?_, ⟨⟨?_, ?_⟩, hm.1⟩, ⟨⟨hmq.2, ?_⟩, hmq.1⟩⟩
    · simpa using hx.1.1 (Fin.natAdd l 0)
    · simpa using hx.1.2 (Fin.natAdd l 0)
    · intro i
      simpa using hx.1.1 (Fin.castAdd (m + 1) i)
    · intro i
      simpa using hm.2.2 i 0
    · intro j
      simpa using hx.1.2 (Fin.natAdd l j.succ)
  · rintro ⟨ht0, htT, hp, hq⟩
    refine ⟨⟨?_, ?_⟩, (ford_monotone_append_iff p (Fin.cons t q)).mpr ?_⟩
    · intro i
      refine Fin.addCases (fun j ↦ ?_) (fun j ↦ ?_) i
      · simpa using hp.1.1 j
      · refine Fin.cases (by simpa using ht0) (fun j ↦ ?_) j
        simpa using ht0.trans (hq.1.1 j)
    · intro i
      refine Fin.addCases (fun j ↦ ?_) (fun j ↦ ?_) i
      · simpa using (hp.1.2 j).trans htT
      · refine Fin.cases (by simpa using htT) (fun j ↦ ?_) j
        simpa using hq.1.2 j
    · refine ⟨hp.2, (ford_monotone_cons_iff t q).mpr ⟨hq.2, hq.1.1⟩, ?_⟩
      intro i j
      exact Fin.cases (by simpa using hp.1.2 i)
        (fun j ↦ by simpa using (hp.1.2 i).trans (hq.1.1 j)) j

theorem ford_splice_crossing_iff {l m : ℕ} (p : Fin l → ℝ) (q : Fin m → ℝ)
    (t T u v : ℝ) :
    Fin.append p (Fin.cons t q) ∈ fordFirstCrossing T u v (Fin.natAdd l 0) ↔
      (0 ≤ t ∧ t ≤ T ∧ v * t < (l : ℝ) + 1 - u) ∧
        p ∈ fordBarrierGood l t u v ∧ q ∈ fordOrderedInterval m t T := by
  constructor
  · intro hx
    obtain ⟨ht0, htT, hp, hq⟩ := (ford_splice_simplex_iff p q t T).mp hx.1
    refine ⟨⟨ht0, htT, ?_⟩, ⟨hp, ?_⟩, hq⟩
    · simpa using hx.2.1
    · intro i
      have hi : Fin.castAdd (m + 1) i < Fin.natAdd l (0 : Fin (m + 1)) := by
        change i.val < l + 0
        simp
      simpa using hx.2.2 (Fin.castAdd (m + 1) i) hi
  · rintro ⟨⟨ht0, htT, hfail⟩, hp, hq⟩
    refine ⟨(ford_splice_simplex_iff p q t T).mpr ⟨ht0, htT, hp.1, hq⟩, ?_, ?_⟩
    · simpa using hfail
    · intro i
      refine Fin.addCases (fun j _ ↦ ?_) (fun j hj ↦ ?_) i
      · simpa using hp.2 j
      · change l + j.val < l + 0 at hj
        omega

theorem ford_splice_measurePreserving (l m : ℕ) :
    MeasurePreserving (fun z : ℝ × ((Fin l → ℝ) × (Fin m → ℝ)) ↦
      Fin.append z.2.1 (Fin.cons z.1 z.2.2)) volume volume := by
  have hleft : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm : ℝ × ((Fin l → ℝ) × (Fin m → ℝ)) ≃ᵐ
        (ℝ × (Fin l → ℝ)) × (Fin m → ℝ)) volume volume :=
    volume_preserving_prodAssoc.symm
  have hswap : MeasurePreserving (Prod.swap : ℝ × (Fin l → ℝ) → (Fin l → ℝ) × ℝ)
      volume volume := Measure.measurePreserving_swap
  have hright : MeasurePreserving
      (MeasurableEquiv.prodAssoc : ((Fin l → ℝ) × ℝ) × (Fin m → ℝ) ≃ᵐ
        (Fin l → ℝ) × (ℝ × (Fin m → ℝ))) volume volume := volume_preserving_prodAssoc
  have hreorder := hright.comp ((hswap.prod (MeasurePreserving.id volume)).comp hleft)
  have hcons : MeasurePreserving (fun z : ℝ × (Fin m → ℝ) ↦
      (Fin.cons z.1 z.2 : Fin (m + 1) → ℝ)) volume volume := by
    simpa only [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv,
      Equiv.coe_fn_mk, Fin.insertNth_zero'] using
      (volume_preserving_piFinSuccAbove (fun _ : Fin (m + 1) ↦ ℝ) 0).symm
  exact ((ford_append_measurePreserving l (m + 1)).comp
    ((MeasurePreserving.id volume).prod hcons)).comp hreorder

/-- Exact first-crossing fiber formula, including its genuine prefix barrier volume. -/
theorem fordFirstCrossing_volume_prefix_suffix (l m : ℕ) (T u v : ℝ) :
    volume (fordFirstCrossing (k := l + (m + 1)) T u v (Fin.natAdd l 0)) =
      ∫⁻ t : ℝ, if 0 ≤ t ∧ t ≤ T ∧ v * t < (l : ℝ) + 1 - u then
        volume (fordBarrierGood l t u v) *
          ENNReal.ofReal ((T - t) ^ m / (m.factorial : ℝ)) else 0 := by
  classical
  have hS := fordFirstCrossing_measurable (k := l + (m + 1)) T u v (Fin.natAdd l 0)
  have hp := ford_splice_measurePreserving l m
  rw [← hp.measure_preimage hS.nullMeasurableSet, Measure.volume_eq_prod,
    Measure.prod_apply (hS.preimage hp.measurable)]
  apply lintegral_congr
  intro t
  by_cases ht : 0 ≤ t ∧ t ≤ T ∧ v * t < (l : ℝ) + 1 - u
  · rw [if_pos ht]
    have heq : {z : (Fin l → ℝ) × (Fin m → ℝ) |
        Fin.append z.1 (Fin.cons t z.2) ∈ fordFirstCrossing T u v (Fin.natAdd l 0)} =
        fordBarrierGood l t u v ×ˢ fordOrderedInterval m t T := by
      ext z
      simp only [mem_ofPred_eq, ford_splice_crossing_iff, ht, true_and, mem_prod]
    change volume {z : (Fin l → ℝ) × (Fin m → ℝ) |
      Fin.append z.1 (Fin.cons t z.2) ∈ fordFirstCrossing T u v (Fin.natAdd l 0)} = _
    rw [heq, Measure.volume_eq_prod, Measure.prod_prod, fordOrderedInterval_volume m ht.2.1]
  · rw [if_neg ht]
    have heq : {z : (Fin l → ℝ) × (Fin m → ℝ) |
        Fin.append z.1 (Fin.cons t z.2) ∈ fordFirstCrossing T u v (Fin.natAdd l 0)} = ∅ := by
      ext z
      simp only [mem_ofPred_eq, ford_splice_crossing_iff, ht, false_and, mem_empty_iff_false]
    change volume {z : (Fin l → ℝ) × (Fin m → ℝ) |
      Fin.append z.1 (Fin.cons t z.2) ∈ fordFirstCrossing T u v (Fin.natAdd l 0)} = 0
    rw [heq, measure_empty]

/-- Positive `v` turns the failure condition into the explicit crossing threshold. -/
theorem fordFirstCrossing_volume_integral (l m : ℕ) (T u : ℝ) {v : ℝ} (hv : 0 < v) :
    volume (fordFirstCrossing (k := l + (m + 1)) T u v (Fin.natAdd l 0)) =
      ∫⁻ t : ℝ in Icc 0 T ∩ Iio (((l : ℝ) + 1 - u) / v),
        volume (fordBarrierGood l t u v) *
          ENNReal.ofReal ((T - t) ^ m / (m.factorial : ℝ)) := by
  classical
  rw [fordFirstCrossing_volume_prefix_suffix,
    ← lintegral_indicator (measurableSet_Icc.inter measurableSet_Iio)]
  apply lintegral_congr
  intro t
  simp only [indicator_apply, mem_inter_iff, mem_Icc, mem_Iio, lt_div_iff₀ hv,
    mul_comm t v, and_assoc]

end Erdos859Verification

end

/- Inlined development module: FordBarrierBound.lean -/

section

/- Actual ordered-barrier endpoint comparison and Ford's main-regime bound. -/

open MeasureTheory Set Real
open scoped ENNReal

namespace Erdos859Verification

theorem fordBarrierGood_prefix_lower {l : ℕ} {t u v : ℝ}
    (hu : 0 ≤ u) (hv : 0 ≤ v) (ht : 0 ≤ t)
    (hvol : volume (fordBarrierGood l t u v) ≠ 0) :
    (l : ℝ) - u ≤ v * t := by
  cases l with
  | zero => simp only [Nat.cast_zero, zero_sub]; nlinarith
  | succ l =>
    obtain ⟨x, hx⟩ := nonempty_of_measure_ne_zero hvol
    have hb := hx.2 (Fin.last l)
    have ht' := mul_le_mul_of_nonneg_left (hx.1.1.2 (Fin.last l)) hv
    simp only [Fin.val_last, Nat.cast_add, Nat.cast_one] at hb ⊢
    linarith

/-- The genuine crossing slack makes the free suffix shrink by `exp (-(2w+2))`. -/
theorem ford_crossing_suffix_power_le {l m : ℕ} {t u v w : ℝ}
    (hw : 0 ≤ w) (hv : 0 < v) (hrel : v = (l + (m + 1) : ℕ) + w - u)
    (ht : t ≤ 1 - (2 * w + 2) / v) (hprefix : (l : ℝ) - u ≤ v * t)
    (hfail : v * t < (l : ℝ) + 1 - u) :
    (1 - (2 * w + 2) / v - t) ^ m ≤
      exp (-(2 * w + 2)) * (1 - t) ^ m := by
  have hvt : v * t ≤ v - (2 * w + 2) := by
    have h := mul_le_mul_of_nonneg_left ht hv.le
    have heq : v * (1 - (2 * w + 2) / v) = v - (2 * w + 2) := by field_simp
    rwa [heq] at h
  have hrel' : v = (l : ℝ) + (m : ℝ) + 1 + w - u := by
    norm_num only [Nat.cast_add, Nat.cast_one] at hrel
    linarith
  have hm : 0 < m := by
    by_contra h
    have hm0 : m = 0 := Nat.eq_zero_of_not_pos h
    simp only [hm0, Nat.cast_zero] at hrel'
    linarith
  let lam := (l : ℝ) + 1 - u - v * t
  let A := w + 2 - lam
  let B := w + lam
  have hlam0 : 0 < lam := by dsimp [lam]; linarith
  have hlam1 : lam ≤ 1 := by dsimp [lam]; linarith
  have hB : 0 ≤ B := by dsimp [B]; linarith
  have hBA : B ≤ A := by dsimp [A, B]; linarith
  have hAm : A ≤ m := by dsimp [A, lam]; linarith
  have hratio := ford_power_ratio_upper hm hB hBA hAm
  have hden : 0 < 1 - t := by
    have hc : 0 < (2 * w + 2) / v := by positivity
    linarith
  have hmB : 0 < (m : ℝ) + B := by
    have hmR : (0 : ℝ) < m := by exact_mod_cast hm
    linarith
  have htop : v * (1 - (2 * w + 2) / v - t) = (m : ℝ) - A := by
    dsimp [A, lam]
    field_simp
    nlinarith [hrel']
  have hbot : v * (1 - t) = (m : ℝ) + B := by dsimp [B, lam]; nlinarith
  have heq : (1 - (2 * w + 2) / v - t) / (1 - t) =
      ((m : ℝ) - A) / ((m : ℝ) + B) := by
    rw [← htop, ← hbot]
    field_simp
  have hexp : -A - B = -(2 * w + 2) := by dsimp [A, B]; ring
  rw [hexp, ← heq, div_pow] at hratio
  exact (div_le_iff₀ (pow_pos hden m)).mp hratio

/-- Comparison of actual first-crossing cell volumes at the two endpoints. -/
theorem fordFirstCrossing_short_le {l m : ℕ} {u v w : ℝ}
    (hu : 0 ≤ u) (hw : 0 ≤ w) (hv : 0 < v)
    (hrel : v = (l + (m + 1) : ℕ) + w - u) :
    volume (fordFirstCrossing (k := l + (m + 1)) (1 - (2 * w + 2) / v) u v
      (Fin.natAdd l 0)) ≤
      ENNReal.ofReal (exp (-(2 * w + 2))) *
        volume (fordFirstCrossing (k := l + (m + 1)) 1 u v (Fin.natAdd l 0)) := by
  classical
  rw [fordFirstCrossing_volume_prefix_suffix, fordFirstCrossing_volume_prefix_suffix,
    ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  apply lintegral_mono
  intro t
  dsimp only
  by_cases ht : 0 ≤ t ∧ t ≤ 1 - (2 * w + 2) / v ∧ v * t < (l : ℝ) + 1 - u
  · rw [if_pos ht]
    have ht1 : 0 ≤ t ∧ t ≤ 1 ∧ v * t < (l : ℝ) + 1 - u := by
      have hc : 0 ≤ (2 * w + 2) / v := by positivity
      exact ⟨ht.1, by linarith [ht.2.1], ht.2.2⟩
    rw [if_pos ht1]
    by_cases hzero : volume (fordBarrierGood l t u v) = 0
    · simp [hzero]
    · have hprefix := fordBarrierGood_prefix_lower hu hv.le ht.1 hzero
      have hpow := ford_crossing_suffix_power_le hw hv hrel ht.2.1 hprefix ht.2.2
      have hdiv := div_le_div_of_nonneg_right hpow (by positivity : (0 : ℝ) ≤ m.factorial)
      have hfactor :
          ENNReal.ofReal ((1 - (2 * w + 2) / v - t) ^ m / (m.factorial : ℝ)) ≤
            ENNReal.ofReal (exp (-(2 * w + 2))) *
              ENNReal.ofReal ((1 - t) ^ m / (m.factorial : ℝ)) := by
        rw [← ENNReal.ofReal_mul (exp_pos _).le]
        apply ENNReal.ofReal_le_ofReal
        simpa only [mul_div_assoc] using hdiv
      calc
        _ ≤ volume (fordBarrierGood l t u v) *
            (ENNReal.ofReal (exp (-(2 * w + 2))) *
              ENNReal.ofReal ((1 - t) ^ m / (m.factorial : ℝ))) :=
          mul_le_mul_of_nonneg_left hfactor (by positivity)
        _ = _ := by ring
  · rw [if_neg ht]
    exact bot_le

theorem fordFirstCrossing_short_le_index {k : ℕ} (l : Fin k) {u v w : ℝ}
    (hu : 0 ≤ u) (hw : 0 ≤ w) (hv : 0 < v) (hrel : v = (k : ℝ) + w - u) :
    volume (fordFirstCrossing (1 - (2 * w + 2) / v) u v l) ≤
