  · obtain ⟨q, hq⟩ := hne
    exact (log_pos (by exact_mod_cast (hS q hq).one_lt)).trans_le
      (fordLogDenominator_mark (Subset.refl S) hS (by linarith) hq)
  · have hS0 := not_nonempty_iff_eq_empty.mp hne
    simpa [hS0, fordLogDenominator] using log_pos hy

