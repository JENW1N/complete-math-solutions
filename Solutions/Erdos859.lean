section

/- Connect the Euclidean phase statistic to the deterministic no-wrap chain. -/

open Finset

namespace Erdos859Verification

theorem nearInteger_of_cubePhaseSquare_le {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {Y a : ℝ} (hY : 0 < Y)
    (hphase : cubePhaseSquare w (a : AddCircle (1 : ℝ)) ≤ 1 / Y ^ 2)
    (i : ι) : NearInteger (1 / Y) (a * (w i : ℝ)) := by
  have hi : ‖w i • (a : AddCircle (1 : ℝ))‖ ^ 2 ≤ cubePhaseSquare w (a : AddCircle (1 : ℝ)) := by
    unfold cubePhaseSquare
    exact single_le_sum (fun j _ ↦ sq_nonneg ‖w j • (a : AddCircle (1 : ℝ))‖) (mem_univ i)
  have hsq : ‖w i • (a : AddCircle (1 : ℝ))‖ ^ 2 ≤ (1 / Y) ^ 2 := by
    simpa only [div_pow, one_pow] using hi.trans hphase
  have hn := (sq_le_sq₀ (norm_nonneg _) (by positivity : 0 ≤ 1 / Y)).mp hsq
  rw [← QuotientAddGroup.mk_nsmul, nsmul_eq_mul, UnitAddCircle.norm_eq] at hn
  refine ⟨round (a * (w i : ℝ)), ?_⟩
  simpa only [mul_comm (w i : ℝ) a] using hn

/-- A localized nonzero rational phase cannot stay small along a divisor
chain that reaches its denominator. The terminal denominator has phase zero
and need not be included among the other coins. -/
theorem cubePhase_gap_of_localized_chain {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {Y : ℝ} {a : ℤ} {r k : ℕ} (v : ℕ → ℕ)
    (hY : 2 < Y) (ha : a ≠ 0) (hr : 0 < r) (hlast : v k = r)
    (hcoins : ∀ i ≤ k, v i = r ∨ ∃ j, w j = v i)
    (hgap : ∀ i < k, (v (i + 1) : ℝ) ≤ Y / 2 * v i)
    (hlocal : cubePhaseSquare w (((a : ℝ) / r : ℝ) : AddCircle (1 : ℝ)) ≤ 1 / Y ^ 2 →
      |(a : ℝ) / r| * v 0 ≤ 1 / 2) :
    1 / Y ^ 2 < cubePhaseSquare w (((a : ℝ) / r : ℝ) : AddCircle (1 : ℝ)) := by
  by_contra! hphase
  have hYpos : 0 < Y := by linarith
  apply no_nonzero_rational_phase_on_chain hY ha hr
    (fun i _ ↦ Nat.cast_nonneg (v i)) (by exact_mod_cast hlast) (hlocal hphase) hgap
  intro i hi
  rcases hcoins i hi with hterminal | ⟨j, hj⟩
  · refine ⟨a, ?_⟩
    rw [hterminal, div_mul_cancel₀ _ (by exact_mod_cast Nat.ne_of_gt hr), sub_self, abs_zero]
    positivity
  · simpa only [hj] using nearInteger_of_cubePhaseSquare_le w hYpos hphase j

end Erdos859Verification

