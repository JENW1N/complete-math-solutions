    linarith
  · have hJn : J ≤ n := by omega
    rw [show n = J + (n - J) by omega, sum_range_add]
    exact add_le_add (virtual_core_loss_head hK J) (virtual_core_loss_tail hK hKJ (n - J))

theorem virtual_core_loss_product_bound {K : ℝ} (hK : 0 ≤ K) {J : ℕ}
    (hKJ : K ≤ (2 : ℝ) ^ J) (n : ℕ) :
    (∏ j ∈ range n, (1 + K / (2 : ℝ) ^ j)) ≤ exp (J * log (1 + K) + 2) := by
  apply (log_le_log_iff (prod_pos (fun j _ ↦ by positivity)) (exp_pos _)).mp
  rw [log_prod (fun j _ ↦ by positivity), log_exp]
  exact virtual_core_log_loss_bound hK hKJ n

/-- Product lower bound with no exponential-in-`A/B` penalty. -/
theorem virtualCoreBin_product_lower {A B : ℝ} (hA : 0 ≤ A) (hB : 0 < B)
    {J : ℕ} (hAB : A / B ≤ (2 : ℝ) ^ J) (n : ℕ) :
    log 2 ^ n * exp (-(J : ℝ) * log (1 + A / B) - 2) ≤
      ∏ j ∈ range n, virtualCoreBin A B j := by
  have hK : 0 ≤ A / B := div_nonneg hA hB.le
  have hprod : 0 < ∏ j ∈ range n, (1 + (A / B) / (2 : ℝ) ^ j) :=
    prod_pos (fun j _ ↦ by positivity)
  have hlog : 0 ≤ log (2 : ℝ) := log_nonneg (by norm_num)
  calc
    _ = log 2 ^ n / exp (J * log (1 + A / B) + 2) := by
      rw [show -(J : ℝ) * log (1 + A / B) - 2 = -(J * log (1 + A / B) + 2) by ring,
        exp_neg]
      rfl
    _ ≤ log 2 ^ n / (∏ j ∈ range n, (1 + (A / B) / (2 : ℝ) ^ j)) :=
      div_le_div_of_nonneg_left (pow_nonneg hlog n) hprod
        (virtual_core_loss_product_bound hK hAB n)
    _ = ∏ j ∈ range n, log 2 / (1 + (A / B) / (2 : ℝ) ^ j) := by
      rw [prod_div_distrib, prod_const, card_range]
    _ ≤ _ := prod_le_prod (fun j _ ↦ div_nonneg hlog (by positivity))
      (fun j _ ↦ virtualCoreBin_lower hA hB j)

/-- Apply the product correction directly to the finite weighted ballot
law. The premise concerns the actual masses of the displayed bins. -/
theorem virtual_core_ballot_weight_lower {n : ℕ} (hn : 0 < n)
    {α : Type*} [Fintype α] (weight : α → ℝ) (bin : α → Fin n)
    {A B lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hlam : 0 ≤ lam)
    {J : ℕ} (hAB : A / B ≤ (2 : ℝ) ^ J)
    (hbin : ∀ j, lam * virtualCoreBin A B j.val ≤ finiteBinMass weight bin j) :
    ((n : ℝ) ^ n / n) * (lam * log 2) ^ n *
      exp (-(J : ℝ) * log (1 + A / B) - 2) ≤
      ∑ x : Fin n → α with CyclicBallot (occupancyCount (fun i ↦ bin (x i))),
        ∏ i, weight (x i) := by
  have hprod : (lam * log 2) ^ n * exp (-(J : ℝ) * log (1 + A / B) - 2) ≤
      ∏ j : Fin n, lam * virtualCoreBin A B j.val := by
    rw [prod_mul_distrib, prod_const, card_univ, Fintype.card_fin,
      Fin.prod_univ_eq_prod_range (virtualCoreBin A B) n, mul_pow]
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
      (virtualCoreBin_product_lower hA hB hAB n) (pow_nonneg hlam n)
  have hballot := finite_bin_ballot_monotone_weight_lower hn weight bin
    (fun j ↦ lam * virtualCoreBin A B j.val)
    (fun j ↦ mul_nonneg hlam (virtualCoreBin_pos hA hB j.val).le)
    (fun i j hij ↦ mul_le_mul_of_nonneg_left (virtualCoreBin_monotone hA hB hij) hlam) hbin
  apply le_trans ?_ hballot
  simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left hprod (by positivity : 0 ≤ (n : ℝ) ^ n / n)

end Erdos859Verification

end

