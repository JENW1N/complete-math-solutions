/- Inlined development module: DivisorStarStructure.lean -/

section

/- Distinct actual divisors underlying the indexed divisor star. -/

namespace Erdos859Verification

open Finset

abbrev DivisorStarCoordinate (n : ℕ) (P : Finset ℕ) :=
  ↥n.divisors ⊕ (↥P × ↥n.divisors)

def divisorStarWeight (n : ℕ) (P : Finset ℕ) : DivisorStarCoordinate n P → ℕ
  | .inl d => d.val
  | .inr pd => pd.1.val * pd.2.val

noncomputable def divisorStar (n : ℕ) (P : Finset ℕ) : Finset ℕ :=
  univ.image (divisorStarWeight n P)

theorem divisorStarWeight_pos {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (i : DivisorStarCoordinate n P) :
    0 < divisorStarWeight n P i := by
  cases i with
  | inl d => exact Nat.pos_of_mem_divisors d.property
  | inr pd =>
    exact Nat.mul_pos (hP pd.1.val pd.1.property).pos
      (Nat.pos_of_mem_divisors pd.2.property)

theorem divisorStarWeight_dvd (n : ℕ) (P : Finset ℕ) (i : DivisorStarCoordinate n P) :
    divisorStarWeight n P i ∣ n * ∏ p ∈ P, p := by
  cases i with
  | inl d => exact dvd_mul_of_dvd_left (Nat.mem_divisors.mp d.property).1 _
  | inr pd =>
    have hp : pd.1.val ∣ ∏ p ∈ P, p := dvd_prod_of_mem id pd.1.property
    have hd : pd.2.val ∣ n := (Nat.mem_divisors.mp pd.2.property).1
    simpa only [divisorStarWeight, Nat.mul_comm] using Nat.mul_dvd_mul hp hd

theorem divisorStarWeight_injective {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hfresh : ∀ p ∈ P, ¬ p ∣ n) :
    Function.Injective (divisorStarWeight n P) := by
  intro i j hij
  have hnot (p : P) (d : n.divisors) : ¬ p.val ∣ d.val :=
    fun h ↦ hfresh p.val p.property (h.trans (Nat.mem_divisors.mp d.property).1)
  cases i with
  | inl d =>
    cases j with
    | inl e => exact congrArg Sum.inl (Subtype.ext hij)
    | inr pe =>
      change d.val = pe.1.val * pe.2.val at hij
      exact False.elim (hnot pe.1 d (hij.symm ▸ dvd_mul_right pe.1.val pe.2.val))
  | inr pd =>
    cases j with
    | inl e =>
      change pd.1.val * pd.2.val = e.val at hij
      exact False.elim (hnot pd.1 e (hij ▸ dvd_mul_right pd.1.val pd.2.val))
    | inr qe =>
      change pd.1.val * pd.2.val = qe.1.val * qe.2.val at hij
      have hpdiv : pd.1.val ∣ qe.1.val * qe.2.val :=
        hij ▸ dvd_mul_right pd.1.val pd.2.val
      have hpq : pd.1.val = qe.1.val := by
        rcases (hP pd.1.val pd.1.property).dvd_mul.mp hpdiv with hpq | hpe
        · exact (Nat.prime_dvd_prime_iff_eq (hP pd.1.val pd.1.property)
            (hP qe.1.val qe.1.property)).mp hpq
        · exact False.elim (hnot pd.1 qe.2 hpe)
      have hde : pd.2.val = qe.2.val := by
        rw [← hpq] at hij
        exact Nat.eq_of_mul_eq_mul_left (hP pd.1.val pd.1.property).pos hij
      exact congrArg Sum.inr (Prod.ext (Subtype.ext hpq) (Subtype.ext hde))

theorem card_divisorStarCoordinate (n : ℕ) (P : Finset ℕ) :
    Fintype.card (DivisorStarCoordinate n P) = (P.card + 1) * n.divisors.card := by
  simp only [DivisorStarCoordinate, Fintype.card_sum, Fintype.card_prod, Fintype.card_coe]
  ring

theorem sum_divisorStarWeight (n : ℕ) (P : Finset ℕ) :
    (∑ i : DivisorStarCoordinate n P, divisorStarWeight n P i) =
      (1 + ∑ p ∈ P, p) * ∑ d ∈ n.divisors, d := by
  simp only [DivisorStarCoordinate, Fintype.sum_sum_type, Fintype.sum_prod_type,
    divisorStarWeight, ← mul_sum]
  rw [← sum_mul, sum_coe_sort n.divisors (fun d : ℕ ↦ d), sum_coe_sort P (fun p : ℕ ↦ p)]
  ring

theorem mem_divisorStar {n d : ℕ} {P : Finset ℕ} :
    d ∈ divisorStar n P ↔ d ∈ n.divisors ∨ ∃ p ∈ P, ∃ e ∈ n.divisors, d = p * e := by
  classical
  constructor
  · intro hd
    obtain ⟨i, _, rfl⟩ := mem_image.mp hd
    cases i with
    | inl e => exact Or.inl e.property
    | inr pe => exact Or.inr ⟨pe.1.val, pe.1.property, pe.2.val, pe.2.property, rfl⟩
  · intro hd
    rcases hd with hd | ⟨p, hp, e, he, rfl⟩
    · exact mem_image.mpr ⟨.inl ⟨d, hd⟩, mem_univ _, rfl⟩
    · exact mem_image.mpr ⟨.inr (⟨p, hp⟩, ⟨e, he⟩), mem_univ _, rfl⟩

theorem divisors_subset_divisorStar (n : ℕ) (P : Finset ℕ) :
    n.divisors ⊆ divisorStar n P := fun _ hd ↦ mem_divisorStar.mpr (Or.inl hd)

theorem divisorStar_pos {n d : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hd : d ∈ divisorStar n P) : 0 < d := by
  obtain ⟨i, _, rfl⟩ := mem_image.mp hd
  exact divisorStarWeight_pos hP i

theorem divisorStar_subset_divisors {n : ℕ} {P : Finset ℕ}
    (hn : 0 < n) (hP : ∀ p ∈ P, p.Prime) :
    divisorStar n P ⊆ (n * ∏ p ∈ P, p).divisors := by
  intro d hd
  obtain ⟨i, _, rfl⟩ := mem_image.mp hd
  exact Nat.mem_divisors.mpr ⟨divisorStarWeight_dvd n P i,
    Nat.ne_of_gt (Nat.mul_pos hn (prod_pos (fun p hp ↦ (hP p hp).pos)))⟩

theorem card_divisorStar {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hfresh : ∀ p ∈ P, ¬ p ∣ n) :
    (divisorStar n P).card = (P.card + 1) * n.divisors.card := by
  rw [divisorStar, card_image_of_injective _ (divisorStarWeight_injective hP hfresh), card_univ]
  exact card_divisorStarCoordinate n P

theorem sum_divisorStar {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hfresh : ∀ p ∈ P, ¬ p ∣ n) :
    (∑ d ∈ divisorStar n P, d) = (1 + ∑ p ∈ P, p) * ∑ d ∈ n.divisors, d := by
  rw [divisorStar, sum_image]
  · exact sum_divisorStarWeight n P
  · exact fun _ _ _ _ h ↦ divisorStarWeight_injective hP hfresh h

theorem cubePhaseSquare_divisorStar_eq {n : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hfresh : ∀ p ∈ P, ¬ p ∣ n)
    (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare (divisorStarWeight n P) x = ∑ d ∈ divisorStar n P, ‖d • x‖ ^ 2 := by
  rw [divisorStar, sum_image]
  · rfl
  · exact fun _ _ _ _ h ↦ divisorStarWeight_injective hP hfresh h

theorem cubePhaseSquare_divisorStar_decomposition (n : ℕ) (P : Finset ℕ)
    (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare (divisorStarWeight n P) x =
      cubePhaseSquare (fun d : n.divisors ↦ d.val) x +
        ∑ p ∈ P, cubePhaseSquare (fun d : n.divisors ↦ d.val) (p • x) := by
  unfold cubePhaseSquare
  simp only [DivisorStarCoordinate, Fintype.sum_sum_type, Fintype.sum_prod_type, divisorStarWeight]
  apply congrArg (fun z : ℝ ↦ (∑ d : n.divisors, ‖d.val • x‖ ^ 2) + z)
  rw [sum_coe_sort P (fun p : ℕ ↦ ∑ d : n.divisors, ‖(p * d.val) • x‖ ^ 2)]
  apply sum_congr rfl
  intro p _
  apply sum_congr rfl
  intro d _
  rw [mul_nsmul]

theorem cubePhaseSquare_divisorStar_old_le (n : ℕ) (P : Finset ℕ)
    (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare (fun d : n.divisors ↦ d.val) x ≤
      cubePhaseSquare (divisorStarWeight n P) x := by
  rw [cubePhaseSquare_divisorStar_decomposition]
  exact le_add_of_nonneg_right (sum_nonneg (fun _ _ ↦ cubePhaseSquare_nonneg _ _))

theorem cubePhaseSquare_divisorStar_mark_le (n : ℕ) (P : Finset ℕ)
    {p : ℕ} (hp : p ∈ P) (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare (fun d : n.divisors ↦ d.val) (p • x) ≤
      cubePhaseSquare (divisorStarWeight n P) x := by
  rw [cubePhaseSquare_divisorStar_decomposition]
  exact (single_le_sum (fun q _ ↦ cubePhaseSquare_nonneg
    (fun d : n.divisors ↦ d.val) (q • x)) hp).trans
    (le_add_of_nonneg_left (cubePhaseSquare_nonneg _ _))

theorem cubePhaseSquare_comp_injective_le {ι κ : Type*} [Fintype ι] [Fintype κ]
    (w : κ → ℕ) (f : ι → κ) (hf : Function.Injective f) (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare (fun i ↦ w (f i)) x ≤ cubePhaseSquare w x := by
  classical
  unfold cubePhaseSquare
  have heq : (∑ i, ‖w (f i) • x‖ ^ 2) = ∑ j ∈ univ.image f, ‖w j • x‖ ^ 2 := by
    rw [sum_image]
    exact fun _ _ _ _ h ↦ hf h
  rw [heq]
  exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun _ _ _ ↦ sq_nonneg _)

/-- Any distinct divisor vector from an earlier core embeds in the star. -/
theorem cubePhaseSquare_le_divisorStar_of_injective_dvd {ι : Type*} [Fintype ι]
    {n : ℕ} (hn : 0 < n) (P : Finset ℕ) (w : ι → ℕ)
    (hw : Function.Injective w) (hdvd : ∀ i, w i ∣ n) (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare w x ≤ cubePhaseSquare (divisorStarWeight n P) x := by
  let f : ι → DivisorStarCoordinate n P :=
    fun i ↦ .inl ⟨w i, Nat.mem_divisors.mpr ⟨hdvd i, Nat.ne_of_gt hn⟩⟩
  have hf : Function.Injective f := by
    intro i j hij
    apply hw
    exact congrArg (divisorStarWeight n P) hij
  exact cubePhaseSquare_comp_injective_le (divisorStarWeight n P) f hf x

theorem cubePhaseSquare_prefix_le_actual_divisorStar {ι : Type*} [Fintype ι]
    {n : ℕ} {P : Finset ℕ} (hn : 0 < n)
    (hP : ∀ p ∈ P, p.Prime) (hfresh : ∀ p ∈ P, ¬ p ∣ n)
    (w : ι → ℕ) (hw : Function.Injective w) (hdvd : ∀ i, w i ∣ n)
    (x : AddCircle (1 : ℝ)) :
    cubePhaseSquare w x ≤ ∑ d ∈ divisorStar n P, ‖d • x‖ ^ 2 := by
  rw [← cubePhaseSquare_divisorStar_eq hP hfresh]
  exact cubePhaseSquare_le_divisorStar_of_injective_dvd hn P w hw hdvd x

end Erdos859Verification

