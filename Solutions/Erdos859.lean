  calc
    _ = (exp (-5 * eps) * (eps / 4) ^ n / (n.factorial : ℝ)) * eta := by ring
    _ ≤ (exp (-mu) * mu ^ n / (n.factorial : ℝ)) * eta :=
      mul_le_mul_of_nonneg_right hcoeff heta
