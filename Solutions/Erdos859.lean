/- Inlined development module: FiniteInsertionDomination.lean -/

section

/- Product-moment domination from a pointwise insertion-growth bound. -/

open Finset Real

namespace Erdos859Verification

noncomputable def insertionWeightedSum {α : Type*} (P : Finset α) (w : α → ℝ)
    (f : Finset α → ℝ) : ℝ :=
  ∑ S ∈ P.powerset, (∏ p ∈ S, w p) * f S

theorem insertionWeightedSum_nonneg {α : Type*} (P : Finset α) {w : α → ℝ}
    {f : Finset α → ℝ} (hw : ∀ p, 0 ≤ w p) (hf : ∀ S, 0 ≤ f S) :
    0 ≤ insertionWeightedSum P w f :=
  sum_nonneg fun S _ ↦ mul_nonneg (prod_nonneg fun p _ ↦ hw p) (hf S)

theorem insertionWeightedSum_mono {α : Type*} (P : Finset α) {w : α → ℝ}
    {f g : Finset α → ℝ} (hw : ∀ p, 0 ≤ w p) (hfg : ∀ S, f S ≤ g S) :
    insertionWeightedSum P w f ≤ insertionWeightedSum P w g :=
  sum_le_sum fun S _ ↦ mul_le_mul_of_nonneg_left (hfg S) (prod_nonneg fun p _ ↦ hw p)

theorem insertionWeightedSum_const_mul {α : Type*} (P : Finset α) (w : α → ℝ)
    (f : Finset α → ℝ) (c : ℝ) :
    insertionWeightedSum P w (fun S ↦ c * f S) = c * insertionWeightedSum P w f := by
  unfold insertionWeightedSum
  rw [mul_sum]
  apply sum_congr rfl
  intro S _
  ring

theorem insertionWeightedSum_insert {α : Type*} [DecidableEq α]
    {P : Finset α} {p : α} (hp : p ∉ P) (w : α → ℝ) (f : Finset α → ℝ) :
    insertionWeightedSum (insert p P) w f =
      insertionWeightedSum P w (fun S ↦ f S + w p * f (insert p S)) := by
  unfold insertionWeightedSum
  rw [sum_powerset_insert hp, ← sum_add_distrib]
  apply sum_congr rfl
  intro S hS
  rw [prod_insert (notMem_mono (mem_powerset.mp hS) hp)]
  ring

theorem insertion_growth_one_coordinate {a b c w z : ℝ}
    (hw : 0 ≤ w) (hc : 0 ≤ c) (hz : 1 ≤ z) (hba : b ≤ c * a) :
    a + w * z * b ≤ ((1 + c * w * z) / (1 + c * w)) * (a + w * b) := by
  have hd : 0 < 1 + c * w := by positivity
  have hprod : 0 ≤ w * (z - 1) * (c * a - b) :=
    mul_nonneg (mul_nonneg hw (sub_nonneg.mpr hz)) (sub_nonneg.mpr hba)
  rw [div_mul_eq_mul_div]
  apply (le_div_iff₀ hd).mpr
  nlinarith only [hprod]

/-- A nonnegative set weight whose insertion cost is at most `c` is dominated,
for increasing product moments, by independent selection with odds `c*w`.
The statement does not divide by the total weight and includes zero mass. -/
theorem insertionWeightedSum_product_domination {α : Type*} [DecidableEq α]
    (P : Finset α) (w z : α → ℝ) {c : ℝ} (hc : 0 ≤ c)
    (hw : ∀ p, 0 ≤ w p) (hz : ∀ p, 1 ≤ z p)
    (f : Finset α → ℝ) (hf : ∀ S, 0 ≤ f S)
    (hgrowth : ∀ S p, f (insert p S) ≤ c * f S) :
    insertionWeightedSum P (fun p ↦ w p * z p) f ≤
      insertionWeightedSum P w f * ∏ p ∈ P, (1 + c * w p * z p) / (1 + c * w p) := by
  induction P using Finset.induction_on generalizing f with
  | empty => simp [insertionWeightedSum]
  | @insert p P hp ih =>
      let g : Finset α → ℝ := fun S ↦ f S + w p * f (insert p S)
      have hg0 : ∀ S, 0 ≤ g S := fun S ↦ add_nonneg (hf S) (mul_nonneg (hw p) (hf _))
      have hg : ∀ S q, g (insert q S) ≤ c * g S := by
        intro S q
        have h1 := hgrowth S q
        have h2 := hgrowth (insert p S) q
        rw [insert_comm q p] at h2
        dsimp [g]
        nlinarith [mul_le_mul_of_nonneg_left h2 (hw p)]
      have hfactor : 0 ≤ (1 + c * w p * z p) / (1 + c * w p) := by
        apply div_nonneg
        · exact add_nonneg zero_le_one
            (mul_nonneg (mul_nonneg hc (hw p)) (le_trans zero_le_one (hz p)))
        · exact add_nonneg zero_le_one (mul_nonneg hc (hw p))
      calc
        _ = insertionWeightedSum P (fun q ↦ w q * z q)
            (fun S ↦ f S + w p * z p * f (insert p S)) :=
          insertionWeightedSum_insert hp _ _
        _ ≤ insertionWeightedSum P (fun q ↦ w q * z q)
            (fun S ↦ ((1 + c * w p * z p) / (1 + c * w p)) * g S) := by
          apply insertionWeightedSum_mono P (fun q ↦ mul_nonneg (hw q) (le_trans zero_le_one (hz q)))
          intro S
          exact insertion_growth_one_coordinate (hw p) hc (hz p) (hgrowth S p)
        _ = ((1 + c * w p * z p) / (1 + c * w p)) *
            insertionWeightedSum P (fun q ↦ w q * z q) g :=
          insertionWeightedSum_const_mul _ _ _ _
        _ ≤ ((1 + c * w p * z p) / (1 + c * w p)) *
            (insertionWeightedSum P w g *
              ∏ q ∈ P, (1 + c * w q * z q) / (1 + c * w q)) :=
          mul_le_mul_of_nonneg_left (ih g hg0 hg) hfactor
        _ = _ := by
          rw [prod_insert hp, insertionWeightedSum_insert hp]
          dsimp [g]
          ring

end Erdos859Verification

end

