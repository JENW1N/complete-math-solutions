theorem fordSupport_denominator_reduction {P : Finset ℕ} {x : ℝ}
    (hx : 2 ≤ x) (hP : ∀ q ∈ P, q.Prime) (hPx : ∀ q ∈ P, (q : ℝ) ≤ x)
