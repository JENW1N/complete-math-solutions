abbrev DyadicPrimeMark (A : ℝ) (j : ℕ) : Type :=
  ↥(primeLogWindow (A * (2 : ℝ) ^ j) (2 * (A * (2 : ℝ) ^ j)))

noncomputable def dyadicPrimeMarkWeight (A : ℝ) (j : ℕ) (p : DyadicPrimeMark A j) : ℝ :=
  primeLogMarkWeight (A * (2 : ℝ) ^ j) (2 * (A * (2 : ℝ) ^ j)) p

noncomputable def primeLogCollisionConstant : ℝ :=
  (4 + 4 * mertensErrorConstant) / log 2

theorem primeLogCollisionConstant_pos : 0 < primeLogCollisionConstant := by
  unfold primeLogCollisionConstant
  positivity [mertensErrorConstant_pos, log_pos (by norm_num : (1 : ℝ) < 2)]

