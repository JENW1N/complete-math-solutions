    exact h
  have hthree : log ((3 : ℝ) / 4) ≤ 0 := log_nonpos (by norm_num) (by norm_num)
  constructor <;> nlinarith

theorem bernoulliSeed_target_log_mem_horizon {k r t : ℕ} (hk : 0 < k) (hr : 0 < r)
    {T0 V a L r0 : ℝ} (hL : 0 ≤ L)
    (hVlo : T0 ≤ V) (hVhi : V ≤ T0 + 4 * r0 * L + L / 16)
    (halo : L / 4 ≤ a) (hahi : a ≤ 5 * L / 16)
    (hrlo : V + a + L / 8 ≤ log (r : ℝ))
    (hrhi : log (r : ℝ) ≤ V + a + L / 4)
    (htlo : (bernoulliSeedScale k : ℝ) * r / 4 ≤ t)
    (hthi : (t : ℝ) ≤ 3 * bernoulliSeedScale k * r / 4) :
    log (t : ℝ) ∈ Set.Icc T0 (T0 + (4 * r0 + 2) * L + 4 * (k : ℝ) ^ 3) := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  exact bernoulli_target_log_mem_horizon (bernoulliSeedScale_pos k) hr
    (one_le_pow₀ hkR) hL (bernoulliSeedScale_log_bounds k).1
    (bernoulliSeedScale_log_bounds k).2 hVlo hVhi halo hahi hrlo hrhi htlo hthi

/-- A concrete natural interval contained in `[N/4,3N/4]`. -/
theorem quarter_interval_mem_bounds {N t : ℕ}
    (ht : t ∈ Icc (N / 4 + 1) (3 * N / 4)) :
    (N : ℝ) / 4 ≤ t ∧ (t : ℝ) ≤ 3 * N / 4 := by
  obtain ⟨hlo, hhi⟩ := mem_Icc.mp ht
  have hlo' : N ≤ 4 * t := by omega
  have hhi' : 4 * t ≤ 3 * N := by omega
  have hloR : (N : ℝ) ≤ 4 * t := by exact_mod_cast hlo'
  have hhiR : 4 * (t : ℝ) ≤ 3 * N := by exact_mod_cast hhi'
  constructor
  · linarith
  · linarith

/-- Every such integer interval carries a fixed positive harmonic mass.
This weaker absolute constant suffices for the mesh coverage argument. -/
theorem quarter_interval_harmonic_mass {N : ℕ} (hN : 4 ≤ N) :
    (1 : ℝ) / 4 ≤ ∑ t ∈ Icc (N / 4 + 1) (3 * N / 4), 1 / (t : ℝ) := by
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hcard : N ≤ 4 * (Icc (N / 4 + 1) (3 * N / 4)).card := by
    rw [Nat.card_Icc]
    omega
  have hcardR : (N : ℝ) ≤ 4 * ((Icc (N / 4 + 1) (3 * N / 4)).card : ℝ) := by
    exact_mod_cast hcard
  calc
    _ ≤ ((Icc (N / 4 + 1) (3 * N / 4)).card : ℝ) / N := by
      apply (le_div_iff₀ hNpos).mpr
      linarith
    _ = ∑ _t ∈ Icc (N / 4 + 1) (3 * N / 4), 1 / (N : ℝ) := by simp [div_eq_mul_inv]
    _ ≤ _ := by
      apply sum_le_sum
      intro t ht
      obtain ⟨hlo, hhi⟩ := mem_Icc.mp ht
      have htpos : (0 : ℝ) < t := by exact_mod_cast (show 0 < t by omega)
      have htN : (t : ℝ) ≤ N := by exact_mod_cast (show t ≤ N by omega)
      exact one_div_le_one_div_of_le htpos htN

/-- The concrete natural interval has fixed harmonic mass and every one
of its targets belongs to the deterministic logarithmic horizon. -/
theorem bernoulliSeed_target_interval_harmonic {k r : ℕ} (hk : 0 < k) (hr : 0 < r)
    {T0 V a L r0 : ℝ} (hL : 0 ≤ L)
    (hVlo : T0 ≤ V) (hVhi : V ≤ T0 + 4 * r0 * L + L / 16)
    (halo : L / 4 ≤ a) (hahi : a ≤ 5 * L / 16)
    (hrlo : V + a + L / 8 ≤ log (r : ℝ))
    (hrhi : log (r : ℝ) ≤ V + a + L / 4)
    (hsize : 4 ≤ bernoulliSeedScale k * r) :
    (1 : ℝ) / 4 ≤
      (∑ t ∈ Icc (bernoulliSeedScale k * r / 4 + 1) (3 * (bernoulliSeedScale k * r) / 4),
        1 / (t : ℝ)) ∧
    ∀ t ∈ Icc (bernoulliSeedScale k * r / 4 + 1) (3 * (bernoulliSeedScale k * r) / 4),
      log (t : ℝ) ∈ Set.Icc T0 (T0 + (4 * r0 + 2) * L + 4 * (k : ℝ) ^ 3) := by
  refine ⟨quarter_interval_harmonic_mass hsize, ?_⟩
  intro t ht
  obtain ⟨htlo, hthi⟩ := quarter_interval_mem_bounds ht
  apply bernoulliSeed_target_log_mem_horizon hk hr hL hVlo hVhi halo hahi hrlo hrhi
  · simpa only [Nat.cast_mul] using htlo
  · simpa only [Nat.cast_mul, Nat.cast_ofNat, mul_assoc] using hthi

end Erdos859Verification

end

/- Inlined development module: FiniteQuantileCoupling.lean -/

section

/- Exact finite inverse-CDF intervals and common-uniform quantile transport. -/

namespace Erdos859Verification

open Finset Real MeasureTheory

noncomputable def finiteMarkCDF (P : Finset ℝ) (a : ℝ → ℝ) (v : ℝ) : ℝ :=
  ∑ x ∈ P.filter (fun x ↦ x ≤ v), a x

noncomputable def finiteMarkLeftCDF (P : Finset ℝ) (a : ℝ → ℝ) (v : ℝ) : ℝ :=
  ∑ x ∈ P.filter (fun x ↦ x < v), a x

noncomputable def finiteQuantileCell (P : Finset ℝ) (a : ℝ → ℝ) (x : ℝ) : Set ℝ :=
  Set.Ioc (finiteMarkLeftCDF P a x) (finiteMarkCDF P a x)

theorem finiteMarkCDF_sub_left {P : Finset ℝ} (a : ℝ → ℝ) {x : ℝ} (hx : x ∈ P) :
    finiteMarkCDF P a x - finiteMarkLeftCDF P a x = a x := by
  classical
  have hi : P.filter (fun y ↦ y ≤ x) = insert x (P.filter (fun y ↦ y < x)) := by
    ext y
    simp only [Finset.mem_filter, Finset.mem_insert]
    constructor
    · intro h
      rcases h.2.eq_or_lt with he | hl
      · exact Or.inl he
      · exact Or.inr ⟨h.1, hl⟩
    · rintro (rfl | ⟨hy, hyx⟩)
      · exact ⟨hx, le_rfl⟩
      · exact ⟨hy, hyx.le⟩
  unfold finiteMarkCDF finiteMarkLeftCDF
  rw [hi, sum_insert (by simp)]
  ring

theorem finiteMarkCDF_le_left {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) {v x : ℝ} (hvx : v < x) :
    finiteMarkCDF P a v ≤ finiteMarkLeftCDF P a x := by
  classical
  apply sum_le_sum_of_subset_of_nonneg
  · intro y hy
    exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hy).1,
      ((Finset.mem_filter.mp hy).2).trans_lt hvx⟩
  · intro y hy _
    exact ha y (Finset.mem_filter.mp hy).1

theorem finiteQuantileCell_subset {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) (x : ℝ) :
    finiteQuantileCell P a x ⊆ Set.Ioc 0 1 := by
  intro s hs
  have hl : 0 ≤ finiteMarkLeftCDF P a x :=
    sum_nonneg (fun y hy ↦ ha y (Finset.mem_filter.mp hy).1)
  have hu : finiteMarkCDF P a x ≤ 1 := by
    rw [← hnorm]
    exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun y hy _ ↦ ha y hy)
  exact ⟨hl.trans_lt hs.1, hs.2.trans hu⟩

theorem finiteQuantileCells_disjoint {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) :
    (P : Set ℝ).PairwiseDisjoint (finiteQuantileCell P a) := by
  intro x _ y _ hxy
  change Disjoint (finiteQuantileCell P a x) (finiteQuantileCell P a y)
  rw [Set.disjoint_left]
  intro s hsx hsy
  rcases lt_or_gt_of_ne hxy with h | h
  · have hc := finiteMarkCDF_le_left ha h
    exact (not_lt_of_ge (hsx.2.trans hc)) hsy.1
  · have hc := finiteMarkCDF_le_left ha h
    exact (not_lt_of_ge (hsy.2.trans hc)) hsx.1

theorem exists_finiteQuantileCell {P : Finset ℝ} {a : ℝ → ℝ}
    (hnorm : ∑ x ∈ P, a x = 1) {s : ℝ} (hs : s ∈ Set.Ioc (0 : ℝ) 1) :
    ∃ x ∈ P, s ∈ finiteQuantileCell P a x := by
  classical
  have hP : P.Nonempty := by
    by_contra h
    have hzero : P = ∅ := not_nonempty_iff_eq_empty.mp h
    simp only [hzero, sum_empty] at hnorm
    norm_num at hnorm
  let S := P.filter (fun x ↦ s ≤ finiteMarkCDF P a x)
  have hmax : finiteMarkCDF P a (P.max' hP) = 1 := by
    unfold finiteMarkCDF
    rw [filter_eq_self.mpr (fun y hy ↦ le_max' P y hy)]
    exact hnorm
  have hS : S.Nonempty := by
    refine ⟨P.max' hP, Finset.mem_filter.mpr ⟨max'_mem P hP, ?_⟩⟩
    simpa only [hmax] using hs.2
  let x := S.min' hS
  have hxS : x ∈ S := min'_mem S hS
  have hxP : x ∈ P := (Finset.mem_filter.mp hxS).1
  have hsu : s ≤ finiteMarkCDF P a x := (Finset.mem_filter.mp hxS).2
  refine ⟨x, hxP, ?_, hsu⟩
  by_contra hn
  have hsl : s ≤ finiteMarkLeftCDF P a x := le_of_not_gt hn
  let Q := P.filter (fun y ↦ y < x)
  have hQ : Q.Nonempty := by
    by_contra h
    have hzero : Q = ∅ := not_nonempty_iff_eq_empty.mp h
    have hz : finiteMarkLeftCDF P a x = 0 := by
      change (∑ y ∈ Q, a y) = 0
      rw [hzero, sum_empty]
    linarith [hs.1]
  let y := Q.max' hQ
  have hyQ : y ∈ Q := max'_mem Q hQ
  have hyP : y ∈ P := (Finset.mem_filter.mp hyQ).1
  have hyx : y < x := (Finset.mem_filter.mp hyQ).2
  have hfilter : P.filter (fun z ↦ z ≤ y) = Q := by
    ext z
    simp only [Finset.mem_filter]
    constructor
    · exact fun ⟨hz, hzy⟩ ↦ Finset.mem_filter.mpr ⟨hz, hzy.trans_lt hyx⟩
    · intro hz
      have hzQ : z ∈ Q := hz
      exact ⟨(Finset.mem_filter.mp hzQ).1, le_max' Q z hzQ⟩
  have hcy : finiteMarkCDF P a y = finiteMarkLeftCDF P a x := by
    unfold finiteMarkCDF
    rw [hfilter]
    rfl
  have hyS : y ∈ S := Finset.mem_filter.mpr ⟨hyP, hcy ▸ hsl⟩
  have hxy : x ≤ y := min'_le S y hyS
  exact (not_lt_of_ge hxy) hyx

theorem finiteQuantileCells_cover {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) :
    (⋃ x ∈ P, finiteQuantileCell P a x) = Set.Ioc 0 1 := by
  ext s
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨x, _, hs⟩
    exact finiteQuantileCell_subset ha hnorm x hs
  · intro hs
    obtain ⟨x, hx, hsx⟩ := exists_finiteQuantileCell hnorm hs
    exact ⟨x, hx, hsx⟩

theorem volume_finiteQuantileCell {P : Finset ℝ} (a : ℝ → ℝ) {x : ℝ} (hx : x ∈ P) :
    volume (finiteQuantileCell P a x) = ENNReal.ofReal (a x) := by
  rw [finiteQuantileCell, Real.volume_Ioc, finiteMarkCDF_sub_left a hx]

noncomputable def finiteQuantile (P : Finset ℝ) (a : ℝ → ℝ) (s : ℝ) : ℝ :=
  ∑ x ∈ P, (finiteQuantileCell P a x).indicator (fun _ ↦ x) s

theorem measurable_finiteQuantile (P : Finset ℝ) (a : ℝ → ℝ) :
    Measurable (finiteQuantile P a) := by
  classical
  apply Finset.measurable_sum
  intro x _
  exact measurable_const.indicator measurableSet_Ioc

theorem finiteQuantile_eq_of_mem {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) {x s : ℝ} (hx : x ∈ P)
    (hs : s ∈ finiteQuantileCell P a x) : finiteQuantile P a s = x := by
  classical
  unfold finiteQuantile
  rw [sum_eq_single x]
  · exact Set.indicator_of_mem hs _
  · intro y hy hyx
    apply Set.indicator_of_notMem
    intro hsy
    have hd := finiteQuantileCells_disjoint ha hy hx hyx
    exact Set.disjoint_left.mp hd hsy hs
  · exact fun h ↦ False.elim (h hx)

theorem finiteQuantile_mem_cell {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1)
    {s : ℝ} (hs : s ∈ Set.Ioc (0 : ℝ) 1) :
    finiteQuantile P a s ∈ P ∧ s ∈ finiteQuantileCell P a (finiteQuantile P a s) := by
  obtain ⟨x, hx, hsx⟩ := exists_finiteQuantileCell hnorm hs
  rw [finiteQuantile_eq_of_mem ha hx hsx]
  exact ⟨hx, hsx⟩

/-- A lower increment bound for the comparison CDF turns uniform CDF error
into deterministic transport error. No assumption concerning a selected
Bernoulli cardinality or a Poisson law is used. -/
theorem finiteQuantile_displacement {P : Finset ℝ} {a H : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1)
    {u z K e s v : ℝ} (hK : 0 < K) (he : 0 ≤ e)
    (hP : ∀ x ∈ P, x ∈ Set.Icc u z)
    (hinc : ∀ x ∈ Set.Icc u z, ∀ y ∈ Set.Icc u z, x ≤ y →
      (y - x) / K ≤ H y - H x)
    (hcdf : ∀ y ∈ Set.Icc u z, |finiteMarkCDF P a y - H y| ≤ e)
    (hs : s ∈ Set.Ioc (0 : ℝ) 1) (hv : v ∈ Set.Icc u z) (hHv : H v = s) :
    |finiteQuantile P a s - v| ≤ K * e := by
  obtain ⟨hxP, hsx⟩ := finiteQuantile_mem_cell ha hnorm hs
  let x := finiteQuantile P a s
  have hx : x ∈ Set.Icc u z := hP x hxP
  have hFx := hcdf x hx
  have hleft : finiteMarkLeftCDF P a x < s := hsx.1
  have hright : s ≤ finiteMarkCDF P a x := hsx.2
  apply abs_le.mpr
  constructor
  · by_cases hxv : x ≤ v
    · have hi := hinc x hx v hv hxv
      rw [hHv] at hi
      have hi' := (div_le_iff₀ hK).mp hi
      have hh := (abs_le.mp hFx).2
      nlinarith
    · have hxv' : v < x := lt_of_not_ge hxv
      change -(K * e) ≤ x - v
      nlinarith [mul_nonneg hK.le he]
  · by_contra hn
    have hlarge : K * e < x - v := lt_of_not_ge hn
    let y := (x + v + K * e) / 2
    have hvy : v ≤ y := by dsimp [y]; nlinarith [mul_nonneg hK.le he]
    have hyx : y < x := by dsimp [y]; linarith
    have hy : y ∈ Set.Icc u z := ⟨hv.1.trans hvy, hyx.le.trans hx.2⟩
    have hFy : finiteMarkCDF P a y < s := (finiteMarkCDF_le_left ha hyx).trans_lt hleft
    have hi := (div_le_iff₀ hK).mp (hinc v hv y hy hvy)
    rw [hHv] at hi
    have hh := (abs_le.mp (hcdf y hy)).1
    dsimp [y] at hi
    nlinarith

theorem finiteQuantile_preimage_inter {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) (B : Set ℝ)
    [DecidablePred (fun x ↦ x ∈ B)] :
    (finiteQuantile P a ⁻¹' B) ∩ Set.Ioc 0 1 =
      ⋃ x ∈ P.filter (fun x ↦ x ∈ B), finiteQuantileCell P a x := by
  classical
  ext s
  simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_iUnion]
  constructor
  · rintro ⟨hsB, hs⟩
    obtain ⟨hx, hsx⟩ := finiteQuantile_mem_cell ha hnorm hs
    exact ⟨finiteQuantile P a s, Finset.mem_filter.mpr ⟨hx, hsB⟩, hsx⟩
  · rintro ⟨x, hx, hsx⟩
    have hxP := (Finset.mem_filter.mp hx).1
    have heq := finiteQuantile_eq_of_mem ha hxP hsx
    refine ⟨?_, finiteQuantileCell_subset ha hnorm x hsx⟩
    rw [heq]
    exact (Finset.mem_filter.mp hx).2

theorem volume_finiteQuantile_preimage_inter {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) (B : Set ℝ)
    [DecidablePred (fun x ↦ x ∈ B)] :
    volume ((finiteQuantile P a ⁻¹' B) ∩ Set.Ioc 0 1) =
      ∑ x ∈ P.filter (fun x ↦ x ∈ B), ENNReal.ofReal (a x) := by
  classical
  rw [finiteQuantile_preimage_inter ha hnorm]
  have hd : ((P.filter (fun x ↦ x ∈ B)) : Set ℝ).PairwiseDisjoint (finiteQuantileCell P a) := by
    intro x hx y hy hxy
    exact finiteQuantileCells_disjoint ha (Finset.mem_filter.mp hx).1
      (Finset.mem_filter.mp hy).1 hxy
  rw [measure_biUnion_finset hd (fun _ _ ↦ measurableSet_Ioc)]
  apply sum_congr rfl
  intro x hx
  exact volume_finiteQuantileCell a (Finset.mem_filter.mp hx).1

noncomputable def finiteMarkLaw (P : Finset ℝ) (a : ℝ → ℝ) : Measure ℝ :=
  ∑ x ∈ P, ENNReal.ofReal (a x) • Measure.dirac x

/-- The finite quantile is an exact realization of the specified mark law
from one uniform coordinate. -/
theorem finiteQuantile_map_uniform {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) :
    Measure.map (finiteQuantile P a) (volume.restrict (Set.Ioc (0 : ℝ) 1)) = finiteMarkLaw P a := by
  classical
  ext B hB
  rw [Measure.map_apply (measurable_finiteQuantile P a) hB,
    Measure.restrict_apply ((measurable_finiteQuantile P a) hB),
    volume_finiteQuantile_preimage_inter ha hnorm]
  simp only [finiteMarkLaw, Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply, smul_eq_mul]
  rw [sum_filter]
  apply sum_congr rfl
  intro x _
  by_cases hx : x ∈ B
  · simp [hx]
  · simp [hx]

theorem finiteQuantile_uniform_isProbability :
    IsProbabilityMeasure (volume.restrict (Set.Ioc (0 : ℝ) 1)) := by
  constructor
  simp only [Measure.restrict_apply_univ, Real.volume_Ioc]
  norm_num

theorem finiteMarkLaw_isProbability {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1) :
    IsProbabilityMeasure (finiteMarkLaw P a) := by
  let : IsProbabilityMeasure (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
    finiteQuantile_uniform_isProbability
  rw [← finiteQuantile_map_uniform ha hnorm]
  exact Measure.isProbabilityMeasure_map (measurable_finiteQuantile P a).aemeasurable

noncomputable def logUniformQuantile (u w s : ℝ) : ℝ :=
  u * exp (s * log (1 + w / u))

theorem measurable_logUniformQuantile (u w : ℝ) : Measurable (logUniformQuantile u w) := by
  unfold logUniformQuantile
  fun_prop

theorem logUniformQuantile_mem {u w s : ℝ} (hw : 0 < w) (hwu : w ≤ u)
    (hs : s ∈ Set.Icc (0 : ℝ) 1) : logUniformQuantile u w s ∈ Set.Icc u (u + w) := by
  have hu : 0 < u := hw.trans_le hwu
  have hH := (logUniform_log_bounds hw hwu).1
  have harg : 0 < 1 + w / u := by positivity
  have hlo : 1 ≤ exp (s * log (1 + w / u)) := one_le_exp (mul_nonneg hs.1 hH.le)
  have hhi : exp (s * log (1 + w / u)) ≤ 1 + w / u := by
    calc
      _ ≤ exp (log (1 + w / u)) := exp_le_exp.mpr (by nlinarith [hs.2])
      _ = _ := exp_log harg
  unfold logUniformQuantile
  constructor
  · nlinarith
  · have hm := mul_le_mul_of_nonneg_left hhi hu.le
    have hid : u * (1 + w / u) = u + w := by field_simp
    linarith

theorem logUniformQuantile_inverse {u w s : ℝ} (hw : 0 < w) (hwu : w ≤ u) :
    log (logUniformQuantile u w s / u) / log (1 + w / u) = s := by
  have hu : 0 < u := hw.trans_le hwu
  have hH := (logUniform_log_bounds hw hwu).1
  have hid : logUniformQuantile u w s / u = exp (s * log (1 + w / u)) := by
    unfold logUniformQuantile
    field_simp
  rw [hid, log_exp]
  exact mul_div_cancel_right₀ s hH.ne'

theorem logUniformCDF_increment {u w x y : ℝ} (hw : 0 < w) (hwu : w ≤ u)
    (hx : x ∈ Set.Icc u (u + w)) (hy : y ∈ Set.Icc u (u + w)) (hxy : x ≤ y) :
    (y - x) / (2 * w) ≤ log (y / u) / log (1 + w / u) -
      log (x / u) / log (1 + w / u) := by
  have hu : 0 < u := hw.trans_le hwu
  have hx0 : 0 < x := hu.trans_le hx.1
  have hy0 : 0 < y := hu.trans_le hy.1
  obtain ⟨hH, _, hHhi⟩ := logUniform_log_bounds hw hwu
  have hden : y * log (1 + w / u) ≤ 2 * w := by
    have hh := (le_div_iff₀ hu).mp hHhi
    have hym : y * log (1 + w / u) ≤ 2 * u * log (1 + w / u) :=
      mul_le_mul_of_nonneg_right (by linarith [hy.2]) hH.le
    nlinarith
  have hlog : (y - x) / y ≤ log (y / x) := by
    have h := one_sub_inv_le_log_of_pos (div_pos hy0 hx0)
    have hid : 1 - (y / x)⁻¹ = (y - x) / y := by field_simp
    rwa [hid] at h
  calc
    _ ≤ (y - x) / (y * log (1 + w / u)) :=
      div_le_div_of_nonneg_left (sub_nonneg.mpr hxy) (mul_pos hy0 hH) hden
    _ = ((y - x) / y) / log (1 + w / u) := by ring
    _ ≤ log (y / x) / log (1 + w / u) := div_le_div_of_nonneg_right hlog hH.le
    _ = _ := by
      rw [log_div hy0.ne' hx0.ne', log_div hy0.ne' hu.ne', log_div hx0.ne' hu.ne']
      ring

/-- The log-uniform comparison specializes the deterministic error to
twice the window width times the CDF discrepancy. -/
theorem finiteQuantile_logUniform_displacement {P : Finset ℝ} {a : ℝ → ℝ}
    (ha : ∀ x ∈ P, 0 ≤ a x) (hnorm : ∑ x ∈ P, a x = 1)
