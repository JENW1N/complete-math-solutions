  intro N
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg N)
  apply sum_le_sum
  intro n _
  by_cases hn : n = 0
  · simp only [f, if_pos hn, Set.indicator_apply]
    split_ifs <;> norm_num
  · have hf : f n = F (P.filter (fun p ↦ p ∣ n)) := by simp [f, hn]
    rw [hf]
    by_cases hpos : 0 < F (P.filter (fun p ↦ p ∣ n))
    · have hrep := hsupport (P.filter (fun p ↦ p ∣ n))
        (mem_powerset.mpr (filter_subset _ _)) hpos
      have hdvd : (∏ p ∈ P.filter (fun p ↦ p ∣ n), p) ∣ n := by
        apply (primeProduct_dvd_iff (fun p hp ↦ hP p (mem_filter.mp hp).1) n).mpr
