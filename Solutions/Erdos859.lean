  have heq : P.powerset.filter (fun U ↦ Good (dyadicCountVector A k U) ∧ Bad U) =
      P.powerset.filter (fun U ↦ ¬ DyadicCountFailure A k v r0 D U ∧ Bad U) := by
    apply filter_congr
    intro U hU
    rw [hevent U hU]
  rwa [heq] at hbound

theorem dyadic_count_good_outcome_mass_lower {A lam v r0 q r : ℝ}
    (hA : 0 < A) {k D : ℕ} {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hlam : 0 < lam) (hq : 0 ≤ q)
    (Bad : Finset ℕ → Prop) [DecidablePred Bad]
    (hclass : (∑ T ∈ P.powerset with DyadicCountFailure A k v r0 D T,
      primeTiltWeight P lam T) ≤ r)
    (hcond : ∀ T ∈ P.powerset, ¬ DyadicCountFailure A k v r0 D T →
