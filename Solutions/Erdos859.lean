    Summable (fun n : ℕ ↦ if FordPowerful n then (n : ℝ) ^ (-3 / 4 : ℝ) else 0) := by
  classical
  have h := (summable_subtype_iff_indicator (s := {n : ℕ | FordPowerful n})
