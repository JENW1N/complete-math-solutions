  induction s using Finset.induction_on_max generalizing U with
  | empty =>
      simp only [sum_empty]
      exact add_nonneg (one_div_nonneg.mpr hL.le)
        (div_nonneg (log_nonneg ((one_le_div hL).mpr hLU)) hq.le)
  | @insert a s hmax ih =>
      have ha : a ∉ s := by
        intro has
        exact (lt_irrefl a) (hmax a has)
      have haL : L ≤ (a : ℝ) := (hbound a (mem_insert_self a s)).1
      have haU : (a : ℝ) ≤ U := (hbound a (mem_insert_self a s)).2
      have ha0 : 0 < (a : ℝ) := hL.trans_le haL
      rw [sum_insert ha]
      by_cases hs : s.Nonempty
      · let b := s.max' hs
        have hb : b ∈ s := max'_mem s hs
        have hbL : L ≤ (b : ℝ) := (hbound b (mem_insert_of_mem hb)).1
        have hb0 : 0 < (b : ℝ) := hL.trans_le hbL
        have hba : b < a := hmax b hb
        have hbound' : ∀ n ∈ s, L ≤ (n : ℝ) ∧ (n : ℝ) ≤ (b : ℝ) := by
          intro n hn
