  exact translation_hole_filling_success_probability hA hw hf.1 hf.2.1
    hf.2.2.2.1 hf.2.2.2.2.1 hf.2.2.1

theorem union_translate_subset_thickened {A : Set ℝ} {x y e : ℝ}
    (he : 0 ≤ e) (hxy : |y - x| ≤ e) :
    A ∪ realTranslateSet A x ⊆
      realSupportThickening A e ∪ realTranslateSet (realSupportThickening A e) y := by
  intro z hz
  rcases hz with hz | hz
  · exact Or.inl ⟨z, hz, by simpa only [sub_self, abs_zero] using he⟩
  · apply Or.inr
    refine ⟨z - x, hz, ?_⟩
    have hid : z - y - (z - x) = x - y := by ring
    rw [hid, abs_sub_comm]
    exact hxy

theorem remainingHoleMeasure_thickened_shift_le {A I : Set ℝ} {x y e : ℝ}
    (he : 0 ≤ e) (hxy : |y - x| ≤ e) (hI : volume I ≠ ∞) :
    remainingHoleMeasure (realSupportThickening A e) I y ≤ remainingHoleMeasure A I x := by
  apply measureReal_mono _ (measure_ne_top_of_subset Set.sdiff_subset hI)
  exact Set.sdiff_subset_sdiff_right (union_translate_subset_thickened he hxy)

theorem realSupportThickening_union_translate (A : Set ℝ) (y e : ℝ) :
    realSupportThickening (A ∪ realTranslateSet A y) e =
      realSupportThickening A e ∪ realTranslateSet (realSupportThickening A e) y := by
  ext z
  constructor
  · rintro ⟨a, ha | ha, hza⟩
    · exact Or.inl ⟨a, ha, hza⟩
    · apply Or.inr
      refine ⟨a - y, ha, ?_⟩
      have hid : z - y - (a - y) = z - a := by ring
      rwa [hid]
  · rintro (⟨a, ha, hza⟩ | ⟨a, ha, hza⟩)
    · exact ⟨a, Or.inl ha, hza⟩
    · refine ⟨a + y, Or.inr ?_, ?_⟩
      · simpa only [realTranslateSet, Set.mem_preimage, add_sub_cancel_right] using ha
      · have hid : z - (a + y) = z - y - a := by ring
        rwa [hid]

def PrimePairHoleFillingEvent (A I : Set ℝ) (e r : ℝ) (T : Finset ℕ) : Prop :=
  ∃ p ∈ T, ∃ q ∈ T,
    volume.real (I \ realSupportThickening
      (A ∪ realTranslateSet A (log (p : ℝ) - log (q : ℝ))) e) ≤ r

theorem primePairHoleFillingEvent_eq (A I : Set ℝ) (e r : ℝ) :
    PrimePairHoleFillingEvent A I e r =
      PrimeSubsetPairEvent {y | remainingHoleMeasure (realSupportThickening A e) I y ≤ r} := by
  funext T
  apply propext
  simp only [PrimePairHoleFillingEvent, PrimeSubsetPairEvent,
    realSupportThickening_union_translate, remainingHoleMeasure, Set.mem_ofPred_eq]

/-- The probability of a successful actual count-two selection has an explicit
positive lower bound whenever the duplicate loss is smaller than one half. -/
theorem primeTilt_two_prime_hole_filling {A : Set ℝ} (hA : IsCompact A)
    {a b lam u eps eta : ℝ} (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hu : log 2 ≤ u) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * primeLogOddsErrorConstant ≤ eps * u)
    (heta : 0 ≤ eta) (hmargin : eta ≤ (1 : ℝ) / 2 - 64 * exp (-u) / eps) :
    eta * exp (-5 * eps) * (eps / 4) ^ 2 / 2 ≤
      ∑ T ∈ (primeLogWindow u ((1 + eps) * u)).powerset.filter (fun T ↦
        T.card = 2 ∧ PrimePairHoleFillingEvent A (Set.Icc (a + eps * u) (b - eps * u))
          (32 * primeLogOddsErrorConstant) (4 * (volume.real (Set.Icc a b \ A)) ^ 2 / (eps * u)) T),
        primeTiltWeight (primeLogWindow u ((1 + eps) * u)) lam T := by
  classical
  let I := Set.Icc (a + eps * u) (b - eps * u)
  let R := 4 * (volume.real (Set.Icc a b \ A)) ^ 2 / (eps * u)
  let E : Set ℝ := {x | remainingHoleMeasure A I x ≤ R}
  let G : Set ℝ := {y | remainingHoleMeasure
    (realSupportThickening A (32 * primeLogOddsErrorConstant)) I y ≤ R}
  have hE : MeasurableSet E := measurableSet_le
    (measurable_remainingHoleMeasure hA.measurableSet measurableSet_Icc) measurable_const
  have hG : MeasurableSet G := measurableSet_le
    (measurable_remainingHoleMeasure (measurableSet_realSupportThickening hA _) measurableSet_Icc)
    measurable_const
  have he : 0 ≤ 32 * primeLogOddsErrorConstant :=
    mul_nonneg (by norm_num) primeLogOddsErrorConstant_pos.le
  have hrobust : ∀ x ∈ E, ∀ y, |y - x| ≤ 32 * primeLogOddsErrorConstant → y ∈ G := by
    intro x hx y hxy
    exact (remainingHoleMeasure_thickened_shift_le he hxy isCompact_Icc.measure_ne_top).trans hx
  have hu0 : 0 < u := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hu
  have hrho : (1 : ℝ) / 2 ≤
      (translationShiftLaw (logUniformPairDensity u (eps * u)) E).toReal :=
    logUniformPair_hole_success_probability hA.measurableSet (mul_pos heps hu0)
      (mul_le_of_le_one_left hu0.le heps1)
