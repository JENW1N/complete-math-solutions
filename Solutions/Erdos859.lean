      symm
      apply sum_subset (subset_univ _)
      intro j _ hj
      have hj' : ¬ ∃ i, f i = j := by simpa only [mem_image, mem_univ, true_and] using hj
      rw [Function.extend_apply' _ _ _ hj', zero_mul]
    _ = ∑ i, Function.extend f c (fun _ ↦ 0) (f i) * (w (f i) : ℤ) :=
      sum_image (fun i _ j _ hij ↦ hf hij)
    _ = _ := by simp only [hf.extend_apply]

