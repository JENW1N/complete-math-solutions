    (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2) (j : ℕ) :
    (1 - virtualPrimeRelativeError B) * virtualCoreBin A B j ≤
      primeNormalizedLogOddsWindowMass lam (A + B * 2 ^ j) (A + B * 2 ^ (j + 1)) := by
  have hp : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
  have hu : log 2 ≤ A + B * 2 ^ j := by nlinarith
  have huv : A + B * 2 ^ j ≤ A + B * 2 ^ (j + 1) := by rw [pow_succ]; nlinarith
  have he := (abs_le.mp (primeNormalizedLogOddsWindowMass_estimate hlam hlam2 hu huv)).1
  have hc := virtualCoreBin_absorb_error hA hB primeLogOddsErrorConstant_pos.le j
  change -(2 * primeLogOddsErrorConstant / (A + B * 2 ^ j)) ≤
    primeNormalizedLogOddsWindowMass lam (A + B * 2 ^ j) (A + B * 2 ^ (j + 1)) -
      virtualCoreBin A B j at he
  unfold virtualPrimeRelativeError
  nlinarith

