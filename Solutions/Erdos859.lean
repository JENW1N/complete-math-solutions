section

/- Exact count moments and finite Chernoff bounds for the tilted prime law. -/

open Finset Real

namespace Erdos859Verification

/-- The effective selection probability of a prime under the count tilt. -/
noncomputable def primeTiltSelectionProbability (lam : ℝ) (p : ℕ) : ℝ :=
  lam / ((p : ℝ) + lam - 1)

theorem primeTiltSelectionProbability_pos_lt_one {p : ℕ} (hp : p.Prime)
    {lam : ℝ} (hlam : 0 < lam) :
    0 < primeTiltSelectionProbability lam p ∧ primeTiltSelectionProbability lam p < 1 := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hd : 0 < (p : ℝ) + lam - 1 := by linarith
  exact ⟨div_pos hlam hd, (div_lt_one hd).mpr (by linarith)⟩

theorem primeTiltWeight_pos {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    {lam : ℝ} (hlam : 0 < lam) (T : Finset ℕ) :
    0 < primeTiltWeight P lam T :=
  div_pos (mul_pos (primePatternWeight_pos hP T) (pow_pos hlam _))
    (primeTiltNormalizer_pos hP hlam)

/-- Tilting twice multiplies the tilt parameters.  This algebraic identity
holds even before positivity assumptions are imposed. -/
theorem primeTiltWeight_count_moment (P : Finset ℕ) (lam z : ℝ) :
    ∑ T ∈ P.powerset, primeTiltWeight P lam T * z ^ T.card =
      primeTiltNormalizer P (lam * z) / primeTiltNormalizer P lam := by
  simp only [primeTiltWeight, div_mul_eq_mul_div, ← sum_div]
  congr 1
  rw [← primePatternWeight_moment]
  apply sum_congr rfl
  intro T _
  rw [mul_pow]
  ring

theorem primeTiltNormalizer_ratio_eq_prod {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) (z : ℝ) :
    primeTiltNormalizer P (lam * z) / primeTiltNormalizer P lam =
      ∏ p ∈ P, (1 + (z - 1) * primeTiltSelectionProbability lam p) := by
  unfold primeTiltNormalizer
  rw [← prod_div_distrib]
  apply prod_congr rfl
  intro p hp
  have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast (hP p hp).ne_zero
  have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
  have hd : (p : ℝ) + lam - 1 ≠ 0 := by linarith
  have hden : 1 + (lam - 1) / (p : ℝ) = ((p : ℝ) + lam - 1) / p := by
    field_simp
    ring
  rw [hden]
  unfold primeTiltSelectionProbability
  field_simp [hp0, hd]
  ring

theorem primeTilt_count_factor_pos {p : ℕ} (hp : p.Prime)
    {lam z : ℝ} (hlam : 0 < lam) (hz : 0 < z) :
    0 < 1 + (z - 1) * primeTiltSelectionProbability lam p := by
  obtain ⟨hq0, hq1⟩ := primeTiltSelectionProbability_pos_lt_one hp hlam
  have hproduct := mul_pos hz hq0
  nlinarith

/-- The logarithmic Bernoulli moment bound also applies to `0 < z < 1`,
which is the range needed for lower count tails. -/
theorem log_primeTilt_count_factor_le {p : ℕ} (hp : p.Prime)
    {lam z : ℝ} (hlam : 0 < lam) (hz : 0 < z) :
    log (1 + (z - 1) * primeTiltSelectionProbability lam p) ≤
      (z - 1) * primeTiltSelectionProbability lam p := by
  simpa using log_le_sub_one_of_pos (primeTilt_count_factor_pos hp hlam hz)

/-- The finite tilted count moment is bounded by the Poisson-shaped
exponential with its exact Bernoulli mean; no Poisson approximation is used. -/
theorem primeTiltWeight_count_moment_le_exp {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam z : ℝ} (hlam : 0 < lam) (hz : 0 < z) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * z ^ T.card) ≤
      exp ((z - 1) * ∑ p ∈ P, primeTiltSelectionProbability lam p) := by
  rw [primeTiltWeight_count_moment, primeTiltNormalizer_ratio_eq_prod hP hlam,
    mul_sum, exp_sum]
  apply Finset.prod_le_prod
  · intro p hp
    exact (primeTilt_count_factor_pos (hP p hp) hlam hz).le
  · intro p hp
    exact (log_le_iff_le_exp (primeTilt_count_factor_pos (hP p hp) hlam hz)).mp
      (log_primeTilt_count_factor_le (hP p hp) hlam hz)

theorem primeTiltWeight_exp_count_moment_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam) (s : ℝ) :
    (∑ T ∈ P.powerset, primeTiltWeight P lam T * exp (s * T.card)) ≤
      exp ((exp s - 1) * ∑ p ∈ P, primeTiltSelectionProbability lam p) := by
  simpa only [mul_comm s, exp_nat_mul] using
    primeTiltWeight_count_moment_le_exp hP hlam (exp_pos s)

/-- A finite exponential Markov bound for any count event whose exponent
is above the supplied threshold. -/
theorem primeTiltWeight_count_event_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (F : Finset ℕ → Prop) [DecidablePred F] (s a : ℝ)
    (hF : ∀ T ∈ P.powerset, F T → s * a ≤ s * (T.card : ℝ)) :
    (∑ T ∈ P.powerset.filter F, primeTiltWeight P lam T) ≤
      exp ((exp s - 1) * (∑ p ∈ P, primeTiltSelectionProbability lam p) - s * a) := by
  have hmarkov :
      (∑ T ∈ P.powerset.filter F, primeTiltWeight P lam T) * exp (s * a) ≤
        ∑ T ∈ P.powerset, primeTiltWeight P lam T * exp (s * T.card) := by
    rw [sum_mul]
    calc
      _ ≤ ∑ T ∈ P.powerset.filter F,
          primeTiltWeight P lam T * exp (s * T.card) := by
        apply sum_le_sum
        intro T hT
        exact mul_le_mul_of_nonneg_left
          (exp_le_exp.mpr (hF T (mem_filter.mp hT).1 (mem_filter.mp hT).2))
          (primeTiltWeight_pos hP hlam T).le
      _ ≤ _ := sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
        (fun T _ _ ↦ mul_nonneg (primeTiltWeight_pos hP hlam T).le (exp_pos _).le)
  calc
    _ ≤ exp ((exp s - 1) * (∑ p ∈ P, primeTiltSelectionProbability lam p)) /
        exp (s * a) :=
      (le_div_iff₀ (exp_pos _)).mpr
        (hmarkov.trans (primeTiltWeight_exp_count_moment_le hP hlam s))
    _ = _ := (exp_sub _ _).symm

/-- Chernoff's upper tail estimate, with an arbitrary nonnegative exponent. -/
theorem primeTiltWeight_count_upper_tail {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (a s : ℝ) (hs : 0 ≤ s) :
    (∑ T ∈ P.powerset.filter (fun T ↦ a ≤ (T.card : ℝ)), primeTiltWeight P lam T) ≤
      exp ((exp s - 1) * (∑ p ∈ P, primeTiltSelectionProbability lam p) - s * a) := by
  apply primeTiltWeight_count_event_le hP hlam
  intro T _ hT
  exact mul_le_mul_of_nonneg_left hT hs

/-- Chernoff's lower tail estimate, including the negative-exponent range
used to control missing points in terminal prime bands. -/
theorem primeTiltWeight_count_lower_tail {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 0 < lam)
    (a s : ℝ) (hs : s ≤ 0) :
    (∑ T ∈ P.powerset.filter (fun T ↦ (T.card : ℝ) ≤ a), primeTiltWeight P lam T) ≤
      exp ((exp s - 1) * (∑ p ∈ P, primeTiltSelectionProbability lam p) - s * a) := by
  apply primeTiltWeight_count_event_le hP hlam
  intro T _ hT
  exact mul_le_mul_of_nonpos_left hT hs

end Erdos859Verification

