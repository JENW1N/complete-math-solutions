    n.val = fordPowerfulSquare n.val ^ 2 * fordPowerfulCube n.val ^ 3 :=
      fordPowerful_representation n.property
    _ = fordPowerfulSquare m.val ^ 2 * fordPowerfulCube m.val ^ 3 := by rw [h1, h2]
    _ = m.val := (fordPowerful_representation m.property).symm

