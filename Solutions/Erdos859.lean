      apply sum_le_sum
      intro p hp
      exact primeLogMark_broad_atom_upper hv heps heps1 hlarge (mem_filter.mp hp).1
    _ = (4 * exp (-v) / eps) *
        (((primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ p ∣ m)).card : ℝ) := by
      simp [mul_comm]
    _ ≤ _ := mul_le_mul_of_nonneg_left hcard (by positivity)

theorem finite_nat_weighted_union_bound (S I : Finset ℕ) (w : ℕ → ℝ)
    (hw : ∀ p ∈ S, 0 ≤ w p) (F : ℕ → ℕ → Prop) [DecidableRel F] :
    (∑ p ∈ S.filter (fun p ↦ ∃ d ∈ I, F d p), w p) ≤
      ∑ d ∈ I, ∑ p ∈ S.filter (F d), w p := by
  simp only [sum_filter]
  rw [sum_comm]
  apply sum_le_sum
  intro p hp
  have hnonneg (d : ℕ) : 0 ≤ if F d p then w p else 0 := by
    split_ifs
    · exact hw p hp
    · exact le_rfl
  split_ifs with h
  · obtain ⟨d, hd, hF⟩ := h
    calc
      w p = if F d p then w p else 0 := by rw [if_pos hF]
      _ ≤ ∑ d ∈ I, if F d p then w p else 0 :=
        single_le_sum (fun d _ ↦ hnonneg d) hd
  · exact sum_nonneg (fun d _ ↦ hnonneg d)

theorem primeLogMark_broad_dvd_any_upper (D : Finset ℕ) {v eps : ℝ}
    (hv : log 2 ≤ v) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * mertensErrorConstant ≤ eps * v) (hD : ∀ d ∈ D, 0 < d) :
    (∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ ∃ d ∈ D, p ∣ d),
      primeLogMarkWeight v ((1 + eps) * v) p) ≤
        (4 * exp (-v) / eps / v) * ∑ d ∈ D, log (d : ℝ) := by
  classical
  have hmass := primeLogWindowMass_broad_lower hv heps heps1 hlarge
  have hmasspos : 0 < primeLogWindowMass v ((1 + eps) * v) :=
    (by positivity : 0 < eps / 4).trans_le hmass
  calc
    _ ≤ ∑ d ∈ D,
        ∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ p ∣ d),
          primeLogMarkWeight v ((1 + eps) * v) p :=
      finite_nat_weighted_union_bound _ D _
        (fun _ _ ↦ by unfold primeLogMarkWeight; positivity) _
    _ ≤ ∑ d ∈ D, (4 * exp (-v) / eps) * (log (d : ℝ) / v) := by
      apply sum_le_sum
      intro d hd
      exact primeLogMark_broad_dvd_upper hv heps heps1 hlarge (hD d hd)
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro d _; ring

theorem primeLogMark_broad_dvd_any_card_upper (D : Finset ℕ) {v eps : ℝ} {T : ℕ}
    (hv : log 2 ≤ v) (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hlarge : 8 * mertensErrorConstant ≤ eps * v)
    (hD : ∀ d ∈ D, 0 < d ∧ d ≤ T) :
    (∑ p ∈ (primeLogWindow v ((1 + eps) * v)).filter (fun p ↦ ∃ d ∈ D, p ∣ d),
      primeLogMarkWeight v ((1 + eps) * v) p) ≤
        (4 * exp (-v) / eps / v) * (D.card : ℝ) * log (T : ℝ) := by
  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  calc
    _ ≤ (4 * exp (-v) / eps / v) * ∑ d ∈ D, log (d : ℝ) :=
      primeLogMark_broad_dvd_any_upper D hv heps heps1 hlarge (fun d hd ↦ (hD d hd).1)
    _ ≤ (4 * exp (-v) / eps / v) * ∑ _d ∈ D, log (T : ℝ) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro d hd
      exact log_le_log (by exact_mod_cast (hD d hd).1) (by exact_mod_cast (hD d hd).2)
    _ = _ := by simp [mul_assoc]

end Erdos859Verification

