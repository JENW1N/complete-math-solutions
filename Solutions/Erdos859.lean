      mul_le_mul_of_nonneg_left hmu (exp_pos _).le
    _ ≤ _ := primeTiltSingleInMass_intensity_lower
      (fun _ hp ↦ (mem_primeLogWindow.mp hp).1) (coreSuffixPrimeBand_subset hB heta2 j) (by linarith)

