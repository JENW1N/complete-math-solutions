  have hrhalf : r ≤ 1 / 2 := (min_le_left _ _).trans hdhalf
  have hsep' : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 2 * r ≤ dist (x i) (x j) := by
    intro i hi j hj hij
