          1 / (a : ℝ) ≤ 1 / L := one_div_le_one_div_of_le hL haL
          _ ≤ 1 / L + log (U / L) / q :=
            le_add_of_nonneg_right
              (div_nonneg (log_nonneg ((one_le_div hL).mpr hLU)) hq.le)

