theorem tendsto_rpow_affine_log_div_nat {r : ℝ} (hr : r < 1) (a b : ℝ) :
    Tendsto (fun k : ℕ ↦ (k : ℝ) ^ r * (a + b * log k) / k) atTop (𝓝 0) := by
  have hpos : 0 < 1 - r := by linarith
  have hp : Tendsto (fun k : ℕ ↦ (k : ℝ) ^ r / k) atTop (𝓝 0) := by
    have h := (tendsto_rpow_neg_atTop hpos).comp (tendsto_natCast_atTop_atTop (R := ℝ))
    apply h.congr'
    filter_upwards [eventually_gt_atTop 0] with k hk
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    simp only [Function.comp_def]
    rw [neg_sub, rpow_sub hkR, rpow_one]
  have hl : Tendsto (fun k : ℕ ↦ (k : ℝ) ^ r * log k / k) atTop (𝓝 0) := by
    have h := (isLittleO_log_rpow_atTop hpos).tendsto_div_nhds_zero.comp
      (tendsto_natCast_atTop_atTop (R := ℝ))
    apply h.congr'
    filter_upwards [eventually_gt_atTop 0] with k hk
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    simp only [Function.comp_def]
    rw [rpow_sub hkR, rpow_one]
    field_simp
  convert (hp.const_mul a).add (hl.const_mul b) using 1
  · ext k
    ring
  · ring

