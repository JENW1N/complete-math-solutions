    (x : α → AddCircle (1 : ℝ)) {delta d : ℝ}
    (hdelta : 0 < delta) (hd : 0 < d) (hdhalf : d ≤ 1 / 2)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → delta ≤ dist (x i) (x j))
    (F : Set (AddCircle (1 : ℝ))) (hF : ∀ i ∈ S, x i ∈ F) :
    (S.card : ℝ) ≤ (1 / d + 1 / delta) *
      AddCircle.haarAddCircle.real (circleClosedNeighborhood F d) := by
  let r := min d (delta / 2)
