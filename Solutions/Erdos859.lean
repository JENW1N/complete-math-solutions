/- Inlined development module: FiniteBernoulliDomination.lean -/

section

/- Coordinatewise stochastic domination for exact finite subset laws. -/

namespace Erdos859Verification

open Finset
open scoped Classical

noncomputable def finiteBernoulliSubsetWeight (P : Finset ℕ) (r : ℕ → ℝ)
    (T : Finset ℕ) : ℝ := ∏ p ∈ P, if p ∈ T then r p else 1-r p

noncomputable def bernoulliSubsetMean (P : Finset ℕ) (r : ℕ → ℝ)
    (f : Finset ℕ → ℝ) : ℝ := ∑ T ∈ P.powerset, finiteBernoulliSubsetWeight P r T * f T

theorem finiteBernoulliSubsetWeight_nonneg {P : Finset ℕ} {r : ℕ → ℝ}
    (hr : ∀ p ∈ P, 0 ≤ r p ∧ r p ≤ 1) (T : Finset ℕ) :
    0 ≤ finiteBernoulliSubsetWeight P r T := by
  apply prod_nonneg
  intro p hp
  split_ifs
  · exact (hr p hp).1
  · exact sub_nonneg.mpr (hr p hp).2

theorem bernoulliSubsetMean_mono_observable {P : Finset ℕ} {r : ℕ → ℝ}
    (hr : ∀ p ∈ P, 0 ≤ r p ∧ r p ≤ 1) {f g : Finset ℕ → ℝ}
    (hfg : ∀ T ⊆ P, f T ≤ g T) : bernoulliSubsetMean P r f ≤ bernoulliSubsetMean P r g :=
  sum_le_sum (fun T hT ↦ mul_le_mul_of_nonneg_left (hfg T (mem_powerset.mp hT))
    (finiteBernoulliSubsetWeight_nonneg hr T))

theorem finiteBernoulliSubsetWeight_insert {P S : Finset ℕ} {p : ℕ}
    (hp : p ∉ P) (hS : S ⊆ P) (r : ℕ → ℝ) :
    finiteBernoulliSubsetWeight (insert p P) r S =
      (1-r p)*finiteBernoulliSubsetWeight P r S ∧
    finiteBernoulliSubsetWeight (insert p P) r (insert p S) =
      r p*finiteBernoulliSubsetWeight P r S := by
  have hpS : p ∉ S := fun h ↦ hp (hS h)
  constructor
  · simp only [finiteBernoulliSubsetWeight, prod_insert hp, if_neg hpS]
  · unfold finiteBernoulliSubsetWeight
    rw [prod_insert hp]
    simp only [mem_insert_self, if_true]
    congr 1
    apply prod_congr rfl
    intro q hq
    have hqp : q ≠ p := fun he ↦ hp (he ▸ hq)
    simp only [mem_insert, hqp, false_or]

theorem bernoulliSubsetMean_insert {P : Finset ℕ} {p : ℕ} (hp : p ∉ P)
    (r : ℕ → ℝ) (f : Finset ℕ → ℝ) :
    bernoulliSubsetMean (insert p P) r f =
      (1-r p)*bernoulliSubsetMean P r f +
        r p*bernoulliSubsetMean P r (fun T ↦ f (insert p T)) := by
  unfold bernoulliSubsetMean
  rw [sum_powerset_insert hp, mul_sum, mul_sum]
  congr 1
  · apply sum_congr rfl
    intro T hT
    rw [(finiteBernoulliSubsetWeight_insert hp (mem_powerset.mp hT) r).1]
    ring
  · apply sum_congr rfl
    intro T hT
    rw [(finiteBernoulliSubsetWeight_insert hp (mem_powerset.mp hT) r).2]
    ring

theorem sum_finiteBernoulliSubsetWeight (P : Finset ℕ) (r : ℕ → ℝ) :
    ∑ T ∈ P.powerset, finiteBernoulliSubsetWeight P r T = 1 := by
  suffices bernoulliSubsetMean P r (fun _ ↦ 1) = 1 by simpa [bernoulliSubsetMean] using this
  induction P using Finset.induction_on with
  | empty => simp [bernoulliSubsetMean, finiteBernoulliSubsetWeight]
  | @insert p P hp ih => rw [bernoulliSubsetMean_insert hp, ih]; ring

/-- Raising independent selection probabilities increases every monotone
observable. The proof eliminates one actual finite coordinate at a time. -/
theorem bernoulliSubsetMean_mono_parameters (P : Finset ℕ) (r s : ℕ → ℝ)
    (hr : ∀ p ∈ P, 0 ≤ r p) (hrs : ∀ p ∈ P, r p ≤ s p)
    (hs : ∀ p ∈ P, s p ≤ 1) (f : Finset ℕ → ℝ) (hf : Monotone f) :
    bernoulliSubsetMean P r f ≤ bernoulliSubsetMean P s f := by
  induction P using Finset.induction_on generalizing f with
  | empty => simp [bernoulliSubsetMean, finiteBernoulliSubsetWeight]
  | @insert p P hp ih =>
    have hrP : ∀ q ∈ P, 0 ≤ r q := fun q hq ↦ hr q (mem_insert_of_mem hq)
    have hrsP : ∀ q ∈ P, r q ≤ s q := fun q hq ↦ hrs q (mem_insert_of_mem hq)
    have hsP : ∀ q ∈ P, s q ≤ 1 := fun q hq ↦ hs q (mem_insert_of_mem hq)
    have hrp := hr p (mem_insert_self p P)
    have hrsp := hrs p (mem_insert_self p P)
    have hsp := hs p (mem_insert_self p P)
    have h0 := ih hrP hrsP hsP f hf
    have h1 := ih hrP hrsP hsP (fun T ↦ f (insert p T))
      (fun A B hAB ↦ hf (insert_subset_insert p hAB))
    have hstep : bernoulliSubsetMean P s f ≤ bernoulliSubsetMean P s (fun T ↦ f (insert p T)) :=
      bernoulliSubsetMean_mono_observable
        (fun q hq ↦ ⟨(hrP q hq).trans (hrsP q hq), hsP q hq⟩)
        (fun T _ ↦ hf (subset_insert p T))
    rw [bernoulliSubsetMean_insert hp, bernoulliSubsetMean_insert hp]
    calc
      _ ≤ (1-r p)*bernoulliSubsetMean P s f +
          r p*bernoulliSubsetMean P s (fun T ↦ f (insert p T)) :=
        add_le_add (mul_le_mul_of_nonneg_left h0 (by linarith))
          (mul_le_mul_of_nonneg_left h1 hrp)
      _ ≤ _ := by nlinarith [mul_nonneg (sub_nonneg.mpr hrsp) (sub_nonneg.mpr hstep)]

theorem prime_softened_expectation_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (f : Finset ℕ → ℝ) (hf : Monotone f) :
    bernoulliSubsetMean P (fun p ↦ 1/((p:ℝ)+1)) f ≤
      ∑ T ∈ P.powerset, primePatternWeight P T * f T := by
  exact bernoulliSubsetMean_mono_parameters P (fun p ↦ 1/((p:ℝ)+1)) (fun p ↦ 1/(p:ℝ))
    (fun p _ ↦ by positivity)
    (fun p hp ↦ one_div_le_one_div_of_le (by exact_mod_cast (hP p hp).pos) (by linarith))
    (fun p hp ↦ (div_le_one (by exact_mod_cast (hP p hp).pos)).mpr
      (by exact_mod_cast (hP p hp).one_le)) f hf

theorem prime_softened_expectation_le_ambient {P Q : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hQ : Q ⊆ P) (f : Finset ℕ → ℝ) (hf : Monotone f) :
    bernoulliSubsetMean Q (fun p ↦ 1/((p:ℝ)+1)) f ≤
      ∑ T ∈ P.powerset, primePatternWeight P T * f T :=
  (prime_softened_expectation_le (fun p hp ↦ hP p (hQ hp)) f hf).trans
    (prime_expectation_mono_universe hP hQ f hf)


end Erdos859Verification

