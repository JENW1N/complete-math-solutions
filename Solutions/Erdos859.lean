/- Inlined development module: PracticalChain.lean -/

section

/- A deterministic practical seed from separated geometric prime windows. -/

open Finset Real

namespace Erdos859Verification

def practicalChainProduct (p : ℕ → ℕ) (j : ℕ) : ℕ :=
  210 * ∏ i ∈ range j, p i

theorem practicalChainProduct_succ (p : ℕ → ℕ) (j : ℕ) :
    practicalChainProduct p (j + 1) = practicalChainProduct p j * p j := by
  simp only [practicalChainProduct, prod_range_succ, mul_assoc]

theorem four_le_log_210 : (4 : ℝ) ≤ log 210 := by
  apply (le_log_iff_exp_le (by norm_num : (0 : ℝ) < 210)).mpr
  have he : exp (4 : ℝ) = exp 1 ^ (4 : ℕ) := by
    simp only [← exp_nat_mul, Nat.cast_ofNat, mul_one]
  rw [he]
  calc
    _ ≤ (3 : ℝ) ^ (4 : ℕ) := pow_le_pow_left₀ (exp_pos _).le exp_one_lt_three.le 4
    _ ≤ 210 := by norm_num

theorem log_seven_lt_three : log (7 : ℝ) < 3 := by
  apply (log_lt_iff_lt_exp (by norm_num : (0 : ℝ) < 7)).mpr
  have he : exp (3 : ℝ) = exp 1 ^ (3 : ℕ) := by
    simp only [← exp_nat_mul, Nat.cast_ofNat, mul_one]
  rw [he]
  calc
    (7 : ℝ) < 2 ^ (3 : ℕ) := by norm_num
    _ ≤ _ := pow_le_pow_left₀ (by norm_num) exp_one_gt_two.le 3

theorem coprime_210_of_prime_gt_seven {p : ℕ} (hp : p.Prime) (h7 : 7 < p) :
    Nat.Coprime 210 p := by
  have h2 : Nat.Coprime 2 p :=
    (Nat.coprime_primes (by norm_num) hp).mpr (by omega)
  have h3 : Nat.Coprime 3 p :=
    (Nat.coprime_primes (by norm_num) hp).mpr (by omega)
  have h5 : Nat.Coprime 5 p :=
    (Nat.coprime_primes (by norm_num) hp).mpr (by omega)
  have h7' : Nat.Coprime 7 p :=
    (Nat.coprime_primes (by norm_num) hp).mpr (by omega)
  exact (h2.mul_left h3).mul_left h5 |>.mul_left h7'

theorem prime_window_strictMono {p : ℕ → ℕ} {N : ℕ}
    (hprime : ∀ j < N, (p j).Prime)
    (hlo : ∀ j < N, 3 * ((3 : ℝ) / 2) ^ j ≤ log (p j))
    (hhi : ∀ j < N, log (p j) ≤ 4 * ((3 : ℝ) / 2) ^ j)
    {i j : ℕ} (hij : i < j) (hj : j < N) : p i < p j := by
  have hipos : (0 : ℝ) < p i := by exact_mod_cast (hprime i (hij.trans hj)).pos
  have hjpos : (0 : ℝ) < p j := by exact_mod_cast (hprime j hj).pos
  apply Nat.cast_lt.mp ((log_lt_log_iff hipos hjpos).mp ?_)
  have hpow : ((3 : ℝ) / 2) ^ (i + 1) ≤ ((3 : ℝ) / 2) ^ j :=
    pow_le_pow_right₀ (by norm_num) (Nat.succ_le_of_lt hij)
  rw [pow_succ] at hpow
  have hpos : 0 < ((3 : ℝ) / 2) ^ i := by positivity
  have hupper := hhi i (hij.trans hj)
  have hlower := hlo j hj
  nlinarith

/-- Every selection of one prime per window produces a practical product.
The size invariant also ensures that each new prime is at most the current
product, which will control the overshoot at the stopping threshold. -/
theorem practicalChain_of_log_windows {p : ℕ → ℕ} {N : ℕ}
    (hprime : ∀ j < N, (p j).Prime)
    (hlo : ∀ j < N, 3 * ((3 : ℝ) / 2) ^ j ≤ log (p j))
    (hhi : ∀ j < N, log (p j) ≤ 4 * ((3 : ℝ) / 2) ^ j) :
    ∀ j ≤ N, Nat.IsPractical (practicalChainProduct p j) ∧
      0 < practicalChainProduct p j ∧
      4 * ((3 : ℝ) / 2) ^ j ≤ log (practicalChainProduct p j) := by
  intro j
  induction j with
  | zero =>
    intro _
    simpa [practicalChainProduct] using
      (show Nat.IsPractical 210 ∧ 0 < (210 : ℕ) ∧ (4 : ℝ) ≤ log 210 from
        ⟨practical_210, by norm_num, four_le_log_210⟩)
  | succ j ih =>
    intro hj
    have hjN : j < N := by omega
    obtain ⟨hpractical, hprodpos, hsize⟩ := ih (by omega)
    have hnew : p j ≤ practicalChainProduct p j := by
      apply Nat.cast_le.mp ((log_le_log_iff
        (by exact_mod_cast (hprime j hjN).pos)
        (by exact_mod_cast hprodpos)).mp ?_)
      exact (hhi j hjN).trans hsize
    have h7 : 7 < p j := by
      have hpow : (1 : ℝ) ≤ ((3 : ℝ) / 2) ^ j := one_le_pow₀ (by norm_num)
      have hlog : log (7 : ℝ) < log (p j) := by
        have := hlo j hjN
        linarith [log_seven_lt_three]
      exact Nat.cast_lt.mp ((log_lt_log_iff (by norm_num)
        (by exact_mod_cast (hprime j hjN).pos)).mp hlog)
    have hcop : Nat.Coprime (practicalChainProduct p j) (p j) := by
      apply Nat.Coprime.mul_left (coprime_210_of_prime_gt_seven (hprime j hjN) h7)
      apply Nat.Coprime.prod_left
      intro i hi
      exact (Nat.coprime_primes (hprime i ((mem_range.mp hi).trans hjN))
        (hprime j hjN)).mpr (prime_window_strictMono hprime hlo hhi (mem_range.mp hi) hjN).ne
    rw [practicalChainProduct_succ]
    refine ⟨practical_mul_prime hpractical (hprime j hjN) hcop (by omega),
      Nat.mul_pos hprodpos (hprime j hjN).pos, ?_⟩
    rw [Nat.cast_mul, log_mul (by exact_mod_cast hprodpos.ne')
      (by exact_mod_cast (hprime j hjN).ne_zero), pow_succ]
    have := hlo j hjN
    have hnonneg : 0 ≤ ((3 : ℝ) / 2) ^ j := by positivity
    nlinarith

theorem exists_threshold_crossing {f : ℕ → ℕ} {Z N : ℕ}
    (hzero : f 0 < Z) (hlarge : Z ≤ f N) :
    ∃ j < N, f j < Z ∧ Z ≤ f (j + 1) := by
  induction N with
  | zero => omega
  | succ N ih =>
    by_cases hN : Z ≤ f N
    · obtain ⟨j, hj, hsmall, hbig⟩ := ih hN
      exact ⟨j, by omega, hsmall, hbig⟩
    · exact ⟨N, by omega, by omega, hlarge⟩

/-- Stopping at the first crossing gives a practical seed in `[Z,Z²)`,
using only primes less than `Z` before that crossing. -/
theorem exists_practicalSeed_from_windows {p : ℕ → ℕ} {N Z : ℕ}
    (hprime : ∀ j < N, (p j).Prime)
    (hlo : ∀ j < N, 3 * ((3 : ℝ) / 2) ^ j ≤ log (p j))
    (hhi : ∀ j < N, log (p j) ≤ 4 * ((3 : ℝ) / 2) ^ j)
    (hZ : 210 < Z) (hlarge : log (Z : ℝ) ≤ 4 * ((3 : ℝ) / 2) ^ N) :
    ∃ j < N, Nat.IsPractical (practicalChainProduct p (j + 1)) ∧
      Z ≤ practicalChainProduct p (j + 1) ∧
      practicalChainProduct p (j + 1) < Z ^ 2 ∧ p j < Z := by
  have hchain := practicalChain_of_log_windows hprime hlo hhi
  obtain ⟨_, hNpos, hNsize⟩ := hchain N le_rfl
  have hlast : Z ≤ practicalChainProduct p N := by
    apply Nat.cast_le.mp ((log_le_log_iff (by exact_mod_cast (by omega : 0 < Z))
      (by exact_mod_cast hNpos)).mp (hlarge.trans hNsize))
  obtain ⟨j, hj, hsmall, hbig⟩ := exists_threshold_crossing
    (show practicalChainProduct p 0 < Z by simpa [practicalChainProduct] using hZ) hlast
  obtain ⟨_, hjpos, hjsize⟩ := hchain j hj.le
  have hnew : p j ≤ practicalChainProduct p j := by
    apply Nat.cast_le.mp ((log_le_log_iff (by exact_mod_cast (hprime j hj).pos)
      (by exact_mod_cast hjpos)).mp ((hhi j hj).trans hjsize))
  refine ⟨j, hj, (hchain (j + 1) (by omega)).1, hbig, ?_, lt_of_le_of_lt hnew hsmall⟩
  rw [practicalChainProduct_succ]
  have hprod := Nat.mul_le_mul_left (practicalChainProduct p j) hnew
  nlinarith

end Erdos859Verification

end

