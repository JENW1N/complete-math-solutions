/- Inlined development module: CoreBlockEvent.lean -/

section

/- One complete prefix-ballot and early-suffix block in the actual prime law. -/

namespace Erdos859Verification

open Finset Real

noncomputable def coreBlockBand (A B : ℝ) (n K : ℕ) : Option (Fin K) → Finset ℕ
  | none => virtualPrimeUniverse A B n
  | some j => virtualPrimeBand A B (n + j.val)

def CoreBlockEvent (A B eta : ℝ) (n K : ℕ) (T : Finset ℕ) : Prop :=
  (T ∩ virtualPrimeUniverse A B n).card = n ∧
    primeSubsetBallot (virtualPrimeUniverse A B n) (virtualPrimeBinIndex A B n)
      (T ∩ virtualPrimeUniverse A B n) ∧
    ∀ j : Fin K, (T ∩ virtualPrimeBand A B (n + j.val)).card = 1 ∧
      T ∩ virtualPrimeBand A B (n + j.val) ⊆ coreSuffixPrimeBand A B eta (n + j.val)

noncomputable def coreBlockEventMass (A B eta lam : ℝ) (n K : ℕ) : ℝ := by
  classical
  exact ∑ T ∈ (virtualPrimeUniverse A B (n + K)).powerset.filter (CoreBlockEvent A B eta n K),
    primeTiltWeight (virtualPrimeUniverse A B (n + K)) lam T

theorem coreBlockBand_union (A B : ℝ) (n K : ℕ) :
    primeBandUnion (coreBlockBand A B n K) = virtualPrimeUniverse A B (n + K) := by
  ext p
  constructor
  · intro hp
    obtain ⟨j, _, hj⟩ := mem_biUnion.mp hp
    cases j with
    | none =>
      obtain ⟨i, hi, hpi⟩ := mem_biUnion.mp hj
      exact mem_biUnion.mpr ⟨i, mem_range.mpr (by have := mem_range.mp hi; omega), hpi⟩
    | some j =>
      exact mem_biUnion.mpr ⟨n + j.val, mem_range.mpr (by omega), hj⟩
  · intro hp
    obtain ⟨i, hi, hpi⟩ := mem_biUnion.mp hp
    by_cases hin : i < n
    · exact mem_biUnion.mpr ⟨none, mem_univ _, mem_biUnion.mpr ⟨i, mem_range.mpr hin, hpi⟩⟩
    · have hK : i - n < K := by have := mem_range.mp hi; omega
      refine mem_biUnion.mpr ⟨some ⟨i - n, hK⟩, mem_univ _, ?_⟩
      simpa only [coreBlockBand, Nat.add_sub_of_le (by omega : n ≤ i)] using hpi

theorem virtualPrimeUniverse_disjoint_later_band {A B : ℝ} (hB : 0 < B)
    {n j : ℕ} (hnj : n ≤ j) : Disjoint (virtualPrimeUniverse A B n) (virtualPrimeBand A B j) := by
  apply disjoint_left.mpr
  intro p hp hj
  obtain ⟨i, hi, hpi⟩ := mem_biUnion.mp hp
  exact disjoint_left.mp (virtualPrimeBand_disjoint hB (by have := mem_range.mp hi; omega)) hpi hj

theorem coreBlockBand_disjoint {A B : ℝ} (hB : 0 < B) (n K : ℕ) :
    Pairwise (fun i j ↦ Disjoint (coreBlockBand A B n K i) (coreBlockBand A B n K j)) := by
  intro i j hij
  cases i with
  | none =>
    cases j with
    | none => exact False.elim (hij rfl)
    | some j => exact virtualPrimeUniverse_disjoint_later_band hB (Nat.le_add_right n j.val)
  | some i =>
    cases j with
    | none => exact (virtualPrimeUniverse_disjoint_later_band hB (Nat.le_add_right n i.val)).symm
    | some j =>
      apply virtualPrimeBand_disjoint hB
      intro h
      exact hij (congrArg some (Fin.ext (Nat.add_left_cancel h)))

noncomputable def coreBlockBandEvent (A B eta : ℝ) (n K : ℕ) :
    Option (Fin K) → Finset ℕ → Prop
  | none, T => T.card = n ∧
      primeSubsetBallot (virtualPrimeUniverse A B n) (virtualPrimeBinIndex A B n) T
  | some j, T => T.card = 1 ∧ T ⊆ coreSuffixPrimeBand A B eta (n + j.val)

theorem coreBlockEvent_iff_band_events (A B eta : ℝ) (n K : ℕ) (T : Finset ℕ) :
    CoreBlockEvent A B eta n K T ↔
      ∀ i, coreBlockBandEvent A B eta n K i (T ∩ coreBlockBand A B n K i) := by
  constructor
  · intro h i
    cases i with
    | none => exact ⟨h.1, h.2.1⟩
    | some j => exact h.2.2 j
  · intro h
    exact ⟨(h none).1, (h none).2, fun j ↦ h (some j)⟩

theorem coreBlockEventMass_factorization {A B : ℝ} (hB : 0 < B)
    (eta lam : ℝ) (n K : ℕ) :
    coreBlockEventMass A B eta lam n K = virtualPrimeBallotMass A B lam n *
      ∏ j : Fin K, primeTiltSingleInMass (virtualPrimeBand A B (n + j.val))
        (coreSuffixPrimeBand A B eta (n + j.val)) lam := by
  classical
  have h := prime_tilt_disjoint_band_events_product (coreBlockBand A B n K)
    (coreBlockBand_disjoint hB n K) lam (coreBlockBandEvent A B eta n K)
  simp_rw [← coreBlockEvent_iff_band_events] at h
  rw [coreBlockBand_union, Fintype.prod_option] at h
  have hpref : (∑ T ∈ (coreBlockBand A B n K none).powerset.filter
      (coreBlockBandEvent A B eta n K none), primeTiltWeight (coreBlockBand A B n K none) lam T) =
      virtualPrimeBallotMass A B lam n := by
    simp only [virtualPrimeBallotMass, primeTiltGoodCountMass, coreBlockBand, coreBlockBandEvent, sum_filter]
    apply sum_congr rfl
    intro T _
    by_cases ht : T.card = n ∧
        primeSubsetBallot (virtualPrimeUniverse A B n) (virtualPrimeBinIndex A B n) T
    · simp only [ht]
    · simp only [ht, if_false]
  have hsuff (j : Fin K) : (∑ T ∈ (coreBlockBand A B n K (some j)).powerset.filter
      (coreBlockBandEvent A B eta n K (some j)), primeTiltWeight (coreBlockBand A B n K (some j)) lam T) =
      primeTiltSingleInMass (virtualPrimeBand A B (n + j.val))
        (coreSuffixPrimeBand A B eta (n + j.val)) lam := by
    simp only [primeTiltSingleInMass, coreBlockBand, coreBlockBandEvent, sum_filter]
    apply sum_congr rfl
    intro T _
    by_cases ht : T.card = 1 ∧ T ⊆ coreSuffixPrimeBand A B eta (n + j.val)
    · simp only [ht]
    · simp only [ht, if_false]
  rw [hpref] at h
  simp_rw [hsuff] at h
  exact h

theorem sum_primeBand_intersections {ι : Type*} [Fintype ι]
    (P : ι → Finset ℕ) (hdis : Pairwise (fun i j ↦ Disjoint (P i) (P j)))
    {T : Finset ℕ} (hT : T ⊆ primeBandUnion P) (f : ℕ → ℝ) :
    (∑ p ∈ T, f p) = ∑ i, ∑ p ∈ T ∩ P i, f p := by
  rw [← primeBand_intersections_union P hT]
  rw [sum_biUnion (fun i _ j _ hij ↦ Disjoint.mono inter_subset_right inter_subset_right (hdis hij))]
  simp only [primeBand_union_inter hdis (fun _ ↦ inter_subset_right)]

theorem coreBlockEvent_card {A B eta : ℝ} {n K : ℕ} {T : Finset ℕ}
    (hB : 0 < B) (hT : T ⊆ virtualPrimeUniverse A B (n + K))
    (hevent : CoreBlockEvent A B eta n K T) : T.card = n + K := by
  have hsub : T ⊆ primeBandUnion (coreBlockBand A B n K) := by rwa [coreBlockBand_union]
  rw [card_primeBand_intersections (coreBlockBand A B n K) (coreBlockBand_disjoint hB n K) hsub,
    Fintype.sum_option]
  simp only [coreBlockBand, hevent.1, (hevent.2.2 _).1, sum_const, card_univ, Fintype.card_fin,
    smul_eq_mul, mul_one]

theorem coreBlockEvent_log_sum_le {A B eta eps : ℝ} {n K : ℕ} {T : Finset ℕ}
    (hB : 0 < B) (hT : T ⊆ virtualPrimeUniverse A B (n + K))
    (hevent : CoreBlockEvent A B eta n K T)
    (hsize : (n : ℝ) ≤ eps * (2 : ℝ) ^ K) :
    (∑ p ∈ T, log (p : ℝ)) ≤ (n + K : ℕ) * A + B * (exp eta + eps) * (2 : ℝ) ^ (n + K) := by
  have hprefix : (∑ p ∈ T ∩ virtualPrimeUniverse A B n, log (p : ℝ)) ≤
      (n : ℝ) * (A + B * 2 ^ n) := by
    have hb : ∀ p ∈ T ∩ virtualPrimeUniverse A B n, log (p : ℝ) ≤ A + B * 2 ^ n := by
      intro p hp
      have hw := (mem_inter.mp hp).2
      rw [virtualPrimeUniverse_eq_window hB] at hw
      exact (mem_primeLogWindow.mp hw).2.2
    have hs := sum_le_sum (fun p hp ↦ hb p hp)
    simpa only [sum_const, nsmul_eq_mul, hevent.1] using hs
  have hsuffix (j : Fin K) : (∑ p ∈ T ∩ virtualPrimeBand A B (n + j.val), log (p : ℝ)) ≤
      A + B * exp eta * 2 ^ (n + j.val) := by
    have hb : ∀ p ∈ T ∩ virtualPrimeBand A B (n + j.val),
        log (p : ℝ) ≤ A + B * exp eta * 2 ^ (n + j.val) :=
      fun _ hp ↦ (mem_primeLogWindow.mp ((hevent.2.2 j).2 hp)).2.2
    have hs := sum_le_sum (fun p hp ↦ hb p hp)
    simpa only [sum_const, nsmul_eq_mul, (hevent.2.2 j).1, Nat.cast_one, one_mul] using hs
  have hsub : T ⊆ primeBandUnion (coreBlockBand A B n K) := by rwa [coreBlockBand_union]
  have hsplit := sum_primeBand_intersections (coreBlockBand A B n K)
    (coreBlockBand_disjoint hB n K) hsub (fun p ↦ log (p : ℝ))
  rw [Fintype.sum_option] at hsplit
  have hsum : (∑ j : Fin K, (A + B * exp eta * 2 ^ (n + (j : ℕ)))) =
      (K : ℝ) * A + B * exp eta * ((2 : ℝ) ^ (n + K) - (2 : ℝ) ^ n) := by
    rw [Fin.sum_univ_eq_sum_range (fun j : ℕ ↦ A + B * exp eta * 2 ^ (n + j)),
      sum_add_distrib, ← mul_sum, sum_shifted_dyadic_powers]
    simp
  have hpre : (n : ℝ) * (2 : ℝ) ^ n ≤ eps * (2 : ℝ) ^ (n + K) := by
    have h := mul_le_mul_of_nonneg_right hsize (by positivity : (0 : ℝ) ≤ 2 ^ n)
    simpa only [pow_add, mul_assoc, mul_comm, mul_left_comm] using h
  have hgeom : (n : ℝ) * (2 : ℝ) ^ n + exp eta * ((2 : ℝ) ^ (n + K) - (2 : ℝ) ^ n) ≤
      (exp eta + eps) * (2 : ℝ) ^ (n + K) := by
    nlinarith [show 0 ≤ exp eta * (2 : ℝ) ^ n by positivity]
  calc
    _ = _ := hsplit
    _ ≤ (n : ℝ) * (A + B * 2 ^ n) + ∑ j : Fin K, (A + B * exp eta * 2 ^ (n + j.val)) :=
      add_le_add hprefix (sum_le_sum (fun j _ ↦ hsuffix j))
    _ = (n + K : ℕ) * A + B * ((n : ℝ) * (2 : ℝ) ^ n +
        exp eta * ((2 : ℝ) ^ (n + K) - (2 : ℝ) ^ n)) := by rw [hsum]; push_cast; ring
    _ ≤ _ := by simpa only [mul_assoc] using add_le_add le_rfl (mul_le_mul_of_nonneg_left hgeom hB.le)

noncomputable def coreBlockSuffixLower (A B eta lam : ℝ) (n K : ℕ) : ℝ :=
  ∏ j : Fin K,
    exp (-(lam * (log 2 + 2 * primeLogOddsErrorConstant / (A + B * 2 ^ (n + j.val))))) *
      (lam * eta * B * 2 ^ (n + j.val) / (2 * (A + B * 2 ^ (n + j.val))))

noncomputable def coreBlockPrefixLower (A B lam : ℝ) (n J : ℕ) : ℝ :=
  exp (-(n : ℝ) * (lam * log 2 - 1 - log (lam * log 2)) -
    2 * lam * primeLogOddsErrorConstant / (A + B) -
    J * log (1 + A / B) - 2 - 2 * n * virtualPrimeRelativeError B) /
      (exp 1 * (n : ℝ) ^ 2) -
        (8 * (n : ℝ) ^ 2 * (A + B) / (B * log 2)) * exp (-(A + B))

theorem virtualPrimeBallotMass_nonneg {A B lam : ℝ}
    (hB : 0 < B) (hlam : 0 < lam) (n : ℕ) : 0 ≤ virtualPrimeBallotMass A B lam n := by
  unfold virtualPrimeBallotMass primeTiltGoodCountMass
  apply sum_nonneg
  intro T _
  exact (primeTiltWeight_pos (fun p hp ↦ by
    rw [virtualPrimeUniverse_eq_window hB] at hp
    exact (mem_primeLogWindow.mp hp).1) hlam T).le

theorem coreBlockSuffixLower_nonneg {A B eta lam : ℝ}
    (hA : 0 ≤ A) (hB : 0 < B) (heta : 0 ≤ eta) (hlam : 0 ≤ lam) (n K : ℕ) :
    0 ≤ coreBlockSuffixLower A B eta lam n K := by
  apply prod_nonneg
  intro j _
  positivity

theorem coreBlockEventMass_lower_of_prefix {A B eta lam L : ℝ}
    (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (heta : 0 < eta) (heta2 : eta ≤ log 2)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ eta * B) (n K : ℕ)
    (hprefix : L ≤ virtualPrimeBallotMass A B lam n) :
    L * coreBlockSuffixLower A B eta lam n K ≤ coreBlockEventMass A B eta lam n K := by
  rw [coreBlockEventMass_factorization hB]
  apply mul_le_mul hprefix
  · apply prod_le_prod
    · intro j _
      positivity
    · intro j _
      exact coreSuffix_singleIn_probability_lower hA hB hbase heta heta2 hlam hlam2 hlarge (n + j.val)
  · exact coreBlockSuffixLower_nonneg hA hB heta.le (by linarith) n K
  · exact virtualPrimeBallotMass_nonneg hB (by linarith) n

/-- Explicit finite lower bound; the prefix term retains its proved repeated-mark
error, and taking its positive part requires no extra probability margin. -/
theorem coreBlockEventMass_explicit_lower {n : ℕ} (hn : 0 < n) (K : ℕ)
    {A B eta lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (heta : 0 < eta) (heta2 : eta ≤ log 2)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ eta * B)
    {J : ℕ} (hAB : A / B ≤ (2 : ℝ) ^ J) :
    max 0 (coreBlockPrefixLower A B lam n J) * coreBlockSuffixLower A B eta lam n K ≤
      coreBlockEventMass A B eta lam n K := by
  have hlarge' : 4 * primeLogOddsErrorConstant ≤ B * log 2 :=
    hlarge.trans (by simpa only [mul_comm] using mul_le_mul_of_nonneg_right heta2 hB.le)
  apply coreBlockEventMass_lower_of_prefix hA hB hbase heta heta2 hlam hlam2 hlarge n K
  exact max_le (virtualPrimeBallotMass_nonneg hB (by linarith) n)
    (virtualPrime_ballot_probability_explicit_lower hn hA hB hbase hlam hlam2 hlarge' hAB)

end Erdos859Verification

