      (virtualPrimeBinIndex A B n) j = ∑ p ∈ virtualPrimeBand A B j.val, weight p := by
  classical
  unfold finiteBinMass
  apply sum_bij (fun p _ ↦ p.val)
  · intro p hp
    exact (virtualPrimeBinIndex_eq_iff hB n p j).mp (mem_filter.mp hp).2
  · intro p _ q _ hpq
    exact Subtype.ext hpq
  · intro p hp
    let q : virtualPrimeUniverse A B n := ⟨p, virtualPrimeBand_subset_universe A B j.isLt hp⟩
    exact ⟨q, mem_filter.mpr ⟨mem_univ _, (virtualPrimeBinIndex_eq_iff hB n q j).mpr hp⟩, rfl⟩
  · intro p _
    rfl

theorem virtualPrimeUniverse_eq_window {A B : ℝ} (hB : 0 < B) (n : ℕ) :
    virtualPrimeUniverse A B n = primeLogWindow (A + B) (A + B * 2 ^ n) := by
  induction n with
  | zero =>
      ext p
      simp only [virtualPrimeUniverse, range_zero, biUnion_empty, notMem_empty,
        mem_primeLogWindow, pow_zero, mul_one]
      exact ⟨False.elim, fun ⟨_, hlo, hhi⟩ ↦ (not_lt_of_ge hhi) hlo⟩
  | succ n ih =>
      have hp : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
      have hab : A + B ≤ A + B * 2 ^ n := by nlinarith
      have hbc : A + B * 2 ^ n ≤ A + B * 2 ^ (n + 1) := by rw [pow_succ]; nlinarith
      calc
        virtualPrimeUniverse A B (n + 1) = virtualPrimeUniverse A B n ∪ virtualPrimeBand A B n := by
          simp only [virtualPrimeUniverse, range_add_one, biUnion_insert, union_comm]
        _ = _ := by rw [ih, virtualPrimeBand, primeLogWindow_union_adjacent hab hbc]

/-- Actual prime intensity weights satisfy the corrected virtual-bin
ballot bound, with no bin-mass premise left unproved. -/
theorem virtualPrime_ballot_intensity_lower {n : ℕ} (hn : 0 < n)
    {A B lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 2 * primeLogOddsErrorConstant ≤ B * log 2)
    {J : ℕ} (hAB : A / B ≤ (2 : ℝ) ^ J) :
    ((n : ℝ) ^ n / n) * (lam * (1 - virtualPrimeRelativeError B) * log 2) ^ n *
      exp (-(J : ℝ) * log (1 + A / B) - 2) ≤
      ∑ x : Fin n → virtualPrimeUniverse A B n with
        CyclicBallot (occupancyCount (fun i ↦ virtualPrimeBinIndex A B n (x i))),
          ∏ i, primeLogOddsIntensity lam (x i).val := by
  have hcoef : 0 ≤ lam * (1 - virtualPrimeRelativeError B) :=
    mul_nonneg (by linarith) (sub_nonneg.mpr (virtualPrimeRelativeError_bounds hB hlarge).2)
  have hbin (j : Fin n) :
      (lam * (1 - virtualPrimeRelativeError B)) * virtualCoreBin A B j.val ≤
      finiteBinMass (fun p : virtualPrimeUniverse A B n ↦ primeLogOddsIntensity lam p.val)
        (virtualPrimeBinIndex A B n) j := by
    rw [virtualPrime_finiteBinMass_eq hB]
    exact virtualPrime_intensity_mass_lower hA hB hbase hlam hlam2 j.val
  exact virtual_core_ballot_weight_lower hn
    (fun p : virtualPrimeUniverse A B n ↦ primeLogOddsIntensity lam p.val)
    (virtualPrimeBinIndex A B n) hA hB hcoef hAB hbin

