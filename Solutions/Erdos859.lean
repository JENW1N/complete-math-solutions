/- Inlined development module: PracticalSeedHorizon.lean -/

section

/- A logarithmic number of geometric windows suffices for a practical seed. -/

open Finset Real

namespace Erdos859Verification

noncomputable def seedWindowCount (Z : ℕ) : ℕ :=
  ⌈log (log (Z : ℝ) / 4) / log ((3 : ℝ) / 2)⌉₊

theorem four_lt_log_of_gt_210 {Z : ℕ} (hZ : 210 < Z) : 4 < log (Z : ℝ) := by
  exact four_le_log_210.trans_lt
    (log_lt_log (by norm_num) (by exact_mod_cast hZ))

theorem seedWindowCount_large {Z : ℕ} (hZ : 210 < Z) :
    log (Z : ℝ) ≤ 4 * ((3 : ℝ) / 2) ^ seedWindowCount Z := by
  have hlog := four_lt_log_of_gt_210 hZ
  have hr : 0 < log ((3 : ℝ) / 2) := log_pos (by norm_num)
  have hceil := Nat.le_ceil (log (log (Z : ℝ) / 4) / log ((3 : ℝ) / 2))
  change log (log (Z : ℝ) / 4) / log ((3 : ℝ) / 2) ≤ (seedWindowCount Z : ℝ) at hceil
  have h := (div_le_iff₀ hr).mp hceil
  rw [← log_pow] at h
  have hle := (log_le_log_iff (by positivity : 0 < log (Z : ℝ) / 4)
    (pow_pos (by norm_num : (0 : ℝ) < 3 / 2) _)).mp h
  linarith

theorem seedWindowCount_upper {Z : ℕ} (hZ : 210 < Z) :
    (seedWindowCount Z : ℝ) < log (log (Z : ℝ)) / log ((3 : ℝ) / 2) + 1 := by
  have hlog := four_lt_log_of_gt_210 hZ
  have hr : 0 < log ((3 : ℝ) / 2) := log_pos (by norm_num)
  have hquot : 1 ≤ log (Z : ℝ) / 4 := by linarith
  have hx : 0 ≤ log (log (Z : ℝ) / 4) / log ((3 : ℝ) / 2) :=
    div_nonneg (log_nonneg hquot) hr.le
  have hlogdiv : log (log (Z : ℝ) / 4) ≤ log (log (Z : ℝ)) := by
    rw [log_div (by linarith : log (Z : ℝ) ≠ 0) (by norm_num)]
    exact sub_le_self _ (log_nonneg (by norm_num))
  exact (Nat.ceil_lt_add_one hx).trans_le
    (add_le_add (div_le_div_of_nonneg_right hlogdiv hr.le) le_rfl)

theorem seedWindowCount_previous {Z j : ℕ} (hZ : 210 < Z) (hj : j < seedWindowCount Z) :
    4 * ((3 : ℝ) / 2) ^ j < log (Z : ℝ) := by
  have hlog := four_lt_log_of_gt_210 hZ
  have hr : 0 < log ((3 : ℝ) / 2) := log_pos (by norm_num)
  have hjR : (j : ℝ) < log (log (Z : ℝ) / 4) / log ((3 : ℝ) / 2) :=
    Nat.lt_ceil.mp hj
  have h := (lt_div_iff₀ hr).mp hjR
  rw [← log_pow] at h
  have hlt := (log_lt_log_iff (pow_pos (by norm_num : (0 : ℝ) < 3 / 2) _)
    (by positivity : 0 < log (Z : ℝ) / 4)).mp h
  linarith

/-- Every prime inspected by the seed event is smaller than its target scale. -/
theorem practicalSeedPrimeUniverse_lt {Z p : ℕ} (hZ : 210 < Z)
    (hp : p ∈ practicalSeedPrimeUniverse (seedWindowCount Z)) : p < Z := by
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  have hjN := mem_range.mp hj
  rcases lt_or_ge j 4 with hj4 | hj4
  · interval_cases j <;> simp only [practicalSeedBand, mem_singleton] at hpj <;> omega
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hj4
    rw [Nat.add_comm 4 k] at hpj
    have hpband := mem_practicalPrimeBand.mp hpj
    have hplog : log (p : ℝ) < log (Z : ℝ) :=
      hpband.2.2.trans_lt (seedWindowCount_previous hZ (by omega))
    exact Nat.cast_lt.mp ((log_lt_log_iff
      (by exact_mod_cast hpband.1.pos) (by exact_mod_cast (show 0 < Z by omega))).mp hplog)

theorem seedWindowCount_probability_lower {eta : ℝ} (heta : 0 < eta) (heta1 : eta < 1)
    {Z : ℕ} (hZ : 210 < Z) :
    eta ^ 5 / (log (Z : ℝ)) ^ (-log eta / log ((3 : ℝ) / 2)) ≤
      eta ^ (seedWindowCount Z + 4) := by
  have hlog : 0 < log (Z : ℝ) := by linarith [four_lt_log_of_gt_210 hZ]
  have hden := rpow_pos_of_pos hlog (-log eta / log ((3 : ℝ) / 2))
  apply (log_le_log_iff (div_pos (pow_pos heta 5) hden)
    (pow_pos heta (seedWindowCount Z + 4))).mp
  rw [log_div (pow_pos heta 5).ne' hden.ne', log_pow, log_rpow hlog, log_pow]
  simp only [Nat.cast_add, Nat.cast_ofNat]
  have hmul := mul_le_mul_of_nonpos_right (seedWindowCount_upper hZ).le
    (log_neg heta heta1).le
  calc
    5 * log eta - (-log eta / log (3 / 2)) * log (log (Z : ℝ)) =
        (log (log (Z : ℝ)) / log (3 / 2) + 1) * log eta + 4 * log eta := by ring
    _ ≤ ((seedWindowCount Z : ℝ) + 4) * log eta := by linarith

/-- The seed probability loses only a fixed power of the logarithm, without
requiring an asymptotic counting theorem for practical numbers. -/
theorem exists_practicalSeed_polylog_lower :
    ∃ c : ℝ, 0 < c ∧ ∃ C : ℝ, 0 < C ∧ ∀ Z : ℕ, 210 < Z →
      c / (log (Z : ℝ)) ^ C ≤
        ∑ T ∈ (practicalSeedPrimeUniverse (seedWindowCount Z)).powerset,
          primePatternWeight (practicalSeedPrimeUniverse (seedWindowCount Z)) T *
            practicalSeedIndicator Z T := by
  obtain ⟨eta, heta, heta1, hbound⟩ := exists_practicalSeed_weight_lower
  refine ⟨eta ^ 5, pow_pos heta 5, -log eta / log ((3 : ℝ) / 2),
    div_pos (neg_pos.mpr (log_neg heta heta1)) (log_pos (by norm_num)), ?_⟩
  intro Z hZ
  exact (seedWindowCount_probability_lower heta heta1 hZ).trans
    (hbound (seedWindowCount Z) Z hZ (seedWindowCount_large hZ))

end Erdos859Verification

