theorem prime_expectation_mono_universe {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) (f : Finset ℕ → ℝ) (hf : Monotone f) :
    (∑ T ∈ B.powerset, primePatternWeight B T * f T) ≤
      ∑ T ∈ P.powerset, primePatternWeight P T * f T := by
  rw [← prime_expectation_restrict hP hB f]
  apply sum_le_sum
  intro T _
  exact mul_le_mul_of_nonneg_left (hf inter_subset_left) (primePatternWeight_pos hP T).le

/-- FKG applied to the likelihood ratio gives stochastic domination by
the tilted law whenever the tilt parameter is at least one. -/
theorem primeTilt_expectation_ge {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {lam : ℝ} (hlam : 1 ≤ lam)
    (f : Finset ℕ → ℝ) (hf0 : ∀ T, 0 ≤ f T) (hf : Monotone f) :
    (∑ T ∈ P.powerset, primePatternWeight P T * f T) ≤
      ∑ T ∈ P.powerset, primeTiltWeight P lam T * f T := by
  have hlam0 : 0 < lam := zero_lt_one.trans_le hlam
  have hg : Monotone (fun T : Finset ℕ ↦ lam ^ T.card) := by
    intro S T hST
    exact pow_le_pow_right₀ hlam (card_le_card hST)
  have h := prime_positive_association hP f (fun T ↦ lam ^ T.card) hf0
    (fun T ↦ (pow_pos hlam0 T.card).le) hf hg
  rw [primePatternWeight_moment] at h
  have hrewrite : (∑ T ∈ P.powerset, primeTiltWeight P lam T * f T) =
      (∑ T ∈ P.powerset, primePatternWeight P T * (f T * lam ^ T.card)) /
        primeTiltNormalizer P lam := by
    rw [sum_div]
    apply sum_congr rfl
    intro T _
    unfold primeTiltWeight
    ring
  rw [hrewrite]
  exact (le_div_iff₀ (primeTiltNormalizer_pos hP hlam0)).mpr h

end Erdos859Verification

