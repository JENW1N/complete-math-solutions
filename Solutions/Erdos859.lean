    (P : Fin n → Finset ℕ) (Q : Fin r → Finset ℕ)
    (hP : ∀ i p, p ∈ P i → p.Prime) (hQ : ∀ i p, p ∈ Q i → p.Prime)
    (hdis : Disjoint (primeBandUnion P) (primeBandUnion Q))
