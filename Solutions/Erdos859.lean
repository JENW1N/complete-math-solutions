    (hk : 0 < k) (hn : 0 < n) (hC : 0 < C)
    (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hepslow : (k : ℝ) ^ (-D) ≤ eps)
    (hnupper : (n : ℝ) ≤ C * (k : ℝ) ^ r) :
    0 ≤ 5 * eps + (n : ℝ) * log (4 * n / eps) ∧
      5 * eps + (n : ℝ) * log (4 * n / eps) ≤
        5 + C * (k : ℝ) ^ r * (log (4 * C) + (r + D) * log k) := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hnR : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hp : 0 < (k : ℝ) ^ (-D) := rpow_pos_of_pos hkR _
  have hlogpos : 0 ≤ log (4 * n / eps) := by
    apply log_nonneg
    apply (le_div_iff₀ heps).mpr
    nlinarith
  have hratio : 4 * (n : ℝ) / eps ≤ 4 * C * (k : ℝ) ^ (r + D) := by
    calc
      _ ≤ (4 * C * (k : ℝ) ^ r) / (k : ℝ) ^ (-D) :=
        div_le_div₀ (by positivity) (by nlinarith) hp hepslow
      _ = _ := by rw [rpow_add hkR, rpow_neg hkR.le]; simp only [div_eq_mul_inv, inv_inv]; ring
  have hlog : log (4 * n / eps) ≤ log (4 * C) + (r + D) * log k := by
    have h := log_le_log (by positivity : 0 < 4 * (n : ℝ) / eps) hratio
    rwa [log_mul (by positivity) (rpow_pos_of_pos hkR _).ne', log_rpow hkR] at h
  constructor
  · positivity
  · have hm := mul_le_mul hnupper hlog hlogpos (by positivity : 0 ≤ C * (k : ℝ) ^ r)
    nlinarith

theorem tendsto_broad_count_cost_div {n : ℕ → ℕ} {eps : ℕ → ℝ}
    {C D r : ℝ} (hC : 0 < C) (hr : r < 1)
    (hn : ∀ᶠ k : ℕ in atTop, 0 < n k)
    (heps : ∀ᶠ k : ℕ in atTop, 0 < eps k ∧ eps k ≤ 1)
    (hepslow : ∀ᶠ k : ℕ in atTop, (k : ℝ) ^ (-D) ≤ eps k)
    (hnupper : ∀ᶠ k : ℕ in atTop, (n k : ℝ) ≤ C * (k : ℝ) ^ r) :
    Tendsto (fun k : ℕ ↦
      (5 * eps k + (n k : ℝ) * log (4 * n k / eps k)) / k) atTop (𝓝 0) := by
  have hlim : Tendsto (fun k : ℕ ↦
      (5 + C * (k : ℝ) ^ r * (log (4 * C) + (r + D) * log k)) / k)
      atTop (𝓝 0) := by
    convert (tendsto_const_div_atTop_nhds_zero_nat (5 : ℝ)).add
      ((tendsto_rpow_affine_log_div_nat hr (log (4 * C)) (r + D)).const_mul C) using 1
    · ext k
      ring
    · ring
  apply squeeze_zero' _ _ hlim
  · filter_upwards [eventually_gt_atTop 0, hn, heps, hepslow, hnupper] with k hk hn he hl hu
    exact div_nonneg (broad_count_cost_polynomial_bound hk hn hC he.1 he.2 hl hu).1
      (Nat.cast_nonneg k)
  · filter_upwards [eventually_gt_atTop 0, hn, heps, hepslow, hnupper] with k hk hn he hl hu
    exact div_le_div_of_nonneg_right
      (broad_count_cost_polynomial_bound hk hn hC he.1 he.2 hl hu).2 (Nat.cast_nonneg k)

end Erdos859Verification

