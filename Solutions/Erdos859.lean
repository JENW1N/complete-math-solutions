section

/- Consistency of the finite prime laws under restriction to fewer primes. -/

open Finset Filter
open scoped Topology

namespace Erdos859Verification

theorem prime_expectation_restrict {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) (F : Finset ℕ → ℝ) :
    (∑ T ∈ P.powerset, primePatternWeight P T * F (T ∩ B)) =
      ∑ U ∈ B.powerset, primePatternWeight B U * F U := by
  apply tendsto_nhds_unique (tendsto_mean_prime_observable hP (fun T ↦ F (T ∩ B)))
  convert tendsto_mean_prime_observable (fun p hp ↦ hP p (hB hp)) F using 1
  funext N
  congr 1
  apply sum_congr rfl
  intro n _
  congr 1
  ext p
  simp only [mem_inter, mem_filter]
  constructor
  · exact fun hp ↦ ⟨hp.2, hp.1.2⟩
  · exact fun hp ↦ ⟨⟨hB hp.1, hp.2⟩, hp.1⟩

noncomputable def primeBandHitIndicator (B T : Finset ℕ) : ℝ :=
  if (T ∩ B).Nonempty then 1 else 0

theorem primeBandHitIndicator_nonneg (B T : Finset ℕ) :
    0 ≤ primeBandHitIndicator B T := by
  unfold primeBandHitIndicator
  split_ifs <;> norm_num

theorem primeBandHitIndicator_monotone (B : Finset ℕ) :
    Monotone (primeBandHitIndicator B) := by
  intro S T hST
  unfold primeBandHitIndicator
  by_cases hS : (S ∩ B).Nonempty
  · have hT : (T ∩ B).Nonempty := hS.mono (inter_subset_inter hST subset_rfl)
    simp [hS, hT]
  · simp only [if_neg hS]
    split_ifs <;> norm_num

theorem primeBandHitIndicator_expectation {P B : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hB : B ⊆ P) :
    (∑ T ∈ P.powerset, primePatternWeight P T * primeBandHitIndicator B T) =
      primeBandHitWeight B := by
  unfold primeBandHitIndicator
  rw [prime_expectation_restrict hP hB (fun U ↦ if U.Nonempty then (1 : ℝ) else 0)]
  unfold primeBandHitWeight
  rw [sum_filter]
  apply sum_congr rfl
  intro U _
  split_ifs <;> simp

theorem primeBandHitWeight_pos {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hne : P.Nonempty) : 0 < primeBandHitWeight P := by
  unfold primeBandHitWeight
  apply sum_pos'
  · intro T _
    exact (primePatternWeight_pos hP T).le
  · obtain ⟨p, hp⟩ := hne
    exact ⟨{p}, mem_filter.mpr ⟨mem_powerset.mpr (singleton_subset_iff.mpr hp),
      singleton_nonempty p⟩, primePatternWeight_pos hP {p}⟩

end Erdos859Verification

