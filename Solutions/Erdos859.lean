      rw [Nat.cast_sub (by omega : r ≤ k - 1), Nat.cast_sub (by omega : 1 ≤ k), Nat.cast_one]
    calc
      _ ≤ (2 : ℝ) ^ (D - (1 + eps) * (r : ℝ)) /
          (A * (2 : ℝ) ^ (k - 1 - r)) :=
        div_le_div_of_nonneg_right hpow (by positivity)
      _ = (2 : ℝ) ^ (D - (1 + eps) * (r : ℝ) - (k - 1 - r : ℕ)) / A := by
        rw [rpow_sub (by norm_num : (0 : ℝ) < 2)
          (D - (1 + eps) * (r : ℝ)) ((k - 1 - r : ℕ) : ℝ), rpow_natCast]
