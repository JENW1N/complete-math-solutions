  have hlog2 : log (2 : ℝ) ≤ log (p : ℝ) :=
    log_le_log (by norm_num) (by exact_mod_cast hp.two_le)
  calc
    _ ≤ log (2 * (p : ℝ)) := log_le_log hargpos (by linarith)
    _ = log 2 + log (p : ℝ) := log_mul (by norm_num) hp0.ne'
    _ ≤ _ := by linarith

noncomputable def fordStoppingLogThreshold (y : ℝ) (S : Finset ℕ) : ℝ :=
  max (log 2) (fordLogDenominator y S / 2)

