theorem proper_signedCubeFourier_eq_coefficients {ι : Type*} [Fintype ι]
    (w : ι → ℕ) {H : ℕ} (hproper : IsProperSignedCube w H) (x : AddCircle (1 : ℝ)) :
    integerSetFourierMean (signedCubeValueSet w H) x =
