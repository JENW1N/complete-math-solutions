theorem norm_bernoulli_factor_sq (z : ℂ) (hz : ‖z‖ = 1) :
    ‖(1 + z) / 2‖ ^ 2 = (1 + z.re) / 2 := by
  have hzsq : z.re * z.re + z.im * z.im = 1 := by
    simpa only [Complex.normSq_apply, hz, one_pow] using Complex.normSq_eq_norm_sq z
  rw [norm_div, Complex.norm_ofNat, div_pow, Complex.sq_norm, Complex.normSq_apply]
  simp only [Complex.add_re, Complex.one_re, Complex.add_im, Complex.one_im, zero_add]
  nlinarith

theorem fourier_one_re_centered (a : ℝ) :
    (fourier 1 (a : AddCircle (1 : ℝ))).re =
      cos (2 * Real.pi * (a - (round a : ℝ))) := by
  simpa [signedCubeValue] using
    signedCube_fourier_re_centered (fun _ : Fin 1 ↦ 1) (fun _ ↦ 1) a

/-- The circle distance controls the squared norm of a fair coin transform. -/
theorem bernoulli_circle_norm_sq_le (x : AddCircle (1 : ℝ)) :
    ‖(1 + fourier 1 x) / 2‖ ^ 2 ≤ 1 - 4 * ‖x‖ ^ 2 := by
  induction x using QuotientAddGroup.induction_on with
  | H a =>
    let t : ℝ := a - (round a : ℝ)
    have ht : |t| ≤ 1 / 2 := by
      simpa only [UnitAddCircle.norm_eq, abs_one] using
        (AddCircle.norm_le_half_period (1 : ℝ) (by norm_num) (x := (a : AddCircle (1 : ℝ))))
    have hangle : |2 * Real.pi * t| ≤ Real.pi := by
      rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi)]
      nlinarith [Real.pi_pos]
    have hcos := Real.cos_le_one_sub_mul_cos_sq hangle
    have hcoef : 2 / Real.pi ^ 2 * (2 * Real.pi * t) ^ 2 = 8 * t ^ 2 := by
      field_simp
      ring
    rw [hcoef] at hcos
    have hz : ‖fourier 1 (a : AddCircle (1 : ℝ))‖ = 1 := by
      rw [fourier_apply]
      exact Circle.norm_coe _
    rw [norm_bernoulli_factor_sq _ hz, fourier_one_re_centered,
      UnitAddCircle.norm_eq, sq_abs]
    change (1 + cos (2 * Real.pi * t)) / 2 ≤ 1 - 4 * t ^ 2
    linarith

/-- Uniform Gaussian decay, including the half-period where the factor is zero. -/
theorem bernoulli_circle_decay (x : AddCircle (1 : ℝ)) :
    ‖(1 + fourier 1 x) / 2‖ ≤ exp (-2 * ‖x‖ ^ 2) := by
  apply (sq_le_sq₀ (norm_nonneg _) (exp_pos _).le).mp
  calc
    _ ≤ 1 - 4 * ‖x‖ ^ 2 := bernoulli_circle_norm_sq_le x
    _ ≤ exp (-4 * ‖x‖ ^ 2) := by linarith [Real.add_one_le_exp (-4 * ‖x‖ ^ 2)]
    _ = _ := by rw [← exp_nat_mul]; congr 1; ring

theorem bernoulli_product_decay {ι : Type*} [Fintype ι]
    (w : ι → ℕ) (x : AddCircle (1 : ℝ)) :
    ‖∏ i, ((1 + fourier 1 (w i • x)) / 2)‖ ≤ exp (-2 * cubePhaseSquare w x) := by
