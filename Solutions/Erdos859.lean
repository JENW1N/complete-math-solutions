    (hlarge : 4 * mertensErrorConstant ≤ A * log 2)
    (hb : 0 < b) (hd : 1 ≤ d) (hscale : b * A ≤ d) (heps : 0 < eps)
    (hbarrier : ∀ j : Fin k,
