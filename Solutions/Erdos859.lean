  have hnonneg : 0 ≤ ∑ p ∈ U, log (p : ℝ) :=
    sum_nonneg (fun p _ ↦ Real.log_natCast_nonneg p)
  have hsum : (∑ p ∈ U, log (p : ℝ)) ≤ ∑ p ∈ T, log (p : ℝ) :=
    sum_le_sum_of_subset_of_nonneg hUT (fun p _ _ ↦ Real.log_natCast_nonneg p)
  exact ⟨hnonneg.trans hyU.1, by linarith [hyU.2]⟩

theorem primeSubsetSumSupport_subset_Icc_of_sum_bound (T : Finset ℕ) (d L : ℝ)
    (hbound : (∑ p ∈ T, log (p : ℝ)) + d ≤ L) :
    primeSubsetSumSupport T d ⊆ Set.Icc 0 L :=
  (primeSubsetSumSupport_subset_Icc T d).trans (Set.Icc_subset_Icc le_rfl hbound)

theorem primeSubsetSumSupport_inter_Icc_eq (T : Finset ℕ) (d L : ℝ)
    (hbound : (∑ p ∈ T, log (p : ℝ)) + d ≤ L) :
    primeSubsetSumSupport T d ∩ Set.Icc 0 L = primeSubsetSumSupport T d :=
  Set.inter_eq_left.mpr (primeSubsetSumSupport_subset_Icc_of_sum_bound T d L hbound)

theorem primeSubsetSumSupport_inter_measure_mono (d : ℝ) (K : Set ℝ) :
    Monotone (fun T : Finset ℕ ↦ volume.real (primeSubsetSumSupport T d ∩ K)) := by
  intro S T hST
  exact measureReal_mono
    (Set.inter_subset_inter (primeSubsetSumSupport_mono hST d) Set.Subset.rfl)
    (measure_ne_top_of_subset Set.inter_subset_left
      (isCompact_primeSubsetSumSupport T d).measure_ne_top)

/-- The large-support indicator is increasing, as required for finite FKG. -/
theorem primeSubsetSumSupport_large_indicator_monotone (d r : ℝ) (K : Set ℝ) :
    Monotone (fun T : Finset ℕ ↦
      if r ≤ volume.real (primeSubsetSumSupport T d ∩ K) then (1 : ℝ) else 0) := by
  intro S T hST
  by_cases hS : r ≤ volume.real (primeSubsetSumSupport S d ∩ K)
  · have hT := hS.trans (primeSubsetSumSupport_inter_measure_mono d K hST)
    simp only [if_pos hS, if_pos hT, le_refl]
  · simp only [if_neg hS]
    split_ifs <;> norm_num

/-- Reindexing coordinates preserves the complete fair-bit subset-sum support,
including multiplicities of coincident mark values. -/
theorem finite_bitSum_support_reindex {ι κ : Type*} [Fintype ι] [Fintype κ]
    (e : ι ≃ κ) (v : κ → ℝ) (d : ℝ) :
    finiteIntervalSupport (fun b : ι → Bool ↦ ∑ i, if b i then v (e i) else 0) d =
      finiteIntervalSupport (fun b : κ → Bool ↦ ∑ j, if b j then v j else 0) d := by
  apply Set.Subset.antisymm
  · apply finiteIntervalSupport_mono_range
    rintro s ⟨b, rfl⟩
    refine ⟨fun j ↦ b (e.symm j), ?_⟩
    have hsum := e.sum_comp (fun j ↦ if b (e.symm j) then v j else 0)
    simpa using hsum.symm
  · apply finiteIntervalSupport_mono_range
    rintro s ⟨b, rfl⟩
    exact ⟨fun i ↦ b (e i), e.sum_comp (fun j ↦ if b j then v j else 0)⟩

/-- Distinct coordinate labels turn indexed bit choices into subsets of the
finite image. Injectivity is essential: repeated labels can be used twice
by indexed bit choices but occur only once in the image finset. -/
theorem finite_bitSum_support_eq_primeSubsetSumSupport {ι : Type*}
    [Fintype ι] [DecidableEq ι] (f : ι → ℕ) (hf : Function.Injective f) (d : ℝ) :
    finiteIntervalSupport (fun b : ι → Bool ↦ ∑ i, if b i then log (f i : ℝ) else 0) d =
      primeSubsetSumSupport (univ.image f) d := by
  classical
  ext y
  constructor
  · intro hy
    obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hy
    let I : Finset ι := univ.filter (fun i ↦ b i)
    have hI : I.image f ⊆ univ.image f := image_subset_image (filter_subset _ _)
    have hsum : (∑ p ∈ I.image f, log (p : ℝ)) =
        ∑ i, if b i then log (f i : ℝ) else 0 := by
      rw [sum_image (fun i _ j _ hij ↦ hf hij)]
      exact sum_filter _ _
    apply mem_primeSubsetSumSupport.mpr
    refine ⟨I.image f, hI, ?_⟩
    simpa only [hsum] using hb
  · intro hy
    obtain ⟨U, hU, hyU⟩ := mem_primeSubsetSumSupport.mp hy
    let b : ι → Bool := fun i ↦ decide (f i ∈ U)
    let I : Finset ι := univ.filter (fun i ↦ f i ∈ U)
    have himage : I.image f = U := by
      ext p
      constructor
      · intro hp
        obtain ⟨i, hi, rfl⟩ := mem_image.mp hp
        exact (mem_filter.mp hi).2
      · intro hp
        obtain ⟨i, hi, hfi⟩ := mem_image.mp (hU hp)
        exact mem_image.mpr ⟨i, mem_filter.mpr ⟨hi, by simpa only [hfi] using hp⟩, hfi⟩
    have hsum : (∑ i, if b i then log (f i : ℝ) else 0) =
        ∑ p ∈ U, log (p : ℝ) := by
      rw [← himage, sum_image (fun i _ j _ hij ↦ hf hij)]
      simp [I, b, sum_filter]
    exact Set.mem_iUnion.mpr ⟨b, by simpa only [hsum] using hyU⟩

theorem finiteSubsetSumAtom_prime_support {ι : Type*} [Fintype ι] [DecidableEq ι]
    (f : ι → ℕ) (hf : Function.Injective f) (d : ℝ) :
    finiteIntervalSupport (finiteSubsetSumAtom (fun _ (p : ℕ) ↦ log (p : ℝ)) f) d =
      primeSubsetSumSupport (univ.image f) d :=
  finite_bitSum_support_eq_primeSubsetSumSupport f hf d

def bandTuplePrimeMap {ι : Type*} {P : ι → Finset ℕ} {n : ι → ℕ}
    (x : BandTuple P n) (ji : Sigma (fun j ↦ Fin (n j))) : ℕ := (x ji.1 ji.2).val

theorem bandTuplePrimeMap_injective {ι : Type*} {P : ι → Finset ℕ} {n : ι → ℕ}
    (hdis : Pairwise (fun j k ↦ Disjoint (P j) (P k)))
    (x : BandTuple P n) (hx : BandTupleDistinct x) : Function.Injective (bandTuplePrimeMap x) := by
  rintro ⟨j, i⟩ ⟨k, l⟩ heq
  change (x j i).val = (x k l).val at heq
  have hjk : j = k := by
    by_contra hne
    apply disjoint_left.mp (hdis hne) (x j i).property
    rw [heq]
    exact (x k l).property
  subst k
  have hil : i = l := hx j (Subtype.ext heq)
  subst l
  rfl

theorem image_bandTuplePrimeMap {ι : Type*} [Fintype ι]
    {P : ι → Finset ℕ} {n : ι → ℕ} (x : BandTuple P n) :
    univ.image (bandTuplePrimeMap x) = primeBandUnion (bandTupleSupport x) := by
  ext p
  simp [bandTuplePrimeMap, primeBandUnion, bandTupleSupport, tupleSupport]

/-- On distinct tuples from disjoint bands, the thickened fair subset-sum
support is exactly the canonical support of the union of selected primes. -/
theorem distinct_bandTuple_subsetSum_support {ι : Type*} [Fintype ι] [DecidableEq ι]
    {P : ι → Finset ℕ} {n : ι → ℕ}
    (hdis : Pairwise (fun j k ↦ Disjoint (P j) (P k)))
    (x : BandTuple P n) (hx : BandTupleDistinct x) (d : ℝ) :
    finiteIntervalSupport
      (finiteSubsetSumAtom (fun (ji : Sigma (fun j ↦ Fin (n j))) (p : P ji.1) ↦
        log (p : ℕ)) (bandTupleSigmaEquiv P n x)) d =
          primeSubsetSumSupport (primeBandUnion (bandTupleSupport x)) d := by
  have h := finiteSubsetSumAtom_prime_support (bandTuplePrimeMap x)
    (bandTuplePrimeMap_injective hdis x hx) d
  have hatom :
      finiteSubsetSumAtom (fun (ji : Sigma (fun j ↦ Fin (n j))) (p : P ji.1) ↦
        log (p : ℕ)) (bandTupleSigmaEquiv P n x) =
      finiteSubsetSumAtom (fun _ (p : ℕ) ↦ log (p : ℝ)) (bandTuplePrimeMap x) := by
    funext b
    rfl
  rw [hatom]
  simpa only [image_bandTuplePrimeMap] using h

end Erdos859Verification

