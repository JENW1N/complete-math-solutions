  have hv0 : 0 < v := (log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hv
  have hB : 0 ≤ 16 * v / (q : ℝ) + 16 * exp (-v) / eps := by positivity
  have hw := (primeLogOddsMark_broad_normalized hlam hlam2 hv heps heps1 hlarge).1
  exact (finite_weighted_mul_residues_le _ _ hcop hB hw
    (fun _ ↦ primeLogOddsMark_broad_residue_upper hlam hlam2 hv heps heps1 hlarge hq) S).trans
      (mul_le_mul_of_nonneg_right
