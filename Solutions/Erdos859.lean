    (p : virtualPrimeUniverse A B n) (j : Fin n) :
    virtualPrimeBinIndex A B n p = j ↔ p.val ∈ virtualPrimeBand A B j.val := by
  constructor
  · intro h
    simpa only [h] using virtualPrimeBinIndex_mem A B n p
  · intro hp
    apply Fin.ext
    by_contra h
    exact (disjoint_left.mp (virtualPrimeBand_disjoint hB h))
      (virtualPrimeBinIndex_mem A B n p) hp

