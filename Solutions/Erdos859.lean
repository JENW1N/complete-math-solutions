theorem virtualPrime_intensity_mass_lower_explicit {n : ℕ} (hn : 0 < n)
    {A B lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ B * log 2) :
    B * log 2 / (2 * (A + B)) ≤
      ∑ p ∈ virtualPrimeUniverse A B n, primeLogOddsIntensity lam p := by
  have hxi := virtualPrime_relative_error_le_half hB hlarge
  have hcoef : (1 : ℝ) / 2 ≤ lam * (1 - virtualPrimeRelativeError B) := by nlinarith
  have hlog : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hden : 0 < 1 + A / B := by positivity
  have heq : B * log 2 / (2 * (A + B)) = (1 / 2 : ℝ) * (log 2 / (1 + A / B)) := by
    field_simp
    ring
  calc
    _ = (1 / 2 : ℝ) * (log 2 / (1 + A / B)) := heq
    _ ≤ (1 / 2 : ℝ) * virtualCoreBin A B 0 := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      simpa only [pow_zero, div_one] using virtualCoreBin_lower hA hB 0
    _ ≤ lam * (1 - virtualPrimeRelativeError B) * virtualCoreBin A B 0 :=
      mul_le_mul_of_nonneg_right hcoef (virtualCoreBin_pos hA hB 0).le
    _ ≤ ∑ p ∈ virtualPrimeBand A B 0, primeLogOddsIntensity lam p :=
      virtualPrime_intensity_mass_lower hA hB hbase hlam hlam2 0
    _ ≤ _ := by
      apply sum_le_sum_of_subset_of_nonneg (virtualPrimeBand_subset_universe A B hn)
      intro p hp _
      rw [virtualPrimeUniverse_eq_window hB] at hp
      exact (primeLogOddsIntensity_le_odds (zero_lt_one.trans_le hlam)
        (mem_primeLogWindow.mp hp).1).1

theorem virtualPrime_ballot_probability_explicit_lower {n : ℕ} (hn : 0 < n)
    {A B lam : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hbase : log 2 ≤ A + B)
    (hlam : 1 ≤ lam) (hlam2 : lam ≤ 2)
    (hlarge : 4 * primeLogOddsErrorConstant ≤ B * log 2)
    {J : ℕ} (hAB : A / B ≤ (2 : ℝ) ^ J) :
    exp (-(n : ℝ) * (lam * log 2 - 1 - log (lam * log 2)) -
      2 * lam * primeLogOddsErrorConstant / (A + B) -
      J * log (1 + A / B) - 2 - 2 * n * virtualPrimeRelativeError B) /
      (exp 1 * (n : ℝ) ^ 2) -
        (8 * (n : ℝ) ^ 2 * (A + B) / (B * log 2)) * exp (-(A + B)) ≤
      virtualPrimeBallotMass A B lam n := by
  classical
  let P := virtualPrimeUniverse A B n
  let M := ∑ p ∈ P, primeLogOddsIntensity lam p
  let W := ∑ x : Fin n → P with
    CyclicBallot (occupancyCount (fun i ↦ virtualPrimeBinIndex A B n (x i))),
      ∏ i, primeLogOddsIntensity lam (x i).val
  let alpha := 4 * exp (-(A + B)) / M
  have hM : 0 < M := virtualPrime_intensity_mass_pos hn hA hB hbase hlam hlam2 hlarge
  have halpha : 0 ≤ alpha := by dsimp [alpha]; positivity
  have hP (p : ℕ) (hp : p ∈ P) : p.Prime := by
    change p ∈ virtualPrimeUniverse A B n at hp
    rw [virtualPrimeUniverse_eq_window hB] at hp
    exact (mem_primeLogWindow.mp hp).1
  have hs := primeTilt_ballot_count_lower hP (zero_lt_one.trans_le hlam)
    (virtualPrimeBinIndex A B n) hM rfl halpha
    (fun _ hp ↦ virtualPrime_intensity_atom_le hB hlam hlam2 hM hp) (le_refl W)
  have hmain := virtualPrime_ballot_exponential_cost_lower hn hA hB hbase hlam hlam2 hlarge hAB
  have hdup : exp (-M) / (n.factorial : ℝ) * (M ^ n * ((n : ℝ) ^ 2 * alpha)) ≤
      (n : ℝ) ^ 2 * alpha := by
    calc
      _ = (exp (-M) * M ^ n / (n.factorial : ℝ)) * ((n : ℝ) ^ 2 * alpha) := by ring
      _ ≤ 1 * ((n : ℝ) ^ 2 * alpha) := mul_le_mul_of_nonneg_right
        (poisson_count_factor_le_one hM.le n) (by positivity)
      _ = _ := one_mul _
  have hlo : B * log 2 / (2 * (A + B)) ≤ M :=
    virtualPrime_intensity_mass_lower_explicit hn hA hB hbase hlam hlam2 hlarge
  have hlog : 0 < log (2 : ℝ) := log_pos (by norm_num)
  have hab : 0 < A + B := by positivity
  have ha : alpha ≤ (8 * (A + B) / (B * log 2)) * exp (-(A + B)) := by
    calc
      _ ≤ (4 * exp (-(A + B))) / (B * log 2 / (2 * (A + B))) :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hlo
      _ = _ := by field_simp; ring
  have he : (n : ℝ) ^ 2 * alpha ≤
      (8 * (n : ℝ) ^ 2 * (A + B) / (B * log 2)) * exp (-(A + B)) := by
    calc
      _ ≤ (n : ℝ) ^ 2 * ((8 * (A + B) / (B * log 2)) * exp (-(A + B))) :=
        mul_le_mul_of_nonneg_left ha (sq_nonneg (n : ℝ))
      _ = _ := by ring
  calc
    _ ≤ _ - (n : ℝ) ^ 2 * alpha := sub_le_sub_left he _
    _ ≤ exp (-M) / (n.factorial : ℝ) * W -
        exp (-M) / (n.factorial : ℝ) * (M ^ n * ((n : ℝ) ^ 2 * alpha)) :=
      sub_le_sub hmain hdup
    _ = exp (-M) / (n.factorial : ℝ) * (W - M ^ n * ((n : ℝ) ^ 2 * alpha)) := by ring
    _ ≤ _ := hs

end Erdos859Verification

end

