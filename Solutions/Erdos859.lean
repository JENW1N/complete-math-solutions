def signedCubeValue {ι : Type*} [Fintype ι] (w : ι → ℕ) (c : ι → ℤ) : ℤ :=
  ∑ i, c i * (w i : ℤ)

def IsProperSignedCube {ι : Type*} [Fintype ι] (w : ι → ℕ) (H : ℕ) : Prop :=
  ∀ c c' : ι → ℤ, (∀ i, |c i| ≤ (H : ℤ)) → (∀ i, |c' i| ≤ (H : ℤ)) →
    signedCubeValue w c = signedCubeValue w c' → c = c'

noncomputable def signedCoefficientBox (ι : Type*) [Fintype ι] (H : ℕ) :
    Finset (ι → ℤ) := by
  classical
  exact Fintype.piFinset (fun _ : ι ↦ Icc (-(H : ℤ)) (H : ℤ))

