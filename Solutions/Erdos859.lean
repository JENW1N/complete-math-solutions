theorem divisorCubeWeight_pos {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    (U : DivisorCubeCoordinate P) : 0 < divisorCubeWeight P U :=
  prod_pos (fun p hp ↦ (hP p (mem_powerset.mp U.property hp)).pos)

theorem squarefree_divisorCubeProduct {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) :
    Squarefree (∏ p ∈ P, p) := by
  refine squarefree_prod_of_pairwise_isCoprime (fun p hp q hq hpq ↦ ?_)
    (fun p hp ↦ (hP p hp).squarefree)
  change IsRelPrime p q
  rw [← Nat.coprime_iff_isRelPrime]
  exact (Nat.coprime_primes (hP p hp) (hP q hq)).mpr hpq

theorem divisorCubeWeight_injective {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) :
    Function.Injective (divisorCubeWeight P) := by
  intro U V hUV
  apply Subtype.ext
  have hU : (divisorCubeWeight P U).primeFactors = U.val :=
    Nat.primeFactors_prod (fun p hp ↦ hP p (mem_powerset.mp U.property hp))
  have hV : (divisorCubeWeight P V).primeFactors = V.val :=
    Nat.primeFactors_prod (fun p hp ↦ hP p (mem_powerset.mp V.property hp))
  rw [← hU, ← hV, hUV]

/-- These coordinates enumerate all positive divisors, without multiplicity. -/
theorem image_divisorCubeWeight {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) :
    univ.image (divisorCubeWeight P) = (∏ p ∈ P, p).divisors := by
  have hprod := squarefree_divisorCubeProduct hP
  ext d
  constructor
  · intro hd
    obtain ⟨U, _, rfl⟩ := mem_image.mp hd
    exact Nat.mem_divisors.mpr ⟨divisorCubeWeight_dvd P U, hprod.ne_zero⟩
  · intro hd
    have hdiv := (Nat.mem_divisors.mp hd).1
    have hsub : d.primeFactors ⊆ P := by
      have h := Nat.primeFactors_mono hdiv hprod.ne_zero
      rwa [Nat.primeFactors_prod hP] at h
    refine mem_image.mpr ⟨⟨d.primeFactors, mem_powerset.mpr hsub⟩, mem_univ _, ?_⟩
    exact Nat.prod_primeFactors_of_squarefree (hprod.squarefree_of_dvd hdiv)

theorem sum_divisors_primeProduct {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) :
    (∑ d ∈ (∏ p ∈ P, p).divisors, d) = ∏ p ∈ P, (1 + p) := by
  rw [← image_divisorCubeWeight hP, sum_image]
  · exact sum_divisorCubeWeight P
  · exact fun _ _ _ _ h ↦ divisorCubeWeight_injective hP h

theorem log_divisorCubeProduct {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime) :
    log ((∏ p ∈ P, p : ℕ) : ℝ) = ∑ p ∈ P, log (p : ℝ) := by
  rw [Nat.cast_prod, Real.log_prod]
  intro p hp
  exact_mod_cast (hP p hp).ne_zero

theorem sum_divisorCubeWeight_le_product_sq {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) :
    (∑ U : DivisorCubeCoordinate P, divisorCubeWeight P U) ≤ (∏ p ∈ P, p) ^ 2 := by
  rw [sum_divisorCubeWeight, ← prod_pow]
  apply prod_le_prod (fun _ _ ↦ Nat.zero_le _)
  intro p hp
  have h := (hP p hp).two_le
  nlinarith

theorem sum_divisorCubeWeight_insert (P : Finset ℕ) (p : ℕ) (hp : p ∉ P) :
    (∑ U : DivisorCubeCoordinate (insert p P), divisorCubeWeight (insert p P) U) =
      (1 + p) * ∑ U : DivisorCubeCoordinate P, divisorCubeWeight P U := by
  rw [sum_divisorCubeWeight, sum_divisorCubeWeight, prod_insert hp]

theorem isProper_divisorCube_empty (H : ℕ) :
    IsProperSignedCube (divisorCubeWeight ∅) H := by
  intro c c' _hc _hc' heq
  funext U
  have hU : U.val = ∅ := subset_empty.mp (mem_powerset.mp U.property)
  have hall (V : DivisorCubeCoordinate ∅) : V = U := by
    apply Subtype.ext
    exact (subset_empty.mp (mem_powerset.mp V.property)).trans hU.symm
  have hsum (a : DivisorCubeCoordinate ∅ → ℤ) :
      signedCubeValue (divisorCubeWeight ∅) a = a U := by
    unfold signedCubeValue
    rw [sum_eq_single U]
    · simp [divisorCubeWeight, hU]
    · intro V _ hne
      exact False.elim (hne (hall V))
    · intro h
      exact False.elim (h (mem_univ U))
  rwa [hsum, hsum] at heq

def divisorCubeInsertMap (P : Finset ℕ) (p : ℕ) :
    DivisorCubeCoordinate P ⊕ DivisorCubeCoordinate P → DivisorCubeCoordinate (insert p P)
  | .inl U => ⟨U.val, mem_powerset.mpr ((mem_powerset.mp U.property).trans (subset_insert _ _))⟩
  | .inr U => ⟨insert p U.val, mem_powerset.mpr (insert_subset_insert p (mem_powerset.mp U.property))⟩

theorem divisorCubeInsertMap_bijective (P : Finset ℕ) (p : ℕ) (hp : p ∉ P) :
    Function.Bijective (divisorCubeInsertMap P p) := by
  have hnot (U : DivisorCubeCoordinate P) : p ∉ U.val :=
    fun h ↦ hp (mem_powerset.mp U.property h)
  constructor
  · intro X Y hXY
    have heq := congrArg Subtype.val hXY
    cases X with
    | inl U =>
      cases Y with
      | inl V => exact congrArg Sum.inl (Subtype.ext heq)
      | inr V =>
        change U.val = insert p V.val at heq
        exact False.elim (hnot U (heq.symm ▸ mem_insert_self p V.val))
    | inr U =>
      cases Y with
      | inl V =>
        change insert p U.val = V.val at heq
        exact False.elim (hnot V (heq ▸ mem_insert_self p U.val))
      | inr V =>
        change insert p U.val = insert p V.val at heq
        have he := congrArg (fun S : Finset ℕ ↦ S.erase p) heq
        simp only [erase_insert (hnot U), erase_insert (hnot V)] at he
        exact congrArg Sum.inr (Subtype.ext he)
  · intro U
    by_cases hpu : p ∈ U.val
    · have hsub : U.val.erase p ⊆ P := by
        intro q hq
        have h := mem_powerset.mp U.property (mem_erase.mp hq).2
        rcases mem_insert.mp h with h | h
        · exact False.elim ((mem_erase.mp hq).1 h)
        · exact h
      refine ⟨.inr ⟨U.val.erase p, mem_powerset.mpr hsub⟩, ?_⟩
      apply Subtype.ext
      exact insert_erase hpu
    · have hsub : U.val ⊆ P := by
        intro q hq
        rcases mem_insert.mp (mem_powerset.mp U.property hq) with h | h
        · exact False.elim (hpu (h ▸ hq))
        · exact h
      exact ⟨.inl ⟨U.val, mem_powerset.mpr hsub⟩, Subtype.ext rfl⟩

noncomputable def divisorCubeInsertEquiv (P : Finset ℕ) (p : ℕ) (hp : p ∉ P) :
    DivisorCubeCoordinate P ⊕ DivisorCubeCoordinate P ≃ DivisorCubeCoordinate (insert p P) :=
  Equiv.ofBijective (divisorCubeInsertMap P p) (divisorCubeInsertMap_bijective P p hp)

theorem divisorCubeWeight_insert_equiv (P : Finset ℕ) (p : ℕ) (hp : p ∉ P)
    (U : DivisorCubeCoordinate P ⊕ DivisorCubeCoordinate P) :
    divisorCubeWeight (insert p P) (divisorCubeInsertEquiv P p hp U) =
      doubledCubeWeight (divisorCubeWeight P) p U := by
  cases U with
  | inl U => rfl
  | inr U =>
    exact prod_insert (fun h ↦ hp (mem_powerset.mp U.property h))

theorem signedCubeValue_comp_equiv {ι κ : Type*} [Fintype ι] [Fintype κ]
    (e : ι ≃ κ) (w : κ → ℕ) (c : κ → ℤ) :
    signedCubeValue (fun i ↦ w (e i)) (fun i ↦ c (e i)) = signedCubeValue w c :=
  e.sum_comp (fun j ↦ c j * (w j : ℤ))

theorem isProperSignedCube_comp_equiv {ι κ : Type*} [Fintype ι] [Fintype κ]
    (e : ι ≃ κ) (w : κ → ℕ) (H : ℕ) :
    IsProperSignedCube (fun i ↦ w (e i)) H ↔ IsProperSignedCube w H := by
  constructor
  · intro h c c' hc hc' heq
    have hcoeff := h (fun i ↦ c (e i)) (fun i ↦ c' (e i))
      (fun i ↦ hc (e i)) (fun i ↦ hc' (e i)) (by
        rw [signedCubeValue_comp_equiv, signedCubeValue_comp_equiv]
        exact heq)
    funext j
    simpa only [Equiv.apply_symm_apply] using congrFun hcoeff (e.symm j)
  · intro h c c' hc hc' heq
    have hsum (a : ι → ℤ) :
        signedCubeValue w (fun j ↦ a (e.symm j)) =
          signedCubeValue (fun i ↦ w (e i)) a := by
      symm
      simpa only [Equiv.symm_apply_apply] using
        signedCubeValue_comp_equiv e w (fun j ↦ a (e.symm j))
    have hcoeff := h (fun j ↦ c (e.symm j)) (fun j ↦ c' (e.symm j))
      (fun j ↦ hc (e.symm j)) (fun j ↦ hc' (e.symm j)) (by
        rw [hsum, hsum]
        exact heq)
    funext i
    simpa only [Equiv.symm_apply_apply] using congrFun hcoeff (e i)

/-- Adjoining a fresh prime is exactly the doubled divisor cube. -/
theorem isProper_divisorCube_insert_iff (P : Finset ℕ) (p : ℕ) (hp : p ∉ P) (H : ℕ) :
    IsProperSignedCube (divisorCubeWeight (insert p P)) H ↔
      IsProperSignedCube (doubledCubeWeight (divisorCubeWeight P) p) H := by
  have h := isProperSignedCube_comp_equiv (divisorCubeInsertEquiv P p hp)
    (divisorCubeWeight (insert p P)) H
  have hw : (fun U ↦ divisorCubeWeight (insert p P) (divisorCubeInsertEquiv P p hp U)) =
      doubledCubeWeight (divisorCubeWeight P) p := by
    funext U
    exact divisorCubeWeight_insert_equiv P p hp U
  rw [hw] at h
  exact h.symm

theorem notproper_divisorCube_insert_dvd_difference (P : Finset ℕ)
    {H p : ℕ} (hproper : IsProperSignedCube (divisorCubeWeight P) H)
    (hp : p ∉ P) (hp0 : p ≠ 0)
    (hbad : ¬ IsProperSignedCube (divisorCubeWeight (insert p P)) H) :
    ∃ m ∈ positiveSignedCubeDifferences (divisorCubeWeight P) H, p ∣ m := by
  apply notproper_doubledCube_dvd_difference (divisorCubeWeight P) hproper hp0
  exact fun h ↦ hbad ((isProper_divisorCube_insert_iff P p hp H).mpr h)

theorem positive_divisorCube_difference_bounds (P : Finset ℕ) (H : ℕ)
    {m : ℕ} (hm : m ∈ positiveSignedCubeDifferences (divisorCubeWeight P) H) :
    0 < m ∧ m ≤ 2 * H * ∏ p ∈ P, (1 + p) := by
  simpa only [sum_divisorCubeWeight] using
    positiveSignedCubeDifferences_bounds (divisorCubeWeight P) H hm

theorem positive_divisorCube_differences_card_le (P : Finset ℕ) (H : ℕ) :
    (positiveSignedCubeDifferences (divisorCubeWeight P) H).card ≤ (4 * H + 1) ^ (2 ^ P.card) := by
  simpa only [card_divisorCubeCoordinate] using
    positiveSignedCubeDifferences_card_le (divisorCubeWeight P) H

end Erdos859Verification

end

/- Inlined development module: FordDivisorIntervals.lean -/

section

/- Finite covering bounds for thickened logarithmic subset sums. -/

open Finset Real MeasureTheory

namespace Erdos859Verification

/-- Fixing the selected elements outside `S` puts all remaining subset sums
inside one interval of length `d + sum_{p in S} log p`. -/
theorem primeSubsetSumSupport_complement_cover (T S : Finset ℕ) (d : ℝ) :
    primeSubsetSumSupport T d ⊆
      ⋃ U : (T \ S).powerset,
        Set.Icc (∑ p ∈ (U : Finset ℕ), log (p : ℝ))
          ((∑ p ∈ (U : Finset ℕ), log (p : ℝ)) +
            (∑ p ∈ S, log (p : ℝ)) + d) := by
  intro y hy
  obtain ⟨V, hVT, hVy⟩ := mem_primeSubsetSumSupport.mp hy
  have hVS : V \ S ⊆ T \ S := by
    intro p hp
    exact mem_sdiff.mpr ⟨hVT (mem_sdiff.mp hp).1, (mem_sdiff.mp hp).2⟩
  apply Set.mem_iUnion.mpr
  refine ⟨⟨V \ S, mem_powerset.mpr hVS⟩, ?_⟩
  have hsplit := sum_inter_add_sum_sdiff V S (fun p ↦ log (p : ℝ))
  have hnonneg : 0 ≤ ∑ p ∈ V ∩ S, log (p : ℝ) :=
    sum_nonneg (fun p _ ↦ Real.log_natCast_nonneg p)
  have hsum : (∑ p ∈ V ∩ S, log (p : ℝ)) ≤ ∑ p ∈ S, log (p : ℝ) :=
    sum_le_sum_of_subset_of_nonneg inter_subset_right
      (fun p _ _ ↦ Real.log_natCast_nonneg p)
  exact ⟨by dsimp; linarith [hVy.1], by dsimp; linarith [hVy.2]⟩

/-- A choice of a small-prime core yields the clustering upper bound.  This is
valid for every finite set of natural labels, without a primality assumption. -/
theorem primeSubsetSumSupport_measure_le_complement (T S : Finset ℕ)
    {d : ℝ} (hd : 0 ≤ d) :
    volume.real (primeSubsetSumSupport T d) ≤
      (2 : ℝ) ^ (T \ S).card * ((∑ p ∈ S, log (p : ℝ)) + d) := by
  classical
  let c : (T \ S).powerset → ℝ := fun U ↦ ∑ p ∈ (U : Finset ℕ), log (p : ℝ)
  let L : ℝ := (∑ p ∈ S, log (p : ℝ)) + d
  have hL : 0 ≤ L := add_nonneg (sum_nonneg (fun p _ ↦ Real.log_natCast_nonneg p)) hd
  have hcompact : IsCompact (⋃ U : (T \ S).powerset, Set.Icc (c U) (c U + L)) :=
    isCompact_iUnion (fun _ ↦ isCompact_Icc)
  have hcover : primeSubsetSumSupport T d ⊆
      ⋃ U : (T \ S).powerset, Set.Icc (c U) (c U + L) := by
    simpa only [c, L, add_assoc] using primeSubsetSumSupport_complement_cover T S d
  calc
    _ ≤ volume.real (⋃ U : (T \ S).powerset, Set.Icc (c U) (c U + L)) :=
      measureReal_mono hcover hcompact.measure_ne_top
    _ ≤ ∑ U : (T \ S).powerset, volume.real (Set.Icc (c U) (c U + L)) :=
      measureReal_iUnion_fintype_le _
    _ = _ := by simp [Real.volume_real_Icc, max_eq_left hL, L, mul_add]

/-- The form used for ordered prime prefixes in Ford's divisor-interval bound. -/
theorem primeSubsetSumSupport_measure_le_core {T S : Finset ℕ} (hST : S ⊆ T)
    {d : ℝ} (hd : 0 ≤ d) :
    volume.real (primeSubsetSumSupport T d) ≤
      (2 : ℝ) ^ (T.card - S.card) * ((∑ p ∈ S, log (p : ℝ)) + d) := by
  simpa only [card_sdiff_of_subset hST] using
    primeSubsetSumSupport_measure_le_complement T S hd

theorem primeSubsetSumSupport_measure_le_card (T : Finset ℕ) {d : ℝ} (hd : 0 ≤ d) :
    volume.real (primeSubsetSumSupport T d) ≤ (2 : ℝ) ^ T.card * d := by
  simpa using primeSubsetSumSupport_measure_le_complement T ∅ hd

theorem primeSubsetSumSupport_measure_le_span (T : Finset ℕ) {d : ℝ} (hd : 0 ≤ d) :
    volume.real (primeSubsetSumSupport T d) ≤ (∑ p ∈ T, log (p : ℝ)) + d := by
  simpa using primeSubsetSumSupport_measure_le_complement T T hd

end Erdos859Verification

end

