    (w atom : ι → ℝ) (d : ℝ) :
    (∫ y, finiteIntervalSmoothing w atom d y ^ 2) =
      ∑ i, ∑ j, (w i * w j) * (max (d - |atom i - atom j|) 0 / d ^ 2) := by
  simp_rw [finiteIntervalSmoothing_sq_eq]
  rw [integral_finsetSum univ (fun i _ ↦ integrable_finsetSum univ (fun j _ ↦
    (integrable_intervalSmoothingKernel_mul d (atom i) (atom j)).const_mul (w i * w j)))]
  apply sum_congr rfl
  intro i _
  rw [integral_finsetSum univ (fun j _ ↦
    (integrable_intervalSmoothingKernel_mul d (atom i) (atom j)).const_mul (w i * w j))]
  simp_rw [integral_const_mul, integral_intervalSmoothingKernel_mul]

theorem intervalSmoothing_overlap_le_collision {d : ℝ} (hd : 0 < d) (x z : ℝ) :
    max (d - |x - z|) 0 / d ^ 2 ≤ (if |x - z| ≤ d then 1 else 0) / d := by
  by_cases hxz : |x - z| ≤ d
  · rw [if_pos hxz, max_eq_left (sub_nonneg.mpr hxz)]
    calc
      (d - |x - z|) / d ^ 2 ≤ d / d ^ 2 :=
        div_le_div_of_nonneg_right (by linarith [abs_nonneg (x - z)]) (sq_nonneg d)
      _ = 1 / d := by field_simp [hd.ne']
  · rw [if_neg hxz, max_eq_right (by linarith : d - |x - z| ≤ 0)]
