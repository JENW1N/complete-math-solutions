/- Component ClosureInputModel; SHA256 3aaafcaf11f9c588d0552d8a0dda8bec88297a92528ac1d84f674aafb612ba85. -/
section PolicySubmissionPart70
/- Input slots and local semantic bridges for the original assertion prefix. -/

namespace ClosureInputModel
open ClosureSemantics

noncomputable def inputValuation (X Y : Rat) (p : Nat → Prop) (r : Nat → Rat) : Valuation :=
  fun slot =>
    if slot = 0 then ratValue X
    else if slot = 1 then ratValue Y
    else if slot % 2 = 0 then
      boolValue (@decide (p ((slot - 2) / 2)) (Classical.propDecidable _))
    else ratValue (r ((slot - 3) / 2))

def programModel_eq_raw (raw : Nat → Node) (input : Valuation) (i : Nat)
    (h : ∀ j ∈ (raw i).children, j < i) :
    programModel raw input i = evalNode input (programModel raw input) (raw i) := by
  simpa only [boundedProgram_eq raw i h] using programModel_equations raw input i

def programModel_agrees_below (raw : Nat → Node) (input values : Valuation) (N : Nat)
    (h : ∀ i < N, values i = evalNode input values (boundedProgram raw i)) :
    ∀ i < N, programModel raw input i = values i := by
  intro i
  induction i using Nat.strong_induction_on with
  | h i ih =>
    intro hi
    calc
      programModel raw input i = evalNode input (programModel raw input) (boundedProgram raw i) :=
        programModel_equations raw input i
      _ = evalNode input values (boundedProgram raw i) := by
        apply evalNode_congr
        intro j hj
        have hji := boundedProgram_children raw i j hj
        exact ih j hji (hji.trans hi)
      _ = values i := (h i hi).symm

end ClosureInputModel

end PolicySubmissionPart70

/- Component ClosurePrefixAdapter; SHA256 7955e120dba069fa5b9136f79741f570bbedf0ed6857d55001eaa9978a189e4a. -/
section PolicySubmissionPart71
/- A short-record prefix adapter, whose records can be checked against packed data. -/
namespace ClosurePrefixAdapter
open ClosureSemantics ClosurePackedProgram PackedNatTable

abbrev Pattern := Op × List Nat

def interval_from_fin {P : Nat → Prop} (a n : Nat)
    (h : ∀ i : Fin n, P (a + i.val)) : ∀ i, a ≤ i → i < a+n → P i := by
  intro i ha hi
  simpa only [Nat.add_sub_of_le ha] using h ⟨i-a, by omega⟩

def interval_join {P : Nat → Prop} (a b c : Nat)
    (left : ∀ i, a ≤ i → i < b → P i)
    (right : ∀ i, b ≤ i → i < c → P i) : ∀ i, a ≤ i → i < c → P i := by
  intro i ha hc
  by_cases hb : i < b
  · exact left i ha hb
  · exact right i (by omega) hc

def zigzag : Int → Nat
  | .ofNat n => 2 * n
  | .negSucc n => 2 * n + 1

def Pattern.record (p : Pattern) : List Nat :=
  match p.1 with
  | .input k => [2,k]
  | .qConst q => [3,zigzag q.num,q.den]
  | .zConst z => [4,zigzag z]
  | .bConst false => [0]
  | .bConst true => [1]
  | .alias => 5 :: p.2
  | .bNot => 6 :: p.2
  | .bOr => 7 :: p.2
  | .bAnd => 8 :: p.2
  | .bEq => 9 :: p.2
  | .ite => 10 :: p.2
  | .qEq => 11 :: p.2
  | .zEq => 12 :: p.2
  | .qLe => 13 :: p.2
  | .zLe => 14 :: p.2
  | .qLt => 15 :: p.2
  | .zLt => 16 :: p.2
  | .qAdd => 17 :: p.2
  | .zAdd => 18 :: p.2
  | .qMul => 19 :: p.2
  | .zMul => 20 :: p.2
  | .qNeg => 21 :: p.2
  | .zNeg => 22 :: p.2
  | .qSub => 23 :: p.2
  | .zSub => 24 :: p.2
  | .qDiv => 25 :: p.2

def Pattern.node (p : Pattern) (i : Nat) : Node :=
  match p.1 with
  | .input k => ⟨.input k, []⟩
  | .qConst q => ⟨.qConst q, []⟩
  | .zConst z => ⟨.zConst z, []⟩
  | .bConst b => ⟨.bConst b, []⟩
  | op => ⟨op, p.2.map (fun d => i - d)⟩

def indexAt (indices : Table Nat) (i : Nat) : Nat :=
  (indices.get 0 (i / 4) >>> (12 * (i % 4))) &&& 0xfff

def patternAt (dictionary : Table Pattern) (indices : Table Nat) (i : Nat) : Pattern :=
  dictionary.get ⟨.bConst false, []⟩ (indexAt indices i)

def program (dictionary : Table Pattern) (indices : Table Nat) (i : Nat) : Node :=
  (patternAt dictionary indices i).node i

def check (source : Nat → Node) (dictionary : Table Pattern) (indices : Table Nat)
    (N i : Nat) : Bool :=
  if 0 < indexAt indices i then
    (ClosurePattern.sameOp (source i).op (program dictionary indices i).op &&
      ((source i).children == (program dictionary indices i).children)) &&
      (program dictionary indices i).children.all
        (fun j => decide (j < N ∧ 0 < indexAt indices j))
  else true

def check_sound (source : Nat → Node) (dictionary : Table Pattern) (indices : Table Nat)
    (N i : Nat) (h : check source dictionary indices N i = true) (hi : 0 < indexAt indices i) :
    source i = program dictionary indices i ∧
      ∀ j ∈ (program dictionary indices i).children, j < N ∧ 0 < indexAt indices j := by
  simp only [check, if_pos hi, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  have ho := ClosurePattern.sameOp_sound _ _ h.1.1
  have hc : (source i).children = (program dictionary indices i).children := by
    simpa using h.1.2
  refine ⟨?_, h.2⟩
  have he : source i = ⟨(source i).op, (source i).children⟩ := rfl
  rw [he, ho, hc]

def model_eq_on_raw (source target : Nat → Node) (input : Valuation) (N : Nat)
    (S : Nat → Prop)
    (hshape : ∀ i < N, S i → source i = target i)
    (hclosed : ∀ i < N, S i → ∀ j ∈ (target i).children, j < N ∧ S j) :
    ∀ i < N, S i → programModel source input i = programModel target input i := by
  intro i
  induction i using Nat.strong_induction_on with
  | h i ih =>
    intro hi hs
    rw [programModel_equations source input i, programModel_equations target input i]
    have hb : boundedProgram source i = boundedProgram target i := by
      unfold boundedProgram
      rw [hshape i hi hs]
    rw [hb]
    apply evalNode_congr
    intro j hj
    have hji := boundedProgram_children target i j hj
    have hjraw : j ∈ (target i).children := List.mem_of_mem_filter hj
    have hjc := hclosed i hi hs j hjraw
    exact ih j hji hjc.1 hjc.2

def checked_model_eq (source : Nat → Node) (dictionary : Table Pattern)
    (indices : Table Nat) (input : Valuation) (N : Nat)
    (h : ∀ i < N, check source dictionary indices N i = true) :
    ∀ i < N, 0 < indexAt indices i →
      programModel source input i = programModel (program dictionary indices) input i := by
  apply model_eq_on_raw source (program dictionary indices) input N (fun i => 0 < indexAt indices i)
  · intro i hi hs
    exact (check_sound source dictionary indices N i (h i hi) hs).1
  · intro i hi hs
    exact (check_sound source dictionary indices N i (h i hi) hs).2

end ClosurePrefixAdapter

end PolicySubmissionPart71

