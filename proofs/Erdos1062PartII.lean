section PolicySubmissionPart4
/- Propositional semantics of the transparent signed-clause input representation. -/

namespace Bounty
open Std.Sat Std.Tactic.BVDecide.LRAT Std.Tactic.BVDecide.LRAT.Internal

def policySignedHolds (P : Nat → Prop) (z : Int) : Prop :=
  if 0 < z then P z.natAbs else ¬ P z.natAbs

def policySignedClauseHolds (P : Nat → Prop) (c : List Int) : Prop :=
  ∃ z ∈ c, policySignedHolds P z

end Bounty

