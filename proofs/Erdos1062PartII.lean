/- Decision-instance independent elementary input reflection. -/
namespace ClosureInputReflection
open ClosureSemantics

def boolValue_decide_irrel (p : Prop) (d e : Decidable p) :
    boolValue (@decide p d) = boolValue (@decide p e) :=
  congrArg (fun dec : Decidable p => boolValue (@decide p dec)) (Subsingleton.elim _ _)

