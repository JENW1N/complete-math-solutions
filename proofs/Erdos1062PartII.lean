def zeroValue : Value := ⟨false, 0, 0⟩
def boolValue (b : Bool) : Value := ⟨b, 0, 0⟩
def intValue (z : Int) : Value := ⟨false, z, 0⟩
def ratValue (q : Rat) : Value := ⟨false, 0, q⟩

abbrev Valuation := Nat → Value

inductive Op where
  | input : Nat → Op
  | qConst : Rat → Op
  | zConst : Int → Op
  | bConst : Bool → Op
  | alias | bNot | bOr | bAnd | bEq | ite
  | qEq | zEq | qLe | zLe | qLt | zLt
  | qAdd | zAdd | qMul | zMul | qNeg | zNeg | qSub | zSub | qDiv

structure Node where
  op : Op
  children : List Nat

def evalOp (input : Valuation) : Op → List Value → Value
  | .input k, _ => input k
  | .qConst c, _ => ratValue c
  | .zConst c, _ => intValue c
  | .bConst c, _ => boolValue c
  | .alias, [a] => a
  | .bNot, [a] => boolValue (!a.b)
  | .bOr, xs => boolValue ((xs.map Value.b).any id)
  | .bAnd, xs => boolValue ((xs.map Value.b).all id)
  | .bEq, [a, b] => boolValue (a.b == b.b)
  | .ite, [c, a, b] => if c.b then a else b
  | .qEq, [a, b] => boolValue (decide (a.q = b.q))
  | .zEq, [a, b] => boolValue (decide (a.z = b.z))
  | .qLe, [a, b] => boolValue (decide (a.q ≤ b.q))
  | .zLe, [a, b] => boolValue (decide (a.z ≤ b.z))
  | .qLt, [a, b] => boolValue (decide (a.q < b.q))
  | .zLt, [a, b] => boolValue (decide (a.z < b.z))
  | .qAdd, a :: rest => ratValue ((rest.map Value.q).foldl (· + ·) a.q)
  | .zAdd, a :: rest => intValue ((rest.map Value.z).foldl (· + ·) a.z)
  | .qMul, a :: rest => ratValue ((rest.map Value.q).foldl (· * ·) a.q)
  | .zMul, a :: rest => intValue ((rest.map Value.z).foldl (· * ·) a.z)
  | .qAdd, [] => ratValue 0
  | .zAdd, [] => intValue 0
  | .qMul, [] => ratValue 1
  | .zMul, [] => intValue 1
  | .qNeg, [a] => ratValue (-a.q)
  | .zNeg, [a] => intValue (-a.z)
  | .qSub, a :: rest => ratValue ((rest.map Value.q).foldl (· - ·) a.q)
  | .zSub, a :: rest => intValue ((rest.map Value.z).foldl (· - ·) a.z)
  | .qDiv, [a, b] => ratValue (a.q / b.q)
  | _, _ => zeroValue

def evalNode (input values : Valuation) (node : Node) : Value :=
  evalOp input node.op (node.children.map values)

def evalNode_congr (input values other : Valuation) (node : Node)
    (h : ∀ j ∈ node.children, values j = other j) :
    evalNode input values node = evalNode input other node := by
  unfold evalNode
  congr 1
  exact List.map_congr_left h

def interpret (program : Nat → Node) (input : Valuation) : Valuation :=
  Nat.lt_wfRel.wf.fix fun i previous =>
    evalNode input (fun j => if h : j < i then previous j h else zeroValue) (program i)

def interpret_eq (program : Nat → Node) (input : Valuation) (i : Nat)
    (h : ∀ j ∈ (program i).children, j < i) :
    interpret program input i = evalNode input (interpret program input) (program i) := by
  rw [interpret, WellFounded.fix_eq]
  apply evalNode_congr
  intro j hj
  rw [dif_pos (h j hj)]

def Equations (program : Nat → Node) (input values : Valuation) : Prop :=
  ∀ i, values i = evalNode input values (program i)

def interpret_equations (program : Nat → Node) (input : Valuation)
    (h : ∀ i, ∀ j ∈ (program i).children, j < i) :
    Equations program input (interpret program input) := by
  intro i
  exact interpret_eq program input i (h i)

end ClosureSemantics

end PolicySubmissionPart1

