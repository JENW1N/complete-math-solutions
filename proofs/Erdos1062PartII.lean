/- Component PolicyMathDensity; SHA256 eeaf1f08fd54d7d7665239bb4f60425bc6e1891adf1f02d57e55bdd2cce633df. -/
section PolicySubmissionPart89
/- Standalone proof of an integer polynomial index lemma.
This does not prove the Subspace Theorem or the Erdős1062(ii) target. -/

/- Component: PolynomialDegreeEchelon; SHA256 506fd270ae0af8512f5b657399384081a522482e4715dcb43bcef2af75b92760 -/
section RothComponent_PolynomialDegreeEchelon
/- A constant invertible row transformation makes polynomial degrees distinct. -/

open Polynomial

namespace Bounty

noncomputable section

def polynomialRowCombination {k : ℕ} (f : Fin k → ℚ[X])
    (A : Matrix (Fin k) (Fin k) ℚ) (i : Fin k) : ℚ[X] :=
  ∑ j, A i j • f j

def polynomialRowCombination_ne_zero {k : ℕ} (f : Fin k → ℚ[X])
    (hf : LinearIndependent ℚ f) (A : Matrix (Fin k) (Fin k) ℚ)
    (hA : A.det ≠ 0) (i : Fin k) : polynomialRowCombination f A i ≠ 0 := by
  intro hi
  have hrow : ∀ j, A i j = 0 := Fintype.linearIndependent_iff.mp hf (A i) hi
  exact hA (Matrix.det_eq_zero_of_row_eq_zero i hrow)

def polynomialRowCombination_updateRow {k : ℕ} (f : Fin k → ℚ[X])
    (A : Matrix (Fin k) (Fin k) ℚ) (i j : Fin k) (c : ℚ) :
    polynomialRowCombination f (A.updateRow i (A i + c • A j)) i =
      polynomialRowCombination f A i + c • polynomialRowCombination f A j := by
  simp only [polynomialRowCombination, Matrix.updateRow_self, Pi.add_apply, Pi.smul_apply,
    add_smul, Finset.sum_add_distrib, Finset.smul_sum, smul_smul, smul_eq_mul]

/-- Cancel the leading coefficient of two equal-degree polynomials. A nonzero
result has strictly smaller natural degree, including the degree-zero edge case. -/
def polynomial_natDegree_cancel_lead {p q : ℚ[X]} (hq : q ≠ 0)
    (hd : p.natDegree = q.natDegree)
    (hnew : p + (-(p.leadingCoeff / q.leadingCoeff)) • q ≠ 0) :
    (p + (-(p.leadingCoeff / q.leadingCoeff)) • q).natDegree < p.natDegree := by
  let c : ℚ := -(p.leadingCoeff / q.leadingCoeff)
  change (p + c • q).natDegree < p.natDegree
  have hle : (p + c • q).natDegree ≤ p.natDegree := by
    apply (Polynomial.natDegree_add_le _ _).trans
    apply max_le le_rfl
    exact (Polynomial.natDegree_smul_le c q).trans hd.symm.le
  have hc : (p + c • q).coeff p.natDegree = 0 := by
    rw [Polynomial.coeff_add, Polynomial.coeff_smul, Polynomial.coeff_natDegree, hd,
      Polynomial.coeff_natDegree]
    simp only [c, smul_eq_mul]
    field_simp [Polynomial.leadingCoeff_ne_zero.mpr hq]
    ring
  have hne : (p + c • q).natDegree ≠ p.natDegree := by
    intro he
    apply Polynomial.leadingCoeff_ne_zero.mpr hnew
    change (p + c • q).coeff (p + c • q).natDegree = 0
    rw [he]
    exact hc
  omega

/-- Every finite independent rational polynomial family has an invertible constant
change of basis whose resulting polynomials have pairwise distinct natural degrees.
The matrix acts on rows: `g i = ∑ j, A i j • f j`. -/
def polynomial_degree_echelon {k : ℕ} (f : Fin k → ℚ[X])
    (hf : LinearIndependent ℚ f) :
    ∃ A : Matrix (Fin k) (Fin k) ℚ, ∃ g : Fin k → ℚ[X],
      A.det ≠ 0 ∧ (∀ i, g i = ∑ j, A i j • f j) ∧
      (∀ i, g i ≠ 0) ∧ Function.Injective (fun i => (g i).natDegree) := by
  classical
  let measure : Matrix (Fin k) (Fin k) ℚ → ℕ :=
    fun A => ∑ i, (polynomialRowCombination f A i).natDegree
  have hex : ∃ n : ℕ, ∃ A : Matrix (Fin k) (Fin k) ℚ, A.det = 1 ∧ measure A = n :=
    ⟨measure 1, 1, by simp, rfl⟩
  obtain ⟨A, hA, hmeasure⟩ := Nat.find_spec hex
  have hmin (B : Matrix (Fin k) (Fin k) ℚ) (hB : B.det = 1) : measure A ≤ measure B := by
    rw [hmeasure]
    exact Nat.find_min' hex ⟨B, hB, rfl⟩
  have hA0 : A.det ≠ 0 := by rw [hA]; norm_num
  have hnonzero := polynomialRowCombination_ne_zero f hf A hA0
  refine ⟨A, polynomialRowCombination f A, hA0, fun _ => rfl, hnonzero, ?_⟩
  intro i j hd
  by_contra hij
  let c : ℚ := -((polynomialRowCombination f A i).leadingCoeff /
    (polynomialRowCombination f A j).leadingCoeff)
  let B : Matrix (Fin k) (Fin k) ℚ := A.updateRow i (A i + c • A j)
  have hB : B.det = 1 := (Matrix.det_updateRow_add_smul_self A hij c).trans hA
  have hBi : polynomialRowCombination f B i =
      polynomialRowCombination f A i + c • polynomialRowCombination f A j :=
    polynomialRowCombination_updateRow f A i j c
  have hBnz : polynomialRowCombination f B i ≠ 0 :=
    polynomialRowCombination_ne_zero f hf B (by rw [hB]; norm_num) i
  have hlt : (polynomialRowCombination f B i).natDegree <
      (polynomialRowCombination f A i).natDegree := by
    rw [hBi] at hBnz ⊢
    exact polynomial_natDegree_cancel_lead (hnonzero j) hd hBnz
  have hBt (t : Fin k) (hti : t ≠ i) :
      polynomialRowCombination f B t = polynomialRowCombination f A t := by
    simp only [polynomialRowCombination, B, Matrix.updateRow_ne hti]
  have hdrop : measure B < measure A := by
    apply Finset.sum_lt_sum
    · intro t ht
      by_cases hti : t = i
      · subst t
        exact hlt.le
      · rw [hBt t hti]
    · exact ⟨i, Finset.mem_univ i, hlt⟩
  exact (not_lt_of_ge (hmin B hB)) hdrop


end
end Bounty
end RothComponent_PolynomialDegreeEchelon

/- Component: UnivariateWronskian; SHA256 d13c46c193a9864197f28c3946420f6b1f105d08f4a4e66bde06ff2cb78f0c8f -/
section RothComponent_UnivariateWronskian
/- Arbitrary finite polynomial Wronskians over the rationals. -/

noncomputable section


open Polynomial Matrix Finset

namespace Bounty

def polynomialWronskian {n : ℕ} (f : Fin n → ℚ[X]) : ℚ[X] :=
  Matrix.det (fun i j : Fin n => Polynomial.hasseDeriv i.val (f j))

def choose_matrix_det_ne_zero {n : ℕ} (d : Fin n → ℕ)
    (hd : Function.Injective d) :
    Matrix.det (fun i j : Fin n => (Nat.choose (d j) i.val : ℚ)) ≠ 0 := by
  have hv : Function.Injective (fun i : Fin n => (d i : ℚ)) := by
    intro i j hij
    apply hd
    change (d i : ℚ) = (d j : ℚ) at hij
    exact_mod_cast hij
  have hvdet := Matrix.det_vandermonde_ne_zero_iff.mpr hv
  have heval := Matrix.det_eval_matrixOfPolynomials_eq_det_vandermonde
    (fun i : Fin n => (d i : ℚ)) (fun j : Fin n => descPochhammer ℚ j.val)
    (fun j => descPochhammer_natDegree ℚ j.val)
    (fun j => monic_descPochhammer ℚ j.val)
  have hentry (i j : Fin n) :
      (descPochhammer ℚ j.val).eval (d i : ℚ) =
        (Nat.factorial j.val : ℚ) * (Nat.choose (d i) j.val : ℚ) := by
    rw [descPochhammer_eval_eq_descFactorial]
    exact_mod_cast Nat.descFactorial_eq_factorial_mul_choose (d i) j.val
  have hdet := Matrix.det_mul_row (fun j : Fin n => (Nat.factorial j.val : ℚ))
    (fun i j : Fin n => (Nat.choose (d i) j.val : ℚ))
  have heq : (Matrix.of fun i j : Fin n =>
      (descPochhammer ℚ j.val).eval (d i : ℚ)) =
      (Matrix.of fun i j : Fin n =>
        (Nat.factorial j.val : ℚ) * (Nat.choose (d i) j.val : ℚ)) := by
    ext i j
    exact hentry i j
  have hnot : Matrix.det (fun i j : Fin n => (Nat.choose (d i) j.val : ℚ)) ≠ 0 := by
    intro hzero
    apply hvdet
    rw [heval, heq, hdet, hzero, mul_zero]
  change (Matrix.transpose (fun i j : Fin n =>
    (Nat.choose (d i) j.val : ℚ))).det ≠ 0
  erw [Matrix.det_transpose]
  exact hnot

def shifted_hasse_coeff (p : ℚ[X]) (i k : ℕ) :
    (X ^ i * Polynomial.hasseDeriv i p).coeff k =
      (Nat.choose k i : ℚ) * p.coeff k := by
  by_cases hik : i ≤ k
  · rw [Polynomial.coeff_X_pow_mul', if_pos hik, Polynomial.hasseDeriv_coeff,
      Nat.sub_add_cancel hik]
  · rw [Polynomial.coeff_X_pow_mul', if_neg hik,
      Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge hik)]
    simp

def shifted_hasse_natDegree_le (p : ℚ[X]) (i : ℕ) :
    (X ^ i * Polynomial.hasseDeriv i p).natDegree ≤ p.natDegree := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [shifted_hasse_coeff, Polynomial.coeff_eq_zero_of_natDegree_lt hk, mul_zero]

def coeff_prod_sum_of_natDegree_le {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → ℚ[X]) (d : ι → ℕ)
    (hd : ∀ i ∈ s, (f i).natDegree ≤ d i) :
    (∏ i ∈ s, f i).coeff (∑ i ∈ s, d i) = ∏ i ∈ s, (f i).coeff (d i) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hds : ∀ i ∈ s, (f i).natDegree ≤ d i := fun i hi =>
      hd i (Finset.mem_insert_of_mem hi)
    have hprod : (∏ i ∈ s, f i).natDegree ≤ ∑ i ∈ s, d i := by
      exact (Polynomial.natDegree_prod_le _ _).trans
        (Finset.sum_le_sum hds)
    rw [Finset.prod_insert ha, Finset.sum_insert ha,
      Polynomial.coeff_mul_add_eq_of_natDegree_le (hd a (Finset.mem_insert_self _ _)) hprod,
      ih hds, Finset.prod_insert ha]

def coeff_det_sum_of_column_natDegree_le {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℚ[X]) (d : Fin n → ℕ)
    (hd : ∀ i j, (A i j).natDegree ≤ d j) :
    A.det.coeff (∑ j, d j) = Matrix.det (fun i j => (A i j).coeff (d j)) := by
  classical
  erw [Matrix.det_apply, Matrix.det_apply]
  simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_smul]
  apply Finset.sum_congr rfl
  intro σ hσ
  congr 1
  exact coeff_prod_sum_of_natDegree_le Finset.univ
    (fun j => A (σ j) j) d (fun j _ => hd (σ j) j)

def polynomialWronskian_ne_zero_of_injective_natDegree {n : ℕ}
    (f : Fin n → ℚ[X]) (hf : ∀ j, f j ≠ 0)
    (hd : Function.Injective (fun j => (f j).natDegree)) :
    polynomialWronskian f ≠ 0 := by
  classical
  let A : Matrix (Fin n) (Fin n) ℚ[X] :=
    fun i j => X ^ i.val * Polynomial.hasseDeriv i.val (f j)
  have hAdeg : ∀ i j, (A i j).natDegree ≤ (f j).natDegree :=
    fun i j => shifted_hasse_natDegree_le (f j) i.val
  have hcoeff := coeff_det_sum_of_column_natDegree_le A
    (fun j => (f j).natDegree) hAdeg
  have hentry (i j : Fin n) : (A i j).coeff (f j).natDegree =
      (f j).leadingCoeff * (Nat.choose (f j).natDegree i.val : ℚ) := by
    change (X ^ i.val * Polynomial.hasseDeriv i.val (f j)).coeff (f j).natDegree = _
    rw [shifted_hasse_coeff, Polynomial.coeff_natDegree, mul_comm]
  have hmatrix : (fun i j : Fin n => (A i j).coeff (f j).natDegree) =
      (Matrix.of fun i j : Fin n =>
        (f j).leadingCoeff * (Nat.choose (f j).natDegree i.val : ℚ)) := by
    funext i j
    exact hentry i j
  rw [hmatrix] at hcoeff
  have hcoeff := hcoeff.trans (Matrix.det_mul_row
    (fun j : Fin n => (f j).leadingCoeff)
    (fun i j : Fin n => (Nat.choose (f j).natDegree i.val : ℚ)))
  have hcoeff_ne : A.det.coeff (∑ j, (f j).natDegree) ≠ 0 := by
    rw [hcoeff]
    apply mul_ne_zero
    · exact Finset.prod_ne_zero_iff.mpr fun j _ => Polynomial.leadingCoeff_ne_zero.mpr (hf j)
    · exact choose_matrix_det_ne_zero (fun j => (f j).natDegree) hd
  have hA : A.det ≠ 0 := by
    intro hzero
    exact hcoeff_ne (by rw [hzero, Polynomial.coeff_zero])
  have hscale : A.det = (∏ i : Fin n, (X : ℚ[X]) ^ i.val) * polynomialWronskian f := by
    exact Matrix.det_mul_column (fun i : Fin n => (X : ℚ[X]) ^ i.val)
      (fun i j : Fin n => Polynomial.hasseDeriv i.val (f j))
  intro hzero
  apply hA
  rw [hscale, hzero, mul_zero]

def polynomialWronskian_sum_smul {n : ℕ} (f g : Fin n → ℚ[X])
    (A : Matrix (Fin n) (Fin n) ℚ)
    (hg : ∀ i, g i = ∑ j, A i j • f j) :
    polynomialWronskian g = polynomialWronskian f * Polynomial.C A.det := by
  classical
  have hmatrix : (fun i j : Fin n => Polynomial.hasseDeriv i.val (g j)) =
      (Matrix.of fun i j : Fin n => Polynomial.hasseDeriv i.val (f j)) *
        Polynomial.C.mapMatrix A.transpose := by
    funext i j
    change Polynomial.hasseDeriv i.val (g j) =
      ∑ k, Polynomial.hasseDeriv i.val (f k) * Polynomial.C (A j k)
    rw [hg j, map_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [map_smul, Polynomial.smul_eq_C_mul, mul_comm]
  unfold polynomialWronskian
  rw [hmatrix, Matrix.det_mul, ← Polynomial.C.map_det, Matrix.det_transpose]
  rfl

def polynomialWronskian_ne_zero {n : ℕ} (f : Fin n → ℚ[X])
    (hf : LinearIndependent ℚ f) : polynomialWronskian f ≠ 0 := by
  obtain ⟨A, g, _, hg, hgne, hdeg⟩ := polynomial_degree_echelon f hf
  have hgnz := polynomialWronskian_ne_zero_of_injective_natDegree g hgne hdeg
  intro hzero
  apply hgnz
  rw [polynomialWronskian_sum_smul f g A hg, hzero, zero_mul]

def iterated_derivative_matrix_det_ne_zero {n : ℕ} (f : Fin n → ℚ[X])
    (hf : LinearIndependent ℚ f) :
    Matrix.det (fun i j : Fin n => (Polynomial.derivative^[i.val]) (f j)) ≠ 0 := by
  classical
  have hentry (i j : Fin n) : (Polynomial.derivative^[i.val]) (f j) =
      Polynomial.C (Nat.factorial i.val : ℚ) * Polynomial.hasseDeriv i.val (f j) := by
    rw [← Polynomial.factorial_smul_hasseDeriv]
    change Nat.factorial i.val • Polynomial.hasseDeriv i.val (f j) = _
    simp only [nsmul_eq_mul, map_natCast]
  have hmatrix : (fun i j : Fin n => (Polynomial.derivative^[i.val]) (f j)) =
      (Matrix.of fun i j : Fin n => Polynomial.C (Nat.factorial i.val : ℚ) *
        Polynomial.hasseDeriv i.val (f j)) := by
    funext i j
    exact hentry i j
  erw [hmatrix, Matrix.det_mul_column]
  apply mul_ne_zero
  · apply Finset.prod_ne_zero_iff.mpr
    intro i hi
    exact Polynomial.C_ne_zero.mpr (by exact_mod_cast Nat.factorial_ne_zero i.val)
  · exact polynomialWronskian_ne_zero f hf


end Bounty
end
end RothComponent_UnivariateWronskian

/- Component: PolynomialKronecker; SHA256 3bcc5c80babd01f3df4f7edbb38072ba6017b49dcd8679b5734ed98cb90a582d -/
section RothComponent_PolynomialKronecker
/- Kronecker substitution is injective on a bounded box of monomial exponents. -/

open Polynomial

namespace Bounty

noncomputable section

def kroneckerExponent {m : ℕ} (M : ℕ) (e : Fin m →₀ ℕ) : ℕ :=
  ∑ j, e j * M ^ j.val

def polynomialKronecker (m M : ℕ) : MvPolynomial (Fin m) ℚ →ₐ[ℚ] ℚ[X] :=
  MvPolynomial.aeval fun j => Polynomial.X ^ (M ^ j.val)

def KroneckerBound {m : ℕ} (M : ℕ) (p : MvPolynomial (Fin m) ℚ) : Prop :=
  ∀ e ∈ p.support, ∀ j, e j < M

def kroneckerExponent_injective_on_digits {m M : ℕ} (hM : 1 < M)
    {e v : Fin m →₀ ℕ} (he : ∀ j, e j < M) (hv : ∀ j, v j < M)
    (h : kroneckerExponent M e = kroneckerExponent M v) : e = v := by
  refine Finsupp.ext <| congrFun <| List.ofFn_inj.mp ?_
  apply Nat.ofDigits_inj_of_len_eq hM (by simp)
  · intro a ha
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp ha
    exact he j
  · intro a ha
    obtain ⟨j, rfl⟩ := List.mem_ofFn.mp ha
    exact hv j
  · simpa only [Nat.ofDigits_eq_sum_mapIdx, List.mapIdx_eq_ofFn, List.get_ofFn,
      List.length_ofFn, Fin.val_cast, List.sum_ofFn, kroneckerExponent] using! h

def polynomialKronecker_monomial {m : ℕ} (M : ℕ) (e : Fin m →₀ ℕ) (a : ℚ) :
    polynomialKronecker m M (MvPolynomial.monomial e a) =
      Polynomial.monomial (kroneckerExponent M e) a := by
  rw [polynomialKronecker, MvPolynomial.aeval_monomial]
  rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  simp only [← pow_mul, Finset.prod_pow_eq_pow_sum, Polynomial.algebraMap_eq,
    Polynomial.C_mul_X_pow_eq_monomial]
  congr 1
  simp only [kroneckerExponent, mul_comm]

/-- On bounded support, the original coefficient is recovered at its encoded degree. -/
def polynomialKronecker_coeff {m M : ℕ} (hM : 1 < M)
    (p : MvPolynomial (Fin m) ℚ) (hp : KroneckerBound M p)
    (e : Fin m →₀ ℕ) (he : e ∈ p.support) :
    (polynomialKronecker m M p).coeff (kroneckerExponent M e) = MvPolynomial.coeff e p := by
  classical
  nth_rw 1 [MvPolynomial.as_sum p]
  rw [map_sum]
  simp only [polynomialKronecker_monomial, Polynomial.finsetSum_coeff]
  rw [Finset.sum_eq_single e]
  · exact Polynomial.coeff_monomial_same _ _
  · intro v hv hve
    apply Polynomial.coeff_monomial_of_ne
    intro hh
    exact hve (kroneckerExponent_injective_on_digits hM (hp v hv) (hp e he) hh.symm)
  · exact fun hnot => False.elim (hnot he)

def polynomialKronecker_eq_zero_iff {m M : ℕ} (hM : 1 < M)
    (p : MvPolynomial (Fin m) ℚ) (hp : KroneckerBound M p) :
    polynomialKronecker m M p = 0 ↔ p = 0 := by
  constructor
  · intro hzero
    by_contra hpzero
    obtain ⟨e, he⟩ := MvPolynomial.support_nonempty.mpr hpzero
    have hh := polynomialKronecker_coeff hM p hp e he
    rw [hzero, Polynomial.coeff_zero] at hh
    exact (MvPolynomial.mem_support_iff.mp he) hh.symm
  · rintro rfl
    exact map_zero _

def kroneckerBound_linearCombination {m k M : ℕ}
    (f : Fin k → MvPolynomial (Fin m) ℚ) (hf : ∀ i, KroneckerBound M (f i))
    (c : Fin k → ℚ) : KroneckerBound M (∑ i, c i • f i) := by
  classical
  intro e he j
  obtain ⟨i, hi, hei⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum he)
  exact hf i e (MvPolynomial.support_smul hei) j

def polynomialKronecker_linearIndependent {m k M : ℕ} (hM : 1 < M)
    (f : Fin k → MvPolynomial (Fin m) ℚ) (hf : LinearIndependent ℚ f)
    (hbound : ∀ i, KroneckerBound M (f i)) :
    LinearIndependent ℚ (fun i => polynomialKronecker m M (f i)) := by
  apply Fintype.linearIndependent_iff.mpr
  intro c hc i
  have hmap : polynomialKronecker m M (∑ j, c j • f j) = 0 := by
    simpa only [map_sum, map_smul] using hc
  have hzero := (polynomialKronecker_eq_zero_iff hM _
    (kroneckerBound_linearCombination f hbound c)).mp hmap
  exact Fintype.linearIndependent_iff.mp hf c hzero i

/-- A common base can be chosen before taking any linear combinations. -/
def exists_polynomialKronecker_linearIndependent {m k : ℕ}
    (f : Fin k → MvPolynomial (Fin m) ℚ) (hf : LinearIndependent ℚ f) :
    ∃ M : ℕ, 2 ≤ M ∧ (∀ i, KroneckerBound M (f i)) ∧
      LinearIndependent ℚ (fun i => polynomialKronecker m M (f i)) := by
  let M : ℕ := 2 + ∑ i, (f i).totalDegree
  have hM : 2 ≤ M := by dsimp only [M]; omega
  have hb (i : Fin k) : KroneckerBound M (f i) := by
    intro e he j
    have hi : (f i).totalDegree ≤ ∑ l, (f l).totalDegree :=
      Finset.single_le_sum (f := fun l : Fin k => (f l).totalDegree)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    have hj := (MvPolynomial.monomial_le_degreeOf j he).trans
      (MvPolynomial.degreeOf_le_totalDegree (f i) j)
    dsimp only [M]
    omega
  exact ⟨M, hM, hb, polynomialKronecker_linearIndependent (by omega) f hf hb⟩


end
end Bounty
end RothComponent_PolynomialKronecker

/- Component: WeightedPolynomialIndex; SHA256 e4a7e147839dcc158d4ca744ea00bea9e0820af99684b92047421d25752a2c12 -/
section RothComponent_WeightedPolynomialIndex
/- Weighted Taylor orders of rational multivariate polynomials.  The polynomial
embedding into formal power series preserves every coefficient, allowing the
existing weighted-order domain theorem to supply product additivity. -/

namespace Bounty

noncomputable section
open scoped BigOperators

variable {I : Type*}

/-- Translation by the rational tuple `β`, so its coefficients are Taylor coefficients. -/
def weightedTaylor (β : I → ℚ) : MvPolynomial I ℚ →+* MvPolynomial I ℚ :=
  MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i + MvPolynomial.C (β i))

def weightedTaylor_C (β : I → ℚ) (a : ℚ) :
    weightedTaylor β (MvPolynomial.C a) = MvPolynomial.C a := by
  simp [weightedTaylor]

def weightedTaylor_X (β : I → ℚ) (i : I) :
    weightedTaylor β (MvPolynomial.X i) = MvPolynomial.X i + MvPolynomial.C (β i) := by
  simp [weightedTaylor]

def weightedTaylor_comp (β γ : I → ℚ) (p : MvPolynomial I ℚ) :
    weightedTaylor β (weightedTaylor γ p) = weightedTaylor (β + γ) p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [weightedTaylor_C]
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p i hp => simp [map_mul, map_add, hp, Pi.add_apply, add_assoc,
      weightedTaylor_X, weightedTaylor_C]

def weightedTaylor_zero (p : MvPolynomial I ℚ) : weightedTaylor 0 p = p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [weightedTaylor_C]
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p i hp => simp [map_mul, hp, weightedTaylor_X]

def weightedTaylor_injective (β : I → ℚ) : Function.Injective (weightedTaylor β) := by
  intro p q h
  have hh := congrArg (weightedTaylor (-β)) h
  simpa only [weightedTaylor_comp, neg_add_cancel, weightedTaylor_zero] using hh

def weightedTaylor_eq_zero (β : I → ℚ) (p : MvPolynomial I ℚ) :
    weightedTaylor β p = 0 ↔ p = 0 :=
  (weightedTaylor_injective β).eq_iff' (map_zero _)

/-- Minimum natural weight in the support, with value infinity for the zero polynomial.
The laws below hold even for weights zero; positive Roth weights are a special case. -/
def weightedPolynomialOrder (w : I → ℕ) (p : MvPolynomial I ℚ) : ℕ∞ :=
  MvPowerSeries.weightedOrder w (p : MvPowerSeries I ℚ)

/-- The weighted Taylor-support index at `β`. -/
def weightedPolynomialIndex (w : I → ℕ) (β : I → ℚ) (p : MvPolynomial I ℚ) : ℕ∞ :=
  weightedPolynomialOrder w (weightedTaylor β p)

def weightedPolynomialOrder_eq_top (w : I → ℕ) (p : MvPolynomial I ℚ) :
    weightedPolynomialOrder w p = ⊤ ↔ p = 0 := by
  simp [weightedPolynomialOrder, MvPolynomial.coe_eq_zero_iff]

def weightedPolynomialIndex_eq_top (w : I → ℕ) (β : I → ℚ)
    (p : MvPolynomial I ℚ) : weightedPolynomialIndex w β p = ⊤ ↔ p = 0 := by
  simp [weightedPolynomialIndex, weightedPolynomialOrder_eq_top, weightedTaylor_eq_zero]

def weightedPolynomialIndex_finite (w : I → ℕ) (β : I → ℚ)
    {p : MvPolynomial I ℚ} (hp : p ≠ 0) : weightedPolynomialIndex w β p < ⊤ := by
  exact lt_top_iff_ne_top.mpr (fun h => hp ((weightedPolynomialIndex_eq_top w β p).mp h))

def weightedPolynomialOrder_le_of_coeff (w : I → ℕ) {p : MvPolynomial I ℚ}
    {d : I →₀ ℕ} (hd : MvPolynomial.coeff d p ≠ 0) :
    weightedPolynomialOrder w p ≤ (Finsupp.weight w d : ℕ∞) := by
  exact MvPowerSeries.weightedOrder_le w (by simpa only [MvPolynomial.coeff_coe] using hd)

def weightedPolynomialOrder_le_iff (w : I → ℕ) (p : MvPolynomial I ℚ)
    (n : ℕ∞) : n ≤ weightedPolynomialOrder w p ↔
      ∀ d, MvPolynomial.coeff d p ≠ 0 → n ≤ (Finsupp.weight w d : ℕ∞) := by
  constructor
  · intro hn d hd
    exact hn.trans (weightedPolynomialOrder_le_of_coeff w hd)
  · intro h
    apply MvPowerSeries.le_weightedOrder w
    intro d hd
    change MvPolynomial.coeff d p = 0
    by_contra hc
    exact (not_le_of_gt hd) (h d hc)

def weightedPolynomialOrder_attained (w : I → ℕ) {p : MvPolynomial I ℚ}
    (hp : p ≠ 0) : ∃ d, MvPolynomial.coeff d p ≠ 0 ∧
      (Finsupp.weight w d : ℕ∞) = weightedPolynomialOrder w p := by
  have hp' : (p : MvPowerSeries I ℚ) ≠ 0 := by
    intro hz
    apply hp
    apply MvPolynomial.coe_injective I ℚ
    exact hz
  simpa only [MvPolynomial.coeff_coe, weightedPolynomialOrder] using
    MvPowerSeries.exists_coeff_ne_zero_and_weightedOrder w
      ((MvPowerSeries.ne_zero_iff_weightedOrder_finite w).mp hp')

def weightedPolynomialIndex_attained (w : I → ℕ) (β : I → ℚ)
    {p : MvPolynomial I ℚ} (hp : p ≠ 0) : ∃ d ∈ (weightedTaylor β p).support,
      (Finsupp.weight w d : ℕ∞) = weightedPolynomialIndex w β p := by
  simpa only [MvPolynomial.mem_support_iff, weightedPolynomialIndex] using
    weightedPolynomialOrder_attained w (show weightedTaylor β p ≠ 0 by
      exact fun hz => hp ((weightedTaylor_eq_zero β p).mp hz))

def weightedPolynomialOrder_mul (w : I → ℕ) (p q : MvPolynomial I ℚ) :
    weightedPolynomialOrder w (p * q) = weightedPolynomialOrder w p + weightedPolynomialOrder w q := by
  simp only [weightedPolynomialOrder, MvPolynomial.coe_mul, MvPowerSeries.weightedOrder_mul]

def weightedPolynomialIndex_mul (w : I → ℕ) (β : I → ℚ) (p q : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (p * q) =
      weightedPolynomialIndex w β p + weightedPolynomialIndex w β q := by
  simp only [weightedPolynomialIndex, map_mul, weightedPolynomialOrder_mul]

def weightedPolynomialOrder_add (w : I → ℕ) (p q : MvPolynomial I ℚ) :
    min (weightedPolynomialOrder w p) (weightedPolynomialOrder w q) ≤
      weightedPolynomialOrder w (p + q) := by
  exact MvPowerSeries.min_weightedOrder_le_add w
    (f := (p : MvPowerSeries I ℚ)) (g := (q : MvPowerSeries I ℚ))

def weightedPolynomialIndex_add (w : I → ℕ) (β : I → ℚ) (p q : MvPolynomial I ℚ) :
    min (weightedPolynomialIndex w β p) (weightedPolynomialIndex w β q) ≤
      weightedPolynomialIndex w β (p + q) := by
  simpa only [weightedPolynomialIndex, map_add] using
    weightedPolynomialOrder_add w (weightedTaylor β p) (weightedTaylor β q)

def weightedTaylor_pderiv (β : I → ℚ) (i : I) (p : MvPolynomial I ℚ) :
    weightedTaylor β (MvPolynomial.pderiv i p) = MvPolynomial.pderiv i (weightedTaylor β p) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a => simp [weightedTaylor_C]
  | add p q hp hq => simp [map_add, hp, hq]
  | mul_X p j hp =>
    by_cases h : j = i
    · subst j
      simp [map_add, map_mul, hp, weightedTaylor_X]
    · simp [map_add, map_mul, hp, MvPolynomial.pderiv_X_of_ne h,
        weightedTaylor_X]

/-- A coordinate derivative can lower the order by at most its coordinate weight.
Writing the bound additively also covers zero polynomials and zero derivatives. -/
def weightedPolynomialOrder_pderiv (w : I → ℕ) (i : I) (p : MvPolynomial I ℚ) :
    weightedPolynomialOrder w p ≤
      weightedPolynomialOrder w (MvPolynomial.pderiv i p) + (w i : ℕ∞) := by
  by_cases hd : MvPolynomial.pderiv i p = 0
  · simp [hd, weightedPolynomialOrder]
  obtain ⟨d, hcoeff, hweight⟩ := weightedPolynomialOrder_attained w hd
  have hp : MvPolynomial.coeff (d + Finsupp.single i 1) p ≠ 0 := by
    rw [MvPolynomial.coeff_pderiv] at hcoeff
    exact left_ne_zero_of_mul hcoeff
  have hh := weightedPolynomialOrder_le_of_coeff w hp
  simpa only [map_add, Finsupp.weight_single, one_nsmul, Nat.cast_add, hweight] using hh

def weightedPolynomialIndex_pderiv (w : I → ℕ) (β : I → ℚ) (i : I)
    (p : MvPolynomial I ℚ) : weightedPolynomialIndex w β p ≤
      weightedPolynomialIndex w β (MvPolynomial.pderiv i p) + (w i : ℕ∞) := by
  simpa only [weightedPolynomialIndex, weightedTaylor_pderiv] using
    weightedPolynomialOrder_pderiv w i (weightedTaylor β p)


end
end Bounty
end RothComponent_WeightedPolynomialIndex

/- Component: WeightedIndexDeterminant; SHA256 c82bfb52fe2ad22ce0b1d32dde07300f80ce5aeeaa7dd4e31aa0a7e0907dc61a -/
section RothComponent_WeightedIndexDeterminant
/- Finite-sum, mixed-derivative, and determinant calculus for the actual weighted
Taylor index.  Derivative words are shared with the generalized Wronskian proof. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I J : Type*}

def weightedPolynomialIndex_zero (w : I → ℕ) (β : I → ℚ) :
    weightedPolynomialIndex w β (0 : MvPolynomial I ℚ) = ⊤ := by
  simp [weightedPolynomialIndex, weightedPolynomialOrder]

def weightedPolynomialIndex_C (w : I → ℕ) (β : I → ℚ) {a : ℚ} (ha : a ≠ 0) :
    weightedPolynomialIndex w β (MvPolynomial.C a) = 0 := by
  simp only [weightedPolynomialIndex, weightedTaylor_C]
  apply le_antisymm
  · have h := weightedPolynomialOrder_le_of_coeff w
      (p := MvPolynomial.C a) (d := 0) (by simpa using ha)
    simpa only [map_zero, Nat.cast_zero] using h
  · exact bot_le

def weightedPolynomialIndex_one (w : I → ℕ) (β : I → ℚ) :
    weightedPolynomialIndex w β (1 : MvPolynomial I ℚ) = 0 := by
  simpa using weightedPolynomialIndex_C w β (one_ne_zero : (1 : ℚ) ≠ 0)

def weightedPolynomialIndex_C_mul (w : I → ℕ) (β : I → ℚ)
    {a : ℚ} (ha : a ≠ 0) (p : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (MvPolynomial.C a * p) = weightedPolynomialIndex w β p := by
  rw [weightedPolynomialIndex_mul, weightedPolynomialIndex_C w β ha, zero_add]

def weightedPolynomialIndex_smul (w : I → ℕ) (β : I → ℚ)
    {a : ℚ} (ha : a ≠ 0) (p : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (a • p) = weightedPolynomialIndex w β p := by
  rw [MvPolynomial.smul_eq_C_mul]
  exact weightedPolynomialIndex_C_mul w β ha p

def weightedPolynomialIndex_neg (w : I → ℕ) (β : I → ℚ)
    (p : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (-p) = weightedPolynomialIndex w β p := by
  simpa only [neg_one_smul] using
    weightedPolynomialIndex_smul w β (neg_ne_zero.mpr (one_ne_zero : (1 : ℚ) ≠ 0)) p

def weightedPolynomialIndex_unit_smul (w : I → ℕ) (β : I → ℚ)
    (u : ℤˣ) (p : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (u • p) = weightedPolynomialIndex w β p := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · simp
  · simp [weightedPolynomialIndex_neg]

def weightedPolynomialIndex_sum_lower (w : I → ℕ) (β : I → ℚ)
    (s : Finset J) (p : J → MvPolynomial I ℚ) (b : ℕ∞)
    (h : ∀ j ∈ s, b ≤ weightedPolynomialIndex w β (p j)) :
    b ≤ weightedPolynomialIndex w β (∑ j ∈ s, p j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [weightedPolynomialIndex_zero]
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact (le_min (h a (by simp)) (ih (fun j hj => h j (by simp [hj])))).trans
      (weightedPolynomialIndex_add w β (p a) (∑ j ∈ s, p j))

def weightedPolynomialIndex_prod (w : I → ℕ) (β : I → ℚ)
    (s : Finset J) (p : J → MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (∏ j ∈ s, p j) =
      ∑ j ∈ s, weightedPolynomialIndex w β (p j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [weightedPolynomialIndex_one]
  | @insert a s ha ih => simp only [Finset.prod_insert ha, Finset.sum_insert ha,
      weightedPolynomialIndex_mul, ih]

/-- A derivative word acts from the right: the head is the last derivative applied. -/
def wordPDeriv : List I → (MvPolynomial I ℚ →ₗ[ℚ] MvPolynomial I ℚ)
  | [] => LinearMap.id
  | i :: s => (MvPolynomial.pderiv i).toLinearMap.comp (wordPDeriv s)

def wordPDeriv_nil (p : MvPolynomial I ℚ) : wordPDeriv [] p = p := rfl

def wordPDeriv_cons (i : I) (s : List I) (p : MvPolynomial I ℚ) :
    wordPDeriv (i :: s) p = MvPolynomial.pderiv i (wordPDeriv s p) := rfl

def wordPDeriv_append (s t : List I) (p : MvPolynomial I ℚ) :
    wordPDeriv (s ++ t) p = wordPDeriv s (wordPDeriv t p) := by
  induction s with
  | nil => rfl
  | cons i s ih => simp only [List.cons_append, wordPDeriv_cons, ih]

def wordDerivativeWeight (w : I → ℕ) (s : List I) : ℕ := (s.map w).sum

def wordDerivativeWeight_nil (w : I → ℕ) : wordDerivativeWeight w [] = 0 := rfl

def wordDerivativeWeight_cons (w : I → ℕ) (i : I) (s : List I) :
    wordDerivativeWeight w (i :: s) = w i + wordDerivativeWeight w s := rfl

def weightedPolynomialIndex_wordPDeriv (w : I → ℕ) (β : I → ℚ)
    (s : List I) (p : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β p ≤ weightedPolynomialIndex w β (wordPDeriv s p) +
      (wordDerivativeWeight w s : ℕ∞) := by
  induction s with
  | nil => simp [wordPDeriv_nil, wordDerivativeWeight_nil]
  | cons i s ih =>
    calc
      weightedPolynomialIndex w β p ≤ weightedPolynomialIndex w β (wordPDeriv s p) +
          (wordDerivativeWeight w s : ℕ∞) := ih
      _ ≤ (weightedPolynomialIndex w β (MvPolynomial.pderiv i (wordPDeriv s p)) +
          (w i : ℕ∞)) + (wordDerivativeWeight w s : ℕ∞) :=
        add_le_add (weightedPolynomialIndex_pderiv w β i (wordPDeriv s p)) le_rfl
      _ = _ := by simp only [wordPDeriv_cons, wordDerivativeWeight_cons, Nat.cast_add, add_assoc]

def weightedPolynomialIndex_det_lower [Fintype J] [DecidableEq J]
    (w : I → ℕ) (β : I → ℚ) (A : Matrix J J (MvPolynomial I ℚ)) (b : ℕ∞)
    (h : ∀ σ : Equiv.Perm J, b ≤ ∑ j, weightedPolynomialIndex w β (A (σ j) j)) :
    b ≤ weightedPolynomialIndex w β A.det := by
  rw [Matrix.det_apply]
  apply weightedPolynomialIndex_sum_lower
  intro σ _
  rw [weightedPolynomialIndex_unit_smul, weightedPolynomialIndex_prod]
  exact h σ

def weightedPolynomialIndex_det_row_loss [Fintype J] [DecidableEq J]
    (w : I → ℕ) (β : I → ℚ) (A : Matrix J J (MvPolynomial I ℚ))
    (b : J → ℕ∞) (r : J → ℕ)
    (h : ∀ i j, b j ≤ weightedPolynomialIndex w β (A i j) + (r i : ℕ∞)) :
    (∑ j, b j) ≤ weightedPolynomialIndex w β A.det + (∑ i, r i : ℕ) := by
  have hb : (∑ j, b j) - (∑ i, r i : ℕ) ≤ weightedPolynomialIndex w β A.det := by
    apply weightedPolynomialIndex_det_lower
    intro σ
    apply tsub_le_iff_right.mpr
    have hh := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => h (σ j) j)
    simpa only [Finset.sum_add_distrib, ← Nat.cast_sum, Equiv.sum_comp σ r] using hh
  exact tsub_le_iff_right.mp hb

/-- Row and column derivative losses, in the truncated form used in the Roth determinant bound. -/
def weightedPolynomialIndex_det_row_column_loss [Fintype J] [DecidableEq J]
    (w : I → ℕ) (β : I → ℚ) (A : Matrix J J (MvPolynomial I ℚ))
    (b : ℕ∞) (r c : J → ℕ)
    (h : ∀ i j, b ≤ weightedPolynomialIndex w β (A i j) + (r i : ℕ∞) + (c j : ℕ∞)) :
    (∑ j : J, (b - (c j : ℕ∞))) ≤ weightedPolynomialIndex w β A.det + (∑ i : J, r i : ℕ) := by
  apply weightedPolynomialIndex_det_row_loss (J := J) w β A (fun j => b - (c j : ℕ∞)) r
  intro i j
  exact tsub_le_iff_right.mpr (h i j)

end
end Bounty
end RothComponent_WeightedIndexDeterminant

/- Component: GeneralizedWronskian; SHA256 fe9db46245ed4fe447e691295ad3976042dba63bf0b958848fcf1b9e81370dd9 -/
section RothComponent_GeneralizedWronskian
/- Generalized polynomial Wronskians via finite chain-rule expansions. -/

noncomputable section


open Polynomial MvPolynomial Matrix Finset

namespace Bounty

def derivative_aeval_eq_sum_pderiv {m : ℕ} (x : Fin m → ℚ[X])
    (p : MvPolynomial (Fin m) ℚ) :
    Polynomial.derivative (MvPolynomial.aeval x p) =
      ∑ j, Polynomial.derivative (x j) * MvPolynomial.aeval x (MvPolynomial.pderiv j p) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    simp only [map_add, hp, hq, mul_add, Finset.sum_add_distrib]
  | mul_X p a hp =>
    simp only [map_mul, MvPolynomial.aeval_X, Polynomial.derivative_mul,
      MvPolynomial.pderiv_mul, map_add, MvPolynomial.pderiv_X,
      Pi.single_apply, hp]
    simp only [mul_add, Finset.sum_add_distrib]
    have hfirst :
        ∑ j : Fin m, Polynomial.derivative (x j) *
          (MvPolynomial.aeval x (MvPolynomial.pderiv j p) * x a) =
        (∑ j : Fin m, Polynomial.derivative (x j) *
          MvPolynomial.aeval x (MvPolynomial.pderiv j p)) * x a := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    rw [hfirst]
    congr 1
    simp [mul_comm]

def ChainLabel (m : ℕ) : ℕ → Type
  | 0 => Unit
  | n + 1 => Option (Fin m) × ChainLabel m n

abbrev chainLabelFintype (m n : ℕ) : Fintype (ChainLabel m n) := by
  induction n with
  | zero => exact inferInstanceAs (Fintype Unit)
  | succ n ih =>
    letI := ih
    exact inferInstanceAs (Fintype (Option (Fin m) × ChainLabel m n))

def chainWord (m : ℕ) : (n : ℕ) → ChainLabel m n → List (Fin m)
  | 0, _ => []
  | n + 1, (none, a) => chainWord m n a
  | n + 1, (some j, a) => j :: chainWord m n a

def chainCoefficient {m : ℕ} (x : Fin m → ℚ[X]) :
    (n : ℕ) → ChainLabel m n → ℚ[X]
  | 0, _ => 1
  | n + 1, (none, a) => Polynomial.derivative (chainCoefficient x n a)
  | n + 1, (some j, a) => chainCoefficient x n a * Polynomial.derivative (x j)

def chainWord_length_le (m n : ℕ) (a : ChainLabel m n) :
    (chainWord m n a).length ≤ n := by
  induction n with
  | zero => simp [chainWord]
  | succ n ih =>
    rcases a with ⟨j, a⟩
    cases j with
    | none => simpa only [chainWord] using (ih a).trans (Nat.le_succ n)
    | some j => simpa only [chainWord, List.length_cons] using Nat.succ_le_succ (ih a)

def exists_det_summand_ne_zero {k : ℕ} {α : Fin k → Type*}
    [∀ i, Fintype (α i)] (v : ∀ i, α i → Fin k → ℚ[X])
    (h : Matrix.det (fun i j => ∑ a, v i a j) ≠ 0) :
    ∃ a : ∀ i, α i, Matrix.det (fun i j => v i (a i) j) ≠ 0 := by
  classical
  by_contra hnone
  push Not at hnone
  apply h
  have hsum := (Matrix.detRowAlternating (R := ℚ[X]) (n := Fin k)).toMultilinearMap.map_sum v
  change Matrix.det (fun i => ∑ a, v i a) =
    ∑ a : ∀ i, α i, Matrix.det (fun i => v i (a i)) at hsum
  have heq : (fun i j => ∑ a, v i a j) = (fun i => ∑ a, v i a) := by
    funext i j
    simp only [Finset.sum_apply]
  rw [heq, hsum]
  exact Finset.sum_eq_zero (fun a _ => hnone a)

def iterated_derivative_aeval_expansion {m : ℕ} (x : Fin m → ℚ[X])
    (n : ℕ) (p : MvPolynomial (Fin m) ℚ) :
    letI := chainLabelFintype m n
    (Polynomial.derivative^[n]) (MvPolynomial.aeval x p) =
      ∑ a : ChainLabel m n, chainCoefficient x n a *
        MvPolynomial.aeval x (wordPDeriv (chainWord m n a) p) := by
  classical
  letI (t : ℕ) : Fintype (ChainLabel m t) := chainLabelFintype m t
  induction n with
  | zero =>
    have hcard : Fintype.card (ChainLabel m 0) = 1 :=
      (Fintype.card_congr (Equiv.refl Unit)).trans Fintype.card_unit
    simp only [Function.iterate_zero_apply, chainCoefficient, chainWord, wordPDeriv_nil,
      one_mul, Finset.sum_const, Finset.card_univ, hcard, one_nsmul]
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih, map_sum]
    change (∑ a : ChainLabel m n, Polynomial.derivative
      (chainCoefficient x n a * MvPolynomial.aeval x (wordPDeriv (chainWord m n a) p))) =
      ∑ a : Option (Fin m) × ChainLabel m n,
        chainCoefficient x (n + 1) a *
          MvPolynomial.aeval x (wordPDeriv (chainWord m (n + 1) a) p)
    rw [Fintype.sum_prod_type]
    simp only [Fintype.sum_option, chainCoefficient, chainWord, wordPDeriv_cons,
      Polynomial.derivative_mul, derivative_aeval_eq_sum_pderiv, Finset.sum_add_distrib]
    congr 1
    simp_rw [Finset.mul_sum, mul_assoc]
    exact Finset.sum_comm

def exists_generalizedWronskian_ne_zero {m k : ℕ}
    (f : Fin k → MvPolynomial (Fin m) ℚ) (hf : LinearIndependent ℚ f) :
    ∃ w : Fin k → List (Fin m), (∀ i, (w i).length ≤ i.val) ∧
      Matrix.det (fun i j : Fin k => wordPDeriv (w i) (f j)) ≠ 0 := by
  classical
  letI (t : ℕ) : Fintype (ChainLabel m t) := chainLabelFintype m t
  obtain ⟨M, _, _, hli⟩ := exists_polynomialKronecker_linearIndependent f hf
  let x : Fin m → ℚ[X] := fun j => Polynomial.X ^ (M ^ j.val)
  change LinearIndependent ℚ (fun j => MvPolynomial.aeval x (f j)) at hli
  have huniv := iterated_derivative_matrix_det_ne_zero
    (fun j => MvPolynomial.aeval x (f j)) hli
  have hrows : (fun i j : Fin k =>
      (Polynomial.derivative^[i.val]) (MvPolynomial.aeval x (f j))) =
      (fun i j : Fin k => ∑ a : ChainLabel m i.val, chainCoefficient x i.val a *
        MvPolynomial.aeval x (wordPDeriv (chainWord m i.val a) (f j))) := by
    funext i j
    exact iterated_derivative_aeval_expansion x i.val (f j)
  rw [hrows] at huniv
  obtain ⟨a, ha⟩ := exists_det_summand_ne_zero
    (fun (i : Fin k) (b : ChainLabel m i.val) (j : Fin k) =>
      chainCoefficient x i.val b *
        MvPolynomial.aeval x (wordPDeriv (chainWord m i.val b) (f j))) huniv
  refine ⟨fun i => chainWord m i.val (a i), fun i => chainWord_length_le m i.val (a i), ?_⟩
  intro hzero
  apply ha
  change (Matrix.of fun i j : Fin k => chainCoefficient x i.val (a i) *
    MvPolynomial.aeval x (wordPDeriv (chainWord m i.val (a i)) (f j))).det = 0
  erw [Matrix.det_mul_column]
  have hmap : Matrix.det (fun i j : Fin k => MvPolynomial.aeval x
      (wordPDeriv (chainWord m i.val (a i)) (f j))) =
      MvPolynomial.aeval x
        (Matrix.det (fun i j : Fin k => wordPDeriv (chainWord m i.val (a i)) (f j))) := by
    exact ((MvPolynomial.aeval x).map_det
      (fun i j : Fin k => wordPDeriv (chainWord m i.val (a i)) (f j))).symm
  rw [hmap, hzero, map_zero, mul_zero]


end Bounty
end
end RothComponent_GeneralizedWronskian

/- Component: PolynomialSeparatedRank; SHA256 36b5d05b012fc760cf6429bd8884270afd4493e553d7822b6bfe9da8f1799212 -/
section RothComponent_PolynomialSeparatedRank
/- Finite separated-variable rank decompositions obtained from selected coefficients. -/

open Polynomial Module

namespace Bounty

noncomputable section

/-- Select a basis from a finite family, retaining the original indices. -/
def finite_family_basis_indices {V : Type*} [AddCommGroup V] [Module ℚ V]
    {N : ℕ} (v : Fin N → V) :
    ∃ k : ℕ, k ≤ N ∧ ∃ a : Fin k → Fin N, Function.Injective a ∧
      LinearIndependent ℚ (fun j => v (a j)) ∧
      Submodule.span ℚ (Set.range (fun j => v (a j))) =
        Submodule.span ℚ (Set.range v) := by
  classical
  obtain ⟨K, a, ha, hspan, hli⟩ := exists_linearIndependent' ℚ v
  let : Fintype K := Fintype.ofInjective a ha
  let e : Fin (Fintype.card K) ≃ K := (Fintype.equivFin K).symm
  refine ⟨Fintype.card K, ?_, a ∘ e, ha.comp e.injective, hli.comp e e.injective, ?_⟩
  · simpa using Fintype.card_le_of_injective a ha
  · change Submodule.span ℚ (Set.range ((v ∘ a) ∘ e)) = _
    rw [e.surjective.range_comp]
    exact hspan

/-- Coordinates in that selected basis form an identity matrix on the selected rows. -/
def finite_family_coordinate_split {V : Type*} [AddCommGroup V] [Module ℚ V]
    {N : ℕ} (v : Fin N → V) :
    ∃ k : ℕ, k ≤ N ∧ ∃ a : Fin k → Fin N, Function.Injective a ∧
      LinearIndependent ℚ (fun j => v (a j)) ∧
      ∃ c : Fin N → Fin k → ℚ,
        (∀ i, v i = ∑ j, c i j • v (a j)) ∧
        (∀ i j, c (a i) j = if i = j then 1 else 0) := by
  classical
  obtain ⟨k, hk, a, ha, hli, hspan⟩ := finite_family_basis_indices v
  let S := Submodule.span ℚ (Set.range (fun j => v (a j)))
  have hv (i : Fin N) : v i ∈ S := by
    change v i ∈ Submodule.span ℚ (Set.range (fun j => v (a j)))
    rw [hspan]
    exact Submodule.subset_span (Set.mem_range_self i)
  let b := Basis.span hli
  let c (i : Fin N) (j : Fin k) : ℚ := b.repr ⟨v i, hv i⟩ j
  refine ⟨k, hk, a, ha, hli, c, ?_, ?_⟩
  · intro i
    have hh := congrArg (fun y : S => (y : V)) (b.sum_repr ⟨v i, hv i⟩)
    simpa only [Submodule.coe_sum, Submodule.coe_smul, b, Basis.coe_span_apply, c]
      using hh.symm
  · intro i j
    simp [c, b, Basis.span_repr_eq_single, Finsupp.single_apply]

/-- A polynomial over a rational algebra has a separated decomposition of its exact
coefficient rank. The left factors are distinct selected coefficients of the original
polynomial, and the right factors have no greater degree than the original polynomial. -/
def polynomial_separated_rank {A : Type*} [CommRing A] [Algebra ℚ A]
    (P : A[X]) (hP : P ≠ 0) :
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ P.natDegree + 1 ∧
      ∃ a : Fin k → Fin (P.natDegree + 1), Function.Injective a ∧
      ∃ ψ : Fin k → ℚ[X],
        LinearIndependent ℚ (fun j => P.coeff (a j)) ∧
        LinearIndependent ℚ ψ ∧
        (∀ j, (ψ j).natDegree ≤ P.natDegree) ∧
        P = ∑ j, Polynomial.C (P.coeff (a j)) *
          (ψ j).map (algebraMap ℚ A) := by
  classical
  obtain ⟨k, hk, a, ha, hli, c, hc, hdelta⟩ :=
    finite_family_coordinate_split (fun i : Fin (P.natDegree + 1) => P.coeff i)
  let ψ (j : Fin k) : ℚ[X] := Polynomial.ofFn (P.natDegree + 1) (fun i => c i j)
  have hcoeff (j : Fin k) (i : Fin (P.natDegree + 1)) : (ψ j).coeff i = c i j := by
    simp [ψ, Polynomial.ofFn_coeff_eq_val_of_lt, i.isLt]
  have hψ : LinearIndependent ℚ ψ := by
    apply Fintype.linearIndependent_iff.mpr
    intro d hd j
    have hh := congrArg (fun q : ℚ[X] => q.coeff (a j)) hd
    simpa only [Polynomial.finsetSum_coeff, Polynomial.coeff_smul, hcoeff,
      hdelta, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
      Finset.mem_univ, if_true, Polynomial.coeff_zero] using hh
  have hdeg (j : Fin k) : (ψ j).natDegree ≤ P.natDegree := by
    have hh := Polynomial.ofFn_natDegree_lt (by omega : 1 ≤ P.natDegree + 1)
      (fun i => c i j)
    exact Nat.lt_succ_iff.mp hh
  have hsplit : P = ∑ j, Polynomial.C (P.coeff (a j)) *
      (ψ j).map (algebraMap ℚ A) := by
    ext n
    simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_map]
    by_cases hn : n < P.natDegree + 1
    · have hh := hc ⟨n, hn⟩
      simp only [Algebra.smul_def, mul_comm] at hh
      simpa only [ψ, Polynomial.ofFn_coeff_eq_val_of_lt _ hn] using hh
    · have hpzero : P.coeff n = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      rw [hpzero]
      symm
      apply Finset.sum_eq_zero
      intro j hj
      have hqzero : (ψ j).coeff n = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by have := hdeg j; omega)
      rw [hqzero, map_zero, mul_zero]
  have hkpos : 1 ≤ k := by
    by_contra hh
    have hkzero : k = 0 := by omega
    subst k
    simp only [Finset.univ_eq_empty, Finset.sum_empty] at hsplit
    exact hP hsplit
  exact ⟨k, hkpos, hk, a, ha, ψ, hli, hψ, hdeg, hsplit⟩

def mvPolynomial_separated_rank {m : ℕ}
    (P : (MvPolynomial (Fin m) ℚ)[X]) (hP : P ≠ 0) :
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ P.natDegree + 1 ∧
      ∃ φ : Fin k → MvPolynomial (Fin m) ℚ, ∃ ψ : Fin k → ℚ[X],
        LinearIndependent ℚ φ ∧ LinearIndependent ℚ ψ ∧
        (∀ j, ∃ n ≤ P.natDegree, φ j = P.coeff n) ∧
        (∀ j, (ψ j).natDegree ≤ P.natDegree) ∧
        P = ∑ j, Polynomial.C (φ j) * (ψ j).map MvPolynomial.C := by
  obtain ⟨k, hkpos, hk, a, ha, ψ, hφ, hψ, hdeg, hsplit⟩ := polynomial_separated_rank P hP
  refine ⟨k, hkpos, hk, (fun j => P.coeff (a j)), ψ, hφ, hψ, ?_, hdeg, ?_⟩
  · intro j
    exact ⟨a j, Nat.lt_succ_iff.mp (a j).isLt, rfl⟩
  · exact hsplit


end
end Bounty
end RothComponent_PolynomialSeparatedRank

/- Component: RationalRootHeight; SHA256 5e47a2a77de45ae7abc1a312c125cb45978f4639e3fd60ab67ea32448faeab0f -/
section RothComponent_RationalRootHeight
/- The one-variable height estimate for the rational polynomial-index argument. -/

namespace Bounty

open Polynomial
noncomputable section

def integerPolynomialCoeffSum (P : ℤ[X]) : ℝ :=
  (P.map (Int.castRingHom ℂ)).sum fun _ a => ‖a‖

def polynomial_mahlerMeasure_pow (P : ℂ[X]) (n : ℕ) :
    (P ^ n).mahlerMeasure = P.mahlerMeasure ^ n := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, Polynomial.mahlerMeasure_mul, ih, pow_succ]

def integer_linear_mahlerMeasure (p q : ℤ) (hq : q ≠ 0) :
    ((C q * X - C p).map (Int.castRingHom ℂ)).mahlerMeasure =
      max ‖(q : ℂ)‖ ‖(p : ℂ)‖ := by
  have hqc : (q : ℂ) ≠ 0 := by exact_mod_cast hq
  rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X, Polynomial.map_C]
  change (C (q : ℂ) * X - C (p : ℂ)).mahlerMeasure = _
  rw [sub_eq_add_neg, ← Polynomial.C_neg]
  rw [Polynomial.mahlerMeasure_C_mul_X_add_C hqc]
  simp only [norm_neg]

def integer_linear_power_height_bound {P : ℤ[X]} (hP : P ≠ 0)
    (p q : ℤ) (hq : q ≠ 0) (n : ℕ) (hdiv : (C q * X - C p) ^ n ∣ P) :
    (max ‖(q : ℂ)‖ ‖(p : ℂ)‖) ^ n ≤ integerPolynomialCoeffSum P := by
  obtain ⟨Q, hPQ⟩ := hdiv
  have hQ : Q ≠ 0 := by
    intro hzero
    apply hP
    rw [hPQ, hzero, mul_zero]
  have hQ1 := Polynomial.one_le_mahlerMeasure_of_ne_zero hQ
  have hm : (P.map (Int.castRingHom ℂ)).mahlerMeasure =
      (max ‖(q : ℂ)‖ ‖(p : ℂ)‖) ^ n *
        (Q.map (Int.castRingHom ℂ)).mahlerMeasure := by
    rw [hPQ, Polynomial.map_mul, Polynomial.map_pow, Polynomial.mahlerMeasure_mul,
      polynomial_mahlerMeasure_pow, integer_linear_mahlerMeasure p q hq]
  calc
    _ ≤ (max ‖(q : ℂ)‖ ‖(p : ℂ)‖) ^ n *
        (Q.map (Int.castRingHom ℂ)).mahlerMeasure :=
      le_mul_of_one_le_right (by positivity) hQ1
    _ = (P.map (Int.castRingHom ℂ)).mahlerMeasure := hm.symm
    _ ≤ integerPolynomialCoeffSum P := Polynomial.mahlerMeasure_le_sum_norm_coeff _

def integer_linear_power_log_height_bound {P : ℤ[X]} (hP : P ≠ 0)
    (p q : ℤ) (hq : q ≠ 0) (n : ℕ) (hdiv : (C q * X - C p) ^ n ∣ P) :
    (n : ℝ) * Real.log (max ‖(q : ℂ)‖ ‖(p : ℂ)‖) ≤
      Real.log (integerPolynomialCoeffSum P) := by
  have hqc : (q : ℂ) ≠ 0 := by exact_mod_cast hq
  have hb : 0 < max ‖(q : ℂ)‖ ‖(p : ℂ)‖ :=
    (norm_pos_iff.mpr hqc).trans_le (le_max_left _ _)
  have hh := Real.log_le_log (pow_pos hb n) (integer_linear_power_height_bound hP p q hq n hdiv)
  simpa only [Real.log_pow] using hh


end
end Bounty
end RothComponent_RationalRootHeight

/- Component: RationalRootMultiplicityHeight; SHA256 f1a3f3c44217673bb3f2ce2b082df98020020d757fce49448b1557f555927f8d -/
section RothComponent_RationalRootMultiplicityHeight
/- Rational root multiplicity, primitive linear factors, and coefficient height. -/

namespace Bounty

open Polynomial
noncomputable section

def rationalRootFactor (β : ℚ) : ℤ[X] := C (β.den : ℤ) * X - C β.num

def rationalRootFactor_primitive (β : ℚ) : (rationalRootFactor β).IsPrimitive := by
  intro a ha
  have hc := (Polynomial.C_dvd_iff_dvd_coeff a _).mp ha
  have hq : a ∣ (β.den : ℤ) := by
    simpa only [rationalRootFactor, Polynomial.coeff_sub, Polynomial.coeff_C_mul_X,
      Polynomial.coeff_C, if_pos, if_neg, Nat.one_ne_zero, ite_false, sub_zero] using hc 1
  have hp : a ∣ β.num := by
    have hh : a ∣ -β.num := by simpa [rationalRootFactor] using hc 0
    simpa using hh
  have hcop : IsCoprime β.num (β.den : ℤ) := by
    apply Int.isCoprime_iff_gcd_eq_one.mpr
    simpa only [Int.gcd_def, Int.natAbs_natCast] using β.reduced
  exact hcop.isUnit_of_dvd' hp hq

def rationalRootFactor_pow_primitive (β : ℚ) (n : ℕ) :
    ((rationalRootFactor β) ^ n).IsPrimitive := by
  induction n with
  | zero => simp
  | succ n ih => simpa only [pow_succ] using ih.mul (rationalRootFactor_primitive β)

def rationalRootFactor_map (β : ℚ) :
    (rationalRootFactor β).map (Int.castRingHom ℚ) =
      C (β.den : ℚ) * (X - C β) := by
  have hden : (β.den : ℚ) ≠ 0 := by exact_mod_cast β.den_ne_zero
  have hnum : (β.den : ℚ) * β = (β.num : ℚ) := by
    calc
      (β.den : ℚ) * β = (β.den : ℚ) * ((β.num : ℚ) / (β.den : ℚ)) :=
        congrArg (fun x : ℚ => (β.den : ℚ) * x) β.num_div_den.symm
      _ = (β.num : ℚ) := by field_simp
  simp only [rationalRootFactor, Polynomial.map_sub, Polynomial.map_mul,
    Polynomial.map_C, Polynomial.map_X]
  change C (β.den : ℚ) * X - C (β.num : ℚ) = _
  rw [mul_sub, ← Polynomial.C_mul, hnum]

def rationalRootFactor_pow_dvd (P : ℤ[X]) (β : ℚ) (n : ℕ)
    (hdiv : (X - C β) ^ n ∣ P.map (Int.castRingHom ℚ)) :
    (rationalRootFactor β) ^ n ∣ P := by
  apply (Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast _ _
    (rationalRootFactor_pow_primitive β n)).mpr
  rw [Polynomial.map_pow, rationalRootFactor_map, mul_pow]
  have hc : IsUnit (C (β.den : ℚ) ^ n : ℚ[X]) :=
    (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr (by exact_mod_cast β.den_ne_zero))).pow n
  exact (hc.mul_left_dvd).mpr hdiv

def rational_rootMultiplicity_height_bound {P : ℤ[X]} (hP : P ≠ 0) (β : ℚ) :
    (Polynomial.rootMultiplicity β (P.map (Int.castRingHom ℚ)) : ℝ) *
      Real.log (max ‖(β.den : ℂ)‖ ‖(β.num : ℂ)‖) ≤
      Real.log (integerPolynomialCoeffSum P) := by
  apply integer_linear_power_log_height_bound hP β.num (β.den : ℤ)
    (by exact_mod_cast β.den_ne_zero)
  exact rationalRootFactor_pow_dvd P β _ (Polynomial.pow_rootMultiplicity_dvd _ β)


end
end Bounty
end RothComponent_RationalRootMultiplicityHeight

/- Component: RothIndexNormalization; SHA256 d5e8eae8f8d7c671604ec159d5dc9c64a65e8f32fbd166ec84330954f7532f43 -/
section RothComponent_RothIndexNormalization
/- Real Roth indices obtained by normalizing the actual weighted Taylor order.
The total real-valued definition sends the zero polynomial to zero; all minimum
characterizations and degree bounds below explicitly assume a nonzero polynomial. -/

namespace Bounty

noncomputable section
open scoped BigOperators

def rothDenominator {m : ℕ} (r : Fin m → ℕ) : ℕ := ∏ i, r i

def rothWeight {m : ℕ} (r : Fin m → ℕ) (i : Fin m) : ℕ :=
  ∏ j ∈ Finset.univ.erase i, r j

def rothMonomialWeight {m : ℕ} (r : Fin m → ℕ) (d : Fin m →₀ ℕ) : ℝ :=
  ∑ i, (d i : ℝ) / r i

def rothPolynomialIndex {m : ℕ} (r : Fin m → ℕ) (β : Fin m → ℚ)
    (P : MvPolynomial (Fin m) ℚ) : ℝ :=
  ((weightedPolynomialIndex (rothWeight r) β P).toNat : ℝ) / rothDenominator r

def rothDenominator_pos {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i) :
    0 < rothDenominator r := Finset.prod_pos (fun i _ => hr i)

def rothWeight_mul {m : ℕ} (r : Fin m → ℕ) (i : Fin m) :
    rothWeight r i * r i = rothDenominator r :=
  Finset.prod_erase_mul Finset.univ r (Finset.mem_univ i)

def rothWeight_div_denominator {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (i : Fin m) : (rothWeight r i : ℝ) / rothDenominator r = 1 / (r i : ℝ) := by
  have hD : (rothDenominator r : ℝ) ≠ 0 := by exact_mod_cast (rothDenominator_pos hr).ne'
  have hi : (r i : ℝ) ≠ 0 := by exact_mod_cast (hr i).ne'
  apply (div_eq_div_iff hD hi).mpr
  simpa only [one_mul, ← Nat.cast_mul] using congrArg (fun n : ℕ => (n : ℝ)) (rothWeight_mul r i)

def rothMonomialWeight_eq_normalized_weight {m : ℕ} {r : Fin m → ℕ}
    (hr : ∀ i, 0 < r i) (d : Fin m →₀ ℕ) :
    (Finsupp.weight (rothWeight r) d : ℝ) / rothDenominator r = rothMonomialWeight r d := by
  rw [Finsupp.weight_eq_sum]
  simp only [smul_eq_mul, Nat.cast_sum, Nat.cast_mul, Finset.sum_div, rothMonomialWeight]
  apply Finset.sum_congr rfl
  intro i hi
  rw [mul_div_assoc, rothWeight_div_denominator hr]
  ring

def rothPolynomialIndex_nonneg {m : ℕ} (r : Fin m → ℕ) (β : Fin m → ℚ)
    (P : MvPolynomial (Fin m) ℚ) : 0 ≤ rothPolynomialIndex r β P := by
  unfold rothPolynomialIndex
  positivity

/-- Every nonzero Taylor coefficient supplies an upper bound on the normalized index. -/
def rothPolynomialIndex_le_support {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin m → ℚ) (P : MvPolynomial (Fin m) ℚ)
    {d : Fin m →₀ ℕ} (hd : d ∈ (weightedTaylor β P).support) :
    rothPolynomialIndex r β P ≤ rothMonomialWeight r d := by
  have hh := weightedPolynomialOrder_le_of_coeff (rothWeight r)
    (MvPolynomial.mem_support_iff.mp hd)
  have hn : (weightedPolynomialIndex (rothWeight r) β P).toNat ≤
      Finsupp.weight (rothWeight r) d := ENat.toNat_le_of_le_natCast hh
  rw [← rothMonomialWeight_eq_normalized_weight hr]
  exact div_le_div_of_nonneg_right (by exact_mod_cast hn) (Nat.cast_nonneg _)

/-- The normalized index is attained by an actual nonzero Taylor coefficient. -/
def rothPolynomialIndex_attained {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin m → ℚ) {P : MvPolynomial (Fin m) ℚ} (hP : P ≠ 0) :
    ∃ d ∈ (weightedTaylor β P).support,
      rothPolynomialIndex r β P = rothMonomialWeight r d := by
  obtain ⟨d, hd, hweight⟩ := weightedPolynomialIndex_attained (rothWeight r) β hP
  refine ⟨d, hd, ?_⟩
  have hh := congrArg ENat.toNat hweight
  simp only [ENat.toNat_natCast] at hh
  rw [rothPolynomialIndex, ← hh]
  exact rothMonomialWeight_eq_normalized_weight hr d

def weightedTaylor_monomial_degreeOf_le {m : ℕ} (β : Fin m → ℚ)
    (d : Fin m →₀ ℕ) (a : ℚ) (i : Fin m) :
    (weightedTaylor β (MvPolynomial.monomial d a)).degreeOf i ≤ d i := by
  classical
  rw [weightedTaylor, MvPolynomial.eval₂Hom_monomial,
    Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  apply (MvPolynomial.degreeOf_C_mul_le _ i a).trans
  apply (MvPolynomial.degreeOf_prod_le i _ _).trans
  calc
    (∑ j, ((MvPolynomial.X j + MvPolynomial.C (β j)) ^ d j).degreeOf i) ≤
        ∑ j, d j * (if i = j then 1 else 0) := by
      apply Finset.sum_le_sum
      intro j hj
      apply (MvPolynomial.degreeOf_pow_le i _ _).trans
      apply Nat.mul_le_mul_left
      simpa only [MvPolynomial.degreeOf_X, MvPolynomial.degreeOf_C, max_eq_left (Nat.zero_le _)]
        using MvPolynomial.degreeOf_add_le i (MvPolynomial.X j) (MvPolynomial.C (β j))
    _ = d i := by simp

def weightedTaylor_degreeOf_le {m : ℕ} (β : Fin m → ℚ)
    (P : MvPolynomial (Fin m) ℚ) (i : Fin m) :
    (weightedTaylor β P).degreeOf i ≤ P.degreeOf i := by
  classical
  nth_rw 1 [MvPolynomial.as_sum P]
  rw [map_sum]
  apply (MvPolynomial.degreeOf_sum_le i _ _).trans
  apply Finset.sup_le
  intro d hd
  exact (weightedTaylor_monomial_degreeOf_le β d (MvPolynomial.coeff d P) i).trans
    (MvPolynomial.monomial_le_degreeOf i hd)

def weightedTaylor_degreeOf {m : ℕ} (β : Fin m → ℚ)
    (P : MvPolynomial (Fin m) ℚ) (i : Fin m) :
    (weightedTaylor β P).degreeOf i = P.degreeOf i := by
  apply le_antisymm (weightedTaylor_degreeOf_le β P i)
  simpa only [weightedTaylor_comp, neg_add_cancel, weightedTaylor_zero] using
    weightedTaylor_degreeOf_le (-β) (weightedTaylor β P) i

def rothPolynomialIndex_le_dimension {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin m → ℚ) {P : MvPolynomial (Fin m) ℚ} (hP : P ≠ 0)
    (hdegree : ∀ i, P.degreeOf i ≤ r i) : rothPolynomialIndex r β P ≤ m := by
  obtain ⟨d, hd, heq⟩ := rothPolynomialIndex_attained hr β hP
  rw [heq, rothMonomialWeight]
  calc
    (∑ i : Fin m, (d i : ℝ) / r i) ≤ ∑ _i : Fin m, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro i hi
      apply (div_le_one (by exact_mod_cast hr i)).mpr
      exact_mod_cast (MvPolynomial.monomial_le_degreeOf i hd).trans
        ((weightedTaylor_degreeOf β P i).le.trans (hdegree i))
    _ = m := by simp

def rothMonomialWeight_scale {m : ℕ} (r : Fin m → ℕ) (k : ℕ)
    (d : Fin m →₀ ℕ) :
    rothMonomialWeight (fun i => k * r i) d = rothMonomialWeight r d / k := by
  simp only [rothMonomialWeight, Nat.cast_mul, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  rw [div_div, mul_comm]

def rothPolynomialIndex_scale {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin m → ℚ) {P : MvPolynomial (Fin m) ℚ} (hP : P ≠ 0)
    {k : ℕ} (hk : 0 < k) :
    rothPolynomialIndex (fun i => k * r i) β P = rothPolynomialIndex r β P / k := by
  have hkr (i : Fin m) : 0 < k * r i := Nat.mul_pos hk (hr i)
  have hkreal : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  obtain ⟨d, hd, heq⟩ := rothPolynomialIndex_attained hr β hP
  obtain ⟨e, he, heq'⟩ := rothPolynomialIndex_attained hkr β hP
  apply le_antisymm
  · calc
      _ ≤ rothMonomialWeight (fun i => k * r i) d :=
        rothPolynomialIndex_le_support hkr β P hd
      _ = _ := by rw [rothMonomialWeight_scale, heq]
  · calc
      _ ≤ rothMonomialWeight r e / k :=
        div_le_div_of_nonneg_right (rothPolynomialIndex_le_support hr β P he) hkreal
      _ = _ := by rw [heq', rothMonomialWeight_scale]

def rothPolynomialIndex_mul {m : ℕ} (r : Fin m → ℕ) (β : Fin m → ℚ)
    {P Q : MvPolynomial (Fin m) ℚ} (hP : P ≠ 0) (hQ : Q ≠ 0) :
    rothPolynomialIndex r β (P * Q) = rothPolynomialIndex r β P + rothPolynomialIndex r β Q := by
  simp only [rothPolynomialIndex, weightedPolynomialIndex_mul,
    ENat.toNat_add (weightedPolynomialIndex_finite _ _ hP).ne
      (weightedPolynomialIndex_finite _ _ hQ).ne, Nat.cast_add, add_div]


end
end Bounty
end RothComponent_RothIndexNormalization

/- Component: RothUnivariateIndex; SHA256 8f7f621ecf9f8eb932902c07e9f454b1f4ffc64189fef0dc80602b18c0c6932c -/
section RothComponent_RothUnivariateIndex
/- The normalized one-variable Taylor index is rational-root multiplicity divided by degree. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Polynomial

def unique_weightedTaylor (β : Fin 1 → ℚ) (P : MvPolynomial (Fin 1) ℚ) :
    MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) (weightedTaylor β P) =
      (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) P).comp (Polynomial.X + Polynomial.C (β 0)) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [MvPolynomial.uniqueAlgEquiv_apply, weightedTaylor_C]
  | add P Q hP hQ => simp [map_add, hP, hQ]
  | mul_X P i hP =>
    have hi : i = 0 := Subsingleton.elim _ _
    subst i
    simp [map_mul, map_add, hP, MvPolynomial.uniqueAlgEquiv_apply,
      weightedTaylor_X]

def rothPolynomialIndex_eq_rootMultiplicity {r : Fin 1 → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin 1 → ℚ) {P : MvPolynomial (Fin 1) ℚ} (hP : P ≠ 0) :
    rothPolynomialIndex r β P =
      ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) P).rootMultiplicity (β 0) : ℝ) / r 0 := by
  rw [Polynomial.rootMultiplicity_eq_natTrailingDegree, ← unique_weightedTaylor]
  let T := weightedTaylor β P
  let Q := MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) T
  have hT : T ≠ 0 := fun hz => hP ((weightedTaylor_eq_zero β P).mp hz)
  have hQ : Q ≠ 0 := by
    intro hz
    apply hT
    exact (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).injective
      (hz.trans (map_zero _).symm)
  change rothPolynomialIndex r β P = (Q.natTrailingDegree : ℝ) / r 0
  apply le_antisymm
  · have hc := Polynomial.coeff_natTrailingDegree_ne_zero.mpr hQ
    change (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) T).coeff Q.natTrailingDegree ≠ 0 at hc
    rw [MvPolynomial.coeff_uniqueAlgEquiv] at hc
    have hu := rothPolynomialIndex_le_support hr β P (MvPolynomial.mem_support_iff.mpr hc)
    simpa [rothMonomialWeight] using hu
  · obtain ⟨d, hd, heq⟩ := rothPolynomialIndex_attained hr β hP
    have hd' : Q.coeff (d 0) ≠ 0 := by
      change (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) T).coeff (d 0) ≠ 0
      rw [MvPolynomial.coeff_uniqueAlgEquiv]
      have hdEq : Finsupp.single (0 : Fin 1) (d 0) = d := by
        simpa using (Finsupp.unique_single d).symm
      change MvPolynomial.coeff (Finsupp.single (0 : Fin 1) (d 0)) T ≠ 0
      rw [hdEq]
      exact MvPolynomial.mem_support_iff.mp hd
    have hn := Polynomial.natTrailingDegree_le_of_ne_zero hd'
    rw [heq]
    simp only [rothMonomialWeight, Fin.sum_univ_one]
    exact div_le_div_of_nonneg_right (by exact_mod_cast hn) (Nat.cast_nonneg _)

def rothUnivariate_integer_height_bound (r : Fin 1 → ℕ) (hr : ∀ i, 0 < r i)
    (β : Fin 1 → ℚ) {P : ℤ[X]} (hP : P ≠ 0) :
    rothPolynomialIndex r β ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm
      (P.map (Int.castRingHom ℚ))) *
        ((r 0 : ℝ) * Real.log (max ‖((β 0).den : ℂ)‖ ‖((β 0).num : ℂ)‖)) ≤
      Real.log (integerPolynomialCoeffSum P) := by
  have hPQ : P.map (Int.castRingHom ℚ) ≠ 0 := by
    intro hz
    apply hP
    exact (Polynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective)
      (hz.trans (Polynomial.map_zero _).symm)
  have hM : (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm (P.map (Int.castRingHom ℚ)) ≠ 0 := by
    intro hz
    apply hPQ
    exact (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm.injective
      (hz.trans (map_zero _).symm)
  rw [rothPolynomialIndex_eq_rootMultiplicity hr β hM, AlgEquiv.apply_symm_apply]
  have hr0 : (r 0 : ℝ) ≠ 0 := by exact_mod_cast (hr 0).ne'
  rw [div_mul_eq_mul_div, mul_div_assoc, mul_div_cancel_left₀ _ hr0]
  exact rational_rootMultiplicity_height_bound hP (β 0)


end
end Bounty
end RothComponent_RothUnivariateIndex

/- Component: PolynomialCoefficientNorm; SHA256 3121619c6ec30ab1ef03b1743098af5be37e6d61132039e91563bcb5a8c2cc04 -/
section RothComponent_PolynomialCoefficientNorm
/- The coefficient sum norm needed in the rational Roth polynomial argument. -/

namespace Bounty

noncomputable section
open scoped BigOperators

variable {I R : Type*} [NormedCommRing R]

def polynomialCoeffL1 (P : MvPolynomial I R) : ℝ :=
  ∑ d ∈ P.support, ‖MvPolynomial.coeff d P‖

def polynomialCoeffL1_nonneg (P : MvPolynomial I R) : 0 ≤ polynomialCoeffL1 P := by
  exact Finset.sum_nonneg (fun _ _ => norm_nonneg _)

def polynomialCoeffL1_zero : polynomialCoeffL1 (0 : MvPolynomial I R) = 0 := by
  simp [polynomialCoeffL1]

def polynomialCoeffL1_sum_of_support_subset (P : MvPolynomial I R)
    (s : Finset (I →₀ ℕ)) (hs : P.support ⊆ s) :
    polynomialCoeffL1 P = ∑ d ∈ s, ‖MvPolynomial.coeff d P‖ := by
  classical
  apply Finset.sum_subset hs
  intro d _ hd
  rw [MvPolynomial.notMem_support_iff.mp hd, norm_zero]

def polynomialCoeffL1_add (P Q : MvPolynomial I R) :
    polynomialCoeffL1 (P + Q) ≤ polynomialCoeffL1 P + polynomialCoeffL1 Q := by
  classical
  let s := P.support ∪ Q.support
  rw [polynomialCoeffL1_sum_of_support_subset (P + Q) s MvPolynomial.support_add,
    polynomialCoeffL1_sum_of_support_subset P s Finset.subset_union_left,
    polynomialCoeffL1_sum_of_support_subset Q s Finset.subset_union_right,
    ← Finset.sum_add_distrib]
  exact Finset.sum_le_sum (fun d _ => by simpa using norm_add_le (MvPolynomial.coeff d P) (MvPolynomial.coeff d Q))

def polynomialCoeffL1_sum {J : Type*} (s : Finset J) (P : J → MvPolynomial I R) :
    polynomialCoeffL1 (∑ j ∈ s, P j) ≤ ∑ j ∈ s, polynomialCoeffL1 (P j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [polynomialCoeffL1_zero]
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact (polynomialCoeffL1_add _ _).trans (add_le_add le_rfl ih)

def polynomialCoeffL1_monomial (d : I →₀ ℕ) (a : R) :
    polynomialCoeffL1 (MvPolynomial.monomial d a) = ‖a‖ := by
  classical
  exact MvPolynomial.sum_monomial_eq (norm_zero : ‖(0 : R)‖ = 0)

def polynomialCoeffL1_C (a : R) :
    polynomialCoeffL1 (MvPolynomial.C a : MvPolynomial I R) = ‖a‖ := by
  exact polynomialCoeffL1_monomial 0 a

def polynomialCoeffL1_one [NormOneClass R] :
    polynomialCoeffL1 (1 : MvPolynomial I R) = 1 := by
  rw [← MvPolynomial.C_1, polynomialCoeffL1_C, norm_one]

def polynomialCoeffL1_mul (P Q : MvPolynomial I R) :
    polynomialCoeffL1 (P * Q) ≤ polynomialCoeffL1 P * polynomialCoeffL1 Q := by
  classical
  have hprod : P * Q = ∑ d ∈ P.support, ∑ e ∈ Q.support,
      MvPolynomial.monomial (d + e) (MvPolynomial.coeff d P * MvPolynomial.coeff e Q) := by
    conv_lhs => rw [MvPolynomial.as_sum P, MvPolynomial.as_sum Q]
    simp only [Finset.sum_mul, Finset.mul_sum, MvPolynomial.monomial_mul]
    exact Finset.sum_comm
  rw [hprod]
  calc
    _ ≤ ∑ d ∈ P.support, polynomialCoeffL1 (∑ e ∈ Q.support,
        MvPolynomial.monomial (d + e) (MvPolynomial.coeff d P * MvPolynomial.coeff e Q)) :=
      polynomialCoeffL1_sum _ _
    _ ≤ ∑ d ∈ P.support, ∑ e ∈ Q.support,
        polynomialCoeffL1 (MvPolynomial.monomial (d + e)
          (MvPolynomial.coeff d P * MvPolynomial.coeff e Q)) :=
      Finset.sum_le_sum (fun _ _ => polynomialCoeffL1_sum _ _)
    _ ≤ ∑ d ∈ P.support, ∑ e ∈ Q.support,
        ‖MvPolynomial.coeff d P‖ * ‖MvPolynomial.coeff e Q‖ := by
      apply Finset.sum_le_sum
      intro d _
      apply Finset.sum_le_sum
      intro e _
      rw [polynomialCoeffL1_monomial]
      exact norm_mul_le _ _
    _ = polynomialCoeffL1 P * polynomialCoeffL1 Q := by
      simp only [polynomialCoeffL1, Finset.sum_mul, Finset.mul_sum]
      exact Finset.sum_comm

def polynomialCoeffL1_prod [NormOneClass R] {J : Type*} (s : Finset J)
    (P : J → MvPolynomial I R) :
    polynomialCoeffL1 (∏ j ∈ s, P j) ≤ ∏ j ∈ s, polynomialCoeffL1 (P j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [polynomialCoeffL1_one]
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    exact (polynomialCoeffL1_mul _ _).trans
      (mul_le_mul_of_nonneg_left ih (polynomialCoeffL1_nonneg _))

def norm_coeff_le_polynomialCoeffL1 (P : MvPolynomial I R) (d : I →₀ ℕ) :
    ‖MvPolynomial.coeff d P‖ ≤ polynomialCoeffL1 P := by
  classical
  by_cases hd : d ∈ P.support
  · exact Finset.single_le_sum (fun _ _ => norm_nonneg _) hd
  · simp only [MvPolynomial.notMem_support_iff.mp hd, norm_zero]
    exact polynomialCoeffL1_nonneg _

def polynomialCoeffL1_pos {P : MvPolynomial I R} (hP : P ≠ 0) :
    0 < polynomialCoeffL1 P := by
  classical
  obtain ⟨d, hd⟩ := MvPolynomial.exists_coeff_ne_zero hP
  exact (norm_pos_iff.mpr hd).trans_le (norm_coeff_le_polynomialCoeffL1 P d)


end
end Bounty
end RothComponent_PolynomialCoefficientNorm

/- Component: PolynomialCoefficientDeterminant; SHA256 3776cae0ad95603c49cc4dcafcbfaa27ed1e8adda8cb741bae810b1d716bcca1 -/
section RothComponent_PolynomialCoefficientDeterminant
/- Coefficient norm bounds for determinant auxiliary polynomials. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I R J : Type*} [NormedCommRing R]

def polynomialCoeffL1_neg (P : MvPolynomial I R) :
    polynomialCoeffL1 (-P) = polynomialCoeffL1 P := by
  classical
  simp [polynomialCoeffL1]

def polynomialCoeffL1_unit_smul (u : ℤˣ) (P : MvPolynomial I R) :
    polynomialCoeffL1 (u • P) = polynomialCoeffL1 P := by
  rcases Int.units_eq_one_or u with rfl | rfl <;> simp [polynomialCoeffL1_neg]

def polynomialCoeffL1_det [NormOneClass R] [Fintype J] [DecidableEq J]
    (A : Matrix J J (MvPolynomial I R)) :
    polynomialCoeffL1 A.det ≤
      ∑ σ : Equiv.Perm J, ∏ j, polynomialCoeffL1 (A (σ j) j) := by
  rw [Matrix.det_apply]
  apply (polynomialCoeffL1_sum _ _).trans
  apply Finset.sum_le_sum
  intro σ _
  rw [polynomialCoeffL1_unit_smul]
  exact polynomialCoeffL1_prod _ _

def polynomialCoeffL1_det_le [NormOneClass R] [Fintype J] [DecidableEq J]
    (A : Matrix J J (MvPolynomial I R)) (B : ℝ) (_hB : 0 ≤ B)
    (hA : ∀ i j, polynomialCoeffL1 (A i j) ≤ B) :
    polynomialCoeffL1 A.det ≤ (Fintype.card J).factorial * B ^ Fintype.card J := by
  calc
    _ ≤ ∑ σ : Equiv.Perm J, ∏ j, polynomialCoeffL1 (A (σ j) j) := polynomialCoeffL1_det A
    _ ≤ ∑ _σ : Equiv.Perm J, ∏ _j : J, B := by
      apply Finset.sum_le_sum
      intro σ _
      exact Finset.prod_le_prod (fun j _ => polynomialCoeffL1_nonneg _) (fun j _ => hA (σ j) j)
    _ = (Fintype.card J).factorial * B ^ Fintype.card J := by
      simp [Fintype.card_perm]

def polynomialCoeffL1_det_log_le [NormOneClass R] [Fintype J] [DecidableEq J]
    (A : Matrix J J (MvPolynomial I R)) (hdet : A.det ≠ 0)
    (B : ℝ) (hB : 0 < B) (hA : ∀ i j, polynomialCoeffL1 (A i j) ≤ B) :
    Real.log (polynomialCoeffL1 A.det) ≤
      Real.log ((Fintype.card J).factorial : ℝ) + (Fintype.card J : ℝ) * Real.log B := by
  have hf : (0 : ℝ) < (Fintype.card J).factorial := by exact_mod_cast Nat.factorial_pos _
  have h := Real.log_le_log (polynomialCoeffL1_pos hdet)
    (polynomialCoeffL1_det_le A B hB.le hA)
  rwa [Real.log_mul hf.ne' (pow_pos hB _).ne', Real.log_pow] at h


end
end Bounty
end RothComponent_PolynomialCoefficientDeterminant

/- Component: DividedWordDerivatives; SHA256 1e32467e609f852e2772902b0b2f850f42fa8b5371df2ba893b288b35f59e72f -/
section RothComponent_DividedWordDerivatives
/- Exact coefficients of derivative words and their divided normalization. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- The multiplicity of each coordinate in a derivative word. -/
def wordDerivativeCounts (s : List I) : I →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun i => s.count i)

def wordDerivativeCounts_apply (s : List I) (i : I) :
    wordDerivativeCounts s i = s.count i := rfl

def wordDerivativeCounts_nil : wordDerivativeCounts ([] : List I) = 0 := by
  ext i
  simp [wordDerivativeCounts_apply]

def wordDerivativeCounts_cons (i : I) (s : List I) :
    wordDerivativeCounts (i :: s) = Finsupp.single i 1 + wordDerivativeCounts s := by
  ext j
  by_cases h : j = i
  · subst j
    simp [add_comm, wordDerivativeCounts_apply]
  · simp [List.count_cons_of_ne (Ne.symm h), h, wordDerivativeCounts_apply]

def derivativeFallingProduct (a c : I →₀ ℕ) : ℚ :=
  ∏ i, ((a i + c i).descFactorial (c i) : ℚ)

private def descFactorial_step (a c : ℕ) :
    (a + (1 + c)).descFactorial (1 + c) =
      (a + 1 + c).descFactorial c * (a + 1) := by
  rw [Nat.add_comm 1 c, Nat.descFactorial_succ]
  have he : a + (c + 1) = a + 1 + c := by omega
  rw [he, Nat.add_sub_cancel]
  exact Nat.mul_comm _ _

private def derivativeFallingProduct_step (a c : I →₀ ℕ) (i : I) :
    derivativeFallingProduct a (Finsupp.single i 1 + c) =
      derivativeFallingProduct (a + Finsupp.single i 1) c * (a i + 1) := by
  have hfactor (j : I) :
      ((a j + (Finsupp.single i 1 + c : I →₀ ℕ) j).descFactorial
        ((Finsupp.single i 1 + c : I →₀ ℕ) j) : ℚ) =
        ((((a + Finsupp.single i 1 : I →₀ ℕ) j) + c j).descFactorial (c j) : ℚ) *
          (if j = i then (a i + 1 : ℚ) else 1) := by
    by_cases h : j = i
    · subst j
      simp only [Finsupp.add_apply, Finsupp.single_eq_same, if_pos rfl]
      exact_mod_cast descFactorial_step (a i) (c i)
    · simp [Finsupp.single_apply, h, Ne.symm h]
  simp only [derivativeFallingProduct, hfactor, Finset.prod_mul_distrib]
  simp

def coeff_wordPDeriv (s : List I) (P : MvPolynomial I ℚ) (a : I →₀ ℕ) :
    MvPolynomial.coeff a (wordPDeriv s P) =
      MvPolynomial.coeff (a + wordDerivativeCounts s) P *
        derivativeFallingProduct a (wordDerivativeCounts s) := by
  induction s generalizing a with
  | nil => simp [derivativeFallingProduct, wordPDeriv_nil, wordDerivativeCounts_nil]
  | cons i s ih =>
    rw [wordPDeriv_cons, MvPolynomial.coeff_pderiv, ih,
      wordDerivativeCounts_cons, derivativeFallingProduct_step]
    simp only [add_assoc, mul_assoc]

def coeff_wordPDeriv_descFactorial (s : List I) (P : MvPolynomial I ℚ) (a : I →₀ ℕ) :
    MvPolynomial.coeff a (wordPDeriv s P) =
      MvPolynomial.coeff (a + wordDerivativeCounts s) P *
        ∏ i, ((a i + s.count i).descFactorial (s.count i) : ℚ) := by
  simpa only [derivativeFallingProduct, wordDerivativeCounts_apply] using coeff_wordPDeriv s P a

/-- The nonzero rational product of the coordinate factorials. -/
def wordDerivativeFactorial (s : List I) : ℚ := ∏ i, ((s.count i).factorial : ℚ)

def wordDerivativeFactorial_ne_zero (s : List I) : wordDerivativeFactorial s ≠ 0 := by
  apply Finset.prod_ne_zero_iff.mpr
  intro i _
  exact Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)

def dividedWordPDeriv (s : List I) : MvPolynomial I ℚ →ₗ[ℚ] MvPolynomial I ℚ :=
  (wordDerivativeFactorial s)⁻¹ • wordPDeriv s

def coeff_dividedWordPDeriv (s : List I) (P : MvPolynomial I ℚ) (a : I →₀ ℕ) :
    MvPolynomial.coeff a (dividedWordPDeriv s P) =
      MvPolynomial.coeff (a + wordDerivativeCounts s) P *
        ∏ i, ((a i + s.count i).choose (s.count i) : ℚ) := by
  change MvPolynomial.coeff a ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P) = _
  rw [MvPolynomial.coeff_smul, coeff_wordPDeriv_descFactorial, smul_eq_mul]
  simp_rw [Nat.descFactorial_eq_factorial_mul_choose, Nat.cast_mul]
  rw [Finset.prod_mul_distrib]
  change (wordDerivativeFactorial s)⁻¹ *
    (MvPolynomial.coeff (a + wordDerivativeCounts s) P *
      (wordDerivativeFactorial s * ∏ i, ((a i + s.count i).choose (s.count i) : ℚ))) = _
  calc
    _ = ((wordDerivativeFactorial s)⁻¹ * wordDerivativeFactorial s) *
        (MvPolynomial.coeff (a + wordDerivativeCounts s) P *
          ∏ i, ((a i + s.count i).choose (s.count i) : ℚ)) := by ring
    _ = _ := by rw [inv_mul_cancel₀ (wordDerivativeFactorial_ne_zero s), one_mul]

def dividedWordPDeriv_integral (s : List I) (P : MvPolynomial I ℚ)
    (hP : ∀ a, ∃ z : ℤ, MvPolynomial.coeff a P = (z : ℚ)) :
    ∀ a, ∃ z : ℤ, MvPolynomial.coeff a (dividedWordPDeriv s P) = (z : ℚ) := by
  intro a
  obtain ⟨z, hz⟩ := hP (a + wordDerivativeCounts s)
  refine ⟨z * ∏ i, ((a i + s.count i).choose (s.count i) : ℤ), ?_⟩
  rw [coeff_dividedWordPDeriv, hz]
  simp

def derivativeChooseProduct_le (s : List I) (a : I →₀ ℕ) (r : I → ℕ)
    (hr : ∀ i, a i + s.count i ≤ r i) :
    (∏ i, (a i + s.count i).choose (s.count i)) ≤ 2 ^ (∑ i, r i) := by
  calc
    _ ≤ ∏ i, 2 ^ r i := Finset.prod_le_prod' (fun i _ =>
      (Nat.choose_le_two_pow _ _).trans (Nat.pow_le_pow_right (by decide) (hr i)))
    _ = _ := Finset.prod_pow_eq_pow_sum Finset.univ r 2

def weightedPolynomialIndex_dividedWordPDeriv (w : I → ℕ) (β : I → ℚ)
    (s : List I) (P : MvPolynomial I ℚ) :
    weightedPolynomialIndex w β (dividedWordPDeriv s P) =
      weightedPolynomialIndex w β (wordPDeriv s P) := by
  exact weightedPolynomialIndex_smul w β
    (inv_ne_zero (wordDerivativeFactorial_ne_zero s)) (wordPDeriv s P)


end
end Bounty
end RothComponent_DividedWordDerivatives

/- Component: DividedDerivativeCoefficientNorm; SHA256 a39c7c7bfbfcd4a15a0bef6ac1f673e7eb83c5c91c953956674649d9958d50e8 -/
section RothComponent_DividedDerivativeCoefficientNorm
/- Divided derivatives have coefficient growth exponential in the total degree. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I : Type*} [Fintype I] [DecidableEq I]

def PolynomialBoxBound (r : I → ℕ) (P : MvPolynomial I ℚ) : Prop :=
  ∀ a ∈ P.support, ∀ i, a i ≤ r i

def dividedWordPDeriv_support_shift (s : List I) (P : MvPolynomial I ℚ)
    {a : I →₀ ℕ} (ha : a ∈ (dividedWordPDeriv s P).support) :
    a + wordDerivativeCounts s ∈ P.support := by
  apply MvPolynomial.mem_support_iff.mpr
  have h := MvPolynomial.mem_support_iff.mp ha
  rw [coeff_dividedWordPDeriv] at h
  exact left_ne_zero_of_mul h

def polynomialBoxBound_dividedWordPDeriv (s : List I) {r : I → ℕ}
    {P : MvPolynomial I ℚ} (hP : PolynomialBoxBound r P) :
    PolynomialBoxBound r (dividedWordPDeriv s P) := by
  intro a ha i
  exact (Nat.le_add_right (a i) (wordDerivativeCounts s i)).trans
    (hP _ (dividedWordPDeriv_support_shift s P ha) i)

def polynomialCoeffL1_dividedWordPDeriv (s : List I) (r : I → ℕ)
    (P : MvPolynomial I ℚ) (hP : PolynomialBoxBound r P) :
    polynomialCoeffL1 (dividedWordPDeriv s P) ≤
      (2 : ℝ) ^ (∑ i, r i) * polynomialCoeffL1 P := by
  classical
  let c := wordDerivativeCounts s
  have hentry (a : I →₀ ℕ) (ha : a ∈ (dividedWordPDeriv s P).support) :
      ‖MvPolynomial.coeff a (dividedWordPDeriv s P)‖ ≤
        (2 : ℝ) ^ (∑ i, r i) * ‖MvPolynomial.coeff (a + c) P‖ := by
    have hr : ∀ i, a i + s.count i ≤ r i :=
      fun i => hP _ (dividedWordPDeriv_support_shift s P ha) i
    have hchoose := derivativeChooseProduct_le s a r hr
    have hnorm : ‖(∏ i, ((a i + s.count i).choose (s.count i) : ℚ))‖ ≤
        (2 : ℝ) ^ (∑ i, r i) := by
      rw [← Nat.cast_prod]
      rw [← Rat.norm_cast_real]
      push_cast
      rw [Real.norm_of_nonneg (by positivity)]
      exact (show ((∏ i, (a i + s.count i).choose (s.count i)) : ℝ) ≤
          (2 : ℝ) ^ (∑ i, r i) from by exact_mod_cast hchoose)
    rw [coeff_dividedWordPDeriv, norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right hnorm (norm_nonneg _)
  have hsum : (∑ a ∈ (dividedWordPDeriv s P).support,
      ‖MvPolynomial.coeff (a + c) P‖) ≤ polynomialCoeffL1 P := by
    rw [← Finset.sum_image (f := fun a : I →₀ ℕ => ‖MvPolynomial.coeff a P‖)
      (g := fun a : I →₀ ℕ => a + c)
      (s := (dividedWordPDeriv s P).support)
      (by intro a ha b hb hab; exact add_right_cancel hab)]
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro b hb
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hb
      exact dividedWordPDeriv_support_shift s P ha
    · intro b _ _
      exact norm_nonneg _
  calc
    _ ≤ ∑ a ∈ (dividedWordPDeriv s P).support,
        (2 : ℝ) ^ (∑ i, r i) * ‖MvPolynomial.coeff (a + c) P‖ :=
      Finset.sum_le_sum hentry
    _ = (2 : ℝ) ^ (∑ i, r i) *
        (∑ a ∈ (dividedWordPDeriv s P).support, ‖MvPolynomial.coeff (a + c) P‖) :=
      (Finset.mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hsum (by positivity)

def polynomialCoeffL1_double_dividedWordPDeriv (s t : List I) (r : I → ℕ)
    (P : MvPolynomial I ℚ) (hP : PolynomialBoxBound r P) :
    polynomialCoeffL1 (dividedWordPDeriv s (dividedWordPDeriv t P)) ≤
      (4 : ℝ) ^ (∑ i, r i) * polynomialCoeffL1 P := by
  calc
    _ ≤ (2 : ℝ) ^ (∑ i, r i) * polynomialCoeffL1 (dividedWordPDeriv t P) :=
      polynomialCoeffL1_dividedWordPDeriv s r _ (polynomialBoxBound_dividedWordPDeriv t hP)
    _ ≤ (2 : ℝ) ^ (∑ i, r i) * ((2 : ℝ) ^ (∑ i, r i) * polynomialCoeffL1 P) :=
      mul_le_mul_of_nonneg_left (polynomialCoeffL1_dividedWordPDeriv t r P hP) (by positivity)
    _ = _ := by rw [← mul_assoc, ← mul_pow]; norm_num

end
end Bounty
end RothComponent_DividedDerivativeCoefficientNorm

/- Component: IntegerRankOneFactors; SHA256 f8775fc8d0e76bdf1c7c6dc5e50b9844470bad72656928fd032690e50a3ac29d -/
section RothComponent_IntegerRankOneFactors
/- Integer factors of a nonzero rank-one integer matrix, obtained by making a
column primitive and using its integral Bezout coefficients. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I J : Type*} [Fintype I] [Fintype J]

/-- Rank-one integer matrices admit integral outer factors, with primitive left factor. -/
def integer_rankOne_factors (A : I → J → ℤ)
    (hA : ∃ i j, A i j ≠ 0)
    (hminor : ∀ i k j l, A i j * A k l = A i l * A k j) :
    ∃ (a : I → ℤ) (b : J → ℤ),
      (∀ i j, A i j = a i * b j) ∧ Finset.univ.gcd a = 1 := by
  classical
  obtain ⟨i₀, j₀, hnonzero⟩ := hA
  obtain ⟨a, ha, hprimitive⟩ := Finset.extract_gcd
    (s := Finset.univ) (fun i => A i j₀) ⟨i₀, Finset.mem_univ i₀⟩
  let g : ℤ := Finset.univ.gcd (fun i => A i j₀)
  have hscale (i : I) : A i j₀ = g * a i := ha i (Finset.mem_univ i)
  have hg : g ≠ 0 := Finset.gcd_ne_zero_iff.mpr ⟨i₀, Finset.mem_univ i₀, hnonzero⟩
  have hcross (i k : I) (j : J) : a i * A k j = a k * A i j := by
    apply mul_left_cancel₀ hg
    have hm := hminor i k j₀ j
    rw [hscale i, hscale k] at hm
    calc
      g * (a i * A k j) = (g * a i) * A k j := by ring
      _ = A i j * (g * a k) := hm
      _ = g * (a k * A i j) := by ring
  obtain ⟨f, hf⟩ := Finset.gcd_eq_sum_mul Finset.univ a
  rw [hprimitive] at hf
  let b : J → ℤ := fun j => ∑ k, f k * A k j
  refine ⟨a, b, ?_, hprimitive⟩
  intro i j
  symm
  change a i * (∑ k, f k * A k j) = A i j
  calc
    _ = ∑ k, a i * (f k * A k j) := Finset.mul_sum _ _ _
    _ = ∑ k, (a k * f k) * A i j := by
      apply Finset.sum_congr rfl
      intro k _
      calc
        a i * (f k * A k j) = f k * (a i * A k j) := by ring
        _ = f k * (a k * A i j) := by rw [hcross]
        _ = (a k * f k) * A i j := by ring
    _ = (∑ k, a k * f k) * A i j := (Finset.sum_mul _ _ _).symm
    _ = A i j := by rw [← hf, one_mul]

def integer_rankOne_factors_of_ne_zero (A : I → J → ℤ) (hA : A ≠ 0)
    (hminor : ∀ i k j l, A i j * A k l = A i l * A k j) :
    ∃ (a : I → ℤ) (b : J → ℤ),
      (∀ i j, A i j = a i * b j) ∧ Finset.univ.gcd a = 1 := by
  apply integer_rankOne_factors A _ hminor
  by_contra! hh
  exact hA (funext fun i => funext fun j => hh i j)

/-- A rational outer factorization of an integer matrix already forces integer factors. -/
def integer_rankOne_factors_of_rat (A : I → J → ℤ) (hA : A ≠ 0)
    (u : I → ℚ) (v : J → ℚ) (huv : ∀ i j, (A i j : ℚ) = u i * v j) :
    ∃ (a : I → ℤ) (b : J → ℤ),
      (∀ i j, A i j = a i * b j) ∧ Finset.univ.gcd a = 1 := by
  apply integer_rankOne_factors_of_ne_zero A hA
  intro i k j l
  have hh : (A i j : ℚ) * (A k l : ℚ) = (A i l : ℚ) * (A k j : ℚ) := by
    simp only [huv]
    ring
  exact_mod_cast hh

/-- Nonzero rational outer factors differ from the integral ones by reciprocal scalars. -/
def integer_rankOne_factors_with_rat_scalars (A : I → J → ℤ) (hA : A ≠ 0)
    (u : I → ℚ) (v : J → ℚ) (huv : ∀ i j, (A i j : ℚ) = u i * v j) :
    ∃ (a : I → ℤ) (b : J → ℤ) (c : ℚ), c ≠ 0 ∧
      (∀ i j, A i j = a i * b j) ∧ Finset.univ.gcd a = 1 ∧
      (∀ i, (a i : ℚ) = c * u i) ∧ (∀ j, (b j : ℚ) = c⁻¹ * v j) := by
  obtain ⟨a, b, hab, hprimitive⟩ := integer_rankOne_factors_of_rat A hA u v huv
  have hex : ∃ i j, A i j ≠ 0 := by
    by_contra! hh
    exact hA (funext fun i => funext fun j => hh i j)
  obtain ⟨i₀, j₀, hnonzero⟩ := hex
  have hnrat : (A i₀ j₀ : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hnonzero
  have hu : u i₀ ≠ 0 := left_ne_zero_of_mul (huv i₀ j₀ ▸ hnrat)
  have hv : v j₀ ≠ 0 := right_ne_zero_of_mul (huv i₀ j₀ ▸ hnrat)
  have ha : (a i₀ : ℚ) ≠ 0 := by
    exact_mod_cast left_ne_zero_of_mul (hab i₀ j₀ ▸ hnonzero)
  have hb : (b j₀ : ℚ) ≠ 0 := by
    exact_mod_cast right_ne_zero_of_mul (hab i₀ j₀ ▸ hnonzero)
  let c : ℚ := v j₀ / (b j₀ : ℚ)
  have hc : c ≠ 0 := div_ne_zero hv hb
  have haq (i : I) : (a i : ℚ) = c * u i := by
    apply (mul_right_cancel₀ hb)
    calc
      (a i : ℚ) * (b j₀ : ℚ) = (A i j₀ : ℚ) := by rw [hab]; norm_cast
      _ = u i * v j₀ := huv i j₀
      _ = (c * u i) * (b j₀ : ℚ) := by
        dsimp [c]
        rw [mul_right_comm, div_mul_cancel₀ _ hb, mul_comm]
  have hbq (j : J) : (b j : ℚ) = c⁻¹ * v j := by
    apply (mul_left_cancel₀ ha)
    calc
      (a i₀ : ℚ) * (b j : ℚ) = (A i₀ j : ℚ) := by rw [hab]; norm_cast
      _ = u i₀ * v j := huv i₀ j
      _ = (a i₀ : ℚ) * (c⁻¹ * v j) := by
        rw [haq]
        calc
          u i₀ * v j = (c * c⁻¹) * (u i₀ * v j) := by rw [mul_inv_cancel₀ hc, one_mul]
          _ = _ := by ring
  exact ⟨a, b, c, hc, hab, hprimitive, haq, hbq⟩


end
end Bounty
end RothComponent_IntegerRankOneFactors

/- Component: IntegerSeparatedPolynomialFactors; SHA256 dc689aa94900a5b76e9ec64ef87efd347952f4ca61318992055d148b467b33c3 -/
section RothComponent_IntegerSeparatedPolynomialFactors
/- Integral separated factors of an integer polynomial known to split rationally.
The finite coefficient matrix is indexed by the supports of the rational factors. -/

namespace Bounty
noncomputable section
open scoped BigOperators Polynomial

variable {I : Type*}

def separatedPolynomial_coeff {R : Type*} [CommSemiring R]
    (U₂ : MvPolynomial I R) (U₁ : Polynomial R) (d : I →₀ ℕ) (n : ℕ) :
    MvPolynomial.coeff d ((Polynomial.C U₂ * U₁.map MvPolynomial.C).coeff n) =
      MvPolynomial.coeff d U₂ * U₁.coeff n := by
  rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, mul_comm U₂,
    MvPolynomial.coeff_C_mul, mul_comm]

private def reconstruct_mv_rat (U : MvPolynomial I ℚ) (a : U.support → ℤ)
    (c : ℚ) (ha : ∀ d, (a d : ℚ) = c * MvPolynomial.coeff d.1 U) :
    MvPolynomial.map (Int.castRingHom ℚ)
        (∑ d : U.support, MvPolynomial.monomial d.1 (a d)) = c • U := by
  classical
  simp only [map_sum, MvPolynomial.map_monomial]
  calc
    (∑ d : U.support, MvPolynomial.monomial d.1 (a d : ℚ)) =
        ∑ d : U.support, c • MvPolynomial.monomial d.1 (MvPolynomial.coeff d.1 U) := by
      apply Finset.sum_congr rfl
      intro d _
      rw [ha]
      simp only [MvPolynomial.smul_monomial, smul_eq_mul]
    _ = c • (∑ d : U.support, MvPolynomial.monomial d.1 (MvPolynomial.coeff d.1 U)) :=
      Finset.smul_sum.symm
    _ = c • U := by
      congr 1
      calc
        _ = ∑ d ∈ U.support, MvPolynomial.monomial d (MvPolynomial.coeff d U) :=
          Finset.sum_coe_sort U.support (fun d => MvPolynomial.monomial d (MvPolynomial.coeff d U))
        _ = U := MvPolynomial.support_sum_monomial_coeff U

private def reconstruct_uni_rat (U : Polynomial ℚ) (a : U.support → ℤ)
    (c : ℚ) (ha : ∀ n, (a n : ℚ) = c * U.coeff n.1) :
    (∑ n : U.support, Polynomial.monomial n.1 (a n)).map (Int.castRingHom ℚ) = c • U := by
  classical
  simp only [Polynomial.map_sum, Polynomial.map_monomial]
  calc
    (∑ n : U.support, Polynomial.monomial n.1 (a n : ℚ)) =
        ∑ n : U.support, c • Polynomial.monomial n.1 (U.coeff n.1) := by
      apply Finset.sum_congr rfl
      intro n _
      rw [ha]
      simp only [Polynomial.smul_monomial, smul_eq_mul]
    _ = c • (∑ n : U.support, Polynomial.monomial n.1 (U.coeff n.1)) :=
      Finset.smul_sum.symm
    _ = c • U := by
      congr 1
      calc
        _ = ∑ n ∈ U.support, Polynomial.monomial n (U.coeff n) :=
          Finset.sum_coe_sort U.support (fun n => Polynomial.monomial n (U.coeff n))
        _ = U := Polynomial.sum_monomial_eq U

/-- An integer polynomial with a rational separated factorization has integer separated
factors.  Their rational images differ from the original factors by reciprocal scalars. -/
def integer_separated_polynomial_factors
    (V : Polynomial (MvPolynomial I ℤ)) (U₂ : MvPolynomial I ℚ) (U₁ : Polynomial ℚ)
    (hU₂ : U₂ ≠ 0) (hU₁ : U₁ ≠ 0)
    (hV : V.map (MvPolynomial.map (Int.castRingHom ℚ)) =
      Polynomial.C U₂ * U₁.map MvPolynomial.C) :
    ∃ (F₂ : MvPolynomial I ℤ) (F₁ : Polynomial ℤ) (c : ℚ),
      F₂ ≠ 0 ∧ F₁ ≠ 0 ∧ c ≠ 0 ∧
      V = Polynomial.C F₂ * F₁.map MvPolynomial.C ∧
      MvPolynomial.map (Int.castRingHom ℚ) F₂ = c • U₂ ∧
      F₁.map (Int.castRingHom ℚ) = c⁻¹ • U₁ := by
  classical
  let A : U₂.support → U₁.support → ℤ := fun d n => MvPolynomial.coeff d.1 (V.coeff n.1)
  have hcoeff (d : I →₀ ℕ) (n : ℕ) :
      ((MvPolynomial.coeff d (V.coeff n) : ℤ) : ℚ) = MvPolynomial.coeff d U₂ * U₁.coeff n := by
    have hh := congrArg (fun W : Polynomial (MvPolynomial I ℚ) =>
      MvPolynomial.coeff d (W.coeff n)) hV
    simpa only [Polynomial.coeff_map, MvPolynomial.coeff_map, Int.coe_castRingHom,
      separatedPolynomial_coeff] using hh
  have hA : A ≠ 0 := by
    obtain ⟨d, hd⟩ := MvPolynomial.support_nonempty.mpr hU₂
    obtain ⟨n, hn⟩ := Polynomial.support_nonempty.mpr hU₁
    intro hz
    have hh := hcoeff d n
    have haz : A ⟨d, hd⟩ ⟨n, hn⟩ = 0 := congrFun (congrFun hz ⟨d, hd⟩) ⟨n, hn⟩
    change MvPolynomial.coeff d (V.coeff n) = 0 at haz
    rw [haz, Int.cast_zero] at hh
    exact (mul_ne_zero (MvPolynomial.mem_support_iff.mp hd)
      (Polynomial.mem_support_iff.mp hn)) hh.symm
  obtain ⟨a, b, c, hc, hab, _, ha, hb⟩ := integer_rankOne_factors_with_rat_scalars A hA
    (fun d => MvPolynomial.coeff d.1 U₂) (fun n => U₁.coeff n.1)
    (fun d n => hcoeff d.1 n.1)
  let F₂ : MvPolynomial I ℤ := ∑ d : U₂.support, MvPolynomial.monomial d.1 (a d)
  let F₁ : Polynomial ℤ := ∑ n : U₁.support, Polynomial.monomial n.1 (b n)
  have hF₂ : MvPolynomial.map (Int.castRingHom ℚ) F₂ = c • U₂ := reconstruct_mv_rat U₂ a c ha
  have hF₁ : F₁.map (Int.castRingHom ℚ) = c⁻¹ • U₁ := reconstruct_uni_rat U₁ b c⁻¹ hb
  have hF₂ne : F₂ ≠ 0 := by
    intro hz
    rw [hz, map_zero] at hF₂
    exact (smul_ne_zero hc hU₂) hF₂.symm
  have hF₁ne : F₁ ≠ 0 := by
    intro hz
    rw [hz, Polynomial.map_zero] at hF₁
    exact (smul_ne_zero (inv_ne_zero hc) hU₁) hF₁.symm
  refine ⟨F₂, F₁, c, hF₂ne, hF₁ne, hc, ?_, hF₂, hF₁⟩
  apply Polynomial.ext
  intro n
  apply MvPolynomial.ext
  intro d
  apply (Int.cast_injective : Function.Injective (fun z : ℤ => (z : ℚ)))
  rw [separatedPolynomial_coeff, Int.cast_mul, hcoeff]
  have h₂ := congrArg (MvPolynomial.coeff d) hF₂
  have h₁ := congrArg (fun Q : Polynomial ℚ => Q.coeff n) hF₁
  simp only [MvPolynomial.coeff_map, Int.coe_castRingHom, MvPolynomial.coeff_smul,
    smul_eq_mul] at h₂
  simp only [Polynomial.coeff_map, Int.coe_castRingHom, Polynomial.coeff_smul,
    smul_eq_mul] at h₁
  rw [h₂, h₁]
  calc
    MvPolynomial.coeff d U₂ * U₁.coeff n =
        (c * c⁻¹) * (MvPolynomial.coeff d U₂ * U₁.coeff n) := by
      rw [mul_inv_cancel₀ hc, one_mul]
    _ = _ := by ring


end
end Bounty
end RothComponent_IntegerSeparatedPolynomialFactors

/- Component: SeparatedCoefficientNorm; SHA256 d7cff77cebfa685d57d33afcb03be5da94dc8ba82e823c0eeacbea75476bb77e -/
section RothComponent_SeparatedCoefficientNorm
/- Exact coefficient-sum norms for separated products, integral lower bounds,
and invariance under coefficient embeddings preserving the norm. -/

namespace Bounty
noncomputable section
open scoped BigOperators Polynomial

variable {I R S : Type*} [NormedCommRing R] [NormedCommRing S]

def univariateCoeffL1 (P : Polynomial R) : ℝ := ∑ n ∈ P.support, ‖P.coeff n‖

def iteratedCoeffL1 (V : Polynomial (MvPolynomial I R)) : ℝ :=
  ∑ n ∈ V.support, polynomialCoeffL1 (V.coeff n)

def univariateCoeffL1_nonneg (P : Polynomial R) : 0 ≤ univariateCoeffL1 P :=
  Finset.sum_nonneg (fun _ _ => norm_nonneg _)

def norm_coeff_le_univariateCoeffL1 (P : Polynomial R) (n : ℕ) :
    ‖P.coeff n‖ ≤ univariateCoeffL1 P := by
  classical
  by_cases hn : n ∈ P.support
  · exact Finset.single_le_sum (fun _ _ => norm_nonneg _) hn
  · simp only [Polynomial.notMem_support_iff.mp hn, norm_zero]
    exact univariateCoeffL1_nonneg P

def iteratedCoeffL1_sum_of_support_subset (V : Polynomial (MvPolynomial I R))
    (s : Finset ℕ) (hs : V.support ⊆ s) :
    iteratedCoeffL1 V = ∑ n ∈ s, polynomialCoeffL1 (V.coeff n) := by
  classical
  apply Finset.sum_subset hs
  intro n _ hn
  rw [Polynomial.notMem_support_iff.mp hn, polynomialCoeffL1_zero]

def polynomialCoeffL1_smul_eq [NormMulClass R] (a : R) (P : MvPolynomial I R) :
    polynomialCoeffL1 (a • P) = ‖a‖ * polynomialCoeffL1 P := by
  rw [polynomialCoeffL1_sum_of_support_subset (a • P) P.support MvPolynomial.support_smul]
  simp only [MvPolynomial.coeff_smul, smul_eq_mul, norm_mul, polynomialCoeffL1, Finset.mul_sum]

def iteratedCoeffL1_separated [NormMulClass R]
    (F₂ : MvPolynomial I R) (F₁ : Polynomial R) :
    iteratedCoeffL1 (Polynomial.C F₂ * F₁.map MvPolynomial.C) =
      polynomialCoeffL1 F₂ * univariateCoeffL1 F₁ := by
  classical
  have hs : (Polynomial.C F₂ * F₁.map MvPolynomial.C).support ⊆ F₁.support := by
    intro n hn
    by_contra hn'
    have hz : (Polynomial.C F₂ * F₁.map MvPolynomial.C).coeff n = 0 := by
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, Polynomial.notMem_support_iff.mp hn',
        map_zero, mul_zero]
    exact Polynomial.mem_support_iff.mp hn hz
  rw [iteratedCoeffL1_sum_of_support_subset _ F₁.support hs]
  simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map]
  have he (n : ℕ) : F₂ * MvPolynomial.C (F₁.coeff n) = (F₁.coeff n) • F₂ := by
    rw [MvPolynomial.smul_eq_C_mul, mul_comm]
  simp_rw [he, polynomialCoeffL1_smul_eq]
  rw [← Finset.sum_mul, mul_comm]
  rfl

def one_le_polynomialCoeffL1_int {P : MvPolynomial I ℤ} (hP : P ≠ 0) :
    1 ≤ polynomialCoeffL1 P := by
  obtain ⟨d, hd⟩ := MvPolynomial.exists_coeff_ne_zero hP
  have hnorm : (1 : ℝ) ≤ ‖MvPolynomial.coeff d P‖ := by
    rw [Int.norm_eq_abs]
    exact_mod_cast Int.one_le_abs hd
  exact hnorm.trans (norm_coeff_le_polynomialCoeffL1 P d)

def one_le_univariateCoeffL1_int {P : Polynomial ℤ} (hP : P ≠ 0) :
    1 ≤ univariateCoeffL1 P := by
  obtain ⟨n, hn⟩ := Polynomial.support_nonempty.mpr hP
  have hnorm : (1 : ℝ) ≤ ‖P.coeff n‖ := by
    rw [Int.norm_eq_abs]
    exact_mod_cast Int.one_le_abs (Polynomial.mem_support_iff.mp hn)
  exact hnorm.trans (norm_coeff_le_univariateCoeffL1 P n)

def separated_factor_log_bounds (F₂ : MvPolynomial I ℤ) (F₁ : Polynomial ℤ)
    (hF₂ : F₂ ≠ 0) (hF₁ : F₁ ≠ 0) :
    0 ≤ Real.log (polynomialCoeffL1 F₂) ∧ 0 ≤ Real.log (univariateCoeffL1 F₁) ∧
      Real.log (polynomialCoeffL1 F₂) ≤
        Real.log (iteratedCoeffL1 (Polynomial.C F₂ * F₁.map MvPolynomial.C)) ∧
      Real.log (univariateCoeffL1 F₁) ≤
        Real.log (iteratedCoeffL1 (Polynomial.C F₂ * F₁.map MvPolynomial.C)) := by
  have h₂ := one_le_polynomialCoeffL1_int hF₂
  have h₁ := one_le_univariateCoeffL1_int hF₁
  rw [iteratedCoeffL1_separated]
  refine ⟨Real.log_nonneg h₂, Real.log_nonneg h₁, ?_, ?_⟩
  · apply Real.log_le_log (lt_of_lt_of_le zero_lt_one h₂)
    exact le_mul_of_one_le_right (polynomialCoeffL1_nonneg F₂) h₁
  · apply Real.log_le_log (lt_of_lt_of_le zero_lt_one h₁)
    exact le_mul_of_one_le_left (univariateCoeffL1_nonneg F₁) h₂

def polynomialCoeffL1_map (f : R →+* S) (hf : Function.Injective f)
    (hnorm : ∀ a, ‖f a‖ = ‖a‖) (P : MvPolynomial I R) :
    polynomialCoeffL1 (MvPolynomial.map f P) = polynomialCoeffL1 P := by
  classical
  unfold polynomialCoeffL1
  rw [MvPolynomial.support_map_of_injective P hf]
  simp only [MvPolynomial.coeff_map, hnorm]

def univariateCoeffL1_map (f : R →+* S) (hf : Function.Injective f)
    (hnorm : ∀ a, ‖f a‖ = ‖a‖) (P : Polynomial R) :
    univariateCoeffL1 (P.map f) = univariateCoeffL1 P := by
  classical
  unfold univariateCoeffL1
  rw [Polynomial.support_map_of_injective P hf]
  simp only [Polynomial.coeff_map, hnorm]

def iteratedCoeffL1_map (f : R →+* S) (hf : Function.Injective f)
    (hnorm : ∀ a, ‖f a‖ = ‖a‖) (V : Polynomial (MvPolynomial I R)) :
    iteratedCoeffL1 (V.map (MvPolynomial.map f)) = iteratedCoeffL1 V := by
  classical
  unfold iteratedCoeffL1
  rw [Polynomial.support_map_of_injective V (MvPolynomial.map_injective f hf)]
  simp only [Polynomial.coeff_map, polynomialCoeffL1_map f hf hnorm]

def polynomialCoeffL1_map_int_rat (P : MvPolynomial I ℤ) :
    polynomialCoeffL1 (MvPolynomial.map (Int.castRingHom ℚ) P) = polynomialCoeffL1 P :=
  polynomialCoeffL1_map (Int.castRingHom ℚ) Int.cast_injective Int.norm_cast_rat P

def iteratedCoeffL1_map_int_rat (V : Polynomial (MvPolynomial I ℤ)) :
    iteratedCoeffL1 (V.map (MvPolynomial.map (Int.castRingHom ℚ))) = iteratedCoeffL1 V :=
  iteratedCoeffL1_map (Int.castRingHom ℚ) Int.cast_injective Int.norm_cast_rat V


end
end Bounty
end RothComponent_SeparatedCoefficientNorm

/- Component: RothDerivativeFactorization; SHA256 ee5830d1622c5270be282fd3d302ac68f47984767bb609af5be794a2e1973992 -/
section RothComponent_RothDerivativeFactorization
/- The actual mixed-derivative determinant in the rational Roth argument. -/

noncomputable section


open Polynomial MvPolynomial Matrix Finset

namespace Bounty

def wordCoefficientDerivative {m : ℕ} (w : List (Fin m)) :
    (MvPolynomial (Fin m) ℚ)[X] →ₗ[ℚ] (MvPolynomial (Fin m) ℚ)[X] :=
  Polynomial.lsum fun n =>
    ((Polynomial.monomial n).restrictScalars ℚ).comp (wordPDeriv w)

def wordCoefficientDerivative_coeff {m : ℕ} (w : List (Fin m))
    (P : (MvPolynomial (Fin m) ℚ)[X]) (n : ℕ) :
    (wordCoefficientDerivative w P).coeff n = wordPDeriv w (P.coeff n) := by
  classical
  by_cases hn : n ∈ P.support
  · simp [wordCoefficientDerivative, Polynomial.lsum_apply,
      Polynomial.sum_def, Polynomial.coeff_monomial, hn]
  · have hz : P.coeff n = 0 := Polynomial.notMem_support_iff.mp hn
    simp [wordCoefficientDerivative, Polynomial.lsum_apply,
      Polynomial.sum_def, Polynomial.coeff_monomial, hn, hz]

def wordCoefficientDerivative_C_mul_map {m : ℕ} (w : List (Fin m))
    (a : MvPolynomial (Fin m) ℚ) (q : ℚ[X]) :
    wordCoefficientDerivative w (Polynomial.C a * q.map MvPolynomial.C) =
      Polynomial.C (wordPDeriv w a) * q.map MvPolynomial.C := by
  ext n
  simp only [wordCoefficientDerivative_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_map]
  rw [mul_comm a, MvPolynomial.C_mul', map_smul, ← MvPolynomial.C_mul', mul_comm]

def rothMixedDerivative {m : ℕ} (w : List (Fin m)) (n : ℕ)
    (P : (MvPolynomial (Fin m) ℚ)[X]) : (MvPolynomial (Fin m) ℚ)[X] :=
  Polynomial.derivative^[n] (wordCoefficientDerivative w P)

def rothMixedDerivative_separated_sum {m k : ℕ}
    (P : (MvPolynomial (Fin m) ℚ)[X])
    (φ : Fin k → MvPolynomial (Fin m) ℚ) (ψ : Fin k → ℚ[X])
    (hsplit : P = ∑ j, Polynomial.C (φ j) * (ψ j).map MvPolynomial.C)
    (w : List (Fin m)) (n : ℕ) :
    rothMixedDerivative w n P =
      ∑ j, Polynomial.C (wordPDeriv w (φ j)) *
        ((Polynomial.derivative^[n]) (ψ j)).map MvPolynomial.C := by
  unfold rothMixedDerivative
  rw [hsplit, map_sum, Polynomial.iterate_derivative_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rw [wordCoefficientDerivative_C_mul_map, Polynomial.iterate_derivative_C_mul,
    Polynomial.iterate_derivative_map]

def rothMixedDerivative_matrix_factorization {m k : ℕ}
    (P : (MvPolynomial (Fin m) ℚ)[X])
    (φ : Fin k → MvPolynomial (Fin m) ℚ) (ψ : Fin k → ℚ[X])
    (hsplit : P = ∑ j, Polynomial.C (φ j) * (ψ j).map MvPolynomial.C)
    (w : Fin k → List (Fin m)) :
    (Matrix.of fun i j : Fin k => rothMixedDerivative (w i) j.val P) =
      Polynomial.C.mapMatrix (fun i j : Fin k => wordPDeriv (w i) (φ j)) *
      (Polynomial.mapRingHom MvPolynomial.C).mapMatrix
        (Matrix.transpose (fun i j : Fin k => (Polynomial.derivative^[i.val]) (ψ j))) := by
  funext i j
  change rothMixedDerivative (w i) j.val P =
    ∑ s, Polynomial.C (wordPDeriv (w i) (φ s)) *
      ((Polynomial.derivative^[j.val]) (ψ s)).map MvPolynomial.C
  exact rothMixedDerivative_separated_sum P φ ψ hsplit (w i) j.val

def rothMixedDerivative_det_factorization {m k : ℕ}
    (P : (MvPolynomial (Fin m) ℚ)[X])
    (φ : Fin k → MvPolynomial (Fin m) ℚ) (ψ : Fin k → ℚ[X])
    (hsplit : P = ∑ j, Polynomial.C (φ j) * (ψ j).map MvPolynomial.C)
    (w : Fin k → List (Fin m)) :
    Matrix.det (fun i j : Fin k => rothMixedDerivative (w i) j.val P) =
      Polynomial.C (Matrix.det (fun i j : Fin k => wordPDeriv (w i) (φ j))) *
      (Matrix.det (fun i j : Fin k => (Polynomial.derivative^[i.val]) (ψ j))).map
        MvPolynomial.C := by
  change (Matrix.of fun i j : Fin k => rothMixedDerivative (w i) j.val P).det = _
  erw [rothMixedDerivative_matrix_factorization P φ ψ hsplit w, Matrix.det_mul,
    ← Polynomial.C.map_det]
  congr 1
  exact ((Polynomial.mapRingHom MvPolynomial.C).map_det
    (Matrix.transpose (Matrix.of fun i j : Fin k =>
      (Polynomial.derivative^[i.val]) (ψ j)))).symm.trans (by rw [Matrix.det_transpose])

def polynomial_det_natDegree_le {k r : ℕ}
    (A : Matrix (Fin k) (Fin k) ℚ[X])
    (hA : ∀ i j, (A i j).natDegree ≤ r) : A.det.natDegree ≤ k * r := by
  classical
  rw [Matrix.det_apply]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro σ hσ
  calc
    (Equiv.Perm.sign σ • ∏ j, A (σ j) j).natDegree ≤
        (∏ j, A (σ j) j).natDegree := Polynomial.natDegree_smul_le _ _
    _ ≤ ∑ j, (A (σ j) j).natDegree := Polynomial.natDegree_prod_le _ _
    _ ≤ ∑ _j : Fin k, r := Finset.sum_le_sum (fun j _ => hA (σ j) j)
    _ = k * r := by simp

end Bounty
end
end RothComponent_RothDerivativeFactorization

/- Component: RothDividedFactorization; SHA256 395032c6da3ecff164cf75cbcf9df74464ca9dfec1858d98e6fd31a5bd719441 -/
section RothComponent_RothDividedFactorization
/- Divided derivative factorization with the last variable isolated. -/

noncomputable section
open Polynomial MvPolynomial Matrix Finset
namespace Bounty

def lastVariableEquiv (m : ℕ) : MvPolynomial (Fin (m + 1)) ℚ ≃ₐ[ℚ]
    (MvPolynomial (Fin m) ℚ)[X] :=
  (MvPolynomial.renameEquiv ℚ (finRotate (m + 1))).trans
    (MvPolynomial.finSuccEquiv ℚ m)

def finRotate_castSucc {m : ℕ} (i : Fin m) :
    finRotate (m + 1) i.castSucc = i.succ := by
  exact finRotate_of_lt i.isLt

def lastVariableEquiv_natDegree {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) :
    (lastVariableEquiv m P).natDegree = P.degreeOf (Fin.last m) := by
  change (MvPolynomial.finSuccEquiv ℚ m
    (MvPolynomial.rename (finRotate (m + 1)) P)).natDegree = _
  rw [MvPolynomial.natDegree_finSuccEquiv, ← finRotate_last]
  exact MvPolynomial.degreeOf_rename_of_injective (finRotate (m + 1)).injective _

def lastVariableEquiv_coeff_degreeOf {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (i : Fin m) (n : ℕ) :
    ((lastVariableEquiv m P).coeff n).degreeOf i ≤ P.degreeOf i.castSucc := by
  change ((MvPolynomial.finSuccEquiv ℚ m
    (MvPolynomial.rename (finRotate (m + 1)) P)).coeff n).degreeOf i ≤ _
  calc
    _ ≤ (MvPolynomial.rename (finRotate (m + 1)) P).degreeOf i.succ :=
      MvPolynomial.degreeOf_coeff_finSuccEquiv _ _ _
    _ = _ := by rw [← finRotate_castSucc i];
                exact MvPolynomial.degreeOf_rename_of_injective
                  (finRotate (m + 1)).injective i.castSucc

def finSuccEquiv_pderiv_zero {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) :
    MvPolynomial.finSuccEquiv ℚ m (MvPolynomial.pderiv 0 P) =
      Polynomial.derivative (MvPolynomial.finSuccEquiv ℚ m P) := by
  apply Polynomial.ext
  intro n
  apply MvPolynomial.ext
  intro a
  have he : a.cons n + Finsupp.single 0 1 = a.cons (n + 1) := by
    ext j
    cases j using Fin.cases <;> simp
  simp only [MvPolynomial.finSuccEquiv_coeff_coeff, MvPolynomial.coeff_pderiv,
    Polynomial.coeff_derivative, he, Finsupp.cons_zero]
  rw [show (n : MvPolynomial (Fin m) ℚ) + 1 = MvPolynomial.C (n + 1 : ℚ) by simp,
    mul_comm (((MvPolynomial.finSuccEquiv ℚ m) P).coeff (n + 1)),
    MvPolynomial.coeff_C_mul, MvPolynomial.finSuccEquiv_coeff_coeff, mul_comm]

def finSuccEquiv_pderiv_succ {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (i : Fin m) :
    MvPolynomial.finSuccEquiv ℚ m (MvPolynomial.pderiv i.succ P) =
      wordCoefficientDerivative [i] (MvPolynomial.finSuccEquiv ℚ m P) := by
  apply Polynomial.ext
  intro n
  apply MvPolynomial.ext
  intro a
  have he : a.cons n + Finsupp.single i.succ 1 =
      (a + Finsupp.single i 1).cons n := by
    ext j
    cases j using Fin.cases <;> simp [Finsupp.single_apply]
  simp only [wordCoefficientDerivative_coeff, wordPDeriv_cons, wordPDeriv_nil,
    MvPolynomial.finSuccEquiv_coeff_coeff, MvPolynomial.coeff_pderiv,
    he, Finsupp.cons_succ]

def lastVariableEquiv_pderiv_last {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) :
    lastVariableEquiv m (MvPolynomial.pderiv (Fin.last m) P) =
      Polynomial.derivative (lastVariableEquiv m P) := by
  change MvPolynomial.finSuccEquiv ℚ m
    (MvPolynomial.rename (finRotate (m + 1)) (MvPolynomial.pderiv _ P)) = _
  rw [← MvPolynomial.pderiv_rename (finRotate (m + 1)).injective, finRotate_last]
  exact finSuccEquiv_pderiv_zero _

def lastVariableEquiv_pderiv_castSucc {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (i : Fin m) :
    lastVariableEquiv m (MvPolynomial.pderiv i.castSucc P) =
      wordCoefficientDerivative [i] (lastVariableEquiv m P) := by
  change MvPolynomial.finSuccEquiv ℚ m
    (MvPolynomial.rename (finRotate (m + 1)) (MvPolynomial.pderiv _ P)) = _
  rw [← MvPolynomial.pderiv_rename (finRotate (m + 1)).injective,
    finRotate_castSucc]
  exact finSuccEquiv_pderiv_succ _ _

def lastVariableEquiv_word_castSucc {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (w : List (Fin m)) :
    lastVariableEquiv m (wordPDeriv (w.map Fin.castSucc) P) =
      wordCoefficientDerivative w (lastVariableEquiv m P) := by
  induction w with
  | nil =>
    apply Polynomial.ext
    intro n
    simp [wordCoefficientDerivative_coeff, wordPDeriv_nil]
  | cons i w hw =>
    simp only [List.map_cons, wordPDeriv_cons, lastVariableEquiv_pderiv_castSucc, hw]
    apply Polynomial.ext
    intro n
    simp [wordCoefficientDerivative_coeff, wordPDeriv_cons, wordPDeriv_nil]

def lastVariableEquiv_word_last {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (n : ℕ) :
    lastVariableEquiv m (wordPDeriv (List.replicate n (Fin.last m)) P) =
      (Polynomial.derivative^[n]) (lastVariableEquiv m P) := by
  induction n with
  | zero => simp [wordPDeriv_nil]
  | succ n hn =>
    rw [List.replicate_succ, wordPDeriv_cons, lastVariableEquiv_pderiv_last, hn,
      Function.iterate_succ_apply']

def degreeOf_pderiv_le {I : Type*} (P : MvPolynomial I ℚ) (i j : I) :
    (MvPolynomial.pderiv j P).degreeOf i ≤ P.degreeOf i := by
  classical
  apply MvPolynomial.degreeOf_le_iff.mpr
  intro a ha
  have hc := MvPolynomial.mem_support_iff.mp ha
  rw [MvPolynomial.coeff_pderiv] at hc
  have hmem : a + Finsupp.single j 1 ∈ P.support :=
    MvPolynomial.mem_support_iff.mpr (left_ne_zero_of_mul hc)
  exact (Nat.le_add_right _ _).trans
    (MvPolynomial.le_degreeOf_of_mem_support i hmem)

def degreeOf_wordPDeriv_le {I : Type*} (P : MvPolynomial I ℚ)
    (w : List I) (i : I) : (wordPDeriv w P).degreeOf i ≤ P.degreeOf i := by
  induction w with
  | nil => simp [wordPDeriv_nil]
  | cons j w hw => exact (degreeOf_pderiv_le _ i j).trans hw

def mvPolynomial_det_degreeOf_le {I : Type*} {k r : ℕ}
    (A : Matrix (Fin k) (Fin k) (MvPolynomial I ℚ)) (a : I)
    (hA : ∀ i j, (A i j).degreeOf a ≤ r) : A.det.degreeOf a ≤ k * r := by
  classical
  rw [Matrix.det_apply]
  apply (MvPolynomial.degreeOf_sum_le _ _ _).trans
  apply Finset.sup_le
  intro σ hσ
  have hs : (Equiv.Perm.sign σ • ∏ j, A (σ j) j).degreeOf a ≤
      (∏ j, A (σ j) j).degreeOf a := by
    simp only [MvPolynomial.degreeOf_eq_sup]
    exact Finset.sup_mono MvPolynomial.support_smul
  calc
    _ ≤ _ := hs
    _ ≤ ∑ j, (A (σ j) j).degreeOf a := MvPolynomial.degreeOf_prod_le _ _ _
    _ ≤ ∑ _j : Fin k, r := Finset.sum_le_sum (fun j _ => hA (σ j) j)
    _ = k * r := by simp

def lastVariableEquiv_rename_castSucc {m : ℕ} (P : MvPolynomial (Fin m) ℚ) :
    lastVariableEquiv m (MvPolynomial.rename Fin.castSucc P) = Polynomial.C P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [lastVariableEquiv, MvPolynomial.finSuccEquiv_apply]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
    rw [map_mul, map_mul, hp, map_mul]
    apply congrArg (fun q => Polynomial.C p * q)
    change MvPolynomial.finSuccEquiv ℚ m
      (MvPolynomial.rename (finRotate (m + 1))
        (MvPolynomial.rename Fin.castSucc (MvPolynomial.X i))) = _
    rw [MvPolynomial.rename_X, MvPolynomial.rename_X, finRotate_castSucc,
      MvPolynomial.finSuccEquiv_X_succ]

def lastVariableEquiv_aeval_last {m : ℕ} (P : ℚ[X]) :
    lastVariableEquiv m (Polynomial.aeval (MvPolynomial.X (Fin.last m)) P) =
      P.map MvPolynomial.C := by
  induction P using Polynomial.induction_on' with
  | add p q hp hq => simp [hp, hq]
  | monomial n a =>
    rw [← Polynomial.C_mul_X_pow_eq_monomial]
    simp [lastVariableEquiv, MvPolynomial.finSuccEquiv_apply]

def rothDividedDerivative {m : ℕ} (w : List (Fin m)) (n : ℕ)
    (P : MvPolynomial (Fin (m + 1)) ℚ) : MvPolynomial (Fin (m + 1)) ℚ :=
  dividedWordPDeriv (List.replicate n (Fin.last m))
    (dividedWordPDeriv (w.map Fin.castSucc) P)

def rothRowScalar {m : ℕ} (w : List (Fin m)) : ℚ :=
  (wordDerivativeFactorial (w.map Fin.castSucc))⁻¹

def rothColumnScalar (m n : ℕ) : ℚ :=
  (wordDerivativeFactorial (List.replicate n (Fin.last m)))⁻¹

def rothRowScalar_ne_zero {m : ℕ} (w : List (Fin m)) : rothRowScalar w ≠ 0 :=
  inv_ne_zero (wordDerivativeFactorial_ne_zero _)

def rothColumnScalar_ne_zero (m n : ℕ) : rothColumnScalar m n ≠ 0 :=
  inv_ne_zero (wordDerivativeFactorial_ne_zero _)

def lastVariableEquiv_rothDividedDerivative {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (w : List (Fin m)) (n : ℕ) :
    lastVariableEquiv m (rothDividedDerivative w n P) =
      rothColumnScalar m n • rothRowScalar w •
        rothMixedDerivative w n (lastVariableEquiv m P) := by
  unfold rothDividedDerivative dividedWordPDeriv
  simp only [LinearMap.smul_apply, map_smul]
  rw [lastVariableEquiv_word_last, lastVariableEquiv_word_castSucc]
  exact smul_comm _ _ _

def det_rational_row_smul {R : Type*} [CommRing R] [Algebra ℚ R]
    {k : ℕ} (c : Fin k → ℚ) (A : Matrix (Fin k) (Fin k) R) :
    Matrix.det (fun i j => c i • A i j) = (∏ i, c i) • A.det := by
  change (Matrix.of fun i j => c i • A i j).det = _
  simp only [Algebra.smul_def]
  rw [Matrix.det_mul_column, ← map_prod]

def det_rational_column_smul {R : Type*} [CommRing R] [Algebra ℚ R]
    {k : ℕ} (c : Fin k → ℚ) (A : Matrix (Fin k) (Fin k) R) :
    Matrix.det (fun i j => c j • A i j) = (∏ i, c i) • A.det := by
  change (Matrix.of fun i j => c j • A i j).det = _
  simp only [Algebra.smul_def]
  rw [Matrix.det_mul_row, ← map_prod]

def lastVariableEquiv_rothDivided_det {m k : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (w : Fin k → List (Fin m)) :
    lastVariableEquiv m (Matrix.det (fun i j : Fin k =>
      rothDividedDerivative (w i) j.val P)) =
      (∏ j : Fin k, rothColumnScalar m j.val) •
        (∏ i : Fin k, rothRowScalar (w i)) •
          Matrix.det (fun i j : Fin k =>
            rothMixedDerivative (w i) j.val (lastVariableEquiv m P)) := by
  change (lastVariableEquiv m).toRingHom ((Matrix.of fun i j : Fin k =>
    rothDividedDerivative (w i) j.val P).det) = _
  rw [(lastVariableEquiv m).toRingHom.map_det]
  change Matrix.det (fun i j : Fin k =>
    lastVariableEquiv m (rothDividedDerivative (w i) j.val P)) = _
  simp only [lastVariableEquiv_rothDividedDerivative]
  erw [det_rational_column_smul, det_rational_row_smul]

def rational_smul_separated (m : ℕ) (c d : ℚ)
    (A : MvPolynomial (Fin m) ℚ) (B : ℚ[X]) :
    d • c • (Polynomial.C A * B.map MvPolynomial.C) =
      Polynomial.C (c • A) * (d • B).map MvPolynomial.C := by
  apply Polynomial.ext
  intro n
  simp only [Polynomial.coeff_smul, Polynomial.coeff_C_mul, Polynomial.coeff_map]
  simp only [← MvPolynomial.C_mul', smul_eq_mul, map_mul]
  ring

def exists_rothDivided_factorization {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (hP : P ≠ 0)
    (r : Fin (m + 1) → ℕ) (hdegree : ∀ i, P.degreeOf i ≤ r i) :
    ∃ k : ℕ, 1 ≤ k ∧ k ≤ P.degreeOf (Fin.last m) + 1 ∧
      k ≤ r (Fin.last m) + 1 ∧
      ∃ w : Fin k → List (Fin m), (∀ i, (w i).length ≤ i.val) ∧
        ∃ U₂ : MvPolynomial (Fin m) ℚ, ∃ U₁ : ℚ[X],
          U₂ ≠ 0 ∧ U₁ ≠ 0 ∧
          (∀ a, U₂.degreeOf a ≤ k * r a.castSucc) ∧
          U₁.natDegree ≤ k * r (Fin.last m) ∧
          lastVariableEquiv m (Matrix.det (fun i j : Fin k =>
            rothDividedDerivative (w i) j.val P)) =
              Polynomial.C U₂ * U₁.map MvPolynomial.C ∧
          Matrix.det (fun i j : Fin k => rothDividedDerivative (w i) j.val P) =
            MvPolynomial.rename Fin.castSucc U₂ *
              Polynomial.aeval (MvPolynomial.X (Fin.last m)) U₁ ∧
          Matrix.det (fun i j : Fin k => rothDividedDerivative (w i) j.val P) ≠ 0 := by
  classical
  let Q := lastVariableEquiv m P
  have hQ : Q ≠ 0 :=
    (map_ne_zero_iff (lastVariableEquiv m) (lastVariableEquiv m).injective).mpr hP
  obtain ⟨k, hkpos, hk, φ, ψ, hφ, hψ, hφcoeff, hψdeg, hsplit⟩ :=
    mvPolynomial_separated_rank Q hQ
  obtain ⟨w, hw, hW₂⟩ := exists_generalizedWronskian_ne_zero φ hφ
  let W₂ := Matrix.det (fun i j : Fin k => wordPDeriv (w i) (φ j))
  let W₁ := Matrix.det (fun i j : Fin k => (Polynomial.derivative^[i.val]) (ψ j))
  let c : ℚ := ∏ i : Fin k, rothRowScalar (w i)
  let d : ℚ := ∏ j : Fin k, rothColumnScalar m j.val
  have hc : c ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => rothRowScalar_ne_zero (w i)
  have hd : d ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => rothColumnScalar_ne_zero m j.val
  have hW₁ : W₁ ≠ 0 := iterated_derivative_matrix_det_ne_zero ψ hψ
  have hW₂deg (a : Fin m) : W₂.degreeOf a ≤ k * r a.castSucc := by
    apply mvPolynomial_det_degreeOf_le
    intro i j
    obtain ⟨n, _, hn⟩ := hφcoeff j
    exact (degreeOf_wordPDeriv_le _ _ _).trans (by
      rw [hn]
      exact (lastVariableEquiv_coeff_degreeOf P a n).trans (hdegree a.castSucc))
  have hW₁deg : W₁.natDegree ≤ k * r (Fin.last m) := by
    apply polynomial_det_natDegree_le
    intro i j
    exact (Polynomial.natDegree_iterate_derivative (ψ j) i.val).trans
      ((Nat.sub_le _ _).trans ((hψdeg j).trans (by
        rw [lastVariableEquiv_natDegree]
        exact hdegree _)))
  let U₂ := c • W₂
  let U₁ := d • W₁
  have hU₂ : U₂ ≠ 0 := smul_ne_zero hc hW₂
  have hU₁ : U₁ ≠ 0 := smul_ne_zero hd hW₁
  have hU₂deg (a : Fin m) : U₂.degreeOf a ≤ k * r a.castSucc := by
    apply le_trans ?_ (hW₂deg a)
    change (c • W₂).degreeOf a ≤ W₂.degreeOf a
    simp only [MvPolynomial.degreeOf_eq_sup]
    exact Finset.sup_mono MvPolynomial.support_smul
  have hU₁deg : U₁.natDegree ≤ k * r (Fin.last m) :=
    (Polynomial.natDegree_smul_le _ _).trans hW₁deg
  have hfactor : lastVariableEquiv m (Matrix.det (fun i j : Fin k =>
      rothDividedDerivative (w i) j.val P)) =
        Polynomial.C U₂ * U₁.map MvPolynomial.C := by
    rw [lastVariableEquiv_rothDivided_det,
      rothMixedDerivative_det_factorization Q φ ψ hsplit w]
    exact rational_smul_separated m c d W₂ W₁
  have hactual : Matrix.det (fun i j : Fin k => rothDividedDerivative (w i) j.val P) =
      MvPolynomial.rename Fin.castSucc U₂ *
        Polynomial.aeval (MvPolynomial.X (Fin.last m)) U₁ := by
    apply (lastVariableEquiv m).injective
    rw [map_mul, lastVariableEquiv_rename_castSucc, lastVariableEquiv_aeval_last]
    exact hfactor
  have hnonzero : Matrix.det (fun i j : Fin k => rothDividedDerivative (w i) j.val P) ≠ 0 := by
    intro hz
    have hh : Polynomial.C U₂ * U₁.map MvPolynomial.C ≠ 0 :=
      mul_ne_zero (Polynomial.C_ne_zero.mpr hU₂) (Polynomial.map_ne_zero hU₁)
    apply hh
    rw [← hfactor, hz, map_zero]
  have hkactual : k ≤ P.degreeOf (Fin.last m) + 1 := by
    simpa only [Q, lastVariableEquiv_natDegree] using hk
  exact ⟨k, hkpos, hkactual, hkactual.trans (Nat.add_le_add_right (hdegree _) 1),
    w, hw, U₂, U₁, hU₂, hU₁, hU₂deg, hU₁deg, hfactor, hactual, hnonzero⟩

end Bounty
end
end RothComponent_RothDividedFactorization

/- Component: RothDeterminantIndexBound; SHA256 6c3d0930fe3041099d66f0af82d20cac4e4232af12c025172bffeceec79692dc -/
section RothComponent_RothDeterminantIndexBound
/- Real normalized determinant-index bounds and the finite triangular sum estimate. -/

namespace Bounty

noncomputable section
open scoped BigOperators

def rothWordWeight {m : ℕ} (r : Fin m → ℕ) (s : List (Fin m)) : ℝ :=
  (wordDerivativeWeight (rothWeight r) s : ℝ) / rothDenominator r

def rothWordWeight_eq_sum {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (s : List (Fin m)) : rothWordWeight r s = (s.map (fun i => (1 : ℝ) / r i)).sum := by
  induction s with
  | nil => simp [rothWordWeight, wordDerivativeWeight_nil]
  | cons i s ih =>
    simp only [rothWordWeight, wordDerivativeWeight_cons, Nat.cast_add, add_div,
      rothWeight_div_denominator hr, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih]

def rothWordWeight_replicate {m : ℕ} {r : Fin m → ℕ} (hr : ∀ i, 0 < r i)
    (i : Fin m) (n : ℕ) : rothWordWeight r (List.replicate n i) = n / (r i : ℝ) := by
  rw [rothWordWeight_eq_sum hr]
  simp [List.map_replicate, List.sum_replicate, nsmul_eq_mul, div_eq_mul_inv]

def enat_normalized_sub {a : ℕ∞} (_ha : a ≠ ⊤) (b : ℕ) {D : ℝ} (hD : 0 < D) :
    ((a - (b : ℕ∞)).toNat : ℝ) / D = max ((a.toNat : ℝ) / D - b / D) 0 := by
  rw [ENat.toNat_sub (by simp), ENat.toNat_natCast]
  by_cases hb : b ≤ a.toNat
  · rw [Nat.cast_sub hb, sub_div, max_eq_left]
    exact sub_nonneg.mpr (div_le_div_of_nonneg_right (by exact_mod_cast hb) hD.le)
  · have hab : a.toNat ≤ b := by omega
    rw [Nat.sub_eq_zero_of_le hab, Nat.cast_zero, zero_div, max_eq_right]
    exact sub_nonpos.mpr (div_le_div_of_nonneg_right (by exact_mod_cast hab) hD.le)

def rothPolynomialIndex_det_row_column_loss {m : ℕ} {J : Type*} [Fintype J] [DecidableEq J]
    {r : Fin m → ℕ} (hr : ∀ i, 0 < r i) (β : Fin m → ℚ)
    (rows cols : J → List (Fin m)) (P : MvPolynomial (Fin m) ℚ) (hP : P ≠ 0)
    (A : Matrix J J (MvPolynomial (Fin m) ℚ)) (hdet : A.det ≠ 0)
    (hloss : ∀ i j, weightedPolynomialIndex (rothWeight r) β P ≤
      weightedPolynomialIndex (rothWeight r) β (A i j) +
        (wordDerivativeWeight (rothWeight r) (rows i) : ℕ∞) +
        (wordDerivativeWeight (rothWeight r) (cols j) : ℕ∞)) :
    (∑ j : J, max (rothPolynomialIndex r β P - rothWordWeight r (cols j)) 0) ≤
      rothPolynomialIndex r β A.det + ∑ i : J, rothWordWeight r (rows i) := by
  let a := weightedPolynomialIndex (rothWeight r) β P
  let V := A.det
  have ha : a ≠ ⊤ := (weightedPolynomialIndex_finite _ _ hP).ne
  have hV : weightedPolynomialIndex (rothWeight r) β V ≠ ⊤ :=
    (weightedPolynomialIndex_finite _ _ hdet).ne
  have hb (j : J) : a - (wordDerivativeWeight (rothWeight r) (cols j) : ℕ∞) ≠ ⊤ :=
    ne_top_of_le_ne_top ha tsub_le_self
  have hh := weightedPolynomialIndex_det_row_column_loss (rothWeight r) β A
    a (wordDerivativeWeight (rothWeight r) ∘ rows)
      (wordDerivativeWeight (rothWeight r) ∘ cols) hloss
  have hright : weightedPolynomialIndex (rothWeight r) β V +
      (∑ i, wordDerivativeWeight (rothWeight r) (rows i) : ℕ) ≠ ⊤ := by
    exact (ENat.add_lt_top.mpr ⟨lt_top_iff_ne_top.mpr hV, by simp⟩).ne
  have hn := ENat.toNat_le_toNat hh hright
  simp only [Function.comp_def] at hn
  rw [ENat.toNat_sum (fun j _ => hb j), ENat.toNat_add hV (by simp), ENat.toNat_natCast] at hn
  have hreal :
      ((∑ j : J, (a - (wordDerivativeWeight (rothWeight r) (cols j) : ℕ∞)).toNat : ℕ) : ℝ) ≤
        ((weightedPolynomialIndex (rothWeight r) β V).toNat : ℝ) +
          (∑ i : J, wordDerivativeWeight (rothWeight r) (rows i) : ℕ) := by
    exact_mod_cast hn
  have hD : (0 : ℝ) < rothDenominator r := by exact_mod_cast rothDenominator_pos hr
  have hnorm := div_le_div_of_nonneg_right hreal hD.le
  simp only [Nat.cast_sum, Finset.sum_div, add_div,
    enat_normalized_sub ha _ hD] at hnorm
  exact hnorm

def rothPolynomialIndex_divided_mixed_det {m : ℕ} {J : Type*} [Fintype J] [DecidableEq J]
    {r : Fin m → ℕ} (hr : ∀ i, 0 < r i) (β : Fin m → ℚ)
    (rows cols : J → List (Fin m)) (P : MvPolynomial (Fin m) ℚ) (hP : P ≠ 0)
    (hdet : Matrix.det (fun i j : J => dividedWordPDeriv (cols j) (dividedWordPDeriv (rows i) P)) ≠ 0) :
    (∑ j : J, max (rothPolynomialIndex r β P - rothWordWeight r (cols j)) 0) ≤
      rothPolynomialIndex r β
        (Matrix.det (fun i j : J => dividedWordPDeriv (cols j) (dividedWordPDeriv (rows i) P))) +
          ∑ i : J, rothWordWeight r (rows i) := by
  apply rothPolynomialIndex_det_row_column_loss hr β rows cols P hP _ hdet
  intro i j
  have hrow : weightedPolynomialIndex (rothWeight r) β P ≤
      weightedPolynomialIndex (rothWeight r) β (dividedWordPDeriv (rows i) P) +
        (wordDerivativeWeight (rothWeight r) (rows i) : ℕ∞) := by
    simpa only [weightedPolynomialIndex_dividedWordPDeriv] using
      weightedPolynomialIndex_wordPDeriv (rothWeight r) β (rows i) P
  have hcol : weightedPolynomialIndex (rothWeight r) β (dividedWordPDeriv (rows i) P) ≤
      weightedPolynomialIndex (rothWeight r) β (dividedWordPDeriv (cols j) (dividedWordPDeriv (rows i) P)) +
        (wordDerivativeWeight (rothWeight r) (cols j) : ℕ∞) := by
    simpa only [weightedPolynomialIndex_dividedWordPDeriv] using
      weightedPolynomialIndex_wordPDeriv (rothWeight r) β (cols j) (dividedWordPDeriv (rows i) P)
  have hh := hrow.trans (add_le_add hcol le_rfl)
  simpa only [add_assoc, add_comm, add_left_comm] using hh

def rothPolynomialIndex_divided_mixed_det_progression {m k : ℕ}
    {r : Fin m → ℕ} (hr : ∀ i, 0 < r i) (β : Fin m → ℚ)
    (rows : Fin k → List (Fin m)) (last : Fin m) (P : MvPolynomial (Fin m) ℚ)
    (hP : P ≠ 0)
    (hdet : Matrix.det (fun i j : Fin k =>
      dividedWordPDeriv (List.replicate j.val last) (dividedWordPDeriv (rows i) P)) ≠ 0)
    (γ : ℝ) (hrows : ∀ i, rothWordWeight r (rows i) ≤ γ) :
    (∑ j : Fin k, max (rothPolynomialIndex r β P - j.val / (r last : ℝ)) 0) ≤
      rothPolynomialIndex r β (Matrix.det (fun i j : Fin k =>
        dividedWordPDeriv (List.replicate j.val last) (dividedWordPDeriv (rows i) P))) + k * γ := by
  have hh := rothPolynomialIndex_divided_mixed_det hr β rows
    (fun j : Fin k => List.replicate j.val last) P hP hdet
  simp only [rothWordWeight_replicate hr] at hh
  apply hh.trans
  apply add_le_add le_rfl
  simpa using Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hrows i)

def fin_sum_real_val (k : ℕ) : (∑ j : Fin k, (j.val : ℝ)) = (k : ℝ) * (k - 1) / 2 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.val_castSucc, Fin.val_last, ih, Nat.cast_add, Nat.cast_one]
    ring

/-- The sum of a decreasing nonnegative arithmetic progression dominates its
triangular area. This discrete induction avoids rounding or integration. -/
def arithmetic_max_sum_triangle (k : ℕ) (x : ℝ) (hx : 0 ≤ x) (hxk : x ≤ k) :
    x ^ 2 ≤ 2 * ∑ j : Fin k, max (x - j.val) 0 := by
  induction k generalizing x with
  | zero => simp only [Nat.cast_zero] at hxk; simp; nlinarith
  | succ k ih =>
    rw [Fin.sum_univ_succ]
    simp only [Fin.val_zero, Nat.cast_zero, sub_zero, max_eq_left hx,
      Fin.val_succ, Nat.cast_add, Nat.cast_one]
    have htail : (∑ j : Fin k, max (x - ((j.val : ℝ) + 1)) 0) =
        ∑ j : Fin k, max ((x - 1) - j.val) 0 := by
      apply Finset.sum_congr rfl
      intro j hj
      congr 1
      ring
    rw [htail]
    by_cases hsmall : x ≤ 1
    · have hs : 0 ≤ ∑ j : Fin k, max ((x - 1) - j.val) 0 :=
        Finset.sum_nonneg (fun _ _ => le_max_right _ _)
      nlinarith [mul_nonneg hx (sub_nonneg.mpr hsmall)]
    · have hx1 : 0 ≤ x - 1 := by linarith
      have hxk' : x - 1 ≤ (k : ℝ) := by
        simp only [Nat.cast_add, Nat.cast_one] at hxk
        linarith
      have hh := ih (x - 1) hx1 hxk'
      nlinarith

/-- Estimate (E), with the exact constant `2*m`. -/
def roth_arithmetic_progression_lower {m r k : ℕ} (hm : 2 ≤ m) (hr : 1 ≤ r)
    (_hk : 1 ≤ k) (hkr : k ≤ r + 1) {I : ℝ} (hI : 0 ≤ I) (hIm : I ≤ m) :
    ((k : ℝ) / (2 * m)) * I ^ 2 ≤ ∑ j : Fin k, max (I - j.val / (r : ℝ)) 0 := by
  have hrpos : (0 : ℝ) < r := by exact_mod_cast (by omega : 0 < r)
  have hmpos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  let S : ℝ := ∑ j : Fin k, max (I - j.val / (r : ℝ)) 0
  change ((k : ℝ) / (2 * m)) * I ^ 2 ≤ S
  rw [div_mul_eq_mul_div]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2 * m)).mpr
  by_cases hhigh : ((k : ℝ) - 1) / r ≤ I
  · have hraw : (k : ℝ) * I - ((k : ℝ) * (k - 1) / 2) / r ≤ S := by
      have hh := Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset (Fin k))) =>
        le_max_left (I - j.val / (r : ℝ)) 0)
      simpa only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul, ← Finset.sum_div, fin_sum_real_val] using hh
    have hcross : (k : ℝ) - 1 ≤ I * r := (div_le_iff₀ hrpos).mp hhigh
    have hhalf : ((k : ℝ) * (k - 1) / 2) / r ≤ (k : ℝ) * I / 2 := by
      apply (div_le_iff₀ hrpos).mpr
      nlinarith [mul_nonneg hk0 (sub_nonneg.mpr hcross)]
    have hlinear : (k : ℝ) * I ≤ 2 * S := by linarith
    have hquad : I ^ 2 ≤ (m : ℝ) * I := by
      nlinarith [mul_nonneg hI (sub_nonneg.mpr hIm)]
    have hh1 := mul_le_mul_of_nonneg_left hquad hk0
    have hh2 := mul_le_mul_of_nonneg_left hlinear hmpos.le
    nlinarith
  · have hx : (r : ℝ) * I ≤ (k : ℝ) := by
      have hh := (lt_div_iff₀ hrpos).mp (lt_of_not_ge hhigh)
      nlinarith
    have htriangle := arithmetic_max_sum_triangle k ((r : ℝ) * I) (mul_nonneg hrpos.le hI) hx
    have hscale : (∑ j : Fin k, max ((r : ℝ) * I - j.val) 0) = (r : ℝ) * S := by
      dsimp only [S]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      rw [mul_max_of_nonneg _ _ hrpos.le, mul_zero, mul_sub,
        mul_div_cancel₀ _ hrpos.ne']
    rw [hscale] at htriangle
    have htri : (r : ℝ) * I ^ 2 ≤ 2 * S := by
      nlinarith [sq_nonneg I]
    have hkmr : (k : ℝ) ≤ (m : ℝ) * r := by
      exact_mod_cast (by nlinarith : k ≤ m * r)
    have hh1 := mul_le_mul_of_nonneg_right hkmr (sq_nonneg I)
    have hh2 := mul_le_mul_of_nonneg_left htri hmpos.le
    nlinarith

/-- The complete lower bound (E) for the actual divided mixed determinant. -/
def roth_divided_determinant_quadratic_lower {m k : ℕ} (hm : 2 ≤ m)
    {r : Fin m → ℕ} (hr : ∀ i, 0 < r i) (β : Fin m → ℚ)
    (rows : Fin k → List (Fin m)) (last : Fin m) (P : MvPolynomial (Fin m) ℚ)
    (hP : P ≠ 0) (hdegree : ∀ i, P.degreeOf i ≤ r i)
    (hk : 1 ≤ k) (hkr : k ≤ r last + 1)
    (hdet : Matrix.det (fun i j : Fin k =>
      dividedWordPDeriv (List.replicate j.val last) (dividedWordPDeriv (rows i) P)) ≠ 0)
    (γ : ℝ) (hrows : ∀ i, rothWordWeight r (rows i) ≤ γ) :
    ((k : ℝ) / (2 * m)) * (rothPolynomialIndex r β P) ^ 2 ≤
      rothPolynomialIndex r β (Matrix.det (fun i j : Fin k =>
        dividedWordPDeriv (List.replicate j.val last) (dividedWordPDeriv (rows i) P))) + k * γ := by
  exact (roth_arithmetic_progression_lower hm (hr last) hk hkr
    (rothPolynomialIndex_nonneg r β P) (rothPolynomialIndex_le_dimension hr β hP hdegree)).trans
      (rothPolynomialIndex_divided_mixed_det_progression hr β rows last P hP hdet γ hrows)


end
end Bounty
end RothComponent_RothDeterminantIndexBound

/- Component: RothDeterminantHeightBound; SHA256 6785610d8460d9d15b0e55412a25afde9deb8d22603f26686339cc075b4e74d5 -/
section RothComponent_RothDeterminantHeightBound
/- Conservative explicit constants for the Roth auxiliary determinant. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def roth_log_factorial_bound (k q : ℕ) (hk : k ≤ q + 1) :
    Real.log (k.factorial : ℝ) ≤ (k : ℝ) * q := by
  by_cases hk0 : k = 0
  · subst k; simp
  have hkp : (0 : ℝ) < k := by exact_mod_cast Nat.pos_of_ne_zero hk0
  have hfp : (0 : ℝ) < k.factorial := by exact_mod_cast Nat.factorial_pos k
  have hf : (k.factorial : ℝ) ≤ (k : ℝ) ^ k := by exact_mod_cast Nat.factorial_le_pow k
  have hlog := Real.log_le_log hfp hf
  rw [Real.log_pow] at hlog
  have hkq : (k : ℝ) - 1 ≤ q := by
    have hh : (k : ℝ) ≤ (q : ℝ) + 1 := by exact_mod_cast hk
    linarith
  exact hlog.trans (mul_le_mul_of_nonneg_left
    ((Real.log_le_sub_one_of_pos hkp).trans hkq) hkp.le)

def roth_log_four_le_two : Real.log 4 ≤ 2 := by
  have h := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
  have heq : Real.log 4 = 2 * Real.log 2 := by
    simpa only [show (2 : ℝ) ^ 2 = 4 by norm_num, Nat.cast_ofNat] using
      (Real.log_pow (2 : ℝ) 2)
  rw [heq]
  linarith

def roth_determinant_log_bound {I : Type*} [Fintype I] [DecidableEq I]
    {k : ℕ} (rows cols : Fin k → List I) (r : I → ℕ)
    (P : MvPolynomial I ℚ) (hP : P ≠ 0) (hbox : PolynomialBoxBound r P)
    (r₀ q : ℕ) (hk : k ≤ q + 1)
    (hR : ((∑ i, r i : ℕ) : ℝ) ≤ (4 / 3 : ℝ) * r₀)
    (hq : (q : ℝ) ≤ (r₀ : ℝ) / 4)
    (hdet : Matrix.det (fun i j : Fin k => dividedWordPDeriv (rows i)
      (dividedWordPDeriv (cols j) P)) ≠ 0) :
    Real.log (polynomialCoeffL1 (Matrix.det (fun i j : Fin k => dividedWordPDeriv (rows i)
      (dividedWordPDeriv (cols j) P)))) ≤
        (k : ℝ) * (Real.log (polynomialCoeffL1 P) + 3 * r₀) := by
  have hL := polynomialCoeffL1_pos hP
  have hA := polynomialCoeffL1_det_log_le
    (fun i j : Fin k => dividedWordPDeriv (rows i) (dividedWordPDeriv (cols j) P)) hdet
    ((4 : ℝ) ^ (∑ i, r i) * polynomialCoeffL1 P)
    (mul_pos (by positivity) hL)
    (fun i j => polynomialCoeffL1_double_dividedWordPDeriv _ _ r P hbox)
  simp only [Fintype.card_fin] at hA
  rw [Real.log_mul (by positivity) hL.ne', Real.log_pow] at hA
  have hfact := roth_log_factorial_bound k q hk
  have hlog4 := roth_log_four_le_two
  have hR0 : (0 : ℝ) ≤ (∑ i, r i : ℕ) := Nat.cast_nonneg _
  have hsmall : (q : ℝ) + (∑ i, r i : ℕ) * Real.log 4 ≤ 3 * r₀ := by
    have ht := mul_le_mul_of_nonneg_left hlog4 hR0
    have hr₀ : (0 : ℝ) ≤ r₀ := Nat.cast_nonneg _
    nlinarith
  have hmul := mul_le_mul_of_nonneg_left hsmall (Nat.cast_nonneg k : (0 : ℝ) ≤ k)
  nlinarith


end
end Bounty
end RothComponent_RothDeterminantHeightBound

/- Component: RothSeparatedIndex; SHA256 00b3c3db66b11d3832f066427d3e07bdcbf86da81a5f0fde6a0fe883df952929 -/
section RothComponent_RothSeparatedIndex
/- Exact normalized index formulas for polynomials on separated variable sets. -/

namespace Bounty

noncomputable section
open scoped BigOperators
open Polynomial

def weightedTaylor_rename {m n : ℕ} (f : Fin m → Fin n) (β : Fin n → ℚ)
    (P : MvPolynomial (Fin m) ℚ) :
    weightedTaylor β (MvPolynomial.rename f P) =
      MvPolynomial.rename f (weightedTaylor (β ∘ f) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [weightedTaylor_C]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [map_mul, MvPolynomial.rename_X, weightedTaylor_X, map_add,
      MvPolynomial.rename_C, hP, Function.comp_apply]

def rothMonomialWeight_mapDomain {m n : ℕ} (f : Fin m → Fin n)
    (r : Fin n → ℕ) (d : Fin m →₀ ℕ) :
    rothMonomialWeight r (d.mapDomain f) = rothMonomialWeight (r ∘ f) d := by
  have hh := Finsupp.sum_mapDomain_index (f := f) (s := d)
    (h := fun i (v : ℕ) => (v : ℝ) / r i)
    (fun _ => by simp) (fun _ _ _ => by simp only [Nat.cast_add, add_div])
  rw [(d.mapDomain f).sum_fintype (fun i (v : ℕ) => (v : ℝ) / r i) (fun _ => by simp),
    d.sum_fintype (fun i (v : ℕ) => (v : ℝ) / r (f i)) (fun _ => by simp)] at hh
  exact hh

/-- Adding unused variables leaves the normalized index unchanged, with the
degree bounds and evaluation point restricted along the injection. -/
def rothPolynomialIndex_rename {m n : ℕ} {r : Fin n → ℕ} (hr : ∀ i, 0 < r i)
    (β : Fin n → ℚ) (f : Fin m → Fin n) (hf : Function.Injective f)
    (P : MvPolynomial (Fin m) ℚ) (hP : P ≠ 0) :
    rothPolynomialIndex r β (MvPolynomial.rename f P) =
      rothPolynomialIndex (r ∘ f) (β ∘ f) P := by
  classical
  have hr' (i : Fin m) : 0 < (r ∘ f) i := hr (f i)
  have hQ : MvPolynomial.rename f P ≠ 0 := by
    intro hh
    exact hP ((MvPolynomial.rename_eq_zero_iff_of_injective P hf).mp hh)
  have hsupport : (weightedTaylor β (MvPolynomial.rename f P)).support =
      Finset.image (Finsupp.mapDomain f) (weightedTaylor (β ∘ f) P).support := by
    rw [weightedTaylor_rename, MvPolynomial.support_rename_of_injective hf]
  apply le_antisymm
  · obtain ⟨d, hd, heq⟩ := rothPolynomialIndex_attained hr' (β ∘ f) hP
    have hmem : d.mapDomain f ∈ (weightedTaylor β (MvPolynomial.rename f P)).support := by
      rw [hsupport]
      exact Finset.mem_image.mpr ⟨d, hd, rfl⟩
    have hh := rothPolynomialIndex_le_support hr β (MvPolynomial.rename f P) hmem
    rw [rothMonomialWeight_mapDomain, ← heq] at hh
    exact hh
  · obtain ⟨e, he, heq⟩ := rothPolynomialIndex_attained hr β hQ
    rw [hsupport] at he
    obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp he
    rw [heq, rothMonomialWeight_mapDomain]
    exact rothPolynomialIndex_le_support hr' (β ∘ f) P hd

def rothPolynomialIndex_first_embedding {m : ℕ} {r : Fin (m + 1) → ℕ}
    (hr : ∀ i, 0 < r i) (β : Fin (m + 1) → ℚ)
    (P : MvPolynomial (Fin m) ℚ) (hP : P ≠ 0) :
    rothPolynomialIndex r β (MvPolynomial.rename Fin.castSucc P) =
      rothPolynomialIndex (r ∘ Fin.castSucc) (β ∘ Fin.castSucc) P :=
  rothPolynomialIndex_rename hr β Fin.castSucc (Fin.castSucc_injective m) P hP

def roth_last_embedding_eq_rename {m : ℕ} (F : ℚ[X]) :
    Polynomial.aeval (MvPolynomial.X (Fin.last m)) F =
      MvPolynomial.rename (fun _ : Fin 1 => Fin.last m)
        ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm F) := by
  rw [Polynomial.aeval_def, MvPolynomial.rename_eq_aeval, MvPolynomial.aeval_def]
  change F.eval₂ MvPolynomial.C (MvPolynomial.X (Fin.last m)) =
    ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm F).eval₂ MvPolynomial.C
      (fun _ => MvPolynomial.X (Fin.last m))
  exact MvPolynomial.eval₂_const_uniqueAlgEquiv_symm.symm

def roth_last_embedding_ne_zero {m : ℕ} {F : ℚ[X]} (hF : F ≠ 0) :
    Polynomial.aeval (MvPolynomial.X (R := ℚ) (Fin.last m)) F ≠ 0 := by
  change F.toMvPolynomial (Fin.last m) ≠ 0
  intro hh
  apply hF
  apply Polynomial.toMvPolynomial_injective (Fin.last m)
  exact hh.trans (map_zero _).symm

def rothPolynomialIndex_last_embedding {m : ℕ} {r : Fin (m + 1) → ℕ}
    (hr : ∀ i, 0 < r i) (β : Fin (m + 1) → ℚ) (F : ℚ[X]) (hF : F ≠ 0) :
    rothPolynomialIndex r β (Polynomial.aeval (MvPolynomial.X (Fin.last m)) F) =
      (F.rootMultiplicity (β (Fin.last m)) : ℝ) / r (Fin.last m) := by
  let f : Fin 1 → Fin (m + 1) := fun _ => Fin.last m
  have hf : Function.Injective f := fun _ _ _ => Subsingleton.elim _ _
  have hr' (i : Fin 1) : 0 < (r ∘ f) i := hr (f i)
  have hQ : (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm F ≠ 0 := by
    intro hh
    apply hF
    exact (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm.injective
      (hh.trans (map_zero _).symm)
  rw [roth_last_embedding_eq_rename]
  change rothPolynomialIndex r β (MvPolynomial.rename f
    ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm F)) = _
  rw [rothPolynomialIndex_rename hr β f hf _ hQ,
    rothPolynomialIndex_eq_rootMultiplicity hr' (β ∘ f) hQ, AlgEquiv.apply_symm_apply]
  rfl

/-- The exact separated-factor formula used in the induction on the number of variables. -/
def rothPolynomialIndex_separated_product {m : ℕ} {r : Fin (m + 1) → ℕ}
    (hr : ∀ i, 0 < r i) (β : Fin (m + 1) → ℚ)
    (F₂ : MvPolynomial (Fin m) ℚ) (hF₂ : F₂ ≠ 0) (F₁ : ℚ[X]) (hF₁ : F₁ ≠ 0) :
    rothPolynomialIndex r β (MvPolynomial.rename Fin.castSucc F₂ *
      Polynomial.aeval (MvPolynomial.X (Fin.last m)) F₁) =
        rothPolynomialIndex (r ∘ Fin.castSucc) (β ∘ Fin.castSucc) F₂ +
          (F₁.rootMultiplicity (β (Fin.last m)) : ℝ) / r (Fin.last m) := by
  have hleft : MvPolynomial.rename Fin.castSucc F₂ ≠ 0 := by
    intro hh
    exact hF₂ ((MvPolynomial.rename_eq_zero_iff_of_injective F₂ (Fin.castSucc_injective m)).mp hh)
  rw [rothPolynomialIndex_mul r β hleft (roth_last_embedding_ne_zero hF₁),
    rothPolynomialIndex_first_embedding hr β F₂ hF₂,
    rothPolynomialIndex_last_embedding hr β F₁ hF₁]

end
end Bounty
end RothComponent_RothSeparatedIndex

/- Component: IntegerPolynomialReification; SHA256 33472f3697cbca9b3a29d38c7a4772168ea8a575d55a97aadae0e1e2a8b17e20 -/
section RothComponent_IntegerPolynomialReification
/- Reification of integral rational coefficients via polynomial map-range criteria,
including divided derivative matrices and their ordinary determinants. -/

namespace Bounty
noncomputable section
open scoped BigOperators Polynomial

variable {I J : Type*}

def HasIntegerMvCoefficients (P : MvPolynomial I ℚ) : Prop :=
  ∀ d, ∃ z : ℤ, MvPolynomial.coeff d P = (z : ℚ)

def HasIntegerIteratedCoefficients (V : Polynomial (MvPolynomial I ℚ)) : Prop :=
  ∀ n, HasIntegerMvCoefficients (V.coeff n)

def hasIntegerMvCoefficients_map (P : MvPolynomial I ℤ) :
    HasIntegerMvCoefficients (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  intro d
  exact ⟨MvPolynomial.coeff d P, by simp [MvPolynomial.coeff_map]⟩

/-- The existing coefficient-range criterion constructs an actual integer polynomial. -/
def exists_integer_mvPolynomial (P : MvPolynomial I ℚ) (hP : HasIntegerMvCoefficients P) :
    ∃ Q : MvPolynomial I ℤ, MvPolynomial.map (Int.castRingHom ℚ) Q = P := by
  apply MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
  intro a ha
  obtain ⟨d, _, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp ha
  obtain ⟨z, hz⟩ := hP d
  exact ⟨z, hz.symm⟩

def hasIntegerMvCoefficients_iff_exists (P : MvPolynomial I ℚ) :
    HasIntegerMvCoefficients P ↔
      ∃ Q : MvPolynomial I ℤ, MvPolynomial.map (Int.castRingHom ℚ) Q = P := by
  constructor
  · exact exists_integer_mvPolynomial P
  · rintro ⟨Q, rfl⟩
    exact hasIntegerMvCoefficients_map Q

def exists_integer_iteratedPolynomial (V : Polynomial (MvPolynomial I ℚ))
    (hV : HasIntegerIteratedCoefficients V) :
    ∃ W : Polynomial (MvPolynomial I ℤ),
      W.map (MvPolynomial.map (Int.castRingHom ℚ)) = V := by
  apply (Polynomial.mem_lifts V).mp
  apply (Polynomial.lifts_iff_coeff_lifts V).mpr
  intro n
  exact exists_integer_mvPolynomial (V.coeff n) (hV n)

def hasIntegerMvCoefficients_dividedWordPDeriv [Fintype I] [DecidableEq I]
    (s : List I) (P : MvPolynomial I ℚ) (hP : HasIntegerMvCoefficients P) :
    HasIntegerMvCoefficients (dividedWordPDeriv s P) :=
  dividedWordPDeriv_integral s P hP

def exists_integer_dividedWordPDeriv [Fintype I] [DecidableEq I]
    (s : List I) (P : MvPolynomial I ℤ) :
    ∃ Q : MvPolynomial I ℤ, MvPolynomial.map (Int.castRingHom ℚ) Q =
      dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P) :=
  exists_integer_mvPolynomial _ (hasIntegerMvCoefficients_dividedWordPDeriv s _
    (hasIntegerMvCoefficients_map P))

/-- Reify the entries, then use the actual ring-homomorphism determinant identity. -/
def exists_integer_determinant [Fintype J] [DecidableEq J]
    (A : Matrix J J (MvPolynomial I ℚ))
    (hA : ∀ i j, HasIntegerMvCoefficients (A i j)) :
    ∃ Q : MvPolynomial I ℤ, MvPolynomial.map (Int.castRingHom ℚ) Q = A.det := by
  classical
  choose B hB using fun i j => exists_integer_mvPolynomial (A i j) (hA i j)
  refine ⟨Matrix.det (Matrix.of B), ?_⟩
  rw [RingHom.map_det]
  apply congrArg Matrix.det
  funext i j
  exact hB i j

def hasIntegerMvCoefficients_det [Fintype J] [DecidableEq J]
    (A : Matrix J J (MvPolynomial I ℚ))
    (hA : ∀ i j, HasIntegerMvCoefficients (A i j)) :
    HasIntegerMvCoefficients A.det :=
  (hasIntegerMvCoefficients_iff_exists A.det).mpr (exists_integer_determinant A hA)

def hasIntegerMvCoefficients_rename {K : Type*} (f : I → K)
    (P : MvPolynomial I ℚ) (hP : HasIntegerMvCoefficients P) :
    HasIntegerMvCoefficients (MvPolynomial.rename f P) := by
  obtain ⟨Q, rfl⟩ := exists_integer_mvPolynomial P hP
  rw [← MvPolynomial.map_rename]
  exact hasIntegerMvCoefficients_map (MvPolynomial.rename f Q)

def hasIntegerIteratedCoefficients_finSuccEquiv {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (hP : HasIntegerMvCoefficients P) :
    HasIntegerIteratedCoefficients (MvPolynomial.finSuccEquiv ℚ m P) := by
  intro n d
  rw [MvPolynomial.finSuccEquiv_coeff_coeff]
  exact hP _

/-- This expression is definitionally the `lastVariableEquiv` used in the Roth
factorization module; the bridge does not depend on that larger proof module. -/
def exists_integer_lastVariablePolynomial {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) ℚ) (hP : HasIntegerMvCoefficients P) :
    ∃ V : Polynomial (MvPolynomial (Fin m) ℤ),
      V.map (MvPolynomial.map (Int.castRingHom ℚ)) =
        MvPolynomial.finSuccEquiv ℚ m (MvPolynomial.rename (finRotate (m + 1)) P) := by
  apply exists_integer_iteratedPolynomial
  exact hasIntegerIteratedCoefficients_finSuccEquiv _
    (hasIntegerMvCoefficients_rename (finRotate (m + 1)) P hP)


end
end Bounty
end RothComponent_IntegerPolynomialReification

/- Component: RothDegreeBounds; SHA256 fe90c59dad2ce4930b12b6d5010fc538c0c25fafee4d8b5732393941fe7f6a8a -/
section RothComponent_RothDegreeBounds
/- Elementary consequences of the descending degree ratios in Roth's induction. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def roth_degree_decay_antitone {m : ℕ} (r : Fin (m + 1) → ℕ) (θ : ℝ)
    (hθ : θ ≤ 1) (hstep : ∀ i : Fin m, (r i.succ : ℝ) ≤ θ * r i.castSucc) :
    Antitone r := by
  apply Fin.antitone_iff_succ_le.mpr
  intro i
  have hh : (r i.succ : ℝ) ≤ r i.castSucc :=
    (hstep i).trans (by nlinarith [Nat.cast_nonneg (r i.castSucc) (α := ℝ)])
  exact_mod_cast hh

def roth_degree_decay_sum {m : ℕ} (r : Fin (m + 1) → ℕ) (θ : ℝ)
    (hθ : θ ≤ (1 / 4 : ℝ))
    (hstep : ∀ i : Fin m, (r i.succ : ℝ) ≤ θ * r i.castSucc) :
    ((∑ i, r i : ℕ) : ℝ) ≤ (4 / 3 : ℝ) * r 0 := by
  have ht : (∑ i : Fin m, (r i.succ : ℝ)) ≤
      (1 / 4 : ℝ) * (∑ i : Fin m, (r i.castSucc : ℝ)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro i _
    exact (hstep i).trans (mul_le_mul_of_nonneg_right hθ (Nat.cast_nonneg _))
  have hhead : (∑ i : Fin m, (r i.castSucc : ℝ)) ≤ ∑ i : Fin (m + 1), (r i : ℝ) := by
    rw [Fin.sum_univ_castSucc]
    exact le_add_of_nonneg_right (Nat.cast_nonneg _)
  have hs := Fin.sum_univ_succ (fun i : Fin (m + 1) => (r i : ℝ))
  push_cast
  nlinarith

def roth_degree_decay_last {m : ℕ} (r : Fin (m + 2) → ℕ) (θ : ℝ)
    (hθ : θ ≤ (1 / 4 : ℝ))
    (hstep : ∀ i : Fin (m + 1), (r i.succ : ℝ) ≤ θ * r i.castSucc) :
    (r (Fin.last (m + 1)) : ℝ) ≤ (r 0 : ℝ) / 4 := by
  have hmono := roth_degree_decay_antitone r θ (by linarith) hstep
  have h0 : r (Fin.last (m + 1)) ≤ r (Fin.succ (0 : Fin (m + 1))) :=
    hmono (Fin.le_last _)
  have hh := hstep 0
  have hr0 : (0 : ℝ) ≤ r 0 := Nat.cast_nonneg _
  have h0r : (r (Fin.last (m + 1)) : ℝ) ≤ r (Fin.succ (0 : Fin (m + 1))) := by
    exact_mod_cast h0
  have hc : (0 : Fin (m + 1)).castSucc = (0 : Fin (m + 2)) := rfl
  rw [hc] at hh
  nlinarith

def roth_first_word_weight_bound {m : ℕ} {r : Fin (m + 2) → ℕ}
    (hr : ∀ i, 0 < r i) (hmono : Antitone r) (s : List (Fin (m + 1)))
    (hlen : s.length ≤ r (Fin.last (m + 1))) :
    rothWordWeight r (s.map Fin.castSucc) ≤
      (r (Fin.last (m + 1)) : ℝ) / r (Fin.castSucc (Fin.last m)) := by
  have hden : (0 : ℝ) < r (Fin.castSucc (Fin.last m)) := by exact_mod_cast hr _
  have hterm (i : Fin (m + 1)) : (1 : ℝ) / r i.castSucc ≤
      1 / (r (Fin.castSucc (Fin.last m)) : ℝ) := by
    apply one_div_le_one_div_of_le hden
    have hi : i.castSucc ≤ (Fin.last m).castSucc := by
      change i.val ≤ m
      omega
    exact_mod_cast hmono hi
  have hsum : (s.map (fun i => (1 : ℝ) / r i.castSucc)).sum ≤
      (s.length : ℝ) / r (Fin.castSucc (Fin.last m)) := by
    clear hlen
    induction s with
    | nil => simp
    | cons i s ih =>
      simp only [List.map_cons, List.sum_cons, List.length_cons, Nat.cast_add, Nat.cast_one, add_div]
      have hh := hterm i
      linarith
  rw [rothWordWeight_eq_sum hr, List.map_map]
  exact hsum.trans (div_le_div_of_nonneg_right (by exact_mod_cast hlen) hden.le)


end
end Bounty
end RothComponent_RothDegreeBounds

/- Component: RothUnivariateHeight; SHA256 ee5ae1c3484f1c20eed69765f491ec5cc08358a397a09fb352173fee0bb9930c -/
section RothComponent_RothUnivariateHeight
/- Standard rational height and raw integer coefficient norms for the Roth base case. -/

namespace Bounty
noncomputable section
open Polynomial
open scoped BigOperators

def rationalRoot_logHeight (β : ℚ) :
    Real.log (max ‖(β.den : ℂ)‖ ‖(β.num : ℂ)‖) = Height.logHeight₁ β := by
  rw [Rat.logHeight₁_eq_log_max]
  congr 1
  have ha : ((β.num.natAbs : ℕ) : ℝ) = |(β.num : ℝ)| := by
    calc
      (β.num.natAbs : ℝ) = ((β.num.natAbs : ℤ) : ℝ) := (Int.cast_natCast _).symm
      _ = ((|β.num| : ℤ) : ℝ) := congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs β.num)
      _ = |(β.num : ℝ)| := Int.cast_abs
  simp only [Complex.norm_natCast, Complex.norm_intCast, Nat.cast_max, ha]
  exact max_comm _ _

def integerPolynomialCoeffSum_eq_univariateCoeffL1 (P : ℤ[X]) :
    integerPolynomialCoeffSum P = univariateCoeffL1 P := by
  change univariateCoeffL1 (P.map (Int.castRingHom ℂ)) = _
  apply univariateCoeffL1_map (Int.castRingHom ℂ) Int.cast_injective
  intro a
  change ‖(a : ℂ)‖ = ‖a‖
  simp only [Complex.norm_intCast, Int.norm_eq_abs]

def univariateCoeffL1_uniqueAlgEquiv {R : Type*} [NormedCommRing R]
    (P : MvPolynomial (Fin 1) R) :
    univariateCoeffL1 (MvPolynomial.uniqueAlgEquiv R (Fin 1) P) = polynomialCoeffL1 P := by
  classical
  have hdEq (d : Fin 1 →₀ ℕ) : Finsupp.single (0 : Fin 1) (d 0) = d := by
    simpa using (Finsupp.unique_single d).symm
  have hs : (MvPolynomial.uniqueAlgEquiv R (Fin 1) P).support =
      P.support.image (fun d : Fin 1 →₀ ℕ => d 0) := by
    ext n
    simp only [Polynomial.mem_support_iff, Finset.mem_image, MvPolynomial.mem_support_iff,
      MvPolynomial.coeff_uniqueAlgEquiv]
    constructor
    · intro h
      exact ⟨Finsupp.single 0 n, h, by simp⟩
    · rintro ⟨d, hd, rfl⟩
      change MvPolynomial.coeff (Finsupp.single (0 : Fin 1) (d 0)) P ≠ 0
      rwa [hdEq d]
  have hinj : Function.Injective (fun d : Fin 1 →₀ ℕ => d 0) := by
    intro a b hab
    rw [← hdEq a, ← hdEq b]
    exact congrArg (Finsupp.single (0 : Fin 1)) hab
  rw [univariateCoeffL1, hs, Finset.sum_image hinj.injOn]
  apply Finset.sum_congr rfl
  intro d hd
  rw [MvPolynomial.coeff_uniqueAlgEquiv]
  change ‖MvPolynomial.coeff (Finsupp.single (0 : Fin 1) (d 0)) P‖ = _
  rw [hdEq d]

def rational_rootMultiplicity_standard_height_bound {P : ℤ[X]}
    (hP : P ≠ 0) (β : ℚ) :
    ((P.map (Int.castRingHom ℚ)).rootMultiplicity β : ℝ) * Height.logHeight₁ β ≤
      Real.log (univariateCoeffL1 P) := by
  simpa only [rationalRoot_logHeight, integerPolynomialCoeffSum_eq_univariateCoeffL1] using
    rational_rootMultiplicity_height_bound hP β

def rothUnivariate_standard_height_bound (r : Fin 1 → ℕ) (hr : ∀ i, 0 < r i)
    (β : Fin 1 → ℚ) {P : ℤ[X]} (hP : P ≠ 0) :
    rothPolynomialIndex r β ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm
      (P.map (Int.castRingHom ℚ))) * ((r 0 : ℝ) * Height.logHeight₁ (β 0)) ≤
      Real.log (univariateCoeffL1 P) := by
  simpa only [rationalRoot_logHeight, integerPolynomialCoeffSum_eq_univariateCoeffL1] using
    rothUnivariate_integer_height_bound r hr β hP

def uniqueAlgEquiv_map_int_rat (P : MvPolynomial (Fin 1) ℤ) :
    (MvPolynomial.uniqueAlgEquiv ℤ (Fin 1) P).map (Int.castRingHom ℚ) =
      MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  ext n
  simp only [Polynomial.coeff_map, MvPolynomial.coeff_uniqueAlgEquiv, MvPolynomial.coeff_map]

def rothUnivariate_mv_integer_height_bound (r : Fin 1 → ℕ) (hr : ∀ i, 0 < r i)
    (β : Fin 1 → ℚ) {P : MvPolynomial (Fin 1) ℤ} (hP : P ≠ 0) :
    rothPolynomialIndex r β (MvPolynomial.map (Int.castRingHom ℚ) P) *
      ((r 0 : ℝ) * Height.logHeight₁ (β 0)) ≤ Real.log (polynomialCoeffL1 P) := by
  let U := MvPolynomial.uniqueAlgEquiv ℤ (Fin 1) P
  have hU : U ≠ 0 := by
    intro hz
    apply hP
    exact (MvPolynomial.uniqueAlgEquiv ℤ (Fin 1)).injective
      (hz.trans (map_zero _).symm)
  have hh := rothUnivariate_standard_height_bound r hr β hU
  have he : (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).symm (U.map (Int.castRingHom ℚ)) =
      MvPolynomial.map (Int.castRingHom ℚ) P := by
    apply (MvPolynomial.uniqueAlgEquiv ℚ (Fin 1)).injective
    rw [AlgEquiv.apply_symm_apply]
    exact uniqueAlgEquiv_map_int_rat P
  rw [he] at hh
  simpa only [U, univariateCoeffL1_uniqueAlgEquiv] using hh


end
end Bounty
end RothComponent_RothUnivariateHeight

/- Component: LastVariableCoefficientNorm; SHA256 650c5c9fbf2a06be3a1dd0191ee8740cad52c2204cd5b33968a9ad23777325f0 -/
section RothComponent_LastVariableCoefficientNorm
/- Reindexing the coefficient sum by a variable injection or by separating
one variable preserves the exact coefficient-sum norm. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I J R : Type*} [NormedCommRing R]

def polynomialCoeffL1_rename_of_injective (f : I → J)
    (hf : Function.Injective f) (P : MvPolynomial I R) :
    polynomialCoeffL1 (MvPolynomial.rename f P) = polynomialCoeffL1 P := by
  classical
  unfold polynomialCoeffL1
  rw [MvPolynomial.support_rename_of_injective hf,
    Finset.sum_image (Finsupp.mapDomain_injective hf).injOn]
  simp only [MvPolynomial.coeff_rename_mapDomain f hf]

def polynomialCoeffL1_finSuccEquiv_coeff {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) R) (n : ℕ) :
    polynomialCoeffL1 ((MvPolynomial.finSuccEquiv R m P).coeff n) =
      ∑ d ∈ P.support with d 0 = n, ‖MvPolynomial.coeff d P‖ := by
  classical
  rw [← MvPolynomial.image_support_finSuccEquiv,
    Finset.sum_image (Finsupp.cons_right_injective n).injOn]
  simp only [polynomialCoeffL1, MvPolynomial.finSuccEquiv_coeff_coeff]

def iteratedCoeffL1_finSuccEquiv {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) R) :
    iteratedCoeffL1 (MvPolynomial.finSuccEquiv R m P) = polynomialCoeffL1 P := by
  classical
  unfold iteratedCoeffL1
  simp_rw [polynomialCoeffL1_finSuccEquiv_coeff]
  rw [MvPolynomial.support_finSuccEquiv]
  exact Finset.sum_fiberwise_of_maps_to
    (fun d hd => Finset.mem_image_of_mem (fun e : Fin (m + 1) →₀ ℕ => e 0) hd)
    (fun d => ‖MvPolynomial.coeff d P‖)

def iteratedCoeffL1_lastVariable {m : ℕ}
    (P : MvPolynomial (Fin (m + 1)) R) :
    iteratedCoeffL1 (MvPolynomial.finSuccEquiv R m
      (MvPolynomial.rename (finRotate (m + 1)) P)) = polynomialCoeffL1 P := by
  rw [iteratedCoeffL1_finSuccEquiv,
    polynomialCoeffL1_rename_of_injective _ (finRotate (m + 1)).injective]

end
end Bounty
end RothComponent_LastVariableCoefficientNorm

/- Component: IntegerRothTheorem; SHA256 59757cc1d82c5d7a0860cc5bef1c0893107ce3982b6bee164e7823038ff2068e -/
section RothComponent_IntegerRothTheorem
/- The integer coefficient-sum version of Roth's polynomial index lemma.
The theorem is proved by induction on the number of variables, using actual
nonzero divided derivative determinants and actual integer separated factors. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Polynomial

def integerMap_degreeOf {I : Type*} (P : MvPolynomial I ℤ) (i : I) :
    (MvPolynomial.map (Int.castRingHom ℚ) P).degreeOf i = P.degreeOf i := by
  classical
  simp only [MvPolynomial.degreeOf_def,
    MvPolynomial.degrees_map_of_injective P (f := Int.castRingHom ℚ) (Int.cast_injective :
      Function.Injective (Int.castRingHom ℚ))]

def integerMap_ne_zero {I : Type*} {P : MvPolynomial I ℤ} (hP : P ≠ 0) :
    MvPolynomial.map (Int.castRingHom ℚ) P ≠ 0 := by
  intro hh
  apply hP
  exact (MvPolynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective)
    (hh.trans (map_zero _).symm)

def roth_theta_square (n : ℕ) (η : ℝ) : (η ^ 2) ^ (2 ^ n) = η ^ (2 ^ (n + 1)) := by
  rw [← pow_mul, pow_succ]
  congr 1
  ring

def roth_theta_step_bounds (n : ℕ) {η : ℝ} (hη : 0 < η) (hηhalf : η ≤ 1 / 2) :
    0 < η ^ (2 ^ (n + 1)) ∧ η ^ (2 ^ (n + 1)) ≤ η ^ 2 ∧
      η ^ (2 ^ (n + 1)) ≤ (1 / 4 : ℝ) := by
  have hηone : η ≤ 1 := by linarith
  have hpow : 2 ≤ 2 ^ (n + 1) := by
    rw [pow_succ]
    have := Nat.one_le_pow n 2 (by omega)
    omega
  have hh := pow_le_pow_of_le_one hη.le hηone hpow
  exact ⟨pow_pos hη _, hh, hh.trans (by
    nlinarith [mul_nonneg hη.le (sub_nonneg.mpr hηhalf)])⟩

/-- There are `n+1` variables, so this covers every positive dimension without
casts in the adjacent-degree condition. All height assumptions are pointwise. -/
def integer_roth_index_bound (n : ℕ) :
    ∀ (P : MvPolynomial (Fin (n + 1)) ℤ), P ≠ 0 →
    ∀ (r : Fin (n + 1) → ℕ), (∀ i, 0 < r i) → (∀ i, P.degreeOf i ≤ r i) →
    ∀ (β : Fin (n + 1) → ℚ) (η : ℝ), 0 < η → η ≤ 1 / 2 →
    (∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc) →
    (∀ i, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r i : ℝ) * Height.logHeight₁ (β i))) →
    rothPolynomialIndex r β (MvPolynomial.map (Int.castRingHom ℚ) P) ≤ 2 * (n + 1 : ℕ) * η := by
  induction n with
  | zero =>
    intro P hP r hr hdegree β η hη hηhalf hstep hheight
    have hroot := rothUnivariate_mv_integer_height_bound r hr β hP
    have hh := hheight 0
    simp only [Nat.zero_add, pow_zero, pow_one, Nat.cast_one] at hh ⊢
    have hL : 0 ≤ Real.log (polynomialCoeffL1 P) := Real.log_nonneg (one_le_polynomialCoeffL1_int hP)
    have hr0 : (0 : ℝ) < r 0 := by exact_mod_cast hr 0
    have hH : 0 < (r 0 : ℝ) * Height.logHeight₁ (β 0) := by
      by_contra hn
      have hneg := mul_nonpos_of_nonneg_of_nonpos hη.le (le_of_not_gt hn)
      nlinarith
    have hi : rothPolynomialIndex r β (MvPolynomial.map (Int.castRingHom ℚ) P) ≤ η := by
      apply (mul_le_mul_iff_left₀ hH).mp
      nlinarith
    linarith
  | succ n ih =>
    intro P hP r hr hdegree β η hη hηhalf hstep hheight
    let Q : MvPolynomial (Fin (n + 2)) ℚ := MvPolynomial.map (Int.castRingHom ℚ) P
    let θ : ℝ := η ^ (2 ^ (n + 1))
    have hQ : Q ≠ 0 := integerMap_ne_zero hP
    have hQdegree (i) : Q.degreeOf i ≤ r i := by
      simpa only [Q, integerMap_degreeOf] using hdegree i
    have hbox : PolynomialBoxBound r Q := fun d hd i =>
      (MvPolynomial.monomial_le_degreeOf i hd).trans (hQdegree i)
    obtain ⟨hθpos, hθη, hθquarter⟩ := roth_theta_step_bounds n hη hηhalf
    change 0 < θ at hθpos
    change θ ≤ η ^ 2 at hθη
    change θ ≤ (1 / 4 : ℝ) at hθquarter
    have hmono : Antitone r := roth_degree_decay_antitone r θ (by linarith) hstep
    have hR := roth_degree_decay_sum r θ hθquarter hstep
    have hlast := roth_degree_decay_last r θ hθquarter hstep
    obtain ⟨k, hkpos, hkactual, hk, w, hw, U₂, U₁, hU₂, hU₁, hU₂deg, hU₁deg,
      hfactor, hactual, hV⟩ := exists_rothDivided_factorization Q hQ r hQdegree
    let rows (i : Fin k) := (w i).map Fin.castSucc
    let cols (j : Fin k) := List.replicate j.val (Fin.last (n + 1))
    let A : Matrix (Fin k) (Fin k) (MvPolynomial (Fin (n + 2)) ℚ) :=
      fun i j => dividedWordPDeriv (cols j) (dividedWordPDeriv (rows i) Q)
    let V := A.det
    change V ≠ 0 at hV
    have hVk : Real.log (polynomialCoeffL1 V) ≤
        (k : ℝ) * (Real.log (polynomialCoeffL1 P) + 3 * (r 0 : ℝ)) := by
      have htranspose : Matrix.det (fun i j : Fin k =>
          dividedWordPDeriv (cols i) (dividedWordPDeriv (rows j) Q)) ≠ 0 := by
        change A.transpose.det ≠ 0
        rw [Matrix.det_transpose]
        exact hV
      have hh := roth_determinant_log_bound cols rows r Q hQ hbox (r 0)
        (r (Fin.last (n + 1))) hk hR hlast htranspose
      change Real.log (polynomialCoeffL1 A.transpose.det) ≤ _ at hh
      rw [Matrix.det_transpose] at hh
      simpa only [V, Q, polynomialCoeffL1_map_int_rat] using hh
