/- Component PackedNatTable; SHA256 4dbc0fd1f62f91219e64063380c873d611f8bd540bba3156d774d7ec2687dc0a. -/
section PolicySubmissionPart19
/- Random access to finite packed numerical records using balanced tables. -/
namespace PackedNatTable

inductive Table (α : Type) where
  | leaf : Array α → Table α
  | branch : Nat → Table α → Table α → Table α

def Table.get (fallback : α) : Table α → Nat → α
  | .leaf xs, i => xs[i]?.getD fallback
  | .branch cutoff left right, i =>
      if i < cutoff then left.get fallback i else right.get fallback (i - cutoff)

structure Block where
  offsets : Nat
  data : Nat

def emptyBlock : Block := ⟨0, 0⟩

def Block.start (b : Block) (i : Nat) : Nat :=
  (b.offsets >>> (13 * i)) &&& 0x1fff

def Block.get (b : Block) (i : Nat) : List Nat :=
  let first := b.start i
  let count := b.start (i + 1) - first
  let packed := (b.data >>> (6 * first)) &&& ((1 <<< (6 * count)) - 1)
  CompactNatData.decode count packed

def records (t : Table Block) (i : Nat) : List Nat :=
  (t.get emptyBlock (i / 32)).get (i % 32)

end PackedNatTable

end PolicySubmissionPart19

/- Component PackedTableAll; SHA256 9c01cd09571cad070d9e1d6443d53b7794fed50f43d7a2fa1b7fd48859621c7c. -/
section PolicySubmissionPart20
namespace PackedNatTable

def Table.All (P : α → Prop) : Table α → Prop
  | .leaf xs => ∀ a ∈ xs, P a
  | .branch _ left right => left.All P ∧ right.All P

def Table.get_all (P : α → Prop) (fallback : α) (hf : P fallback)
    (t : Table α) (ht : t.All P) (i : Nat) : P (t.get fallback i) := by
  induction t generalizing i with
  | leaf xs =>
    cases he : xs[i]? with
    | none => simpa only [Table.get, he, Option.getD_none] using hf
    | some a =>
      simpa only [Table.get, he, Option.getD_some] using ht a (Array.mem_of_getElem? he)
  | branch cutoff left right ihl ihr =>
    obtain ⟨hl, hr⟩ := ht
    by_cases hi : i < cutoff
    · simpa only [Table.get, hi, ↓reduceIte] using ihl hl i
    · simpa only [Table.get, hi, ↓reduceIte] using ihr hr (i - cutoff)

end PackedNatTable

end PolicySubmissionPart20

