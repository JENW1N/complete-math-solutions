/- Component PolicyRUPBoundary; SHA256 0624fd4b0479c269aaa70229e81f9bb0f7f0a2ce369788d9f2c967cf5b21a234. -/
section PolicySubmissionPart36
/- Signed boundary clauses of a sparse RUP block and explicit variable renaming. -/

namespace Bounty
open Std.Sat Std.Tactic.BVDecide.LRAT Std.Tactic.BVDecide.LRAT.Internal

def policyRenameLiteral (σ : Nat → Nat) (z : Int) : Int :=
  if 0 < z then (σ z.natAbs : Int) else -(σ z.natAbs : Int)

def policySignedHolds_rename (P : Nat → Prop) (σ : Nat → Nat)
    (hσ : ∀ i, 0 < σ i) (z : Int) :
    policySignedHolds P (policyRenameLiteral σ z) ↔
      policySignedHolds (fun i => P (σ i)) z := by
  have hpos : (0 : Int) < (σ z.natAbs : Int) := by exact_mod_cast hσ z.natAbs
  have hn : σ z.natAbs ≠ 0 := Nat.ne_of_gt (hσ z.natAbs)
  by_cases hz : 0 < z
  · simp [policyRenameLiteral, policySignedHolds, hz, hn]
  · simp [policyRenameLiteral, policySignedHolds, hz, hn, not_lt_of_ge (le_of_lt hpos)]

def policySignedClauseHolds_rename (P : Nat → Prop) (σ : Nat → Nat)
    (hσ : ∀ i, 0 < σ i) (cs : List Int) :
    policySignedClauseHolds P (cs.map (policyRenameLiteral σ)) ↔
      policySignedClauseHolds (fun i => P (σ i)) cs := by
  simp only [policySignedClauseHolds, List.mem_map, exists_exists_and_eq_and,
    policySignedHolds_rename P σ hσ]

end Bounty

end PolicySubmissionPart36

/- Component PolicyClauseReindex; SHA256 118589b8c2cd35ae9e899e411a3804d2ba500459d2266275a5473af6154944b5. -/
section PolicySubmissionPart37
/- One shared positive variable renaming for an entire Boolean refutation. -/

namespace Bounty

def policyClauseRename_model (small dense : Nat → List Int) (σ : Nat → Nat)
    (P : Nat → Prop)
    (hσ : ∀ i, 0 < σ i) (i : Nat)
    (hm : (small i).map (policyRenameLiteral σ) = dense i)
    (hi : policySignedClauseHolds P (dense i)) :
    policySignedClauseHolds (fun j => P (σ j)) (small i) := by
  apply (policySignedClauseHolds_rename P σ hσ (small i)).mp
  rwa [hm]

end Bounty

end PolicySubmissionPart37

