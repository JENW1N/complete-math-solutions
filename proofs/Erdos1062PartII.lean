def checkAnchor (program : Nat → Node) (indices : Nat → Nat)
    (patterns : Nat → Pattern) (N fuel i : Nat) : Bool :=
  if indices i = 0 then true else
    decide (indices i - 1 < N) &&
      checkBody program indices fuel (patterns (indices i - 1)) i

def anchor_good (raw : Nat → Node) (input env : SValuation)
    (anchor : Nat → Option SValue) (indices : Nat → Nat)
    (hanchor : ∀ i, anchor i =
      if indices i = 0 then none else some (env (indices i - 1)))
    (patterns : Nat → Pattern) (N fuel i : Nat)
    (hsemantic : ∀ j < N, env j = eval input env (fuel + 1) (patterns j))
    (hc : checkAnchor (boundedProgram raw) indices patterns N fuel i = true) :
    ∀ a, anchor i = some a → a = anchorBody raw input anchor i := by
  intro a ha
  by_cases hz : indices i = 0
  · have hn : anchor i = none := by
      rw [hanchor, hz] <;> rfl
    rw [hn] at ha
    cases ha
  · have hh : indices i - 1 < N ∧
        checkBody (boundedProgram raw) indices fuel (patterns (indices i - 1)) i = true := by
      simpa only [checkAnchor, if_neg hz, Bool.and_eq_true, decide_eq_true_eq] using hc
