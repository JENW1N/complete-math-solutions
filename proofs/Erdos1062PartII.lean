  cases eps with
  | false => exact closureRaw_false_0 X Y p r
  | true => exact closureRaw_false_1 X Y p r

def cutoffAvailability : CutoffAvailability := cutoffAvailability_of_closure closureRaw_false

def f_eq_globalUpper (n : ℕ) : Erdos1062.f n = globalUpper n :=
