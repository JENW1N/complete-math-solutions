/- Component ClosureActual; SHA256 330a72a33df1a785353687135798a08c3d9a644dcc0c03c31c2cc912f8664182 -/
section SubmissionComponent_ClosureActual
/- Interpret the finite dependency table by actual recursive cutoff states. -/

namespace Bounty

noncomputable def closureActualState (eps : Bool) (u : ℚ) (k : ℕ) : ℕ × ℚ :=
  cutoffState (closureNodeType eps k) ((closureNode k).v * u)

noncomputable def closureActualPhase (eps : Bool) (u : ℚ) (k : ℕ) : Prop :=
  (closureActualState eps u k).1 = 1

noncomputable def closureActualValue (eps : Bool) (u : ℚ) (k : ℕ) : ℚ :=
  (closureActualState eps u k).2 / u

def closureRootFour (u : ℚ) : ℚ := (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ / u
def closureRootThree (u : ℚ) : ℚ := (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ / u

def closureActual_parity (eps : Bool) (u : ℚ) (k : ℕ) :
    (closureActualState eps u k).1 < 2 := cutoffState_parity _ _

def closureActual_phase (eps : Bool) (u : ℚ) (k : ℕ) :
    closurePhase (closureActualPhase eps u k) = (closureActualState eps u k).1 :=
  closurePhase_of_nat (closureActual_parity eps u k)

def closureActual_child_five (eps : Bool) (u : ℚ) {k : ℕ} (hk : k < 28) :
    closureActualState eps u (closureNode k).child5 =
      cutoffState true ((closureNode k).v * u / 5) := by
  unfold closureActualState
  rw [(closureNode_child_types eps hk).1]
  congr 1
  apply (eq_div_iff (by norm_num : (5 : ℚ) ≠ 0)).mpr
  calc
    (closureNode (closureNode k).child5).v * u * 5 =
        ((closureNode (closureNode k).child5).v * 5) * u := by ring
    _ = (closureNode k).v * u := by rw [(closureNode_children hk).2.2.1]

def closureActual_child_seven (eps : Bool) (u : ℚ) {k : ℕ} (hk : k < 28) :
    closureActualState eps u (closureNode k).child7 =
      cutoffState (closureNodeType eps k) ((closureNode k).v * u / 7) := by
  unfold closureActualState
  rw [(closureNode_child_types eps hk).2]
  congr 1
  apply (eq_div_iff (by norm_num : (7 : ℚ) ≠ 0)).mpr
