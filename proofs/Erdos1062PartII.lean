/- Component NormalizedPowers; SHA256 bbf6d8dbfec9260fcd9572e2f3463dfb90b21c7f47ef43df17af024e2907ebba -/
section SubmissionComponent_NormalizedPowers
/- Power normalization and the two possible power bins after scaling. -/

namespace Bounty

def power_floor_nat_bounds {b : ℕ} (hb : 1 < b) {u : ℚ} (hu : 1 ≤ u) :
    ((b ^ Nat.log b ⌊u⌋₊ : ℕ) : ℚ) ≤ u ∧
      u < ((b ^ (Nat.log b ⌊u⌋₊ + 1) : ℕ) : ℚ) := by
  have hu0 : 0 ≤ u := by linarith
  have hn : ⌊u⌋₊ ≠ 0 := by
    have hh : 1 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
    omega
  constructor
  · exact (Nat.le_floor_iff hu0).mp (Nat.pow_log_le_self b hn)
  · exact (Nat.floor_lt hu0).mp (Nat.lt_pow_succ_log_self hb _)

def normalized_power_bounds {b : ℕ} (hb : 1 < b) {u : ℚ} (hu : 1 ≤ u) :
    1 / (b : ℚ) < (b : ℚ) ^ Nat.log b ⌊u⌋₊ / u ∧
      (b : ℚ) ^ Nat.log b ⌊u⌋₊ / u ≤ 1 := by
  have hu0 : 0 < u := by linarith
  have hb0 : (0 : ℚ) < b := by exact_mod_cast (by omega : 0 < b)
  have hh := power_floor_nat_bounds hb hu
  constructor
  · rw [div_lt_div_iff₀ hb0 hu0, one_mul]
    simpa only [Nat.cast_pow, Nat.cast_mul, pow_succ] using hh.2
  · apply (div_le_one hu0).mpr
    simpa only [Nat.cast_pow] using hh.1

def power_floor_two_bins {b j : ℕ} {u : ℚ} (hu : 0 ≤ u)
    (hlo : (b : ℚ) ^ j ≤ u) (hhi : u < (b : ℚ) ^ (j + 2)) :
    (b : ℚ) ^ Nat.log b ⌊u⌋₊ =
      if (b : ℚ) ^ (j + 1) ≤ u then (b : ℚ) ^ (j + 1) else (b : ℚ) ^ j := by
  by_cases hm : (b : ℚ) ^ (j + 1) ≤ u
  · have he : Nat.log b ⌊u⌋₊ = j + 1 :=
      log_floor_of_bounds hu (by simpa only [Nat.cast_pow] using hm)
        (by simpa only [Nat.cast_pow, Nat.add_assoc] using hhi)
    simp [hm, he]
  · have he : Nat.log b ⌊u⌋₊ = j :=
      log_floor_of_bounds hu (by simpa only [Nat.cast_pow] using hlo)
        (by simpa only [Nat.cast_pow] using (lt_of_not_ge hm))
    simp [hm, he]

def scaled_power_two_bins {b k : ℕ} (hb : 1 < b) (hk : 0 < k)
    {u d : ℚ} (hu : 1 ≤ u) (hd : 0 < d)
    (hdlo : (b : ℚ) ^ (k - 1) < d) (hdhi : d ≤ (b : ℚ) ^ k)
    (hindex : k ≤ Nat.log b ⌊u⌋₊) :
    (b : ℚ) ^ Nat.log b ⌊u / d⌋₊ =
      if (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 1) ≤ u / d
      then (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 1)
      else (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) := by
  have hb0 : (0 : ℚ) < b := by exact_mod_cast (by omega : 0 < b)
  have hroot := power_floor_nat_bounds hb hu
  have hloRoot : (b : ℚ) ^ Nat.log b ⌊u⌋₊ ≤ u := by
    simpa only [Nat.cast_pow] using hroot.1
  have hhiRoot : u < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + 1) := by
    simpa only [Nat.cast_pow] using hroot.2
  have hproduct : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) * (b : ℚ) ^ k =
      (b : ℚ) ^ Nat.log b ⌊u⌋₊ := by
    rw [← pow_add, Nat.sub_add_cancel hindex]
  have hproductHi : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 2) * (b : ℚ) ^ (k - 1) =
      (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + 1) := by
    rw [← pow_add]
    congr 1
    omega
  have hlo : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) ≤ u / d := by
    apply (le_div_iff₀ hd).mpr
    calc
      (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) * d ≤
          (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) * (b : ℚ) ^ k :=
        mul_le_mul_of_nonneg_left hdhi (le_of_lt (pow_pos hb0 _))
      _ = (b : ℚ) ^ Nat.log b ⌊u⌋₊ := hproduct
      _ ≤ u := hloRoot
  have hhi : u / d < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 2) := by
    apply (div_lt_iff₀ hd).mpr
    calc
      u < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + 1) := hhiRoot
      _ = (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 2) * (b : ℚ) ^ (k - 1) := hproductHi.symm
      _ < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 2) * d :=
        mul_lt_mul_of_pos_left hdlo (pow_pos hb0 _)
  exact power_floor_two_bins (div_nonneg (by linarith) (le_of_lt hd)) hlo hhi


end Bounty

end SubmissionComponent_NormalizedPowers

/- Component PowerScales; SHA256 cd806089de0e99effeaf86cbc602fed15b71ff13aee9d2146fccbdee3b709891 -/
section SubmissionComponent_PowerScales
/- The two power bins under multiplication, including the factor-five loss window. -/

namespace Bounty

def multiplied_power_two_bins {b k : ℕ} (hb : 1 < b)
    {u d : ℚ} (hu : 1 ≤ u)
    (hdlo : (b : ℚ) ^ k ≤ d) (hdhi : d < (b : ℚ) ^ (k + 1)) :
    (b : ℚ) ^ Nat.log b ⌊d * u⌋₊ =
      if (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 1) ≤ d * u
      then (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 1)
      else (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k) := by
  have hb0 : (0 : ℚ) < b := by exact_mod_cast (by omega : 0 < b)
  have hd0 : 0 < d := lt_of_lt_of_le (pow_pos hb0 _) hdlo
  have hu0 : 0 < u := by linarith
  have hroot := power_floor_nat_bounds hb hu
  have hloRoot : (b : ℚ) ^ Nat.log b ⌊u⌋₊ ≤ u := by
    simpa only [Nat.cast_pow] using hroot.1
  have hhiRoot : u < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + 1) := by
    simpa only [Nat.cast_pow] using hroot.2
  have hlo : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k) ≤ d * u := by
    rw [pow_add, mul_comm d u]
    exact mul_le_mul hloRoot hdlo (le_of_lt (pow_pos hb0 _)) (le_of_lt hu0)
  have hhi : d * u < (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 2) := by
    calc
      d * u < (b : ℚ) ^ (k + 1) * u := mul_lt_mul_of_pos_right hdhi hu0
      _ < (b : ℚ) ^ (k + 1) * (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + 1) :=
        mul_lt_mul_of_pos_left hhiRoot (pow_pos hb0 _)
      _ = (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 2) := by
        rw [← pow_add]
        congr 1
        omega
  exact power_floor_two_bins (le_of_lt (mul_pos hd0 hu0)) hlo hhi

def multiplied_power_normalized {b k : ℕ} (hb : 1 < b)
    {u d : ℚ} (hu : 1 ≤ u)
    (hdlo : (b : ℚ) ^ k ≤ d) (hdhi : d < (b : ℚ) ^ (k + 1)) :
    (b : ℚ) ^ Nat.log b ⌊d * u⌋₊ / u =
      if (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 1) / u ≤ d
      then (b : ℚ) ^ Nat.log b ⌊u⌋₊ / u * (b : ℚ) ^ (k + 1)
      else (b : ℚ) ^ Nat.log b ⌊u⌋₊ / u * (b : ℚ) ^ k := by
  have hu0 : 0 < u := by linarith
  rw [multiplied_power_two_bins hb hu hdlo hdhi]
  simp only [div_le_iff₀ hu0]
  split_ifs <;> simp only [pow_add] <;> ring


end Bounty

end SubmissionComponent_PowerScales

/- Component NormalizedLoss; SHA256 235c33ee30f7895b5b2820014e03a4e286c8aff6edc667644ee38e57dcab9736 -/
section SubmissionComponent_NormalizedLoss
/- Exact rational endpoints for the powers-of-five obstruction window. -/

namespace Bounty

def badWindow_floor_iff_powers {u : ℚ} (hu : 10 ≤ u) :
    badWindow ⌊u⌋₊ ↔
      4 * u < 5 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ∧
      10 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ 9 * u ∧
      3 * u < 4 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 10 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hn0 : ⌊u⌋₊ ≠ 0 := by omega
  have ha : 1 ≤ Nat.log 4 ⌊u⌋₊ :=
    (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr (by norm_num; omega)
  have hb : 2 ≤ Nat.log 3 ⌊u⌋₊ :=
    (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr (by norm_num; omega)
  have hp4 : (4 : ℕ) ^ Nat.log 4 ⌊u⌋₊ = 4 * 4 ^ (Nat.log 4 ⌊u⌋₊ - 1) := by
    calc
      4 ^ Nat.log 4 ⌊u⌋₊ = 4 ^ (Nat.log 4 ⌊u⌋₊ - 1 + 1) := by congr 1; omega
      _ = 4 * 4 ^ (Nat.log 4 ⌊u⌋₊ - 1) := by rw [pow_succ, Nat.mul_comm]
  have hp3 : (3 : ℕ) ^ Nat.log 3 ⌊u⌋₊ = 9 * 3 ^ (Nat.log 3 ⌊u⌋₊ - 2) := by
    calc
      3 ^ Nat.log 3 ⌊u⌋₊ = 3 ^ (Nat.log 3 ⌊u⌋₊ - 2 + 2) := by congr 1; omega
      _ = 9 * 3 ^ (Nat.log 3 ⌊u⌋₊ - 2) := by rw [pow_add]; norm_num; omega
  have hp4q : (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ = 4 * 4 ^ (Nat.log 4 ⌊u⌋₊ - 1) := by
    exact_mod_cast hp4
  have hp3q : (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ = 9 * 3 ^ (Nat.log 3 ⌊u⌋₊ - 2) := by
    exact_mod_cast hp3
  rw [badWindow_iff_canonical]
  constructor
  · rintro ⟨_, h4, h3lo, h3hi⟩
    have h4' : ⌊u⌋₊ < 5 * 4 ^ (Nat.log 4 ⌊u⌋₊ - 1) := by omega
    have h4q : u < 5 * (4 : ℚ) ^ (Nat.log 4 ⌊u⌋₊ - 1) := by
      exact_mod_cast (Nat.floor_lt hu0).mp h4'
    have h3loq : 10 * (3 : ℚ) ^ (Nat.log 3 ⌊u⌋₊ - 2) ≤ u := by
      exact_mod_cast (Nat.le_floor_iff hu0).mp h3lo
    have h3hiq : u < 12 * (3 : ℚ) ^ (Nat.log 3 ⌊u⌋₊ - 2) := by
      exact_mod_cast (Nat.floor_lt hu0).mp h3hi
    exact ⟨by nlinarith [hp4q], by nlinarith [hp3q], by nlinarith [hp3q]⟩
  · rintro ⟨h4, h3lo, h3hi⟩
    have h4q : u < 5 * (4 : ℚ) ^ (Nat.log 4 ⌊u⌋₊ - 1) := by nlinarith [hp4q]
    have h3loq : 10 * (3 : ℚ) ^ (Nat.log 3 ⌊u⌋₊ - 2) ≤ u := by nlinarith [hp3q]
    have h3hiq : u < 12 * (3 : ℚ) ^ (Nat.log 3 ⌊u⌋₊ - 2) := by nlinarith [hp3q]
    have h4' : ⌊u⌋₊ < 5 * 4 ^ (Nat.log 4 ⌊u⌋₊ - 1) :=
      (Nat.floor_lt hu0).mpr (by exact_mod_cast h4q)
    have h3lo' : 10 * 3 ^ (Nat.log 3 ⌊u⌋₊ - 2) ≤ ⌊u⌋₊ :=
      (Nat.le_floor_iff hu0).mpr (by exact_mod_cast h3loq)
    have h3hi' : ⌊u⌋₊ < 12 * 3 ^ (Nat.log 3 ⌊u⌋₊ - 2) :=
      (Nat.floor_lt hu0).mpr (by exact_mod_cast h3hiq)
    exact ⟨Nat.pow_log_le_self 4 hn0, by omega, h3lo', h3hi'⟩

def badWindow_floor_scaled_iff {u v : ℚ} (hu : 0 < u) (hv : 10 ≤ v * u) :
    badWindow ⌊v * u⌋₊ ↔
      4 * v < 5 * ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ∧
      10 * ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) ≤ 9 * v ∧
      3 * v < 4 * ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) := by
  rw [badWindow_floor_iff_powers hv]
  have h4 : (4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u * u = (4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ :=
    div_mul_cancel₀ _ (ne_of_gt hu)
  have h3 : (3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u * u = (3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ :=
    div_mul_cancel₀ _ (ne_of_gt hu)
  constructor <;> rintro ⟨h₁, h₂, h₃⟩
  · exact ⟨by nlinarith, by nlinarith, by nlinarith⟩
  · exact ⟨by nlinarith, by nlinarith, by nlinarith⟩


end Bounty

end SubmissionComponent_NormalizedLoss

/- Component ParityPowers; SHA256 fbe6af3f90e0826256f98d1a27476a9363ba98f71ea23b68fb55ef4a28132dab -/
section SubmissionComponent_ParityPowers
/- The latest odd-parity thresholds in terms of the two unscaled powers. -/

namespace Bounty

def log_powers_distinct {n : ℕ} (hn : 3 ≤ n) :
    4 ^ Nat.log 4 n ≠ 3 ^ Nat.log 3 n := by
  intro he
  have hc : Nat.Coprime (4 ^ Nat.log 4 n) (3 ^ Nat.log 3 n) :=
    (by norm_num : Nat.Coprime 4 3).pow _ _
  rw [he, Nat.coprime_self] at hc
  have hlog : 1 ≤ Nat.log 3 n :=
    (Nat.le_log_iff_pow_le (by norm_num) (by omega : n ≠ 0)).mpr (by simpa using hn)
  have hh : 1 < 3 ^ Nat.log 3 n := Nat.one_lt_pow (by omega) (by norm_num)
  omega

def double_four_power_half {n : ℕ} (hn : 2 ≤ n) :
    2 * (4 : ℚ) ^ Nat.log 4 (n / 2) =
      if 2 * 4 ^ Nat.log 4 n ≤ n
      then 2 * (4 : ℚ) ^ Nat.log 4 n else (4 : ℚ) ^ Nat.log 4 n / 2 := by
  by_cases hp : 2 * 4 ^ Nat.log 4 n ≤ n
  · have hp' := (log_two_odd_iff_four_threshold (by omega : 0 < n)).mpr hp
    have hh := log_four_half_odd hp'
    simp [hp, hh]
  · have hp' : Nat.log 2 n % 2 = 0 := by
      have hnot : ¬Nat.log 2 n % 2 = 1 :=
        mt (log_two_odd_iff_four_threshold (by omega : 0 < n)).mp hp
      omega
    have hh := log_four_half_even hn hp'
    have he : (4 : ℚ) ^ Nat.log 4 n = 4 * (4 : ℚ) ^ Nat.log 4 (n / 2) := by
      rw [← hh, pow_succ]
      ring
    simp only [hp, if_false, he]
    ring

def double_three_power_half {n : ℕ} (hn : 2 ≤ n) :
    2 * (3 : ℚ) ^ Nat.log 3 (n / 2) =
      if 2 * 3 ^ Nat.log 3 n ≤ n
      then 2 * (3 : ℚ) ^ Nat.log 3 n else 2 * (3 : ℚ) ^ Nat.log 3 n / 3 := by
  by_cases hd : 2 * 3 ^ Nat.log 3 n ≤ n
  · have hh := log_three_half (by omega : 0 < n) hd
    simp [hd, hh]
  · have hh := log_three_half_below hn hd
    have he : (3 : ℚ) ^ Nat.log 3 n = 3 * (3 : ℚ) ^ Nat.log 3 (n / 2) := by
      rw [← hh, pow_succ]
      ring
    simp only [hd, if_false, he]
    ring

def double_four_power_half_floor {u : ℚ} (hu : 2 ≤ u) :
    2 * (4 : ℚ) ^ Nat.log 4 ⌊u / 2⌋₊ =
      if 2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ≤ u
      then 2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ else (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ / 2 := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hh := double_four_power_half hn
  have hfloor : ⌊u / 2⌋₊ = ⌊u⌋₊ / 2 := Nat.floor_div_natCast u 2
  simpa only [hfloor,
    Nat.le_floor_iff hu0, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] using hh

def double_three_power_half_floor {u : ℚ} (hu : 2 ≤ u) :
    2 * (3 : ℚ) ^ Nat.log 3 ⌊u / 2⌋₊ =
      if 2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ u
      then 2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ else 2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ / 3 := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hh := double_three_power_half hn
  have hfloor : ⌊u / 2⌋₊ = ⌊u⌋₊ / 2 := Nat.floor_div_natCast u 2
  simpa only [hfloor,
    Nat.le_floor_iff hu0, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] using hh


end Bounty

end SubmissionComponent_ParityPowers

/- Component ProfileLevels; SHA256 5b94fd28810ff485629b707cf8d64beb0bfca2c5fc4868c19a45d69834f5fbe2 -/
section SubmissionComponent_ProfileLevels
/- The current and preceding cutoff levels as rational threshold profiles. -/

namespace Bounty

def cutoffPowerFour (p n : ℕ) : ℚ :=
  if p = 0 then 4 ^ Nat.log 4 n else 2 * 4 ^ Nat.log 4 (n / 2)

def cutoffPowerThree (p n : ℕ) : ℚ :=
  if p = 0 then 3 ^ Nat.log 3 n else 2 * 3 ^ Nat.log 3 (n / 2)

def rational_power_pred {b k : ℕ} (hb : 0 < b) (hk : 0 < k) :
    (b : ℚ) ^ (k - 1) = (b : ℚ) ^ k / b := by
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hb)
  apply (eq_div_iff hb0).mpr
  rw [← pow_succ, show k - 1 + 1 = k by omega]

def lowerCutoff_zero_previous_rational {n : ℕ} (hn : 3 ≤ n) :
    (lowerCutoff 0 (cutoffCount 0 n - 1) : ℚ) =
      if (4 : ℚ) ^ Nat.log 4 n > (3 : ℚ) ^ Nat.log 3 n
      then max ((4 : ℚ) ^ Nat.log 4 n / 4) ((3 : ℚ) ^ Nat.log 3 n)
      else max ((4 : ℚ) ^ Nat.log 4 n) ((3 : ℚ) ^ Nat.log 3 n / 3) := by
  by_cases hh : (3 : ℕ) ^ Nat.log 3 n < 4 ^ Nat.log 4 n
  · have hhq : (3 : ℚ) ^ Nat.log 3 n < 4 ^ Nat.log 4 n := by exact_mod_cast hh
    have hj : 0 < Nat.log 4 n := by
      have hp : 0 < (3 : ℕ) ^ Nat.log 3 n := by positivity
      by_contra he
      have hz : Nat.log 4 n = 0 := by omega
      simp only [hz, pow_zero] at hh
      omega
    rw [if_pos hhq, lowerCutoff_zero_previous_four (by omega) hh]
    simp only [Nat.cast_max, Nat.cast_pow, Nat.cast_ofNat]
    have he : (4 : ℚ) ^ (Nat.log 4 n - 1) = (4 : ℚ) ^ Nat.log 4 n / 4 := by
      simpa only [Nat.cast_ofNat] using rational_power_pred (by norm_num : 0 < (4 : ℕ)) hj
    rw [he]
  · have hneq := log_powers_distinct hn
    have hh' : (4 : ℕ) ^ Nat.log 4 n < 3 ^ Nat.log 3 n := by omega
    have hhq : ¬(3 : ℚ) ^ Nat.log 3 n < 4 ^ Nat.log 4 n := by exact_mod_cast hh
    have hj : 0 < Nat.log 3 n := by
      have hp : 0 < (4 : ℕ) ^ Nat.log 4 n := by positivity
      by_contra he
      have hz : Nat.log 3 n = 0 := by omega
      simp only [hz, pow_zero] at hh'
      omega
    rw [if_neg hhq, lowerCutoff_zero_previous_three (by omega) hh']
    simp only [Nat.cast_max, Nat.cast_pow, Nat.cast_ofNat]
    have he : (3 : ℚ) ^ (Nat.log 3 n - 1) = (3 : ℚ) ^ Nat.log 3 n / 3 := by
      simpa only [Nat.cast_ofNat] using rational_power_pred (by norm_num : 0 < (3 : ℕ)) hj
    rw [he]

def lowerCutoff_at_count_profile {p n : ℕ} (hp : p < 2) (hn : 2 ≤ n) :
    (lowerCutoff p (cutoffCount p n) : ℚ) =
      max (cutoffPowerFour p n) (cutoffPowerThree p n) := by
  have hp' : p = 0 ∨ p = 1 := by omega
  rcases hp' with rfl | rfl
  · rw [lowerCutoff_zero_at_count (by omega)]
    simp only [cutoffPowerFour, cutoffPowerThree, ↓reduceIte, Nat.cast_max,
      Nat.cast_pow, Nat.cast_ofNat]
  · rw [lowerCutoff_one_at_count hn]
    simp only [cutoffPowerFour, cutoffPowerThree, show ¬(1 : ℕ) = 0 by omega,
      if_false, Nat.cast_mul, Nat.cast_max, Nat.cast_pow, Nat.cast_ofNat]
    exact mul_max_of_nonneg _ _ (by norm_num : (0 : ℚ) ≤ 2)

def lowerCutoff_previous_profile {p n : ℕ} (hp : p < 2) (hn : 6 ≤ n) :
    (lowerCutoff p (cutoffCount p n - 1) : ℚ) =
      if cutoffPowerFour p n > cutoffPowerThree p n
      then max (cutoffPowerFour p n / 4) (cutoffPowerThree p n)
      else max (cutoffPowerFour p n) (cutoffPowerThree p n / 3) := by
  have hp' : p = 0 ∨ p = 1 := by omega
  rcases hp' with rfl | rfl
  · simpa only [cutoffPowerFour, cutoffPowerThree, ↓reduceIte] using
      lowerCutoff_zero_previous_rational (by omega : 3 ≤ n)
  · have hcp := cutoffCount_one_ge_three hn
    have hc : cutoffCount 1 n = cutoffCount 0 (n / 2) + 1 := by
      simp [cutoffCount, show ¬n < 2 by omega, show n / 2 ≠ 0 by omega]
      omega
    have he : cutoffCount 1 n - 1 - 1 = cutoffCount 0 (n / 2) - 1 := by omega
    rw [lowerCutoff_one_scale (by omega : 2 ≤ cutoffCount 1 n - 1), he]
    simp only [Nat.cast_mul, Nat.cast_ofNat, cutoffPowerFour, cutoffPowerThree,
      show ¬(1 : ℕ) = 0 by omega, if_false]
    rw [lowerCutoff_zero_previous_rational (by omega : 3 ≤ n / 2)]
    have heq : 2 * (4 : ℚ) ^ Nat.log 4 (n / 2) > 2 * (3 : ℚ) ^ Nat.log 3 (n / 2) ↔
        (4 : ℚ) ^ Nat.log 4 (n / 2) > (3 : ℚ) ^ Nat.log 3 (n / 2) := by
      constructor <;> intro hh <;> linarith
    simp only [heq]
    split_ifs <;> rw [mul_max_of_nonneg _ _ (by norm_num : (0 : ℚ) ≤ 2)] <;>
      congr 1 <;> ring


end Bounty

end SubmissionComponent_ProfileLevels

/- Component ProfileQuota; SHA256 8e275e2f296b96cb3e20e0b237940f5fb7776c4858cb3c640c640c3a750b05f8 -/
section SubmissionComponent_ProfileQuota
/- The signed difference between a quota loss and a cutoff parity deficit. -/

namespace Bounty

def quotaLossValue (eps : Bool) (u : ℚ) : ℕ :=
  letI := badWindow_decidable ⌊5 * u⌋₊
  if eps = true ∧ badWindow ⌊5 * u⌋₊ then 1 else 0

def cutoffDeficit (p : ℕ) (u : ℚ) : ℕ :=
  if p = 0 then
    if 2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ≤ u ∧ 2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ u then 1 else 0
  else
    if ¬2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ≤ u ∧ ¬2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ u then 1 else 0

def cutoffDelta (eps : Bool) (p : ℕ) (u : ℚ) : ℤ :=
  (quotaLossValue eps u : ℤ) - (cutoffDeficit p u : ℤ)

def quotaLossValue_le_one (eps : Bool) (u : ℚ) : quotaLossValue eps u ≤ 1 := by
  unfold quotaLossValue
  split_ifs <;> omega

def cutoffDeficit_le_one (p : ℕ) (u : ℚ) : cutoffDeficit p u ≤ 1 := by
  unfold cutoffDeficit
  split_ifs <;> omega

def cutoffCount_add_deficit {p : ℕ} (hp : p < 2) {u : ℚ} (hu : 2 ≤ u) :
    cutoffCount p ⌊u⌋₊ + cutoffDeficit p u = smoothRankBound ⌊u⌋₊ := by
  have hp' : p = 0 ∨ p = 1 := by omega
  rcases hp' with rfl | rfl
  · simpa only [cutoffDeficit, ↓reduceIte] using cutoffCount_zero_floor_deficit (by linarith : 1 ≤ u)
  · simpa only [cutoffDeficit, show ¬(1 : ℕ) = 0 by omega, ↓reduceIte] using cutoffCount_one_floor_deficit hu

def quotaLossValue_one_ge_fifty_four {eps : Bool} {u : ℚ} (hu : 0 ≤ u)
    (hloss : quotaLossValue eps u = 1) : 54 ≤ u := by
  have hb : badWindow ⌊5 * u⌋₊ := by
    unfold quotaLossValue at hloss
    split_ifs at hloss with hh
    · exact hh.2
  have hh : (0x10e : ℚ) ≤ 5 * u :=
    (Nat.le_floor_iff (by positivity : 0 ≤ 5 * u)).mp (badWindow_ge_270 hb)
  linarith

def cutoffDelta_bounds (eps : Bool) (p : ℕ) (u : ℚ) :
    -1 ≤ cutoffDelta eps p u ∧ cutoffDelta eps p u ≤ 1 := by
  have hl := quotaLossValue_le_one eps u
  have hd := cutoffDeficit_le_one p u
  unfold cutoffDelta
  omega

def quotaValue_cast_eq_count_sub_delta {eps : Bool} {p : ℕ} (hp : p < 2)
    {u : ℚ} (hu : 2 ≤ u) :
    (quotaValue eps u : ℤ) = (cutoffCount p ⌊u⌋₊ : ℤ) - cutoffDelta eps p u := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 0 < ⌊u⌋₊ := by
    have hh : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
    omega
  have hr := smoothRankBound_pos hn
  have hl := quotaLossValue_le_one eps u
  have hc := cutoffCount_add_deficit hp hu
  have hdef : quotaValue eps u = smoothRankBound ⌊u⌋₊ - quotaLossValue eps u := rfl
  rw [hdef]
  unfold cutoffDelta
  omega

def cutoffDelta_one_ge_fifty_four {eps : Bool} {p : ℕ} {u : ℚ} (hu : 0 ≤ u)
    (hd : cutoffDelta eps p u = 1) : 54 ≤ u := by
  have hl := quotaLossValue_le_one eps u
  have hdef := cutoffDeficit_le_one p u
  have he : quotaLossValue eps u = 1 := by unfold cutoffDelta at hd; omega
  exact quotaLossValue_one_ge_fifty_four hu he


end Bounty

end SubmissionComponent_ProfileQuota

/- Component ProfileValidity; SHA256 4024ca34b3c981b4b47947e205aab2bac69f07f4defc22eef7a3db38aba97ff4 -/
section SubmissionComponent_ProfileValidity
/- The rational closure profile is exactly the cutoff quota condition. -/

namespace Bounty

def cutoffProfileLower (eps : Bool) (p : ℕ) (u : ℚ) : ℚ :=
  if cutoffDelta eps p u = 0 then max (cutoffPowerFour p ⌊u⌋₊) (cutoffPowerThree p ⌊u⌋₊)
  else if cutoffPowerFour p ⌊u⌋₊ > cutoffPowerThree p ⌊u⌋₊
    then max (cutoffPowerFour p ⌊u⌋₊ / 4) (cutoffPowerThree p ⌊u⌋₊)
    else max (cutoffPowerFour p ⌊u⌋₊) (cutoffPowerThree p ⌊u⌋₊ / 3)

def cutoffProfileValid (eps : Bool) (p : ℕ) (u r : ℚ) : Prop :=
  0 ≤ cutoffDelta eps p u ∧ cutoffProfileLower eps p u ≤ r ∧
    if cutoffDelta eps p u = 0 then r ≤ u
    else r < max (cutoffPowerFour p ⌊u⌋₊) (cutoffPowerThree p ⌊u⌋₊)

def lowerCutoff_quota_profile {eps : Bool} {p : ℕ} (hp : p < 2)
    {u : ℚ} (hu : 2 ≤ u) (hd : 0 ≤ cutoffDelta eps p u) :
    (lowerCutoff p (quotaValue eps u) : ℚ) = cutoffProfileLower eps p u := by
  have hh := quotaValue_cast_eq_count_sub_delta (eps := eps) hp hu
  have hdhi := (cutoffDelta_bounds eps p u).2
  have hu0 : 0 ≤ u := by linarith
  by_cases hz : cutoffDelta eps p u = 0
  · have hq : quotaValue eps u = cutoffCount p ⌊u⌋₊ := by omega
    have hn : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
    rw [hq, lowerCutoff_at_count_profile hp hn]
    simp [cutoffProfileLower, hz]
  · have hd1 : cutoffDelta eps p u = 1 := by omega
    have hu54 := cutoffDelta_one_ge_fifty_four hu0 hd1
    have hn : 6 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr (by norm_num; linarith)
    have hq : quotaValue eps u = cutoffCount p ⌊u⌋₊ - 1 := by omega
    rw [hq, lowerCutoff_previous_profile hp hn]
    simp [cutoffProfileLower, hz]

def cutoffProfileValid_iff {eps : Bool} {p : ℕ} (hp : p < 2)
    {u r : ℚ} (hu : 2 ≤ u) (hr : 0 ≤ r) :
    cutoffProfileValid eps p u r ↔
      r ≤ u ∧ cutoffCount p ⌊r⌋₊ = quotaValue eps u := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hbounds := (cutoffCount_floor_level_iff p (cutoffCount p ⌊u⌋₊) hu0).mp rfl
  have hcast := quotaValue_cast_eq_count_sub_delta (eps := eps) hp hu
  have hdelta := cutoffDelta_bounds eps p u
  have casesDelta : cutoffDelta eps p u = -1 ∨ cutoffDelta eps p u = 0 ∨ cutoffDelta eps p u = 1 := by omega
  rcases casesDelta with hneg | hz | hone
  · apply iff_of_false
    · intro hv
      have := hv.1
      omega
    · rintro ⟨hru, hsize⟩
      have hm := cutoffCount_mono p (Nat.floor_mono hru)
      omega
  · have hd : 0 ≤ cutoffDelta eps p u := by omega
    have hq : quotaValue eps u = cutoffCount p ⌊u⌋₊ := by omega
    have hlo := lowerCutoff_quota_profile (eps := eps) hp hu hd
    constructor
    · intro hv
      have hru : r ≤ u := by simpa only [hz, ↓reduceIte] using hv.2.2
      refine ⟨hru, (cutoffCount_floor_level_iff p (quotaValue eps u) hr).mpr ?_⟩
      constructor
      · simpa only [hlo] using hv.2.1
      · rw [hq]
        exact hru.trans_lt hbounds.2
    · rintro ⟨hru, hsize⟩
      have hb := (cutoffCount_floor_level_iff p (quotaValue eps u) hr).mp hsize
      refine ⟨hd, ?_, ?_⟩
      · simpa only [hlo] using hb.1
      · simpa only [hz, ↓reduceIte] using hru
  · have hd : 0 ≤ cutoffDelta eps p u := by omega
    have hz : cutoffDelta eps p u ≠ 0 := by omega
    have hq : quotaValue eps u + 1 = cutoffCount p ⌊u⌋₊ := by omega
    have hlo := lowerCutoff_quota_profile (eps := eps) hp hu hd
    have hhi : (lowerCutoff p (quotaValue eps u + 1) : ℚ) =
        max (cutoffPowerFour p ⌊u⌋₊) (cutoffPowerThree p ⌊u⌋₊) := by
      rw [hq, lowerCutoff_at_count_profile hp hn]
    constructor
    · intro hv
      have hrhi : r < (lowerCutoff p (quotaValue eps u + 1) : ℚ) := by
        simpa only [hz, ↓reduceIte, hhi] using hv.2.2
      have hru : r ≤ u := by
        rw [hq] at hrhi
        exact (hrhi.trans_le hbounds.1).le
      refine ⟨hru, (cutoffCount_floor_level_iff p (quotaValue eps u) hr).mpr ?_⟩
      exact ⟨by simpa only [hlo] using hv.2.1, hrhi⟩
    · rintro ⟨_, hsize⟩
      have hb := (cutoffCount_floor_level_iff p (quotaValue eps u) hr).mp hsize
      refine ⟨hd, ?_, ?_⟩
      · simpa only [hlo] using hb.1
      · simpa only [hz, ↓reduceIte, hhi] using hb.2


end Bounty

end SubmissionComponent_ProfileValidity

/- Component ProfileTrial; SHA256 8ee28eb10e5bc33de807f03b4b6265c7e3ba75ae33b57f2ad7e40f72827c3b3e -/
section SubmissionComponent_ProfileTrial
/- Equivalence between the actual recursive trial and its rational profile. -/

namespace Bounty

def cutoffProfileTrial (eps : Bool) (u : ℚ) (p : ℕ) (c5 c7 : ℕ × ℚ) : ℚ :=
  max (max (3 * u / 4) (cutoffProfileLower eps p u))
    (max ((if p = c5.1 then 4 else 6) * c5.2) ((if p = c7.1 then 4 else 6) * c7.2))

def cutoffProfileTrial_bounds (eps : Bool) (u : ℚ) (p : ℕ) (c5 c7 : ℕ × ℚ) :
    3 * u / 4 ≤ cutoffProfileTrial eps u p c5 c7 ∧
    cutoffProfileLower eps p u ≤ cutoffProfileTrial eps u p c5 c7 ∧
    (if p = c5.1 then 4 else 6) * c5.2 ≤ cutoffProfileTrial eps u p c5 c7 ∧
    (if p = c7.1 then 4 else 6) * c7.2 ≤ cutoffProfileTrial eps u p c5 c7 := by
  unfold cutoffProfileTrial
  exact ⟨(le_max_left _ _).trans (le_max_left _ _),
    (le_max_right _ _).trans (le_max_left _ _),
    (le_max_left _ _).trans (le_max_right _ _),
    (le_max_right _ _).trans (le_max_right _ _)⟩

def cutoffTrial_eq_profile {eps : Bool} {u : ℚ} {p : ℕ} (hp : p < 2)
    (hu : 2 ≤ u) (hd : 0 ≤ cutoffDelta eps p u) (c5 c7 : ℕ × ℚ) :
    cutoffTrial u (quotaValue eps u) p c5 c7 = cutoffProfileTrial eps u p c5 c7 := by
  unfold cutoffTrial cutoffProfileTrial
  rw [lowerCutoff_quota_profile hp hu hd]

def cutoffAvailable_delta_nonneg {eps : Bool} {u : ℚ} {p : ℕ} {c5 c7 : ℕ × ℚ}
    (hp : p < 2) (hu : 2 ≤ u) (ha : cutoffAvailable u (quotaValue eps u) p c5 c7) :
    0 ≤ cutoffDelta eps p u := by
  have hsize := cutoffTrial_size (by linarith : 0 ≤ u) ha
  have hm := cutoffCount_mono p (Nat.floor_mono ha.1)
  have hc := quotaValue_cast_eq_count_sub_delta (eps := eps) hp hu
  omega

def cutoffAvailable_iff_profile {eps : Bool} {u : ℚ} {p : ℕ} {c5 c7 : ℕ × ℚ}
    (hp : p < 2) (hu : 2 ≤ u) :
    cutoffAvailable u (quotaValue eps u) p c5 c7 ↔
      cutoffProfileValid eps p u (cutoffProfileTrial eps u p c5 c7) := by
  have hb := cutoffProfileTrial_bounds eps u p c5 c7
  have hr : 0 ≤ cutoffProfileTrial eps u p c5 c7 := by linarith [hb.1]
  constructor
  · intro ha
    have hd := cutoffAvailable_delta_nonneg hp hu ha
    have he := cutoffTrial_eq_profile hp hu hd c5 c7
    apply (cutoffProfileValid_iff hp hu hr).mpr
    constructor
    · simpa only [he] using ha.1
    · simpa only [he] using cutoffTrial_size (by linarith : 0 ≤ u) ha
  · intro hv
    have he := cutoffTrial_eq_profile hp hu hv.1 c5 c7
    have hh := (cutoffProfileValid_iff hp hu hr).mp hv
    have hlevel := (cutoffCount_floor_level_iff p (quotaValue eps u) hr).mp hh.2
    unfold cutoffAvailable
    rw [he]
    exact ⟨hh.1, hlevel.2⟩


end Bounty

end SubmissionComponent_ProfileTrial

/- Component DivisionPowers; SHA256 237fd97e9899f0cd27dac4ac1f01dfa4194ee8c9fb5f05cb309986c25a0b5fab -/
section SubmissionComponent_DivisionPowers
/- Child powers divided by the root input, in the closure's rational coordinates. -/

namespace Bounty

def divided_power_normalized {b k : ℕ} (hb : 1 < b) (hk : 0 < k)
    {u d : ℚ} (hu : 1 ≤ u) (hd : 0 < d)
    (hdlo : (b : ℚ) ^ (k - 1) < d) (hdhi : d ≤ (b : ℚ) ^ k)
    (hindex : k ≤ Nat.log b ⌊u⌋₊) :
    (b : ℚ) ^ Nat.log b ⌊u / d⌋₊ / u =
      if (b : ℚ) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k ≤ 1 / d
      then (b : ℚ) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k
      else ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k := by
  have hu0 : 0 < u := by linarith
  have hb0 : (0 : ℚ) < b := by exact_mod_cast (by omega : 0 < b)
  have hp : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) * (b : ℚ) ^ k =
      (b : ℚ) ^ Nat.log b ⌊u⌋₊ := by
    rw [← pow_add, Nat.sub_add_cancel hindex]
  have hsmall : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) / u =
      ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k := by
    apply (eq_div_iff (ne_of_gt (pow_pos hb0 _))).mpr
    rw [div_mul_eq_mul_div, hp]
  have hbig : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 1) / u =
      (b : ℚ) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k := by
    rw [pow_succ]
    calc
      (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) * b / u =
          b * ((b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k) / u) := by ring
      _ = b * (((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k) := by rw [hsmall]
      _ = (b : ℚ) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k := by ring
  have hcond : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ - k + 1) ≤ u / d ↔
      (b : ℚ) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) / (b : ℚ) ^ k ≤ 1 / d := by
    rw [← hbig, le_div_iff₀ hd, div_le_div_iff₀ hu0 hd, one_mul]
  rw [scaled_power_two_bins hb hk hu hd hdlo hdhi hindex]
  simp only [hcond]
  split_ifs <;> simp only [hsmall, hbig]

def multiplied_power_normalized_linear {b k : ℕ} (hb : 1 < b)
    {u d : ℚ} (hu : 1 ≤ u)
    (hdlo : (b : ℚ) ^ k ≤ d) (hdhi : d < (b : ℚ) ^ (k + 1)) :
    (b : ℚ) ^ Nat.log b ⌊d * u⌋₊ / u =
      if (b : ℚ) ^ (k + 1) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) ≤ d
      then (b : ℚ) ^ (k + 1) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u)
      else (b : ℚ) ^ k * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) := by
  have hh := multiplied_power_normalized hb hu hdlo hdhi
  have he : (b : ℚ) ^ (Nat.log b ⌊u⌋₊ + k + 1) / u =
      (b : ℚ) ^ (k + 1) * ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) := by
    rw [show Nat.log b ⌊u⌋₊ + k + 1 = Nat.log b ⌊u⌋₊ + (k + 1) by omega, pow_add]
    ring
  simpa only [he, mul_comm] using hh


end Bounty

end SubmissionComponent_DivisionPowers

/- Component ProfileScaling; SHA256 87a4be247874c01ebe3a829c380e270bfcc4c325f14e0e84b4a98a93c6012850 -/
section SubmissionComponent_ProfileScaling
/- Normalizing the cutoff profile by a positive root input. -/

namespace Bounty

def normalizedParityFour (p : ℕ) (v a : ℚ) : ℚ :=
  if p = 0 then a else if 2 * a ≤ v then 2 * a else a / 2

def normalizedParityThree (p : ℕ) (v b : ℚ) : ℚ :=
  if p = 0 then b else if 2 * b ≤ v then 2 * b else 2 * b / 3

def normalizedProfileLower (delta : ℤ) (a b : ℚ) : ℚ :=
  if delta = 0 then max a b else if a > b then max (a / 4) b else max a (b / 3)

def normalizedProfileValid (delta : ℤ) (v a b r : ℚ) : Prop :=
  0 ≤ delta ∧ normalizedProfileLower delta a b ≤ r ∧
    if delta = 0 then r ≤ v else r < max a b

def cutoffPowerFour_normalized (p : ℕ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffPowerFour p ⌊v * u⌋₊ / u =
      normalizedParityFour p v ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) := by
  by_cases hp : p = 0
  · simp [cutoffPowerFour, normalizedParityFour, hp]
  · have hh := double_four_power_half_floor hv
    have hfloor : ⌊v * u / 2⌋₊ = ⌊v * u⌋₊ / 2 := Nat.floor_div_natCast (v * u) 2
    rw [hfloor] at hh
    have hc : 2 * ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ≤ v ↔
        2 * (4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ ≤ v * u := by
      rw [← mul_div_assoc, div_le_iff₀ hu]
    simp only [cutoffPowerFour, normalizedParityFour, hp, ↓reduceIte, hh, hc]
    split_ifs <;> ring

def cutoffPowerThree_normalized (p : ℕ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffPowerThree p ⌊v * u⌋₊ / u =
      normalizedParityThree p v ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) := by
  by_cases hp : p = 0
  · simp [cutoffPowerThree, normalizedParityThree, hp]
  · have hh := double_three_power_half_floor hv
    have hfloor : ⌊v * u / 2⌋₊ = ⌊v * u⌋₊ / 2 := Nat.floor_div_natCast (v * u) 2
    rw [hfloor] at hh
    have hc : 2 * ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) ≤ v ↔
        2 * (3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ ≤ v * u := by
      rw [← mul_div_assoc, div_le_iff₀ hu]
    simp only [cutoffPowerThree, normalizedParityThree, hp, ↓reduceIte, hh, hc]
    split_ifs <;> ring

def normalizedProfileLower_scale (delta : ℤ) (a b : ℚ) {u : ℚ} (hu : 0 < u) :
    normalizedProfileLower delta a b / u = normalizedProfileLower delta (a / u) (b / u) := by
  unfold normalizedProfileLower
  simp only [div_lt_div_iff_of_pos_right hu]
  split_ifs <;> rw [← max_div_div_right hu.le] <;> congr 1 <;> ring

def cutoffProfileLower_normalized (eps : Bool) (p : ℕ) {u v : ℚ} (hu : 0 < u)
    (hv : 2 ≤ v * u) :
    cutoffProfileLower eps p (v * u) / u =
      normalizedProfileLower (cutoffDelta eps p (v * u))
        (normalizedParityFour p v ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u))
        (normalizedParityThree p v ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)) := by
  change normalizedProfileLower (cutoffDelta eps p (v * u))
    (cutoffPowerFour p ⌊v * u⌋₊) (cutoffPowerThree p ⌊v * u⌋₊) / u = _
  rw [normalizedProfileLower_scale _ _ _ hu,
    cutoffPowerFour_normalized p hu hv, cutoffPowerThree_normalized p hu hv]

def normalizedProfileValid_scale (delta : ℤ) (v a b r : ℚ) {u : ℚ} (hu : 0 < u) :
    (0 ≤ delta ∧ normalizedProfileLower delta a b ≤ r * u ∧
      if delta = 0 then r * u ≤ v * u else r * u < max a b) ↔
      normalizedProfileValid delta v (a / u) (b / u) r := by
  unfold normalizedProfileValid
  rw [← normalizedProfileLower_scale _ _ _ hu, ← div_le_iff₀ hu]
  simp only [mul_le_mul_iff_left₀ hu, max_div_div_right hu.le, lt_div_iff₀ hu]

def cutoffProfileValid_normalized (eps : Bool) (p : ℕ) {u v r : ℚ} (hu : 0 < u)
    (hv : 2 ≤ v * u) :
    cutoffProfileValid eps p (v * u) (r * u) ↔
      normalizedProfileValid (cutoffDelta eps p (v * u)) v
        (normalizedParityFour p v ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u))
        (normalizedParityThree p v ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)) r := by
  change (0 ≤ cutoffDelta eps p (v * u) ∧
    normalizedProfileLower (cutoffDelta eps p (v * u))
      (cutoffPowerFour p ⌊v * u⌋₊) (cutoffPowerThree p ⌊v * u⌋₊) ≤ r * u ∧
      if cutoffDelta eps p (v * u) = 0 then r * u ≤ v * u
      else r * u < max (cutoffPowerFour p ⌊v * u⌋₊) (cutoffPowerThree p ⌊v * u⌋₊)) ↔ _
  rw [normalizedProfileValid_scale _ _ _ _ _ hu,
    cutoffPowerFour_normalized p hu hv, cutoffPowerThree_normalized p hu hv]


end Bounty

end SubmissionComponent_ProfileScaling

/- Component QuotaScaling; SHA256 1171240a9ff518c1440f9bf2a22494e770c83914d55a498c64974d1f3ff8eaea -/
section SubmissionComponent_QuotaScaling
/- The normalized loss and deficit formulas used by the closure certificate. -/

namespace Bounty

def normalizedDeficit (p : ℕ) (v a b : ℚ) : ℕ :=
  if p = 0 then if 2 * a ≤ v ∧ 2 * b ≤ v then 1 else 0
  else if ¬2 * a ≤ v ∧ ¬2 * b ≤ v then 1 else 0

def normalizedLossValue (eps : Bool) (v a b : ℚ) : ℕ :=
  if eps = true ∧ 5 * v < (5 / 4 : ℚ) * a ∧ (10 / 9 : ℚ) * b ≤ 5 * v ∧
    5 * v < (4 / 3 : ℚ) * b then 1 else 0

def normalizedDelta (eps : Bool) (p : ℕ) (v a b a5 b5 : ℚ) : ℤ :=
  (normalizedLossValue eps v a5 b5 : ℤ) - (normalizedDeficit p v a b : ℤ)

def cutoffDeficit_normalized (p : ℕ) {u v : ℚ} (hu : 0 < u) :
    cutoffDeficit p (v * u) = normalizedDeficit p v
      ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) := by
  have h4 : 2 * ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ≤ v ↔
      2 * (4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ ≤ v * u := by
    rw [← mul_div_assoc, div_le_iff₀ hu]
  have h3 : 2 * ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u) ≤ v ↔
      2 * (3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ ≤ v * u := by
    rw [← mul_div_assoc, div_le_iff₀ hu]
  simp only [cutoffDeficit, normalizedDeficit, h4, h3]

def quotaLossValue_normalized (eps : Bool) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    quotaLossValue eps (v * u) = normalizedLossValue eps v
      ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u)
      ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) := by
  have hh := badWindow_floor_scaled_iff (u := u) (v := 5 * v) hu (by nlinarith : 10 ≤ (5 * v) * u)
  have hb : badWindow ⌊5 * (v * u)⌋₊ ↔
      4 * (5 * v) < 5 * ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ∧
      10 * ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) ≤ 9 * (5 * v) ∧
      3 * (5 * v) < 4 * ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) := by
    simpa only [mul_assoc] using hh
  have hb' : badWindow ⌊5 * (v * u)⌋₊ ↔
      5 * v < (5 / 4 : ℚ) * ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ∧
      (10 / 9 : ℚ) * ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) ≤ 5 * v ∧
      5 * v < (4 / 3 : ℚ) * ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) := by
    rw [hb]
    constructor <;> rintro ⟨h₁, h₂, h₃⟩ <;>
      exact ⟨by linarith, by linarith, by linarith⟩
  simp only [quotaLossValue, normalizedLossValue, hb']

def cutoffDelta_normalized (eps : Bool) (p : ℕ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffDelta eps p (v * u) = normalizedDelta eps p v
      ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
      ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u)
      ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) := by
  unfold cutoffDelta normalizedDelta
  rw [quotaLossValue_normalized eps hu hv, cutoffDeficit_normalized p hu]


end Bounty

end SubmissionComponent_QuotaScaling

/- Component TrialScaling; SHA256 2502d94740d81774eb053d76bb047ef55c61b1d3745b12bba6ad4a61585b1f1a -/
section SubmissionComponent_TrialScaling
/- The entire recursive trial expressed in normalized coordinates. -/

namespace Bounty

def normalizedProfileTrial (delta : ℤ) (v a b : ℚ) (p p5 p7 : ℕ) (r5 r7 : ℚ) : ℚ :=
  max (max (3 * v / 4) (normalizedProfileLower delta a b))
    (max ((if p = p5 then 4 else 6) * r5) ((if p = p7 then 4 else 6) * r7))

def cutoffProfileTrial_normalized (eps : Bool) (p p5 p7 : ℕ) (r5 r7 : ℚ)
    {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffProfileTrial eps (v * u) p (p5, r5 * u) (p7, r7 * u) / u =
      normalizedProfileTrial (cutoffDelta eps p (v * u)) v
        (normalizedParityFour p v ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u))
        (normalizedParityThree p v ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)) p p5 p7 r5 r7 := by
  have hscale (a b : ℚ) : a * (b * u) / u = a * b := by
    field_simp
  have hbase : 3 * (v * u) / 4 / u = 3 * v / 4 := by
    field_simp
  unfold cutoffProfileTrial normalizedProfileTrial
  simp only [← max_div_div_right hu.le, hscale, hbase]
  rw [cutoffProfileLower_normalized eps p hu hv]

def cutoffAvailable_iff_normalized {eps : Bool} {p : ℕ} (hp : p < 2)
    (p5 p7 : ℕ) (r5 r7 : ℚ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    let a := normalizedParityFour p v ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u)
    let b := normalizedParityThree p v ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
    let delta := cutoffDelta eps p (v * u)
    cutoffAvailable (v * u) (quotaValue eps (v * u)) p (p5, r5 * u) (p7, r7 * u) ↔
      normalizedProfileValid delta v a b (normalizedProfileTrial delta v a b p p5 p7 r5 r7) := by
  dsimp only
  rw [cutoffAvailable_iff_profile hp hv]
  have htrial := cutoffProfileTrial_normalized eps p p5 p7 r5 r7 hu hv
  have he := (div_eq_iff (ne_of_gt hu)).mp htrial
  rw [he, cutoffProfileValid_normalized eps p hu hv]


end Bounty

end SubmissionComponent_TrialScaling

/- Component CandidateChoice; SHA256 3f26e35fb12df49b94cf7eb63aa2071314b6a73aa47fa0904ec45b133b93035f -/
section SubmissionComponent_CandidateChoice
/- Explicit phase and value choices made by the recursive candidate. -/

namespace Bounty

def preferred_phase_normalized {u v : ℚ} (hu : 0 < u) (hv : 1 ≤ v * u) :
    Nat.log 2 ⌊v * u⌋₊ % 2 = 1 ↔
      2 * ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ≤ v := by
  have hv0 : 0 ≤ v * u := by linarith
  have hn : 0 < ⌊v * u⌋₊ := by
    have hh : 1 ≤ ⌊v * u⌋₊ := (Nat.le_floor_iff hv0).mpr hv
    omega
  rw [log_two_odd_iff_four_threshold hn, Nat.le_floor_iff hv0]
  simp only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
  rw [← mul_div_assoc, div_le_iff₀ hu]

def cutoffCandidate_phase_one_iff (eps : Bool) (u : ℚ) (c5 c7 : ℕ × ℚ) :
    (cutoffCandidate eps u c5 c7).1 = 1 ↔
      if Nat.log 2 ⌊u⌋₊ % 2 = 1 then cutoffAvailable u (quotaValue eps u) 1 c5 c7
      else ¬cutoffAvailable u (quotaValue eps u) 0 c5 c7 := by
  by_cases hp : Nat.log 2 ⌊u⌋₊ % 2 = 1
  · by_cases ha : cutoffAvailable u (quotaValue eps u) 1 c5 c7 <;>
      simp [cutoffCandidate, hp, ha]
  · have hp0 : Nat.log 2 ⌊u⌋₊ % 2 = 0 := by omega
    by_cases ha : cutoffAvailable u (quotaValue eps u) 0 c5 c7 <;>
      simp [cutoffCandidate, hp0, ha]

def cutoffCandidate_value_profile {eps : Bool} {u : ℚ} {c5 c7 : ℕ × ℚ} (hu : 2 ≤ u)
    (ha : cutoffAvailable u (quotaValue eps u) 0 c5 c7 ∨
      cutoffAvailable u (quotaValue eps u) 1 c5 c7) :
    (cutoffCandidate eps u c5 c7).2 =
      if (cutoffCandidate eps u c5 c7).1 = 1
      then cutoffProfileTrial eps u 1 c5 c7 else cutoffProfileTrial eps u 0 c5 c7 := by
  have hp := cutoffCandidate_parity eps u c5 c7
  have hc := cutoffCandidate_available ha
  have hd := cutoffAvailable_delta_nonneg hp hu hc
  have he := cutoffTrial_eq_profile hp hu hd c5 c7
  rw [cutoffCandidate_eq_trial, he]
  by_cases hphase : (cutoffCandidate eps u c5 c7).1 = 1
  · simp only [hphase, ↓reduceIte]
  · have hzero : (cutoffCandidate eps u c5 c7).1 = 0 := by omega
    simp only [hzero, show ¬(0 : ℕ) = 1 by omega, ↓reduceIte]


end Bounty

end SubmissionComponent_CandidateChoice

/- Component NormalizedStep; SHA256 eb69d34d60eb3cf1306faf2e54db3172effdbc39537fc290f3c55a93d36bbac9 -/
section SubmissionComponent_NormalizedStep
/- The normalized state and trial predicates appearing in the closure inputs. -/

namespace Bounty

def normalizedStateValid (eps : Bool) (p : ℕ) (v a b a5 b5 r : ℚ) : Prop :=
  normalizedProfileValid (normalizedDelta eps p v a b a5 b5) v
    (normalizedParityFour p v a) (normalizedParityThree p v b) r

def normalizedTrialValue (eps : Bool) (p p5 p7 : ℕ) (v a b a5 b5 r5 r7 : ℚ) : ℚ :=
  normalizedProfileTrial (normalizedDelta eps p v a b a5 b5) v
    (normalizedParityFour p v a) (normalizedParityThree p v b) p p5 p7 r5 r7

def normalizedTrialAvailable (eps : Bool) (p p5 p7 : ℕ) (v a b a5 b5 r5 r7 : ℚ) : Prop :=
  normalizedStateValid eps p v a b a5 b5 (normalizedTrialValue eps p p5 p7 v a b a5 b5 r5 r7)

def cutoffProfileValid_iff_normalizedState (eps : Bool) (p : ℕ) {u v r : ℚ}
    (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffProfileValid eps p (v * u) (r * u) ↔
      normalizedStateValid eps p v
        ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
        ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) r := by
  rw [cutoffProfileValid_normalized eps p hu hv]
  unfold normalizedStateValid
  rw [cutoffDelta_normalized eps p hu hv]

def cutoffAvailable_iff_normalizedTrial {eps : Bool} {p : ℕ} (hp : p < 2)
    (p5 p7 : ℕ) (r5 r7 : ℚ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffAvailable (v * u) (quotaValue eps (v * u)) p (p5, r5 * u) (p7, r7 * u) ↔
      normalizedTrialAvailable eps p p5 p7 v
        ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
        ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u) r5 r7 := by
  have hh := cutoffAvailable_iff_normalized (eps := eps) hp p5 p7 r5 r7 hu hv
  dsimp only at hh
  unfold normalizedTrialAvailable normalizedStateValid normalizedTrialValue
  simpa only [cutoffDelta_normalized eps p hu hv] using hh

end Bounty

end SubmissionComponent_NormalizedStep

/- Component ClosureRootBounds; SHA256 946665fa0be10ef0d2dbbf96fcff337840818a19d06dd563fb04e426192563b7 -/
section SubmissionComponent_ClosureRootBounds
/- Uniform root and descendant bounds for the seven-step closure. -/

namespace Bounty

def closure_root_log_bounds {u : ℚ} (hu : 0x1921ee ≤ u) :
    10 ≤ Nat.log 4 ⌊u⌋₊ ∧ 13 ≤ Nat.log 3 ⌊u⌋₊ := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 0x1921ee ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hn0 : ⌊u⌋₊ ≠ 0 := by omega
  constructor
  · apply (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr
    norm_num
    omega
  · apply (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr
    norm_num
    omega

end Bounty

end SubmissionComponent_ClosureRootBounds

/- Component PowerCoordinates; SHA256 4bac70d657eb28cbe06f1080612987f6be0999d40af2c9a5d0dde1acce7ee6e5 -/
section SubmissionComponent_PowerCoordinates
/- A common two-bin coordinate for the finite normalized closure. -/

namespace Bounty

def normalizedPowerCoordinate (b : ℕ) (scale v x : ℚ) : ℚ :=
  if (b : ℚ) * scale * x ≤ v then (b : ℚ) * scale * x else scale * x

def normalizedPower_divided_coordinate {b k : ℕ} (hb : 1 < b) (hk : 0 < k)
    {u d : ℚ} (hu : 1 ≤ u) (hd : 0 < d)
    (hdlo : (b : ℚ) ^ (k - 1) < d) (hdhi : d ≤ (b : ℚ) ^ k)
    (hindex : k ≤ Nat.log b ⌊u⌋₊) :
    (b : ℚ) ^ Nat.log b ⌊u / d⌋₊ / u =
      normalizedPowerCoordinate b (1 / (b : ℚ) ^ k) (1 / d)
        ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) := by
  simpa only [normalizedPowerCoordinate, div_eq_mul_inv, one_mul, mul_one,
    mul_assoc, mul_left_comm, mul_comm] using
    divided_power_normalized hb hk hu hd hdlo hdhi hindex

def normalizedPower_multiplied_coordinate {b k : ℕ} (hb : 1 < b)
    {u d : ℚ} (hu : 1 ≤ u)
    (hdlo : (b : ℚ) ^ k ≤ d) (hdhi : d < (b : ℚ) ^ (k + 1)) :
    (b : ℚ) ^ Nat.log b ⌊d * u⌋₊ / u =
      normalizedPowerCoordinate b ((b : ℚ) ^ k) d ((b : ℚ) ^ Nat.log b ⌊u⌋₊ / u) := by
  simpa only [normalizedPowerCoordinate, pow_succ, mul_assoc, mul_left_comm, mul_comm] using
    multiplied_power_normalized_linear hb hu hdlo hdhi


end Bounty

end SubmissionComponent_PowerCoordinates

