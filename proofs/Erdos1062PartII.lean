/- Component PolicyFixedClauseData; SHA256 4d19e49c906a9c4b07ae987f5cab505e65280dc38230312979ca26ccb69c050f. -/
section PolicySubmissionPart31
/- Direct fixed-width signed-literal records, validated by the consuming checkers. -/

namespace Bounty

def policyFixedLiterals (width : Nat) : Nat → Nat → List Int
  | 0, _ => []
  | count + 1, packed =>
      let code := packed &&& ((1 <<< width) - 1)
      let lit : Int := if code % 2 = 0 then (code / 2 : Nat) else -(code / 2 : Int)
      lit :: policyFixedLiterals width count (packed >>> width)

def policyFixedClauseDatabase (width : Nat)
    (t : PackedNatTable.Table PackedNatTable.Block) (i : Nat) : List Int :=
  let b := t.get PackedNatTable.emptyBlock (i / 32)
  let first := b.start (i % 32)
  let count := b.start (i % 32 + 1) - first
  policyFixedLiterals width count (b.data >>> (width * first))

end Bounty

end PolicySubmissionPart31

