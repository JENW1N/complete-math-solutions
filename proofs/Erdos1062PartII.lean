/- Component PolicyClosedConstantCache; SHA256 1a86e0331287eb18ba40023f3aa8644583a558d8681972b439a1396ca9fdb6d3. -/
section PolicySubmissionPart42
/- Experimental constant folding for arithmetic certificates.  Cache entries
are checked against the original program.  This proves transfer of Equations,
not syntactic equality between the original and folded programs. -/
namespace PolicyClosedConstantCache
open ClosureLinear ClosureSemantics Bounty

def checkClosedRatValue (program : ℕ → Node) (fuel i : ℕ) (q : ℚ) : Bool :=
  match closedNode program fuel i with
  | none => false
  | some v => decide (v.b = false ∧ v.z = 0 ∧ v.q = q)

def checkClosedRatValue_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (fuel i : ℕ) (q : ℚ)
    (h : checkClosedRatValue program fuel i q = true) : values i = ratValue q := by
  cases hv : closedNode program fuel i with
  | none => simp [checkClosedRatValue, hv] at h
  | some v =>
    have hf : v.b = false ∧ v.z = 0 ∧ v.q = q := by
      simpa [checkClosedRatValue, hv] using h
    have hq : v = ratValue q := by
      cases v with
      | mk b z r => simp_all [ratValue]
    exact (closedNode_sound program input values he fuel i v hv).symm.trans hq

inductive Cache where
  | empty
  | branch (key fuel : ℕ) (value : ℚ) (left right : Cache)

def Cache.lookup : Cache → ℕ → Option ℚ
  | .empty, _ => none
  | .branch key _ q left right, i =>
    if i = key then some q else if i < key then left.lookup i else right.lookup i

def Cache.check (program : ℕ → Node) : Cache → Bool
  | .empty => true
  | .branch key fuel q left right =>
    checkClosedRatValue program fuel key q && (left.check program && right.check program)

def Cache.lookup_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (cache : Cache)
    (hc : cache.check program = true) (i : ℕ) (q : ℚ)
    (hl : cache.lookup i = some q) : values i = ratValue q := by
  induction cache generalizing i q with
  | empty => simp [lookup] at hl
  | branch key fuel value left right ihl ihr =>
    have hh : checkClosedRatValue program fuel key value = true ∧
        left.check program = true ∧ right.check program = true := by
      simpa only [check, Bool.and_eq_true] using hc
    by_cases hi : i = key
    · subst i
      have hq : value = q := by simpa [lookup] using hl
      subst q
      exact checkClosedRatValue_sound program input values he fuel key value hh.1
    · by_cases hlt : i < key
      · exact ihl hh.2.1 i q (by simpa [lookup, hi, hlt] using hl)
      · exact ihr hh.2.2 i q (by simpa [lookup, hi, hlt] using hl)

def aliasOp : Op → Bool
  | .alias => true
  | _ => false

def foldedProgram (program : ℕ → Node) (cache : Cache) (i : ℕ) : Node :=
  if aliasOp (program i).op then
    match cache.lookup i with
    | some q => ⟨.qConst q, []⟩
    | none => program i
  else program i

def foldedProgram_equations (program : ℕ → Node) (cache : Cache)
    (input values : Valuation) (he : Equations program input values)
    (hc : cache.check program = true) :
    Equations (foldedProgram program cache) input values := by
  intro i
  unfold foldedProgram
  split
  next =>
    cases hl : cache.lookup i with
    | none => simpa only [hl] using he i
    | some q =>
      have hv := Cache.lookup_sound program input values he cache hc i q hl
      simpa only [hl, evalNode, evalOp, List.map_nil] using hv
  next => exact he i

end PolicyClosedConstantCache

end PolicySubmissionPart42

