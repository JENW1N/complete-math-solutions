      48 * integerIndexSeries 4 (fun k => (jumpVisit4 r 1 (k - 1) : ℝ)) := by
  have hs (i : Fin 4) (k : ℤ) :=
    (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 4)
