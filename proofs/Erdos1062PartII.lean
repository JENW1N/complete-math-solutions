/- Component ClosureActualRules; SHA256 5f343a1defcd4fbfac1fdfde11ebdff5da92ee787c4d7374fdce3cab02466780 -/
section SubmissionComponent_ClosureActualRules
/- The recursive states obey the phase, value, and leaf rules of the finite model. -/

namespace Bounty

def closureActual_phase_rule {eps : Bool} {u : ℚ} (hu : 0x1921ee ≤ u)
    {k : ℕ} (hk : k < 28) :
    closureActualPhase eps u k ↔
      if 2 * closureNodeFour k (closureRootFour u) ≤ (closureNode k).v then
        closureNodeAvailable eps k 1 (closureRootFour u) (closureRootThree u)
          (closureActualPhase eps u) (closureActualValue eps u)
      else ¬closureNodeAvailable eps k 0 (closureRootFour u) (closureRootThree u)
          (closureActualPhase eps u) (closureActualValue eps u) := by
  have hk36 : k < 36 := by omega
  have hv := (closureNode_v_bounds hu hk36).2.2
  change (cutoffState (closureNodeType eps k) ((closureNode k).v * u)).1 = 1 ↔ _
  rw [cutoffState_of_large (by linarith : 1 ≤ (closureNode k).v * u), cutoffCandidate_phase_one_iff]
  simp only [preferred_phase_normalized (by linarith : 0 < u) (by linarith : 1 ≤ (closureNode k).v * u),
    closureNodeFour_coordinate hu hk36, closureActual_available hu hk (by norm_num : 0 < 2),
    closureActual_available hu hk (by norm_num : 1 < 2), closureRootFour]
  rfl

def closureActual_value_rule {eps : Bool} {u : ℚ} (hu : 0x1921ee ≤ u)
    {k : ℕ} (hk : k < 28)
    (ha : cutoffAvailable ((closureNode k).v * u) (quotaValue (closureNodeType eps k) ((closureNode k).v * u))
        0 (cutoffState true ((closureNode k).v * u / 5))
        (cutoffState (closureNodeType eps k) ((closureNode k).v * u / 7)) ∨
      cutoffAvailable ((closureNode k).v * u) (quotaValue (closureNodeType eps k) ((closureNode k).v * u))
        1 (cutoffState true ((closureNode k).v * u / 5))
        (cutoffState (closureNodeType eps k) ((closureNode k).v * u / 7))) :
    closureActualValue eps u k = if (closureActualState eps u k).1 = 1 then
        closureNodeTrial eps k 1 (closureRootFour u) (closureRootThree u)
          (closureActualPhase eps u) (closureActualValue eps u)
      else closureNodeTrial eps k 0 (closureRootFour u) (closureRootThree u)
          (closureActualPhase eps u) (closureActualValue eps u) := by
  have hv := (closureNode_v_bounds hu (show k < 36 by omega)).2.2
  simp only [closureActual_trial hu hk, closureActualValue, closureActualState,
    cutoffState_of_large (by linarith : 1 ≤ (closureNode k).v * u)]
  have hh := congrArg (fun r : ℚ => r / u) (cutoffCandidate_value_profile hv ha)
  split_ifs at hh ⊢ <;> exact hh

def closureActual_valid {eps : Bool} {u : ℚ} (hu : 0x1921ee ≤ u)
    {k : ℕ} (hk : k < 36)
    (ha : cutoffAvailable ((closureNode k).v * u) (quotaValue (closureNodeType eps k) ((closureNode k).v * u))
        0 (cutoffState true ((closureNode k).v * u / 5))
        (cutoffState (closureNodeType eps k) ((closureNode k).v * u / 7)) ∨
      cutoffAvailable ((closureNode k).v * u) (quotaValue (closureNodeType eps k) ((closureNode k).v * u))
        1 (cutoffState true ((closureNode k).v * u / 5))
        (cutoffState (closureNodeType eps k) ((closureNode k).v * u / 7))) :
    normalizedStateValid (closureNodeType eps k) (closureActualState eps u k).1 (closureNode k).v
      (closureNodeFour k (closureRootFour u)) (closureNodeThree k (closureRootThree u))
      (closureLossFour k (closureRootFour u)) (closureLossThree k (closureRootThree u))
      (closureActualValue eps u k) := by
  have hh := cutoffState_normalized_profile_of_local (by linarith : 0 < u)
    (closureNode_v_bounds hu hk).2.2 ha
  rw [closureNodeFour_coordinate hu hk, closureNodeThree_coordinate hu hk,
    closureLossFour_coordinate hu hk, closureLossThree_coordinate hu hk] at hh
  exact hh


