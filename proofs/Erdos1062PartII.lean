/- Component ClosureInputNormalization; SHA256 b800ebbc61da502ecbc26db0dc08d07df642e49a4410f2421c92966d5572b8c5 -/
section SubmissionComponent_ClosureInputNormalization
/- Normal forms shared by the mathematical definitions and finite inputs. -/

namespace Bounty

def closureGamma_zero (P : Prop) [Decidable P] (r : ℚ) :
    (if (0 : ℕ) = closurePhase P then 4 else 6) * r =
      if (P ↔ False) then 4 * r else 6 * r := by
  classical
  by_cases hp : P <;> simp [closurePhase, hp]

def closureGamma_one (P : Prop) [Decidable P] (r : ℚ) :
    (if (1 : ℕ) = closurePhase P then 4 else 6) * r =
      if (P ↔ True) then 4 * r else 6 * r := by
  classical
  by_cases hp : P <;> simp [closurePhase, hp]

def closureIndicator_cast (P : Prop) [Decidable P] :
    Int.ofNat (if P then (1 : ℕ) else 0) = if P then (1 : ℤ) else 0 := by
  by_cases hp : P <;> simp [hp]

def closureIndicator_natCast (P : Prop) [Decidable P] :
    (Nat.cast (if P then (1 : ℕ) else 0) : ℤ) = if P then (1 : ℤ) else 0 := by
  exact closureIndicator_cast P

def closureCap_simplify (P : Prop) [Decidable P] (r v m : ℚ) :
    (if P then r ≤ (if P then v else m) else r < (if P then v else m)) ↔
      if P then r ≤ v else r < m := by
  by_cases hp : P <;> simp [hp]

def normalizedProfileTrial_left (delta : ℤ) (v a b : ℚ)
    (p p5 p7 : ℕ) (r5 r7 : ℚ) :
    normalizedProfileTrial delta v a b p p5 p7 r5 r7 =
      max (max (max (3 * v / 4) (normalizedProfileLower delta a b))
        ((if p = p5 then 4 else 6) * r5)) ((if p = p7 then 4 else 6) * r7) := by
  unfold normalizedProfileTrial
  simp only [max_assoc]


end Bounty

