      apply Option.some.inj
      simpa only [hanchor i, if_neg hz] using ha
    exact he.symm.trans ((hsemantic (indices i - 1) hh.1).trans
      (checkBody_sound raw input env anchor indices hanchor fuel _ i hh.2))

