/- Component RotationCoordinates; SHA256 bb14d9b4e9c7f15bc4de45a15f4bf825227d09e227fe6d712753d8e9e24dd136 -/
section SubmissionComponent_RotationCoordinates
/- Relate the arithmetic coefficient indices to rotations by logarithmic ratios. -/

namespace Bounty

noncomputable def rotationSlope : ℝ := Real.log 4 / Real.log 3

def rotationSlope_irrational : Irrational rotationSlope :=
  irrational_log_four_div_log_three

def rotationSlope_bounds : 1 < rotationSlope ∧ rotationSlope < 2 := by
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hlo : Real.log 3 < Real.log 4 := Real.log_lt_log (by norm_num) (by norm_num)
  have hhi : Real.log 4 < 2 * Real.log 3 := by
    have hh := Real.log_lt_log (by norm_num : (0 : ℝ) < 4) (by norm_num : (4 : ℝ) < 3 ^ 2)
    simpa only [Real.log_pow, Nat.cast_ofNat] using hh
  constructor
  · exact (lt_div_iff₀ h3).mpr (by simpa only [one_mul] using hlo)
  · exact (div_lt_iff₀ h3).mpr hhi

def inverse_rotationSlope : Real.logb 4 3 = 1 / rotationSlope := by
  unfold Real.logb rotationSlope
  simp only [one_div_div]

def logb_nat_floor_int (a b : ℕ) :
    ⌊Real.logb (b : ℝ) (a : ℝ)⌋ = (Nat.log b a : ℤ) := by
  rw [Real.floor_logb_natCast (Nat.cast_nonneg a), Int.log_natCast]

def normalized_power_eq_rotation {a b : ℕ} (ha : 0 < a) (hb : 1 < b) (n : ℕ) :
    ((a : ℝ) ^ n / (b : ℝ) ^ Nat.log b (a ^ n)) =
      (b : ℝ) ^ Int.fract ((n : ℝ) * Real.logb (b : ℝ) (a : ℝ)) := by
  have hbpos : (0 : ℝ) < b := by exact_mod_cast (by omega : 0 < b)
  have hbne : (b : ℝ) ≠ 1 := by exact_mod_cast (by omega : b ≠ 1)
  have hapos : (0 : ℝ) < (a ^ n : ℕ) := by exact_mod_cast (pow_pos ha n)
  have hl : Real.logb (b : ℝ) ((a ^ n : ℕ) : ℝ) =
      (n : ℝ) * Real.logb (b : ℝ) (a : ℝ) := by
    rw [Nat.cast_pow, Real.logb_pow]
  rw [← hl, Int.fract, logb_nat_floor_int, Int.cast_natCast,
    Real.rpow_sub hbpos, Real.rpow_logb hbpos hbne hapos, Real.rpow_natCast, Nat.cast_pow]

def normalized_four_eq_rotation (n : ℕ) :
    ((4 : ℝ) ^ n / (3 : ℝ) ^ Nat.log 3 (4 ^ n)) =
      (3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope) := by
  simpa only [Real.logb, rotationSlope, Nat.cast_ofNat] using
    normalized_power_eq_rotation (by norm_num : 0 < 4) (by norm_num : 1 < 3) n

def normalized_three_eq_rotation (n : ℕ) :
    ((3 : ℝ) ^ n / (4 : ℝ) ^ Nat.log 4 (3 ^ n)) =
      (4 : ℝ) ^ Int.fract ((n : ℝ) / rotationSlope) := by
  have hh := normalized_power_eq_rotation (by norm_num : 0 < 3) (by norm_num : 1 < 4) n
  norm_num only [Nat.cast_ofNat] at hh
  simpa only [inverse_rotationSlope, mul_one_div] using hh


end Bounty

end SubmissionComponent_RotationCoordinates

/- Component RotationCoding; SHA256 4d8017c476b97ac216f94bbc4e6e3a01643c1db5f5115a56b3baddea23d6f217 -/
section SubmissionComponent_RotationCoding
/- The two integer coefficient sequences are exact codings of irrational rotations. -/

namespace Bounty

noncomputable def realCoefficient4 (x : ℝ) : ℤ := by
  classical
  exact if 15 * x < 16 then 78
    else if 9 * x < 10 then 30
    else if 3 * x < 4 then -30
    else if 2 * x < 3 then 30
    else if x < 2 then 0
    else if 3 * x < 8 then -60
    else -12

noncomputable def realCoefficient3 (x : ℝ) : ℤ := by
  classical
  exact if 3 * x < 4 then 30
    else if 5 * x < 8 then 35
    else if 3 * x < 5 then 29
    else if x < 2 then 24
    else -60

def scaled_nat_ratio_lt {x y : ℕ} (hy : 0 < y) (a c : ℕ) :
    (a : ℝ) * ((x : ℝ) / (y : ℝ)) < (c : ℝ) ↔ a * x < c * y := by
  rw [← mul_div_assoc, div_lt_iff₀ (by exact_mod_cast hy : (0 : ℝ) < y)]
  norm_cast

def realCoefficient4_normalized (n : ℕ) :
    realCoefficient4 ((4 : ℝ) ^ n / (3 : ℝ) ^ Nat.log 3 (4 ^ n)) = coefficient4 n := by
  have hh (p q : ℕ) :
      (p : ℝ) * ((4 : ℝ) ^ n / (3 : ℝ) ^ Nat.log 3 (4 ^ n)) < (q : ℝ) ↔
        p * 4 ^ n < q * 3 ^ Nat.log 3 (4 ^ n) := by
    simpa only [Nat.cast_pow, Nat.cast_ofNat] using
      scaled_nat_ratio_lt (x := 4 ^ n) (by positivity : 0 < (3 : ℕ) ^ Nat.log 3 (4 ^ n)) p q
  have h15 := hh 15 16
  have h9 := hh 9 10
  have h3 := hh 3 4
  have h2 := hh 2 3
  have h1 := hh 1 2
  have h8 := hh 3 8
  norm_num only [Nat.cast_ofNat, Nat.cast_one, one_mul] at h15 h9 h3 h2 h1 h8
  simp only [realCoefficient4, coefficient4, h15, h9, h3, h2, h1, h8]

def realCoefficient3_normalized (n : ℕ) :
    realCoefficient3 ((3 : ℝ) ^ n / (4 : ℝ) ^ Nat.log 4 (3 ^ n)) = coefficient3 n := by
  have hh (p q : ℕ) :
      (p : ℝ) * ((3 : ℝ) ^ n / (4 : ℝ) ^ Nat.log 4 (3 ^ n)) < (q : ℝ) ↔
        p * 3 ^ n < q * 4 ^ Nat.log 4 (3 ^ n) := by
    simpa only [Nat.cast_pow, Nat.cast_ofNat] using
      scaled_nat_ratio_lt (x := 3 ^ n) (by positivity : 0 < (4 : ℕ) ^ Nat.log 4 (3 ^ n)) p q
  have h3 := hh 3 4
  have h5 := hh 5 8
  have h35 := hh 3 5
  have h1 := hh 1 2
  norm_num only [Nat.cast_ofNat, Nat.cast_one, one_mul] at h3 h5 h35 h1
  simp only [realCoefficient3, coefficient3, h3, h5, h35, h1]

def coefficient4_rotation (n : ℕ) :
    coefficient4 n = realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope)) := by
  rw [← realCoefficient4_normalized, normalized_four_eq_rotation]

def coefficient3_rotation (n : ℕ) :
    coefficient3 n = realCoefficient3 ((4 : ℝ) ^ Int.fract ((n : ℝ) / rotationSlope)) := by
  rw [← realCoefficient3_normalized, normalized_three_eq_rotation]


end Bounty

end SubmissionComponent_RotationCoding

/- Component RotationSeparation; SHA256 2fd960aca7b09d88db238c99cd09b06192600196e4b83ac2be0b8ce7f9bf7f51 -/
section SubmissionComponent_RotationSeparation
/- A direct determinant proof of the separation bound between consecutive rational returns. -/

namespace Bounty

def return_pair_best_approximation {α : ℝ} {p P : ℤ} {q Q n : ℕ} (k : ℤ)
    (hq : 0 < q) (hn : 0 < n) (hnQ : n < Q)
    (hdet : (q : ℤ) * P - p * Q = 1)
    (hd : 0 < (q : ℝ) * α - p) (hd' : 0 < (P : ℝ) - Q * α) :
    (q : ℝ) * α - p ≤ |(n : ℝ) * α - k| := by
  let a : ℤ := P * n - Q * k
  let b : ℤ := q * k - p * n
  have hlin : a * q + b * Q = n := by
    dsimp [a, b]
    calc
      (P * n - Q * k) * q + (q * k - p * n) * Q =
        ((q : ℤ) * P - p * Q) * n := by ring
      _ = n := by rw [hdet, one_mul]
  have hdetR : (q : ℝ) * P - p * Q = 1 := by exact_mod_cast hdet
  have herr : (a : ℝ) * ((q : ℝ) * α - p) -
      (b : ℝ) * ((P : ℝ) - Q * α) = (n : ℝ) * α - k := by
    dsimp [a, b]
    push_cast
    calc
      ((P : ℝ) * n - Q * k) * ((q : ℝ) * α - p) -
          ((q : ℝ) * k - p * n) * ((P : ℝ) - Q * α) =
        ((q : ℝ) * P - p * Q) * ((n : ℝ) * α - k) := by ring
      _ = (n : ℝ) * α - k := by rw [hdetR, one_mul]
  have hqZ : (0 : ℤ) < q := by exact_mod_cast hq
  have hnZ : (0 : ℤ) < n := by exact_mod_cast hn
  have hQZ : (0 : ℤ) < Q := by exact_mod_cast (by omega : 0 < Q)
  have hnQZ : (n : ℤ) < Q := by exact_mod_cast hnQ
  by_cases hb : b ≤ 0
  · have ha : 1 ≤ a := by
      by_contra hh
      have han : a ≤ 0 := by omega
      have h1 := mul_nonpos_of_nonpos_of_nonneg han hqZ.le
      have h2 := mul_nonpos_of_nonpos_of_nonneg hb hQZ.le
      omega
    have haR : (1 : ℝ) ≤ a := by exact_mod_cast ha
    have hbR : (b : ℝ) ≤ 0 := by exact_mod_cast hb
    have h1 := mul_le_mul_of_nonneg_right haR hd.le
    have h2 := mul_nonpos_of_nonpos_of_nonneg hbR hd'.le
    have habs := le_abs_self ((n : ℝ) * α - k)
    nlinarith
  · have hbpos : 1 ≤ b := by omega
    have ha : a ≤ -1 := by
      by_contra hh
      have han : 0 ≤ a := by omega
      have h1 := mul_nonneg han hqZ.le
      have h2 := mul_le_mul_of_nonneg_right hbpos hQZ.le
      nlinarith
    have haR : (a : ℝ) ≤ -1 := by exact_mod_cast ha
    have hbR : (0 : ℝ) ≤ b := by exact_mod_cast (by omega : 0 ≤ b)
    have h1 := mul_le_mul_of_nonneg_right haR hd.le
    have h2 := mul_nonneg hbR hd'.le
    have habs := neg_le_abs ((n : ℝ) * α - k)
    nlinarith

def return_pair_error_identity {α : ℝ} {p P : ℤ} {q Q : ℕ}
    (hdet : (q : ℤ) * P - p * Q = 1) :
    (Q : ℝ) * ((q : ℝ) * α - p) + (q : ℝ) * ((P : ℝ) - Q * α) = 1 := by
  have hh : (q : ℝ) * P - p * Q = 1 := by exact_mod_cast hdet
  nlinarith

def return_pair_positive_error_bound {α : ℝ} {p P : ℤ} {q Q : ℕ}
    (hq : 0 < q) (hQ : 0 < Q) (hdet : (q : ℤ) * P - p * Q = 1)
    (hd' : 0 < (P : ℝ) - Q * α) :
    (q : ℝ) * α - p < 1 / (Q : ℝ) := by
  have hqr : (0 : ℝ) < q := by exact_mod_cast hq
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  have hpos := mul_pos hqr hd'
  have hh := return_pair_error_identity (α := α) hdet
  apply (lt_div_iff₀ hQr).mpr
  nlinarith

end Bounty

end SubmissionComponent_RotationSeparation

/- Component RotationCoverage; SHA256 595f3ad4399bb6edbaaedadaf630f093208ec2c88ba9c472f0a1136a19bd916a -/
section SubmissionComponent_RotationCoverage
/- A finite-minimum proof that every short rotation arc is visited in a bounded block. -/

namespace Bounty

def fract_sub_small {x d : ℝ} (hd : 0 < d) (hxd : d ≤ Int.fract x) :
    Int.fract (x - d) = Int.fract x - d := by
  have he : x - d = (Int.fract x - d) + (⌊x⌋ : ℝ) := by
    rw [Int.fract]
    ring
  rw [he, Int.fract_add_intCast]
  exact Int.fract_eq_self.mpr ⟨by linarith, by linarith [Int.fract_lt_one x]⟩

def return_pair_arc_covered {α : ℝ} {p P : ℤ} {q Q : ℕ}
    (hq : 0 < q) (hQ : 0 < Q)
    (hd : 0 < (q : ℝ) * α - p) (hd' : 0 < (P : ℝ) - Q * α)
    (hle : (P : ℝ) - Q * α ≤ (q : ℝ) * α - p) (t : ℝ) :
    ∃ j : ℕ, j < q + Q ∧ Int.fract ((j : ℝ) * α - t) < (q : ℝ) * α - p := by
  let f : ℕ → ℝ := fun j => Int.fract ((j : ℝ) * α - t)
  have hne : (Finset.range (q + Q)).Nonempty := ⟨0, Finset.mem_range.mpr (by omega)⟩
  obtain ⟨j, hj, hmin⟩ := Finset.exists_min_image (Finset.range (q + Q)) f hne
  have hjlt := Finset.mem_range.mp hj
  refine ⟨j, hjlt, ?_⟩
  by_contra hh
  have hdf : (q : ℝ) * α - p ≤ f j := le_of_not_gt hh
  by_cases hqj : q ≤ j
  · have hk : j - q < q + Q := by omega
    have hmin' := hmin (j - q) (Finset.mem_range.mpr hk)
    have he : ((j - q : ℕ) : ℝ) * α - t =
        (((j : ℝ) * α - t) - ((q : ℝ) * α - p)) - p := by
      rw [Nat.cast_sub hqj]
      ring
    have hf : f (j - q) = f j - ((q : ℝ) * α - p) := by
      dsimp only [f]
      rw [he, Int.fract_sub_intCast, fract_sub_small hd hdf]
    rw [hf] at hmin'
    linarith
  · have hk : j + Q < q + Q := by omega
    have hmin' := hmin (j + Q) (Finset.mem_range.mpr hk)
    have he : ((j + Q : ℕ) : ℝ) * α - t =
        (((j : ℝ) * α - t) - ((P : ℝ) - Q * α)) + P := by
      push_cast
      ring
    have hf : f (j + Q) = f j - ((P : ℝ) - Q * α) := by
      dsimp only [f]
      rw [he, Int.fract_add_intCast, fract_sub_small hd' (hle.trans hdf)]
    rw [hf] at hmin'
    linarith

def return_pair_arc_covered_block {α : ℝ} {p P : ℤ} {q Q : ℕ}
    (hq : 0 < q) (hQ : 0 < Q)
    (hd : 0 < (q : ℝ) * α - p) (hd' : 0 < (P : ℝ) - Q * α)
    (hle : (P : ℝ) - Q * α ≤ (q : ℝ) * α - p) (t : ℝ) (N : ℕ) :
    ∃ j : ℕ, N ≤ j ∧ j < N + q + Q ∧
      Int.fract ((j : ℝ) * α - t) < (q : ℝ) * α - p := by
  obtain ⟨k, hk, hh⟩ := return_pair_arc_covered hq hQ hd hd' hle (t - (N : ℝ) * α)
  refine ⟨N + k, by omega, by omega, ?_⟩
  have he : ((N + k : ℕ) : ℝ) * α - t = (k : ℝ) * α - (t - (N : ℝ) * α) := by
    push_cast
    ring
  rwa [he]


end Bounty

end SubmissionComponent_RotationCoverage

/- Component ReturnBrackets; SHA256 e10f3ceb601dc46ec297fbea9fe9ca635b94cbd86e990c27a4f4f070c076895d -/
section SubmissionComponent_ReturnBrackets
/- Unbounded unimodular return pairs, constructed directly by mediants. -/

namespace Bounty

def irrational_nat_mul_ne_int {α : ℝ} (hα : Irrational α)
    {q : ℕ} (hq : 0 < q) (p : ℤ) : (q : ℝ) * α ≠ p := by
  intro he
  apply hα.ne_rational p (q : ℤ)
  have hqr : (q : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hq)
  rw [Int.cast_natCast, eq_div_iff hqr]
  nlinarith

def positive_remainder_exists {x y : ℝ} (hy : 0 < y) (hxy : y < x)
    (hne : ∀ k : ℕ, x ≠ (k : ℝ) * y) :
    ∃ k : ℕ, 0 < k ∧ 0 < x - (k : ℝ) * y ∧ x - (k : ℝ) * y < y := by
  let k : ℕ := ⌊x / y⌋₊
  have hratio : 1 < x / y := (lt_div_iff₀ hy).mpr (by simpa using hxy)
  have hk : 0 < k := Nat.floor_pos.mpr hratio.le
  have hlo : (k : ℝ) * y ≤ x := (le_div_iff₀ hy).mp (Nat.floor_le (by linarith))
  have hhi : x < ((k : ℝ) + 1) * y :=
    (div_lt_iff₀ hy).mp (Nat.lt_floor_add_one (x / y))
  refine ⟨k, hk, ?_, by nlinarith⟩
  have hne' := hne k
  have hlt : (k : ℝ) * y < x := lt_of_le_of_ne hlo (Ne.symm hne')
  linarith

structure ReturnBracket (α : ℝ) where
  p : ℤ
  P : ℤ
  q : ℕ
  Q : ℕ
  q_pos : 0 < q
  Q_pos : 0 < Q
  q_le_Q : q ≤ Q
  determinant : (q : ℤ) * P - p * Q = 1
  lower_pos : 0 < (q : ℝ) * α - p
  upper_pos : 0 < (P : ℝ) - Q * α
  upper_lt_lower : (P : ℝ) - Q * α < (q : ℝ) * α - p

def ReturnBracket.next_exists {α : ℝ} (hα : Irrational α) (s : ReturnBracket α) :
    ∃ t : ReturnBracket α, s.q < t.q ∧ s.Q < t.Q := by
  have hsq := s.q_pos
  have hsQ := s.Q_pos
  let d : ℝ := (s.q : ℝ) * α - s.p
  let e : ℝ := (s.P : ℝ) - s.Q * α
  have hd : 0 < d := s.lower_pos
  have he : 0 < e := s.upper_pos
  have hed : e < d := s.upper_lt_lower
  have hne : ∀ k : ℕ, d ≠ (k : ℝ) * e := by
    intro k hh
    have hq : 0 < s.q + k * s.Q := by omega
    apply irrational_nat_mul_ne_int hα hq (s.p + (k : ℤ) * s.P)
    dsimp [d, e] at hh
    push_cast
    nlinarith
  obtain ⟨a, ha, hda, hdae⟩ := positive_remainder_exists he hed hne
  let p' : ℤ := s.p + (a : ℤ) * s.P
  let q' : ℕ := s.q + a * s.Q
  let d' : ℝ := (q' : ℝ) * α - p'
  have hd'eq : d' = d - (a : ℝ) * e := by
    dsimp [d', q', p', d, e]
    push_cast
    ring
  have hd' : 0 < d' := hd'eq ▸ hda
  have hd'e : d' < e := hd'eq ▸ hdae
  have hq' : 0 < q' := by dsimp [q']; omega
  have hne' : ∀ k : ℕ, e ≠ (k : ℝ) * d' := by
    intro k hh
    have hQ : 0 < s.Q + k * q' := by omega
    apply irrational_nat_mul_ne_int hα hQ (s.P + (k : ℤ) * p')
    dsimp [e, d'] at hh
    push_cast
    nlinarith
  obtain ⟨b, hb, heb, hebd⟩ := positive_remainder_exists hd' hd'e hne'
  let P' : ℤ := s.P + (b : ℤ) * p'
  let Q' : ℕ := s.Q + b * q'
  have hQ' : 0 < Q' := by dsimp [Q']; omega
  have hqQ' : q' ≤ Q' := by
    have hh : q' ≤ b * q' := by nlinarith
    dsimp [Q']
    omega
  have hdet' : (q' : ℤ) * s.P - p' * s.Q = 1 := by
    dsimp [q', p']
    push_cast
    nlinarith [s.determinant]
  have hdet'' : (q' : ℤ) * P' - p' * Q' = 1 := by
    dsimp [P', Q']
    push_cast
    nlinarith [hdet']
  have he'eq : (P' : ℝ) - Q' * α = e - (b : ℝ) * d' := by
    dsimp [P', Q', e, d']
    push_cast
    ring
  let t : ReturnBracket α :=
    { p := p', P := P', q := q', Q := Q',
      q_pos := hq', Q_pos := hQ', q_le_Q := hqQ', determinant := hdet'',
      lower_pos := hd', upper_pos := he'eq ▸ heb,
      upper_lt_lower := he'eq ▸ hebd }
  refine ⟨t, ?_, ?_⟩
  · change s.q < q'
    have hh : 0 < a * s.Q := Nat.mul_pos ha s.Q_pos
    dsimp [q']
    omega
  · change s.Q < Q'
    have hh : 0 < b * q' := Nat.mul_pos hb hq'
    dsimp [Q']
    omega

def returnBracket_nonempty {α : ℝ} (hα : Irrational α) (hlo : 1 < α)
    (hhi : α < 2) : Nonempty (ReturnBracket α) := by
  let d : ℝ := α - 1
  let e : ℝ := 2 - α
  have hd : 0 < d := by dsimp [d]; linarith
  have he : 0 < e := by dsimp [e]; linarith
  have hne : e ≠ d := by
    intro hh
    apply hα.ne_rational 3 2
    dsimp [e, d] at hh
    norm_num
    linarith
  by_cases hed : e < d
  · exact ⟨{ p := 1, P := 2, q := 1, Q := 1,
             q_pos := by norm_num, Q_pos := by norm_num, q_le_Q := le_rfl,
             determinant := by norm_num,
             lower_pos := by simpa [d] using hd,
             upper_pos := by simpa [e] using he,
             upper_lt_lower := by simpa [d, e] using hed }⟩
  · have hde : d < e := lt_of_le_of_ne (le_of_not_gt hed) (Ne.symm hne)
    have hmultiple : ∀ k : ℕ, e ≠ (k : ℝ) * d := by
      intro k hh
      apply irrational_nat_mul_ne_int hα (Nat.succ_pos k) (2 + k)
      dsimp [e, d] at hh
      push_cast
      nlinarith
    obtain ⟨k, hk, hrem, hremd⟩ := positive_remainder_exists hd hde hmultiple
    have herr : ((2 + (k : ℤ) : ℤ) : ℝ) - (1 + k : ℕ) * α = e - (k : ℝ) * d := by
      dsimp [e, d]
      push_cast
      ring
    exact ⟨{ p := 1, P := 2 + k, q := 1, Q := 1 + k,
             q_pos := by norm_num, Q_pos := by omega, q_le_Q := by omega,
             determinant := by push_cast; ring,
             lower_pos := by simpa [d] using hd,
             upper_pos := herr ▸ hrem,
             upper_lt_lower := by simpa only [Nat.cast_one, Int.cast_one, one_mul] using
               (show ((2 + (k : ℤ) : ℤ) : ℝ) - (1 + k : ℕ) * α < d from herr ▸ hremd) }⟩


end Bounty

end SubmissionComponent_ReturnBrackets

/- Component ReturnSequence; SHA256 2f8dc55053bcb6273e6119c6de833d275fc60d98d6478c0535d74adfed32421c -/
section SubmissionComponent_ReturnSequence
/- A sequence of return pairs with diverging denominators and vanishing errors. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def returnBracketNext {α : ℝ} (hα : Irrational α)
    (s : ReturnBracket α) : ReturnBracket α := Classical.choose (s.next_exists hα)

def returnBracketNext_growth {α : ℝ} (hα : Irrational α) (s : ReturnBracket α) :
    s.q < (returnBracketNext hα s).q ∧ s.Q < (returnBracketNext hα s).Q :=
  Classical.choose_spec (s.next_exists hα)

noncomputable def returnBracketSequence {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) : ℕ → ReturnBracket α
  | 0 => Classical.choice (returnBracket_nonempty hα hlo hhi)
  | n + 1 => returnBracketNext hα (returnBracketSequence hα hlo hhi n)

def returnBracketSequence_growth {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) (n : ℕ) :
    (returnBracketSequence hα hlo hhi n).q < (returnBracketSequence hα hlo hhi (n + 1)).q ∧
    (returnBracketSequence hα hlo hhi n).Q < (returnBracketSequence hα hlo hhi (n + 1)).Q :=
  returnBracketNext_growth hα (returnBracketSequence hα hlo hhi n)

def returnBracketSequence_lower_bound {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) (n : ℕ) :
    n + 1 ≤ (returnBracketSequence hα hlo hhi n).q ∧
    n + 1 ≤ (returnBracketSequence hα hlo hhi n).Q := by
  induction n with
  | zero =>
    have hh := (returnBracketSequence hα hlo hhi 0).q_pos
    have hh' := (returnBracketSequence hα hlo hhi 0).Q_pos
    omega
  | succ n ih =>
    have hh := returnBracketSequence_growth hα hlo hhi n
    omega

def returnBracketSequence_q_tendsto {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) :
    Tendsto (fun n => (returnBracketSequence hα hlo hhi n).q) atTop atTop := by
  refine tendsto_atTop.2 (fun N => ?_)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hh := (returnBracketSequence_lower_bound hα hlo hhi n).1
  omega

def returnBracketSequence_Q_tendsto {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) :
    Tendsto (fun n => (returnBracketSequence hα hlo hhi n).Q) atTop atTop := by
  refine tendsto_atTop.2 (fun N => ?_)
  filter_upwards [eventually_ge_atTop N] with n hn
  have hh := (returnBracketSequence_lower_bound hα hlo hhi n).2
  omega

def ReturnBracket.lower_error_lt {α : ℝ} (s : ReturnBracket α) :
    (s.q : ℝ) * α - s.p < 1 / (s.Q : ℝ) :=
  return_pair_positive_error_bound s.q_pos s.Q_pos s.determinant s.upper_pos

def ReturnBracket.lower_error_lt_one {α : ℝ} (s : ReturnBracket α) :
    (s.q : ℝ) * α - s.p < 1 := by
  have hQ : (1 : ℝ) ≤ s.Q := by exact_mod_cast s.Q_pos
  have hh : 1 / (s.Q : ℝ) ≤ 1 := by
    apply (div_le_iff₀ (by linarith : (0 : ℝ) < s.Q)).mpr
    nlinarith
  exact s.lower_error_lt.trans_le hh

def ReturnBracket.numerator_bounds {α : ℝ} (s : ReturnBracket α)
    (hlo : 1 < α) (hhi : α < 2) :
    (s.q : ℤ) ≤ s.p ∧ s.p < 2 * s.q ∧
    (s.Q : ℤ) < s.P ∧ s.P ≤ 2 * s.Q ∧ s.p < s.P := by
  have hq : (0 : ℝ) < s.q := by exact_mod_cast s.q_pos
  have hQ : (0 : ℝ) < s.Q := by exact_mod_cast s.Q_pos
  have hd := s.lower_pos
  have he := s.upper_pos
  have he_lt := s.upper_lt_lower
  have hd_one := s.lower_error_lt_one
  have hqlo : (s.q : ℝ) < s.q * α := by nlinarith
  have hqhi : (s.q : ℝ) * α < 2 * s.q := by nlinarith
  have hQlo : (s.Q : ℝ) < s.Q * α := by nlinarith
  have hQhi : (s.Q : ℝ) * α < 2 * s.Q := by nlinarith
  have hp : (s.q : ℤ) ≤ s.p := by
    by_contra hh
    have hhZ : s.p + 1 ≤ (s.q : ℤ) := by omega
    have hhR : (s.p : ℝ) + 1 ≤ s.q := by exact_mod_cast hhZ
    linarith
  have hp' : s.p < 2 * s.q := by
    have hh : (s.p : ℝ) < 2 * s.q := by linarith
    exact_mod_cast hh
  have hP : (s.Q : ℤ) < s.P := by
    have hh : (s.Q : ℝ) < s.P := by linarith
    exact_mod_cast hh
  have hP' : s.P ≤ 2 * s.Q := by
    by_contra hh
    have hhZ : 2 * (s.Q : ℤ) + 1 ≤ s.P := by omega
    have hhR : 2 * (s.Q : ℝ) + 1 ≤ s.P := by exact_mod_cast hhZ
    linarith
  have hqQ : (s.q : ℝ) ≤ s.Q := by exact_mod_cast s.q_le_Q
  have hpP : s.p < s.P := by
    have hh : (s.p : ℝ) < s.P := by nlinarith
    exact_mod_cast hh
  exact ⟨hp, hp', hP, hP', hpP⟩

def returnBracketSequence_error_tendsto {α : ℝ} (hα : Irrational α)
    (hlo : 1 < α) (hhi : α < 2) :
    Tendsto (fun n => ((returnBracketSequence hα hlo hhi n).q : ℝ) * α -
      (returnBracketSequence hα hlo hhi n).p) atTop (nhds 0) := by
  have hlim : Tendsto (fun n => 1 / ((returnBracketSequence hα hlo hhi n).Q : ℝ))
      atTop (nhds 0) :=
    tendsto_one_div_atTop_nhds_zero_nat.comp (returnBracketSequence_Q_tendsto hα hlo hhi)
  exact squeeze_zero
    (fun n => (returnBracketSequence hα hlo hhi n).lower_pos.le)
    (fun n => (returnBracketSequence hα hlo hhi n).lower_error_lt.le) hlim

noncomputable def rotationReturns : ℕ → ReturnBracket rotationSlope :=
  returnBracketSequence rotationSlope_irrational rotationSlope_bounds.1 rotationSlope_bounds.2

def rotationReturns_denominators_tendsto :
    Tendsto (fun n => (rotationReturns n).q) atTop atTop ∧
    Tendsto (fun n => (rotationReturns n).Q) atTop atTop :=
  ⟨returnBracketSequence_q_tendsto _ _ _, returnBracketSequence_Q_tendsto _ _ _⟩

def rotationReturns_error_tendsto :
    Tendsto (fun n => ((rotationReturns n).q : ℝ) * rotationSlope -
      (rotationReturns n).p) atTop (nhds 0) :=
  returnBracketSequence_error_tendsto _ _ _


end Bounty

end SubmissionComponent_ReturnSequence

/- Component ReturnScale; SHA256 13ff160f1964d8740c2042d0a088a38914b4159a1d650f0efba27eed6bcb568a -/
section SubmissionComponent_ReturnScale
/- The common logarithmic scale of the two rotation codings. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def returnScale (n : ℕ) : ℝ := (rotationReturns n).P * Real.log 3

def ReturnBracket.log_bounds (s : ReturnBracket rotationSlope) :
    (s.p : ℝ) * Real.log 3 < (s.q : ℝ) * Real.log 4 ∧
    (s.q : ℝ) * Real.log 4 ≤ (s.Q : ℝ) * Real.log 4 ∧
    (s.Q : ℝ) * Real.log 4 < (s.P : ℝ) * Real.log 3 ∧
    (s.P : ℝ) * Real.log 3 ≤ 2 * ((s.Q : ℝ) * Real.log 4) := by
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have h4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have h34 : Real.log 3 < Real.log 4 :=
    Real.log_lt_log (by norm_num) (by norm_num)
  have hrel : rotationSlope * Real.log 3 = Real.log 4 := by
    dsimp [rotationSlope]
    exact div_mul_cancel₀ _ (ne_of_gt h3)
  have hd := mul_pos s.lower_pos h3
  have he := mul_pos s.upper_pos h3
  have hlo : (s.p : ℝ) * Real.log 3 < (s.q : ℝ) * Real.log 4 := by
    nlinarith [hrel]
  have hhi : (s.Q : ℝ) * Real.log 4 < (s.P : ℝ) * Real.log 3 := by
    nlinarith [hrel]
  have hqQ : (s.q : ℝ) ≤ s.Q := by exact_mod_cast s.q_le_Q
  have hmid := mul_le_mul_of_nonneg_right hqQ h4.le
  have hP : (s.P : ℝ) ≤ 2 * s.Q := by
    exact_mod_cast (s.numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2).2.2.2.1
  have hQ : (0 : ℝ) < s.Q := by exact_mod_cast s.Q_pos
  have hPln := mul_le_mul_of_nonneg_right hP h3.le
  refine ⟨hlo, hmid, hhi, ?_⟩
  nlinarith

def returnScale_pos (n : ℕ) : 0 < returnScale n := by
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hh := (rotationReturns n).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
  have hQ := (rotationReturns n).Q_pos
  have hP : (0 : ℝ) < (rotationReturns n).P := by
    exact_mod_cast (by omega : 0 < (rotationReturns n).P)
  exact mul_pos hP h3

def returnScale_bounds (n : ℕ) :
    ((rotationReturns n).q : ℝ) * Real.log 4 ≤ returnScale n ∧
    ((rotationReturns n).p : ℝ) * Real.log 3 ≤ returnScale n ∧
    returnScale n / 2 ≤ ((rotationReturns n).Q : ℝ) * Real.log 4 ∧
    ((rotationReturns n).Q : ℝ) * Real.log 4 ≤ returnScale n := by
  have hh := (rotationReturns n).log_bounds
  dsimp only [returnScale]
  constructor
  · exact hh.2.1.trans hh.2.2.1.le
  constructor
  · exact (hh.1.trans_le hh.2.1).le.trans hh.2.2.1.le
  constructor
  · linarith [hh.2.2.2]
  · exact hh.2.2.1.le

def returnScale_tendsto : Tendsto returnScale atTop atTop := by
  have hQ : Tendsto (fun n => ((rotationReturns n).Q : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp rotationReturns_denominators_tendsto.2
  have hh : Tendsto (fun n => ((rotationReturns n).Q : ℝ) * Real.log 4) atTop atTop :=
    (tendsto_mul_const_atTop_of_pos (Real.log_pos (by norm_num : (1 : ℝ) < 4))).2 hQ
  exact tendsto_atTop_mono (fun n => (returnScale_bounds n).2.2.2) hh


end Bounty

end SubmissionComponent_ReturnScale

/- Component RotationOrbitSeparation; SHA256 975abbb0963357e1a5555aa26c5c4b89e887d1fa20146f782a7bdb977be8048f -/
section SubmissionComponent_RotationOrbitSeparation
/- Uniform separation of shrinking visits to different rotation orbits. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def integerDistance (x : ℝ) : ℝ :=
  min (Int.fract x) (1 - Int.fract x)

def integerDistance_pos {x : ℝ} (hx : ∀ k : ℤ, x ≠ k) :
    0 < integerDistance x := by
  exact lt_min (Int.fract_pos.mpr (hx ⌊x⌋)) (sub_pos.mpr (Int.fract_lt_one x))

def integerDistance_le_abs (x : ℝ) (k : ℤ) : integerDistance x ≤ |x - k| := by
  by_cases hk : k ≤ ⌊x⌋
  · have hkr : (k : ℝ) ≤ (⌊x⌋ : ℝ) := by exact_mod_cast hk
    have hf : Int.fract x ≤ x - k := by
      change x - (⌊x⌋ : ℝ) ≤ x - k
      linarith
    exact (min_le_left _ _).trans (hf.trans (le_abs_self _))
  · have hk' : ⌊x⌋ + 1 ≤ k := by omega
    have hkr : (⌊x⌋ : ℝ) + 1 ≤ k := by exact_mod_cast hk'
    have hf : 1 - Int.fract x ≤ -(x - k) := by
      change 1 - (x - (⌊x⌋ : ℝ)) ≤ -(x - k)
      linarith
    exact (min_le_right _ _).trans (hf.trans (neg_le_abs _))

def two_visits_distance_lt {α t u δ : ℝ} {i j : ℤ}
    (hi : Int.fract ((i : ℝ) * α - t) < δ)
    (hj : Int.fract ((j : ℝ) * α - u) < δ) :
    integerDistance (((j - i : ℤ) : ℝ) * α - (u - t)) < δ := by
  let x : ℝ := (i : ℝ) * α - t
  let y : ℝ := (j : ℝ) * α - u
  have he : (((j - i : ℤ) : ℝ) * α - (u - t)) -
      ((⌊y⌋ - ⌊x⌋ : ℤ) : ℝ) = Int.fract y - Int.fract x := by
    change _ = (y - (⌊y⌋ : ℝ)) - (x - (⌊x⌋ : ℝ))
    dsimp only [x, y]
    push_cast
    ring
  have hh := integerDistance_le_abs (((j - i : ℤ) : ℝ) * α - (u - t)) (⌊y⌋ - ⌊x⌋)
  rw [he] at hh
  have hh' : |Int.fract y - Int.fract x| < δ := by
    have hxn := Int.fract_nonneg x
    have hyn := Int.fract_nonneg y
    rw [abs_lt]
    constructor <;> linarith
  exact hh.trans_lt hh'

def distinct_orbit_visits_separate {α t u : ℝ} {δ : ℕ → ℝ}
    (hδ : Tendsto δ atTop (nhds 0))
    (horbit : ∀ h k : ℤ, (h : ℝ) * α - (u - t) ≠ k) (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : ℤ,
      Int.fract ((i : ℝ) * α - t) < δ r →
      Int.fract ((j : ℝ) * α - u) < δ r → (M : ℤ) < |j - i| := by
  have hsmall : ∀ᶠ r in atTop, ∀ h ∈ Finset.Icc (-(M : ℤ)) M,
      δ r < integerDistance ((h : ℝ) * α - (u - t)) := by
    apply (eventually_all_finset _).mpr
    intro h hh
    exact hδ.eventually (gt_mem_nhds (integerDistance_pos (horbit h)))
  filter_upwards [hsmall] with r hr i j hi hj
  by_contra hh
  have habs : |j - i| ≤ (M : ℤ) := le_of_not_gt hh
  have hmem : j - i ∈ Finset.Icc (-(M : ℤ)) M := by
    simpa only [Finset.mem_Icc, abs_le] using habs
  have hlarge := hr (j - i) hmem
  have hclose := two_visits_distance_lt hi hj
  linarith

end Bounty

end SubmissionComponent_RotationOrbitSeparation

/- Component JumpOrbitArithmetic; SHA256 3e5bd5dd7bf3f67ac9e88879f3255eb517f9238077437c3b7f28b9d116a54af1 -/
section SubmissionComponent_JumpOrbitArithmetic
/- Prime valuations distinguish all four jump orbits in either coding. -/

namespace Bounty

def rationalPrimeMonomial (a b c : ℤ) : ℚ := (2 : ℚ) ^ a * (3 : ℚ) ^ b * (5 : ℚ) ^ c

def rationalPrimeMonomial_pos (a b c : ℤ) : 0 < rationalPrimeMonomial a b c := by
  unfold rationalPrimeMonomial
  positivity

def padicValRat_nat_zero {p n : ℕ} (h : ¬ p ∣ n) : padicValRat p (n : ℚ) = 0 := by
  rw [padicValRat.of_nat, padicValNat.eq_zero_of_not_dvd h, Nat.cast_zero]

def rationalPrimeMonomial_val_two (a b c : ℤ) :
    padicValRat 2 (rationalPrimeMonomial a b c) = a := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : padicValRat 2 2 = 1 := padicValRat.self (by norm_num)
  have h3 : padicValRat 2 3 = 0 := padicValRat_nat_zero (by norm_num : ¬ 2 ∣ 3)
  have h5 : padicValRat 2 5 = 0 := padicValRat_nat_zero (by norm_num : ¬ 2 ∣ 5)
  unfold rationalPrimeMonomial
  rw [padicValRat.mul (by positivity) (by positivity),
    padicValRat.mul (by positivity) (by positivity)]
  simp only [padicValRat.zpow, h2, h3, h5]
  ring

def rationalPrimeMonomial_val_five (a b c : ℤ) :
    padicValRat 5 (rationalPrimeMonomial a b c) = c := by
  let : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have h2 : padicValRat 5 2 = 0 := padicValRat_nat_zero (by norm_num : ¬ 5 ∣ 2)
  have h3 : padicValRat 5 3 = 0 := padicValRat_nat_zero (by norm_num : ¬ 5 ∣ 3)
  have h5 : padicValRat 5 5 = 1 := padicValRat.self (by norm_num)
  unfold rationalPrimeMonomial
  rw [padicValRat.mul (by positivity) (by positivity),
    padicValRat.mul (by positivity) (by positivity)]
  simp only [padicValRat.zpow, h2, h3, h5]
  ring

def rationalPrimeMonomial_mul (a b c x y z : ℤ) :
    rationalPrimeMonomial a b c * rationalPrimeMonomial x y z =
      rationalPrimeMonomial (a + x) (b + y) (c + z) := by
  unfold rationalPrimeMonomial
  rw [zpow_add₀ (by norm_num : (2 : ℚ) ≠ 0),
    zpow_add₀ (by norm_num : (3 : ℚ) ≠ 0),
    zpow_add₀ (by norm_num : (5 : ℚ) ≠ 0)]
  ring

def rational_four_three_monomial (h k : ℤ) :
    (4 : ℚ) ^ h * (3 : ℚ) ^ k = rationalPrimeMonomial (2 * h) k 0 := by
  unfold rationalPrimeMonomial
  have hh : (4 : ℚ) ^ h = (2 : ℚ) ^ (2 * h) := by
    rw [zpow_mul]
    norm_num
  simp only [hh, zpow_zero, mul_one]

def jumpExponent4 (i : Fin 4) : ℤ := ![0, 1, 0, 1] i
def jumpExponent3 (i : Fin 4) : ℤ := ![0, 1, 3, -2] i
def jumpFiveExponent (i : Fin 4) : ℤ := ![0, 0, -1, 1] i
def jumpThreeExponent4 (i : Fin 4) : ℤ := ![0, 0, 2, -2] i

def jumpRepresentative4 (i : Fin 4) : ℚ :=
  rationalPrimeMonomial (jumpExponent4 i) (jumpThreeExponent4 i) (jumpFiveExponent i)

def jumpRepresentative3 (i : Fin 4) : ℚ :=
  rationalPrimeMonomial (jumpExponent3 i) 0 (jumpFiveExponent i)

def jumpRepresentative4_table : jumpRepresentative4 = ![1, 2, 9 / 5, 10 / 9] := by
  funext i
  fin_cases i <;> norm_num [jumpRepresentative4, jumpExponent4, jumpThreeExponent4,
    jumpFiveExponent, rationalPrimeMonomial]

def jumpRepresentative3_table : jumpRepresentative3 = ![1, 2, 8 / 5, 5 / 4] := by
  funext i
  fin_cases i <;> norm_num [jumpRepresentative3, jumpExponent3,
    jumpFiveExponent, rationalPrimeMonomial]

def jumpRepresentative4_distinct_orbits {i j : Fin 4} (hij : i ≠ j) (h k : ℤ) :
    jumpRepresentative4 i ≠ jumpRepresentative4 j * ((4 : ℚ) ^ h * (3 : ℚ) ^ k) := by
  intro he
  rw [rational_four_three_monomial, jumpRepresentative4, jumpRepresentative4,
    rationalPrimeMonomial_mul] at he
  have h2 := congrArg (padicValRat 2) he
  have h5 := congrArg (padicValRat 5) he
  simp only [rationalPrimeMonomial_val_two] at h2
  simp only [rationalPrimeMonomial_val_five] at h5
  fin_cases i <;> fin_cases j <;>
    norm_num [jumpExponent4] at h2 <;>
    norm_num [jumpFiveExponent] at h5 <;> omega

def jumpRepresentative3_distinct_orbits {i j : Fin 4} (hij : i ≠ j) (h k : ℤ) :
    jumpRepresentative3 i ≠ jumpRepresentative3 j * ((4 : ℚ) ^ h * (3 : ℚ) ^ k) := by
  intro he
  rw [rational_four_three_monomial, jumpRepresentative3, jumpRepresentative3,
    rationalPrimeMonomial_mul] at he
  have h2 := congrArg (padicValRat 2) he
  have h5 := congrArg (padicValRat 5) he
  simp only [rationalPrimeMonomial_val_two] at h2
  simp only [rationalPrimeMonomial_val_five] at h5
  fin_cases i <;> fin_cases j <;>
    norm_num [jumpExponent3] at h2 <;>
    norm_num [jumpFiveExponent] at h5 <;> omega


end Bounty

end SubmissionComponent_JumpOrbitArithmetic

/- Component ReciprocalReturns; SHA256 e0c1440bcbbd126242ff54590d6645485c482c46249143837b13fd34f2ae8264 -/
section SubmissionComponent_ReciprocalReturns
/- Transfer the return pair to the reciprocal rotation by reversing its sign. -/

namespace Bounty

def ReturnBracket.negativeInverse {α : ℝ} (s : ReturnBracket α)
    (hlo : 1 < α) (hhi : α < 2) : ReturnBracket (-1 / α) := by
  have hb := s.numerator_bounds hlo hhi
  have hq := s.q_pos
  have hQ := s.Q_pos
  have hp : 0 < s.p := by omega
  have hP : 0 < s.P := by omega
  have hα : 0 < α := by linarith
  have hpZ : (s.p.toNat : ℤ) = s.p := Int.toNat_of_nonneg hp.le
  have hPZ : (s.P.toNat : ℤ) = s.P := Int.toNat_of_nonneg hP.le
  have hpR : (s.p.toNat : ℝ) = s.p := by exact_mod_cast hpZ
  have hPR : (s.P.toNat : ℝ) = s.P := by exact_mod_cast hPZ
  have hlower : (s.p.toNat : ℝ) * (-1 / α) - ((-(s.q : ℤ) : ℤ) : ℝ) =
      ((s.q : ℝ) * α - s.p) / α := by
    rw [hpR]
    push_cast
    field_simp
    ring
  have hupper : ((-(s.Q : ℤ) : ℤ) : ℝ) - (s.P.toNat : ℝ) * (-1 / α) =
      ((s.P : ℝ) - s.Q * α) / α := by
    rw [hPR]
    push_cast
    field_simp
    ring
  refine { p := -(s.q : ℤ), P := -(s.Q : ℤ), q := s.p.toNat, Q := s.P.toNat,
           q_pos := Int.pos_iff_toNat_pos.mp hp,
           Q_pos := Int.pos_iff_toNat_pos.mp hP,
           q_le_Q := Int.toNat_le_toNat hb.2.2.2.2.le,
           determinant := ?_, lower_pos := ?_, upper_pos := ?_, upper_lt_lower := ?_ }
  · rw [hpZ, hPZ]
    nlinarith [s.determinant]
  · rw [hlower]
    exact div_pos s.lower_pos hα
  · rw [hupper]
    exact div_pos s.upper_pos hα
  · rw [hupper, hlower]
    exact div_lt_div_of_pos_right s.upper_lt_lower hα

def ReturnBracket.reciprocal_best_approximation {α : ℝ} (s : ReturnBracket α)
    (hlo : 1 < α) (hhi : α < 2) {n : ℕ} (hn : 0 < n) (hnP : n < s.P.toNat)
    (k : ℤ) : ((s.q : ℝ) * α - s.p) / α ≤ |(n : ℝ) / α - k| := by
  let t := s.negativeInverse hlo hhi
  have hp : 0 < s.p := by
    have hb := s.numerator_bounds hlo hhi
    have hq := s.q_pos
    omega
  have hpR : (s.p.toNat : ℝ) = s.p := by exact_mod_cast Int.toNat_of_nonneg hp.le
  have hh := return_pair_best_approximation (α := -1 / α) (-k)
    t.q_pos hn hnP t.determinant t.lower_pos t.upper_pos
  change (s.p.toNat : ℝ) * (-1 / α) - ((-(s.q : ℤ) : ℤ) : ℝ) ≤
    |(n : ℝ) * (-1 / α) - ((-k : ℤ) : ℝ)| at hh
  have he : (s.p.toNat : ℝ) * (-1 / α) - ((-(s.q : ℤ) : ℤ) : ℝ) =
      ((s.q : ℝ) * α - s.p) / α := by
    rw [hpR]
    push_cast
    field_simp
    ring
  have he' : (n : ℝ) * (-1 / α) - ((-k : ℤ) : ℝ) = -((n : ℝ) / α - k) := by
    push_cast
    ring
  simpa only [he, he', abs_neg] using hh

end Bounty

end SubmissionComponent_ReciprocalReturns

/- Component JumpOrbits; SHA256 f44b7eee2553f15d1225b2c68f2dcf5c55dcfebbce65e9e1f33fe7c62f7b656a -/
section SubmissionComponent_JumpOrbits
/- The logarithmic jump locations lie in pairwise distinct rotation orbits. -/

namespace Bounty

def logarithmic_relation_implies_monomial {a b r s : ℚ}
    (ha : 0 < a) (hb : 1 < b) (hr : 0 < r) (hs : 0 < s) (h k : ℤ)
    (he : (h : ℝ) * (Real.log (a : ℝ) / Real.log (b : ℝ)) -
      (Real.logb (b : ℝ) (s : ℝ) - Real.logb (b : ℝ) (r : ℝ)) = k) :
    s = r * (a ^ h * b ^ (-k)) := by
  have haR : (0 : ℝ) < a := by exact_mod_cast ha
  have hbR : (1 : ℝ) < b := by exact_mod_cast hb
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have hlog : Real.log (b : ℝ) ≠ 0 := ne_of_gt (Real.log_pos hbR)
  have hratio : ((h : ℝ) * Real.log (a : ℝ) -
      (Real.log (s : ℝ) - Real.log (r : ℝ))) / Real.log (b : ℝ) = k := by
    calc
      _ = (h : ℝ) * (Real.log (a : ℝ) / Real.log (b : ℝ)) -
          (Real.log (s : ℝ) / Real.log (b : ℝ) -
            Real.log (r : ℝ) / Real.log (b : ℝ)) := by ring
      _ = k := by simpa only [Real.logb] using he
  have hcross := (div_eq_iff hlog).mp hratio
  have hapos : (0 : ℝ) < (a : ℝ) ^ h := zpow_pos haR h
  have hbpos : (0 : ℝ) < (b : ℝ) ^ (-k) := zpow_pos (by linarith) (-k)
  have hprod : (0 : ℝ) < (r : ℝ) * ((a : ℝ) ^ h * (b : ℝ) ^ (-k)) :=
    mul_pos hrR (mul_pos hapos hbpos)
  have hlogs : Real.log ((r : ℝ) * ((a : ℝ) ^ h * (b : ℝ) ^ (-k))) =
      Real.log (s : ℝ) := by
    rw [Real.log_mul (ne_of_gt hrR) (ne_of_gt (mul_pos hapos hbpos)),
      Real.log_mul (ne_of_gt hapos) (ne_of_gt hbpos), Real.log_zpow, Real.log_zpow,
      Int.cast_neg]
    linarith
  have hreal : (s : ℝ) = (r : ℝ) * ((a : ℝ) ^ h * (b : ℝ) ^ (-k)) :=
    (Real.log_injOn_pos hprod hsR hlogs).symm
  exact_mod_cast hreal

noncomputable def jumpCoordinate4 (i : Fin 4) : ℝ := Real.logb 3 (jumpRepresentative4 i)
noncomputable def jumpCoordinate3 (i : Fin 4) : ℝ := Real.logb 4 (jumpRepresentative3 i)

def jumpOrbits4_distinct {i j : Fin 4} (hij : i ≠ j) (h k : ℤ) :
    (h : ℝ) * rotationSlope - (jumpCoordinate4 j - jumpCoordinate4 i) ≠ k := by
  intro he
  have hi : 0 < jumpRepresentative4 i := rationalPrimeMonomial_pos _ _ _
  have hj : 0 < jumpRepresentative4 j := rationalPrimeMonomial_pos _ _ _
  have hh := logarithmic_relation_implies_monomial (a := 4) (b := 3)
    (by norm_num) (by norm_num) hi hj h k
    (by simpa only [Rat.cast_ofNat, rotationSlope, jumpCoordinate4] using he)
  exact jumpRepresentative4_distinct_orbits (Ne.symm hij) h (-k) hh

def jumpOrbits3_distinct {i j : Fin 4} (hij : i ≠ j) (h k : ℤ) :
    (h : ℝ) * (1 / rotationSlope) - (jumpCoordinate3 j - jumpCoordinate3 i) ≠ k := by
  intro he
  have hi : 0 < jumpRepresentative3 i := rationalPrimeMonomial_pos _ _ _
  have hj : 0 < jumpRepresentative3 j := rationalPrimeMonomial_pos _ _ _
  have hh := logarithmic_relation_implies_monomial (a := 3) (b := 4)
    (by norm_num) (by norm_num) hi hj h k
    (by simpa only [Rat.cast_ofNat, ← inverse_rotationSlope, Real.logb, jumpCoordinate3] using he)
  rw [mul_comm ((3 : ℚ) ^ h) ((4 : ℚ) ^ (-k))] at hh
  exact jumpRepresentative3_distinct_orbits (Ne.symm hij) (-k) h hh

def jumpCoordinate4_zero : jumpCoordinate4 0 = 0 := by
  rw [jumpCoordinate4, jumpRepresentative4_table]
  norm_num [Real.logb]

def jumpCoordinate3_zero : jumpCoordinate3 0 = 0 := by
  rw [jumpCoordinate3, jumpRepresentative3_table]
  norm_num [Real.logb]

end Bounty

end SubmissionComponent_JumpOrbits

/- Component SmallRotationJumps; SHA256 e0aa8d4c0ea48ca11f96f75adeec3334882a6c78fa295c2a074a65b931079535 -/
section SubmissionComponent_SmallRotationJumps
/- Half-open circular jump indicators, with exact floor-difference identities. -/

namespace Bounty

noncomputable def forwardJump (δ t x : ℝ) : ℤ := by
  classical
  exact if 1 - δ ≤ Int.fract (x - t) then 1 else 0

noncomputable def backwardJump (δ t x : ℝ) : ℤ := by
  classical
  exact if Int.fract (x - t) < δ then 1 else 0

def floor_forward_jump {δ : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    ⌊x + δ⌋ - ⌊x⌋ = forwardJump δ 0 x := by
  classical
  have hf0 := Int.fract_nonneg x
  have hf1 := Int.fract_lt_one x
  have hfx : Int.fract x = x - (⌊x⌋ : ℝ) := rfl
  by_cases h : 1 - δ ≤ Int.fract x
  · have he : ⌊x + δ⌋ = ⌊x⌋ + 1 := by
      apply Int.floor_eq_iff.mpr
      push_cast
      constructor <;> linarith
    simp only [forwardJump, sub_zero, if_pos h, he]
    omega
  · have he : ⌊x + δ⌋ = ⌊x⌋ := by
      apply Int.floor_eq_iff.mpr
      constructor <;> linarith
    simp only [forwardJump, sub_zero, if_neg h, he, sub_self]

def floor_backward_jump {δ : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    ⌊x - δ⌋ - ⌊x⌋ = -backwardJump δ 0 x := by
  classical
  have hf0 := Int.fract_nonneg x
  have hf1 := Int.fract_lt_one x
  have hfx : Int.fract x = x - (⌊x⌋ : ℝ) := rfl
  by_cases h : Int.fract x < δ
  · have he : ⌊x - δ⌋ = ⌊x⌋ - 1 := by
      apply Int.floor_eq_iff.mpr
      push_cast
      constructor <;> linarith
    simp only [backwardJump, sub_zero, if_pos h, he]
    omega
  · have he : ⌊x - δ⌋ = ⌊x⌋ := by
      apply Int.floor_eq_iff.mpr
      constructor <;> linarith
    simp only [backwardJump, sub_zero, if_neg h, he, sub_self, neg_zero]

noncomputable def circleStep (t x : ℝ) : ℤ := by
  classical
  exact if t ≤ Int.fract x then 1 else 0

def circleStep_eq_floors {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t < 1) (x : ℝ) :
    circleStep t x = 1 + ⌊x - t⌋ - ⌊x⌋ := by
  classical
  have hh := floor_backward_jump ht0 ht1 x
  by_cases h : t ≤ Int.fract x
  · have hn : ¬ Int.fract x < t := not_lt_of_ge h
    simp only [circleStep, if_pos h, backwardJump, sub_zero, if_neg hn, neg_zero] at *
    omega
  · have hn : Int.fract x < t := lt_of_not_ge h
    simp only [circleStep, if_neg h, backwardJump, sub_zero, if_pos hn] at *
    omega

def circleStep_forward_difference {t δ : ℝ}
    (ht0 : 0 ≤ t) (ht1 : t < 1) (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    circleStep t (x + δ) - circleStep t x =
      forwardJump δ t x - forwardJump δ 0 x := by
  rw [circleStep_eq_floors ht0 ht1, circleStep_eq_floors ht0 ht1]
  have hh := floor_forward_jump hd0 hd1 (x - t)
  have hh' := floor_forward_jump hd0 hd1 x
  have he : x - t + δ = x + δ - t := by ring
  rw [he] at hh
  have hj : forwardJump δ 0 (x - t) = forwardJump δ t x := by
    simp only [forwardJump, sub_zero]
  rw [hj] at hh
  omega

def circleStep_backward_difference {t δ : ℝ}
    (ht0 : 0 ≤ t) (ht1 : t < 1) (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    circleStep t (x - δ) - circleStep t x =
      -backwardJump δ t x + backwardJump δ 0 x := by
  rw [circleStep_eq_floors ht0 ht1, circleStep_eq_floors ht0 ht1]
  have hh := floor_backward_jump hd0 hd1 (x - t)
  have hh' := floor_backward_jump hd0 hd1 x
  have he : x - t - δ = x - δ - t := by ring
  rw [he] at hh
  have hj : backwardJump δ 0 (x - t) = backwardJump δ t x := by
    simp only [backwardJump, sub_zero]
  rw [hj] at hh
  omega

def forwardJump_integer_shift (δ t x : ℝ) (k : ℤ) :
    forwardJump δ (t + k) x = forwardJump δ t x := by
  have he : x - (t + (k : ℝ)) = (x - t) - k := by ring
  simp only [forwardJump, he, Int.fract_sub_intCast]

def backwardJump_integer_shift (δ t x : ℝ) (k : ℤ) :
    backwardJump δ (t + k) x = backwardJump δ t x := by
  have he : x - (t + (k : ℝ)) = (x - t) - k := by ring
  simp only [backwardJump, he, Int.fract_sub_intCast]

def forwardJump_orbit_shift (δ t α : ℝ) (n k : ℤ) :
    forwardJump δ (t + (k : ℝ) * α) ((n : ℝ) * α) =
      forwardJump δ t (((n - k : ℤ) : ℝ) * α) := by
  have he : (n : ℝ) * α - (t + (k : ℝ) * α) = ((n - k : ℤ) : ℝ) * α - t := by
    push_cast
    ring
  simp only [forwardJump, he]

def backwardJump_orbit_shift (δ t α : ℝ) (n k : ℤ) :
    backwardJump δ (t + (k : ℝ) * α) ((n : ℝ) * α) =
      backwardJump δ t (((n - k : ℤ) : ℝ) * α) := by
  have he : (n : ℝ) * α - (t + (k : ℝ) * α) = ((n - k : ℤ) : ℝ) * α - t := by
    push_cast
    ring
  simp only [backwardJump, he]


end Bounty

end SubmissionComponent_SmallRotationJumps

/- Component VanishingJumps; SHA256 90be37583a6485a86d9d2ea122bf13167efb9dc1caac4524ebf22520ef4dc2ea -/
section SubmissionComponent_VanishingJumps
/- Exact initial visits and disappearance of all other fixed-index jump terms. -/

open Filter
open scoped Topology

namespace Bounty

def irrational_int_mul_ne_int {α : ℝ} (hα : Irrational α) {n : ℤ}
    (hn : n ≠ 0) (k : ℤ) : (n : ℝ) * α ≠ k := by
  intro he
  apply hα.ne_rational k n
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  apply (eq_div_iff hnR).mpr
  nlinarith

def jumpOrbit4_int_index_ne {i : Fin 4} {n : ℤ} (hn : i ≠ 0 ∨ n ≠ 0) (k : ℤ) :
    (n : ℝ) * rotationSlope - jumpCoordinate4 i ≠ k := by
  by_cases hi : i = 0
  · subst i
    rw [jumpCoordinate4_zero, sub_zero]
    exact irrational_int_mul_ne_int rotationSlope_irrational (hn.resolve_left (by simp)) k
  · simpa only [jumpCoordinate4_zero, sub_zero] using
      jumpOrbits4_distinct (i := 0) (j := i) (Ne.symm hi) n k

def jumpOrbit3_int_index_ne {i : Fin 4} {n : ℤ} (hn : i ≠ 0 ∨ n ≠ 0) (k : ℤ) :
    (n : ℝ) * (1 / rotationSlope) - jumpCoordinate3 i ≠ k := by
  by_cases hi : i = 0
  · subst i
    rw [jumpCoordinate3_zero, sub_zero]
    have hIrr : Irrational (1 / rotationSlope) := by
      simpa only [one_div] using rotationSlope_irrational.inv
    exact irrational_int_mul_ne_int hIrr (hn.resolve_left (by simp)) k
  · simpa only [jumpCoordinate3_zero, sub_zero] using
      jumpOrbits3_distinct (i := 0) (j := i) (Ne.symm hi) n k

def jumps_eventually_zero {δ : ℕ → ℝ} (hδ : Tendsto δ atTop (nhds 0))
    {x t : ℝ} (hx : ∀ k : ℤ, x - t ≠ k) :
    ∀ᶠ r in atTop, forwardJump (δ r) t x = 0 ∧ backwardJump (δ r) t x = 0 := by
  classical
  have hh := hδ.eventually (gt_mem_nhds (integerDistance_pos hx))
  filter_upwards [hh] with r hr
  have hleft := lt_of_lt_of_le hr (min_le_left (Int.fract (x - t)) (1 - Int.fract (x - t)))
  have hright := lt_of_lt_of_le hr (min_le_right (Int.fract (x - t)) (1 - Int.fract (x - t)))
  have hf : ¬ 1 - δ r ≤ Int.fract (x - t) := by linarith
  have hb : ¬ Int.fract (x - t) < δ r := by linarith
  simp only [forwardJump, backwardJump, if_neg hf, if_neg hb, and_self]

noncomputable def returnError (r : ℕ) : ℝ :=
  ((rotationReturns r).q : ℝ) * rotationSlope - (rotationReturns r).p

def returnError_pos (r : ℕ) : 0 < returnError r := (rotationReturns r).lower_pos

def returnError_lt_one (r : ℕ) : returnError r < 1 := (rotationReturns r).lower_error_lt_one

def returnError_tendsto : Tendsto returnError atTop (nhds 0) := rotationReturns_error_tendsto

def reciprocal_returnError_tendsto :
    Tendsto (fun r => returnError r / rotationSlope) atTop (nhds 0) := by
  simpa only [zero_div] using returnError_tendsto.div_const rotationSlope

noncomputable def jumpVisit4 (r : ℕ) (i : Fin 4) (n : ℤ) : ℤ :=
  forwardJump (returnError r) (jumpCoordinate4 i) ((n : ℝ) * rotationSlope)

noncomputable def jumpVisit3 (r : ℕ) (i : Fin 4) (n : ℤ) : ℤ :=
  backwardJump (returnError r / rotationSlope) (jumpCoordinate3 i) ((n : ℝ) / rotationSlope)

def jumpVisit4_initial (r : ℕ) : jumpVisit4 r 0 0 = 0 := by
  classical
  have hh : ¬ 1 - returnError r ≤ 0 := by linarith [returnError_lt_one r]
  simp only [jumpVisit4, jumpCoordinate4_zero, Int.cast_zero, zero_mul,
    forwardJump, sub_zero, Int.fract_zero, if_neg hh]

def jumpVisit3_initial (r : ℕ) : jumpVisit3 r 0 0 = 1 := by
  classical
  have hh : 0 < returnError r / rotationSlope :=
    div_pos (returnError_pos r) (by linarith [rotationSlope_bounds.1])
  simp only [jumpVisit3, jumpCoordinate3_zero, Int.cast_zero, zero_div,
    backwardJump, sub_zero, Int.fract_zero, if_pos hh]

def jumpVisit4_fixed_eventually_zero {i : Fin 4} {n : ℤ} (hn : i ≠ 0 ∨ n ≠ 0) :
    ∀ᶠ r in atTop, jumpVisit4 r i n = 0 := by
  have hh := jumps_eventually_zero returnError_tendsto (jumpOrbit4_int_index_ne hn)
  exact hh.mono (fun r hr => hr.1)

def jumpVisit3_fixed_eventually_zero {i : Fin 4} {n : ℤ} (hn : i ≠ 0 ∨ n ≠ 0) :
    ∀ᶠ r in atTop, jumpVisit3 r i n = 0 := by
  have horbit : ∀ k : ℤ, (n : ℝ) / rotationSlope - jumpCoordinate3 i ≠ k := by
    simpa only [mul_one_div] using jumpOrbit3_int_index_ne hn
  have hh := jumps_eventually_zero reciprocal_returnError_tendsto horbit
  exact hh.mono (fun r hr => hr.2)


end Bounty

end SubmissionComponent_VanishingJumps

/- Component JumpVisitSpacing; SHA256 11cce2fe1611c20ac1629b15f934e9978300b75cfaf718ae592c68d964ef190c -/
section SubmissionComponent_JumpVisitSpacing
/- Quantitative separation of the actual forward and backward visit sequences. -/

namespace Bounty

def forwardJump_lift {δ t x : ℝ} (h : forwardJump δ t x ≠ 0) :
    t - δ ≤ x - ((⌊x - t⌋ + 1 : ℤ) : ℝ) ∧
      x - ((⌊x - t⌋ + 1 : ℤ) : ℝ) < t := by
  classical
  have hh : 1 - δ ≤ Int.fract (x - t) := by
    by_contra hn
    simp only [forwardJump, if_neg hn, ne_eq, not_true_eq_false] at h
  have hu := Int.fract_lt_one (x - t)
  change 1 - δ ≤ x - t - (⌊x - t⌋ : ℝ) at hh
  change x - t - (⌊x - t⌋ : ℝ) < 1 at hu
  push_cast
  constructor <;> linarith

def backwardJump_lift {δ t x : ℝ} (h : backwardJump δ t x ≠ 0) :
    t ≤ x - (⌊x - t⌋ : ℝ) ∧ x - (⌊x - t⌋ : ℝ) < t + δ := by
  classical
  have hh : Int.fract (x - t) < δ := by
    by_contra hn
    simp only [backwardJump, if_neg hn, ne_eq, not_true_eq_false] at h
  have hl := Int.fract_nonneg (x - t)
  change x - t - (⌊x - t⌋ : ℝ) < δ at hh
  change 0 ≤ x - t - (⌊x - t⌋ : ℝ) at hl
  constructor <;> linarith

def short_lifted_visits_separated {α δ t : ℝ} {Q i j : ℕ} {a b : ℤ}
    (happrox : ∀ n : ℕ, 0 < n → n < Q → ∀ k : ℤ, δ ≤ |(n : ℝ) * α - k|)
    (hij : i < j)
    (hi : t ≤ (i : ℝ) * α - a ∧ (i : ℝ) * α - a < t + δ)
    (hj : t ≤ (j : ℝ) * α - b ∧ (j : ℝ) * α - b < t + δ) :
    Q ≤ j - i := by
  by_contra hh
  have hl := happrox (j - i) (by omega) (by omega) (b - a)
  have he : ((j - i : ℕ) : ℝ) * α - ((b - a : ℤ) : ℝ) =
      ((j : ℝ) * α - b) - ((i : ℝ) * α - a) := by
    rw [Nat.cast_sub (by omega : i ≤ j), Int.cast_sub]
    ring
  rw [he] at hl
  have hs : |((j : ℝ) * α - b) - ((i : ℝ) * α - a)| < δ := by
    rw [abs_lt]
    constructor <;> linarith [hi.1, hi.2, hj.1, hj.2]
  linarith

def jumpVisit4_separated (r : ℕ) (i : Fin 4) {m n : ℕ} (hmn : m < n)
    (hm : jumpVisit4 r i m ≠ 0) (hn : jumpVisit4 r i n ≠ 0) :
    (rotationReturns r).Q ≤ n - m := by
  have hm' := forwardJump_lift hm
  have hn' := forwardJump_lift hn
  simp only [Int.cast_natCast] at hm' hn'
  have hap (k : ℕ) (hk : 0 < k) (hkQ : k < (rotationReturns r).Q) (l : ℤ) :
      returnError r ≤ |(k : ℝ) * rotationSlope - l| :=
    return_pair_best_approximation l (rotationReturns r).q_pos hk hkQ
      (rotationReturns r).determinant (rotationReturns r).lower_pos (rotationReturns r).upper_pos
  exact short_lifted_visits_separated hap hmn
    ⟨hm'.1, by linarith [hm'.2]⟩ ⟨hn'.1, by linarith [hn'.2]⟩

def jumpVisit3_separated (r : ℕ) (i : Fin 4) {m n : ℕ} (hmn : m < n)
    (hm : jumpVisit3 r i m ≠ 0) (hn : jumpVisit3 r i n ≠ 0) :
    (rotationReturns r).P.toNat ≤ n - m := by
  have hm' := backwardJump_lift hm
  have hn' := backwardJump_lift hn
  simp only [Int.cast_natCast] at hm' hn'
  have hap (k : ℕ) (hk : 0 < k) (hkP : k < (rotationReturns r).P.toNat) (l : ℤ) :
      returnError r / rotationSlope ≤ |(k : ℝ) * (1 / rotationSlope) - l| := by
    simpa only [returnError, mul_one_div] using (rotationReturns r).reciprocal_best_approximation
      rotationSlope_bounds.1 rotationSlope_bounds.2 hk hkP l
  apply short_lifted_visits_separated hap hmn
  · simpa only [mul_one_div] using hm'
  · simpa only [mul_one_div] using hn'

def jumpVisit4_time_separation (r : ℕ) (i : Fin 4) {m n : ℕ} (hmn : m < n)
    (hm : jumpVisit4 r i m ≠ 0) (hn : jumpVisit4 r i n ≠ 0) :
    returnScale r / 2 ≤ (n : ℝ) * Real.log 4 - (m : ℝ) * Real.log 4 := by
  have hh : ((rotationReturns r).Q : ℝ) ≤ ((n - m : ℕ) : ℝ) := by
    exact_mod_cast jumpVisit4_separated r i hmn hm hn
  rw [Nat.cast_sub hmn.le] at hh
  have hl := mul_le_mul_of_nonneg_right hh (Real.log_pos (by norm_num : (1 : ℝ) < 4)).le
  have hs := (returnScale_bounds r).2.2.1
  nlinarith

def jumpVisit3_time_separation (r : ℕ) (i : Fin 4) {m n : ℕ} (hmn : m < n)
    (hm : jumpVisit3 r i m ≠ 0) (hn : jumpVisit3 r i n ≠ 0) :
    returnScale r ≤ (n : ℝ) * Real.log 3 - (m : ℝ) * Real.log 3 := by
  have hh : ((rotationReturns r).P.toNat : ℝ) ≤ ((n - m : ℕ) : ℝ) := by
    exact_mod_cast jumpVisit3_separated r i hmn hm hn
  have hP : 0 ≤ (rotationReturns r).P := by
    have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
    have hQ := (rotationReturns r).Q_pos
    omega
  have he : ((rotationReturns r).P.toNat : ℝ) = (rotationReturns r).P := by
    exact_mod_cast Int.toNat_of_nonneg hP
  rw [he, Nat.cast_sub hmn.le] at hh
  have hl := mul_le_mul_of_nonneg_right hh (Real.log_pos (by norm_num : (1 : ℝ) < 3)).le
  unfold returnScale
  nlinarith


end Bounty

end SubmissionComponent_JumpVisitSpacing

/- Component ReturnEventFamilies; SHA256 a1cf329568775017fa1aa72bfa6a0c7d16f966cd9063e9e14ef9893f00158656 -/
section SubmissionComponent_ReturnEventFamilies
/- The sixteen logarithmic event sequences of the exact remainder, and their two cutoffs. -/

namespace Bounty

abbrev ReturnEventFamily := Fin 4 × Fin 4

noncomputable def returnEventStep (i : ReturnEventFamily) : ℝ :=
  if i.1 < 2 then Real.log 4 else Real.log 3

noncomputable def returnEventOffset (r : ℕ) (i : ReturnEventFamily) : ℝ :=
  if i.1 = 0 then ((rotationReturns r).p.toNat : ℝ) * Real.log 3
  else if i.1 = 2 then ((rotationReturns r).q : ℝ) * Real.log 4 else 0

noncomputable def returnEventVisit (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : Prop :=
  0 < n ∧ if i.1 < 2 then jumpVisit4 r i.2 n ≠ 0 else jumpVisit3 r i.2 n ≠ 0

noncomputable def returnEventTime (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : ℝ :=
  (n : ℝ) * returnEventStep i - returnEventOffset r i

def returnEventStep_pos (i : ReturnEventFamily) : 0 < returnEventStep i := by
  unfold returnEventStep
  split <;> exact Real.log_pos (by norm_num)

def returnEventVisit_separation (r : ℕ) (i : ReturnEventFamily) {m n : ℕ}
    (hm : returnEventVisit r i m) (hn : returnEventVisit r i n) (hmn : m < n) :
    returnScale r / 2 ≤ (n : ℝ) * returnEventStep i - (m : ℝ) * returnEventStep i := by
  by_cases hi : i.1 < 2
  · have hm' : jumpVisit4 r i.2 m ≠ 0 := by
      simpa only [returnEventVisit, if_pos hi] using hm.2
    have hn' : jumpVisit4 r i.2 n ≠ 0 := by
      simpa only [returnEventVisit, if_pos hi] using hn.2
    simpa only [returnEventStep, if_pos hi] using jumpVisit4_time_separation r i.2 hmn hm' hn'
  · have hm' : jumpVisit3 r i.2 m ≠ 0 := by
      simpa only [returnEventVisit, if_neg hi] using hm.2
    have hn' : jumpVisit3 r i.2 n ≠ 0 := by
      simpa only [returnEventVisit, if_neg hi] using hn.2
    have hh := jumpVisit3_time_separation r i.2 hmn hm' hn'
    simp only [returnEventStep, if_neg hi]
    linarith [returnScale_pos r]

def returnEventTime_gap (r : ℕ) (a : ℝ) :
    ∃ t : ℝ, a < t ∧ t + returnScale r / 0x64 < a + returnScale r ∧
      ∀ i n, returnEventVisit r i n →
        returnEventTime r i n < t ∨ t + returnScale r / 0x64 < returnEventTime r i n := by
  exact linear_event_families_gap (by norm_num : Fintype.card ReturnEventFamily ≤ 16)
    returnEventStep (returnEventOffset r) (returnEventVisit r) returnEventStep_pos
    (returnScale_pos r) (fun i m n hm hn hmn => returnEventVisit_separation r i hm hn hmn) a

end Bounty

end SubmissionComponent_ReturnEventFamilies

/- Component IntegerIndexSeries; SHA256 d133e28f528910f2edf079b063475b8b14584c1ee4f35c9fcb3f6eedcbb2716f -/
section SubmissionComponent_IntegerIndexSeries
/- Weighted series under the integer shifts occurring in the jump-orbit tables. -/

namespace Bounty

noncomputable def integerIndexSeries (b : ℝ) (f : ℤ → ℝ) : ℝ :=
  ∑' n : ℕ, f (n : ℤ) / b ^ n

def integerIndexSeries_summable {b M : ℝ} {f : ℤ → ℝ}
    (hb : 1 < b) (hf : ∀ k, |f k| ≤ M) :
    Summable (fun n : ℕ => f (n : ℤ) / b ^ n) :=
  weighted_summable hb (fun n => hf (n : ℤ))

def integerIndexSeries_up_one {b M : ℝ} {f : ℤ → ℝ}
    (hb : 1 < b) (hf : ∀ k, |f k| ≤ M) :
    integerIndexSeries b (fun k => f (k + 1)) =
      b * (integerIndexSeries b f - f 0) := by
  have hb0 : b ≠ 0 := ne_of_gt (by linarith : 0 < b)
  have ht := hasSum_nat_tail_sub (integerIndexSeries_summable hb hf)
  simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, pow_zero, div_one] at ht
  have hs : HasSum (fun n : ℕ => f ((n : ℤ) + 1) / b ^ n)
      (b * (integerIndexSeries b f - f 0)) := by
    apply (ht.mul_left b).congr_fun
    intro n
    rw [pow_succ]
    field_simp
  exact hs.tsum_eq

def integerIndexSeries_down_one {b M : ℝ} {f : ℤ → ℝ}
    (hb : 1 < b) (hf : ∀ k, |f k| ≤ M) :
    integerIndexSeries b (fun k => f (k - 1)) =
      f (-1) + integerIndexSeries b f / b := by
  have hb0 : b ≠ 0 := ne_of_gt (by linarith : 0 < b)
  have hh := integerIndexSeries_up_one hb (fun k => hf (k - 1))
  simp only [add_sub_cancel_right, zero_sub] at hh
  field_simp
  nlinarith

def integerIndexSeries_down_two {b M : ℝ} {f : ℤ → ℝ}
    (hb : 1 < b) (hf : ∀ k, |f k| ≤ M) :
    integerIndexSeries b (fun k => f (k - 2)) =
      f (-2) + f (-1) / b + integerIndexSeries b f / b ^ 2 := by
  have hh := integerIndexSeries_down_one hb (fun k => hf (k - 1))
  change integerIndexSeries b (fun k => f ((k - 1) - 1)) =
    f ((-1 : ℤ) - 1) + integerIndexSeries b (fun k => f (k - 1)) / b at hh
  have he : (fun k : ℤ => f ((k - 1) - 1)) = (fun k : ℤ => f (k - 2)) := by
    funext k
    congr 1
    ring
  rw [he, show (-1 : ℤ) - 1 = -2 by norm_num, integerIndexSeries_down_one hb hf] at hh
  rw [hh]
  simp only [add_div, div_div, pow_two]
  ring


end Bounty

end SubmissionComponent_IntegerIndexSeries

/- Component CoefficientSteps; SHA256 cda139637f48df8ce7e69bceeb02a0b5dd738c31128953a15331ddb9b494e5d3 -/
section SubmissionComponent_CoefficientSteps
/- Write both coefficient tables as finite sums of circular steps. -/

namespace Bounty

noncomputable def coefficientCut (a c x : ℝ) : ℤ := by
  classical
  exact if a * x < c then 0 else 1

def realCoefficient4_eq_cuts (x : ℝ) :
    realCoefficient4 x = 78 - 48 * coefficientCut 15 16 x - 60 * coefficientCut 9 10 x +
      60 * coefficientCut 3 4 x - 30 * coefficientCut 2 3 x -
      60 * coefficientCut 1 2 x + 48 * coefficientCut 3 8 x := by
  classical
  simp only [realCoefficient4, coefficientCut, one_mul]
  split_ifs <;> norm_num at * <;> linarith

def realCoefficient3_eq_cuts (x : ℝ) :
    realCoefficient3 x = 30 + 5 * coefficientCut 3 4 x - 6 * coefficientCut 5 8 x -
      5 * coefficientCut 3 5 x - 84 * coefficientCut 1 2 x := by
  classical
  simp only [realCoefficient3, coefficientCut, one_mul]
  split_ifs <;> norm_num at * <;> linarith

def circleStep_logb_cut {a b c : ℝ} (ha : 0 < a) (hb : 1 < b) (hc : 0 < c)
    (x : ℝ) : circleStep (Real.logb b (c / a)) x = coefficientCut a c (b ^ Int.fract x) := by
  classical
  have hh : Real.logb b (c / a) ≤ Int.fract x ↔ c ≤ a * b ^ Int.fract x := by
    rw [Real.logb_le_iff_le_rpow hb (div_pos hc ha), div_le_iff₀ ha, mul_comm]
  simp only [circleStep, coefficientCut, hh]
  by_cases h : a * b ^ Int.fract x < c
  · simp only [h, if_true, not_le_of_gt h, if_false]
  · simp only [h, if_false, le_of_not_gt h, if_true]

def coefficient4_circle_steps (x : ℝ) :
    realCoefficient4 ((3 : ℝ) ^ Int.fract x) =
      78 - 48 * circleStep (Real.logb 3 (16 / 15)) x -
      60 * circleStep (Real.logb 3 (10 / 9)) x +
      60 * circleStep (Real.logb 3 (4 / 3)) x -
      30 * circleStep (Real.logb 3 (3 / 2)) x -
      60 * circleStep (Real.logb 3 2) x +
      48 * circleStep (Real.logb 3 (8 / 3)) x := by
  rw [realCoefficient4_eq_cuts]
  have hh (a c : ℝ) (ha : 0 < a) (hc : 0 < c) := circleStep_logb_cut ha
    (by norm_num : (1 : ℝ) < 3) hc x
  rw [hh 15 16 (by norm_num) (by norm_num), hh 9 10 (by norm_num) (by norm_num),
    hh 3 4 (by norm_num) (by norm_num), hh 2 3 (by norm_num) (by norm_num),
    hh 3 8 (by norm_num) (by norm_num)]
  have h2 := hh 1 2 (by norm_num) (by norm_num)
  norm_num only [div_one] at h2
  rw [h2]

def coefficient3_circle_steps (x : ℝ) :
    realCoefficient3 ((4 : ℝ) ^ Int.fract x) =
      30 + 5 * circleStep (Real.logb 4 (4 / 3)) x -
      6 * circleStep (Real.logb 4 (8 / 5)) x -
      5 * circleStep (Real.logb 4 (5 / 3)) x -
      84 * circleStep (Real.logb 4 2) x := by
  rw [realCoefficient3_eq_cuts]
  have hh (a c : ℝ) (ha : 0 < a) (hc : 0 < c) := circleStep_logb_cut ha
    (by norm_num : (1 : ℝ) < 4) hc x
  rw [hh 3 4 (by norm_num) (by norm_num), hh 5 8 (by norm_num) (by norm_num),
    hh 3 5 (by norm_num) (by norm_num)]
  have h2 := hh 1 2 (by norm_num) (by norm_num)
  norm_num only [div_one] at h2
  rw [h2]


end Bounty

end SubmissionComponent_CoefficientSteps

/- Component CoefficientJumps; SHA256 a74467303ff4aae8b31420d73b1a499539d0143b77423f2d12f22dd5e77d67b7 -/
section SubmissionComponent_CoefficientJumps
/- Exact signed jump identities for the two coefficient tables. -/

namespace Bounty

def logb_unit_interval {b y : ℝ} (hb : 1 < b) (hy : 1 ≤ y) (hyb : y < b) :
    0 ≤ Real.logb b y ∧ Real.logb b y < 1 := by
  refine ⟨Real.logb_nonneg hb hy, ?_⟩
  apply (Real.logb_lt_iff_lt_rpow hb (by linarith : 0 < y)).mpr
  simpa only [Real.rpow_one] using hyb

def coefficient4_forward_jumps {δ : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    realCoefficient4 ((3 : ℝ) ^ Int.fract (x + δ)) -
      realCoefficient4 ((3 : ℝ) ^ Int.fract x) =
      90 * forwardJump δ 0 x - 48 * forwardJump δ (Real.logb 3 (16 / 15)) x -
      60 * forwardJump δ (Real.logb 3 (10 / 9)) x +
      60 * forwardJump δ (Real.logb 3 (4 / 3)) x -
      30 * forwardJump δ (Real.logb 3 (3 / 2)) x -
      60 * forwardJump δ (Real.logb 3 2) x +
      48 * forwardJump δ (Real.logb 3 (8 / 3)) x := by
  rw [coefficient4_circle_steps, coefficient4_circle_steps]
  have hh (y : ℝ) (hy : 1 ≤ y) (hyb : y < 3) :=
    logb_unit_interval (by norm_num : (1 : ℝ) < 3) hy hyb
  have h1 := hh (16 / 15) (by norm_num) (by norm_num)
  have h2 := hh (10 / 9) (by norm_num) (by norm_num)
  have h3 := hh (4 / 3) (by norm_num) (by norm_num)
  have h4 := hh (3 / 2) (by norm_num) (by norm_num)
  have h5 := hh 2 (by norm_num) (by norm_num)
  have h6 := hh (8 / 3) (by norm_num) (by norm_num)
  have he1 := circleStep_forward_difference h1.1 h1.2 hd0 hd1 x
  have he2 := circleStep_forward_difference h2.1 h2.2 hd0 hd1 x
  have he3 := circleStep_forward_difference h3.1 h3.2 hd0 hd1 x
  have he4 := circleStep_forward_difference h4.1 h4.2 hd0 hd1 x
  have he5 := circleStep_forward_difference h5.1 h5.2 hd0 hd1 x
  have he6 := circleStep_forward_difference h6.1 h6.2 hd0 hd1 x
  omega

def coefficient3_backward_jumps {δ : ℝ} (hd0 : 0 ≤ δ) (hd1 : δ < 1) (x : ℝ) :
    realCoefficient3 ((4 : ℝ) ^ Int.fract (x - δ)) -
      realCoefficient3 ((4 : ℝ) ^ Int.fract x) =
      -90 * backwardJump δ 0 x - 5 * backwardJump δ (Real.logb 4 (4 / 3)) x +
      6 * backwardJump δ (Real.logb 4 (8 / 5)) x +
      5 * backwardJump δ (Real.logb 4 (5 / 3)) x +
      84 * backwardJump δ (Real.logb 4 2) x := by
  rw [coefficient3_circle_steps, coefficient3_circle_steps]
  have hh (y : ℝ) (hy : 1 ≤ y) (hyb : y < 4) :=
    logb_unit_interval (by norm_num : (1 : ℝ) < 4) hy hyb
  have h1 := hh (4 / 3) (by norm_num) (by norm_num)
  have h2 := hh (8 / 5) (by norm_num) (by norm_num)
  have h3 := hh (5 / 3) (by norm_num) (by norm_num)
  have h4 := hh 2 (by norm_num) (by norm_num)
  have he1 := circleStep_backward_difference h1.1 h1.2 hd0 hd1 x
  have he2 := circleStep_backward_difference h2.1 h2.2 hd0 hd1 x
  have he3 := circleStep_backward_difference h3.1 h3.2 hd0 hd1 x
  have he4 := circleStep_backward_difference h4.1 h4.2 hd0 hd1 x
  omega


end Bounty

end SubmissionComponent_CoefficientJumps

/- Component CoefficientReturnShifts; SHA256 4512f73aaabb9cb35501f37f574b23b006cf0934f440d74d2b75747eb5d141cd -/
section SubmissionComponent_CoefficientReturnShifts
/- Relate integer index shifts to the small positive and negative rotations. -/

namespace Bounty

def coefficient4_return_shift (r n : ℕ) :
    coefficient4 (n + (rotationReturns r).q) =
      realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope + returnError r)) := by
  rw [coefficient4_rotation]
  have he : ((n + (rotationReturns r).q : ℕ) : ℝ) * rotationSlope =
      ((n : ℝ) * rotationSlope + returnError r) + (rotationReturns r).p := by
    dsimp only [returnError]
    push_cast
    ring
  rw [he, Int.fract_add_intCast]

def coefficient3_return_shift (r n : ℕ) :
    coefficient3 (n + (rotationReturns r).p.toNat) =
      realCoefficient3 ((4 : ℝ) ^ Int.fract
        ((n : ℝ) / rotationSlope - returnError r / rotationSlope)) := by
  rw [coefficient3_rotation]
  have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
  have hq := (rotationReturns r).q_pos
  have hp : 0 ≤ (rotationReturns r).p := by omega
  have hpR : ((rotationReturns r).p.toNat : ℝ) = (rotationReturns r).p := by
    exact_mod_cast Int.toNat_of_nonneg hp
  have hα : rotationSlope ≠ 0 := ne_of_gt (by linarith [rotationSlope_bounds.1])
  have he : ((n + (rotationReturns r).p.toNat : ℕ) : ℝ) / rotationSlope =
      ((n : ℝ) / rotationSlope - returnError r / rotationSlope) +
        (((rotationReturns r).q : ℤ) : ℝ) := by
    dsimp only [returnError]
    rw [Nat.cast_add, hpR, Int.cast_natCast]
    field_simp
    <;> ring
  rw [he, Int.fract_add_intCast]

def reciprocal_returnError_lt_one (r : ℕ) : returnError r / rotationSlope < 1 := by
  have hα : 0 < rotationSlope := by linarith [rotationSlope_bounds.1]
  apply (div_lt_iff₀ hα).mpr
  linarith [returnError_lt_one r, rotationSlope_bounds.1]

def coefficient4_difference_is_forward (r n : ℕ) :
    coefficient4 (n + (rotationReturns r).q) - coefficient4 n =
      realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope + returnError r)) -
      realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope)) := by
  rw [coefficient4_return_shift, coefficient4_rotation n]

def coefficient3_difference_is_backward (r n : ℕ) :
    coefficient3 (n + (rotationReturns r).p.toNat) - coefficient3 n =
      realCoefficient3 ((4 : ℝ) ^ Int.fract
        ((n : ℝ) / rotationSlope - returnError r / rotationSlope)) -
      realCoefficient3 ((4 : ℝ) ^ Int.fract ((n : ℝ) / rotationSlope)) := by
  rw [coefficient3_return_shift, coefficient3_rotation n]


end Bounty

end SubmissionComponent_CoefficientReturnShifts

/- Component JumpCoordinateShifts; SHA256 ec4bc4c901ccebe73af2f6e63d4c551317e7a5dd72690af963574f2af9bf5e62 -/
section SubmissionComponent_JumpCoordinateShifts
/- Exact orbit shifts of every discontinuity in the coefficient tables. -/

namespace Bounty

def logb_monomial {a b r : ℝ} (ha : 0 < a) (hb : 1 < b) (hr : 0 < r)
    (k l : ℤ) :
    Real.logb b (r * (a ^ k * b ^ l)) =
      Real.logb b r + (k : ℝ) * (Real.log a / Real.log b) + l := by
  have hlog : Real.log b ≠ 0 := ne_of_gt (Real.log_pos hb)
  have hak : 0 < a ^ k := zpow_pos ha k
  have hbl : 0 < b ^ l := zpow_pos (by linarith) l
  simp only [Real.logb]
  rw [Real.log_mul (ne_of_gt hr) (ne_of_gt (mul_pos hak hbl)),
    Real.log_mul (ne_of_gt hak) (ne_of_gt hbl), Real.log_zpow, Real.log_zpow]
  field_simp
  ring

def jumpCoordinate4_table :
    jumpCoordinate4 = ![0, Real.logb 3 2, Real.logb 3 (9 / 5), Real.logb 3 (10 / 9)] := by
  funext i
  fin_cases i <;> norm_num [jumpCoordinate4, jumpRepresentative4_table, Real.logb]

def jumpCoordinate3_table :
    jumpCoordinate3 = ![0, Real.logb 4 2, Real.logb 4 (8 / 5), Real.logb 4 (5 / 4)] := by
  funext i
  fin_cases i <;> norm_num [jumpCoordinate3, jumpRepresentative3_table, Real.logb]

def jump4_four_thirds : Real.logb 3 (4 / 3) = jumpCoordinate4 0 + rotationSlope - 1 := by
  have hh := logb_monomial (a := 4) (b := 3) (r := 1)
    (by norm_num) (by norm_num) (by norm_num) 1 (-1)
  norm_num at hh
  simpa [jumpCoordinate4_zero, rotationSlope, sub_eq_add_neg] using hh

def jump4_three_halves : Real.logb 3 (3 / 2) = jumpCoordinate4 1 - rotationSlope + 1 := by
  have hh := logb_monomial (a := 4) (b := 3) (r := 2)
    (by norm_num) (by norm_num) (by norm_num) (-1) 1
  norm_num at hh
  simpa [jumpCoordinate4_table, rotationSlope, sub_eq_add_neg] using hh

def jump4_eight_thirds : Real.logb 3 (8 / 3) = jumpCoordinate4 1 + rotationSlope - 1 := by
  have hh := logb_monomial (a := 4) (b := 3) (r := 2)
    (by norm_num) (by norm_num) (by norm_num) 1 (-1)
  norm_num at hh
  simpa [jumpCoordinate4_table, rotationSlope, sub_eq_add_neg] using hh

def jump4_sixteen_fifteenths :
    Real.logb 3 (16 / 15) = jumpCoordinate4 2 + 2 * rotationSlope - 3 := by
  have hh := logb_monomial (a := 4) (b := 3) (r := 9 / 5)
    (by norm_num) (by norm_num) (by norm_num) 2 (-3)
  norm_num at hh
  simpa [jumpCoordinate4_table, rotationSlope, sub_eq_add_neg] using hh

def jump3_four_thirds :
    Real.logb 4 (4 / 3) = jumpCoordinate3 0 - (1 / rotationSlope) + 1 := by
  have hh := logb_monomial (a := 3) (b := 4) (r := 1)
    (by norm_num) (by norm_num) (by norm_num) (-1) 1
  norm_num at hh
  rw [← inverse_rotationSlope]
  simpa [jumpCoordinate3_zero, Real.logb, sub_eq_add_neg] using hh

def jump3_five_thirds :
    Real.logb 4 (5 / 3) = jumpCoordinate3 3 - (1 / rotationSlope) + 1 := by
  have hh := logb_monomial (a := 3) (b := 4) (r := 5 / 4)
    (by norm_num) (by norm_num) (by norm_num) (-1) 1
  norm_num at hh
  rw [← inverse_rotationSlope]
  simpa [jumpCoordinate3_table, Real.logb, sub_eq_add_neg] using hh


end Bounty

end SubmissionComponent_JumpCoordinateShifts

/- Component OrbitJumpTables; SHA256 521809bd0966883052522674b4be7dc5558fd79ceac6d4f08a37ba5fdd44479f -/
section SubmissionComponent_OrbitJumpTables
/- Rewrite the signed coefficient jumps in the four representative orbits. -/

namespace Bounty

def forwardJump_two_shifts (δ t α : ℝ) (n k l : ℤ) :
    forwardJump δ (t + (k : ℝ) * α + l) ((n : ℝ) * α) =
      forwardJump δ t (((n - k : ℤ) : ℝ) * α) := by
  rw [forwardJump_integer_shift, forwardJump_orbit_shift]

def backwardJump_two_shifts (δ t α : ℝ) (n k l : ℤ) :
    backwardJump δ (t + (k : ℝ) * α + l) ((n : ℝ) * α) =
      backwardJump δ t (((n - k : ℤ) : ℝ) * α) := by
  rw [backwardJump_integer_shift, backwardJump_orbit_shift]

def coefficient4_forward_visits (r : ℕ) (n : ℤ) :
    realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope + returnError r)) -
      realCoefficient4 ((3 : ℝ) ^ Int.fract ((n : ℝ) * rotationSlope)) =
      90 * jumpVisit4 r 0 n - 48 * jumpVisit4 r 2 (n - 2) - 60 * jumpVisit4 r 3 n +
      60 * jumpVisit4 r 0 (n - 1) - 30 * jumpVisit4 r 1 (n + 1) -
      60 * jumpVisit4 r 1 n + 48 * jumpVisit4 r 1 (n - 1) := by
  rw [coefficient4_forward_jumps (returnError_pos r).le (returnError_lt_one r)]
  have hs (t : ℝ) (k l : ℤ) :=
    forwardJump_two_shifts (returnError r) t rotationSlope n k l
  have h0 : forwardJump (returnError r) 0 ((n : ℝ) * rotationSlope) = jumpVisit4 r 0 n := by
    simp only [jumpVisit4, jumpCoordinate4_zero]
  have h16 : forwardJump (returnError r) (Real.logb 3 (16 / 15)) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 2 (n - 2) := by
    rw [jump4_sixteen_fifteenths]
    simpa only [jumpVisit4, Int.cast_ofNat, Int.cast_neg, sub_eq_add_neg] using
      hs (jumpCoordinate4 2) 2 (-3)
  have h10 : forwardJump (returnError r) (Real.logb 3 (10 / 9)) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 3 n := by
    have ht : jumpCoordinate4 3 = Real.logb 3 (10 / 9) := by rw [jumpCoordinate4_table]; rfl
    simp only [jumpVisit4, ht]
  have h4 : forwardJump (returnError r) (Real.logb 3 (4 / 3)) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 0 (n - 1) := by
    rw [jump4_four_thirds]
    simpa only [jumpVisit4, Int.cast_one, Int.cast_neg, one_mul, sub_eq_add_neg] using
      hs (jumpCoordinate4 0) 1 (-1)
  have h3 : forwardJump (returnError r) (Real.logb 3 (3 / 2)) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 1 (n + 1) := by
    rw [jump4_three_halves]
    simpa only [jumpVisit4, Int.cast_one, Int.cast_neg, neg_one_mul, sub_neg_eq_add,
      sub_eq_add_neg, neg_neg] using hs (jumpCoordinate4 1) (-1) 1
  have h2 : forwardJump (returnError r) (Real.logb 3 2) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 1 n := by
    have ht : jumpCoordinate4 1 = Real.logb 3 2 := by rw [jumpCoordinate4_table]; rfl
    simp only [jumpVisit4, ht]
  have h8 : forwardJump (returnError r) (Real.logb 3 (8 / 3)) ((n : ℝ) * rotationSlope) =
      jumpVisit4 r 1 (n - 1) := by
    rw [jump4_eight_thirds]
    simpa only [jumpVisit4, Int.cast_one, Int.cast_neg, one_mul, sub_eq_add_neg] using
      hs (jumpCoordinate4 1) 1 (-1)
  rw [h0, h16, h10, h4, h3, h2, h8]

def coefficient3_backward_visits (r : ℕ) (n : ℤ) :
    realCoefficient3 ((4 : ℝ) ^ Int.fract
        ((n : ℝ) / rotationSlope - returnError r / rotationSlope)) -
      realCoefficient3 ((4 : ℝ) ^ Int.fract ((n : ℝ) / rotationSlope)) =
      -90 * jumpVisit3 r 0 n - 5 * jumpVisit3 r 0 (n + 1) + 6 * jumpVisit3 r 2 n +
      5 * jumpVisit3 r 3 (n + 1) + 84 * jumpVisit3 r 1 n := by
  have hd : 0 ≤ returnError r / rotationSlope :=
    div_nonneg (returnError_pos r).le (by linarith [rotationSlope_bounds.1])
  rw [coefficient3_backward_jumps hd (reciprocal_returnError_lt_one r)]
  have hs (t : ℝ) (k l : ℤ) :=
    backwardJump_two_shifts (returnError r / rotationSlope) t (1 / rotationSlope) n k l
  have h0 : backwardJump (returnError r / rotationSlope) 0 ((n : ℝ) / rotationSlope) =
      jumpVisit3 r 0 n := by
    simp only [jumpVisit3, jumpCoordinate3_zero]
  have h4 : backwardJump (returnError r / rotationSlope) (Real.logb 4 (4 / 3))
      ((n : ℝ) / rotationSlope) = jumpVisit3 r 0 (n + 1) := by
    rw [jump3_four_thirds]
    simpa only [jumpVisit3, Int.cast_one, Int.cast_neg, neg_one_mul, sub_neg_eq_add,
      sub_eq_add_neg, mul_one_div, neg_neg, neg_div] using hs (jumpCoordinate3 0) (-1) 1
  have h8 : backwardJump (returnError r / rotationSlope) (Real.logb 4 (8 / 5))
      ((n : ℝ) / rotationSlope) = jumpVisit3 r 2 n := by
    have ht : jumpCoordinate3 2 = Real.logb 4 (8 / 5) := by rw [jumpCoordinate3_table]; rfl
    simp only [jumpVisit3, ht]
  have h5 : backwardJump (returnError r / rotationSlope) (Real.logb 4 (5 / 3))
      ((n : ℝ) / rotationSlope) = jumpVisit3 r 3 (n + 1) := by
    rw [jump3_five_thirds]
    simpa only [jumpVisit3, Int.cast_one, Int.cast_neg, neg_one_mul, sub_neg_eq_add,
      sub_eq_add_neg, mul_one_div, neg_neg, neg_div] using hs (jumpCoordinate3 3) (-1) 1
  have h2 : backwardJump (returnError r / rotationSlope) (Real.logb 4 2)
      ((n : ℝ) / rotationSlope) = jumpVisit3 r 1 n := by
    have ht : jumpCoordinate3 1 = Real.logb 4 2 := by rw [jumpCoordinate3_table]; rfl
    simp only [jumpVisit3, ht]
  rw [h0, h4, h8, h5, h2]

def coefficient4_return_visits (r n : ℕ) :
    coefficient4 (n + (rotationReturns r).q) - coefficient4 n =
      90 * jumpVisit4 r 0 n - 48 * jumpVisit4 r 2 ((n : ℤ) - 2) - 60 * jumpVisit4 r 3 n +
      60 * jumpVisit4 r 0 ((n : ℤ) - 1) - 30 * jumpVisit4 r 1 ((n : ℤ) + 1) -
      60 * jumpVisit4 r 1 n + 48 * jumpVisit4 r 1 ((n : ℤ) - 1) := by
  rw [coefficient4_difference_is_forward]
  simpa only [Int.cast_natCast] using coefficient4_forward_visits r (n : ℤ)

def coefficient3_return_visits (r n : ℕ) :
    coefficient3 (n + (rotationReturns r).p.toNat) - coefficient3 n =
      -90 * jumpVisit3 r 0 n - 5 * jumpVisit3 r 0 ((n : ℤ) + 1) + 6 * jumpVisit3 r 2 n +
      5 * jumpVisit3 r 3 ((n : ℤ) + 1) + 84 * jumpVisit3 r 1 n := by
  rw [coefficient3_difference_is_backward]
  simpa only [Int.cast_natCast] using coefficient3_backward_visits r (n : ℤ)


end Bounty

end SubmissionComponent_OrbitJumpTables

/- Component GroupedJumpSeries; SHA256 3a7f84ffb11af317c8912946eaa4f361e37dfad83e9a68b4d66e08024175e7d8 -/
section SubmissionComponent_GroupedJumpSeries
/- Group the weighted jumps by representative orbit, including all initial terms. -/

open Filter
open scoped Topology

namespace Bounty

def jumpVisit4_abs_le_one (r : ℕ) (i : Fin 4) (n : ℤ) :
    |(jumpVisit4 r i n : ℝ)| ≤ 1 := by
  classical
  unfold jumpVisit4 forwardJump
  split <;> norm_num

def jumpVisit3_abs_le_one (r : ℕ) (i : Fin 4) (n : ℤ) :
    |(jumpVisit3 r i n : ℝ)| ≤ 1 := by
  classical
  unfold jumpVisit3 backwardJump
  split <;> norm_num

noncomputable def positiveJumpSeries4 (r : ℕ) (i : Fin 4) : ℝ :=
  ∑' n : ℕ, (jumpVisit4 r i (n + 1) : ℝ) / (4 : ℝ) ^ (n + 1)

noncomputable def positiveJumpSeries3 (r : ℕ) (i : Fin 4) : ℝ :=
  ∑' n : ℕ, (jumpVisit3 r i (n + 1) : ℝ) / (3 : ℝ) ^ (n + 1)

def positiveJumpSeries4_eq (r : ℕ) (i : Fin 4) :
    positiveJumpSeries4 r i =
      integerIndexSeries 4 (fun k => (jumpVisit4 r i k : ℝ)) - jumpVisit4 r i 0 := by
  have hh := hasSum_nat_tail_sub
    (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 4) (jumpVisit4_abs_le_one r i))
  simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, pow_zero, div_one] at hh
  exact hh.tsum_eq

def positiveJumpSeries3_eq (r : ℕ) (i : Fin 4) :
    positiveJumpSeries3 r i =
      integerIndexSeries 3 (fun k => (jumpVisit3 r i k : ℝ)) - jumpVisit3 r i 0 := by
  have hh := hasSum_nat_tail_sub
    (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 3) (jumpVisit3_abs_le_one r i))
  simp only [Nat.cast_add, Nat.cast_one, Nat.cast_zero, pow_zero, div_one] at hh
