def closureNodeType (eps : Bool) (k : ℕ) : Bool := if (closureNode k).i = 0 then eps else true

def closureNodeFour (k : ℕ) (X : ℚ) : ℚ :=
  normalizedPowerCoordinate 4 (closureNode k).scale4 (closureNode k).v X

def closureNodeThree (k : ℕ) (Y : ℚ) : ℚ :=
  normalizedPowerCoordinate 3 (closureNode k).scale3 (closureNode k).v Y

def closureLossFour (k : ℕ) (X : ℚ) : ℚ :=
  normalizedPowerCoordinate 4 (closureNode k).lossScale4 (5 * (closureNode k).v) X

def closureLossThree (k : ℕ) (Y : ℚ) : ℚ :=
  normalizedPowerCoordinate 3 (closureNode k).lossScale3 (5 * (closureNode k).v) Y

noncomputable def closureNodeTrial (eps : Bool) (k phase : ℕ) (X Y : ℚ)
    (p : ℕ → Prop) (r : ℕ → ℚ) : ℚ :=
  normalizedTrialValue (closureNodeType eps k) phase
    (closurePhase (p (closureNode k).child5)) (closurePhase (p (closureNode k).child7))
    (closureNode k).v (closureNodeFour k X) (closureNodeThree k Y)
    (closureLossFour k X) (closureLossThree k Y) (r (closureNode k).child5) (r (closureNode k).child7)

noncomputable def closureNodeAvailable (eps : Bool) (k phase : ℕ) (X Y : ℚ)
    (p : ℕ → Prop) (r : ℕ → ℚ) : Prop :=
  normalizedStateValid (closureNodeType eps k) phase (closureNode k).v
    (closureNodeFour k X) (closureNodeThree k Y) (closureLossFour k X) (closureLossThree k Y)
    (closureNodeTrial eps k phase X Y p r)

noncomputable def closureNodeConstraint (eps : Bool) (k : ℕ) (X Y : ℚ)
    (p : ℕ → Prop) (r : ℕ → ℚ) : Prop := by
  classical
  exact if k = 0 then
    ¬closureNodeAvailable eps k 0 X Y p r ∧ ¬closureNodeAvailable eps k 1 X Y p r
  else if (closureNode k).leaf then
    3 * (closureNode k).v / 4 ≤ r k ∧
    if p k then normalizedStateValid (closureNodeType eps k) 1 (closureNode k).v
      (closureNodeFour k X) (closureNodeThree k Y) (closureLossFour k X) (closureLossThree k Y) (r k)
    else normalizedStateValid (closureNodeType eps k) 0 (closureNode k).v
      (closureNodeFour k X) (closureNodeThree k Y) (closureLossFour k X) (closureLossThree k Y) (r k)
  else
    (closureNodeAvailable eps k 0 X Y p r ∨ closureNodeAvailable eps k 1 X Y p r) ∧
    (p k ↔ if 2 * closureNodeFour k X ≤ (closureNode k).v
      then closureNodeAvailable eps k 1 X Y p r else ¬closureNodeAvailable eps k 0 X Y p r) ∧
    r k = if p k then closureNodeTrial eps k 1 X Y p r else closureNodeTrial eps k 0 X Y p r

noncomputable def ClosureRawHypothesis (eps : Bool) (X Y : ℚ) (p : ℕ → Prop) (r : ℕ → ℚ) : Prop :=
