  have hh := ((((((hs 0 0).mul_left 90).sub ((hs 2 (-2)).mul_left 48)).sub
    ((hs 3 0).mul_left 60)).add ((hs 0 (-1)).mul_left 60)).sub
    ((hs 1 1).mul_left 30)).sub ((hs 1 0).mul_left 60) |>.add ((hs 1 (-1)).mul_left 48)
  simp only [add_zero, ← sub_eq_add_neg] at hh
  apply HasSum.tsum_eq
  apply hh.congr_fun
  intro n
  rw [coefficient4_return_visits]
  push_cast
  ring

def coefficient3_return_series_raw (r : ℕ) :
    (∑' n : ℕ, ((coefficient3 (n + (rotationReturns r).p.toNat) - coefficient3 n : ℤ) : ℝ) /
        (3 : ℝ) ^ n) =
      -90 * integerIndexSeries 3 (fun k => (jumpVisit3 r 0 k : ℝ)) -
      5 * integerIndexSeries 3 (fun k => (jumpVisit3 r 0 (k + 1) : ℝ)) +
      6 * integerIndexSeries 3 (fun k => (jumpVisit3 r 2 k : ℝ)) +
      5 * integerIndexSeries 3 (fun k => (jumpVisit3 r 3 (k + 1) : ℝ)) +
      84 * integerIndexSeries 3 (fun k => (jumpVisit3 r 1 k : ℝ)) := by
  have hs (i : Fin 4) (k : ℤ) :=
    (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 3)
      (fun n => jumpVisit3_abs_le_one r i (n + k))).hasSum
  have hh := (((((hs 0 0).mul_left (-90)).sub ((hs 0 1).mul_left 5)).add
    ((hs 2 0).mul_left 6)).add ((hs 3 1).mul_left 5)).add ((hs 1 0).mul_left 84)
  simp only [add_zero] at hh
  apply HasSum.tsum_eq
  apply hh.congr_fun
  intro n
  rw [coefficient3_return_visits]
  push_cast
  ring

def coefficient4_return_series_grouped :
    ∀ᶠ r in atTop,
      (∑' n : ℕ, ((coefficient4 (n + (rotationReturns r).q) - coefficient4 n : ℤ) : ℝ) /
          (4 : ℝ) ^ n) =
        0x69 * positiveJumpSeries4 r 0 - 0xa8 * positiveJumpSeries4 r 1 -
        3 * positiveJumpSeries4 r 2 - 60 * positiveJumpSeries4 r 3 := by
