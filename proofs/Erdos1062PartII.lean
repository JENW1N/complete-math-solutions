/- Component RationalCertificate; SHA256 4bf290ccbdabe7b223ee62ecbc320e7beb70013a61188aa52647bbbf8aabd452 -/
section SubmissionComponent_RationalCertificate
/- Rational certificates give natural cutoff certificates without rounding gaps. -/

namespace Bounty

structure RationalCutoffCertificate (n : ℕ) where
  parity : ℕ → ℕ
  cutoff : ℕ → ℚ
  parity_lt : ∀ q ∈ coprimeCores n, parity q < 2
  cutoff_nonneg : ∀ q ∈ coprimeCores n, 0 ≤ cutoff q
  cutoff_bound : ∀ q ∈ coprimeCores n, cutoff q ≤ (n : ℚ) / q
  lower_bound : ∀ q ∈ coprimeCores n, 3 * ((n : ℚ) / q) ≤ 4 * cutoff q
  compatible_five : ∀ q ∈ coprimeCores n, 5 * q ∈ coprimeCores n →
    (if parity q = parity (5 * q) then 4 else 6) * cutoff (5 * q) ≤ cutoff q
  compatible_seven : ∀ q ∈ coprimeCores n, 7 * q ∈ coprimeCores n →
    (if parity q = parity (7 * q) then 4 else 6) * cutoff (7 * q) ≤ cutoff q
  quota : ∀ q ∈ coprimeCores n, cutoffCount (parity q) ⌊cutoff q⌋₊ = componentQuota n q

noncomputable def RationalCutoffCertificate.toNatural {n : ℕ} (C : RationalCutoffCertificate n) :
    CutoffCertificate n where
  parity := C.parity
  cutoff := fun q => ⌊C.cutoff q⌋₊
  parity_lt := C.parity_lt
  cutoff_bound := by
    intro q hq
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
    have hh := (Nat.floor_le (C.cutoff_nonneg q hq)).trans (C.cutoff_bound q hq)
    have hmul := (le_div_iff₀ (by exact_mod_cast hqpos : (0 : ℚ) < q)).mp hh
    exact_mod_cast (by nlinarith : (q : ℚ) * ⌊C.cutoff q⌋₊ ≤ n)
  lower_bound := by
    intro q hq s hs
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
    exact rationalWindow_scaled_eighth hqpos (C.lower_bound q hq) hs
  compatible_five := by
    intro q hq ht
    have hh := C.compatible_five q hq ht
    by_cases he : C.parity q = C.parity (5 * q)
    · simp only [he, ↓reduceIte] at hh ⊢
      exact floor_scaled_le (C.cutoff_nonneg (5 * q) ht) hh
    · simp only [he, ↓reduceIte] at hh ⊢
      exact floor_scaled_le (C.cutoff_nonneg (5 * q) ht) hh
  compatible_seven := by
    intro q hq ht
    have hh := C.compatible_seven q hq ht
    by_cases he : C.parity q = C.parity (7 * q)
    · simp only [he, ↓reduceIte] at hh ⊢
      exact floor_scaled_le (C.cutoff_nonneg (7 * q) ht) hh
    · simp only [he, ↓reduceIte] at hh ⊢
      exact floor_scaled_le (C.cutoff_nonneg (7 * q) ht) hh
  quota := C.quota

def f_eq_globalUpper_of_rational_certificate {n : ℕ} (C : RationalCutoffCertificate n) :
    Erdos1062.f n = globalUpper n := f_eq_globalUpper_of_certificate C.toNatural

end Bounty

end SubmissionComponent_RationalCertificate

/- Component RationalSystem; SHA256 b7de74307a5b0cd6cb43eb087dd137f3c1721f930d55f988aa2b75dce23b693e -/
section SubmissionComponent_RationalSystem
/- A universal two-type cutoff system suffices for every extremal problem size. -/

namespace Bounty

structure RationalCutoffSystem where
  parity : Bool → ℚ → ℕ
  cutoff : Bool → ℚ → ℚ
  parity_lt : ∀ eps u, 1 ≤ u → parity eps u < 2
  cutoff_nonneg : ∀ eps u, 1 ≤ u → 0 ≤ cutoff eps u
  cutoff_bound : ∀ eps u, 1 ≤ u → cutoff eps u ≤ u
  lower_bound : ∀ eps u, 1 ≤ u → 3 * u ≤ 4 * cutoff eps u
  compatible_five : ∀ eps u, 5 ≤ u →
    (if parity eps u = parity true (u / 5) then 4 else 6) * cutoff true (u / 5) ≤ cutoff eps u
  compatible_seven : ∀ eps u, 7 ≤ u →
    (if parity eps u = parity eps (u / 7) then 4 else 6) * cutoff eps (u / 7) ≤ cutoff eps u
  quota : ∀ eps u, 1 ≤ u → cutoffCount (parity eps u) ⌊cutoff eps u⌋₊ = rationalQuota eps u

noncomputable def RationalCutoffSystem.toCertificate (S : RationalCutoffSystem) (n : ℕ) :
    RationalCutoffCertificate n where
  parity := fun q => S.parity (decide (5 ∣ q)) ((n : ℚ) / q)
  cutoff := fun q => S.cutoff (decide (5 ∣ q)) ((n : ℚ) / q)
  parity_lt := fun q hq => S.parity_lt _ _ (quotient_ge_one_of_core_mem hq)
  cutoff_nonneg := fun q hq => S.cutoff_nonneg _ _ (quotient_ge_one_of_core_mem hq)
  cutoff_bound := fun q hq => S.cutoff_bound _ _ (quotient_ge_one_of_core_mem hq)
  lower_bound := fun q hq => S.lower_bound _ _ (quotient_ge_one_of_core_mem hq)
  compatible_five := by
    intro q hq ht
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
    have h5qn := (Finset.mem_Icc.mp (Finset.mem_filter.mp ht).1).2
    have hu : (5 : ℚ) ≤ (n : ℚ) / q := by
      apply (le_div_iff₀ (by exact_mod_cast hqpos : (0 : ℚ) < q)).mpr
      exact_mod_cast h5qn
    have hflag : decide (5 ∣ 5 * q) = true := by simp
    have hh := S.compatible_five (decide (5 ∣ q)) ((n : ℚ) / q) hu
    simpa only [rational_scaled_quotient, hflag, Nat.cast_ofNat] using hh
  compatible_seven := by
    intro q hq ht
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
    have h7qn := (Finset.mem_Icc.mp (Finset.mem_filter.mp ht).1).2
    have hu : (7 : ℚ) ≤ (n : ℚ) / q := by
      apply (le_div_iff₀ (by exact_mod_cast hqpos : (0 : ℚ) < q)).mpr
      exact_mod_cast h7qn
    have hd : (5 ∣ 7 * q) ↔ 5 ∣ q := by
      rw [(show Nat.Prime 5 by decide).dvd_mul]
      norm_num
    have hflag : decide (5 ∣ 7 * q) = decide (5 ∣ q) := by simp only [hd]
    have hh := S.compatible_seven (decide (5 ∣ q)) ((n : ℚ) / q) hu
    simpa only [rational_scaled_quotient, hflag, Nat.cast_ofNat] using hh
  quota := by
    intro q hq
    rw [componentQuota_eq_rationalQuota hq]
    exact S.quota _ _ (quotient_ge_one_of_core_mem hq)

def f_eq_globalUpper_of_system (S : RationalCutoffSystem) (n : ℕ) :
    Erdos1062.f n = globalUpper n :=
  f_eq_globalUpper_of_rational_certificate (S.toCertificate n)

end Bounty

end SubmissionComponent_RationalSystem

/- Component CutoffValidity; SHA256 b76b811b8d2e4c826d143b84e416baa04e731af2cecbbf989464d59f3d674bd1 -/
section SubmissionComponent_CutoffValidity
/- Universal trial availability is the remaining combinatorial construction obligation. -/

namespace Bounty

def cutoffCandidate_available {eps : Bool} {u : ℚ} {c5 c7 : ℕ × ℚ}
    (h : cutoffAvailable u (quotaValue eps u) 0 c5 c7 ∨
      cutoffAvailable u (quotaValue eps u) 1 c5 c7) :
    cutoffAvailable u (quotaValue eps u) (cutoffCandidate eps u c5 c7).1 c5 c7 := by
  unfold cutoffCandidate
  dsimp only
  by_cases hp0 : Nat.log 2 ⌊u⌋₊ % 2 = 0
  · rw [hp0]
    split_ifs with hh
    · exact hh
    · simpa using h.resolve_left hh
  · have hp1 : Nat.log 2 ⌊u⌋₊ % 2 = 1 := by omega
    rw [hp1]
    split_ifs with hh
    · exact hh
    · simpa using h.resolve_right hh

def cutoffState_eq_trial {eps : Bool} {u : ℚ} (hu : 1 ≤ u) :
    (cutoffState eps u).2 = cutoffTrial u (quotaValue eps u) (cutoffState eps u).1
      (cutoffState true (u / 5)) (cutoffState eps (u / 7)) := by
  simpa only [cutoffState_of_large hu] using
    cutoffCandidate_eq_trial eps u (cutoffState true (u / 5)) (cutoffState eps (u / 7))

def cutoffState_bounds {eps : Bool} {u : ℚ} (hu : 1 ≤ u) :
    3 * u / 4 ≤ (cutoffState eps u).2 ∧
    (lowerCutoff (cutoffState eps u).1 (quotaValue eps u) : ℚ) ≤ (cutoffState eps u).2 ∧
    (if (cutoffState eps u).1 = (cutoffState true (u / 5)).1 then 4 else 6) *
      (cutoffState true (u / 5)).2 ≤ (cutoffState eps u).2 ∧
    (if (cutoffState eps u).1 = (cutoffState eps (u / 7)).1 then 4 else 6) *
      (cutoffState eps (u / 7)).2 ≤ (cutoffState eps u).2 := by
  have hh := cutoffTrial_bounds u (quotaValue eps u) (cutoffState eps u).1
    (cutoffState true (u / 5)) (cutoffState eps (u / 7))
  rwa [← cutoffState_eq_trial hu] at hh

def CutoffAvailability : Prop :=
  ∀ eps u, 1 ≤ u →
    cutoffAvailable u (quotaValue eps u) 0 (cutoffState true (u / 5)) (cutoffState eps (u / 7)) ∨
    cutoffAvailable u (quotaValue eps u) 1 (cutoffState true (u / 5)) (cutoffState eps (u / 7))

def cutoffState_available (H : CutoffAvailability) {eps : Bool} {u : ℚ} (hu : 1 ≤ u) :
    cutoffAvailable u (quotaValue eps u) (cutoffState eps u).1
      (cutoffState true (u / 5)) (cutoffState eps (u / 7)) := by
  simpa only [cutoffState_of_large hu] using cutoffCandidate_available (H eps u hu)

noncomputable def cutoffSystemOfAvailability (H : CutoffAvailability) : RationalCutoffSystem where
  parity := fun eps u => (cutoffState eps u).1
  cutoff := fun eps u => (cutoffState eps u).2
  parity_lt := fun eps u _ => cutoffState_parity eps u
  cutoff_nonneg := by
    intro eps u hu
    have hh := (cutoffState_bounds (eps := eps) hu).1
    linarith
  cutoff_bound := by
    intro eps u hu
    have hh := (cutoffState_available H (eps := eps) hu).1
    rwa [← cutoffState_eq_trial hu] at hh
  lower_bound := by
    intro eps u hu
    have hh := (cutoffState_bounds (eps := eps) hu).1
    linarith
  compatible_five := by
    intro eps u hu
    exact (cutoffState_bounds (eps := eps) (by linarith : 1 ≤ u)).2.2.1
  compatible_seven := by
    intro eps u hu
    exact (cutoffState_bounds (eps := eps) (by linarith : 1 ≤ u)).2.2.2
  quota := by
    intro eps u hu
    have hh := cutoffTrial_size (by linarith : 0 ≤ u) (cutoffState_available H (eps := eps) hu)
    rw [← cutoffState_eq_trial hu] at hh
    rwa [quotaValue_eq] at hh

def f_eq_globalUpper_of_availability (H : CutoffAvailability) (n : ℕ) :
    Erdos1062.f n = globalUpper n := f_eq_globalUpper_of_system (cutoffSystemOfAvailability H) n

end Bounty

end SubmissionComponent_CutoffValidity

