/- Component ClosureAnchorSemantics; SHA256 552d19ff89828981d9491ed37b2fd0da82b202f012875ff5af8f90cd9cfb336e. -/
section PolicySubmissionPart77
/- A mathematical, typed interpretation with sparse formula anchors. -/
namespace ClosureAnchorSemantics
open ClosureSemantics ClosureInputModel

inductive SValue where
  | prop : Prop → SValue
  | int : Int → SValue
  | rat : Rat → SValue

def SValue.p : SValue → Prop | .prop p => p | _ => False
def SValue.z : SValue → Int | .int z => z | _ => 0
def SValue.q : SValue → Rat | .rat q => q | _ => 0
abbrev SValuation := Nat → SValue

def conjunction : List Prop → Prop
  | [] => True
  | [p] => p
  | p :: q :: ps => p ∧ conjunction (q :: ps)

def disjunction : List Prop → Prop
  | [] => False
  | [p] => p
  | p :: q :: ps => p ∨ disjunction (q :: ps)

noncomputable def sIte (p : Prop) (a b : SValue) : SValue := by
  letI : (a : Prop) → Decidable a := Classical.propDecidable
  exact match a, b with
    | .prop a, .prop b => .prop (if p then a else b)
    | .int a, .int b => .int (if p then a else b)
    | .rat a, .rat b => .rat (if p then a else b)
    | a, b => if p then a else b

noncomputable def evalSOp (input : SValuation) : Op → List SValue → SValue
  | .input k, _ => input k
  | .qConst c, _ => .rat c
  | .zConst c, _ => .int c
  | .bConst true, _ => .prop True
  | .bConst false, _ => .prop False
  | .alias, [a] => a
  | .bNot, [a] => .prop (¬a.p)
  | .bOr, xs => .prop (disjunction (xs.map SValue.p))
  | .bAnd, xs => .prop (conjunction (xs.map SValue.p))
  | .bEq, [a,b] => .prop (a.p ↔ b.p)
  | .ite, [c,a,b] => sIte c.p a b
  | .qEq, [a,b] => .prop (a.q = b.q)
  | .zEq, [a,b] => .prop (a.z = b.z)
  | .qLe, [a,b] => .prop (a.q ≤ b.q)
  | .zLe, [a,b] => .prop (a.z ≤ b.z)
  | .qLt, [a,b] => .prop (a.q < b.q)
  | .zLt, [a,b] => .prop (a.z < b.z)
  | .qAdd, a :: rest => .rat ((rest.map SValue.q).foldl (· + ·) a.q)
  | .zAdd, a :: rest => .int ((rest.map SValue.z).foldl (· + ·) a.z)
  | .qMul, a :: rest => .rat ((rest.map SValue.q).foldl (· * ·) a.q)
  | .zMul, a :: rest => .int ((rest.map SValue.z).foldl (· * ·) a.z)
  | .qAdd, [] => .rat 0
  | .zAdd, [] => .int 0
  | .qMul, [] => .rat 1
  | .zMul, [] => .int 1
  | .qNeg, [a] => .rat (-a.q)
  | .zNeg, [a] => .int (-a.z)
  | .qSub, a :: rest => .rat ((rest.map SValue.q).foldl (· - ·) a.q)
  | .zSub, a :: rest => .int ((rest.map SValue.z).foldl (· - ·) a.z)
  | .qDiv, [a,b] => .rat (a.q / b.q)
  | _, _ => .rat 0

noncomputable def evalSNode (input values : SValuation) (n : Node) : SValue :=
  evalSOp input n.op (n.children.map values)

def evalSNode_congr (input values other : SValuation) (n : Node)
    (h : ∀ j ∈ n.children, values j = other j) :
    evalSNode input values n = evalSNode input other n := by
  unfold evalSNode
  congr 1
  exact List.map_congr_left h

noncomputable def sInput (X Y : Rat) (p : Nat → Prop) (r : Nat → Rat) : SValuation :=
  fun slot => if slot = 0 then .rat X else if slot = 1 then .rat Y
    else if slot % 2 = 0 then .prop (p ((slot - 2) / 2))
    else .rat (r ((slot - 3) / 2))

noncomputable def evalAnchored (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) : Nat → SValuation
  | 0, _ => .rat 0
  | fuel + 1, i => match anchor i with
    | some a => a
    | none => evalSNode input (evalAnchored raw input anchor fuel) (boundedProgram raw i)

noncomputable def anchoredValues (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) : SValuation :=
  fun i => evalAnchored raw input anchor (i + 1) i

noncomputable def anchorBody (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) (i : Nat) : SValue :=
  evalSNode input (evalAnchored raw input anchor i) (boundedProgram raw i)

def evalAnchored_stable (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) (i fuel : Nat) (hi : i < fuel) :
    evalAnchored raw input anchor fuel i = anchoredValues raw input anchor i := by
  induction i using Nat.strong_induction_on generalizing fuel with
  | h i ih =>
    cases fuel with
    | zero => omega
    | succ fuel =>
      unfold anchoredValues
      cases ha : anchor i with
      | some a => simp only [evalAnchored, ha]
      | none =>
        simp only [evalAnchored, ha]
        apply evalSNode_congr
        intro j hj
        have hji := boundedProgram_children raw i j hj
        rw [ih j hji fuel (by omega), ih j hji i hji]

def anchorBody_eq (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) (i : Nat) :
    anchorBody raw input anchor i =
      evalSNode input (anchoredValues raw input anchor) (boundedProgram raw i) := by
  apply evalSNode_congr
  intro j hj
  exact evalAnchored_stable raw input anchor j i (boundedProgram_children raw i j hj)

def anchoredValues_equation (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) (i : Nat)
    (h : ∀ a, anchor i = some a → a = anchorBody raw input anchor i) :
    anchoredValues raw input anchor i =
      evalSNode input (anchoredValues raw input anchor) (boundedProgram raw i) := by
  rw [← anchorBody_eq]
  unfold anchoredValues
  cases ha : anchor i with
  | none => simp only [evalAnchored, ha, anchorBody]
  | some a => simpa only [evalAnchored, ha] using h a ha

end ClosureAnchorSemantics

end PolicySubmissionPart77

/- Component ClosureAnchorEncoding; SHA256 c657aefdacd54976d9493b5fa69fe70a71e26dc611944ff67fa2f1d568f728a8. -/
section PolicySubmissionPart78
/- Boolean encoding of the mathematical anchored interpreter. -/
namespace ClosureAnchorSemantics
open ClosureSemantics ClosureInputModel ClosureInputReflection

noncomputable def encode : SValue → Value
  | .prop p => boolValue (@decide p (Classical.propDecidable p))
  | .int z => intValue z
  | .rat q => ratValue q

def encode_prop (p : Prop) : encode (.prop p) =
    boolValue (@decide p (Classical.propDecidable p)) := rfl
def encode_int (z : Int) : encode (.int z) = intValue z := rfl
def encode_rat (q : Rat) : encode (.rat q) = ratValue q := rfl

def encode_b (a : SValue) :
    (encode a).b = @decide a.p (Classical.propDecidable _) := by
  cases a with
  | prop p => rfl
  | int z => exact (decide_false (Classical.propDecidable False)).symm
  | rat q => exact (decide_false (Classical.propDecidable False)).symm

def encode_z (a : SValue) : (encode a).z = a.z := by cases a <;> rfl
def encode_q (a : SValue) : (encode a).q = a.q := by cases a <;> rfl

def decide_conjunction (ps : List Prop) :
    @decide (conjunction ps) (Classical.propDecidable _) =
      (ps.map (fun p => @decide p (Classical.propDecidable _))).all id := by
  induction ps with
  | nil => exact decide_true _
  | cons p ps ih =>
    cases ps with
    | nil => exact (Bool.and_true _).symm
    | cons q qs =>
      exact (@Bool.decide_and p (conjunction (q :: qs)) (Classical.propDecidable _)
        (Classical.propDecidable _) (Classical.propDecidable _)).trans
        (congrArg (fun b => @decide p (Classical.propDecidable _) && b) ih)

def decide_disjunction (ps : List Prop) :
    @decide (disjunction ps) (Classical.propDecidable _) =
      (ps.map (fun p => @decide p (Classical.propDecidable _))).any id := by
  induction ps with
  | nil => exact decide_false _
  | cons p ps ih =>
    cases ps with
    | nil => exact (Bool.or_false _).symm
    | cons q qs =>
      exact (@Bool.decide_or p (disjunction (q :: qs)) (Classical.propDecidable _)
        (Classical.propDecidable _) (Classical.propDecidable _)).trans
        (congrArg (fun b => @decide p (Classical.propDecidable _) || b) ih)

def encode_conjunction (xs : List SValue) :
    encode (.prop (conjunction (xs.map SValue.p))) =
      boolValue (((xs.map encode).map Value.b).all id) := by
  simp only [encode_prop, decide_conjunction, List.map_map, Function.comp_def, encode_b]

def encode_disjunction (xs : List SValue) :
    encode (.prop (disjunction (xs.map SValue.p))) =
      boolValue (((xs.map encode).map Value.b).any id) := by
  simp only [encode_prop, decide_disjunction, List.map_map, Function.comp_def, encode_b]

def encode_sIte (p : Prop) (a b : SValue) :
    encode (sIte p a b) =
      if @decide p (Classical.propDecidable _) then encode a else encode b := by
  letI : (a : Prop) → Decidable a := Classical.propDecidable
  by_cases h : p <;> cases a <;> cases b <;> simp [sIte, encode, h]

def encode_evalSOp (input : SValuation) (op : Op) (xs : List SValue) :
    encode (evalSOp input op xs) = evalOp (fun i => encode (input i)) op (xs.map encode) := by
  letI : (a : Prop) → Decidable a := Classical.propDecidable
  cases op
  case bConst b => cases b <;> simp only [evalSOp, evalOp, encode_prop, decide_true, decide_false]
  case bOr => exact encode_disjunction xs
  case bAnd => exact encode_conjunction xs
  all_goals
    rcases xs with _ | ⟨a, _ | ⟨b, _ | ⟨c, _ | ⟨d, xs⟩⟩⟩⟩ <;>
    simp only [evalSOp, evalOp, List.map_cons, List.map_nil, encode_conjunction,
      encode_disjunction, encode_sIte, List.map_map, Function.comp_def, encode_q, encode_z,
      encode_b, encode_prop, encode_int, encode_rat, decide_true, decide_false,
      Bool.decide_iff_dist, decide_not]
  all_goals first | rfl | exact boolValue_decide_irrel _ _ _ | split_ifs <;> rfl

def encode_evalSNode (input values : SValuation) (n : Node) :
    encode (evalSNode input values n) =
      evalNode (fun i => encode (input i)) (fun i => encode (values i)) n := by
  simpa only [evalSNode, evalNode, List.map_map, Function.comp_def] using
    encode_evalSOp input n.op (n.children.map values)

def encode_sInput (X Y : Rat) (p : Nat → Prop) (r : Nat → Rat) :
    (fun i => encode (sInput X Y p r i)) = inputValuation X Y p r := by
  funext i
  unfold sInput inputValuation
  split_ifs <;> rfl

def anchored_model_agrees (raw : Nat → Node) (X Y : Rat) (p : Nat → Prop)
    (r : Nat → Rat) (anchor : Nat → Option SValue) (N : Nat)
    (h : ∀ i < N, ∀ a, anchor i = some a →
      a = anchorBody raw (sInput X Y p r) anchor i) :
    ∀ i < N, programModel raw (inputValuation X Y p r) i =
      encode (anchoredValues raw (sInput X Y p r) anchor i) := by
  apply programModel_agrees_below
  intro i hi
  rw [anchoredValues_equation raw (sInput X Y p r) anchor i (h i hi), encode_evalSNode,
    encode_sInput]

end ClosureAnchorSemantics

end PolicySubmissionPart78

/- Component ClosureAnchorAssertions; SHA256 a0b8f91e5defe8e9a444158460affe53955faa6e01ef8d278f9c3858055ce65c. -/
section PolicySubmissionPart79
/- From checked mathematical anchors to actual asserted SAT unit clauses. -/
namespace ClosureAnchorSemantics
open ClosureSemantics ClosureInputModel

def anchoredValues_of_some (raw : Nat → Node) (input : SValuation)
    (anchor : Nat → Option SValue) (i : Nat) (a : SValue) (ha : anchor i = some a) :
    anchoredValues raw input anchor i = a := by
  simp only [anchoredValues, evalAnchored, ha]

def anchor_model_true (raw : Nat → Node) (X Y : Rat) (p : Nat → Prop)
    (r : Nat → Rat) (anchor : Nat → Option SValue) (N i : Nat) (a : Prop)
    (hcheck : ∀ j < N, ∀ v, anchor j = some v →
      v = anchorBody raw (sInput X Y p r) anchor j)
    (hi : i < N) (ha : anchor i = some (.prop a)) (htruth : a) :
    (programModel raw (inputValuation X Y p r) i).b = true := by
  rw [anchored_model_agrees raw X Y p r anchor N hcheck i hi,
    anchoredValues_of_some raw (sInput X Y p r) anchor i (.prop a) ha]
  exact @decide_eq_true a (Classical.propDecidable a) htruth

def alias_model (raw : Nat → Node) (input : Valuation) (i j : Nat)
    (hnode : raw i = ⟨.alias, [j]⟩) (hback : j < i) :
    programModel raw input i = programModel raw input j := by
  rw [programModel_eq_raw raw input i (by simpa [hnode] using hback), hnode]
  rfl

end ClosureAnchorSemantics

end PolicySubmissionPart79

/- Component ClosureAnchorFuelPatternCheck; SHA256 46448ae0600e0a3d99dd721ad7dce7739b5bd5dc41612d760ec7b21231a7e9b1. -/
section PolicySubmissionPart80
/- Experimental anchor matching with an evaluator structurally recursive on fuel. -/
namespace ClosureAnchorFuelPatternCheck
open ClosureSemantics ClosureAnchorSemantics ClosurePattern

noncomputable def eval (input env : SValuation) (fuel : Nat) (pattern : Pattern) : SValue :=
  match fuel, pattern with
  | 0, _ => .rat 0
  | _ + 1, .hole k => env k
  | fuel + 1, .node op children =>
      evalSOp input op (children.map (eval input env fuel))
termination_by structural fuel

def check (program : Nat → Node) (indices : Nat → Nat) :
    Nat → Pattern → Nat → Bool
  | 0, _, _ => false
  | _ + 1, .hole k, i => indices i == k + 1
  | fuel + 1, .node op children, i =>
      (indices i == 0) && sameOp op (program i).op &&
        allPairs (check program indices fuel) children (program i).children

def check_sound (raw : Nat → Node) (input env : SValuation)
    (anchor : Nat → Option SValue) (indices : Nat → Nat)
    (hanchor : ∀ i, anchor i =
      if indices i = 0 then none else some (env (indices i - 1)))
    (fuel : Nat) (pattern : Pattern) (i : Nat)
    (hc : check (boundedProgram raw) indices fuel pattern i = true) :
    eval input env fuel pattern = anchoredValues raw input anchor i := by
  induction fuel generalizing pattern i with
  | zero => simp [check] at hc
  | succ fuel ih =>
    cases pattern with
    | hole k =>
      have hk : indices i = k + 1 := by
        simpa only [check, beq_iff_eq] using hc
      have ha : anchor i = some (env k) := by
        rw [hanchor, hk]
        simp
      simpa only [eval] using (anchoredValues_of_some raw input anchor i (env k) ha).symm
    | node op children =>
      have hh : (indices i = 0 ∧ sameOp op (boundedProgram raw i).op = true) ∧
          allPairs (check (boundedProgram raw) indices fuel)
            children (boundedProgram raw i).children = true := by
        simpa only [check, Bool.and_eq_true, beq_iff_eq] using hc
      have hn : anchor i = none := by
        rw [hanchor, hh.1.1] <;> rfl
      have hop := sameOp_sound op (boundedProgram raw i).op hh.1.2
      have hchildren := allPairs_map_eq
        (check (boundedProgram raw) indices fuel)
        (eval input env fuel) (anchoredValues raw input anchor)
        (fun p j hp => ih p j hp) children (boundedProgram raw i).children hh.2
      have hv : eval input env (fuel + 1) (.node op children) =
          evalSNode input (anchoredValues raw input anchor) (boundedProgram raw i) := by
        simp only [eval, evalSNode, hchildren, hop]
      have he := anchoredValues_equation raw input anchor i (by
        intro a ha
        rw [hn] at ha
        cases ha)
      exact hv.trans he.symm

def checkBody (program : Nat → Node) (indices : Nat → Nat)
    (fuel : Nat) (pattern : Pattern) (i : Nat) : Bool :=
  match pattern with
  | .hole _ => false
  | .node op children =>
      sameOp op (program i).op &&
        allPairs (check program indices fuel) children (program i).children

def checkBody_sound (raw : Nat → Node) (input env : SValuation)
    (anchor : Nat → Option SValue) (indices : Nat → Nat)
    (hanchor : ∀ i, anchor i =
      if indices i = 0 then none else some (env (indices i - 1)))
    (fuel : Nat) (pattern : Pattern) (i : Nat)
    (hc : checkBody (boundedProgram raw) indices fuel pattern i = true) :
    eval input env (fuel + 1) pattern = anchorBody raw input anchor i := by
  cases pattern with
  | hole k => simp [checkBody] at hc
  | node op children =>
    have hh : sameOp op (boundedProgram raw i).op = true ∧
        allPairs (check (boundedProgram raw) indices fuel)
          children (boundedProgram raw i).children = true := by
      simpa only [checkBody, Bool.and_eq_true] using hc
    have hop := sameOp_sound op (boundedProgram raw i).op hh.1
    have hchildren := allPairs_map_eq
      (check (boundedProgram raw) indices fuel)
      (eval input env fuel) (anchoredValues raw input anchor)
      (fun p j hp => check_sound raw input env anchor indices hanchor fuel p j hp)
      children (boundedProgram raw i).children hh.2
