section PolicySubmissionPart33
/- Signed-clause unit propagation with ordinary natural-number bit masks. -/

namespace Bounty

abbrev PolicyBitState := Nat × Nat

def policyBitValid (P : Nat → Prop) (s : PolicyBitState) : Prop :=
  (∀ i, s.1.testBit i = true → P i) ∧ (∀ i, s.2.testBit i = true → ¬P i)

def policyBitFalse (s : PolicyBitState) (z : Int) : Bool :=
  if 0 < z then s.2.testBit z.natAbs else s.1.testBit z.natAbs

def policyBitAddTrue (s : PolicyBitState) (z : Int) : PolicyBitState :=
  if 0 < z then (s.1 ||| 2 ^ z.natAbs, s.2) else (s.1, s.2 ||| 2 ^ z.natAbs)

def policyBitAddFalse (s : PolicyBitState) (z : Int) : PolicyBitState :=
  if 0 < z then (s.1, s.2 ||| 2 ^ z.natAbs) else (s.1 ||| 2 ^ z.natAbs, s.2)

def policyBitFalse_sound P s z (hv : policyBitValid P s)
    (h : policyBitFalse s z = true) : ¬policySignedHolds P z := by
  by_cases hz : 0 < z
  · simp only [policyBitFalse, policySignedHolds, if_pos hz] at h ⊢
    exact hv.2 _ h
  · simp only [policyBitFalse, policySignedHolds, if_neg hz] at h ⊢
    exact not_not_intro (hv.1 _ h)

def policyBitAddTrue_valid P s z (hv : policyBitValid P s)
    (hz : policySignedHolds P z) : policyBitValid P (policyBitAddTrue s z) := by
  by_cases hp : 0 < z
  · simp only [policySignedHolds, if_pos hp] at hz
    unfold policyBitValid policyBitAddTrue
    rw [if_pos hp]
    refine ⟨?_, hv.2⟩
    intro i hi
    simp only [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
    rcases hi with hi | hi
    · exact hv.1 _ hi
    · simpa only [← hi] using hz
  · simp only [policySignedHolds, if_neg hp] at hz
    unfold policyBitValid policyBitAddTrue
    rw [if_neg hp]
    refine ⟨hv.1, ?_⟩
    intro i hi
    simp only [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
    rcases hi with hi | hi
    · exact hv.2 _ hi
    · simpa only [← hi] using hz

def policyBitAddFalse_valid P s z (hv : policyBitValid P s)
    (hz : ¬policySignedHolds P z) : policyBitValid P (policyBitAddFalse s z) := by
  classical
  by_cases hp : 0 < z
  · simp only [policySignedHolds, if_pos hp] at hz
    unfold policyBitValid policyBitAddFalse
    rw [if_pos hp]
    refine ⟨hv.1, ?_⟩
    intro i hi
    simp only [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
    rcases hi with hi | hi
    · exact hv.2 _ hi
    · simpa only [← hi] using hz
  · simp only [policySignedHolds, if_neg hp, not_not] at hz
    unfold policyBitValid policyBitAddFalse
    rw [if_neg hp]
    refine ⟨?_, hv.2⟩
    intro i hi
    simp only [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hi
    rcases hi with hi | hi
    · exact hv.1 _ hi
    · simpa only [← hi] using hz

def policyBitStart : List Int → PolicyBitState
  | [] => (0, 0)
  | z :: zs => policyBitAddFalse (policyBitStart zs) z

def policyBitStart_valid P c (h : ¬policySignedClauseHolds P c) :
    policyBitValid P (policyBitStart c) := by
  induction c with
  | nil => simp [policyBitStart, policyBitValid]
  | cons z zs ih =>
    apply policyBitAddFalse_valid
    · apply ih
      rintro ⟨w, hw, hp⟩
      exact h ⟨w, List.mem_cons_of_mem _ hw, hp⟩
    · intro hz
      exact h ⟨z, List.mem_cons_self, hz⟩

def policyBitAdvance (db : Nat → List Int) : List Nat → PolicyBitState → Bool
  | [], _ => false
  | h :: hs, s =>
      match (db h).filter (fun z => !policyBitFalse s z) with
      | [] => true
      | [z] => policyBitAdvance db hs (policyBitAddTrue s z)
      | _ => policyBitAdvance db hs s

def policyBitAdvance_sound db hs P s (hv : policyBitValid P s)
    (hc : ∀ i ∈ hs, policySignedClauseHolds P (db i))
    (h : policyBitAdvance db hs s = true) : False := by
  induction hs generalizing s with
  | nil => simp [policyBitAdvance] at h
  | cons i hs ih =>
    have hh : ∀ j ∈ hs, policySignedClauseHolds P (db j) :=
      fun j hj => hc j (List.mem_cons_of_mem _ hj)
    have hex : ∃ z ∈ (db i).filter (fun z => !policyBitFalse s z), policySignedHolds P z := by
      obtain ⟨z, hz, hp⟩ := hc i List.mem_cons_self
      refine ⟨z, List.mem_filter.mpr ⟨hz, ?_⟩, hp⟩
      cases hb : policyBitFalse s z with
      | false => rfl
      | true => exact False.elim (policyBitFalse_sound P s z hv hb hp)
    cases he : (db i).filter (fun z => !policyBitFalse s z) with
    | nil => simp only [he, List.not_mem_nil, false_and, exists_false] at hex
    | cons z zs =>
      cases zs with
      | nil =>
        have hz : policySignedHolds P z := by simpa only [he, List.mem_singleton,
          exists_eq_left] using hex
        exact ih (policyBitAddTrue s z) (policyBitAddTrue_valid P s z hv hz) hh
          (by simpa only [policyBitAdvance, he] using h)
      | cons w ws =>
        exact ih s hv hh (by simpa only [policyBitAdvance, he] using h)

def policyBitRUP (db : Nat → List Int) (c : List Int) (hints : List Nat) : Bool :=
  policyBitAdvance db hints (policyBitStart c)

def policyBitRUP_sound db c hints P
    (hc : ∀ i ∈ hints, policySignedClauseHolds P (db i))
    (h : policyBitRUP db c hints = true) : policySignedClauseHolds P c := by
  classical
  by_contra hn
  exact policyBitAdvance_sound db hints P (policyBitStart c)
    (policyBitStart_valid P c hn) hc h

end Bounty

end PolicySubmissionPart33

/- Component PolicyBitsetComposition; SHA256 8c0f44e6588620fe556ebc89f7b3eba71195198e58de51caca92fbc5672e6554. -/
section PolicySubmissionPart34
/- Well-founded composition of directly checked bitset RUP clauses. -/

namespace Bounty

def policyBitActionGood (db : Nat → List Int) (i : Nat) (hints : List Nat) : Bool :=
  hints.all (fun j => decide (0 < j ∧ j < i)) && policyBitRUP db (db i) hints

def policyBitActionGood_sound db i hints P
    (h : policyBitActionGood db i hints = true)
    (hi : ∀ j, 0 < j → j < i → policySignedClauseHolds P (db j)) :
    policySignedClauseHolds P (db i) := by
  simp only [policyBitActionGood, Bool.and_eq_true, List.all_eq_true,
    decide_eq_true_eq] at h
  exact policyBitRUP_sound db (db i) hints P
    (fun j hj => hi j (h.1 j hj).1 (h.1 j hj).2) h.2

def policyBitGraph_sound (db : Nat → List Int) (initialBound limit : Nat)
    (hints : Nat → List Nat) (P : Nat → Prop)
    (hc : ∀ i, initialBound ≤ i → i < limit → policyBitActionGood db i (hints i) = true)
    (hi : ∀ i, 0 < i → i < initialBound → policySignedClauseHolds P (db i)) :
    ∀ i, 0 < i → i < limit → policySignedClauseHolds P (db i) := by
  intro i
  induction i using Nat.strong_induction_on with
  | h i ih =>
    intro hip hil
    by_cases hlt : i < initialBound
    · exact hi i hip hlt
    apply policyBitActionGood_sound db i (hints i) P (hc i (Nat.le_of_not_gt hlt) hil)
    intro j hj hji
    exact ih j hji hj (lt_trans hji hil)

def policyBitGraph_false (db : Nat → List Int) (initialBound limit root : Nat)
    (hints : Nat → List Nat) (P : Nat → Prop)
    (hc : ∀ i, initialBound ≤ i → i < limit → policyBitActionGood db i (hints i) = true)
    (hi : ∀ i, 0 < i → i < initialBound → policySignedClauseHolds P (db i))
    (hr : 0 < root) (hrl : root < limit) (he : db root = []) : False := by
  have hh := policyBitGraph_sound db initialBound limit hints P hc hi root hr hrl
  rw [he] at hh
  simpa [policySignedClauseHolds] using hh

def policyIntervalJoin (P : Nat → Prop) (a b c : Nat)
    (hl : ∀ i, a ≤ i → i < b → P i)
    (hr : ∀ i, b ≤ i → i < c → P i) :
    ∀ i, a ≤ i → i < c → P i := by
  intro i hia hic
  by_cases hib : i < b
  · exact hl i hia hib
  · exact hr i (Nat.le_of_not_gt hib) hic

end Bounty

end PolicySubmissionPart34

