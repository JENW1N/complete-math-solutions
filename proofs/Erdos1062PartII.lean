/- Component ClosureCircuit; SHA256 9543e2ea042f895ae0affd1cbff0a127734830a60c82caefd6802586b4e7ecdf. -/
section PolicySubmissionPart5
/- Ordinary Tseitin-clause soundness for Boolean gates and typed DAG nodes. -/

namespace ClosureCircuit
open Bounty

inductive Gate where
  | fixedValue : Bool → Gate
  | neg : Nat → Gate
  | disj : List Nat → Gate
  | conj : List Nat → Gate
  | iff : Nat → Nat → Gate
  | alias : Nat → Gate
  | ite : Nat → Nat → Nat → Gate

def Gate.inputs : Gate → List Nat
  | .fixedValue _ => []
  | .neg a | .alias a => [a]
  | .disj xs | .conj xs => xs
  | .iff a b => [a, b]
  | .ite c a b => [c, a, b]

def Gate.eval (B : Nat → Bool) : Gate → Bool
  | .fixedValue b => b
  | .neg a => !B a
  | .disj xs => xs.any B
  | .conj xs => xs.all B
  | .iff a b => B a == B b
  | .alias a => B a
  | .ite c a b => if B c then B a else B b

def Gate.clauses (v : Nat) : Gate → List (List Int)
  | .fixedValue true => [[v]]
  | .fixedValue false => [[-(v : Int)]]
  | .neg a => [[v, a], [-(v : Int), -(a : Int)]]
  | .disj xs => (-(v : Int) :: xs.map (fun (a : Nat) => (a : Int))) ::
      xs.map (fun (a : Nat) => [(v : Int), -(a : Int)])
  | .conj xs => ((v : Int) :: xs.map (fun (a : Nat) => -(a : Int))) ::
      xs.map (fun (a : Nat) => [-(v : Int), (a : Int)])
  | .iff a b => [[-(v : Int), -(a : Int), b], [-(v : Int), a, -(b : Int)],
      [v, a, b], [v, -(a : Int), -(b : Int)]]
  | .alias a => [[-(v : Int), a], [v, -(a : Int)]]
  | .ite c a b => [[-(c : Int), -(a : Int), v], [-(c : Int), a, -(v : Int)],
      [c, -(b : Int), v], [c, b, -(v : Int)]]

def Holds (B : Nat → Bool) (clause : List Int) : Prop :=
  policySignedClauseHolds (fun i => B i = true) clause

def signed_pos (B : Nat → Bool) {a : Nat} (ha : 0 < a) :
    policySignedHolds (fun i => B i = true) (a : Int) ↔ B a = true := by
  simp [policySignedHolds, Nat.ne_of_gt ha]

def signed_neg (B : Nat → Bool) (a : Nat) :
    policySignedHolds (fun i => B i = true) (-(a : Int)) ↔ B a = false := by
  cases hb : B a <;> simp [policySignedHolds, hb]

def holds_nil (B : Nat → Bool) : ¬ Holds B [] := by
  simp [Holds, policySignedClauseHolds]

def holds_cons (B : Nat → Bool) (z : Int) (zs : List Int) :
    Holds B (z :: zs) ↔ policySignedHolds (fun i => B i = true) z ∨ Holds B zs := by
  simp [Holds, policySignedClauseHolds]

def holds_map_pos (B : Nat → Bool) (xs : List Nat)
    (hpos : ∀ a ∈ xs, 0 < a) :
    Holds B (xs.map (fun (a : Nat) => (a : Int))) ↔ ∃ a ∈ xs, B a = true := by
  change (∃ z ∈ xs.map (fun (a : Nat) => (a : Int)),
    policySignedHolds (fun i => B i = true) z) ↔ _
  constructor
  · rintro ⟨z, hz, hv⟩
    obtain ⟨a, ha, rfl⟩ : ∃ a ∈ xs, (a : Int) = z := List.mem_map.mp hz
    exact ⟨a, ha, (signed_pos B (hpos a ha)).mp hv⟩
  · rintro ⟨a, ha, hv⟩
    exact ⟨(a : Int), List.mem_map.mpr ⟨a, ha, rfl⟩, (signed_pos B (hpos a ha)).mpr hv⟩

def holds_map_neg (B : Nat → Bool) (xs : List Nat) :
    Holds B (xs.map (fun (a : Nat) => -(a : Int))) ↔ ∃ a ∈ xs, B a = false := by
  change (∃ z ∈ xs.map (fun (a : Nat) => -(a : Int)),
    policySignedHolds (fun i => B i = true) z) ↔ _
  constructor
  · rintro ⟨z, hz, hv⟩
    obtain ⟨a, ha, rfl⟩ : ∃ a ∈ xs, -(a : Int) = z := List.mem_map.mp hz
    exact ⟨a, ha, (signed_neg B a).mp hv⟩
  · rintro ⟨a, ha, hv⟩
    exact ⟨-(a : Int), List.mem_map.mpr ⟨a, ha, rfl⟩, (signed_neg B a).mpr hv⟩

def gate_clauses_sound (B : Nat → Bool) (g : Gate) (v : Nat)
    (hv : 0 < v) (hp : ∀ a ∈ g.inputs, 0 < a) (he : B v = g.eval B) :
    ∀ clause ∈ g.clauses v, Holds B clause := by
  cases g with
  | fixedValue b =>
    cases b <;> simp [Gate.clauses, Gate.eval, holds_cons, holds_nil, signed_pos B hv,
      signed_neg, he]
  | neg a =>
    have ha : 0 < a := hp a (by simp [Gate.inputs])
    simp only [Gate.clauses, List.mem_cons, List.not_mem_nil, or_false]
    intro clause hc
    rcases hc with rfl | rfl <;>
      simp only [holds_cons, holds_nil, signed_pos B hv, signed_pos B ha, signed_neg,
        or_false] <;>
      cases h1 : B v <;> cases h2 : B a <;> simp_all [Gate.eval]
  | «alias» a =>
    have ha : 0 < a := hp a (by simp [Gate.inputs])
    simp only [Gate.clauses, List.mem_cons, List.not_mem_nil, or_false]
    intro clause hc
    rcases hc with rfl | rfl <;>
      simp only [holds_cons, holds_nil, signed_pos B hv, signed_pos B ha, signed_neg,
        or_false] <;>
      cases h1 : B v <;> cases h2 : B a <;> simp_all [Gate.eval]
  | iff a b =>
    have ha : 0 < a := hp a (by simp [Gate.inputs])
    have hb : 0 < b := hp b (by simp [Gate.inputs])
    simp only [Gate.clauses, List.mem_cons, List.not_mem_nil, or_false]
    intro clause hc
    rcases hc with rfl | rfl | rfl | rfl <;>
      simp only [holds_cons, holds_nil, signed_pos B hv, signed_pos B ha, signed_pos B hb,
        signed_neg, or_false] <;>
      cases h1 : B v <;> cases h2 : B a <;> cases h3 : B b <;> simp_all [Gate.eval]
  | ite c a b =>
    have hc : 0 < c := hp c (by simp [Gate.inputs])
    have ha : 0 < a := hp a (by simp [Gate.inputs])
    have hb : 0 < b := hp b (by simp [Gate.inputs])
    simp only [Gate.clauses, List.mem_cons, List.not_mem_nil, or_false]
    intro clause hcl
    rcases hcl with rfl | rfl | rfl | rfl <;>
      simp only [holds_cons, holds_nil, signed_pos B hv, signed_pos B ha, signed_pos B hb,
        signed_pos B hc, signed_neg, or_false] <;>
      cases h1 : B v <;> cases h2 : B c <;> cases h3 : B a <;> cases h4 : B b <;>
        simp_all [Gate.eval]
  | disj xs =>
    change B v = xs.any B at he
    intro clause hc
    rcases List.mem_cons.mp hc with rfl | hc
    · rw [holds_cons, signed_neg, holds_map_pos B xs hp]
      cases h : B v with
      | false => exact Or.inl rfl
      | true =>
        right
        exact List.any_eq_true.mp (by simpa only [h] using he.symm)
    · obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hc
      simp only [holds_cons, holds_nil, signed_pos B hv, signed_neg, or_false]
      cases h : B a with
      | false => exact Or.inr rfl
      | true =>
        left
        exact he.trans (List.any_eq_true.mpr ⟨a, ha, h⟩)
  | conj xs =>
    change B v = xs.all B at he
    intro clause hc
    rcases List.mem_cons.mp hc with rfl | hc
    · rw [holds_cons, signed_pos B hv, holds_map_neg]
      cases h : B v with
      | true => exact Or.inl rfl
      | false =>
        right
        obtain ⟨a, ha, hn⟩ := List.all_eq_false.mp (by simpa only [h] using he.symm)
        exact ⟨a, ha, by cases hb : B a <;> simp_all⟩
    · obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hc
      simp only [holds_cons, holds_nil, signed_neg, signed_pos B (hp a ha), or_false]
      cases h : B v with
      | false => exact Or.inl rfl
      | true =>
        right
        exact List.all_eq_true.mp (by simpa only [h] using he.symm) a ha

def Gate.toNode : Gate → ClosureSemantics.Node
  | .fixedValue b => ⟨.bConst b, []⟩
  | .neg a => ⟨.bNot, [a]⟩
  | .disj xs => ⟨.bOr, xs⟩
  | .conj xs => ⟨.bAnd, xs⟩
  | .iff a b => ⟨.bEq, [a, b]⟩
  | .alias a => ⟨.alias, [a]⟩
  | .ite c a b => ⟨.ite, [c, a, b]⟩

def evalNode_toNode (input values : ClosureSemantics.Valuation) (g : Gate) :
    (ClosureSemantics.evalNode input values g.toNode).b = g.eval (fun i => (values i).b) := by
  cases g <;>
    simp [Gate.toNode, Gate.eval, ClosureSemantics.evalNode, ClosureSemantics.evalOp,
      ClosureSemantics.boolValue, List.map_map, List.any_map, List.all_map, Function.comp_def]
  split_ifs <;> rfl

def Gate.rename (σ : Nat → Nat) : Gate → Gate
  | .fixedValue b => .fixedValue b
  | .neg a => .neg (σ a)
  | .disj xs => .disj (xs.map σ)
  | .conj xs => .conj (xs.map σ)
  | .iff a b => .iff (σ a) (σ b)
  | .alias a => .alias (σ a)
  | .ite c a b => .ite (σ c) (σ a) (σ b)

def Gate.inputs_rename (σ : Nat → Nat) (g : Gate) :
    (g.rename σ).inputs = g.inputs.map σ := by
  cases g <;> rfl

def Gate.eval_rename (B : Nat → Bool) (σ : Nat → Nat) (g : Gate) :
    (g.rename σ).eval B = g.eval (fun i => B (σ i)) := by
  cases g <;> simp [Gate.rename, Gate.eval, List.any_map, List.all_map, Function.comp_def]

def Gate.eval_congr (g : Gate) (B C : Nat → Bool)
    (h : ∀ i ∈ g.inputs, B i = C i) : g.eval B = g.eval C := by
  cases g with
  | fixedValue b => rfl
  | neg a => simp only [Gate.eval, h a (by simp [Gate.inputs])]
  | «alias» a => exact h a (by simp [Gate.inputs])
  | iff a b =>
    simp only [Gate.eval, h a (by simp [Gate.inputs]), h b (by simp [Gate.inputs])]
  | ite c a b =>
    simp only [Gate.eval, h c (by simp [Gate.inputs]), h a (by simp [Gate.inputs]),
      h b (by simp [Gate.inputs])]
  | disj xs =>
    have hm : xs.map B = xs.map C := List.map_congr_left h
    simpa [Gate.eval, List.any_map] using congrArg (fun l : List Bool => l.any id) hm
  | conj xs =>
    have hm : xs.map B = xs.map C := List.map_congr_left h
    simpa [Gate.eval, List.all_map] using congrArg (fun l : List Bool => l.all id) hm

def node_clauses_sound (input values : ClosureSemantics.Valuation)
    (B : Nat → Bool) (σ : Nat → Nat) (g : Gate) (out : Nat)
    (he : values out = ClosureSemantics.evalNode input values g.toNode)
    (hout : B (σ out) = (values out).b)
    (hinputs : ∀ a ∈ g.inputs, B (σ a) = (values a).b)
    (hpos_out : 0 < σ out) (hpos_inputs : ∀ a ∈ g.inputs, 0 < σ a) :
    ∀ clause ∈ (g.rename σ).clauses (σ out), Holds B clause := by
  apply gate_clauses_sound B (g.rename σ) (σ out) hpos_out
  · intro a ha
    rw [Gate.inputs_rename] at ha
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp ha
    exact hpos_inputs j hj
  · rw [Gate.eval_rename, hout]
    calc
      (values out).b = (ClosureSemantics.evalNode input values g.toNode).b :=
        congrArg ClosureSemantics.Value.b he
      _ = g.eval (fun i => (values i).b) := evalNode_toNode input values g
      _ = g.eval (fun i => B (σ i)) := (Gate.eval_congr g _ _ hinputs).symm

end ClosureCircuit

end PolicySubmissionPart5

/- Component ClosureCircuitCheck; SHA256 5b2ebec0cdd5335935033a5233c80f9ae3d0d76c440a686f60b381c5ecd6f9c2. -/
section PolicySubmissionPart6
/- Checked membership of actual clauses among a typed node's Tseitin clauses. -/
namespace ClosureCircuit
open ClosureSemantics Bounty

def gateOf : (node : Node) → Option {g : Gate // node = g.toNode}
  | ⟨.bConst b, []⟩ => some ⟨.fixedValue b, rfl⟩
  | ⟨.bNot, [a]⟩ => some ⟨.neg a, rfl⟩
  | ⟨.bOr, xs⟩ => some ⟨.disj xs, rfl⟩
  | ⟨.bAnd, xs⟩ => some ⟨.conj xs, rfl⟩
  | ⟨.bEq, [a, b]⟩ => some ⟨.iff a b, rfl⟩
  | ⟨.alias, [a]⟩ => some ⟨.alias a, rfl⟩
  | ⟨.ite, [c, a, b]⟩ => some ⟨.ite c a b, rfl⟩
  | _ => none

def clauseSubset (source target : List Int) : Bool :=
  source.all (fun lit => decide (lit ∈ target))

def clauseSubset_sound (P : Nat → Prop) (source target : List Int)
    (hc : clauseSubset source target = true) (hs : policySignedClauseHolds P source) :
    policySignedClauseHolds P target := by
  obtain ⟨lit, hlit, hv⟩ := hs
  have hm : ∀ z ∈ source, z ∈ target := by simpa [clauseSubset] using hc
  exact ⟨lit, hm lit hlit, hv⟩

def checkGateClause (program : Nat → Node) (out : Nat) (clause : List Int) : Bool :=
  match gateOf (program out) with
  | none => false
  | some g => ((g.val.rename Nat.succ).clauses (out + 1)).any (fun c => clauseSubset c clause)

def checkGateClause_sound (program : Nat → Node) (input values : Valuation)
    (he : Equations program input values) (out : Nat) (clause : List Int)
    (hc : checkGateClause program out clause = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) clause := by
  cases hg : gateOf (program out) with
  | none => simp [checkGateClause, hg] at hc
  | some g =>
    have hmem : ∃ c ∈ (g.val.rename Nat.succ).clauses (out + 1), clauseSubset c clause = true := by
      simpa only [checkGateClause, hg, List.any_eq_true] using hc
    obtain ⟨c, hcm, hsub⟩ := hmem
    apply clauseSubset_sound _ c clause hsub
    apply node_clauses_sound input values (fun v => (values (v - 1)).b) Nat.succ g.val out
      _ _ _ (Nat.succ_pos _) (fun _ _ => Nat.succ_pos _) c hcm
    · rw [← g.property]
      exact he out
    · simp
    · intro a ha
      simp

def checkCircuitEntry (program : Nat → Node) (clauses : Nat → List Int) : List Nat → Bool
  | [clauseId, out] => checkGateClause program out (clauses clauseId)
  | _ => false

def checkCircuitEntry_sound (program : Nat → Node) (input values : Valuation)
    (he : Equations program input values) (clauses : Nat → List Int)
    (entry : List Nat) (hc : checkCircuitEntry program clauses entry = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) (clauses (entry.headD 0)) := by
  cases entry with
  | nil => simp [checkCircuitEntry] at hc
  | cons clauseId rest =>
    cases rest with
    | nil => simp [checkCircuitEntry] at hc
    | cons out tail =>
      cases tail with
      | cons a as => simp [checkCircuitEntry] at hc
      | nil => exact checkGateClause_sound program input values he out (clauses clauseId) hc

end ClosureCircuit

end PolicySubmissionPart6

/- Component ClosureCircuitBlock; SHA256 8ce5aaa2c9bc1a33c0ca7f1c101abea44ce96741ee35c3b4e773cc7c8ddf0f83. -/
section PolicySubmissionPart7
namespace ClosureCircuit
open ClosureSemantics Bounty

def checkCircuitBlock (program : ℕ → Node) (clauses : ℕ → List ℤ)
    (records : ℕ → List ℕ) (start count : ℕ) : Bool :=
  (List.range count).all fun i => checkCircuitEntry program clauses (records (start + i))

def checkCircuitBlock_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (clauses : ℕ → List ℤ) (records : ℕ → List ℕ)
    (start count : ℕ) (hc : checkCircuitBlock program clauses records start count = true)
    (i : ℕ) (hi : i < count) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true)
      (clauses ((records (start + i)).headD 0)) := by
  have h : ∀ j ∈ List.range count,
      checkCircuitEntry program clauses (records (start + j)) = true := by
    simpa only [checkCircuitBlock, List.all_eq_true] using hc
  exact checkCircuitEntry_sound program input values he clauses (records (start + i))
    (h i (List.mem_range.mpr hi))

end ClosureCircuit

end PolicySubmissionPart7

/- Component PolicyLinearCertificate; SHA256 cf77a260405b54f95bd0f1310c3ffdf7b90b25d5e0e8eb394123a4f5a147618d. -/
section PolicySubmissionPart8
/- A sparse affine linear certificate checker, with ordinary kernel soundness. -/

namespace ClosureLinear

abbrev Coefficients := List (ℕ × ℚ)

def evalCoefficients (x : ℕ → ℚ) : Coefficients → ℚ
  | [] => 0
  | (i, q) :: xs => q * x i + evalCoefficients x xs

def insertCoefficient (a : ℕ × ℚ) : Coefficients → Coefficients
  | [] => [a]
  | b :: bs =>
    if a.1 = b.1 then (a.1, a.2 + b.2) :: bs
    else b :: insertCoefficient a bs

def addCoefficients : Coefficients → Coefficients → Coefficients
  | [], ys => ys
  | a :: xs, ys => insertCoefficient a (addCoefficients xs ys)

def scaleCoefficients (q : ℚ) (xs : Coefficients) : Coefficients :=
  xs.map fun a => (a.1, q * a.2)

def eval_insertCoefficient (x : ℕ → ℚ) (a : ℕ × ℚ) (xs : Coefficients) :
    evalCoefficients x (insertCoefficient a xs) = a.2 * x a.1 + evalCoefficients x xs := by
  induction xs with
  | nil => simp [insertCoefficient, evalCoefficients]
  | cons b bs ih =>
    simp only [insertCoefficient]
    split_ifs with h
    · simp only [evalCoefficients, h]
      ring
    · simp only [evalCoefficients, ih]
      ring

def eval_addCoefficients (x : ℕ → ℚ) (xs ys : Coefficients) :
    evalCoefficients x (addCoefficients xs ys) = evalCoefficients x xs + evalCoefficients x ys := by
  induction xs with
  | nil => simp [addCoefficients, evalCoefficients]
  | cons a xs ih =>
    simp only [addCoefficients, eval_insertCoefficient, ih, evalCoefficients]
    ring

def eval_scaleCoefficients (x : ℕ → ℚ) (q : ℚ) (xs : Coefficients) :
    evalCoefficients x (scaleCoefficients q xs) = q * evalCoefficients x xs := by
  induction xs with
  | nil => simp [scaleCoefficients, evalCoefficients]
  | cons a xs ih =>
    simp only [scaleCoefficients, List.map_cons, evalCoefficients] at *
    rw [ih]
    ring

structure Affine where
  coefficients : Coefficients
  fixedValue : ℚ

def Affine.eval (f : Affine) (x : ℕ → ℚ) : ℚ :=
  f.fixedValue + evalCoefficients x f.coefficients

def Affine.zero : Affine := ⟨[], 0⟩

def Affine.add (f g : Affine) : Affine :=
  ⟨addCoefficients f.coefficients g.coefficients, f.fixedValue + g.fixedValue⟩

def Affine.scale (q : ℚ) (f : Affine) : Affine :=
  ⟨scaleCoefficients q f.coefficients, q * f.fixedValue⟩

def Affine.eval_zero (x : ℕ → ℚ) : Affine.zero.eval x = 0 := by
  simp [Affine.zero, Affine.eval, evalCoefficients]

def Affine.eval_add (f g : Affine) (x : ℕ → ℚ) :
    (f.add g).eval x = f.eval x + g.eval x := by
  simp only [Affine.add, Affine.eval, eval_addCoefficients]
  ring

def Affine.eval_scale (q : ℚ) (f : Affine) (x : ℕ → ℚ) :
    (f.scale q).eval x = q * f.eval x := by
  simp only [Affine.scale, Affine.eval, eval_scaleCoefficients]
  ring

structure Row where
  form : Affine
  strict : Bool

def Row.Holds (r : Row) (x : ℕ → ℚ) : Prop :=
  if r.strict then 0 < r.form.eval x else 0 ≤ r.form.eval x

def Row.nonneg (r : Row) (x : ℕ → ℚ) (h : r.Holds x) : 0 ≤ r.form.eval x := by
  cases hs : r.strict <;> simp [Row.Holds, hs] at h
  · exact h
  · exact le_of_lt h

def weightedSum : List (ℕ × Row) → Affine
  | [] => Affine.zero
  | (w, r) :: xs => (r.form.scale w).add (weightedSum xs)

def hasStrict (xs : List (ℕ × Row)) : Bool :=
  xs.any fun a => decide (0 < a.1) && a.2.strict

def weightedSum_nonneg (xs : List (ℕ × Row)) (x : ℕ → ℚ)
    (h : ∀ a ∈ xs, a.2.Holds x) : 0 ≤ (weightedSum xs).eval x := by
  induction xs with
  | nil => simp [weightedSum, Affine.eval_zero]
  | cons a xs ih =>
    have ha := (a.2.nonneg x (h a (List.mem_cons_self ..)))
    have hr := ih (fun b hb => h b (List.mem_cons_of_mem _ hb))
    simpa [weightedSum, Affine.eval_add, Affine.eval_scale] using
      add_nonneg (mul_nonneg (Nat.cast_nonneg a.1) ha) hr

def weightedSum_pos (xs : List (ℕ × Row)) (x : ℕ → ℚ)
    (h : ∀ a ∈ xs, a.2.Holds x) (hs : hasStrict xs = true) :
    0 < (weightedSum xs).eval x := by
  induction xs with
  | nil => simp [hasStrict] at hs
  | cons a xs ih =>
    have ha := h a (List.mem_cons_self ..)
    have hr : ∀ b ∈ xs, b.2.Holds x := fun b hb => h b (List.mem_cons_of_mem _ hb)
    have split : (0 < a.1 ∧ a.2.strict = true) ∨ hasStrict xs = true := by
      simpa [hasStrict, Bool.or_eq_true, Bool.and_eq_true] using hs
    rcases split with hfirst | hrest
    · have hp : 0 < a.2.form.eval x := by simpa [Row.Holds, hfirst.2] using ha
      have hw : (0 : ℚ) < a.1 := by exact_mod_cast hfirst.1
      simpa [weightedSum, Affine.eval_add, Affine.eval_scale] using
        add_pos_of_pos_of_nonneg (mul_pos hw hp) (weightedSum_nonneg xs x hr)
    · have hp := ih hr hrest
      simpa [weightedSum, Affine.eval_add, Affine.eval_scale] using
        add_pos_of_nonneg_of_pos (mul_nonneg (Nat.cast_nonneg a.1) (a.2.nonneg x ha)) hp

def zeroCoefficients (xs : Coefficients) : Bool :=
  xs.all fun a => decide (a.2 = 0)

def evalCoefficients_eq_zero (x : ℕ → ℚ) (xs : Coefficients)
    (h : zeroCoefficients xs = true) : evalCoefficients x xs = 0 := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    have hh : a.2 = 0 ∧ zeroCoefficients xs = true := by
      simpa [zeroCoefficients, Bool.and_eq_true] using h
    simp [evalCoefficients, hh.1, ih hh.2]

def check (xs : List (ℕ × Row)) : Bool :=
  let total := weightedSum xs
  zeroCoefficients total.coefficients && decide (total.fixedValue ≤ 0) &&
    (decide (total.fixedValue < 0) || hasStrict xs)

def check_sound (xs : List (ℕ × Row)) (x : ℕ → ℚ)
    (h : ∀ a ∈ xs, a.2.Holds x) (hc : check xs = true) : False := by
  have hparts : (zeroCoefficients (weightedSum xs).coefficients = true ∧
      (weightedSum xs).fixedValue ≤ 0) ∧
      ((weightedSum xs).fixedValue < 0 ∨ hasStrict xs = true) := by
    simpa [check, Bool.and_eq_true, Bool.or_eq_true] using hc
  have heval : (weightedSum xs).eval x = (weightedSum xs).fixedValue := by
    simp [Affine.eval, evalCoefficients_eq_zero x _ hparts.1.1]
  rcases hparts.2 with hnegative | hstrict
  · have hn := weightedSum_nonneg xs x h
    rw [heval] at hn
    exact (not_lt_of_ge hn) hnegative
  · have hp := weightedSum_pos xs x h hstrict
    rw [heval] at hp
    exact (not_lt_of_ge hparts.1.2) hp

end ClosureLinear

end PolicySubmissionPart8

/- Component PolicyLinearNormalization; SHA256 178c2708a3e3cf82eaa9b66fe146cea89e82a9599bee362a6d8c010f14b5c387. -/
section PolicySubmissionPart9
/- Verified arithmetic normalization used by reflected linear certificates. -/

namespace ClosureLinear
open ClosureSemantics

def Affine.const (q : ℚ) : Affine := ⟨[], q⟩
def Affine.variable (i : ℕ) : Affine := ⟨[(i, 1)], 0⟩
def Affine.neg (f : Affine) : Affine := f.scale (-1)
def Affine.sub (f g : Affine) : Affine := f.add g.neg

def Affine.eval_const (q : ℚ) (x : ℕ → ℚ) : (Affine.const q).eval x = q := by
  simp [Affine.const, Affine.eval, evalCoefficients]

def Affine.eval_variable (i : ℕ) (x : ℕ → ℚ) : (Affine.variable i).eval x = x i := by
  simp [Affine.variable, Affine.eval, evalCoefficients]

def Affine.eval_neg (f : Affine) (x : ℕ → ℚ) : f.neg.eval x = -f.eval x := by
  simp [Affine.neg, Affine.eval_scale]

def Affine.eval_sub (f g : Affine) (x : ℕ → ℚ) : (f.sub g).eval x = f.eval x - g.eval x := by
  simp [Affine.sub, Affine.eval_add, Affine.eval_neg, sub_eq_add_neg]

def Affine.eval_of_zeroCoefficients (f : Affine) (x : ℕ → ℚ)
    (h : zeroCoefficients f.coefficients = true) : f.eval x = f.fixedValue := by
  simp [Affine.eval, evalCoefficients_eq_zero x _ h]

def Affine.mul? (f g : Affine) : Option Affine :=
  if zeroCoefficients f.coefficients then some (g.scale f.fixedValue)
  else if zeroCoefficients g.coefficients then some (f.scale g.fixedValue)
  else none

def Affine.div? (f g : Affine) : Option Affine :=
  if zeroCoefficients g.coefficients then some (f.scale g.fixedValue⁻¹) else none

def Affine.mul?_sound (f g out : Affine) (x : ℕ → ℚ) (h : f.mul? g = some out) :
    out.eval x = f.eval x * g.eval x := by
  unfold Affine.mul? at h
  split_ifs at h with hf hg
  · cases h
    rw [Affine.eval_scale, Affine.eval_of_zeroCoefficients f x hf]
  · cases h
    rw [Affine.eval_scale, Affine.eval_of_zeroCoefficients g x hg]
    ring

def Affine.div?_sound (f g out : Affine) (x : ℕ → ℚ) (h : f.div? g = some out) :
    out.eval x = f.eval x / g.eval x := by
  unfold Affine.div? at h
  split_ifs at h with hg
  · cases h
    rw [Affine.eval_scale, Affine.eval_of_zeroCoefficients g x hg]
    simp [div_eq_mul_inv, mul_comm]

def foldAdd (f : Affine) : List Affine → Affine
  | [] => f
  | g :: gs => foldAdd (f.add g) gs

def foldSub (f : Affine) : List Affine → Affine
  | [] => f
  | g :: gs => foldSub (f.sub g) gs

def foldMul (f : Affine) : List Affine → Option Affine
  | [] => some f
  | g :: gs => do
    let product ← f.mul? g
    foldMul product gs

def eval_foldAdd (f : Affine) (fs : List Affine) (x : ℕ → ℚ) :
    (foldAdd f fs).eval x = (fs.map (fun g => g.eval x)).foldl (· + ·) (f.eval x) := by
  induction fs generalizing f with
  | nil => rfl
  | cons g gs ih => simp [foldAdd, ih, Affine.eval_add]

def eval_foldSub (f : Affine) (fs : List Affine) (x : ℕ → ℚ) :
    (foldSub f fs).eval x = (fs.map (fun g => g.eval x)).foldl (· - ·) (f.eval x) := by
  induction fs generalizing f with
  | nil => rfl
  | cons g gs ih => simp [foldSub, ih, Affine.eval_sub]

def eval_foldMul (f out : Affine) (fs : List Affine) (x : ℕ → ℚ)
    (h : foldMul f fs = some out) :
    out.eval x = (fs.map (fun g => g.eval x)).foldl (· * ·) (f.eval x) := by
  induction fs generalizing f with
  | nil => simpa [foldMul] using (congrArg (fun a => a.map (fun g => g.eval x)) h).symm
  | cons g gs ih =>
    cases hm : f.mul? g with
    | none => simp [foldMul, hm] at h
    | some product =>
      have hr : foldMul product gs = some out := by simpa [foldMul, hm] using h
      rw [ih product hr]
      simp [Affine.mul?_sound f g product x hm]

def normalizeOp : Op → List Affine → Option Affine
  | .qConst q, _ => some (Affine.const q)
  | .zConst z, _ => some (Affine.const z)
  | .qAdd, [] | .zAdd, [] => some (Affine.const 0)
  | .qMul, [] | .zMul, [] => some (Affine.const 1)
  | .qAdd, f :: fs | .zAdd, f :: fs => some (foldAdd f fs)
  | .qSub, f :: fs | .zSub, f :: fs => some (foldSub f fs)
  | .qMul, f :: fs | .zMul, f :: fs => foldMul f fs
  | .qNeg, [f] | .zNeg, [f] => some f.neg
  | .qDiv, [f, g] => f.div? g
  | _, _ => none

def evalNumbers : Op → List ℚ → Option ℚ
  | .qConst q, _ => some q
  | .zConst z, _ => some z
  | .qAdd, [] | .zAdd, [] => some 0
  | .qMul, [] | .zMul, [] => some 1
  | .qAdd, q :: qs | .zAdd, q :: qs => some (qs.foldl (· + ·) q)
  | .qSub, q :: qs | .zSub, q :: qs => some (qs.foldl (· - ·) q)
  | .qMul, q :: qs | .zMul, q :: qs => some (qs.foldl (· * ·) q)
  | .qNeg, [q] | .zNeg, [q] => some (-q)
  | .qDiv, [q, r] => some (q / r)
  | _, _ => none

def normalizeOp_sound (op : Op) (fs : List Affine) (out : Affine) (x : ℕ → ℚ)
    (h : normalizeOp op fs = some out) :
    evalNumbers op (fs.map fun f => f.eval x) = some (out.eval x) := by
  fun_cases normalizeOp op fs <;>
    simp only [normalizeOp, evalNumbers, List.map_nil, List.map_cons, Option.some.injEq] at h ⊢
  all_goals first
    | (cases h <;> simp [Affine.eval_const, Affine.eval_neg, eval_foldAdd, eval_foldSub])
    | exact (eval_foldMul _ _ _ x h).symm
    | exact (Affine.div?_sound _ _ _ x h).symm

def rationalOp : Op → Bool
  | .qConst _ | .qAdd | .qSub | .qMul | .qNeg | .qDiv => true
  | _ => false

def integerOp : Op → Bool
  | .zConst _ | .zAdd | .zSub | .zMul | .zNeg => true
  | _ => false

def intCast_foldl_add (xs : List ℤ) (a : ℤ) :
    ((xs.foldl (· + ·) a : ℤ) : ℚ) =
      (xs.map fun z => (z : ℚ)).foldl (· + ·) (a : ℚ) := by
  induction xs generalizing a with
  | nil => rfl
  | cons z zs ih => simpa using ih (a + z)

def intCast_foldl_sub (xs : List ℤ) (a : ℤ) :
    ((xs.foldl (· - ·) a : ℤ) : ℚ) =
      (xs.map fun z => (z : ℚ)).foldl (· - ·) (a : ℚ) := by
  induction xs generalizing a with
  | nil => rfl
  | cons z zs ih => simpa using ih (a - z)

def intCast_foldl_mul (xs : List ℤ) (a : ℤ) :
    ((xs.foldl (· * ·) a : ℤ) : ℚ) =
      (xs.map fun z => (z : ℚ)).foldl (· * ·) (a : ℚ) := by
  induction xs generalizing a with
  | nil => rfl
  | cons z zs ih => simpa using ih (a * z)

def evalNumbers_rational (input : Valuation) (op : Op) (vs : List Value) (q : ℚ)
    (ho : rationalOp op = true) (h : evalNumbers op (vs.map Value.q) = some q) :
    (evalOp input op vs).q = q := by
  fun_cases evalOp input op vs <;>
    simp_all [rationalOp, evalOp, evalNumbers, ratValue, zeroValue]
  cases op <;> simp_all [rationalOp]
  all_goals cases vs with
    | nil => simp_all [evalNumbers]
    | cons a rest =>
      cases rest with
      | nil => simp_all [evalNumbers]
      | cons b tail => cases tail <;> simp_all [evalNumbers]

def evalNumbers_integer (input : Valuation) (op : Op) (vs : List Value) (q : ℚ)
    (ho : integerOp op = true)
    (h : evalNumbers op (vs.map fun v => (v.z : ℚ)) = some q) :
    ((evalOp input op vs).z : ℚ) = q := by
  fun_cases evalOp input op vs <;>
    simp_all [integerOp, evalOp, evalNumbers, intValue, zeroValue,
      intCast_foldl_add, intCast_foldl_sub, intCast_foldl_mul, List.map_map]
  all_goals first
    | (rw [List.flatMap_map, ← List.map_eq_flatMap]; exact h)
    | skip
  cases op <;> simp_all [integerOp]
  all_goals cases vs with
    | nil => simp_all [evalNumbers]
    | cons a rest =>
      cases rest with
      | nil => simp_all [evalNumbers]
      | cons b tail => cases tail <;> simp_all [evalNumbers]

def normalizeOp_rational_sound (input : Valuation) (op : Op)
    (fs : List Affine) (vs : List Value) (out : Affine) (x : ℕ → ℚ)
    (hvals : fs.map (fun f => f.eval x) = vs.map Value.q)
    (ho : rationalOp op = true) (h : normalizeOp op fs = some out) :
    out.eval x = (evalOp input op vs).q := by
  have hn := normalizeOp_sound op fs out x h
  rw [hvals] at hn
  exact (evalNumbers_rational input op vs _ ho hn).symm

def normalizeOp_integer_sound (input : Valuation) (op : Op)
    (fs : List Affine) (vs : List Value) (out : Affine) (x : ℕ → ℚ)
    (hvals : fs.map (fun f => f.eval x) = vs.map fun v => (v.z : ℚ))
    (ho : integerOp op = true) (h : normalizeOp op fs = some out) :
    out.eval x = ((evalOp input op vs).z : ℚ) := by
  have hn := normalizeOp_sound op fs out x h
  rw [hvals] at hn
  exact (evalNumbers_integer input op vs _ ho hn).symm

end ClosureLinear

end PolicySubmissionPart9

/- Component PolicyLinearDAG; SHA256 1f375409245a24265a43b10cca7e09610d1b0626a446f54083e3cdc44b8e343a. -/
section PolicySubmissionPart10
/- Checked affine normalization of finite arithmetic fragments of an expression DAG. -/
namespace ClosureLinear
open ClosureSemantics

def collect {α β : Type} (f : α → Option β) : List α → Option (List β)
  | [] => some []
  | a :: as => do
    let b ← f a
    let bs ← collect f as
    pure (b :: bs)

def collect_sound {α β γ : Type} (f : α → Option β) (g : β → γ) (e : α → γ)
    (h : ∀ a b, f a = some b → g b = e a) (as : List α) (bs : List β)
    (hc : collect f as = some bs) : bs.map g = as.map e := by
  induction as generalizing bs with
  | nil => simpa [collect] using hc.symm
  | cons a as ih =>
    cases ha : f a with
    | none => simp [collect, ha] at hc
    | some b =>
      cases hr : collect f as with
      | none => simp [collect, ha, hr] at hc
      | some rest =>
        have hb : b :: rest = bs := by simpa [collect, ha, hr] using hc
        subst bs
        simp only [List.map_cons, h a b ha, ih rest hr]

def closedOp : Op → Bool
  | .input _ => false
  | _ => true

def evalOp_closed (op : Op) (vs : List Value) (input : Valuation)
    (h : closedOp op = true) :
    evalOp (fun _ => zeroValue) op vs = evalOp input op vs := by
  cases op <;> simp_all [closedOp]
  all_goals cases vs with
    | nil => rfl
    | cons a rest =>
      cases rest with
      | nil => rfl
      | cons b tail =>
        cases tail with
        | nil => rfl
        | cons c more => cases more <;> rfl

def closedNode (program : ℕ → Node) : ℕ → ℕ → Option Value
  | 0, _ => none
  | fuel + 1, i =>
    if closedOp (program i).op then do
      let children ← collect (closedNode program fuel) (program i).children
      pure (evalOp (fun _ => zeroValue) (program i).op children)
    else none

def closedNode_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (fuel i : ℕ) (v : Value)
    (h : closedNode program fuel i = some v) : v = values i := by
  induction fuel generalizing i v with
  | zero => simp [closedNode] at h
  | succ fuel ih =>
    simp only [closedNode] at h
    split at h
    next hop =>
      cases hc : collect (closedNode program fuel) (program i).children with
      | none => simp [hc] at h
      | some children =>
        have hv : evalOp (fun _ => zeroValue) (program i).op children = v := by
          simpa [hc] using h
        subst v
        have hchildren := collect_sound (closedNode program fuel) id values
          (fun j w hw => ih j w hw) _ children hc
        simp only [List.map_id_fun, id_eq] at hchildren
        rw [hchildren, evalOp_closed _ _ input hop, he i]
        rfl
    next => simp_all

def numericValue (integer : Bool) (v : Value) : ℚ :=
  if integer then (v.z : ℚ) else v.q

def numericOp (integer : Bool) (op : Op) : Bool :=
  if integer then integerOp op else rationalOp op

def normalizeOp_numeric_sound (integer : Bool) (input : Valuation) (op : Op)
    (fs : List Affine) (vs : List Value) (out : Affine) (x : ℕ → ℚ)
    (hvals : fs.map (fun f => f.eval x) = vs.map (numericValue integer))
    (ho : numericOp integer op = true) (h : normalizeOp op fs = some out) :
    out.eval x = numericValue integer (evalOp input op vs) := by
  cases integer with
  | false => exact normalizeOp_rational_sound input op fs vs out x hvals ho h
  | true => exact normalizeOp_integer_sound input op fs vs out x hvals ho h

def normalizeTerm (program : ℕ → Node) (cut : ℕ → Option ℕ) (integer : Bool) :
    ℕ → ℕ → Option Affine
  | 0, _ => none
  | fuel + 1, i =>
    match cut i with
    | some j => some (Affine.variable j)
    | none =>
      if numericOp integer (program i).op then do
        let fs ← collect (normalizeTerm program cut integer fuel) (program i).children
        normalizeOp (program i).op fs
      else do
        let v ← closedNode program (fuel + 1) i
        pure (Affine.const (numericValue integer v))

def normalizeTerm_sound (program : ℕ → Node) (cut : ℕ → Option ℕ)
    (integer : Bool) (input values : Valuation) (x : ℕ → ℚ)
    (he : Equations program input values)
    (hcut : ∀ i j, cut i = some j → x j = numericValue integer (values i))
    (fuel i : ℕ) (out : Affine)
    (h : normalizeTerm program cut integer fuel i = some out) :
    out.eval x = numericValue integer (values i) := by
  induction fuel generalizing i out with
  | zero => simp [normalizeTerm] at h
  | succ fuel ih =>
    cases hc : cut i with
    | some j =>
      have hout : Affine.variable j = out := by simpa [normalizeTerm, hc] using h
      subst out
      exact (Affine.eval_variable j x).trans (hcut i j hc)
    | none =>
      simp only [normalizeTerm, hc] at h
      split at h
      next hop =>
        cases hfs : collect (normalizeTerm program cut integer fuel) (program i).children with
        | none => simp [hfs] at h
        | some fs =>
          have hn : normalizeOp (program i).op fs = some out := by simpa [hfs] using h
          have hchildren := collect_sound (normalizeTerm program cut integer fuel)
            (fun f => f.eval x) (fun j => numericValue integer (values j))
            (fun j f hf => ih j f hf) _ fs hfs
          have hv : fs.map (fun f => f.eval x) =
              ((program i).children.map values).map (numericValue integer) := by
            simpa only [List.map_map, Function.comp_def] using hchildren
          rw [he i]
          exact normalizeOp_numeric_sound integer input (program i).op fs
            ((program i).children.map values) out x hv hop hn
      next =>
        cases hv : closedNode program (fuel + 1) i with
        | none => simp [hv] at h
        | some v =>
          have hout : Affine.const (numericValue integer v) = out := by simpa [hv] using h
          subst out
          rw [Affine.eval_const, closedNode_sound program input values he _ i v hv]

end ClosureLinear

end PolicySubmissionPart10

/- Component PolicyLinearAtoms; SHA256 3c7cf73f4f3438eb44bfe2443706923a599b27209e7a39ea406262cfc30ab545. -/
section PolicySubmissionPart11
/- Sound conversion of rational and integer comparisons into affine inequalities. -/
namespace ClosureLinear
open ClosureSemantics

abbrev Branches := List (List Row)

def Branches.Holds (bs : Branches) (x : ℕ → ℚ) : Prop :=
  ∃ rows ∈ bs, ∀ r ∈ rows, r.Holds x

def makeRow (integer strict : Bool) (f : Affine) : Row :=
  if integer && strict then ⟨f.sub (Affine.const 1), false⟩ else ⟨f, strict⟩

def makeRow_sound (integer strict : Bool) (f : Affine) (x : ℕ → ℚ)
    (hi : integer = true → ∃ z : ℤ, f.eval x = z)
    (h : if strict then 0 < f.eval x else 0 ≤ f.eval x) :
    (makeRow integer strict f).Holds x := by
  cases integer with
  | false => exact h
  | true =>
    cases strict with
    | false => exact h
    | true =>
      obtain ⟨z, hz⟩ := hi rfl
      have hpos : (0 : ℚ) < z := by simpa [hz] using h
      have hzpos : 0 < z := by exact_mod_cast hpos
      have hone : (1 : ℚ) ≤ z := by exact_mod_cast (show (1 : ℤ) ≤ z by omega)
      simpa [makeRow, Row.Holds, Affine.eval_sub, Affine.eval_const, hz] using sub_nonneg.mpr hone

inductive Comparison where
  | eq | le | lt

def Comparison.eval : Comparison → ℚ → ℚ → Bool
  | .eq, a, b => decide (a = b)
  | .le, a, b => decide (a ≤ b)
  | .lt, a, b => decide (a < b)

def atomBranches (integer : Bool) : Comparison → Bool → Affine → Affine → Branches
  | .eq, true, f, g => [[makeRow integer false (f.sub g), makeRow integer false (g.sub f)]]
  | .eq, false, f, g => [[makeRow integer true (f.sub g)], [makeRow integer true (g.sub f)]]
  | .le, true, f, g => [[makeRow integer false (g.sub f)]]
  | .le, false, f, g => [[makeRow integer true (f.sub g)]]
  | .lt, true, f, g => [[makeRow integer true (g.sub f)]]
  | .lt, false, f, g => [[makeRow integer false (f.sub g)]]

def atomBranches_sound (integer : Bool) (cmp : Comparison) (positive : Bool)
    (f g : Affine) (x : ℕ → ℚ)
    (hi : integer = true → (∃ a : ℤ, f.eval x = a) ∧ (∃ b : ℤ, g.eval x = b))
    (h : cmp.eval (f.eval x) (g.eval x) = positive) :
    (atomBranches integer cmp positive f g).Holds x := by
  have hfg : integer = true → ∃ z : ℤ, (f.sub g).eval x = z := by
    intro he
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hi he
    exact ⟨a - b, by simp [Affine.eval_sub, ha, hb]⟩
  have hgf : integer = true → ∃ z : ℤ, (g.sub f).eval x = z := by
    intro he
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hi he
    exact ⟨b - a, by simp [Affine.eval_sub, ha, hb]⟩
  cases cmp <;> cases positive <;>
    simp only [Comparison.eval, decide_eq_true_eq, decide_eq_false_iff_not] at h <;>
    simp only [atomBranches, Branches.Holds, List.mem_cons, List.not_mem_nil,
      or_false, exists_eq_or_imp, exists_eq_left, forall_eq_or_imp, forall_eq] at ⊢
  · rcases lt_or_gt_of_ne h with hlt | hgt
    · right
      exact makeRow_sound integer true (g.sub f) x hgf (by simpa [Affine.eval_sub] using sub_pos.mpr hlt)
    · left
      exact makeRow_sound integer true (f.sub g) x hfg (by simpa [Affine.eval_sub] using sub_pos.mpr hgt)
  · constructor
    · exact makeRow_sound integer false (f.sub g) x hfg (by simp [Affine.eval_sub, h])
    · exact makeRow_sound integer false (g.sub f) x hgf (by simp [Affine.eval_sub, h])
  · exact makeRow_sound integer true (f.sub g) x hfg
      (by simpa [Affine.eval_sub] using sub_pos.mpr (lt_of_not_ge h))
  · exact makeRow_sound integer false (g.sub f) x hgf
      (by simpa [Affine.eval_sub] using sub_nonneg.mpr h)
  · exact makeRow_sound integer false (f.sub g) x hfg
      (by simpa [Affine.eval_sub] using sub_nonneg.mpr (le_of_not_gt h))
  · exact makeRow_sound integer true (g.sub f) x hgf
      (by simpa [Affine.eval_sub] using sub_pos.mpr h)

def comparisonOp (integer : Bool) (cmp : Comparison) : Op :=
  match integer, cmp with
  | false, .eq => .qEq
  | false, .le => .qLe
  | false, .lt => .qLt
  | true, .eq => .zEq
  | true, .le => .zLe
  | true, .lt => .zLt

def comparisonOp_eval (integer : Bool) (cmp : Comparison) (input : Valuation)
    (a b : Value) :
    (evalOp input (comparisonOp integer cmp) [a, b]).b =
      cmp.eval (numericValue integer a) (numericValue integer b) := by
  cases integer <;> cases cmp <;>
    simp [comparisonOp, evalOp, boolValue, Comparison.eval, numericValue]

def atomBranches_values (integer : Bool) (cmp : Comparison) (positive : Bool)
    (f g : Affine) (x : ℕ → ℚ) (input : Valuation) (a b : Value)
    (hf : f.eval x = numericValue integer a) (hg : g.eval x = numericValue integer b)
    (h : (evalOp input (comparisonOp integer cmp) [a, b]).b = positive) :
    (atomBranches integer cmp positive f g).Holds x := by
  apply atomBranches_sound integer cmp positive f g x
  · intro hi
    subst integer
    exact ⟨⟨a.z, hf⟩, ⟨b.z, hg⟩⟩
  · rw [hf, hg]
    exact (comparisonOp_eval integer cmp input a b).symm.trans h

end ClosureLinear

end PolicySubmissionPart11

/- Component PolicyLinearBranches; SHA256 4c96643afb5a2de47b6c62823b8a60cfa81b6365fef5a092b748b42281c94e60. -/
section PolicySubmissionPart12
/- Boolean branch operations used in checked linear sequents. -/
namespace ClosureLinear

def collect_members {α β : Type} (f : α → Option β) (as : List α) (bs : List β)
    (hc : collect f as = some bs) :
    (∀ a ∈ as, ∃ b ∈ bs, f a = some b) ∧
      (∀ b ∈ bs, ∃ a ∈ as, f a = some b) := by
  induction as generalizing bs with
  | nil =>
    have hb : bs = [] := by simpa [collect] using hc.symm
    subst bs
    simp
  | cons a as ih =>
    cases ha : f a with
    | none => simp [collect, ha] at hc
    | some b =>
      cases hr : collect f as with
      | none => simp [collect, ha, hr] at hc
      | some rest =>
        have hb : b :: rest = bs := by simpa [collect, ha, hr] using hc
        subst bs
        obtain ⟨hin, hout⟩ := ih rest hr
        constructor
        · intro c hm
          rcases List.mem_cons.mp hm with rfl | hm
          · exact ⟨b, List.mem_cons_self .., ha⟩
          · obtain ⟨d, hd, hfd⟩ := hin c hm
            exact ⟨d, List.mem_cons_of_mem _ hd, hfd⟩
        · intro d hm
          rcases List.mem_cons.mp hm with rfl | hm
          · exact ⟨a, List.mem_cons_self .., ha⟩
          · obtain ⟨c, hc, hfc⟩ := hout d hm
            exact ⟨c, List.mem_cons_of_mem _ hc, hfc⟩

def crossBranches (a b : Branches) : Branches :=
  a.flatMap fun xs => b.map fun ys => xs ++ ys

def crossBranches_sound (a b : Branches) (x : ℕ → ℚ)
    (ha : a.Holds x) (hb : b.Holds x) : (crossBranches a b).Holds x := by
  obtain ⟨xs, hxs, hx⟩ := ha
  obtain ⟨ys, hys, hy⟩ := hb
  refine ⟨xs ++ ys, ?_, ?_⟩
  · exact List.mem_flatMap.mpr ⟨xs, hxs, List.mem_map.mpr ⟨ys, hys, rfl⟩⟩
  · intro r hr
    rcases List.mem_append.mp hr with hr | hr
    · exact hx r hr
    · exact hy r hr

def allBranches : List Branches → Branches
  | [] => [[]]
  | bs :: rest => crossBranches bs (allBranches rest)

def allBranches_sound (bs : List Branches) (x : ℕ → ℚ)
    (h : ∀ b ∈ bs, b.Holds x) : (allBranches bs).Holds x := by
  induction bs with
  | nil => exact ⟨[], List.mem_cons_self .., by simp⟩
  | cons b bs ih =>
    exact crossBranches_sound b (allBranches bs) x
      (h b (List.mem_cons_self ..)) (ih (fun c hc => h c (List.mem_cons_of_mem _ hc)))

def anyBranches_sound (bs : List Branches) (x : ℕ → ℚ)
    (h : ∃ b ∈ bs, b.Holds x) : Branches.Holds bs.flatten x := by
  obtain ⟨b, hb, rows, hr, hrows⟩ := h
  exact ⟨rows, List.mem_flatten.mpr ⟨b, hb, hr⟩, hrows⟩

def combineBranches (conjunction : Bool) (bs : List Branches) : Branches :=
  if conjunction then allBranches bs else bs.flatten

def combineBranches_sound (conjunction : Bool) (bs : List Branches) (x : ℕ → ℚ)
    (h : if conjunction then ∀ b ∈ bs, b.Holds x else ∃ b ∈ bs, b.Holds x) :
    (combineBranches conjunction bs).Holds x := by
  cases conjunction with
  | false => exact anyBranches_sound bs x h
  | true => exact allBranches_sound bs x h

def combine_collect_sound (conjunction : Bool) {α : Type} (f : α → Option Branches)
    (values : α → Prop) (as : List α) (bs : List Branches) (x : ℕ → ℚ)
    (hf : ∀ a b, f a = some b → values a → b.Holds x)
    (hc : collect f as = some bs)
    (h : if conjunction then ∀ a ∈ as, values a else ∃ a ∈ as, values a) :
    (combineBranches conjunction bs).Holds x := by
  obtain ⟨hin, hout⟩ := collect_members f as bs hc
  apply combineBranches_sound
  cases conjunction with
  | false =>
    obtain ⟨a, ha, hval⟩ := h
    obtain ⟨b, hb, hfb⟩ := hin a ha
    exact ⟨b, hb, hf a b hfb hval⟩
  | true =>
    intro b hb
    obtain ⟨a, ha, hfa⟩ := hout b hb
    exact hf a b hfa (h a ha)

end ClosureLinear

end PolicySubmissionPart12

/- Component PolicyLinearFormula; SHA256 26271c067cc0506a5457180f6b9108c21705aec0858414f2180b044640791ce2. -/
section PolicySubmissionPart13
/- Verified extraction of linear contradiction branches from Boolean DAG nodes. -/
namespace ClosureLinear
open ClosureSemantics

inductive FormulaRule where
  | fixedValue : Bool → FormulaRule
  | same : ℕ → FormulaRule
  | neg : ℕ → FormulaRule
  | combine : Bool → List ℕ → FormulaRule
  | atom : Comparison → ℕ → ℕ → FormulaRule
  | reject

def comparisonOf (integer : Bool) : Op → Option Comparison
  | .qEq => if integer then none else some .eq
  | .qLe => if integer then none else some .le
  | .qLt => if integer then none else some .lt
  | .zEq => if integer then some .eq else none
  | .zLe => if integer then some .le else none
  | .zLt => if integer then some .lt else none
  | _ => none

def comparisonOf_eq (integer : Bool) (op : Op) (cmp : Comparison)
    (h : comparisonOf integer op = some cmp) : op = comparisonOp integer cmp := by
  cases integer <;> cases op <;> simp_all [comparisonOf, comparisonOp]
  all_goals subst cmp; rfl

def parseFormula (integer : Bool) (node : Node) : FormulaRule :=
  match node.op, node.children with
  | .bConst b, _ => .fixedValue b
  | .alias, [j] => .same j
  | .bNot, [j] => .neg j
  | .bAnd, js => .combine true js
  | .bOr, js => .combine false js
  | op, js =>
    match comparisonOf integer op, js with
    | some cmp, [a, b] => .atom cmp a b
    | _, _ => .reject

def FormulaRule.Holds (integer : Bool) (input values : Valuation) (positive : Bool) :
    FormulaRule → Prop
  | .fixedValue b => b = positive
  | .same j => (values j).b = positive
  | .neg j => (values j).b = !positive
  | .combine conjunction js =>
    if conjunction == positive then ∀ j ∈ js, (values j).b = positive
    else ∃ j ∈ js, (values j).b = positive
  | .atom cmp a b => (evalOp input (comparisonOp integer cmp) [values a, values b]).b = positive
  | .reject => True

def parseFormula_sound (integer : Bool) (input values : Valuation)
    (node : Node) (positive : Bool) (h : (evalNode input values node).b = positive) :
    (parseFormula integer node).Holds integer input values positive := by
  fun_cases parseFormula integer node <;>
    simp_all [FormulaRule.Holds, evalNode, evalOp, boolValue]
  · cases positive <;> simp_all
  · cases positive <;> simp_all
  · rename_i cmp a b _ _ _ hc _
    rw [← comparisonOf_eq integer node.op cmp hc]
    exact h

def normalizeFormula (program : ℕ → Node) (cut : ℕ → Option ℕ) (integer : Bool) :
    ℕ → ℕ → Bool → Option Branches
  | 0, _, _ => none
  | fuel + 1, i, positive =>
    match parseFormula integer (program i) with
    | .fixedValue b =>
      some (if b == positive then [[]] else [[makeRow false false (Affine.const (-1))]])
    | .same j => normalizeFormula program cut integer fuel j positive
    | .neg j => normalizeFormula program cut integer fuel j (!positive)
    | .combine conjunction js => do
      let bs ← collect (fun j => normalizeFormula program cut integer fuel j positive) js
      pure (combineBranches (conjunction == positive) bs)
    | .atom cmp a b => do
      let f ← normalizeTerm program cut integer fuel a
      let g ← normalizeTerm program cut integer fuel b
      pure (atomBranches integer cmp positive f g)
    | .reject => none

def normalizeFormula_sound (program : ℕ → Node) (cut : ℕ → Option ℕ)
    (integer : Bool) (input values : Valuation) (x : ℕ → ℚ)
    (he : Equations program input values)
    (hcut : ∀ i j, cut i = some j → x j = numericValue integer (values i))
    (fuel i : ℕ) (positive : Bool) (bs : Branches)
    (hn : normalizeFormula program cut integer fuel i positive = some bs)
    (h : (values i).b = positive) : bs.Holds x := by
  induction fuel generalizing i positive bs with
  | zero => simp [normalizeFormula] at hn
  | succ fuel ih =>
    have hv : (evalNode input values (program i)).b = positive := by rw [← he i]; exact h
    have hs := parseFormula_sound integer input values (program i) positive hv
    simp only [normalizeFormula] at hn
    cases hr : parseFormula integer (program i) with
    | fixedValue b =>
      rw [hr] at hn hs
      have hb : b = positive := hs
      subst b
      have hbs : [[]] = bs := by simpa using hn
      subst bs
      exact ⟨[], List.mem_cons_self .., by simp⟩
    | same j =>
      rw [hr] at hn hs
      exact ih j positive bs hn hs
    | neg j =>
      rw [hr] at hn hs
      exact ih j (!positive) bs hn hs
    | combine conjunction js =>
      rw [hr] at hn hs
      cases hc : collect (fun j => normalizeFormula program cut integer fuel j positive) js with
      | none => simp [hc] at hn
      | some children =>
        have hbs : combineBranches (conjunction == positive) children = bs := by
          simpa [hc] using hn
        subst bs
        exact combine_collect_sound (conjunction == positive)
          (fun j => normalizeFormula program cut integer fuel j positive)
          (fun j => (values j).b = positive) js children x
          (fun j b hj hv => ih j positive b hj hv) hc hs
    | atom cmp a b =>
      rw [hr] at hn hs
      cases hf : normalizeTerm program cut integer fuel a with
      | none => simp [hf] at hn
      | some f =>
        cases hg : normalizeTerm program cut integer fuel b with
        | none => simp [hf, hg] at hn
        | some g =>
          have hbs : atomBranches integer cmp positive f g = bs := by simpa [hf, hg] using hn
          subst bs
          exact atomBranches_values integer cmp positive f g x input (values a) (values b)
            (normalizeTerm_sound program cut integer input values x he hcut fuel a f hf)
            (normalizeTerm_sound program cut integer input values x he hcut fuel b g hg) hs
    | reject => simp [hr] at hn

end ClosureLinear

end PolicySubmissionPart13

/- Component PolicyLinearSequent; SHA256 175452e3dd63ee58637954deb45cb870dbd185e315751127df0ad92a239e7f7e. -/
section PolicySubmissionPart14
/- A sound, computational checker for arithmetic implication leaves. -/
namespace ClosureLinear
open ClosureSemantics

def selectRows (rows : List Row) (weights : List (ℕ × ℕ)) : Option (List (ℕ × Row)) :=
  collect (fun iw => rows[iw.1]?.map (fun r => (iw.2, r))) weights

def selectRows_sound (rows : List Row) (weights : List (ℕ × ℕ))
    (selected : List (ℕ × Row)) (x : ℕ → ℚ)
    (hs : selectRows rows weights = some selected) (h : ∀ r ∈ rows, r.Holds x) :
    ∀ a ∈ selected, a.2.Holds x := by
  intro a ha
  obtain ⟨iw, _, hw⟩ := (collect_members _ weights selected hs).2 a ha
  cases hr : rows[iw.1]? with
  | none => simp [hr] at hw
  | some r =>
    have heq : (iw.2, r) = a := by simpa [hr] using hw
    subst a
    exact h r (List.mem_of_getElem? hr)

def checkBranch (rows : List Row) (weights : List (ℕ × ℕ)) : Bool :=
  match selectRows rows weights with
  | some selected => check selected
  | none => false

def checkBranch_sound (rows : List Row) (weights : List (ℕ × ℕ)) (x : ℕ → ℚ)
    (hc : checkBranch rows weights = true) (h : ∀ r ∈ rows, r.Holds x) : False := by
  cases hs : selectRows rows weights with
  | none => simp [checkBranch, hs] at hc
  | some selected =>
    exact check_sound selected x (selectRows_sound rows weights selected x hs h)
      (by simpa [checkBranch, hs] using hc)

def checkBranches : Branches → List (List (ℕ × ℕ)) → Bool
  | [], [] => true
  | rows :: bs, weights :: cs => checkBranch rows weights && checkBranches bs cs
  | _, _ => false

def checkBranches_sound (bs : Branches) (certs : List (List (ℕ × ℕ))) (x : ℕ → ℚ)
    (hc : checkBranches bs certs = true) (h : bs.Holds x) : False := by
  induction bs generalizing certs with
  | nil => obtain ⟨rows, hr, _⟩ := h; simp at hr
  | cons rows bs ih =>
    cases certs with
    | nil => simp [checkBranches] at hc
    | cons weights cs =>
      have hp : checkBranch rows weights = true ∧ checkBranches bs cs = true := by
        simpa [checkBranches, Bool.and_eq_true] using hc
      obtain ⟨rs, hrs, hrows⟩ := h
      rcases List.mem_cons.mp hrs with rfl | hrs
      · exact checkBranch_sound rs weights x hp.1 hrows
      · exact ih cs hp.2 ⟨rs, hrs, hrows⟩

def normalizeSequent (program : ℕ → Node) (cut : ℕ → Option ℕ) (integer : Bool)
    (fuel : ℕ) (signed : List (ℕ × Bool)) : Option Branches := do
  let bs ← collect (fun ib => normalizeFormula program cut integer fuel ib.1 ib.2) signed
  pure (allBranches bs)

def normalizeSequent_sound (program : ℕ → Node) (cut : ℕ → Option ℕ)
    (integer : Bool) (input values : Valuation) (x : ℕ → ℚ)
    (he : Equations program input values)
    (hcut : ∀ i j, cut i = some j → x j = numericValue integer (values i))
    (fuel : ℕ) (signed : List (ℕ × Bool)) (bs : Branches)
    (hn : normalizeSequent program cut integer fuel signed = some bs)
    (h : ∀ ib ∈ signed, (values ib.1).b = ib.2) : bs.Holds x := by
  cases hc : collect (fun ib => normalizeFormula program cut integer fuel ib.1 ib.2) signed with
  | none => simp [normalizeSequent, hc] at hn
  | some children =>
    have hbs : allBranches children = bs := by simpa [normalizeSequent, hc] using hn
    subst bs
    exact combine_collect_sound true
      (fun ib : ℕ × Bool => normalizeFormula program cut integer fuel ib.1 ib.2)
      (fun ib : ℕ × Bool => (values ib.1).b = ib.2) signed children x
      (fun ib b hb hv => normalizeFormula_sound program cut integer input values x
        he hcut fuel ib.1 ib.2 b hb hv) hc h

def checkSequent (program : ℕ → Node) (cut : ℕ → Option ℕ) (integer : Bool)
    (fuel : ℕ) (signed : List (ℕ × Bool)) (certs : List (List (ℕ × ℕ))) : Bool :=
  match normalizeSequent program cut integer fuel signed with
  | some bs => checkBranches bs certs
  | none => false

def checkSequent_sound (program : ℕ → Node) (cut : ℕ → Option ℕ)
    (integer : Bool) (input values : Valuation) (x : ℕ → ℚ)
    (he : Equations program input values)
    (hcut : ∀ i j, cut i = some j → x j = numericValue integer (values i))
    (fuel : ℕ) (signed : List (ℕ × Bool)) (certs : List (List (ℕ × ℕ)))
    (hc : checkSequent program cut integer fuel signed certs = true)
    (h : ∀ ib ∈ signed, (values ib.1).b = ib.2) : False := by
  cases hn : normalizeSequent program cut integer fuel signed with
  | none => simp [checkSequent, hn] at hc
  | some bs =>
    exact checkBranches_sound bs certs x (by simpa [checkSequent, hn] using hc)
      (normalizeSequent_sound program cut integer input values x he hcut fuel signed bs hn h)

def cutIndex : List ℕ → ℕ → Option ℕ
  | [], _ => none
  | a :: as, i => if i = a then some 0 else (cutIndex as i).map Nat.succ

def cutIndex_get (ids : List ℕ) (i j : ℕ) (h : cutIndex ids i = some j) :
    ids[j]? = some i := by
  induction ids generalizing j with
  | nil => simp [cutIndex] at h
  | cons a as ih =>
    by_cases hi : i = a
    · have hj : j = 0 := by simpa [cutIndex, hi] using h.symm
      subst j
      simp [hi]
    · cases hc : cutIndex as i with
      | none => simp [cutIndex, hi, hc] at h
      | some k =>
        have hj : k + 1 = j := by simpa [cutIndex, hi, hc] using h
        subst j
        simpa using ih k hc

def checkSequent_of_cuts (program : ℕ → Node) (ids : List ℕ) (integer : Bool)
    (input values : Valuation) (he : Equations program input values)
    (fuel : ℕ) (signed : List (ℕ × Bool)) (certs : List (List (ℕ × ℕ)))
    (hc : checkSequent program (cutIndex ids) integer fuel signed certs = true)
    (h : ∀ ib ∈ signed, (values ib.1).b = ib.2) : False := by
  apply checkSequent_sound program (cutIndex ids) integer input values
    (fun j => numericValue integer (values (ids[j]?.getD 0))) he _ fuel signed certs hc h
  intro i j hj
  rw [cutIndex_get ids i j hj]
  rfl

def checkImplication (program : ℕ → Node) (ids : List ℕ) (integer : Bool)
    (fuel : ℕ) (premises : List ℕ) (conclusion : ℕ) (certs : List (List (ℕ × ℕ))) : Bool :=
  checkSequent program (cutIndex ids) integer fuel
    (premises.map (fun i => (i, true)) ++ [(conclusion, false)]) certs

def checkImplication_sound (program : ℕ → Node) (ids : List ℕ) (integer : Bool)
    (input values : Valuation) (he : Equations program input values)
    (fuel : ℕ) (premises : List ℕ) (conclusion : ℕ) (certs : List (List (ℕ × ℕ)))
    (hc : checkImplication program ids integer fuel premises conclusion certs = true)
    (h : ∀ i ∈ premises, (values i).b = true) : (values conclusion).b = true := by
  cases hconclusion : (values conclusion).b with
  | true => rfl
  | false =>
    apply False.elim
    apply checkSequent_of_cuts program ids integer input values he fuel _ certs hc
    intro ib hib
    rcases List.mem_append.mp hib with hp | heq
    · obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hp
      exact h i hi
    · have hi : ib = (conclusion, false) := by simpa using heq
      subst ib
      exact hconclusion

end ClosureLinear

end PolicySubmissionPart14

/- Component ClosurePattern; SHA256 a786e2a8c781ead32f67dfb7c900933fe95e93bd08a45ed6fef7e064b80fe035. -/
section PolicySubmissionPart15
/- A total matcher for finite expression schemas, with kernel soundness. -/
namespace ClosurePattern
open ClosureSemantics

inductive Pattern where
  | hole : Nat → Pattern
  | node : Op → List Pattern → Pattern

def eval (env : Valuation) : Pattern → Value
  | .hole k => env k
  | .node op children => evalOp (fun _ => zeroValue) op (children.map (eval env))

def sameOp : Op → Op → Bool
  | .input a, .input b => a == b
  | .qConst a, .qConst b => a == b
  | .zConst a, .zConst b => a == b
  | .bConst a, .bConst b => a == b
  | .alias, .alias | .bNot, .bNot | .bOr, .bOr | .bAnd, .bAnd
  | .bEq, .bEq | .ite, .ite | .qEq, .qEq | .zEq, .zEq
  | .qLe, .qLe | .zLe, .zLe | .qLt, .qLt | .zLt, .zLt
  | .qAdd, .qAdd | .zAdd, .zAdd | .qMul, .qMul | .zMul, .zMul
  | .qNeg, .qNeg | .zNeg, .zNeg | .qSub, .qSub | .zSub, .zSub
  | .qDiv, .qDiv => true
  | _, _ => false

def sameOp_sound (a b : Op) (h : sameOp a b = true) : a = b := by
  cases a <;> cases b <;> simp_all [sameOp]

def allPairs (f : α → β → Bool) : List α → List β → Bool
  | [], [] => true
  | a :: as, b :: bs => f a b && allPairs f as bs
  | _, _ => false

def allPairs_map_eq (f : α → β → Bool) (left : α → γ) (right : β → γ)
    (h : ∀ a b, f a b = true → left a = right b)
    (as : List α) (bs : List β) (hc : allPairs f as bs = true) :
    as.map left = bs.map right := by
  induction as generalizing bs with
  | nil => cases bs <;> simp_all [allPairs]
  | cons a as ih =>
    cases bs with
    | nil => simp [allPairs] at hc
    | cons b bs =>
      have hh : f a b = true ∧ allPairs f as bs = true := by
        simpa [allPairs, Bool.and_eq_true] using hc
      simp only [List.map_cons, h a b hh.1, ih bs hh.2]

def check (program : Nat → Node) (cut : Nat → Option Nat) :
    Nat → Pattern → Nat → Bool
  | 0, _, _ => false
  | _ + 1, .hole k, i => cut i == some k
  | fuel + 1, .node op children, i =>
      ClosureLinear.closedOp op && sameOp op (program i).op &&
        allPairs (check program cut fuel) children (program i).children

def check_sound (program : Nat → Node) (cut : Nat → Option Nat)
    (input values env : Valuation) (he : Equations program input values)
    (hcut : ∀ i j, cut i = some j → env j = values i)
    (fuel : Nat) (pattern : Pattern) (i : Nat)
    (hc : check program cut fuel pattern i = true) : eval env pattern = values i := by
  induction fuel generalizing pattern i with
  | zero => simp [check] at hc
  | succ fuel ih =>
    cases pattern with
    | hole k =>
      simp only [eval]
      apply hcut i k
      simpa [check, beq_iff_eq] using hc
    | node op children =>
      have hh : (ClosureLinear.closedOp op = true ∧ sameOp op (program i).op = true) ∧
          allPairs (check program cut fuel) children (program i).children = true := by
        simpa only [check, Bool.and_eq_true] using hc
      have hop := sameOp_sound op (program i).op hh.1.2
      have hchildren := allPairs_map_eq (check program cut fuel) (eval env) values
        (fun p j hp => ih p j hp) children (program i).children hh.2
      simp only [eval, hchildren]
      rw [ClosureLinear.evalOp_closed _ _ input hh.1.1, hop, he i]
      rfl

def environment (ids : List Nat) (values : Valuation) : Valuation :=
  fun j => values (ids[j]?.getD 0)

def check_of_cuts (program : Nat → Node) (ids : List Nat)
    (input values : Valuation) (he : Equations program input values)
    (fuel : Nat) (pattern : Pattern) (i : Nat)
    (hc : check program (ClosureLinear.cutIndex ids) fuel pattern i = true) :
    eval (environment ids values) pattern = values i := by
  apply check_sound program (ClosureLinear.cutIndex ids) input values (environment ids values)
    he _ fuel pattern i hc
  intro k j hj
  simp only [environment, ClosureLinear.cutIndex_get ids k j hj]
  rfl

end ClosurePattern

end PolicySubmissionPart15

/- Component ClosureSchema; SHA256 813f5d94ac9b3da1870e09109161da29971933311616dd09775ec803969d51d9. -/
section PolicySubmissionPart16
/- Ordinary proved expression schemas and checked instantiation in a DAG. -/
namespace ClosurePattern
open ClosureSemantics

structure Schema where
  definitions : List (Nat × Pattern)
  premises : List Pattern
  conclusion : Pattern

def Schema.Valid (s : Schema) : Prop :=
  ∀ env : Valuation,
    (∀ d ∈ s.definitions, env d.1 = eval env d.2) →
    (∀ p ∈ s.premises, (eval env p).b = true) →
    (eval env s.conclusion).b = true

def checkSchema (program : Nat → Node) (ids : List Nat) (fuel : Nat)
    (s : Schema) (premises : List Nat) (conclusion : Nat) : Bool :=
  s.definitions.all (fun d => check program (ClosureLinear.cutIndex ids) fuel
    d.2 (ids[d.1]?.getD 0)) &&
  allPairs (check program (ClosureLinear.cutIndex ids) fuel) s.premises premises &&
  check program (ClosureLinear.cutIndex ids) fuel s.conclusion conclusion

def checkSchema_sound (program : Nat → Node) (ids : List Nat)
    (input values : Valuation) (he : Equations program input values)
    (fuel : Nat) (s : Schema) (premises : List Nat) (conclusion : Nat)
    (hv : s.Valid) (hc : checkSchema program ids fuel s premises conclusion = true)
    (hp : ∀ i ∈ premises, (values i).b = true) : (values conclusion).b = true := by
  have hh : (s.definitions.all (fun d => check program (ClosureLinear.cutIndex ids) fuel
        d.2 (ids[d.1]?.getD 0)) = true ∧
      allPairs (check program (ClosureLinear.cutIndex ids) fuel) s.premises premises = true) ∧
      check program (ClosureLinear.cutIndex ids) fuel s.conclusion conclusion = true := by
    simpa only [checkSchema, Bool.and_eq_true] using hc
  have hd : ∀ d ∈ s.definitions, environment ids values d.1 =
      eval (environment ids values) d.2 := by
    intro d hdm
    exact (check_of_cuts program ids input values he fuel d.2 _
      (List.all_eq_true.mp hh.1.1 d hdm)).symm
  have hmaps : s.premises.map (eval (environment ids values)) = premises.map values := by
    exact allPairs_map_eq (check program (ClosureLinear.cutIndex ids) fuel)
      (eval (environment ids values)) values
      (fun p i h => check_of_cuts program ids input values he fuel p i h)
      s.premises premises hh.1.2
  have hps : ∀ p ∈ s.premises, (eval (environment ids values) p).b = true := by
    intro p hpm
    have hm : eval (environment ids values) p ∈ premises.map values := by
      rw [← hmaps]
      exact List.mem_map.mpr ⟨p, hpm, rfl⟩
    obtain ⟨i, hi, heq⟩ := List.mem_map.mp hm
    rw [← heq]
    exact hp i hi
  have hout := hv (environment ids values) hd hps
  rw [check_of_cuts program ids input values he fuel s.conclusion conclusion hh.2] at hout
  exact hout

end ClosurePattern

end PolicySubmissionPart16

