/- Frozen source ClosureRawDepth5Policy; SHA256 cdf58e7d4efa59a34a6df9cf802df23f66f0b327b2463a31d9ceb6bf9663e065. -/
section PolicyCombinatorialFront_ClosureRawDepth5Policy

/- Depth-5 finite closure.

The generator `build_closure_1062.py` finds the closure already contradictory at
depth 5 (cells `5^i * 7^j`, `i + j ≤ 5`): 21 nodes instead of 36, with a Z3 proof
and certificate pipeline roughly half the size.

The depth-5 cells are exactly the first 21 nodes of `closureNode`, and the
depth-4 nodes 10..14 already have the depth-5 nodes 15..20 as children, so no
renumbering is needed: nodes 15..20 simply become leaves.

`closureRawHypothesis5_of_raw` shows every model of the depth-7 hypothesis is a
model of the depth-5 one, so the existing mathematical proof of
`ClosureRawHypothesis` is reused unchanged. -/

namespace Bounty

/-- `closureNodeConstraint` with the depth-5 nodes `15 ≤ k` treated as leaves. -/
noncomputable def closureNodeConstraint5 (eps : Bool) (k : ℕ) (X Y : ℚ)
    (p : ℕ → Prop) (r : ℕ → ℚ) : Prop := by
  classical
  exact if k = 0 then
    ¬closureNodeAvailable eps k 0 X Y p r ∧ ¬closureNodeAvailable eps k 1 X Y p r
  else if 15 ≤ k then
    3 * (closureNode k).v / 4 ≤ r k ∧
    if p k then normalizedStateValid (closureNodeType eps k) 1 (closureNode k).v
      (closureNodeFour k X) (closureNodeThree k Y) (closureLossFour k X) (closureLossThree k Y) (r k)
    else normalizedStateValid (closureNodeType eps k) 0 (closureNode k).v
      (closureNodeFour k X) (closureNodeThree k Y) (closureLossFour k X) (closureLossThree k Y) (r k)
  else
    (closureNodeAvailable eps k 0 X Y p r ∨ closureNodeAvailable eps k 1 X Y p r) ∧
    (p k ↔ if 2 * closureNodeFour k X ≤ (closureNode k).v
      then closureNodeAvailable eps k 1 X Y p r else ¬closureNodeAvailable eps k 0 X Y p r) ∧
    r k = if p k then closureNodeTrial eps k 1 X Y p r else closureNodeTrial eps k 0 X Y p r

noncomputable def ClosureRawHypothesis5 (eps : Bool) (X Y : ℚ) (p : ℕ → Prop) (r : ℕ → ℚ) : Prop :=
  1 / 4 < X ∧ X ≤ 1 ∧ 1 / 3 < Y ∧ Y ≤ 1 ∧ ∀ k < 21, closureNodeConstraint5 eps k X Y p r

/-- Every trial value dominates `3v/4`: it is a `max` whose innermost left term is `3v/4`. -/
def closureNodeTrial_ge (eps : Bool) (k phase : ℕ) (X Y : ℚ)
    (p : ℕ → Prop) (r : ℕ → ℚ) :
    3 * (closureNode k).v / 4 ≤ closureNodeTrial eps k phase X Y p r := by
  unfold closureNodeTrial normalizedTrialValue normalizedProfileTrial
  exact le_trans (le_max_left _ _) (le_max_left _ _)

/-- None of the first 28 nodes is a depth-7 leaf. -/
def closureNode_leaf_false (k : ℕ) (hk : k < 28) : (closureNode k).leaf = false := by
  interval_cases k <;> rfl

/-- The depth-7 hypothesis implies the depth-5 hypothesis on the same `p`, `r`. -/
def closureRawHypothesis5_of_raw (eps : Bool) (X Y : ℚ) (p : ℕ → Prop) (r : ℕ → ℚ)
    (h : ClosureRawHypothesis eps X Y p r) : ClosureRawHypothesis5 eps X Y p r := by
  classical
  obtain ⟨h1, h2, h3, h4, hall⟩ := h
  refine ⟨h1, h2, h3, h4, fun k hk => ?_⟩
  have hc := hall k (by omega)
  have hleaf := closureNode_leaf_false k (by omega)
  unfold closureNodeConstraint at hc
  unfold closureNodeConstraint5
  by_cases hk0 : k = 0
  · simpa only [hk0, if_true] using hc
  · rw [if_neg hk0] at hc ⊢
    rw [if_neg (by simp [hleaf])] at hc
    by_cases h15 : 15 ≤ k
    · rw [if_pos h15]
      obtain ⟨hor, hp, hr⟩ := hc
      refine ⟨?_, ?_⟩
      · rw [hr]
        split_ifs
        · exact closureNodeTrial_ge eps k 1 X Y p r
        · exact closureNodeTrial_ge eps k 0 X Y p r
      · by_cases hpk : p k
        · rw [if_pos hpk, hr, if_pos hpk]
          show closureNodeAvailable eps k 1 X Y p r
          split_ifs at hp with hC
          · exact hp.mp hpk
          · exact hor.resolve_left (hp.mp hpk)
        · rw [if_neg hpk, hr, if_neg hpk]
          show closureNodeAvailable eps k 0 X Y p r
          split_ifs at hp with hC
          · exact hor.resolve_right (fun h1 => hpk (hp.mpr h1))
          · exact not_not.mp (fun h0 => hpk (hp.mpr h0))
    · rw [if_neg h15]
      exact hc

end Bounty


end PolicyCombinatorialFront_ClosureRawDepth5Policy

