def basePieces0_span : cutoffTableSpan 0 0x1921ee basePieces0 := by
  unfold basePieces0
  repeat' apply And.intro
  all_goals norm_num [cutoffTableSpan]

def basePieces0_ordered : basePieces0.Pairwise (fun x y => x.hi ≤ y.lo) :=
  cutoffTableSpan_ordered basePieces0_span

def baseTable_eval_0_0 {u : ℚ} (hlo : 0 ≤ u) (hhi : u < 1) :
    cutoffTableEval (basePieces false) u = (0, 0 * (u) + 0) := by
  have hh := cutoffTableEval_eq_of_mem (rows := basePieces0) (row := ⟨0, 1, 0, 0, 0⟩)
    basePieces0_ordered (List.mem_of_getElem? (i := 0) (by rfl)) hlo hhi
  exact hh

