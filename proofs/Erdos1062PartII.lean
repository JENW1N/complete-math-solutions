/- Component GridWork; SHA256 f152ca58e05da7e36dc3f63f1fb16436c60d2532669012b1b49e753b86708bb9 -/
section SubmissionComponent_GridWork
/- A row-counting proof of the two-dimensional fork-free bound. -/

namespace Bounty

def GridForkFree (A : Finset (ℕ × ℕ)) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ c ∈ A, a ≠ b → a ≠ c →
    a.1 ≤ b.1 → a.2 ≤ b.2 → a.1 ≤ c.1 → a.2 ≤ c.2 → b = c

def gridRow (A : Finset (ℕ × ℕ)) (y : ℕ) : Finset (ℕ × ℕ) :=
  A.filter (fun a => a.2 = y)

def gridRow_card_le_two {A : Finset (ℕ × ℕ)} (hA : GridForkFree A) (y : ℕ) :
    (gridRow A y).card ≤ 2 := by
  classical
  by_cases hr : (gridRow A y).Nonempty
  · let X := (gridRow A y).image Prod.fst
    have hX : X.Nonempty := hr.image Prod.fst
    obtain ⟨a, ha, hamin⟩ := Finset.mem_image.mp (Finset.min'_mem X hX)
    have hay : a.2 = y := (Finset.mem_filter.mp ha).2
    have hamin' : ∀ b ∈ gridRow A y, a.1 ≤ b.1 := by
      intro b hb
      rw [hamin]
      exact Finset.min'_le X b.1 (Finset.mem_image_of_mem Prod.fst hb)
    have he : ((gridRow A y).erase a).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro b hb c hc
      obtain ⟨hba, hbr⟩ := Finset.mem_erase.mp hb
      obtain ⟨hca, hcr⟩ := Finset.mem_erase.mp hc
      have hby : b.2 = y := (Finset.mem_filter.mp hbr).2
      have hcy : c.2 = y := (Finset.mem_filter.mp hcr).2
      exact hA a (Finset.mem_filter.mp ha).1 b (Finset.mem_filter.mp hbr).1
        c (Finset.mem_filter.mp hcr).1 hba.symm hca.symm
        (hamin' b hbr) (by omega) (hamin' c hcr) (by omega)
    have hcard := Finset.card_erase_add_one ha
    omega
  · have hempty : gridRow A y = ∅ := Finset.not_nonempty_iff_eq_empty.mp hr
    simp [hempty]

def grid_forbidden_upper {A : Finset (ℕ × ℕ)} (hA : GridForkFree A)
    {a b c : ℕ × ℕ} (ha : a ∈ A) (hb : b ∈ A) (hc : c ∈ A)
    (habrow : a.2 = b.2) (habcol : a.1 < b.1)
    (haccol : a.1 ≤ c.1) (hacrow : a.2 < c.2) : False := by
  have hab : a ≠ b := by
    intro h
    subst b
    omega
  have hac : a ≠ c := by
    intro h
    subst c
    omega
  have hbc := hA a ha b hb c hc hab hac habcol.le
    (by omega) haccol hacrow.le
  have := congrArg Prod.snd hbc
  omega

def grid_above_pair_left {A : Finset (ℕ × ℕ)} (hA : GridForkFree A)
    {a b c : ℕ × ℕ} (ha : a ∈ A) (hb : b ∈ A) (hc : c ∈ A)
    (hab : a ≠ b) (habrow : a.2 = b.2) (hacrow : a.2 < c.2) :
    c.1 < a.1 ∧ c.1 < b.1 := by
  have habcol : a.1 ≠ b.1 := by
    intro h
    exact hab (Prod.ext h habrow)
  by_cases hlt : a.1 < b.1
  · have h : c.1 < a.1 := by
      by_contra hh
      exact grid_forbidden_upper hA ha hb hc habrow hlt (by omega) hacrow
    omega
  · have h : c.1 < b.1 := by
      by_contra hh
      exact grid_forbidden_upper hA hb ha hc habrow.symm (by omega) (by omega) (by omega)
    omega

def gridRows (A : Finset (ℕ × ℕ)) : Finset ℕ := A.image Prod.snd

def gridDoubleRows (A : Finset (ℕ × ℕ)) : Finset ℕ :=
  (gridRows A).filter (fun y => (gridRow A y).card = 2)

def gridDoubles (A : Finset (ℕ × ℕ)) : Finset (ℕ × ℕ) :=
  A.filter (fun a => (gridRow A a.2).card = 2)

def gridDoubles_fst_injective {A : Finset (ℕ × ℕ)} (hA : GridForkFree A) :
    Set.InjOn Prod.fst (gridDoubles A : Set (ℕ × ℕ)) := by
  intro a ha b hb hfst
  have haA := (Finset.mem_filter.mp ha).1
  have hbA := (Finset.mem_filter.mp hb).1
  by_cases hrow : a.2 = b.2
  · exact Prod.ext hfst hrow
  · by_cases hlt : a.2 < b.2
    · have hcard := (Finset.mem_filter.mp ha).2
      obtain ⟨c, hc, hca⟩ := Finset.exists_mem_ne (show 1 < (gridRow A a.2).card by omega) a
      have hcA := (Finset.mem_filter.mp hc).1
      have hcy := (Finset.mem_filter.mp hc).2
      have h := grid_above_pair_left hA haA hcA hbA hca.symm (by omega) hlt
      omega
    · have hcard := (Finset.mem_filter.mp hb).2
      obtain ⟨c, hc, hcb⟩ := Finset.exists_mem_ne (show 1 < (gridRow A b.2).card by omega) b
      have hcA := (Finset.mem_filter.mp hc).1
      have hcy := (Finset.mem_filter.mp hc).2
      have h := grid_above_pair_left hA hbA hcA haA hcb.symm (by omega) (by omega)
      omega

def grid_card_decomposition {A : Finset (ℕ × ℕ)} (hA : GridForkFree A) :
    A.card = (gridRows A).card + (gridDoubleRows A).card := by
  have hcard : A.card = ∑ y ∈ gridRows A, (gridRow A y).card := by
    simpa [gridRows, gridRow] using Finset.card_eq_sum_card_image Prod.snd A
  rw [hcard]
  calc
    (∑ y ∈ gridRows A, (gridRow A y).card) =
        ∑ y ∈ gridRows A, (1 + if (gridRow A y).card = 2 then 1 else 0) := by
      apply Finset.sum_congr rfl
      intro y hy
      have hupper := gridRow_card_le_two hA y
      have hlower : 0 < (gridRow A y).card := by
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
        apply Finset.card_pos.mpr
        exact ⟨a, Finset.mem_filter.mpr ⟨ha, rfl⟩⟩
      split_ifs <;> omega
    _ = (gridRows A).card + (gridDoubleRows A).card := by
      simp [Finset.sum_add_distrib, gridDoubleRows]

def gridDoubles_card (A : Finset (ℕ × ℕ)) :
    (gridDoubles A).card = 2 * (gridDoubleRows A).card := by
  have hfilter :
      A.filter (fun a => a.2 ∈ gridDoubleRows A) = gridDoubles A := by
    ext a
    simp only [Finset.mem_filter, gridDoubleRows, gridDoubles]
    constructor
    · intro h
      exact ⟨h.1, h.2.2⟩
    · intro h
      exact ⟨h.1, Finset.mem_image_of_mem Prod.snd h.1, h.2⟩
  have hsum := Finset.sum_card_fiberwise_eq_card_filter A (gridDoubleRows A) Prod.snd
  rw [hfilter] at hsum
  calc
    (gridDoubles A).card = ∑ y ∈ gridDoubleRows A, (gridRow A y).card := hsum.symm
    _ = ∑ _y ∈ gridDoubleRows A, 2 := by
      apply Finset.sum_congr rfl
      intro y hy
      exact (Finset.mem_filter.mp hy).2
    _ = 2 * (gridDoubleRows A).card := by simp [Nat.mul_comm]

def grid_card_bound {A : Finset (ℕ × ℕ)} {W H : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < W) (hH : ∀ a ∈ A, a.2 < H) :
    A.card ≤ H + W / 2 := by
  have hrows : (gridRows A).card ≤ H := by
    calc
      (gridRows A).card ≤ (Finset.range H).card := by
        apply Finset.card_le_card
        intro y hy
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
        exact Finset.mem_range.mpr (hH a ha)
      _ = H := Finset.card_range H
  have hdoubles : (gridDoubles A).card ≤ W := by
    calc
      (gridDoubles A).card = ((gridDoubles A).image Prod.fst).card :=
        (Finset.card_image_iff.mpr (gridDoubles_fst_injective hA)).symm
      _ ≤ (Finset.range W).card := by
        apply Finset.card_le_card
        intro x hx
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
        exact Finset.mem_range.mpr (hW a (Finset.mem_filter.mp ha).1)
      _ = W := Finset.card_range W
  rw [gridDoubles_card] at hdoubles
  rw [grid_card_decomposition hA]
  omega

end Bounty

end SubmissionComponent_GridWork

/- Component GridBoundary; SHA256 bb520fd269023ebb862cba3aee015678bb7acc03206e3afe7e4920bd975172a2 -/
section SubmissionComponent_GridBoundary
/- Equality cases for the row-counting bound. -/

namespace Bounty

def gridRows_card_le {A : Finset (ℕ × ℕ)} {H : ℕ}
    (hH : ∀ a ∈ A, a.2 < H) : (gridRows A).card ≤ H := by
  calc
    (gridRows A).card ≤ (Finset.range H).card := by
      apply Finset.card_le_card
      intro y hy
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
      exact Finset.mem_range.mpr (hH a ha)
    _ = H := Finset.card_range H

def gridDoubles_card_le {A : Finset (ℕ × ℕ)} {W : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < W) :
    (gridDoubles A).card ≤ W := by
  calc
    (gridDoubles A).card = ((gridDoubles A).image Prod.fst).card :=
      (Finset.card_image_iff.mpr (gridDoubles_fst_injective hA)).symm
    _ ≤ (Finset.range W).card := by
      apply Finset.card_le_card
      intro x hx
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
      exact Finset.mem_range.mpr (hW a (Finset.mem_filter.mp ha).1)
    _ = W := Finset.card_range W

def grid_saturated_counts {A : Finset (ℕ × ℕ)} {W H : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < W) (hH : ∀ a ∈ A, a.2 < H)
    (hcard : A.card = H + W / 2) :
    (gridRows A).card = H ∧ (gridDoubleRows A).card = W / 2 := by
  have hr := gridRows_card_le hH
  have hd := gridDoubles_card_le hA hW
  rw [gridDoubles_card] at hd
  have hsum := grid_card_decomposition hA
  omega

def grid_saturated_rows {A : Finset (ℕ × ℕ)} {W H : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < W) (hH : ∀ a ∈ A, a.2 < H)
    (hcard : A.card = H + W / 2) : gridRows A = Finset.range H := by
  apply Finset.eq_of_subset_of_card_le
  · intro y hy
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
    exact Finset.mem_range.mpr (hH a ha)
  · simp only [Finset.card_range, (grid_saturated_counts hA hW hH hcard).1]
    exact le_rfl

def grid_saturated_even_columns {A : Finset (ℕ × ℕ)} {k H : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < 2 * k) (hH : ∀ a ∈ A, a.2 < H)
    (hcard : A.card = H + k) :
    (gridDoubles A).image Prod.fst = Finset.range (2 * k) := by
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    exact Finset.mem_range.mpr (hW a (Finset.mem_filter.mp ha).1)
  · have hd := (grid_saturated_counts hA hW hH (by omega)).2
    rw [Finset.card_range, Finset.card_image_iff.mpr (gridDoubles_fst_injective hA),
      gridDoubles_card]
    omega

def grid_point_below_double {A : Finset (ℕ × ℕ)} (hA : GridForkFree A)
    {a c : ℕ × ℕ} (ha : a ∈ gridDoubles A) (hc : c ∈ A) (hrow : a.2 < c.2) :
    c.1 < a.1 := by
  have hcard := (Finset.mem_filter.mp ha).2
  obtain ⟨b, hb, hba⟩ := Finset.exists_mem_ne (show 1 < (gridRow A a.2).card by omega) a
  exact (grid_above_pair_left hA (Finset.mem_filter.mp ha).1
    (Finset.mem_filter.mp hb).1 hc hba.symm
    (by simpa using (Finset.mem_filter.mp hb).2.symm) hrow).1

def grid_top_double_of_saturated_even {A : Finset (ℕ × ℕ)} {k h : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < 2 * k)
    (hH : ∀ a ∈ A, a.2 < h + 1) (hcard : A.card = h + 1 + k) :
    (gridRow A h).card = 2 := by
  have hrows := grid_saturated_rows hA hW hH (by omega)
  have hmem : h ∈ gridRows A := by rw [hrows]; exact Finset.mem_range.mpr (by omega)
  obtain ⟨c, hc, hch⟩ := Finset.mem_image.mp hmem
  have hk : 0 < k := by have := hW c hc; omega
  have hcols := grid_saturated_even_columns hA hW hH hcard
  have hzero : 0 ∈ (gridDoubles A).image Prod.fst := by
    rw [hcols]
    exact Finset.mem_range.mpr (by omega)
  obtain ⟨a, ha, ha0⟩ := Finset.mem_image.mp hzero
  have hah := hH a (Finset.mem_filter.mp ha).1
  have hay : a.2 = h := by
    by_contra hh
    have := grid_point_below_double hA ha hc (by omega)
    omega
  simpa [hay] using (Finset.mem_filter.mp ha).2

def grid_bound_top_single {A : Finset (ℕ × ℕ)} {k h : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < 2 * k)
    (hH : ∀ a ∈ A, a.2 < h + 1)
    (htop : ∀ a ∈ A, a.2 = h → a.1 = 0) : A.card ≤ h + k := by
  have hbound := grid_card_bound hA hW hH
  by_contra hc
  have hcard : A.card = h + 1 + k := by omega
  have htwo := grid_top_double_of_saturated_even hA hW hH hcard
  have hone : (gridRow A h).card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro a ha b hb
    obtain ⟨haA, hay⟩ := Finset.mem_filter.mp ha
    obtain ⟨hbA, hby⟩ := Finset.mem_filter.mp hb
    exact Prod.ext (by rw [htop a haA hay, htop b hbA hby]) (by omega)
  omega

def grid_top_pair_of_saturated_even {A : Finset (ℕ × ℕ)} {k h : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < 2 * k)
    (hH : ∀ a ∈ A, a.2 < h + 1)
    (htop : ∀ a ∈ A, a.2 = h → a.1 < 2)
    (hcard : A.card = h + 1 + k) : (0, h) ∈ A ∧ (1, h) ∈ A := by
  have htwo := grid_top_double_of_saturated_even hA hW hH hcard
  have heq : gridRow A h = ({(0, h), (1, h)} : Finset (ℕ × ℕ)) := by
    apply Finset.eq_of_subset_of_card_le
    · intro a ha
      obtain ⟨haA, hay⟩ := Finset.mem_filter.mp ha
      have hax := htop a haA hay
      have hx : a.1 = 0 ∨ a.1 = 1 := by omega
      rcases hx with hx | hx
      · have he : a = (0, h) := Prod.ext hx hay
        simp [he]
      · have he : a = (1, h) := Prod.ext hx hay
        simp [he]
    · rw [htwo]
      simp
  constructor
  · have hm : (0, h) ∈ gridRow A h := by rw [heq]; simp
    exact (Finset.mem_filter.mp hm).1
  · have hm : (1, h) ∈ gridRow A h := by rw [heq]; simp
    exact (Finset.mem_filter.mp hm).1

end Bounty

end SubmissionComponent_GridBoundary

/- Component GridOdd; SHA256 5aaeb15303e19575a7f83d8109895c72326b34c1b82994a81331e1a67dca4683 -/
section SubmissionComponent_GridOdd
/- Rigidity in odd-width grids with a single available top cell. -/

namespace Bounty

def grid_double_row_mem {A : Finset (ℕ × ℕ)} {a b : ℕ × ℕ}
    (ha : a ∈ gridDoubles A) (hb : b ∈ A) (hrow : b.2 = a.2) :
    b ∈ gridDoubles A := by
  apply Finset.mem_filter.mpr
  exact ⟨hb, by rw [hrow]; exact (Finset.mem_filter.mp ha).2⟩

def grid_double_zero_excluded {A : Finset (ℕ × ℕ)} {h : ℕ}
    (hA : GridForkFree A) (hH : ∀ a ∈ A, a.2 < h + 1)
    (htop : ∀ a ∈ A, a.2 = h → a.1 = 0) (hmem : h ∈ gridRows A) :
    ∀ a ∈ gridDoubles A, a.1 ≠ 0 := by
  intro a ha ha0
  obtain ⟨c, hc, hch⟩ := Finset.mem_image.mp hmem
  have hah := hH a (Finset.mem_filter.mp ha).1
  by_cases hay : a.2 = h
  · have hcard := (Finset.mem_filter.mp ha).2
    obtain ⟨b, hb, hba⟩ := Finset.exists_mem_ne (show 1 < (gridRow A a.2).card by omega) a
    obtain ⟨hbA, hby⟩ := Finset.mem_filter.mp hb
    have hb0 := htop b hbA (by omega)
    exact hba (Prod.ext (by omega) hby)
  · have := grid_point_below_double hA ha hc (by omega)
    omega

def grid_saturated_odd_columns {A : Finset (ℕ × ℕ)} {k h : ℕ}
    (hA : GridForkFree A) (hW : ∀ a ∈ A, a.1 < 2 * k + 1)
    (hH : ∀ a ∈ A, a.2 < h + 1)
    (htop : ∀ a ∈ A, a.2 = h → a.1 = 0)
    (hcard : A.card = h + 1 + k) :
    (gridDoubles A).image Prod.fst = Finset.Icc 1 (2 * k) := by
  have hrows := grid_saturated_rows hA hW hH (by omega)
  have hmem : h ∈ gridRows A := by rw [hrows]; exact Finset.mem_range.mpr (by omega)
  have hnonzero := grid_double_zero_excluded hA hH htop hmem
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    have haW := hW a (Finset.mem_filter.mp ha).1
    have ha0 := hnonzero a ha
    exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  · have hd := (grid_saturated_counts hA hW hH (by omega)).2
    rw [Finset.card_image_iff.mpr (gridDoubles_fst_injective hA), gridDoubles_card]
    simp only [Nat.card_Icc]
    omega

def grid_double_one_two_same_row {A : Finset (ℕ × ℕ)}
    (hA : GridForkFree A) (hnozero : ∀ a ∈ gridDoubles A, a.1 ≠ 0)
    {a b : ℕ × ℕ} (ha : a ∈ gridDoubles A) (hb : b ∈ gridDoubles A)
    (ha1 : a.1 = 1) (hb2 : b.1 = 2) : a.2 = b.2 := by
  by_contra hne
  by_cases hlt : a.2 < b.2
  · have := grid_point_below_double hA ha (Finset.mem_filter.mp hb).1 hlt
    omega
  · have hcard := (Finset.mem_filter.mp ha).2
    obtain ⟨c, hc, hca⟩ := Finset.exists_mem_ne (show 1 < (gridRow A a.2).card by omega) a
    obtain ⟨hcA, hcy⟩ := Finset.mem_filter.mp hc
    have hcD := grid_double_row_mem ha hcA hcy
    have hc0 := hnozero c hcD
    have hc2 := grid_point_below_double hA hb hcA (by omega)
    exact hca (Prod.ext (by omega) hcy)

def grid_three_in_column_forbidden {A : Finset (ℕ × ℕ)}
    (hA : GridForkFree A) {x y z w : ℕ}
    (hy : (x, y) ∈ A) (hz : (x, z) ∈ A) (hw : (x, w) ∈ A)
    (hyz : y < z) (hzw : z < w) : False := by
  have hh := hA (x, y) hy (x, z) hz (x, w) hw
    (by intro he; have := congrArg Prod.snd he; simpa using hyz.ne this)
    (by intro he; have := congrArg Prod.snd he; omega)
    le_rfl hyz.le le_rfl (by omega)
  have := congrArg Prod.snd hh
  omega

def grid_odd_forced_pair {A : Finset (ℕ × ℕ)} {k b : ℕ}
    (hk : 0 < k) (hA : GridForkFree A)
    (hW : ∀ a ∈ A, a.1 < 2 * k + 1) (hH : ∀ a ∈ A, a.2 < b + 3)
    (htop : ∀ a ∈ A, a.2 = b + 2 → a.1 = 0)
    (hsecond : ∀ a ∈ A, a.1 = 2 → a.2 ≤ b)
    (hcard : A.card = b + 3 + k) : (1, b) ∈ A ∧ (2, b) ∈ A := by
  have hH' : ∀ a ∈ A, a.2 < (b + 2) + 1 := by intro a ha; have := hH a ha; omega
  have hrows := grid_saturated_rows hA hW hH (by omega)
  have hmem : b + 2 ∈ gridRows A := by
    rw [hrows]
    exact Finset.mem_range.mpr (by omega)
  have hnozero := grid_double_zero_excluded hA hH' htop hmem
  have hcols := grid_saturated_odd_columns hA hW hH' htop (by omega)
  have h1 : 1 ∈ (gridDoubles A).image Prod.fst := by
    rw [hcols]
    exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  have h2 : 2 ∈ (gridDoubles A).image Prod.fst := by
    rw [hcols]
    exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  obtain ⟨a, ha, ha1⟩ := Finset.mem_image.mp h1
  obtain ⟨c, hc, hc2⟩ := Finset.mem_image.mp h2
  have hrow := grid_double_one_two_same_row hA hnozero ha hc ha1 hc2
  have hcb := hsecond c (Finset.mem_filter.mp hc).1 hc2
  have hab : a.2 = b := by
    by_contra hne
    have hablt : a.2 < b := by omega
    have hzero : ∀ y, b ≤ y → y < b + 3 → (0, y) ∈ A := by
      intro y hby hyH
      have hy : y ∈ gridRows A := by rw [hrows]; exact Finset.mem_range.mpr hyH
      obtain ⟨d, hd, hdy⟩ := Finset.mem_image.mp hy
      have hdx := grid_point_below_double hA ha hd (by omega)
      have he : d = (0, y) := Prod.ext (by omega) hdy
      rwa [← he]
    exact grid_three_in_column_forbidden hA
      (hzero b (by omega) (by omega)) (hzero (b + 1) (by omega) (by omega))
      (hzero (b + 2) (by omega) (by omega)) (by omega) (by omega)
  constructor
  · have he : a = (1, b) := Prod.ext ha1 hab
    exact he ▸ (Finset.mem_filter.mp ha).1
  · have he : c = (2, b) := Prod.ext hc2 (by omega)
    exact he ▸ (Finset.mem_filter.mp hc).1

end Bounty

end SubmissionComponent_GridOdd

/- Component GridBridge; SHA256 f53cd8833bdeabaa4ab47df355c2739ef8bd82171dac1a5979bbeb05511b8711 -/
section SubmissionComponent_GridBridge
/- Divisibility among two-prime smooth numbers is product order on a grid. -/

namespace Bounty

def gridValue (a : ℕ × ℕ) : ℕ := 2 ^ a.1 * 3 ^ a.2

def gridValue_pos (a : ℕ × ℕ) : 0 < gridValue a := by
  unfold gridValue
  positivity

def gridValue_factorization_two (a : ℕ × ℕ) :
    (gridValue a).factorization 2 = a.1 := by
  unfold gridValue
  rw [Nat.factorization_mul (by positivity) (by positivity), Finsupp.add_apply,
    Nat.factorization_pow_self Nat.prime_two]
  have h : (3 ^ a.2).factorization 2 = 0 := by
    apply Nat.factorization_eq_zero_of_not_dvd
    intro hd
    have := Nat.prime_two.dvd_of_dvd_pow hd
    norm_num at this
  omega

def gridValue_factorization_three (a : ℕ × ℕ) :
    (gridValue a).factorization 3 = a.2 := by
  unfold gridValue
  rw [Nat.factorization_mul (by positivity) (by positivity), Finsupp.add_apply,
    Nat.factorization_pow_self Nat.prime_three]
  have h : (2 ^ a.1).factorization 3 = 0 := by
    apply Nat.factorization_eq_zero_of_not_dvd
    intro hd
    have := Nat.prime_three.dvd_of_dvd_pow hd
    norm_num at this
  omega

def gridValue_injective : Function.Injective gridValue := by
  intro a b hab
  apply Prod.ext
  · have := congrArg (fun n : ℕ => n.factorization 2) hab
    simpa only [gridValue_factorization_two] using this
  · have := congrArg (fun n : ℕ => n.factorization 3) hab
    simpa only [gridValue_factorization_three] using this

def gridValue_dvd_iff (a b : ℕ × ℕ) :
    gridValue a ∣ gridValue b ↔ a.1 ≤ b.1 ∧ a.2 ≤ b.2 := by
  constructor
  · intro h
    have hf := (Nat.factorization_le_iff_dvd (ne_of_gt (gridValue_pos a))
      (ne_of_gt (gridValue_pos b))).mpr h
    constructor
    · simpa only [gridValue_factorization_two] using hf 2
    · simpa only [gridValue_factorization_three] using hf 3
  · rintro ⟨h₁, h₂⟩
    exact mul_dvd_mul (pow_dvd_pow 2 h₁) (pow_dvd_pow 3 h₂)

def gridForkFree_iff {A : Finset (ℕ × ℕ)} :
    GridForkFree A ↔ Erdos1062.ForkFree (gridValue '' (A : Set (ℕ × ℕ))) := by
  rw [forkFree_iff]
  constructor
  · intro hA x y z hx hy hz hxy hxz hdivy hdivz
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    obtain ⟨c, hc, rfl⟩ := hz
    obtain ⟨hy₁, hy₂⟩ := (gridValue_dvd_iff a b).mp hdivy
    obtain ⟨hz₁, hz₂⟩ := (gridValue_dvd_iff a c).mp hdivz
    have hab : a ≠ b := by intro he; exact hxy (congrArg gridValue he)
    have hac : a ≠ c := by intro he; exact hxz (congrArg gridValue he)
    exact congrArg gridValue (hA a ha b hb c hc hab hac hy₁ hy₂ hz₁ hz₂)
  · intro hA a ha b hb c hc hab hac hy₁ hy₂ hz₁ hz₂
    apply gridValue_injective
    exact hA (gridValue a) (gridValue b) (gridValue c)
      ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩ ⟨c, hc, rfl⟩ (fun he => hab (gridValue_injective he))
      (fun he => hac (gridValue_injective he))
      ((gridValue_dvd_iff a b).mpr ⟨hy₁, hy₂⟩)
      ((gridValue_dvd_iff a c).mpr ⟨hz₁, hz₂⟩)

def gridCoordinates (n : ℕ) : ℕ × ℕ := (n.factorization 2, n.factorization 3)

def gridCoordinates_value (a : ℕ × ℕ) : gridCoordinates (gridValue a) = a := by
  apply Prod.ext
  · exact gridValue_factorization_two a
  · exact gridValue_factorization_three a

def gridValue_log_bounds {a : ℕ × ℕ} {n : ℕ} (h : gridValue a ≤ n) :
    a.1 ≤ Nat.log 2 n ∧ a.2 ≤ Nat.log 3 n := by
  have hn : n ≠ 0 := by have := gridValue_pos a; omega
  constructor
  · apply (Nat.le_log_iff_pow_le (by norm_num) hn).mpr
    have hp : 1 ≤ (3 : ℕ) ^ a.2 := Nat.one_le_iff_ne_zero.mpr (by positivity)
    exact (by unfold gridValue at h; nlinarith : 2 ^ a.1 ≤ n)
  · apply (Nat.le_log_iff_pow_le (by norm_num) hn).mpr
    have hp : 1 ≤ (2 : ℕ) ^ a.1 := Nat.one_le_iff_ne_zero.mpr (by positivity)
    exact (by unfold gridValue at h; nlinarith : 3 ^ a.2 ≤ n)

end Bounty

end SubmissionComponent_GridBridge

/- Component FiveLoss; SHA256 6f0b67fcd12a16d548f86ae1f479385c0fd472ad713c8542f1851c7b1dbeedf2 -/
section SubmissionComponent_FiveLoss
/- Equality in adjacent powers-of-five components forces a forbidden fork. -/

namespace Bounty

def forkFree_not_double_five {S : Set ℕ} (hS : Erdos1062.ForkFree S)
    {a : ℕ} (ha : 0 < a) (haS : a ∈ S) (h2 : 2 * a ∈ S) (h5 : 5 * a ∈ S) : False := by
  have hh := (forkFree_iff S).mp hS a (2 * a) (5 * a) haS h2 h5
    (by omega) (by omega) (by exact ⟨2, by ring⟩) (by exact ⟨5, by ring⟩)
  omega

def grid_five_layer_loss {A B : Finset (ℕ × ℕ)} {S : Set ℕ} {k j b : ℕ}
    (hk : 0 < k) (hA : GridForkFree A) (hB : GridForkFree B)
    (hWA : ∀ a ∈ A, a.1 < 2 * k + 1) (hHA : ∀ a ∈ A, a.2 < b + 3)
    (htopA : ∀ a ∈ A, a.2 = b + 2 → a.1 = 0)
    (hsecondA : ∀ a ∈ A, a.1 = 2 → a.2 ≤ b)
    (hWB : ∀ a ∈ B, a.1 < 2 * j) (hHB : ∀ a ∈ B, a.2 < b + 1)
    (htopB : ∀ a ∈ B, a.2 = b → a.1 < 2)
    (hAS : ∀ a ∈ A, gridValue a ∈ S)
    (hBS : ∀ a ∈ B, 5 * gridValue a ∈ S)
    (hS : Erdos1062.ForkFree S) :
    A.card + B.card + 1 ≤ (b + 3 + k) + (b + 1 + j) := by
  have hAbasic := grid_card_bound hA hWA hHA
  have hBbasic := grid_card_bound hB hWB hHB
  by_contra hlt
  have hAc : A.card = b + 3 + k := by omega
  have hBc : B.card = b + 1 + j := by omega
  obtain ⟨ha1, ha2⟩ := grid_odd_forced_pair hk hA hWA hHA htopA hsecondA hAc
  obtain ⟨_, hb1⟩ := grid_top_pair_of_saturated_even hB hWB hHB htopB hBc
  have h1 : 2 * 3 ^ b ∈ S := by simpa [gridValue] using hAS (1, b) ha1
  have h2 : 2 * (2 * 3 ^ b) ∈ S := by
    have hh := hAS (2, b) ha2
    norm_num [gridValue] at hh
    convert hh using 1
    ring
  have h5 : 5 * (2 * 3 ^ b) ∈ S := by simpa [gridValue] using hBS (1, b) hb1
  exact forkFree_not_double_five hS (by positivity) h1 h2 h5

end Bounty

end SubmissionComponent_FiveLoss

/- Component SmoothRank; SHA256 34273eadda8c4afb918793f21e0088eb02d207953335e532c5eb54ef49396c9e -/
section SubmissionComponent_SmoothRank
/- The sharp upper bound in a two-prime divisibility component. -/

namespace Bounty

def smoothRankBound (n : ℕ) : ℕ :=
  if n = 0 then 0 else
    Nat.log 3 n + 1 + Nat.log 2 n / 2 +
      if Nat.log 2 n % 2 = 1 ∧ 2 * 3 ^ Nat.log 3 n ≤ n then 1 else 0

def grid_natural_sharp_bound {A : Finset (ℕ × ℕ)} {n : ℕ}
    (hn : 0 < n) (hA : GridForkFree A) (hbound : ∀ a ∈ A, gridValue a ≤ n) :
    A.card ≤ smoothRankBound n := by
  have hW : ∀ a ∈ A, a.1 < Nat.log 2 n + 1 := by
    intro a ha
    exact Nat.lt_succ_of_le (gridValue_log_bounds (hbound a ha)).1
  have hH : ∀ a ∈ A, a.2 < Nat.log 3 n + 1 := by
    intro a ha
    exact Nat.lt_succ_of_le (gridValue_log_bounds (hbound a ha)).2
  have hbasic := grid_card_bound hA hW hH
  unfold smoothRankBound
  rw [if_neg (by omega : n ≠ 0)]
  by_cases hpar : Nat.log 2 n % 2 = 1
  · by_cases htop : 2 * 3 ^ Nat.log 3 n ≤ n
    · rw [if_pos ⟨hpar, htop⟩]
      omega
    · rw [if_neg (by simp [htop])]
      have hWeven : ∀ a ∈ A, a.1 < 2 * ((Nat.log 2 n + 1) / 2) := by
        intro a ha
        have := hW a ha
        omega
      have hsingle : ∀ a ∈ A, a.2 = Nat.log 3 n → a.1 = 0 := by
        intro a ha hay
        by_contra hax
        have hpow : 2 ≤ (2 : ℕ) ^ a.1 := by
          calc
            2 = (2 : ℕ) ^ 1 := by norm_num
            _ ≤ 2 ^ a.1 := Nat.pow_le_pow_right (by norm_num) (by omega)
        have hb := hbound a ha
        unfold gridValue at hb
        rw [hay] at hb
        apply htop
        nlinarith
      have hh := grid_bound_top_single hA hWeven hH hsingle
      omega
  · rw [if_neg (by simp [hpar])]
    omega

end Bounty

end SubmissionComponent_SmoothRank

/- Component WindowCount; SHA256 58f33d4b9f803b7a0322843468c1288acc1863366d0070e366ddb3418be4416f -/
section SubmissionComponent_WindowCount
/- Explicit finite witnesses for the two-prime rank bound. -/

namespace Bounty

def log_scaled_bounds {b d n : ℕ} (hb : 1 < b) (hd : 0 < d) (hdn : d ≤ n) :
    d * b ^ Nat.log b (n / d) ≤ n ∧
      n < b * (d * b ^ Nat.log b (n / d)) := by
  have hquot : n / d ≠ 0 := by have := Nat.div_pos hdn hd; omega
  have hlo := Nat.pow_log_le_self b hquot
  have hhi := Nat.lt_pow_succ_log_self hb (n / d)
  constructor
  · have hh := (Nat.le_div_iff_mul_le hd).mp hlo
    simpa [Nat.mul_comm] using hh
  · have hh := (Nat.div_lt_iff_lt_mul hd).mp hhi
    simpa [pow_succ, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hh

def two_pow_even (j : ℕ) : (2 : ℕ) ^ (2 * j) = 4 ^ j := by
  rw [pow_mul]
  norm_num

def two_pow_odd (j : ℕ) : (2 : ℕ) ^ (2 * j + 1) = 2 * 4 ^ j := by
  rw [pow_add, two_pow_even]
  simp [Nat.mul_comm]

def window0Primary (n i : ℕ) : ℕ × ℕ := (2 * Nat.log 4 (n / 3 ^ i), i)
def window0Secondary (n j : ℕ) : ℕ × ℕ := (2 * j + 1, Nat.log 3 (n / 4 ^ (j + 1)))

def window0Grid (n : ℕ) : Finset (ℕ × ℕ) :=
  ((Finset.range (Nat.log 3 n + 1)).image (window0Primary n)) ∪
  ((Finset.range (Nat.log 4 n)).image (window0Secondary n))

def window0Primary_injective (n : ℕ) : Function.Injective (window0Primary n) := by
  intro a b hab
  exact congrArg Prod.snd hab

def window0Secondary_injective (n : ℕ) : Function.Injective (window0Secondary n) := by
  intro a b hab
  have hh := congrArg Prod.fst hab
  dsimp [window0Secondary] at hh
  omega

def window0Grid_card (n : ℕ) :
    (window0Grid n).card = Nat.log 3 n + 1 + Nat.log 4 n := by
  unfold window0Grid
  rw [Finset.card_union_of_disjoint]
  · rw [Finset.card_image_of_injective _ (window0Primary_injective n),
      Finset.card_image_of_injective _ (window0Secondary_injective n)]
    simp
  · apply Finset.disjoint_left.mpr
    intro a ha hb
    obtain ⟨i, hi, hia⟩ := Finset.mem_image.mp ha
    obtain ⟨j, hj, hja⟩ := Finset.mem_image.mp hb
    have hh := congrArg Prod.fst (hia.trans hja.symm)
    dsimp [window0Primary, window0Secondary] at hh
    omega

def window0Primary_mem {n i : ℕ} (hn : 0 < n) (hi : i ≤ Nat.log 3 n) :
    gridValue (window0Primary n i) ∈ cutoffWindow 0 n := by
  have hd : 0 < (3 : ℕ) ^ i := by positivity
  have hdn : (3 : ℕ) ^ i ≤ n :=
    (Nat.le_log_iff_pow_le (by norm_num) (by omega : n ≠ 0)).mp hi
  have hh := log_scaled_bounds (by norm_num : 1 < (4 : ℕ)) hd hdn
  have hvalue : gridValue (window0Primary n i) = 3 ^ i * 4 ^ Nat.log 4 (n / 3 ^ i) := by
    simp [gridValue, window0Primary, two_pow_even, Nat.mul_comm]
  constructor
  · exact ⟨(window0Primary n i).1, (window0Primary n i).2, rfl⟩
  · left
    constructor
    · rw [gridValue_factorization_two]
      simp [window0Primary]
    · rw [hvalue]
      exact ⟨hh.2, hh.1⟩

def window0Secondary_mem {n j : ℕ} (hn : 0 < n) (hj : j < Nat.log 4 n) :
    gridValue (window0Secondary n j) ∈ cutoffWindow 0 n := by
  have hd : 0 < (4 : ℕ) ^ (j + 1) := by positivity
  have hdn : (4 : ℕ) ^ (j + 1) ≤ n :=
    (Nat.le_log_iff_pow_le (by norm_num) (by omega : n ≠ 0)).mp (by omega)
  have hh := log_scaled_bounds (by norm_num : 1 < (3 : ℕ)) hd hdn
  have hvalue : 2 * gridValue (window0Secondary n j) =
      4 ^ (j + 1) * 3 ^ Nat.log 3 (n / 4 ^ (j + 1)) := by
    dsimp only [gridValue, window0Secondary]
    rw [two_pow_odd, pow_succ]
    ring
  constructor
  · exact ⟨(window0Secondary n j).1, (window0Secondary n j).2, rfl⟩
  · right
    constructor
    · rw [gridValue_factorization_two]
      simp [window0Secondary]
    · rw [← hvalue] at hh
      constructor <;> omega

def window0Grid_subset {n : ℕ} (hn : 0 < n) :
    ∀ a ∈ window0Grid n, gridValue a ∈ cutoffWindow 0 n := by
  intro a ha
  rcases Finset.mem_union.mp ha with ha | ha
  · obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ha
    exact window0Primary_mem hn (by have := Finset.mem_range.mp hi; omega)
  · obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp ha
    exact window0Secondary_mem hn (Finset.mem_range.mp hj)

def window0Witness (n : ℕ) : Finset ℕ := (window0Grid n).image gridValue

def window0Witness_card (n : ℕ) :
    (window0Witness n).card = Nat.log 3 n + 1 + Nat.log 4 n := by
  rw [window0Witness, Finset.card_image_of_injective _ gridValue_injective, window0Grid_card]

def window0Witness_subset {n : ℕ} (hn : 0 < n) :
    (window0Witness n : Set ℕ) ⊆ cutoffWindow 0 n := by
  intro x hx
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
  exact window0Grid_subset hn a ha

end Bounty

end SubmissionComponent_WindowCount

/- Component FiveInterval; SHA256 cd96d816231a581130f9eb75453fd8593b7f671da1d2b7ef59a996b917986353 -/
section SubmissionComponent_FiveInterval
/- The powers-of-five loss on its exact arithmetic interval. -/

namespace Bounty

def badWindow (n : ℕ) : Prop :=
  ∃ j b : ℕ, 4 ^ j ≤ n ∧ 4 * n < 5 * 4 ^ j ∧
    10 * 3 ^ b ≤ n ∧ n < 12 * 3 ^ b

def gridValue_column_lt {a : ℕ × ℕ} {q n W : ℕ}
    (_hq : 0 < q) (hbound : q * gridValue a ≤ n) (hlt : n < q * 2 ^ W) : a.1 < W := by
  by_contra hh
  have hpow : (2 : ℕ) ^ W ≤ 2 ^ a.1 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have h3 : 0 < (3 : ℕ) ^ a.2 := by positivity
  unfold gridValue at hbound
  have hmul : q * 2 ^ W ≤ q * 2 ^ a.1 := Nat.mul_le_mul_left _ hpow
  have hh : q * 2 ^ a.1 ≤ q * (2 ^ a.1 * 3 ^ a.2) := by nlinarith
  omega

def gridValue_row_lt {a : ℕ × ℕ} {q n H : ℕ}
    (_hq : 0 < q) (hbound : q * gridValue a ≤ n) (hlt : n < q * 3 ^ H) : a.2 < H := by
  by_contra hh
  have hpow : (3 : ℕ) ^ H ≤ 3 ^ a.2 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have h2 : 0 < (2 : ℕ) ^ a.1 := by positivity
  unfold gridValue at hbound
  have hmul : q * 3 ^ H ≤ q * 3 ^ a.2 := Nat.mul_le_mul_left _ hpow
  have hh : q * 3 ^ a.2 ≤ q * (2 ^ a.1 * 3 ^ a.2) := by nlinarith
  omega

def badWindow_grid_bounds {n j b : ℕ}
    (h4 : 4 * n < 5 * 4 ^ j) (h3lo : 10 * 3 ^ b ≤ n) (h3hi : n < 12 * 3 ^ b) :
    0 < j ∧
    (∀ a : ℕ × ℕ, gridValue a ≤ n →
      a.1 < 2 * j + 1 ∧ a.2 < b + 3 ∧
      (a.2 = b + 2 → a.1 = 0) ∧ (a.1 = 2 → a.2 ≤ b)) ∧
    (∀ a : ℕ × ℕ, 5 * gridValue a ≤ n →
      a.1 < 2 * (j - 1) ∧ a.2 < b + 1 ∧ (a.2 = b → a.1 < 2)) := by
  have h3pos : 0 < (3 : ℕ) ^ b := by positivity
  have hj : 0 < j := by
    by_contra hh
    have he : j = 0 := by omega
    simp only [he, pow_zero] at h4
    omega
  refine ⟨hj, ?_, ?_⟩
  · intro a ha
    have ha1 : 1 * gridValue a ≤ n := by simpa using ha
    constructor
    · apply gridValue_column_lt (by norm_num : 0 < (1 : ℕ)) ha1
      rw [one_mul, two_pow_odd]
      omega
    constructor
    · apply gridValue_row_lt (by norm_num : 0 < (1 : ℕ)) ha1
      rw [one_mul, pow_add]
      norm_num
      omega
    constructor
    · intro hay
      have hbase : (2 : ℕ) ^ a.1 * (9 * 3 ^ b) ≤ n := by
        simpa [gridValue, hay, pow_add, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using ha
      by_contra hax
      have hx : 2 ≤ (2 : ℕ) ^ a.1 := by
        have hh := Nat.pow_le_pow_right (n := 2) (by norm_num) (show 1 ≤ a.1 by omega)
        simpa using hh
      nlinarith
    · intro hax
      by_contra hby
      have hy : 3 ^ (b + 1) ≤ (3 : ℕ) ^ a.2 :=
        Nat.pow_le_pow_right (by norm_num) (by omega)
      rw [pow_succ] at hy
      have hbase : 4 * 3 ^ a.2 ≤ n := by simpa [gridValue, hax] using ha
      omega
  · intro a ha
    constructor
    · apply gridValue_column_lt (by norm_num : 0 < (5 : ℕ)) ha
      rw [two_pow_even]
      have hj' : j = (j - 1) + 1 := by omega
      have hpow : (4 : ℕ) ^ j = 4 * 4 ^ (j - 1) := by
        calc
          (4 : ℕ) ^ j = 4 ^ ((j - 1) + 1) := by rw [← hj']
          _ = 4 * 4 ^ (j - 1) := by rw [pow_succ]; ring
      rw [hpow] at h4
      omega
    constructor
    · apply gridValue_row_lt (by norm_num : 0 < (5 : ℕ)) ha
      rw [pow_succ]
      omega
    · intro hay
      by_contra hax
      have hx : 4 ≤ (2 : ℕ) ^ a.1 := by
        have hh := Nat.pow_le_pow_right (n := 2) (by norm_num) (show 2 ≤ a.1 by omega)
        simpa using hh
      have hbase : 5 * (2 ^ a.1 * 3 ^ b) ≤ n := by simpa [gridValue, hay] using ha
      nlinarith

def badWindow_five_layer_loss {n j b : ℕ} {A B : Finset (ℕ × ℕ)} {S : Set ℕ}
    (h4 : 4 * n < 5 * 4 ^ j) (h3lo : 10 * 3 ^ b ≤ n) (h3hi : n < 12 * 3 ^ b)
    (hA : GridForkFree A) (hB : GridForkFree B)
    (hAn : ∀ a ∈ A, gridValue a ≤ n) (hBn : ∀ a ∈ B, 5 * gridValue a ≤ n)
    (hAS : ∀ a ∈ A, gridValue a ∈ S) (hBS : ∀ a ∈ B, 5 * gridValue a ∈ S)
    (hS : Erdos1062.ForkFree S) :
    A.card + B.card + 1 ≤ (b + 3 + j) + (b + 1 + (j - 1)) := by
  obtain ⟨hj, hAb, hBb⟩ := badWindow_grid_bounds h4 h3lo h3hi
  exact grid_five_layer_loss hj hA hB
    (fun a ha => (hAb a (hAn a ha)).1)
    (fun a ha => (hAb a (hAn a ha)).2.1)
    (fun a ha => (hAb a (hAn a ha)).2.2.1)
    (fun a ha => (hAb a (hAn a ha)).2.2.2)
    (fun a ha => (hBb a (hBn a ha)).1)
    (fun a ha => (hBb a (hBn a ha)).2.1)
    (fun a ha => (hBb a (hBn a ha)).2.2) hAS hBS hS

end Bounty

end SubmissionComponent_FiveInterval

/- Component BadRank; SHA256 b6f86ea82ba214bc4e38e5a034b96a5a21963b27d80507a593dfac1a5180bb25 -/
section SubmissionComponent_BadRank
/- Exact component ranks in the obstruction window and disjointness of losses. -/

namespace Bounty

def badWindow_rank_values {n j b : ℕ}
    (h4lo : 4 ^ j ≤ n) (h4hi : 4 * n < 5 * 4 ^ j)
    (h3lo : 10 * 3 ^ b ≤ n) (h3hi : n < 12 * 3 ^ b) :
    smoothRankBound n = b + 3 + j ∧ smoothRankBound (n / 5) = b + 1 + (j - 1) := by
  have h3pos : 0 < (3 : ℕ) ^ b := by positivity
  have hn : n ≠ 0 := by omega
  have hn5 : n / 5 ≠ 0 := by omega
  have hj2 : 2 ≤ j := by
    by_contra hbad
    have hj : j = 0 ∨ j = 1 := by omega
    rcases hj with rfl | rfl <;> norm_num at h4hi <;> omega
  have hlog2 : Nat.log 2 n = 2 * j := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · rwa [two_pow_even]
    · rw [two_pow_odd]
      omega
  have hlog3 : Nat.log 3 n = b + 2 := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · rw [pow_add]
      norm_num
      omega
    · rw [show b + 2 + 1 = b + 3 by omega, pow_add]
      norm_num
      omega
  have hj' : j = (j - 2) + 2 := by omega
  have h4pow : (4 : ℕ) ^ j = 16 * 4 ^ (j - 2) := by
    calc
      (4 : ℕ) ^ j = 4 ^ ((j - 2) + 2) := by rw [← hj']
      _ = 16 * 4 ^ (j - 2) := by rw [pow_add]; ring
  have hlog2half : Nat.log 2 (n / 5) = 2 * (j - 2) + 1 := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · rw [two_pow_odd]
      apply (Nat.le_div_iff_mul_le (by norm_num : 0 < (5 : ℕ))).mpr
      rw [h4pow] at h4lo
      omega
    · apply (Nat.div_lt_iff_lt_mul (by norm_num : 0 < (5 : ℕ))).mpr
      rw [pow_succ, two_pow_odd]
      rw [h4pow] at h4hi
      omega
  have hlog3half : Nat.log 3 (n / 5) = b := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · omega
    · rw [pow_succ]
      omega
  have htophalf : 2 * 3 ^ Nat.log 3 (n / 5) ≤ n / 5 := by
    rw [hlog3half]
    omega
  constructor
  · simp [smoothRankBound, hn, hlog2, hlog3]
  · simp only [smoothRankBound, hn5, ↓reduceIte, hlog2half, hlog3half]
    have hpar : (2 * (j - 2) + 1) % 2 = 1 := by omega
    rw [if_pos ⟨hpar, by simpa [hlog3half] using htophalf⟩]
    omega

def badWindow_not_div_five {n : ℕ} (hn : badWindow n) : ¬badWindow (n / 5) := by
  rintro ⟨j, b, hjlo, hjhi, _, _⟩
  obtain ⟨k, c, hklo, hkhi, _, _⟩ := hn
  have hpowpos : 0 < (4 : ℕ) ^ j := by positivity
  have hkj : j + 2 ≤ k := by
    by_contra hh
    have hp : (4 : ℕ) ^ k ≤ 4 ^ (j + 1) :=
      Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [pow_succ] at hp
    omega
  have hp : (4 : ℕ) ^ (j + 2) ≤ 4 ^ k := Nat.pow_le_pow_right (by norm_num) hkj
  rw [pow_add] at hp
  norm_num at hp
  omega

def badWindow_rank_loss {n : ℕ} {A B : Finset (ℕ × ℕ)} {S : Set ℕ}
    (hn : badWindow n) (hA : GridForkFree A) (hB : GridForkFree B)
    (hAn : ∀ a ∈ A, gridValue a ≤ n) (hBn : ∀ a ∈ B, 5 * gridValue a ≤ n)
    (hAS : ∀ a ∈ A, gridValue a ∈ S) (hBS : ∀ a ∈ B, 5 * gridValue a ∈ S)
    (hS : Erdos1062.ForkFree S) :
    A.card + B.card + 1 ≤ smoothRankBound n + smoothRankBound (n / 5) := by
  obtain ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩ := hn
  obtain ⟨hr1, hr2⟩ := badWindow_rank_values h4lo h4hi h3lo h3hi
  rw [hr1, hr2]
  exact badWindow_five_layer_loss h4hi h3lo h3hi hA hB hAn hBn hAS hBS hS

end Bounty

end SubmissionComponent_BadRank

/- Component Core23; SHA256 103b078245eb4cd986fff5b29b6f4a857f44b4c96ccb11a574d1e6fa5dc1f7ed -/
section SubmissionComponent_Core23
/- Canonical decomposition into a coprime-to-six core and a two-prime component. -/

namespace Bounty

def core23 (n : ℕ) : ℕ := ordCompl[3] (ordCompl[2] n)

def core23_pos {n : ℕ} (hn : 0 < n) : 0 < core23 n := by
  apply Nat.ordCompl_pos 3
  exact ne_of_gt (Nat.ordCompl_pos 2 (ne_of_gt hn))

def core23_le (n : ℕ) : core23 n ≤ n :=
  (Nat.ordCompl_le (ordCompl[2] n) 3).trans (Nat.ordCompl_le n 2)

def core23_decomposition (n : ℕ) : core23 n * gridValue (gridCoordinates n) = n := by
  have h3 : (ordCompl[2] n).factorization 3 = n.factorization 3 := by
    rw [Nat.factorization_ordCompl]
    simp
  have he2 := Nat.ordProj_mul_ordCompl_eq_self n 2
  have he3 := Nat.ordProj_mul_ordCompl_eq_self (ordCompl[2] n) 3
  rw [h3] at he3
  change core23 n * (2 ^ n.factorization 2 * 3 ^ n.factorization 3) = n
  calc
    core23 n * (2 ^ n.factorization 2 * 3 ^ n.factorization 3) =
        2 ^ n.factorization 2 * (3 ^ n.factorization 3 * core23 n) := by ring
    _ = n := by
      have hh : 3 ^ n.factorization 3 * core23 n = ordCompl[2] n := by
        simpa only [core23, h3] using he3
      rw [hh]
      exact he2

def core23_not_dvd_two {n : ℕ} (hn : 0 < n) : ¬2 ∣ core23 n := by
  intro hd
  exact Nat.not_dvd_ordCompl Nat.prime_two (ne_of_gt hn)
    (hd.trans (Nat.ordCompl_dvd (ordCompl[2] n) 3))

def core23_not_dvd_three {n : ℕ} (hn : 0 < n) : ¬3 ∣ core23 n :=
  Nat.not_dvd_ordCompl Nat.prime_three (ne_of_gt (Nat.ordCompl_pos 2 (ne_of_gt hn)))

def core23_coprime {n : ℕ} (hn : 0 < n) : (core23 n).Coprime 6 := by
  have h2 : Nat.Coprime 2 (core23 n) :=
    (Nat.prime_two.coprime_iff_not_dvd).mpr (core23_not_dvd_two hn)
  have h3 : Nat.Coprime 3 (core23 n) :=
    (Nat.prime_three.coprime_iff_not_dvd).mpr (core23_not_dvd_three hn)
  simpa using (h2.mul_left h3).symm

def core23_gridValue (a : ℕ × ℕ) : core23 (gridValue a) = 1 := by
  have hh := core23_decomposition (gridValue a)
  rw [gridCoordinates_value] at hh
  have hp := gridValue_pos a
  nlinarith

def core23_mul (m n : ℕ) : core23 (m * n) = core23 m * core23 n := by
  simp only [core23, Nat.ordCompl_mul]

def core23_eq_self {q : ℕ} (hq : q.Coprime 6) : core23 q = q := by
  have h2 : ¬2 ∣ q := by
    intro hd
    have hg := Nat.eq_one_of_dvd_coprimes hq hd (by norm_num : 2 ∣ 6)
    norm_num at hg
  have h3 : ¬3 ∣ q := by
    intro hd
    have hg := Nat.eq_one_of_dvd_coprimes hq hd (by norm_num : 3 ∣ 6)
    norm_num at hg
  unfold core23
  rw [(Nat.ordCompl_eq_self_iff_zero_or_not_dvd q Nat.prime_two).mpr (Or.inr h2)]
  exact (Nat.ordCompl_eq_self_iff_zero_or_not_dvd q Nat.prime_three).mpr (Or.inr h3)

def core23_coordinates_injective :
    Function.Injective (fun n => (core23 n, gridCoordinates n)) := by
  intro m n he
  have hc := congrArg Prod.fst he
  have hg := congrArg Prod.snd he
  dsimp only at hc hg
  calc
    m = core23 m * gridValue (gridCoordinates m) := (core23_decomposition m).symm
    _ = core23 n * gridValue (gridCoordinates n) := by rw [hc, hg]
    _ = n := core23_decomposition n

end Bounty

end SubmissionComponent_Core23

/- Component ComponentSum; SHA256 1267861b451434ccab5de81dd48d55fd7cba530d0429d8d0cab53d29994fa22a -/
section SubmissionComponent_ComponentSum
/- Decomposing a finite fork-free set into its coprime-to-six components. -/

namespace Bounty

def forkFree_scale_iff {q : ℕ} (hq : 0 < q) (S : Set ℕ) :
    Erdos1062.ForkFree ((fun m => q * m) '' S) ↔ Erdos1062.ForkFree S := by
  rw [forkFree_iff, forkFree_iff]
  have hi : Function.Injective (fun m : ℕ => q * m) := by
    intro a b hab
    dsimp only at hab
    exact Nat.eq_of_mul_eq_mul_left hq hab
  constructor
  · intro hh a b c ha hb hc hab hac hdab hdac
    apply hi
    exact hh (q * a) (q * b) (q * c) ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩ ⟨c, hc, rfl⟩
      (fun he => hab (hi he)) (fun he => hac (hi he))
      (Nat.mul_dvd_mul_left q hdab) (Nat.mul_dvd_mul_left q hdac)
  · intro hh a b c ha hb hc hab hac hdab hdac
    obtain ⟨x, hx, rfl⟩ := ha
    obtain ⟨y, hy, rfl⟩ := hb
    obtain ⟨z, hz, rfl⟩ := hc
    have hxy : x ≠ y := by intro he; exact hab (congrArg (fun m => q * m) he)
    have hxz : x ≠ z := by intro he; exact hac (congrArg (fun m => q * m) he)
    apply congrArg (fun m => q * m)
    exact hh x y z hx hy hz hxy hxz
      ((Nat.mul_dvd_mul_iff_left hq).mp hdab) ((Nat.mul_dvd_mul_iff_left hq).mp hdac)

def coreFiber (A : Finset ℕ) (q : ℕ) : Finset ℕ := A.filter (fun n => core23 n = q)
def componentGrid (A : Finset ℕ) (q : ℕ) : Finset (ℕ × ℕ) :=
  (coreFiber A q).image gridCoordinates

def componentGrid_card (A : Finset ℕ) (q : ℕ) :
    (componentGrid A q).card = (coreFiber A q).card := by
  apply Finset.card_image_iff.mpr
  intro m hm n hn hcoords
  have hmcore := (Finset.mem_filter.mp hm).2
  have hncore := (Finset.mem_filter.mp hn).2
  apply core23_coordinates_injective
  change (core23 m, gridCoordinates m) = (core23 n, gridCoordinates n)
  exact Prod.ext (hmcore.trans hncore.symm) hcoords

def componentGrid_scaled_mem {A : Finset ℕ} {q : ℕ} {a : ℕ × ℕ}
    (ha : a ∈ componentGrid A q) : q * gridValue a ∈ A := by
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp ha
  obtain ⟨hnA, hncore⟩ := Finset.mem_filter.mp hn
  have hh := core23_decomposition n
  rw [hncore] at hh
  rwa [hh]

def componentGrid_bound {A : Finset ℕ} {q n : ℕ}
    (hbound : ∀ m ∈ A, m ≤ n) :
    ∀ a ∈ componentGrid A q, q * gridValue a ≤ n := by
  intro a ha
  exact hbound _ (componentGrid_scaled_mem ha)

def componentGrid_forkFree {A : Finset ℕ} {q : ℕ}
    (hq : 0 < q) (hA : Erdos1062.ForkFree (A : Set ℕ)) :
    GridForkFree (componentGrid A q) := by
  apply gridForkFree_iff.mpr
  apply (forkFree_scale_iff hq _).mp
  apply forkFree_mono _ hA
  rintro x ⟨y, ⟨a, ha, rfl⟩, rfl⟩
  exact componentGrid_scaled_mem ha

def coprimeCores (n : ℕ) : Finset ℕ := (Finset.Icc 1 n).filter (fun q => q.Coprime 6)

def core23_mem_coprimeCores {A : Finset ℕ} {n m : ℕ}
    (hA : ∀ a ∈ A, 1 ≤ a ∧ a ≤ n) (hm : m ∈ A) : core23 m ∈ coprimeCores n := by
  have hmb := hA m hm
  apply Finset.mem_filter.mpr
  constructor
  · exact Finset.mem_Icc.mpr ⟨core23_pos (by omega), (core23_le m).trans hmb.2⟩
  · exact core23_coprime (by omega)

def card_eq_sum_components {A : Finset ℕ} {n : ℕ}
    (hA : ∀ a ∈ A, 1 ≤ a ∧ a ≤ n) :
    A.card = ∑ q ∈ coprimeCores n, (componentGrid A q).card := by
  simp only [componentGrid_card]
  have hh := Finset.sum_card_fiberwise_eq_card_filter A (coprimeCores n) core23
  have he : A.filter (fun a => core23 a ∈ coprimeCores n) = A := by
    apply Finset.filter_eq_self.mpr
    intro a ha
    exact core23_mem_coprimeCores hA ha
  rw [he] at hh
  exact hh.symm

def componentGrid_rank_bound {A : Finset ℕ} {n q : ℕ}
    (hbound : ∀ m ∈ A, m ≤ n) (hA : Erdos1062.ForkFree (A : Set ℕ)) (hq : 0 < q) :
    (componentGrid A q).card ≤ smoothRankBound (n / q) := by
  have hbd : ∀ a ∈ componentGrid A q, gridValue a ≤ n / q := by
    intro a ha
    apply (Nat.le_div_iff_mul_le hq).mpr
    simpa [Nat.mul_comm] using componentGrid_bound hbound a ha
  by_cases hnq : n / q = 0
  · have he : componentGrid A q = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro a ha
      have hp := gridValue_pos a
      have hh := hbd a ha
      omega
    simp [he]
  · exact grid_natural_sharp_bound (Nat.pos_of_ne_zero hnq) (componentGrid_forkFree hq hA) hbd

end Bounty

end SubmissionComponent_ComponentSum

/- Component MatchingLoss; SHA256 3cef6769bb02764c68ead0a6f082283dd18b9268f21f3a7499abb7e4616e73ae -/
section SubmissionComponent_MatchingLoss
/- Summing disjoint losses in a finite family of components. -/

namespace Bounty

def sum_matching_losses {ι : Type*} [DecidableEq ι]
    (Q E : Finset ι) (g : ι → ι) (a r : ι → ℕ)
    (hEQ : E ⊆ Q) (hgQ : E.image g ⊆ Q)
    (hginj : Set.InjOn g (E : Set ι)) (hdisj : Disjoint E (E.image g))
    (hbound : ∀ i ∈ Q, a i ≤ r i)
    (hloss : ∀ i ∈ E, a i + a (g i) + 1 ≤ r i + r (g i)) :
    (∑ i ∈ Q, a i) + E.card ≤ ∑ i ∈ Q, r i := by
  let d : ι → ℕ := fun i => r i - a i
  have hdecomp : ∀ i ∈ Q, a i + d i = r i := by
    intro i hi
    exact Nat.add_sub_of_le (hbound i hi)
  have hedge : ∀ i ∈ E, 1 ≤ d i + d (g i) := by
    intro i hi
    have hh := hloss i hi
    have hiQ := hEQ hi
    have hgiQ := hgQ (Finset.mem_image_of_mem g hi)
    have hd1 := hdecomp i hiQ
    have hd2 := hdecomp (g i) hgiQ
    omega
  have hcard : E.card ≤ ∑ i ∈ E, (d i + d (g i)) := by
    calc
      E.card = ∑ _i ∈ E, 1 := by simp
      _ ≤ ∑ i ∈ E, (d i + d (g i)) := Finset.sum_le_sum hedge
  have hsum : (∑ i ∈ E, (d i + d (g i))) = ∑ i ∈ E ∪ E.image g, d i := by
    rw [Finset.sum_add_distrib, Finset.sum_union hdisj, Finset.sum_image]
    exact fun i hi j hj hij => hginj hi hj hij
  rw [hsum] at hcard
  have hdQ : (∑ i ∈ E ∪ E.image g, d i) ≤ ∑ i ∈ Q, d i := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · exact Finset.union_subset hEQ hgQ
    · intro i _ _
      exact Nat.zero_le _
  have hwhole : (∑ i ∈ Q, a i) + (∑ i ∈ Q, d i) = ∑ i ∈ Q, r i := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl hdecomp
  omega

end Bounty

end SubmissionComponent_MatchingLoss

/- Component GlobalUpper; SHA256 dc239b5528393e265c4b58f66e52be64cf3971a8d022da7680ca03028464dc43 -/
section SubmissionComponent_GlobalUpper
/- The global upper bound, including every disjoint powers-of-five loss. -/

namespace Bounty

def badWindow_ge_ten {n : ℕ} (hn : badWindow n) : 10 ≤ n := by
  obtain ⟨j, b, _, _, h3lo, _⟩ := hn
  have hp : 0 < (3 : ℕ) ^ b := by positivity
  omega

def componentGrid_five_loss {A : Finset ℕ} {n q : ℕ}
    (hbound : ∀ m ∈ A, m ≤ n) (hA : Erdos1062.ForkFree (A : Set ℕ)) (hq : 0 < q)
    (hbad : badWindow (n / q)) :
    (componentGrid A q).card + (componentGrid A (5 * q)).card + 1 ≤
      smoothRankBound (n / q) + smoothRankBound (n / (5 * q)) := by
  let S : Set ℕ := {m | q * m ∈ A}
  have hS : Erdos1062.ForkFree S := by
    apply (forkFree_scale_iff hq S).mp
    apply forkFree_mono _ hA
    rintro m ⟨a, ha, rfl⟩
    exact ha
  have hAn : ∀ a ∈ componentGrid A q, gridValue a ≤ n / q := by
    intro a ha
    apply (Nat.le_div_iff_mul_le hq).mpr
    simpa [Nat.mul_comm] using componentGrid_bound hbound a ha
  have hBn : ∀ a ∈ componentGrid A (5 * q), 5 * gridValue a ≤ n / q := by
    intro a ha
    apply (Nat.le_div_iff_mul_le hq).mpr
    simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using componentGrid_bound hbound a ha
  have hAS : ∀ a ∈ componentGrid A q, gridValue a ∈ S := by
    intro a ha
    exact componentGrid_scaled_mem ha
  have hBS : ∀ a ∈ componentGrid A (5 * q), 5 * gridValue a ∈ S := by
    intro a ha
    change q * (5 * gridValue a) ∈ A
    simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using componentGrid_scaled_mem ha
  have hh := badWindow_rank_loss hbad (componentGrid_forkFree hq hA)
    (componentGrid_forkFree (by omega : 0 < 5 * q) hA) hAn hBn hAS hBS hS
  simpa only [Nat.div_div_eq_div_mul, Nat.mul_comm q 5] using hh

noncomputable def lossCores (n : ℕ) : Finset ℕ :=
  open scoped Classical in (coprimeCores n).filter (fun q => badWindow (n / q))

def lossCores_subset (n : ℕ) : lossCores n ⊆ coprimeCores n := by
  classical
  exact Finset.filter_subset _ _

def lossCores_five_subset (n : ℕ) :
    (lossCores n).image (fun q => 5 * q) ⊆ coprimeCores n := by
  classical
  intro x hx
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hx
  obtain ⟨hqQ, hbad⟩ := Finset.mem_filter.mp hq
  obtain ⟨hqI, hq6⟩ := Finset.mem_filter.mp hqQ
  obtain ⟨hq1, hqn⟩ := Finset.mem_Icc.mp hqI
  have hten := badWindow_ge_ten hbad
  have hle : 5 * q ≤ n := (Nat.le_div_iff_mul_le hq1).mp (by omega)
  apply Finset.mem_filter.mpr
  constructor
  · exact Finset.mem_Icc.mpr ⟨by omega, hle⟩
  · exact (Nat.coprime_mul_iff_left).mpr ⟨by norm_num, hq6⟩

def lossCores_disjoint (n : ℕ) :
    Disjoint (lossCores n) ((lossCores n).image (fun q => 5 * q)) := by
  classical
  apply Finset.disjoint_left.mpr
  intro x hx hy
  obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hy
  have hbad := (Finset.mem_filter.mp hq).2
  have hbad' := (Finset.mem_filter.mp hx).2
  apply badWindow_not_div_five hbad
  simpa only [Nat.div_div_eq_div_mul, Nat.mul_comm q 5] using hbad'

def forkFree_card_with_losses {A : Finset ℕ} {n : ℕ}
    (hbound : ∀ m ∈ A, 1 ≤ m ∧ m ≤ n) (hA : Erdos1062.ForkFree (A : Set ℕ)) :
    A.card + (lossCores n).card ≤ ∑ q ∈ coprimeCores n, smoothRankBound (n / q) := by
  classical
  rw [card_eq_sum_components hbound]
  have hi : Set.InjOn (fun q : ℕ => 5 * q) (lossCores n : Set ℕ) := by
    intro q hq r hr he
    dsimp only at he
    omega
  apply sum_matching_losses (coprimeCores n) (lossCores n) (fun q => 5 * q)
    (fun q => (componentGrid A q).card) (fun q => smoothRankBound (n / q))
    (lossCores_subset n) (lossCores_five_subset n) hi (lossCores_disjoint n)
  · intro q hq
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
    exact componentGrid_rank_bound (fun m hm => (hbound m hm).2) hA hqpos
  · intro q hq
    obtain ⟨hqQ, hbad⟩ := Finset.mem_filter.mp hq
    have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hqQ).1).1
    exact componentGrid_five_loss (fun m hm => (hbound m hm).2) hA hqpos hbad

noncomputable def globalUpper (n : ℕ) : ℕ :=
  (∑ q ∈ coprimeCores n, smoothRankBound (n / q)) - (lossCores n).card

def f_le_globalUpper (n : ℕ) : Erdos1062.f n ≤ globalUpper n := by
  classical
  obtain ⟨A, hAb, hAf, hAc⟩ := exists_maximizer n
  have hfin : A.Finite := (Set.finite_Icc 1 n).subset hAb
  let T := hfin.toFinset
  have hT : (T : Set ℕ) = A := Set.Finite.coe_toFinset _
  have hbound : ∀ m ∈ T, 1 ≤ m ∧ m ≤ n := by
    intro m hm
    have hmA : m ∈ A := by rwa [← hT]
    exact hAb hmA
  have hfree : Erdos1062.ForkFree (T : Set ℕ) := by rwa [hT]
  have hh := forkFree_card_with_losses hbound hfree
  have hc : T.card = Erdos1062.f n := by
    rw [← Set.ncard_coe_finset, hT, hAc]
  rw [hc] at hh
  unfold globalUpper
  omega

end Bounty

end SubmissionComponent_GlobalUpper

/- Component WindowExact; SHA256 7c1db549ba2a17e00ad4334fbee770863cdc4286251a8486ec2c0c60d3d8f68f -/
section SubmissionComponent_WindowExact
/- Each cutoff window is exactly its explicit witness. -/

namespace Bounty

def log_scaled_eq {b d n k : ℕ} (hd : 0 < d)
    (hlo : d * b ^ k ≤ n) (hhi : n < b * (d * b ^ k)) :
    Nat.log b (n / d) = k := by
  apply Nat.log_eq_of_pow_le_of_lt_pow
  · apply (Nat.le_div_iff_mul_le hd).mpr
    simpa [Nat.mul_comm] using hlo
  · apply (Nat.div_lt_iff_lt_mul hd).mpr
    simpa [pow_succ, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using hhi

def cutoffWindow0_grid_mem {n a b : ℕ}
    (hm : gridValue (a, b) ∈ cutoffWindow 0 n) : (a, b) ∈ window0Grid n := by
  have hn : 0 < n := by
    have hp := gridValue_pos (a, b)
    have hh := (cutoffWindow_subset 0 n hm).2
    omega
  have hbounds := gridValue_log_bounds (cutoffWindow_subset 0 n hm).2
  rcases hm.2 with hm | hm
  · rw [gridValue_factorization_two] at hm
    change a % 2 = 0 ∧ n < 4 * (2 ^ a * 3 ^ b) ∧ 2 ^ a * 3 ^ b ≤ n at hm
    have ha : a = 2 * (a / 2) := by omega
    have hpow : (2 : ℕ) ^ a = 4 ^ (a / 2) := by
      calc
        (2 : ℕ) ^ a = 2 ^ (2 * (a / 2)) := by rw [← ha]
        _ = 4 ^ (a / 2) := two_pow_even _
    have hlog : Nat.log 4 (n / 3 ^ b) = a / 2 := by
      apply log_scaled_eq (by positivity)
      · rw [hpow] at hm
        nlinarith [hm.2.2]
      · rw [hpow] at hm
        nlinarith [hm.2.1]
    apply Finset.mem_union_left
    apply Finset.mem_image.mpr
    refine ⟨b, Finset.mem_range.mpr (by omega), ?_⟩
    apply Prod.ext
    · dsimp [window0Primary]
      omega
    · rfl
  · rw [gridValue_factorization_two] at hm
    change a % 2 ≠ 0 ∧ n < 6 * (2 ^ a * 3 ^ b) ∧ 2 * (2 ^ a * 3 ^ b) ≤ n at hm
    have ha : a = 2 * (a / 2) + 1 := by omega
    have hpow : (2 : ℕ) ^ a = 2 * 4 ^ (a / 2) := by
      calc
        (2 : ℕ) ^ a = 2 ^ (2 * (a / 2) + 1) := by rw [← ha]
        _ = 2 * 4 ^ (a / 2) := two_pow_odd _
    have hvalue : 2 * (2 ^ a * 3 ^ b) = 4 ^ (a / 2 + 1) * 3 ^ b := by
      rw [hpow, pow_succ]
      ring
    have hlog : Nat.log 3 (n / 4 ^ (a / 2 + 1)) = b := by
      apply log_scaled_eq (by positivity)
      · rw [← hvalue]
        exact hm.2.2
      · rw [← hvalue]
        omega
    have hj : a / 2 < Nat.log 4 n := by
      have hp : 0 < (3 : ℕ) ^ b := by positivity
      have hh : (4 : ℕ) ^ (a / 2 + 1) ≤ n := by
        rw [hvalue] at hm
        nlinarith [hm.2.2]
      have := (Nat.le_log_iff_pow_le (by norm_num : 1 < (4 : ℕ)) (by omega : n ≠ 0)).mpr hh
      omega
    apply Finset.mem_union_right
    apply Finset.mem_image.mpr
    refine ⟨a / 2, Finset.mem_range.mpr hj, ?_⟩
    apply Prod.ext
    · dsimp [window0Secondary]
      omega
    · exact hlog

def cutoffWindow0_eq {n : ℕ} (hn : 0 < n) :
    cutoffWindow 0 n = (window0Witness n : Set ℕ) := by
  apply Set.Subset.antisymm
  · intro m hm
    obtain ⟨a, b, he⟩ := hm.1
    have he' : m = gridValue (a, b) := he
    rw [he'] at hm ⊢
    exact Finset.mem_image_of_mem _ (cutoffWindow0_grid_mem hm)
  · exact window0Witness_subset hn

def cutoffWindow0_ncard {n : ℕ} (hn : 0 < n) :
    (cutoffWindow 0 n).ncard = Nat.log 3 n + 1 + Nat.log 4 n := by
  rw [cutoffWindow0_eq hn, Set.ncard_coe_finset, window0Witness_card]

end Bounty

end SubmissionComponent_WindowExact

/- Component WindowCountOne; SHA256 f7fe9933c5b7f1a612fa7f98d6b23aef403bd701a01ae219e695e60056ee5b7b -/
section SubmissionComponent_WindowCountOne
/- The other parity of the cutoff construction and exact component rank. -/

namespace Bounty

def window1Witness (n : ℕ) : Finset ℕ :=
  insert (3 ^ Nat.log 3 (n / 2)) ((window0Witness (n / 2)).image (fun m => 2 * m))

def window1Witness_card (n : ℕ) :
    (window1Witness n).card = Nat.log 3 (n / 2) + Nat.log 4 (n / 2) + 2 := by
  have hnot : 3 ^ Nat.log 3 (n / 2) ∉
      (window0Witness (n / 2)).image (fun m => 2 * m) := by
    intro hh
    obtain ⟨m, hm, he⟩ := Finset.mem_image.mp hh
    have hd : 2 ∣ 3 ^ Nat.log 3 (n / 2) := ⟨m, he.symm⟩
    have := Nat.prime_two.dvd_of_dvd_pow hd
    norm_num at this
  have hi : Function.Injective (fun m : ℕ => 2 * m) := by
    intro a b hab
    dsimp only at hab
    omega
  rw [window1Witness, Finset.card_insert_of_notMem hnot,
    Finset.card_image_of_injective _ hi, window0Witness_card]
  omega

def window1_base_mem {n : ℕ} (hn : 2 ≤ n) :
    3 ^ Nat.log 3 (n / 2) ∈ cutoffWindow 1 n := by
  have hn' : n / 2 ≠ 0 := by omega
  have hlo := Nat.pow_log_le_self 3 hn'
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < (3 : ℕ)) (n / 2)
  rw [pow_succ] at hhi
  have hpow : (3 ^ Nat.log 3 (n / 2)).factorization 2 = 0 := by
    have hh := gridValue_factorization_two (0, Nat.log 3 (n / 2))
    simpa [gridValue] using hh
  constructor
  · exact ⟨0, Nat.log 3 (n / 2), by simp⟩
  · right
    exact ⟨by omega, by omega, by omega⟩

def window1_double_mem {n m : ℕ} (hm : m ∈ cutoffWindow 0 (n / 2)) :
    2 * m ∈ cutoffWindow 1 n := by
  have hmpos := smooth23_pos hm.1
  have hfactor := factorization_two_double hmpos
  constructor
  · obtain ⟨a, b, he⟩ := hm.1
    exact ⟨a + 1, b, by rw [he, pow_succ]; ring⟩
  · rcases hm.2 with hm | hm
    · left
      exact ⟨by omega, by omega, by omega⟩
    · right
      exact ⟨by omega, by omega, by omega⟩

def window1Witness_subset {n : ℕ} (hn : 2 ≤ n) :
    (window1Witness n : Set ℕ) ⊆ cutoffWindow 1 n := by
  intro m hm
  rcases Finset.mem_insert.mp hm with rfl | hm
  · exact window1_base_mem hn
  · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hm
    exact window1_double_mem (window0Witness_subset (by omega : 0 < n / 2) ha)

def log_four_eq (n : ℕ) : Nat.log 4 n = Nat.log 2 n / 2 := by
  exact Nat.log_pow_left 2 2 n

def log_three_half {n : ℕ} (_hn : 0 < n)
    (htop : 2 * 3 ^ Nat.log 3 n ≤ n) : Nat.log 3 (n / 2) = Nat.log 3 n := by
  have hp : 0 < (3 : ℕ) ^ Nat.log 3 n := by positivity
  have hn2 : n / 2 ≠ 0 := by omega
  apply le_antisymm
  · apply Nat.log_mono_right
    exact Nat.div_le_self n 2
  · apply (Nat.le_log_iff_pow_le (by norm_num) hn2).mpr
    omega

def log_four_half_odd {n : ℕ} (hpar : Nat.log 2 n % 2 = 1) :
    Nat.log 4 (n / 2) = Nat.log 4 n := by
  rw [log_four_eq, log_four_eq, Nat.log_div_base]
  omega

end Bounty

end SubmissionComponent_WindowCountOne

/- Component WindowExactOne; SHA256 e41d375d05a6e50965b8238113172fa9284275332240b2f251738df55ef0ae51 -/
section SubmissionComponent_WindowExactOne
/- Exact cardinalities and lower-endpoint cases of both cutoff windows. -/

namespace Bounty

def cutoffWindow1_half {n m : ℕ} (hs : Smooth23 m)
    (hm : 2 * m ∈ cutoffWindow 1 n) : m ∈ cutoffWindow 0 (n / 2) := by
  have hfactor := factorization_two_double (smooth23_pos hs)
  constructor
  · exact hs
  · rcases hm.2 with hm | hm
    · left
      exact ⟨by omega, by omega, by omega⟩
    · right
      exact ⟨by omega, by omega, by omega⟩

def cutoffWindow1_eq {n : ℕ} (hn : 2 ≤ n) :
    cutoffWindow 1 n = (window1Witness n : Set ℕ) := by
  apply Set.Subset.antisymm
  · intro m hm
    obtain ⟨a, b, he⟩ := hm.1
    have he' : m = gridValue (a, b) := he
    rw [he'] at hm ⊢
    by_cases ha : a = 0
    · have hmem : 3 ^ b ∈ cutoffWindow 1 n := by
        simpa [ha, gridValue] using hm
      have hfactor : (3 ^ b).factorization 2 = 0 := by
        simpa [gridValue] using gridValue_factorization_two (0, b)
      have hwindow : n < 6 * 3 ^ b ∧ 2 * 3 ^ b ≤ n := by
        rcases hmem.2 with h | h
        · omega
        · exact h.2
      have hlog : Nat.log 3 (n / 2) = b := by
        apply Nat.log_eq_of_pow_le_of_lt_pow
        · omega
        · rw [pow_succ]
          omega
      change gridValue (a, b) ∈ window1Witness n
      have hvalue : gridValue (a, b) = 3 ^ Nat.log 3 (n / 2) := by
        simp [gridValue, ha, hlog]
      rw [hvalue]
      exact Finset.mem_insert_self _ _
    · have ha' : a = (a - 1) + 1 := by omega
      have hvalue : gridValue (a, b) = 2 * gridValue (a - 1, b) := by
        change 2 ^ a * 3 ^ b = 2 * (2 ^ (a - 1) * 3 ^ b)
        conv_lhs => rw [ha', pow_succ]
        ring
      rw [hvalue] at hm ⊢
      have hs : Smooth23 (gridValue (a - 1, b)) := ⟨a - 1, b, rfl⟩
      have hhalf := cutoffWindow1_half hs hm
      rw [cutoffWindow0_eq (by omega : 0 < n / 2)] at hhalf
      apply Finset.mem_insert_of_mem
      exact Finset.mem_image_of_mem _ hhalf
  · exact window1Witness_subset hn

def cutoffWindow1_ncard {n : ℕ} (hn : 2 ≤ n) :
    (cutoffWindow 1 n).ncard = Nat.log 3 (n / 2) + Nat.log 4 (n / 2) + 2 := by
  rw [cutoffWindow1_eq hn, Set.ncard_coe_finset, window1Witness_card]

def cutoffWindow_zero (p : ℕ) : cutoffWindow p 0 = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro m hm
  have hh := cutoffWindow_subset p 0 hm
  have := hh.1
  have := hh.2
  omega

def cutoffWindow1_one : cutoffWindow 1 1 = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro m hm
  have hbound := cutoffWindow_subset 1 1 hm
  have hm1 : m = 1 := by have := hbound.1; have := hbound.2; omega
  subst m
  have hfactor : (1 : ℕ).factorization 2 = 0 := by simp
  rcases hm.2 with hh | hh <;> omega

def cutoffCount (p n : ℕ) : ℕ :=
  if p = 0 then
    if n = 0 then 0 else Nat.log 3 n + 1 + Nat.log 4 n
  else
    if n < 2 then 0 else Nat.log 3 (n / 2) + Nat.log 4 (n / 2) + 2

def cutoffWindow_ncard {p : ℕ} (hp : p < 2) (n : ℕ) :
    (cutoffWindow p n).ncard = cutoffCount p n := by
  by_cases hp0 : p = 0
  · subst p
    by_cases hn : n = 0
    · subst n
      simp [cutoffCount, cutoffWindow_zero]
    · rw [cutoffWindow0_ncard (by omega)]
      simp [cutoffCount, hn]
  · have hp1 : p = 1 := by omega
    subst p
    by_cases hn : n < 2
    · have he : n = 0 ∨ n = 1 := by omega
      rcases he with rfl | rfl <;> simp [cutoffWindow_zero, cutoffWindow1_one, cutoffCount]
    · rw [cutoffWindow1_ncard (by omega)]
      simp [cutoffCount, hn]

def cutoffCount_mono (p : ℕ) : Monotone (cutoffCount p) := by
  intro n m hnm
  have h3 := Nat.log_mono_right (b := 3) hnm
  have h4 := Nat.log_mono_right (b := 4) hnm
  have hhalf : n / 2 ≤ m / 2 := Nat.div_le_div_right hnm
  have h3half := Nat.log_mono_right (b := 3) hhalf
  have h4half := Nat.log_mono_right (b := 4) hhalf
  unfold cutoffCount
  split_ifs <;> omega

end Bounty

end SubmissionComponent_WindowExactOne

/- Component GlobalWindow; SHA256 a7b66394c6115a86e778d7fc92d0e6bee6f5ffa829a479daa37161887b5349d6 -/
section SubmissionComponent_GlobalWindow
/- A local-to-global criterion for the cutoff construction. -/

namespace Bounty

def core23_small_multiplier {a b n : ℕ}
    (_ha : 0 < a) (hb : 0 < b) (hlow : n < 8 * a) (hhigh : b ≤ n)
    (hab : a ∣ b) (hne : a ≠ b) (h5 : b ≠ 5 * a) (h7 : b ≠ 7 * a) :
    core23 b = core23 a := by
  obtain ⟨k, rfl⟩ := hab
  have hk : k < 8 := by nlinarith
  have hk0 : 0 < k := by nlinarith
  have hk1 : k ≠ 1 := by intro he; simp [he] at hne
  have hk5 : k ≠ 5 := by intro he; apply h5; rw [he]; ring
  have hk7 : k ≠ 7 := by intro he; apply h7; rw [he]; ring
  have hs : Smooth23 k := by
    have hc : k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 6 := by omega
    rcases hc with rfl | rfl | rfl | rfl
    · exact ⟨1, 0, by norm_num⟩
    · exact ⟨0, 1, by norm_num⟩
    · exact ⟨2, 0, by norm_num⟩
    · exact ⟨1, 1, by norm_num⟩
  obtain ⟨x, y, he⟩ := hs
  have hcore : core23 k = 1 := by
    rw [he]
    exact core23_gridValue (x, y)
  rw [core23_mul, hcore, mul_one]

def forkFree_of_components_above_eighth {S : Set ℕ} {n : ℕ}
    (hbound : ∀ a ∈ S, 0 < a ∧ n < 8 * a ∧ a ≤ n)
    (h5 : ∀ a ∈ S, 5 * a ∉ S) (h7 : ∀ a ∈ S, 7 * a ∉ S)
    (hcomponents : ∀ q, Erdos1062.ForkFree (S ∩ {a | core23 a = q})) :
    Erdos1062.ForkFree S := by
  rw [forkFree_iff]
  intro a b c ha hb hc hab hac hdab hdac
  have habcore : core23 b = core23 a := by
    exact core23_small_multiplier (hbound a ha).1 (hbound b hb).1 (hbound a ha).2.1
      (hbound b hb).2.2 hdab hab (by intro he; exact h5 a ha (he ▸ hb))
      (by intro he; exact h7 a ha (he ▸ hb))
  have haccore : core23 c = core23 a := by
    exact core23_small_multiplier (hbound a ha).1 (hbound c hc).1 (hbound a ha).2.1
      (hbound c hc).2.2 hdac hac (by intro he; exact h5 a ha (he ▸ hc))
      (by intro he; exact h7 a ha (he ▸ hc))
  exact (forkFree_iff _).mp (hcomponents (core23 a)) a b c
    ⟨ha, rfl⟩ ⟨hb, habcore⟩ ⟨hc, haccore⟩ hab hac hdab hdac

end Bounty

end SubmissionComponent_GlobalWindow

/- Component SelectedFamily; SHA256 24f7ad88a998e9eac12aa46e63b7af28a81b696f27571d0aa2f32b30cfc6d7c2 -/
section SubmissionComponent_SelectedFamily
/- Assembling compatible cutoff windows in disjoint arithmetic components. -/

namespace Bounty

noncomputable def scaledCutoff (q p r : ℕ) : Finset ℕ :=
  (cutoffWindow_finite p r).toFinset.image (fun s => q * s)

noncomputable def selectedFamily (Q : Finset ℕ) (p r : ℕ → ℕ) : Finset ℕ :=
  Q.biUnion (fun q => scaledCutoff q (p q) (r q))

def mem_scaledCutoff {a q p r : ℕ} :
    a ∈ scaledCutoff q p r ↔ ∃ s ∈ cutoffWindow p r, a = q * s := by
  simp [scaledCutoff, eq_comm]

def mem_selectedFamily {a : ℕ} {Q : Finset ℕ} {p r : ℕ → ℕ} :
    a ∈ selectedFamily Q p r ↔
      ∃ q ∈ Q, ∃ s ∈ cutoffWindow (p q) (r q), a = q * s := by
  simp only [selectedFamily, Finset.mem_biUnion, mem_scaledCutoff]

def smooth23_core {s : ℕ} (hs : Smooth23 s) : core23 s = 1 := by
  obtain ⟨a, b, rfl⟩ := hs
  exact core23_gridValue (a, b)

def scaledCutoff_core {a q p r : ℕ} (hq : q.Coprime 6)
    (ha : a ∈ scaledCutoff q p r) : core23 a = q := by
  obtain ⟨s, hs, rfl⟩ := mem_scaledCutoff.mp ha
  rw [core23_mul, core23_eq_self hq, smooth23_core hs.1, mul_one]

def scaledCutoff_card {q p r : ℕ} (hq : 0 < q) (hp : p < 2) :
    (scaledCutoff q p r).card = cutoffCount p r := by
  have hi : Function.Injective (fun s : ℕ => q * s) := by
    intro a b hab
    exact Nat.eq_of_mul_eq_mul_left hq hab
  rw [scaledCutoff, Finset.card_image_of_injective _ hi,
    ← Set.ncard_eq_toFinset_card (cutoffWindow p r) (cutoffWindow_finite p r), cutoffWindow_ncard hp]

def scaledCutoff_forkFree {q p r : ℕ} (hq : 0 < q) (hp : p < 2) :
    Erdos1062.ForkFree (scaledCutoff q p r : Set ℕ) := by
  have he : (scaledCutoff q p r : Set ℕ) = (fun s => q * s) '' cutoffWindow p r := by
    ext a
    simp only [Finset.mem_coe, mem_scaledCutoff, Set.mem_image]
    constructor
    · rintro ⟨s, hs, he⟩
      exact ⟨s, hs, he.symm⟩
    · rintro ⟨s, hs, he⟩
      exact ⟨s, hs, he.symm⟩
  rw [he]
  exact (forkFree_scale_iff hq _).mpr (cutoffWindow_forkFree hp r)

def selectedFamily_card {Q : Finset ℕ} {p r : ℕ → ℕ}
    (hQ : ∀ q ∈ Q, 0 < q ∧ q.Coprime 6) (hp : ∀ q ∈ Q, p q < 2) :
    (selectedFamily Q p r).card = ∑ q ∈ Q, cutoffCount (p q) (r q) := by
  have hd : ∀ q ∈ Q, ∀ t ∈ Q, q ≠ t →
      Disjoint (scaledCutoff q (p q) (r q)) (scaledCutoff t (p t) (r t)) := by
    intro q hq t ht hne
    apply Finset.disjoint_left.mpr
    intro a ha hb
    exact hne ((scaledCutoff_core (hQ q hq).2 ha).symm.trans (scaledCutoff_core (hQ t ht).2 hb))
  rw [selectedFamily, Finset.card_biUnion hd]
  apply Finset.sum_congr rfl
  intro q hq
  exact scaledCutoff_card (hQ q hq).1 (hp q hq)

def selectedFamily_components {Q : Finset ℕ} {p r : ℕ → ℕ}
    (hQ : ∀ q ∈ Q, 0 < q ∧ q.Coprime 6) (hp : ∀ q ∈ Q, p q < 2) (q : ℕ) :
    Erdos1062.ForkFree ((selectedFamily Q p r : Set ℕ) ∩ {a | core23 a = q}) := by
  by_cases hqQ : q ∈ Q
  · apply forkFree_mono _ (scaledCutoff_forkFree (r := r q) (hQ q hqQ).1 (hp q hqQ))
    intro a ha
    obtain ⟨t, ht, s, hs, he⟩ := mem_selectedFamily.mp ha.1
    have hmem : a ∈ scaledCutoff t (p t) (r t) := mem_scaledCutoff.mpr ⟨s, hs, he⟩
    have hcore := scaledCutoff_core (hQ t ht).2 hmem
    have htq : t = q := hcore.symm.trans ha.2
    rwa [htq] at hmem
  · have he : ((selectedFamily Q p r : Set ℕ) ∩ {a | core23 a = q}) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro a ha
      obtain ⟨t, ht, s, hs, he⟩ := mem_selectedFamily.mp ha.1
      have hmem : a ∈ scaledCutoff t (p t) (r t) := mem_scaledCutoff.mpr ⟨s, hs, he⟩
      have hcore := scaledCutoff_core (hQ t ht).2 hmem
      have htq : t = q := hcore.symm.trans ha.2
      exact hqQ (htq ▸ ht)
    rw [he]
    exact forkFree_empty

def selectedFamily_exclude_multiple {Q : Finset ℕ} {p r : ℕ → ℕ} {d : ℕ}
    (hQ : ∀ q ∈ Q, 0 < q ∧ q.Coprime 6) (hd : 0 < d) (hd6 : d.Coprime 6)
    (hdisj : ∀ q ∈ Q, d * q ∈ Q →
      Disjoint (cutoffWindow (p q) (r q)) (cutoffWindow (p (d * q)) (r (d * q)))) :
    ∀ a ∈ selectedFamily Q p r, d * a ∉ selectedFamily Q p r := by
  intro a ha hb
  obtain ⟨q, hq, s, hs, has⟩ := mem_selectedFamily.mp ha
  obtain ⟨t, ht, u, hu, hbu⟩ := mem_selectedFamily.mp hb
  have hcorea : core23 a = q :=
    scaledCutoff_core (hQ q hq).2 (mem_scaledCutoff.mpr ⟨s, hs, has⟩)
  have hcoreb : core23 (d * a) = t :=
    scaledCutoff_core (hQ t ht).2 (mem_scaledCutoff.mpr ⟨u, hu, hbu⟩)
  have htq : t = d * q := by
    rw [core23_mul, core23_eq_self hd6, hcorea] at hcoreb
    exact hcoreb.symm
  have hsu : s = u := by
    apply Nat.eq_of_mul_eq_mul_left (mul_pos hd (hQ q hq).1)
    calc
      (d * q) * s = d * (q * s) := by ring
      _ = d * a := by rw [has]
      _ = t * u := hbu
      _ = (d * q) * u := by rw [htq]
  have hD := hdisj q hq (htq ▸ ht)
  have hu' : s ∈ cutoffWindow (p (d * q)) (r (d * q)) := by
    rw [hsu]
    rwa [htq] at hu
  exact Set.disjoint_left.mp hD hs hu'

def selectedFamily_forkFree {Q : Finset ℕ} {p r : ℕ → ℕ} {n : ℕ}
    (hQ : ∀ q ∈ Q, 0 < q ∧ q.Coprime 6) (hp : ∀ q ∈ Q, p q < 2)
    (hcut : ∀ q ∈ Q, q * r q ≤ n)
    (hlow : ∀ q ∈ Q, ∀ s ∈ cutoffWindow (p q) (r q), n < 8 * (q * s))
    (h5 : ∀ q ∈ Q, 5 * q ∈ Q →
      (if p q = p (5 * q) then 4 else 6) * r (5 * q) ≤ r q)
    (h7 : ∀ q ∈ Q, 7 * q ∈ Q →
      (if p q = p (7 * q) then 4 else 6) * r (7 * q) ≤ r q) :
    Erdos1062.ForkFree (selectedFamily Q p r : Set ℕ) := by
  apply forkFree_of_components_above_eighth
  · intro a ha
    obtain ⟨q, hq, s, hs, rfl⟩ := mem_selectedFamily.mp ha
    refine ⟨mul_pos (hQ q hq).1 (smooth23_pos hs.1), hlow q hq s hs, ?_⟩
    have hsr := (cutoffWindow_subset (p q) (r q) hs).2
    exact (Nat.mul_le_mul_left q hsr).trans (hcut q hq)
  · exact selectedFamily_exclude_multiple hQ (by norm_num : 0 < (5 : ℕ)) (by norm_num)
      (fun q hq ht => cutoffWindow_disjoint (h5 q hq ht))
  · exact selectedFamily_exclude_multiple hQ (by norm_num : 0 < (7 : ℕ)) (by norm_num)
      (fun q hq ht => cutoffWindow_disjoint (h7 q hq ht))
  · exact selectedFamily_components hQ hp

end Bounty

end SubmissionComponent_SelectedFamily

/- Component CutoffCertificate; SHA256 c10fb000d64bdd10e74f201284ed9e9f3922358a9af8997fb0a9338b14a450eb -/
section SubmissionComponent_CutoffCertificate
/- The precise certificate needed to attain the global upper bound. -/

namespace Bounty

noncomputable def lossChildren (n : ℕ) : Finset ℕ :=
  (lossCores n).image (fun q => 5 * q)

noncomputable def componentQuota (n q : ℕ) : ℕ :=
  open scoped Classical in smoothRankBound (n / q) - if q ∈ lossChildren n then 1 else 0

def smoothRankBound_pos {n : ℕ} (hn : 0 < n) : 0 < smoothRankBound n := by
  unfold smoothRankBound
  rw [if_neg (ne_of_gt hn)]
  omega

def lossChildren_rank_pos {n q : ℕ} (hq : q ∈ lossChildren n) :
    0 < smoothRankBound (n / q) := by
  classical
  obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hq
  have hbad := (Finset.mem_filter.mp ht).2
  have hten := badWindow_ge_ten hbad
  have hn : 0 < n / (5 * t) := by
    rw [Nat.mul_comm 5 t, ← Nat.div_div_eq_div_mul]
    omega
  exact smoothRankBound_pos hn

def componentQuota_sum (n : ℕ) :
    (∑ q ∈ coprimeCores n, componentQuota n q) = globalUpper n := by
  classical
  have hsubset : lossChildren n ⊆ coprimeCores n := lossCores_five_subset n
  have hfilter : (coprimeCores n).filter (fun q => q ∈ lossChildren n) = lossChildren n := by
    ext q
    simp only [Finset.mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨hsubset h, h⟩⟩
  have hsum : (∑ q ∈ coprimeCores n, if q ∈ lossChildren n then 1 else 0) =
      (lossChildren n).card := by
    rw [Finset.sum_boole, hfilter]
    norm_cast
  have hcard : (lossChildren n).card = (lossCores n).card := by
    apply Finset.card_image_of_injective
    intro a b hab
    dsimp only at hab
    omega
  unfold componentQuota globalUpper
  rw [Finset.sum_tsub_distrib, hsum, hcard]
  intro q hq
  split_ifs with hh
  · exact lossChildren_rank_pos hh
  · exact Nat.zero_le _

structure CutoffCertificate (n : ℕ) where
  parity : ℕ → ℕ
  cutoff : ℕ → ℕ
  parity_lt : ∀ q ∈ coprimeCores n, parity q < 2
  cutoff_bound : ∀ q ∈ coprimeCores n, q * cutoff q ≤ n
  lower_bound : ∀ q ∈ coprimeCores n, ∀ s ∈ cutoffWindow (parity q) (cutoff q),
    n < 8 * (q * s)
  compatible_five : ∀ q ∈ coprimeCores n, 5 * q ∈ coprimeCores n →
    (if parity q = parity (5 * q) then 4 else 6) * cutoff (5 * q) ≤ cutoff q
  compatible_seven : ∀ q ∈ coprimeCores n, 7 * q ∈ coprimeCores n →
    (if parity q = parity (7 * q) then 4 else 6) * cutoff (7 * q) ≤ cutoff q
  quota : ∀ q ∈ coprimeCores n, cutoffCount (parity q) (cutoff q) = componentQuota n q

def cutoffCertificate_witness {n : ℕ} (C : CutoffCertificate n) :
    ∃ A : Finset ℕ, (∀ m ∈ A, 1 ≤ m ∧ m ≤ n) ∧
      Erdos1062.ForkFree (A : Set ℕ) ∧ A.card = globalUpper n := by
  have hQ : ∀ q ∈ coprimeCores n, 0 < q ∧ q.Coprime 6 := by
    intro q hq
    obtain ⟨hqI, hq6⟩ := Finset.mem_filter.mp hq
    exact ⟨(Finset.mem_Icc.mp hqI).1, hq6⟩
  refine ⟨selectedFamily (coprimeCores n) C.parity C.cutoff, ?_, ?_, ?_⟩
  · intro m hm
    obtain ⟨q, hq, s, hs, rfl⟩ := mem_selectedFamily.mp hm
    constructor
    · exact mul_pos (hQ q hq).1 (smooth23_pos hs.1)
    · exact (Nat.mul_le_mul_left q (cutoffWindow_subset _ _ hs).2).trans (C.cutoff_bound q hq)
  · exact selectedFamily_forkFree hQ C.parity_lt C.cutoff_bound C.lower_bound
      C.compatible_five C.compatible_seven
  · rw [selectedFamily_card hQ C.parity_lt]
    calc
      (∑ q ∈ coprimeCores n, cutoffCount (C.parity q) (C.cutoff q)) =
          ∑ q ∈ coprimeCores n, componentQuota n q := Finset.sum_congr rfl C.quota
      _ = globalUpper n := componentQuota_sum n

def f_eq_globalUpper_of_certificate {n : ℕ} (C : CutoffCertificate n) :
    Erdos1062.f n = globalUpper n := by
  apply le_antisymm (f_le_globalUpper n)
  obtain ⟨A, hbound, hfree, hcard⟩ := cutoffCertificate_witness C
  rw [← hcard, ← Set.ncard_coe_finset]
  apply card_le_f _ hfree
  intro m hm
  exact hbound m hm

end Bounty

end SubmissionComponent_CutoffCertificate

/- Component QuotaIdentity; SHA256 dbd6804f74b09f50a215146d881d7238a4c9fbb7ebd802a406146a78919c99b9 -/
section SubmissionComponent_QuotaIdentity
/- The component quota is the type-dependent quota of the rational recursion. -/

namespace Bounty

def lossChildren_iff {n q : ℕ} (hq : q ∈ coprimeCores n) :
    q ∈ lossChildren n ↔ 5 ∣ q ∧ badWindow (n / (q / 5)) := by
  classical
  constructor
  · intro hh
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hh
    constructor
    · exact dvd_mul_right 5 t
    · simpa using (Finset.mem_filter.mp ht).2
  · rintro ⟨⟨t, rfl⟩, hbad⟩
    have htQ : t ∈ coprimeCores n := by
      obtain ⟨hqI, hq6⟩ := Finset.mem_filter.mp hq
      obtain ⟨hqpos, hqn⟩ := Finset.mem_Icc.mp hqI
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_Icc.mpr ⟨by omega, by omega⟩, (Nat.coprime_mul_iff_left.mp hq6).2⟩
    apply Finset.mem_image_of_mem
    apply Finset.mem_filter.mpr
    exact ⟨htQ, by simpa using hbad⟩

def quotient_ge_one_of_core_mem {n q : ℕ} (hq : q ∈ coprimeCores n) :
    1 ≤ (n : ℚ) / q := by
  obtain ⟨hqI, _⟩ := Finset.mem_filter.mp hq
  obtain ⟨hqpos, hqn⟩ := Finset.mem_Icc.mp hqI
  apply (le_div_iff₀ (by exact_mod_cast hqpos : (0 : ℚ) < q)).mpr
  simpa using (show (q : ℚ) ≤ n by exact_mod_cast hqn)

def rational_scaled_quotient (n q d : ℕ) :
    (n : ℚ) / (d * q : ℕ) = ((n : ℚ) / q) / d := by
  rw [div_div]
  congr 1
  push_cast
  ring

def floor_five_quotient {n q : ℕ} (hq : 0 < q) (h5 : 5 ∣ q) :
    ⌊5 * ((n : ℚ) / q)⌋₊ = n / (q / 5) := by
  obtain ⟨t, rfl⟩ := h5
  have ht : (t : ℚ) ≠ 0 := by exact_mod_cast (by omega : t ≠ 0)
  have he : 5 * ((n : ℚ) / (5 * t : ℕ)) = (n : ℚ) / t := by
    push_cast
    field_simp
  rw [he, Nat.floor_div_eq_div]
  simp

noncomputable def rationalQuota (eps : Bool) (u : ℚ) : ℕ :=
  open scoped Classical in smoothRankBound ⌊u⌋₊ -
    if eps = true ∧ badWindow ⌊5 * u⌋₊ then 1 else 0

def componentQuota_eq_rationalQuota {n q : ℕ} (hq : q ∈ coprimeCores n) :
    componentQuota n q = rationalQuota (decide (5 ∣ q)) ((n : ℚ) / q) := by
  classical
  have hqpos := (Finset.mem_Icc.mp (Finset.mem_filter.mp hq).1).1
  unfold componentQuota rationalQuota
  rw [Nat.floor_div_eq_div]
  by_cases h5 : 5 ∣ q
  · rw [floor_five_quotient hqpos h5]
    simp [lossChildren_iff hq, h5]
  · simp [lossChildren_iff hq, h5]

end Bounty

end SubmissionComponent_QuotaIdentity

/- Component ComputableWindow; SHA256 f52220eca8eacfad95e815a69b744ca4fc7b894f14bf7a4c259862092a3d5b5b -/
section SubmissionComponent_ComputableWindow
/- A finite decision procedure for the obstruction window. -/

namespace Bounty

def badWindow_iff_bounded (n : ℕ) :
    badWindow n ↔ ∃ j ∈ Finset.range (Nat.log 4 n + 1),
      ∃ b ∈ Finset.range (Nat.log 3 n + 1),
        4 ^ j ≤ n ∧ 4 * n < 5 * 4 ^ j ∧ 10 * 3 ^ b ≤ n ∧ n < 12 * 3 ^ b := by
  constructor
  · intro hn
    have hn0 : n ≠ 0 := by have := badWindow_ge_ten hn; omega
    obtain ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩ := hn
    have hj : j ≤ Nat.log 4 n := (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr h4lo
    have hb : b ≤ Nat.log 3 n :=
      (Nat.le_log_iff_pow_le (by norm_num) hn0).mpr (by omega)
    exact ⟨j, Finset.mem_range.mpr (by omega), b, Finset.mem_range.mpr (by omega),
      h4lo, h4hi, h3lo, h3hi⟩
  · rintro ⟨j, _, b, _, h4lo, h4hi, h3lo, h3hi⟩
    exact ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩

def badWindow_decidable (n : ℕ) : Decidable (badWindow n) :=
  decidable_of_iff
    (∃ j ∈ Finset.range (Nat.log 4 n + 1), ∃ b ∈ Finset.range (Nat.log 3 n + 1),
      4 ^ j ≤ n ∧ 4 * n < 5 * 4 ^ j ∧ 10 * 3 ^ b ≤ n ∧ n < 12 * 3 ^ b)
    (badWindow_iff_bounded n).symm

def quotaValue (eps : Bool) (u : ℚ) : ℕ :=
  letI := badWindow_decidable
  smoothRankBound ⌊u⌋₊ - if eps = true ∧ badWindow ⌊5 * u⌋₊ then 1 else 0

def quotaValue_eq (eps : Bool) (u : ℚ) : quotaValue eps u = rationalQuota eps u := by
  unfold quotaValue rationalQuota
  by_cases hh : eps = true ∧ badWindow ⌊5 * u⌋₊ <;> simp [hh]

end Bounty

end SubmissionComponent_ComputableWindow

/- Component RationalWindow; SHA256 fc6f9921cfc61e6dd3b976f94a8b5eb3871e61cd7531794cdd557224d3edd899 -/
section SubmissionComponent_RationalWindow
/- Rational cutoffs retain the strict endpoints required by the construction. -/

namespace Bounty

def rationalWindow (p : ℕ) (r : ℚ) : Set ℕ := cutoffWindow p ⌊r⌋₊

def rationalWindow_lower {p n : ℕ} {r : ℚ} (hn : n ∈ rationalWindow p r) :
    r < 6 * (n : ℚ) := by
  have hh : ⌊r⌋₊ < 6 * n := cutoffWindow_lower hn
  have hlt := Nat.lt_of_floor_lt hh
  exact_mod_cast hlt

def rationalWindow_eighth {p n : ℕ} {r u : ℚ}
    (hn : n ∈ rationalWindow p r) (hru : 3 * u ≤ 4 * r) : u < 8 * (n : ℚ) := by
  have hh := rationalWindow_lower hn
  linarith

def floor_scaled_le {r s : ℚ} (hs : 0 ≤ s) {d : ℕ} (hd : (d : ℚ) * s ≤ r) :
    d * ⌊s⌋₊ ≤ ⌊r⌋₊ := by
  have hr : 0 ≤ r := (mul_nonneg (Nat.cast_nonneg d) hs).trans hd
  apply (Nat.le_floor_iff hr).mpr
  push_cast
  exact (mul_le_mul_of_nonneg_left (Nat.floor_le hs) (Nat.cast_nonneg d)).trans hd

def rationalWindow_scaled_eighth {n q s p : ℕ} {r : ℚ} (hq : 0 < q)
    (hcut : 3 * ((n : ℚ) / q) ≤ 4 * r) (hs : s ∈ rationalWindow p r) : n < 8 * (q * s) := by
  have hsq := rationalWindow_eighth hs hcut
  have hmul := (div_lt_iff₀ (by exact_mod_cast hq : (0 : ℚ) < q)).mp hsq
  exact_mod_cast (by nlinarith : (n : ℚ) < 8 * ((q : ℚ) * s))

end Bounty

end SubmissionComponent_RationalWindow

/- Component CutoffLevels; SHA256 d5fec12465da57274832497430fd6445c0531c87ef263e82a296f7c981d1adc1 -/
section SubmissionComponent_CutoffLevels
/- Exact half-open intervals on which a cutoff window has prescribed size. -/

namespace Bounty

def cutoffCount_unbounded (p k : ℕ) : ∃ r, k ≤ cutoffCount p r := by
  by_cases hp : p = 0
  · refine ⟨3 ^ k, ?_⟩
    have hn : (3 : ℕ) ^ k ≠ 0 := by positivity
    simp only [cutoffCount, hp, ↓reduceIte, hn, Nat.log_pow (by norm_num : 1 < (3 : ℕ))]
    omega
  · refine ⟨2 * 3 ^ k, ?_⟩
    have hk : 0 < (3 : ℕ) ^ k := by positivity
    have hn : ¬2 * 3 ^ k < 2 := by omega
    have hdiv : (2 * 3 ^ k : ℕ) / 2 = 3 ^ k := by omega
    simp only [cutoffCount, hp, ↓reduceIte, hn, hdiv,
      Nat.log_pow (by norm_num : 1 < (3 : ℕ))]
    omega

noncomputable def lowerCutoff (p k : ℕ) : ℕ := Nat.find (cutoffCount_unbounded p k)

def lowerCutoff_spec (p k : ℕ) : k ≤ cutoffCount p (lowerCutoff p k) :=
  Nat.find_spec (cutoffCount_unbounded p k)

def lowerCutoff_le_iff (p k r : ℕ) : lowerCutoff p k ≤ r ↔ k ≤ cutoffCount p r := by
  constructor
  · intro hh
    exact (lowerCutoff_spec p k).trans (cutoffCount_mono p hh)
  · intro hh
    exact Nat.find_min' (cutoffCount_unbounded p k) hh

def lt_lowerCutoff_iff (p k r : ℕ) : r < lowerCutoff p k ↔ cutoffCount p r < k := by
  have hh := lowerCutoff_le_iff p k r
  omega

def cutoffCount_level_iff (p k r : ℕ) :
    cutoffCount p r = k ↔ lowerCutoff p k ≤ r ∧ r < lowerCutoff p (k + 1) := by
  rw [lowerCutoff_le_iff, lt_lowerCutoff_iff]
  omega

def cutoffCount_floor_level_iff (p k : ℕ) {r : ℚ} (hr : 0 ≤ r) :
    cutoffCount p ⌊r⌋₊ = k ↔ (lowerCutoff p k : ℚ) ≤ r ∧ r < lowerCutoff p (k + 1) := by
  rw [cutoffCount_level_iff, Nat.le_floor_iff hr, Nat.floor_lt hr]

end Bounty

end SubmissionComponent_CutoffLevels

/- Component CutoffRecursion; SHA256 08fe00aa39b943b9462552b350e5ad8b75eeb4b09779eaa98722b584170efac6 -/
section SubmissionComponent_CutoffRecursion
/- The candidate cutoff recursion; universal availability is still to be proved. -/

namespace Bounty

noncomputable def cutoffTrial (u : ℚ) (k p : ℕ) (c5 c7 : ℕ × ℚ) : ℚ :=
  max (max (3 * u / 4) (lowerCutoff p k : ℚ))
    (max ((if p = c5.1 then 4 else 6) * c5.2) ((if p = c7.1 then 4 else 6) * c7.2))

def cutoffAvailable (u : ℚ) (k p : ℕ) (c5 c7 : ℕ × ℚ) : Prop :=
  cutoffTrial u k p c5 c7 ≤ u ∧ cutoffTrial u k p c5 c7 < lowerCutoff p (k + 1)

noncomputable def cutoffAvailable_decidable (u : ℚ) (k p : ℕ) (c5 c7 : ℕ × ℚ) :
    Decidable (cutoffAvailable u k p c5 c7) := by
  unfold cutoffAvailable
  infer_instance

noncomputable def cutoffCandidate (eps : Bool) (u : ℚ) (c5 c7 : ℕ × ℚ) : ℕ × ℚ :=
  letI := cutoffAvailable_decidable
  let k := quotaValue eps u
  let preferred := Nat.log 2 ⌊u⌋₊ % 2
  let p := if cutoffAvailable u k preferred c5 c7 then preferred else 1 - preferred
  (p, cutoffTrial u k p c5 c7)

def floor_div_lt_floor {u : ℚ} {d : ℕ} (hu : 1 ≤ u) (hd : 1 < d) :
    ⌊u / d⌋₊ < ⌊u⌋₊ := by
  rw [Nat.floor_div_natCast]
  apply Nat.div_lt_self
  · exact (Nat.le_floor_iff (by linarith : 0 ≤ u)).mpr hu
  · exact hd

noncomputable def cutoffState (eps : Bool) (u : ℚ) : ℕ × ℚ :=
  if hu : u < 1 then (0, 0) else
    cutoffCandidate eps u (cutoffState true (u / 5)) (cutoffState eps (u / 7))
termination_by ⌊u⌋₊
decreasing_by
  · exact floor_div_lt_floor (d := 5) (by linarith) (by norm_num)
  · exact floor_div_lt_floor (d := 7) (by linarith) (by norm_num)

def cutoffTrial_bounds (u : ℚ) (k p : ℕ) (c5 c7 : ℕ × ℚ) :
    3 * u / 4 ≤ cutoffTrial u k p c5 c7 ∧
    (lowerCutoff p k : ℚ) ≤ cutoffTrial u k p c5 c7 ∧
    (if p = c5.1 then 4 else 6) * c5.2 ≤ cutoffTrial u k p c5 c7 ∧
    (if p = c7.1 then 4 else 6) * c7.2 ≤ cutoffTrial u k p c5 c7 := by
  unfold cutoffTrial
  exact ⟨(le_max_left _ _).trans (le_max_left _ _),
    (le_max_right _ _).trans (le_max_left _ _),
    (le_max_left _ _).trans (le_max_right _ _),
    (le_max_right _ _).trans (le_max_right _ _)⟩

def cutoffTrial_size {u : ℚ} {k p : ℕ} {c5 c7 : ℕ × ℚ}
    (hu : 0 ≤ u) (hvalid : cutoffAvailable u k p c5 c7) :
    cutoffCount p ⌊cutoffTrial u k p c5 c7⌋₊ = k := by
  have hh := cutoffTrial_bounds u k p c5 c7
  have hr : 0 ≤ cutoffTrial u k p c5 c7 := by linarith [hh.1]
  apply (cutoffCount_floor_level_iff p k hr).mpr
  exact ⟨hh.2.1, hvalid.2⟩

def cutoffCandidate_parity (eps : Bool) (u : ℚ) (c5 c7 : ℕ × ℚ) :
    (cutoffCandidate eps u c5 c7).1 < 2 := by
  unfold cutoffCandidate
  dsimp only
  split_ifs <;> omega

def cutoffCandidate_eq_trial (eps : Bool) (u : ℚ) (c5 c7 : ℕ × ℚ) :
    (cutoffCandidate eps u c5 c7).2 =
      cutoffTrial u (quotaValue eps u) (cutoffCandidate eps u c5 c7).1 c5 c7 := by
  unfold cutoffCandidate
  dsimp only

def cutoffState_of_small {eps : Bool} {u : ℚ} (hu : u < 1) : cutoffState eps u = (0, 0) := by
  rw [cutoffState, dif_pos hu]

def cutoffState_of_large {eps : Bool} {u : ℚ} (hu : 1 ≤ u) :
    cutoffState eps u = cutoffCandidate eps u (cutoffState true (u / 5)) (cutoffState eps (u / 7)) := by
  rw [cutoffState, dif_neg (by linarith)]

def cutoffState_parity (eps : Bool) (u : ℚ) : (cutoffState eps u).1 < 2 := by
  by_cases hu : u < 1
  · rw [cutoffState_of_small hu]
    norm_num
  · rw [cutoffState_of_large (le_of_not_gt hu)]
    exact cutoffCandidate_parity _ _ _ _

end Bounty

end SubmissionComponent_CutoffRecursion

/- Component CutoffBase; SHA256 92ba667e4f197efc465542c84024b066863a3afc820f9c082bf897aee13ad6d6 -/
section SubmissionComponent_CutoffBase
/- Initial rational intervals on which trial availability can be proved directly. -/

namespace Bounty

def lowerCutoff_eq_of_step {p k r : ℕ} (hr : 0 < r)
    (hlo : k ≤ cutoffCount p r) (hprev : cutoffCount p (r - 1) < k) :
    lowerCutoff p k = r := by
  have hh := (lowerCutoff_le_iff p k r).mpr hlo
  have hp := (lt_lowerCutoff_iff p k (r - 1)).mpr hprev
  omega

def badWindow_ge_270 {n : ℕ} (hn : badWindow n) : 0x10e ≤ n := by
  obtain ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩ := hn
  by_contra hsmall
  have hj : j < 5 := by
    by_contra hh
    have hp : (4 : ℕ) ^ 5 ≤ 4 ^ j := Nat.pow_le_pow_right (by norm_num) (by omega)
    norm_num at hp
    omega
  have hb : b < 3 := by
    by_contra hh
    have hp : (3 : ℕ) ^ 3 ≤ 3 ^ b := Nat.pow_le_pow_right (by norm_num) (by omega)
    norm_num at hp
    omega
  interval_cases j <;> interval_cases b <;> norm_num at * <;> omega

end Bounty

end SubmissionComponent_CutoffBase

