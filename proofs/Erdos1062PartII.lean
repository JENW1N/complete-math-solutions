section SubmissionComponent_NormalizedPairs
/- Normalized rules with arbitrary actual child states. -/

namespace Bounty

def cutoffAvailable_iff_normalized_pair {eps : Bool} {p : ℕ} (hp : p < 2)
    (c5 c7 : ℕ × ℚ) {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffAvailable (v * u) (quotaValue eps (v * u)) p c5 c7 ↔
      normalizedTrialAvailable eps p c5.1 c7.1 v
        ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
        ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u)
        (c5.2 / u) (c7.2 / u) := by
  have hh := cutoffAvailable_iff_normalizedTrial (eps := eps) hp c5.1 c7.1
    (c5.2 / u) (c7.2 / u) hu hv
  simpa only [div_mul_cancel₀ _ (ne_of_gt hu), Prod.eta] using hh

def cutoffProfileTrial_normalized_pair (eps : Bool) (p : ℕ) (c5 c7 : ℕ × ℚ)
    {u v : ℚ} (hu : 0 < u) (hv : 2 ≤ v * u) :
    cutoffProfileTrial eps (v * u) p c5 c7 / u =
      normalizedTrialValue eps p c5.1 c7.1 v
        ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
        ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u)
        (c5.2 / u) (c7.2 / u) := by
  have hh := cutoffProfileTrial_normalized eps p c5.1 c7.1 (c5.2 / u) (c7.2 / u) hu hv
  simp only [div_mul_cancel₀ _ (ne_of_gt hu), Prod.eta,
    cutoffDelta_normalized eps p hu hv] at hh
  exact hh

