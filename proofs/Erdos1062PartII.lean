/- Component NormalizedCounts; SHA256 cc30e10e0045906b45078bdb26cb5ee7dbf0f1a8355fd72b97ec0e3cb126c06f -/
section SubmissionComponent_NormalizedCounts
/- The two cutoff deficits, in the form used by the normalized closure. -/

namespace Bounty

def log_four_half_even {n : ℕ} (hn : 2 ≤ n)
    (hpar : Nat.log 2 n % 2 = 0) :
    Nat.log 4 (n / 2) + 1 = Nat.log 4 n := by
  have hlog : 1 ≤ Nat.log 2 n :=
    (Nat.le_log_iff_pow_le (by norm_num) (by omega : n ≠ 0)).mpr (by simpa using hn)
  rw [log_four_eq, log_four_eq, Nat.log_div_base]
  omega

def log_three_half_below {n : ℕ} (hn : 2 ≤ n)
    (htop : ¬2 * 3 ^ Nat.log 3 n ≤ n) :
    Nat.log 3 (n / 2) + 1 = Nat.log 3 n := by
  have hlog : 1 ≤ Nat.log 3 n := by
    by_contra hh
    have hz : Nat.log 3 n = 0 := by omega
    simp only [hz, pow_zero, mul_one] at htop
    omega
  have hb : Nat.log 3 n - 1 + 1 = Nat.log 3 n := by omega
  have hp := Nat.pow_log_le_self 3 (by omega : n ≠ 0)
  have hp' : 3 ^ (Nat.log 3 n - 1) * 3 ≤ n := by
    simpa only [← pow_succ, hb] using hp
  have he : Nat.log 3 (n / 2) = Nat.log 3 n - 1 := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · omega
    · rw [hb]
      omega
  omega

def log_two_odd_iff_four_threshold {n : ℕ} (hn : 0 < n) :
    Nat.log 2 n % 2 = 1 ↔ 2 * 4 ^ Nat.log 4 n ≤ n := by
  have power (j : ℕ) : (2 : ℕ) ^ (2 * j + 1) = 2 * 4 ^ j := by
    rw [pow_succ, pow_mul]
    norm_num
    omega
  have hlo := Nat.pow_log_le_self 2 (by omega : n ≠ 0)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < (2 : ℕ)) n
  rw [log_four_eq]
  by_cases hp : Nat.log 2 n % 2 = 1
  · have he : Nat.log 2 n = 2 * (Nat.log 2 n / 2) + 1 := by omega
    rw [he, power] at hlo
    exact iff_of_true hp hlo
  · have he : Nat.log 2 n + 1 = 2 * (Nat.log 2 n / 2) + 1 := by omega
    rw [Nat.succ_eq_add_one, he, power] at hhi
    exact iff_of_false hp (by omega)

def cutoffCount_zero_deficit {n : ℕ} (hn : 0 < n) :
    cutoffCount 0 n +
      (if Nat.log 2 n % 2 = 1 ∧ 2 * 3 ^ Nat.log 3 n ≤ n then 1 else 0) =
      smoothRankBound n := by
  simp [cutoffCount, smoothRankBound, Nat.ne_of_gt hn, log_four_eq]

def cutoffCount_one_deficit {n : ℕ} (hn : 2 ≤ n) :
    cutoffCount 1 n +
      (if ¬Nat.log 2 n % 2 = 1 ∧ ¬2 * 3 ^ Nat.log 3 n ≤ n then 1 else 0) =
      smoothRankBound n := by
  have hc : cutoffCount 1 n = Nat.log 3 (n / 2) + Nat.log 4 (n / 2) + 2 := by
    simp [cutoffCount, show ¬n < 2 by omega]
  have hr : smoothRankBound n = Nat.log 3 n + 1 + Nat.log 4 n +
      (if Nat.log 2 n % 2 = 1 ∧ 2 * 3 ^ Nat.log 3 n ≤ n then 1 else 0) := by
    simp [smoothRankBound, show n ≠ 0 by omega, log_four_eq]
  rw [hc, hr]
  by_cases hp : Nat.log 2 n % 2 = 1
  · have h4 := log_four_half_odd hp
    by_cases hd : 2 * 3 ^ Nat.log 3 n ≤ n
    · have h3 := log_three_half (by omega : 0 < n) hd
      simp only [hp, hd, and_self, not_true_eq_false, reduceIte]
      omega
    · have h3 := log_three_half_below hn hd
      simp only [hp, hd, and_false, not_true_eq_false, false_and, reduceIte]
      omega
  · have h4 := log_four_half_even hn (by omega)
    by_cases hd : 2 * 3 ^ Nat.log 3 n ≤ n
    · have h3 := log_three_half (by omega : 0 < n) hd
      simp only [hp, hd, false_and, not_true_eq_false, and_false, reduceIte]
      omega
    · have h3 := log_three_half_below hn hd
      simp only [hp, hd, not_false_eq_true, and_self, reduceIte]
      omega

def cutoffCount_zero_floor_deficit {u : ℚ} (hu : 1 ≤ u) :
    cutoffCount 0 ⌊u⌋₊ +
      (if 2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ≤ u ∧
          2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ u then 1 else 0) =
      smoothRankBound ⌊u⌋₊ := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 0 < ⌊u⌋₊ := by
    have hh : 1 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
    omega
  have hh := cutoffCount_zero_deficit hn
  simpa only [log_two_odd_iff_four_threshold hn, Nat.le_floor_iff hu0,
    Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] using hh

def cutoffCount_one_floor_deficit {u : ℚ} (hu : 2 ≤ u) :
    cutoffCount 1 ⌊u⌋₊ +
      (if ¬2 * (4 : ℚ) ^ Nat.log 4 ⌊u⌋₊ ≤ u ∧
          ¬2 * (3 : ℚ) ^ Nat.log 3 ⌊u⌋₊ ≤ u then 1 else 0) =
      smoothRankBound ⌊u⌋₊ := by
  have hu0 : 0 ≤ u := by linarith
  have hn : 2 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
  have hh := cutoffCount_one_deficit hn
  simpa only [log_two_odd_iff_four_threshold (by omega : 0 < ⌊u⌋₊),
    Nat.le_floor_iff hu0, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] using hh


end Bounty

end SubmissionComponent_NormalizedCounts

/- Component NormalizedLevels; SHA256 ce27accb82b45eddab5f148b265cc2842517defc56d50d7be12768d28eb2a147 -/
section SubmissionComponent_NormalizedLevels
/- Exact threshold locations needed for normalized cutoff trials. -/

namespace Bounty

def lowerCutoff_zero_at_count {n : ℕ} (hn : 0 < n) :
    lowerCutoff 0 (cutoffCount 0 n) =
      max (4 ^ Nat.log 4 n) (3 ^ Nat.log 3 n) := by
  let a := 4 ^ Nat.log 4 n
  let b := 3 ^ Nat.log 3 n
  have ha : a ≤ n := Nat.pow_log_le_self 4 (by omega)
  have hb : b ≤ n := Nat.pow_log_le_self 3 (by omega)
  have hab : max a b ≤ n := max_le ha hb
  have hpos : 0 < max a b := lt_of_lt_of_le (by dsimp [a]; positivity) (le_max_left _ _)
  have h4 : Nat.log 4 (max a b) = Nat.log 4 n := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · exact le_max_left _ _
    · exact lt_of_le_of_lt hab (Nat.lt_pow_succ_log_self (by norm_num) n)
  have h3 : Nat.log 3 (max a b) = Nat.log 3 n := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · exact le_max_right _ _
    · exact lt_of_le_of_lt hab (Nat.lt_pow_succ_log_self (by norm_num) n)
  have hc : cutoffCount 0 (max a b) = cutoffCount 0 n := by
    simp [cutoffCount, Nat.ne_of_gt hn, Nat.ne_of_gt hpos, h4, h3]
  apply le_antisymm
  · exact (lowerCutoff_le_iff _ _ _).mpr (le_of_eq hc.symm)
  · change max a b ≤ lowerCutoff 0 (cutoffCount 0 n)
    by_contra hh
    let r := lowerCutoff 0 (cutoffCount 0 n)
    have hr : r < max a b := by dsimp [r]; omega
    have hrn : r ≤ n := le_trans (Nat.le_of_lt hr) hab
    have hs : cutoffCount 0 n ≤ cutoffCount 0 r := lowerCutoff_spec _ _
    have hrpos : 0 < r := by
      by_contra hh
      have hz : r = 0 := by omega
      simp [cutoffCount, hz, Nat.ne_of_gt hn] at hs
    have h4le := Nat.log_mono_right (b := 4) hrn
    have h3le := Nat.log_mono_right (b := 3) hrn
    have hcount : Nat.log 3 n + 1 + Nat.log 4 n ≤ Nat.log 3 r + 1 + Nat.log 4 r := by
      simpa [cutoffCount, Nat.ne_of_gt hn, Nat.ne_of_gt hrpos] using hs
    have h4eq : Nat.log 4 n = Nat.log 4 r := by omega
    have h3eq : Nat.log 3 n = Nat.log 3 r := by omega
    have har : a ≤ r := by
      dsimp [a]
      rw [h4eq]
      exact Nat.pow_log_le_self _ (by omega)
    have hbr : b ≤ r := by
      dsimp [b]
      rw [h3eq]
      exact Nat.pow_log_le_self _ (by omega)
    have := max_le har hbr
    omega

def lowerCutoff_one_scale {k : ℕ} (hk : 2 ≤ k) :
    lowerCutoff 1 k = 2 * lowerCutoff 0 (k - 1) := by
  have equiv (r : ℕ) : k ≤ cutoffCount 1 r ↔ k - 1 ≤ cutoffCount 0 (r / 2) := by
    by_cases hr : r < 2
    · have hz : r / 2 = 0 := by omega
      simp [cutoffCount, hr, hz]
      omega
    · have hr0 : r / 2 ≠ 0 := by omega
      simp only [cutoffCount, one_ne_zero, reduceIte, hr, hr0]
      omega
  apply le_antisymm
  · apply (lowerCutoff_le_iff _ _ _).mpr
    rw [equiv]
    simpa using lowerCutoff_spec 0 (k - 1)
  · have h := (equiv (lowerCutoff 1 k)).mp (lowerCutoff_spec 1 k)
    have hh := (lowerCutoff_le_iff 0 (k - 1) (lowerCutoff 1 k / 2)).mpr h
    omega

def lowerCutoff_one_at_count {n : ℕ} (hn : 2 ≤ n) :
    lowerCutoff 1 (cutoffCount 1 n) =
      2 * max (4 ^ Nat.log 4 (n / 2)) (3 ^ Nat.log 3 (n / 2)) := by
  have hn0 : n / 2 ≠ 0 := by omega
  have hc : cutoffCount 1 n = cutoffCount 0 (n / 2) + 1 := by
    simp [cutoffCount, show ¬n < 2 by omega, hn0]
    omega
  have hk : 2 ≤ cutoffCount 1 n := by
    simp [cutoffCount, show ¬n < 2 by omega]
  rw [lowerCutoff_one_scale hk, hc, Nat.add_sub_cancel,
    lowerCutoff_zero_at_count (by omega)]


end Bounty

end SubmissionComponent_NormalizedLevels

