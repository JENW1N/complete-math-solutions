/- Component PolicyLinearClause; SHA256 ed38b741d2cf872a03c0e92ffd071c2fac5ec580ae6dba84d77409a7803affbc. -/
section PolicySubmissionPart22
/- Arithmetic implication certificates imply the actual signed SAT clauses. -/
namespace ClosureLinear
open ClosureSemantics Bounty

def implicationIncluded (premises : List ℕ) (conclusion : ℕ) (clause : List ℤ) : Bool :=
  decide (((conclusion + 1 : ℕ) : ℤ) ∈ clause) &&
    premises.all (fun i => decide (-((i + 1 : ℕ) : ℤ) ∈ clause))

def dense_positive_holds (values : Valuation) (i : ℕ) (h : (values i).b = true) :
    policySignedHolds (fun v => (values (v - 1)).b = true) ((i + 1 : ℕ) : ℤ) := by
  have hp : (0 : ℤ) < ((i + 1 : ℕ) : ℤ) := by omega
  simpa only [policySignedHolds, if_pos hp, Int.natAbs_natCast, Nat.add_sub_cancel] using h

def dense_negative_holds (values : Valuation) (i : ℕ) (h : (values i).b ≠ true) :
    policySignedHolds (fun v => (values (v - 1)).b = true) (-((i + 1 : ℕ) : ℤ)) := by
  have hp : ¬(0 : ℤ) < -((i + 1 : ℕ) : ℤ) := by omega
  simpa only [policySignedHolds, if_neg hp, Int.natAbs_neg, Int.natAbs_natCast,
    Nat.add_sub_cancel] using h

def implicationIncluded_sound (values : Valuation) (premises : List ℕ)
    (conclusion : ℕ) (clause : List ℤ)
    (hc : implicationIncluded premises conclusion clause = true)
    (h : (∀ i ∈ premises, (values i).b = true) → (values conclusion).b = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) clause := by
  classical
  have hp : (((conclusion + 1 : ℕ) : ℤ) ∈ clause) ∧
      ∀ i ∈ premises, -((i + 1 : ℕ) : ℤ) ∈ clause := by
    simpa [implicationIncluded, Bool.and_eq_true] using hc
  by_cases hm : ∀ i ∈ premises, (values i).b = true
  · exact ⟨_, hp.1, dense_positive_holds values conclusion (h hm)⟩
  · push Not at hm
    obtain ⟨i, hi, hv⟩ := hm
    exact ⟨_, hp.2 i hi, dense_negative_holds values i hv⟩

def checkImplicationClause (program : ℕ → Node) (ids : List ℕ) (integer : Bool)
    (fuel : ℕ) (premises : List ℕ) (conclusion : ℕ) (certs : List (List (ℕ × ℕ)))
    (clause : List ℤ) : Bool :=
  implicationIncluded premises conclusion clause &&
    checkImplication program ids integer fuel premises conclusion certs

def checkImplicationClause_sound (program : ℕ → Node) (ids : List ℕ) (integer : Bool)
    (input values : Valuation) (he : Equations program input values)
    (fuel : ℕ) (premises : List ℕ) (conclusion : ℕ) (certs : List (List (ℕ × ℕ)))
    (clause : List ℤ)
    (hc : checkImplicationClause program ids integer fuel premises conclusion certs clause = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) clause := by
  have hp : implicationIncluded premises conclusion clause = true ∧
      checkImplication program ids integer fuel premises conclusion certs = true := by
    simpa [checkImplicationClause, Bool.and_eq_true] using hc
  exact implicationIncluded_sound values premises conclusion clause hp.1
    (checkImplication_sound program ids integer input values he fuel premises conclusion certs hp.2)

end ClosureLinear

end PolicySubmissionPart22

/- Component PolicyLinearRecords; SHA256 3015b3ca06db8cd233f235e499a16993dae4a4e9e4896b710e8d43364ef16b85. -/
section PolicySubmissionPart23
/- Untrusted numerical records and bounded batches of arithmetic certificates. -/
namespace ClosureLinear
open ClosureSemantics Bounty

structure ArithmeticCertificate where
  integer : Bool
  fuel : ℕ
  conclusion : ℕ
  cuts : List ℕ
  premises : List ℕ
  weights : List (List (ℕ × ℕ))

def readNatList : List ℕ → Option (List ℕ × List ℕ)
  | [] => none
  | n :: xs => if n ≤ xs.length then some (xs.take n, xs.drop n) else none

def readWeightPairs : ℕ → List ℕ → Option (List (ℕ × ℕ) × List ℕ)
  | 0, xs => some ([], xs)
  | n + 1, i :: w :: xs => do
    let (rest, tail) ← readWeightPairs n xs
    pure ((i, w) :: rest, tail)
  | _, _ => none

def readWeightBranches : ℕ → List ℕ → Option (List (List (ℕ × ℕ)) × List ℕ)
  | 0, xs => some ([], xs)
  | n + 1, count :: xs => do
    let (weights, tail) ← readWeightPairs count xs
    let (rest, tail) ← readWeightBranches n tail
    pure (weights :: rest, tail)
  | _, _ => none

def decodeArithmeticCertificate : List ℕ → Option ArithmeticCertificate
  | mode :: fuel :: conclusion :: xs => do
    let (cuts, xs) ← readNatList xs
    let (premises, xs) ← readNatList xs
    match xs with
    | count :: xs =>
      let (weights, tail) ← readWeightBranches count xs
      match tail with
      | [] => pure ⟨mode == 1, fuel, conclusion, cuts, premises, weights⟩
      | _ => none
    | [] => none
  | _ => none

def checkArithmeticRecord (program : ℕ → Node) (clause : List ℤ) (record : List ℕ) : Bool :=
  match decodeArithmeticCertificate record with
  | none => false
  | some cert => checkImplicationClause program cert.cuts cert.integer cert.fuel
      cert.premises cert.conclusion cert.weights clause

def checkArithmeticRecord_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (clause : List ℤ) (record : List ℕ)
    (hc : checkArithmeticRecord program clause record = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) clause := by
  cases hd : decodeArithmeticCertificate record with
  | none => simp [checkArithmeticRecord, hd] at hc
  | some cert =>
    exact checkImplicationClause_sound program cert.cuts cert.integer input values he
      cert.fuel cert.premises cert.conclusion cert.weights clause
      (by simpa [checkArithmeticRecord, hd] using hc)

def checkArithmeticEntry (program : ℕ → Node) (clauses : ℕ → List ℤ) : List ℕ → Bool
  | [] => false
  | clauseId :: record => checkArithmeticRecord program (clauses clauseId) record

def checkArithmeticEntry_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (clauses : ℕ → List ℤ) (entry : List ℕ)
    (hc : checkArithmeticEntry program clauses entry = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true) (clauses (entry.headD 0)) := by
  cases entry with
  | nil => simp [checkArithmeticEntry] at hc
  | cons clauseId record =>
    exact checkArithmeticRecord_sound program input values he (clauses clauseId) record hc

def checkArithmeticBlock (program : ℕ → Node) (clauses : ℕ → List ℤ)
    (records : ℕ → List ℕ) (start count : ℕ) : Bool :=
  (List.range count).all fun i => checkArithmeticEntry program clauses (records (start + i))

def checkArithmeticBlock_sound (program : ℕ → Node) (input values : Valuation)
    (he : Equations program input values) (clauses : ℕ → List ℤ) (records : ℕ → List ℕ)
    (start count : ℕ) (hc : checkArithmeticBlock program clauses records start count = true)
    (i : ℕ) (hi : i < count) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true)
      (clauses ((records (start + i)).headD 0)) := by
  have h : ∀ j ∈ List.range count,
      checkArithmeticEntry program clauses (records (start + j)) = true := by
    simpa only [checkArithmeticBlock, List.all_eq_true] using hc
  exact checkArithmeticEntry_sound program input values he clauses (records (start + i))
    (h i (List.mem_range.mpr hi))

end ClosureLinear

end PolicySubmissionPart23

