/- Component OneFormReturnContradiction; SHA256 1e3c3fc81a0ee1d7e30ae7473371ddb2a5e8c698e2442b561064c48a5ca44f1a -/
section SubmissionComponent_OneFormReturnContradiction
/- The exact remaining arithmetic implication. The covering theorem is an
explicit hypothesis, not a proved theorem or an added axiom. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable section

def oneFormHeightFactor_of_exponential_bound {I : Type*} [Fintype I]
    (x : I → ℚ) (L : ℝ) (hH : Height.mulHeight x ≤ Real.exp (27 * L)) :
    Real.exp (-L / 0x190) ≤ oneFormHeightFactor x := by
  have hh := Real.rpow_le_rpow_of_nonpos (Height.mulHeight_pos x) hH
    (show -oneFormExponent ≤ 0 by norm_num [oneFormExponent])
  have he : Real.exp (27 * L) ^ (-oneFormExponent) = Real.exp (-L / 0x190) := by
    rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
    congr 1
    norm_num [oneFormExponent]
    ring
  simpa only [he, oneFormHeightFactor] using hh

def no_fixedReturnApproximation_of_oneForm_cover (hST : OneFormCover405) :
    ¬Nonempty FixedReturnApproximation := by
  rintro ⟨a⟩
  have hdim : Fintype.card (Fin a.dimension) + 1 ≤ 0x195 := by
    simpa only [Fintype.card_fin] using Nat.add_le_add_right a.dimension_upper 1
  obtain ⟨C, hC, hbound⟩ := oneForm_integer_rigidity hST hdim a.coefficient
  have hlarge : ∀ᶠ n in atTop, -0x190 * Real.log C < a.scale n :=
    a.scale_tendsto.eventually (eventually_gt_atTop _)
  have hpositive : ∀ᶠ n in atTop, 0 ≤ a.scale n :=
    a.scale_tendsto.eventually (eventually_ge_atTop _)
  obtain ⟨n, hn, hLn, hL0⟩ := (a.eventual_estimates.and (hlarge.and hpositive)).exists
  rcases hn with ⟨hLT, hu, hH, hne, herror⟩
  have hT0 : 0 ≤ a.cutoff n := hL0.trans hLT
  have htu : ∀ i, Real.exp (-a.cutoff n) ≤ |(a.unit n i : ℝ)| := by
    intro i
    rw [abs_of_pos (by exact_mod_cast a.unit_pos n i)]
    exact hu i
  have ht1 : Real.exp (-a.cutoff n) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    linarith
  have hlower := hbound (a.integerPart n) (a.unit n) (a.unit_twoThreeUnit n)
    (Real.exp (-a.cutoff n)) (Real.exp_pos _) ht1 htu hne
  have hvec : hyperplaneOptionVector ((a.integerPart n : ℤ) : ℚ) (a.unit n) =
      fixedApproximationVector (a.integerPart n) (a.unit n) := by
    funext i
    cases i <;> rfl
  rw [hvec] at hlower
  have hfac := oneFormHeightFactor_of_exponential_bound
    (fixedApproximationVector (a.integerPart n) (a.unit n)) (a.scale n) hH
  have he : C * Real.exp (-a.cutoff n) * Real.exp (-a.scale n / 0x190) ≤
      Real.exp (-a.cutoff n - a.scale n / 0xc8) := by
    exact (mul_le_mul_of_nonneg_left hfac (mul_nonneg hC.le (Real.exp_pos _).le)).trans
      (hlower.trans herror)
  have hexp : Real.exp (-a.cutoff n - a.scale n / 0xc8) =
      Real.exp (-a.scale n / 0x190) *
        (Real.exp (-a.cutoff n) * Real.exp (-a.scale n / 0x190)) := by
    rw [← Real.exp_add, ← Real.exp_add]
    congr 1
    ring
  rw [hexp, mul_assoc] at he
  have hsmall : C ≤ Real.exp (-a.scale n / 0x190) :=
    le_of_mul_le_mul_right he (mul_pos (Real.exp_pos _) (Real.exp_pos _))
  have hstrict : Real.exp (-a.scale n / 0x190) < C := by
    rw [← Real.exp_log hC]
    apply Real.exp_lt_exp.mpr
    linarith
  exact (not_lt_of_ge hsmall) hstrict

def irrational_explicitDensity_of_oneForm_cover (hST : OneFormCover405) :
    Irrational explicitDensity := by
  by_contra h
  exact no_fixedReturnApproximation_of_oneForm_cover hST
    (rational_density_fixed_return_approximation h)

def target_of_oneForm_cover (hST : OneFormCover405) :
    fcTypeOfName% "Erdos1062.erdos_1062.parts.ii" := by
  exact target_iff_irrational_explicitDensity.mpr
    (irrational_explicitDensity_of_oneForm_cover hST)

/-- The remaining theorem can be stated using integer vectors alone. -/
def IntegerOneFormCover405 : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I],
    2 ≤ Fintype.card I → Fintype.card I ≤ 0x195 →
    ∀ (d : I → ℚ) (k : I), d k ≠ 0 →
    ∃ F : Finset (I → ℚ), (∀ a ∈ F, a ≠ 0) ∧
      ∀ x : I → ℤ, x ≠ 0 →
        (twoThreeOneFormProduct d (fun i => (x i : ℚ)) k : ℝ) <
          oneFormHeightFactor (fun i => (x i : ℚ)) →
        ∃ a ∈ F, (∑ i, a i * (x i : ℚ)) = 0

def oneForm_cover_of_integer_cover (h : IntegerOneFormCover405) : OneFormCover405 := by
  intro I instF instD hmin hmax d k hdk
  obtain ⟨F, hF, hcover⟩ := h I hmin hmax d k hdk
  refine ⟨F, hF, ?_⟩
  intro x hx hne hsmall
  exact oneForm_integer_cover_to_sInteger d k oneFormExponent F hcover x hx hne hsmall

def target_of_integer_oneForm_cover (h : IntegerOneFormCover405) :
    fcTypeOfName% "Erdos1062.erdos_1062.parts.ii" :=
  target_of_oneForm_cover (oneForm_cover_of_integer_cover h)


