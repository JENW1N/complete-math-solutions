namespace Bounty

def cutoffCount_one_ge_three {n : ℕ} (hn : 6 ≤ n) :
    3 ≤ cutoffCount 1 n := by
  have hh : 3 ≤ n / 2 := by omega
  have hlog : 1 ≤ Nat.log 3 (n / 2) :=
    (Nat.le_log_iff_pow_le (by norm_num) (by omega : n / 2 ≠ 0)).mpr (by simpa using hh)
  simp [cutoffCount, show ¬n < 2 by omega]
  omega

