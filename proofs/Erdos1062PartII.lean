/- Packed base-64 digits of finite numerical certificate data. -/
namespace CompactNatData

def step (state : List Nat × Nat × Nat) (d : Nat) : List Nat × Nat × Nat :=
  let value := state.2.1 + d % 32 * state.2.2
  if d < 32 then (value :: state.1, 0, 1)
  else (state.1, value, state.2.2 * 32)

def read : Nat → Nat → (List Nat × Nat × Nat) → (List Nat × Nat × Nat)
  | 0, _, state => state
  | fuel + 1, packed, state => read fuel (packed / 64) (step state (packed % 64))

def decode (digits packed : Nat) : List Nat :=
  (read digits packed ([], 0, 1)).1.reverse

end CompactNatData

