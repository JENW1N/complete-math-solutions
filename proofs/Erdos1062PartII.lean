def baseIvlLo {L lo u : ℚ} (h : lo ≤ L) (hu : L ≤ u) : lo ≤ u := le_trans h hu

def baseIvlHi {H hi u : ℚ} (h : H ≤ hi) (hu : u < H) : u < hi := lt_of_lt_of_le hu h

def baseIvlLo5 {L lo u : ℚ} (h : lo * 5 ≤ L) (hu : L ≤ u) : lo ≤ u / 5 :=
  (le_div_iff₀ (by norm_num)).2 (le_trans h hu)

def baseIvlHi5 {H hi u : ℚ} (h : H ≤ hi * 5) (hu : u < H) : u / 5 < hi :=
  (div_lt_iff₀ (by norm_num)).2 (lt_of_lt_of_le hu h)

def baseIvlLo7 {L lo u : ℚ} (h : lo * 7 ≤ L) (hu : L ≤ u) : lo ≤ u / 7 :=
  (le_div_iff₀ (by norm_num)).2 (le_trans h hu)

def baseIvlHi7 {H hi u : ℚ} (h : H ≤ hi * 7) (hu : u < H) : u / 7 < hi :=
  (div_lt_iff₀ (by norm_num)).2 (lt_of_lt_of_le hu h)

