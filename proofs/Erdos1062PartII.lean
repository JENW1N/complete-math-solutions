/- Component ClosureAliasCheck; SHA256 ca109b348bb954ac0598042ad2551ff362ad46be27a436f642f05bb85c06b72a. -/
section PolicySubmissionPart85
/- Reflect closed alias-node lookups without expanding them in the elaborator. -/
namespace ClosureAliasCheck
open ClosureSemantics

def check (node : Node) (target : Nat) : Bool :=
  match node.op with
  | .alias => decide (node.children = [target])
  | _ => false

def sound (node : Node) (target : Nat) (h : check node target = true) :
    node = ⟨.alias, [target]⟩ := by
  cases node with
  | mk op children => cases op <;> simp_all [check]

end ClosureAliasCheck

