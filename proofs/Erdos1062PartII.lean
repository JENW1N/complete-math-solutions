/- Component ClosureProgram; SHA256 ccc83efd3f39b3af359c3e2b79d8bf1099c1ba872c816d046800b14491d4526c. -/
section PolicySubmissionPart26
/- A total DAG program with backward references, for arbitrary decoded data. -/
namespace ClosureSemantics

def boundedNode (i : Nat) (node : Node) : Node :=
  ⟨node.op, node.children.filter (fun j => decide (j < i))⟩

def boundedProgram (raw : Nat → Node) (i : Nat) : Node := boundedNode i (raw i)

def boundedProgram_children (raw : Nat → Node) (i j : Nat)
    (h : j ∈ (boundedProgram raw i).children) : j < i := by
  have hh : j ∈ (raw i).children ∧ decide (j < i) = true := by
    simpa only [boundedProgram, boundedNode, List.mem_filter] using h
  exact of_decide_eq_true hh.2

def programModel (raw : Nat → Node) (input : Valuation) : Valuation :=
  interpret (boundedProgram raw) input

def programModel_equations (raw : Nat → Node) (input : Valuation) :
    Equations (boundedProgram raw) input (programModel raw input) := by
  exact interpret_equations (boundedProgram raw) input
    (fun i j h => boundedProgram_children raw i j h)

def boundedProgram_eq (raw : Nat → Node) (i : Nat)
    (h : ∀ j ∈ (raw i).children, j < i) : boundedProgram raw i = raw i := by
  unfold boundedProgram boundedNode
  have hh : (raw i).children.filter (fun j => decide (j < i)) = (raw i).children := by
    apply List.filter_eq_self.mpr
    intro j hj
    exact decide_eq_true (h j hj)
  rw [hh]

end ClosureSemantics

end PolicySubmissionPart26

/- Component ClosurePackedProgram; SHA256 968044345330c011b1c6e55075d6d865bd5d48b86e1f663877c1f945ac329c7f. -/
section PolicySubmissionPart27
/- Typed expression nodes decoded from finite numerical records. -/
namespace ClosurePackedProgram
open ClosureSemantics

def signed (n : Nat) : Int :=
  if n % 2 = 0 then Int.ofNat (n / 2) else -(Int.ofNat (n / 2)) - 1

def decodeNode (i : Nat) : List Nat → Node
  | [] => ⟨.bConst false, []⟩
  | 0 :: _ => ⟨.bConst false, []⟩
  | 1 :: _ => ⟨.bConst true, []⟩
  | 2 :: k :: _ => ⟨.input k, []⟩
  | 3 :: num :: den :: _ => ⟨.qConst ((signed num : Rat) / (den : Rat)), []⟩
  | 4 :: n :: _ => ⟨.zConst (signed n), []⟩
  | op :: args =>
      let children := args.map (fun d => i - d)
      let tag := match op with
        | 5 => Op.alias | 6 => Op.bNot | 7 => Op.bOr | 8 => Op.bAnd
        | 9 => Op.bEq | 10 => Op.ite | 11 => Op.qEq | 12 => Op.zEq
        | 13 => Op.qLe | 14 => Op.zLe | 15 => Op.qLt | 16 => Op.zLt
        | 17 => Op.qAdd | 18 => Op.zAdd | 19 => Op.qMul | 20 => Op.zMul
        | 21 => Op.qNeg | 22 => Op.zNeg | 23 => Op.qSub | 24 => Op.zSub
        | 25 => Op.qDiv | _ => Op.bConst false
      ⟨tag, children⟩

def raw (t : PackedNatTable.Table PackedNatTable.Block) (i : Nat) : Node :=
  decodeNode i (PackedNatTable.records t i)

end ClosurePackedProgram

end PolicySubmissionPart27

/- Component ClosureFixedWidthProgram; SHA256 2bcad5c1fc11db1c8f491f610a7d042edf5f71cea5d3b1344d488811f63e40c5. -/
section PolicySubmissionPart28
/- Direct bit-field decoding of typed expression nodes. -/
namespace ClosureFixedWidthProgram
open ClosureSemantics PackedNatTable

def children (i width : Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | count + 1, packed =>
      (i - (packed &&& ((1 <<< width) - 1))) ::
        children i width count (packed >>> width)

def decodeNode (i bits packed : Nat) : Node :=
  let op := packed &&& 31
  let payload := packed >>> 5
  if op = 0 then ⟨.bConst false, []⟩
  else if op = 1 then ⟨.bConst true, []⟩
  else if op = 2 then ⟨.input payload, []⟩
  else if op = 3 then
    ⟨.qConst ((ClosurePackedProgram.signed (payload &&& 0xffffff) : Rat) /
      ((payload >>> 24) : Rat)), []⟩
  else if op = 4 then ⟨.zConst (ClosurePackedProgram.signed payload), []⟩
  else
    let width := (payload &&& 15) + 1
    let args := children i width ((bits - 9) / width) (payload >>> 4)
    let tag := match op with
      | 5 => Op.alias | 6 => Op.bNot | 7 => Op.bOr | 8 => Op.bAnd
      | 9 => Op.bEq | 10 => Op.ite | 11 => Op.qEq | 12 => Op.zEq
      | 13 => Op.qLe | 14 => Op.zLe | 15 => Op.qLt | 16 => Op.zLt
      | 17 => Op.qAdd | 18 => Op.zAdd | 19 => Op.qMul | 20 => Op.zMul
      | 21 => Op.qNeg | 22 => Op.zNeg | 23 => Op.qSub | 24 => Op.zSub
      | 25 => Op.qDiv | _ => Op.bConst false
    ⟨tag, args⟩

def getNode (b : Block) (slot i : Nat) : Node :=
  let first := b.start slot
  let bits := b.start (slot + 1) - first
  let packed := (b.data >>> first) &&& ((1 <<< bits) - 1)
  decodeNode i bits packed

def raw (t : Table Block) (i : Nat) : Node :=
  getNode (t.get emptyBlock (i / 32)) (i % 32) i

end ClosureFixedWidthProgram

end PolicySubmissionPart28

