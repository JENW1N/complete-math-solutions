/- Component LatticeProjection; SHA256 d1a0038da17b12bf8f0006e6161546b542b4e9e016d1186f40f694cefe606fe7 -/
section SubmissionComponent_LatticeProjection
/- Rounded lifts under projection away from one lattice vector. The proofs
give finite bounded intersections of the projected lattice, the primitive
kernel for a shortest vector, and the quantitative projected norm gap. -/

namespace Bounty
noncomputable section
open scoped InnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def latticeProjection (v : E) : E →L[ℝ] E := (ℝ ∙ v)ᗮ.starProjection

def latticeProjectionCoefficient (v x : E) : ℝ := inner ℝ v x / ‖v‖ ^ 2

def roundedLatticeLift (v x : E) : E :=
  x - (round (latticeProjectionCoefficient v x)) • v

def projectedLattice (L : Submodule ℤ E) (v : E) : Submodule ℤ E :=
  L.map ((latticeProjection v).toLinearMap.restrictScalars ℤ)

def latticeProjection_self (v : E) : latticeProjection v v = 0 :=
  Submodule.starProjection_orthogonalComplement_singleton_eq_zero v

def latticeProjection_eq (v x : E) :
    latticeProjection v x = x - latticeProjectionCoefficient v x • v := by
  rw [latticeProjection, Submodule.starProjection_orthogonal_val,
    Submodule.starProjection_singleton]
  rfl

def latticeProjection_inner (v x : E) : inner ℝ (latticeProjection v x) v = 0 := by
  apply Submodule.mem_orthogonal_singleton_iff_inner_left.mp
  exact Submodule.starProjection_apply_mem _ _

def roundedLatticeLift_mem (L : Submodule ℤ E) {v x : E}
    (hv : v ∈ L) (hx : x ∈ L) : roundedLatticeLift v x ∈ L :=
  L.sub_mem hx (L.smul_mem _ hv)

def latticeProjection_roundedLatticeLift (v x : E) :
    latticeProjection v (roundedLatticeLift v x) = latticeProjection v x := by
  simp only [roundedLatticeLift, map_sub, map_zsmul, latticeProjection_self,
    smul_zero, sub_zero]

def roundedLatticeLift_eq (v x : E) :
    roundedLatticeLift v x = latticeProjection v x +
      (latticeProjectionCoefficient v x - (round (latticeProjectionCoefficient v x) : ℝ)) • v := by
  rw [roundedLatticeLift, latticeProjection_eq, sub_smul, Int.cast_smul_eq_zsmul]
  abel

def roundedLatticeLift_norm_le (v x : E) :
    ‖roundedLatticeLift v x‖ ≤ ‖latticeProjection v x‖ + ‖v‖ / 2 := by
  rw [roundedLatticeLift_eq]
  apply (norm_add_le _ _).trans
  apply add_le_add_right
  rw [norm_smul, Real.norm_eq_abs]
  have hh := mul_le_mul_of_nonneg_right
    (abs_sub_round (latticeProjectionCoefficient v x)) (norm_nonneg v)
  nlinarith

def roundedLatticeLift_norm_sq (v x : E) :
    ‖roundedLatticeLift v x‖ ^ 2 = ‖latticeProjection v x‖ ^ 2 +
      (latticeProjectionCoefficient v x - (round (latticeProjectionCoefficient v x) : ℝ)) ^ 2 * ‖v‖ ^ 2 := by
  rw [roundedLatticeLift_eq]
  have horth : inner ℝ (latticeProjection v x)
      ((latticeProjectionCoefficient v x - (round (latticeProjectionCoefficient v x) : ℝ)) • v) = 0 := by
    rw [inner_smul_right, latticeProjection_inner, mul_zero]
  have hh := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth
  simpa only [← sq, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs] using hh

def roundedLatticeLift_norm_sq_le (v x : E) :
    ‖roundedLatticeLift v x‖ ^ 2 ≤ ‖latticeProjection v x‖ ^ 2 + ‖v‖ ^ 2 / 4 := by
  rw [roundedLatticeLift_norm_sq]
  have habs := abs_sub_round (latticeProjectionCoefficient v x)
  have hs : (latticeProjectionCoefficient v x -
      (round (latticeProjectionCoefficient v x) : ℝ)) ^ 2 ≤ (1 / 4 : ℝ) := by
    rcases abs_le.mp habs with ⟨hl, hu⟩
    nlinarith
  have hh := mul_le_mul_of_nonneg_right hs (sq_nonneg ‖v‖)
  linarith

/-- No primitivity or shortest-vector assumption is needed for finite bounded
intersections of the image under projection along a lattice vector. -/
def projectedLattice_finite_inter [FiniteDimensional ℝ E] (L : Submodule ℤ E) [DiscreteTopology L]
    {v : E} (hv : v ∈ L) {s : Set E} (hs : Bornology.IsBounded s) :
    Set.Finite (s ∩ (projectedLattice L v : Set E)) := by
  obtain ⟨R, hR⟩ := hs.exists_norm_le
  have hclosed : IsClosed (L : Set E) :=
    AddSubgroup.isClosed_of_discrete (H := L.toAddSubgroup)
  have hfinite : Set.Finite ((Metric.closedBall (0 : E) (R + ‖v‖ / 2)) ∩ (L : Set E)) :=
    Metric.finite_isBounded_inter_isClosed DiscreteTopology.isDiscrete
      Metric.isBounded_closedBall hclosed
  apply (hfinite.image (latticeProjection v)).subset
  rintro y ⟨hy, hyL⟩
  obtain ⟨x, hx, hxy⟩ := hyL
  change latticeProjection v x = y at hxy
  refine ⟨roundedLatticeLift v x, ⟨?_, roundedLatticeLift_mem L hv hx⟩, ?_⟩
  · rw [Metric.mem_closedBall, dist_zero_right]
    exact (roundedLatticeLift_norm_le v x).trans (by rw [hxy]; linarith [hR y hy])
  · rw [latticeProjection_roundedLatticeLift, hxy]

/-- Projecting along any lattice vector has a discrete image. -/
def projectedLattice_discreteTopology [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] {v : E} (hv : v ∈ L) :
    DiscreteTopology (projectedLattice L v) := by
  have hfin := projectedLattice_finite_inter L hv
    (s := Metric.closedBall (0 : E) 1) Metric.isBounded_closedBall
  have hpre := Set.Finite.preimage
    (f := (Subtype.val : projectedLattice L v → E)) Subtype.val_injective.injOn hfin
  have hball : Set.Finite (Metric.closedBall (0 : projectedLattice L v) 1) := by
    rw [show Metric.closedBall (0 : projectedLattice L v) 1 =
      {x : projectedLattice L v | ‖(x : E)‖ ≤ 1} by ext x; simp]
    simpa [Set.preimage, Metric.mem_closedBall, dist_zero_right] using hpre
  exact discreteTopology_iff_isOpen_singleton_zero.mpr
    (isOpen_singleton_of_finite_mem_nhds 0 (Metric.closedBall_mem_nhds _ (by norm_num)) hball)

/-- A shortest nonzero vector is obtained by minimizing on a finite ball. -/
def exists_shortest_lattice_vector [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] (hL : ∃ x ∈ L, x ≠ 0) :
    ∃ v ∈ L, v ≠ 0 ∧ ∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖ := by
  obtain ⟨x₀, hx₀, hx₀ne⟩ := hL
  have hclosed : IsClosed (L : Set E) :=
    AddSubgroup.isClosed_of_discrete (H := L.toAddSubgroup)
  have hfinite : Set.Finite (Metric.closedBall (0 : E) ‖x₀‖ ∩ (L : Set E)) :=
    Metric.finite_isBounded_inter_isClosed DiscreteTopology.isDiscrete
      Metric.isBounded_closedBall hclosed
  let s : Set E := (Metric.closedBall 0 ‖x₀‖ ∩ (L : Set E)) \ {0}
  have hs : s.Finite := hfinite.subset (by intro x hx; exact hx.1)
  have hx₀s : x₀ ∈ s := by
    exact ⟨⟨by simp, hx₀⟩, hx₀ne⟩
  obtain ⟨v, hv, hmin⟩ := Set.exists_min_image s (fun x => ‖x‖) hs ⟨x₀, hx₀s⟩
  refine ⟨v, hv.1.2, hv.2, ?_⟩
  intro x hx hxne
  by_cases hball : ‖x‖ ≤ ‖x₀‖
  · exact hmin x ⟨⟨by simpa using hball, hx⟩, hxne⟩
  · exact (hmin x₀ hx₀s).trans (le_of_lt (lt_of_not_ge hball))

/-- The exact primitive-kernel identity, deduced from shortestness by rounding. -/
def shortest_latticeProjection_eq_zero_iff (L : Submodule ℤ E) {v : E}
    (hvL : v ∈ L) (hv : v ≠ 0)
    (hshort : ∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖) {x : E} (hx : x ∈ L) :
    latticeProjection v x = 0 ↔ ∃ z : ℤ, z • v = x := by
  constructor
  · intro hz
    have hred : roundedLatticeLift v x = 0 := by
      by_contra hne
      have hmin := hshort _ (roundedLatticeLift_mem L hvL hx) hne
      have hnorm := roundedLatticeLift_norm_le v x
      rw [hz, norm_zero, zero_add] at hnorm
      have hvpos := norm_pos_iff.mpr hv
      linarith
    exact ⟨round (latticeProjectionCoefficient v x), (sub_eq_zero.mp hred).symm⟩
  · rintro ⟨z, rfl⟩
    simp [latticeProjection_self]

/-- The quantitative gap proves discreteness of the projected lattice before
choosing its own shortest vector. -/
def shortest_latticeProjection_norm_sq_gap (L : Submodule ℤ E) {v : E}
    (hvL : v ∈ L) (hshort : ∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖)
    {x : E} (hx : x ∈ L) (hproj : latticeProjection v x ≠ 0) :
    (3 / 4 : ℝ) * ‖v‖ ^ 2 ≤ ‖latticeProjection v x‖ ^ 2 := by
  have hred : roundedLatticeLift v x ≠ 0 := by
    intro hz
    apply hproj
    rw [← latticeProjection_roundedLatticeLift v x, hz, map_zero]
  have hmin := hshort _ (roundedLatticeLift_mem L hvL hx) hred
  have hsq := sq_le_sq₀ (norm_nonneg v) (norm_nonneg (roundedLatticeLift v x)) |>.mpr hmin
  have hbound := roundedLatticeLift_norm_sq_le v x
  linarith


end
end Bounty

end SubmissionComponent_LatticeProjection

/- Component ProjectedLatticeBasis; SHA256 054a2e44111522bfdd82c84aca2e9eb48fdf0c0dda3054fedb8cc4ba671a7560 -/
section SubmissionComponent_ProjectedLatticeBasis
/- Projection into the actual orthogonal-complement subtype, and integer
basis lifting using the shortest-vector kernel rather than a PID quotient. -/

namespace Bounty
noncomputable section
open scoped InnerProductSpace BigOperators
open Module

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def latticeProjectionToOrthogonal (v : E) : E →ₗ[ℤ] (ℝ ∙ v)ᗮ :=
  (ℝ ∙ v)ᗮ.orthogonalProjectionOnto.toLinearMap.restrictScalars ℤ

def orthogonalProjectedLattice (L : Submodule ℤ E) (v : E) :
    Submodule ℤ (ℝ ∙ v)ᗮ := L.map (latticeProjectionToOrthogonal v)

def latticeProjectionMap (L : Submodule ℤ E) (v : E) :
    L →ₗ[ℤ] orthogonalProjectedLattice L v :=
  ((latticeProjectionToOrthogonal v).comp L.subtype).codRestrict _
    (fun x => ⟨x, x.property, rfl⟩)

def latticeProjectionMap_self (L : Submodule ℤ E) {v : E} (hv : v ∈ L) :
    latticeProjectionMap L v ⟨v, hv⟩ = 0 := by
  apply Subtype.ext
  apply Subtype.ext
  exact latticeProjection_self v

def latticeProjectionMap_surjective (L : Submodule ℤ E) (v : E) :
    Function.Surjective (latticeProjectionMap L v) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, hx, hxy⟩ := hy
  exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩

def orthogonalProjectedLattice_discreteTopology [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] {v : E} (hv : v ∈ L) :
    DiscreteTopology (orthogonalProjectedLattice L v) := by
  let _ := projectedLattice_discreteTopology L hv
  let f : orthogonalProjectedLattice L v → projectedLattice L v := fun y =>
    ⟨((y : (ℝ ∙ v)ᗮ) : E), by
      obtain ⟨x, hx, hxy⟩ := y.property
      exact ⟨x, hx, congrArg Subtype.val hxy⟩⟩
  have hf : Continuous f := by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.comp continuous_subtype_val
  apply DiscreteTopology.of_continuous_injective hf
  intro x y h
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg (fun z : projectedLattice L v => (z : E)) h

def orthogonalProjectedLattice_span (L : Submodule ℤ E) (v : E)
    (hspan : Submodule.span ℝ (L : Set E) = ⊤) :
    Submodule.span ℝ (orthogonalProjectedLattice L v : Set (ℝ ∙ v)ᗮ) = ⊤ := by
  have himage : (orthogonalProjectedLattice L v : Set (ℝ ∙ v)ᗮ) =
      (ℝ ∙ v)ᗮ.orthogonalProjectionOnto '' (L : Set E) := rfl
  rw [himage]
  change Submodule.span ℝ ((ℝ ∙ v)ᗮ.orthogonalProjectionOnto.toLinearMap '' (L : Set E)) = ⊤
  rw [← Submodule.map_span, hspan, Submodule.map_top]
  apply LinearMap.range_eq_top.mpr
  intro y
  exact ⟨y, Submodule.orthogonalProjectionOnto_mem_subspace_eq_self y⟩

def orthogonalProjectedLattice_isZLattice (L : Submodule ℤ E) (v : E)
    [DiscreteTopology (orthogonalProjectedLattice L v)]
    (hspan : Submodule.span ℝ (L : Set E) = ⊤) :
    IsZLattice ℝ (orthogonalProjectedLattice L v) :=
  ⟨orthogonalProjectedLattice_span L v hspan⟩

/-- A lift with both the projection and the half-unit reduction coefficient explicit. -/
def exists_rounded_orthogonal_lift (L : Submodule ℤ E) {v : E} (hv : v ∈ L)
    (y : orthogonalProjectedLattice L v) :
    ∃ x : L, latticeProjectionMap L v x = y ∧
      ∃ a : ℝ, |a| ≤ 1 / 2 ∧
        (x : E) = ((y : (ℝ ∙ v)ᗮ) : E) + a • v ∧
        ‖(x : E)‖ ^ 2 ≤ ‖((y : (ℝ ∙ v)ᗮ) : E)‖ ^ 2 + ‖v‖ ^ 2 / 4 := by
  obtain ⟨z, hz⟩ := latticeProjectionMap_surjective L v y
  have hze : latticeProjection v (z : E) = ((y : (ℝ ∙ v)ᗮ) : E) :=
    congrArg (fun q : orthogonalProjectedLattice L v => ((q : (ℝ ∙ v)ᗮ) : E)) hz
  refine ⟨⟨roundedLatticeLift v z, roundedLatticeLift_mem L hv z.property⟩, ?_,
    latticeProjectionCoefficient v z - (round (latticeProjectionCoefficient v z) : ℝ),
    abs_sub_round _, ?_, ?_⟩
  · apply Subtype.ext
    apply Subtype.ext
    change latticeProjection v (roundedLatticeLift v z) = _
    rw [latticeProjection_roundedLatticeLift, hze]
  · exact (roundedLatticeLift_eq v z).trans (by rw [hze])
  · simpa only [hze] using roundedLatticeLift_norm_sq_le v z

/-- Any chosen lifts of a projected basis, together with a shortest vector,
form an integer basis. No assertion about a PID quotient is assumed. -/
def exists_lattice_basis_of_projection_lifts (L : Submodule ℤ E) {v : E}
    (hvL : v ∈ L) (hv : v ≠ 0)
    (hshort : ∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖) {n : ℕ}
    (b : Basis (Fin n) ℤ (orthogonalProjectedLattice L v))
    (u : Fin n → L) (hu : ∀ i, latticeProjectionMap L v (u i) = b i) :
    ∃ B : Basis (Fin (n + 1)) ℤ L,
      B 0 = ⟨v, hvL⟩ ∧ ∀ i : Fin n, B i.succ = u i := by
  classical
  let w : Fin (n + 1) → L := Fin.cons ⟨v, hvL⟩ u
  have hli : LinearIndependent ℤ w := by
    apply Fintype.linearIndependent_iff.mpr
    intro c hc i
    have hp := congrArg (latticeProjectionMap L v) hc
    simp only [map_sum, map_smul, map_add, map_zero, Fin.sum_univ_succ, w,
      Fin.cons_zero, Fin.cons_succ, latticeProjectionMap_self, hu, smul_zero, zero_add] at hp
    have htail (j : Fin n) : c j.succ = 0 :=
      Fintype.linearIndependent_iff.mp b.linearIndependent _ hp j
    have hz : c 0 • (⟨v, hvL⟩ : L) = 0 := by
      simpa only [Fin.sum_univ_succ, w, Fin.cons_zero, Fin.cons_succ,
        htail, zero_smul, Finset.sum_const_zero, add_zero] using hc
    have hzero : c 0 = 0 := by
      have hzE : (c 0 : ℝ) • v = 0 := by
        rw [Int.cast_smul_eq_zsmul]
        exact congrArg Subtype.val hz
      have hzR : (c 0 : ℝ) = 0 := (smul_eq_zero.mp hzE).resolve_right hv
      exact_mod_cast hzR
    exact Fin.cases hzero htail i
  have hsp : ⊤ ≤ Submodule.span ℤ (Set.range w) := by
    intro x _
    let z : L := ∑ i : Fin n, b.repr (latticeProjectionMap L v x) i • u i
    have hz : latticeProjectionMap L v z = latticeProjectionMap L v x := by
      dsimp only [z]
      rw [map_sum]
      simp only [map_smul, hu]
      exact b.sum_repr _
    have hp : latticeProjectionMap L v (x - z) = 0 := by rw [map_sub, hz, sub_self]
    have hpe : latticeProjection v ((x - z : L) : E) = 0 :=
      congrArg (fun y : orthogonalProjectedLattice L v => ((y : (ℝ ∙ v)ᗮ) : E)) hp
    obtain ⟨a, ha⟩ := (shortest_latticeProjection_eq_zero_iff L hvL hv hshort
      (x - z).property).mp hpe
    have hxrep : x = a • (⟨v, hvL⟩ : L) + z := by
      apply Subtype.ext
      change (x : E) = a • v + (z : E)
      change a • v = (x : E) - (z : E) at ha
      exact (sub_eq_iff_eq_add).mp ha.symm
    rw [hxrep]
    apply Submodule.add_mem
    · exact Submodule.smul_mem _ a (Submodule.subset_span ⟨0, rfl⟩)
    · apply Submodule.sum_mem
      intro i _
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i.succ, rfl⟩)
  let B := Basis.mk hli hsp
  refine ⟨B, ?_, ?_⟩
  · exact congrFun (Basis.coe_mk hli hsp) 0
  · intro i
    exact congrFun (Basis.coe_mk hli hsp) i.succ

/-- The induction interface: the lifted basis has the chosen shortest vector
first, exact projected tail, and explicit nearest-integer reduction bounds. -/
def exists_reduced_lattice_basis_lift (L : Submodule ℤ E) {v : E}
    (hvL : v ∈ L) (hv : v ≠ 0)
    (hshort : ∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖) {n : ℕ}
    (b : Basis (Fin n) ℤ (orthogonalProjectedLattice L v)) :
    ∃ B : Basis (Fin (n + 1)) ℤ L,
      B 0 = ⟨v, hvL⟩ ∧ ∀ i : Fin n,
        latticeProjectionMap L v (B i.succ) = b i ∧
        ∃ a : ℝ, |a| ≤ 1 / 2 ∧
          (B i.succ : E) = ((b i : (ℝ ∙ v)ᗮ) : E) + a • v ∧
          ‖(B i.succ : E)‖ ^ 2 ≤ ‖((b i : (ℝ ∙ v)ᗮ) : E)‖ ^ 2 + ‖v‖ ^ 2 / 4 := by
  classical
  choose u hu using fun i : Fin n => exists_rounded_orthogonal_lift L hvL (b i)
  obtain ⟨B, hB0, hB⟩ := exists_lattice_basis_of_projection_lifts L hvL hv hshort b u
    (fun i => (hu i).1)
  refine ⟨B, hB0, ?_⟩
  intro i
  rw [hB]
  exact hu i


end
end Bounty

end SubmissionComponent_ProjectedLatticeBasis

/- Component ReducedLatticeBasis; SHA256 cf044da05f2fa1ddd563749c15e84b308168c89fbb92013ab52eb9b1bd93eb51 -/
section SubmissionComponent_ReducedLatticeBasis
/- A recursively reduced integer lattice basis.  The recursion keeps the
actual orthogonal projected lattice, its basis, and the rounding coefficient
of every lift.  Thus the reduction conditions are data about the constructed
basis, rather than hypotheses about an unspecified Gram--Schmidt process. -/

namespace Bounty
noncomputable section
open scoped InnerProductSpace BigOperators
open Module

universe u

/-- Recursive shortest-projection reduction, with its successive orthogonal
lengths.  At each stage the first vector is shortest, and each remaining basis
vector is a half-unit-reduced lift of the recursively reduced projected basis. -/
def IsReducedLatticeBasis : (n : ℕ) → {E : Type u} →
    [NormedAddCommGroup E] → [InnerProductSpace ℝ E] →
    (L : Submodule ℤ E) → Basis (Fin n) ℤ L → (Fin n → ℝ) → Prop
  | 0, _, _, _, _, _, _ => True
  | n + 1, E, _, _, L, B, h =>
      ∃ (v : E) (hvL : v ∈ L), v ≠ 0 ∧
        (∀ x ∈ L, x ≠ 0 → ‖v‖ ≤ ‖x‖) ∧ B 0 = ⟨v, hvL⟩ ∧ h 0 = ‖v‖ ∧
        ∃ b : Basis (Fin n) ℤ (orthogonalProjectedLattice L v),
          IsReducedLatticeBasis n (orthogonalProjectedLattice L v) b
            (fun i => h i.succ) ∧
          ∀ i : Fin n, latticeProjectionMap L v (B i.succ) = b i ∧
            ∃ a : ℝ, |a| ≤ 1 / 2 ∧
              (B i.succ : E) = ((b i : (ℝ ∙ v)ᗮ) : E) + a • v ∧
              ‖(B i.succ : E)‖ ^ 2 ≤
                ‖((b i : (ℝ ∙ v)ᗮ) : E)‖ ^ 2 + ‖v‖ ^ 2 / 4

/-- Every full discrete lattice admits a recursively reduced integer basis. -/
def exists_reduced_lattice_basis (n : ℕ) :
    ∀ (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
      [FiniteDimensional ℝ E] (L : Submodule ℤ E)
      [DiscreteTopology L] [IsZLattice ℝ L],
      finrank ℝ E = n →
      ∃ (B : Basis (Fin n) ℤ L) (h : Fin n → ℝ),
        IsReducedLatticeBasis n L B h := by
  induction n with
  | zero =>
      intro E _ _ _ L _ _ hdim
      let _ : Subsingleton E := Module.finrank_zero_iff.mp hdim
      exact ⟨Basis.empty L, fun i => Fin.elim0 i, trivial⟩
  | succ n ih =>
      intro E _ _ _ L _ _ hdim
      have hspan : Submodule.span ℝ (L : Set E) = ⊤ := IsZLattice.span_top
      have hnonzero : ∃ x ∈ L, x ≠ 0 := by
        by_contra! h
        have hbot : Submodule.span ℝ (L : Set E) = ⊥ := by
          apply le_antisymm _ bot_le
          exact Submodule.span_le.mpr (fun x hx => by simpa using h x hx)
        let _ : Subsingleton E := ⟨fun x y => by
          have hz (z : E) : z = 0 := by
            have : z ∈ (⊥ : Submodule ℝ E) := by
              rw [← hbot, hspan]
              trivial
            exact this
          rw [hz x, hz y]⟩
        have : finrank ℝ E = 0 := Module.finrank_eq_zero_of_subsingleton ℝ E
        omega
      obtain ⟨v, hvL, hv, hshort⟩ := exists_shortest_lattice_vector L hnonzero
      let _ := orthogonalProjectedLattice_discreteTopology L hvL
      let _ := orthogonalProjectedLattice_isZLattice L v hspan
      have hdim' : finrank ℝ (ℝ ∙ v)ᗮ = n := by
        apply Submodule.finrank_add_finrank_orthogonal'
        simpa [finrank_span_singleton hv, add_comm] using hdim.symm
      obtain ⟨b, h, hb⟩ := ih (ℝ ∙ v)ᗮ (orthogonalProjectedLattice L v) hdim'
      obtain ⟨B, hB0, hB⟩ := exists_reduced_lattice_basis_lift L hvL hv hshort b
      refine ⟨B, Fin.cons ‖v‖ h, v, hvL, hv, hshort, hB0, rfl, b, ?_, hB⟩
      exact hb

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def IsReducedLatticeBasis.length_pos {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) : ∀ i, 0 < h i := by
  induction n generalizing E with
  | zero => exact fun i => Fin.elim0 i
  | succ n ih =>
      obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
      exact Fin.cases (by rw [hh0]; exact norm_pos_iff.mpr hv) (ih hb)

def IsReducedLatticeBasis.first_length {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin (n + 1)) ℤ L} {h : Fin (n + 1) → ℝ}
    (hB : IsReducedLatticeBasis (n + 1) L B h) : h 0 = ‖(B 0 : E)‖ := by
  obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
  simpa [hB0] using hh0

def IsReducedLatticeBasis.first_gap {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin (n + 2)) ℤ L} {h : Fin (n + 2) → ℝ}
    (hB : IsReducedLatticeBasis (n + 2) L B h) :
    (3 / 4 : ℝ) * h 0 ^ 2 ≤ h (Fin.succ 0) ^ 2 := by
  obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
  have hp : latticeProjection v (B (Fin.succ 0) : E) =
      ((b 0 : (ℝ ∙ v)ᗮ) : E) :=
    congrArg (fun z : orthogonalProjectedLattice L v => ((z : (ℝ ∙ v)ᗮ) : E))
      (hlift 0).1
  have hn : ((b 0 : (ℝ ∙ v)ᗮ) : E) ≠ 0 := by
    intro hz
    exact b.ne_zero 0 (Subtype.ext (Subtype.ext hz))
  have hg := shortest_latticeProjection_norm_sq_gap L hvL hshort
    (B (Fin.succ 0)).property (hp ▸ hn)
  rw [hp] at hg
  simpa only [hh0, hb.first_length, Submodule.norm_coe] using hg

def IsReducedLatticeBasis.first_length_sq_le {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin (n + 1)) ℤ L} {h : Fin (n + 1) → ℝ}
    (hB : IsReducedLatticeBasis (n + 1) L B h) (i : Fin (n + 1)) :
    h 0 ^ 2 ≤ (4 / 3 : ℝ) ^ i.val * h i ^ 2 := by
  induction n generalizing E with
  | zero =>
      have hi : i = 0 := Fin.ext (by omega)
      simp [hi]
  | succ n ih =>
      refine Fin.cases (by simp) (fun j => ?_) i
      have hgap := hB.first_gap
      obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
      have ht := ih hb j
      calc
        h 0 ^ 2 ≤ (4 / 3 : ℝ) * h (Fin.succ 0) ^ 2 := by nlinarith
        _ ≤ (4 / 3 : ℝ) * ((4 / 3 : ℝ) ^ j.val * h j.succ ^ 2) :=
          mul_le_mul_of_nonneg_left ht (by norm_num)
        _ = (4 / 3 : ℝ) ^ j.succ.val * h j.succ ^ 2 := by
          rw [Fin.val_succ, pow_succ]
          ring

/-- The concrete lifted basis has the sharp geometric-series norm bound. -/
def IsReducedLatticeBasis.norm_sq_le {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) (i : Fin n) :
    ‖(B i : E)‖ ^ 2 ≤ (4 / 3 : ℝ) ^ i.val * h i ^ 2 := by
  induction n generalizing E with
  | zero => exact Fin.elim0 i
  | succ n ih =>
      refine Fin.cases (by simpa using le_of_eq (congrArg (fun t : ℝ => t ^ 2)
        hB.first_length.symm)) (fun j => ?_) i
      have hhead := hB.first_length_sq_le j.succ
      obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
      have ht := ih hb j
      rw [hh0] at hhead
      obtain ⟨a, ha, heq, hnorm⟩ := (hlift j).2
      calc
        ‖(B j.succ : E)‖ ^ 2 ≤
            ‖((b j : (ℝ ∙ v)ᗮ) : E)‖ ^ 2 + ‖v‖ ^ 2 / 4 := hnorm
        _ ≤ (4 / 3 : ℝ) ^ j.val * h j.succ ^ 2 +
            ((4 / 3 : ℝ) ^ j.succ.val * h j.succ ^ 2) / 4 :=
          add_le_add ht (div_le_div_of_nonneg_right hhead (by norm_num))
        _ = (4 / 3 : ℝ) ^ j.succ.val * h j.succ ^ 2 := by
          rw [Fin.val_succ, pow_succ]
          ring

def IsReducedLatticeBasis.norm_le {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) (i : Fin n) :
    ‖(B i : E)‖ ≤ (2 / Real.sqrt 3) ^ i.val * h i := by
  have hq : 0 ≤ 2 / Real.sqrt 3 := by positivity
  have hq2 : (2 / Real.sqrt 3) ^ 2 = (4 / 3 : ℝ) := by
    rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
    norm_num
  have hs : ((2 / Real.sqrt 3) ^ i.val * h i) ^ 2 =
      (4 / 3 : ℝ) ^ i.val * h i ^ 2 := by
    rw [mul_pow, ← pow_mul, Nat.mul_comm i.val 2, pow_mul, hq2]
  have hn : 0 ≤ (2 / Real.sqrt 3) ^ i.val * h i :=
    mul_nonneg (pow_nonneg hq _) (hB.length_pos i).le
  have hb := hB.norm_sq_le i
  nlinarith [norm_nonneg (B i : E)]

/-- The norm product is bounded by the product of successive orthogonal
lengths, with the explicit reduced-basis constant. -/
def IsReducedLatticeBasis.norm_product_le {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) :
    (∏ i : Fin n, ‖(B i : E)‖) ≤
      (2 / Real.sqrt 3) ^ (∑ i : Fin n, i.val) * ∏ i : Fin n, h i := by
  calc
    (∏ i : Fin n, ‖(B i : E)‖) ≤
        ∏ i : Fin n, (2 / Real.sqrt 3) ^ i.val * h i :=
      Finset.prod_le_prod (fun i _ => norm_nonneg _) (fun i _ => hB.norm_le i)
    _ = _ := by rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]

def IsReducedLatticeBasis.norm_product_le_explicit {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) :
    (∏ i : Fin n, ‖(B i : E)‖) ≤
      (2 / Real.sqrt 3) ^ (n * (n - 1) / 2) * ∏ i : Fin n, h i := by
  have hs : (∑ i : Fin n, i.val) = n * (n - 1) / 2 := by
    rw [Fin.sum_univ_eq_sum_range (fun i : ℕ => i), Finset.sum_range_id]
  simpa only [hs] using hB.norm_product_le

/-- The recursive data give an actual orthogonal family in the original
ambient space and all the size-reduced triangular expansion coefficients. -/
def IsReducedLatticeBasis.exists_orthogonal_data {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) :
    ∃ (g : Fin n → E) (μ : Fin n → Fin n → ℝ),
      (∀ i, ‖g i‖ = h i) ∧
      Pairwise (fun i j => inner ℝ (g i) (g j) = 0) ∧
      (∀ i j, |μ i j| ≤ 1 / 2) ∧
      ∀ i, (B i : E) = g i + ∑ j : Fin n, if j < i then μ i j • g j else 0 := by
  classical
  induction n generalizing E with
  | zero =>
      refine ⟨fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, ?_, ?_, ?_⟩ <;>
        intro i <;> exact Fin.elim0 i
  | succ n ih =>
      obtain ⟨v, hvL, hv, hshort, hB0, hh0, b, hb, hlift⟩ := hB
      obtain ⟨g, μ, hgnorm, hgorth, hμ, hexp⟩ := ih hb
      choose a ha heq hnorm using fun i => (hlift i).2
      let G : Fin (n + 1) → E := Fin.cons v (fun i => (g i : E))
      let M : Fin (n + 1) → Fin (n + 1) → ℝ :=
        Fin.cons (fun _ => 0) (fun i => Fin.cons (a i) (μ i))
      refine ⟨G, M, ?_, ?_, ?_, ?_⟩
      · exact Fin.cases hh0.symm hgnorm
      · intro i j
        refine Fin.cases ?_ (fun i => ?_) i
        · refine Fin.cases ?_ (fun j => ?_) j
          · exact fun hij => False.elim (hij rfl)
          · exact fun _ => Submodule.mem_orthogonal_singleton_iff_inner_right.mp (g j).property
        · refine Fin.cases ?_ (fun j => ?_) j
          · exact fun _ => Submodule.mem_orthogonal_singleton_iff_inner_left.mp (g i).property
          · exact fun hij => hgorth (fun h => hij (congrArg Fin.succ h))
      · intro i j
        refine Fin.cases (by norm_num [M]) (fun i => ?_) i
        exact Fin.cases (ha i) (hμ i) j
      · intro i
        refine Fin.cases ?_ (fun i => ?_) i
        · simp [G, hB0]
        · have hexp' := congrArg (fun z : (ℝ ∙ v)ᗮ => (z : E)) (hexp i)
          simp only [Submodule.coe_add, Submodule.coe_sum, Submodule.coe_smul,
            Submodule.coe_zero, apply_ite] at hexp'
          simp only [G, M, Fin.cons_succ, Fin.sum_univ_succ, Fin.cons_zero,
            Fin.succ_pos, ↓reduceIte, Fin.succ_lt_succ_iff]
          rw [heq i, hexp']
          abel


end
end Bounty

end SubmissionComponent_ReducedLatticeBasis

/- Component ReducedLatticeDeterminant; SHA256 962bf143e227ce3a6d8209aa3276ab80415f5e9db588b075057229a5da697a9c -/
section SubmissionComponent_ReducedLatticeDeterminant
/- Determinants and covolumes of the actual recursively reduced basis. -/

namespace Bounty
noncomputable section
open scoped InnerProductSpace BigOperators Matrix
open Module MeasureTheory

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A triangular expansion with diagonal one does not change the determinant. -/
def orthogonal_expansion_det {n : ℕ} (e : Basis (Fin n) ℝ E)
    (x g : Fin n → E) (μ : Fin n → Fin n → ℝ)
    (hexp : ∀ i, x i = g i + ∑ j : Fin n, if j < i then μ i j • g j else 0) :
    e.det x = e.det g := by
  classical
  let T : Matrix (Fin n) (Fin n) ℝ :=
    1 + Matrix.of (fun i j => if i < j then μ j i else 0)
  have hT : T.IsUpperTriangular := by
    intro i j hij
    change j < i at hij
    simp [T, ne_of_gt hij, not_lt_of_ge hij.le]
  have hdetT : T.det = 1 := by
    rw [Matrix.det_of_isUpperTriangular hT]
    simp [T]
  have hmat : e.toMatrix x = e.toMatrix g * T := by
    dsimp only [T]
    rw [Matrix.mul_add, Matrix.mul_one]
    ext i j
    change e.coord i (x j) = e.coord i (g j) +
      ∑ k : Fin n, e.coord i (g k) * (if k < j then μ j k else 0)
    rw [hexp j, map_add, map_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro k _
    split_ifs <;> simp [map_smul, mul_comm]
  rw [Basis.det_apply, hmat, Matrix.det_mul, hdetT, mul_one, ← Basis.det_apply]

/-- In an orthonormal coordinate system, the absolute determinant of an
orthogonal family is exactly the product of its lengths. -/
def orthogonal_abs_det {n : ℕ} (e : OrthonormalBasis (Fin n) ℝ E)
    (g : Fin n → E) (hg : Pairwise (fun i j => inner ℝ (g i) (g j) = 0)) :
    |e.toBasis.det g| = ∏ i : Fin n, ‖g i‖ := by
  classical
  have hgram : Matrix.gram ℝ g = Matrix.diagonal (fun i => ‖g i‖ ^ 2) := by
    ext i j
    by_cases hij : i = j
    · subst j
      simp
    · simp [hij, hg hij]
  have hmat : Matrix.gram ℝ g = (e.toBasis.toMatrix g).transpose * e.toBasis.toMatrix g := by
    have he : e.toBasis.toMatrix g = Matrix.of (fun i j => e.repr (g j) i) := by
      ext i j
      exact e.coe_toBasis_repr_apply (g j) i
    rw [he]
    simpa only [Matrix.conjTranspose_eq_transpose_of_trivial]
      using Matrix.gram_eq_conjTranspose_mul e g
  have hs : (e.toBasis.det g) ^ 2 = (∏ i : Fin n, ‖g i‖) ^ 2 := by
    have hd := congrArg Matrix.det (hmat.symm.trans hgram)
    simpa only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_diagonal,
      Basis.det_apply, ← sq, Finset.prod_pow] using hd
  have hp : 0 ≤ ∏ i : Fin n, ‖g i‖ := Finset.prod_nonneg (fun _ _ => norm_nonneg _)
  nlinarith [sq_abs (e.toBasis.det g), abs_nonneg (e.toBasis.det g)]

def IsReducedLatticeBasis.abs_det_eq_product {n : ℕ} {L : Submodule ℤ E}
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) (e : OrthonormalBasis (Fin n) ℝ E) :
    |e.toBasis.det (fun i => (B i : E))| = ∏ i : Fin n, h i := by
  obtain ⟨g, μ, hnorm, horth, hμ, hexp⟩ := hB.exists_orthogonal_data
  rw [orthogonal_expansion_det e.toBasis _ g μ hexp, orthogonal_abs_det e g horth]
  simp only [hnorm]

def IsReducedLatticeBasis.covolume_eq_product [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] {n : ℕ} {L : Submodule ℤ E}
    [DiscreteTopology L] [IsZLattice ℝ L]
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) (e : OrthonormalBasis (Fin n) ℝ E) :
    ZLattice.covolume L = ∏ i : Fin n, h i := by
  have hvol : volume.real (ZSpan.fundamentalDomain e.toBasis) = 1 := by
    rw [measureReal_congr (ZSpan.fundamentalDomain_ae_parallelepiped e.toBasis volume)]
    simp only [measureReal_def, e.coe_toBasis, e.volume_parallelepiped, ENNReal.toReal_one]
  rw [ZLattice.covolume_eq_det_mul_measureReal L volume B e.toBasis, hvol, mul_one]
  exact hB.abs_det_eq_product e

def IsReducedLatticeBasis.norm_product_le_covolume [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] {n : ℕ} {L : Submodule ℤ E}
    [DiscreteTopology L] [IsZLattice ℝ L]
    {B : Basis (Fin n) ℤ L} {h : Fin n → ℝ}
    (hB : IsReducedLatticeBasis n L B h) (e : OrthonormalBasis (Fin n) ℝ E) :
    (∏ i : Fin n, ‖(B i : E)‖) ≤
      (2 / Real.sqrt 3) ^ (n * (n - 1) / 2) * ZLattice.covolume L := by
  rw [hB.covolume_eq_product e]
  exact hB.norm_product_le_explicit

/-- Existence of an actual integer basis with the explicit covolume bound,
including dimension zero. -/
def exists_lattice_basis_norm_product_le_covolume [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] :
    ∃ B : Basis (Fin (finrank ℝ E)) ℤ L,
      (∏ i : Fin (finrank ℝ E), ‖(B i : E)‖) ≤
        (2 / Real.sqrt 3) ^ (finrank ℝ E * (finrank ℝ E - 1) / 2) *
          ZLattice.covolume L := by
  obtain ⟨B, h, hB⟩ := exists_reduced_lattice_basis (finrank ℝ E) E L rfl
  exact ⟨B, hB.norm_product_le_covolume (stdOrthonormalBasis ℝ E)⟩


end
end Bounty

end SubmissionComponent_ReducedLatticeDeterminant

/- Component LatticeSuccessiveMinima; SHA256 308b65d5cf92bbad5e112996062e10028db8b71e49d6704b6c8e6cb19fefa6a1 -/
section SubmissionComponent_LatticeSuccessiveMinima
/- Successive Euclidean minima obtained by finite minimization in the actual
lattice.  The greedy construction is subsequently characterized intrinsically
by bounded independent tuples, so the minima do not depend on its choices. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Module

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

def latticePrefixSpan {n : ℕ} (v : Fin n → E) (k : ℕ) : Submodule ℝ E :=
  Submodule.span ℝ (v '' {i | i.val < k})

def latticePrefixSpan_eq_range {n k : ℕ} (v : Fin n → E) (hk : k ≤ n) :
    latticePrefixSpan v k =
      Submodule.span ℝ (Set.range (fun j : Fin k => v (Fin.castLE hk j))) := by
  change Submodule.span ℝ _ = Submodule.span ℝ _
  apply congrArg (Submodule.span ℝ)
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i.val, hi⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨Fin.castLE hk j, j.isLt, rfl⟩

def latticePrefixSpan_zero {n : ℕ} (v : Fin n → E) :
    latticePrefixSpan v 0 = ⊥ := by simp [latticePrefixSpan]

def latticePrefixSpan_full {n : ℕ} (v : Fin n → E) :
    latticePrefixSpan v n = Submodule.span ℝ (Set.range v) := by
  rw [latticePrefixSpan_eq_range v le_rfl]
  rfl

def latticePrefixSpan_snoc {n k : ℕ} (v : Fin n → E) (x : E) (hk : k ≤ n) :
    latticePrefixSpan (Fin.snoc v x) k = latticePrefixSpan v k := by
  rw [latticePrefixSpan_eq_range _ (hk.trans (Nat.le_succ n)), latticePrefixSpan_eq_range _ hk]
  apply congrArg (Submodule.span ℝ)
  apply congrArg Set.range
  funext j
  rw [show Fin.castLE (hk.trans (Nat.le_succ n)) j = (Fin.castLE hk j).castSucc from rfl]
  simp only [Fin.snoc_castSucc]

def latticePrefixSpan_finrank_le [FiniteDimensional ℝ E] {n k : ℕ}
    (v : Fin n → E) (hk : k ≤ n) : finrank ℝ (latticePrefixSpan v k) ≤ k := by
  rw [latticePrefixSpan_eq_range v hk]
  simpa only [Fintype.card_fin, Set.finrank] using finrank_range_le_card (R := ℝ)
    (fun j : Fin k => v (Fin.castLE hk j))

def latticePrefixSpan_finrank [FiniteDimensional ℝ E] {n k : ℕ}
    {v : Fin n → E} (hv : LinearIndependent ℝ v) (hk : k ≤ n) :
    finrank ℝ (latticePrefixSpan v k) = k := by
  rw [latticePrefixSpan_eq_range v hk]
  simpa only [Fintype.card_fin, Function.comp_def] using finrank_span_eq_card
    (hv.comp (Fin.castLE hk) (Fin.castLE_injective hk))

/-- Shortest points outside any prescribed subspace exist whenever that
subspace does not contain all lattice points. -/
def exists_shortest_lattice_vector_outside [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] (S : Submodule ℝ E)
    (hL : ∃ x ∈ L, x ∉ S) :
    ∃ v ∈ L, v ∉ S ∧ ∀ x ∈ L, x ∉ S → ‖v‖ ≤ ‖x‖ := by
  obtain ⟨x₀, hx₀, hx₀ne⟩ := hL
  have hclosed : IsClosed (L : Set E) :=
    AddSubgroup.isClosed_of_discrete (H := L.toAddSubgroup)
  have hfinite : Set.Finite (Metric.closedBall (0 : E) ‖x₀‖ ∩ (L : Set E)) :=
    Metric.finite_isBounded_inter_isClosed DiscreteTopology.isDiscrete
      Metric.isBounded_closedBall hclosed
  let s : Set E := (Metric.closedBall 0 ‖x₀‖ ∩ (L : Set E)) \ (S : Set E)
  have hs : s.Finite := hfinite.subset (by intro x hx; exact hx.1)
  have hx₀s : x₀ ∈ s := ⟨⟨by simp, hx₀⟩, hx₀ne⟩
  obtain ⟨v, hv, hmin⟩ := Set.exists_min_image s (fun x => ‖x‖) hs ⟨x₀, hx₀s⟩
  refine ⟨v, hv.1.2, hv.2, ?_⟩
  intro x hx hxne
  by_cases hball : ‖x‖ ≤ ‖x₀‖
  · exact hmin x ⟨⟨by simpa using hball, hx⟩, hxne⟩
  · exact (hmin x₀ hx₀s).trans (le_of_lt (lt_of_not_ge hball))

def IsLatticeMinimumTuple (L : Submodule ℤ E) {n : ℕ} (v : Fin n → E) : Prop :=
  LinearIndependent ℝ v ∧ (∀ i, v i ∈ L) ∧
    ∀ i x, x ∈ L → x ∉ latticePrefixSpan v i.val → ‖v i‖ ≤ ‖x‖

def exists_lattice_minimum_tuple [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] [IsZLattice ℝ L]
    (n : ℕ) (hn : n ≤ finrank ℝ E) :
    ∃ v : Fin n → E, IsLatticeMinimumTuple L v := by
  induction n with
  | zero =>
      refine ⟨fun i => Fin.elim0 i, linearIndependent_empty_type, ?_, ?_⟩
      · exact fun i => Fin.elim0 i
      · exact fun i => Fin.elim0 i
  | succ n ih =>
      obtain ⟨v, hvli, hvL, hvmin⟩ := ih (Nat.le_of_succ_le hn)
      have hex : ∃ x ∈ L, x ∉ Submodule.span ℝ (Set.range v) := by
        by_contra! h
        have htop : Submodule.span ℝ (Set.range v) = ⊤ := by
          apply top_unique
          rw [← IsZLattice.span_top (K := ℝ) (L := L)]
          exact Submodule.span_le.mpr h
        have hr := finrank_span_eq_card hvli
        rw [htop] at hr
        simp only [finrank_top, Fintype.card_fin] at hr
        omega
      obtain ⟨x, hxL, hx, hxmin⟩ := exists_shortest_lattice_vector_outside L _ hex
      refine ⟨Fin.snoc v x, hvli.finSnoc hx, ?_, ?_⟩
      · exact Fin.lastCases (by simpa) (fun i => by simpa using hvL i)
      · intro i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · simpa only [Fin.snoc_last, Fin.val_last, latticePrefixSpan_snoc v x le_rfl,
            latticePrefixSpan_full] using hxmin
        · simpa only [Fin.snoc_castSucc, Fin.val_castSucc,
            latticePrefixSpan_snoc v x (Nat.le_of_lt j.isLt)] using hvmin j

def IsLatticeMinimumTuple.monotone {n : ℕ} {L : Submodule ℤ E} {v : Fin n → E}
    (hv : IsLatticeMinimumTuple L v) : Monotone (fun i => ‖v i‖) := by
  intro i j hij
  apply hv.2.2 i (v j) (hv.2.1 j)
  exact hv.1.notMem_span_image (by simpa using not_lt_of_ge hij)

def IsLatticeMinimumTuple.norm_pos {n : ℕ} {L : Submodule ℤ E} {v : Fin n → E}
    (hv : IsLatticeMinimumTuple L v) (i : Fin n) : 0 < ‖v i‖ :=
  norm_pos_iff.mpr (hv.1.ne_zero i)

def IsLatticeMinimumTuple.short_mem_prefix {n : ℕ} {L : Submodule ℤ E}
    {v : Fin n → E} (hv : IsLatticeMinimumTuple L v) (i : Fin n) {x : E}
    (hx : x ∈ L) (hnorm : ‖x‖ < ‖v i‖) : x ∈ latticePrefixSpan v i.val := by
  by_contra h
  exact (not_le_of_gt hnorm) (hv.2.2 i x hx h)

def IsLatticeMinimumTuple.le_of_independent_tuple [FiniteDimensional ℝ E]
    {n : ℕ} {L : Submodule ℤ E} {v : Fin n → E}
    (hv : IsLatticeMinimumTuple L v) (i : Fin n) {R : ℝ}
    (w : Fin (i.val + 1) → E) (hw : LinearIndependent ℝ w)
    (hwL : ∀ j, w j ∈ L) (hwR : ∀ j, ‖w j‖ ≤ R) : ‖v i‖ ≤ R := by
  by_contra h
  have hlt : R < ‖v i‖ := lt_of_not_ge h
  have hspan : Submodule.span ℝ (Set.range w) ≤ latticePrefixSpan v i.val := by
    apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact hv.short_mem_prefix i (hwL j) ((hwR j).trans_lt hlt)
  have hd := Submodule.finrank_mono hspan
  rw [finrank_span_eq_card hw, Fintype.card_fin] at hd
  have hp := latticePrefixSpan_finrank_le v (Nat.le_of_lt i.isLt)
  omega

def IsLatticeMinimumTuple.le_iff_independent_tuple [FiniteDimensional ℝ E]
    {n : ℕ} {L : Submodule ℤ E} {v : Fin n → E}
    (hv : IsLatticeMinimumTuple L v) (i : Fin n) (R : ℝ) :
    ‖v i‖ ≤ R ↔ ∃ w : Fin (i.val + 1) → E,
      LinearIndependent ℝ w ∧ (∀ j, w j ∈ L) ∧ (∀ j, ‖w j‖ ≤ R) := by
  constructor
  · intro hR
    let f := Fin.castLE (Nat.succ_le_of_lt i.isLt)
    refine ⟨fun j => v (f j), hv.1.comp f (Fin.castLE_injective _),
      fun j => hv.2.1 (f j), fun j => ?_⟩
    apply le_trans (hv.monotone (show f j ≤ i from ?_)) hR
    change j.val ≤ i.val
    omega
  · rintro ⟨w, hw, hwL, hwR⟩
    exact hv.le_of_independent_tuple i w hw hwL hwR

section Minima
variable [FiniteDimensional ℝ E] (L : Submodule ℤ E)
variable [DiscreteTopology L] [IsZLattice ℝ L]

def latticeMinimumVectors : Fin (finrank ℝ E) → E :=
  Classical.choose (exists_lattice_minimum_tuple L (finrank ℝ E) le_rfl)

def latticeMinimumVectors_spec : IsLatticeMinimumTuple L (latticeMinimumVectors L) :=
  Classical.choose_spec (exists_lattice_minimum_tuple L (finrank ℝ E) le_rfl)

def latticeSuccessiveMinimum (i : Fin (finrank ℝ E)) : ℝ := ‖latticeMinimumVectors L i‖

def latticeSuccessiveMinimum_pos (i : Fin (finrank ℝ E)) :
    0 < latticeSuccessiveMinimum L i := (latticeMinimumVectors_spec L).norm_pos i

def latticeSuccessiveMinimum_monotone : Monotone (latticeSuccessiveMinimum L) :=
  (latticeMinimumVectors_spec L).monotone

/-- Intrinsic characterization: the i-th (zero-indexed) minimum is at most R
exactly when the radius-R ball contains i+1 independent lattice vectors. -/
def latticeSuccessiveMinimum_le_iff (i : Fin (finrank ℝ E)) (R : ℝ) :
    latticeSuccessiveMinimum L i ≤ R ↔ ∃ w : Fin (i.val + 1) → E,
      LinearIndependent ℝ w ∧ (∀ j, w j ∈ L) ∧ (∀ j, ‖w j‖ ≤ R) :=
  (latticeMinimumVectors_spec L).le_iff_independent_tuple i R

def latticeMinimumVectors_attain :
    LinearIndependent ℝ (latticeMinimumVectors L) ∧
    (∀ i, latticeMinimumVectors L i ∈ L) ∧
    (∀ i, ‖latticeMinimumVectors L i‖ = latticeSuccessiveMinimum L i) :=
  ⟨(latticeMinimumVectors_spec L).1, (latticeMinimumVectors_spec L).2.1, fun _ => rfl⟩

def latticeSuccessiveMinimum_le_sorted_tuple (w : Fin (finrank ℝ E) → E)
    (hw : LinearIndependent ℝ w) (hwL : ∀ j, w j ∈ L)
    (hmono : Monotone (fun j => ‖w j‖)) (i : Fin (finrank ℝ E)) :
    latticeSuccessiveMinimum L i ≤ ‖w i‖ := by
  apply (latticeSuccessiveMinimum_le_iff L i _).mpr
  let f := Fin.castLE (Nat.succ_le_of_lt i.isLt)
  refine ⟨fun j => w (f j), hw.comp f (Fin.castLE_injective _),
    fun j => hwL (f j), fun j => hmono ?_⟩
  change j.val ≤ i.val
  omega

def latticeSuccessiveMinimum_product_le_tuple (w : Fin (finrank ℝ E) → E)
    (hw : LinearIndependent ℝ w) (hwL : ∀ j, w j ∈ L) :
    (∏ i, latticeSuccessiveMinimum L i) ≤ ∏ i, ‖w i‖ := by
  classical
  let σ := Tuple.sort (fun j => ‖w j‖)
  have hle (i : Fin (finrank ℝ E)) : latticeSuccessiveMinimum L i ≤ ‖w (σ i)‖ :=
    latticeSuccessiveMinimum_le_sorted_tuple L (w ∘ σ) (hw.comp σ σ.injective)
      (fun j => hwL (σ j)) (by
        simpa only [Function.comp_def] using Tuple.monotone_sort (fun j => ‖w j‖)) i
  calc
    (∏ i, latticeSuccessiveMinimum L i) ≤ ∏ i, ‖w (σ i)‖ :=
      Finset.prod_le_prod (fun i _ => (latticeSuccessiveMinimum_pos L i).le) (fun i _ => hle i)
    _ = _ := Equiv.prod_comp σ (fun j => ‖w j‖)

def latticeSuccessiveMinimum_product_le_covolume
    [MeasurableSpace E] [BorelSpace E] :
    (∏ i, latticeSuccessiveMinimum L i) ≤
      (2 / Real.sqrt 3) ^ (finrank ℝ E * (finrank ℝ E - 1) / 2) *
        ZLattice.covolume L := by
  obtain ⟨B, hB⟩ := exists_lattice_basis_norm_product_le_covolume L
  apply le_trans (latticeSuccessiveMinimum_product_le_tuple L
    (fun i => (B i : E)) ?_ (fun i => (B i).property)) hB
  have he : (fun i => (B i : E)) = (B.ofZLatticeBasis ℝ L : Fin (finrank ℝ E) → E) := by
    funext i
    exact (B.ofZLatticeBasis_apply ℝ L i).symm
  rw [he]
  exact (B.ofZLatticeBasis ℝ L).linearIndependent

end Minima

/-- The elementary Leibniz bound, with independent bounds on each column. -/
def lattice_matrix_abs_det_le {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (c : Fin n → ℝ) (hA : ∀ i j, |A i j| ≤ c j) :
    |A.det| ≤ (n.factorial : ℝ) * ∏ j, c j := by
  classical
  rw [Matrix.det_apply']
  calc
    |∑ σ : Equiv.Perm (Fin n), ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A (σ i) i| ≤
        ∑ σ : Equiv.Perm (Fin n),
          |((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, A (σ i) i| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _σ : Equiv.Perm (Fin n), ∏ j, c j := by
      apply Finset.sum_le_sum
      intro σ _
      have hs : |((Equiv.Perm.sign σ : ℤ) : ℝ)| = 1 := by
        exact_mod_cast (Int.isUnit_iff_abs_eq.mp (Equiv.Perm.sign σ).isUnit)
      rw [abs_mul, hs, one_mul, Finset.abs_prod]
      exact Finset.prod_le_prod (fun _ _ => abs_nonneg _) (fun i _ => hA (σ i) i)
    _ = _ := by simp [Fintype.card_perm]

def lattice_abs_det_le_factorial_norm_product {n : ℕ}
    (e : OrthonormalBasis (Fin n) ℝ E) (w : Fin n → E) :
    |e.toBasis.det w| ≤ (n.factorial : ℝ) * ∏ i, ‖w i‖ := by
  rw [Basis.det_apply]
  apply lattice_matrix_abs_det_le
  intro i j
  rw [Basis.toMatrix_apply, e.coe_toBasis_repr_apply, e.repr_apply_apply]
  simpa only [Real.norm_eq_abs, e.norm_eq_one, one_mul] using
    norm_inner_le_norm (𝕜 := ℝ) (e i) (w j)

/-- Independent lattice vectors have absolute determinant at least the
lattice covolume, because their coordinates in an integer basis have a
nonzero integer determinant. -/
def lattice_covolume_le_abs_det [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L]
    (e : OrthonormalBasis (Fin (finrank ℝ E)) ℝ E)
    (w : Fin (finrank ℝ E) → E) (hw : LinearIndependent ℝ w)
    (hwL : ∀ i, w i ∈ L) : ZLattice.covolume L ≤ |e.toBasis.det w| := by
  classical
  obtain ⟨B, h, hB⟩ := exists_reduced_lattice_basis (finrank ℝ E) E L rfl
  let b := B.ofZLatticeBasis ℝ L
  let wL : Fin (finrank ℝ E) → L := fun i => ⟨w i, hwL i⟩
  let A : Matrix (Fin (finrank ℝ E)) (Fin (finrank ℝ E)) ℤ := B.toMatrix wL
  have hb : (b : Fin (finrank ℝ E) → E) = fun i => (B i : E) := by
    funext i
    exact B.ofZLatticeBasis_apply ℝ L i
  have hcov : ZLattice.covolume L = |e.toBasis.det b| := by
    rw [hb, hB.abs_det_eq_product e, hB.covolume_eq_product e]
  have hA : b.toMatrix w = A.map (Int.castRingHom ℝ) := by
    ext i j
    exact B.ofZLatticeBasis_repr_apply ℝ L (wL j) i
  have hcast : b.det w = (A.det : ℝ) := by
    rw [Basis.det_apply, hA]
    exact ((Int.castRingHom ℝ).map_det A).symm
  let bw := basisOfLinearIndependentOfCardEqFinrank' w hw (by simp)
  have hbw : (bw : Fin (finrank ℝ E) → E) = w :=
    coe_basisOfLinearIndependentOfCardEqFinrank' w hw _
  have hne : b.det w ≠ 0 := by
    rw [← hbw]
    exact (b.isUnit_det bw).ne_zero
  have hAz : A.det ≠ 0 := by
    intro hz
    apply hne
    rw [hcast, hz, Int.cast_zero]
  have habs : (1 : ℝ) ≤ |b.det w| := by
    rw [hcast]
    have hz : (1 : ℤ) ≤ |A.det| := by have := abs_pos.mpr hAz; omega
    exact_mod_cast hz
  have hfactor : e.toBasis.det w = e.toBasis.det b * b.det w := by
    have hf := congrArg (fun f : AlternatingMap ℝ E ℝ (Fin (finrank ℝ E)) => f w)
      (e.toBasis.det.eq_smul_basis_det b)
    simpa only [AlternatingMap.smul_apply, smul_eq_mul] using hf
  rw [hfactor, abs_mul, ← hcov]
  exact le_mul_of_one_le_right (ZLattice.covolume_pos L).le habs

def latticeSuccessiveMinimum_covolume_div_factorial_le [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] :
    ZLattice.covolume L / (finrank ℝ E).factorial ≤
      ∏ i, latticeSuccessiveMinimum L i := by
  have ht := latticeMinimumVectors_attain L
  have hdet := lattice_covolume_le_abs_det L (stdOrthonormalBasis ℝ E)
    (latticeMinimumVectors L) ht.1 ht.2.1
  have hbound := lattice_abs_det_le_factorial_norm_product (stdOrthonormalBasis ℝ E)
    (latticeMinimumVectors L)
  apply (div_le_iff₀ (by exact_mod_cast Nat.factorial_pos (finrank ℝ E))).mpr
  simpa only [latticeSuccessiveMinimum, mul_comm] using hdet.trans hbound

/-- Both product bounds for the actual attained Euclidean successive minima. -/
def latticeSuccessiveMinimum_product_bounds [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] :
    ZLattice.covolume L / (finrank ℝ E).factorial ≤ (∏ i, latticeSuccessiveMinimum L i) ∧
    (∏ i, latticeSuccessiveMinimum L i) ≤
      (2 / Real.sqrt 3) ^ (finrank ℝ E * (finrank ℝ E - 1) / 2) *
        ZLattice.covolume L :=
  ⟨latticeSuccessiveMinimum_covolume_div_factorial_le L,
    latticeSuccessiveMinimum_product_le_covolume L⟩


end
end Bounty

end SubmissionComponent_LatticeSuccessiveMinima

/- Component RationalBoxLattice; SHA256 535fbb6c0fd03f5c7a61ea5eeac877d53fa666fb73129a2be1abb3c66143bd66 -/
section SubmissionComponent_RationalBoxLattice
/- Actual Euclidean lattices associated to rational rectangular domains. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module MeasureTheory

abbrev BoxEuclidean (d : ℕ) := EuclideanSpace ℝ (Fin d)

def matrixEuclideanEquiv {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ) (hC : C.det ≠ 0) :
    BoxEuclidean d ≃ₗ[ℝ] BoxEuclidean d :=
  C.toLinearEquiv (EuclideanSpace.basisFun (Fin d) ℝ).toBasis (isUnit_iff_ne_zero.mpr hC)

def matrixEuclideanEquiv_apply {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ)
    (hC : C.det ≠ 0) (x : BoxEuclidean d) :
    matrixEuclideanEquiv C hC x = Matrix.toEuclideanLin C x := by
  rw [matrixEuclideanEquiv, Matrix.toLinearEquiv_apply,
    ← Matrix.toEuclideanLin_eq_toLin_orthonormal]

def matrixEuclideanBasis {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ) (hC : C.det ≠ 0) :
    Basis (Fin d) ℝ (BoxEuclidean d) :=
  (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.map (matrixEuclideanEquiv C hC)

abbrev matrixEuclideanLattice {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ) (hC : C.det ≠ 0) :
    Submodule ℤ (BoxEuclidean d) := Submodule.span ℤ (Set.range (matrixEuclideanBasis C hC))

def matrixEuclideanBasis_toMatrix {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ)
    (hC : C.det ≠ 0) :
    (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.toMatrix (matrixEuclideanBasis C hC) = C := by
  conv_rhs => rw [← LinearMap.toMatrix_toLin (EuclideanSpace.basisFun (Fin d) ℝ).toBasis
    (EuclideanSpace.basisFun (Fin d) ℝ).toBasis C]
  ext i j
  simp only [Basis.toMatrix_apply, LinearMap.toMatrix_apply, matrixEuclideanBasis,
    Basis.map_apply, matrixEuclideanEquiv, Matrix.toLinearEquiv_apply]

def matrixEuclideanLattice_covolume {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ)
    (hC : C.det ≠ 0) : ZLattice.covolume (matrixEuclideanLattice C hC) = |C.det| := by
  let e := EuclideanSpace.basisFun (Fin d) ℝ
  let b := matrixEuclideanBasis C hC
  have hvol : volume.real (ZSpan.fundamentalDomain e.toBasis) = 1 := by
    rw [measureReal_congr (ZSpan.fundamentalDomain_ae_parallelepiped e.toBasis volume)]
    simp only [measureReal_def, e.coe_toBasis, e.volume_parallelepiped, ENNReal.toReal_one]
  change ZLattice.covolume (Submodule.span ℤ (Set.range b)) = |C.det|
  rw [ZLattice.covolume_eq_det_mul_measureReal _ volume (b.restrictScalars ℤ) e.toBasis,
    hvol, mul_one]
  have hb : (fun i => ((b.restrictScalars ℤ i : matrixEuclideanLattice C hC) : BoxEuclidean d)) = b := by
    funext i
    exact b.restrictScalars_apply ℤ i
  change |e.toBasis.det (fun i => ((b.restrictScalars ℤ i : matrixEuclideanLattice C hC) : BoxEuclidean d))| = _
  rw [hb, Basis.det_apply, matrixEuclideanBasis_toMatrix]

def matrixEuclideanLattice_mem_iff {d : ℕ} (C : Matrix (Fin d) (Fin d) ℝ)
    (hC : C.det ≠ 0) (y : BoxEuclidean d) :
    y ∈ matrixEuclideanLattice C hC ↔ ∃ z : Fin d → ℤ,
      y = Matrix.toEuclideanLin C (WithLp.toLp 2 (fun i => (z i : ℝ))) := by
  let e := EuclideanSpace.basisFun (Fin d) ℝ
  let f := matrixEuclideanEquiv C hC
  rw [matrixEuclideanLattice, (matrixEuclideanBasis C hC).mem_span_iff_repr_mem ℤ]
  constructor
  · intro hy
    choose z hz using hy
    refine ⟨z, ?_⟩
    rw [← matrixEuclideanEquiv_apply C hC]
    apply f.symm.injective
    change f.symm y = f.symm (f _)
    rw [f.symm_apply_apply]
    ext i
    exact (hz i).symm
  · rintro ⟨z, rfl⟩ i
    refine ⟨z i, ?_⟩
    rw [← matrixEuclideanEquiv_apply C hC]
    change (z i : ℝ) = e.toBasis.repr (f.symm (f (WithLp.toLp 2 (fun i => (z i : ℝ))))) i
    rw [f.symm_apply_apply, e.coe_toBasis_repr_apply]
    rfl

def rationalBoxMatrix {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) (B : Fin d → ℝ) :
    Matrix (Fin d) (Fin d) ℝ :=
  Matrix.diagonal (fun i => (B i)⁻¹) * A.map (Rat.castHom ℝ)

def rationalBoxLatticeMatrix {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) : Matrix (Fin d) (Fin d) ℝ :=
  rationalBoxMatrix A B * Matrix.diagonal (fun i => (N i : ℝ))

def rationalBoxMatrix_det {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) (B : Fin d → ℝ) :
    (rationalBoxMatrix A B).det = (A.det : ℝ) / ∏ i, B i := by
  rw [rationalBoxMatrix, Matrix.det_mul, Matrix.det_diagonal]
  have hc : (A.map (Rat.castHom ℝ)).det = (A.det : ℝ) := ((Rat.castHom ℝ).map_det A).symm
  rw [hc, Finset.prod_inv_distrib, div_eq_mul_inv, mul_comm]

def rationalBoxLatticeMatrix_det {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) :
    (rationalBoxLatticeMatrix A B N).det = (A.det : ℝ) * (∏ i, (N i : ℝ)) / ∏ i, B i := by
  rw [rationalBoxLatticeMatrix, Matrix.det_mul, rationalBoxMatrix_det, Matrix.det_diagonal]
  ring

def rationalBoxMatrix_det_ne_zero {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i) :
    (rationalBoxMatrix A B).det ≠ 0 := by
  rw [rationalBoxMatrix_det]
  exact div_ne_zero (by exact_mod_cast hA) (Finset.prod_ne_zero_iff.mpr (fun i _ => (hB i).ne'))

def rationalBoxLatticeMatrix_det_ne_zero {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    (rationalBoxLatticeMatrix A B N).det ≠ 0 := by
  rw [rationalBoxLatticeMatrix, Matrix.det_mul, Matrix.det_diagonal]
  exact mul_ne_zero (rationalBoxMatrix_det_ne_zero A B hA hB)
    (Finset.prod_ne_zero_iff.mpr (fun i _ => by exact_mod_cast (hN i).ne'))

abbrev rationalBoxLattice {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) : Submodule ℤ (BoxEuclidean d) :=
  matrixEuclideanLattice (rationalBoxLatticeMatrix A B N)
    (rationalBoxLatticeMatrix_det_ne_zero A B N hA hB hN)

def rationalBoxLattice_covolume {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    ZLattice.covolume (rationalBoxLattice A B N hA hB hN) =
      |(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i := by
  have hn : (0 : ℝ) < ∏ i, (N i : ℝ) :=
    Finset.prod_pos (fun i _ => by exact_mod_cast hN i)
  have hb : (0 : ℝ) < ∏ i, B i := Finset.prod_pos (fun i _ => hB i)
  rw [rationalBoxLattice, matrixEuclideanLattice_covolume, rationalBoxLatticeMatrix_det,
    abs_div, abs_mul, abs_of_pos hn, abs_of_pos hb]

def rationalBoxTransform {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i) :
    BoxEuclidean d ≃ₗ[ℝ] BoxEuclidean d :=
  matrixEuclideanEquiv (rationalBoxMatrix A B) (rationalBoxMatrix_det_ne_zero A B hA hB)

def rationalBoxTransform_apply {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i)
    (x : BoxEuclidean d) (i : Fin d) :
    rationalBoxTransform A B hA hB x i =
      (A.map (Rat.castHom ℝ) *ᵥ WithLp.ofLp x) i / B i := by
  rw [rationalBoxTransform, matrixEuclideanEquiv_apply]
  change (rationalBoxMatrix A B *ᵥ WithLp.ofLp x) i = _
  simp [rationalBoxMatrix, ← Matrix.mulVec_mulVec, Matrix.mulVec_diagonal,
    div_eq_mul_inv, mul_comm]

def diagonalIntegerPoint {d : ℕ} (N : Fin d → ℕ) (z : Fin d → ℤ) : BoxEuclidean d :=
  WithLp.toLp 2 (fun i => (N i : ℝ) * (z i : ℝ))

def rationalBoxLattice_mem_iff {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (y : BoxEuclidean d) :
    y ∈ rationalBoxLattice A B N hA hB hN ↔ ∃ z : Fin d → ℤ,
      y = rationalBoxTransform A B hA hB (diagonalIntegerPoint N z) := by
  rw [rationalBoxLattice, matrixEuclideanLattice_mem_iff]
  apply exists_congr
  intro z
  apply Iff.of_eq
  apply congrArg (fun t : BoxEuclidean d => y = t)
  rw [rationalBoxTransform, matrixEuclideanEquiv_apply]
  ext i
  change ((rationalBoxMatrix A B * Matrix.diagonal (fun i => (N i : ℝ))) *ᵥ
    (fun i => (z i : ℝ))) i = (rationalBoxMatrix A B *ᵥ (fun i => (N i : ℝ) * (z i : ℝ))) i
  rw [← Matrix.mulVec_mulVec]
  apply congrArg (fun t : Fin d → ℝ => (rationalBoxMatrix A B *ᵥ t) i)
  ext j
  exact Matrix.mulVec_diagonal _ _ j

def rationalBoxContains {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (x : BoxEuclidean d) : Prop :=
  ∀ i, |(A.map (Rat.castHom ℝ) *ᵥ WithLp.ofLp x) i| ≤ B i

def rationalBoxContains_norm_le_sqrt {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i)
    (x : BoxEuclidean d) (hx : rationalBoxContains A B x) :
    ‖rationalBoxTransform A B hA hB x‖ ≤ Real.sqrt d := by
  let y := rationalBoxTransform A B hA hB x
  have hy (i : Fin d) : |y i| ≤ 1 := by
    rw [show y i = (A.map (Rat.castHom ℝ) *ᵥ WithLp.ofLp x) i / B i from
      rationalBoxTransform_apply A B hA hB x i, abs_div, abs_of_pos (hB i)]
    exact (div_le_one (hB i)).mpr (hx i)
  have hs : ‖y‖ ^ 2 ≤ (d : ℝ) := by
    rw [EuclideanSpace.real_norm_sq_eq]
    calc
      (∑ i, y i ^ 2) ≤ ∑ _i : Fin d, (1 : ℝ) := by
        apply Finset.sum_le_sum
        intro i _
        nlinarith [hy i, abs_nonneg (y i), sq_abs (y i)]
      _ = _ := by simp
  have hsq := Real.sq_sqrt (Nat.cast_nonneg d : (0 : ℝ) ≤ d)
  have hpos := Real.sqrt_nonneg (d : ℝ)
  change ‖y‖ ≤ _
  nlinarith [norm_nonneg y]

def boxDimensionEquiv (d : ℕ) : Fin d ≃ Fin (finrank ℝ (BoxEuclidean d)) :=
  finCongr (by simp [BoxEuclidean])

/-- The Euclidean successive minimum of the transformed lattice, measured
on the original domain by the norm `‖T x‖₂`. -/
def rationalBoxMinimumValue {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) : ℝ :=
  latticeSuccessiveMinimum (rationalBoxLattice A B N hA hB hN) (boxDimensionEquiv d i)

def rationalBoxMinimumPoints {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) : BoxEuclidean d :=
  (rationalBoxTransform A B hA hB).symm
    (latticeMinimumVectors (rationalBoxLattice A B N hA hB hN) (boxDimensionEquiv d i))

def rationalBoxMinimumPoints_integral {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) :
    ∃ z : Fin d → ℤ, rationalBoxMinimumPoints A B N hA hB hN i = diagonalIntegerPoint N z := by
  have hm := (latticeMinimumVectors_attain (rationalBoxLattice A B N hA hB hN)).2.1
    (boxDimensionEquiv d i)
  obtain ⟨z, hz⟩ := (rationalBoxLattice_mem_iff A B N hA hB hN _).mp hm
  refine ⟨z, ?_⟩
  unfold rationalBoxMinimumPoints
  rw [hz, LinearEquiv.symm_apply_apply]

def rationalBoxMinimumPoints_independent {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    LinearIndependent ℝ (rationalBoxMinimumPoints A B N hA hB hN) := by
  have hli := (latticeMinimumVectors_attain (rationalBoxLattice A B N hA hB hN)).1.comp
    (boxDimensionEquiv d) (boxDimensionEquiv d).injective
  exact hli.map' (rationalBoxTransform A B hA hB).symm.toLinearMap
    (LinearMap.ker_eq_bot.mpr (rationalBoxTransform A B hA hB).symm.injective)

def rationalBoxMinimumPoints_attain {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) :
    ‖rationalBoxTransform A B hA hB (rationalBoxMinimumPoints A B N hA hB hN i)‖ =
      rationalBoxMinimumValue A B N hA hB hN i := by
  simp [rationalBoxMinimumPoints, rationalBoxMinimumValue, latticeSuccessiveMinimum]

def rationalBoxMinimumValue_pos {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) :
    0 < rationalBoxMinimumValue A B N hA hB hN i :=
  latticeSuccessiveMinimum_pos _ _

def rationalBoxMinimumValue_monotone {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    Monotone (rationalBoxMinimumValue A B N hA hB hN) := by
  intro i j hij
  apply latticeSuccessiveMinimum_monotone
  exact hij

def rationalBoxMinimumValue_product_bounds {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    (|(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i) / d.factorial ≤
        (∏ i, rationalBoxMinimumValue A B N hA hB hN i) ∧
    (∏ i, rationalBoxMinimumValue A B N hA hB hN i) ≤
      (2 / Real.sqrt 3) ^ (d * (d - 1) / 2) *
        (|(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i) := by
  have hp : (∏ i, rationalBoxMinimumValue A B N hA hB hN i) =
      ∏ i, latticeSuccessiveMinimum (rationalBoxLattice A B N hA hB hN) i :=
    Equiv.prod_comp (boxDimensionEquiv d) _
  rw [hp]
  have h := latticeSuccessiveMinimum_product_bounds (rationalBoxLattice A B N hA hB hN)
  rw [rationalBoxLattice_covolume] at h
  simpa only [BoxEuclidean, finrank_euclideanSpace, Fintype.card_fin] using h

def box_prefix_finCongr {d n m : ℕ} (hn : n = m) (v : Fin m → BoxEuclidean d) (k : ℕ) :
    latticePrefixSpan (v ∘ finCongr hn) k = latticePrefixSpan v k := by
  subst m
  rfl

def box_prefix_map {d n : ℕ} (v : Fin n → BoxEuclidean d)
    (f : BoxEuclidean d ≃ₗ[ℝ] BoxEuclidean d) (k : ℕ) :
    (latticePrefixSpan v k).map f.toLinearMap = latticePrefixSpan (f ∘ v) k := by
  rw [latticePrefixSpan, Submodule.map_span, Set.image_image]
  rfl

end
end Bounty

end SubmissionComponent_RationalBoxLattice

/- Component DavenportBasisRounding; SHA256 2a4947a7306e1017ca39d6a46e094ec385d6a50b9123f5a9171f1ed261010674 -/
section SubmissionComponent_DavenportBasisRounding
/- Gaussian maximum-pivot elimination for the Davenport construction.
Columns are indexed from zero.  Elimination of n preceding pivots costs at
most 2^n in the coordinate bound. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Module

def davenportPivotStep {d : ℕ} (u x : Fin d → ℝ) (p : Fin d) : Fin d → ℝ :=
  x - (x p / u p) • u

def davenportPivotStep_zero {d : ℕ} (u x : Fin d → ℝ) (p : Fin d) (hp : u p ≠ 0) :
    davenportPivotStep u x p p = 0 := by
  simp [davenportPivotStep, div_mul_cancel₀ _ hp]

def davenportPivotStep_bound {d : ℕ} (u x : Fin d → ℝ) (p : Fin d)
    (hp : u p ≠ 0) (hdom : ∀ r, |u r| ≤ |u p|) {R : ℝ}
    (hx : ∀ r, |x r| ≤ R) : ∀ r, |davenportPivotStep u x p r| ≤ 2 * R := by
  intro r
  have hpos : 0 < |u p| := abs_pos.mpr hp
  have hmul : |(x p / u p) * u r| ≤ |x p| := by
    rw [abs_mul, abs_div]
    calc
      |x p| / |u p| * |u r| ≤ |x p| / |u p| * |u p| :=
        mul_le_mul_of_nonneg_left (hdom r) (div_nonneg (abs_nonneg _) hpos.le)
      _ = _ := div_mul_cancel₀ _ hpos.ne'
  change |x r - (x p / u p) * u r| ≤ _
  have ht := abs_sub_le (x r) 0 ((x p / u p) * u r)
  simp only [sub_zero, zero_sub, abs_neg] at ht
  linarith [hx r, hx p]

/-- Eliminate all preceding pivots, retaining an explicit residual, span
relation, zero pivot coordinates, and a uniform coordinate bound. -/
def exists_davenport_elimination {n d : ℕ}
    (u : Fin n → Fin d → ℝ) (p : Fin n → Fin d)
    (hp : ∀ i, u i (p i) ≠ 0)
    (hdom : ∀ i r, |u i r| ≤ |u i (p i)|)
    (hzero : ∀ i j, i < j → u j (p i) = 0)
    (x : Fin d → ℝ) {R : ℝ} (hR : 0 ≤ R) (hx : ∀ r, |x r| ≤ R) :
    ∃ y : Fin d → ℝ, y - x ∈ Submodule.span ℝ (Set.range u) ∧
      (∀ i, y (p i) = 0) ∧ (∀ r, |y r| ≤ (2 : ℝ) ^ n * R) := by
  induction n generalizing x R with
  | zero =>
      refine ⟨x, by simp, fun i => Fin.elim0 i, ?_⟩
      simpa using hx
  | succ n ih =>
      let u' : Fin n → Fin d → ℝ := fun i => u i.succ
      let p' : Fin n → Fin d := fun i => p i.succ
      let x' := davenportPivotStep (u 0) x (p 0)
      have hx' : ∀ r, |x' r| ≤ 2 * R := davenportPivotStep_bound _ _ _ (hp 0) (hdom 0) hx
      obtain ⟨y, hyspan, hyzero, hybound⟩ := ih u' p' (fun i => hp i.succ)
        (fun i => hdom i.succ) (fun i j hij => hzero i.succ j.succ (Fin.succ_lt_succ_iff.mpr hij))
        x' (mul_nonneg (by norm_num) hR) hx'
      have hsub : Submodule.span ℝ (Set.range u') ≤ Submodule.span ℝ (Set.range u) := by
        apply Submodule.span_mono
        rintro _ ⟨i, rfl⟩
        exact ⟨i.succ, rfl⟩
      have hxspan : x' - x ∈ Submodule.span ℝ (Set.range u) := by
        have hu : u 0 ∈ Submodule.span ℝ (Set.range u) := Submodule.subset_span ⟨0, rfl⟩
        convert (Submodule.span ℝ (Set.range u)).smul_mem (-(x (p 0) / u 0 (p 0))) hu using 1
        ·
          simp [x', davenportPivotStep, sub_eq_add_neg, add_assoc]
      have hspan : y - x ∈ Submodule.span ℝ (Set.range u) := by
        convert (Submodule.span ℝ (Set.range u)).add_mem (hsub hyspan) hxspan using 1
        · abel
      have hker : Submodule.span ℝ (Set.range u') ≤ LinearMap.ker (LinearMap.proj (p 0)) := by
        apply Submodule.span_le.mpr
        rintro _ ⟨i, rfl⟩
        exact hzero 0 i.succ (Fin.succ_pos i)
      have hz0 : y (p 0) = 0 := by
        have hz := hker hyspan
        change y (p 0) - x' (p 0) = 0 at hz
        rw [show x' (p 0) = 0 from davenportPivotStep_zero _ _ _ (hp 0)] at hz
        simpa using hz
      refine ⟨y, hspan, Fin.cases hz0 hyzero, ?_⟩
      intro r
      calc
        |y r| ≤ (2 : ℝ) ^ n * (2 * R) := hybound r
        _ = (2 : ℝ) ^ (n + 1) * R := by rw [pow_succ]; ring

/-- Extending two equal prefix spans by vectors differing within that span
preserves equality of the extended spans. -/
def davenport_span_snoc {n d : ℕ} (u g : Fin n → Fin d → ℝ) (y x : Fin d → ℝ)
    (hspan : Submodule.span ℝ (Set.range u) = Submodule.span ℝ (Set.range g))
    (hy : y - x ∈ Submodule.span ℝ (Set.range g)) :
    Submodule.span ℝ (Set.range (Fin.snoc u y)) =
      Submodule.span ℝ (Set.range (Fin.snoc g x)) := by
  have hu : Submodule.span ℝ (Set.range u) ≤ Submodule.span ℝ (Set.range (Fin.snoc u y)) := by
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨i.castSucc, by simp⟩
  have hg : Submodule.span ℝ (Set.range g) ≤ Submodule.span ℝ (Set.range (Fin.snoc g x)) := by
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨i.castSucc, by simp⟩
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.snoc_last]
      have hx := Submodule.subset_span (R := ℝ) (s := Set.range (Fin.snoc g x))
        (Set.mem_range_self (Fin.last n))
      simp only [Fin.snoc_last] at hx
      have hc := (Submodule.span ℝ (Set.range (Fin.snoc g x))).add_mem (hg hy) hx
      rw [sub_add_cancel] at hc
      exact hc
    · simp only [Fin.snoc_castSucc]
      exact hg (hspan ▸ Submodule.subset_span ⟨j, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.snoc_last]
      have hy' := Submodule.subset_span (R := ℝ) (s := Set.range (Fin.snoc u y))
        (Set.mem_range_self (Fin.last n))
      simp only [Fin.snoc_last] at hy'
      have hc := (Submodule.span ℝ (Set.range (Fin.snoc u y))).sub_mem hy' (hu (hspan.symm ▸ hy))
      rw [show y - (y - x) = x by abel] at hc
      exact hc
    · simp only [Fin.snoc_castSucc]
      exact hu (hspan.symm ▸ Submodule.subset_span ⟨j, rfl⟩)

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

def davenportPrefixSpan {n : ℕ} (v : Fin n → E) (k : ℕ) : Submodule ℝ E :=
  Submodule.span ℝ (v '' {i | i.val < k})

def davenportPrefixSpan_eq_range {n k : ℕ} (v : Fin n → E) (hk : k ≤ n) :
    davenportPrefixSpan v k =
      Submodule.span ℝ (Set.range (fun j : Fin k => v (Fin.castLE hk j))) := by
  change Submodule.span ℝ _ = Submodule.span ℝ _
  apply congrArg (Submodule.span ℝ)
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i.val, hi⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨Fin.castLE hk j, j.isLt, rfl⟩

def davenportPrefixSpan_full {n : ℕ} (v : Fin n → E) :
    davenportPrefixSpan v n = Submodule.span ℝ (Set.range v) := by
  rw [davenportPrefixSpan_eq_range v le_rfl]
  rfl

def davenportPrefixSpan_snoc {n k : ℕ} (v : Fin n → E) (x : E) (hk : k ≤ n) :
    davenportPrefixSpan (Fin.snoc v x) k = davenportPrefixSpan v k := by
  rw [davenportPrefixSpan_eq_range _ (hk.trans (Nat.le_succ n)), davenportPrefixSpan_eq_range _ hk]
  apply congrArg (Submodule.span ℝ)
  apply congrArg Set.range
  funext j
  rw [show Fin.castLE (hk.trans (Nat.le_succ n)) j = (Fin.castLE hk j).castSucc from rfl]
  simp only [Fin.snoc_castSucc]

structure DavenportGaussianData {n d : ℕ} (g : Fin n → Fin d → ℝ) (lam : Fin n → ℝ) where
  residual : Fin n → Fin d → ℝ
  pivot : Fin n → Fin d
  pivot_injective : Function.Injective pivot
  pivot_ne : ∀ i, residual i (pivot i) ≠ 0
  dominates : ∀ i r, |residual i r| ≤ |residual i (pivot i)|
  zeros : ∀ i j, i < j → residual j (pivot i) = 0
  bound : ∀ i r, |residual i r| ≤ (2 : ℝ) ^ i.val * lam i
  relation : ∀ i, residual i - g i ∈ davenportPrefixSpan g i.val
  span_eq : Submodule.span ℝ (Set.range residual) = Submodule.span ℝ (Set.range g)

/-- Actual Gaussian residuals, with maximum-coordinate pivots and explicit
exponential bounds.  No adapted-basis hypothesis is used. -/
def exists_davenport_gaussian {n d : ℕ} (g : Fin n → Fin d → ℝ) (lam : Fin n → ℝ)
    (hLI : LinearIndependent ℝ g) (hlam : ∀ i, 0 ≤ lam i)
    (hg : ∀ i r, |g i r| ≤ lam i) : Nonempty (DavenportGaussianData g lam) := by
  induction n with
  | zero =>
      exact ⟨⟨g, Fin.elim0, fun i => Fin.elim0 i, fun i => Fin.elim0 i,
        fun i => Fin.elim0 i, fun i => Fin.elim0 i, fun i => Fin.elim0 i,
        fun i => Fin.elim0 i, rfl⟩⟩
  | succ n ih =>
      let g' : Fin n → Fin d → ℝ := fun i => g i.castSucc
      let lam' : Fin n → ℝ := fun i => lam i.castSucc
      have hLI' : LinearIndependent ℝ g' := hLI.comp _ (Fin.castSucc_injective _)
      obtain ⟨G⟩ := ih g' lam' hLI' (fun i => hlam i.castSucc) (fun i => hg i.castSucc)
      obtain ⟨y, hyspan, hyzero, hybound⟩ := exists_davenport_elimination
        G.residual G.pivot G.pivot_ne G.dominates G.zeros (g (Fin.last n))
        (hlam (Fin.last n)) (hg (Fin.last n))
      have hyspan' : y - g (Fin.last n) ∈ Submodule.span ℝ (Set.range g') :=
        G.span_eq ▸ hyspan
      have hyne : y ≠ 0 := by
        intro hy
        have hlast : g (Fin.last n) ∉ Submodule.span ℝ (Set.range g') := by
          have hh := hLI.notMem_span_image (s := Set.range (Fin.castSucc : Fin n → Fin (n+1)))
            (x := Fin.last n) (by simp)
          simpa only [← Set.range_comp, Function.comp_def] using hh
        apply hlast
        have hn := (Submodule.span ℝ (Set.range g')).neg_mem hyspan'
        simpa [hy] using hn
      obtain ⟨r, hr⟩ : ∃ r, y r ≠ 0 := by
        by_contra! hh
        exact hyne (funext hh)
      obtain ⟨p, _, hpmax⟩ := Finset.exists_max_image Finset.univ (fun r => |y r|)
        ⟨r, Finset.mem_univ r⟩
      have hpne : y p ≠ 0 := by
        intro hp
        have hh := hpmax r (Finset.mem_univ r)
        rw [hp, abs_zero] at hh
        exact hr (abs_nonpos_iff.mp hh)
      have hpnew : p ∉ Set.range G.pivot := by
        rintro ⟨i, rfl⟩
        exact hpne (hyzero i)
      let u : Fin (n + 1) → Fin d → ℝ := Fin.snoc G.residual y
      let p' : Fin (n + 1) → Fin d := Fin.snoc G.pivot p
      have hgsnoc : Fin.snoc g' (g (Fin.last n)) = g := by
        ext i
        exact Fin.lastCases (by simp) (fun j => by simp [g']) i
      refine ⟨⟨u, p', Fin.snoc_injective_of_injective G.pivot_injective hpnew, ?_, ?_,
        ?_, ?_, ?_, ?_⟩⟩
      · intro i
        exact Fin.lastCases (by simpa [u, p'] using hpne)
          (fun j => by simpa [u, p'] using G.pivot_ne j) i
      · intro i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · simpa [u, p'] using fun r => hpmax r (Finset.mem_univ r)
        · simpa [u, p'] using G.dominates j
      · intro i j
        refine Fin.lastCases ?_ (fun k => ?_) j
        · intro hij
          obtain ⟨l, rfl⟩ := Fin.exists_castSucc_eq.mpr (Fin.ne_last_of_lt hij)
          simpa [u, p'] using hyzero l
        · refine Fin.lastCases ?_ (fun l => ?_) i
          · intro hi
            exact (not_lt_of_ge (Fin.le_last _) hi).elim
          · intro hi
            simpa [u, p'] using G.zeros l k hi
      · intro i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · simpa [u] using hybound
        · simpa [u, lam'] using G.bound j
      · intro i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · change u (Fin.last n) - g (Fin.last n) ∈ davenportPrefixSpan g n
          rw [← hgsnoc, davenportPrefixSpan_snoc _ _ (le_refl n), davenportPrefixSpan_full]
          simpa [u] using hyspan'
        · have hh := G.relation j
          change u j.castSucc - g j.castSucc ∈ davenportPrefixSpan g j.val
          rw [← hgsnoc, davenportPrefixSpan_snoc _ _ (Nat.le_of_lt j.isLt)]
          simpa [u, g'] using hh
      · dsimp [u]
        rw [davenport_span_snoc _ _ _ _ G.span_eq hyspan', hgsnoc]

/-- In the square case the distinct pivot rows give an actual permutation.
The residual bound already has the row/column minimum required by rounding. -/
def exists_davenport_gaussian_permutation {d : ℕ} (g : Fin d → Fin d → ℝ)
    (lam : Fin d → ℝ) (hLI : LinearIndependent ℝ g) (hlam : ∀ i, 0 ≤ lam i)
    (hmono : Monotone lam) (hg : ∀ i r, |g i r| ≤ lam i) :
    ∃ (u : Fin d → Fin d → ℝ) (p : Equiv.Perm (Fin d)),
      (∀ j, u j - g j ∈ davenportPrefixSpan g j.val) ∧
      (∀ i j, i < j → u j (p i) = 0) ∧
      (∀ i, u i (p i) ≠ 0) ∧
      (∀ i r, |u i r| ≤ |u i (p i)|) ∧
      (∀ i j, |u j (p i)| ≤ (2 : ℝ) ^ j.val * min (lam i) (lam j)) := by
  obtain ⟨G⟩ := exists_davenport_gaussian g lam hLI hlam hg
  let p : Equiv.Perm (Fin d) := Equiv.ofBijective G.pivot
    (Finite.injective_iff_bijective.mp G.pivot_injective)
  refine ⟨G.residual, p, G.relation, G.zeros, G.pivot_ne, G.dominates, ?_⟩
  intro i j
  by_cases hij : i < j
  · change |G.residual j (G.pivot i)| ≤ _
    rw [G.zeros i j hij, abs_zero]
    exact mul_nonneg (by positivity) (le_min (hlam i) (hlam j))
  · rw [min_eq_right (hmono (le_of_not_gt hij))]
    exact G.bound j (p i)


end
end Bounty

end SubmissionComponent_DavenportBasisRounding

/- Component DavenportIntegerRounding; SHA256 e19b7f0a452e6cba126fcc004bb82835828690fb0e63912aa6a9f94b1ec0672e -/
section SubmissionComponent_DavenportIntegerRounding
namespace Bounty
noncomputable section
open scoped BigOperators
open Module

def davenport_integer_span_snoc {n d : ℕ} (u g : Fin n → Fin d → ℝ) (y x : Fin d → ℝ)
    (hspan : Submodule.span ℤ (Set.range u) = Submodule.span ℤ (Set.range g))
    (hy : y - x ∈ Submodule.span ℤ (Set.range g)) :
    Submodule.span ℤ (Set.range (Fin.snoc u y)) =
      Submodule.span ℤ (Set.range (Fin.snoc g x)) := by
  have hu : Submodule.span ℤ (Set.range u) ≤ Submodule.span ℤ (Set.range (Fin.snoc u y)) := by
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨i.castSucc, by simp⟩
  have hg : Submodule.span ℤ (Set.range g) ≤ Submodule.span ℤ (Set.range (Fin.snoc g x)) := by
    apply Submodule.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨i.castSucc, by simp⟩
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.snoc_last]
      have hx := Submodule.subset_span (R := ℤ) (s := Set.range (Fin.snoc g x))
        (Set.mem_range_self (Fin.last n))
      simp only [Fin.snoc_last] at hx
      have hc := (Submodule.span ℤ (Set.range (Fin.snoc g x))).add_mem (hg hy) hx
      rw [sub_add_cancel] at hc
      exact hc
    · simp only [Fin.snoc_castSucc]
      exact hg (hspan ▸ Submodule.subset_span ⟨j, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.snoc_last]
      have hy' := Submodule.subset_span (R := ℤ) (s := Set.range (Fin.snoc u y))
        (Set.mem_range_self (Fin.last n))
      simp only [Fin.snoc_last] at hy'
      have hc := (Submodule.span ℤ (Set.range (Fin.snoc u y))).sub_mem hy' (hu (hspan.symm ▸ hy))
      rw [show y - (y - x) = x by abel] at hc
      exact hc
    · simp only [Fin.snoc_castSucc]
      exact hu (hspan.symm ▸ Submodule.subset_span ⟨j, rfl⟩)

variable {E : Type*} [AddCommGroup E]
def davenportIntegerPrefixSpan {n : ℕ} (v : Fin n → E) (k : ℕ) : Submodule ℤ E :=
  Submodule.span ℤ (v '' {i | i.val < k})

def davenportIntegerPrefixSpan_eq_range {n k : ℕ} (v : Fin n → E) (hk : k ≤ n) :
    davenportIntegerPrefixSpan v k =
      Submodule.span ℤ (Set.range (fun j : Fin k => v (Fin.castLE hk j))) := by
  change Submodule.span ℤ _ = Submodule.span ℤ _
  apply congrArg (Submodule.span ℤ)
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i.val, hi⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨Fin.castLE hk j, j.isLt, rfl⟩

def davenportIntegerPrefixSpan_full {n : ℕ} (v : Fin n → E) :
    davenportIntegerPrefixSpan v n = Submodule.span ℤ (Set.range v) := by
  rw [davenportIntegerPrefixSpan_eq_range v le_rfl]
  rfl

def davenportIntegerPrefixSpan_snoc {n k : ℕ} (v : Fin n → E) (x : E) (hk : k ≤ n) :
    davenportIntegerPrefixSpan (Fin.snoc v x) k = davenportIntegerPrefixSpan v k := by
  rw [davenportIntegerPrefixSpan_eq_range _ (hk.trans (Nat.le_succ n)), davenportIntegerPrefixSpan_eq_range _ hk]
  apply congrArg (Submodule.span ℤ)
  apply congrArg Set.range
  funext j
  rw [show Fin.castLE (hk.trans (Nat.le_succ n)) j = (Fin.castLE hk j).castSucc from rfl]
  simp only [Fin.snoc_castSucc]

def davenport_sum_two_pow (n : ℕ) :
    (∑ i : Fin n, (2 : ℝ) ^ i.val) = 2 ^ n - 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Fin.sum_univ_castSucc]
      change (∑ i : Fin n, (2 : ℝ) ^ i.val) + 2 ^ n = 2 ^ (n + 1) - 1
      rw [ih, pow_succ]
      ring

structure DavenportRoundingData {n d : ℕ} (g : Fin n → Fin d → ℝ)
    (lam : Fin n → ℝ) (rho : Fin d → ℝ) where
  vector : Fin n → Fin d → ℝ
  real_span : Submodule.span ℝ (Set.range vector) = Submodule.span ℝ (Set.range g)
  integer_span : Submodule.span ℤ (Set.range vector) = Submodule.span ℤ (Set.range g)
  integer_relation : ∀ j, vector j - g j ∈ davenportIntegerPrefixSpan g j.val
  bound : ∀ j r, |vector j r| ≤ (2 : ℝ) ^ (j.val + 1) * min (rho r) (lam j)

/-- Rounding actual residuals by nearest integers.  Every difference from
the original column lies in the integer span of preceding original columns. -/
def exists_davenport_rounding {n d : ℕ} (g u : Fin n → Fin d → ℝ)
    (lam : Fin n → ℝ) (rho : Fin d → ℝ)
    (hlam : ∀ j, 0 ≤ lam j) (hrho : ∀ r, 0 ≤ rho r) (hmono : Monotone lam)
    (hrel : ∀ j, u j - g j ∈ davenportPrefixSpan g j.val)
    (hu : ∀ j r, |u j r| ≤ (2 : ℝ) ^ j.val * min (rho r) (lam j)) :
    Nonempty (DavenportRoundingData g lam rho) := by
  classical
  induction n with
  | zero =>
      exact ⟨⟨g, rfl, rfl, fun j => Fin.elim0 j, fun j => Fin.elim0 j⟩⟩
  | succ n ih =>
      let g' : Fin n → Fin d → ℝ := fun j => g j.castSucc
      let u' : Fin n → Fin d → ℝ := fun j => u j.castSucc
      let lam' : Fin n → ℝ := fun j => lam j.castSucc
      have hgsnoc : Fin.snoc g' (g (Fin.last n)) = g := by
        ext i
        exact Fin.lastCases (by simp) (fun j => by simp [g']) i
      have hrel' : ∀ j, u' j - g' j ∈ davenportPrefixSpan g' j.val := by
        intro j
        have hh := hrel j.castSucc
        change u' j - g' j ∈ davenportPrefixSpan g j.val at hh
        rw [← hgsnoc, davenportPrefixSpan_snoc _ _ (Nat.le_of_lt j.isLt)] at hh
        exact hh
      obtain ⟨H⟩ := ih g' u' lam' (fun j => hlam j.castSucc)
        (fun i j hij => hmono hij) hrel' (fun j => hu j.castSucc)
      have hlast : u (Fin.last n) - g (Fin.last n) ∈
          Submodule.span ℝ (Set.range H.vector) := by
        rw [H.real_span]
        have hh := hrel (Fin.last n)
        change u (Fin.last n) - g (Fin.last n) ∈ davenportPrefixSpan g n at hh
        rw [← hgsnoc, davenportPrefixSpan_snoc _ _ le_rfl, davenportPrefixSpan_full] at hh
        simpa using hh
      obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hlast
      let w : Fin d → ℝ := g (Fin.last n) + ∑ i, (round (a i) : ℝ) • H.vector i
      have hwsub : w - g (Fin.last n) = ∑ i, (round (a i) : ℝ) • H.vector i := by
        dsimp [w]; abel
      have hwreal : w - g (Fin.last n) ∈ Submodule.span ℝ (Set.range g') := by
        rw [hwsub, ← H.real_span]
        exact Submodule.sum_mem _ fun i _ =>
          Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
      have hwint : w - g (Fin.last n) ∈ Submodule.span ℤ (Set.range g') := by
        rw [hwsub, ← H.integer_span]
        apply Submodule.sum_mem
        intro i _
        rw [Int.cast_smul_eq_zsmul]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
      have hwres : w = u (Fin.last n) + ∑ i, ((round (a i) : ℝ) - a i) • H.vector i := by
        simp_rw [sub_smul, Finset.sum_sub_distrib]
        rw [ha]
        dsimp [w]
        abel
      have hwbound : ∀ r, |w r| ≤ (2 : ℝ) ^ (n + 1) * min (rho r) (lam (Fin.last n)) := by
        intro r
        let M := min (rho r) (lam (Fin.last n))
        have hM : 0 ≤ M := le_min (hrho r) (hlam (Fin.last n))
        have heach : ∀ i : Fin n,
            |((round (a i) : ℝ) - a i) * H.vector i r| ≤ (2 : ℝ) ^ i.val * M := by
          intro i
          have hround : |(round (a i) : ℝ) - a i| ≤ 1 / 2 := by
            simpa only [abs_sub_comm] using abs_sub_round (a i)
          have hmin : min (rho r) (lam' i) ≤ M :=
            min_le_min le_rfl (hmono (Fin.le_last i.castSucc))
          have hh := (H.bound i r).trans (mul_le_mul_of_nonneg_left hmin (by positivity))
          calc
            _ = |(round (a i) : ℝ) - a i| * |H.vector i r| := abs_mul _ _
            _ ≤ (1 / 2) * ((2 : ℝ) ^ (i.val + 1) * M) :=
              mul_le_mul hround hh (abs_nonneg _) (by norm_num)
            _ = (2 : ℝ) ^ i.val * M := by rw [pow_succ]; ring
        have hsum : |∑ i : Fin n, ((round (a i) : ℝ) - a i) * H.vector i r| ≤
            ((2 : ℝ) ^ n - 1) * M := by
          calc
            _ ≤ ∑ i : Fin n, |((round (a i) : ℝ) - a i) * H.vector i r| :=
              Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ i : Fin n, (2 : ℝ) ^ i.val * M := Finset.sum_le_sum fun i _ => heach i
            _ = _ := by rw [← Finset.sum_mul, davenport_sum_two_pow]
        have hh := congrFun hwres r
        simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at hh
        rw [hh]
        calc
          _ ≤ |u (Fin.last n) r| + |∑ i : Fin n, ((round (a i) : ℝ) - a i) * H.vector i r| :=
            abs_add_le _ _
          _ ≤ (2 : ℝ) ^ n * M + (2 ^ n - 1) * M := add_le_add (hu (Fin.last n) r) hsum
          _ ≤ (2 : ℝ) ^ (n + 1) * M := by rw [pow_succ]; nlinarith
      let h : Fin (n + 1) → Fin d → ℝ := Fin.snoc H.vector w
      refine ⟨⟨h, ?_, ?_, ?_, ?_⟩⟩
      · dsimp [h]
        rw [davenport_span_snoc _ _ _ _ H.real_span hwreal, hgsnoc]
      · dsimp [h]
        rw [davenport_integer_span_snoc _ _ _ _ H.integer_span hwint, hgsnoc]
      · intro j
        refine Fin.lastCases ?_ (fun i => ?_) j
        · change h (Fin.last n) - g (Fin.last n) ∈ davenportIntegerPrefixSpan g n
          rw [← hgsnoc, davenportIntegerPrefixSpan_snoc _ _ le_rfl, davenportIntegerPrefixSpan_full]
          simpa [h] using hwint
        · change h i.castSucc - g i.castSucc ∈ davenportIntegerPrefixSpan g i.val
          rw [← hgsnoc, davenportIntegerPrefixSpan_snoc _ _ (Nat.le_of_lt i.isLt)]
          simpa [h, g'] using H.integer_relation i
      · intro j
        refine Fin.lastCases ?_ (fun i => ?_) j
        · simpa [h] using hwbound
        · simpa [h, lam'] using H.bound i

def davenport_integer_prefix_coefficients {n d k : ℕ} (g : Fin n → Fin d → ℝ)
    (x : Fin d → ℝ) (hx : x ∈ davenportIntegerPrefixSpan g k) :
    ∃ c : Fin n → ℤ, x = ∑ i, if i.val < k then (c i : ℝ) • g i else 0 := by
  classical
  let s : Finset (Fin n) := Finset.univ.filter fun i => i.val < k
  have hs : (s : Set (Fin n)) = {i | i.val < k} := by ext i; simp [s]
  change x ∈ Submodule.span ℤ (g '' {i | i.val < k}) at hx
  rw [← hs] at hx
  obtain ⟨c, hc⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' (R := ℤ)).mp hx
  refine ⟨c, ?_⟩
  simpa only [s, Finset.sum_filter, Int.cast_smul_eq_zsmul] using hc.symm

def davenport_integer_span_of_relation {n d : ℕ} (h g : Fin n → Fin d → ℝ)
    (hrel : ∀ j, h j - g j ∈ davenportIntegerPrefixSpan g j.val) :
    Submodule.span ℤ (Set.range h) = Submodule.span ℤ (Set.range g) := by
  induction n with
  | zero => simp
  | succ n ih =>
      let h' : Fin n → Fin d → ℝ := fun i => h i.castSucc
      let g' : Fin n → Fin d → ℝ := fun i => g i.castSucc
      have hh : Fin.snoc h' (h (Fin.last n)) = h := by ext i; exact Fin.lastCases (by simp) (fun j => by simp [h']) i
      have hg : Fin.snoc g' (g (Fin.last n)) = g := by ext i; exact Fin.lastCases (by simp) (fun j => by simp [g']) i
      have hrel' : ∀ j, h' j - g' j ∈ davenportIntegerPrefixSpan g' j.val := by
        intro j
        have ht := hrel j.castSucc
        change h' j - g' j ∈ davenportIntegerPrefixSpan g j.val at ht
        rw [← hg, davenportIntegerPrefixSpan_snoc _ _ (Nat.le_of_lt j.isLt)] at ht
        exact ht
      have hs := ih h' g' hrel'
      have hl : h (Fin.last n) - g (Fin.last n) ∈ Submodule.span ℤ (Set.range g') := by
        have ht := hrel (Fin.last n)
        change h (Fin.last n) - g (Fin.last n) ∈ davenportIntegerPrefixSpan g n at ht
        rw [← hg, davenportIntegerPrefixSpan_snoc _ _ le_rfl, davenportIntegerPrefixSpan_full] at ht
        simpa using ht
      simpa only [hh, hg] using davenport_integer_span_snoc h' g' _ _ hs hl

def davenportIntegerPrefixSpan_restrict {n k l : ℕ} (g : Fin n → E)
    (hk : k ≤ n) (hl : l ≤ k) :
    davenportIntegerPrefixSpan (fun i : Fin k => g (Fin.castLE hk i)) l =
      davenportIntegerPrefixSpan g l := by
  rw [davenportIntegerPrefixSpan_eq_range _ hl,
    davenportIntegerPrefixSpan_eq_range _ (hl.trans hk)]
  rfl

def davenport_integer_prefixes_of_relation {n d : ℕ} (h g : Fin n → Fin d → ℝ)
    (hrel : ∀ j, h j - g j ∈ davenportIntegerPrefixSpan g j.val) (k : ℕ) (hk : k ≤ n) :
    davenportIntegerPrefixSpan h k = davenportIntegerPrefixSpan g k := by
  rw [davenportIntegerPrefixSpan_eq_range _ hk, davenportIntegerPrefixSpan_eq_range _ hk]
  apply davenport_integer_span_of_relation
  intro j
  rw [davenportIntegerPrefixSpan_restrict _ hk (Nat.le_of_lt j.isLt)]
  exact hrel (Fin.castLE hk j)

def davenport_rational_prefixes_of_relation {n d : ℕ} (h g : Fin n → Fin d → ℝ)
    (hrel : ∀ j, h j - g j ∈ davenportIntegerPrefixSpan g j.val) (k : ℕ) (hk : k ≤ n) :
    Submodule.span ℚ (h '' {i | i.val < k}) = Submodule.span ℚ (g '' {i | i.val < k}) := by
  have hh := congrArg (fun S : Submodule ℤ (Fin d → ℝ) => Submodule.span ℚ (S : Set (Fin d → ℝ)))
    (davenport_integer_prefixes_of_relation h g hrel k hk)
  simpa only [davenportIntegerPrefixSpan, Submodule.span_span_of_tower] using hh

/-- The actual integer change-of-columns matrix. -/
def davenportIntegerMatrix {n : ℕ} (z : Fin n → Fin n → ℤ) : Matrix (Fin n) (Fin n) ℤ :=
  1 + Matrix.of (fun i j => if i < j then z j i else 0)

def davenportIntegerMatrix_upper {n : ℕ} (z : Fin n → Fin n → ℤ) :
    (davenportIntegerMatrix z).IsUpperTriangular := by
  intro i j hij
  change j < i at hij
  simp [davenportIntegerMatrix, ne_of_gt hij, not_lt_of_ge hij.le]

def davenportIntegerMatrix_diag {n : ℕ} (z : Fin n → Fin n → ℤ) (i : Fin n) :
    davenportIntegerMatrix z i i = 1 := by simp [davenportIntegerMatrix]

def davenportIntegerMatrix_det {n : ℕ} (z : Fin n → Fin n → ℤ) :
    (davenportIntegerMatrix z).det = 1 := by
  rw [Matrix.det_of_isUpperTriangular (davenportIntegerMatrix_upper z)]
  change (∏ i : Fin n, davenportIntegerMatrix z i i) = 1
  simp only [davenportIntegerMatrix_diag, Finset.prod_const_one]

def davenport_integer_matrix_identity {n d : ℕ} (h g : Fin n → Fin d → ℝ)
    (z : Fin n → Fin n → ℤ)
    (hexp : ∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0) :
    Matrix.of (fun i j => h j i) = Matrix.of (fun i j => g j i) *
      (davenportIntegerMatrix z).map (Int.castRingHom ℝ) := by
  classical
  have hmap : (davenportIntegerMatrix z).map (Int.castRingHom ℝ) =
      1 + Matrix.of (fun i j => if i < j then (z j i : ℝ) else 0) := by
    ext i j
    simp [davenportIntegerMatrix, Matrix.map_apply, Matrix.one_apply]
  rw [hmap, Matrix.mul_add, Matrix.mul_one]
  ext i j
  change h j i = g j i + ∑ k, g k i * (if k < j then (z j k : ℝ) else 0)
  rw [hexp j]
  simp only [Pi.add_apply, Finset.sum_apply]
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  split_ifs <;> simp [mul_comm]

def davenport_integer_det_identity {d : ℕ} (h g : Fin d → Fin d → ℝ)
    (z : Fin d → Fin d → ℤ)
    (hexp : ∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0) :
    (Matrix.of (fun i j => h j i)).det = (Matrix.of (fun i j => g j i)).det := by
  rw [davenport_integer_matrix_identity h g z hexp, Matrix.det_mul]
  have hd := (Int.castRingHom ℝ).map_det (davenportIntegerMatrix z)
  change ((davenportIntegerMatrix z).det : ℝ) = ((davenportIntegerMatrix z).map (Int.castRingHom ℝ)).det at hd
  rw [← hd, davenportIntegerMatrix_det]
  simp

def exists_davenport_integer_rounding {d : ℕ} (g : Fin d → Fin d → ℝ)
    (lam : Fin d → ℝ) (hLI : LinearIndependent ℝ g) (hlam : ∀ j, 0 ≤ lam j)
    (hmono : Monotone lam) (hg : ∀ j r, |g j r| ≤ lam j) :
    ∃ (p : Equiv.Perm (Fin d)) (h : Fin d → Fin d → ℝ) (z : Fin d → Fin d → ℤ),
      (∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0) ∧
      (∀ k, k ≤ d → davenportIntegerPrefixSpan h k = davenportIntegerPrefixSpan g k) ∧
      (Matrix.of (fun i j => h j i)).det = (Matrix.of (fun i j => g j i)).det ∧
      LinearIndependent ℝ h ∧
      (∀ k, k ≤ d → Submodule.span ℚ (h '' {i | i.val < k}) =
        Submodule.span ℚ (g '' {i | i.val < k})) ∧
      (∀ i j, |h j (p i)| ≤ (2 : ℝ) ^ (j.val + 1) * min (lam i) (lam j)) := by
  classical
  obtain ⟨u, p, hrel, _, _, _, hu⟩ := exists_davenport_gaussian_permutation g lam hLI hlam hmono hg
  let rho : Fin d → ℝ := fun r => lam (p.symm r)
  have hur : ∀ j r, |u j r| ≤ (2 : ℝ) ^ j.val * min (rho r) (lam j) := by
    intro j r
    simpa [rho] using hu (p.symm r) j
  obtain ⟨H⟩ := exists_davenport_rounding g u lam rho hlam (fun r => hlam (p.symm r)) hmono hrel hur
  have hcoeff : ∀ j, ∃ c : Fin d → ℤ,
      H.vector j - g j = ∑ i, if i < j then (c i : ℝ) • g i else 0 := by
    intro j
    exact davenport_integer_prefix_coefficients g _ (H.integer_relation j)
  choose z hz using hcoeff
  have hexp : ∀ j, H.vector j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0 := by
    intro j
    rw [← hz j]
    abel
  have hLIH : LinearIndependent ℝ H.vector := by
    apply linearIndependent_iff_card_eq_finrank_span.mpr
    change Fintype.card (Fin d) = finrank ℝ (Submodule.span ℝ (Set.range H.vector))
    rw [H.real_span]
    exact (finrank_span_eq_card hLI).symm
  refine ⟨p, H.vector, z, hexp, davenport_integer_prefixes_of_relation _ _ H.integer_relation,
    davenport_integer_det_identity _ _ z hexp, hLIH,
    davenport_rational_prefixes_of_relation _ _ H.integer_relation, ?_⟩
  intro i j
  simpa [rho] using H.bound j (p i)

/-- Uniform dimension-only version, useful for compound-coordinate bounds. -/
def exists_davenport_integer_rounding_uniform {d : ℕ} (g : Fin d → Fin d → ℝ)
    (lam : Fin d → ℝ) (hLI : LinearIndependent ℝ g) (hlam : ∀ j, 0 ≤ lam j)
    (hmono : Monotone lam) (hg : ∀ j r, |g j r| ≤ lam j) :
    ∃ (p : Equiv.Perm (Fin d)) (h : Fin d → Fin d → ℝ) (z : Fin d → Fin d → ℤ),
      (∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0) ∧
      (∀ k, k ≤ d → davenportIntegerPrefixSpan h k = davenportIntegerPrefixSpan g k) ∧
      (Matrix.of (fun i j => h j i)).det = (Matrix.of (fun i j => g j i)).det ∧
      LinearIndependent ℝ h ∧
      (∀ k, k ≤ d → Submodule.span ℚ (h '' {i | i.val < k}) =
        Submodule.span ℚ (g '' {i | i.val < k})) ∧
      (∀ i j, |h j (p i)| ≤ (2 : ℝ) ^ d * min (lam i) (lam j)) := by
  obtain ⟨p, h, z, he, hp, hd, hli, hq, hb⟩ :=
    exists_davenport_integer_rounding g lam hLI hlam hmono hg
  refine ⟨p, h, z, he, hp, hd, hli, hq, ?_⟩
  intro i j
  apply (hb i j).trans
  apply mul_le_mul_of_nonneg_right _ (le_min (hlam i) (hlam j))
  exact pow_le_pow_right₀ (by norm_num) (Nat.succ_le_of_lt j.isLt)


end
end Bounty

end SubmissionComponent_DavenportIntegerRounding

/- Component RationalBoxDavenport; SHA256 01569f5c5577238df54d5078dd1ac7c97ef937c145158b3787cfbab9de15425c -/
section SubmissionComponent_RationalBoxDavenport
/- Integer Davenport columns for the actual rational rectangular lattice.
The minima used here are Euclidean minima of the transformed lattice. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module

def diagonalIntegerPoint_integer_expansion {d : ℕ} (N : Fin d → ℕ)
    (g h : Fin d → BoxEuclidean d) (z : Fin d → Fin d → ℤ)
    (hg : ∀ j, ∃ a : Fin d → ℤ, g j = diagonalIntegerPoint N a)
    (hexp : ∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0) :
    ∀ j, ∃ b : Fin d → ℤ, h j = diagonalIntegerPoint N b := by
  classical
  choose a ha using hg
  intro j
  refine ⟨fun r => a j r + ∑ i, if i < j then z j i * a i r else 0, ?_⟩
  rw [hexp j]
  simp_rw [ha]
  ext r
  simp only [PiLp.add_apply, WithLp.ofLp_sum, Finset.sum_apply, apply_ite,
    diagonalIntegerPoint, WithLp.ofLp_toLp, Int.cast_add, Int.cast_sum,
    Int.cast_mul, Int.cast_zero]
  rw [mul_add, Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  split_ifs <;> simp [mul_left_comm]

/-- Actual diagonal-integer columns with the Davenport bound.  Their
integer change-of-columns matrix has diagonal one and determinant one. -/
def exists_rationalBox_davenport {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) :
    ∃ (p : Equiv.Perm (Fin d)) (h : Fin d → BoxEuclidean d)
      (z : Fin d → Fin d → ℤ),
      (∀ j, h j = rationalBoxMinimumPoints A B N hA hB hN j +
        ∑ i, if i < j then (z j i : ℝ) • rationalBoxMinimumPoints A B N hA hB hN i else 0) ∧
      (∀ j, ∃ b : Fin d → ℤ, h j = diagonalIntegerPoint N b) ∧
      LinearIndependent ℝ h ∧
      (∀ k, k ≤ d → Submodule.span ℚ (h '' {i | i.val < k}) =
        Submodule.span ℚ (rationalBoxMinimumPoints A B N hA hB hN '' {i | i.val < k})) ∧
      (∀ k, k ≤ d → latticePrefixSpan h k =
        latticePrefixSpan (rationalBoxMinimumPoints A B N hA hB hN) k) ∧
      (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.det h =
        (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.det (rationalBoxMinimumPoints A B N hA hB hN) ∧
      (∀ i j, |(A.map (Rat.castHom ℝ) *ᵥ WithLp.ofLp (h j)) (p i)| ≤
        (2 : ℝ) ^ d * B (p i) * min (rationalBoxMinimumValue A B N hA hB hN i)
          (rationalBoxMinimumValue A B N hA hB hN j)) := by
  classical
  let g := rationalBoxMinimumPoints A B N hA hB hN
  let lam := rationalBoxMinimumValue A B N hA hB hN
  let T := rationalBoxTransform A B hA hB
  let F : BoxEuclidean d ≃ₗ[ℝ] (Fin d → ℝ) := T.trans (WithLp.linearEquiv 2 ℝ (Fin d → ℝ))
  let y : Fin d → Fin d → ℝ := fun j => F (g j)
  have hyLI : LinearIndependent ℝ y := (rationalBoxMinimumPoints_independent A B N hA hB hN).map'
    F.toLinearMap (LinearMap.ker_eq_bot.mpr F.injective)
  have hyb : ∀ j r, |y j r| ≤ lam j := by
    intro j r
    have hh := PiLp.norm_apply_le (T (g j)) r
    rw [Real.norm_eq_abs, rationalBoxMinimumPoints_attain] at hh
    exact hh
  obtain ⟨p, v, z, hexp, hint, _, hvLI, hq, hb⟩ := exists_davenport_integer_rounding_uniform
    y lam hyLI (fun j => (rationalBoxMinimumValue_pos A B N hA hB hN j).le)
    (rationalBoxMinimumValue_monotone A B N hA hB hN) hyb
  let h : Fin d → BoxEuclidean d := fun j => F.symm (v j)
  have he : ∀ j, h j = g j + ∑ i, if i < j then (z j i : ℝ) • g i else 0 := by
    intro j
    have hh := congrArg F.symm (hexp j)
    simpa only [map_add, map_sum, apply_ite, map_smul, map_zero, y, LinearEquiv.symm_apply_apply] using hh
  have hpref (R : Type) [Field R] [Algebra R ℝ]
      (heq : ∀ k, k ≤ d → Submodule.span R (v '' {i | i.val < k}) =
        Submodule.span R (y '' {i | i.val < k})) (k : ℕ) (hk : k ≤ d) :
      Submodule.span R (h '' {i | i.val < k}) = Submodule.span R (g '' {i | i.val < k}) := by
    have hh := congrArg (Submodule.map (F.symm.restrictScalars R).toLinearMap) (heq k hk)
    simp only [Submodule.map_span, Set.image_image] at hh
    simpa only [LinearEquiv.coe_toLinearMap, LinearEquiv.restrictScalars_apply, Function.comp_def,
      y, LinearEquiv.symm_apply_apply] using hh
  have hr : ∀ k, k ≤ d → Submodule.span ℝ (v '' {i | i.val < k}) =
      Submodule.span ℝ (y '' {i | i.val < k}) := by
    intro k hk
    have hh := congrArg (fun S : Submodule ℤ (Fin d → ℝ) => Submodule.span ℝ (S : Set (Fin d → ℝ)))
      (hint k hk)
    simpa only [davenportIntegerPrefixSpan, Submodule.span_span_of_tower] using hh
  refine ⟨p, h, z, he, diagonalIntegerPoint_integer_expansion N g h z
    (rationalBoxMinimumPoints_integral A B N hA hB hN) he,
    hvLI.map' F.symm.toLinearMap (LinearMap.ker_eq_bot.mpr F.symm.injective),
    hpref ℚ hq, hpref ℝ hr,
    orthogonal_expansion_det (EuclideanSpace.basisFun (Fin d) ℝ).toBasis h g
      (fun j i => (z j i : ℝ)) he, ?_⟩
  intro i j
  have hF : T (h j) = WithLp.toLp 2 (v j) := by
    apply (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).injective
    exact F.apply_symm_apply (v j)
  have hh := hb i j
  rw [show v j (p i) = T (h j) (p i) by rw [hF],
    rationalBoxTransform_apply, abs_div, abs_of_pos (hB (p i))] at hh
  have hm := (div_le_iff₀ (hB (p i))).mp hh
  calc
    _ ≤ (2 : ℝ) ^ d * min (lam i) (lam j) * B (p i) := hm
    _ = _ := by ring


end
end Bounty

end SubmissionComponent_RationalBoxDavenport

/- Component EuclideanMinimumGap; SHA256 eb19d99235bd324f1eb9ee90ae74787413b9653f7f3642701df7fe11ca5b36f6 -/
section SubmissionComponent_EuclideanMinimumGap
/- Quantitative gaps selected above the Euclidean radius of the whole box.
The factor (sqrt d)^d is essential: these are Euclidean, not sup-norm minima. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Module

/-- A product exceeding the no-gap bound forces a large adjacent gap whose
upper endpoint also exceeds the specified domain radius. -/
def finite_positive_minima_gap {d : ℕ} (hd : 0 < d) (lam : Fin d → ℝ)
    {R G : ℝ} (hR : 0 ≤ R) (hG : 1 ≤ G) (hlam : ∀ i, 0 ≤ lam i)
    (hfirst : lam ⟨0, hd⟩ ≤ R)
    (hprod : R ^ d * G ^ (d * (d - 1)) < ∏ i, lam i) :
    ∃ i j : Fin d, j.val = i.val + 1 ∧ R < lam j ∧ G * lam i < lam j := by
  classical
  by_contra! hn
  have hb : ∀ i : Fin d, lam i ≤ R * G ^ i.val := by
    cases d with
    | zero => omega
    | succ n =>
        intro i
        refine Fin.induction ?_ (fun j ih => ?_) i
        · simpa using hfirst
        · by_cases hh : lam j.succ ≤ R
          · exact hh.trans (le_mul_of_one_le_right hR (one_le_pow₀ hG))
          · have hstep : lam j.succ ≤ G * lam j.castSucc :=
              hn j.castSucc j.succ rfl (lt_of_not_ge hh)
            calc
              _ ≤ G * lam j.castSucc := hstep
              _ ≤ G * (R * G ^ j.val) := mul_le_mul_of_nonneg_left ih (le_trans (by norm_num) hG)
              _ = R * G ^ j.succ.val := by simp only [Fin.val_succ, pow_succ]; ring
  have hb' : ∀ i, lam i ≤ R * G ^ (d - 1) := by
    intro i
    apply (hb i).trans
    apply mul_le_mul_of_nonneg_left _ hR
    exact pow_le_pow_right₀ hG (by omega)
  have hp : (∏ i, lam i) ≤ R ^ d * G ^ (d * (d - 1)) := by
    calc
      _ ≤ ∏ _i : Fin d, R * G ^ (d - 1) :=
        Finset.prod_le_prod (fun i _ => hlam i) (fun i _ => hb' i)
      _ = (R * G ^ (d - 1)) ^ d := by simp
      _ = _ := by rw [mul_pow, ← pow_mul, Nat.mul_comm (d - 1) d]
  exact (not_le_of_gt hprod) hp

/-- The actual original-coordinate diagonal-integer rectangular domain. -/
def rationalDiagonalBoxDomain {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) : Set (BoxEuclidean d) :=
  {x | ∃ z : Fin d → ℤ, x = diagonalIntegerPoint N z ∧ rationalBoxContains A B x}

def rationalBoxMinimumPoints_short_mem_prefix {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d) (z : Fin d → ℤ)
    (hz : ‖rationalBoxTransform A B hA hB (diagonalIntegerPoint N z)‖ <
      rationalBoxMinimumValue A B N hA hB hN i) :
    diagonalIntegerPoint N z ∈ latticePrefixSpan (rationalBoxMinimumPoints A B N hA hB hN) i.val := by
  let L := rationalBoxLattice A B N hA hB hN
  let T := rationalBoxTransform A B hA hB
  have hm := (latticeMinimumVectors_spec L).short_mem_prefix (boxDimensionEquiv d i)
    ((rationalBoxLattice_mem_iff A B N hA hB hN _).mpr ⟨z, rfl⟩) hz
  have hb : diagonalIntegerPoint N z ∈
      (latticePrefixSpan (latticeMinimumVectors L) i.val).map T.symm.toLinearMap :=
    ⟨T (diagonalIntegerPoint N z), hm, T.symm_apply_apply _⟩
  rw [box_prefix_map] at hb
  have heq : latticePrefixSpan (rationalBoxMinimumPoints A B N hA hB hN) i.val =
      latticePrefixSpan (T.symm ∘ latticeMinimumVectors L) i.val := by
    change latticePrefixSpan ((T.symm ∘ latticeMinimumVectors L) ∘ boxDimensionEquiv d) i.val = _
    unfold boxDimensionEquiv
    exact box_prefix_finCongr (by simp [BoxEuclidean])
      (T.symm ∘ latticeMinimumVectors L) i.val
  rw [heq]
  exact hb

def rationalDiagonalBoxDomain_mem_prefix {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (B : Fin d → ℝ) (N : Fin d → ℕ) (hA : A.det ≠ 0)
    (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i) (i : Fin d)
    (hi : Real.sqrt d < rationalBoxMinimumValue A B N hA hB hN i) :
    rationalDiagonalBoxDomain A B N ⊆
      latticePrefixSpan (rationalBoxMinimumPoints A B N hA hB hN) i.val := by
  rintro x ⟨z, rfl, hx⟩
  apply rationalBoxMinimumPoints_short_mem_prefix A B N hA hB hN i z
  exact (rationalBoxContains_norm_le_sqrt A B hA hB _ hx).trans_lt hi

def rationalBoxMinimumValue_first_le_domain_radius {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (B : Fin d → ℝ) (N : Fin d → ℕ)
    (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i)
    (hne : ∃ x ∈ rationalDiagonalBoxDomain A B N, x ≠ 0) :
    rationalBoxMinimumValue A B N hA hB hN ⟨0, hd⟩ ≤ Real.sqrt d := by
  obtain ⟨x, ⟨z, rfl, hx⟩, hne⟩ := hne
  let L := rationalBoxLattice A B N hA hB hN
  let T := rationalBoxTransform A B hA hB
  have hm := (latticeMinimumVectors_spec L).2.2 (boxDimensionEquiv d ⟨0, hd⟩)
    (T (diagonalIntegerPoint N z))
    ((rationalBoxLattice_mem_iff A B N hA hB hN _).mpr ⟨z, rfl⟩)
  have hout : T (diagonalIntegerPoint N z) ∉
      latticePrefixSpan (latticeMinimumVectors L) (boxDimensionEquiv d ⟨0, hd⟩).val := by
    change T (diagonalIntegerPoint N z) ∉ latticePrefixSpan (latticeMinimumVectors L) 0
    rw [latticePrefixSpan_zero, Submodule.mem_bot]
    exact fun h => hne (T.injective (h.trans T.map_zero.symm))
  exact (hm hout).trans (rationalBoxContains_norm_le_sqrt A B hA hB _ hx)

/-- A determinant-growth criterion giving an actual containing prefix.
The upper gap endpoint is above sqrt d, so containment is valid for every
point of the rectangular domain, not merely for the Euclidean unit ball. -/
def rationalDiagonalBoxDomain_large_gap {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (B : Fin d → ℝ) (N : Fin d → ℕ)
    (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i)
    (hne : ∃ x ∈ rationalDiagonalBoxDomain A B N, x ≠ 0)
    {G : ℝ} (hG : 1 ≤ G)
    (hdet : (d.factorial : ℝ) * (Real.sqrt d) ^ d * G ^ (d * (d - 1)) <
      |(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i) :
    ∃ i j : Fin d, j.val = i.val + 1 ∧
      Real.sqrt d < rationalBoxMinimumValue A B N hA hB hN j ∧
      G * rationalBoxMinimumValue A B N hA hB hN i < rationalBoxMinimumValue A B N hA hB hN j ∧
      rationalDiagonalBoxDomain A B N ⊆
        latticePrefixSpan (rationalBoxMinimumPoints A B N hA hB hN) j.val ∧
      finrank ℝ (Submodule.span ℝ (rationalDiagonalBoxDomain A B N)) ≤ j.val := by
  have hfac : (0 : ℝ) < d.factorial := by exact_mod_cast Nat.factorial_pos d
  have hp := (rationalBoxMinimumValue_product_bounds A B N hA hB hN).1
  have hprod : (Real.sqrt d) ^ d * G ^ (d * (d - 1)) <
      ∏ i, rationalBoxMinimumValue A B N hA hB hN i := by
    apply lt_of_lt_of_le _ hp
    apply (lt_div_iff₀ hfac).mpr
    nlinarith [hdet]
  obtain ⟨i, j, hij, hj, hgap⟩ := finite_positive_minima_gap hd
    (rationalBoxMinimumValue A B N hA hB hN) (Real.sqrt_nonneg d) hG
    (fun i => (rationalBoxMinimumValue_pos A B N hA hB hN i).le)
    (rationalBoxMinimumValue_first_le_domain_radius hd A B N hA hB hN hne) hprod
  have hsub := rationalDiagonalBoxDomain_mem_prefix A B N hA hB hN j hj
  refine ⟨i, j, hij, hj, hgap, hsub, ?_⟩
  have hh := Submodule.finrank_mono (Submodule.span_le.mpr hsub)
  rw [latticePrefixSpan_finrank (rationalBoxMinimumPoints_independent A B N hA hB hN)
    (Nat.le_of_lt j.isLt)] at hh
  exact hh


end
end Bounty

end SubmissionComponent_EuclideanMinimumGap

/- Component RationalBoxDavenportGap; SHA256 1b6f9c3b7e2c24fc42031cfb0cfeebcb02eff78c77231b0656769ea0355c0f57 -/
section SubmissionComponent_RationalBoxDavenportGap
/- Actual rounded diagonal-lattice columns and a quantitative containing
minimum gap, with the Euclidean sqrt(d) correction included. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module

def exists_rationalBox_davenport_gap {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (B : Fin d → ℝ) (N : Fin d → ℕ)
    (hA : A.det ≠ 0) (hB : ∀ i, 0 < B i) (hN : ∀ i, 0 < N i)
    (hne : ∃ x ∈ rationalDiagonalBoxDomain A B N, x ≠ 0)
    {G : ℝ} (hG : 1 ≤ G)
    (hdet : (d.factorial : ℝ) * (Real.sqrt d) ^ d * G ^ (d * (d - 1)) <
      |(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i) :
    ∃ (p : Equiv.Perm (Fin d)) (h : Fin d → BoxEuclidean d)
      (z : Fin d → Fin d → ℤ) (lo hi : Fin d),
      hi.val = lo.val + 1 ∧
      (∀ j, h j = rationalBoxMinimumPoints A B N hA hB hN j +
        ∑ i, if i < j then (z j i : ℝ) • rationalBoxMinimumPoints A B N hA hB hN i else 0) ∧
      (∀ j, ∃ b : Fin d → ℤ, h j = diagonalIntegerPoint N b) ∧
      LinearIndependent ℝ h ∧
      (∀ k, k ≤ d → Submodule.span ℚ (h '' {i | i.val < k}) =
        Submodule.span ℚ (rationalBoxMinimumPoints A B N hA hB hN '' {i | i.val < k})) ∧
      (∀ i j, |(A.map (Rat.castHom ℝ) *ᵥ WithLp.ofLp (h j)) (p i)| ≤
        (2 : ℝ) ^ d * B (p i) * min (rationalBoxMinimumValue A B N hA hB hN i)
          (rationalBoxMinimumValue A B N hA hB hN j)) ∧
      Real.sqrt d < rationalBoxMinimumValue A B N hA hB hN hi ∧
      G < rationalBoxMinimumValue A B N hA hB hN hi /
        rationalBoxMinimumValue A B N hA hB hN lo ∧
      rationalDiagonalBoxDomain A B N ⊆ latticePrefixSpan h hi.val ∧
      finrank ℝ (latticePrefixSpan h hi.val) = hi.val ∧
      finrank ℝ (Submodule.span ℝ (rationalDiagonalBoxDomain A B N)) ≤ hi.val := by
  obtain ⟨p, h, z, he, hz, hLI, hq, hr, _, hb⟩ := exists_rationalBox_davenport A B N hA hB hN
  obtain ⟨lo, hi, hidx, hhi, hgap, hsub, hrank⟩ :=
    rationalDiagonalBoxDomain_large_gap hd A B N hA hB hN hne hG hdet
  refine ⟨p, h, z, lo, hi, hidx, he, hz, hLI, hq, hb, hhi,
    (lt_div_iff₀ (rationalBoxMinimumValue_pos A B N hA hB hN lo)).mpr hgap, ?_,
    latticePrefixSpan_finrank hLI (Nat.le_of_lt hi.isLt), hrank⟩
  rw [hr hi.val (Nat.le_of_lt hi.isLt)]
  exact hsub


end
end Bounty

end SubmissionComponent_RationalBoxDavenportGap

/- Component PadicCeilingDivisibility; SHA256 b0d3e161676c9fd4d777cf7b7827d1396cfd86de83748d96616ae52eb239bb15 -/
section SubmissionComponent_PadicCeilingDivisibility
/- Exact real exponential cutoffs for integer p-adic norms, including zero. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def padicNorm_int_real_exp (p : ℕ) [Fact p.Prime] (z : ℤ) (hz : z ≠ 0) :
    (padicNorm p (z : ℚ) : ℝ) =
      Real.exp (-((padicValInt p z : ℝ) * Real.log p)) := by
  have hp : (0 : ℝ) < p := by exact_mod_cast (Fact.out : p.Prime).pos
  rw [padicNorm.eq_zpow_of_nonzero (by exact_mod_cast hz), padicValRat.of_int]
  simp only [zpow_neg, zpow_natCast, Rat.cast_inv, Rat.cast_pow, Rat.cast_natCast]
  rw [Real.exp_neg, Real.exp_nat_mul, Real.exp_log hp]

def prime_pow_dvd_int_iff_le_padicVal (p : ℕ) [Fact p.Prime] (z : ℤ)
    (hz : z ≠ 0) (n : ℕ) : ((p ^ n : ℕ) : ℤ) ∣ z ↔ n ≤ padicValInt p z := by
  rw [padicNorm.dvd_iff_norm_le,
    padicNorm.eq_zpow_of_nonzero (by exact_mod_cast hz), padicValRat.of_int,
    zpow_le_zpow_iff_right₀ (by exact_mod_cast (Fact.out : p.Prime).one_lt), neg_le_neg_iff]
  exact_mod_cast Iff.rfl

/-- Exact ceiling conversion.  The zero case is part of the equivalence. -/
def padicNorm_int_le_exp_iff_dvd (p : ℕ) [Fact p.Prime] (z : ℤ) (a : ℝ) :
    (padicNorm p (z : ℚ) : ℝ) ≤ Real.exp (-a) ↔
      ((p ^ Nat.ceil (a / Real.log p) : ℕ) : ℤ) ∣ z := by
  by_cases hz : z = 0
  · subst z
    simp [le_of_lt (Real.exp_pos (-a))]
  have hp : 0 < Real.log (p : ℝ) := Real.log_pos (by exact_mod_cast (Fact.out : p.Prime).one_lt)
  rw [padicNorm_int_real_exp p z hz, Real.exp_le_exp,
    prime_pow_dvd_int_iff_le_padicVal p z hz, Nat.ceil_le, div_le_iff₀ hp]
  constructor <;> intro h <;> linarith

/-- Rounding the prime exponent costs less than a factor p. -/
def prime_ceiling_power_bounds (p : ℕ) (hp : 1 < p) {a : ℝ} (ha : 0 ≤ a) :
    Real.exp a ≤ (p : ℝ) ^ Nat.ceil (a / Real.log p) ∧
      (p : ℝ) ^ Nat.ceil (a / Real.log p) < p * Real.exp a := by
  have hpl : 0 < Real.log (p : ℝ) := Real.log_pos (by exact_mod_cast hp)
  have hpp : (0 : ℝ) < p := by exact_mod_cast (by omega : 0 < p)
  have he : (p : ℝ) ^ Nat.ceil (a / Real.log p) =
      Real.exp ((Nat.ceil (a / Real.log p) : ℝ) * Real.log p) := by
    rw [Real.exp_nat_mul, Real.exp_log hpp]
  rw [he]
  constructor
  · apply Real.exp_le_exp.mpr
    exact (div_le_iff₀ hpl).mp (Nat.le_ceil _)
  · have hh := Nat.ceil_lt_add_one (div_nonneg ha hpl.le)
    have hm := mul_lt_mul_of_pos_right hh hpl
    have hab : (Nat.ceil (a / Real.log p) : ℝ) * Real.log p < a + Real.log p := by
      simpa only [add_mul, div_mul_cancel₀ _ hpl.ne', one_mul] using hm
    have hx := Real.exp_lt_exp.mpr hab
    simpa only [Real.exp_add, Real.exp_log hpp, mul_comm] using hx


end
end Bounty

end SubmissionComponent_PadicCeilingDivisibility

/- Component RationalThreePlaceDomain; SHA256 c8c7aec46a3a7180a2a476a04289d2c880fd7430c3dbd4f6c42d4310b26480fd -/
section SubmissionComponent_RationalThreePlaceDomain
/- Exact equality of the three-place integer domain and a diagonal lattice box. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def integerEuclideanPoint {d : ℕ} (x : Fin d → ℤ) : BoxEuclidean d :=
  WithLp.toLp 2 (fun i => (x i : ℝ))

def rationalThreePlaceDomain {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) : Set (Fin d → ℤ) :=
  {x | (∀ i, |(A.map (Rat.castHom ℝ) *ᵥ (fun j => (x j : ℝ))) i| ≤ Real.exp (c 0 i * q)) ∧
    (∀ i, (padicNorm 2 (x i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q)) ∧
    (∀ i, (padicNorm 3 (x i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q))}

def threePlaceWidth {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (i : Fin d) : ℝ :=
  Real.exp (c 0 i * q)

def threePlaceDiagonal {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (i : Fin d) : ℕ :=
  2 ^ Nat.ceil (-(c 1 i * q) / Real.log 2) * 3 ^ Nat.ceil (-(c 2 i * q) / Real.log 3)

def threePlaceWidth_pos {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (i : Fin d) :
    0 < threePlaceWidth c q i := Real.exp_pos _

def threePlaceDiagonal_pos {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (i : Fin d) :
    0 < threePlaceDiagonal c q i := by unfold threePlaceDiagonal; positivity

def two_three_pow_dvd_int_iff (u v : ℕ) (x : ℤ) :
    (((2 ^ u * 3 ^ v : ℕ) : ℤ) ∣ x) ↔
      (((2 ^ u : ℕ) : ℤ) ∣ x) ∧ (((3 ^ v : ℕ) : ℤ) ∣ x) := by
  rw [Nat.cast_mul]
  constructor
  · intro h
    exact ⟨(dvd_mul_right _ _).trans h, (dvd_mul_left _ _).trans h⟩
  · rintro ⟨h2, h3⟩
    have hc : Nat.Coprime (2 ^ u) (3 ^ v) := (by norm_num : Nat.Coprime 2 3).pow u v
    exact hc.isCoprime.mul_dvd h2 h3

def threePlaceDiagonal_dvd_iff {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    (q : ℝ) (i : Fin d) (x : ℤ) :
    ((threePlaceDiagonal c q i : ℤ) ∣ x) ↔
      (padicNorm 2 (x : ℚ) : ℝ) ≤ Real.exp (c 1 i * q) ∧
      (padicNorm 3 (x : ℚ) : ℝ) ≤ Real.exp (c 2 i * q) := by
  rw [threePlaceDiagonal, two_three_pow_dvd_int_iff]
  simpa only [neg_neg, Nat.cast_ofNat] using and_congr
    (padicNorm_int_le_exp_iff_dvd 2 x (-(c 1 i * q))).symm
    (padicNorm_int_le_exp_iff_dvd 3 x (-(c 2 i * q))).symm

def rationalThreePlaceDomain_iff_divisibility {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) (q : ℝ) (x : Fin d → ℤ) :
    x ∈ rationalThreePlaceDomain A c q ↔
      rationalBoxContains A (threePlaceWidth c q) (integerEuclideanPoint x) ∧
      ∀ i, (threePlaceDiagonal c q i : ℤ) ∣ x i := by
  simp only [rationalThreePlaceDomain, Set.mem_ofPred_eq, threePlaceDiagonal_dvd_iff,
    rationalBoxContains, threePlaceWidth, integerEuclideanPoint, WithLp.ofLp_toLp]
  aesop

/-- Equality at each actual integer point; it includes zero coordinates. -/
def rationalThreePlaceDomain_point_iff {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) (q : ℝ) (x : Fin d → ℤ) :
    x ∈ rationalThreePlaceDomain A c q ↔ integerEuclideanPoint x ∈
      rationalDiagonalBoxDomain A (threePlaceWidth c q) (threePlaceDiagonal c q) := by
  rw [rationalThreePlaceDomain_iff_divisibility]
  constructor
  · rintro ⟨hb, hd⟩
    choose z hz using hd
    refine ⟨z, ?_, hb⟩
    ext i
    change (x i : ℝ) = (threePlaceDiagonal c q i : ℝ) * (z i : ℝ)
    exact_mod_cast hz i
  · rintro ⟨z, hz, hb⟩
    refine ⟨hb, fun i => ⟨z i, ?_⟩⟩
    have hi := congrArg (fun v : BoxEuclidean d => v i) hz
    change (x i : ℝ) = (threePlaceDiagonal c q i : ℝ) * (z i : ℝ) at hi
    exact_mod_cast hi

/-- Exact set equality, not merely an inclusion or an abstract lattice model. -/
def rationalThreePlaceDomain_image {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) (q : ℝ) :
    integerEuclideanPoint '' rationalThreePlaceDomain A c q =
      rationalDiagonalBoxDomain A (threePlaceWidth c q) (threePlaceDiagonal c q) := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (rationalThreePlaceDomain_point_iff A c q x).mp hx
  · rintro ⟨z, rfl, hb⟩
    let x : Fin d → ℤ := fun i => (threePlaceDiagonal c q i : ℤ) * z i
    have hx : integerEuclideanPoint x = diagonalIntegerPoint (threePlaceDiagonal c q) z := by
      ext i
      simp [integerEuclideanPoint, diagonalIntegerPoint, x]
    refine ⟨x, (rationalThreePlaceDomain_point_iff A c q x).mpr ?_, hx⟩
    rw [hx]
    exact ⟨z, rfl, hb⟩

/-- Each coordinate denominator differs from the exact real scaling by
less than a factor six. -/
def threePlaceDiagonal_bounds {d : ℕ} (c : Fin 3 → Fin d → ℝ) {q : ℝ}
    (hq : 0 ≤ q) (hc1 : ∀ i, c 1 i ≤ 0) (hc2 : ∀ i, c 2 i ≤ 0) (i : Fin d) :
    Real.exp (-(c 1 i + c 2 i) * q) ≤ (threePlaceDiagonal c q i : ℝ) ∧
      (threePlaceDiagonal c q i : ℝ) ≤ 6 * Real.exp (-(c 1 i + c 2 i) * q) := by
  have h2 := prime_ceiling_power_bounds 2 (by norm_num) (neg_nonneg.mpr (mul_nonpos_of_nonpos_of_nonneg (hc1 i) hq))
  have h3 := prime_ceiling_power_bounds 3 (by norm_num) (neg_nonneg.mpr (mul_nonpos_of_nonpos_of_nonneg (hc2 i) hq))
  have he : Real.exp (-(c 1 i + c 2 i) * q) =
      Real.exp (-(c 1 i * q)) * Real.exp (-(c 2 i * q)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [he, threePlaceDiagonal, Nat.cast_mul, Nat.cast_pow, Nat.cast_pow]
  constructor
  · exact mul_le_mul h2.1 h3.1 (Real.exp_nonneg _) (by positivity)
  · calc
      _ ≤ (2 * Real.exp (-(c 1 i * q))) * (3 * Real.exp (-(c 2 i * q))) :=
        mul_le_mul h2.2.le h3.2.le (by positivity) (by positivity)
      _ = _ := by ring


end
end Bounty

end SubmissionComponent_RationalThreePlaceDomain

/- Component ThreePlaceCovolume; SHA256 2bf668c0d1fd9828b1ac8b34e08b180e8e2f6e2ea457b626e04fd7ec26a5d88e -/
section SubmissionComponent_ThreePlaceCovolume
/- Covolume estimates for the exact three-place diagonal lattice. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Module MeasureTheory

def threePlaceProfileSum {d : ℕ} (c : Fin 3 → Fin d → ℝ) : ℝ :=
  ∑ v : Fin 3, ∑ i, c v i

def threePlaceProfileSum_eq {d : ℕ} (c : Fin 3 → Fin d → ℝ) :
    threePlaceProfileSum c = ∑ i : Fin d, (c 0 i + c 1 i + c 2 i) := by
  simp [threePlaceProfileSum, Fin.sum_univ_succ, Finset.sum_add_distrib, add_assoc]

abbrev rationalThreePlaceLattice {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0) : Submodule ℤ (BoxEuclidean d) :=
  rationalBoxLattice A (threePlaceWidth c q) (threePlaceDiagonal c q) hA
    (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)

def threePlaceCoordinateScale_bounds {d : ℕ} (c : Fin 3 → Fin d → ℝ) {q : ℝ}
    (hq : 0 ≤ q) (hc1 : ∀ i, c 1 i ≤ 0) (hc2 : ∀ i, c 2 i ≤ 0) (i : Fin d) :
    Real.exp (-(c 0 i + c 1 i + c 2 i) * q) ≤
        (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i ∧
      (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i ≤
        6 * Real.exp (-(c 0 i + c 1 i + c 2 i) * q) := by
  have hh := threePlaceDiagonal_bounds c hq hc1 hc2 i
  have hw := threePlaceWidth_pos c q i
  have he : Real.exp (-(c 1 i + c 2 i) * q) / threePlaceWidth c q i =
      Real.exp (-(c 0 i + c 1 i + c 2 i) * q) := by
    rw [threePlaceWidth, ← Real.exp_sub]
    congr 1
    ring
  constructor
  · rw [← he]
    exact div_le_div_of_nonneg_right hh.1 hw.le
  · rw [← he]
    calc
      _ ≤ (6 * Real.exp (-(c 1 i + c 2 i) * q)) / threePlaceWidth c q i :=
        div_le_div_of_nonneg_right hh.2 hw.le
      _ = _ := by ring

def threePlace_exp_product {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) :
    (∏ i, Real.exp (-(c 0 i + c 1 i + c 2 i) * q)) =
      Real.exp (-threePlaceProfileSum c * q) := by
  rw [← Real.exp_sum]
  congr 1
  rw [← Finset.sum_mul, Finset.sum_neg_distrib, threePlaceProfileSum_eq]

/-- Exact determinant formula for the actual full discrete lattice. -/
def rationalThreePlaceLattice_covolume {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0) :
    ZLattice.covolume (rationalThreePlaceLattice A c q hA) =
      |(A.det : ℝ)| * (∏ i, (threePlaceDiagonal c q i : ℝ)) / ∏ i, threePlaceWidth c q i :=
  rationalBoxLattice_covolume A _ _ hA _ _

/-- The upper estimate uses the exact profile sum; a lower bound on its
negative alone cannot supply an upper estimate with the same rho. -/
def rationalThreePlaceLattice_covolume_bounds {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) {q : ℝ} (hA : A.det ≠ 0)
    (hq : 0 ≤ q) (hc1 : ∀ i, c 1 i ≤ 0) (hc2 : ∀ i, c 2 i ≤ 0) :
    |(A.det : ℝ)| * Real.exp (-threePlaceProfileSum c * q) ≤
        ZLattice.covolume (rationalThreePlaceLattice A c q hA) ∧
      ZLattice.covolume (rationalThreePlaceLattice A c q hA) ≤
        (6 : ℝ) ^ d * |(A.det : ℝ)| * Real.exp (-threePlaceProfileSum c * q) := by
  have he : ZLattice.covolume (rationalThreePlaceLattice A c q hA) =
      |(A.det : ℝ)| * ∏ i, (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i := by
    rw [rationalThreePlaceLattice_covolume, Finset.prod_div_distrib]
    ring
  have hlo : (∏ i, Real.exp (-(c 0 i + c 1 i + c 2 i) * q)) ≤
      ∏ i, (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i :=
    Finset.prod_le_prod (fun _ _ => Real.exp_nonneg _)
      (fun i _ => (threePlaceCoordinateScale_bounds c hq hc1 hc2 i).1)
  have hhi : (∏ i, (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i) ≤
      ∏ i, 6 * Real.exp (-(c 0 i + c 1 i + c 2 i) * q) :=
    Finset.prod_le_prod (fun i _ => div_nonneg (Nat.cast_nonneg _) (threePlaceWidth_pos c q i).le)
      (fun i _ => (threePlaceCoordinateScale_bounds c hq hc1 hc2 i).2)
  rw [threePlace_exp_product] at hlo
  rw [Finset.prod_mul_distrib, threePlace_exp_product] at hhi
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at hhi
  rw [he]
  refine ⟨mul_le_mul_of_nonneg_left hlo (abs_nonneg _), ?_⟩
  calc
    _ ≤ |(A.det : ℝ)| * ((6 : ℝ) ^ d * Real.exp (-threePlaceProfileSum c * q)) :=
      mul_le_mul_of_nonneg_left hhi (abs_nonneg _)
    _ = _ := by ring

def rationalThreePlaceLattice_covolume_lower {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) {q ρ : ℝ} (hA : A.det ≠ 0)
    (hq : 0 ≤ q) (hc1 : ∀ i, c 1 i ≤ 0) (hc2 : ∀ i, c 2 i ≤ 0)
    (hsum : threePlaceProfileSum c ≤ -ρ) :
    |(A.det : ℝ)| * Real.exp (ρ * q) ≤ ZLattice.covolume (rationalThreePlaceLattice A c q hA) := by
  apply le_trans _ (rationalThreePlaceLattice_covolume_bounds A c hA hq hc1 hc2).1
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
  apply Real.exp_le_exp.mpr
  have hh := mul_le_mul_of_nonneg_right hsum hq
  nlinarith


end
end Bounty

end SubmissionComponent_ThreePlaceCovolume

/- Component ThreePlaceDavenportGap; SHA256 def74f57f06f1be4c9b18fb2544ea81569838e0803694de3dcee33744a912444 -/
section SubmissionComponent_ThreePlaceDavenportGap
/- The full geometric bridge for the actual three-place integer domain. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module

def threePlaceMinimumValue {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0) : Fin d → ℝ :=
  rationalBoxMinimumValue A (threePlaceWidth c q) (threePlaceDiagonal c q) hA
    (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)

def threePlaceMinimumPoints {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0) : Fin d → BoxEuclidean d :=
  rationalBoxMinimumPoints A (threePlaceWidth c q) (threePlaceDiagonal c q) hA
    (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)

def integerEuclideanPoint_injective {d : ℕ} :
    Function.Injective (@integerEuclideanPoint d) := by
  intro x y h
  funext i
  have hi := congrArg (fun v : BoxEuclidean d => v i) h
  change (x i : ℝ) = (y i : ℝ) at hi
  exact_mod_cast hi

/-- With the explicit Euclidean gap threshold, the three-place domain
admits actual integer Davenport columns and a containing proper prefix. -/
def exists_threePlace_davenport_gap {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) {q ρ G : ℝ}
    (hA : A.det ≠ 0) (hq : 0 ≤ q)
    (hc1 : ∀ i, c 1 i ≤ 0) (hc2 : ∀ i, c 2 i ≤ 0)
    (hsum : threePlaceProfileSum c ≤ -ρ)
    (hne : ∃ x ∈ rationalThreePlaceDomain A c q, x ≠ 0) (hG : 1 ≤ G)
    (hgrowth : (d.factorial : ℝ) * (Real.sqrt d) ^ d * G ^ (d * (d - 1)) <
      |(A.det : ℝ)| * Real.exp (ρ * q)) :
    ∃ (p : Equiv.Perm (Fin d)) (H : Fin d → Fin d → ℤ) (z : Fin d → Fin d → ℤ)
      (lo hi : Fin d),
      hi.val = lo.val + 1 ∧
      (∀ j i, (threePlaceDiagonal c q i : ℤ) ∣ H j i) ∧
      (∀ j, integerEuclideanPoint (H j) = threePlaceMinimumPoints A c q hA j +
        ∑ i, if i < j then (z j i : ℝ) • threePlaceMinimumPoints A c q hA i else 0) ∧
      LinearIndependent ℝ (fun j => integerEuclideanPoint (H j)) ∧
      (∀ k, k ≤ d → Submodule.span ℚ ((fun j => integerEuclideanPoint (H j)) '' {i | i.val < k}) =
        Submodule.span ℚ (threePlaceMinimumPoints A c q hA '' {i | i.val < k})) ∧
      (∀ i j, |(A.map (Rat.castHom ℝ) *ᵥ (fun r => (H j r : ℝ))) (p i)| ≤
        (2 : ℝ) ^ d * Real.exp (c 0 (p i) * q) *
          min (threePlaceMinimumValue A c q hA i) (threePlaceMinimumValue A c q hA j)) ∧
      Real.sqrt d < threePlaceMinimumValue A c q hA hi ∧
      G < threePlaceMinimumValue A c q hA hi / threePlaceMinimumValue A c q hA lo ∧
      (∀ x ∈ rationalThreePlaceDomain A c q, integerEuclideanPoint x ∈
        latticePrefixSpan (fun j => integerEuclideanPoint (H j)) hi.val) ∧
      finrank ℝ (latticePrefixSpan (fun j => integerEuclideanPoint (H j)) hi.val) = hi.val ∧
      finrank ℝ (Submodule.span ℝ (integerEuclideanPoint '' rationalThreePlaceDomain A c q)) ≤ hi.val := by
  let B := threePlaceWidth c q
  let N := threePlaceDiagonal c q
  have hboxne : ∃ x ∈ rationalDiagonalBoxDomain A B N, x ≠ 0 := by
    obtain ⟨x, hx, hxne⟩ := hne
    refine ⟨integerEuclideanPoint x, (rationalThreePlaceDomain_point_iff A c q x).mp hx, ?_⟩
    intro hz
    apply hxne
    apply integerEuclideanPoint_injective
    have hzero : integerEuclideanPoint (0 : Fin d → ℤ) = 0 := by ext i; simp [integerEuclideanPoint]
    exact hz.trans hzero.symm
  have hdet : (d.factorial : ℝ) * (Real.sqrt d) ^ d * G ^ (d * (d - 1)) <
      |(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, B i := by
    have hh := rationalThreePlaceLattice_covolume_lower A c hA hq hc1 hc2 hsum
    rw [rationalThreePlaceLattice_covolume] at hh
    exact hgrowth.trans_le hh
  obtain ⟨p, h, z, lo, hi, hidx, he, hint, hLI, hpref, hb, hhi, hgap, hsub, hdim, hrank⟩ :=
    exists_rationalBox_davenport_gap hd A B N hA (threePlaceWidth_pos c q)
      (threePlaceDiagonal_pos c q) hboxne hG hdet
  choose b hbdiag using hint
  let H : Fin d → Fin d → ℤ := fun j i => (N i : ℤ) * b j i
  have hH : (fun j => integerEuclideanPoint (H j)) = h := by
    funext j
    rw [hbdiag j]
    ext i
    simp [integerEuclideanPoint, diagonalIntegerPoint, H]
  refine ⟨p, H, z, lo, hi, hidx, (fun j i => ⟨b j i, rfl⟩), ?_, ?_, ?_, ?_, hhi, hgap, ?_, ?_, ?_⟩
  · intro j
    rw [congrFun hH j]
    exact he j
  · rw [hH]
    exact hLI
  · rw [hH]
    exact hpref
  · intro i j
    have hh := hb i j
    rw [← congrFun hH j] at hh
    exact hh
  · intro x hx
    rw [hH]
    exact hsub ((rationalThreePlaceDomain_point_iff A c q x).mp hx)
  · rw [hH]
    exact hdim
  · rw [rationalThreePlaceDomain_image]
    exact hrank


end
end Bounty

end SubmissionComponent_ThreePlaceDavenportGap

/- Component ThreePlaceMinimaBounds; SHA256 c0972339d911636ab9a0dd1b4b43834b23ef2d3f200c949d53592405ba76f848 -/
section SubmissionComponent_ThreePlaceMinimaBounds
/- Uniform exponential bounds for the actual transformed Euclidean minima. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module MeasureTheory

def rationalMatrixSize {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) : ℝ :=
  1 + ∑ i, ∑ j, |(A i j : ℝ)|

def rationalMatrixSize_one_le {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) :
    1 ≤ rationalMatrixSize A := by
  unfold rationalMatrixSize
  exact le_add_of_nonneg_right (Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _)))

def rationalMatrixSize_entry {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) (i j : Fin d) :
    |(A i j : ℝ)| ≤ rationalMatrixSize A := by
  have h1 : |(A i j : ℝ)| ≤ ∑ k : Fin d, |(A i k : ℝ)| :=
    Finset.single_le_sum (f := fun k : Fin d => |(A i k : ℝ)|)
      (fun k _ => abs_nonneg _) (Finset.mem_univ j)
  have h2 : (∑ k : Fin d, |(A i k : ℝ)|) ≤ ∑ l : Fin d, ∑ k : Fin d, |(A l k : ℝ)| :=
    Finset.single_le_sum (f := fun l : Fin d => ∑ k : Fin d, |(A l k : ℝ)|)
      (fun l _ => Finset.sum_nonneg (fun k _ => abs_nonneg _)) (Finset.mem_univ i)
  unfold rationalMatrixSize
  linarith

def boxEuclidean_norm_le_sum_abs {d : ℕ} (x : BoxEuclidean d) :
    ‖x‖ ≤ ∑ i, |x i| := by
  let e := EuclideanSpace.basisFun (Fin d) ℝ
  have hx : (∑ i, x i • e i) = x := e.toBasis.sum_repr x
  calc
    ‖x‖ = ‖∑ i, x i • e i‖ := congrArg norm hx.symm
    _ ≤ ∑ i, ‖x i • e i‖ := norm_sum_le _ _
    _ = _ := by simp [norm_smul, e.norm_eq_one, Real.norm_eq_abs]

def threePlaceDiagonal_uniform_upper {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    {M q : ℝ} (hM : 0 ≤ M) (hq : 0 ≤ q) (hc : ∀ v i, |c v i| ≤ M) (i : Fin d) :
    (threePlaceDiagonal c q i : ℝ) ≤ 6 * Real.exp (2 * M * q) := by
  have hp (p : ℕ) (hp : 1 < p) (v : Fin 3) :
      (p : ℝ) ^ Nat.ceil (-(c v i * q) / Real.log p) ≤ p * Real.exp (M * q) := by
    have hlog : 0 < Real.log (p : ℝ) := Real.log_pos (by exact_mod_cast hp)
    have hcv : -(c v i * q) ≤ M * q := by
      have hh := mul_le_mul_of_nonneg_right ((neg_le_abs (c v i)).trans (hc v i)) hq
      linarith
    have hceil := Nat.ceil_mono (div_le_div_of_nonneg_right hcv hlog.le)
    exact (pow_le_pow_right₀ (by exact_mod_cast (Nat.le_of_lt hp)) hceil).trans
      (prime_ceiling_power_bounds p hp (mul_nonneg hM hq)).2.le
  have h2 := hp 2 (by norm_num) 1
  have h3 := hp 3 (by norm_num) 2
  simp only [Nat.cast_ofNat] at h2 h3
  rw [threePlaceDiagonal, Nat.cast_mul, Nat.cast_pow, Nat.cast_pow]
  calc
    _ ≤ (2 * Real.exp (M * q)) * (3 * Real.exp (M * q)) :=
      mul_le_mul h2 h3 (by positivity) (by positivity)
    _ = 6 * Real.exp (M * q + M * q) := by rw [Real.exp_add]; ring
    _ = _ := by congr 2; ring

def threePlaceWidth_uniform_bounds {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    {M q : ℝ} (hq : 0 ≤ q) (hc : ∀ v i, |c v i| ≤ M) (i : Fin d) :
    threePlaceWidth c q i ≤ Real.exp (M * q) ∧
      (threePlaceWidth c q i)⁻¹ ≤ Real.exp (M * q) := by
  constructor
  · exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hc 0 i)) hq)
  · rw [threePlaceWidth, ← Real.exp_neg]
    apply Real.exp_le_exp.mpr
    have hh := mul_le_mul_of_nonneg_right ((neg_le_abs _).trans (hc 0 i)) hq
    linarith

def threePlaceBasis_norm_bound {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) {M q : ℝ} (hA : A.det ≠ 0) (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hc : ∀ v i, |c v i| ≤ M) (j : Fin d) :
    ‖matrixEuclideanBasis (rationalBoxLatticeMatrix A (threePlaceWidth c q) (threePlaceDiagonal c q))
      (rationalBoxLatticeMatrix_det_ne_zero A _ _ hA (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)) j‖ ≤
      (6 * (d + 1 : ℝ) * rationalMatrixSize A) * Real.exp (3 * M * q) := by
  let B := threePlaceWidth c q
  let N := threePlaceDiagonal c q
  let C := rationalBoxLatticeMatrix A B N
  let hC := rationalBoxLatticeMatrix_det_ne_zero A B N hA (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)
  let b := matrixEuclideanBasis C hC
  have hKA : 0 ≤ rationalMatrixSize A := le_trans (by norm_num) (rationalMatrixSize_one_le A)
  have hentry (i : Fin d) : |b j i| ≤ 6 * rationalMatrixSize A * Real.exp (3 * M * q) := by
    have he : b j i = C i j := congrArg (fun D : Matrix (Fin d) (Fin d) ℝ => D i j)
      (matrixEuclideanBasis_toMatrix C hC)
    rw [he]
    have hCij : C i j = (B i)⁻¹ * (A i j : ℝ) * (N j : ℝ) := by
      simp [C, rationalBoxLatticeMatrix, rationalBoxMatrix, Matrix.diagonal_mul, Matrix.mul_diagonal]
    rw [hCij, abs_mul, abs_mul, abs_of_nonneg (inv_nonneg.mpr (threePlaceWidth_pos c q i).le),
      abs_of_nonneg (show (0 : ℝ) ≤ N j from Nat.cast_nonneg _)]
    calc
      _ ≤ (Real.exp (M * q) * rationalMatrixSize A) * (6 * Real.exp (2 * M * q)) :=
        mul_le_mul (mul_le_mul (threePlaceWidth_uniform_bounds c hq hc i).2
          (rationalMatrixSize_entry A i j) (abs_nonneg _) (Real.exp_nonneg _))
          (threePlaceDiagonal_uniform_upper c hM hq hc j) (Nat.cast_nonneg _)
          (mul_nonneg (Real.exp_nonneg _) hKA)
      _ = 6 * rationalMatrixSize A * Real.exp (M * q + 2 * M * q) := by rw [Real.exp_add]; ring
      _ = _ := by congr 2; ring
  have hK : 0 ≤ 6 * rationalMatrixSize A * Real.exp (3 * M * q) :=
    mul_nonneg (mul_nonneg (by norm_num) (le_trans (by norm_num) (rationalMatrixSize_one_le A))) (Real.exp_nonneg _)
  calc
    ‖b j‖ ≤ ∑ i, |b j i| := boxEuclidean_norm_le_sum_abs _
    _ ≤ ∑ _i : Fin d, 6 * rationalMatrixSize A * Real.exp (3 * M * q) :=
      Finset.sum_le_sum (fun i _ => hentry i)
    _ = (d : ℝ) * (6 * rationalMatrixSize A * Real.exp (3 * M * q)) := by simp
    _ ≤ (d + 1 : ℝ) * (6 * rationalMatrixSize A * Real.exp (3 * M * q)) :=
      mul_le_mul_of_nonneg_right (by linarith) hK
    _ = _ := by ring

def threePlaceMinimumValue_uniform_upper {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) {M q : ℝ} (hA : A.det ≠ 0) (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hc : ∀ v i, |c v i| ≤ M) (i : Fin d) :
    threePlaceMinimumValue A c q hA i ≤
      (6 * (d + 1 : ℝ) * rationalMatrixSize A) * Real.exp (3 * M * q) := by
  let B := threePlaceWidth c q
  let N := threePlaceDiagonal c q
  let L := rationalBoxLattice A B N hA (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)
  let C := rationalBoxLatticeMatrix A B N
  let hC := rationalBoxLatticeMatrix_det_ne_zero A B N hA (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)
  let b := matrixEuclideanBasis C hC
  apply (latticeSuccessiveMinimum_le_iff L (boxDimensionEquiv d i) _).mpr
  let f := Fin.castLE (Nat.succ_le_of_lt i.isLt)
  refine ⟨fun j => b (f j), b.linearIndependent.comp f (Fin.castLE_injective _), ?_, ?_⟩
  · intro j
    exact Submodule.subset_span ⟨f j, rfl⟩
  · intro j
    exact threePlaceBasis_norm_bound A c hA hM hq hc (f j)

def positive_constant_exp_bounds {C q : ℝ} (hC : 0 < C) (hq : 1 ≤ q) :
    Real.exp (-|Real.log C| * q) ≤ C ∧ C ≤ Real.exp (|Real.log C| * q) := by
  have hh : |Real.log C| ≤ |Real.log C| * q := le_mul_of_one_le_right (abs_nonneg _) hq
  constructor
  · calc
      _ ≤ Real.exp (Real.log C) := Real.exp_le_exp.mpr (by nlinarith [neg_abs_le (Real.log C)])
      _ = C := Real.exp_log hC
  · calc
      C = Real.exp (Real.log C) := (Real.exp_log hC).symm
      _ ≤ _ := Real.exp_le_exp.mpr ((le_abs_self _).trans hh)

def threePlaceMinimumValue_exp_upper {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) {M q : ℝ} (hA : A.det ≠ 0) (hM : 0 ≤ M) (hq : 1 ≤ q)
    (hc : ∀ v i, |c v i| ≤ M) (i : Fin d) :
    threePlaceMinimumValue A c q hA i ≤
      Real.exp ((3 * M + |Real.log (6 * (d + 1 : ℝ) * rationalMatrixSize A)|) * q) := by
  have hK : 0 < 6 * (d + 1 : ℝ) * rationalMatrixSize A :=
    mul_pos (mul_pos (by norm_num) (by positivity)) ((by norm_num : (0 : ℝ) < 1).trans_le (rationalMatrixSize_one_le A))
  apply (threePlaceMinimumValue_uniform_upper A c hA hM (le_trans (by norm_num) hq) hc i).trans
  calc
    _ ≤ Real.exp (|Real.log (6 * (d + 1 : ℝ) * rationalMatrixSize A)| * q) * Real.exp (3 * M * q) :=
      mul_le_mul_of_nonneg_right (positive_constant_exp_bounds hK hq).2 (Real.exp_nonneg _)
    _ = _ := by rw [← Real.exp_add]; congr 1; ring

def threePlaceMinimumValue_product_exp_lower {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (c : Fin 3 → Fin d → ℝ) {M q : ℝ}
    (hA : A.det ≠ 0) (hq : 0 ≤ q) (hc : ∀ v i, |c v i| ≤ M) :
    (|(A.det : ℝ)| / d.factorial) * Real.exp (-((d : ℝ) * M) * q) ≤
      ∏ i, threePlaceMinimumValue A c q hA i := by
  have hscale (i : Fin d) : Real.exp (-(M * q)) ≤
      (threePlaceDiagonal c q i : ℝ) / threePlaceWidth c q i := by
    rw [Real.exp_neg, inv_eq_one_div]
    calc
      _ ≤ 1 / threePlaceWidth c q i :=
        one_div_le_one_div_of_le (threePlaceWidth_pos c q i) (threePlaceWidth_uniform_bounds c hq hc i).1
      _ ≤ _ := div_le_div_of_nonneg_right
        (by exact_mod_cast (threePlaceDiagonal_pos c q i)) (threePlaceWidth_pos c q i).le
  have hs := Finset.prod_le_prod (fun _ _ => Real.exp_nonneg _) (fun i (_ : i ∈ Finset.univ) => hscale i)
  have he : (∏ _i : Fin d, Real.exp (-(M * q))) = Real.exp (-((d : ℝ) * M) * q) := by
    simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← Real.exp_nat_mul]
    congr 1
    ring
  rw [he, Finset.prod_div_distrib] at hs
  have hp := (rationalBoxMinimumValue_product_bounds A (threePlaceWidth c q) (threePlaceDiagonal c q)
    hA (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)).1
  apply le_trans _ hp
  have hfac : (0 : ℝ) < d.factorial := by exact_mod_cast Nat.factorial_pos d
  have ht := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hs (abs_nonneg (A.det : ℝ))) hfac.le
  convert ht using 1 <;> ring

def finite_minima_exp_lower {d : ℕ} (lam : Fin d → ℝ) {C U V q : ℝ}
    (hC : 0 < C) (hU : 0 ≤ U) (hq : 1 ≤ q) (hlam : ∀ i, 0 ≤ lam i)
    (hupper : ∀ i, lam i ≤ Real.exp (U * q))
    (hprod : C * Real.exp (-V * q) ≤ ∏ i, lam i) (i : Fin d) :
    Real.exp (-(V + U * d + |Real.log C|) * q) ≤ lam i := by
  classical
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq
  have he1 : 1 ≤ Real.exp (U * q) := Real.one_le_exp_iff.mpr (mul_nonneg hU hq0)
  have hother : (∏ j ∈ Finset.univ.erase i, lam j) ≤ Real.exp (U * q) ^ d := by
    calc
      _ ≤ ∏ _j ∈ Finset.univ.erase i, Real.exp (U * q) :=
        Finset.prod_le_prod (fun j _ => hlam j) (fun j _ => hupper j)
      _ = Real.exp (U * q) ^ (d - 1) := by simp
      _ ≤ _ := pow_le_pow_right₀ he1 (Nat.sub_le _ _)
  have hp : (∏ j, lam j) ≤ lam i * Real.exp (U * q) ^ d := by
    rw [← Finset.mul_prod_erase Finset.univ lam (Finset.mem_univ i)]
    exact mul_le_mul_of_nonneg_left hother (hlam i)
  have hlow : Real.exp (-(V + U * d + |Real.log C|) * q) * Real.exp (U * q) ^ d ≤
      C * Real.exp (-V * q) := by
    have hh := mul_le_mul_of_nonneg_right (positive_constant_exp_bounds hC hq).1 (Real.exp_nonneg (-V * q))
    calc
      _ = Real.exp (-|Real.log C| * q) * Real.exp (-V * q) := by
        rw [← Real.exp_nat_mul, ← Real.exp_add, ← Real.exp_add]
        congr 1
        ring
      _ ≤ _ := hh
  exact (mul_le_mul_iff_left₀ (pow_pos (Real.exp_pos _) d)).mp (by
    simpa only [mul_comm] using hlow.trans (hprod.trans hp))

def exists_threePlaceMinimumValue_uniform_exp_bounds {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0) (M : ℝ) :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ (c : Fin 3 → Fin d → ℝ) (q : ℝ), 1 ≤ q →
      (∀ v i, |c v i| ≤ M) → ∀ i,
      Real.exp (-L * q) ≤ threePlaceMinimumValue A c q hA i ∧
        threePlaceMinimumValue A c q hA i ≤ Real.exp (L * q) := by
  let M' := max M 0
  let U := 3 * M' + |Real.log (6 * (d + 1 : ℝ) * rationalMatrixSize A)|
  let C := |(A.det : ℝ)| / d.factorial
  let V := (d : ℝ) * M'
  let L := U + V + U * d + |Real.log C|
  have hM : 0 ≤ M' := le_max_right _ _
  have hU : 0 ≤ U := add_nonneg (mul_nonneg (by norm_num) hM) (abs_nonneg _)
  have hV : 0 ≤ V := mul_nonneg (Nat.cast_nonneg _) hM
  have hC : 0 < C := div_pos (abs_pos.mpr (by exact_mod_cast hA)) (by exact_mod_cast Nat.factorial_pos d)
  have hUd : 0 ≤ U * d := mul_nonneg hU (Nat.cast_nonneg _)
  refine ⟨L, by dsimp [L]; positivity, ?_⟩
  intro c q hq hc i
  have hc' : ∀ v i, |c v i| ≤ M' := fun v i => (hc v i).trans (le_max_left _ _)
  have hu := threePlaceMinimumValue_exp_upper A c hA hM hq hc'
  have hp := threePlaceMinimumValue_product_exp_lower A c hA (le_trans (by norm_num) hq) hc'
  have hl := finite_minima_exp_lower (threePlaceMinimumValue A c q hA) hC hU hq
    (fun i => (rationalBoxMinimumValue_pos A _ _ hA _ _ i).le) hu hp i
  constructor
  · apply le_trans _ hl
    apply Real.exp_le_exp.mpr
    have hq0 : 0 ≤ q := le_trans (by norm_num) hq
    have hh := mul_nonneg hU hq0
    dsimp [L]
    nlinarith
  · apply (hu i).trans
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_right _ (le_trans (by norm_num) hq)
    dsimp [L]
    linarith [abs_nonneg (Real.log C)]


end
end Bounty

end SubmissionComponent_ThreePlaceMinimaBounds

/- Component CompoundMatrixAlgebra; SHA256 c1ff7533b9aa2449de13aa80682fbb7ff19db56e8ce111b2b67d1795324c687c -/
section SubmissionComponent_CompoundMatrixAlgebra
/- The actual compound matrix in the increasing-subset exterior-power basis.
Its entries are the usual minors, and its composition and column action are
deduced from the exterior-power functor. -/

namespace Bounty
noncomputable section
open scoped BigOperators

abbrev CompoundIndex (d ell : ℕ) := Set.powersetCard (Fin d) ell

def compoundIndexEmbedding {d ell : ℕ} (s : CompoundIndex d ell) : Fin ell ↪o Fin d :=
  Set.powersetCard.ofFinEmbEquiv.symm s

def compoundIndex_card (d ell : ℕ) : Fintype.card (CompoundIndex d ell) = d.choose ell := by
  rw [Fintype.card_eq_nat_card, Set.powersetCard.card, Nat.card_fin]

def compoundExteriorBasis (R : Type*) [CommRing R] (d ell : ℕ) :
    Module.Basis (CompoundIndex d ell) R (⋀[R]^ell (Fin d → R)) :=
  (Pi.basisFun R (Fin d)).exteriorPower ell

def compoundMatrix {R : Type*} [CommRing R] {d : ℕ} (ell : ℕ)
    (M : Matrix (Fin d) (Fin d) R) : Matrix (CompoundIndex d ell) (CompoundIndex d ell) R := by
  classical
  exact LinearMap.toMatrix (compoundExteriorBasis R d ell) (compoundExteriorBasis R d ell)
    (exteriorPower.map ell (Matrix.toLin' M))

def compoundWedgeCoordinates {R : Type*} [CommRing R] {d ell : ℕ}
    (v : Fin ell → Fin d → R) : CompoundIndex d ell → R :=
  (compoundExteriorBasis R d ell).repr (exteriorPower.ιMulti R ell v)

def compoundWedgeCoordinates_apply {R : Type*} [CommRing R] {d ell : ℕ}
    (v : Fin ell → Fin d → R) (s : CompoundIndex d ell) :
    compoundWedgeCoordinates v s =
      (Matrix.of (fun i j : Fin ell => v j (compoundIndexEmbedding s i))).det := by
  rw [compoundWedgeCoordinates, compoundExteriorBasis, exteriorPower.basis_repr_apply,
    exteriorPower.ιMultiDual_apply_ιMulti]
  simp only [Module.Basis.coord_apply, Pi.basisFun_repr]
  have heq : (Matrix.of (fun i j : Fin ell => v i (Set.powersetCard.ofFinEmbEquiv.symm s j))) =
      (Matrix.of (fun i j : Fin ell => v j (compoundIndexEmbedding s i))).transpose := by
    ext i j
    rfl
  exact (congrArg Matrix.det heq).trans (Matrix.det_transpose _)

/-- The entry indexed by row subset `s` and column subset `t` is their minor,
with both subsets enumerated increasingly. -/
def compoundMatrix_apply {R : Type*} [CommRing R] {d : ℕ} (ell : ℕ)
    (M : Matrix (Fin d) (Fin d) R) (s t : CompoundIndex d ell) :
    compoundMatrix ell M s t =
      (M.submatrix (compoundIndexEmbedding s) (compoundIndexEmbedding t)).det := by
  classical
  rw [compoundMatrix, LinearMap.toMatrix_apply]
  simp only [compoundExteriorBasis, exteriorPower.basis_apply, exteriorPower.ιMulti_family,
    exteriorPower.map_apply_ιMulti]
  change compoundWedgeCoordinates
    (fun j => Matrix.toLin' M (Pi.basisFun R (Fin d) (compoundIndexEmbedding t j))) s = _
  rw [compoundWedgeCoordinates_apply]
  congr 1
  ext i j
  simp only [Matrix.of_apply, Matrix.toLin'_apply, Pi.basisFun_apply,
    Matrix.mulVec_single_one, Matrix.col_apply, Matrix.submatrix_apply]

def compoundMatrix_mul {R : Type*} [CommRing R] {d : ℕ} (ell : ℕ)
    (M N : Matrix (Fin d) (Fin d) R) :
    compoundMatrix ell (M * N) = compoundMatrix ell M * compoundMatrix ell N := by
  classical
  simp only [compoundMatrix, Matrix.toLin'_mul, exteriorPower.map_comp]
  exact LinearMap.toMatrix_comp (compoundExteriorBasis R d ell)
    (compoundExteriorBasis R d ell) (compoundExteriorBasis R d ell) _ _

def compoundMatrix_column {R : Type*} [CommRing R] {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) R) (t : CompoundIndex d ell) :
    compoundWedgeCoordinates (fun j i => M i (compoundIndexEmbedding t j)) =
      fun s => compoundMatrix ell M s t := by
  funext s
  rw [compoundWedgeCoordinates_apply, compoundMatrix_apply]
  rfl

def compoundMatrix_map {R S : Type*} [CommRing R] [CommRing S] {d : ℕ}
    (f : R →+* S) (ell : ℕ) (M : Matrix (Fin d) (Fin d) R) :
    compoundMatrix ell (f.mapMatrix M) = f.mapMatrix (compoundMatrix ell M) := by
  ext s t
  change compoundMatrix ell (f.mapMatrix M) s t = f (compoundMatrix ell M s t)
  rw [compoundMatrix_apply, compoundMatrix_apply, RingHom.map_det]
  rfl

def compoundMatrix_one {R : Type*} [CommRing R] (d ell : ℕ) :
    compoundMatrix ell (1 : Matrix (Fin d) (Fin d) R) = 1 := by
  classical
  simp only [compoundMatrix, Matrix.toLin'_one, exteriorPower.map_id, LinearMap.toMatrix_id]

/-- The compound acts on actual minors of any tuple of columns. -/
def compoundMatrix_wedge_action {R : Type*} [CommRing R] {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) R) (v : Fin ell → Fin d → R) :
    (compoundMatrix ell M).mulVec (compoundWedgeCoordinates v) =
      compoundWedgeCoordinates (fun j => M.mulVec (v j)) := by
  classical
  have hh := LinearMap.toMatrix_mulVec_repr (compoundExteriorBasis R d ell)
    (compoundExteriorBasis R d ell) (exteriorPower.map ell (Matrix.toLin' M))
    (exteriorPower.ιMulti R ell v)
  simpa only [compoundMatrix, compoundWedgeCoordinates, exteriorPower.map_apply_ιMulti,
    Function.comp_def, Matrix.toLin'_apply] using hh

def compoundMatrix_mul_inverse {K : Type*} [Field K] {d : ℕ} (ell : ℕ)
    (M : Matrix (Fin d) (Fin d) K) (hM : M.det ≠ 0) :
    compoundMatrix ell M * compoundMatrix ell M⁻¹ = 1 := by
  rw [← compoundMatrix_mul, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hM), compoundMatrix_one]

def compoundMatrix_det_ne_zero {K : Type*} [Field K] {d : ℕ} (ell : ℕ)
    (M : Matrix (Fin d) (Fin d) K) (hM : M.det ≠ 0) :
    (compoundMatrix ell M).det ≠ 0 := by
  classical
  intro hz
  have hh := congrArg Matrix.det (compoundMatrix_mul_inverse ell M hM)
  rw [Matrix.det_mul, hz, zero_mul, Matrix.det_one] at hh
  exact zero_ne_one hh

end
end Bounty

end SubmissionComponent_CompoundMatrixAlgebra

/- Component CofactorNormal; SHA256 ce1cff96605c23a71d159136c0ea6c08db3c24c59ca15439f37689026f9ff05c -/
section SubmissionComponent_CofactorNormal
/- Signed maximal minors of a rectangular matrix with one more row than
column. The transformation formula is proved by applying the adjugate
product identity to a zero-column completion. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def cofactorCompletion {R : Type*} [Zero R] {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) R) : Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  fun i j => Fin.cases 0 (X i) j

def cofactorNormal {R : Type*} [CommRing R] {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) R) : Fin (n + 1) → R :=
  fun i => (-1) ^ i.val * (X.submatrix i.succAbove id).det

def cofactorNormal_eq_adjugate {R : Type*} [CommRing R] {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) R) (i : Fin (n + 1)) :
    cofactorNormal X i = (cofactorCompletion X).adjugate 0 i := by
  rw [Matrix.adjugate_fin_succ_eq_det_submatrix]
  simp [cofactorNormal, cofactorCompletion, Matrix.submatrix]

def cofactorCompletion_mul {R : Type*} [CommRing R] {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (X : Matrix (Fin (n + 1)) (Fin n) R) :
    cofactorCompletion (A * X) = A * cofactorCompletion X := by
  ext i j
  refine Fin.cases ?_ (fun k => ?_) j
  · simp [cofactorCompletion, Matrix.mul_apply]
  · simp [cofactorCompletion, Matrix.mul_apply]

def cofactorNormal_mul {R : Type*} [CommRing R] {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (X : Matrix (Fin (n + 1)) (Fin n) R) :
    cofactorNormal (A * X) = A.adjugate.transpose.mulVec (cofactorNormal X) := by
  ext i
  simp_rw [cofactorNormal_eq_adjugate]
  rw [cofactorCompletion_mul, Matrix.adjugate_mul_distrib]
  simp only [Matrix.mul_apply, Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  exact Finset.sum_congr rfl fun j _ => by rw [cofactorNormal_eq_adjugate]; ring

def cofactorNormal_dot_column {R : Type*} [CommRing R] {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) R) (j : Fin n) :
    dotProduct (cofactorNormal X) (X.col j) = 0 := by
  have h := congrArg (fun M : Matrix (Fin (n + 1)) (Fin (n + 1)) R => M 0 j.succ)
    (Matrix.adjugate_mul (cofactorCompletion X))
  simpa [Matrix.mul_apply, cofactorNormal_eq_adjugate, dotProduct,
    cofactorCompletion, Matrix.col, Matrix.one_apply, Ne.symm (Fin.succ_ne_zero j)] using h

def cofactorNormal_map {R S : Type*} [CommRing R] [CommRing S] {n : ℕ}
    (f : R →+* S) (X : Matrix (Fin (n + 1)) (Fin n) R) :
    cofactorNormal (X.map f) = fun i => f (cofactorNormal X i) := by
  ext i
  simp only [cofactorNormal, map_mul, map_pow, map_neg, map_one]
  congr 1
  exact (f.map_det (X.submatrix i.succAbove id)).symm

def cofactorNormal_ne_zero {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℚ)
    (hX : LinearIndependent ℚ X.col) : cofactorNormal X ≠ 0 := by
  obtain ⟨v, hv⟩ := exists_linearIndependent_cons_of_lt_finrank hX
    (by simp : n < Module.finrank ℚ (Fin (n + 1) → ℚ))
  let B : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ :=
    fun i j => Fin.cases (v i) (X i) j
  have hcol : B.col = Fin.cons v X.col := by
    ext j i
    refine Fin.cases ?_ (fun k => ?_) j <;> rfl
  have hB : B.det ≠ 0 := Matrix.nonsingular_iff_det_ne_zero.mp
    (Matrix.Nonsingular.of_linearIndependent_col (by rw [hcol]; exact hv))
  intro hz
  apply hB
  rw [Matrix.det_succ_column_zero]
  apply Finset.sum_eq_zero
  intro i _
  have hi : cofactorNormal X i = 0 := congrFun hz i
  change (-1 : ℚ) ^ i.val * v i * (X.submatrix i.succAbove id).det = 0
  rw [mul_right_comm, ← cofactorNormal, hi, zero_mul]

end
end Bounty

end SubmissionComponent_CofactorNormal

/- Component LocalPolynomialEvaluation; SHA256 9ae647c462f81b6f00997fa074be0e49ee1312a9c0ece63d5671dbadc679bfbd -/
section SubmissionComponent_LocalPolynomialEvaluation
/- Local evaluation bounds with actual maximizing supported monomials.
Different places may choose different exponents. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rationalPadicNormMulHom (p : ℕ) [Fact p.Prime] : ℚ →* ℚ where
  toFun := padicNorm p
  map_one' := padicNorm.one
  map_mul' := padicNorm.mul

def padicNorm_finset_prod {I : Type*} (p : ℕ) [Fact p.Prime]
    (s : Finset I) (f : I → ℚ) :
    padicNorm p (∏ i ∈ s, f i) = ∏ i ∈ s, padicNorm p (f i) :=
  map_prod (rationalPadicNormMulHom p) f s

def padicNorm_nat_pow (p : ℕ) [Fact p.Prime] (x : ℚ) (n : ℕ) :
    padicNorm p (x ^ n) = (padicNorm p x) ^ n :=
  map_pow (rationalPadicNormMulHom p) x n

def rational_polynomial_eval_norm_le {I : Type*} [Fintype I]
    (P : MvPolynomial I ℚ) (x : I → ℚ) (M : ℝ)
    (hM : ∀ e ∈ P.support, ∏ i, ‖x i‖ ^ e i ≤ M) :
    ‖MvPolynomial.eval x P‖ ≤ polynomialCoeffL1 P * M := by
  classical
  rw [MvPolynomial.eval_eq']
  calc
    _ ≤ ∑ e ∈ P.support, ‖MvPolynomial.coeff e P * ∏ i, x i ^ e i‖ := norm_sum_le _ _
    _ = ∑ e ∈ P.support, ‖MvPolynomial.coeff e P‖ * ∏ i, ‖x i‖ ^ e i := by
      simp only [norm_mul, norm_prod, norm_pow]
    _ ≤ ∑ e ∈ P.support, ‖MvPolynomial.coeff e P‖ * M :=
      Finset.sum_le_sum fun e he => mul_le_mul_of_nonneg_left (hM e he) (norm_nonneg _)
    _ = _ := by rw [← Finset.sum_mul]; rfl

def rational_polynomial_eval_norm_le_some_monomial {I : Type*} [Fintype I]
    (P : MvPolynomial I ℚ) (hP : P ≠ 0) (x : I → ℚ) :
    ∃ e ∈ P.support,
      ‖MvPolynomial.eval x P‖ ≤ polynomialCoeffL1 P * ∏ i, ‖x i‖ ^ e i := by
  classical
  obtain ⟨e, he, hmax⟩ := Finset.exists_max_image P.support
    (fun e => ∏ i, ‖x i‖ ^ e i) (MvPolynomial.support_nonempty.mpr hP)
  exact ⟨e, he, rational_polynomial_eval_norm_le P x _ hmax⟩

def integer_polynomial_eval₂_padicNorm_le {I : Type*} [Fintype I]
    (p : ℕ) [Fact p.Prime] (P : MvPolynomial I ℤ) (x : I → ℚ) (M : ℚ) (hM : 0 ≤ M)
    (hterms : ∀ e ∈ P.support, ∏ i, (padicNorm p (x i)) ^ e i ≤ M) :
    padicNorm p (MvPolynomial.eval₂ (Int.castRingHom ℚ) x P) ≤ M := by
  rw [MvPolynomial.eval₂_eq']
  apply padicNorm.sum_le' _ hM
  intro e he
  rw [padicNorm.mul, padicNorm_finset_prod]
  simp_rw [padicNorm_nat_pow]
  calc
    _ ≤ 1 * (∏ i, (padicNorm p (x i)) ^ e i) :=
      mul_le_mul_of_nonneg_right (padicNorm.of_int (MvPolynomial.coeff e P))
        (Finset.prod_nonneg fun i _ => pow_nonneg (padicNorm.nonneg _) _)
    _ ≤ M := by simpa only [one_mul] using hterms e he

def integer_polynomial_eval₂_padicNorm_le_some_monomial {I : Type*} [Fintype I]
    (p : ℕ) [Fact p.Prime] (P : MvPolynomial I ℤ) (hP : P ≠ 0) (x : I → ℚ) :
    ∃ e ∈ P.support, padicNorm p (MvPolynomial.eval₂ (Int.castRingHom ℚ) x P) ≤
      ∏ i, (padicNorm p (x i)) ^ e i := by
  classical
  obtain ⟨e, he, hmax⟩ := Finset.exists_max_image P.support
    (fun e => ∏ i, (padicNorm p (x i)) ^ e i) (MvPolynomial.support_nonempty.mpr hP)
  exact ⟨e, he, integer_polynomial_eval₂_padicNorm_le p P x _
    (Finset.prod_nonneg fun i _ => pow_nonneg (padicNorm.nonneg _) _) hmax⟩


end
end Bounty

end SubmissionComponent_LocalPolynomialEvaluation

/- Component LocalDeterminantBounds; SHA256 2440a31b92033387b9f771d99f97f99fb1c2550374aac214f8bdae770bd3f5cf -/
section SubmissionComponent_LocalDeterminantBounds
/- Rowwise determinant bounds at the real and finite places, including the
omitted-row exponent for the actual signed cofactor normal. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def rational_det_norm_le_row_bounds {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℚ) (b : Fin n → ℝ)
    (hb : ∀ i, 0 ≤ b i) (hA : ∀ i j, ‖A i j‖ ≤ b i) :
    ‖A.det‖ ≤ (n.factorial : ℝ) * ∏ i, b i := by
  classical
  rw [Matrix.det_apply']
  calc
    _ ≤ ∑ σ : Equiv.Perm (Fin n), ‖((Equiv.Perm.sign σ : ℤ) : ℚ) * ∏ i, A (σ i) i‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _σ : Equiv.Perm (Fin n), ∏ i, b i := by
      apply Finset.sum_le_sum
      intro σ _
      have hs : ‖((Equiv.Perm.sign σ : ℤ) : ℚ)‖ = 1 := by
        rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
      rw [norm_mul, hs, one_mul, norm_prod, ← Equiv.prod_comp σ b]
      exact Finset.prod_le_prod (fun _ _ => norm_nonneg _) (fun i _ => hA (σ i) i)
    _ = _ := by simp [Fintype.card_perm]

def padicNorm_sum_cast_le {I : Type*} (p : ℕ) [Fact p.Prime]
    (s : Finset I) (f : I → ℚ) (B : ℝ) (hB : 0 ≤ B)
    (hf : ∀ i ∈ s, (padicNorm p (f i) : ℝ) ≤ B) :
    (padicNorm p (∑ i ∈ s, f i) : ℝ) ≤ B := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hB
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have hu : (padicNorm p (f a + ∑ i ∈ s, f i) : ℝ) ≤
          max (padicNorm p (f a) : ℝ) (padicNorm p (∑ i ∈ s, f i) : ℝ) := by
        exact_mod_cast (padicNorm.nonarchimedean (p := p) (q := f a) (r := ∑ i ∈ s, f i))
      exact hu.trans (max_le (hf a (Finset.mem_insert_self _ _))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))))

def rational_det_padicNorm_le_row_bounds {n : ℕ}
    (p : ℕ) [Fact p.Prime] (A : Matrix (Fin n) (Fin n) ℚ) (b : Fin n → ℝ)
    (hb : ∀ i, 0 ≤ b i) (hA : ∀ i j, (padicNorm p (A i j) : ℝ) ≤ b i) :
    (padicNorm p A.det : ℝ) ≤ ∏ i, b i := by
  classical
  rw [Matrix.det_apply']
  apply padicNorm_sum_cast_le _ _ _ _ (Finset.prod_nonneg (fun i _ => hb i))
  intro σ _
  have hs : padicNorm p (((Equiv.Perm.sign σ : ℤ) : ℚ)) = 1 := by
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
  rw [padicNorm.mul, hs, one_mul, padicNorm_finset_prod, Rat.cast_prod,
    ← Equiv.prod_comp σ b]
  exact Finset.prod_le_prod (fun i _ => by exact_mod_cast padicNorm.nonneg (A (σ i) i))
    (fun i _ => hA (σ i) i)

def cofactorNormal_norm_le {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℚ) (b : Fin (n + 1) → ℝ)
    (hb : ∀ i, 0 ≤ b i) (hX : ∀ i j, ‖X i j‖ ≤ b i) (i : Fin (n + 1)) :
    ‖cofactorNormal X i‖ ≤ (n.factorial : ℝ) * ∏ j : Fin n, b (i.succAbove j) := by
  simpa [cofactorNormal, norm_mul, norm_pow] using
    rational_det_norm_le_row_bounds (X.submatrix i.succAbove id)
      (fun j => b (i.succAbove j)) (fun j => hb _) (fun j k => hX _ _)

def cofactorNormal_padicNorm_le {n : ℕ}
    (p : ℕ) [Fact p.Prime] (X : Matrix (Fin (n + 1)) (Fin n) ℚ)
    (b : Fin (n + 1) → ℝ) (hb : ∀ i, 0 ≤ b i)
    (hX : ∀ i j, (padicNorm p (X i j) : ℝ) ≤ b i) (i : Fin (n + 1)) :
    (padicNorm p (cofactorNormal X i) : ℝ) ≤ ∏ j : Fin n, b (i.succAbove j) := by
  simpa [cofactorNormal, padicNorm_nat_pow] using
    rational_det_padicNorm_le_row_bounds p (X.submatrix i.succAbove id)
      (fun j => b (i.succAbove j)) (fun j => hb _) (fun j k => hX _ _)

def prod_exp_omit_coordinate {n : ℕ} (c : Fin (n + 1) → ℝ)
    (t : ℝ) (i : Fin (n + 1)) :
    (∏ j : Fin n, Real.exp (c (i.succAbove j) * t)) =
      Real.exp (((∑ j, c j) - c i) * t) := by
  rw [← Real.exp_sum, ← Finset.sum_mul]
  congr 2
  have h := Fin.sum_univ_succAbove c i
  linarith

def cofactorNormal_norm_le_exp {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℚ) (c : Fin (n + 1) → ℝ) (t : ℝ)
    (hX : ∀ i j, ‖X i j‖ ≤ Real.exp (c i * t)) (i : Fin (n + 1)) :
    ‖cofactorNormal X i‖ ≤ (n.factorial : ℝ) *
      Real.exp (((∑ j, c j) - c i) * t) := by
  simpa only [prod_exp_omit_coordinate] using
    cofactorNormal_norm_le X (fun i => Real.exp (c i * t))
      (fun i => (Real.exp_pos _).le) hX i

def cofactorNormal_padicNorm_le_exp {n : ℕ}
    (p : ℕ) [Fact p.Prime] (X : Matrix (Fin (n + 1)) (Fin n) ℚ)
    (c : Fin (n + 1) → ℝ) (t : ℝ)
    (hX : ∀ i j, (padicNorm p (X i j) : ℝ) ≤ Real.exp (c i * t)) (i : Fin (n + 1)) :
    (padicNorm p (cofactorNormal X i) : ℝ) ≤ Real.exp (((∑ j, c j) - c i) * t) := by
  simpa only [prod_exp_omit_coordinate] using
    cofactorNormal_padicNorm_le p X (fun i => Real.exp (c i * t))
      (fun i => (Real.exp_pos _).le) hX i


end
end Bounty

end SubmissionComponent_LocalDeterminantBounds

/- Component CompoundMatrixBounds; SHA256 6ba8c99fef16eddca4dbfa1712aa33ff10cfbaf2034e963d39443261a4c3e879 -/
section SubmissionComponent_CompoundMatrixBounds
/- Actual archimedean and finite-place bounds for compound entries. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def product_min_le_min_product {I : Type*} [Fintype I]
    (a b : I → ℝ) (ha : ∀ i, 0 ≤ a i) (hb : ∀ i, 0 ≤ b i) :
    (∏ i, min (a i) (b i)) ≤ min (∏ i, a i) (∏ i, b i) := by
  apply le_min
  · exact Finset.prod_le_prod (fun i _ => le_min (ha i) (hb i))
      (fun i _ => min_le_left _ _)
  · exact Finset.prod_le_prod (fun i _ => le_min (ha i) (hb i))
      (fun i _ => min_le_right _ _)

def rational_det_norm_le_permutation_bound {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℚ) (B : ℝ)
    (hA : ∀ σ : Equiv.Perm (Fin n), (∏ i, ‖A (σ i) i‖) ≤ B) :
    ‖A.det‖ ≤ (n.factorial : ℝ) * B := by
  classical
  rw [Matrix.det_apply']
  calc
    _ ≤ ∑ σ : Equiv.Perm (Fin n), ‖((Equiv.Perm.sign σ : ℤ) : ℚ) * ∏ i, A (σ i) i‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _σ : Equiv.Perm (Fin n), B := by
      apply Finset.sum_le_sum
      intro σ _
      have hs : ‖((Equiv.Perm.sign σ : ℤ) : ℚ)‖ = 1 := by
        rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]
      simpa only [norm_mul, hs, one_mul, norm_prod] using hA σ
    _ = _ := by simp [Fintype.card_perm]

def rational_det_norm_le_row_column_min {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℚ) (K : ℝ) (b r c : Fin n → ℝ)
    (hK : 0 ≤ K) (hb : ∀ i, 0 ≤ b i) (hr : ∀ i, 0 ≤ r i) (hc : ∀ i, 0 ≤ c i)
    (hA : ∀ i j, ‖A i j‖ ≤ K * b i * min (r i) (c j)) :
    ‖A.det‖ ≤ (n.factorial : ℝ) * K ^ n * (∏ i, b i) *
      min (∏ i, r i) (∏ i, c i) := by
  have hh := rational_det_norm_le_permutation_bound A
    (K ^ n * (∏ i, b i) * min (∏ i, r i) (∏ i, c i)) (by
      intro σ
      calc
        _ ≤ ∏ i, K * b (σ i) * min (r (σ i)) (c i) :=
          Finset.prod_le_prod (fun i _ => norm_nonneg _) (fun i _ => hA (σ i) i)
        _ = K ^ n * (∏ i, b i) * (∏ i, min (r (σ i)) (c i)) := by
          rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const]
          simp only [Finset.card_univ, Fintype.card_fin, Equiv.prod_comp]
        _ ≤ _ := by
          apply mul_le_mul_of_nonneg_left _
            (mul_nonneg (pow_nonneg hK _) (Finset.prod_nonneg (fun i _ => hb i)))
          simpa only [Equiv.prod_comp] using
            product_min_le_min_product (fun i => r (σ i)) c (fun i => hr _) hc)
  simpa only [mul_assoc] using hh

def compoundCoordinateProduct {d ell : ℕ} (b : Fin d → ℝ)
    (s : CompoundIndex d ell) : ℝ := ∏ i : Fin ell, b (compoundIndexEmbedding s i)

def compoundCoordinateProduct_nonneg {d ell : ℕ} (b : Fin d → ℝ)
    (hb : ∀ i, 0 ≤ b i) (s : CompoundIndex d ell) :
    0 ≤ compoundCoordinateProduct b s := Finset.prod_nonneg (fun _ _ => hb _)

def compoundCoordinateProduct_pos {d ell : ℕ} (b : Fin d → ℝ)
    (hb : ∀ i, 0 < b i) (s : CompoundIndex d ell) :
    0 < compoundCoordinateProduct b s := Finset.prod_pos (fun _ _ => hb _)

def compoundMatrix_norm_le_min {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) ℚ) (K : ℝ) (b r c : Fin d → ℝ)
    (hK : 0 ≤ K) (hb : ∀ i, 0 ≤ b i) (hr : ∀ i, 0 ≤ r i) (hc : ∀ i, 0 ≤ c i)
    (hM : ∀ i j, ‖M i j‖ ≤ K * b i * min (r i) (c j))
    (s t : CompoundIndex d ell) :
    ‖compoundMatrix ell M s t‖ ≤
      (ell.factorial : ℝ) * K ^ ell * compoundCoordinateProduct b s *
        min (compoundCoordinateProduct r s) (compoundCoordinateProduct c t) := by
  rw [compoundMatrix_apply]
  exact rational_det_norm_le_row_column_min _ K
    (fun i => b (compoundIndexEmbedding s i)) (fun i => r (compoundIndexEmbedding s i))
    (fun j => c (compoundIndexEmbedding t j)) hK (fun _ => hb _) (fun _ => hr _)
    (fun _ => hc _) (fun _ _ => hM _ _)

def compoundMatrix_padicNorm_le {d ell : ℕ}
    (p : ℕ) [Fact p.Prime] (M : Matrix (Fin d) (Fin d) ℚ)
    (b : Fin d → ℝ) (hb : ∀ i, 0 ≤ b i)
    (hM : ∀ i j, (padicNorm p (M i j) : ℝ) ≤ b i)
    (s t : CompoundIndex d ell) :
    (padicNorm p (compoundMatrix ell M s t) : ℝ) ≤ compoundCoordinateProduct b s := by
  rw [compoundMatrix_apply]
  exact rational_det_padicNorm_le_row_bounds p _
    (fun i => b (compoundIndexEmbedding s i)) (fun _ => hb _) (fun _ _ => hM _ _)

def compoundMatrix_davenport_bound {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) ℚ) (p : Equiv.Perm (Fin d))
    (K : ℝ) (b lam : Fin d → ℝ) (hK : 0 ≤ K)
    (hb : ∀ i, 0 ≤ b i) (hlam : ∀ i, 0 ≤ lam i)
    (hM : ∀ i j, ‖M (p i) j‖ ≤ K * b (p i) * min (lam i) (lam j))
    (s t : CompoundIndex d ell) :
    ‖compoundMatrix ell M s t‖ ≤
      (ell.factorial : ℝ) * K ^ ell * compoundCoordinateProduct b s *
        min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundCoordinateProduct lam t) := by
  apply compoundMatrix_norm_le_min M K b (lam ∘ p.symm) lam hK hb (fun _ => hlam _) hlam
  intro i j
  simpa only [p.apply_symm_apply, Function.comp_apply] using hM (p.symm i) j

end
end Bounty

end SubmissionComponent_CompoundMatrixBounds

/- Component FiniteExponentProfiles; SHA256 4809703dd70bbb7a13f0da999b455eeecf4e348962d738cdc9c0824e623a11fd -/
section SubmissionComponent_FiniteExponentProfiles
/- A finite partition by coordinatewise upper mesh rounding, preserving
nonpositive coordinates and half of a negative total exponent margin. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def exponentProfileMesh (I : Type*) [Fintype I] (ρ : ℝ) : ℝ :=
  ρ / (2 * Fintype.card I)

def upperMeshProfile {I : Type*} (δ : ℝ) (a : I → ℝ) (i : I) : ℝ :=
  δ * (Int.ceil (a i / δ) : ℝ)

def exponentProfileMesh_pos (I : Type*) [Fintype I] [Nonempty I]
    (ρ : ℝ) (hρ : 0 < ρ) : 0 < exponentProfileMesh I ρ := by
  unfold exponentProfileMesh
  exact div_pos hρ (mul_pos (by norm_num) (by exact_mod_cast Fintype.card_pos))

def upperMeshProfile_bounds {I : Type*} (δ : ℝ) (hδ : 0 < δ)
    (a : I → ℝ) (i : I) : a i ≤ upperMeshProfile δ a i ∧
      upperMeshProfile δ a i < a i + δ := by
  have heq : δ * (a i / δ) = a i := by field_simp
  constructor
  · have hh := mul_le_mul_of_nonneg_left (Int.le_ceil (a i / δ)) hδ.le
    simpa only [heq, upperMeshProfile] using hh
  · have hh := mul_lt_mul_of_pos_left (Int.ceil_lt_add_one (a i / δ)) hδ
    simpa only [mul_add, heq, mul_one, upperMeshProfile] using hh

def upperMeshProfile_nonpos {I : Type*} (δ : ℝ) (hδ : 0 < δ)
    (a : I → ℝ) (i : I) (ha : a i ≤ 0) : upperMeshProfile δ a i ≤ 0 := by
  have hh : Int.ceil (a i / δ) ≤ 0 :=
    Int.ceil_nonpos.mpr (div_nonpos_of_nonpos_of_nonneg ha hδ.le)
  exact mul_nonpos_of_nonneg_of_nonpos hδ.le (by exact_mod_cast hh)

def upperMeshProfile_abs_le {I : Type*} (δ : ℝ) (hδ : 0 < δ)
    (M : ℝ) (a : I → ℝ) (ha : ∀ i, |a i| ≤ M) (i : I) :
    |upperMeshProfile δ a i| ≤ M + δ := by
  obtain ⟨hlo, hhi⟩ := upperMeshProfile_bounds δ hδ a i
  obtain ⟨hal, har⟩ := abs_le.mp (ha i)
  exact abs_le.mpr ⟨by linarith, by linarith⟩

def upperMeshProfile_sum_le_half {I : Type*} [Fintype I] [Nonempty I]
    (ρ : ℝ) (hρ : 0 < ρ) (a : I → ℝ) (ha : ∑ i, a i ≤ -ρ) :
    ∑ i, upperMeshProfile (exponentProfileMesh I ρ) a i ≤ -ρ / 2 := by
  have hδ := exponentProfileMesh_pos I ρ hρ
  have hs : (∑ i, upperMeshProfile (exponentProfileMesh I ρ) a i) ≤
      ∑ i, (a i + exponentProfileMesh I ρ) :=
    Finset.sum_le_sum (fun i _ => (upperMeshProfile_bounds _ hδ a i).2.le)
  have hn : (Fintype.card I : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_pos.ne'
  have hmass : (Fintype.card I : ℝ) * exponentProfileMesh I ρ = ρ / 2 := by
    unfold exponentProfileMesh
    field_simp
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, hmass] at hs
  linarith

/-- The integer tuples in this explicit box enumerate all possible rounded
profiles for coordinates in `[-M,M]`. -/
def exponentProfileIntegerBox (I : Type*) [Fintype I] (M δ : ℝ) : Finset (I → ℤ) := by
  classical
  exact Fintype.piFinset (fun _ => Finset.Icc (Int.ceil (-M / δ)) (Int.ceil (M / δ)))

def exponentProfiles (I : Type*) [Fintype I] (M ρ : ℝ) : Finset (I → ℝ) := by
  classical
  let δ := exponentProfileMesh I ρ
  exact ((exponentProfileIntegerBox I M δ).image (fun v i => δ * (v i : ℝ))).filter
    (fun c => (∀ i, |c i| ≤ M + δ) ∧ ∑ i, c i ≤ -ρ / 2)

def exponentProfiles_properties {I : Type*} [Fintype I] (M ρ : ℝ)
    (c : I → ℝ) (hc : c ∈ exponentProfiles I M ρ) :
    (∀ i, |c i| ≤ M + ρ / (2 * Fintype.card I)) ∧ ∑ i, c i ≤ -ρ / 2 := by
  classical
  exact (Finset.mem_filter.mp hc).2

def upperMeshProfile_mem_exponentProfiles {I : Type*} [Fintype I] [Nonempty I]
    (M ρ : ℝ) (hρ : 0 < ρ) (a : I → ℝ)
    (hab : ∀ i, |a i| ≤ M) (has : ∑ i, a i ≤ -ρ) :
    upperMeshProfile (exponentProfileMesh I ρ) a ∈ exponentProfiles I M ρ := by
  classical
  have hδ := exponentProfileMesh_pos I ρ hρ
  apply Finset.mem_filter.mpr
  constructor
  · apply Finset.mem_image.mpr
    refine ⟨fun i => Int.ceil (a i / exponentProfileMesh I ρ), ?_, rfl⟩
    apply Fintype.mem_piFinset.mpr
    intro i
    obtain ⟨hlo, hhi⟩ := abs_le.mp (hab i)
    exact Finset.mem_Icc.mpr ⟨Int.ceil_mono (div_le_div_of_nonneg_right hlo hδ.le),
      Int.ceil_mono (div_le_div_of_nonneg_right hhi hδ.le)⟩
  · exact ⟨upperMeshProfile_abs_le _ hδ M a hab, upperMeshProfile_sum_le_half ρ hρ a has⟩

/-- Every bounded exponent tuple of total at most `-ρ` is dominated by one
member of an actual finite family.  All members have the stated size and
negative-sum bounds, and the selected member preserves every nonpositive
coordinate of the input. -/
def exists_finite_exponent_profiles (I : Type*) [Fintype I] [Nonempty I]
    (M ρ : ℝ) (hρ : 0 < ρ) :
    ∃ C : Finset (I → ℝ),
      (∀ c ∈ C, (∀ i, |c i| ≤ M + ρ / (2 * Fintype.card I)) ∧ ∑ i, c i ≤ -ρ / 2) ∧
      ∀ a : I → ℝ, (∀ i, |a i| ≤ M) → (∑ i, a i ≤ -ρ) →
        ∃ c ∈ C, (∀ i, a i ≤ c i) ∧ (∀ i, a i ≤ 0 → c i ≤ 0) := by
  refine ⟨exponentProfiles I M ρ, fun c hc => exponentProfiles_properties M ρ c hc, ?_⟩
  intro a hab has
  have hδ := exponentProfileMesh_pos I ρ hρ
  exact ⟨upperMeshProfile (exponentProfileMesh I ρ) a,
    upperMeshProfile_mem_exponentProfiles M ρ hρ a hab has,
    fun i => (upperMeshProfile_bounds _ hδ a i).1,
    fun i hi => upperMeshProfile_nonpos _ hδ a i hi⟩

/-- All members can be required to be nonpositive on a designated set of
coordinates, while still covering every input with those signs. -/
def exists_finite_exponent_profiles_nonpos_on (I : Type*) [Fintype I] [Nonempty I]
    (S : Set I) (M ρ : ℝ) (hρ : 0 < ρ) :
    ∃ C : Finset (I → ℝ),
      (∀ c ∈ C, (∀ i, |c i| ≤ M + ρ / (2 * Fintype.card I)) ∧
        (∑ i, c i ≤ -ρ / 2) ∧ (∀ i ∈ S, c i ≤ 0)) ∧
      ∀ a : I → ℝ, (∀ i, |a i| ≤ M) → (∑ i, a i ≤ -ρ) →
        (∀ i ∈ S, a i ≤ 0) → ∃ c ∈ C, (∀ i, a i ≤ c i) ∧
          (∀ i, a i ≤ 0 → c i ≤ 0) := by
  classical
  obtain ⟨C, hC, hcover⟩ := exists_finite_exponent_profiles I M ρ hρ
  refine ⟨C.filter (fun c => ∀ i ∈ S, c i ≤ 0), ?_, ?_⟩
  · intro c hc
    obtain ⟨hc, hs⟩ := Finset.mem_filter.mp hc
    exact ⟨(hC c hc).1, (hC c hc).2, hs⟩
  · intro a hab has haS
    obtain ⟨c, hc, hle, hsign⟩ := hcover a hab has
    exact ⟨c, Finset.mem_filter.mpr ⟨hc, fun i hi => hsign i (haS i hi)⟩, hle, hsign⟩

end
end Bounty

end SubmissionComponent_FiniteExponentProfiles

/- Component ProductExponentProfiles; SHA256 4d87cc5f3e8e374f359cd4d824443a00f3f23ba330b117abe283fec03860c85d -/
section SubmissionComponent_ProductExponentProfiles
/- A small product of positive local values is covered by finitely many fixed profiles. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def normalized_log_profile_bounds {I : Type*} [Fintype I]
    (f : I → ℝ) (q M ρ : ℝ) (hq : 0 < q)
    (hlo : ∀ i, Real.exp (-M * q) ≤ f i)
    (hhi : ∀ i, f i ≤ Real.exp (M * q))
    (hprod : ∏ i, f i ≤ Real.exp (-ρ * q)) :
    (∀ i, |Real.log (f i) / q| ≤ M) ∧
      (∑ i, Real.log (f i) / q) ≤ -ρ := by
  have hpos : ∀ i, 0 < f i := fun i => (Real.exp_pos _).trans_le (hlo i)
  constructor
  · intro i
    apply abs_le.mpr
    constructor
    · apply (le_div_iff₀ hq).mpr
      exact (Real.le_log_iff_exp_le (hpos i)).mpr (hlo i)
    · apply (div_le_iff₀ hq).mpr
      exact (Real.log_le_iff_le_exp (hpos i)).mpr (hhi i)
  · rw [← Finset.sum_div]
    apply (div_le_iff₀ hq).mpr
    rw [← Real.log_prod (fun i _ => (hpos i).ne')]
    exact (Real.log_le_iff_le_exp (Finset.prod_pos (fun i _ => hpos i))).mpr hprod

def exists_finite_product_profiles (I : Type*) [Fintype I] [Nonempty I]
    (S : Set I) (M ρ : ℝ) (hρ : 0 < ρ) :
    ∃ C : Finset (I → ℝ),
      (∀ c ∈ C, (∀ i, |c i| ≤ M + ρ / (2 * Fintype.card I)) ∧
        (∑ i, c i ≤ -ρ / 2) ∧ (∀ i ∈ S, c i ≤ 0)) ∧
      ∀ (q : ℝ) (f : I → ℝ), 0 < q →
        (∀ i, Real.exp (-M * q) ≤ f i) →
        (∀ i, f i ≤ Real.exp (M * q)) →
        (∏ i, f i ≤ Real.exp (-ρ * q)) →
        (∀ i ∈ S, f i ≤ 1) →
        ∃ c ∈ C, ∀ i, f i ≤ Real.exp (c i * q) := by
  obtain ⟨C, hC, hcover⟩ := exists_finite_exponent_profiles_nonpos_on I S M ρ hρ
  refine ⟨C, hC, ?_⟩
  intro q f hq hlo hhi hprod hsign
  have hpos : ∀ i, 0 < f i := fun i => (Real.exp_pos _).trans_le (hlo i)
  obtain ⟨hab, has⟩ := normalized_log_profile_bounds f q M ρ hq hlo hhi hprod
  obtain ⟨c, hc, hle, _⟩ := hcover (fun i => Real.log (f i) / q) hab has (by
    intro i hi
    apply div_nonpos_of_nonpos_of_nonneg _ hq.le
    exact Real.log_nonpos (hpos i).le (hsign i hi))
  refine ⟨c, hc, fun i => ?_⟩
  apply (Real.log_le_iff_le_exp (hpos i)).mp
  exact (div_le_iff₀ hq).mp (hle i)

def exists_finite_three_place_product_profiles (d : ℕ) (hd : 0 < d)
    (M ρ : ℝ) (hρ : 0 < ρ) :
    ∃ C : Finset (Fin 3 → Fin d → ℝ),
      (∀ c ∈ C, (∀ v i, |c v i| ≤ M + ρ / (6 * d)) ∧
        (∑ v, ∑ i, c v i) ≤ -ρ / 2 ∧ (∀ v i, v ≠ 0 → c v i ≤ 0)) ∧
      ∀ (q : ℝ) (f : Fin 3 → Fin d → ℝ), 0 < q →
        (∀ v i, Real.exp (-M * q) ≤ f v i) →
        (∀ v i, f v i ≤ Real.exp (M * q)) →
        (∏ v, ∏ i, f v i) ≤ Real.exp (-ρ * q) →
        (∀ v i, v ≠ 0 → f v i ≤ 1) →
        ∃ c ∈ C, ∀ v i, f v i ≤ Real.exp (c v i * q) := by
  classical
  let : NeZero d := ⟨hd.ne'⟩
  obtain ⟨C, hC, hcover⟩ := exists_finite_product_profiles (Fin 3 × Fin d)
    {i | i.1 ≠ 0} M ρ hρ
  refine ⟨C.image Function.curry, ?_, ?_⟩
  · intro c hc
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hc
    obtain ⟨hab, has, hsign⟩ := hC a ha
    refine ⟨?_, ?_, ?_⟩
    · intro v i
      convert hab (v, i) using 1 <;> simp [Function.curry, Fintype.card_prod, Nat.cast_mul]
      ring
    · simpa only [Fintype.sum_prod_type, Function.curry] using has
    · intro v i hv
      exact hsign (v, i) hv
  · intro q f hq hlo hhi hprod hsign
    obtain ⟨c, hc, hbound⟩ := hcover q (Function.uncurry f) hq
      (fun i => hlo i.1 i.2) (fun i => hhi i.1 i.2)
      (by simpa only [Fintype.prod_prod_type, Function.uncurry] using hprod)
      (fun i hi => hsign i.1 i.2 hi)
    exact ⟨Function.curry c, Finset.mem_image.mpr ⟨c, hc, rfl⟩, fun v i => hbound (v, i)⟩

end
end Bounty

end SubmissionComponent_ProductExponentProfiles

/- Component CompoundBoxProfiles; SHA256 b3037859c962e75c896700972a36e8b9d055f44f351dd59197ed8eeb61855545 -/
section SubmissionComponent_CompoundBoxProfiles
/- Actual clipped compound boxes and their logarithmic three-place profiles. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def compoundLocalWidths {d ell : ℕ} (K : ℝ) (b : Fin 3 → Fin d → ℝ)
    (lam : Fin d → ℝ) (p : Equiv.Perm (Fin d)) (tau : ℝ) :
    Fin 3 → CompoundIndex d ell → ℝ :=
  ![fun s => (ell.factorial : ℝ) * K ^ ell * compoundCoordinateProduct (b 0) s *
      min (compoundCoordinateProduct (lam ∘ p.symm) s) tau,
    compoundCoordinateProduct (b 1), compoundCoordinateProduct (b 2)]

def compoundLogProfile {d ell : ℕ} (K : ℝ) (b : Fin 3 → Fin d → ℝ)
    (lam : Fin d → ℝ) (p : Equiv.Perm (Fin d)) (tau q : ℝ) :
    Fin 3 → CompoundIndex d ell → ℝ :=
  fun v s => Real.log (compoundLocalWidths K b lam p tau v s) / q

def compoundLocalWidths_pos {d ell : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (tau : ℝ) (hK : 0 < K)
    (hb : ∀ v i, 0 < b v i) (hlam : ∀ i, 0 < lam i) (htau : 0 < tau)
    (v : Fin 3) (s : CompoundIndex d ell) :
    0 < compoundLocalWidths K b lam p tau v s := by
  fin_cases v
  · change 0 < (ell.factorial : ℝ) * K ^ ell * compoundCoordinateProduct (b 0) s *
      min (compoundCoordinateProduct (lam ∘ p.symm) s) tau
    exact mul_pos (mul_pos (mul_pos (by exact_mod_cast Nat.factorial_pos ell)
      (pow_pos hK _)) (compoundCoordinateProduct_pos _ (hb 0) s))
      (lt_min (compoundCoordinateProduct_pos _ (fun i => hlam _) s) htau)
  · exact compoundCoordinateProduct_pos _ (hb 1) s
  · exact compoundCoordinateProduct_pos _ (hb 2) s

def exp_compoundLogProfile {d ell : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (tau q : ℝ) (hK : 0 < K)
    (hb : ∀ v i, 0 < b v i) (hlam : ∀ i, 0 < lam i)
    (htau : 0 < tau) (hq : q ≠ 0) (v : Fin 3) (s : CompoundIndex d ell) :
    Real.exp (compoundLogProfile K b lam p tau q v s * q) =
      compoundLocalWidths K b lam p tau v s := by
  rw [compoundLogProfile, div_mul_cancel₀ _ hq, Real.exp_log
    (compoundLocalWidths_pos K b lam p tau hK hb hlam htau v s)]

def compoundMatrix_clipped_local_bounds {d ell : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (H : Matrix (Fin d) (Fin d) ℤ)
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (tau : ℝ) (hK : 0 ≤ K)
    (hb : ∀ v i, 0 ≤ b v i) (hlam : ∀ i, 0 ≤ lam i)
    (hInf : ∀ i j, ‖(A * H.map (Int.castRingHom ℚ)) (p i) j‖ ≤
      K * b 0 (p i) * min (lam i) (lam j))
    (hTwo : ∀ i j, (padicNorm 2 (H i j : ℚ) : ℝ) ≤ b 1 i)
    (hThree : ∀ i j, (padicNorm 3 (H i j : ℚ) : ℝ) ≤ b 2 i)
    (t : CompoundIndex d ell) (ht : compoundCoordinateProduct lam t ≤ tau) :
    (∀ s, ‖(compoundMatrix ell A * (compoundMatrix ell H).map (Int.castRingHom ℚ)) s t‖ ≤
      compoundLocalWidths K b lam p tau 0 s) ∧
    (∀ s, (padicNorm 2 ((compoundMatrix ell H s t : ℤ) : ℚ) : ℝ) ≤
      compoundLocalWidths K b lam p tau 1 s) ∧
    (∀ s, (padicNorm 3 ((compoundMatrix ell H s t : ℤ) : ℚ) : ℝ) ≤
      compoundLocalWidths K b lam p tau 2 s) := by
  have hmap : compoundMatrix ell (H.map (Int.castRingHom ℚ)) =
      (compoundMatrix ell H).map (Int.castRingHom ℚ) :=
    compoundMatrix_map (Int.castRingHom ℚ) ell H
  constructor
  · intro s
    rw [← hmap, ← compoundMatrix_mul]
    apply (compoundMatrix_davenport_bound _ p K (b 0) lam hK (hb 0) hlam hInf s t).trans
    apply mul_le_mul_of_nonneg_left (min_le_min_left _ ht)
    exact mul_nonneg (mul_nonneg (by exact_mod_cast Nat.factorial_pos ell |>.le)
      (pow_nonneg hK _)) (compoundCoordinateProduct_nonneg _ (hb 0) s)
  · constructor
    · intro s
      have hh := compoundMatrix_padicNorm_le 2 (H.map (Int.castRingHom ℚ)) (b 1) (hb 1) hTwo s t
      rw [hmap] at hh
      change (padicNorm 2 ((compoundMatrix ell H s t : ℤ) : ℚ) : ℝ) ≤ compoundCoordinateProduct (b 1) s
      exact hh
    · intro s
      have hh := compoundMatrix_padicNorm_le 3 (H.map (Int.castRingHom ℚ)) (b 2) (hb 2) hThree s t
      rw [hmap] at hh
      change (padicNorm 3 ((compoundMatrix ell H s t : ℤ) : ℚ) : ℝ) ≤ compoundCoordinateProduct (b 2) s
      exact hh

def compoundLogProfile_sum {d ell : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (tau q : ℝ) (hK : 0 < K)
    (hb : ∀ v i, 0 < b v i) (hlam : ∀ i, 0 < lam i) (htau : 0 < tau) :
    (∑ v, ∑ s : CompoundIndex d ell, compoundLogProfile K b lam p tau q v s) =
      Real.log (∏ v, ∏ s : CompoundIndex d ell, compoundLocalWidths K b lam p tau v s) / q := by
  simp only [compoundLogProfile, ← Finset.sum_div]
  congr 1
  rw [Real.log_prod (fun v _ => (Finset.prod_pos (fun s _ =>
    compoundLocalWidths_pos K b lam p tau hK hb hlam htau v s)).ne')]
  apply Finset.sum_congr rfl
  intro v _
  exact (Real.log_prod (fun s _ =>
    (compoundLocalWidths_pos K b lam p tau hK hb hlam htau v s).ne')).symm

end
end Bounty

end SubmissionComponent_CompoundBoxProfiles

/- Component ThreePlaceExactWidths; SHA256 d11b013ea9a03a431010fa87bfdd38cb850086277657b7615b7b588df0d70634 -/
section SubmissionComponent_ThreePlaceExactWidths
/- Exact prime-power local widths, with no rounding loss in their product. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix
open Module MeasureTheory

def threePlaceExactWidths {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) : Fin 3 → Fin d → ℝ :=
  ![threePlaceWidth c q,
    fun i => Real.exp (-(Nat.ceil (-(c 1 i * q) / Real.log 2) : ℝ) * Real.log 2),
    fun i => Real.exp (-(Nat.ceil (-(c 2 i * q) / Real.log 3) : ℝ) * Real.log 3)]

def threePlaceExactWidths_zero {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (i : Fin d) :
    threePlaceExactWidths c q 0 i = threePlaceWidth c q i := rfl

def threePlaceExactWidths_pos {d : ℕ} (c : Fin 3 → Fin d → ℝ) (q : ℝ) (v : Fin 3) (i : Fin d) :
    0 < threePlaceExactWidths c q v i := by fin_cases v <;> exact Real.exp_pos _

def prime_power_width (p : ℕ) (hp : 0 < p) (n : ℕ) :
    Real.exp (-(n : ℝ) * Real.log p) = ((p : ℝ) ^ n)⁻¹ := by
  rw [neg_mul, Real.exp_neg, Real.exp_nat_mul, Real.exp_log (by exact_mod_cast hp)]

def threePlaceExactWidths_finite_product {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    (q : ℝ) (i : Fin d) :
    threePlaceExactWidths c q 1 i * threePlaceExactWidths c q 2 i =
      (threePlaceDiagonal c q i : ℝ)⁻¹ := by
  change Real.exp _ * Real.exp _ = _
  have h2 := prime_power_width 2 (by norm_num) (Nat.ceil (-(c 1 i * q) / Real.log 2))
  have h3 := prime_power_width 3 (by norm_num) (Nat.ceil (-(c 2 i * q) / Real.log 3))
  norm_num only [Nat.cast_ofNat] at h2 h3
  rw [h2, h3]
  simp only [threePlaceDiagonal, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat, mul_inv_rev]
  ring

def padicNorm_int_le_prime_power_width (p : ℕ) [Fact p.Prime] (n : ℕ) (x : ℤ)
    (hx : ((p ^ n : ℕ) : ℤ) ∣ x) :
    (padicNorm p (x : ℚ) : ℝ) ≤ Real.exp (-(n : ℝ) * Real.log p) := by
  rw [prime_power_width p (Fact.out : p.Prime).pos n]
  have hh := (padicNorm.dvd_iff_norm_le (p := p)).mp hx
  simp only [zpow_neg, zpow_natCast] at hh
  have hhR : (padicNorm p (x : ℚ) : ℝ) ≤ ((((p : ℚ) ^ n)⁻¹ : ℚ) : ℝ) := by exact_mod_cast hh
  simpa only [Rat.cast_inv, Rat.cast_pow, Rat.cast_natCast] using hhR

def threePlaceExactWidths_padic_bounds {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    (q : ℝ) (i : Fin d) (x : ℤ) (hx : (threePlaceDiagonal c q i : ℤ) ∣ x) :
    (padicNorm 2 (x : ℚ) : ℝ) ≤ threePlaceExactWidths c q 1 i ∧
      (padicNorm 3 (x : ℚ) : ℝ) ≤ threePlaceExactWidths c q 2 i := by
  obtain ⟨h2, h3⟩ := (two_three_pow_dvd_int_iff _ _ x).mp hx
  exact ⟨padicNorm_int_le_prime_power_width 2 _ x h2, padicNorm_int_le_prime_power_width 3 _ x h3⟩

def prime_exact_width_exp_bounds (p : ℕ) (hp : 1 < p) (hp3 : p ≤ 3)
    {t M q : ℝ} (hM : 0 ≤ M) (hq : 1 ≤ q) (ht : |t| ≤ M) :
    Real.exp (-(M + Real.log 3) * q) ≤
        Real.exp (-(Nat.ceil (-(t * q) / Real.log p) : ℝ) * Real.log p) ∧
      Real.exp (-(Nat.ceil (-(t * q) / Real.log p) : ℝ) * Real.log p) ≤
        Real.exp ((M + Real.log 3) * q) := by
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq
  have hpl : 0 < Real.log (p : ℝ) := Real.log_pos (by exact_mod_cast hp)
  have h3 : 0 < Real.log (3 : ℝ) := Real.log_pos (by norm_num)
  have hcv : -(t * q) ≤ M * q := by
    have hh := mul_le_mul_of_nonneg_right ((neg_le_abs t).trans ht) hq0
    linarith
  have hceil := Nat.ceil_mono (div_le_div_of_nonneg_right hcv hpl.le)
  have hceilR : (Nat.ceil (-(t * q) / Real.log p) : ℝ) ≤ Nat.ceil (M * q / Real.log p) := by exact_mod_cast hceil
  have hb := Nat.ceil_lt_add_one (div_nonneg (mul_nonneg hM hq0) hpl.le)
  have hm := mul_le_mul_of_nonneg_right (hceilR.trans hb.le) hpl.le
  rw [add_mul, div_mul_cancel₀ _ hpl.ne', one_mul] at hm
  have hpL : Real.log (p : ℝ) ≤ Real.log 3 := Real.log_le_log (by exact_mod_cast (by omega : 0 < p)) (by exact_mod_cast hp3)
  have h3q : Real.log (3 : ℝ) ≤ Real.log 3 * q := le_mul_of_one_le_right h3.le hq
  constructor
  · apply Real.exp_le_exp.mpr
    nlinarith
  · apply Real.exp_le_exp.mpr
    have hn : (0 : ℝ) ≤ Nat.ceil (-(t * q) / Real.log p) := Nat.cast_nonneg _
    nlinarith

def threePlaceExactWidths_exp_bounds {d : ℕ} (c : Fin 3 → Fin d → ℝ)
    {M q : ℝ} (hM : 0 ≤ M) (hq : 1 ≤ q) (hc : ∀ v i, |c v i| ≤ M)
    (v : Fin 3) (i : Fin d) :
    Real.exp (-(M + Real.log 3) * q) ≤ threePlaceExactWidths c q v i ∧
      threePlaceExactWidths c q v i ≤ Real.exp ((M + Real.log 3) * q) := by
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq
  have h3 : 0 ≤ Real.log (3 : ℝ) := (Real.log_pos (by norm_num)).le
  fin_cases v
  · constructor <;> apply Real.exp_le_exp.mpr
    · have hh := mul_le_mul_of_nonneg_right (abs_le.mp (hc 0 i)).1 hq0
      have hh3 := mul_nonneg h3 hq0
      nlinarith
    · have hh := mul_le_mul_of_nonneg_right (abs_le.mp (hc 0 i)).2 hq0
      have hh3 := mul_nonneg h3 hq0
      nlinarith
  · exact prime_exact_width_exp_bounds 2 (by norm_num) (by norm_num) hM hq (hc 1 i)
  · exact prime_exact_width_exp_bounds 3 (by norm_num) (by norm_num) hM hq (hc 2 i)


end
end Bounty

end SubmissionComponent_ThreePlaceExactWidths

/- Component CompoundMatrixDeterminant; SHA256 f8bc5f8dd604617b7f586aded752ccf2a26bcbe07ff372e8d01162051172411b -/
section SubmissionComponent_CompoundMatrixDeterminant
/- Determinants of actual compound matrices. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def compoundIndexEmbedding_prod {R : Type*} [CommMonoid R] {d ell : ℕ}
    (s : CompoundIndex d ell) (D : Fin d → R) :
    (∏ j, D (compoundIndexEmbedding s j)) = ∏ i ∈ s.val, D i := by
  classical
  apply Finset.prod_bij (fun j _ => compoundIndexEmbedding s j)
  · intro j _
    exact (Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem s _).mp ⟨j, rfl⟩
  · intro a _ b _ hab
    exact (compoundIndexEmbedding s).injective hab
  · intro b hb
    obtain ⟨j, hj⟩ := (Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem s b).mpr hb
    exact ⟨j, Finset.mem_univ _, hj⟩
  · intro _ _; rfl

def compoundIndex_card_containing {d ell : ℕ} (hell : 1 ≤ ell) (i : Fin d) :
    ((Finset.univ : Finset (CompoundIndex d ell)).filter (fun s => i ∈ s.val)).card =
      (d - 1).choose (ell - 1) := by
  classical
  have himage :
      (((Finset.univ : Finset (CompoundIndex d ell)).filter (fun s => i ∈ s.val)).image
        Subtype.val) = (Finset.univ.powersetCard ell).filter (fun s : Finset (Fin d) => i ∈ s) := by
    ext s
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_powersetCard, Finset.subset_univ]
    constructor
    · rintro ⟨t, hit, rfl⟩
      exact ⟨t.prop, hit⟩
    · rintro ⟨hs, his⟩
      exact ⟨⟨s, hs⟩, his, rfl⟩
  have hc := Finset.card_filter_powersetCard_subset ({i} : Finset (Fin d))
    Finset.univ ell (Finset.subset_univ _) (by simpa using hell)
  rw [← Finset.card_image_of_injective _ Subtype.val_injective, himage]
  simpa only [Finset.singleton_subset_iff, Finset.card_univ, Fintype.card_fin,
    Finset.card_singleton] using hc

def compoundIndex_prod {R : Type*} [CommMonoid R] {d ell : ℕ}
    (hell : 1 ≤ ell) (D : Fin d → R) :
    (∏ s : CompoundIndex d ell, ∏ j, D (compoundIndexEmbedding s j)) =
      (∏ i, D i) ^ ((d - 1).choose (ell - 1)) := by
  classical
  have hprod : (∏ s : CompoundIndex d ell, ∏ j, D (compoundIndexEmbedding s j)) =
      ∏ s : CompoundIndex d ell, ∏ i : Fin d, if i ∈ s.val then D i else 1 := by
    apply Finset.prod_congr rfl
    intro s _
    rw [compoundIndexEmbedding_prod, Finset.prod_ite_mem_eq]
  rw [hprod]
  rw [Finset.prod_comm]
  simp_rw [← Finset.prod_filter, Finset.prod_const, compoundIndex_card_containing hell]
  rw [Finset.prod_pow]

end
end Bounty

end SubmissionComponent_CompoundMatrixDeterminant

/- Component CompoundIndexProducts; SHA256 77e18031c0a6a11547aa024ddd509054191fe6b61e36c61fe1861b59c90cae6c -/
section SubmissionComponent_CompoundIndexProducts
/- Ordered compound-coordinate products and the exact loss from clipping one maximum. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def compoundIndexPerm {d : ℕ} (ell : ℕ) (p : Equiv.Perm (Fin d)) :
    Equiv.Perm (CompoundIndex d ell) where
  toFun := Set.powersetCard.map ell p.toEmbedding
  invFun := Set.powersetCard.map ell p.symm.toEmbedding
  left_inv s := by
    apply Subtype.ext
    ext i
    simp [Set.powersetCard.map]
  right_inv s := by
    apply Subtype.ext
    ext i
    simp [Set.powersetCard.map]

def compoundCoordinateProduct_permute {d ell : ℕ} (p : Equiv.Perm (Fin d))
    (b : Fin d → ℝ) (s : CompoundIndex d ell) :
    compoundCoordinateProduct b (compoundIndexPerm ell p s) =
      compoundCoordinateProduct (b ∘ p) s := by
  classical
  unfold compoundCoordinateProduct
  rw [compoundIndexEmbedding_prod, compoundIndexEmbedding_prod]
  change (∏ i ∈ s.val.map p.toEmbedding, b i) = ∏ i ∈ s.val, (b ∘ p) i
  rw [Finset.prod_map]
  rfl

def compoundCoordinateProduct_prod {d ell : ℕ} (hell : 1 ≤ ell) (b : Fin d → ℝ) :
    (∏ s : CompoundIndex d ell, compoundCoordinateProduct b s) =
      (∏ i, b i) ^ ((d - 1).choose (ell - 1)) :=
  compoundIndex_prod hell b

def compoundCoordinateProduct_prod_permute {d ell : ℕ}
    (p : Equiv.Perm (Fin d)) (b : Fin d → ℝ) (f : ℝ → ℝ) :
    (∏ s : CompoundIndex d ell, f (compoundCoordinateProduct (b ∘ p) s)) =
      ∏ s : CompoundIndex d ell, f (compoundCoordinateProduct b s) := by
  simp_rw [← compoundCoordinateProduct_permute]
  exact Equiv.prod_comp (compoundIndexPerm ell p)
    (fun s : CompoundIndex d ell => f (compoundCoordinateProduct b s))

def compoundTailEmbedding (d k : ℕ) : Fin (d - k) ↪o Fin d :=
  OrderEmbedding.ofStrictMono (fun j => ⟨k + j.val, by omega⟩)
    (by intro i j hij; exact Nat.add_lt_add_left hij k)

def compoundTailIndex (d k : ℕ) : CompoundIndex d (d - k) :=
  Set.powersetCard.ofFinEmbEquiv (compoundTailEmbedding d k)

def compoundIndexEmbedding_tail (d k : ℕ) :
    compoundIndexEmbedding (compoundTailIndex d k) = compoundTailEmbedding d k :=
  Set.powersetCard.ofFinEmbEquiv.symm_apply_apply _

def compoundIndex_mem_tail {d k : ℕ} (i : Fin d) :
    i ∈ (compoundTailIndex d k).val ↔ k ≤ i.val := by
  change i ∈ Set.powersetCard.ofFinEmbEquiv (compoundTailEmbedding d k) ↔ _
  rw [Set.powersetCard.mem_ofFinEmbEquiv_iff_mem_range]
  constructor
  · rintro ⟨j, rfl⟩
    exact Nat.le_add_right k _
  · intro hi
    refine ⟨⟨i.val - k, by omega⟩, ?_⟩
    apply Fin.ext
    change k + (i.val - k) = i.val
    omega

def orderEmbedding_fin_upper {d ell : ℕ} (hell : ell ≤ d)
    (e : Fin ell ↪o Fin d) (i : Fin ell) : (e i).val ≤ d - ell + i.val := by
  cases ell with
  | zero => exact Fin.elim0 i
  | succ n =>
    refine Fin.reverseInduction ?_ ?_ i
    · have h := (e (Fin.last n)).isLt
      simp only [Fin.val_last]
      omega
    · intro j ih
      have hs := e.strictMono j.castSucc_lt_succ
      change (e j.castSucc).val < (e j.succ).val at hs
      simp only [Fin.val_castSucc, Fin.val_succ] at ih ⊢
      omega

def orderEmbedding_fin_lower {d ell : ℕ} (hell : 0 < ell)
    (e : Fin ell ↪o Fin d) (i : Fin ell) : (e ⟨0, hell⟩).val + i.val ≤ (e i).val := by
  cases ell with
  | zero => omega
  | succ n =>
  refine Fin.induction ?_ ?_ i
  · simp
  · intro j ih
    have hs := e.strictMono j.castSucc_lt_succ
    change (e j.castSucc).val < (e j.succ).val at hs
    simp only [Fin.val_castSucc, Fin.val_succ] at ih ⊢
    omega

def compoundIndex_first_lt_of_ne_tail {d k : ℕ} (hk : k < d)
    (s : CompoundIndex d (d - k)) (hs : s ≠ compoundTailIndex d k) :
    (compoundIndexEmbedding s ⟨0, by omega⟩).val < k := by
  by_contra hn
  apply hs
  apply Set.powersetCard.ofFinEmbEquiv.symm.injective
  change compoundIndexEmbedding s = compoundIndexEmbedding (compoundTailIndex d k)
  rw [compoundIndexEmbedding_tail]
  ext j
  have hu := orderEmbedding_fin_upper (Nat.sub_le d k) (compoundIndexEmbedding s) j
  have hl := orderEmbedding_fin_lower (Nat.sub_pos_of_lt hk) (compoundIndexEmbedding s) j
  change (compoundIndexEmbedding s j).val = k + j.val
  omega

def compoundGapRatio {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d) : ℝ :=
  lam ⟨k, hk⟩ / lam ⟨k - 1, by omega⟩

def compoundClipLevel {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d) : ℝ :=
  compoundCoordinateProduct lam (compoundTailIndex d k) / compoundGapRatio lam hk

def compoundGapRatio_pos {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) : 0 < compoundGapRatio lam hk :=
  div_pos (hpos _) (hpos _)

def compoundGapRatio_one_le {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam) : 1 ≤ compoundGapRatio lam hk := by
  apply (le_div_iff₀ (hpos _)).mpr
  simpa only [one_mul] using hmono (show (⟨k - 1, by omega⟩ : Fin d) ≤ ⟨k, hk⟩ from by
    change k - 1 ≤ k; omega)

def compoundClipLevel_pos {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) : 0 < compoundClipLevel lam hk :=
  div_pos (compoundCoordinateProduct_pos lam hpos _) (compoundGapRatio_pos lam hk hpos)

def compoundClipLevel_le_tail {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam) :
    compoundClipLevel lam hk ≤ compoundCoordinateProduct lam (compoundTailIndex d k) := by
  exact div_le_self (compoundCoordinateProduct_pos lam hpos _).le
    (compoundGapRatio_one_le lam hk hpos hmono)

def compoundCoordinateProduct_le_clip_of_ne_tail {d k : ℕ}
    (lam : Fin d → ℝ) (hkpos : 1 ≤ k) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam)
    (s : CompoundIndex d (d - k)) (hs : s ≠ compoundTailIndex d k) :
    compoundCoordinateProduct lam s ≤ compoundClipLevel lam hk := by
  classical
  let z : Fin (d - k) := ⟨0, by omega⟩
  let tailRest : ℝ := ∏ j ∈ Finset.univ.erase z, lam (compoundTailEmbedding d k j)
  have htail : compoundCoordinateProduct lam (compoundTailIndex d k) =
      lam ⟨k, hk⟩ * tailRest := by
    unfold compoundCoordinateProduct
    rw [compoundIndexEmbedding_tail]
    exact (Finset.mul_prod_erase Finset.univ
      (fun j => lam (compoundTailEmbedding d k j)) (Finset.mem_univ z)).symm
  have hclip : compoundClipLevel lam hk = lam ⟨k - 1, by omega⟩ * tailRest := by
    rw [compoundClipLevel, htail, compoundGapRatio]
    field_simp [ne_of_gt (hpos ⟨k, hk⟩), ne_of_gt (hpos ⟨k - 1, by omega⟩)]
  rw [hclip]
  unfold compoundCoordinateProduct
  rw [← Finset.mul_prod_erase Finset.univ
    (fun j => lam (compoundIndexEmbedding s j)) (Finset.mem_univ z)]
  apply mul_le_mul
  · apply hmono
    have hfirst := compoundIndex_first_lt_of_ne_tail hk s hs
    change (compoundIndexEmbedding s z).val ≤ k - 1
    change (compoundIndexEmbedding s z).val < k at hfirst
    omega
  · apply Finset.prod_le_prod (fun _ _ => (hpos _).le)
    intro j _
    apply hmono
    have hu := orderEmbedding_fin_upper (Nat.sub_le d k) (compoundIndexEmbedding s) j
    change (compoundIndexEmbedding s j).val ≤ k + j.val
    omega
  · exact Finset.prod_nonneg (fun _ _ => (hpos _).le)
  · exact (hpos _).le

/-- Clipping the unique large coordinate removes exactly the adjacent-minimum gap. -/
def compoundCoordinateProduct_clipped_prod {d k : ℕ}
    (lam : Fin d → ℝ) (hkpos : 1 ≤ k) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam) :
    (∏ s : CompoundIndex d (d - k), min (compoundCoordinateProduct lam s)
      (compoundClipLevel lam hk)) =
        (∏ i, lam i) ^ ((d - 1).choose (d - k - 1)) / compoundGapRatio lam hk := by
  classical
  let s₀ := compoundTailIndex d k
  have hrest : (∏ s ∈ Finset.univ.erase s₀,
      min (compoundCoordinateProduct lam s) (compoundClipLevel lam hk)) =
        ∏ s ∈ Finset.univ.erase s₀, compoundCoordinateProduct lam s := by
    apply Finset.prod_congr rfl
    intro s hs
    exact min_eq_left (compoundCoordinateProduct_le_clip_of_ne_tail lam hkpos hk hpos hmono s
      (Finset.mem_erase.mp hs).1)
  calc
    _ = compoundClipLevel lam hk *
        ∏ s ∈ Finset.univ.erase s₀, compoundCoordinateProduct lam s := by
      rw [← Finset.mul_prod_erase Finset.univ
        (fun s => min (compoundCoordinateProduct lam s) (compoundClipLevel lam hk))
        (Finset.mem_univ s₀), hrest,
        min_eq_right (compoundClipLevel_le_tail lam hk hpos hmono)]
    _ = (∏ s : CompoundIndex d (d - k), compoundCoordinateProduct lam s) /
        compoundGapRatio lam hk := by
      rw [← Finset.mul_prod_erase Finset.univ (compoundCoordinateProduct lam)
        (Finset.mem_univ s₀)]
      unfold compoundClipLevel
      ring
    _ = _ := by rw [compoundCoordinateProduct_prod (by omega)]

def compoundCoordinateProduct_clipped_prod_permute {d k : ℕ}
    (p : Equiv.Perm (Fin d)) (lam : Fin d → ℝ) (hkpos : 1 ≤ k) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam) :
    (∏ s : CompoundIndex d (d - k), min (compoundCoordinateProduct (lam ∘ p.symm) s)
      (compoundClipLevel lam hk)) =
        (∏ i, lam i) ^ ((d - 1).choose (d - k - 1)) / compoundGapRatio lam hk := by
  rw [compoundCoordinateProduct_prod_permute p.symm lam
    (fun a => min a (compoundClipLevel lam hk))]
  exact compoundCoordinateProduct_clipped_prod lam hkpos hk hpos hmono


end
end Bounty

end SubmissionComponent_CompoundIndexProducts

/- Component CompoundProfileBounds; SHA256 7f16e28bac4cac780d37a448ff5fe3efd79c023447ae3d2b82696172b06f2f26 -/
section SubmissionComponent_CompoundProfileBounds
/- Uniform bounds for actual clipped compound logarithmic profiles. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def abs_log_le_of_exp_bounds {x M q : ℝ}
    (hlo : Real.exp (-M * q) ≤ x) (hhi : x ≤ Real.exp (M * q)) :
    |Real.log x| ≤ M * q := by
  have hx := (Real.exp_pos _).trans_le hlo
  exact abs_le.mpr ⟨(Real.le_log_iff_exp_le hx).mpr (by simpa only [neg_mul] using hlo),
    (Real.log_le_iff_le_exp hx).mpr hhi⟩

def abs_sub_le_abs_add_abs_local (a b : ℝ) : |a - b| ≤ |a| + |b| := by
  simpa only [sub_zero, zero_sub, abs_neg] using abs_sub_le a 0 b

def compoundCoordinateProduct_log_bound {d ell : ℕ} (b : Fin d → ℝ)
    (hpos : ∀ i, 0 < b i) {C : ℝ} (hb : ∀ i, |Real.log (b i)| ≤ C)
    (s : CompoundIndex d ell) : |Real.log (compoundCoordinateProduct b s)| ≤ ell * C := by
  rw [compoundCoordinateProduct, Real.log_prod (fun i _ => (hpos _).ne')]
  calc
    _ ≤ ∑ i : Fin ell, |Real.log (b (compoundIndexEmbedding s i))| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : Fin ell, C := Finset.sum_le_sum (fun i _ => hb _)
    _ = _ := by simp

def compoundClipLevel_log_bound {d k : ℕ} (lam : Fin d → ℝ) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) {L q : ℝ} (hlam : ∀ i, |Real.log (lam i)| ≤ L * q) :
    |Real.log (compoundClipLevel lam hk)| ≤ ((d - k : ℕ) + 2 : ℝ) * L * q := by
  rw [compoundClipLevel, Real.log_div (compoundCoordinateProduct_pos lam hpos _).ne'
    (compoundGapRatio_pos lam hk hpos).ne', compoundGapRatio,
    Real.log_div (hpos _).ne' (hpos _).ne']
  calc
    _ ≤ |Real.log (compoundCoordinateProduct lam (compoundTailIndex d k))| +
      |Real.log (lam ⟨k, hk⟩) - Real.log (lam ⟨k - 1, by omega⟩)| := abs_sub_le_abs_add_abs_local _ _
    _ ≤ |Real.log (compoundCoordinateProduct lam (compoundTailIndex d k))| +
      (|Real.log (lam ⟨k, hk⟩)| + |Real.log (lam ⟨k - 1, by omega⟩)|) :=
        add_le_add le_rfl (abs_sub_le_abs_add_abs_local _ _)
    _ ≤ ((d - k : ℕ) : ℝ) * (L * q) + (L * q + L * q) :=
      add_le_add (compoundCoordinateProduct_log_bound lam hpos hlam _)
        (add_le_add (hlam _) (hlam _))
    _ = _ := by ring

def compoundLogProfile_clip_abs_bound {d k : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (hk : k < d) {B L q : ℝ}
    (hK : 0 < K) (hbpos : ∀ v i, 0 < b v i) (hlpos : ∀ i, 0 < lam i)
    (_hB : 0 ≤ B) (hL : 0 ≤ L) (hq : 1 ≤ q)
    (hb : ∀ v i, |Real.log (b v i)| ≤ B * q)
    (hl : ∀ i, |Real.log (lam i)| ≤ L * q)
    (v : Fin 3) (s : CompoundIndex d (d - k)) :
    |compoundLogProfile K b lam p (compoundClipLevel lam hk) q v s| ≤
      |Real.log (((d - k).factorial : ℝ) * K ^ (d - k))| +
        (d - k : ℕ) * B + ((d - k : ℕ) + 2 : ℝ) * L := by
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq
  have hqp : 0 < q := lt_of_lt_of_le (by norm_num) hq
  let C : ℝ := (d - k).factorial * K ^ (d - k)
  have hC : 0 < C := mul_pos (by exact_mod_cast Nat.factorial_pos (d - k)) (pow_pos hK _)
  have hLc : |Real.log C| ≤ |Real.log C| * q := le_mul_of_one_le_right (abs_nonneg _) hq
  have hLq : 0 ≤ L * q := mul_nonneg hL hq0
  have hm : |Real.log (min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundClipLevel lam hk))| ≤
      ((d - k : ℕ) + 2 : ℝ) * L * q := by
    by_cases h : compoundCoordinateProduct (lam ∘ p.symm) s ≤ compoundClipLevel lam hk
    · rw [min_eq_left h]
      apply (compoundCoordinateProduct_log_bound (lam ∘ p.symm) (fun i => hlpos _) (fun i => hl _) s).trans
      nlinarith
    · rw [min_eq_right (le_of_not_ge h)]
      exact compoundClipLevel_log_bound lam hk hlpos hl
  unfold compoundLogProfile
  rw [abs_div, abs_of_pos hqp]
  apply (div_le_iff₀ hqp).mpr
  fin_cases v
  · change |Real.log (C * compoundCoordinateProduct (b 0) s *
        min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundClipLevel lam hk))| ≤ _
    have hminpos : 0 < min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundClipLevel lam hk) :=
      lt_min (compoundCoordinateProduct_pos (lam ∘ p.symm) (fun i => hlpos (p.symm i)) s)
        (compoundClipLevel_pos lam hk hlpos)
    rw [Real.log_mul (mul_pos hC (compoundCoordinateProduct_pos _ (hbpos 0) s)).ne' hminpos.ne',
      Real.log_mul hC.ne' (compoundCoordinateProduct_pos _ (hbpos 0) s).ne']
    have hb0 := compoundCoordinateProduct_log_bound (b 0) (hbpos 0) (hb 0) s
    have ht := (abs_add_le (Real.log C + Real.log (compoundCoordinateProduct (b 0) s))
      (Real.log (min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundClipLevel lam hk)))).trans
      (add_le_add (abs_add_le (Real.log C) (Real.log (compoundCoordinateProduct (b 0) s))) le_rfl)
    change _ ≤ (|Real.log C| + _ + _) * q
    nlinarith
  · change |Real.log (compoundCoordinateProduct (b 1) s)| ≤ _
    have hh := compoundCoordinateProduct_log_bound (b 1) (hbpos 1) (hb 1) s
    have hc0 : 0 ≤ |Real.log C| * q := mul_nonneg (abs_nonneg _) hq0
    have hl0 : 0 ≤ ((d - k : ℕ) + 2 : ℝ) * (L * q) := mul_nonneg (by positivity) hLq
    change _ ≤ (|Real.log C| + _ + _) * q
    nlinarith
  · change |Real.log (compoundCoordinateProduct (b 2) s)| ≤ _
    have hh := compoundCoordinateProduct_log_bound (b 2) (hbpos 2) (hb 2) s
    have hc0 : 0 ≤ |Real.log C| * q := mul_nonneg (abs_nonneg _) hq0
    have hl0 : 0 ≤ ((d - k : ℕ) + 2 : ℝ) * (L * q) := mul_nonneg (by positivity) hLq
    change _ ≤ (|Real.log C| + _ + _) * q
    nlinarith

def exists_threePlace_compoundLogProfile_bound {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0) (M : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (c : Fin 3 → Fin d → ℝ) (q : ℝ), 1 ≤ q →
      (∀ v i, |c v i| ≤ M) → ∀ (k : ℕ) (hk : k < d) (p : Equiv.Perm (Fin d))
      (v : Fin 3) (s : CompoundIndex d (d - k)),
      |compoundLogProfile ((2 : ℝ) ^ d) (threePlaceExactWidths c q)
        (threePlaceMinimumValue A c q hA) p
        (compoundClipLevel (threePlaceMinimumValue A c q hA) hk) q v s| ≤ C := by
  classical
  obtain ⟨L, hL, hmins⟩ := exists_threePlaceMinimumValue_uniform_exp_bounds A hA M
  let B := max M 0 + Real.log 3
  have hB : 0 ≤ B := add_nonneg (le_max_right _ _) (Real.log_nonneg (by norm_num))
  let D := ∑ ell : Fin (d + 1), |Real.log ((ell.val.factorial : ℝ) * ((2 : ℝ) ^ d) ^ ell.val)|
  have hD : 0 ≤ D := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  let C := D + d * B + ((d : ℝ) + 2) * L
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro c q hq hc k hk p v s
  have hb : ∀ v i, |Real.log (threePlaceExactWidths c q v i)| ≤ B * q := by
    intro v i
    have hh := threePlaceExactWidths_exp_bounds c (le_max_right M 0) hq
      (fun v i => (hc v i).trans (le_max_left M 0)) v i
    exact abs_log_le_of_exp_bounds hh.1 hh.2
  have hl : ∀ i, |Real.log (threePlaceMinimumValue A c q hA i)| ≤ L * q := by
    intro i
    exact abs_log_le_of_exp_bounds (hmins c q hq hc i).1 (hmins c q hq hc i).2
  have hh := compoundLogProfile_clip_abs_bound ((2 : ℝ) ^ d) (threePlaceExactWidths c q)
    (threePlaceMinimumValue A c q hA) p hk (by positivity) (threePlaceExactWidths_pos c q)
    (fun i => rationalBoxMinimumValue_pos A _ _ hA _ _ i) hB hL hq hb hl v s
  have hconst : |Real.log (((d - k).factorial : ℝ) * ((2 : ℝ) ^ d) ^ (d - k))| ≤ D := by
    exact Finset.single_le_sum
      (f := fun ell : Fin (d + 1) => |Real.log ((ell.val.factorial : ℝ) * ((2 : ℝ) ^ d) ^ ell.val)|)
      (fun ell _ => abs_nonneg _) (Finset.mem_univ (⟨d - k, by omega⟩ : Fin (d + 1)))
  apply hh.trans
  have hkd : ((d - k : ℕ) : ℝ) ≤ d := by exact_mod_cast Nat.sub_le d k
  have hbmul := mul_le_mul_of_nonneg_right hkd hB
  have hlmul := mul_le_mul_of_nonneg_right (add_le_add_right hkd 2) hL
  dsimp [C]
  linarith


end
end Bounty

end SubmissionComponent_CompoundProfileBounds

/- Component CompoundWidthProduct; SHA256 a434f222dc9fa11621c6d40a1cc3ecafd3da9b5ac41115b172de2dda3a086fad -/
section SubmissionComponent_CompoundWidthProduct
/- The minimum gap supplies the exact compound volume loss and a negative profile sum. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def compoundLocalWidths_product {d k : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (hkpos : 1 ≤ k) (hk : k < d)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam) :
    (∏ v, ∏ s : CompoundIndex d (d - k),
      compoundLocalWidths K b lam p (compoundClipLevel lam hk) v s) =
        ((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
          ((∏ v, ∏ i, b v i) * (∏ i, lam i)) ^ ((d - 1).choose (d - k - 1)) /
          compoundGapRatio lam hk := by
  have hell : 1 ≤ d - k := by omega
  have harch : (∏ s : CompoundIndex d (d - k),
      compoundLocalWidths K b lam p (compoundClipLevel lam hk) 0 s) =
        ((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
          (∏ i, b 0 i) ^ ((d - 1).choose (d - k - 1)) *
          ((∏ i, lam i) ^ ((d - 1).choose (d - k - 1)) / compoundGapRatio lam hk) := by
    change (∏ s : CompoundIndex d (d - k),
      ((d - k).factorial * K ^ (d - k)) * compoundCoordinateProduct (b 0) s *
        min (compoundCoordinateProduct (lam ∘ p.symm) s) (compoundClipLevel lam hk)) = _
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const,
      Finset.card_univ, compoundIndex_card, compoundCoordinateProduct_prod hell,
      compoundCoordinateProduct_clipped_prod_permute p lam hkpos hk hpos hmono]
  have hfinite (v : Fin 3) (hv : v ≠ 0) :
      (∏ s : CompoundIndex d (d - k),
        compoundLocalWidths K b lam p (compoundClipLevel lam hk) v s) =
          (∏ i, b v i) ^ ((d - 1).choose (d - k - 1)) := by
    fin_cases v
    · exact False.elim (hv rfl)
    · exact compoundCoordinateProduct_prod hell (b 1)
    · exact compoundCoordinateProduct_prod hell (b 2)
  rw [Fin.prod_univ_three, harch, hfinite 1 (by decide), hfinite 2 (by decide),
    Fin.prod_univ_three]
  simp only [mul_pow]
  ring

def compoundLocalWidths_product_le {d k : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (hkpos : 1 ≤ k) (hk : k < d)
    (hK : 0 ≤ K) (hb : ∀ v i, 0 ≤ b v i)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam)
    (L : ℝ) (hL : ((∏ v, ∏ i, b v i) * (∏ i, lam i)) ≤ L) :
    (∏ v, ∏ s : CompoundIndex d (d - k),
      compoundLocalWidths K b lam p (compoundClipLevel lam hk) v s) ≤
        ((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
          L ^ ((d - 1).choose (d - k - 1)) / compoundGapRatio lam hk := by
  rw [compoundLocalWidths_product K b lam p hkpos hk hpos hmono]
  apply div_le_div_of_nonneg_right _ (compoundGapRatio_pos lam hk hpos).le
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply pow_le_pow_left₀ _ hL
  exact mul_nonneg (Finset.prod_nonneg (fun v _ => Finset.prod_nonneg (fun i _ => hb v i)))
    (Finset.prod_nonneg (fun i _ => (hpos i).le))

def compoundLogProfile_sum_le_of_growth {d k : ℕ}
    (K : ℝ) (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ)
    (p : Equiv.Perm (Fin d)) (hkpos : 1 ≤ k) (hk : k < d)
    (hK : 0 < K) (hb : ∀ v i, 0 < b v i)
    (hpos : ∀ i, 0 < lam i) (hmono : Monotone lam)
    (L q ρ : ℝ) (hLpos : 0 < L) (hq : 0 < q)
    (hL : ((∏ v, ∏ i, b v i) * (∏ i, lam i)) ≤ L)
    (hconst : Real.log (((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
      L ^ ((d - 1).choose (d - k - 1))) ≤ ρ * q)
    (hgap : Real.exp (2 * ρ * q) ≤ compoundGapRatio lam hk) :
    (∑ v, ∑ s : CompoundIndex d (d - k),
      compoundLogProfile K b lam p (compoundClipLevel lam hk) q v s) ≤ -ρ := by
  have hBpos : 0 < ((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
      L ^ ((d - 1).choose (d - k - 1)) := by positivity
  have hB := (Real.log_le_iff_le_exp hBpos).mp hconst
  have hquot :
      ((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
        L ^ ((d - 1).choose (d - k - 1)) / compoundGapRatio lam hk ≤ Real.exp (-ρ * q) := by
    apply (div_le_iff₀ (compoundGapRatio_pos lam hk hpos)).mpr
    apply hB.trans
    calc
      Real.exp (ρ * q) = Real.exp (2 * ρ * q) * Real.exp (-ρ * q) := by
        rw [← Real.exp_add]
        congr 1
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hgap (Real.exp_nonneg _)
      _ = _ := by ring
  have hprod := (compoundLocalWidths_product_le K b lam p hkpos hk hK.le
    (fun v i => (hb v i).le) hpos hmono L hL).trans hquot
  rw [compoundLogProfile_sum K b lam p (compoundClipLevel lam hk) q hK hb hpos
    (compoundClipLevel_pos lam hk hpos)]
  apply (div_le_iff₀ hq).mpr
  apply (Real.log_le_iff_le_exp (Finset.prod_pos (fun v _ => Finset.prod_pos (fun s _ =>
    compoundLocalWidths_pos K b lam p (compoundClipLevel lam hk) hK hb hpos
      (compoundClipLevel_pos lam hk hpos) v s)))).mpr
  exact hprod

end
end Bounty

end SubmissionComponent_CompoundWidthProduct

/- Component CompoundUniformDeficit; SHA256 266ce16bcdec52c68f8d611063d94c865dcc77ab5a701bf64b17b38097aab8d3 -/
section SubmissionComponent_CompoundUniformDeficit
/- A single scale threshold works for every proper minimum-prefix dimension. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def compoundCoefficientBudget (d k : ℕ) (K L : ℝ) : ℝ :=
  Real.log (((d - k).factorial * K ^ (d - k)) ^ (d.choose (d - k)) *
    L ^ ((d - 1).choose (d - k - 1)))

def exists_uniform_compound_deficit_threshold (d : ℕ) (K L γ : ℝ)
    (hγ : 0 < γ) :
    ∃ T : ℝ, 1 ≤ T ∧ ∀ q : ℝ, T ≤ q → ∀ k : ℕ, k < d →
      compoundCoefficientBudget d k K L ≤ (γ / 2) * q := by
  let B : ℝ := ∑ j : Fin d, |compoundCoefficientBudget d j.val K L|
  have hB : 0 ≤ B := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  have hT : 1 ≤ 1 + 2 * B / γ := by
    have hnonneg : 0 ≤ 2 * B / γ := by positivity
    linarith
  refine ⟨1 + 2 * B / γ, hT, ?_⟩
  intro q hq k hk
  have hle : compoundCoefficientBudget d k K L ≤ B := by
    apply (le_abs_self _).trans
    exact Finset.single_le_sum (fun j _ => abs_nonneg (compoundCoefficientBudget d j.val K L))
      (Finset.mem_univ (⟨k, hk⟩ : Fin d))
  have hmul := (div_le_iff₀ hγ).mp (show 2 * B / γ ≤ q by linarith)
  linarith

def exists_uniform_compound_negative_profiles (d : ℕ) (K L γ : ℝ)
    (hK : 0 < K) (hL : 0 < L) (hγ : 0 < γ) :
    ∃ T : ℝ, 1 ≤ T ∧ ∀ (q : ℝ), T ≤ q →
      ∀ (k : ℕ) (_hkpos : 1 ≤ k) (hk : k < d)
        (b : Fin 3 → Fin d → ℝ) (lam : Fin d → ℝ) (p : Equiv.Perm (Fin d)),
      (∀ v i, 0 < b v i) → (∀ i, 0 < lam i) → Monotone lam →
      ((∏ v, ∏ i, b v i) * (∏ i, lam i)) ≤ L →
      Real.exp (γ * q) ≤ compoundGapRatio lam hk →
      (∑ v, ∑ s : CompoundIndex d (d - k),
        compoundLogProfile K b lam p (compoundClipLevel lam hk) q v s) ≤ -(γ / 2) := by
  obtain ⟨T, hT, hbound⟩ := exists_uniform_compound_deficit_threshold d K L γ hγ
  refine ⟨T, hT, ?_⟩
  intro q hq k hkpos hk b lam p hb hlam hmono hprod hgap
  apply compoundLogProfile_sum_le_of_growth K b lam p hkpos hk hK hb hlam hmono
    L q (γ / 2) hL (by linarith) hprod (hbound q hq k hk)
  convert hgap using 1
  congr 2
  ring

end
end Bounty

end SubmissionComponent_CompoundUniformDeficit

/- Component LatticeProfileMass; SHA256 6f153cfbb040c1b3442ff5ccecf8bc4f913243112d2c3ef3d8d339c87720529c -/
section SubmissionComponent_LatticeProfileMass
/- Exact finite-place widths cancel the diagonal lattice determinant in the product bound. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def latticeProfileMassConstant {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) : ℝ :=
  (2 / Real.sqrt 3) ^ (d * (d - 1) / 2) * |(A.det : ℝ)|

def latticeProfileMassConstant_pos {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0) :
    0 < latticeProfileMassConstant A := by
  apply mul_pos
  · apply pow_pos
    exact div_pos (by norm_num) (Real.sqrt_pos.mpr (by norm_num))
  · exact abs_pos.mpr (by exact_mod_cast hA)

def rationalBoxMinimum_threePlace_mass_bound {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (b : Fin 3 → Fin d → ℝ) (N : Fin d → ℕ)
    (hA : A.det ≠ 0) (hb : ∀ i, 0 < b 0 i) (hN : ∀ i, 0 < N i)
    (hfinite : ∀ i, b 1 i * b 2 i = (N i : ℝ)⁻¹) :
    ((∏ v, ∏ i, b v i) * ∏ i, rationalBoxMinimumValue A (b 0) N hA hb hN i) ≤
      latticeProfileMassConstant A := by
  have hB : (0 : ℝ) < ∏ i, b 0 i := Finset.prod_pos (fun i _ => hb i)
  have hNprod : (0 : ℝ) < ∏ i, (N i : ℝ) :=
    Finset.prod_pos (fun i _ => by exact_mod_cast hN i)
  have hfiniteprod : (∏ i, b 1 i) * (∏ i, b 2 i) = (∏ i, (N i : ℝ))⁻¹ := by
    rw [← Finset.prod_mul_distrib]
    simp_rw [hfinite]
    rw [Finset.prod_inv_distrib]
  have hscale : (∏ v, ∏ i, b v i) = (∏ i, b 0 i) / ∏ i, (N i : ℝ) := by
    rw [Fin.prod_univ_three, mul_assoc, hfiniteprod, div_eq_mul_inv]
  rw [hscale]
  have hmin := (rationalBoxMinimumValue_product_bounds A (b 0) N hA hb hN).2
  calc
    _ ≤ ((∏ i, b 0 i) / ∏ i, (N i : ℝ)) *
        ((2 / Real.sqrt 3) ^ (d * (d - 1) / 2) *
          (|(A.det : ℝ)| * (∏ i, (N i : ℝ)) / ∏ i, b 0 i)) :=
      mul_le_mul_of_nonneg_left hmin (div_nonneg hB.le hNprod.le)
    _ = latticeProfileMassConstant A := by
      unfold latticeProfileMassConstant
      field_simp
      <;> ring

end
end Bounty

end SubmissionComponent_LatticeProfileMass

/- Component ThreePlaceGapRate; SHA256 a31630e5c4986bda309882a0983b775fca014d2139cd7adbb9e79fbb544077ab -/
section SubmissionComponent_ThreePlaceGapRate
/- A fixed positive exponential gap rate and a threshold absorbing the
actual determinant and Euclidean dimension constants. -/

namespace Bounty
noncomputable section

def threePlaceGapRate (d : ℕ) (ρ : ℝ) : ℝ := ρ / (2 * (d * (d - 1) : ℕ))

def threePlaceGapRate_pos {d : ℕ} (hd : 2 ≤ d) {ρ : ℝ} (hρ : 0 < ρ) :
    0 < threePlaceGapRate d ρ := by
  have hn : 0 < d * (d - 1) := Nat.mul_pos (by omega) (by omega)
  exact div_pos hρ (mul_pos (by norm_num) (by exact_mod_cast hn))

def exists_threePlace_gap_threshold {d : ℕ} (hd : 2 ≤ d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0) {ρ : ℝ} (hρ : 0 < ρ) :
    ∃ q₀ : ℝ, 1 ≤ q₀ ∧ ∀ q : ℝ, q₀ ≤ q →
      1 ≤ Real.exp (threePlaceGapRate d ρ * q) ∧
      (d.factorial : ℝ) * (Real.sqrt d) ^ d *
          (Real.exp (threePlaceGapRate d ρ * q)) ^ (d * (d - 1)) <
        |(A.det : ℝ)| * Real.exp (ρ * q) := by
  let C : ℝ := d.factorial * (Real.sqrt d) ^ d
  let a : ℝ := |(A.det : ℝ)|
  have ha : 0 < a := abs_pos.mpr (by exact_mod_cast hA)
  have hC : 0 < C := mul_pos (by exact_mod_cast Nat.factorial_pos d)
    (pow_pos (Real.sqrt_pos.mpr (by exact_mod_cast (by omega : 0 < d))) d)
  let S := |Real.log C| + |Real.log a|
  have hS : 0 ≤ S := add_nonneg (abs_nonneg _) (abs_nonneg _)
  let q₀ := 1 + 2 * S / ρ
  have hq₀ : 1 ≤ q₀ := le_add_of_nonneg_right (div_nonneg (mul_nonneg (by norm_num) hS) hρ.le)
  refine ⟨q₀, hq₀, ?_⟩
  intro q hq
  have hq1 : 1 ≤ q := hq₀.trans hq
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq1
  refine ⟨Real.one_le_exp_iff.mpr (mul_nonneg (threePlaceGapRate_pos hd hρ).le hq0), ?_⟩
  have hlarge : S < ρ * q / 2 := by
    have hh := mul_le_mul_of_nonneg_right hq hρ.le
    dsimp [q₀] at hh
    rw [add_mul, div_mul_cancel₀ _ hρ.ne', one_mul] at hh
    nlinarith
  have hn : (d * (d - 1) : ℕ) ≠ 0 := ne_of_gt (Nat.mul_pos (by omega) (by omega))
  have hnr : ((d * (d - 1) : ℕ) : ℝ) ≠ 0 := by exact_mod_cast hn
  have hexp : (Real.exp (threePlaceGapRate d ρ * q)) ^ (d * (d - 1)) = Real.exp (ρ * q / 2) := by
    rw [← Real.exp_nat_mul]
    congr 1
    unfold threePlaceGapRate
    field_simp [hnr]
  rw [hexp]
  change C * Real.exp (ρ * q / 2) < a * Real.exp (ρ * q)
  calc
    _ = Real.exp (Real.log C + ρ * q / 2) := by rw [Real.exp_add, Real.exp_log hC]
    _ < Real.exp (Real.log a + ρ * q) := by
      apply Real.exp_lt_exp.mpr
      dsimp [S] at hlarge
      nlinarith [le_abs_self (Real.log C), neg_abs_le (Real.log a)]
    _ = _ := by rw [Real.exp_add, Real.exp_log ha]


end
end Bounty

end SubmissionComponent_ThreePlaceGapRate

/- Component RationalSpanDescent; SHA256 f2c1eb58e67308300db324d5c30694789c06981ed85e74e9a4d929f9e44a05eb -/
section SubmissionComponent_RationalSpanDescent
/- Rational points in a real span of rational vectors already belong to the rational span. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rationalDualRealExtension {I : Type*} [Fintype I] [DecidableEq I]
    (f : (I → ℚ) →ₗ[ℚ] ℚ) : (I → ℝ) →ₗ[ℝ] ℝ :=
  ∑ i, (f (Pi.single i 1) : ℝ) • (LinearMap.proj i : (I → ℝ) →ₗ[ℝ] ℝ)

def rationalDualRealExtension_cast {I : Type*} [Fintype I] [DecidableEq I]
    (f : (I → ℚ) →ₗ[ℚ] ℚ) (x : I → ℚ) :
    rationalDualRealExtension f (fun i => (x i : ℝ)) = (f x : ℝ) := by
  have hexp : f x = ∑ i, x i * f (Pi.single i 1) := by
    conv_lhs => rw [← (Pi.basisFun ℚ I).sum_repr x]
    simp only [map_sum, map_smul, Pi.basisFun_repr, Pi.basisFun_apply, smul_eq_mul]
  rw [hexp]
  simp only [rationalDualRealExtension, LinearMap.sum_apply, LinearMap.smul_apply,
    LinearMap.proj_apply, smul_eq_mul, Rat.cast_sum, Rat.cast_mul]
  apply Finset.sum_congr rfl
  intro i _
  ring

def rational_mem_span_of_real_mem_span {I : Type*} [Fintype I] [DecidableEq I]
    (s : Set (I → ℚ)) (x : I → ℚ)
    (hx : (fun i => (x i : ℝ)) ∈
      Submodule.span ℝ ((fun z : I → ℚ => fun i => (z i : ℝ)) '' s)) :
    x ∈ Submodule.span ℚ s := by
  by_contra hn
  obtain ⟨f, hfx, hf⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hn inferInstance
  have hker : Submodule.span ℝ ((fun z : I → ℚ => fun i => (z i : ℝ)) '' s) ≤
      LinearMap.ker (rationalDualRealExtension f) := by
    apply Submodule.span_le.mpr
    rintro y ⟨z, hz, rfl⟩
    change rationalDualRealExtension f (fun i => (z i : ℝ)) = 0
    rw [rationalDualRealExtension_cast]
    have hzmem : f z ∈ (Submodule.span ℚ s).map f :=
      Submodule.mem_map_of_mem (Submodule.subset_span hz)
    rw [hf] at hzmem
    have hz0 : f z = 0 := hzmem
    rw [hz0, Rat.cast_zero]
  have hxzero := hker hx
  rw [LinearMap.mem_ker, rationalDualRealExtension_cast] at hxzero
  exact hfx (by exact_mod_cast hxzero)

def rational_mem_span_of_euclidean_mem_span {d : ℕ}
    (s : Set (Fin d → ℚ)) (x : Fin d → ℚ)
    (hx : (WithLp.toLp 2 (fun i => (x i : ℝ)) : BoxEuclidean d) ∈
      Submodule.span ℝ ((fun z : Fin d → ℚ => WithLp.toLp 2 (fun i => (z i : ℝ))) '' s)) :
    x ∈ Submodule.span ℚ s := by
  apply rational_mem_span_of_real_mem_span s x
  have hm := Submodule.mem_map_of_mem
    (f := (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).toLinearMap) hx
  rw [Submodule.map_span, Set.image_image] at hm
  exact hm

def integer_mem_rational_prefix_of_real_prefix {d : ℕ}
    (H : Fin d → Fin d → ℤ) (x : Fin d → ℤ) (k : ℕ)
    (hx : integerEuclideanPoint x ∈ latticePrefixSpan (fun j => integerEuclideanPoint (H j)) k) :
    (fun i => (x i : ℚ)) ∈ Submodule.span ℚ
      ((fun j i => (H j i : ℚ)) '' {j : Fin d | j.val < k}) := by
  apply rational_mem_span_of_euclidean_mem_span
    ((fun j i => (H j i : ℚ)) '' {j : Fin d | j.val < k}) (fun i => (x i : ℚ))
  rw [Set.image_image]
  simpa only [latticePrefixSpan, integerEuclideanPoint, Function.comp_def, Rat.cast_intCast] using hx

def integer_matrix_det_ne_zero_of_euclidean_independent {d : ℕ}
    (X : Matrix (Fin d) (Fin d) ℤ)
    (hX : LinearIndependent ℝ (fun j => integerEuclideanPoint (X.col j))) :
    (X.map (Int.castRingHom ℚ)).det ≠ 0 := by
  have hreal := hX.map' (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).toLinearMap
    (LinearMap.ker_eq_bot.mpr (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).injective)
  change LinearIndependent ℝ (X.map (Int.castRingHom ℝ)).col at hreal
  have hdet : (X.map (Int.castRingHom ℝ)).det ≠ 0 :=
    Matrix.nonsingular_iff_det_ne_zero.mp (Matrix.Nonsingular.of_linearIndependent_col hreal)
  intro hz
  have hmap : (X.map (Int.castRingHom ℚ)).det = (X.det : ℚ) :=
    ((Int.castRingHom ℚ).map_det X).symm
  rw [hmap] at hz
  have hzZ : X.det = 0 := by exact_mod_cast hz
  apply hdet
  calc
    _ = (X.det : ℝ) := ((Int.castRingHom ℝ).map_det X).symm
    _ = 0 := by rw [hzZ, Int.cast_zero]

end
end Bounty

end SubmissionComponent_RationalSpanDescent

/- Component ThreePlaceCompoundWitness; SHA256 2111c1a0da3abbd52f08a697fb15c45006ed24ca9cabeb849aec8c4a3a71d0af -/
section SubmissionComponent_ThreePlaceCompoundWitness
/- Actual compound witnesses for every sufficiently large three-place domain. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def threePlaceCompoundProfile {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0)
    (p : Equiv.Perm (Fin d)) (k : Fin d) : Fin 3 → CompoundIndex d (d - k.val) → ℝ :=
  compoundLogProfile ((2 : ℝ) ^ d) (threePlaceExactWidths c q)
    (threePlaceMinimumValue A c q hA) p
    (compoundClipLevel (threePlaceMinimumValue A c q hA) k.isLt) q

def ThreePlaceCompoundWitnessData {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ)
    (c : Fin 3 → Fin d → ℝ) (q : ℝ) (hA : A.det ≠ 0) (C ρ : ℝ)
    (k : Fin d) (p : Equiv.Perm (Fin d)) (H : Matrix (Fin d) (Fin d) ℤ) : Prop :=
        1 ≤ k.val ∧ (H.map (Int.castRingHom ℚ)).det ≠ 0 ∧
        (∀ v s, |threePlaceCompoundProfile A c q hA p k v s| ≤ C) ∧
        (∑ v, ∑ s, threePlaceCompoundProfile A c q hA p k v s) ≤ -(threePlaceGapRate d ρ / 2) ∧
        (∀ (t : CompoundIndex d (d - k.val)), t ≠ compoundTailIndex d k.val →
          (∀ s, ‖(compoundMatrix (d - k.val) A *
            (compoundMatrix (d - k.val) H).map (Int.castRingHom ℚ)) s t‖ ≤
              Real.exp (threePlaceCompoundProfile A c q hA p k 0 s * q)) ∧
          (∀ s, (padicNorm 2 ((compoundMatrix (d - k.val) H s t : ℤ) : ℚ) : ℝ) ≤
              Real.exp (threePlaceCompoundProfile A c q hA p k 1 s * q)) ∧
          (∀ s, (padicNorm 3 ((compoundMatrix (d - k.val) H s t : ℤ) : ℚ) : ℝ) ≤
              Real.exp (threePlaceCompoundProfile A c q hA p k 2 s * q))) ∧
        (∀ x ∈ rationalThreePlaceDomain A c q,
          (fun i => (x i : ℚ)) ∈ Submodule.span ℚ
            (((H.map (Int.castRingHom ℚ)).col) '' {j : Fin d | j.val < k.val}))

def exists_threePlace_compound_witnesses {d : ℕ} (hd : 2 ≤ d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0) (M ρ : ℝ) (hρ : 0 < ρ) :
    ∃ C T : ℝ, 0 ≤ C ∧ 1 ≤ T ∧ ∀ (c : Fin 3 → Fin d → ℝ) (q : ℝ),
      (∀ v i, |c v i| ≤ M) → (∀ i, c 1 i ≤ 0) → (∀ i, c 2 i ≤ 0) →
      (∑ v, ∑ i, c v i) ≤ -ρ → T ≤ q →
      (∃ x ∈ rationalThreePlaceDomain A c q, x ≠ 0) →
      ∃ (k : Fin d) (p : Equiv.Perm (Fin d)) (H : Matrix (Fin d) (Fin d) ℤ),
        ThreePlaceCompoundWitnessData A c q hA C ρ k p H := by
  obtain ⟨C, hC, hbound⟩ := exists_threePlace_compoundLogProfile_bound A hA M
  have hγ := threePlaceGapRate_pos hd hρ
  obtain ⟨T₁, hT₁, hgaprate⟩ := exists_threePlace_gap_threshold hd A hA hρ
  obtain ⟨T₂, hT₂, hdeficit⟩ := exists_uniform_compound_negative_profiles d ((2 : ℝ) ^ d)
    (latticeProfileMassConstant A) (threePlaceGapRate d ρ) (by positivity)
    (latticeProfileMassConstant_pos A hA) hγ
  refine ⟨C, max T₁ T₂, hC, hT₁.trans (le_max_left _ _), ?_⟩
  intro c q hc hc1 hc2 hsum hq hne
  have hq₁ : T₁ ≤ q := (le_max_left _ _).trans hq
  have hq₂ : T₂ ≤ q := (le_max_right _ _).trans hq
  have hq1 : 1 ≤ q := hT₁.trans hq₁
  have hq0 : 0 ≤ q := le_trans (by norm_num) hq1
  have hqp : 0 < q := lt_of_lt_of_le (by norm_num) hq1
  obtain ⟨hG, hgrowth⟩ := hgaprate q hq₁
  obtain ⟨p, W, z, lo, hi, hidx, hdiv, _, hLI, _, harch, _, hgap, hcontain, _, _⟩ :=
    exists_threePlace_davenport_gap (by omega : 0 < d) A c hA hq0 hc1 hc2 hsum hne hG hgrowth
  let H : Matrix (Fin d) (Fin d) ℤ := fun i j => W j i
  let lam := threePlaceMinimumValue A c q hA
  let b := threePlaceExactWidths c q
  have hpos : ∀ i, 0 < lam i := fun i => rationalBoxMinimumValue_pos A _ _ hA _ _ i
  have hmono : Monotone lam := rationalBoxMinimumValue_monotone A _ _ hA _ _
  have hhipos : 1 ≤ hi.val := by omega
  have hdet : (H.map (Int.castRingHom ℚ)).det ≠ 0 :=
    integer_matrix_det_ne_zero_of_euclidean_independent H hLI
  have hratio : compoundGapRatio lam hi.isLt = lam hi / lam lo := by
    have hprev : (⟨hi.val - 1, by omega⟩ : Fin d) = lo := by
      apply Fin.ext
      change hi.val - 1 = lo.val
      omega
    change lam hi / lam ⟨hi.val - 1, _⟩ = lam hi / lam lo
    rw [hprev]
  have hmass : ((∏ v, ∏ i, b v i) * ∏ i, lam i) ≤ latticeProfileMassConstant A :=
    rationalBoxMinimum_threePlace_mass_bound A b (threePlaceDiagonal c q) hA
      (threePlaceWidth_pos c q) (threePlaceDiagonal_pos c q)
      (threePlaceExactWidths_finite_product c q)
  have hlocal : ∀ i j, ‖(A * H.map (Int.castRingHom ℚ)) (p i) j‖ ≤
      (2 : ℝ) ^ d * b 0 (p i) * min (lam i) (lam j) := by
    intro i j
    change ‖(∑ r, A (p i) r * (W j r : ℚ) : ℚ)‖ ≤ _
    rw [← Rat.norm_cast_real, Real.norm_eq_abs]
    simpa [Matrix.mulVec, dotProduct, Matrix.map_apply, Rat.cast_sum, Rat.cast_mul,
      b, threePlaceExactWidths_zero, threePlaceWidth, lam] using harch i j
  refine ⟨hi, p, H, ?_⟩
  unfold ThreePlaceCompoundWitnessData
  refine ⟨hhipos, hdet, ?_, ?_, ?_, ?_⟩
  · exact hbound c q hq1 hc hi.val hi.isLt p
  · apply hdeficit q hq₂ hi.val hhipos hi.isLt b lam p
      (threePlaceExactWidths_pos c q) hpos hmono hmass
    rw [hratio]
    exact hgap.le
  · intro t ht
    have htclip := compoundCoordinateProduct_le_clip_of_ne_tail lam hhipos hi.isLt hpos hmono t ht
    have hloc := compoundMatrix_clipped_local_bounds A H ((2 : ℝ) ^ d) b lam p
      (compoundClipLevel lam hi.isLt) (by positivity)
      (fun v i => (threePlaceExactWidths_pos c q v i).le) (fun i => (hpos i).le) hlocal
      (fun i j => (threePlaceExactWidths_padic_bounds c q i (W j i) (hdiv j i)).1)
      (fun i j => (threePlaceExactWidths_padic_bounds c q i (W j i) (hdiv j i)).2) t htclip
    have he (v : Fin 3) (s : CompoundIndex d (d - hi.val)) :
        Real.exp (threePlaceCompoundProfile A c q hA p hi v s * q) =
          compoundLocalWidths ((2 : ℝ) ^ d) b lam p (compoundClipLevel lam hi.isLt) v s :=
      exp_compoundLogProfile _ b lam p _ q (by positivity) (threePlaceExactWidths_pos c q)
        hpos (compoundClipLevel_pos lam hi.isLt hpos) hqp.ne' v s
    simpa only [he] using hloc
  · intro x hx
    exact integer_mem_rational_prefix_of_real_prefix W x hi.val (hcontain x hx)

end
end Bounty

end SubmissionComponent_ThreePlaceCompoundWitness

/- Component IntegerThreePlaceProduct; SHA256 e8dcdc1fe5df96148d3907fb8e00955aebb91749daeb892517b278b0a5331752 -/
section SubmissionComponent_IntegerThreePlaceProduct
/- The three-place product lower bound for actual nonzero integers, proved
from coprime prime-power divisibility rather than a product-formula premise. -/

namespace Bounty
noncomputable section

def padicNorm_int_inverse_power (p : ℕ) (z : ℤ) (hz : z ≠ 0) :
    padicNorm p (z : ℚ) = ((p : ℚ) ^ padicValNat p z.natAbs)⁻¹ := by
  rw [padicNorm.eq_zpow_of_nonzero (by exact_mod_cast hz), padicValRat.of_int]
  simp only [padicValInt, zpow_neg, zpow_natCast]

def two_prime_valuation_power_dvd (p q n : ℕ)
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    p ^ padicValNat p n * q ^ padicValNat q n ∣ n := by
  have hc : Nat.Coprime p q := (Nat.coprime_primes hp hq).mpr hpq
  exact (hc.pow _ _).mul_dvd_of_dvd_of_dvd pow_padicValNat_dvd pow_padicValNat_dvd

def integer_two_prime_product_lower_rat (p q : ℕ)
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (z : ℤ) (hz : z ≠ 0) :
    (1 : ℚ) ≤ |(z : ℚ)| * padicNorm p (z : ℚ) * padicNorm q (z : ℚ) := by
  have hn : 0 < z.natAbs := Int.natAbs_pos.mpr hz
  have hb := Nat.le_of_dvd hn (two_prime_valuation_power_dvd p q z.natAbs hp hq hpq)
  have hbq : (p : ℚ) ^ padicValNat p z.natAbs *
      (q : ℚ) ^ padicValNat q z.natAbs ≤ (z.natAbs : ℚ) := by exact_mod_cast hb
  have hp0 : (0 : ℚ) < p := by exact_mod_cast hp.pos
  have hq0 : (0 : ℚ) < q := by exact_mod_cast hq.pos
  have habs : |(z : ℚ)| = (z.natAbs : ℚ) := by rw [Nat.cast_natAbs, Int.cast_abs]
  rw [padicNorm_int_inverse_power p z hz, padicNorm_int_inverse_power q z hz,
    habs]
  calc
    _ ≤ (z.natAbs : ℚ) /
        ((p : ℚ) ^ padicValNat p z.natAbs * (q : ℚ) ^ padicValNat q z.natAbs) :=
      (one_le_div₀ (by positivity)).mpr hbq
    _ = _ := by rw [div_eq_mul_inv, mul_inv_rev]; ring

def integer_two_prime_product_lower (p q : ℕ)
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (z : ℤ) (hz : z ≠ 0) :
    (1 : ℝ) ≤ |(z : ℝ)| * (padicNorm p (z : ℚ) : ℝ) * (padicNorm q (z : ℚ) : ℝ) := by
  exact_mod_cast integer_two_prime_product_lower_rat p q hp hq hpq z hz

def integer_three_place_product_lower_rat (z : ℤ) (hz : z ≠ 0) :
    (1 : ℚ) ≤ |(z : ℚ)| * padicNorm 2 (z : ℚ) * padicNorm 3 (z : ℚ) :=
  integer_two_prime_product_lower_rat 2 3 (by norm_num) (by norm_num) (by norm_num) z hz

def integer_three_place_product_lower (z : ℤ) (hz : z ≠ 0) :
    (1 : ℝ) ≤ |(z : ℝ)| * (padicNorm 2 (z : ℚ) : ℝ) * (padicNorm 3 (z : ℚ) : ℝ) :=
  integer_two_prime_product_lower 2 3 (by norm_num) (by norm_num) (by norm_num) z hz


end
end Bounty

end SubmissionComponent_IntegerThreePlaceProduct

/- Component PrimitiveCofactorHeight; SHA256 8a1741a0bf788e8d6666ef17216d4c3fbc04c2e4cc3c9e02a72ead29879d6091 -/
section SubmissionComponent_PrimitiveCofactorHeight
/- Primitive normalization and the arithmetic lower bounds for a selected
nonzero real coordinate and two selected nonzero finite-place coordinates. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def integer_vector_primitive_factor {I : Type*} [Fintype I]
    (w : I → ℤ) (hw : w ≠ 0) :
    ∃ (g : ℤ) (a : I → ℤ), 0 < g ∧ a ≠ 0 ∧
      Finset.univ.gcd a = 1 ∧ ∀ i, w i = g * a i := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, w i ≠ 0 := by simpa [funext_iff] using hw
  obtain ⟨a, ha, hprim⟩ := Finset.extract_gcd w ⟨i, Finset.mem_univ i⟩
  have hg : Finset.univ.gcd w ≠ 0 := Finset.gcd_ne_zero_iff.mpr ⟨i, Finset.mem_univ i, hi⟩
  refine ⟨Finset.univ.gcd w, a, lt_of_le_of_ne Finset.Int.finsetGcd_nonneg (Ne.symm hg),
    ?_, hprim, fun j => ha j (Finset.mem_univ j)⟩
  intro hz
  apply hi
  simpa [hz] using ha i (Finset.mem_univ i)

def integer_cofactor_primitive_factor {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℤ)
    (hX : LinearIndependent ℚ (X.map (Int.castRingHom ℚ)).col) :
    ∃ (g : ℤ) (a : Fin (n + 1) → ℤ), 0 < g ∧ a ≠ 0 ∧
      Finset.univ.gcd a = 1 ∧ ∀ i, cofactorNormal X i = g * a i := by
  apply integer_vector_primitive_factor
  intro hz
  apply cofactorNormal_ne_zero _ hX
  rw [cofactorNormal_map]
  ext i
  simp [hz]

def integerVectorMax {I : Type*} [Fintype I] (a : I → ℤ) : ℝ :=
  ((⨆ i, |a i|) : ℤ)

def integerVectorMax_ge_one {I : Type*} [Fintype I]
    (a : I → ℤ) (ha : a ≠ 0) : 1 ≤ integerVectorMax a := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by simpa [funext_iff] using ha
  have hi' : (1 : ℤ) ≤ |a i| := by have := abs_pos.mpr hi; omega
  have hh := hi'.trans (Finite.le_ciSup (fun i => |a i|) i)
  unfold integerVectorMax
  exact_mod_cast hh

def integer_coord_abs_le_max {I : Type*} [Fintype I]
    (a : I → ℤ) (i : I) : |(a i : ℝ)| ≤ integerVectorMax a := by
  unfold integerVectorMax
  exact_mod_cast Finite.le_ciSup (fun i => |a i|) i

def primitive_integer_logHeight {I : Type*} [Fintype I] [Nonempty I]
    (a : I → ℤ) (ha : Finset.univ.gcd a = 1) :
    Height.logHeight (fun i => (a i : ℚ)) = Real.log (integerVectorMax a) :=
  Rat.logHeight_eq_max_abs_of_gcd_eq_one ha

def padicNorm_integer_reciprocal_lower (p : ℕ) (hp : p.Prime)
    (z : ℤ) (hz : z ≠ 0) :
    1 / |(z : ℝ)| ≤ (padicNorm p (z : ℚ) : ℝ) := by
  have hn : 0 < z.natAbs := Int.natAbs_pos.mpr hz
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hb : (p : ℝ) ^ padicValNat p z.natAbs ≤ (z.natAbs : ℝ) := by
    exact_mod_cast Nat.le_of_dvd hn (pow_padicValNat_dvd (p := p) (n := z.natAbs))
  rw [padicNorm_int_inverse_power p z hz]
  simp only [Rat.cast_inv, Rat.cast_pow, Rat.cast_natCast]
  have habs : |(z : ℝ)| = (z.natAbs : ℝ) := by rw [Nat.cast_natAbs, Int.cast_abs]
  rw [habs, ← one_div]
  exact one_div_le_one_div_of_le (pow_pos hp0 _) hb

def padicNorm_integer_le_height_reciprocal {I : Type*} [Fintype I]
    (p : ℕ) (hp : p.Prime) (a : I → ℤ) (i : I) (hi : a i ≠ 0) :
    1 / integerVectorMax a ≤ (padicNorm p (a i : ℚ) : ℝ) := by
  have hi0 : (0 : ℝ) < |(a i : ℝ)| := abs_pos.mpr (by exact_mod_cast hi)
  exact (one_div_le_one_div_of_le hi0 (integer_coord_abs_le_max a i)).trans
    (padicNorm_integer_reciprocal_lower p hp _ hi)

def nonzero_rational_scaled_integer_norm_lower (x : ℚ) (D z : ℤ)
    (hD : 0 < D) (hx : x ≠ 0) (hz : (D : ℚ) * x = z) :
    1 / (D : ℝ) ≤ ‖x‖ := by
  have hz0 : z ≠ 0 := by
    intro h
    have : (D : ℚ) * x = 0 := by simpa [h] using hz
    exact (mul_ne_zero (by exact_mod_cast hD.ne') hx) this
  have hz1 : (1 : ℤ) ≤ |z| := by have := abs_pos.mpr hz0; omega
  have hzreal : (1 : ℝ) ≤ |(z : ℝ)| := by exact_mod_cast hz1
  have hh := congrArg norm hz
  have hDreal : (0 : ℝ) < D := by exact_mod_cast hD
  simp only [norm_mul, Int.norm_cast_rat, Int.norm_eq_abs,
    abs_of_pos hDreal] at hh
  exact (div_le_iff₀ hDreal).mpr (by nlinarith [hh])

def primitive_normal_selected_product_lower {I : Type*} [Fintype I]
    (a : I → ℤ) (i₂ i₃ : I) (hi₂ : a i₂ ≠ 0) (hi₃ : a i₃ ≠ 0)
    (x : ℚ) (D z : ℤ) (hD : 0 < D) (hx : x ≠ 0) (hz : (D : ℚ) * x = z) :
    1 / ((D : ℝ) * integerVectorMax a ^ 2) ≤
      ‖x‖ * (padicNorm 2 (a i₂ : ℚ) : ℝ) * (padicNorm 3 (a i₃ : ℚ) : ℝ) := by
  have ha : a ≠ 0 := by intro hh; exact hi₂ (congrFun hh i₂)
  have hH : 0 < integerVectorMax a := lt_of_lt_of_le (by norm_num) (integerVectorMax_ge_one a ha)
  have hDr : (0 : ℝ) < D := by exact_mod_cast hD
  have h₀ := nonzero_rational_scaled_integer_norm_lower x D z hD hx hz
  have h₂ := padicNorm_integer_le_height_reciprocal 2 (by norm_num) a i₂ hi₂
  have h₃ := padicNorm_integer_le_height_reciprocal 3 (by norm_num) a i₃ hi₃
  have hp₂ : (0 : ℝ) ≤ padicNorm 2 (a i₂ : ℚ) := by exact_mod_cast padicNorm.nonneg (a i₂ : ℚ)
  calc
    _ = (1 / (D : ℝ)) * (1 / integerVectorMax a) * (1 / integerVectorMax a) := by ring
    _ ≤ _ := mul_le_mul (mul_le_mul h₀ h₂ (by positivity) (norm_nonneg _))
      h₃ (by positivity) (mul_nonneg (norm_nonneg _) hp₂)

def remove_integer_three_place_scalar (g : ℤ) (hg : g ≠ 0)
    (x y z : ℚ) :
    ‖x‖ * (padicNorm 2 y : ℝ) * (padicNorm 3 z : ℝ) ≤
      ‖(g : ℚ) * x‖ * (padicNorm 2 ((g : ℚ) * y) : ℝ) *
        (padicNorm 3 ((g : ℚ) * z) : ℝ) := by
  have hgprod := integer_three_place_product_lower g hg
  have hp₂ : (0 : ℝ) ≤ padicNorm 2 y := by exact_mod_cast padicNorm.nonneg y
  have hp₃ : (0 : ℝ) ≤ padicNorm 3 z := by exact_mod_cast padicNorm.nonneg z
  have hbase : 0 ≤ ‖x‖ * (padicNorm 2 y : ℝ) * (padicNorm 3 z : ℝ) := by positivity
  have h := mul_le_mul_of_nonneg_right hgprod hbase
  simp only [norm_mul, padicNorm.mul, Rat.cast_mul, Int.norm_cast_rat, Int.norm_eq_abs]
  nlinarith [h]


end
end Bounty

end SubmissionComponent_PrimitiveCofactorHeight

/- Component CofactorHeightLower; SHA256 907b8311f072161f135a23d02c0e8e633cc805670a718cec177cdbbd158418d6 -/
section SubmissionComponent_CofactorHeightLower
/- The large-height branch for an actual primitive cofactor normal.
The integer common factor is removed with its three-place product lower
bound; no affine height of an unnormalized normal is substituted. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def cofactorTransform {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) :=
  A.adjugate.transpose

def exists_integer_scaled_rational_matrix {I J : Type*} [Fintype I] [Fintype J]
    (F : Matrix I J ℚ) :
    ∃ D : ℤ, 0 < D ∧ ∃ B : Matrix I J ℤ, ∀ i j, (B i j : ℚ) = (D : ℚ) * F i j := by
  obtain ⟨D, hD⟩ := IsLocalization.exist_integer_multiples_of_finite (Submonoid.pos ℤ)
    (fun z : I × J => F z.1 z.2)
  choose B hB using hD
  refine ⟨D.val, D.property, fun i j => B (i, j), ?_⟩
  intro i j
  simpa [Algebra.smul_def] using hB (i, j)

def exists_cofactor_denominator {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) :
    ∃ D : ℤ, 0 < D ∧ ∀ (a : Fin (n + 1) → ℤ) (i : Fin (n + 1)),
      ∃ z : ℤ, (D : ℚ) * (cofactorTransform A).mulVec (fun j => (a j : ℚ)) i = z := by
  obtain ⟨D, hD, B, hB⟩ := exists_integer_scaled_rational_matrix (cofactorTransform A)
  refine ⟨D, hD, fun a i => ⟨∑ j, B i j * a j, ?_⟩⟩
  simp only [Matrix.mulVec, dotProduct, Finset.mul_sum, Int.cast_sum, Int.cast_mul, hB]
  apply Finset.sum_congr rfl
  intro j _
  ring

def cofactor_three_place_upper {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ)
    (X : Matrix (Fin (n + 1)) (Fin n) ℚ)
    (c : Fin 3 → Fin (n + 1) → ℝ) (t : ℝ)
    (hInf : ∀ i j, ‖(A * X) i j‖ ≤ Real.exp (c 0 i * t))
    (h₂ : ∀ i j, (padicNorm 2 (X i j) : ℝ) ≤ Real.exp (c 1 i * t))
    (h₃ : ∀ i j, (padicNorm 3 (X i j) : ℝ) ≤ Real.exp (c 2 i * t))
    (i : Fin 3 → Fin (n + 1)) :
    ‖cofactorNormal (A * X) (i 0)‖ *
        (padicNorm 2 (cofactorNormal X (i 1)) : ℝ) *
        (padicNorm 3 (cofactorNormal X (i 2)) : ℝ) ≤
      (n.factorial : ℝ) * Real.exp (((∑ v, ∑ j, c v j) - ∑ v, c v (i v)) * t) := by
  have h₀ := cofactorNormal_norm_le_exp (A * X) (c 0) t hInf (i 0)
  have h₂' := cofactorNormal_padicNorm_le_exp 2 X (c 1) t h₂ (i 1)
  have h₃' := cofactorNormal_padicNorm_le_exp 3 X (c 2) t h₃ (i 2)
  have hp₂ : (0 : ℝ) ≤ padicNorm 2 (cofactorNormal X (i 1)) := by
    exact_mod_cast padicNorm.nonneg (cofactorNormal X (i 1))
  have hp₃ : (0 : ℝ) ≤ padicNorm 3 (cofactorNormal X (i 2)) := by
    exact_mod_cast padicNorm.nonneg (cofactorNormal X (i 2))
  calc
    _ ≤ ((n.factorial : ℝ) * Real.exp (((∑ j, c 0 j) - c 0 (i 0)) * t)) *
        Real.exp (((∑ j, c 1 j) - c 1 (i 1)) * t) *
        Real.exp (((∑ j, c 2 j) - c 2 (i 2)) * t) :=
      mul_le_mul (mul_le_mul h₀ h₂' hp₂ (by positivity)) h₃' hp₃ (by positivity)
    _ = _ := by
      rw [mul_assoc, mul_assoc, ← Real.exp_add, ← Real.exp_add]
      congr 2
      simp only [Fin.sum_univ_succ, Fin.sum_univ_zero]
      norm_num
      ring

def primitive_cofactor_three_place_upper {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ)
    (X : Matrix (Fin (n + 1)) (Fin n) ℤ)
    (g : ℤ) (hg : g ≠ 0) (a : Fin (n + 1) → ℤ)
    (hfactor : ∀ j, cofactorNormal X j = g * a j)
    (c : Fin 3 → Fin (n + 1) → ℝ) (t : ℝ)
    (hInf : ∀ i j, ‖(A * X.map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c 0 i * t))
    (h₂ : ∀ i j, (padicNorm 2 (X i j : ℚ) : ℝ) ≤ Real.exp (c 1 i * t))
    (h₃ : ∀ i j, (padicNorm 3 (X i j : ℚ) : ℝ) ≤ Real.exp (c 2 i * t))
    (i : Fin 3 → Fin (n + 1)) :
    ‖(cofactorTransform A).mulVec (fun j => (a j : ℚ)) (i 0)‖ *
        (padicNorm 2 (a (i 1) : ℚ) : ℝ) * (padicNorm 3 (a (i 2) : ℚ) : ℝ) ≤
      (n.factorial : ℝ) * Real.exp (((∑ v, ∑ j, c v j) - ∑ v, c v (i v)) * t) := by
  have hnormal : cofactorNormal (X.map (Int.castRingHom ℚ)) =
      (g : ℚ) • (fun j => (a j : ℚ)) := by
    ext j
    rw [cofactorNormal_map]
    change ((cofactorNormal X j : ℤ) : ℚ) = (g : ℚ) * (a j : ℚ)
    rw [hfactor, Int.cast_mul]
  have htrans : cofactorNormal (A * X.map (Int.castRingHom ℚ)) =
      (g : ℚ) • (cofactorTransform A).mulVec (fun j => (a j : ℚ)) := by
    rw [cofactorNormal_mul, hnormal, Matrix.mulVec_smul]
    rfl
  have hupper := cofactor_three_place_upper A (X.map (Int.castRingHom ℚ)) c t hInf h₂ h₃ i
  rw [hnormal, htrans] at hupper
  exact (remove_integer_three_place_scalar g hg _ _ _).trans hupper

def primitive_cofactor_height_lower {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ)
    (X : Matrix (Fin (n + 1)) (Fin n) ℤ)
    (g : ℤ) (hg : g ≠ 0) (a : Fin (n + 1) → ℤ)
    (hprimitive : Finset.univ.gcd a = 1)
    (hfactor : ∀ j, cofactorNormal X j = g * a j)
    (c : Fin 3 → Fin (n + 1) → ℝ) (t ρ : ℝ) (ht : 0 ≤ t)
    (hInf : ∀ i j, ‖(A * X.map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c 0 i * t))
    (h₂ : ∀ i j, (padicNorm 2 (X i j : ℚ) : ℝ) ≤ Real.exp (c 1 i * t))
    (h₃ : ∀ i j, (padicNorm 3 (X i j : ℚ) : ℝ) ≤ Real.exp (c 2 i * t))
    (hc : (∑ v, ∑ j, c v j) ≤ -ρ)
    (i : Fin 3 → Fin (n + 1)) (hi : -ρ / 2 ≤ ∑ v, c v (i v))
    (hi₂ : a (i 1) ≠ 0) (hi₃ : a (i 2) ≠ 0)
    (D z : ℤ) (hD : 0 < D)
    (hx : (cofactorTransform A).mulVec (fun j => (a j : ℚ)) (i 0) ≠ 0)
    (hz : (D : ℚ) * (cofactorTransform A).mulVec (fun j => (a j : ℚ)) (i 0) = z) :
    ρ * t / 4 - Real.log ((D : ℝ) * (n.factorial : ℝ)) / 2 ≤
      Height.logHeight (fun j => (a j : ℚ)) := by
  have hu := primitive_cofactor_three_place_upper A X g hg a hfactor c t hInf h₂ h₃ i
  have he : ((∑ v, ∑ j, c v j) - ∑ v, c v (i v)) * t ≤ -ρ * t / 2 := by
    have h : (∑ v, ∑ j, c v j) - ∑ v, c v (i v) ≤ -ρ / 2 := by linarith
    nlinarith [mul_le_mul_of_nonneg_right h ht]
  have hu' := hu.trans (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr he)
    (show (0 : ℝ) ≤ n.factorial by positivity))
  have hl := primitive_normal_selected_product_lower a (i 1) (i 2) hi₂ hi₃ _ D z hD hx hz
  have hboth := hl.trans hu'
  have ha : a ≠ 0 := by intro h; exact hi₂ (congrFun h (i 1))
  have hH : 0 < integerVectorMax a := lt_of_lt_of_le (by norm_num) (integerVectorMax_ge_one a ha)
  have hDr : (0 : ℝ) < D := by exact_mod_cast hD
  have hf : (0 : ℝ) < n.factorial := by exact_mod_cast Nat.factorial_pos n
  have hlog := Real.log_le_log (by positivity : 0 < 1 / ((D : ℝ) * integerVectorMax a ^ 2)) hboth
  rw [primitive_integer_logHeight a hprimitive]
  rw [Real.log_div one_ne_zero (by positivity), Real.log_one,
    Real.log_mul hDr.ne' (by positivity), Real.log_pow,
    Real.log_mul hf.ne' (Real.exp_ne_zero _), Real.log_exp] at hlog
  rw [Real.log_mul hDr.ne' hf.ne']
  nlinarith


end
end Bounty

end SubmissionComponent_CofactorHeightLower

/- Component HyperplaneIndexSpecialization; SHA256 31e52aedcfb013b82de805ce732f687030e82431ae0d53f8e1ce4e79a642c88a -/
section SubmissionComponent_HyperplaneIndexSpecialization
/- Saturation and specialization of weighted monomial orders.  Removing
zero-weight variables preserves the order during exact monomial division and
can only increase it during specialization.  The coefficient maps are actual
injections of subvectors, so the coefficient sum norm does not increase. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I J R : Type*}

def polynomialCoeffL1_le_coeff_embedding [NormedCommRing R]
    (P : MvPolynomial I R) (Q : MvPolynomial J R)
    (f : (J →₀ ℕ) → (I →₀ ℕ)) (hf : Function.Injective f)
    (hcoeff : ∀ d, MvPolynomial.coeff d Q = MvPolynomial.coeff (f d) P) :
    polynomialCoeffL1 Q ≤ polynomialCoeffL1 P := by
  classical
  have hs : Q.support.image f ⊆ P.support := by
    intro e he
    obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp he
    simpa only [MvPolynomial.mem_support_iff, ← hcoeff] using hd
  calc
    _ = ∑ e ∈ Q.support.image f, ‖MvPolynomial.coeff e P‖ := by
      rw [Finset.sum_image hf.injOn]
      simp only [polynomialCoeffL1, hcoeff]
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hs (fun _ _ _ => norm_nonneg _)

def polynomialCoeffL1_divMonomial_le [NormedCommRing R]
    (P : MvPolynomial I R) (s : I →₀ ℕ) :
    polynomialCoeffL1 (P.divMonomial s) ≤ polynomialCoeffL1 P :=
  polynomialCoeffL1_le_coeff_embedding P _ (s + ·) (add_right_injective s)
    (fun _ => MvPolynomial.coeff_divMonomial _ _ _)

def polynomialCoeffL1_killCompl_le [NormedCommRing R]
    (f : I → J) (hf : Function.Injective f) (P : MvPolynomial J R) :
    polynomialCoeffL1 (P.killCompl hf) ≤ polynomialCoeffL1 P :=
  polynomialCoeffL1_le_coeff_embedding P _ (Finsupp.mapDomain f)
    (Finsupp.mapDomain_injective hf) (fun _ => MvPolynomial.coeff_killCompl hf)

def specialization_weight_mapDomain (w : J → ℕ) (f : I → J) (d : I →₀ ℕ) :
    Finsupp.weight w (d.mapDomain f) = Finsupp.weight (w ∘ f) d := by
  exact Finsupp.sum_mapDomain_index (f := f) (s := d)
    (h := fun i (v : ℕ) => v • w i) (fun _ => zero_smul _ _)
    (fun _ _ _ => add_smul ..)

def weightedPolynomialOrder_killCompl_le (w : J → ℕ) (f : I → J)
    (hf : Function.Injective f) (P : MvPolynomial J ℚ) :
    weightedPolynomialOrder w P ≤ weightedPolynomialOrder (w ∘ f) (P.killCompl hf) := by
  apply (weightedPolynomialOrder_le_iff _ _ _).mpr
  intro d hd
  rw [MvPolynomial.coeff_killCompl] at hd
  simpa only [specialization_weight_mapDomain] using weightedPolynomialOrder_le_of_coeff w hd

def weightedPolynomialOrder_monomial_one (w : I → ℕ) (s : I →₀ ℕ) :
    weightedPolynomialOrder w (MvPolynomial.monomial s (1 : ℚ)) = Finsupp.weight w s := by
  classical
  apply le_antisymm
  · apply weightedPolynomialOrder_le_of_coeff
    simp
  · apply (weightedPolynomialOrder_le_iff _ _ _).mpr
    intro d hd
    have hds : d = s := by
      by_contra hh
      simp [MvPolynomial.coeff_monomial, Ne.symm hh] at hd
    subst d
    exact le_rfl

def monomial_mul_divMonomial_of_support [CommSemiring R]
    (P : MvPolynomial I R) (s : I →₀ ℕ)
    (hs : ∀ d ∈ P.support, s ≤ d) :
    MvPolynomial.monomial s 1 * P.divMonomial s = P := by
  have hz : P.modMonomial s = 0 := by
    ext d
    by_cases hsd : s ≤ d
    · simp [MvPolynomial.coeff_modMonomial_of_le P hsd]
    · rw [MvPolynomial.coeff_modMonomial_of_not_le P hsd, MvPolynomial.coeff_zero]
      exact MvPolynomial.notMem_support_iff.mp (fun hd => hsd (hs d hd))
  simpa only [hz, add_zero] using P.divMonomial_add_modMonomial s

def degreeOf_divMonomial_le [CommSemiring R] (P : MvPolynomial I R)
    (s : I →₀ ℕ) (i : I) :
    (P.divMonomial s).degreeOf i ≤ P.degreeOf i := by
  apply MvPolynomial.degreeOf_le_iff.mpr
  intro d hd
  have hp : s + d ∈ P.support := by
    simpa only [MvPolynomial.mem_support_iff, MvPolynomial.coeff_divMonomial] using hd
  exact (Nat.le_add_left _ _).trans (MvPolynomial.monomial_le_degreeOf i hp)

def zeroCoordinateSpecialization [CommSemiring R] (z : I) :
    MvPolynomial I R →ₐ[R] MvPolynomial {i : I // i ≠ z} R :=
  MvPolynomial.killCompl (f := Subtype.val) Subtype.val_injective

/-- The coefficient slice at exponent `k` in the variable `z`. -/
def coordinateSlice [CommSemiring R] (z : I) (k : ℕ) (P : MvPolynomial I R) :
    MvPolynomial {i : I // i ≠ z} R :=
  zeroCoordinateSpecialization z (P.divMonomial (Finsupp.single z k))

def coordinateSlice_coeff [CommSemiring R] (z : I) (k : ℕ)
    (P : MvPolynomial I R) (d : {i : I // i ≠ z} →₀ ℕ) :
    MvPolynomial.coeff d (coordinateSlice z k P) =
      MvPolynomial.coeff (Finsupp.single z k + d.mapDomain Subtype.val) P := by
  exact (MvPolynomial.coeff_killCompl Subtype.val_injective).trans
    (MvPolynomial.coeff_divMonomial _ _ _)

def coordinate_exponent_split (z : I) (d : I →₀ ℕ) :
    Finsupp.single z (d z) +
      (d.comapDomain (Subtype.val : {i : I // i ≠ z} → I)
        Subtype.val_injective.injOn).mapDomain Subtype.val = d := by
  classical
  let e := d.comapDomain (Subtype.val : {i : I // i ≠ z} → I) Subtype.val_injective.injOn
  have hz : e.mapDomain Subtype.val z = 0 := by
    apply Finsupp.mapDomain_of_not_mem_image_support
    rintro ⟨j, _, hj⟩
    exact j.property hj
  ext i
  by_cases hi : i = z
  · subst i
    change (Finsupp.single z (d z)) z + e.mapDomain Subtype.val z = d z
    simp only [Finsupp.single_eq_same, hz, add_zero]
  · have hh := Finsupp.mapDomain_apply Subtype.val_injective e (⟨i, hi⟩ : {i : I // i ≠ z})
    change (Finsupp.single z (d z)) i + e.mapDomain Subtype.val i = d i
    rw [hh]
    simp only [e, Finsupp.comapDomain_apply, Finsupp.single_eq_of_ne hi, zero_add]

def coordinateSlice_ne_zero_of_coeff [CommSemiring R]
    (z : I) (P : MvPolynomial I R) {d : I →₀ ℕ}
    (hd : MvPolynomial.coeff d P ≠ 0) : coordinateSlice z (d z) P ≠ 0 := by
  intro hz
  let e := d.comapDomain (Subtype.val : {i : I // i ≠ z} → I) Subtype.val_injective.injOn
  have hh := congrArg (MvPolynomial.coeff e) hz
  rw [coordinateSlice_coeff, MvPolynomial.coeff_zero] at hh
  have he : Finsupp.single z (d z) + e.mapDomain Subtype.val = d := coordinate_exponent_split z d
  exact hd (he ▸ hh)

end
end Bounty

end SubmissionComponent_HyperplaneIndexSpecialization

/- Component BlockHomogeneousDehomogenization; SHA256 80530dd4143d107cdac1261107f14a03bfeab0def789c269e60b29a457317d85 -/
section SubmissionComponent_BlockHomogeneousDehomogenization
/- Exact dehomogenization of two-coordinate homogeneous blocks.  The variable
`Sum.inl i` is retained and `Sum.inr i` is set to one.  Fixed block degrees
make the map on supported exponents injective, preventing coefficient collisions. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {I R S : Type*}

open scoped Classical in
def blockLeftExponent (e : I ⊕ I →₀ ℕ) : I →₀ ℕ :=
  e.comapDomain Sum.inl Sum.inl_injective.injOn

open scoped Classical in
def blockLeftExponent_apply (e : I ⊕ I →₀ ℕ) (i : I) :
    blockLeftExponent e i = e (Sum.inl i) := rfl

open scoped Classical in
def BlockHomogeneous [CommSemiring R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) : Prop :=
  ∀ e ∈ P.support, ∀ i, e (Sum.inl i) + e (Sum.inr i) = r i

open scoped Classical in
def blockDehomogenize [CommSemiring R] :
    MvPolynomial (I ⊕ I) R →ₐ[R] MvPolynomial I R :=
  MvPolynomial.aeval (Sum.elim MvPolynomial.X (fun _ => 1))

open scoped Classical in
def blockDehomogenize_C [CommSemiring R] (a : R) :
    blockDehomogenize (I := I) (MvPolynomial.C a) = MvPolynomial.C a := by
  simp [blockDehomogenize]

open scoped Classical in
def blockDehomogenize_X_inl [CommSemiring R] (i : I) :
    blockDehomogenize (MvPolynomial.X (R := R) (Sum.inl i)) = MvPolynomial.X i := by
  simp [blockDehomogenize]

open scoped Classical in
def blockDehomogenize_X_inr [CommSemiring R] (i : I) :
    blockDehomogenize (MvPolynomial.X (R := R) (Sum.inr i)) = 1 := by
  simp [blockDehomogenize]

open scoped Classical in
def blockLeftExponent_injective_fixed (r : I → ℕ) {e d : I ⊕ I →₀ ℕ}
    (he : ∀ i, e (Sum.inl i) + e (Sum.inr i) = r i)
    (hd : ∀ i, d (Sum.inl i) + d (Sum.inr i) = r i)
    (h : blockLeftExponent e = blockLeftExponent d) : e = d := by
  ext j
  cases j with
  | inl i => exact DFunLike.congr_fun h i
  | inr i =>
    have hi : e (Sum.inl i) = d (Sum.inl i) := DFunLike.congr_fun h i
    have := he i
    have := hd i
    omega

open scoped Classical in
def blockDehomogenize_monomial [CommSemiring R]
    (e : I ⊕ I →₀ ℕ) (a : R) :
    blockDehomogenize (MvPolynomial.monomial e a) =
      MvPolynomial.monomial (blockLeftExponent e) a := by
  rw [blockDehomogenize, MvPolynomial.aeval_monomial, MvPolynomial.monomial_eq]
  congr 1
  nth_rw 1 [← Finsupp.comapDomain_sumElim_comapDomain e]
  rw [Finsupp.prod_sumElim]
  simp [blockLeftExponent, Function.comp_def]

open scoped Classical in
def blockDehomogenize_as_sum [CommSemiring R] (P : MvPolynomial (I ⊕ I) R) :
    blockDehomogenize P = ∑ e ∈ P.support,
      MvPolynomial.monomial (blockLeftExponent e) (MvPolynomial.coeff e P) := by
  nth_rw 1 [MvPolynomial.as_sum P]
  simp only [map_sum, blockDehomogenize_monomial]

/- Every supported original coefficient is recovered exactly after dehomogenization. -/
open scoped Classical in
def blockDehomogenize_coeff [CommSemiring R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) (hP : BlockHomogeneous r P)
    (e : I ⊕ I →₀ ℕ) (he : e ∈ P.support) :
    MvPolynomial.coeff (blockLeftExponent e) (blockDehomogenize P) = MvPolynomial.coeff e P := by
  classical
  rw [blockDehomogenize_as_sum, MvPolynomial.coeff_sum, Finset.sum_eq_single e]
  · simp
  · intro d hd hde
    have hh : blockLeftExponent d ≠ blockLeftExponent e :=
      fun hh => hde (blockLeftExponent_injective_fixed r (hP d hd) (hP e he) hh)
    simp [MvPolynomial.coeff_monomial, hh]
  · exact fun hn => False.elim (hn he)

open scoped Classical in
def blockDehomogenize_support_subset [CommSemiring R]
    (P : MvPolynomial (I ⊕ I) R) :
    (blockDehomogenize P).support ⊆ P.support.image blockLeftExponent := by
  classical
  rw [blockDehomogenize_as_sum]
  intro d hd
  obtain ⟨e, he, hde⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hd)
  have hh := MvPolynomial.support_monomial_subset hde
  exact Finset.mem_image.mpr ⟨e, he, (Finset.mem_singleton.mp hh).symm⟩

open scoped Classical in
def blockDehomogenize_support [CommSemiring R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) (hP : BlockHomogeneous r P) :
    (blockDehomogenize P).support = P.support.image blockLeftExponent := by
  classical
  apply Finset.Subset.antisymm (blockDehomogenize_support_subset P)
  intro d hd
  obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hd
  rw [MvPolynomial.mem_support_iff, blockDehomogenize_coeff r P hP e he]
  exact MvPolynomial.mem_support_iff.mp he

open scoped Classical in
def blockDehomogenize_ne_zero [CommSemiring R] (r : I → ℕ)
    {P : MvPolynomial (I ⊕ I) R} (hP : BlockHomogeneous r P) (hne : P ≠ 0) :
    blockDehomogenize P ≠ 0 := by
  classical
  obtain ⟨e, he⟩ := MvPolynomial.support_nonempty.mpr hne
  intro hz
  have hh := blockDehomogenize_coeff r P hP e he
  rw [hz, MvPolynomial.coeff_zero] at hh
  exact (MvPolynomial.mem_support_iff.mp he) hh.symm

open scoped Classical in
def blockDehomogenize_coeffL1 [NormedCommRing R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) (hP : BlockHomogeneous r P) :
    polynomialCoeffL1 (blockDehomogenize P) = polynomialCoeffL1 P := by
  classical
  unfold polynomialCoeffL1
  rw [blockDehomogenize_support r P hP, Finset.sum_image]
  · exact Finset.sum_congr rfl (fun e he => congrArg norm (blockDehomogenize_coeff r P hP e he))
  · intro e he d hd hh
    exact blockLeftExponent_injective_fixed r (hP e he) (hP d hd) hh

open scoped Classical in
def blockDehomogenize_degreeOf_le [CommSemiring R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) (hP : BlockHomogeneous r P) (i : I) :
    (blockDehomogenize P).degreeOf i ≤ r i := by
  classical
  apply MvPolynomial.degreeOf_le_iff.mpr
  intro d hd
  obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp (blockDehomogenize_support_subset P hd)
  have := hP e he i
  simp only [blockLeftExponent_apply]
  omega

open scoped Classical in
def blockDehomogenize_map [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (P : MvPolynomial (I ⊕ I) R) :
    MvPolynomial.map f (blockDehomogenize P) = blockDehomogenize (MvPolynomial.map f P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i <;> simp only [map_mul, MvPolynomial.map_X, blockDehomogenize_X_inl,
      blockDehomogenize_X_inr, map_one, hP]

open scoped Classical in
def block_weight_left (w : I → ℕ) (e : I ⊕ I →₀ ℕ) :
    Finsupp.weight (Sum.elim w (fun _ => 0)) e = Finsupp.weight w (blockLeftExponent e) := by
  rw [Finsupp.weight_apply, Finsupp.weight_apply]
  nth_rw 1 [← Finsupp.comapDomain_sumElim_comapDomain e]
  rw [Finsupp.sum_sumElim]
  simp [blockLeftExponent, Function.comp_def]

open scoped Classical in
def blockDehomogenize_order (r w : I → ℕ)
    (P : MvPolynomial (I ⊕ I) ℚ) (hP : BlockHomogeneous r P) :
    weightedPolynomialOrder (Sum.elim w (fun _ => 0)) P =
      weightedPolynomialOrder w (blockDehomogenize P) := by
  apply le_antisymm
  · apply (weightedPolynomialOrder_le_iff _ _ _).mpr
    intro d hd
    obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp (blockDehomogenize_support_subset P
      (MvPolynomial.mem_support_iff.mpr hd))
    simpa only [block_weight_left] using weightedPolynomialOrder_le_of_coeff
      (Sum.elim w (fun _ => 0)) (MvPolynomial.mem_support_iff.mp he)
  · apply (weightedPolynomialOrder_le_iff _ _ _).mpr
    intro e he
    have hc : MvPolynomial.coeff (blockLeftExponent e) (blockDehomogenize P) ≠ 0 := by
      rw [blockDehomogenize_coeff r P hP e (MvPolynomial.mem_support_iff.mpr he)]
      exact he
    simpa only [block_weight_left] using weightedPolynomialOrder_le_of_coeff w hc

/- A substitution homogeneous of the weight of each input variable preserves
weighted homogeneity.  This is used for changes of coordinates inside blocks. -/
open scoped Classical in
def weightedHomogeneous_aeval [CommSemiring R] {J : Type*}
    (w : J → ℕ) (g : J → MvPolynomial J R)
    (hg : ∀ j, MvPolynomial.IsWeightedHomogeneous w (g j) (w j))
    (P : MvPolynomial J R) (n : ℕ) (hP : MvPolynomial.IsWeightedHomogeneous w P n) :
    MvPolynomial.IsWeightedHomogeneous w (MvPolynomial.aeval g P) n := by
  classical
  nth_rw 1 [MvPolynomial.as_sum P]
  rw [map_sum]
  apply MvPolynomial.IsWeightedHomogeneous.sum
  intro e he
  rw [MvPolynomial.aeval_monomial]
  change MvPolynomial.IsWeightedHomogeneous w
    (MvPolynomial.C (MvPolynomial.coeff e P) * e.prod (fun j a => g j ^ a)) n
  have hprod := MvPolynomial.IsWeightedHomogeneous.prod e.support
    (fun j => g j ^ e j) (fun j => e j • w j) (fun j _ => (hg j).pow (e j))
  have hsum : ∑ j ∈ e.support, e j • w j = n := hP (MvPolynomial.mem_support_iff.mp he)
  rw [hsum] at hprod
  exact hprod.C_mul _

open scoped Classical in
def blockDegreeWeight (i : I) : I ⊕ I → ℕ :=
  Sum.elim (Pi.single i 1) (Pi.single i 1)

open scoped Classical in
def blockDegreeWeight_apply (i : I) (e : I ⊕ I →₀ ℕ) :
    Finsupp.weight (blockDegreeWeight i) e = e (Sum.inl i) + e (Sum.inr i) := by
  rw [Finsupp.weight_apply]
  nth_rw 1 [← Finsupp.comapDomain_sumElim_comapDomain e]
  rw [Finsupp.sum_sumElim]
  change Finsupp.weight (Pi.single i 1) (e.comapDomain Sum.inl Sum.inl_injective.injOn) +
    Finsupp.weight (Pi.single i 1) (e.comapDomain Sum.inr Sum.inr_injective.injOn) = _
  simp only [Finsupp.weight_single_one_apply, Finsupp.comapDomain_apply]

open scoped Classical in
def blockHomogeneous_iff_weighted [CommSemiring R] (r : I → ℕ)
    (P : MvPolynomial (I ⊕ I) R) :
    BlockHomogeneous r P ↔
      ∀ i, MvPolynomial.IsWeightedHomogeneous (blockDegreeWeight i) P (r i) := by
  constructor
  · intro h i e he
    rw [blockDegreeWeight_apply]
    exact h e (MvPolynomial.mem_support_iff.mpr he) i
  · intro h e he i
    simpa only [blockDegreeWeight_apply] using h i (MvPolynomial.mem_support_iff.mp he)

/- Homogeneous Taylor translation in each pair `(X_i,Y_i)`. -/
open scoped Classical in
def blockTaylor [CommSemiring R] (β : I → R) :
    MvPolynomial (I ⊕ I) R →ₐ[R] MvPolynomial (I ⊕ I) R :=
  MvPolynomial.aeval (Sum.elim
    (fun i => MvPolynomial.X (Sum.inl i) + MvPolynomial.C (β i) * MvPolynomial.X (Sum.inr i))
    (fun i => MvPolynomial.X (Sum.inr i)))

open scoped Classical in
open scoped Classical in
def blockTaylor_X_inl [CommSemiring R] (β : I → R) (i : I) :
    blockTaylor β (MvPolynomial.X (Sum.inl i)) =
      MvPolynomial.X (Sum.inl i) + MvPolynomial.C (β i) * MvPolynomial.X (Sum.inr i) := by
  simp [blockTaylor]

open scoped Classical in
def blockTaylor_X_inr [CommSemiring R] (β : I → R) (i : I) :
    blockTaylor β (MvPolynomial.X (Sum.inr i)) = MvPolynomial.X (Sum.inr i) := by
  simp [blockTaylor]

open scoped Classical in
def blockTaylor_homogeneous [CommSemiring R] (r : I → ℕ) (β : I → R)
    (P : MvPolynomial (I ⊕ I) R) (hP : BlockHomogeneous r P) :
    BlockHomogeneous r (blockTaylor β P) := by
  apply (blockHomogeneous_iff_weighted r _).mpr
  intro i
  apply weightedHomogeneous_aeval
  · intro j
    cases j with
    | inl j =>
      exact (MvPolynomial.isWeightedHomogeneous_X R (blockDegreeWeight i) (Sum.inl j)).add
        ((MvPolynomial.isWeightedHomogeneous_X R (blockDegreeWeight i) (Sum.inr j)).C_mul (β j))
    | inr j => exact MvPolynomial.isWeightedHomogeneous_X R _ _
  · exact (blockHomogeneous_iff_weighted r P).mp hP i

open scoped Classical in
def blockDehomogenize_blockTaylor (β : I → ℚ) (P : MvPolynomial (I ⊕ I) ℚ) :
    blockDehomogenize (blockTaylor β P) = weightedTaylor β (blockDehomogenize P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [weightedTaylor_C]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P j hP =>
    cases j <;> simp only [map_mul, blockTaylor_X_inl, blockTaylor_X_inr,
      blockDehomogenize_X_inl, blockDehomogenize_X_inr, map_add, blockDehomogenize_C,
      mul_one, weightedTaylor_X, map_one, hP]

/- The order in the homogeneous forms `X_i - β_i Y_i` becomes the ordinary
Taylor index at `β` after dehomogenization. -/
open scoped Classical in
def blockDehomogenize_hyperplane_index (r w : I → ℕ) (β : I → ℚ)
    (P : MvPolynomial (I ⊕ I) ℚ) (hP : BlockHomogeneous r P) :
    weightedPolynomialOrder (Sum.elim w (fun _ => 0)) (blockTaylor β P) =
      weightedPolynomialIndex w β (blockDehomogenize P) := by
  rw [blockDehomogenize_order r w _ (blockTaylor_homogeneous r β P hP),
    blockDehomogenize_blockTaylor]
  rfl


end
end Bounty

end SubmissionComponent_BlockHomogeneousDehomogenization

/- Component RationalHyperplanePairHeight; SHA256 a9ece804862ac1f70bc8c3432e983633d3d69a1de9ae845d73baf482114ccd4e -/
section SubmissionComponent_RationalHyperplanePairHeight
/- A rational hyperplane has a coefficient pair whose height is at least
the projective coefficient height divided by the projective dimension. -/

namespace Bounty
noncomputable section
open scoped BigOperators

/-- Each coordinate is a coordinate of the Segre product of the pairs
`[x_i,1]`.  Projection cannot increase projective height. -/
def projective_logHeight_le_sum_coordinate_heights
    {K I : Type*} [Field K] [Height.AdmissibleAbsValues K] [Fintype I]
    (x : I → K) : Height.logHeight x ≤ ∑ i, Height.logHeight₁ (x i) := by
  classical
  let y (i : I) : Fin 2 → K := ![x i, 1]
  have hy (i : I) : y i ≠ 0 := by
    intro hz
    have hh := congrFun hz 1
    simp [y] at hh
  let pick (i : I) (a : I) : Fin 2 := if a = i then 0 else 1
  have hpick : (fun v : I → Fin 2 => ∏ a, y a (v a)) ∘ pick = x := by
    funext i
    change (∏ a, y a (if a = i then 0 else 1)) = x i
    rw [Finset.prod_eq_single i]
    · simp [y]
    · intro a _ hai
      simp [hai, y]
    · simp
  have hh := Height.logHeight_comp_le pick (fun v : I → Fin 2 => ∏ a, y a (v a))
  rw [hpick, Height.logHeight_fun_prod_eq hy] at hh
  simpa only [y, ← Height.logHeight₁_eq_logHeight] using hh

def rational_hyperplane_height_le_sum_ratios {I : Type*} [Fintype I] [DecidableEq I]
    (b : I → ℚ) (j : I) (hj : b j ≠ 0) :
    Height.logHeight b ≤ ∑ i ∈ Finset.univ.erase j, Height.logHeight₁ (b i / b j) := by
  have hscale : Height.logHeight (fun i => b i / b j) = Height.logHeight b := by
    have he : (fun i => b i / b j) = (b j)⁻¹ • b := by
      ext i
      simp only [Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm]
    rw [he, Height.logHeight_smul_eq_logHeight b (inv_ne_zero hj)]
  have hh := projective_logHeight_le_sum_coordinate_heights (fun i => b i / b j)
  rw [hscale, ← Finset.sum_erase_add Finset.univ
    (fun i => Height.logHeight₁ (b i / b j)) (Finset.mem_univ j)] at hh
  simpa only [div_self hj, Height.logHeight₁_one, add_zero] using hh

/-- Any nonzero coefficient may be used as the denominator of the selected ratio. -/
def exists_rational_hyperplane_height_pair {d : ℕ} (hd : 1 ≤ d)
    (b : Fin (d + 1) → ℚ) (j : Fin (d + 1)) (hj : b j ≠ 0) :
    ∃ i : Fin (d + 1), i ≠ j ∧
      Height.logHeight b / (d : ℝ) ≤ Height.logHeight₁ (-b i / b j) := by
  classical
  let s : Finset (Fin (d + 1)) := Finset.univ.erase j
  have hcard : s.card = d := by simp [s]
  have hs : s.Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨i, hi, hmax⟩ := s.exists_max_image (fun a => Height.logHeight₁ (b a / b j)) hs
  have hsum : (∑ a ∈ s, Height.logHeight₁ (b a / b j)) ≤
      (d : ℝ) * Height.logHeight₁ (b i / b j) := by
    calc
      _ ≤ ∑ _a ∈ s, Height.logHeight₁ (b i / b j) := Finset.sum_le_sum hmax
      _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, hcard]
  refine ⟨i, (Finset.mem_erase.mp hi).1, ?_⟩
  rw [neg_div, Height.logHeight₁_neg]
  apply (div_le_iff₀ (by exact_mod_cast (show 0 < d by omega))).mpr
  simpa only [mul_comm] using (rational_hyperplane_height_le_sum_ratios b j hj).trans hsum

end
end Bounty

end SubmissionComponent_RationalHyperplanePairHeight

/- Component RationalHyperplaneIndex; SHA256 ee5fc430ea06146f893b39c9c8b8d922fe741359ec652c92207155859472be5f -/
section SubmissionComponent_RationalHyperplaneIndex
/- Concrete coordinate changes and saturation for the rational hyperplane
index.  Pivots and complementary variables are separated by a sum type. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {B C I J R : Type*}

/- Set one variable to zero while keeping the ambient variable type fixed. -/
open scoped Classical in
def zeroVariable [CommSemiring R] (z : I) : MvPolynomial I R →ₐ[R] MvPolynomial I R :=
  MvPolynomial.aeval (fun i => if i = z then 0 else MvPolynomial.X i)

open scoped Classical in
open scoped Classical in
def zeroVariable_X [CommSemiring R] (z i : I) :
    zeroVariable z (MvPolynomial.X (R := R) i) = if i = z then 0 else MvPolynomial.X i := by
  simp [zeroVariable]

open scoped Classical in
def zeroCoordinateSpecialization_X_self [CommSemiring R] (z : I) :
    zeroCoordinateSpecialization z (MvPolynomial.X (R := R) z) = 0 := by
  change (MvPolynomial.monomial (Finsupp.single z 1) (1 : R)).killCompl Subtype.val_injective = 0
  apply MvPolynomial.killCompl_monomial_eq_zero_of_notMem_range _ _ (a := z)
  · simp
  · rintro ⟨i, hi⟩
    exact i.property hi

open scoped Classical in
def zeroCoordinateSpecialization_X_ne [CommSemiring R] (z i : I) (hi : i ≠ z) :
    zeroCoordinateSpecialization z (MvPolynomial.X (R := R) i) = MvPolynomial.X ⟨i, hi⟩ := by
  simpa only [zeroCoordinateSpecialization, MvPolynomial.rename_X] using MvPolynomial.killCompl_rename_app Subtype.val_injective
    (MvPolynomial.X (R := R) (⟨i, hi⟩ : {i : I // i ≠ z}))

open scoped Classical in
def zeroVariable_eq_rename_specialization [CommSemiring R] (z : I) (P : MvPolynomial I R) :
    zeroVariable z P = MvPolynomial.rename Subtype.val (zeroCoordinateSpecialization z P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [zeroCoordinateSpecialization]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    rw [map_mul, map_mul, map_mul, hP, zeroVariable_X]
    by_cases hi : i = z
    · subst i
      simp only [zeroCoordinateSpecialization_X_self, map_zero, ite_true]
    · rw [if_neg hi, zeroCoordinateSpecialization_X_ne z i hi, MvPolynomial.rename_X]

open scoped Classical in
def zeroVariable_coeffL1_le [NormedCommRing R] (z : I) (P : MvPolynomial I R) :
    polynomialCoeffL1 (zeroVariable z P) ≤ polynomialCoeffL1 P := by
  rw [zeroVariable_eq_rename_specialization,
    polynomialCoeffL1_rename_of_injective _ Subtype.val_injective]
  exact polynomialCoeffL1_killCompl_le _ Subtype.val_injective P

open scoped Classical in
def zeroVariable_support_subset [CommSemiring R] (z : I) (P : MvPolynomial I R) :
    (zeroVariable z P).support ⊆ P.support := by
  rw [zeroVariable_eq_rename_specialization]
  exact MvPolynomial.support_rename_killCompl_subset Subtype.val_injective

open scoped Classical in
def zeroVariable_degreeOf_le [CommSemiring R] (z : I) (P : MvPolynomial I R) (i : I) :
    (zeroVariable z P).degreeOf i ≤ P.degreeOf i := by
  simp only [MvPolynomial.degreeOf_eq_sup]
  exact Finset.sup_mono (zeroVariable_support_subset z P)

open scoped Classical in
def weightedPolynomialOrder_rename_injective (w : J → ℕ) (f : I → J)
    (hf : Function.Injective f) (P : MvPolynomial I ℚ) :
    weightedPolynomialOrder w (MvPolynomial.rename f P) = weightedPolynomialOrder (w ∘ f) P := by
  classical
  apply le_antisymm
  · apply (weightedPolynomialOrder_le_iff _ _ _).mpr
    intro d hd
    have hh : MvPolynomial.coeff (d.mapDomain f) (MvPolynomial.rename f P) ≠ 0 := by
      rwa [MvPolynomial.coeff_rename_mapDomain f hf]
    simpa only [specialization_weight_mapDomain] using weightedPolynomialOrder_le_of_coeff w hh
  · apply (weightedPolynomialOrder_le_iff _ _ _).mpr
    intro e he
    have hs : e ∈ (MvPolynomial.rename f P).support := MvPolynomial.mem_support_iff.mpr he
    rw [MvPolynomial.support_rename_of_injective hf] at hs
    obtain ⟨d, hd, rfl⟩ := Finset.mem_image.mp hs
    simpa only [specialization_weight_mapDomain] using weightedPolynomialOrder_le_of_coeff
      (w ∘ f) (MvPolynomial.mem_support_iff.mp hd)

open scoped Classical in
def zeroVariable_order_le (w : I → ℕ) (z : I) (P : MvPolynomial I ℚ) :
    weightedPolynomialOrder w P ≤ weightedPolynomialOrder w (zeroVariable z P) := by
  rw [zeroVariable_eq_rename_specialization, weightedPolynomialOrder_rename_injective _ _
    Subtype.val_injective]
  exact weightedPolynomialOrder_killCompl_le _ _ Subtype.val_injective P

/- An invertible triangular change: every pivot is translated by a polynomial
in the complementary variables, which themselves are fixed. -/
open scoped Classical in
def complementShear [CommSemiring R] (g : B → MvPolynomial C R) :
    MvPolynomial (B ⊕ C) R →ₐ[R] MvPolynomial (B ⊕ C) R :=
  MvPolynomial.aeval (Sum.elim
    (fun b => MvPolynomial.X (Sum.inl b) + MvPolynomial.rename Sum.inr (g b))
    (fun c => MvPolynomial.X (Sum.inr c)))

open scoped Classical in
open scoped Classical in
def complementShear_X_inl [CommSemiring R] (g : B → MvPolynomial C R) (b : B) :
    complementShear g (MvPolynomial.X (Sum.inl b)) =
      MvPolynomial.X (Sum.inl b) + MvPolynomial.rename Sum.inr (g b) := by simp [complementShear]

open scoped Classical in
def complementShear_X_inr [CommSemiring R] (g : B → MvPolynomial C R) (c : C) :
    complementShear g (MvPolynomial.X (Sum.inr c)) = MvPolynomial.X (Sum.inr c) := by
  simp [complementShear]

open scoped Classical in
def complementShear_rename_inr [CommSemiring R] (g : B → MvPolynomial C R)
    (P : MvPolynomial C R) :
    complementShear g (MvPolynomial.rename Sum.inr P) = MvPolynomial.rename Sum.inr P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P c hP => simp only [map_mul, MvPolynomial.rename_X, complementShear_X_inr, hP]

open scoped Classical in
def complementShear_comp [CommSemiring R] (g h : B → MvPolynomial C R)
    (P : MvPolynomial (B ⊕ C) R) :
    complementShear g (complementShear h P) = complementShear (g + h) P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i <;> simp only [map_mul, complementShear_X_inl, complementShear_X_inr,
      map_add, complementShear_rename_inr, Pi.add_apply, hP, add_assoc]

open scoped Classical in
def complementShear_zero [CommSemiring R] (P : MvPolynomial (B ⊕ C) R) :
    complementShear (0 : B → MvPolynomial C R) P = P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i <;> simp only [map_mul, complementShear_X_inl, complementShear_X_inr,
      Pi.zero_apply, map_zero, add_zero, hP]

open scoped Classical in
def complementShear_inverse [CommRing R] (g : B → MvPolynomial C R)
    (P : MvPolynomial (B ⊕ C) R) : complementShear (-g) (complementShear g P) = P := by
  rw [complementShear_comp, neg_add_cancel, complementShear_zero]

open scoped Classical in
def complementShear_injective [CommRing R] (g : B → MvPolynomial C R) :
    Function.Injective (complementShear g) := by
  intro P Q h
  have hh := congrArg (complementShear (-g)) h
  simpa only [complementShear_inverse] using hh

open scoped Classical in
def zeroVariable_rename_inr [CommSemiring R] (c : C) (P : MvPolynomial C R) :
    zeroVariable (Sum.inr c : B ⊕ C) (MvPolynomial.rename Sum.inr P) =
      MvPolynomial.rename Sum.inr (zeroVariable c P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [map_mul, MvPolynomial.rename_X, zeroVariable_X, Sum.inr.injEq, hP]
    split_ifs <;> simp only [map_zero, MvPolynomial.rename_X]

open scoped Classical in
def zeroVariable_complementShear [CommSemiring R] (g : B → MvPolynomial C R)
    (c : C) (P : MvPolynomial (B ⊕ C) R) :
    zeroVariable (Sum.inr c) (complementShear g P) =
      complementShear (fun b => zeroVariable c (g b)) (zeroVariable (Sum.inr c) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i with
    | inl b =>
      simp only [map_mul, complementShear_X_inl, map_add, zeroVariable_X,
        Sum.inl_ne_inr, if_false, zeroVariable_rename_inr, hP]
    | inr i =>
      simp only [map_mul, complementShear_X_inr, zeroVariable_X, Sum.inr.injEq, hP]
      split_ifs <;> simp only [map_zero, complementShear_X_inr]

/- The support order after the concrete inverse-form coordinate change. -/
open scoped Classical in
def complementHyperplaneIndex (w : B → ℕ) (g : B → MvPolynomial C ℚ)
    (P : MvPolynomial (B ⊕ C) ℚ) : ℕ∞ :=
  weightedPolynomialOrder (Sum.elim w (fun _ => 0)) (complementShear g P)

open scoped Classical in
def zeroVariable_map {S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (z : I) (P : MvPolynomial I R) :
    MvPolynomial.map f (zeroVariable z P) = zeroVariable z (MvPolynomial.map f P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [map_mul, MvPolynomial.map_X, zeroVariable_X, hP]
    split_ifs <;> simp only [map_zero, MvPolynomial.map_X]

open scoped Classical in
def zeroVariable_degreeOf_self [CommSemiring R] (z : I) (P : MvPolynomial I R) :
    (zeroVariable z P).degreeOf z = 0 := by
  apply Nat.eq_zero_of_le_zero
  apply MvPolynomial.degreeOf_le_iff.mpr
  intro e he
  rw [zeroVariable_eq_rename_specialization,
    MvPolynomial.support_rename_of_injective Subtype.val_injective] at he
  obtain ⟨d, _, rfl⟩ := Finset.mem_image.mp he
  apply Nat.le_zero.mpr
  apply Finsupp.mapDomain_of_not_mem_image_support
  rintro ⟨i, _, hi⟩
  exact i.property hi

open scoped Classical in
def complementHyperplaneIndex_saturation (w : B → ℕ)
    (g : B → MvPolynomial C ℚ) (c : C) (k : ℕ) (P : MvPolynomial (B ⊕ C) ℚ) :
    complementHyperplaneIndex w g (MvPolynomial.X (Sum.inr c) ^ k * P) =
      complementHyperplaneIndex w g P := by
  unfold complementHyperplaneIndex
  rw [map_mul, map_pow, complementShear_X_inr, weightedPolynomialOrder_mul,
    MvPolynomial.X_pow_eq_monomial, weightedPolynomialOrder_monomial_one]
  simp only [Finsupp.weight_single, Sum.elim_inr, smul_zero, Nat.cast_zero, zero_add]

open scoped Classical in
def complementHyperplaneIndex_specialization (w : B → ℕ)
    (g : B → MvPolynomial C ℚ) (c : C) (P : MvPolynomial (B ⊕ C) ℚ) :
    complementHyperplaneIndex w g P ≤
      complementHyperplaneIndex w (fun b => zeroVariable c (g b)) (zeroVariable (Sum.inr c) P) := by
  have hh := zeroVariable_order_le (Sum.elim w (fun _ => 0)) (Sum.inr c) (complementShear g P)
  rw [zeroVariable_complementShear] at hh
  exact hh

/- Fixed block degrees, expressed using the concrete weights of a block map. -/
open scoped Classical in
def MultiBlockHomogeneous {H : Type*} [CommSemiring R]
    (block : I → H) (r : H → ℕ) (P : MvPolynomial I R) : Prop :=
  ∀ h, MvPolynomial.IsWeightedHomogeneous (fun i => if block i = h then 1 else 0) P (r h)

open scoped Classical in
def weightedHomogeneous_divMonomial [CommSemiring R] (w : I → ℕ)
    (P : MvPolynomial I R) (n : ℕ) (hP : MvPolynomial.IsWeightedHomogeneous w P n)
    (s : I →₀ ℕ) :
    MvPolynomial.IsWeightedHomogeneous w (P.divMonomial s) (n - Finsupp.weight w s) := by
  intro e he
  rw [MvPolynomial.coeff_divMonomial] at he
  have hh := hP he
  rw [map_add] at hh
  omega

open scoped Classical in
def weightedHomogeneous_zeroVariable [CommSemiring R] (w : I → ℕ)
    (P : MvPolynomial I R) (n : ℕ) (hP : MvPolynomial.IsWeightedHomogeneous w P n)
    (z : I) : MvPolynomial.IsWeightedHomogeneous w (zeroVariable z P) n := by
  intro e he
  exact hP (MvPolynomial.mem_support_iff.mp
    (zeroVariable_support_subset z P (MvPolynomial.mem_support_iff.mpr he)))

/- An actual integer coefficient slice in a complementary variable preserves
nonzero, lowers block degrees, and cannot lower the concrete hyperplane index. -/
open scoped Classical in
def exists_integer_complement_specialization {H : Type*} [DecidableEq H]
    (block : B ⊕ C → H) (r : H → ℕ) (w : B → ℕ) (g : B → MvPolynomial C ℚ)
    (c : C) (P : MvPolynomial (B ⊕ C) ℤ) (hP : P ≠ 0) (hhom : MultiBlockHomogeneous block r P) :
    ∃ k : ℕ, ∃ Q : MvPolynomial (B ⊕ C) ℤ,
      Q = zeroVariable (Sum.inr c) (P.divMonomial (Finsupp.single (Sum.inr c) k)) ∧
      Q ≠ 0 ∧ Q.degreeOf (Sum.inr c) = 0 ∧
      (∀ i, Q.degreeOf i ≤ P.degreeOf i) ∧ polynomialCoeffL1 Q ≤ polynomialCoeffL1 P ∧
      MultiBlockHomogeneous block (fun h => r h - if block (Sum.inr c) = h then k else 0) Q ∧
      complementHyperplaneIndex w g (MvPolynomial.map (Int.castRingHom ℚ) P) ≤
        complementHyperplaneIndex w (fun b => zeroVariable c (g b))
          (MvPolynomial.map (Int.castRingHom ℚ) Q) := by
  classical
  obtain ⟨d, hd, hmin⟩ := P.support.exists_min_image (fun e => e (Sum.inr c))
    (MvPolynomial.support_nonempty.mpr hP)
  let k := d (Sum.inr c)
  let V := P.divMonomial (Finsupp.single (Sum.inr c) k)
  let Q := zeroVariable (Sum.inr c) V
  have hdiv : ∀ e ∈ P.support, Finsupp.single (Sum.inr c) k ≤ e := by
    intro e he
    exact Finsupp.single_le_iff.mpr (hmin e he)
  have hfactor : P = MvPolynomial.X (Sum.inr c) ^ k * V := by
    rw [MvPolynomial.X_pow_eq_monomial]
    exact (monomial_mul_divMonomial_of_support P _ hdiv).symm
  have hQ : Q ≠ 0 := by
    rw [show Q = MvPolynomial.rename Subtype.val (coordinateSlice (Sum.inr c) k P) from
      zeroVariable_eq_rename_specialization _ _]
    exact fun hz => (coordinateSlice_ne_zero_of_coeff (Sum.inr c) P
      (MvPolynomial.mem_support_iff.mp hd))
      ((MvPolynomial.rename_eq_zero_iff_of_injective _ Subtype.val_injective).mp hz)
  refine ⟨k, Q, rfl, hQ, zeroVariable_degreeOf_self _ _, ?_, ?_, ?_, ?_⟩
  · intro i
    exact (zeroVariable_degreeOf_le _ _ i).trans (degreeOf_divMonomial_le P _ i)
  · exact (zeroVariable_coeffL1_le _ V).trans (polynomialCoeffL1_divMonomial_le P _)
  · intro h
    have hh := weightedHomogeneous_zeroVariable _ V _
      (weightedHomogeneous_divMonomial _ P _ (hhom h) _) (Sum.inr c)
    simpa only [Finsupp.weight_single, smul_eq_mul, mul_ite, mul_one, mul_zero] using hh
  · have hh := complementHyperplaneIndex_specialization w g c
      (MvPolynomial.map (Int.castRingHom ℚ) V)
    have hf := congrArg (MvPolynomial.map (Int.castRingHom ℚ)) hfactor
    simp only [map_mul, map_pow, MvPolynomial.map_X] at hf
    rw [← zeroVariable_map] at hh
    rw [hf, complementHyperplaneIndex_saturation]
    exact hh


end
end Bounty

end SubmissionComponent_RationalHyperplaneIndex

/- Component BalancedMonomialCounting; SHA256 1707de2028969a92cf3881739d0bf662b6e44eb9bd72d62a885e0373addd8d6d -/
section SubmissionComponent_BalancedMonomialCounting
/- Exact finite second-moment counting for arrays of weak compositions. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def finite_product_mixed_sum_zero
    {I : Type*} [Fintype I] [DecidableEq I]
    {β : I → Type*} [∀ i, Fintype (β i)]
    (f : ∀ i, β i → ℝ) (hf : ∀ i, ∑ t, f i t = 0)
    {i j : I} (hij : i ≠ j) :
    ∑ x : ∀ i, β i, f i (x i) * f j (x j) = 0 := by
  classical
  have hji : j ≠ i := Ne.symm hij
  calc
    _ = ∑ y : β i × (∀ a : {a // a ≠ i}, β a),
        f i y.1 * f j (y.2 ⟨j, hji⟩) := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i β)
      intro x
      rfl
    _ = 0 := by
      rw [Fintype.sum_prod_type]
      simp_rw [← Finset.mul_sum]
      rw [← Finset.sum_mul, hf i, zero_mul]

def finite_product_second_moment
    {I : Type*} [Fintype I] [DecidableEq I]
    {β : I → Type*} [∀ i, Fintype (β i)]
    (f : ∀ i, β i → ℝ) (hf : ∀ i, ∑ t, f i t = 0) :
    (∑ x : ∀ i, β i, (∑ i, f i (x i)) ^ 2) =
      ∑ i, ∑ x : ∀ i, β i, (f i (x i)) ^ 2 := by
  classical
  simp_rw [pow_two, Fintype.sum_mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.sum_comm]
  rw [Finset.sum_eq_single i]
  · intro j _ hji
    exact finite_product_mixed_sum_zero f hf (Ne.symm hji)
  · simp

def finite_product_second_moment_le
    {I : Type*} [Fintype I] [DecidableEq I]
    {β : I → Type*} [∀ i, Fintype (β i)]
    (f : ∀ i, β i → ℝ) (hf : ∀ i, ∑ t, f i t = 0)
    (hbound : ∀ i t, (f i t) ^ 2 ≤ 1) :
    (∑ x : ∀ i, β i, (∑ i, f i (x i)) ^ 2) ≤
      (Fintype.card (∀ i, β i) : ℝ) * Fintype.card I := by
  rw [finite_product_second_moment f hf]
  calc
    _ ≤ ∑ _i : I, ∑ _x : ∀ i, β i, (1 : ℝ) := by
      exact Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun x _ => hbound i (x i)
    _ = _ := by simp [mul_comm]

abbrev WeakComposition (d r : ℕ) := ↥(Finset.Nat.antidiagonalTuple d r)

def weakComposition_sum {d r : ℕ} (v : WeakComposition d r) :
    ∑ i, v.val i = r := Finset.Nat.mem_antidiagonalTuple.mp v.property

def weakComposition_coord_le {d r : ℕ} (v : WeakComposition d r) (i : Fin d) :
    v.val i ≤ r := by
  exact (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)).trans_eq
    (weakComposition_sum v)

def weakCompositionPerm {d r : ℕ} (e : Equiv.Perm (Fin d)) :
    WeakComposition d r ≃ WeakComposition d r where
  toFun v := ⟨fun i => v.val (e i), Finset.Nat.mem_antidiagonalTuple.mpr
    ((Equiv.sum_comp e v.val).trans (weakComposition_sum v))⟩
  invFun v := ⟨fun i => v.val (e.symm i), Finset.Nat.mem_antidiagonalTuple.mpr
    ((Equiv.sum_comp e.symm v.val).trans (weakComposition_sum v))⟩
  left_inv v := by ext i; simp
  right_inv v := by ext i; simp

def weakComposition_coordinate_sum_eq {d r : ℕ} (i j : Fin d) :
    (∑ v : WeakComposition d r, (v.val i : ℝ)) =
      ∑ v : WeakComposition d r, (v.val j : ℝ) := by
  classical
  apply Fintype.sum_equiv (weakCompositionPerm (r := r) (Equiv.swap i j))
  intro v
  simp [weakCompositionPerm]

def weakComposition_coordinate_sum {d r : ℕ} (i : Fin d) :
    (d : ℝ) * (∑ v : WeakComposition d r, (v.val i : ℝ)) =
      (Fintype.card (WeakComposition d r) : ℝ) * r := by
  calc
    _ = ∑ j : Fin d, ∑ v : WeakComposition d r, (v.val j : ℝ) := by
      simp_rw [← weakComposition_coordinate_sum_eq i]
      simp
    _ = ∑ v : WeakComposition d r, ∑ j : Fin d, (v.val j : ℝ) :=
      Finset.sum_comm
    _ = _ := by
      simp_rw [← Nat.cast_sum, weakComposition_sum]
      simp

def compositionCentered {d r : ℕ} (i : Fin d) (v : WeakComposition d r) : ℝ :=
  (v.val i : ℝ) / r - 1 / d

def compositionCentered_sum {d r : ℕ} (hd : 0 < d) (hr : 0 < r) (i : Fin d) :
    ∑ v : WeakComposition d r, compositionCentered i v = 0 := by
  have hd0 : (d : ℝ) ≠ 0 := by positivity
  have hr0 : (r : ℝ) ≠ 0 := by positivity
  have hs := weakComposition_coordinate_sum (r := r) i
  simp only [compositionCentered, Finset.sum_sub_distrib, ← Finset.sum_div,
    Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  field_simp
  nlinarith

def compositionCentered_sq_le_one {d r : ℕ} (hd : 0 < d) (hr : 0 < r)
    (i : Fin d) (v : WeakComposition d r) : (compositionCentered i v) ^ 2 ≤ 1 := by
  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hr0 : (0 : ℝ) < r := by positivity
  have hc0 : (0 : ℝ) ≤ v.val i := by positivity
  have hc1 : (v.val i : ℝ) ≤ r := by exact_mod_cast weakComposition_coord_le v i
  have hq0 : (0 : ℝ) ≤ (v.val i : ℝ) / r := div_nonneg hc0 (le_of_lt hr0)
  have hq1 : (v.val i : ℝ) / r ≤ 1 := (div_le_one hr0).mpr hc1
  have hz0 : (0 : ℝ) ≤ 1 / d := by positivity
  have hz1 : (1 : ℝ) / d ≤ 1 := (div_le_one (by positivity)).mpr hd1
  dsimp [compositionCentered]
  nlinarith [mul_nonneg (sub_nonneg.mpr hq1) hq0,
    mul_nonneg (sub_nonneg.mpr hz1) hz0]

abbrev CompositionArray (m d : ℕ) (r : Fin m → ℕ) :=
  ∀ h : Fin m, WeakComposition d (r h)

def compositionArray_nonempty {m d : ℕ} (r : Fin m → ℕ) (hd : 0 < d) :
    Nonempty (CompositionArray m d r) := by
  classical
  refine ⟨fun h => ⟨fun i => if i = (⟨0, hd⟩ : Fin d) then r h else 0, ?_⟩⟩
  apply Finset.Nat.mem_antidiagonalTuple.mpr
  simp

def compositionArray_card_pos {m d : ℕ} (r : Fin m → ℕ) (hd : 0 < d) :
    0 < Fintype.card (CompositionArray m d r) :=
  Fintype.card_pos_iff.mpr (compositionArray_nonempty r hd)

def compositionDeviation {m d : ℕ} {r : Fin m → ℕ}
    (i : Fin d) (J : CompositionArray m d r) : ℝ :=
  (∑ h, ((J h).val i : ℝ) / r h) - (m : ℝ) / d

def compositionDeviation_eq_sum {m d : ℕ} {r : Fin m → ℕ}
    (i : Fin d) (J : CompositionArray m d r) :
    compositionDeviation i J = ∑ h, compositionCentered i (J h) := by
  simp [compositionDeviation, compositionCentered, Finset.sum_sub_distrib, div_eq_mul_inv]

def compositionArray_second_moment {m d : ℕ} (r : Fin m → ℕ)
    (hd : 0 < d) (hr : ∀ h, 0 < r h) (i : Fin d) :
    (∑ J : CompositionArray m d r, (compositionDeviation i J) ^ 2) ≤
      (Fintype.card (CompositionArray m d r) : ℝ) * m := by
  simp_rw [compositionDeviation_eq_sum]
  simpa using finite_product_second_moment_le
    (fun h (v : WeakComposition d (r h)) => compositionCentered i v)
    (fun h => compositionCentered_sum hd (hr h) i)
    (fun h => compositionCentered_sq_le_one hd (hr h) i)

def finite_bad_card_sq_le {Ω : Type*} [Fintype Ω]
    (f : Ω → ℝ) (a : ℝ) (ha : 0 ≤ a) :
    ((Finset.univ.filter (fun x => a ≤ |f x|)).card : ℝ) * a ^ 2 ≤
      ∑ x, (f x) ^ 2 := by
  classical
  calc
    _ = ∑ _x ∈ Finset.univ.filter (fun x => a ≤ |f x|), a ^ 2 := by simp
    _ ≤ ∑ x ∈ Finset.univ.filter (fun x => a ≤ |f x|), (f x) ^ 2 := by
      apply Finset.sum_le_sum
      intro x hx
      have hx' := (Finset.mem_filter.mp hx).2
      nlinarith [sq_abs (f x), mul_nonneg (sub_nonneg.mpr hx') (add_nonneg (abs_nonneg (f x)) ha)]
    _ ≤ ∑ x, (f x) ^ 2 :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        (fun x _ _ => sq_nonneg (f x))

def badCompositionCoordinate {m d : ℕ} (r : Fin m → ℕ) (η : ℝ) (i : Fin d) :
    Finset (CompositionArray m d r) := by
  classical
  exact Finset.univ.filter (fun J => (m : ℝ) * η ≤ |compositionDeviation i J|)

def badCompositionCoordinate_card_bound {m d : ℕ} (r : Fin m → ℕ)
    (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (η : ℝ) (hη : 0 ≤ η) (i : Fin d) :
    ((badCompositionCoordinate r η i).card : ℝ) * m * η ^ 2 ≤
      Fintype.card (CompositionArray m d r) := by
  have hm' : (0 : ℝ) < m := by positivity
  have hfirst := finite_bad_card_sq_le (compositionDeviation (r := r) i)
    ((m : ℝ) * η) (mul_nonneg (le_of_lt hm') hη)
  have hsecond := compositionArray_second_moment r hd hr i
  change ((badCompositionCoordinate r η i).card : ℝ) * ((m : ℝ) * η) ^ 2 ≤ _ at hfirst
  have hle : (m : ℝ) * (((badCompositionCoordinate r η i).card : ℝ) * m * η ^ 2) ≤
      (m : ℝ) * Fintype.card (CompositionArray m d r) := by nlinarith
  exact (mul_le_mul_iff_right₀ hm').mp hle

def badCompositionArrays {m d : ℕ} (r : Fin m → ℕ) (η : ℝ) :
    Finset (CompositionArray m d r) := by
  classical
  exact Finset.univ.biUnion (badCompositionCoordinate r η)

def mem_badCompositionArrays {m d : ℕ} (r : Fin m → ℕ) (η : ℝ)
    (J : CompositionArray m d r) :
    J ∈ badCompositionArrays r η ↔
      ∃ i : Fin d, (m : ℝ) * η ≤ |compositionDeviation i J| := by
  classical
  simp [badCompositionArrays, badCompositionCoordinate]

def not_mem_badCompositionArrays {m d : ℕ} (r : Fin m → ℕ) (η : ℝ)
    (J : CompositionArray m d r) :
    J ∉ badCompositionArrays r η ↔
      ∀ i : Fin d, |compositionDeviation i J| < (m : ℝ) * η := by
  rw [mem_badCompositionArrays]
  simp

def badCompositionArrays_card_bound {m d : ℕ} (r : Fin m → ℕ)
    (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (η : ℝ) (hη : 0 ≤ η) :
    ((badCompositionArrays (d := d) r η).card : ℝ) * m * η ^ 2 ≤
      (d : ℝ) * Fintype.card (CompositionArray m d r) := by
  classical
  have hu : (badCompositionArrays (d := d) r η).card ≤
      ∑ i : Fin d, (badCompositionCoordinate r η i).card := Finset.card_biUnion_le
  have hu' : ((badCompositionArrays (d := d) r η).card : ℝ) ≤
      ∑ i : Fin d, ((badCompositionCoordinate r η i).card : ℝ) := by exact_mod_cast hu
  calc
    _ = ((badCompositionArrays (d := d) r η).card : ℝ) * ((m : ℝ) * η ^ 2) := by ring
    _ ≤ (∑ i : Fin d, ((badCompositionCoordinate r η i).card : ℝ)) *
        ((m : ℝ) * η ^ 2) := mul_le_mul_of_nonneg_right hu' (by positivity)
    _ = ∑ i : Fin d, ((badCompositionCoordinate r η i).card : ℝ) * m * η ^ 2 := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ ≤ ∑ _i : Fin d, (Fintype.card (CompositionArray m d r) : ℝ) :=
      Finset.sum_le_sum fun i _ => badCompositionCoordinate_card_bound r hm hd hr η hη i
    _ = _ := by simp

def badCompositionArrays_quarter {m d : ℕ} (r : Fin m → ℕ)
    (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (s : ℕ) (η : ℝ) (hη : 0 ≤ η)
    (hlarge : 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2) :
    4 * (s * (badCompositionArrays (d := d) r η).card) ≤ Fintype.card (CompositionArray m d r) := by
  have hd' : (0 : ℝ) < d := by positivity
  have hbound := badCompositionArrays_card_bound r hm hd hr η hη
  have hle : (d : ℝ) * (4 * (s : ℝ) * (badCompositionArrays (d := d) r η).card) ≤
      (d : ℝ) * Fintype.card (CompositionArray m d r) := by
    calc
      _ = ((badCompositionArrays (d := d) r η).card : ℝ) * (4 * (s : ℝ) * d) := by ring
      _ ≤ ((badCompositionArrays (d := d) r η).card : ℝ) * ((m : ℝ) * η ^ 2) :=
        mul_le_mul_of_nonneg_left hlarge (by positivity)
      _ ≤ _ := by simpa [mul_assoc] using hbound
  have hle' := (mul_le_mul_iff_right₀ hd').mp hle
  rw [← mul_assoc]
  exact_mod_cast hle'


end
end Bounty

end SubmissionComponent_BalancedMonomialCounting

/- Component IntegerSmallKernel; SHA256 dee44ae4bf41e5bc51f97b9207be460928d6ffd0421111822775745ee89dc436 -/
section SubmissionComponent_IntegerSmallKernel
/- A coefficient-sum form of the integer small-kernel lemma for at most half as many equations. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Matrix

def exists_integer_small_kernel {I J : Type*} [Fintype I] [Fintype J]
    (A : Matrix I J ℤ) (hN : 0 < Fintype.card J)
    (hhalf : 2 * Fintype.card I ≤ Fintype.card J)
    (H : ℝ) (hH : 1 ≤ H) (hentry : ∀ i j, ‖A i j‖ ≤ H) :
    ∃ c : J → ℤ, c ≠ 0 ∧ A *ᵥ c = 0 ∧
      (∀ j, ‖c j‖ ≤ Fintype.card J * H) ∧
      (∑ j, ‖c j‖) ≤ (Fintype.card J : ℝ) ^ 2 * H := by
  classical
  letI : SeminormedAddCommGroup (Matrix I J ℤ) := Matrix.seminormedAddCommGroup
  have hNreal : (1 : ℝ) ≤ Fintype.card J := by exact_mod_cast hN
  have hprod : 1 ≤ (Fintype.card J : ℝ) * H := one_le_mul_of_one_le_of_one_le hNreal hH
  suffices hh : ∃ c : J → ℤ, c ≠ 0 ∧ A *ᵥ c = 0 ∧
      (∀ j, ‖c j‖ ≤ Fintype.card J * H) by
    obtain ⟨c, hc, hAc, hbound⟩ := hh
    refine ⟨c, hc, hAc, hbound, ?_⟩
    calc
      ∑ j, ‖c j‖ ≤ ∑ _j : J, (Fintype.card J : ℝ) * H := Finset.sum_le_sum (fun j _ => hbound j)
      _ = (Fintype.card J : ℝ) ^ 2 * H := by simp; ring
  by_cases hm : 0 < Fintype.card I
  · have hlt : Fintype.card I < Fintype.card J := by omega
    obtain ⟨c, hc, hAc, hnorm⟩ := Int.Matrix.exists_ne_zero_int_vec_norm_le A hlt hm
    have hAnorm : ‖A‖ ≤ H := (Matrix.norm_le_iff (by linarith : 0 ≤ H)).mpr hentry
    have hb : 1 ≤ (Fintype.card J : ℝ) * max 1 ‖A‖ :=
      one_le_mul_of_one_le_of_one_le hNreal (le_max_left _ _)
    have hden : (0 : ℝ) < Fintype.card J - Fintype.card I :=
      sub_pos.mpr (by exact_mod_cast hlt)
    have he : (Fintype.card I : ℝ) / (Fintype.card J - Fintype.card I) ≤ 1 := by
      apply (div_le_one hden).mpr
      have hh : 2 * (Fintype.card I : ℝ) ≤ Fintype.card J := by exact_mod_cast hhalf
      linarith
    have hp := Real.rpow_le_rpow_of_exponent_le hb he
    rw [Real.rpow_one] at hp
    have hsmall : ‖c‖ ≤ (Fintype.card J : ℝ) * H := hnorm.trans (hp.trans
      (mul_le_mul_of_nonneg_left (max_le hH hAnorm) (Nat.cast_nonneg _)))
    exact ⟨c, hc, hAc, fun j => (norm_le_pi_norm c j).trans hsmall⟩
  · have hz : Fintype.card I = 0 := by omega
    letI : IsEmpty I := Fintype.card_eq_zero_iff.mp hz
    obtain ⟨j⟩ := Fintype.card_pos_iff.mp hN
    refine ⟨fun _ => 1, ?_, ?_, ?_⟩
    · intro h
      have hh := congrFun h j
      norm_num at hh
    · ext i
      exact isEmptyElim i
    · intro j
      simpa using hprod


end
end Bounty

end SubmissionComponent_IntegerSmallKernel

/- Component AuxiliaryPolynomialKernel; SHA256 e77ff86c8268168d08db3f0094d85f28f661f36ccecc2760f58166b6114ff002 -/
section SubmissionComponent_AuxiliaryPolynomialKernel
/- Actual nonzero integer polynomials satisfying finitely many small linear conditions. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Matrix

def indexedIntegerPolynomial {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (c : J → ℤ) : MvPolynomial V ℤ :=
  ∑ j, MvPolynomial.monomial (e j) (c j)

def indexedIntegerPolynomial_coeff {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (he : Function.Injective e) (c : J → ℤ) (j : J) :
    MvPolynomial.coeff (e j) (indexedIntegerPolynomial e c) = c j := by
  classical
  simp only [indexedIntegerPolynomial, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
  rw [Finset.sum_eq_single j]
  · simp
  · intro k _ hk
    rw [if_neg (fun h => hk (he h))]
  · simp

def indexedIntegerPolynomial_ne_zero {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (he : Function.Injective e) {c : J → ℤ} (hc : c ≠ 0) :
    indexedIntegerPolynomial e c ≠ 0 := by
  intro hz
  apply hc
  funext j
  have hh := indexedIntegerPolynomial_coeff e he c j
  simpa only [hz, MvPolynomial.coeff_zero, Pi.zero_apply] using hh.symm

def indexedIntegerPolynomial_support {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (c : J → ℤ) {a : V →₀ ℕ}
    (ha : a ∈ (indexedIntegerPolynomial e c).support) : ∃ j, e j = a := by
  classical
  by_contra hh
  push Not at hh
  apply MvPolynomial.mem_support_iff.mp ha
  simp only [indexedIntegerPolynomial, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
  exact Finset.sum_eq_zero (fun j _ => if_neg (hh j))

def indexedIntegerPolynomial_norm_le {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (c : J → ℤ) :
    polynomialCoeffL1 (indexedIntegerPolynomial e c) ≤ ∑ j, ‖c j‖ := by
  simpa only [indexedIntegerPolynomial, polynomialCoeffL1_monomial] using
    polynomialCoeffL1_sum Finset.univ (fun j => MvPolynomial.monomial (e j) (c j))

def indexedIntegerPolynomial_linearMap {V J : Type*} [Fintype J]
    (e : J → V →₀ ℕ) (c : J → ℤ) (F : MvPolynomial V ℤ →ₗ[ℤ] ℤ) :
    F (indexedIntegerPolynomial e c) = ∑ j, F (MvPolynomial.monomial (e j) 1) * c j := by
  simp only [indexedIntegerPolynomial, map_sum]
  apply Finset.sum_congr rfl
  intro j _
  have hh : MvPolynomial.monomial (e j) (c j) = c j • MvPolynomial.monomial (e j) (1 : ℤ) := by
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [hh, map_smul, smul_eq_mul, mul_comm]

def exists_small_integer_auxiliary_polynomial {V I J : Type*} [Fintype I] [Fintype J]
    (e : J → V →₀ ℕ) (he : Function.Injective e)
    (F : I → MvPolynomial V ℤ →ₗ[ℤ] ℤ)
    (hN : 0 < Fintype.card J) (hhalf : 2 * Fintype.card I ≤ Fintype.card J)
    (H : ℝ) (hH : 1 ≤ H)
    (hentry : ∀ i j, ‖F i (MvPolynomial.monomial (e j) 1)‖ ≤ H) :
    ∃ P : MvPolynomial V ℤ, P ≠ 0 ∧
      (∀ a ∈ P.support, ∃ j, e j = a) ∧ (∀ i, F i P = 0) ∧
      polynomialCoeffL1 P ≤ (Fintype.card J : ℝ) ^ 2 * H := by
  let A : Matrix I J ℤ := fun i j => F i (MvPolynomial.monomial (e j) 1)
  obtain ⟨c, hc, hAc, _, hsum⟩ := exists_integer_small_kernel A hN hhalf H hH hentry
  refine ⟨indexedIntegerPolynomial e c, indexedIntegerPolynomial_ne_zero e he hc,
    fun a ha => indexedIntegerPolynomial_support e c ha, ?_,
    (indexedIntegerPolynomial_norm_le e c).trans hsum⟩
  intro i
  rw [indexedIntegerPolynomial_linearMap]
  exact congrFun hAc i


end
end Bounty

end SubmissionComponent_AuxiliaryPolynomialKernel

/- Component PolynomialSubstitutionNorm; SHA256 4c5a98171eb2c58a8019c0dc230dcb91d61ed6b85677e9d608c4db125718ef9d -/
section SubmissionComponent_PolynomialSubstitutionNorm
/- Explicit coefficient-sum bounds for substituted monomials. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def polynomialCoeffL1_pow {V R : Type*} [NormedCommRing R] [NormOneClass R]
    (P : MvPolynomial V R) (n : ℕ) : polynomialCoeffL1 (P ^ n) ≤ polynomialCoeffL1 P ^ n := by
  induction n with
  | zero => simp [polynomialCoeffL1_one]
  | succ n ih =>
    rw [pow_succ, pow_succ]
    exact (polynomialCoeffL1_mul _ _).trans
      (mul_le_mul_of_nonneg_right ih (polynomialCoeffL1_nonneg P))

def polynomialCoeffL1_aeval_monomial_one {I V : Type*} [Fintype I]
    (f : I → MvPolynomial V ℤ) (e : I →₀ ℕ) {C : ℝ}
    (hC : 0 ≤ C) (hf : ∀ i, polynomialCoeffL1 (f i) ≤ C) :
    polynomialCoeffL1 (MvPolynomial.aeval f (MvPolynomial.monomial e (1 : ℤ))) ≤
      C ^ (∑ i, e i) := by
  classical
  rw [MvPolynomial.aeval_monomial]
  simp only [map_one, one_mul]
  rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  calc
    _ ≤ ∏ i, polynomialCoeffL1 (f i ^ e i) := polynomialCoeffL1_prod _ _
    _ ≤ ∏ i, polynomialCoeffL1 (f i) ^ e i :=
      Finset.prod_le_prod (fun i _ => polynomialCoeffL1_nonneg _) (fun i _ => polynomialCoeffL1_pow _ _)
    _ ≤ ∏ i, C ^ e i := Finset.prod_le_prod
      (fun i _ => pow_nonneg (polynomialCoeffL1_nonneg _) _)
      (fun i _ => pow_le_pow_left₀ (polynomialCoeffL1_nonneg _) (hf i) _)
    _ = C ^ (∑ i, e i) := Finset.prod_pow_eq_pow_sum _ _ _

def norm_coeff_aeval_monomial_one_le {I V : Type*} [Fintype I]
    (f : I → MvPolynomial V ℤ) (e : I →₀ ℕ) (a : V →₀ ℕ) {C : ℝ}
    (hC : 0 ≤ C) (hf : ∀ i, polynomialCoeffL1 (f i) ≤ C) :
    ‖MvPolynomial.coeff a (MvPolynomial.aeval f (MvPolynomial.monomial e (1 : ℤ)))‖ ≤
      C ^ (∑ i, e i) :=
  (norm_coeff_le_polynomialCoeffL1 _ _).trans (polynomialCoeffL1_aeval_monomial_one f e hC hf)

end
end Bounty

end SubmissionComponent_PolynomialSubstitutionNorm

/- Component BalancedAuxiliaryPolynomial; SHA256 dc164d0e99dfddc7eb1bef11f7577aca766e3616652c14a4928dddc2d32310e0 -/
section SubmissionComponent_BalancedAuxiliaryPolynomial
/- An actual nonzero integer auxiliary polynomial with balanced monomial
support after finitely many integer changes of coordinates within blocks. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def compositionExponent {m d : ℕ} {r : Fin m → ℕ}
    (J : CompositionArray m d r) : (Fin m × Fin d) →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun x => (J x.1).val x.2)

def compositionExponent_apply {m d : ℕ} {r : Fin m → ℕ}
    (J : CompositionArray m d r) (h : Fin m) (i : Fin d) :
    compositionExponent J (h, i) = (J h).val i := rfl

def compositionExponent_injective {m d : ℕ} (r : Fin m → ℕ) :
    Function.Injective (compositionExponent (m := m) (d := d) (r := r)) := by
  intro J K hJK
  funext h
  apply Subtype.ext
  funext i
  exact congrArg (fun e : (Fin m × Fin d) →₀ ℕ => e (h, i)) hJK

def compositionExponent_block_sum {m d : ℕ} {r : Fin m → ℕ}
    (J : CompositionArray m d r) (h : Fin m) :
    ∑ i, compositionExponent J (h, i) = r h := weakComposition_sum (J h)

def compositionExponent_total {m d : ℕ} {r : Fin m → ℕ}
    (J : CompositionArray m d r) :
    ∑ x : Fin m × Fin d, compositionExponent J x = ∑ h, r h := by
  rw [Fintype.sum_prod_type]
  simp_rw [compositionExponent_block_sum]

def exists_compositionExponent_iff {m d : ℕ} (r : Fin m → ℕ)
    (e : (Fin m × Fin d) →₀ ℕ) :
    (∃ J : CompositionArray m d r, compositionExponent J = e) ↔
      ∀ h, ∑ i, e (h, i) = r h := by
  constructor
  · rintro ⟨J, rfl⟩
    exact compositionExponent_block_sum J
  · intro he
    refine ⟨fun h => ⟨fun i => e (h, i), Finset.Nat.mem_antidiagonalTuple.mpr (he h)⟩, ?_⟩
    ext x
    rfl

def ProductBlockHomogeneous {m d : ℕ} {R : Type*} [CommSemiring R]
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) R) : Prop :=
  ∀ e ∈ P.support, ∀ h, ∑ i, e (h, i) = r h

def productBlockWeight {m d : ℕ} (h : Fin m) (x : Fin m × Fin d) : ℕ :=
  if x.1 = h then 1 else 0

def productBlockWeight_apply {m d : ℕ} (h : Fin m)
    (e : (Fin m × Fin d) →₀ ℕ) :
    Finsupp.weight (productBlockWeight h) e = ∑ i, e (h, i) := by
  rw [Finsupp.weight_eq_sum, Fintype.sum_prod_type]
  simp [productBlockWeight]

def productBlockHomogeneous_iff_weighted {m d : ℕ} {R : Type*} [CommSemiring R]
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) R) :
    ProductBlockHomogeneous r P ↔
      ∀ h, MvPolynomial.IsWeightedHomogeneous (productBlockWeight h) P (r h) := by
  constructor
  · intro hP h e he
    rw [productBlockWeight_apply]
    exact hP e (MvPolynomial.mem_support_iff.mpr he) h
  · intro hP e he h
    simpa only [productBlockWeight_apply] using hP h (MvPolynomial.mem_support_iff.mp he)

def blockLinearForm {m d : ℕ} (A : Fin m → Fin d → Fin d → ℤ)
    (x : Fin m × Fin d) : MvPolynomial (Fin m × Fin d) ℤ :=
  ∑ j, MvPolynomial.C (A x.1 x.2 j) * MvPolynomial.X (x.1, j)

def blockLinearSubstitution {m d : ℕ} (A : Fin m → Fin d → Fin d → ℤ) :
    MvPolynomial (Fin m × Fin d) ℤ →ₐ[ℤ] MvPolynomial (Fin m × Fin d) ℤ :=
  MvPolynomial.aeval (blockLinearForm A)

def blockLinearForm_homogeneous {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℤ) (h : Fin m) (x : Fin m × Fin d) :
    MvPolynomial.IsWeightedHomogeneous (productBlockWeight h)
      (blockLinearForm A x) (productBlockWeight h x) := by
  apply MvPolynomial.IsWeightedHomogeneous.sum
  intro j _
  exact (MvPolynomial.isWeightedHomogeneous_X ℤ (productBlockWeight h) (x.1, j)).C_mul _

def blockLinearSubstitution_homogeneous {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℤ) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℤ) (hP : ProductBlockHomogeneous r P) :
    ProductBlockHomogeneous r (blockLinearSubstitution A P) := by
  apply (productBlockHomogeneous_iff_weighted r _).mpr
  intro h
  exact weightedHomogeneous_aeval (productBlockWeight h) (blockLinearForm A)
    (blockLinearForm_homogeneous A h) P (r h)
    ((productBlockHomogeneous_iff_weighted r P).mp hP h)

def blockLinearForm_norm_le {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℤ) (x : Fin m × Fin d) :
    polynomialCoeffL1 (blockLinearForm A x) ≤ ∑ j, ‖A x.1 x.2 j‖ := by
  calc
    _ ≤ ∑ j, polynomialCoeffL1
        (MvPolynomial.C (A x.1 x.2 j) * MvPolynomial.X (x.1, j)) :=
      polynomialCoeffL1_sum _ _
    _ = _ := by
      apply Finset.sum_congr rfl
      intro j _
      rw [MvPolynomial.C_mul_X_eq_monomial, polynomialCoeffL1_monomial]

def balancedCoefficientCondition {m d s : ℕ} (r : Fin m → ℕ) (η : ℝ)
    (A : Fin s → Fin m → Fin d → Fin d → ℤ)
    (z : Fin s × ↥(badCompositionArrays (d := d) r η)) :
    MvPolynomial (Fin m × Fin d) ℤ →ₗ[ℤ] ℤ :=
  (MvPolynomial.lcoeff ℤ (compositionExponent z.2.val)).comp
    (blockLinearSubstitution (A z.1)).toLinearMap

def exists_balanced_integer_auxiliary_of_bound {m d s : ℕ}
    (r : Fin m → ℕ) (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (η : ℝ) (hη : 0 ≤ η) (hlarge : 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2)
    (A : Fin s → Fin m → Fin d → Fin d → ℤ)
    (H : ℝ) (hH : 1 ≤ H)
    (hentry : ∀ v (J K : CompositionArray m d r),
      ‖MvPolynomial.coeff (compositionExponent K)
        (blockLinearSubstitution (A v) (MvPolynomial.monomial (compositionExponent J) 1))‖ ≤ H) :
    ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧
      ProductBlockHomogeneous r P ∧
      polynomialCoeffL1 P ≤ (Fintype.card (CompositionArray m d r) : ℝ) ^ 2 * H ∧
      ∀ v e, MvPolynomial.coeff e (blockLinearSubstitution (A v) P) ≠ 0 →
        (∀ h, ∑ i, e (h, i) = r h) ∧
        ∀ i : Fin d, |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < (m : ℝ) * η := by
  classical
  let I := Fin s × ↥(badCompositionArrays (d := d) r η)
  have hquarter := badCompositionArrays_quarter r hm hd hr s η hη hlarge
  have hhalf : 2 * Fintype.card I ≤ Fintype.card (CompositionArray m d r) := by
    have hcard : Fintype.card I = s * (badCompositionArrays (d := d) r η).card := by
      simp [I]
    rw [hcard]
    omega
  obtain ⟨P, hP, hsupp, hzero, hnorm⟩ := exists_small_integer_auxiliary_polynomial
    (compositionExponent (d := d) (r := r)) (compositionExponent_injective r)
    (balancedCoefficientCondition r η A) (compositionArray_card_pos r hd) hhalf H hH
    (fun z J => hentry z.1 J z.2.val)
  have hhom : ProductBlockHomogeneous r P := by
    intro e he
    obtain ⟨J, rfl⟩ := hsupp e he
    exact compositionExponent_block_sum J
  refine ⟨P, hP, hhom, hnorm, ?_⟩
  intro v e he
  have hehom := blockLinearSubstitution_homogeneous (A v) r P hhom e
    (MvPolynomial.mem_support_iff.mpr he)
  obtain ⟨J, hJ⟩ := (exists_compositionExponent_iff r e).mpr hehom
  have hgood : J ∉ badCompositionArrays r η := by
    intro hbad
    have hh := hzero (v, ⟨J, hbad⟩)
    change MvPolynomial.coeff (compositionExponent J) (blockLinearSubstitution (A v) P) = 0 at hh
    rw [hJ] at hh
    exact he hh
  refine ⟨hehom, ?_⟩
  intro i
  have hh := (not_mem_badCompositionArrays r η J).mp hgood i
  simpa only [compositionDeviation, ← hJ, compositionExponent_apply] using hh

def exists_balanced_integer_auxiliary {m d s : ℕ}
    (r : Fin m → ℕ) (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (η : ℝ) (hη : 0 ≤ η) (hlarge : 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2)
    (A : Fin s → Fin m → Fin d → Fin d → ℤ)
    (C : ℝ) (hC : 1 ≤ C) (hA : ∀ v h i, ∑ j, ‖A v h i j‖ ≤ C) :
    ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧
      ProductBlockHomogeneous r P ∧
      polynomialCoeffL1 P ≤ (Fintype.card (CompositionArray m d r) : ℝ) ^ 2 * C ^ (∑ h, r h) ∧
      ∀ v e, MvPolynomial.coeff e (blockLinearSubstitution (A v) P) ≠ 0 →
        (∀ h, ∑ i, e (h, i) = r h) ∧
        ∀ i : Fin d, |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < (m : ℝ) * η := by
  apply exists_balanced_integer_auxiliary_of_bound r hm hd hr η hη hlarge A
    (C ^ (∑ h, r h)) (one_le_pow₀ hC)
  intro v J K
  have hf : ∀ x, polynomialCoeffL1 (blockLinearForm (A v) x) ≤ C :=
    fun x => (blockLinearForm_norm_le (A v) x).trans (hA v x.1 x.2)
  simpa only [blockLinearSubstitution, compositionExponent_total] using
    norm_coeff_aeval_monomial_one_le (blockLinearForm (A v))
      (compositionExponent J) (compositionExponent K) (le_trans zero_le_one hC) hf


end
end Bounty

end SubmissionComponent_BalancedAuxiliaryPolynomial

/- Component HyperplaneCoordinateReindex; SHA256 0a0ae811d41f0b1e2e300e28f74678fee5ed456f40fe1deaf029723cb9df13a8 -/
section SubmissionComponent_HyperplaneCoordinateReindex
/- Explicit pivot/complement coordinates for block rational hyperplanes. -/

namespace Bounty
noncomputable section
open scoped BigOperators

abbrev HyperplaneComplement {m d : ℕ} (p : Fin m → Fin (d + 1)) :=
  {x : Fin m × Fin (d + 1) // x.2 ≠ p x.1}

def hyperplanePivotEquiv {m d : ℕ} (p : Fin m → Fin (d + 1)) :
    (Fin m × Fin (d + 1)) ≃ Fin m ⊕ HyperplaneComplement p where
  toFun x := if h : x.2 = p x.1 then Sum.inl x.1 else Sum.inr ⟨x, h⟩
  invFun := Sum.elim (fun h => (h, p h)) Subtype.val
  left_inv := by
    intro x
    dsimp
    split_ifs with hx
    · exact Prod.ext rfl hx.symm
    · rfl
  right_inv := by
    intro x
    cases x with
    | inl h =>
      change (if h' : p h = p h then Sum.inl h else Sum.inr (⟨(h, p h), h'⟩ : HyperplaneComplement p)) = Sum.inl h
      rw [dif_pos rfl]
    | inr x =>
      change (if h : x.val.2 = p x.val.1 then Sum.inl x.val.1 else Sum.inr (⟨x.val, h⟩ : HyperplaneComplement p)) = Sum.inr x
      rw [dif_neg x.property]

def hyperplanePivotEquiv_pivot {m d : ℕ} (p : Fin m → Fin (d + 1)) (h : Fin m) :
    hyperplanePivotEquiv p (h, p h) = Sum.inl h := by simp [hyperplanePivotEquiv]

def hyperplanePivotEquiv_complement {m d : ℕ} (p : Fin m → Fin (d + 1))
    (x : HyperplaneComplement p) : hyperplanePivotEquiv p x.val = Sum.inr x := by
  change (if h : x.val.2 = p x.val.1 then Sum.inl x.val.1 else Sum.inr (⟨x.val, h⟩ : HyperplaneComplement p)) = Sum.inr x
  rw [dif_neg x.property]

def hyperplaneCoordinateBlock {m d : ℕ} (p : Fin m → Fin (d + 1)) :
    Fin m ⊕ HyperplaneComplement p → Fin m := Sum.elim id (fun x => x.val.1)

def hyperplaneCoordinateBlock_pivotEquiv {m d : ℕ}
    (p : Fin m → Fin (d + 1)) (x : Fin m × Fin (d + 1)) :
    hyperplaneCoordinateBlock p (hyperplanePivotEquiv p x) = x.1 := by
  simp only [hyperplanePivotEquiv, Equiv.coe_fn_mk]
  split_ifs <;> rfl

def multiBlockHomogeneous_rename {I J H R : Type*} [CommSemiring R]
    [DecidableEq H] (f : I → J) (hf : Function.Injective f) (block : J → H)
    (r : H → ℕ) (P : MvPolynomial I R)
    (hP : MultiBlockHomogeneous (block ∘ f) r P) :
    MultiBlockHomogeneous block r (MvPolynomial.rename f P) := by
  classical
  intro h e he
  have he' := MvPolynomial.mem_support_iff.mpr he
  rw [MvPolynomial.support_rename_of_injective hf] at he'
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp he'
  rw [specialization_weight_mapDomain]
  exact hP h (MvPolynomial.mem_support_iff.mp ha)

def productBlockHomogeneous_pivotRename {m d : ℕ} {R : Type*} [CommSemiring R]
    (p : Fin m → Fin (d + 1)) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin (d + 1)) R) (hP : ProductBlockHomogeneous r P) :
    MultiBlockHomogeneous (hyperplaneCoordinateBlock p) r
      (MvPolynomial.rename (hyperplanePivotEquiv p) P) := by
  apply multiBlockHomogeneous_rename _ (hyperplanePivotEquiv p).injective
  intro h e he
  rw [Finsupp.weight_eq_sum, Fintype.sum_prod_type]
  simpa [Function.comp, hyperplaneCoordinateBlock_pivotEquiv] using hP e (MvPolynomial.mem_support_iff.mpr he) h

def pivotRename_coeffL1 {m d : ℕ} {R : Type*} [NormedCommRing R]
    (p : Fin m → Fin (d + 1)) (P : MvPolynomial (Fin m × Fin (d + 1)) R) :
    polynomialCoeffL1 (MvPolynomial.rename (hyperplanePivotEquiv p) P) = polynomialCoeffL1 P :=
  polynomialCoeffL1_rename_of_injective _ (hyperplanePivotEquiv p).injective P

end
end Bounty

