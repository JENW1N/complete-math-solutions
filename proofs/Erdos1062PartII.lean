/- Component PolicyFixedHintData; SHA256 c690738d5de43a4cf40d37d29520372e0da72d43be2d02f6ab8ef26571acd008. -/
section PolicySubmissionPart55
/- Direct fixed-width hint IDs, decoded in bounded pieces. -/
namespace Bounty

def policyFixedHintPart : Nat → Nat → List Nat → List Nat
  | 0, _, result => result
  | n + 1, packed, result =>
      policyFixedHintPart n (packed >>> 15) ((packed &&& 0x7fff) :: result)

def policyFixedHintChunks : Nat → Nat → Nat → List Nat → List Nat
  | 0, _, _, result => result
  | fuel + 1, count, packed, result =>
      if count = 0 then result else
      let n := min count 0x200
      let piece := packed &&& ((1 <<< (15 * n)) - 1)
      policyFixedHintChunks fuel (count - n) (packed >>> (15 * n))
        (policyFixedHintPart n piece result)

def policyFixedHintDecode (record : Nat) : List Nat :=
  let count := record &&& 0xfff
  (policyFixedHintChunks (count / 0x200 + 1) count (record >>> 12) []).reverse

end Bounty

end PolicySubmissionPart55

