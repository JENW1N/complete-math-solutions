/- Component ReturnDifferenceIdentity; SHA256 332603a11b26e82cad59ee40d4884e5a7f7167bd3264ae8dee8cf7a0e4826e03 -/
section SubmissionComponent_ReturnDifferenceIdentity
/- An integer prefix and the exact four-family remainder for each small return. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def groupedJump4 (r : ℕ) : ℝ :=
  0x69 * positiveJumpSeries4 r 0 - 0xa8 * positiveJumpSeries4 r 1 -
    3 * positiveJumpSeries4 r 2 - 60 * positiveJumpSeries4 r 3

noncomputable def groupedJump3 (r : ℕ) : ℝ :=
  -0x69 * positiveJumpSeries3 r 0 + 84 * positiveJumpSeries3 r 1 +
    6 * positiveJumpSeries3 r 2 + 15 * positiveJumpSeries3 r 3

noncomputable def returnIntegerPrefix (r : ℕ) : ℤ :=
  ((3 : ℤ) ^ (rotationReturns r).p.toNat - 1) *
      integerPrefix coefficient4 4 (rotationReturns r).q +
    ((4 : ℤ) ^ (rotationReturns r).q - 1) *
      (integerPrefix coefficient3 3 (rotationReturns r).p.toNat - 90)

noncomputable def returnRemainder (r : ℕ) : ℝ :=
  ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) * groupedJump4 r +
    ((4 : ℝ) ^ (rotationReturns r).q - 1) * groupedJump3 r

def returnDifferenceIdentity :
    ∀ᶠ r in atTop,
      ((4 : ℝ) ^ (rotationReturns r).q - 1) *
        ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) * (0xb4 * explicitDensity - 32) -
          returnIntegerPrefix r = returnRemainder r := by
  filter_upwards [coefficient4_return_series_grouped, coefficient3_return_series_grouped]
    with r h4 h3
  have ha := integer_weighted_shift (by norm_num : 1 < (4 : ℕ))
    coefficient4_bound (rotationReturns r).q
  have hb := integer_weighted_shift (by norm_num : 1 < (3 : ℕ))
    coefficient3_bound (rotationReturns r).p.toNat
  norm_num only [Nat.cast_ofNat] at ha hb
  rw [h4] at ha
  rw [h3] at hb
  have hz : 0xb4 * explicitDensity - 32 =
      (∑' n : ℕ, (coefficient4 n : ℝ) / (4 : ℝ) ^ n) +
      (∑' n : ℕ, (coefficient3 n : ℝ) / (3 : ℝ) ^ n) := by
    unfold explicitDensity
    ring
  rw [hz]
  calc
    _ = ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) *
        (((4 : ℝ) ^ (rotationReturns r).q - 1) *
          (∑' n : ℕ, (coefficient4 n : ℝ) / (4 : ℝ) ^ n)) +
      ((4 : ℝ) ^ (rotationReturns r).q - 1) *
        (((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) *
          (∑' n : ℕ, (coefficient3 n : ℝ) / (3 : ℝ) ^ n)) -
      returnIntegerPrefix r := by ring
    _ = returnRemainder r := by
      rw [ha, hb]
      unfold returnIntegerPrefix returnRemainder groupedJump4 groupedJump3
      push_cast
      ring


end Bounty

end SubmissionComponent_ReturnDifferenceIdentity

/- Component ReturnEventSeries; SHA256 f58e196b7ba93d2326f2c6a08e99d6b8716dd77f314bd6e3378eb22a549fc664 -/
section SubmissionComponent_ReturnEventSeries
/- The exact remainder as sixteen absolutely convergent exponential event series. -/

namespace Bounty

def returnEventCoefficient4 (i : Fin 4) : ℤ := ![0x69, -0xa8, -3, -60] i

def returnEventCoefficient3 (i : Fin 4) : ℤ := ![0x69, -84, -6, -15] i

def returnEventCoefficient (i : ReturnEventFamily) : ℤ :=
  if i.1 = 0 then returnEventCoefficient4 i.2
  else if i.1 = 1 then -returnEventCoefficient4 i.2
  else if i.1 = 2 then -returnEventCoefficient3 i.2
  else returnEventCoefficient3 i.2

noncomputable def returnEventTerm (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : ℝ := by
  classical
  exact if returnEventVisit r i n then
    (returnEventCoefficient i : ℝ) * Real.exp (-returnEventTime r i n) else 0

def jumpVisit4_eq_one_of_ne_zero {r : ℕ} {i : Fin 4} {n : ℤ}
    (h : jumpVisit4 r i n ≠ 0) : jumpVisit4 r i n = 1 := by
  unfold jumpVisit4 forwardJump at *
  split at * <;> simp_all

def jumpVisit3_eq_one_of_ne_zero {r : ℕ} {i : Fin 4} {n : ℤ}
    (h : jumpVisit3 r i n ≠ 0) : jumpVisit3 r i n = 1 := by
  unfold jumpVisit3 backwardJump at *
  split at * <;> simp_all

def exp_neg_event_time {b : ℝ} (hb : 0 < b) (offset : ℝ) (n : ℕ) :
    Real.exp (-((n : ℝ) * Real.log b - offset)) = Real.exp offset / b ^ n := by
  rw [neg_sub, Real.exp_sub, Real.exp_nat_mul, Real.exp_log hb]

def returnEventTerm_eq_weighted (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    returnEventTerm r i n =
      if 0 < n then
        (returnEventCoefficient i : ℝ) * Real.exp (returnEventOffset r i) *
          (if i.1 < 2 then (jumpVisit4 r i.2 n : ℝ) / (4 : ℝ) ^ n
          else (jumpVisit3 r i.2 n : ℝ) / (3 : ℝ) ^ n)
      else 0 := by
  classical
  by_cases hn : 0 < n
  · by_cases hi : i.1 < 2
    · by_cases hj : jumpVisit4 r i.2 n ≠ 0
      · have he := jumpVisit4_eq_one_of_ne_zero hj
        have hv : returnEventVisit r i n := by
          simpa only [returnEventVisit, if_pos hi] using And.intro hn hj
        rw [returnEventTerm, if_pos hv, if_pos hn, if_pos hi, he, Int.cast_one]
        simp only [returnEventTime, returnEventStep, if_pos hi]
        rw [exp_neg_event_time (by norm_num : (0 : ℝ) < 4)]
        ring
      · have he : jumpVisit4 r i.2 n = 0 := not_ne_iff.mp hj
        simp [returnEventTerm, returnEventVisit, hn, hi, he]
    · by_cases hj : jumpVisit3 r i.2 n ≠ 0
      · have he := jumpVisit3_eq_one_of_ne_zero hj
        have hv : returnEventVisit r i n := by
          simpa only [returnEventVisit, if_neg hi] using And.intro hn hj
        rw [returnEventTerm, if_pos hv, if_pos hn, if_neg hi, he, Int.cast_one]
        simp only [returnEventTime, returnEventStep, if_neg hi]
        rw [exp_neg_event_time (by norm_num : (0 : ℝ) < 3)]
        ring
      · have he : jumpVisit3 r i.2 n = 0 := not_ne_iff.mp hj
        simp [returnEventTerm, returnEventVisit, hn, hi, he]
  · simp [returnEventTerm, returnEventVisit, hn]

def returnEventTerm_hasSum (r : ℕ) (i : ReturnEventFamily) :
    HasSum (returnEventTerm r i)
      ((returnEventCoefficient i : ℝ) * Real.exp (returnEventOffset r i) *
        (if i.1 < 2 then positiveJumpSeries4 r i.2 else positiveJumpSeries3 r i.2)) := by
  classical
  rw [← hasSum_nat_add_iff' 1]
  simp only [Finset.sum_range_one, returnEventTerm_eq_weighted, Nat.lt_irrefl,
    if_false, sub_zero]
  by_cases hi : i.1 < 2
  · have hs := ((summable_nat_add_iff 1).mpr
      (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 4)
        (jumpVisit4_abs_le_one r i.2))).hasSum
    have hh := hs.mul_left
      ((returnEventCoefficient i : ℝ) * Real.exp (returnEventOffset r i))
    simpa only [Nat.cast_add, Nat.cast_one, Nat.zero_lt_succ, if_pos, hi,
      positiveJumpSeries4] using hh
  · have hs := ((summable_nat_add_iff 1).mpr
      (integerIndexSeries_summable (by norm_num : (1 : ℝ) < 3)
        (jumpVisit3_abs_le_one r i.2))).hasSum
    have hh := hs.mul_left
      ((returnEventCoefficient i : ℝ) * Real.exp (returnEventOffset r i))
    simpa only [Nat.cast_add, Nat.cast_one, Nat.zero_lt_succ, if_pos, if_neg hi,
      positiveJumpSeries3] using hh

def returnEventTerm_summable (r : ℕ) (i : ReturnEventFamily) :
    Summable (returnEventTerm r i) := (returnEventTerm_hasSum r i).summable

def returnEventTerm_tsum (r : ℕ) (i : ReturnEventFamily) :
    (∑' n : ℕ, returnEventTerm r i n) =
      (returnEventCoefficient i : ℝ) * Real.exp (returnEventOffset r i) *
        (if i.1 < 2 then positiveJumpSeries4 r i.2 else positiveJumpSeries3 r i.2) :=
  (returnEventTerm_hasSum r i).tsum_eq

def returnRemainder_event_series (r : ℕ) :
    returnRemainder r = ∑ i : ReturnEventFamily, ∑' n : ℕ, returnEventTerm r i n := by
  simp only [returnEventTerm_tsum, Fintype.sum_prod_type, Fin.sum_univ_four]
  norm_num [Fin.lt_def, Fin.ext_iff, Matrix.cons_val_two, Matrix.cons_val_three,
    returnEventCoefficient, returnEventCoefficient4,
    returnEventCoefficient3, returnEventOffset, Real.exp_nat_mul,
    Real.exp_log (by norm_num : (0 : ℝ) < 3),
    Real.exp_log (by norm_num : (0 : ℝ) < 4)]
  unfold returnRemainder groupedJump4 groupedJump3
  ring


end Bounty

end SubmissionComponent_ReturnEventSeries

/- Component SparseGeometricTail; SHA256 0c64c5aa3060bb0b59e167193718d8021131fc7d14f8bde100cc6a728f407e89 -/
section SubmissionComponent_SparseGeometricTail
/- Geometric tails supported on separated natural-number indices. -/

namespace Bounty

/-- A finite set of indices with spacing at least `Q` has geometric mass
at most that of the progression starting at any lower bound `N`. -/
def sparse_geometric_finset_bound {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    {Q : ℕ} (hQ : 0 < Q) (s : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ s, N ≤ n)
    (hsep : ∀ m ∈ s, ∀ n ∈ s, m < n → Q ≤ n - m) :
    ∑ n ∈ s, r ^ n ≤ r ^ N / (1 - r ^ Q) := by
  classical
  have hd : 0 < 1 - r ^ Q := sub_pos.mpr (pow_lt_one₀ hr0 hr1 (Nat.ne_of_gt hQ))
  induction s using Finset.strongInductionOn generalizing N with
  | _ s ih =>
    by_cases hs : s.Nonempty
    · let m := s.min' hs
      have hm : m ∈ s := Finset.min'_mem s hs
      have hmin (n : ℕ) (hn : n ∈ s) : m ≤ n := Finset.min'_le s n hn
      have hrest : ∑ n ∈ s.erase m, r ^ n ≤ r ^ (m + Q) / (1 - r ^ Q) := by
        apply ih (s.erase m) (Finset.erase_ssubset hm) (m + Q)
        · intro n hn
          have hn' := Finset.mem_erase.mp hn
          have hmn : m < n := lt_of_le_of_ne (hmin n hn'.2) (Ne.symm hn'.1)
          have hg := hsep m hm n hn'.2 hmn
          omega
        · intro a ha b hb hab
          exact hsep a (Finset.mem_of_mem_erase ha) b (Finset.mem_of_mem_erase hb) hab
      calc
        ∑ n ∈ s, r ^ n = r ^ m + ∑ n ∈ s.erase m, r ^ n := by
          rw [← Finset.sum_erase_add _ _ hm]
          ring
        _ ≤ r ^ m + r ^ (m + Q) / (1 - r ^ Q) := add_le_add le_rfl hrest
        _ = r ^ m / (1 - r ^ Q) := by
          rw [pow_add]
          field_simp
          <;> ring
        _ ≤ r ^ N / (1 - r ^ Q) :=
          div_le_div_of_nonneg_right (pow_le_pow_of_le_one hr0 hr1.le (hN m hm)) hd.le
    · have he : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
      subst s
      simpa using div_nonneg (pow_nonneg hr0 N) hd.le

/-- Summability and the sharp geometric upper bound for separated visits. -/
def sparse_geometric_tail_pow {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    {Q : ℕ} (hQ : 0 < Q) (V : ℕ → Prop) [DecidablePred V] (N : ℕ)
    (hsep : ∀ m n, V m → V n → m < n → Q ≤ n - m) :
    Summable (fun n => if V n ∧ N ≤ n then r ^ n else 0) ∧
      (∑' n, if V n ∧ N ≤ n then r ^ n else 0) ≤ r ^ N / (1 - r ^ Q) := by
  classical
  have hnonneg : 0 ≤ (fun n => if V n ∧ N ≤ n then r ^ n else 0) := by
    intro n
    dsimp only [Pi.zero_apply]
    split_ifs <;> positivity
  have hbound (s : Finset ℕ) :
      ∑ n ∈ s, (if V n ∧ N ≤ n then r ^ n else 0) ≤ r ^ N / (1 - r ^ Q) := by
    rw [← Finset.sum_filter]
    apply sparse_geometric_finset_bound hr0 hr1 hQ
    · intro n hn
      exact (Finset.mem_filter.mp hn).2.2
    · intro m hm n hn hmn
      exact hsep m n (Finset.mem_filter.mp hm).2.1 (Finset.mem_filter.mp hn).2.1 hmn
  exact ⟨summable_of_sum_le hnonneg hbound, Real.tsum_le_of_sum_le hnonneg hbound⟩

end Bounty

end SubmissionComponent_SparseGeometricTail

/- Component SparseExponentialTail; SHA256 09025d47469001596818f18079809f9940e664b5e7e6f1d240e49d7f1ac286b3 -/
section SubmissionComponent_SparseExponentialTail
/- Sparse exponential tails with a real event-time cutoff. -/

namespace Bounty

/-- Event times `n * step - offset` separated by at least `Q * step`
have a geometric tail bound measured directly from the real cutoff `T`. -/
def sparse_exponential_tail {step : ℝ} (hstep : 0 < step)
    {Q : ℕ} (hQ : 0 < Q) (offset T : ℝ)
    (V : ℕ → Prop) [DecidablePred V]
    (hsep : ∀ m n, V m → V n → m < n → Q ≤ n - m)
    (htime : ∀ n, V n → T ≤ (n : ℝ) * step - offset) :
    Summable (fun n => if V n then Real.exp (-((n : ℝ) * step - offset)) else 0) ∧
      (∑' n, if V n then Real.exp (-((n : ℝ) * step - offset)) else 0) ≤
        Real.exp (-T) / (1 - Real.exp (-(Q : ℝ) * step)) := by
  classical
  have hr0 : 0 ≤ Real.exp (-step) := (Real.exp_pos _).le
  have hr1 : Real.exp (-step) < 1 := Real.exp_lt_one_iff.mpr (by linarith)
  have hpow (n : ℕ) : Real.exp (-step) ^ n = Real.exp (-(n : ℝ) * step) := by
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  have hweight (n : ℕ) : Real.exp (-((n : ℝ) * step - offset)) =
      Real.exp offset * Real.exp (-step) ^ n := by
    rw [hpow, ← Real.exp_add]
    congr 1
    ring
  have hd : 0 < 1 - Real.exp (-(Q : ℝ) * step) := by
    apply sub_pos.mpr
    apply Real.exp_lt_one_iff.mpr
    have hQr : 0 < (Q : ℝ) := by exact_mod_cast hQ
    nlinarith [mul_pos hQr hstep]
  by_cases hex : ∃ n, V n
  · let N := Nat.find hex
    have hVN : V N := Nat.find_spec hex
    have hN (n : ℕ) (hn : V n) : N ≤ n := Nat.find_min' hex hn
    obtain ⟨hsum, hbound⟩ := sparse_geometric_tail_pow hr0 hr1 hQ V N hsep
    have hfun :
        (fun n => if V n then Real.exp (-((n : ℝ) * step - offset)) else 0) =
        (fun n => Real.exp offset *
          (if V n ∧ N ≤ n then Real.exp (-step) ^ n else 0)) := by
      funext n
      by_cases hn : V n
      · simp only [hn, hN n hn, and_self, ite_true, hweight]
      · simp only [hn, false_and, ite_false, mul_zero]
    rw [hfun]
    refine ⟨hsum.mul_left _, ?_⟩
    rw [tsum_mul_left]
    calc
      Real.exp offset * (∑' n, if V n ∧ N ≤ n then Real.exp (-step) ^ n else 0) ≤
          Real.exp offset * (Real.exp (-step) ^ N / (1 - Real.exp (-step) ^ Q)) :=
        mul_le_mul_of_nonneg_left hbound (Real.exp_pos _).le
      _ = Real.exp (-((N : ℝ) * step - offset)) /
          (1 - Real.exp (-(Q : ℝ) * step)) := by
        rw [← mul_div_assoc, ← hweight, hpow Q]
      _ ≤ Real.exp (-T) / (1 - Real.exp (-(Q : ℝ) * step)) := by
        apply div_le_div_of_nonneg_right _ hd.le
        apply Real.exp_le_exp.mpr
        linarith [htime N hVN]
  · have hempty (n : ℕ) : ¬V n := fun hn => hex ⟨n, hn⟩
    simp only [hempty, ite_false, summable_zero, tsum_zero, true_and]
    exact div_nonneg (Real.exp_pos _).le hd.le


end Bounty

end SubmissionComponent_SparseExponentialTail

/- Component ReturnEventTail; SHA256 836a7bd83088527d5905085bec240c1f7d414050a3fd5e3e783018b1711c83f7 -/
section SubmissionComponent_ReturnEventTail
/- Quantitative tails of the sixteen return-event series. -/

namespace Bounty

noncomputable def returnEventOmittedTerm (r : ℕ) (T : ℝ)
    (i : ReturnEventFamily) (n : ℕ) : ℝ := by
  classical
  exact if T ≤ returnEventTime r i n then returnEventTerm r i n else 0

noncomputable def returnEventTailWeight (r : ℕ) (T : ℝ)
    (i : ReturnEventFamily) (n : ℕ) : ℝ := by
  classical
  exact if returnEventVisit r i n ∧ T ≤ returnEventTime r i n then
    Real.exp (-returnEventTime r i n) else 0

def returnEventCoefficient_abs_le (i : ReturnEventFamily) :
    |(returnEventCoefficient i : ℝ)| ≤ 0xa8 := by
  rcases i with ⟨j, k⟩
  fin_cases j <;> fin_cases k <;>
    norm_num [returnEventCoefficient, returnEventCoefficient4, returnEventCoefficient3, Fin.ext_iff]

def returnEventOmittedTerm_summable (r : ℕ) (T : ℝ) (i : ReturnEventFamily) :
    Summable (returnEventOmittedTerm r T i) := by
  classical
  have hs := (returnEventTerm_summable r i).indicator {n | T ≤ returnEventTime r i n}
  exact hs.congr (fun n => by
    by_cases ht : T ≤ returnEventTime r i n <;> simp [ht, returnEventOmittedTerm])

def returnEventTailWeight_nonneg (r : ℕ) (T : ℝ) (i : ReturnEventFamily) (n : ℕ) :
    0 ≤ returnEventTailWeight r T i n := by
  unfold returnEventTailWeight
  split_ifs <;> positivity

def returnEventOmittedTerm_eq (r : ℕ) (T : ℝ) (i : ReturnEventFamily) (n : ℕ) :
    returnEventOmittedTerm r T i n =
      (returnEventCoefficient i : ℝ) * returnEventTailWeight r T i n := by
  classical
  by_cases hv : returnEventVisit r i n <;>
    by_cases ht : T ≤ returnEventTime r i n <;>
      simp [returnEventOmittedTerm, returnEventTerm, returnEventTailWeight, hv, ht]

/-- Each event family has an integral index spacing whose time spacing is at least half the scale. -/
def returnEventVisit_discrete_spacing (r : ℕ) (i : ReturnEventFamily) :
    ∃ q : ℕ, 0 < q ∧ returnScale r / 2 ≤ (q : ℝ) * returnEventStep i ∧
      ∀ m n, returnEventVisit r i m → returnEventVisit r i n → m < n → q ≤ n - m := by
  by_cases hi : i.1 < 2
  · refine ⟨(rotationReturns r).Q, (rotationReturns r).Q_pos, ?_, ?_⟩
    · simpa only [returnEventStep, if_pos hi] using (returnScale_bounds r).2.2.1
    · intro m n hm hn hmn
      apply jumpVisit4_separated r i.2 hmn
      · simpa only [returnEventVisit, if_pos hi] using hm.2
      · simpa only [returnEventVisit, if_pos hi] using hn.2
  · have hP : 0 < (rotationReturns r).P := by
      have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
      have hQ := (rotationReturns r).Q_pos
      omega
    have hPn : 0 < (rotationReturns r).P.toNat := by omega
    have hcast : ((rotationReturns r).P.toNat : ℝ) = (rotationReturns r).P := by
      exact_mod_cast Int.toNat_of_nonneg hP.le
    refine ⟨(rotationReturns r).P.toNat, hPn, ?_, ?_⟩
    · rw [returnEventStep, if_neg hi, hcast]
      change returnScale r / 2 ≤ returnScale r
      linarith [returnScale_pos r]
    · intro m n hm hn hmn
      apply jumpVisit3_separated r i.2 hmn
      · simpa only [returnEventVisit, if_neg hi] using hm.2
      · simpa only [returnEventVisit, if_neg hi] using hn.2

def returnEventTail_denominator_pos (r : ℕ) :
    0 < 1 - Real.exp (-returnScale r / 2) := by
  apply sub_pos.mpr
  apply Real.exp_lt_one_iff.mpr
  linarith [returnScale_pos r]

/-- Removing all terms before an empty interval gains the full length of that interval. -/
def returnEventTailWeight_bound (r : ℕ) (T : ℝ) (i : ReturnEventFamily)
    (hgap : ∀ n, returnEventVisit r i n →
      returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) :
    Summable (returnEventTailWeight r T i) ∧
      (∑' n, returnEventTailWeight r T i n) ≤
        Real.exp (-T - returnScale r / 0x64) / (1 - Real.exp (-returnScale r / 2)) := by
  classical
  obtain ⟨q, hq, hscale, hsep⟩ := returnEventVisit_discrete_spacing r i
  let V : ℕ → Prop := fun n => returnEventVisit r i n ∧ T ≤ returnEventTime r i n
  have htime (n : ℕ) (hn : V n) :
      T + returnScale r / 0x64 ≤ (n : ℝ) * returnEventStep i - returnEventOffset r i := by
    change T + returnScale r / 0x64 ≤ returnEventTime r i n
    rcases hgap n hn.1 with h | h
    · linarith [hn.2]
    · exact h.le
  obtain ⟨hsum, hbound⟩ := sparse_exponential_tail (returnEventStep_pos i) hq
    (returnEventOffset r i) (T + returnScale r / 0x64) V
    (fun m n hm hn hmn => hsep m n hm.1 hn.1 hmn) htime
  have hsum' : Summable (returnEventTailWeight r T i) := by
    change Summable (fun n => if returnEventVisit r i n ∧ T ≤ returnEventTime r i n then
      Real.exp (-returnEventTime r i n) else 0)
    simpa only [returnEventTime, V] using hsum
  have hb : (∑' n, returnEventTailWeight r T i n) ≤
      Real.exp (-T - returnScale r / 0x64) /
        (1 - Real.exp (-(q : ℝ) * returnEventStep i)) := by
    simpa only [returnEventTailWeight, returnEventTime, V, neg_add_rev, sub_eq_add_neg,
      add_comm] using hbound
  refine ⟨hsum', hb.trans ?_⟩
  apply div_le_div_of_nonneg_left (Real.exp_pos _).le (returnEventTail_denominator_pos r)
  have hexp : Real.exp (-(q : ℝ) * returnEventStep i) ≤ Real.exp (-returnScale r / 2) := by
    apply Real.exp_le_exp.mpr
    linarith
  linarith

def returnEventOmittedTerm_family_bound (r : ℕ) (T : ℝ) (i : ReturnEventFamily)
    (hgap : ∀ n, returnEventVisit r i n →
      returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) :
    |∑' n, returnEventOmittedTerm r T i n| ≤
      0xa8 * Real.exp (-T - returnScale r / 0x64) / (1 - Real.exp (-returnScale r / 2)) := by
  have hb := (returnEventTailWeight_bound r T i hgap).2
  have hnonneg : 0 ≤ ∑' n, returnEventTailWeight r T i n :=
    tsum_nonneg (returnEventTailWeight_nonneg r T i)
  have hfun : returnEventOmittedTerm r T i =
      fun n => (returnEventCoefficient i : ℝ) * returnEventTailWeight r T i n := by
    funext n
    exact returnEventOmittedTerm_eq r T i n
  rw [hfun, tsum_mul_left, abs_mul, abs_of_nonneg hnonneg]
  calc
    |(returnEventCoefficient i : ℝ)| * (∑' n, returnEventTailWeight r T i n) ≤
        0xa8 * (Real.exp (-T - returnScale r / 0x64) / (1 - Real.exp (-returnScale r / 2))) :=
      mul_le_mul (returnEventCoefficient_abs_le i) hb hnonneg (by norm_num)
    _ = _ := by ring

def returnEventOmittedTerm_total_bound (r : ℕ) (T : ℝ)
    (hgap : ∀ i n, returnEventVisit r i n →
      returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) :
    |∑ i : ReturnEventFamily, ∑' n, returnEventOmittedTerm r T i n| ≤
      (16 * 0xa8 : ℝ) * Real.exp (-T - returnScale r / 0x64) /
        (1 - Real.exp (-returnScale r / 2)) := by
  calc
    |∑ i : ReturnEventFamily, ∑' n, returnEventOmittedTerm r T i n| ≤
        ∑ i : ReturnEventFamily, |∑' n, returnEventOmittedTerm r T i n| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : ReturnEventFamily,
        0xa8 * Real.exp (-T - returnScale r / 0x64) / (1 - Real.exp (-returnScale r / 2)) :=
      Finset.sum_le_sum (fun i _ => returnEventOmittedTerm_family_bound r T i (hgap i))
    _ = _ := by norm_num [ReturnEventFamily]; ring


end Bounty

end SubmissionComponent_ReturnEventTail

/- Component ReturnEventBounds; SHA256 e05d18a97b07da3007f7881de0e40be70c622180361706dde82fe51f8bc8ba7c -/
section SubmissionComponent_ReturnEventBounds
/- Bounds for the offsets, exponents, and number of coordinates below a return cutoff. -/

namespace Bounty

def returnEventOffset_bounds (r : ℕ) (i : ReturnEventFamily) :
    0 ≤ returnEventOffset r i ∧ returnEventOffset r i ≤ returnScale r := by
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have h4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hp : 0 ≤ (rotationReturns r).p := by
    have hb := (rotationReturns r).numerator_bounds
      rotationSlope_bounds.1 rotationSlope_bounds.2
    have hq := (rotationReturns r).q_pos
    omega
  have he : ((rotationReturns r).p.toNat : ℝ) = (rotationReturns r).p := by
    exact_mod_cast Int.toNat_of_nonneg hp
  unfold returnEventOffset
  split
  · constructor
    · positivity
    · rw [he]
      exact (returnScale_bounds r).2.1
  · split
    · exact ⟨by positivity, (returnScale_bounds r).1⟩
    · exact ⟨le_refl 0, (returnScale_pos r).le⟩

def returnEventTime_gt_neg_scale (r : ℕ) (i : ReturnEventFamily) {n : ℕ}
    (hn : returnEventVisit r i n) : -returnScale r < returnEventTime r i n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn.1
  have hh := mul_pos hnR (returnEventStep_pos i)
  have ho := (returnEventOffset_bounds r i).2
  unfold returnEventTime
  linarith

def returnEventExponent_le (r : ℕ) (i : ReturnEventFamily) {n : ℕ} {k : ℝ}
    (hn : returnEventTime r i n ≤ k * returnScale r) :
    (n : ℝ) * returnEventStep i ≤ (k + 1) * returnScale r := by
  have ho := (returnEventOffset_bounds r i).2
  unfold returnEventTime at hn
  nlinarith

def separated_events_card_le_bins (E : Finset ℝ) {a gap : ℝ} (N : ℕ)
    (hgap : 0 < gap)
    (hbounds : ∀ x ∈ E, a ≤ x ∧ x ≤ a + (N : ℝ) * gap)
    (hsep : ∀ x ∈ E, ∀ y ∈ E, x ≠ y → gap ≤ |x - y|) :
    E.card ≤ N + 1 := by
  classical
  have hz (x : E) : 0 ≤ ((x : ℝ) - a) / gap ∧ ((x : ℝ) - a) / gap ≤ N := by
    have hx := hbounds x x.property
    constructor
    · exact div_nonneg (by linarith) hgap.le
    · apply (div_le_iff₀ hgap).mpr
      linarith
  let f : E → ↥(Finset.Icc (0 : ℤ) (N : ℤ)) := fun x =>
    ⟨⌊((x : ℝ) - a) / gap⌋, Finset.mem_Icc.mpr
      ⟨Int.floor_nonneg.mpr (hz x).1, Int.floor_le_iff.mpr (by
        push_cast
        linarith [(hz x).2])⟩⟩
  have hinj : Function.Injective f := by
    intro x y hf
    apply Subtype.ext
    by_contra hxy
    have heq : ⌊((x : ℝ) - a) / gap⌋ = ⌊((y : ℝ) - a) / gap⌋ :=
      congrArg Subtype.val hf
    have hh := Int.abs_sub_lt_one_of_floor_eq_floor heq
    have he : ((x : ℝ) - a) / gap - ((y : ℝ) - a) / gap =
        ((x : ℝ) - y) / gap := by ring
    rw [he, abs_div, abs_of_pos hgap] at hh
    have hsmall := (div_lt_iff₀ hgap).mp hh
    have hlarge := hsep x x.property y y.property hxy
    linarith
  have hc := Fintype.card_le_of_injective f hinj
  simpa using hc

def returnEventWindow_card (r k : ℕ) (i : ReturnEventFamily) :
    (linearEventWindow (returnEventStep i) (returnEventOffset r i)
      (-returnScale r) ((k : ℝ) * returnScale r) (returnEventVisit r i)).card ≤ 2 * k + 3 := by
  have hc : (linearEventWindow (returnEventStep i) (returnEventOffset r i)
      (-returnScale r) ((k : ℝ) * returnScale r) (returnEventVisit r i)).card ≤
      (2 * k + 2) + 1 := by
    apply separated_events_card_le_bins _ (2 * k + 2)
      (show 0 < returnScale r / 2 by linarith [returnScale_pos r])
    · intro x hx
      obtain ⟨n, hv, he, hlo, hhi⟩ := (mem_linearEventWindow (returnEventStep_pos i)).mp hx
      refine ⟨hlo, ?_⟩
      push_cast
      nlinarith
    · intro x hx y hy hxy
      obtain ⟨m, hm, rfl, _, _⟩ := (mem_linearEventWindow (returnEventStep_pos i)).mp hx
      obtain ⟨n, hn, rfl, _, _⟩ := (mem_linearEventWindow (returnEventStep_pos i)).mp hy
      have hmn : m ≠ n := by rintro rfl; exact hxy rfl
      rcases lt_or_gt_of_ne hmn with hlt | hgt
      · have hh := returnEventVisit_separation r i hm hn hlt
        have ha := neg_le_abs (((m : ℝ) * returnEventStep i - returnEventOffset r i) -
          ((n : ℝ) * returnEventStep i - returnEventOffset r i))
        linarith
      · have hh := returnEventVisit_separation r i hn hm hgt
        have ha := le_abs_self (((m : ℝ) * returnEventStep i - returnEventOffset r i) -
          ((n : ℝ) * returnEventStep i - returnEventOffset r i))
        linarith
  omega

end Bounty

end SubmissionComponent_ReturnEventBounds

/- Component ReturnEventTruncation; SHA256 206f46103455ab5d78632f7ce33e9c08abcb129ea1d0742935dcac10b042f709 -/
section SubmissionComponent_ReturnEventTruncation
/- Finite truncations of the actual return series and their quantified errors. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def returnTruncationIndices (r : ℕ) (T : ℝ) (i : ReturnEventFamily) : Finset ℕ := by
  classical
  exact (Finset.range (⌈(T + returnEventOffset r i) / returnEventStep i⌉₊ + 1)).filter
    (fun n => returnEventVisit r i n ∧ returnEventTime r i n < T)

def mem_returnTruncationIndices (r : ℕ) (T : ℝ) (i : ReturnEventFamily) (n : ℕ) :
    n ∈ returnTruncationIndices r T i ↔
      returnEventVisit r i n ∧ returnEventTime r i n < T := by
  classical
  constructor
  · intro hn
    exact (Finset.mem_filter.mp hn).2
  · intro hn
    have hnr : (n : ℝ) ≤ (T + returnEventOffset r i) / returnEventStep i := by
      apply (le_div_iff₀ (returnEventStep_pos i)).mpr
      have hh := hn.2
      unfold returnEventTime at hh
      linarith
    have hnat : n ≤ ⌈(T + returnEventOffset r i) / returnEventStep i⌉₊ := by
      exact_mod_cast hnr.trans (Nat.le_ceil _)
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hn⟩

noncomputable def returnTruncation (r : ℕ) (T : ℝ) : ℝ :=
  ∑ i : ReturnEventFamily, ∑ n ∈ returnTruncationIndices r T i, returnEventTerm r i n

def returnEventTerm_retained_tsum (r : ℕ) (T : ℝ) (i : ReturnEventFamily) :
    (∑' n : ℕ, if returnEventTime r i n < T then returnEventTerm r i n else 0) =
      ∑ n ∈ returnTruncationIndices r T i, returnEventTerm r i n := by
  classical
  calc
    _ = ∑ n ∈ returnTruncationIndices r T i,
        (if returnEventTime r i n < T then returnEventTerm r i n else 0) := by
      apply tsum_eq_sum
      intro n hn
      by_cases ht : returnEventTime r i n < T
      · have hv : ¬ returnEventVisit r i n := by
          intro hv
          exact hn ((mem_returnTruncationIndices r T i n).mpr ⟨hv, ht⟩)
        simp only [if_pos ht, returnEventTerm, if_neg hv]
      · simp only [if_neg ht]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro n hn
      exact if_pos ((mem_returnTruncationIndices r T i n).mp hn).2

def returnEventTerm_split_at_cutoff (r : ℕ) (T : ℝ) (i : ReturnEventFamily) :
    (∑' n : ℕ, returnEventTerm r i n) =
      (∑ n ∈ returnTruncationIndices r T i, returnEventTerm r i n) +
        ∑' n : ℕ, returnEventOmittedTerm r T i n := by
  classical
  have hret : Summable (fun n : ℕ =>
      if returnEventTime r i n < T then returnEventTerm r i n else 0) := by
    have hs := (returnEventTerm_summable r i).indicator {n | returnEventTime r i n < T}
    exact hs.congr (fun n => by simp only [Set.indicator_apply, Set.mem_ofPred_eq])
  have hsplit (n : ℕ) : returnEventTerm r i n =
      (if returnEventTime r i n < T then returnEventTerm r i n else 0) +
        returnEventOmittedTerm r T i n := by
    unfold returnEventOmittedTerm
    by_cases ht : returnEventTime r i n < T
    · simp only [if_pos ht, if_neg (not_le_of_gt ht), add_zero]
    · simp only [if_neg ht, if_pos (le_of_not_gt ht), zero_add]
  calc
    _ = ∑' n : ℕ,
        ((if returnEventTime r i n < T then returnEventTerm r i n else 0) +
          returnEventOmittedTerm r T i n) := tsum_congr hsplit
    _ = (∑' n : ℕ, if returnEventTime r i n < T then returnEventTerm r i n else 0) +
        ∑' n : ℕ, returnEventOmittedTerm r T i n :=
      (hret.hasSum.add (returnEventOmittedTerm_summable r T i).hasSum).tsum_eq
    _ = _ := by rw [returnEventTerm_retained_tsum]

def returnRemainder_split_at_cutoff (r : ℕ) (T : ℝ) :
    returnRemainder r = returnTruncation r T +
      ∑ i : ReturnEventFamily, ∑' n : ℕ, returnEventOmittedTerm r T i n := by
  rw [returnRemainder_event_series]
  simp only [returnEventTerm_split_at_cutoff r T, Finset.sum_add_distrib, returnTruncation]

def returnTruncation_error_bound (r : ℕ) (T : ℝ)
    (hgap : ∀ i n, returnEventVisit r i n →
      returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) :
    |returnRemainder r - returnTruncation r T| ≤
      (16 * 0xa8 : ℝ) * Real.exp (-T - returnScale r / 0x64) /
        (1 - Real.exp (-returnScale r / 2)) := by
  rw [returnRemainder_split_at_cutoff r T]
  simpa only [add_sub_cancel_left] using returnEventOmittedTerm_total_bound r T hgap

end Bounty

end SubmissionComponent_ReturnEventTruncation

/- Component ReturnRationalUnits; SHA256 0fe91e0b79a760a14c9ba8159b256520a1476d5deb8de1e8bfd1b47cd57ec98e -/
section SubmissionComponent_ReturnRationalUnits
/- Rational units, with prime support in {2, 3}, for the finite return truncations. -/

namespace Bounty

noncomputable section

def returnRationalUnit (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : ℚ :=
  if i.1 = 0 then (3 : ℚ) ^ (rotationReturns r).p.toNat / (4 : ℚ) ^ n
  else if i.1 = 1 then 1 / (4 : ℚ) ^ n
  else if i.1 = 2 then (4 : ℚ) ^ (rotationReturns r).q / (3 : ℚ) ^ n
  else 1 / (3 : ℚ) ^ n

def returnRationalUnit_pos (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    0 < returnRationalUnit r i n := by
  unfold returnRationalUnit
  split
  · positivity
  · split
    · positivity
    · split <;> positivity

def returnRationalUnit_ne_zero (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    returnRationalUnit r i n ≠ 0 := ne_of_gt (returnRationalUnit_pos r i n)

def returnRationalUnit_cast (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    (returnRationalUnit r i n : ℝ) = Real.exp (-returnEventTime r i n) := by
  rcases i with ⟨j, k⟩
  fin_cases j <;>
    norm_num [returnRationalUnit, returnEventTime, returnEventStep, returnEventOffset,
      Fin.lt_def, Fin.ext_iff,
      exp_neg_event_time (by norm_num : (0 : ℝ) < 4),
      exp_neg_event_time (by norm_num : (0 : ℝ) < 3), Real.exp_sub, Real.exp_neg,
      Real.exp_nat_mul,
      Real.exp_log (by norm_num : (0 : ℝ) < 3),
      Real.exp_log (by norm_num : (0 : ℝ) < 4)]

def returnUnitFourExponent (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : ℤ :=
  if i.1 < 2 then -(n : ℤ)
  else if i.1 = 2 then ((rotationReturns r).q : ℤ) else 0

def returnUnitThreeExponent (r : ℕ) (i : ReturnEventFamily) (n : ℕ) : ℤ :=
  if i.1 = 0 then ((rotationReturns r).p.toNat : ℤ)
  else if i.1 < 2 then 0 else -(n : ℤ)

def returnRationalUnit_eq_four_three_zpow (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    returnRationalUnit r i n =
      (4 : ℚ) ^ returnUnitFourExponent r i n *
        (3 : ℚ) ^ returnUnitThreeExponent r i n := by
  rcases i with ⟨j, k⟩
  dsimp only [returnRationalUnit, returnUnitFourExponent, returnUnitThreeExponent]
  generalize hp : (rotationReturns r).p.toNat = p
  fin_cases j <;>
    norm_num [returnRationalUnit, returnUnitFourExponent, returnUnitThreeExponent,
      Fin.lt_def, Fin.ext_iff, zpow_neg, div_eq_mul_inv, mul_comm]

def returnRationalUnit_primeMonomial (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    returnRationalUnit r i n =
      rationalPrimeMonomial (2 * returnUnitFourExponent r i n)
        (returnUnitThreeExponent r i n) 0 := by
  rw [returnRationalUnit_eq_four_three_zpow, rational_four_three_monomial]

def returnRationalTruncation (r : ℕ) (T : ℝ) : ℚ :=
  ∑ i : ReturnEventFamily, ∑ n ∈ returnTruncationIndices r T i,
    (returnEventCoefficient i : ℚ) * returnRationalUnit r i n

def returnRationalTruncation_cast (r : ℕ) (T : ℝ) :
    (returnRationalTruncation r T : ℝ) = returnTruncation r T := by
  classical
  unfold returnRationalTruncation returnTruncation
  push_cast
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro n hn
  have hv := ((mem_returnTruncationIndices r T i n).mp hn).1
  rw [returnEventTerm, if_pos hv, returnRationalUnit_cast]


end

end Bounty

end SubmissionComponent_ReturnRationalUnits

/- Component ReturnTruncationSize; SHA256 c8217a9efd11b4cc681d76ca8d6a555eff050da23023247060fc9395938d82d4 -/
section SubmissionComponent_ReturnTruncationSize
/- Coordinate counts and exponent bounds for the actual finite return truncations. -/

namespace Bounty

def returnEventTime_injective (r : ℕ) (i : ReturnEventFamily) :
    Function.Injective (returnEventTime r i) := by
  intro m n h
  have hm : (m : ℝ) * returnEventStep i = (n : ℝ) * returnEventStep i := by
    unfold returnEventTime at h
    linarith
  exact_mod_cast mul_right_cancel₀ (ne_of_gt (returnEventStep_pos i)) hm

def returnTruncationIndices_card (r k : ℕ) (T : ℝ) (i : ReturnEventFamily)
    (hT : T ≤ (k : ℝ) * returnScale r) :
    (returnTruncationIndices r T i).card ≤ 2 * k + 3 := by
  classical
  have hsub : (returnTruncationIndices r T i).image (returnEventTime r i) ⊆
      linearEventWindow (returnEventStep i) (returnEventOffset r i)
        (-returnScale r) ((k : ℝ) * returnScale r) (returnEventVisit r i) := by
    intro t ht
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp ht
    obtain ⟨hv, hlt⟩ := (mem_returnTruncationIndices r T i n).mp hn
    exact (mem_linearEventWindow (returnEventStep_pos i)).mpr
      ⟨n, hv, rfl, (returnEventTime_gt_neg_scale r i hv).le, hlt.le.trans hT⟩
  calc
    (returnTruncationIndices r T i).card =
        ((returnTruncationIndices r T i).image (returnEventTime r i)).card :=
      (Finset.card_image_of_injective _ (returnEventTime_injective r i)).symm
    _ ≤ (linearEventWindow (returnEventStep i) (returnEventOffset r i)
        (-returnScale r) ((k : ℝ) * returnScale r) (returnEventVisit r i)).card :=
      Finset.card_le_card hsub
    _ ≤ 2 * k + 3 := returnEventWindow_card r k i

def returnTruncationIndices_total_card (r k : ℕ) (T : ℝ)
    (hT : T ≤ (k : ℝ) * returnScale r) :
    (∑ i : ReturnEventFamily, (returnTruncationIndices r T i).card) ≤ 16 * (2 * k + 3) := by
  calc
    _ ≤ ∑ _i : ReturnEventFamily, (2 * k + 3) :=
      Finset.sum_le_sum (fun i _ => returnTruncationIndices_card r k T i hT)
    _ = 16 * (2 * k + 3) := by simp [ReturnEventFamily, mul_comm]

def returnTruncationIndices_exponent_le (r k : ℕ) (T : ℝ) (i : ReturnEventFamily)
    {n : ℕ} (hT : T ≤ (k : ℝ) * returnScale r)
    (hn : n ∈ returnTruncationIndices r T i) :
    (n : ℝ) * returnEventStep i ≤ ((k : ℝ) + 1) * returnScale r := by
  exact returnEventExponent_le r i (((mem_returnTruncationIndices r T i n).mp hn).2.le.trans hT)

end Bounty

end SubmissionComponent_ReturnTruncationSize

/- Component ReturnTruncationError; SHA256 efb54cd73ade5b50f0ffe4ab8955d4d85deffde024a983af4eb1c446d3143e42 -/
section SubmissionComponent_ReturnTruncationError
/- Absorb the uniform geometric-tail constant into an exponential gain. -/

open Filter
open scoped Topology

namespace Bounty

def returnEventTail_denominator_eventually :
    ∀ᶠ r in atTop, (1 : ℝ) / 2 ≤ 1 - Real.exp (-returnScale r / 2) := by
  have hh := returnScale_tendsto.eventually (eventually_ge_atTop (2 * Real.log 2))
  filter_upwards [hh] with r hr
  have he : Real.exp (-Real.log 2) = (1 : ℝ) / 2 := by
    rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    norm_num
  have hx : Real.exp (-returnScale r / 2) ≤ Real.exp (-Real.log 2) :=
    Real.exp_le_exp.mpr (by linarith)
  rw [he] at hx
  linarith

def returnTruncation_error_uniform :
    ∀ᶠ r in atTop, ∀ T : ℝ,
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) →
      |returnRemainder r - returnTruncation r T| ≤
        0x1500 * Real.exp (-T - returnScale r / 0x64) := by
  filter_upwards [returnEventTail_denominator_eventually] with r hr T hgap
  have hh := returnTruncation_error_bound r T hgap
  apply hh.trans
  apply (div_le_iff₀ (returnEventTail_denominator_pos r)).mpr
  have hm := mul_le_mul_of_nonneg_left hr (Real.exp_pos (-T - returnScale r / 0x64)).le
  nlinarith

def returnTruncation_error_exponential :
    ∀ᶠ r in atTop, ∀ T : ℝ,
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) →
      |returnRemainder r - returnTruncation r T| ≤ Real.exp (-T - returnScale r / 0xc8) := by
  have hlarge := returnScale_tendsto.eventually (eventually_ge_atTop (0xc8 * Real.log 0x1500))
  filter_upwards [returnTruncation_error_uniform, hlarge] with r hr hL T hgap
  calc
    _ ≤ 0x1500 * Real.exp (-T - returnScale r / 0x64) := hr T hgap
    _ = Real.exp (Real.log 0x1500 - T - returnScale r / 0x64) := by
      rw [show Real.log 0x1500 - T - returnScale r / 0x64 =
        Real.log 0x1500 + (-T - returnScale r / 0x64) by ring, Real.exp_add,
        Real.exp_log (by norm_num : (0 : ℝ) < 0x1500)]
    _ ≤ Real.exp (-T - returnScale r / 0xc8) := Real.exp_le_exp.mpr (by linarith)

def returnDensity_truncation_exponential :
    ∀ᶠ r in atTop, ∀ T : ℝ,
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) →
      |((4 : ℝ) ^ (rotationReturns r).q - 1) *
        ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) * (0xb4 * explicitDensity - 32) -
          returnIntegerPrefix r - returnTruncation r T| ≤ Real.exp (-T - returnScale r / 0xc8) := by
  filter_upwards [returnDifferenceIdentity, returnTruncation_error_exponential] with r hid herr T hgap
  rw [hid]
  exact herr T hgap


end Bounty

end SubmissionComponent_ReturnTruncationError

/- Component ReturnPrefixBounds; SHA256 3009413143d21752f9f6509ca5d40d5024ec8181c9f882356070ae158fa32441 -/
section SubmissionComponent_ReturnPrefixBounds
/- Archimedean size bounds for the integer coordinates in the return approximation. -/

open Filter
open scoped Topology

namespace Bounty

def integerPrefix_abs_le {a : ℕ → ℤ} {b : ℕ} {M : ℝ}
    (hb : 1 < b) (ha : ∀ n, |(a n : ℝ)| ≤ M) (q : ℕ) :
    |(integerPrefix a b q : ℝ)| ≤ 2 * M * (b : ℝ) ^ q := by
  have hb0 : 0 < (b : ℝ) := by exact_mod_cast (by omega : 0 < b)
  have hb1 : 1 < (b : ℝ) := by exact_mod_cast hb
  have hb2 : 2 ≤ (b : ℝ) := by exact_mod_cast (by omega : 2 ≤ b)
  have hM : 0 ≤ M := (abs_nonneg _).trans (ha 0)
  have hinv : 1 / (b : ℝ) ≤ (1 : ℝ) / 2 := by
    apply (div_le_iff₀ hb0).mpr
    linarith
  have hden : 0 < 1 - 1 / (b : ℝ) := by linarith
  have hgeo : (∑ n ∈ Finset.range q, (1 / (b : ℝ)) ^ n) ≤ 2 := by
    have hh := sparse_geometric_finset_bound (by positivity : 0 ≤ 1 / (b : ℝ))
      (by simpa only [one_div] using inv_lt_one_of_one_lt₀ hb1)
      (by omega : 0 < (1 : ℕ)) (Finset.range q) 0
      (fun n _ => Nat.zero_le n) (fun m _ n _ hmn => by omega)
    simp only [pow_zero, pow_one] at hh
    apply hh.trans
    apply (div_le_iff₀ hden).mpr
    linarith
  have hsum : |∑ n ∈ Finset.range q, (a n : ℝ) / (b : ℝ) ^ n| ≤ 2 * M := by
    calc
      _ ≤ ∑ n ∈ Finset.range q, |(a n : ℝ) / (b : ℝ) ^ n| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ n ∈ Finset.range q, M * (1 / (b : ℝ)) ^ n := by
        apply Finset.sum_le_sum
        intro n _
        calc
          |(a n : ℝ) / (b : ℝ) ^ n| = |(a n : ℝ)| / (b : ℝ) ^ n := by
            rw [abs_div, abs_of_pos (pow_pos hb0 n)]
          _ ≤ M / (b : ℝ) ^ n := div_le_div_of_nonneg_right (ha n) (pow_pos hb0 n).le
          _ = M * (1 / (b : ℝ)) ^ n := by rw [one_div, inv_pow, div_eq_mul_inv]
      _ = M * ∑ n ∈ Finset.range q, (1 / (b : ℝ)) ^ n := (Finset.mul_sum _ _ _).symm
      _ ≤ M * 2 := mul_le_mul_of_nonneg_left hgeo hM
      _ = 2 * M := mul_comm _ _
  rw [integerPrefix_cast a (by omega) q, abs_mul, abs_of_pos (pow_pos hb0 q)]
  calc
    _ ≤ (b : ℝ) ^ q * (2 * M) := mul_le_mul_of_nonneg_left hsum (pow_pos hb0 q).le
    _ = _ := by ring

def returnPrefix_base_power_bounds (r : ℕ) :
    (4 : ℝ) ^ (rotationReturns r).q ≤ Real.exp (returnScale r) ∧
      (3 : ℝ) ^ (rotationReturns r).p.toNat ≤ Real.exp (returnScale r) := by
  have hp : 0 ≤ (rotationReturns r).p := by
    have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
    have hq := (rotationReturns r).q_pos
    omega
  have hcast : ((rotationReturns r).p.toNat : ℝ) = (rotationReturns r).p := by
    exact_mod_cast Int.toNat_of_nonneg hp
  constructor
  · have he : Real.exp (((rotationReturns r).q : ℝ) * Real.log 4) =
        (4 : ℝ) ^ (rotationReturns r).q := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 4)]
    rw [← he]
    exact Real.exp_le_exp.mpr (returnScale_bounds r).1
  · have he : Real.exp (((rotationReturns r).p.toNat : ℝ) * Real.log 3) =
        (3 : ℝ) ^ (rotationReturns r).p.toNat := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 3)]
    rw [← he]
    apply Real.exp_le_exp.mpr
    rw [hcast]
    exact (returnScale_bounds r).2.1

def returnPrefix_power_product_bound (r : ℕ) :
    (4 : ℝ) ^ (rotationReturns r).q * (3 : ℝ) ^ (rotationReturns r).p.toNat ≤
      Real.exp (2 * returnScale r) := by
  have hh := returnPrefix_base_power_bounds r
  calc
    _ ≤ Real.exp (returnScale r) * Real.exp (returnScale r) :=
      mul_le_mul hh.1 hh.2 (by positivity) (Real.exp_pos _).le
    _ = Real.exp (2 * returnScale r) := by rw [← Real.exp_add]; congr 1; ring

def returnIntegerPrefix_abs_le_power_product (r : ℕ) :
    |(returnIntegerPrefix r : ℝ)| ≤
      0x16e * (4 : ℝ) ^ (rotationReturns r).q * (3 : ℝ) ^ (rotationReturns r).p.toNat := by
  let A : ℝ := (4 : ℝ) ^ (rotationReturns r).q
  let B : ℝ := (3 : ℝ) ^ (rotationReturns r).p.toNat
  let IA : ℝ := (integerPrefix coefficient4 4 (rotationReturns r).q : ℝ)
  let IB : ℝ := (integerPrefix coefficient3 3 (rotationReturns r).p.toNat : ℝ)
  have hA1 : 1 ≤ A := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 4)
  have hB1 : 1 ≤ B := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 3)
  have hIA : |IA| ≤ 0x9c * A := by
    have hh := integerPrefix_abs_le (by norm_num : 1 < (4 : ℕ)) coefficient4_bound
      (rotationReturns r).q
    norm_num at hh
    exact hh
  have hIB : |IB| ≤ 0x78 * B := by
    have hh := integerPrefix_abs_le (by norm_num : 1 < (3 : ℕ)) coefficient3_bound
      (rotationReturns r).p.toNat
    norm_num at hh
    exact hh
  have hIB90 : |IB - 90| ≤ 0xd2 * B := by
    have hh : |IB - 90| ≤ |IB| + 90 := by
      simpa only [sub_eq_add_neg, abs_neg, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 90)]
        using abs_add_le IB (-90)
    linarith
  have hAm1 : |A - 1| ≤ A := by rw [abs_of_nonneg (by linarith : 0 ≤ A - 1)]; linarith
  have hBm1 : |B - 1| ≤ B := by rw [abs_of_nonneg (by linarith : 0 ≤ B - 1)]; linarith
  have he : (returnIntegerPrefix r : ℝ) = (B - 1) * IA + (A - 1) * (IB - 90) := by
    simp [returnIntegerPrefix, A, B, IA, IB]
  rw [he]
  change |(B - 1) * IA + (A - 1) * (IB - 90)| ≤ 0x16e * A * B
  calc
    _ ≤ |(B - 1) * IA| + |(A - 1) * (IB - 90)| := abs_add_le _ _
    _ ≤ B * (0x9c * A) + A * (0xd2 * B) := by
      rw [abs_mul, abs_mul]
      exact add_le_add (mul_le_mul hBm1 hIA (abs_nonneg _) (by linarith))
        (mul_le_mul hAm1 hIB90 (abs_nonneg _) (by linarith))
    _ = 0x16e * A * B := by ring

def returnIntegerPrefix_abs_le_exp (r : ℕ) :
    |(returnIntegerPrefix r : ℝ)| ≤ 0x16e * Real.exp (2 * returnScale r) := by
  calc
    _ ≤ 0x16e * (4 : ℝ) ^ (rotationReturns r).q * (3 : ℝ) ^ (rotationReturns r).p.toNat :=
      returnIntegerPrefix_abs_le_power_product r
    _ = 0x16e * ((4 : ℝ) ^ (rotationReturns r).q * (3 : ℝ) ^ (rotationReturns r).p.toNat) := by ring
    _ ≤ 0x16e * Real.exp (2 * returnScale r) :=
      mul_le_mul_of_nonneg_left (returnPrefix_power_product_bound r) (by norm_num)

noncomputable def returnClearedIntegerHead (z : ℚ) (r : ℕ) : ℤ :=
  z.num * (((4 : ℤ) ^ (rotationReturns r).q - 1) *
      ((3 : ℤ) ^ (rotationReturns r).p.toNat - 1)) -
    (z.den : ℤ) * returnIntegerPrefix r

def returnClearedIntegerHead_cast (z : ℚ) (r : ℕ) :
    (returnClearedIntegerHead z r : ℝ) = (z.den : ℝ) *
      (((4 : ℝ) ^ (rotationReturns r).q - 1) *
        ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) * (z : ℝ) - returnIntegerPrefix r) := by
  have hden : (z.den : ℝ) ≠ 0 := by exact_mod_cast z.den_nz
  have hnum : (z.num : ℝ) = (z.den : ℝ) * (z : ℝ) := by
    rw [Rat.cast_def]
    field_simp
  unfold returnClearedIntegerHead
  push_cast
  rw [hnum]
  ring

def returnClearedIntegerHead_abs_le_exp (z : ℚ) (r : ℕ) :
    |(returnClearedIntegerHead z r : ℝ)| ≤
      (|(z.num : ℝ)| + 0x16e * (z.den : ℝ)) * Real.exp (2 * returnScale r) := by
  let A : ℝ := (4 : ℝ) ^ (rotationReturns r).q
  let B : ℝ := (3 : ℝ) ^ (rotationReturns r).p.toNat
  have hA1 : 1 ≤ A := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 4)
  have hB1 : 1 ≤ B := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 3)
  have hAm1 : |A - 1| ≤ A := by rw [abs_of_nonneg (by linarith : 0 ≤ A - 1)]; linarith
  have hBm1 : |B - 1| ≤ B := by rw [abs_of_nonneg (by linarith : 0 ≤ B - 1)]; linarith
  have hprod : |(A - 1) * (B - 1)| ≤ Real.exp (2 * returnScale r) := by
    rw [abs_mul]
    exact (mul_le_mul hAm1 hBm1 (abs_nonneg _) (by linarith)).trans
      (returnPrefix_power_product_bound r)
  have hden : 0 ≤ (z.den : ℝ) := Nat.cast_nonneg _
  have he : (returnClearedIntegerHead z r : ℝ) =
      (z.num : ℝ) * ((A - 1) * (B - 1)) - (z.den : ℝ) * (returnIntegerPrefix r : ℝ) := by
    simp [returnClearedIntegerHead, A, B]
  rw [he, sub_eq_add_neg]
  calc
    _ ≤ |(z.num : ℝ) * ((A - 1) * (B - 1))| +
        |-((z.den : ℝ) * (returnIntegerPrefix r : ℝ))| := abs_add_le _ _
    _ = |(z.num : ℝ)| * |(A - 1) * (B - 1)| +
        (z.den : ℝ) * |(returnIntegerPrefix r : ℝ)| := by
      simp only [abs_neg, abs_mul, abs_of_nonneg hden]
    _ ≤ |(z.num : ℝ)| * Real.exp (2 * returnScale r) +
        (z.den : ℝ) * (0x16e * Real.exp (2 * returnScale r)) :=
      add_le_add (mul_le_mul_of_nonneg_left hprod (abs_nonneg _))
        (mul_le_mul_of_nonneg_left (returnIntegerPrefix_abs_le_exp r) hden)
    _ = _ := by ring

def returnClearedIntegerHead_eventually_exp (z : ℚ) :
    ∀ᶠ r in atTop, |(returnClearedIntegerHead z r : ℝ)| ≤ Real.exp (3 * returnScale r) := by
  let C : ℝ := |(z.num : ℝ)| + 0x16e * (z.den : ℝ)
  have hden : 0 < (z.den : ℝ) := by exact_mod_cast z.den_pos
  have hC : 0 < C := by dsimp [C]; positivity
  have hlarge := returnScale_tendsto.eventually (eventually_ge_atTop (Real.log C))
  filter_upwards [hlarge] with r hr
  calc
    _ ≤ C * Real.exp (2 * returnScale r) := returnClearedIntegerHead_abs_le_exp z r
    _ = Real.exp (Real.log C + 2 * returnScale r) := by rw [Real.exp_add, Real.exp_log hC]
    _ ≤ Real.exp (3 * returnScale r) := Real.exp_le_exp.mpr (by linarith)

def returnClearedIntegerHead_of_rational_density (h : ¬Irrational explicitDensity) :
    ∃ z : ℚ, (z : ℝ) = 0xb4 * explicitDensity - 32 ∧
      (∀ r : ℕ, (returnClearedIntegerHead z r : ℝ) = (z.den : ℝ) *
        (((4 : ℝ) ^ (rotationReturns r).q - 1) *
          ((3 : ℝ) ^ (rotationReturns r).p.toNat - 1) *
            (0xb4 * explicitDensity - 32) - returnIntegerPrefix r)) ∧
      ∀ᶠ r in atTop, |(returnClearedIntegerHead z r : ℝ)| ≤ Real.exp (3 * returnScale r) := by
  obtain ⟨a, ha⟩ := exists_rat_of_not_irrational h
  let z : ℚ := 0xb4 * a - 32
  have hz : (z : ℝ) = 0xb4 * explicitDensity - 32 := by
    dsimp [z]
    push_cast
    rw [ha]
  refine ⟨z, hz, ?_, returnClearedIntegerHead_eventually_exp z⟩
  intro r
  rw [returnClearedIntegerHead_cast, hz]


end Bounty

end SubmissionComponent_ReturnPrefixBounds

/- Component ReturnCoordinateHeight; SHA256 d1c928de757918ab5bc37515261b495ee6767b291ae8936cd9f44b6e380566e1 -/
section SubmissionComponent_ReturnCoordinateHeight
/- Common denominators and projective height bounds for return coordinates. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable section

def returnHeadUnit (r : ℕ) (j : Fin 4) : ℚ :=
  if j = 0 then (4 : ℚ) ^ (rotationReturns r).q * (3 : ℚ) ^ (rotationReturns r).p.toNat
  else if j = 1 then (4 : ℚ) ^ (rotationReturns r).q
  else if j = 2 then (3 : ℚ) ^ (rotationReturns r).p.toNat else 1

def returnHeadFourExponent (r : ℕ) (j : Fin 4) : ℤ :=
  if j < 2 then ((rotationReturns r).q : ℤ) else 0

def returnHeadThreeExponent (r : ℕ) (j : Fin 4) : ℤ :=
  if j = 0 ∨ j = 2 then ((rotationReturns r).p.toNat : ℤ) else 0

def returnHeadUnit_pos (r : ℕ) (j : Fin 4) : 0 < returnHeadUnit r j := by
  unfold returnHeadUnit
  split_ifs <;> positivity

def returnHeadUnit_ne_zero (r : ℕ) (j : Fin 4) : returnHeadUnit r j ≠ 0 :=
  ne_of_gt (returnHeadUnit_pos r j)

def returnHeadUnit_eq_four_three_zpow (r : ℕ) (j : Fin 4) :
    returnHeadUnit r j = (4 : ℚ) ^ returnHeadFourExponent r j *
      (3 : ℚ) ^ returnHeadThreeExponent r j := by
  dsimp only [returnHeadUnit, returnHeadFourExponent, returnHeadThreeExponent]
  generalize hp : (rotationReturns r).p.toNat = p
  fin_cases j <;>
    norm_num [returnHeadUnit, returnHeadFourExponent, returnHeadThreeExponent,
      Fin.ext_iff, Fin.lt_def]

def returnHeadUnit_primeMonomial (r : ℕ) (j : Fin 4) :
    returnHeadUnit r j = rationalPrimeMonomial (2 * returnHeadFourExponent r j)
      (returnHeadThreeExponent r j) 0 := by
  rw [returnHeadUnit_eq_four_three_zpow, rational_four_three_monomial]

def returnHeadUnit_den (r : ℕ) (j : Fin 4) : (returnHeadUnit r j).den = 1 := by
  fin_cases j <;> simp [returnHeadUnit, Fin.ext_iff]
  have he : (4 : ℚ) ^ (rotationReturns r).q * (3 : ℚ) ^ (rotationReturns r).p.toNat =
      ((4 ^ (rotationReturns r).q * 3 ^ (rotationReturns r).p.toNat : ℕ) : ℚ) := by
    push_cast
    rfl
  rw [he]
  exact Rat.den_natCast _

/-- A finite integer tuple has projective height at most any common absolute-value bound at least one. -/
def rational_integer_tuple_height_le {ι : Type*} [Fintype ι]
    (x : ι → ℤ) {B : ℝ} (hB : 1 ≤ B) (hx : ∀ i, |(x i : ℝ)| ≤ B) :
    Height.mulHeight (fun i => (x i : ℚ)) ≤ B := by
  classical
  let y : Option ι → ℤ := fun j => match j with | none => 1 | some i => x i
  have hg : Finset.univ.gcd y = 1 := by
    rw [← Finset.insert_erase (Finset.mem_univ (none : Option ι)), Finset.gcd_insert]
    simp [y]
  have hh := Rat.mulHeight_eq_max_abs_of_gcd_eq_one hg
  rw [Finite.map_iSup_of_monotone _ Int.cast_mono] at hh
  simp only [Int.cast_abs] at hh
  have hcomp : Height.mulHeight (fun i => (x i : ℚ)) ≤
      Height.mulHeight (fun j : Option ι => (y j : ℚ)) := by
    simpa only [Function.comp_def, y] using
      Height.mulHeight_comp_le (some : ι → Option ι) (fun j : Option ι => (y j : ℚ))
  apply hcomp.trans
  rw [show Height.mulHeight (fun j : Option ι => (y j : ℚ)) =
      ⨆ j : Option ι, |(y j : ℝ)| by exact hh]
  apply ciSup_le
  intro j
  cases j with
  | none => simpa [y] using hB
  | some i => simpa [y] using hx i

def returnDenominatorExponent (r k : ℕ) (b : ℝ) : ℕ :=
  ⌊((k : ℝ) + 1) * returnScale r / Real.log b⌋₊

def returnCommonDenominator (r k : ℕ) : ℕ :=
  4 ^ returnDenominatorExponent r k 4 * 3 ^ returnDenominatorExponent r k 3

def returnCommonDenominator_pos (r k : ℕ) : 0 < returnCommonDenominator r k := by
  unfold returnCommonDenominator
  positivity

def returnDenominatorExponent_bound (r k : ℕ) {b : ℝ} (hb : 1 < b) :
    (returnDenominatorExponent r k b : ℝ) * Real.log b ≤ ((k : ℝ) + 1) * returnScale r := by
  have hl : 0 < Real.log b := Real.log_pos hb
  have hL := returnScale_pos r
  apply (le_div_iff₀ hl).mp
  exact Nat.floor_le (by positivity)

def returnCommonDenominator_bound (r k : ℕ) :
    (returnCommonDenominator r k : ℝ) ≤ Real.exp ((2 * (k : ℝ) + 2) * returnScale r) := by
  have h4 := returnDenominatorExponent_bound r k (by norm_num : (1 : ℝ) < 4)
  have h3 := returnDenominatorExponent_bound r k (by norm_num : (1 : ℝ) < 3)
  have he4 : Real.exp ((returnDenominatorExponent r k 4 : ℝ) * Real.log 4) =
      (4 : ℝ) ^ returnDenominatorExponent r k 4 := by
    rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 4)]
  have he3 : Real.exp ((returnDenominatorExponent r k 3 : ℝ) * Real.log 3) =
      (3 : ℝ) ^ returnDenominatorExponent r k 3 := by
    rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 3)]
  simp only [returnCommonDenominator, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
  rw [← he4, ← he3, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  nlinarith

def rational_nat_div_den_dvd (a b : ℕ) : ((a : ℚ) / b).den ∣ b := by
  have hh : ((((a : ℚ) / b).den : ℤ)) ∣ (b : ℤ) := by
    simpa only [Rat.divInt_eq_div, Int.cast_natCast] using Rat.den_dvd (a : ℤ) (b : ℤ)
  exact Int.natCast_dvd_natCast.mp hh

def returnRationalUnit_den_dvd_base_power (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    (returnRationalUnit r i n).den ∣ (if i.1 < 2 then 4 ^ n else 3 ^ n) := by
  rcases i with ⟨j, l⟩
  fin_cases j
  · simpa [returnRationalUnit, Fin.ext_iff, Fin.lt_def] using
      rational_nat_div_den_dvd (3 ^ (rotationReturns r).p.toNat) (4 ^ n)
  · simpa [returnRationalUnit, Fin.ext_iff, Fin.lt_def] using
      rational_nat_div_den_dvd 1 (4 ^ n)
  · simpa [returnRationalUnit, Fin.ext_iff, Fin.lt_def] using
      rational_nat_div_den_dvd (4 ^ (rotationReturns r).q) (3 ^ n)
  · simpa [returnRationalUnit, Fin.ext_iff, Fin.lt_def] using
      rational_nat_div_den_dvd 1 (3 ^ n)

def returnRationalUnit_den_dvd_common (r k : ℕ) (T : ℝ) (i : ReturnEventFamily)
    {n : ℕ} (hT : T ≤ (k : ℝ) * returnScale r)
    (hn : n ∈ returnTruncationIndices r T i) :
    (returnRationalUnit r i n).den ∣ returnCommonDenominator r k := by
  have he := returnTruncationIndices_exponent_le r k T i hT hn
  have hd := returnRationalUnit_den_dvd_base_power r i n
  by_cases hi : i.1 < 2
  · simp only [returnEventStep, if_pos hi] at he
    simp only [if_pos hi] at hd
    have hnM : n ≤ returnDenominatorExponent r k 4 :=
      Nat.le_floor ((le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 4))).mpr he)
    exact hd.trans ((pow_dvd_pow 4 hnM).trans (dvd_mul_right _ _))
  · simp only [returnEventStep, if_neg hi] at he
    simp only [if_neg hi] at hd
    have hnM : n ≤ returnDenominatorExponent r k 3 :=
      Nat.le_floor ((le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 3))).mpr he)
    exact hd.trans ((pow_dvd_pow 3 hnM).trans (dvd_mul_left _ _))

/-- Any enumeration of the integer prefix, four heads, and actual retained units is permitted. -/
def IsReturnCoordinate (r : ℕ) (T : ℝ) (x : ℚ) : Prop :=
  x = (returnIntegerPrefix r : ℚ) ∨ (∃ j : Fin 4, x = returnHeadUnit r j) ∨
    ∃ i n, n ∈ returnTruncationIndices r T i ∧ x = returnRationalUnit r i n

def returnCoordinate_den_dvd_common (r k : ℕ) (T : ℝ) {x : ℚ}
    (hT : T ≤ (k : ℝ) * returnScale r) (hx : IsReturnCoordinate r T x) :
    x.den ∣ returnCommonDenominator r k := by
  rcases hx with rfl | ⟨j, rfl⟩ | ⟨i, n, hn, rfl⟩
  · simpa only [Rat.den_intCast] using one_dvd (returnCommonDenominator r k)
  · rw [returnHeadUnit_den]
    exact one_dvd _
  · exact returnRationalUnit_den_dvd_common r k T i hT hn

def returnHeadUnit_abs_le_exp (r : ℕ) (j : Fin 4) :
    |(returnHeadUnit r j : ℝ)| ≤ Real.exp (2 * returnScale r) := by
  have hpos : 0 < (returnHeadUnit r j : ℝ) := by exact_mod_cast returnHeadUnit_pos r j
  rw [abs_of_pos hpos]
  have hh := returnPrefix_base_power_bounds r
  have hscale : Real.exp (returnScale r) ≤ Real.exp (2 * returnScale r) :=
    Real.exp_le_exp.mpr (by linarith [returnScale_pos r])
  have hone : 1 ≤ Real.exp (2 * returnScale r) :=
    Real.one_le_exp_iff.mpr (by linarith [returnScale_pos r])
  fin_cases j
  · simpa [returnHeadUnit, Fin.ext_iff] using returnPrefix_power_product_bound r
  · simpa [returnHeadUnit, Fin.ext_iff] using hh.1.trans hscale
  · simpa [returnHeadUnit, Fin.ext_iff] using hh.2.trans hscale
  · simpa [returnHeadUnit, Fin.ext_iff] using hone

def returnCoordinate_abs_le_exp (r : ℕ) (T : ℝ) {x : ℚ}
    (hx : IsReturnCoordinate r T x) :
    |(x : ℝ)| ≤ 0x16e * Real.exp (2 * returnScale r) := by
  rcases hx with rfl | ⟨j, rfl⟩ | ⟨i, n, hn, rfl⟩
  · simpa using returnIntegerPrefix_abs_le_exp r
  · have hh := returnHeadUnit_abs_le_exp r j
    nlinarith [Real.exp_pos (2 * returnScale r)]
  · rw [returnRationalUnit_cast, abs_of_pos (Real.exp_pos _)]
    have hv := ((mem_returnTruncationIndices r T i n).mp hn).1
    have hh : Real.exp (-returnEventTime r i n) ≤ Real.exp (2 * returnScale r) := by
      apply Real.exp_le_exp.mpr
      linarith [returnEventTime_gt_neg_scale r i hv, returnScale_pos r]
    nlinarith [Real.exp_pos (2 * returnScale r)]

def rational_clear_of_den_dvd {x : ℚ} {D : ℕ} (hd : x.den ∣ D) :
    ∃ a : ℤ, (D : ℚ) * x = a := by
  obtain ⟨m, hm⟩ := hd
  refine ⟨(m : ℤ) * x.num, ?_⟩
  rw [hm, Nat.cast_mul, mul_right_comm, Rat.den_mul_eq_num]
  push_cast
  ring

def rational_tuple_height_le_of_den_dvd {ι : Type*} [Fintype ι]
    (x : ι → ℚ) {D : ℕ} (hD : 0 < D) (hd : ∀ i, (x i).den ∣ D)
    {B : ℝ} (hB : 1 ≤ B) (hx : ∀ i, |(D : ℝ) * (x i : ℝ)| ≤ B) :
    Height.mulHeight x ≤ B := by
  classical
  choose y hy using fun i => rational_clear_of_den_dvd (hd i)
  have hh : Height.mulHeight (fun i => (y i : ℚ)) ≤ B := by
    apply rational_integer_tuple_height_le y hB
    intro i
    have he : (y i : ℝ) = (D : ℝ) * (x i : ℝ) := by exact_mod_cast (hy i).symm
    rw [he]
    exact hx i
  have hfun : (fun i => (y i : ℚ)) = (D : ℚ) • x := by
    funext i
    exact (hy i).symm
  rw [hfun, Height.mulHeight_smul_eq_mulHeight x (by exact_mod_cast hD.ne')] at hh
  exact hh

def returnCoordinate_cleared_abs_le (r k : ℕ) (T : ℝ) {x : ℚ}
    (hx : IsReturnCoordinate r T x) :
    |(returnCommonDenominator r k : ℝ) * (x : ℝ)| ≤
      0x16e * Real.exp ((2 * (k : ℝ) + 4) * returnScale r) := by
  rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
  calc
    _ ≤ Real.exp ((2 * (k : ℝ) + 2) * returnScale r) *
        (0x16e * Real.exp (2 * returnScale r)) :=
      mul_le_mul (returnCommonDenominator_bound r k) (returnCoordinate_abs_le_exp r T hx)
        (abs_nonneg _) (Real.exp_pos _).le
    _ = 0x16e * Real.exp ((2 * (k : ℝ) + 4) * returnScale r) := by
      rw [mul_left_comm, ← Real.exp_add]
      congr 1
      ring

/-- The full tuple may use any finite actual-label index type; no padding or repeated units is needed. -/
def returnCoordinateHeight_bound {ι : Type*} [Fintype ι]
    (r k : ℕ) (T : ℝ) (x : ι → ℚ)
    (hT : T ≤ (k : ℝ) * returnScale r) (hx : ∀ i, IsReturnCoordinate r T (x i)) :
    Height.mulHeight x ≤ 0x16e * Real.exp ((2 * (k : ℝ) + 4) * returnScale r) := by
  have hL := returnScale_pos r
  have hone : 1 ≤ Real.exp ((2 * (k : ℝ) + 4) * returnScale r) :=
    Real.one_le_exp_iff.mpr (by positivity)
  apply rational_tuple_height_le_of_den_dvd x (returnCommonDenominator_pos r k)
    (fun i => returnCoordinate_den_dvd_common r k T hT (hx i)) (by linarith)
  exact fun i => returnCoordinate_cleared_abs_le r k T (hx i)

def returnCoordinateHeight_eventually :
    ∀ᶠ r in atTop, ∀ (k : ℕ) (T : ℝ) (ι : Type) [Fintype ι] (x : ι → ℚ),
      T ≤ (k : ℝ) * returnScale r → (∀ i, IsReturnCoordinate r T (x i)) →
      Height.mulHeight x ≤ Real.exp ((2 * (k : ℝ) + 5) * returnScale r) := by
  have hlarge := returnScale_tendsto.eventually (eventually_ge_atTop (Real.log 0x16e))
  filter_upwards [hlarge] with r hr k T ι inst x hT hx
  calc
    _ ≤ 0x16e * Real.exp ((2 * (k : ℝ) + 4) * returnScale r) :=
      returnCoordinateHeight_bound r k T x hT hx
    _ = Real.exp (Real.log 0x16e + (2 * (k : ℝ) + 4) * returnScale r) := by
      rw [Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 0x16e)]
    _ ≤ Real.exp ((2 * (k : ℝ) + 5) * returnScale r) := Real.exp_le_exp.mpr (by nlinarith)

def returnCoordinateHeight_eventually_eleven :
    ∀ᶠ r in atTop, ∀ (T : ℝ) (ι : Type) [Fintype ι] (x : ι → ℚ),
      T ≤ 11 * returnScale r → (∀ i, IsReturnCoordinate r T (x i)) →
      Height.mulHeight x ≤ Real.exp (27 * returnScale r) := by
  filter_upwards [returnCoordinateHeight_eventually] with r hr T ι inst x hT hx
  have hh := hr 11 T ι x hT hx
  norm_num at hh
  exact hh


end
end Bounty

end SubmissionComponent_ReturnCoordinateHeight

/- Component ReturnFiniteApproximation; SHA256 7ba0967cb028c8f6e0c6f6a53189afe3d3b8d339157291c83a5b8b0bdf8049ea -/
section SubmissionComponent_ReturnFiniteApproximation
/- Exact finite rational linear forms underlying the two return approximations. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable section

abbrev ReturnTailLabel (r : ℕ) (T : ℝ) :=
  Σ i : ReturnEventFamily, {n : ℕ // n ∈ returnTruncationIndices r T i}

abbrev ReturnApproximationLabel (r : ℕ) (T : ℝ) := Fin 4 ⊕ ReturnTailLabel r T

def returnApproximationUnit (r : ℕ) (T : ℝ) : ReturnApproximationLabel r T → ℚ :=
  Sum.elim (returnHeadUnit r) (fun a => returnRationalUnit r a.1 a.2.1)

def returnApproximationCoefficient (z : ℚ) (r : ℕ) (T : ℝ) :
    ReturnApproximationLabel r T → ℚ :=
  Sum.elim (fun j => if j = 0 ∨ j = 3 then z else -z)
    (fun a => -(returnEventCoefficient a.1 : ℚ))

def returnCoefficientPalette (z : ℚ) : Finset ℚ :=
  {z, -z} ∪ Finset.univ.image (fun i : ReturnEventFamily => -(returnEventCoefficient i : ℚ))

def returnApproximationUnit_pos (r : ℕ) (T : ℝ) (i : ReturnApproximationLabel r T) :
    0 < returnApproximationUnit r T i := by
  cases i with
  | inl j => exact returnHeadUnit_pos r j
  | inr a => exact returnRationalUnit_pos r a.1 a.2.1

def returnApproximationCoefficient_mem (z : ℚ) (r : ℕ) (T : ℝ)
    (i : ReturnApproximationLabel r T) :
    returnApproximationCoefficient z r T i ∈ returnCoefficientPalette z := by
  classical
  cases i with
  | inl j =>
    change (if j = 0 ∨ j = 3 then z else -z) ∈ _
    split_ifs <;> simp [returnCoefficientPalette]
  | inr a =>
    apply Finset.mem_union_right
    exact Finset.mem_image.mpr ⟨a.1, Finset.mem_univ _, rfl⟩

def returnApproximationLabel_card (r k : ℕ) (T : ℝ)
    (hT : T ≤ (k : ℝ) * returnScale r) :
    Fintype.card (ReturnApproximationLabel r T) ≤ 4 + 16 * (2 * k + 3) := by
  classical
  have hh := returnTruncationIndices_total_card r k T hT
  simpa [ReturnApproximationLabel, ReturnTailLabel, Fintype.card_sigma] using
    Nat.add_le_add_left hh 4

def returnHeadUnit_one_le (r : ℕ) (j : Fin 4) : (1 : ℚ) ≤ returnHeadUnit r j := by
  have h4 : (1 : ℚ) ≤ 4 ^ (rotationReturns r).q := one_le_pow₀ (by norm_num)
  have h3 : (1 : ℚ) ≤ 3 ^ (rotationReturns r).p.toNat := one_le_pow₀ (by norm_num)
  unfold returnHeadUnit
  split_ifs
  · exact one_le_mul_of_one_le_of_one_le h4 h3
  · exact h4
  · exact h3
  · rfl

def returnApproximationUnit_lower (r : ℕ) (T : ℝ) (hT : 0 ≤ T)
    (i : ReturnApproximationLabel r T) :
    Real.exp (-T) ≤ (returnApproximationUnit r T i : ℝ) := by
  cases i with
  | inl j =>
    have hh : (1 : ℝ) ≤ (returnHeadUnit r j : ℝ) := by exact_mod_cast returnHeadUnit_one_le r j
    have he : Real.exp (-T) ≤ 1 := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by linarith)
    exact he.trans hh
  | inr a =>
    have ht := ((mem_returnTruncationIndices r T a.1 a.2.1).mp a.2.2).2
    change Real.exp (-T) ≤ (returnRationalUnit r a.1 a.2.1 : ℝ)
    rw [returnRationalUnit_cast]
    exact Real.exp_le_exp.mpr (by linarith)

def returnApproximation_linear_form (z : ℚ) (r : ℕ) (T : ℝ) :
    (∑ i : ReturnApproximationLabel r T,
      returnApproximationCoefficient z r T i * returnApproximationUnit r T i) -
        (returnIntegerPrefix r : ℚ) =
      ((4 : ℚ) ^ (rotationReturns r).q - 1) *
        ((3 : ℚ) ^ (rotationReturns r).p.toNat - 1) * z -
          returnIntegerPrefix r - returnRationalTruncation r T := by
  classical
  have htail : (∑ a : ReturnTailLabel r T,
      (returnEventCoefficient a.1 : ℚ) * returnRationalUnit r a.1 a.2.1) =
      returnRationalTruncation r T := by
    simp only [ReturnTailLabel, returnRationalTruncation, Fintype.sum_sigma,
      Finset.univ_eq_attach]
    apply Finset.sum_congr rfl
    intro i _
    exact Finset.sum_attach (returnTruncationIndices r T i)
      (fun n : ℕ => (returnEventCoefficient i : ℚ) * returnRationalUnit r i n)
  rw [Fintype.sum_sum_type]
  change (∑ j : Fin 4, (if j = 0 ∨ j = 3 then z else -z) * returnHeadUnit r j) +
    (∑ a : ReturnTailLabel r T, -(returnEventCoefficient a.1 : ℚ) *
      returnRationalUnit r a.1 a.2.1) - _ = _
  simp_rw [neg_mul]
  rw [Finset.sum_neg_distrib, htail]
  simp only [Fin.sum_univ_four]
  norm_num [returnHeadUnit, Fin.ext_iff]
  ring

def returnApproximation_error (z : ℚ)
    (hz : (z : ℝ) = 0xb4 * explicitDensity - 32) :
    ∀ᶠ r in atTop, ∀ T : ℝ,
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) →
      |(((∑ i : ReturnApproximationLabel r T,
        returnApproximationCoefficient z r T i * returnApproximationUnit r T i) -
          (returnIntegerPrefix r : ℚ) : ℚ) : ℝ)| ≤ Real.exp (-T - returnScale r / 0xc8) := by
  filter_upwards [returnDensity_truncation_exponential] with r hr T hgap
  rw [returnApproximation_linear_form]
  push_cast
  rw [hz, returnRationalTruncation_cast]
  exact hr T hgap


end

end Bounty

end SubmissionComponent_ReturnFiniteApproximation

/- Component EventIndexDivergence; SHA256 9afd2b78a6efa14f404f05b116d19adef02dabe3a21c493ab059e1f73b4e3bed -/
section SubmissionComponent_EventIndexDivergence
/- Uniform disappearance of bounded indices and separation between distinct jump orbits. -/

open Filter
open scoped Topology

namespace Bounty

def two_forward_visits_distance_lt {α t u δ : ℝ} {i j : ℤ}
    (hi : 1 - δ ≤ Int.fract ((i : ℝ) * α - t))
    (hj : 1 - δ ≤ Int.fract ((j : ℝ) * α - u)) :
    integerDistance (((j - i : ℤ) : ℝ) * α - (u - t)) < δ := by
  let x : ℝ := (i : ℝ) * α - t
  let y : ℝ := (j : ℝ) * α - u
  have he : (((j - i : ℤ) : ℝ) * α - (u - t)) -
      ((⌊y⌋ - ⌊x⌋ : ℤ) : ℝ) = Int.fract y - Int.fract x := by
    change _ = (y - (⌊y⌋ : ℝ)) - (x - (⌊x⌋ : ℝ))
    dsimp only [x, y]
    push_cast
    ring
  have hh := integerDistance_le_abs (((j - i : ℤ) : ℝ) * α - (u - t)) (⌊y⌋ - ⌊x⌋)
  rw [he] at hh
  have hs : |Int.fract y - Int.fract x| < δ := by
    have hxu := Int.fract_lt_one x
    have hyu := Int.fract_lt_one y
    rw [abs_lt]
    constructor <;> linarith
  exact hh.trans_lt hs

def distinct_orbit_forward_visits_separate {α t u : ℝ} {δ : ℕ → ℝ}
    (hδ : Tendsto δ atTop (nhds 0))
    (horbit : ∀ h k : ℤ, (h : ℝ) * α - (u - t) ≠ k) (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : ℤ,
      1 - δ r ≤ Int.fract ((i : ℝ) * α - t) →
      1 - δ r ≤ Int.fract ((j : ℝ) * α - u) → (M : ℤ) < |j - i| := by
  have hsmall : ∀ᶠ r in atTop, ∀ h ∈ Finset.Icc (-(M : ℤ)) M,
      δ r < integerDistance ((h : ℝ) * α - (u - t)) := by
    apply (eventually_all_finset _).mpr
    intro h _
    exact hδ.eventually (gt_mem_nhds (integerDistance_pos (horbit h)))
  filter_upwards [hsmall] with r hr i j hi hj
  by_contra hh
  have habs : |j - i| ≤ (M : ℤ) := le_of_not_gt hh
  have hmem : j - i ∈ Finset.Icc (-(M : ℤ)) M := by
    simpa only [Finset.mem_Icc, abs_le] using habs
  have hlarge := hr (j - i) hmem
  have hclose := two_forward_visits_distance_lt hi hj
  linarith

def jumpVisit4_distinct_orbits_separate {i j : Fin 4} (hij : i ≠ j) (M : ℕ) :
    ∀ᶠ r in atTop, ∀ m n : ℤ,
      jumpVisit4 r i m ≠ 0 → jumpVisit4 r j n ≠ 0 → (M : ℤ) < |n - m| := by
  have hh := distinct_orbit_forward_visits_separate returnError_tendsto
    (jumpOrbits4_distinct hij) M
  filter_upwards [hh] with r hr m n hm hn
  apply hr m n
  · by_contra hx
    simp only [jumpVisit4, forwardJump, if_neg hx, ne_eq, not_true_eq_false] at hm
  · by_contra hx
    simp only [jumpVisit4, forwardJump, if_neg hx, ne_eq, not_true_eq_false] at hn

def jumpVisit3_distinct_orbits_separate {i j : Fin 4} (hij : i ≠ j) (M : ℕ) :
    ∀ᶠ r in atTop, ∀ m n : ℤ,
      jumpVisit3 r i m ≠ 0 → jumpVisit3 r j n ≠ 0 → (M : ℤ) < |n - m| := by
  have hh := distinct_orbit_visits_separate reciprocal_returnError_tendsto
    (jumpOrbits3_distinct hij) M
  filter_upwards [hh] with r hr m n hm hn
  apply hr m n
  · by_contra hx
    simp only [mul_one_div] at hx
    simp only [jumpVisit3, backwardJump, if_neg hx, ne_eq, not_true_eq_false] at hm
  · by_contra hx
    simp only [mul_one_div] at hx
    simp only [jumpVisit3, backwardJump, if_neg hx, ne_eq, not_true_eq_false] at hn

def returnEventVisit_fixed_disappears (i : ReturnEventFamily) (n : ℕ) :
    ∀ᶠ r in atTop, ¬ returnEventVisit r i n := by
  by_cases hn : n = 0
  · subst n
    exact Eventually.of_forall (fun _ h => (Nat.lt_irrefl 0) h.1)
  have hnZ : (n : ℤ) ≠ 0 := by exact_mod_cast hn
  by_cases hi : i.1 < 2
  · have hh := jumpVisit4_fixed_eventually_zero (i := i.2) (n := n) (Or.inr hnZ)
    filter_upwards [hh] with r hr hv
    have hv' : jumpVisit4 r i.2 n ≠ 0 := by simpa only [if_pos hi] using hv.2
    exact hv' hr
  · have hh := jumpVisit3_fixed_eventually_zero (i := i.2) (n := n) (Or.inr hnZ)
    filter_upwards [hh] with r hr hv
    have hv' : jumpVisit3 r i.2 n ≠ 0 := by simpa only [if_neg hi] using hv.2
    exact hv' hr

def returnEventVisit_indices_diverge (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i n, returnEventVisit r i n → M < n := by
  have hh : ∀ᶠ r in atTop, ∀ i ∈ (Finset.univ : Finset ReturnEventFamily),
      ∀ n ∈ Finset.range (M + 1), ¬ returnEventVisit r i n := by
    apply (eventually_all_finset _).mpr
    intro i _
    apply (eventually_all_finset _).mpr
    intro n _
    exact returnEventVisit_fixed_disappears i n
  filter_upwards [hh] with r hr i n hv
  by_contra hn
  exact hr i (Finset.mem_univ i) n (Finset.mem_range.mpr (by omega)) hv


end Bounty

end SubmissionComponent_EventIndexDivergence

/- Component ReturnVisitCoverage; SHA256 193c806ef7b5f7bfc91486c7022b3cc923da025b28eecc7c7731cf9ee63d7e1a -/
section SubmissionComponent_ReturnVisitCoverage
/- Positive jump visits cover bounded index blocks and logarithmic intervals. -/

open Filter
open scoped Topology

namespace Bounty

def forwardJump_eq_one_of_shifted_fract {δ t x : ℝ} (hδ : 0 ≤ δ)
    (h : Int.fract (x - (t - δ)) < δ) : forwardJump δ t x = 1 := by
  classical
  have hf : 1 - δ ≤ Int.fract (x - t) := by
    by_contra hh
    have hu : Int.fract (x - t) + δ < 1 := by linarith
    have he : x - (t - δ) = (Int.fract (x - t) + δ) + (⌊x - t⌋ : ℝ) := by
      rw [Int.fract]
      ring
    have hfract : Int.fract (x - (t - δ)) = Int.fract (x - t) + δ := by
      rw [he, Int.fract_add_intCast]
      exact Int.fract_eq_self.mpr ⟨by linarith [Int.fract_nonneg (x - t)], hu⟩
    rw [hfract] at h
    linarith [Int.fract_nonneg (x - t)]
  exact if_pos hf

def jumpVisit4_covered_block (r : ℕ) (i : Fin 4) (N : ℕ) :
    ∃ n : ℕ, N ≤ n ∧ n < N + (rotationReturns r).q + (rotationReturns r).Q ∧
      jumpVisit4 r i n = 1 := by
  obtain ⟨n, hlo, hhi, hv⟩ := return_pair_arc_covered_block
    (rotationReturns r).q_pos (rotationReturns r).Q_pos
    (rotationReturns r).lower_pos (rotationReturns r).upper_pos
    (rotationReturns r).upper_lt_lower.le (jumpCoordinate4 i - returnError r) N
  refine ⟨n, hlo, hhi, ?_⟩
  simpa only [jumpVisit4, Int.cast_natCast] using
    forwardJump_eq_one_of_shifted_fract (returnError_pos r).le hv

def returnVisitBlock_log_lt (r : ℕ) :
    (((rotationReturns r).q + (rotationReturns r).Q : ℕ) : ℝ) * Real.log 4 <
      2 * returnScale r := by
  have hh := (rotationReturns r).log_bounds
  rw [Nat.cast_add, add_mul]
  unfold returnScale
  linarith [hh.2.1, hh.2.2.1]

def jumpVisit4_log_covered (r : ℕ) (i : Fin 4) (T : ℝ)
    (hT : 2 * returnScale r < T) :
    ∃ n : ℕ, 0 < n ∧ T - 2 * returnScale r < (n : ℝ) * Real.log 4 ∧
      (n : ℝ) * Real.log 4 < T ∧ jumpVisit4 r i n = 1 := by
  let K : ℕ := (rotationReturns r).q + (rotationReturns r).Q
  let G : ℝ := (K : ℝ) * Real.log 4
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hG : G < 2 * returnScale r := returnVisitBlock_log_lt r
  let a : ℝ := (T - G) / Real.log 4
  have ha : 0 < a := div_pos (by linarith) hlog
  let N : ℕ := ⌈a⌉₊
  obtain ⟨n, hnlo, hnhi, hv⟩ := jumpVisit4_covered_block r i N
  have hNpos : 0 < N := Nat.ceil_pos.mpr ha
  have hNa : a ≤ (N : ℝ) := Nat.le_ceil a
  have hNa' : (N : ℝ) < a + 1 := Nat.ceil_lt_add_one ha.le
  have hnr : (N : ℝ) ≤ n := by exact_mod_cast hnlo
  have hnK : (n : ℝ) + 1 ≤ (N : ℝ) + K := by
    have hh : n + 1 ≤ N + K := by dsimp only [K]; omega
    exact_mod_cast hh
  have hcross : a * Real.log 4 = T - G := by
    dsimp only [a]
    exact div_mul_cancel₀ _ (ne_of_gt hlog)
  have hlo := mul_le_mul_of_nonneg_right (hNa.trans hnr) hlog.le
  have hhi := mul_lt_mul_of_pos_right (by linarith : (n : ℝ) < a + K) hlog
  refine ⟨n, by omega, ?_, ?_, hv⟩
  · rw [hcross] at hlo
    linarith
  · rw [add_mul, hcross] at hhi
    change (n : ℝ) * Real.log 4 < T - G + G at hhi
    linarith

def jumpVisit4_all_indices_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ (i j : Fin 4) (m n : ℕ),
      jumpVisit4 r i m ≠ 0 → jumpVisit4 r j n ≠ 0 →
      (i ≠ j ∨ m ≠ n) → (M : ℤ) < |(n : ℤ) - m| := by
  have horbits : ∀ᶠ r in atTop, ∀ i ∈ (Finset.univ : Finset (Fin 4)),
      ∀ j ∈ (Finset.univ : Finset (Fin 4)), i ≠ j → ∀ m n : ℤ,
        jumpVisit4 r i m ≠ 0 → jumpVisit4 r j n ≠ 0 → (M : ℤ) < |n - m| := by
    apply (eventually_all_finset _).mpr
    intro i _
    apply (eventually_all_finset _).mpr
    intro j _
    by_cases hij : i = j
    · exact Eventually.of_forall (fun _ h => False.elim (h hij))
    · exact (jumpVisit4_distinct_orbits_separate hij M).mono (fun _ h _ => h)
  have hQ := rotationReturns_denominators_tendsto.2.eventually (eventually_ge_atTop (M + 1))
  filter_upwards [horbits, hQ] with r hr hQr i j m n hm hn hne
  by_cases hij : i = j
  · subst j
    have hmn : m ≠ n := hne.resolve_left (by simp)
    rcases lt_or_gt_of_ne hmn with hlt | hgt
    · have hh := jumpVisit4_separated r i hlt hm hn
      rw [abs_of_nonneg (by omega : (0 : ℤ) ≤ (n : ℤ) - m)]
      omega
    · have hh := jumpVisit4_separated r i hgt hn hm
      rw [abs_of_nonpos (by omega : (n : ℤ) - m ≤ 0)]
      omega
  · exact hr i (Finset.mem_univ i) j (Finset.mem_univ j) hij m n hm hn

def returnEventTime_nonvanishing_cutoffs (r : ℕ) :
    ∃ T₁ T₂ : ℝ,
      4 * returnScale r < T₁ ∧ T₁ < 5 * returnScale r ∧
      10 * returnScale r < T₂ ∧ T₂ < 11 * returnScale r ∧
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T₁ ∨ T₁ + returnScale r / 0x64 < returnEventTime r i n) ∧
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T₂ ∨ T₂ + returnScale r / 0x64 < returnEventTime r i n) := by
  obtain ⟨T₁, hlo₁, hhi₁, hgap₁⟩ := returnEventTime_gap r (4 * returnScale r)
  obtain ⟨T₂, hlo₂, hhi₂, hgap₂⟩ := returnEventTime_gap r (10 * returnScale r)
  have hL := returnScale_pos r
  exact ⟨T₁, T₂, hlo₁, by linarith, hlo₂, by linarith, hgap₁, hgap₂⟩


end Bounty

end SubmissionComponent_ReturnVisitCoverage

/- Component ReturnApproximationConditions; SHA256 27ea1e303b3ca0214e6a4677d74e4f6e76603b0f2e87547155caf5fc98d70db2 -/
section SubmissionComponent_ReturnApproximationConditions
/- Packaged analytic, size, and coefficient conditions for both return approximations. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable section

/-- `none` is the integral prefix, while `some i` is the corresponding positive unit. -/
def returnApproximationVector (r : ℕ) (T : ℝ) : Option (ReturnApproximationLabel r T) → ℚ :=
  fun i => match i with
  | none => (returnIntegerPrefix r : ℚ)
  | some j => returnApproximationUnit r T j

def returnApproximationError (z : ℚ) (r : ℕ) (T : ℝ) : ℝ :=
  (((∑ i : ReturnApproximationLabel r T,
    returnApproximationCoefficient z r T i * returnApproximationUnit r T i) -
      (returnIntegerPrefix r : ℚ) : ℚ) : ℝ)

def returnApproximationVector_coordinate (r : ℕ) (T : ℝ)
    (i : Option (ReturnApproximationLabel r T)) :
    IsReturnCoordinate r T (returnApproximationVector r T i) := by
  cases i with
  | none => exact Or.inl rfl
  | some j =>
    cases j with
    | inl a => exact Or.inr (Or.inl ⟨a, rfl⟩)
    | inr a => exact Or.inr (Or.inr ⟨a.1, a.2.1, a.2.2, rfl⟩)

def returnApproximationLabel_card_lower (r : ℕ) (T : ℝ) :
    4 ≤ Fintype.card (ReturnApproximationLabel r T) := by
  classical
  simp [ReturnApproximationLabel]

def returnApproximationLabel_card_eleven (r : ℕ) (T : ℝ)
    (hT : T ≤ 11 * returnScale r) :
    Fintype.card (ReturnApproximationLabel r T) ≤ 0x194 := by
  simpa using returnApproximationLabel_card r 11 T hT

def returnApproximationVector_height :
    ∀ᶠ r in atTop, ∀ T : ℝ, T ≤ 11 * returnScale r →
      Height.mulHeight (returnApproximationVector r T) ≤ Real.exp (27 * returnScale r) := by
  filter_upwards [returnCoordinateHeight_eventually_eleven] with r hr T hT
  exact hr T (Option (ReturnApproximationLabel r T)) (returnApproximationVector r T) hT
    (returnApproximationVector_coordinate r T)

/-- Conditions for a bounded finite unit sum to approximate the shared integral prefix. -/
def ReturnApproximationConditions (z : ℚ) (r : ℕ) (T : ℝ) : Prop :=
  Fintype.card (ReturnApproximationLabel r T) ≤ 0x194 ∧
  (∀ i : ReturnApproximationLabel r T,
    returnApproximationCoefficient z r T i ∈ returnCoefficientPalette z) ∧
  (∀ i : ReturnApproximationLabel r T, 0 < returnApproximationUnit r T i) ∧
  (∀ i : ReturnApproximationLabel r T, Real.exp (-T) ≤ (returnApproximationUnit r T i : ℝ)) ∧
  Height.mulHeight (returnApproximationVector r T) ≤ Real.exp (27 * returnScale r) ∧
  |returnApproximationError z r T| ≤ Real.exp (-T - returnScale r / 0xc8)

def returnApproximation_conditions (z : ℚ)
    (hz : (z : ℝ) = 0xb4 * explicitDensity - 32) :
    ∀ᶠ r in atTop, ∀ T : ℝ, 0 ≤ T → T ≤ 11 * returnScale r →
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T ∨ T + returnScale r / 0x64 < returnEventTime r i n) →
      ReturnApproximationConditions z r T := by
  filter_upwards [returnApproximationVector_height, returnApproximation_error z hz]
    with r hheight herror T hT0 hT hgap
  refine ⟨returnApproximationLabel_card_eleven r T hT,
    returnApproximationCoefficient_mem z r T, returnApproximationUnit_pos r T,
    returnApproximationUnit_lower r T hT0, hheight T hT, ?_⟩
  exact herror T hgap

/-- The two cutoffs have a gap of more than five scales and both satisfy all approximation bounds. -/
def returnApproximation_two_cutoffs (z : ℚ)
    (hz : (z : ℝ) = 0xb4 * explicitDensity - 32) :
    ∀ᶠ r in atTop, ∃ T₁ T₂ : ℝ,
      4 * returnScale r < T₁ ∧ T₁ < 5 * returnScale r ∧
      10 * returnScale r < T₂ ∧ T₂ < 11 * returnScale r ∧
      5 * returnScale r < T₂ - T₁ ∧
      ReturnApproximationConditions z r T₁ ∧ ReturnApproximationConditions z r T₂ ∧
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T₁ ∨ T₁ + returnScale r / 0x64 < returnEventTime r i n) ∧
      (∀ i n, returnEventVisit r i n →
        returnEventTime r i n < T₂ ∨ T₂ + returnScale r / 0x64 < returnEventTime r i n) := by
  filter_upwards [returnApproximation_conditions z hz] with r hr
  obtain ⟨T₁, T₂, hlo₁, hhi₁, hlo₂, hhi₂, hgap₁, hgap₂⟩ :=
    returnEventTime_nonvanishing_cutoffs r
  have hL := returnScale_pos r
  refine ⟨T₁, T₂, hlo₁, hhi₁, hlo₂, hhi₂, ?_, ?_, ?_, hgap₁, hgap₂⟩
  · linarith
  · exact hr T₁ (by linarith) (by linarith) hgap₁
  · exact hr T₂ (by linarith) hhi₂.le hgap₂


end
end Bounty

end SubmissionComponent_ReturnApproximationConditions

/- Component ReturnApproximationSUnits; SHA256 defb2db749cacfdf1489b593c19e337bdd511598dedbf273b9bf09b181f96cff -/
section SubmissionComponent_ReturnApproximationSUnits
/- The finite approximation units have prime support exactly within {2,3}. -/

namespace Bounty

def TwoThreeUnit (x : ℚ) : Prop := ∃ a b : ℤ, x = (2 : ℚ) ^ a * (3 : ℚ) ^ b

def TwoThreeInteger (x : ℚ) : Prop :=
  ∃ a b : ℕ, ∃ z : ℤ, x = (z : ℚ) / ((2 : ℚ) ^ a * (3 : ℚ) ^ b)

def returnApproximationUnit_twoThreeUnit (r : ℕ) (T : ℝ)
    (i : ReturnApproximationLabel r T) : TwoThreeUnit (returnApproximationUnit r T i) := by
  cases i with
  | inl j =>
    refine ⟨2 * returnHeadFourExponent r j, returnHeadThreeExponent r j, ?_⟩
    change returnHeadUnit r j = _
    rw [returnHeadUnit_primeMonomial]
    simp only [rationalPrimeMonomial, zpow_zero, mul_one]
  | inr a =>
    refine ⟨2 * returnUnitFourExponent r a.1 a.2.1,
      returnUnitThreeExponent r a.1 a.2.1, ?_⟩
    change returnRationalUnit r a.1 a.2.1 = _
    rw [returnRationalUnit_primeMonomial]
    simp only [rationalPrimeMonomial, zpow_zero, mul_one]

end Bounty

end SubmissionComponent_ReturnApproximationSUnits

/- Component TwoThreeProductFormula; SHA256 cc84f294510e33414a2f32794604551572bc1467300225a98a6f497075674dee -/
section SubmissionComponent_TwoThreeProductFormula
/- Exact finite-place products for the remaining arithmetic argument.
No Subspace Theorem or irrationality assertion is assumed in this module. -/

namespace Bounty

noncomputable section

def twoThreeUnit_pos {x : ℚ} (hx : TwoThreeUnit x) : 0 < x := by
  obtain ⟨a, b, rfl⟩ := hx
  positivity

def twoThreeUnit_product_formula {x : ℚ} (hx : TwoThreeUnit x) :
    |x| * (padicNorm 2 x * padicNorm 3 x) = 1 := by
  obtain ⟨a, b, rfl⟩ := hx
  have h2 : (2 : ℚ) ^ a ≠ 0 := zpow_ne_zero a (by norm_num)
  have h3 : (3 : ℚ) ^ b ≠ 0 := zpow_ne_zero b (by norm_num)
  have hpos : 0 < (2 : ℚ) ^ a * (3 : ℚ) ^ b := by positivity
  have hv2 : padicValRat 2 ((2 : ℚ) ^ a * (3 : ℚ) ^ b) = a := by
    have hs : padicValRat 2 2 = 1 := padicValRat.self (by norm_num)
    have ht : padicValRat 2 3 = 0 := padicValRat_nat_zero (by norm_num : ¬ 2 ∣ 3)
    rw [padicValRat.mul h2 h3]
    simp only [padicValRat.zpow, hs, ht, mul_one, mul_zero, add_zero]
  have hv3 : padicValRat 3 ((2 : ℚ) ^ a * (3 : ℚ) ^ b) = b := by
    have hs : padicValRat 3 3 = 1 := padicValRat.self (by norm_num)
    have ht : padicValRat 3 2 = 0 := padicValRat_nat_zero (by norm_num : ¬ 3 ∣ 2)
    rw [padicValRat.mul h2 h3]
    simp only [padicValRat.zpow, hs, ht, mul_one, mul_zero, zero_add]
  rw [abs_of_pos hpos, padicNorm.eq_zpow_of_nonzero (mul_ne_zero h2 h3),
    padicNorm.eq_zpow_of_nonzero (mul_ne_zero h2 h3), hv2, hv3]
  simp only [Nat.cast_ofNat, zpow_neg]
  field_simp

def twoThree_integer_finite_norm_bound (P : ℤ) :
    padicNorm 2 (P : ℚ) * padicNorm 3 (P : ℚ) ≤ 1 := by
  exact (mul_le_mul (padicNorm.of_int P) (padicNorm.of_int P)
    (padicNorm.nonneg _) (by norm_num)).trans_eq (one_mul 1)

def twoThreeOneFormProduct {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d x : ι → ℚ) (k : ι) : ℚ :=
  |∑ i, d i * x i| * (∏ i ∈ Finset.univ.erase k, |x i|) *
    ∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i))

def twoThreeOneFormProduct_units {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d x : ι → ℚ) (k : ι) (hx : ∀ i, TwoThreeUnit (x i)) :
    twoThreeOneFormProduct d x k = |∑ i, d i * x i| / |x k| := by
  have hpos : 0 < |x k| := abs_pos.mpr (twoThreeUnit_pos (hx k)).ne'
  apply (eq_div_iff hpos.ne').mpr
  have he : (∏ i ∈ Finset.univ.erase k, |x i|) * |x k| = ∏ i, |x i| :=
    Finset.prod_erase_mul _ _ (Finset.mem_univ k)
  calc
    twoThreeOneFormProduct d x k * |x k| =
        |∑ i, d i * x i| *
          ((∏ i ∈ Finset.univ.erase k, |x i|) * |x k|) *
          (∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i))) := by
            unfold twoThreeOneFormProduct
            ring
    _ = |∑ i, d i * x i| *
          (∏ i, |x i| * (padicNorm 2 (x i) * padicNorm 3 (x i))) := by
            rw [he]
            simp only [Finset.prod_mul_distrib, mul_assoc]
    _ = |∑ i, d i * x i| := by
      simp only [twoThreeUnit_product_formula (hx _), Finset.prod_const_one, mul_one]

def finite_prod_option_erase_none {ι : Type*} [Fintype ι] [DecidableEq ι]
    (f : Option ι → ℚ) :
    (∏ i ∈ Finset.univ.erase none, f i) = ∏ i, f (some i) := by
  have he : (Finset.univ : Finset (Option ι)).erase none =
      (Finset.univ : Finset ι).map Function.Embedding.some := by
    ext i
    cases i <;> simp
  rw [he, Finset.prod_map]
  rfl

def twoThreeOneFormProduct_integer {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d : Option ι → ℚ) (P : ℤ) (u : ι → ℚ) (hu : ∀ i, TwoThreeUnit (u i)) :
    twoThreeOneFormProduct d (fun i => i.elim (P : ℚ) u) none =
      |∑ i, d i * i.elim (P : ℚ) u| *
        (padicNorm 2 (P : ℚ) * padicNorm 3 (P : ℚ)) := by
  unfold twoThreeOneFormProduct
  rw [finite_prod_option_erase_none, Fintype.prod_option]
  simp only [Option.elim_some, Option.elim_none]
  have hprod : (∏ i, |u i|) *
      (∏ i, (padicNorm 2 (u i) * padicNorm 3 (u i))) = 1 := by
    rw [← Finset.prod_mul_distrib]
    simp only [twoThreeUnit_product_formula (hu _), Finset.prod_const_one]
  calc
    _ = |∑ i, d i * i.elim (P : ℚ) u| *
      (padicNorm 2 (P : ℚ) * padicNorm 3 (P : ℚ)) *
        ((∏ i, |u i|) * ∏ i, (padicNorm 2 (u i) * padicNorm 3 (u i))) := by ring
    _ = _ := by rw [hprod, mul_one]

def twoThreeOneFormProduct_integer_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d : Option ι → ℚ) (P : ℤ) (u : ι → ℚ) (hu : ∀ i, TwoThreeUnit (u i)) :
    twoThreeOneFormProduct d (fun i => i.elim (P : ℚ) u) none ≤
      |∑ i, d i * i.elim (P : ℚ) u| := by
  rw [twoThreeOneFormProduct_integer d P u hu]
  exact mul_le_of_le_one_right (abs_nonneg _) (twoThree_integer_finite_norm_bound P)


end
end Bounty

end SubmissionComponent_TwoThreeProductFormula

/- Component OneFormDenominatorClearing; SHA256 61e96d39cc05adf9e393425b739d9eec9fd8867631a63fbe8e94c682bddb9494 -/
section SubmissionComponent_OneFormDenominatorClearing
/- Clear a common {2,3}-unit denominator without changing the one-form product. -/

namespace Bounty

noncomputable section

/-- Every finite tuple of {2,3}-integers can be cleared by one positive natural
denominator which is itself a {2,3}-unit. This includes the empty tuple. -/
def twoThreeInteger_common_denominator {ι : Type*} [Fintype ι]
    (x : ι → ℚ) (hx : ∀ i, TwoThreeInteger (x i)) :
    ∃ D : ℕ, 0 < D ∧ TwoThreeUnit (D : ℚ) ∧
      ∀ i, ∃ z : ℤ, (D : ℚ) * x i = (z : ℚ) := by
  classical
  choose a b z hz using hx
  let den : ι → ℕ := fun i => 2 ^ a i * 3 ^ b i
  let D : ℕ := ∏ i, den i
  have hd (i : ι) : 0 < den i := by
    dsimp only [den]
    positivity
  have hD : 0 < D := Finset.prod_pos fun i hi => hd i
  have hunit : TwoThreeUnit (D : ℚ) := by
    refine ⟨((∑ i, a i : ℕ) : ℤ), ((∑ i, b i : ℕ) : ℤ), ?_⟩
    simp only [D, den, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat,
      zpow_natCast, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  refine ⟨D, hD, hunit, ?_⟩
  intro i
  let rest : ℕ := ∏ j ∈ Finset.univ.erase i, den j
  have hprod : rest * den i = D :=
    Finset.prod_erase_mul Finset.univ den (Finset.mem_univ i)
  have hprodQ : (D : ℚ) = (rest : ℚ) * (den i : ℚ) := by
    exact_mod_cast hprod.symm
  have hxi : x i = (z i : ℚ) / (den i : ℚ) := by
    simpa only [den, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] using hz i
  have hden : (den i : ℚ) ≠ 0 := by exact_mod_cast (hd i).ne'
  refine ⟨(rest : ℤ) * z i, ?_⟩
  rw [hprodQ, hxi]
  simp only [Int.cast_mul, Int.cast_natCast]
  field_simp [hden]

/-- The product is invariant under scaling by a {2,3}-unit, even when the
distinguished coordinate, another coordinate, or the linear form is zero. -/
def twoThreeOneFormProduct_unit_scale {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d x : ι → ℚ) (k : ι) {c : ℚ} (hc : TwoThreeUnit c) :
    twoThreeOneFormProduct d (fun i => c * x i) k = twoThreeOneFormProduct d x k := by
  have hsum : (∑ i, d i * (c * x i)) = c * ∑ i, d i * x i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  have harch : (∏ i ∈ Finset.univ.erase k, |c * x i|) =
      (∏ i ∈ Finset.univ.erase k, |c|) * (∏ i ∈ Finset.univ.erase k, |x i|) := by
    simp only [abs_mul, Finset.prod_mul_distrib]
  have hnorm (i : ι) : padicNorm 2 (c * x i) * padicNorm 3 (c * x i) =
      (padicNorm 2 c * padicNorm 3 c) * (padicNorm 2 (x i) * padicNorm 3 (x i)) := by
    rw [padicNorm.mul, padicNorm.mul]
    ring
  have hfinite : (∏ i, (padicNorm 2 (c * x i) * padicNorm 3 (c * x i))) =
      (∏ _i : ι, (padicNorm 2 c * padicNorm 3 c)) *
        ∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i)) := by
    simp only [hnorm, Finset.prod_mul_distrib]
  have hfactor : |c| * (∏ i ∈ Finset.univ.erase k, |c|) *
      (∏ _i : ι, (padicNorm 2 c * padicNorm 3 c)) = 1 := by
    rw [Finset.mul_prod_erase Finset.univ (fun _ : ι => |c|) (Finset.mem_univ k)]
    rw [← Finset.prod_mul_distrib]
    simp only [twoThreeUnit_product_formula hc, Finset.prod_const_one]
  unfold twoThreeOneFormProduct
  rw [hsum, abs_mul, harch, hfinite]
  calc
    _ = (|c| * (∏ i ∈ Finset.univ.erase k, |c|) *
          (∏ _i : ι, (padicNorm 2 c * padicNorm 3 c))) *
        (|∑ i, d i * x i| * (∏ i ∈ Finset.univ.erase k, |x i|) *
          ∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i))) := by ring
    _ = _ := by rw [hfactor, one_mul]


end
end Bounty

end SubmissionComponent_OneFormDenominatorClearing

/- Component OneFormIntegerBridge; SHA256 05422bc5b7a8d984cd8a7e41f2f3c350f987201f76069f1ca7e3fbb36bdf0e8e -/
section SubmissionComponent_OneFormIntegerBridge
/- A finite cover for integer points gives the identical cover for {2,3}-integers.
The covering theorem is an explicit hypothesis; no arithmetic axiom is added. -/

namespace Bounty

noncomputable section

def oneForm_integer_cover_to_sInteger {I : Type*} [Fintype I] [DecidableEq I]
    (d : I → ℚ) (k : I) (ε : ℝ) (F : Finset (I → ℚ))
    (hcover : ∀ z : I → ℤ, z ≠ 0 →
      (twoThreeOneFormProduct d (fun i => (z i : ℚ)) k : ℝ) <
        Height.mulHeight (fun i => (z i : ℚ)) ^ (-ε) →
      ∃ a ∈ F, (∑ i, a i * (z i : ℚ)) = 0)
    (x : I → ℚ) (hSI : ∀ i, TwoThreeInteger (x i)) (hx : x ≠ 0)
    (hsmall : (twoThreeOneFormProduct d x k : ℝ) < Height.mulHeight x ^ (-ε)) :
    ∃ a ∈ F, (∑ i, a i * x i) = 0 := by
  classical
  obtain ⟨D, hD, hDU, hclear⟩ := twoThreeInteger_common_denominator x hSI
  choose z hz using hclear
  have hD0 : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
  have he : (fun i => (z i : ℚ)) = (fun i => (D : ℚ) * x i) := by
    funext i
    exact (hz i).symm
  have hz0 : z ≠ 0 := by
    intro hzero
    apply hx
    funext i
    have hh : (D : ℚ) * x i = 0 := by rw [hz i, hzero]; rfl
    exact (mul_eq_zero.mp hh).resolve_left hD0
  have hheight : Height.mulHeight (fun i => (z i : ℚ)) = Height.mulHeight x := by
    rw [he]
    exact Height.mulHeight_smul_eq_mulHeight x hD0
  have hproduct : twoThreeOneFormProduct d (fun i => (z i : ℚ)) k =
      twoThreeOneFormProduct d x k := by
    rw [he]
    exact twoThreeOneFormProduct_unit_scale d x k hDU
  obtain ⟨a, ha, haz⟩ := hcover z hz0 (by simpa only [hheight, hproduct] using hsmall)
  refine ⟨a, ha, ?_⟩
  have hs : (D : ℚ) * (∑ i, a i * x i) = ∑ i, a i * (z i : ℚ) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [← hz i]
    ring
  exact (mul_eq_zero.mp (hs.trans haz)).resolve_left hD0


end
end Bounty

end SubmissionComponent_OneFormIntegerBridge

/- Component PrimitiveOneFormReduction; SHA256 69e5ab39381a1bee816e6fee1d0f14997a2c17f890fdda82fe47b50e3e0e14ac -/
section SubmissionComponent_PrimitiveOneFormReduction
/- Primitive normalization preserves the strict one-form approximation inequality. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def twoThreeOneFormProduct_nonneg {I : Type*} [Fintype I] [DecidableEq I]
    (d x : I → ℚ) (k : I) : 0 ≤ twoThreeOneFormProduct d x k := by
  exact mul_nonneg (mul_nonneg (abs_nonneg _)
    (Finset.prod_nonneg (fun i _ => abs_nonneg _)))
    (Finset.prod_nonneg (fun i _ => mul_nonneg (padicNorm.nonneg _) (padicNorm.nonneg _)))

def twoThreeOneFormProduct_scale {I : Type*} [Fintype I] [DecidableEq I]
    (d x : I → ℚ) (k : I) (c : ℚ) :
    twoThreeOneFormProduct d (fun i => c * x i) k =
      (|c| * padicNorm 2 c * padicNorm 3 c) ^ Fintype.card I *
        twoThreeOneFormProduct d x k := by
  have hsum : (∑ i, d i * (c * x i)) = c * ∑ i, d i * x i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have harch : (∏ i ∈ Finset.univ.erase k, |c * x i|) =
      (∏ i ∈ Finset.univ.erase k, |c|) * (∏ i ∈ Finset.univ.erase k, |x i|) := by
    simp only [abs_mul, Finset.prod_mul_distrib]
  have hnorm (i : I) : padicNorm 2 (c * x i) * padicNorm 3 (c * x i) =
      (padicNorm 2 c * padicNorm 3 c) * (padicNorm 2 (x i) * padicNorm 3 (x i)) := by
    rw [padicNorm.mul, padicNorm.mul]
    ring
  have hfinite : (∏ i, (padicNorm 2 (c * x i) * padicNorm 3 (c * x i))) =
      (∏ _i : I, (padicNorm 2 c * padicNorm 3 c)) *
        ∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i)) := by
    simp only [hnorm, Finset.prod_mul_distrib]
  have hfactor : |c| * (∏ i ∈ Finset.univ.erase k, |c|) *
      (∏ _i : I, (padicNorm 2 c * padicNorm 3 c)) =
        (|c| * padicNorm 2 c * padicNorm 3 c) ^ Fintype.card I := by
    rw [Finset.mul_prod_erase Finset.univ (fun _ : I => |c|) (Finset.mem_univ k)]
    rw [← Finset.prod_mul_distrib]
    simp only [Finset.prod_const, Finset.card_univ]
    congr 1
    ring
  unfold twoThreeOneFormProduct
  rw [hsum, abs_mul, harch, hfinite]
  calc
    _ = (|c| * (∏ i ∈ Finset.univ.erase k, |c|) *
          (∏ _i : I, (padicNorm 2 c * padicNorm 3 c))) *
        (|∑ i, d i * x i| * (∏ i ∈ Finset.univ.erase k, |x i|) *
          ∏ i, (padicNorm 2 (x i) * padicNorm 3 (x i))) := by ring
    _ = _ := by rw [hfactor]

def twoThreeOneFormProduct_le_integer_scale {I : Type*} [Fintype I] [DecidableEq I]
    (d x : I → ℚ) (k : I) (g : ℤ) (hg : g ≠ 0) :
    twoThreeOneFormProduct d x k ≤
      twoThreeOneFormProduct d (fun i => (g : ℚ) * x i) k := by
  rw [twoThreeOneFormProduct_scale]
  have hpow : (1 : ℚ) ≤ (|(g : ℚ)| * padicNorm 2 (g : ℚ) * padicNorm 3 (g : ℚ)) ^
      Fintype.card I := one_le_pow₀ (integer_three_place_product_lower_rat g hg)
  exact le_mul_of_one_le_left (twoThreeOneFormProduct_nonneg d x k) hpow

def exists_primitive_oneForm_approximation {I : Type*} [Fintype I] [DecidableEq I]
    (d : I → ℚ) (k : I) (ε : ℝ) (x : I → ℤ) (hx : x ≠ 0)
    (hsmall : (twoThreeOneFormProduct d (fun i => (x i : ℚ)) k : ℝ) <
      Height.mulHeight (fun i => (x i : ℚ)) ^ (-ε)) :
    ∃ (g : ℤ) (a : I → ℤ), 0 < g ∧ a ≠ 0 ∧ Finset.univ.gcd a = 1 ∧
      (∀ i, x i = g * a i) ∧
      (twoThreeOneFormProduct d (fun i => (a i : ℚ)) k : ℝ) <
        Height.mulHeight (fun i => (a i : ℚ)) ^ (-ε) := by
  obtain ⟨g, a, hg, ha, hprim, hfactor⟩ := integer_vector_primitive_factor x hx
  refine ⟨g, a, hg, ha, hprim, hfactor, ?_⟩
  have hcast : (fun i => (x i : ℚ)) = fun i => (g : ℚ) * (a i : ℚ) := by
    funext i
    rw [hfactor i, Int.cast_mul]
  have hheight : Height.mulHeight (fun i => (x i : ℚ)) =
      Height.mulHeight (fun i => (a i : ℚ)) := by
    rw [hcast]
    exact Height.mulHeight_smul_eq_mulHeight _ (by exact_mod_cast hg.ne')
  have hle : (twoThreeOneFormProduct d (fun i => (a i : ℚ)) k : ℝ) ≤
      (twoThreeOneFormProduct d (fun i => (x i : ℚ)) k : ℝ) := by
    rw [hcast]
    exact_mod_cast twoThreeOneFormProduct_le_integer_scale d (fun i => (a i : ℚ)) k g hg.ne'
  exact hle.trans_lt (by simpa only [hheight] using hsmall)

def oneForm_primitive_cover_to_integer {I : Type*} [Fintype I] [DecidableEq I]
    (d : I → ℚ) (k : I) (ε : ℝ) (F : Finset (I → ℚ))
    (hcover : ∀ a : I → ℤ, a ≠ 0 → Finset.univ.gcd a = 1 →
      (twoThreeOneFormProduct d (fun i => (a i : ℚ)) k : ℝ) <
        Height.mulHeight (fun i => (a i : ℚ)) ^ (-ε) →
      ∃ b ∈ F, (∑ i, b i * (a i : ℚ)) = 0)
    (x : I → ℤ) (hx : x ≠ 0)
    (hsmall : (twoThreeOneFormProduct d (fun i => (x i : ℚ)) k : ℝ) <
      Height.mulHeight (fun i => (x i : ℚ)) ^ (-ε)) :
    ∃ b ∈ F, (∑ i, b i * (x i : ℚ)) = 0 := by
  obtain ⟨g, a, _, ha, hprim, hfactor, hsmall⟩ :=
    exists_primitive_oneForm_approximation d k ε x hx hsmall
  obtain ⟨b, hb, hba⟩ := hcover a ha hprim hsmall
  refine ⟨b, hb, ?_⟩
  calc
    _ = (g : ℚ) * ∑ i, b i * (a i : ℚ) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [hfactor i, Int.cast_mul]
      ring
    _ = 0 := by rw [hba, mul_zero]

end
end Bounty

end SubmissionComponent_PrimitiveOneFormReduction

/- Component OneFormMatrixProfiles; SHA256 8e9471e0f398bc0fad20a0e76502c8f244824ab0446d8ad3217b00b3a40594b6 -/
section SubmissionComponent_OneFormMatrixProfiles
/- Replacing one identity row by the given rational form realizes exactly
the one-form three-place product, and hence the finite-profile reduction. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def oneFormRowMatrix {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℚ) (k : I) : Matrix I I ℚ := (1 : Matrix I I ℚ).updateRow k a

def oneFormRowMatrix_mulVec {I : Type*} [Fintype I] [DecidableEq I]
    (a x : I → ℚ) (k : I) :
    (oneFormRowMatrix a k).mulVec x = Function.update x k (∑ i, a i * x i) := by
  rw [oneFormRowMatrix, Matrix.updateRow_mulVec, Matrix.one_mulVec]
  rfl

def oneFormRowMatrix_det {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℚ) (k : I) : (oneFormRowMatrix a k).det = a k := by
  have h := Matrix.det_updateRow_sum (1 : Matrix I I ℚ) k a
  have he : (∑ i, a i • (1 : Matrix I I ℚ) i) = a := by
    ext j
    simp [Matrix.one_apply, Finset.sum_apply]
  simpa [he, oneFormRowMatrix] using h

def oneFormRowMatrix_values_ne_zero {I : Type*} [Fintype I] [DecidableEq I]
    (a x : I → ℚ) (k : I) (hx : ∀ i, x i ≠ 0) (hax : (∑ i, a i * x i) ≠ 0) :
    ∀ i, (oneFormRowMatrix a k).mulVec x i ≠ 0 := by
  intro i
  rw [oneFormRowMatrix_mulVec]
  by_cases hi : i = k
  · simpa [hi] using hax
  · simpa [Function.update_of_ne hi] using hx i

def oneFormRowMatrix_abs_product {I : Type*} [Fintype I] [DecidableEq I]
    (a x : I → ℚ) (k : I) :
    (∏ i, |(oneFormRowMatrix a k).mulVec x i|) =
      |∑ i, a i * x i| * ∏ i ∈ Finset.univ.erase k, |x i| := by
  have he : (fun i => |(oneFormRowMatrix a k).mulVec x i|) =
      Function.update (fun i => |x i|) k |∑ i, a i * x i| := by
    ext i
    rw [oneFormRowMatrix_mulVec]
    by_cases hi : i = k <;> simp [hi]
  rw [he, Finset.prod_update_of_mem (Finset.mem_univ k)]
  simp only [Finset.sdiff_singleton_eq_erase]

def rational_norm_eq_cast_abs (x : ℚ) : ‖x‖ = ((|x| : ℚ) : ℝ) := by
  rw [← Rat.norm_cast_real, Real.norm_eq_abs, Rat.cast_abs]

def oneForm_actual_three_place_product {d : ℕ}
    (a : Fin d → ℚ) (k : Fin d) (x : Fin d → ℤ) :
    (∏ v, ∏ i, actualThreePlaceValues (oneFormRowMatrix a k) x v i) =
      (twoThreeOneFormProduct a (fun i => (x i : ℚ)) k : ℝ) := by
  calc
    _ = (((∏ i, |(oneFormRowMatrix a k).mulVec (fun j => (x j : ℚ)) i|) *
        (∏ i, padicNorm 2 (x i : ℚ)) * (∏ i, padicNorm 3 (x i : ℚ)) : ℚ) : ℝ) := by
      simp [actualThreePlaceValues, Fin.prod_univ_succ, rational_norm_eq_cast_abs,
        Rat.cast_prod, Rat.cast_mul, mul_assoc]
    _ = _ := by
      congr 1
      rw [oneFormRowMatrix_abs_product]
      simp only [twoThreeOneFormProduct, Finset.prod_mul_distrib]
      ring

def exists_finite_primitive_oneForm_profiles {d : ℕ} (hd : 0 < d)
    (a : Fin d → ℚ) (k : Fin d) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ M : ℝ, 1 ≤ M ∧ ∃ C : Finset (Fin 3 → Fin d → ℝ),
      (∀ c ∈ C, (∀ v i, |c v i| ≤ M + ρ / (6 * d)) ∧
        (∑ v, ∑ i, c v i) ≤ -ρ / 2 ∧ (∀ v i, v ≠ 0 → c v i ≤ 0)) ∧
      ∀ x : Fin d → ℤ, Finset.univ.gcd x = 1 →
        1 ≤ Height.logHeight (fun i => (x i : ℚ)) → (∀ i, x i ≠ 0) →
        (∑ i, a i * (x i : ℚ)) ≠ 0 →
        (twoThreeOneFormProduct a (fun i => (x i : ℚ)) k : ℝ) <
          Height.mulHeight (fun i => (x i : ℚ)) ^ (-ρ) →
        ∃ c ∈ C, ∀ v i, actualThreePlaceValues (oneFormRowMatrix a k) x v i ≤
          Real.exp (c v i * Height.logHeight (fun i => (x i : ℚ))) := by
  obtain ⟨M, hM, C, hC, hcover⟩ := exists_finite_primitive_three_place_profiles hd
    (oneFormRowMatrix a k) ρ hρ
  refine ⟨M, hM, C, hC, ?_⟩
  intro x hprim hq hxn hax hprod
  apply hcover x hprim hq hxn
  · exact oneFormRowMatrix_values_ne_zero a (fun i => (x i : ℚ)) k
      (fun i => by exact_mod_cast hxn i) hax
  · rw [oneForm_actual_three_place_product]
    exact hprod.le


end
end Bounty

end SubmissionComponent_OneFormMatrixProfiles

/- Component RationalSubspaceCoverExceptions; SHA256 9b4470b3a211e26300f6696672059eef6ec311b62cfb0d8fe455af03f8b5912e -/
section SubmissionComponent_RationalSubspaceCoverExceptions
/- Concrete finite exceptional families and conversion of proper rational
subspaces to nonzero rational equations. No covering theorem is assumed here. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def proper_rational_subspace_normal {I : Type*} [Fintype I] [DecidableEq I]
    (V : Submodule ℚ (I → ℚ)) (hV : V ≠ ⊤) :
    ∃ a : I → ℚ, a ≠ 0 ∧ ∀ x ∈ V, (∑ i, a i * x i) = 0 := by
  obtain ⟨f, hf, hker⟩ := V.exists_le_ker_of_lt_top hV.lt_top
  let a : I → ℚ := fun i => f (Pi.single i 1)
  have he (x : I → ℚ) : (∑ i, a i * x i) = f x := by
    have hx : x = ∑ i, x i • Pi.single i (1 : ℚ) := by ext i; simp [Pi.single_apply]
    conv_rhs => rw [hx, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp [a, mul_comm]
  refine ⟨a, ?_, ?_⟩
  · intro ha
    apply hf
    apply LinearMap.ext
    intro x
    simpa [ha] using (he x).symm
  · intro x hx
    rw [he]
    exact hker hx

def finite_proper_subspaces_normals {I : Type*} [Fintype I] [DecidableEq I]
    (F : Finset (Submodule ℚ (I → ℚ))) (hF : ∀ V ∈ F, V ≠ ⊤) :
    ∃ G : Finset (I → ℚ), (∀ a ∈ G, a ≠ 0) ∧
      ∀ x : I → ℚ, (∃ V ∈ F, x ∈ V) → ∃ a ∈ G, (∑ i, a i * x i) = 0 := by
  classical
  choose a ha hvan using fun V : ↥F => proper_rational_subspace_normal V.val (hF V.val V.property)
  refine ⟨Finset.univ.image a, ?_, ?_⟩
  · intro b hb
    obtain ⟨V, _, rfl⟩ := Finset.mem_image.mp hb
    exact ha V
  · rintro x ⟨V, hV, hx⟩
    exact ⟨a ⟨V, hV⟩, Finset.mem_image.mpr ⟨⟨V, hV⟩, Finset.mem_univ _, rfl⟩,
      hvan ⟨V, hV⟩ x hx⟩

def finite_primitive_integer_small_height {I : Type*} [Fintype I] [Nonempty I] :
    Set.Finite {x : I → ℤ | x ≠ 0 ∧ Finset.univ.gcd x = 1 ∧
      Height.logHeight (fun i => (x i : ℚ)) < 1} := by
  classical
  let N : ℤ := ⌈Real.exp 1⌉
  apply (Set.finite_Icc (a := fun _ : I => -N) (b := fun _ : I => N)).subset
  rintro x ⟨hx, hprim, hsmall⟩
  have hH : 0 < integerVectorMax x := lt_of_lt_of_le (by norm_num) (integerVectorMax_ge_one x hx)
  have hHsmall : integerVectorMax x < Real.exp 1 := by
    rw [← Real.exp_log hH]
    exact Real.exp_lt_exp.mpr (by simpa [primitive_integer_logHeight x hprim] using hsmall)
  have hcoord (i : I) : |(x i : ℝ)| ≤ (N : ℝ) :=
    (integer_coord_abs_le_max x i).trans (hHsmall.le.trans (Int.le_ceil _))
  constructor <;> intro i
  · exact_mod_cast (abs_le.mp (hcoord i)).1
  · exact_mod_cast (abs_le.mp (hcoord i)).2

def rational_singleton_span_ne_top {I : Type*} [Fintype I]
    (hI : 2 ≤ Fintype.card I) (x : I → ℚ) : Submodule.span ℚ {x} ≠ ⊤ := by
  classical
  have hdim : Module.finrank ℚ (Submodule.span ℚ {x}) ≤ 1 := by
    simpa using (finrank_span_le_card ({x} : Set (I → ℚ)))
  intro htop
  rw [htop, finrank_top, Module.finrank_pi] at hdim
  omega

def finite_small_height_normal_cover {I : Type*} [Fintype I] [DecidableEq I]
    (hI : 2 ≤ Fintype.card I) :
    ∃ G : Finset (I → ℚ), (∀ a ∈ G, a ≠ 0) ∧
      ∀ x : I → ℤ, x ≠ 0 → Finset.univ.gcd x = 1 →
        Height.logHeight (fun i => (x i : ℚ)) < 1 →
        ∃ a ∈ G, (∑ i, a i * (x i : ℚ)) = 0 := by
  classical
  let : Nonempty I := Fintype.card_pos_iff.mp (by omega)
  let S := (finite_primitive_integer_small_height (I := I)).toFinset
  let F := S.image (fun x : I → ℤ => Submodule.span ℚ {fun i => (x i : ℚ)})
  obtain ⟨G, hG, hcover⟩ := finite_proper_subspaces_normals F (by
    intro V hV
    obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hV
    exact rational_singleton_span_ne_top hI _)
  refine ⟨G, hG, ?_⟩
  intro x hx hprim hsmall
  apply hcover
  refine ⟨_, Finset.mem_image.mpr ⟨x, ?_, rfl⟩, Submodule.subset_span (Set.mem_singleton _)⟩
  exact (Set.Finite.mem_toFinset _).mpr ⟨hx, hprim, hsmall⟩


end
end Bounty

end SubmissionComponent_RationalSubspaceCoverExceptions

/- Component BoundedBoxSubspaceCover; SHA256 7f91d940265c2f52223db9bf0d1cd452e98f801cb3bee120107744b650adfadf -/
section SubmissionComponent_BoundedBoxSubspaceCover
/- Bounded logarithmic parameters contribute an actual finite proper-subspace cover. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def exists_bounded_exponential_subspace_cover {d : ℕ} (hd : 2 ≤ d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : Fin d → ℝ) (T : ℝ) :
    ∃ F : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ F, V ≠ ⊤) ∧
      ∀ q : ℝ, 0 ≤ q → q ≤ T → ∀ x : Fin d → ℤ,
        (∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c i * q)) →
        ∃ V ∈ F, (fun i => (x i : ℚ)) ∈ V := by
  classical
  let S := (finite_bounded_exponential_integer_points A hA c T).toFinset
  refine ⟨S.image (fun x : Fin d → ℤ => Submodule.span ℚ {fun i => (x i : ℚ)}), ?_, ?_⟩
  · intro V hV
    obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hV
    exact rational_singleton_span_ne_top (by simpa using hd) _
  · intro q hq hqT x hx
    refine ⟨Submodule.span ℚ {fun i => (x i : ℚ)},
      Finset.mem_image.mpr ⟨x, ?_, rfl⟩, Submodule.subset_span (Set.mem_singleton _)⟩
    change x ∈ (finite_bounded_exponential_integer_points A hA c T).toFinset
    rw [Set.Finite.mem_toFinset]
    refine ⟨q, hq, hqT, fun i => ?_⟩
    rw [← Real.norm_eq_abs, Rat.norm_cast_real]
    exact hx i

end
end Bounty

end SubmissionComponent_BoundedBoxSubspaceCover

/- Component RationalThreePlaceSubspaceCover; SHA256 fcaca9dca9f10a8c58d0dc845ce09c19a331820d665725bfe1d986bd45c0edf3 -/
section SubmissionComponent_RationalThreePlaceSubspaceCover
/- The precise geometric covering contract used by the final arithmetic
application. This file defines a proposition; it does not assert the contract. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def RationalThreePlaceSubspaceCover : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I], 2 ≤ Fintype.card I →
    ∀ (A : Matrix I I ℚ), A.det ≠ 0 →
    ∀ (c : Fin 3 → I → ℝ) (ρ : ℝ), 0 < ρ →
      (∑ v, ∑ i, c v i) ≤ -ρ →
      (∀ v i, v ≠ 0 → c v i ≤ 0) →
      ∃ F : Finset (Submodule ℚ (I → ℚ)), (∀ V ∈ F, V ≠ ⊤) ∧
        ∀ (q : ℝ), 0 ≤ q → ∀ x : I → ℤ,
          (∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c 0 i * q)) →
          (∀ i, (padicNorm 2 (x i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q)) →
          (∀ i, (padicNorm 3 (x i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) →
          ∃ V ∈ F, (fun i => (x i : ℚ)) ∈ V

def three_place_subspace_cover_normals (h : RationalThreePlaceSubspaceCover)
    (I : Type) [Fintype I] [DecidableEq I] (hI : 2 ≤ Fintype.card I)
    (A : Matrix I I ℚ) (hA : A.det ≠ 0)
    (c : Fin 3 → I → ℝ) (ρ : ℝ) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hcfin : ∀ v i, v ≠ 0 → c v i ≤ 0) :
    ∃ G : Finset (I → ℚ), (∀ a ∈ G, a ≠ 0) ∧
      ∀ (q : ℝ), 0 ≤ q → ∀ x : I → ℤ,
        (∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c 0 i * q)) →
        (∀ i, (padicNorm 2 (x i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q)) →
        (∀ i, (padicNorm 3 (x i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) →
        ∃ a ∈ G, (∑ i, a i * (x i : ℚ)) = 0 := by
  obtain ⟨F, hF, hcover⟩ := h I hI A hA c ρ hρ hc hcfin
  obtain ⟨G, hG, hnormal⟩ := finite_proper_subspaces_normals F hF
  exact ⟨G, hG, fun q hq x h₀ h₂ h₃ => hnormal _ (hcover q hq x h₀ h₂ h₃)⟩


end
end Bounty

end SubmissionComponent_RationalThreePlaceSubspaceCover

/- Component ThreePlaceSubspaceCoverReindex; SHA256 7f94130876bd3a0d33f01049ff63ce775d9763335bfc3e07c4180c5d2de86d71 -/
section SubmissionComponent_ThreePlaceSubspaceCoverReindex
/- Exact finite-coordinate transport of the three-place rational subspace-cover contract. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

/-- The same geometric contract on the standard finite coordinate types. -/
def RationalThreePlaceSubspaceCoverFin : Prop :=
  ∀ d : ℕ, 2 ≤ d → ∀ A : Matrix (Fin d) (Fin d) ℚ, A.det ≠ 0 →
    ∀ (c : Fin 3 → Fin d → ℝ) (ρ : ℝ), 0 < ρ →
      (∑ v, ∑ i, c v i) ≤ -ρ →
      (∀ v i, v ≠ 0 → c v i ≤ 0) →
      ∃ F : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ F, V ≠ ⊤) ∧
        ∀ (q : ℝ), 0 ≤ q → ∀ x : Fin d → ℤ,
          (∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c 0 i * q)) →
          (∀ i, (padicNorm 2 (x i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q)) →
          (∀ i, (padicNorm 3 (x i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) →
          ∃ V ∈ F, (fun i => (x i : ℚ)) ∈ V

def profile_mulVec_reindex {I I' : Type*} [Fintype I] [Fintype I']
    (e : I ≃ I') (A : Matrix I I ℚ) (x : I → ℚ) :
    (Matrix.reindex e e A).mulVec (profileCoordinateEquiv e x) =
      profileCoordinateEquiv e (A.mulVec x) := by
  change (A.submatrix e.symm e.symm).mulVec (x ∘ e.symm) = (A.mulVec x) ∘ e.symm
  rw [Matrix.submatrix_mulVec_equiv]
  simp only [Equiv.symm_symm, Function.comp_assoc, Equiv.symm_comp_self, Function.comp_id]

def rationalThreePlaceSubspaceCover_of_fin
    (hfin : RationalThreePlaceSubspaceCoverFin) : RationalThreePlaceSubspaceCover := by
  classical
  intro I _ _ hI A hA c ρ hρ hc hcfin
  let e : I ≃ Fin (Fintype.card I) := Fintype.equivFin I
  let E := profileCoordinateEquiv e
  let A' := Matrix.reindex e e A
  let c' : Fin 3 → Fin (Fintype.card I) → ℝ := fun v i => c v (e.symm i)
  have hA' : A'.det ≠ 0 := by simpa only [A', Matrix.det_reindex_self] using hA
  have hc' : (∑ v, ∑ i, c' v i) ≤ -ρ := by
    simpa only [c', Equiv.sum_comp] using hc
  have hcfin' : ∀ v i, v ≠ 0 → c' v i ≤ 0 := fun v i hv => hcfin v (e.symm i) hv
  obtain ⟨F, hF, hcover⟩ := hfin (Fintype.card I) hI A' hA' c' ρ hρ hc' hcfin'
  refine ⟨F.image (fun V => V.map E.symm.toLinearMap), ?_, ?_⟩
  · intro V hV
    obtain ⟨W, hW, rfl⟩ := Finset.mem_image.mp hV
    exact Submodule.map_ne_top_iff.mpr (hF W hW)
  · intro q hq x hInf hTwo hThree
    let x' : Fin (Fintype.card I) → ℤ := fun i => x (e.symm i)
    have hInf' : ∀ i, ‖A'.mulVec (fun j => (x' j : ℚ)) i‖ ≤ Real.exp (c' 0 i * q) := by
      have heq := profile_mulVec_reindex e A (fun j => (x j : ℚ))
      change A'.mulVec (fun j => (x' j : ℚ)) =
        profileCoordinateEquiv e (A.mulVec (fun j => (x j : ℚ))) at heq
      intro i
      rw [heq]
      exact hInf (e.symm i)
    have hTwo' : ∀ i, (padicNorm 2 (x' i : ℚ) : ℝ) ≤ Real.exp (c' 1 i * q) :=
      fun i => hTwo (e.symm i)
    have hThree' : ∀ i, (padicNorm 3 (x' i : ℚ) : ℝ) ≤ Real.exp (c' 2 i * q) :=
      fun i => hThree (e.symm i)
    obtain ⟨V, hV, hxV⟩ := hcover q hq x' hInf' hTwo' hThree'
    refine ⟨V.map E.symm.toLinearMap, Finset.mem_image.mpr ⟨V, hV, rfl⟩, ?_⟩
    refine Submodule.mem_map.mpr ⟨(fun i => (x' i : ℚ)), hxV, ?_⟩
    change E.symm (E (fun i => (x i : ℚ))) = _
    exact E.symm_apply_apply _

end
end Bounty

end SubmissionComponent_ThreePlaceSubspaceCoverReindex

/- Component RationalThreePlaceSubspaceTheorem; SHA256 8268d47b982520135b40928dde99c90448e87c0e19e55c98c35e93bd081babce -/
section SubmissionComponent_RationalThreePlaceSubspaceTheorem
/- The rational three-place Subspace Theorem for integer coordinate forms at 2 and 3. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def rational_three_place_subspace_cover_fin : RationalThreePlaceSubspaceCoverFin := by
  classical
  intro d hd A hA c ρ hρ hsum hcfin
  let : NeZero d := ⟨by omega⟩
  let M : ℝ := ∑ v, ∑ i, |c v i|
  have hcBound : ∀ v i, |c v i| ≤ M := by
    intro v i
    exact (Finset.single_le_sum (fun j _ => abs_nonneg (c v j)) (Finset.mem_univ i)).trans
      (Finset.single_le_sum (fun w _ => Finset.sum_nonneg (fun j _ => abs_nonneg (c w j)))
        (Finset.mem_univ v))
  obtain ⟨C, T, _, hT, hwitness⟩ := exists_threePlace_compound_witnesses hd A hA M ρ hρ
  let S : Set ℝ := {q | T ≤ q ∧ ∃ x ∈ rationalThreePlaceDomain A c q, x ≠ 0}
  have hS (q : ℝ) (hq : q ∈ S) : 0 ≤ q := le_trans (by linarith) hq.1
  have hex : ∀ q : ℝ, ∃ (k : Fin d) (p : Equiv.Perm (Fin d))
      (H : Matrix (Fin d) (Fin d) ℤ),
      q ∈ S → ThreePlaceCompoundWitnessData A c q hA C ρ k p H := by
    intro q
    by_cases hq : q ∈ S
    · obtain ⟨k, p, H, hdata⟩ := hwitness c q hcBound
        (fun i => hcfin 1 i (by decide)) (fun i => hcfin 2 i (by decide)) hsum hq.1 hq.2
      exact ⟨k, p, H, fun _ => hdata⟩
    · exact ⟨⟨1, by omega⟩, Equiv.refl _, 1, fun h => False.elim (hq h)⟩
  choose cut p H hdata using hex
  let K := {k : Fin d // 1 ≤ k.val}
  let U (k : K) : Set ℝ := {q | q ∈ S ∧ cut q = k.val}
  have hfam (k : K) : ∃ G : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ G, V ≠ ⊤) ∧
      ∀ q ∈ U k, Submodule.span ℚ
        (((H q).map (Int.castRingHom ℚ)).col '' {i : Fin d | i.val < k.val.val}) ∈ G := by
    refine exists_finite_varying_profile_prefix_family k.property k.val.isLt A hA
      (fun q => threePlaceCompoundProfile A c q hA (p q) k.val) C (threePlaceGapRate d ρ / 2)
      (by exact div_pos (threePlaceGapRate_pos hd hρ) (by norm_num)) (U k)
      (fun q hq => hS q hq.1) ?_ ?_ H ?_ ?_ ?_ ?_
    · intro q hq v s
      have hh := (hdata q hq.1).2.2.1
      rw [hq.2] at hh
      exact hh v s
    · intro q hq
      have hh := (hdata q hq.1).2.2.2.1
      rw [hq.2] at hh
      exact hh
    · intro q hq
      exact (hdata q hq.1).2.1
    · intro q hq i t ht
      have hh := (hdata q hq.1).2.2.2.2.1
      rw [hq.2] at hh
      have hmap : compoundMatrix (d - k.val.val) ((H q).map (Int.castRingHom ℚ)) =
          (compoundMatrix (d - k.val.val) (H q)).map (Int.castRingHom ℚ) :=
        compoundMatrix_map (Int.castRingHom ℚ) _ (H q)
      rw [hmap]
      exact (hh t ht).1 i
    · intro q hq i t ht
      have hh := (hdata q hq.1).2.2.2.2.1
      rw [hq.2] at hh
      have hmap : compoundMatrix (d - k.val.val) ((H q).map (Int.castRingHom ℚ)) =
          (compoundMatrix (d - k.val.val) (H q)).map (Int.castRingHom ℚ) :=
        compoundMatrix_map (Int.castRingHom ℚ) _ (H q)
      rw [hmap]
      exact (hh t ht).2.1 i
    · intro q hq i t ht
      have hh := (hdata q hq.1).2.2.2.2.1
      rw [hq.2] at hh
      have hmap : compoundMatrix (d - k.val.val) ((H q).map (Int.castRingHom ℚ)) =
          (compoundMatrix (d - k.val.val) (H q)).map (Int.castRingHom ℚ) :=
        compoundMatrix_map (Int.castRingHom ℚ) _ (H q)
      rw [hmap]
      exact (hh t ht).2.2 i
  choose G hG hcover using hfam
  obtain ⟨B, hB, hsmall⟩ := exists_bounded_exponential_subspace_cover hd A hA (c 0) T
  let F : Finset (Submodule ℚ (Fin d → ℚ)) := B ∪ ({⊥} ∪ Finset.univ.biUnion G)
  refine ⟨F, ?_, ?_⟩
  · intro V hV
    rcases Finset.mem_union.mp hV with hV | hV
    · exact hB V hV
    · rcases Finset.mem_union.mp hV with hV | hV
      · have hv : V = ⊥ := Finset.mem_singleton.mp hV
        rw [hv]
        exact bot_ne_top
      · obtain ⟨k, _, hk⟩ := Finset.mem_biUnion.mp hV
        exact hG k V hk
  · intro q hq x hInf hTwo hThree
    by_cases hx : x = 0
    · refine ⟨⊥, Finset.mem_union_right _ (Finset.mem_union_left _ (Finset.mem_singleton_self _)), ?_⟩
      simp only [hx, Pi.zero_apply, Int.cast_zero, Submodule.mem_bot]
      rfl
    by_cases hqT : q ≤ T
    · obtain ⟨V, hV, hxV⟩ := hsmall q hq hqT x hInf
      exact ⟨V, Finset.mem_union_left _ hV, hxV⟩
    have hxD : x ∈ rationalThreePlaceDomain A c q := by
      refine ⟨?_, hTwo, hThree⟩
      intro i
      have hh := hInf i
      rw [← Rat.norm_cast_real, Real.norm_eq_abs] at hh
      simpa [Matrix.mulVec, dotProduct, Matrix.map_apply, Rat.cast_sum, Rat.cast_mul] using hh
    have hqS : q ∈ S := ⟨le_of_not_ge hqT, x, hxD, hx⟩
    let k : K := ⟨cut q, (hdata q hqS).1⟩
    let V := Submodule.span ℚ
      (((H q).map (Int.castRingHom ℚ)).col '' {i : Fin d | i.val < (cut q).val})
    refine ⟨V, Finset.mem_union_right _ (Finset.mem_union_right _ ?_), ?_⟩
    · apply Finset.mem_biUnion.mpr
      exact ⟨k, Finset.mem_univ k, hcover k q ⟨hqS, rfl⟩⟩
    · exact (hdata q hqS).2.2.2.2.2 x hxD

def rational_three_place_subspace_cover : RationalThreePlaceSubspaceCover :=
  rationalThreePlaceSubspaceCover_of_fin rational_three_place_subspace_cover_fin

end
end Bounty

end SubmissionComponent_RationalThreePlaceSubspaceTheorem

/- Component ThreePlaceOneFormFiniteCover; SHA256 92a2aa7d7d20125da3544ce3517209561ab7868d469a2b9242b3de1ee471be42 -/
section SubmissionComponent_ThreePlaceOneFormFiniteCover
/- The geometric cover implies the actual integer one-form cover in each
finite dimension. Zero values and small primitive heights are included. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def integer_oneForm_finite_cover_of_three_place
    (hST : RationalThreePlaceSubspaceCover) {d : ℕ} (hd : 2 ≤ d)
    (a : Fin d → ℚ) (k : Fin d) (hak : a k ≠ 0)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ G : Finset (Fin d → ℚ), (∀ b ∈ G, b ≠ 0) ∧
      ∀ x : Fin d → ℤ, x ≠ 0 →
        (twoThreeOneFormProduct a (fun i => (x i : ℚ)) k : ℝ) <
          Height.mulHeight (fun i => (x i : ℚ)) ^ (-ε) →
        ∃ b ∈ G, (∑ i, b i * (x i : ℚ)) = 0 := by
  classical
  have hd' : 2 ≤ Fintype.card (Fin d) := by simpa using hd
  obtain ⟨M, hM, C, hC, hprofile⟩ := exists_finite_primitive_oneForm_profiles
    (by omega : 0 < d) a k ε hε
  have hAc : (oneFormRowMatrix a k).det ≠ 0 := by rwa [oneFormRowMatrix_det]
  have hcovers (c : ↥C) := three_place_subspace_cover_normals hST (Fin d) hd'
    (oneFormRowMatrix a k) hAc c.val (ε / 2) (by positivity)
    (by simpa only [neg_div] using (hC c.val c.property).2.1)
    (hC c.val c.property).2.2
  choose F hF hcover using hcovers
  obtain ⟨S, hS, hsmallcover⟩ := finite_small_height_normal_cover hd'
  let E : Finset (Fin d → ℚ) := Finset.univ.image (fun i => Pi.single i 1)
  let P : Finset (Fin d → ℚ) := Finset.univ.biUnion F
  let G : Finset (Fin d → ℚ) := P ∪ (S ∪ ({a} ∪ E))
  have ha : a ≠ 0 := by intro h; exact hak (congrFun h k)
  have hE : ∀ b ∈ E, b ≠ 0 := by
    intro b hb
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hb
    intro h
    have hh := congrFun h i
    simpa using hh
  have hG : ∀ b ∈ G, b ≠ 0 := by
    intro b hb
    rcases Finset.mem_union.mp hb with hb | hb
    · obtain ⟨c, _, hc⟩ := Finset.mem_biUnion.mp hb
      exact hF c b hc
    · rcases Finset.mem_union.mp hb with hb | hb
      · exact hS b hb
      · rcases Finset.mem_union.mp hb with hb | hb
        · simpa only [Finset.mem_singleton.mp hb] using ha
        · exact hE b hb
  refine ⟨G, hG, ?_⟩
  apply oneForm_primitive_cover_to_integer a k ε G
  intro x hx hprim hprod
  by_cases hcoords : ∀ i, x i ≠ 0
  · by_cases hax : (∑ i, a i * (x i : ℚ)) = 0
    · exact ⟨a, by simp [G], hax⟩
    · by_cases hheight : 1 ≤ Height.logHeight (fun i => (x i : ℚ))
      · obtain ⟨c, hc, hp⟩ := hprofile x hprim hheight hcoords hax hprod
        obtain ⟨b, hb, hbx⟩ := hcover ⟨c, hc⟩
          (Height.logHeight (fun i => (x i : ℚ))) (by linarith) x
          (fun i => hp 0 i) (fun i => hp 1 i) (fun i => hp 2 i)
        refine ⟨b, Finset.mem_union_left _ ?_, hbx⟩
        exact Finset.mem_biUnion.mpr ⟨⟨c, hc⟩, Finset.mem_univ _, hb⟩
      · obtain ⟨b, hb, hbx⟩ := hsmallcover x hx hprim (lt_of_not_ge hheight)
        exact ⟨b, Finset.mem_union_right _ (Finset.mem_union_left _ hb), hbx⟩
  · push_neg at hcoords
    obtain ⟨i, hi⟩ := hcoords
    refine ⟨Pi.single i 1, ?_, ?_⟩
    · apply Finset.mem_union_right
      apply Finset.mem_union_right
      apply Finset.mem_union_right
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
    · simp [Pi.single_apply, hi]


end
end Bounty

end SubmissionComponent_ThreePlaceOneFormFiniteCover

/- Component FiniteHyperplaneElimination; SHA256 914801643fb8c3288c4f6723f2932ed213ba1febb5f159342fc387ce3d531e16 -/
section SubmissionComponent_FiniteHyperplaneElimination
/- Exact deletion of a coordinate subject to a fixed rational hyperplane relation. -/

namespace Bounty

universe u

def hyperplaneDeleteCoefficient {I : Type u} (a d : I → ℚ) (k : I) :
    {i : I // i ≠ k} → ℚ :=
  fun i => d i - d k * a i / a k

/-- Substitute for a coordinate with nonzero hyperplane coefficient. The remaining
coordinates are the original coordinates restricted to the complement of the pivot. -/
def finite_hyperplane_eliminate {I : Type u} [Fintype I] [DecidableEq I]
    (a d x : I → ℚ) (k : I) (hak : a k ≠ 0) (hax : ∑ i, a i * x i = 0) :
    (∑ i, d i * x i) =
      ∑ i : {i : I // i ≠ k}, hyperplaneDeleteCoefficient a d k i * x i := by
  have hfull : (∑ i, (d i - d k * a i / a k) * x i) = ∑ i, d i * x i := by
    calc
      _ = (∑ i, d i * x i) - (d k / a k) * ∑ i, a i * x i := by
        rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro i hi
        ring
      _ = _ := by rw [hax, mul_zero, sub_zero]
  have hpivot : (d k - d k * a k / a k) * x k = 0 := by
    field_simp [hak]
    ring
  have hdelete := Fintype.sum_eq_add_sum_subtype_ne
    (fun i => (d i - d k * a i / a k) * x i) k
  rw [hpivot, zero_add] at hdelete
  exact hfull.symm.trans hdelete

/-- A nonzero coefficient vector supplies a single pivot that works for every
target linear form and every vector on the hyperplane. -/
def finite_hyperplane_exists_elimination {I : Type u} [Fintype I] [DecidableEq I]
    (a : I → ℚ) (ha : a ≠ 0) :
    ∃ k : I, a k ≠ 0 ∧ ∀ d x : I → ℚ, (∑ i, a i * x i) = 0 →
      (∑ i, d i * x i) =
        ∑ i : {i : I // i ≠ k}, hyperplaneDeleteCoefficient a d k i * x i := by
  have hex : ∃ k, a k ≠ 0 := by
    by_contra! hh
    apply ha
    funext i
    exact hh i
  obtain ⟨k, hk⟩ := hex
  exact ⟨k, hk, fun d x hx => finite_hyperplane_eliminate a d x k hk hx⟩

def finite_hyperplane_delete_card_lt {I : Type u} [Fintype I] [DecidableEq I] (k : I) :
    Fintype.card {i : I // i ≠ k} < Fintype.card I :=
  Fintype.card_subtype_lt (x := k) (by simp)

def hyperplaneOptionVector {I : Type u} (P : ℚ) (x : I → ℚ) : Option I → ℚ
  | none => P
  | some i => x i

/-- If the integer coordinate has nonzero hyperplane coefficient, removing it
converts the integer approximation error into a linear form in the unit coordinates. -/
def finite_option_hyperplane_eliminate_integer {I : Type u} [Fintype I]
    (a : Option I → ℚ) (d x : I → ℚ) (P : ℤ) (ha : a none ≠ 0)
    (hax : ∑ j, a j * hyperplaneOptionVector (P : ℚ) x j = 0) :
    (∑ i, d i * x i) - (P : ℚ) =
      ∑ i, (d i + a (some i) / a none) * x i := by
  have hh : a none * (P : ℚ) + ∑ i, a (some i) * x i = 0 := by
    simpa only [Fintype.sum_option, hyperplaneOptionVector] using hax
  have hP : (P : ℚ) = -(∑ i, a (some i) * x i) / a none := by
    apply (eq_div_iff ha).mpr
    linear_combination hh
  rw [hP]
  calc
    _ = (∑ i, d i * x i) + (∑ i, a (some i) * x i) / a none := by ring
    _ = (∑ i, d i * x i) + ∑ i, (a (some i) / a none) * x i := by
      rw [Finset.sum_div]
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ = _ := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      ring

/-- If the hyperplane omits the integer coordinate, the integer stays unchanged
while one of the other coordinates is deleted. -/
def finite_option_hyperplane_eliminate_unit {I : Type u} [Fintype I] [DecidableEq I]
    (a : Option I → ℚ) (d x : I → ℚ) (P : ℤ) (ha : a none = 0)
    (k : I) (hak : a (some k) ≠ 0)
    (hax : ∑ j, a j * hyperplaneOptionVector (P : ℚ) x j = 0) :
    (∑ i, d i * x i) - (P : ℚ) =
      (∑ i : {i : I // i ≠ k},
        hyperplaneDeleteCoefficient (fun j => a (some j)) d k i * x i) - (P : ℚ) := by
  have hh : ∑ i, a (some i) * x i = 0 := by
    simpa only [Fintype.sum_option, hyperplaneOptionVector, ha, zero_mul, zero_add] using hax
  rw [finite_hyperplane_eliminate (fun j => a (some j)) d x k hak hh]


end Bounty

end SubmissionComponent_FiniteHyperplaneElimination

/- Component OneFormRigidity; SHA256 f0c0e2c69242908ef6d6778e2ad990a015476f5af5f5f8158396e4ecce1dd438 -/
section SubmissionComponent_OneFormRigidity
/- Finite-hyperplane induction conditional on the actual one-form S-arithmetic
Subspace Theorem. No arithmetic axiom or unconditional target is introduced. -/

namespace Bounty

noncomputable section
open scoped BigOperators

def oneFormExponent : ℝ := 1 / 0x2a30

def oneFormHeightFactor {I : Type*} [Fintype I] (x : I → ℚ) : ℝ :=
  Height.mulHeight x ^ (-oneFormExponent)

def oneFormHeightFactor_pos {I : Type*} [Fintype I] (x : I → ℚ) :
    0 < oneFormHeightFactor x :=
  Real.rpow_pos_of_pos (Height.mulHeight_pos x) _

def oneFormHeightFactor_le_one {I : Type*} [Fintype I] (x : I → ℚ) :
    oneFormHeightFactor x ≤ 1 := by
  apply Real.rpow_le_one_of_one_le_of_nonpos (Height.one_le_mulHeight x)
  norm_num [oneFormExponent]

def oneFormHeightFactor_project {I J : Type*} [Fintype I] [Fintype J]
    (f : J → I) (x : I → ℚ) :
    oneFormHeightFactor x ≤ oneFormHeightFactor (x ∘ f) := by
  apply Real.rpow_le_rpow_of_nonpos (Height.mulHeight_pos (x ∘ f))
    (Height.mulHeight_comp_le f x)
  norm_num [oneFormExponent]

def twoThreeInteger_of_int (P : ℤ) : TwoThreeInteger (P : ℚ) := by
  exact ⟨0, 0, P, by simp⟩

def twoThreeInteger_of_unit {x : ℚ} (hx : TwoThreeUnit x) : TwoThreeInteger x := by
  obtain ⟨a, b, rfl⟩ := hx
  cases a with
  | ofNat a =>
    cases b with
    | ofNat b =>
      refine ⟨0, 0, (2 : ℤ) ^ a * (3 : ℤ) ^ b, ?_⟩
      simp
    | negSucc b =>
      refine ⟨0, b + 1, (2 : ℤ) ^ a, ?_⟩
      simp [zpow_negSucc, div_eq_mul_inv]
  | negSucc a =>
    cases b with
    | ofNat b =>
      refine ⟨a + 1, 0, (3 : ℤ) ^ b, ?_⟩
      simp [zpow_negSucc, div_eq_mul_inv, mul_comm]
    | negSucc b =>
      refine ⟨a + 1, b + 1, 1, ?_⟩
      simp [zpow_negSucc, div_eq_mul_inv, mul_comm]

/-- The actual finite rational hyperplane-cover assertion, specialized only in
dimension, places, and exponent. This is a proposition, not an axiom. -/
def OneFormCover405 : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I],
    2 ≤ Fintype.card I → Fintype.card I ≤ 0x195 →
    ∀ (d : I → ℚ) (k : I), d k ≠ 0 →
    ∃ F : Finset (I → ℚ), (∀ a ∈ F, a ≠ 0) ∧
      ∀ x : I → ℚ, (∀ i, TwoThreeInteger (x i)) → x ≠ 0 →
        (twoThreeOneFormProduct d x k : ℝ) < oneFormHeightFactor x →
        ∃ a ∈ F, (∑ i, a i * x i) = 0

private def positive_common_bound {A : Type*} [Fintype A]
    (c : A → ℝ) (hc : ∀ a, 0 < c a) :
    ∃ C : ℝ, 0 < C ∧ C ≤ 1 ∧ ∀ a, C ≤ c a := by
  classical
  have hh : ∀ s : Finset A, (∀ a ∈ s, 0 < c a) →
      ∃ C : ℝ, 0 < C ∧ C ≤ 1 ∧ ∀ a ∈ s, C ≤ c a := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro hs
      exact ⟨1, by norm_num, le_rfl, by simp⟩
    | @insert a s ha ih =>
      intro hs
      obtain ⟨C, hC, hC1, hCs⟩ := ih (fun b hb => hs b (by simp [hb]))
      refine ⟨min (c a) C, lt_min (hs a (by simp)) hC,
        (min_le_right _ _).trans hC1, ?_⟩
      intro b hb
      rcases Finset.mem_insert.mp hb with rfl | hb
      · exact min_le_left _ _
      · exact (min_le_right _ _).trans (hCs b hb)
  obtain ⟨C, hC, hC1, hCs⟩ := hh Finset.univ (fun a _ => hc a)
  exact ⟨C, hC, hC1, fun a => hCs a (Finset.mem_univ a)⟩

def UnitOneFormLowerBound {I : Type} [Fintype I] (d : I → ℚ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ (u : I → ℚ), (∀ i, TwoThreeUnit (u i)) →
    ∀ t : ℝ, 0 < t → (∀ i, t ≤ |(u i : ℝ)|) →
      (∑ i, d i * u i) ≠ 0 →
      C * t * oneFormHeightFactor u ≤ |((∑ i, d i * u i : ℚ) : ℝ)|

def oneForm_unit_rigidity (hST : OneFormCover405)
    {I : Type} [Fintype I] [DecidableEq I]
    (hI : Fintype.card I ≤ 0x195) (d : I → ℚ) : UnitOneFormLowerBound d := by
  classical
  suffices h : ∀ n : ℕ, ∀ (J : Type) [Fintype J] [DecidableEq J],
      Fintype.card J = n → n ≤ 0x195 → ∀ c : J → ℚ, UnitOneFormLowerBound c by
    exact h (Fintype.card I) I rfl hI d
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro J instF instD hcard hmax c
    by_cases hc : c = 0
    · refine ⟨1, by norm_num, ?_⟩
      intro u hu t ht htu hn
      simp [hc] at hn
    have hex : ∃ k, c k ≠ 0 := by
      by_contra! hh
      exact hc (funext hh)
    obtain ⟨k, hk⟩ := hex
    by_cases hlarge : 2 ≤ Fintype.card J
    · obtain ⟨F, hF, hcover⟩ := hST J hlarge (by omega) c k hk
      have hlocal : ∀ a : F, ∃ C : ℝ, 0 < C ∧
          ∀ (u : J → ℚ), (∀ i, TwoThreeUnit (u i)) →
          ∀ t : ℝ, 0 < t → (∀ i, t ≤ |(u i : ℝ)|) →
          (∑ i, c i * u i) ≠ 0 → (∑ i, a.1 i * u i) = 0 →
          C * t * oneFormHeightFactor u ≤ |((∑ i, c i * u i : ℚ) : ℝ)| := by
        intro a
        obtain ⟨l, hl, _⟩ := finite_hyperplane_exists_elimination a.1 (hF a.1 a.2)
        let K := {i : J // i ≠ l}
        have hlt : Fintype.card K < n := by
          simpa only [K, ← hcard] using finite_hyperplane_delete_card_lt l
        obtain ⟨C, hC, hbound⟩ := ih (Fintype.card K) hlt K rfl (by omega)
          (hyperplaneDeleteCoefficient a.1 c l)
        refine ⟨C, hC, ?_⟩
        intro u hu t ht htu hn hax
        have heq := finite_hyperplane_eliminate a.1 c u l hl hax
        have hn' : (∑ i : K, hyperplaneDeleteCoefficient a.1 c l i * u i) ≠ 0 := by
          rw [← heq]
          exact hn
        have hb := hbound (fun i : K => u i) (fun i => hu i) t ht
          (fun i => htu i) hn'
        rw [← heq] at hb
        calc
          C * t * oneFormHeightFactor u ≤
              C * t * oneFormHeightFactor (fun i : K => u i) :=
            mul_le_mul_of_nonneg_left (oneFormHeightFactor_project Subtype.val u)
              (mul_nonneg hC.le ht.le)
          _ ≤ _ := hb
      choose C hC hbound using hlocal
      obtain ⟨B, hB, hB1, hBC⟩ := positive_common_bound C hC
      refine ⟨B, hB, ?_⟩
      intro u hu t ht htu hn
      by_cases hp : (twoThreeOneFormProduct c u k : ℝ) < oneFormHeightFactor u
      · have hune : u ≠ 0 := by
          intro hzero
          simp [hzero] at hn
        obtain ⟨a, ha, hax⟩ := hcover u (fun i => twoThreeInteger_of_unit (hu i)) hune hp
        let af : F := ⟨a, ha⟩
        calc
          B * t * oneFormHeightFactor u ≤ C af * t * oneFormHeightFactor u :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right (hBC af) ht.le)
              (oneFormHeightFactor_pos u).le
          _ ≤ _ := hbound af u hu t ht htu hn hax
      · have hdiv : oneFormHeightFactor u ≤
            |((∑ i, c i * u i : ℚ) : ℝ)| / |(u k : ℝ)| := by
          have hh := le_of_not_gt hp
          rw [twoThreeOneFormProduct_units c u k hu] at hh
          simpa only [Rat.cast_div, Rat.cast_abs] using hh
        have huk : 0 < |(u k : ℝ)| := by
          exact_mod_cast abs_pos.mpr (twoThreeUnit_pos (hu k)).ne'
        have hm := (le_div_iff₀ huk).mp hdiv
        have hBt : B * t ≤ |(u k : ℝ)| :=
          (mul_le_mul_of_nonneg_right hB1 ht.le).trans (by simpa using htu k)
        exact (mul_le_mul_of_nonneg_right hBt (oneFormHeightFactor_pos u).le).trans
          (by simpa only [mul_comm] using hm)
    · haveI : Subsingleton J := Fintype.card_le_one_iff_subsingleton.mp (by omega)
      have hck : 0 < |(c k : ℝ)| := by exact_mod_cast abs_pos.mpr hk
      refine ⟨|(c k : ℝ)|, hck, ?_⟩
      intro u hu t ht htu hn
      have hs : (∑ i, c i * u i) = c k * u k := by
        apply Fintype.sum_eq_single k
        intro i hi
        exact False.elim (hi (Subsingleton.elim i k))
      rw [hs, Rat.cast_mul, abs_mul]
      calc
        |(c k : ℝ)| * t * oneFormHeightFactor u ≤
            |(c k : ℝ)| * |(u k : ℝ)| * oneFormHeightFactor u :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (htu k) hck.le) (oneFormHeightFactor_pos u).le
        _ ≤ _ := mul_le_of_le_one_right (by positivity) (oneFormHeightFactor_le_one u)


def optionOneFormCoefficient {I : Type*} (d : I → ℚ) : Option I → ℚ
  | none => -1
  | some i => d i

def optionOneFormCoefficient_sum {I : Type*} [Fintype I]
    (d u : I → ℚ) (P : ℤ) :
    (∑ j, optionOneFormCoefficient d j * hyperplaneOptionVector (P : ℚ) u j) =
      (∑ i, d i * u i) - (P : ℚ) := by
  simp only [Fintype.sum_option, optionOneFormCoefficient, hyperplaneOptionVector]
  ring

def oneFormHeightFactor_option_project {I J : Type*} [Fintype I] [Fintype J]
    (f : J → I) (P : ℚ) (u : I → ℚ) :
    oneFormHeightFactor (hyperplaneOptionVector P u) ≤
      oneFormHeightFactor (hyperplaneOptionVector P (u ∘ f)) := by
  have he : hyperplaneOptionVector P u ∘ Option.map f =
      hyperplaneOptionVector P (u ∘ f) := by
    funext j
    cases j <;> rfl
  simpa only [he] using
    oneFormHeightFactor_project (Option.map f) (hyperplaneOptionVector P u)

def oneForm_integer_product_le {I : Type*} [Fintype I] [DecidableEq I]
    (d u : I → ℚ) (P : ℤ) (hu : ∀ i, TwoThreeUnit (u i)) :
    (twoThreeOneFormProduct (optionOneFormCoefficient d)
      (hyperplaneOptionVector (P : ℚ) u) none : ℝ) ≤
        |(((∑ i, d i * u i) - (P : ℚ) : ℚ) : ℝ)| := by
  have hh := twoThreeOneFormProduct_integer_le (optionOneFormCoefficient d) P u hu
  have he : (fun i : Option I => i.elim (P : ℚ) u) =
      hyperplaneOptionVector (P : ℚ) u := by
    funext i
    cases i <;> rfl
  rw [he] at hh
  have he' (i : Option I) : i.elim (P : ℚ) u = hyperplaneOptionVector (P : ℚ) u i :=
    congrFun he i
  simp_rw [he'] at hh
  rw [optionOneFormCoefficient_sum] at hh
  exact_mod_cast hh

def IntegerOneFormLowerBound {I : Type} [Fintype I] (d : I → ℚ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ (P : ℤ) (u : I → ℚ), (∀ i, TwoThreeUnit (u i)) →
    ∀ t : ℝ, 0 < t → t ≤ 1 → (∀ i, t ≤ |(u i : ℝ)|) →
      ((∑ i, d i * u i) - (P : ℚ)) ≠ 0 →
      C * t * oneFormHeightFactor (hyperplaneOptionVector (P : ℚ) u) ≤
        |(((∑ i, d i * u i) - (P : ℚ) : ℚ) : ℝ)|

def oneForm_integer_rigidity (hST : OneFormCover405)
    {I : Type} [Fintype I] [DecidableEq I]
    (hI : Fintype.card I + 1 ≤ 0x195) (d : I → ℚ) : IntegerOneFormLowerBound d := by
  classical
  suffices h : ∀ n : ℕ, ∀ (J : Type) [Fintype J] [DecidableEq J],
      Fintype.card J = n → n + 1 ≤ 0x195 → ∀ c : J → ℚ, IntegerOneFormLowerBound c by
    exact h (Fintype.card I) I rfl hI d
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro J instF instD hcard hmax c
    by_cases hz : Fintype.card J = 0
    · haveI : IsEmpty J := Fintype.card_eq_zero_iff.mp hz
      refine ⟨1, by norm_num, ?_⟩
      intro P u hu t ht ht1 htu hn
      have hP : P ≠ 0 := by
        intro hzero
        simp [hzero] at hn
      have hPabs : 1 ≤ |(P : ℝ)| := by
        have hp : (0 : ℤ) < |P| := abs_pos.mpr hP
        have hp1 : (1 : ℤ) ≤ |P| := by omega
        exact_mod_cast hp1
      have he : |(((∑ i, c i * u i) - (P : ℚ) : ℚ) : ℝ)| = |(P : ℝ)| := by simp
      rw [he, one_mul]
      exact ((mul_le_mul_of_nonneg_right ht1
        (oneFormHeightFactor_pos (hyperplaneOptionVector (P : ℚ) u)).le).trans
          (by simpa using oneFormHeightFactor_le_one (hyperplaneOptionVector (P : ℚ) u))).trans hPabs
    · obtain ⟨F, hF, hcover⟩ := hST (Option J) (by simp; omega)
        (by simpa only [Fintype.card_option, hcard] using hmax)
        (optionOneFormCoefficient c) none (by simp [optionOneFormCoefficient])
      have hlocal : ∀ a : F, ∃ C : ℝ, 0 < C ∧
          ∀ (P : ℤ) (u : J → ℚ), (∀ i, TwoThreeUnit (u i)) →
          ∀ t : ℝ, 0 < t → t ≤ 1 → (∀ i, t ≤ |(u i : ℝ)|) →
          ((∑ i, c i * u i) - (P : ℚ)) ≠ 0 →
          (∑ j, a.1 j * hyperplaneOptionVector (P : ℚ) u j) = 0 →
          C * t * oneFormHeightFactor (hyperplaneOptionVector (P : ℚ) u) ≤
            |(((∑ i, c i * u i) - (P : ℚ) : ℚ) : ℝ)| := by
        intro a
        by_cases ha0 : a.1 none = 0
        · have hex : ∃ l : J, a.1 (some l) ≠ 0 := by
            by_contra! hh
            apply hF a.1 a.2
            funext j
            cases j with
            | none => exact ha0
            | some i => exact hh i
          obtain ⟨l, hl⟩ := hex
          let K := {i : J // i ≠ l}
          have hlt : Fintype.card K < n := by
            simpa only [K, ← hcard] using finite_hyperplane_delete_card_lt l
          obtain ⟨C, hC, hbound⟩ := ih (Fintype.card K) hlt K rfl (by omega)
            (hyperplaneDeleteCoefficient (fun i => a.1 (some i)) c l)
          refine ⟨C, hC, ?_⟩
          intro P u hu t ht ht1 htu hn hax
          have heq := finite_option_hyperplane_eliminate_unit a.1 c u P ha0 l hl hax
          have hn' : ((∑ i : K,
              hyperplaneDeleteCoefficient (fun j => a.1 (some j)) c l i * u i) - (P : ℚ)) ≠ 0 := by
            rw [← heq]
            exact hn
          have hb := hbound P (fun i : K => u i) (fun i => hu i) t ht ht1
            (fun i => htu i) hn'
          rw [← heq] at hb
          calc
            C * t * oneFormHeightFactor (hyperplaneOptionVector (P : ℚ) u) ≤
                C * t * oneFormHeightFactor
                  (hyperplaneOptionVector (P : ℚ) (fun i : K => u i)) :=
              mul_le_mul_of_nonneg_left (oneFormHeightFactor_option_project Subtype.val (P : ℚ) u)
                (mul_nonneg hC.le ht.le)
            _ ≤ _ := hb
        · obtain ⟨C, hC, hbound⟩ := oneForm_unit_rigidity hST (by omega : Fintype.card J ≤ 0x195)
            (fun i => c i + a.1 (some i) / a.1 none)
          refine ⟨C, hC, ?_⟩
          intro P u hu t ht ht1 htu hn hax
          have heq := finite_option_hyperplane_eliminate_integer a.1 c u P ha0 hax
          have hn' : (∑ i, (c i + a.1 (some i) / a.1 none) * u i) ≠ 0 := by
            rw [← heq]
            exact hn
          have hb := hbound u hu t ht htu hn'
          rw [← heq] at hb
          calc
            C * t * oneFormHeightFactor (hyperplaneOptionVector (P : ℚ) u) ≤
                C * t * oneFormHeightFactor u :=
              mul_le_mul_of_nonneg_left
                (oneFormHeightFactor_project some (hyperplaneOptionVector (P : ℚ) u))
                (mul_nonneg hC.le ht.le)
            _ ≤ _ := hb
      choose C hC hbound using hlocal
      obtain ⟨B, hB, hB1, hBC⟩ := positive_common_bound C hC
      refine ⟨B, hB, ?_⟩
      intro P u hu t ht ht1 htu hn
      let x := hyperplaneOptionVector (P : ℚ) u
      by_cases hp : (twoThreeOneFormProduct (optionOneFormCoefficient c) x none : ℝ) <
          oneFormHeightFactor x
      · have hxs : ∀ j, TwoThreeInteger (x j) := by
          intro j
          cases j with
          | none => exact twoThreeInteger_of_int P
          | some i => exact twoThreeInteger_of_unit (hu i)
        have hxne : x ≠ 0 := by
          intro hzero
          have he := optionOneFormCoefficient_sum c u P
          change (∑ j, optionOneFormCoefficient c j * x j) = _ at he
          simp only [hzero, Pi.zero_apply, mul_zero, Finset.sum_const_zero] at he
          exact hn he.symm
        obtain ⟨a, ha, hax⟩ := hcover x hxs hxne hp
        let af : F := ⟨a, ha⟩
        calc
          B * t * oneFormHeightFactor x ≤ C af * t * oneFormHeightFactor x :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right (hBC af) ht.le) (oneFormHeightFactor_pos x).le
          _ ≤ _ := hbound af P u hu t ht ht1 htu hn hax
      · have hfac : oneFormHeightFactor x ≤
            |(((∑ i, c i * u i) - (P : ℚ) : ℚ) : ℝ)| :=
          (le_of_not_gt hp).trans (oneForm_integer_product_le c u P hu)
        have hBt : B * t ≤ 1 :=
          (mul_le_mul_of_nonneg_right hB1 ht.le).trans (by simpa using ht1)
        exact (mul_le_mul_of_nonneg_right hBt (oneFormHeightFactor_pos x).le).trans
          (by simpa using hfac)


end
end Bounty

end SubmissionComponent_OneFormRigidity

/- Component ReturnTruncationNonzero; SHA256 bf4cf6c23eff274b784d81d78fbca28bb84906c97bc8418bc32151c6452ef6ff -/
section SubmissionComponent_ReturnTruncationNonzero
/- Elementary valuation lemmas for nonvanishing of separated return truncations. -/

namespace Bounty

open Filter
open scoped Topology

def returnCoefficient4_ne_zero (i : Fin 4) : returnEventCoefficient4 i ≠ 0 := by
  fin_cases i <;> norm_num [returnEventCoefficient4]

def returnCoefficient4_twoAdic (i : Fin 4) :
    padicValRat 2 (returnEventCoefficient4 i : ℚ) = (![0, 3, 0, 2] : Fin 4 → ℤ) i := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (by norm_num)
  have h105 : padicValRat 2 (0x69 : ℚ) = 0 := padicValRat_nat_zero (by norm_num)
  have h3 : padicValRat 2 (3 : ℚ) = 0 := padicValRat_nat_zero (by norm_num)
  have h21 : padicValRat 2 (21 : ℚ) = 0 := padicValRat_nat_zero (by norm_num)
  have h15 : padicValRat 2 (15 : ℚ) = 0 := padicValRat_nat_zero (by norm_num)
  have h168 : padicValRat 2 (0xa8 : ℚ) = 3 := by
    rw [show (0xa8 : ℚ) = (2 : ℚ) ^ 3 * 21 by norm_num,
      padicValRat.mul (by norm_num) (by norm_num), padicValRat.pow, h2, h21]
    norm_num
  have h60 : padicValRat 2 (60 : ℚ) = 2 := by
    rw [show (60 : ℚ) = (2 : ℚ) ^ 2 * 15 by norm_num,
      padicValRat.mul (by norm_num) (by norm_num), padicValRat.pow, h2, h15]
    norm_num
  fin_cases i <;> norm_num [returnEventCoefficient4, h105, h168, h3, h60]

def returnCoefficient4_twoAdic_bounds (i : Fin 4) :
    0 ≤ padicValRat 2 (returnEventCoefficient4 i : ℚ) ∧
      padicValRat 2 (returnEventCoefficient4 i : ℚ) ≤ 3 := by
  rw [returnCoefficient4_twoAdic]
  fin_cases i <;> norm_num

def twoAdic_int_nonneg (z : ℤ) : 0 ≤ padicValRat 2 (z : ℚ) := by
  rw [padicValRat.of_int]
  positivity

def twoAdic_four : padicValRat 2 (4 : ℚ) = 2 := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : padicValRat 2 (2 : ℚ) = 1 := padicValRat.self (by norm_num)
  rw [show (4 : ℚ) = (2 : ℚ) ^ 2 by norm_num, padicValRat.pow, h2]
  norm_num

def twoAdic_three : padicValRat 2 (3 : ℚ) = 0 :=
  padicValRat_nat_zero (by norm_num : ¬ 2 ∣ 3)

def twoAdic_dyadic_int (z : ℤ) (hz : z ≠ 0) (n : ℕ) :
    padicValRat 2 ((z : ℚ) / (4 : ℚ) ^ n) = padicValRat 2 (z : ℚ) - 2 * n := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hzQ : (z : ℚ) ≠ 0 := by exact_mod_cast hz
  rw [padicValRat.div hzQ (by positivity), padicValRat.pow, twoAdic_four]
  ring

def twoAdic_add_ne_zero_of_lt {x y : ℚ}
    (hval : padicValRat 2 x < padicValRat 2 y) : x + y ≠ 0 := by
  intro hzero
  have he : x = -y := eq_neg_of_add_eq_zero_left hzero
  rw [he, padicValRat.neg] at hval
  exact (lt_irrefl _ hval)

def twoAdic_sum_lower_bound {ι : Type*} (s : Finset ι) (f : ι → ℚ) (k : ℤ)
    (hf : ∀ i ∈ s, f i ≠ 0 → k ≤ padicValRat 2 (f i))
    (hs : (∑ i ∈ s, f i) ≠ 0) : k ≤ padicValRat 2 (∑ i ∈ s, f i) := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  revert hf hs
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    intro hf hs
    rw [Finset.sum_insert ha] at hs ⊢
    have hrest : ∀ i ∈ s, f i ≠ 0 → k ≤ padicValRat 2 (f i) :=
      fun i hi => hf i (Finset.mem_insert_of_mem hi)
    by_cases hfa : f a = 0
    · simp only [hfa, zero_add] at hs ⊢
      exact ih hrest hs
    by_cases hfs : (∑ i ∈ s, f i) = 0
    · simp only [hfs, add_zero]
      exact hf a (Finset.mem_insert_self a s) hfa
    exact (le_min (hf a (Finset.mem_insert_self a s) hfa) (ih hrest hfs)).trans
      (padicValRat.min_le_padicValRat_add hs)

def twoAdic_sum_unique_min {ι : Type*} (s : Finset ι) (f : ι → ℚ)
    {a : ι} (ha : a ∈ s) (hfa : f a ≠ 0)
    (hmin : ∀ i ∈ s, i ≠ a → f i ≠ 0 → padicValRat 2 (f a) < padicValRat 2 (f i)) :
    (∑ i ∈ s, f i) ≠ 0 ∧ padicValRat 2 (∑ i ∈ s, f i) = padicValRat 2 (f a) := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [← Finset.add_sum_erase s f ha]
  by_cases hz : (∑ i ∈ s.erase a, f i) = 0
  · simp only [hz, add_zero]
    exact ⟨hfa, trivial⟩
  have hbound : padicValRat 2 (f a) + 1 ≤ padicValRat 2 (∑ i ∈ s.erase a, f i) := by
    apply twoAdic_sum_lower_bound (s.erase a) f _ _ hz
    intro i hi hfi
    have hh := hmin i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi) hfi
    omega
  have hlt : padicValRat 2 (f a) < padicValRat 2 (∑ i ∈ s.erase a, f i) := by omega
  have hne := twoAdic_add_ne_zero_of_lt hlt
  exact ⟨hne, padicValRat.add_eq_of_lt hne hfa hz hlt⟩

def dyadic_integer_sum_unique_largest {ι : Type*} (s : Finset ι)
    (c : ι → ℤ) (n : ι → ℕ) {a : ι} (ha : a ∈ s) (hca : c a ≠ 0)
    (hgap : ∀ i ∈ s, i ≠ a →
      padicValRat 2 (c a : ℚ) < 2 * ((n a : ℤ) - n i)) :
    (∑ i ∈ s, (c i : ℚ) / (4 : ℚ) ^ n i) ≠ 0 ∧
      padicValRat 2 (∑ i ∈ s, (c i : ℚ) / (4 : ℚ) ^ n i) =
        padicValRat 2 (c a : ℚ) - 2 * n a := by
  have hcaQ : (c a : ℚ) ≠ 0 := by exact_mod_cast hca
  have haTerm : (c a : ℚ) / (4 : ℚ) ^ n a ≠ 0 := div_ne_zero hcaQ (by positivity)
  have hh := twoAdic_sum_unique_min s (fun i => (c i : ℚ) / (4 : ℚ) ^ n i)
    ha haTerm (by
      intro i hi hia hfi
      have hci : c i ≠ 0 := by
        intro hz
        simp [hz] at hfi
      rw [twoAdic_dyadic_int _ hca, twoAdic_dyadic_int _ hci]
      have hb := twoAdic_int_nonneg (c i)
      have hg := hgap i hi hia
      omega)
  simpa only [twoAdic_dyadic_int _ hca] using hh

def twoAdic_nat_log_bound (N : ℕ) (hN : 0 < N) :
    (padicValRat 2 (N : ℚ) : ℝ) * Real.log 2 ≤ Real.log (N : ℝ) := by
  have hdvd : (2 : ℕ) ^ padicValNat 2 N ∣ N := pow_padicValNat_dvd
  have hle : (2 : ℕ) ^ padicValNat 2 N ≤ N := Nat.le_of_dvd hN hdvd
  have hleR : (2 : ℝ) ^ padicValNat 2 N ≤ (N : ℝ) := by exact_mod_cast hle
  have hh := Real.log_le_log (by positivity : (0 : ℝ) < (2 : ℝ) ^ padicValNat 2 N) hleR
  rw [Real.log_pow] at hh
  simpa only [padicValRat.of_nat, Int.cast_natCast] using hh

def twoAdic_three_pow_sub_one_log_bound (p : ℕ) (hp : 0 < p) :
    (padicValRat 2 ((3 : ℚ) ^ p - 1) : ℝ) * Real.log 2 ≤ (p : ℝ) * Real.log 3 := by
  have hpw : 1 < (3 : ℕ) ^ p := one_lt_pow₀ (by norm_num) (by omega)
  have hN : 0 < (3 : ℕ) ^ p - 1 := Nat.sub_pos_of_lt hpw
  have hcast : (((3 : ℕ) ^ p - 1 : ℕ) : ℚ) = (3 : ℚ) ^ p - 1 := by
    rw [Nat.cast_sub hpw.le]
    norm_num
  have hh := twoAdic_nat_log_bound ((3 : ℕ) ^ p - 1) hN
  rw [hcast] at hh
  have hNreal : (0 : ℝ) < (((3 : ℕ) ^ p - 1 : ℕ) : ℝ) := by exact_mod_cast hN
  have hleR : (((3 : ℕ) ^ p - 1 : ℕ) : ℝ) ≤ ((3 : ℕ) ^ p : ℝ) := by
    exact_mod_cast (Nat.sub_le ((3 : ℕ) ^ p) 1)
  have hlog := Real.log_le_log hNreal hleR
  norm_num only [Nat.cast_pow, Nat.cast_ofNat, Real.log_pow] at hlog
  exact hh.trans hlog

def returnCoefficient4_shifted_twoAdic (p : ℕ) (i : Fin 4) :
    padicValRat 2 ((3 : ℚ) ^ p * (returnEventCoefficient4 i : ℚ)) =
      padicValRat 2 (returnEventCoefficient4 i : ℚ) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hc : (returnEventCoefficient4 i : ℚ) ≠ 0 := by
    exact_mod_cast returnCoefficient4_ne_zero i
  rw [padicValRat.mul (by positivity) hc, padicValRat.pow, twoAdic_three]
  ring

def returnMiddleCoefficient_twoAdic_bound (r : ℕ) (i : Fin 4) :
    (padicValRat 2 (((3 : ℚ) ^ (rotationReturns r).p.toNat - 1) *
      (returnEventCoefficient4 i : ℚ)) : ℝ) * Real.log 2 ≤
        returnScale r + 3 * Real.log 2 := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hp : 0 < (rotationReturns r).p.toNat := by
    have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
    have hq := (rotationReturns r).q_pos
    omega
  have hfactor : (3 : ℚ) ^ (rotationReturns r).p.toNat - 1 ≠ 0 :=
    ne_of_gt (sub_pos.mpr (one_lt_pow₀ (by norm_num) (by omega)))
  have hc : (returnEventCoefficient4 i : ℚ) ≠ 0 := by
    exact_mod_cast returnCoefficient4_ne_zero i
  have hv := twoAdic_three_pow_sub_one_log_bound (rotationReturns r).p.toNat hp
  have hC : (padicValRat 2 (returnEventCoefficient4 i : ℚ) : ℝ) ≤ 3 := by
    exact_mod_cast (returnCoefficient4_twoAdic_bounds i).2
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hCb := mul_le_mul_of_nonneg_right hC hlog.le
  have hoffset : ((rotationReturns r).p.toNat : ℝ) * Real.log 3 ≤ returnScale r := by
    simpa [returnEventOffset, Fin.ext_iff] using
      (returnEventOffset_bounds r (0, 0)).2
  rw [padicValRat.mul hfactor hc, Int.cast_add, add_mul]
  linarith

def twoAdic_sum_nonneg {ι : Type*} (s : Finset ι) (f : ι → ℚ)
    (hf : ∀ i ∈ s, 0 ≤ padicValRat 2 (f i)) :
    0 ≤ padicValRat 2 (∑ i ∈ s, f i) := by
  by_cases hz : (∑ i ∈ s, f i) = 0
  · simp [hz]
  exact twoAdic_sum_lower_bound s f 0 (fun i hi _ => hf i hi) hz

def twoAdic_add_nonneg {x y : ℚ}
    (hx : 0 ≤ padicValRat 2 x) (hy : 0 ≤ padicValRat 2 y) :
    0 ≤ padicValRat 2 (x + y) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hz : x + y = 0
  · simp [hz]
  exact (le_min hx hy).trans (padicValRat.min_le_padicValRat_add hz)

def twoAdic_sub_nonneg {x y : ℚ}
    (hx : 0 ≤ padicValRat 2 x) (hy : 0 ≤ padicValRat 2 y) :
    0 ≤ padicValRat 2 (x - y) := by
  rw [sub_eq_add_neg]
  exact twoAdic_add_nonneg hx (by simpa only [padicValRat.neg] using hy)

def returnTernaryWeightedUnit_twoAdic (r : ℕ) (i : ReturnEventFamily) (n : ℕ)
    (hi : 2 ≤ i.1) :
    0 ≤ padicValRat 2 ((returnEventCoefficient i : ℚ) * returnRationalUnit r i n) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hc : returnEventCoefficient i = 0
  · simp [hc]
  have hcQ : (returnEventCoefficient i : ℚ) ≠ 0 := by exact_mod_cast hc
  rw [padicValRat.mul hcQ (returnRationalUnit_ne_zero r i n),
    returnRationalUnit_primeMonomial, rationalPrimeMonomial_val_two]
  apply add_nonneg (twoAdic_int_nonneg _)
  unfold returnUnitFourExponent
  rw [if_neg (not_lt.mpr hi)]
  split <;> positivity

noncomputable def returnDyadicTruncation (r : ℕ) (T : ℝ) : ℚ :=
  ∑ i : Fin 4,
    ((∑ n ∈ returnTruncationIndices r T (0, i),
      (returnEventCoefficient (0, i) : ℚ) * returnRationalUnit r (0, i) n) +
     (∑ n ∈ returnTruncationIndices r T (1, i),
      (returnEventCoefficient (1, i) : ℚ) * returnRationalUnit r (1, i) n))

noncomputable def returnTernaryTruncation (r : ℕ) (T : ℝ) : ℚ :=
  ∑ i : Fin 4,
    ((∑ n ∈ returnTruncationIndices r T (2, i),
      (returnEventCoefficient (2, i) : ℚ) * returnRationalUnit r (2, i) n) +
     (∑ n ∈ returnTruncationIndices r T (3, i),
      (returnEventCoefficient (3, i) : ℚ) * returnRationalUnit r (3, i) n))

def returnRationalTruncation_split_primes (r : ℕ) (T : ℝ) :
    returnRationalTruncation r T = returnDyadicTruncation r T + returnTernaryTruncation r T := by
  simp only [returnRationalTruncation, returnDyadicTruncation, returnTernaryTruncation,
    Fintype.sum_prod_type, Fin.sum_univ_four]
  ring

def returnTernaryTruncation_twoAdic (r : ℕ) (T : ℝ) :
    0 ≤ padicValRat 2 (returnTernaryTruncation r T) := by
  unfold returnTernaryTruncation
  apply twoAdic_sum_nonneg
  intro i _
  apply twoAdic_add_nonneg
  · apply twoAdic_sum_nonneg
    intro n _
    exact returnTernaryWeightedUnit_twoAdic r (2, i) n (by norm_num [Fin.le_def])
  · apply twoAdic_sum_nonneg
    intro n _
    exact returnTernaryWeightedUnit_twoAdic r (3, i) n (by norm_num [Fin.le_def])

def returnTernaryTruncation_difference_twoAdic (r : ℕ) (T₁ T₂ : ℝ) :
    0 ≤ padicValRat 2 (returnTernaryTruncation r T₂ - returnTernaryTruncation r T₁) :=
  twoAdic_sub_nonneg (returnTernaryTruncation_twoAdic r T₂)
    (returnTernaryTruncation_twoAdic r T₁)

def returnRationalTruncation_ne_of_dyadic_valuation (r : ℕ) (T₁ T₂ : ℝ)
    (hdyadic : padicValRat 2 (returnDyadicTruncation r T₂ - returnDyadicTruncation r T₁) < 0) :
    returnRationalTruncation r T₂ ≠ returnRationalTruncation r T₁ := by
  have hternary := returnTernaryTruncation_difference_twoAdic r T₁ T₂
  have hne := twoAdic_add_ne_zero_of_lt (hdyadic.trans_le hternary)
  intro he
  apply hne
  rw [returnRationalTruncation_split_primes, returnRationalTruncation_split_primes] at he
  linear_combination he

abbrev ReturnDyadicIndex := Σ _ : Fin 4, ℕ

noncomputable def returnDyadicIndices (r : ℕ) (T : ℝ) : Finset ReturnDyadicIndex :=
  Finset.univ.sigma (fun i => returnTruncationIndices r T (0, i))

noncomputable def returnDyadicNumerator (r : ℕ) (T : ℝ) (a : ReturnDyadicIndex) : ℤ := by
  classical
  exact returnEventCoefficient4 a.1 * ((3 : ℤ) ^ (rotationReturns r).p.toNat -
    if (a.2 : ℝ) * Real.log 4 < T then 1 else 0)

def mem_returnDyadicIndices (r : ℕ) (T : ℝ) (a : ReturnDyadicIndex) :
    a ∈ returnDyadicIndices r T ↔
      0 < a.2 ∧ jumpVisit4 r a.1 a.2 ≠ 0 ∧
        (a.2 : ℝ) * Real.log 4 - ((rotationReturns r).p.toNat : ℝ) * Real.log 3 < T := by
  classical
  simp [returnDyadicIndices, mem_returnTruncationIndices, returnEventVisit, returnEventTime,
    returnEventStep, returnEventOffset, Fin.lt_def, and_assoc]

def mem_returnUnshiftedDyadicIndices (r : ℕ) (T : ℝ) (i : Fin 4) (n : ℕ) :
    n ∈ returnTruncationIndices r T (1, i) ↔
      0 < n ∧ jumpVisit4 r i n ≠ 0 ∧ (n : ℝ) * Real.log 4 < T := by
  classical
  simp [mem_returnTruncationIndices, returnEventVisit, returnEventTime,
    returnEventStep, returnEventOffset, Fin.lt_def, Fin.ext_iff, and_assoc]

def returnUnshiftedDyadicIndices_subset (r : ℕ) (T : ℝ) (i : Fin 4) :
    returnTruncationIndices r T (1, i) ⊆ returnTruncationIndices r T (0, i) := by
  intro n hn
  have hh := (mem_returnUnshiftedDyadicIndices r T i n).mp hn
  have ho : 0 ≤ ((rotationReturns r).p.toNat : ℝ) * Real.log 3 := by positivity
  have hmem : (⟨i, n⟩ : ReturnDyadicIndex) ∈ returnDyadicIndices r T := by
    apply (mem_returnDyadicIndices r T ⟨i, n⟩).mpr
    exact ⟨hh.1, hh.2.1, by linarith [hh.2.2]⟩
  simpa only [returnDyadicIndices, Finset.mem_sigma, Finset.mem_univ, true_and] using hmem

def returnDyadicTruncation_expanded (r : ℕ) (T : ℝ) :
    returnDyadicTruncation r T = ∑ i : Fin 4,
      ((3 : ℚ) ^ (rotationReturns r).p.toNat *
        (∑ n ∈ returnTruncationIndices r T (0, i), (returnEventCoefficient4 i : ℚ) / (4 : ℚ) ^ n) -
        ∑ n ∈ returnTruncationIndices r T (1, i), (returnEventCoefficient4 i : ℚ) / (4 : ℚ) ^ n) := by
  unfold returnDyadicTruncation
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.mul_sum, sub_eq_add_neg, ← Finset.sum_neg_distrib]
  congr 1
  · apply Finset.sum_congr rfl
    intro n _
    norm_num [returnEventCoefficient, returnRationalUnit, Fin.ext_iff]
    ring
  · apply Finset.sum_congr rfl
    intro n _
    norm_num [returnEventCoefficient, returnRationalUnit, Fin.ext_iff]
    ring

def returnDyadicTruncation_as_integer_sum (r : ℕ) (T : ℝ) :
    returnDyadicTruncation r T =
      ∑ a ∈ returnDyadicIndices r T, (returnDyadicNumerator r T a : ℚ) / (4 : ℚ) ^ a.2 := by
  classical
  rw [returnDyadicTruncation_expanded]
  simp only [returnDyadicIndices, Finset.sum_sigma]
  apply Finset.sum_congr rfl
  intro i _
  have hsub := returnUnshiftedDyadicIndices_subset r T i
  have hsum :
      (∑ n ∈ returnTruncationIndices r T (1, i), (returnEventCoefficient4 i : ℚ) / (4 : ℚ) ^ n) =
      ∑ n ∈ returnTruncationIndices r T (0, i),
        if (n : ℝ) * Real.log 4 < T then (returnEventCoefficient4 i : ℚ) / (4 : ℚ) ^ n else 0 := by
    apply Finset.sum_subset_zero_on_sdiff hsub
    · intro n hn
      have hns := (Finset.mem_sdiff.mp hn).1
      have hnu := (Finset.mem_sdiff.mp hn).2
      have hmem : (⟨i, n⟩ : ReturnDyadicIndex) ∈ returnDyadicIndices r T := by
        simpa only [returnDyadicIndices, Finset.mem_sigma, Finset.mem_univ, true_and] using hns
      have hh := (mem_returnDyadicIndices r T ⟨i, n⟩).mp hmem
      have ht : ¬ (n : ℝ) * Real.log 4 < T := by
        intro ht
        exact hnu ((mem_returnUnshiftedDyadicIndices r T i n).mpr ⟨hh.1, hh.2.1, ht⟩)
      simp only [if_neg ht]
    · intro n hn
      have ht := ((mem_returnUnshiftedDyadicIndices r T i n).mp hn).2.2
      simp only [if_pos ht]
  rw [hsum, Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro n _
  by_cases ht : (n : ℝ) * Real.log 4 < T <;>
    simp [returnDyadicNumerator, ht] <;> ring

def twoAdic_sum_scaled_lower_bound {ι : Type*} (s : Finset ι) (f : ι → ℚ)
    (k c : ℝ) (hc : 0 < c)
    (hf : ∀ i ∈ s, f i ≠ 0 → k < (padicValRat 2 (f i) : ℝ) * c)
    (hs : (∑ i ∈ s, f i) ≠ 0) : k < (padicValRat 2 (∑ i ∈ s, f i) : ℝ) * c := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  revert hf hs
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    intro hf hs
    rw [Finset.sum_insert ha] at hs ⊢
    have hrest : ∀ i ∈ s, f i ≠ 0 → k < (padicValRat 2 (f i) : ℝ) * c :=
      fun i hi => hf i (Finset.mem_insert_of_mem hi)
    by_cases hfa : f a = 0
    · simp only [hfa, zero_add] at hs ⊢
      exact ih hrest hs
    by_cases hfs : (∑ i ∈ s, f i) = 0
    · simp only [hfs, add_zero]
      exact hf a (Finset.mem_insert_self a s) hfa
    have hmin := padicValRat.min_le_padicValRat_add (p := 2) hs
    rcases le_total (padicValRat 2 (f a)) (padicValRat 2 (∑ i ∈ s, f i)) with hle | hle
    · rw [min_eq_left hle] at hmin
      have hminR : (padicValRat 2 (f a) : ℝ) ≤
          (padicValRat 2 (f a + ∑ i ∈ s, f i) : ℝ) := by exact_mod_cast hmin
      exact (hf a (Finset.mem_insert_self a s) hfa).trans_le
        (mul_le_mul_of_nonneg_right hminR hc.le)
    · rw [min_eq_right hle] at hmin
      have hminR : (padicValRat 2 (∑ i ∈ s, f i) : ℝ) ≤
          (padicValRat 2 (f a + ∑ i ∈ s, f i) : ℝ) := by exact_mod_cast hmin
      exact (ih hrest hfs).trans_le (mul_le_mul_of_nonneg_right hminR hc.le)

def return_log_four_eq_two_log_two : Real.log 4 = 2 * Real.log 2 := by
  rw [show (4 : ℝ) = (2 : ℝ) ^ 2 by norm_num, Real.log_pow]
  norm_num

def returnDyadicTruncation_small_cutoff (r : ℕ) (T : ℝ)
    (hT : T < 5 * returnScale r) :
    -6 * returnScale r < (padicValRat 2 (returnDyadicTruncation r T) : ℝ) * Real.log 2 := by
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hL := returnScale_pos r
  by_cases hz : returnDyadicTruncation r T = 0
  · simp only [hz, padicValRat.zero, Int.cast_zero, zero_mul]
    linarith
  rw [returnDyadicTruncation_as_integer_sum] at hz ⊢
  apply twoAdic_sum_scaled_lower_bound _ _ _ _ hlog _ hz
  intro a ha hterm
  have hnum : returnDyadicNumerator r T a ≠ 0 := by
    intro he
    simp [he] at hterm
  rw [twoAdic_dyadic_int _ hnum]
  have hidx := ((mem_returnDyadicIndices r T a).mp ha).2.2
  have hoffset : ((rotationReturns r).p.toNat : ℝ) * Real.log 3 ≤ returnScale r := by
    simpa [returnEventOffset, Fin.ext_iff] using (returnEventOffset_bounds r (0, 0)).2
  have hval : (0 : ℝ) ≤ (padicValRat 2 (returnDyadicNumerator r T a : ℚ) : ℝ) := by
    exact_mod_cast twoAdic_int_nonneg (returnDyadicNumerator r T a)
  have hpos := mul_nonneg hval hlog.le
  rw [return_log_four_eq_two_log_two] at hidx
  push_cast
  nlinarith

def returnDyadicIndices_largest (r : ℕ) (T : ℝ)
    (hT : 2 * returnScale r < T)
    (hsep : ∀ (i j : Fin 4) (m n : ℕ), jumpVisit4 r i m ≠ 0 →
      jumpVisit4 r j n ≠ 0 → (i ≠ j ∨ m ≠ n) → (1 : ℤ) < |(n : ℤ) - m|) :
    ∃ a ∈ returnDyadicIndices r T,
      T - 2 * returnScale r < (a.2 : ℝ) * Real.log 4 ∧
      (∀ b ∈ returnDyadicIndices r T, b.2 ≤ a.2) ∧
      (∀ b ∈ returnDyadicIndices r T, b ≠ a → b.2 + 2 ≤ a.2) := by
  classical
  obtain ⟨n, hn, hlow, hupp, hvisit⟩ := jumpVisit4_log_covered r 0 T hT
  have hnmem : (⟨0, n⟩ : ReturnDyadicIndex) ∈ returnDyadicIndices r T := by
    apply (mem_returnDyadicIndices r T ⟨0, n⟩).mpr
    have ho : 0 ≤ ((rotationReturns r).p.toNat : ℝ) * Real.log 3 := by positivity
    exact ⟨hn, by rw [hvisit]; norm_num, by linarith⟩
  obtain ⟨a, ha, hmax⟩ := Finset.exists_max_image (returnDyadicIndices r T)
    (fun a => a.2) ⟨⟨0, n⟩, hnmem⟩
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  refine ⟨a, ha, ?_, hmax, ?_⟩
  · have hna : (n : ℝ) ≤ (a.2 : ℝ) := by exact_mod_cast hmax ⟨0, n⟩ hnmem
    exact hlow.trans_le (mul_le_mul_of_nonneg_right hna hlog.le)
  · intro b hb hba
    have hne : b.1 ≠ a.1 ∨ b.2 ≠ a.2 := by
      by_contra hh
      push Not at hh
      exact hba (Sigma.ext hh.1 (heq_of_eq hh.2))
    have hs := hsep b.1 a.1 b.2 a.2
      ((mem_returnDyadicIndices r T b).mp hb).2.1
      ((mem_returnDyadicIndices r T a).mp ha).2.1 hne
    have hm := hmax b hb
    rw [abs_of_nonneg (by omega : (0 : ℤ) ≤ (a.2 : ℤ) - b.2)] at hs
    omega

def returnDyadicTruncation_large_cutoff (r : ℕ) (T : ℝ)
    (hL : 3 * Real.log 2 < returnScale r) (hT : 10 * returnScale r < T)
    (hsep : ∀ (i j : Fin 4) (m n : ℕ), jumpVisit4 r i m ≠ 0 →
      jumpVisit4 r j n ≠ 0 → (i ≠ j ∨ m ≠ n) → (1 : ℤ) < |(n : ℤ) - m|) :
    returnDyadicTruncation r T ≠ 0 ∧
      (padicValRat 2 (returnDyadicTruncation r T) : ℝ) * Real.log 2 < -6 * returnScale r := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hscale := returnScale_pos r
  obtain ⟨a, ha, hlow, hmax, hgap⟩ := returnDyadicIndices_largest r T (by linarith) hsep
  have hidx : 8 * returnScale r < (a.2 : ℝ) * (2 * Real.log 2) := by
    rw [return_log_four_eq_two_log_two] at hlow
    linarith
  by_cases ht : (a.2 : ℝ) * Real.log 4 < T
  · have hnum : ∀ b ∈ returnDyadicIndices r T,
        returnDyadicNumerator r T b = returnEventCoefficient4 b.1 *
          ((3 : ℤ) ^ (rotationReturns r).p.toNat - 1) := by
      intro b hb
      have hba : (b.2 : ℝ) ≤ (a.2 : ℝ) := by exact_mod_cast hmax b hb
      have hbt : (b.2 : ℝ) * Real.log 4 < T :=
        (mul_le_mul_of_nonneg_right hba (Real.log_pos (by norm_num)).le).trans_lt ht
      simp [returnDyadicNumerator, hbt]
    have hsum := dyadic_integer_sum_unique_largest (returnDyadicIndices r T)
      (fun b => returnEventCoefficient4 b.1) (fun b => b.2) ha
      (returnCoefficient4_ne_zero a.1) (by
        intro b hb hba
        have hv := (returnCoefficient4_twoAdic_bounds a.1).2
        have hg := hgap b hb hba
        omega)
    have hp : 0 < (rotationReturns r).p.toNat := by
      have hb := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
      have hq := (rotationReturns r).q_pos
      omega
    have hfactor : (3 : ℚ) ^ (rotationReturns r).p.toNat - 1 ≠ 0 :=
      ne_of_gt (sub_pos.mpr (one_lt_pow₀ (by norm_num) (by omega)))
    have hc : (returnEventCoefficient4 a.1 : ℚ) ≠ 0 := by
      exact_mod_cast returnCoefficient4_ne_zero a.1
    have hD : returnDyadicTruncation r T = ((3 : ℚ) ^ (rotationReturns r).p.toNat - 1) *
        (∑ b ∈ returnDyadicIndices r T, (returnEventCoefficient4 b.1 : ℚ) / (4 : ℚ) ^ b.2) := by
      rw [returnDyadicTruncation_as_integer_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro b hb
      rw [hnum b hb]
      push_cast
      ring
    have hv : padicValRat 2 (returnDyadicTruncation r T) =
        padicValRat 2 (((3 : ℚ) ^ (rotationReturns r).p.toNat - 1) *
          (returnEventCoefficient4 a.1 : ℚ)) - 2 * a.2 := by
      rw [hD, padicValRat.mul hfactor hsum.1, hsum.2, padicValRat.mul hfactor hc]
      ring
    refine ⟨by rw [hD]; exact mul_ne_zero hfactor hsum.1, ?_⟩
    have hb := returnMiddleCoefficient_twoAdic_bound r a.1
    rw [hv]
    push_cast
    nlinarith
  · have hnum : returnDyadicNumerator r T a = returnEventCoefficient4 a.1 *
        (3 : ℤ) ^ (rotationReturns r).p.toNat := by
      simp [returnDyadicNumerator, ht]
    have hnum_ne : returnDyadicNumerator r T a ≠ 0 := by
      rw [hnum]
      exact mul_ne_zero (returnCoefficient4_ne_zero a.1) (by positivity)
    have hval : padicValRat 2 (returnDyadicNumerator r T a : ℚ) =
        padicValRat 2 (returnEventCoefficient4 a.1 : ℚ) := by
      rw [hnum]
      push_cast
      rw [mul_comm, returnCoefficient4_shifted_twoAdic]
    have hsum := dyadic_integer_sum_unique_largest (returnDyadicIndices r T)
      (returnDyadicNumerator r T) (fun b => b.2) ha hnum_ne (by
        intro b hb hba
        rw [hval]
        have hv := (returnCoefficient4_twoAdic_bounds a.1).2
        have hg := hgap b hb hba
        omega)
    rw [returnDyadicTruncation_as_integer_sum]
    refine ⟨hsum.1, ?_⟩
    rw [hsum.2, hval]
    have hv : (padicValRat 2 (returnEventCoefficient4 a.1 : ℚ) : ℝ) ≤ 3 := by
      exact_mod_cast (returnCoefficient4_twoAdic_bounds a.1).2
    have hvbound := mul_le_mul_of_nonneg_right hv hlog.le
    push_cast
    nlinarith

def returnDyadicTruncation_difference_negative (r : ℕ) (T₁ T₂ : ℝ)
    (hL : 3 * Real.log 2 < returnScale r)
    (hT₁ : T₁ < 5 * returnScale r) (hT₂ : 10 * returnScale r < T₂)
    (hsep : ∀ (i j : Fin 4) (m n : ℕ), jumpVisit4 r i m ≠ 0 →
      jumpVisit4 r j n ≠ 0 → (i ≠ j ∨ m ≠ n) → (1 : ℤ) < |(n : ℤ) - m|) :
    padicValRat 2 (returnDyadicTruncation r T₂ - returnDyadicTruncation r T₁) < 0 := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hfirst := returnDyadicTruncation_small_cutoff r T₁ hT₁
  have hsecond := returnDyadicTruncation_large_cutoff r T₂ hL hT₂ hsep
  have hltR : (padicValRat 2 (returnDyadicTruncation r T₂) : ℝ) <
      (padicValRat 2 (returnDyadicTruncation r T₁) : ℝ) := by nlinarith [hsecond.2]
  have hlt : padicValRat 2 (returnDyadicTruncation r T₂) <
      padicValRat 2 (returnDyadicTruncation r T₁) := by exact_mod_cast hltR
  have hneg : padicValRat 2 (returnDyadicTruncation r T₂) < 0 := by
    have hscale := returnScale_pos r
    have hnegR : (padicValRat 2 (returnDyadicTruncation r T₂) : ℝ) < 0 := by
      nlinarith [hsecond.2]
    exact_mod_cast hnegR
  by_cases hzero : returnDyadicTruncation r T₁ = 0
  · simpa only [hzero, sub_zero] using hneg
  have hneg_ne : -returnDyadicTruncation r T₁ ≠ 0 := neg_ne_zero.mpr hzero
  have hltneg : padicValRat 2 (returnDyadicTruncation r T₂) <
      padicValRat 2 (-returnDyadicTruncation r T₁) := by simpa only [padicValRat.neg] using hlt
  have hsum_ne := twoAdic_add_ne_zero_of_lt hltneg
  rw [sub_eq_add_neg, padicValRat.add_eq_of_lt hsum_ne hsecond.1 hneg_ne hltneg]
  exact hneg

/-- The actual rational truncations at the two cutoff scales are eventually distinct.
This conclusion uses only visit coverage, visit separation, and integer valuations. -/
def returnRationalTruncation_separated_cutoffs :
    ∀ᶠ r in atTop, ∀ T₁ T₂ : ℝ,
      T₁ < 5 * returnScale r → 10 * returnScale r < T₂ →
      returnRationalTruncation r T₂ ≠ returnRationalTruncation r T₁ := by
  have hscale := returnScale_tendsto.eventually (eventually_gt_atTop (3 * Real.log 2))
  filter_upwards [hscale, jumpVisit4_all_indices_separate 1] with r hr hsep T₁ T₂ hT₁ hT₂
  exact returnRationalTruncation_ne_of_dyadic_valuation r T₁ T₂
    (returnDyadicTruncation_difference_negative r T₁ T₂ hr hT₁ hT₂ hsep)

end Bounty

end SubmissionComponent_ReturnTruncationNonzero

/- Component ReturnErrorDifference; SHA256 a922b78606dc12375ed413c10bb570c9cfea0021b1a5a18d882ed1534cf4ca7e -/
section SubmissionComponent_ReturnErrorDifference
/- The two errors have a common rational head and integral prefix. -/

namespace Bounty

def returnApproximationError_difference (z : ℚ) (r : ℕ) (T U : ℝ) :
    returnApproximationError z r U - returnApproximationError z r T =
      (returnRationalTruncation r T : ℝ) - (returnRationalTruncation r U : ℝ) := by
  unfold returnApproximationError
  rw [returnApproximation_linear_form, returnApproximation_linear_form]
  push_cast
  ring

def returnApproximationError_ne_zero_of_truncations_ne
    (z : ℚ) (r : ℕ) (T U : ℝ)
    (h : returnRationalTruncation r T ≠ returnRationalTruncation r U) :
    returnApproximationError z r T ≠ 0 ∨ returnApproximationError z r U ≠ 0 := by
  by_contra hh
  push Not at hh
  have he := returnApproximationError_difference z r T U
  rw [hh.1, hh.2, sub_self] at he
  have hr : (returnRationalTruncation r T : ℝ) = (returnRationalTruncation r U : ℝ) := by linarith
  exact h (Rat.cast_injective hr)


end Bounty

end SubmissionComponent_ReturnErrorDifference

/- Component ReturnUnitSeparation; SHA256 f648432f13523998682a8090dec82db6677fc4c02e63d1538c1d7f43e3cfdbf3 -/
section SubmissionComponent_ReturnUnitSeparation
/- Uniform arithmetic separation of the moving rational event units. -/

open Filter
open scoped Topology

namespace Bounty

def rationalPrimeMonomial_val_three (a b c : ℤ) :
    padicValRat 3 (rationalPrimeMonomial a b c) = b := by
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have h2 : padicValRat 3 2 = 0 := padicValRat_nat_zero (by norm_num : ¬ 3 ∣ 2)
  have h3 : padicValRat 3 3 = 1 := padicValRat.self (by norm_num)
  have h5 : padicValRat 3 5 = 0 := padicValRat_nat_zero (by norm_num : ¬ 3 ∣ 5)
  unfold rationalPrimeMonomial
  rw [padicValRat.mul (by positivity) (by positivity),
    padicValRat.mul (by positivity) (by positivity)]
  simp only [padicValRat.zpow, h2, h3, h5]
  ring

def returnRationalUnit_val_two (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    padicValRat 2 (returnRationalUnit r i n) = 2 * returnUnitFourExponent r i n := by
  rw [returnRationalUnit_primeMonomial, rationalPrimeMonomial_val_two]

def returnRationalUnit_val_three (r : ℕ) (i : ReturnEventFamily) (n : ℕ) :
    padicValRat 3 (returnRationalUnit r i n) = returnUnitThreeExponent r i n := by
  rw [returnRationalUnit_primeMonomial, rationalPrimeMonomial_val_three]

def jumpVisit3_all_indices_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : Fin 4, ∀ m n : ℕ,
      jumpVisit3 r i m ≠ 0 → jumpVisit3 r j n ≠ 0 →
      (i ≠ j ∨ m ≠ n) → (M : ℤ) < |(n : ℤ) - m| := by
  have hQ := rotationReturns_denominators_tendsto.2.eventually (eventually_gt_atTop M)
  have hh : ∀ᶠ r in atTop, ∀ i ∈ (Finset.univ : Finset (Fin 4)),
      ∀ j ∈ (Finset.univ : Finset (Fin 4)), ∀ m n : ℕ,
      jumpVisit3 r i m ≠ 0 → jumpVisit3 r j n ≠ 0 →
      (i ≠ j ∨ m ≠ n) → (M : ℤ) < |(n : ℤ) - m| := by
    apply (eventually_all_finset _).mpr
    intro i _
    apply (eventually_all_finset _).mpr
    intro j _
    by_cases hij : i = j
    · subst j
      filter_upwards [hQ] with r hr m n hm hn hne
      have hP := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
      have hmn : m ≠ n := hne.resolve_left (not_not.mpr rfl)
      rcases lt_or_gt_of_ne hmn with hlt | hlt
      · have hs := jumpVisit3_separated r i hlt hm hn
        rw [abs_of_nonneg (by omega : (0 : ℤ) ≤ (n : ℤ) - m)]
        omega
      · have hs := jumpVisit3_separated r i hlt hn hm
        rw [abs_of_nonpos (by omega : (n : ℤ) - m ≤ 0)]
        omega
    · filter_upwards [jumpVisit3_distinct_orbits_separate hij M] with r hr m n hm hn _
      exact hr m n hm hn
  filter_upwards [hh] with r hr i j
  exact hr i (Finset.mem_univ i) j (Finset.mem_univ j)

def returnUnitExponent_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : ReturnEventFamily, ∀ m n : ℕ,
      returnEventVisit r i m → returnEventVisit r j n →
      (i ≠ j ∨ m ≠ n) →
      (M : ℤ) < |returnUnitFourExponent r i m - returnUnitFourExponent r j n| ∨
      (M : ℤ) < |returnUnitThreeExponent r i m - returnUnitThreeExponent r j n| := by
  have hq := rotationReturns_denominators_tendsto.1.eventually (eventually_gt_atTop M)
  filter_upwards [hq, returnEventVisit_indices_diverge M,
    jumpVisit4_all_indices_separate M, jumpVisit3_all_indices_separate M]
    with r hqr hidx h4 h3 i j m n hm hn hne
  have hmr : M < m := hidx i m hm
  have hnr : M < n := hidx j n hn
  have hnum := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
  have hpr : (M : ℤ) < (rotationReturns r).p.toNat := by omega
  rcases i with ⟨a, b⟩
  rcases j with ⟨c, d⟩
  by_cases hac : a = c
  · subst c
    have hbd : b ≠ d ∨ m ≠ n := by
      by_contra hh
      push Not at hh
      have he : (a, b) = (a, d) := by rw [hh.1]
      exact hne.elim (fun h => h he) (fun h => h hh.2)
    by_cases ha : a < 2
    · have hm' : jumpVisit4 r b m ≠ 0 := by simpa only [returnEventVisit, if_pos ha] using hm.2
      have hn' : jumpVisit4 r d n ≠ 0 := by simpa only [returnEventVisit, if_pos ha] using hn.2
      have hs := h4 b d m n hm' hn' hbd
      left
      simpa only [returnUnitFourExponent, if_pos ha, neg_sub_neg] using hs
    · have hm' : jumpVisit3 r b m ≠ 0 := by simpa only [returnEventVisit, if_neg ha] using hm.2
      have hn' : jumpVisit3 r d n ≠ 0 := by simpa only [returnEventVisit, if_neg ha] using hn.2
      have hs := h3 b d m n hm' hn' hbd
      have ha0 : a ≠ 0 := by intro he; subst a; norm_num [Fin.lt_def] at ha
      right
      simpa only [returnUnitThreeExponent, if_neg ha0, if_neg ha, neg_sub_neg] using hs
  · fin_cases a <;> fin_cases c <;> norm_num [Fin.ext_iff] at hac <;>
      norm_num [returnUnitFourExponent, returnUnitThreeExponent, Fin.lt_def, Fin.ext_iff] <;>
      (try simp only [lt_abs]) <;> omega

def returnRationalUnit_quotient_valuations_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : ReturnEventFamily, ∀ m n : ℕ,
      returnEventVisit r i m → returnEventVisit r j n →
      (i ≠ j ∨ m ≠ n) →
      (M : ℤ) < |padicValRat 2 (returnRationalUnit r i m / returnRationalUnit r j n)| ∨
      (M : ℤ) < |padicValRat 3 (returnRationalUnit r i m / returnRationalUnit r j n)| := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  filter_upwards [returnUnitExponent_separate M] with r hr i j m n hm hn hne
  rw [padicValRat.div (returnRationalUnit_ne_zero r i m) (returnRationalUnit_ne_zero r j n),
    padicValRat.div (returnRationalUnit_ne_zero r i m) (returnRationalUnit_ne_zero r j n),
    returnRationalUnit_val_two, returnRationalUnit_val_two,
    returnRationalUnit_val_three, returnRationalUnit_val_three]
  rcases hr i j m n hm hn hne with h | h
  · left
    rw [← mul_sub, abs_mul]
    norm_num
    omega
  · exact Or.inr h

def returnRationalUnit_quotient_escapes_finset (s : Finset ℚ) :
    ∀ᶠ r in atTop, ∀ i j : ReturnEventFamily, ∀ m n : ℕ,
      returnEventVisit r i m → returnEventVisit r j n →
      (i ≠ j ∨ m ≠ n) →
      returnRationalUnit r i m / returnRationalUnit r j n ∉ s := by
  let f : ℚ → ℕ := fun x => max (padicValRat 2 x).natAbs (padicValRat 3 x).natAbs
  let M := s.sup f
  have hb (x : ℚ) (hx : x ∈ s) :
      |padicValRat 2 x| ≤ (M : ℤ) ∧ |padicValRat 3 x| ≤ (M : ℤ) := by
    have hh : f x ≤ M := Finset.le_sup hx
    have h2 : (padicValRat 2 x).natAbs ≤ M := (le_max_left _ _).trans hh
    have h3 : (padicValRat 3 x).natAbs ≤ M := (le_max_right _ _).trans hh
    constructor
    · simpa only [Int.natCast_natAbs] using (Nat.cast_le.mpr h2 :
        ((padicValRat 2 x).natAbs : ℤ) ≤ (M : ℤ))
    · simpa only [Int.natCast_natAbs] using (Nat.cast_le.mpr h3 :
        ((padicValRat 3 x).natAbs : ℤ) ≤ (M : ℤ))
  filter_upwards [returnRationalUnit_quotient_valuations_separate M]
    with r hr i j m n hm hn hne hmem
  have hb' := hb _ hmem
  exact (hr i j m n hm hn hne).elim (fun h => (not_lt_of_ge hb'.1) h)
    (fun h => (not_lt_of_ge hb'.2) h)

def returnRationalUnit_quotient_height_diverge (B : ℝ) :
    ∀ᶠ r in atTop, ∀ i j : ReturnEventFamily, ∀ m n : ℕ,
      returnEventVisit r i m → returnEventVisit r j n →
      (i ≠ j ∨ m ≠ n) →
      B < Height.mulHeight₁ (returnRationalUnit r i m / returnRationalUnit r j n) := by
  classical
  let s := (NumberField.finite_setOfPred_mulHeight₁_le ℚ B).toFinset
  filter_upwards [returnRationalUnit_quotient_escapes_finset s]
    with r hr i j m n hm hn hne
  apply lt_of_not_ge
  intro h
  apply hr i j m n hm hn hne
  simpa only [s, Set.Finite.mem_toFinset, Set.mem_ofPred_eq] using h

end Bounty

end SubmissionComponent_ReturnUnitSeparation

/- Component ReturnHeadSeparation; SHA256 5a2111dedc756cb181cfddb6e39d7bf02bfb393f59aaead62405a2775ca522e1 -/
section SubmissionComponent_ReturnHeadSeparation
/- Head-to-head and head-to-tail arithmetic separation. -/

open Filter
open scoped Topology

namespace Bounty

def rational_height_escape_of_valuations (V : ℕ → ℚ → Prop)
    (hV : ∀ M : ℕ, ∀ᶠ r in atTop, ∀ x : ℚ, V r x →
      (M : ℤ) < |padicValRat 2 x| ∨ (M : ℤ) < |padicValRat 3 x|) (B : ℝ) :
    ∀ᶠ r in atTop, ∀ x : ℚ, V r x → B < Height.mulHeight₁ x := by
  classical
  let s := (NumberField.finite_setOfPred_mulHeight₁_le ℚ B).toFinset
  let f : ℚ → ℕ := fun x => max (padicValRat 2 x).natAbs (padicValRat 3 x).natAbs
  let M := s.sup f
  have hb (x : ℚ) (hx : x ∈ s) :
      |padicValRat 2 x| ≤ (M : ℤ) ∧ |padicValRat 3 x| ≤ (M : ℤ) := by
    have hh : f x ≤ M := Finset.le_sup hx
    have h2 : (padicValRat 2 x).natAbs ≤ M := (le_max_left _ _).trans hh
    have h3 : (padicValRat 3 x).natAbs ≤ M := (le_max_right _ _).trans hh
    constructor
    · simpa only [Int.natCast_natAbs] using (Nat.cast_le.mpr h2 :
        ((padicValRat 2 x).natAbs : ℤ) ≤ (M : ℤ))
    · simpa only [Int.natCast_natAbs] using (Nat.cast_le.mpr h3 :
        ((padicValRat 3 x).natAbs : ℤ) ≤ (M : ℤ))
  filter_upwards [hV M] with r hr x hx
  apply lt_of_not_ge
  intro h
  have hmem : x ∈ s := by
    simpa only [s, Set.Finite.mem_toFinset, Set.mem_ofPred_eq] using h
  have hb' := hb x hmem
  exact (hr x hx).elim (fun hh => (not_lt_of_ge hb'.1) hh)
    (fun hh => (not_lt_of_ge hb'.2) hh)

def returnHeadUnit_val_two (r : ℕ) (j : Fin 4) :
    padicValRat 2 (returnHeadUnit r j) = 2 * returnHeadFourExponent r j := by
  rw [returnHeadUnit_primeMonomial, rationalPrimeMonomial_val_two]

def returnHeadUnit_val_three (r : ℕ) (j : Fin 4) :
    padicValRat 3 (returnHeadUnit r j) = returnHeadThreeExponent r j := by
  rw [returnHeadUnit_primeMonomial, rationalPrimeMonomial_val_three]

def returnHeadUnit_quotient_valuations_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ i j : Fin 4, i ≠ j →
      (M : ℤ) < |padicValRat 2 (returnHeadUnit r i / returnHeadUnit r j)| ∨
      (M : ℤ) < |padicValRat 3 (returnHeadUnit r i / returnHeadUnit r j)| := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hq := rotationReturns_denominators_tendsto.1.eventually (eventually_gt_atTop M)
  filter_upwards [hq] with r hqr i j hij
  have hnum := (rotationReturns r).numerator_bounds rotationSlope_bounds.1 rotationSlope_bounds.2
  have hpr : (M : ℤ) < (rotationReturns r).p.toNat := by omega
  rw [padicValRat.div (returnHeadUnit_ne_zero r i) (returnHeadUnit_ne_zero r j),
    padicValRat.div (returnHeadUnit_ne_zero r i) (returnHeadUnit_ne_zero r j),
    returnHeadUnit_val_two, returnHeadUnit_val_two,
    returnHeadUnit_val_three, returnHeadUnit_val_three]
  fin_cases i <;> fin_cases j <;> norm_num [Fin.ext_iff] at hij <;>
    norm_num [returnHeadFourExponent, returnHeadThreeExponent, Fin.lt_def, Fin.ext_iff] <;>
    (try simp only [lt_abs]) <;> omega

def returnHeadTail_quotient_valuations_separate (M : ℕ) :
    ∀ᶠ r in atTop, ∀ j : Fin 4, ∀ i : ReturnEventFamily, ∀ n : ℕ,
      returnEventVisit r i n →
      (M : ℤ) < |padicValRat 2 (returnHeadUnit r j / returnRationalUnit r i n)| ∨
      (M : ℤ) < |padicValRat 3 (returnHeadUnit r j / returnRationalUnit r i n)| := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  filter_upwards [returnEventVisit_indices_diverge M] with r hr j i n hn
  have hnr := hr i n hn
  have h4 : 0 ≤ returnHeadFourExponent r j := by
    unfold returnHeadFourExponent
    split_ifs <;> omega
  have h3 : 0 ≤ returnHeadThreeExponent r j := by
    unfold returnHeadThreeExponent
    split_ifs <;> omega
  rw [padicValRat.div (returnHeadUnit_ne_zero r j) (returnRationalUnit_ne_zero r i n),
    padicValRat.div (returnHeadUnit_ne_zero r j) (returnRationalUnit_ne_zero r i n),
    returnHeadUnit_val_two, returnRationalUnit_val_two,
    returnHeadUnit_val_three, returnRationalUnit_val_three]
  by_cases hi : i.1 < 2
  · left
    rw [returnUnitFourExponent, if_pos hi]
    apply lt_abs.mpr
    left
    omega
  · right
    have hi0 : i.1 ≠ 0 := by intro he; rw [he] at hi; norm_num [Fin.lt_def] at hi
    rw [returnUnitThreeExponent, if_neg hi0, if_neg hi]
    apply lt_abs.mpr
    left
    omega

def returnHeadUnit_quotient_height_diverge (B : ℝ) :
    ∀ᶠ r in atTop, ∀ i j : Fin 4, i ≠ j →
      B < Height.mulHeight₁ (returnHeadUnit r i / returnHeadUnit r j) := by
  let V : ℕ → ℚ → Prop := fun r x =>
    ∃ i j : Fin 4, i ≠ j ∧ x = returnHeadUnit r i / returnHeadUnit r j
  have hV (M : ℕ) : ∀ᶠ r in atTop, ∀ x : ℚ, V r x →
      (M : ℤ) < |padicValRat 2 x| ∨ (M : ℤ) < |padicValRat 3 x| := by
    filter_upwards [returnHeadUnit_quotient_valuations_separate M] with r hr x hx
    obtain ⟨i, j, hij, rfl⟩ := hx
    exact hr i j hij
  filter_upwards [rational_height_escape_of_valuations V hV B] with r hr i j hij
  exact hr _ ⟨i, j, hij, rfl⟩

def returnHeadTail_quotient_height_diverge (B : ℝ) :
    ∀ᶠ r in atTop, ∀ j : Fin 4, ∀ i : ReturnEventFamily, ∀ n : ℕ,
      returnEventVisit r i n →
      B < Height.mulHeight₁ (returnHeadUnit r j / returnRationalUnit r i n) := by
  let V : ℕ → ℚ → Prop := fun r x =>
    ∃ j : Fin 4, ∃ i : ReturnEventFamily, ∃ n : ℕ,
      returnEventVisit r i n ∧ x = returnHeadUnit r j / returnRationalUnit r i n
  have hV (M : ℕ) : ∀ᶠ r in atTop, ∀ x : ℚ, V r x →
      (M : ℤ) < |padicValRat 2 x| ∨ (M : ℤ) < |padicValRat 3 x| := by
    filter_upwards [returnHeadTail_quotient_valuations_separate M] with r hr x hx
    obtain ⟨j, i, n, hn, rfl⟩ := hx
    exact hr j i n hn
  filter_upwards [rational_height_escape_of_valuations V hV B] with r hr j i n hn
  exact hr _ ⟨j, i, n, hn, rfl⟩


end Bounty

end SubmissionComponent_ReturnHeadSeparation

/- Component ReturnApproximationSeparation; SHA256 979896e4db78ee31dbadea053e7e761bafe90ea4559da05108f970ae17fe8ad8 -/
section SubmissionComponent_ReturnApproximationSeparation
/- Separation is uniform across both changing cutoff sets, including their four heads. -/

open Filter
open scoped Topology

namespace Bounty

abbrev ReturnUnitKey := Fin 4 ⊕ (ReturnEventFamily × ℕ)

def returnApproximationKey {r : ℕ} {T : ℝ} : ReturnApproximationLabel r T → ReturnUnitKey :=
  Sum.elim Sum.inl (fun a => Sum.inr (a.1, a.2.1))

def returnApproximationKey_injective (r : ℕ) (T : ℝ) :
    Function.Injective (returnApproximationKey (r := r) (T := T)) := by
  intro i j h
  cases i with
  | inl a =>
    cases j with
    | inl b => exact congrArg Sum.inl (Sum.inl.inj h)
    | inr b => cases h
  | inr a =>
    cases j with
    | inl b => cases h
    | inr b =>
      have he : a.1 = b.1 ∧ a.2.1 = b.2.1 := by
        have hh := Sum.inr.inj h
        exact ⟨congrArg Prod.fst hh, congrArg Prod.snd hh⟩
      obtain ⟨a, m, hm⟩ := a
      obtain ⟨b, n, hn⟩ := b
      dsimp only at he
      rcases he with ⟨rfl, rfl⟩
      rfl

def returnApproximationUnit_quotient_height_diverge (B : ℝ) :
    ∀ᶠ r in atTop, ∀ T U : ℝ,
      ∀ i : ReturnApproximationLabel r T, ∀ j : ReturnApproximationLabel r U,
      returnApproximationKey i ≠ returnApproximationKey j →
      B < Height.mulHeight₁ (returnApproximationUnit r T i / returnApproximationUnit r U j) := by
  filter_upwards [returnHeadUnit_quotient_height_diverge B,
    returnHeadTail_quotient_height_diverge B, returnRationalUnit_quotient_height_diverge B]
    with r hhead hcross htail T U i j hij
  cases i with
  | inl a =>
    cases j with
    | inl b =>
      exact hhead a b (fun he => hij (by cases he; rfl))
    | inr b =>
      exact hcross a b.1 b.2.1
        ((mem_returnTruncationIndices r U b.1 b.2.1).mp b.2.2).1
  | inr a =>
    cases j with
    | inl b =>
      change B < Height.mulHeight₁ (returnRationalUnit r a.1 a.2.1 / returnHeadUnit r b)
      rw [show returnRationalUnit r a.1 a.2.1 / returnHeadUnit r b =
        (returnHeadUnit r b / returnRationalUnit r a.1 a.2.1)⁻¹ by rw [inv_div],
        Height.mulHeight₁_inv]
      exact hcross b a.1 a.2.1
        ((mem_returnTruncationIndices r T a.1 a.2.1).mp a.2.2).1
    | inr b =>
      have hdiff : a.1 ≠ b.1 ∨ a.2.1 ≠ b.2.1 := by
        by_contra hh
        push Not at hh
        apply hij
        exact congrArg Sum.inr (Prod.ext hh.1 hh.2)
      exact htail a.1 b.1 a.2.1 b.2.1
        ((mem_returnTruncationIndices r T a.1 a.2.1).mp a.2.2).1
        ((mem_returnTruncationIndices r U b.1 b.2.1).mp b.2.2).1 hdiff

end Bounty

end SubmissionComponent_ReturnApproximationSeparation

/- Component ReturnApproximationObstruction; SHA256 16bc16627d0259379b6ee8a764306c4d88535330d7c00b06ebe0d43ecc6d5ec7 -/
section SubmissionComponent_ReturnApproximationObstruction
/- Rationality would give nonzero exceptionally small finite return approximations. -/

open Filter
open scoped Topology

namespace Bounty

def returnApproximation_two_errors_not_zero (z : ℚ) :
    ∀ᶠ r in atTop, ∀ T U : ℝ,
      T < 5 * returnScale r → 10 * returnScale r < U →
      returnApproximationError z r T ≠ 0 ∨ returnApproximationError z r U ≠ 0 := by
  filter_upwards [returnRationalTruncation_separated_cutoffs] with r hr T U hT hU
  exact returnApproximationError_ne_zero_of_truncations_ne z r T U (hr T U hT hU).symm

def returnApproximation_nonzero_witness (z : ℚ)
    (hz : (z : ℝ) = 0xb4 * explicitDensity - 32) :
    ∀ᶠ r in atTop, ∃ T : ℝ,
      4 * returnScale r < T ∧ T < 11 * returnScale r ∧
      ReturnApproximationConditions z r T ∧ returnApproximationError z r T ≠ 0 := by
  filter_upwards [returnApproximation_two_cutoffs z hz,
    returnApproximation_two_errors_not_zero z] with r hcut hnz
  obtain ⟨T, U, hTlo, hThi, hUlo, hUhi, hdiff, hT, hU, hgapT, hgapU⟩ := hcut
  have hL := returnScale_pos r
  rcases hnz T U hThi hUlo with h | h
  · exact ⟨T, hTlo, by linarith, hT, h⟩
  · exact ⟨U, by linarith, hUhi, hU, h⟩

def rational_density_nonzero_return_approximations (h : ¬Irrational explicitDensity) :
    ∃ z : ℚ, (z : ℝ) = 0xb4 * explicitDensity - 32 ∧
      ∀ᶠ r in atTop, ∃ T : ℝ,
        4 * returnScale r < T ∧ T < 11 * returnScale r ∧
        ReturnApproximationConditions z r T ∧ returnApproximationError z r T ≠ 0 := by
  obtain ⟨z, hz, _, _⟩ := returnClearedIntegerHead_of_rational_density h
  exact ⟨z, hz, returnApproximation_nonzero_witness z hz⟩

def rational_density_nonzero_return_approximation_sequence
    (h : ¬Irrational explicitDensity) :
    ∃ z : ℚ, ∃ T : ℕ → ℝ,
      (z : ℝ) = 0xb4 * explicitDensity - 32 ∧
      ∀ᶠ r in atTop,
        4 * returnScale r < T r ∧ T r < 11 * returnScale r ∧
        ReturnApproximationConditions z r (T r) ∧ returnApproximationError z r (T r) ≠ 0 := by
  classical
  obtain ⟨z, hz, hh⟩ := rational_density_nonzero_return_approximations h
  obtain ⟨N, hN⟩ := eventually_atTop.mp hh
  have hex (r : ℕ) : ∃ T : ℝ, N ≤ r →
      4 * returnScale r < T ∧ T < 11 * returnScale r ∧
      ReturnApproximationConditions z r T ∧ returnApproximationError z r T ≠ 0 := by
    by_cases hr : N ≤ r
    · obtain ⟨T, hT⟩ := hN r hr
      exact ⟨T, fun _ => hT⟩
    · exact ⟨0, fun h => False.elim (hr h)⟩
  choose T hT using hex
  refine ⟨z, T, hz, ?_⟩
  exact eventually_atTop.mpr ⟨N, hT⟩


end Bounty

end SubmissionComponent_ReturnApproximationObstruction

/- Component BoundedCoefficientPatterns; SHA256 d204d8d4a98d27eed4975b59696d022f833bd098844c6472ea6dcce29a635ffe -/
section SubmissionComponent_BoundedCoefficientPatterns
/- Extract one coefficient pattern from rows of bounded finite size. -/

open Filter

namespace Bounty

universe u v

/-- A sequence in a finite type is constant along a strictly increasing subsequence. -/
def finite_constant_subsequence {α : Type u} [Finite α] (f : ℕ → α) :
    ∃ a : α, ∃ σ : ℕ → ℕ, StrictMono σ ∧ ∀ n, f (σ n) = a := by
  have h : ∃ᶠ n in atTop, ∃ a : α, f n = a :=
    Frequently.of_forall fun n => ⟨f n, rfl⟩
  obtain ⟨a, ha⟩ := frequently_exists.mp h
  obtain ⟨σ, hσ, hconst⟩ := extraction_of_frequently_atTop ha
  exact ⟨a, σ, hσ, hconst⟩

/-- Bounded row sizes and a finite palette give one fixed ordered coefficient row
on an increasing subsequence. The row equivalences retain every actual label. -/
def bounded_coefficient_patterns {α : Type u} [DecidableEq α]
    (I : ℕ → Type v) [∀ n, Fintype (I n)] (N : ℕ) (C : Finset α)
    (c : (n : ℕ) → I n → α)
    (hcard : ∀ n, Fintype.card (I n) ≤ N)
    (hC : ∀ n i, c n i ∈ C) :
    ∃ m ≤ N, ∃ d : Fin m → α, ∃ σ : ℕ → ℕ, StrictMono σ ∧
      ∃ e : (n : ℕ) → Fin m ≃ I (σ n),
        (∀ i, d i ∈ C) ∧ ∀ n i, c (σ n) (e n i) = d i := by
  classical
  let Pattern := Σ m : Fin (N + 1), Fin m.val → ↥C
  let row : ℕ → Pattern := fun n =>
    ⟨⟨Fintype.card (I n), Nat.lt_succ_of_le (hcard n)⟩,
      fun i => ⟨c n ((Fintype.equivFin (I n)).symm i), hC n _⟩⟩
  have row_equiv (n : ℕ) (p : Pattern) (hp : row n = p) :
      ∃ e : Fin p.1.val ≃ I n, ∀ i, c n (e i) = (p.2 i).val := by
    subst p
    exact ⟨(Fintype.equivFin (I n)).symm, fun _ => rfl⟩
  obtain ⟨p, σ, hσ, hrow⟩ := finite_constant_subsequence row
  choose e he using fun n => row_equiv (σ n) p (hrow n)
  exact ⟨p.1.val, Nat.le_of_lt_succ p.1.isLt, fun i => (p.2 i).val,
    σ, hσ, e, fun i => (p.2 i).property, he⟩

/-- The same extraction works when the bounds and palette are only eventually valid. -/
def bounded_coefficient_patterns_eventually {α : Type u} [DecidableEq α]
    (I : ℕ → Type v) [∀ n, Fintype (I n)] (N : ℕ) (C : Finset α)
    (c : (n : ℕ) → I n → α)
    (hcard : ∀ᶠ n in atTop, Fintype.card (I n) ≤ N)
    (hC : ∀ᶠ n in atTop, ∀ i, c n i ∈ C) :
    ∃ m ≤ N, ∃ d : Fin m → α, ∃ σ : ℕ → ℕ, StrictMono σ ∧
      ∃ e : (n : ℕ) → Fin m ≃ I (σ n),
        (∀ i, d i ∈ C) ∧ ∀ n i, c (σ n) (e n i) = d i := by
  have h : ∀ᶠ n in atTop, Fintype.card (I n) ≤ N ∧ ∀ i, c n i ∈ C :=
    hcard.and hC
  obtain ⟨K, hK⟩ := eventually_atTop.mp h
  obtain ⟨m, hm, d, σ, hσ, e, hd, he⟩ :=
    bounded_coefficient_patterns (fun n => I (K + n)) N C (fun n => c (K + n))
      (fun n => (hK (K + n) (Nat.le_add_right K n)).1)
      (fun n => (hK (K + n) (Nat.le_add_right K n)).2)
  refine ⟨m, hm, d, (fun n => K + σ n), ?_, e, hd, he⟩
  exact fun _ _ hij => Nat.add_lt_add_left (hσ hij) K


end Bounty

end SubmissionComponent_BoundedCoefficientPatterns

/- Component ReturnFixedApproximation; SHA256 db39dae26c9cac3193889998aa53e3f024c7dce75e2253a2254d0346bbff5d1d -/
section SubmissionComponent_ReturnFixedApproximation
/- The elementary reduction to a fixed finite sum of {2,3}-units. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable section

def fixedApproximationVector {m : ℕ} (P : ℤ) (u : Fin m → ℚ) : Option (Fin m) → ℚ
  | none => (P : ℚ)
  | some i => u i

def fixedApproximationError {m : ℕ} (d u : Fin m → ℚ) (P : ℤ) : ℚ :=
  (∑ i, d i * u i) - (P : ℚ)

def fixedApproximationVector_return_height {m : ℕ} (r : ℕ) (T : ℝ)
    (e : Fin m ≃ ReturnApproximationLabel r T) :
    Height.mulHeight (fixedApproximationVector (returnIntegerPrefix r)
      (fun i => returnApproximationUnit r T (e i))) =
        Height.mulHeight (returnApproximationVector r T) := by
  have h : fixedApproximationVector (returnIntegerPrefix r)
      (fun i => returnApproximationUnit r T (e i)) =
        returnApproximationVector r T ∘ e.optionCongr := by
    funext i
    cases i <;> rfl
  rw [h]
  exact Height.mulHeight_comp_equiv e.optionCongr (returnApproximationVector r T)

def fixedApproximationError_return {m : ℕ} (z : ℚ) (r : ℕ) (T : ℝ)
    (d : Fin m → ℚ) (e : Fin m ≃ ReturnApproximationLabel r T)
    (hd : ∀ i, returnApproximationCoefficient z r T (e i) = d i) :
    ((fixedApproximationError d (fun i => returnApproximationUnit r T (e i))
      (returnIntegerPrefix r) : ℚ) : ℝ) = returnApproximationError z r T := by
  have hs : (∑ i, d i * returnApproximationUnit r T (e i)) =
      ∑ j, returnApproximationCoefficient z r T j * returnApproximationUnit r T j := by
    calc
      _ = ∑ i, returnApproximationCoefficient z r T (e i) *
          returnApproximationUnit r T (e i) := by simp only [hd]
      _ = _ := e.sum_comp (fun j =>
        returnApproximationCoefficient z r T j * returnApproximationUnit r T j)
  simpa only [fixedApproximationError, returnApproximationError, hs]

/-- A fixed-dimensional family with the exact numerical bounds needed in the
arithmetic argument. All coefficients are independent of the sequence index. -/
structure FixedReturnApproximation where
  dimension : ℕ
  dimension_lower : 4 ≤ dimension
  dimension_upper : dimension ≤ 0x194
  coefficient : Fin dimension → ℚ
  unit : ℕ → Fin dimension → ℚ
  integerPart : ℕ → ℤ
  scale : ℕ → ℝ
  cutoff : ℕ → ℝ
  scale_tendsto : Tendsto scale atTop atTop
  unit_twoThreeUnit : ∀ n i, TwoThreeUnit (unit n i)
  unit_pos : ∀ n i, 0 < unit n i
  eventual_estimates : ∀ᶠ n in atTop,
    scale n ≤ cutoff n ∧
    (∀ i, Real.exp (-cutoff n) ≤ (unit n i : ℝ)) ∧
    Height.mulHeight (fixedApproximationVector (integerPart n) (unit n)) ≤
      Real.exp (27 * scale n) ∧
    fixedApproximationError coefficient (unit n) (integerPart n) ≠ 0 ∧
    |((fixedApproximationError coefficient (unit n) (integerPart n) : ℚ) : ℝ)| ≤
      Real.exp (-cutoff n - scale n / 0xc8)
  quotient_height_diverge : ∀ B : ℝ, ∀ᶠ n in atTop, ∀ i j : Fin dimension,
    i ≠ j → B < Height.mulHeight₁ (unit n i / unit n j)

def rational_density_fixed_return_approximation (h : ¬Irrational explicitDensity) :
    Nonempty FixedReturnApproximation := by
  classical
  obtain ⟨z, T, hz, hgood⟩ := rational_density_nonzero_return_approximation_sequence h
  let I : ℕ → Type := fun r => ReturnApproximationLabel r (T r)
  let c : (r : ℕ) → I r → ℚ := fun r => returnApproximationCoefficient z r (T r)
  have hcard : ∀ᶠ r in atTop, Fintype.card (I r) ≤ 0x194 := by
    filter_upwards [hgood] with r hr
    exact hr.2.2.1.1
  have hC : ∀ᶠ r in atTop, ∀ i, c r i ∈ returnCoefficientPalette z :=
    Eventually.of_forall fun r => returnApproximationCoefficient_mem z r (T r)
  obtain ⟨m, hm, d, σ, hσ, e, hd, he⟩ :=
    bounded_coefficient_patterns_eventually I 0x194 (returnCoefficientPalette z) c hcard hC
  have hmlo : 4 ≤ m := by
    have hc : Fintype.card (I (σ 0)) = m := by
      simpa only [Fintype.card_fin] using (Fintype.card_congr (e 0)).symm
    rw [← hc]
    exact returnApproximationLabel_card_lower (σ 0) (T (σ 0))
  let u : ℕ → Fin m → ℚ := fun n i => returnApproximationUnit (σ n) (T (σ n)) (e n i)
  let P : ℕ → ℤ := fun n => returnIntegerPrefix (σ n)
  let L : ℕ → ℝ := fun n => returnScale (σ n)
  let U : ℕ → ℝ := fun n => T (σ n)
  have herr (n : ℕ) : ((fixedApproximationError d (u n) (P n) : ℚ) : ℝ) =
      returnApproximationError z (σ n) (T (σ n)) :=
    fixedApproximationError_return z (σ n) (T (σ n)) d (e n) (he n)
  have hheight (n : ℕ) : Height.mulHeight (fixedApproximationVector (P n) (u n)) =
      Height.mulHeight (returnApproximationVector (σ n) (T (σ n))) :=
    fixedApproximationVector_return_height (σ n) (T (σ n)) (e n)
  refine ⟨{
    dimension := m
    dimension_lower := hmlo
    dimension_upper := hm
    coefficient := d
    unit := u
    integerPart := P
    scale := L
    cutoff := U
    scale_tendsto := returnScale_tendsto.comp hσ.tendsto_atTop
    unit_twoThreeUnit := fun n i =>
      returnApproximationUnit_twoThreeUnit (σ n) (T (σ n)) (e n i)
    unit_pos := fun n i => returnApproximationUnit_pos (σ n) (T (σ n)) (e n i)
    eventual_estimates := ?_
    quotient_height_diverge := ?_ }⟩
  · filter_upwards [hσ.tendsto_atTop.eventually hgood] with n hn
    rcases hn with ⟨hTlo, hThi, hcond, hnz⟩
    rcases hcond with ⟨_, _, _, hlower, hH, herror⟩
    have hL := returnScale_pos (σ n)
    refine ⟨?_, fun i => hlower (e n i), ?_, ?_, ?_⟩
    · change returnScale (σ n) ≤ T (σ n)
      linarith
    · rw [hheight n]
      exact hH
    · intro hzero
      apply hnz
      rw [← herr n, hzero, Rat.cast_zero]
    · rw [herr n]
      exact herror
  · intro B
    filter_upwards [hσ.tendsto_atTop.eventually
      (returnApproximationUnit_quotient_height_diverge B)] with n hn i j hij
    apply hn (T (σ n)) (T (σ n)) (e n i) (e n j)
    intro hk
    exact hij ((e n).injective (returnApproximationKey_injective (σ n) (T (σ n)) hk))


end
end Bounty

end SubmissionComponent_ReturnFixedApproximation

