/- Component PolicyClosureMath; SHA256 9d7b36812fbb4ac8dfe45961ec13f92d1c90a901f03adc5bb5df750c6de6fcad. -/
section PolicySubmissionPart88
/- Component StateProfile; SHA256 f32ea7c4e33d95846c55792a52f76f2166e7e9921870f1694468ecc883d8c9e7 -/
section SubmissionComponent_StateProfile
/- A local successful recursive choice gives the profile required at a leaf. -/

namespace Bounty

def cutoffState_profile_of_local {eps : Bool} {u : ℚ} (hu : 2 ≤ u)
    (h : cutoffAvailable u (quotaValue eps u) 0 (cutoffState true (u / 5)) (cutoffState eps (u / 7)) ∨
      cutoffAvailable u (quotaValue eps u) 1 (cutoffState true (u / 5)) (cutoffState eps (u / 7))) :
    cutoffProfileValid eps (cutoffState eps u).1 u (cutoffState eps u).2 := by
  have hu1 : 1 ≤ u := by linarith
  have ha : cutoffAvailable u (quotaValue eps u) (cutoffState eps u).1
      (cutoffState true (u / 5)) (cutoffState eps (u / 7)) := by
    simpa only [cutoffState_of_large hu1] using cutoffCandidate_available h
  have hlo := (cutoffState_bounds (eps := eps) hu1).1
  apply (cutoffProfileValid_iff (cutoffState_parity eps u) hu (by linarith)).mpr
  constructor
  · have hh := ha.1
    rwa [← cutoffState_eq_trial hu1] at hh
  · have hh := cutoffTrial_size (by linarith : 0 ≤ u) ha
    rwa [← cutoffState_eq_trial hu1] at hh

def cutoffState_normalized_profile_of_local {eps : Bool} {u v : ℚ}
    (hu : 0 < u) (hv : 2 ≤ v * u)
    (h : cutoffAvailable (v * u) (quotaValue eps (v * u)) 0
        (cutoffState true (v * u / 5)) (cutoffState eps (v * u / 7)) ∨
      cutoffAvailable (v * u) (quotaValue eps (v * u)) 1
        (cutoffState true (v * u / 5)) (cutoffState eps (v * u / 7))) :
    normalizedStateValid eps (cutoffState eps (v * u)).1 v
      ((4 : ℚ) ^ Nat.log 4 ⌊v * u⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊v * u⌋₊ / u)
      ((4 : ℚ) ^ Nat.log 4 ⌊5 * (v * u)⌋₊ / u) ((3 : ℚ) ^ Nat.log 3 ⌊5 * (v * u)⌋₊ / u)
      ((cutoffState eps (v * u)).2 / u) := by
  apply (cutoffProfileValid_iff_normalizedState eps (cutoffState eps (v * u)).1 hu hv).mp
  rw [div_mul_cancel₀ _ (ne_of_gt hu)]
  exact cutoffState_profile_of_local hv h

def cutoffState_normalized_lower {eps : Bool} {u v : ℚ}
    (hu : 0 < u) (hv : 1 ≤ v * u) :
    3 * v / 4 ≤ (cutoffState eps (v * u)).2 / u := by
  apply (le_div_iff₀ hu).mpr
  have hh := (cutoffState_bounds (eps := eps) hv).1
  calc
    (3 * v / 4) * u = 3 * (v * u) / 4 := by ring
    _ ≤ (cutoffState eps (v * u)).2 := hh


end Bounty

end SubmissionComponent_StateProfile

