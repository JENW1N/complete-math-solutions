  have hb : i / 16 < 3 := by omega
  have hw : i % 16 < min 16 (34 - 16 * (i / 16)) := by omega
  have hid : 16 * (i / 16) + i % 16 = i := by omega
  have h := checkBlock_sound policyMappedDatabase1 PolicyAssertedPacked1.records
    (16 * (i / 16)) (min 16 (34 - 16 * (i / 16)))
