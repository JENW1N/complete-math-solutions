/- Component ClosureModel; SHA256 5c062851ec37e77d6a6dffa086e39111babd40f2acafea69306a9ab28482a639 -/
section SubmissionComponent_ClosureModel
/- A hypothetical recursive failure produces the finite model ruled out by the certificates. -/

namespace Bounty

def cutoffLocalAvailable (eps : Bool) (u : ℚ) : Prop :=
  cutoffAvailable u (quotaValue eps u) 0 (cutoffState true (u / 5)) (cutoffState eps (u / 7)) ∨
    cutoffAvailable u (quotaValue eps u) 1 (cutoffState true (u / 5)) (cutoffState eps (u / 7))

def cutoffInductionHypothesis (u : ℚ) : Prop :=
  ∀ eps v, 1 ≤ v → ⌊v⌋₊ < ⌊u⌋₊ → cutoffLocalAvailable eps v

def closureActual_raw_of_failure {eps : Bool} {u : ℚ} (hu : 0x1921ee ≤ u)
    (hi : cutoffInductionHypothesis u) (hf : ¬cutoffLocalAvailable eps u) :
    ClosureRawHypothesis eps (closureRootFour u) (closureRootThree u)
      (closureActualPhase eps u) (closureActualValue eps u) := by
  classical
  have hu0 : 0 < u := by linarith
  have hu1 : 1 ≤ u := by linarith
  have hx : 1 / 4 < closureRootFour u ∧ closureRootFour u ≤ 1 := by
    simpa only [Nat.cast_ofNat, closureRootFour] using normalized_power_bounds (b := 4) (by norm_num) hu1
  have hy : 1 / 3 < closureRootThree u ∧ closureRootThree u ≤ 1 := by
    simpa only [Nat.cast_ofNat, closureRootThree] using normalized_power_bounds (b := 3) (by norm_num) hu1
  refine ⟨hx.1, hx.2, hy.1, hy.2, ?_⟩
  intro k hk
  by_cases hk0 : k = 0
  · subst k
    change ¬closureNodeAvailable eps 0 0 (closureRootFour u) (closureRootThree u)
        (closureActualPhase eps u) (closureActualValue eps u) ∧
      ¬closureNodeAvailable eps 0 1 (closureRootFour u) (closureRootThree u)
        (closureActualPhase eps u) (closureActualValue eps u)
    have h0 := closureActual_available (eps := eps) hu (k := 0) (phase := 0) (by norm_num) (by norm_num)
    have h1 := closureActual_available (eps := eps) hu (k := 0) (phase := 1) (by norm_num) (by norm_num)
    simp only [closureNodeType, closureNode, ↓reduceIte, one_mul] at h0 h1
    exact ⟨fun h => hf (Or.inl (h0.mpr h)), fun h => hf (Or.inr (h1.mpr h))⟩
  · have hv := (closureNode_v_bounds hu hk).2.2
    have ha := hi (closureNodeType eps k) ((closureNode k).v * u) (by linarith)
      (closureNode_floor_lt_root hu (by omega) hk)
    by_cases hleaf : (closureNode k).leaf = true
    · simp only [closureNodeConstraint, if_neg hk0, if_pos hleaf]
      refine ⟨cutoffState_normalized_lower hu0 (by linarith : 1 ≤ (closureNode k).v * u), ?_⟩
      have hvld := closureActual_valid hu hk ha
      by_cases hp : closureActualPhase eps u k
      · rw [if_pos hp]
        have hp' : (closureActualState eps u k).1 = 1 := hp
        simpa only [hp'] using hvld
      · rw [if_neg hp]
        have hp' : (closureActualState eps u k).1 ≠ 1 := hp
        have hb := closureActual_parity eps u k
        have hz : (closureActualState eps u k).1 = 0 := by omega
        simpa only [hz] using hvld
    · have hk28 : k < 28 := by
        have hh : ¬28 ≤ k := fun h => hleaf ((closureNode_leaf_iff hk).mpr h)
        omega
      simp only [closureNodeConstraint, if_neg hk0, if_neg hleaf]
      refine ⟨?_, closureActual_phase_rule hu hk28, ?_⟩
      · exact ha.imp (closureActual_available hu hk28 (by norm_num : 0 < 2)).mp
          (closureActual_available hu hk28 (by norm_num : 1 < 2)).mp
      · have hh := closureActual_value_rule hu hk28 ha
        by_cases hp : closureActualPhase eps u k
        · rw [if_pos hp]
          have hp' : (closureActualState eps u k).1 = 1 := hp
          simpa only [if_pos hp'] using hh
        · rw [if_neg hp]
          have hp' : (closureActualState eps u k).1 ≠ 1 := hp
          simpa only [if_neg hp'] using hh


end Bounty

end SubmissionComponent_ClosureModel

/- Component ClosureInduction; SHA256 07be9ab9910c2a6d5134e25d9737358668863287c82893e314915b4c931c7444 -/
section SubmissionComponent_ClosureInduction
/- Strong induction reduces universal availability to the two finite closure contradictions. -/

namespace Bounty

def cutoffAvailability_of_closure
    (H : ∀ eps X Y p r, ¬ClosureRawHypothesis eps X Y p r) : CutoffAvailability := by
  have all : ∀ n : ℕ, ∀ eps u, ⌊u⌋₊ = n → 1 ≤ u → cutoffLocalAvailable eps u := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro eps u hn hu1
      by_cases hb : u < 0x1921ee
      · exact cutoffAvailabilityBelow_base eps u hu1 hb
      · have hu : 0x1921ee ≤ u := le_of_not_gt hb
        by_contra hf
        have hi : cutoffInductionHypothesis u := by
          intro eps' v hv hsmall
          exact ih ⌊v⌋₊ (by omega) eps' v rfl hv
        exact H eps (closureRootFour u) (closureRootThree u)
          (closureActualPhase eps u) (closureActualValue eps u) (closureActual_raw_of_failure hu hi hf)
  intro eps u hu
  exact all ⌊u⌋₊ eps u rfl hu

end Bounty

end SubmissionComponent_ClosureInduction

