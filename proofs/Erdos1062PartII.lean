/- Component PolicyBitsetBatch; SHA256 d823e5d2e4dd6ccfe7af5540e6aef9bbc36157ff744622d7cdcb2b838678d93f. -/
section PolicySubmissionPart57
/- Bounded finite batches of the proved Boolean propagation checker. -/
namespace Bounty

def policyBitActionIntervalGood (db : Nat → List Int) (hints : Nat → List Nat)
    (lo hi : Nat) : Bool :=
  (List.range' lo (hi - lo)).all (fun i => policyBitActionGood db i (hints i))

def policyBitActionIntervalGood_sound db hints lo hi
    (h : policyBitActionIntervalGood db hints lo hi = true) :
    ∀ i, lo ≤ i → i < hi → policyBitActionGood db i (hints i) = true := by
  simp only [policyBitActionIntervalGood, List.all_eq_true] at h
  intro i hli hih
  apply h i
  rw [List.mem_range']
  exact ⟨i - lo, by omega, by omega⟩

end Bounty

end PolicySubmissionPart57

