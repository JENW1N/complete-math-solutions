/- Component WindowLogBounds; SHA256 d22a772f9048d9d734776debabd97a8b2218845f4718da76f7a8e2f27f37f76d -/
section SubmissionComponent_WindowLogBounds
/- Canonical obstruction indices and logarithms on rational verification intervals. -/

namespace Bounty

def badWindow_log_indices {n j b : ℕ}
    (h4lo : 4 ^ j ≤ n) (h4hi : 4 * n < 5 * 4 ^ j)
    (h3lo : 10 * 3 ^ b ≤ n) (h3hi : n < 12 * 3 ^ b) :
    Nat.log 4 n = j ∧ Nat.log 3 n = b + 2 := by
  constructor
  · apply Nat.log_eq_of_pow_le_of_lt_pow h4lo
    rw [pow_succ]
    omega
  · apply Nat.log_eq_of_pow_le_of_lt_pow
    · rw [pow_add]
      norm_num
      omega
    · rw [show b + 2 + 1 = b + 3 by omega, pow_add]
      norm_num
      omega

def badWindow_iff_canonical (n : ℕ) :
    badWindow n ↔
      4 ^ Nat.log 4 n ≤ n ∧ 4 * n < 5 * 4 ^ Nat.log 4 n ∧
      10 * 3 ^ (Nat.log 3 n - 2) ≤ n ∧ n < 12 * 3 ^ (Nat.log 3 n - 2) := by
  constructor
  · rintro ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩
    obtain ⟨hj, hb⟩ := badWindow_log_indices h4lo h4hi h3lo h3hi
    rw [hj, hb, Nat.add_sub_cancel]
    exact ⟨h4lo, h4hi, h3lo, h3hi⟩
  · intro hh
    exact ⟨Nat.log 4 n, Nat.log 3 n - 2, hh⟩

def log_floor_of_bounds {u : ℚ} {b k : ℕ} (hu : 0 ≤ u)
    (hlo : ((b ^ k : ℕ) : ℚ) ≤ u) (hhi : u < ((b ^ (k + 1) : ℕ) : ℚ)) :
    Nat.log b ⌊u⌋₊ = k := by
  apply Nat.log_eq_of_pow_le_of_lt_pow
  · exact (Nat.le_floor_iff hu).mpr hlo
  · exact (Nat.floor_lt hu).mpr hhi

def smoothRank_floor_of_indices {u : ℚ} {a b : ℕ} (hu : 1 ≤ u)
    (ha : Nat.log 2 ⌊u⌋₊ = a) (hb : Nat.log 3 ⌊u⌋₊ = b) :
    smoothRankBound ⌊u⌋₊ = b + 1 + a / 2 +
      if a % 2 = 1 ∧ ((2 * 3 ^ b : ℕ) : ℚ) ≤ u then 1 else 0 := by
  have hu0 : 0 ≤ u := by linarith
  have hn : ⌊u⌋₊ ≠ 0 := by
    have hh : 1 ≤ ⌊u⌋₊ := (Nat.le_floor_iff hu0).mpr hu
    omega
  unfold smoothRankBound
  rw [if_neg hn, ha, hb]
  simp only [Nat.le_floor_iff hu0]

end Bounty

end SubmissionComponent_WindowLogBounds

/- Component CutoffTable; SHA256 f573fc818b82ce302cb6a099e022c9f4e1ce81c04db88879700fcc8673c0f4ea -/
section SubmissionComponent_CutoffTable
/- Rational interval tables and a checked route from their recursion equations to states. -/

namespace Bounty

structure CutoffPiece where
  lo : ℚ
  hi : ℚ
  parity : ℕ
  slope : ℚ
  intercept : ℚ

def CutoffPiece.value (row : CutoffPiece) (u : ℚ) : ℕ × ℚ :=
  (row.parity, row.slope * u + row.intercept)

def cutoffTableEval : List CutoffPiece → ℚ → ℕ × ℚ
  | [], _ => (0, 0)
  | row :: rows, u => if u < row.hi then row.value u else cutoffTableEval rows u

def cutoffTableSpan : ℚ → ℚ → List CutoffPiece → Prop
  | lo, hi, [] => lo = hi
  | lo, hi, row :: rows =>
      row.lo = lo ∧ row.lo < row.hi ∧ cutoffTableSpan row.hi hi rows

def cutoffTableEval_eq_of_mem {rows : List CutoffPiece} {row : CutoffPiece} {u : ℚ}
    (horder : rows.Pairwise (fun x y => x.hi ≤ y.lo)) (hmem : row ∈ rows)
    (hlo : row.lo ≤ u) (hhi : u < row.hi) :
    cutoffTableEval rows u = row.value u := by
  induction rows with
  | nil => simp at hmem
  | cons first rest ih =>
      obtain ⟨hfirst, hrest⟩ := List.pairwise_cons.mp horder
      rcases List.mem_cons.mp hmem with heq | hmem
      · subst row
        simp [cutoffTableEval, hhi]
      · have hnot : ¬u < first.hi := not_lt_of_ge ((hfirst row hmem).trans hlo)
        rw [cutoffTableEval, if_neg hnot]
        exact ih hrest hmem

def cutoffTableSpan_lower {rows : List CutoffPiece} {lo hi : ℚ}
    (hspan : cutoffTableSpan lo hi rows) {row : CutoffPiece} (hmem : row ∈ rows) :
    lo ≤ row.lo := by
  induction rows generalizing lo with
  | nil => simp at hmem
  | cons first rest ih =>
      obtain ⟨heq, hlt, hrest⟩ := hspan
      rcases List.mem_cons.mp hmem with hr | hmem
      · subst row
        exact heq.ge
      · exact (heq ▸ hlt.le).trans (ih hrest hmem)

def cutoffTableSpan_ordered {rows : List CutoffPiece} {lo hi : ℚ}
    (hspan : cutoffTableSpan lo hi rows) :
    rows.Pairwise (fun x y => x.hi ≤ y.lo) := by
  induction rows generalizing lo with
  | nil => simp
  | cons row rest ih =>
      obtain ⟨_, _, hrest⟩ := hspan
      apply List.pairwise_cons.mpr
      exact ⟨fun _ hmem => cutoffTableSpan_lower hrest hmem, ih hrest⟩

def cutoffState_eq_table {limit : ℚ} (rows : Bool → List CutoffPiece)
    (hsmall : ∀ eps u, u < 1 → cutoffTableEval (rows eps) u = (0, 0))
    (hstep : ∀ eps u, 1 ≤ u → u < limit →
      cutoffCandidate eps u (cutoffTableEval (rows true) (u / 5))
        (cutoffTableEval (rows eps) (u / 7)) = cutoffTableEval (rows eps) u) :
    ∀ eps u, u < limit → cutoffState eps u = cutoffTableEval (rows eps) u := by
  have hall : ∀ m : ℕ, ∀ eps u, ⌊u⌋₊ = m → u < limit →
      cutoffState eps u = cutoffTableEval (rows eps) u := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
        intro eps u hm hlim
        by_cases hu : u < 1
        · rw [cutoffState_of_small hu, hsmall eps u hu]
        · have hu1 : 1 ≤ u := le_of_not_gt hu
          have h5lt : ⌊u / 5⌋₊ < m := by
            rw [← hm]
            exact floor_div_lt_floor hu1 (by norm_num : 1 < (5 : ℕ))
          have h7lt : ⌊u / 7⌋₊ < m := by
            rw [← hm]
            exact floor_div_lt_floor hu1 (by norm_num : 1 < (7 : ℕ))
          have h5 := ih _ h5lt true (u / 5) rfl (by linarith : u / 5 < limit)
          have h7 := ih _ h7lt eps (u / 7) rfl (by linarith : u / 7 < limit)
          rw [cutoffState_of_large hu1, h5, h7]
          exact hstep eps u hu1 hlim
  intro eps u hlim
  exact hall ⌊u⌋₊ eps u rfl hlim

def cutoffTrial_eq_of_bounds {u r : ℚ} {k p : ℕ} {c5 c7 : ℕ × ℚ}
    (hbase : 3 * u / 4 ≤ r) (hlevel : (lowerCutoff p k : ℚ) ≤ r)
    (hfive : (if p = c5.1 then 4 else 6) * c5.2 ≤ r)
    (hseven : (if p = c7.1 then 4 else 6) * c7.2 ≤ r)
    (heq : r = 3 * u / 4 ∨ r = (lowerCutoff p k : ℚ) ∨
      r = (if p = c5.1 then 4 else 6) * c5.2 ∨
      r = (if p = c7.1 then 4 else 6) * c7.2) :
    cutoffTrial u k p c5 c7 = r := by
  apply le_antisymm
  · exact max_le (max_le hbase hlevel) (max_le hfive hseven)
  · have hb := cutoffTrial_bounds u k p c5 c7
    rcases heq with heq | heq | heq | heq
    · exact heq ▸ hb.1
    · exact heq ▸ hb.2.1
    · exact heq ▸ hb.2.2.1
    · exact heq ▸ hb.2.2.2

def cutoffCandidate_eq_preferred {eps : Bool} {u : ℚ} {k p : ℕ} {c5 c7 : ℕ × ℚ}
    (hq : quotaValue eps u = k) (hp : Nat.log 2 ⌊u⌋₊ % 2 = p)
    (ha : cutoffAvailable u k p c5 c7) :
    cutoffCandidate eps u c5 c7 = (p, cutoffTrial u k p c5 c7) := by
  simp [cutoffCandidate, hq, hp, ha]

def cutoffCandidate_eq_alternate {eps : Bool} {u : ℚ} {k p : ℕ} {c5 c7 : ℕ × ℚ}
    (hq : quotaValue eps u = k) (hp : Nat.log 2 ⌊u⌋₊ % 2 = p)
    (ha : ¬cutoffAvailable u k p c5 c7) :
    cutoffCandidate eps u c5 c7 = (1 - p, cutoffTrial u k (1 - p) c5 c7) := by
  simp [cutoffCandidate, hq, hp, ha]

end Bounty

end SubmissionComponent_CutoffTable

/- Component BaseTableData; SHA256 8fcfeb97c99481d4991146d5419e8d046b51401696241edc194c6f4608e898d6 -/
section SubmissionComponent_BaseTableData
