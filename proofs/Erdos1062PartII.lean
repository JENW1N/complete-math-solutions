/- Component RationalHyperplaneReduction; SHA256 e76a8e1e9a1b6ba0028fed4997bafaec1c0ab653ee4001d5788949166cf03668 -/
section SubmissionComponent_RationalHyperplaneReduction
/- Finite iteration of the actual integer saturation/specialization step. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {B C I R : Type*}

open scoped Classical in
def zeroVariables [CommSemiring R] (s : Finset I) : MvPolynomial I R →ₐ[R] MvPolynomial I R :=
  MvPolynomial.aeval (fun i => if i ∈ s then 0 else MvPolynomial.X i)

open scoped Classical in
def zeroVariables_C [CommSemiring R] (s : Finset I) (a : R) :
    zeroVariables s (MvPolynomial.C a) = MvPolynomial.C a := by simp [zeroVariables]

open scoped Classical in
def zeroVariables_X [CommSemiring R] (s : Finset I) (i : I) :
    zeroVariables s (MvPolynomial.X (R := R) i) = if i ∈ s then 0 else MvPolynomial.X i := by
  simp [zeroVariables]

open scoped Classical in
def zeroVariables_empty [CommSemiring R] (P : MvPolynomial I R) :
    zeroVariables ∅ P = P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP => simp only [map_mul, zeroVariables_X, Finset.notMem_empty, if_false, hP]

open scoped Classical in
def zeroVariables_insert [CommSemiring R] (s : Finset I) (z : I) (P : MvPolynomial I R) :
    zeroVariables (insert z s) P = zeroVariable z (zeroVariables s P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [map_mul, zeroVariables_X, Finset.mem_insert, hP]
    by_cases hi : i = z
    · subst i
      by_cases hs : z ∈ s <;> simp [hs, zeroVariable_X]
    · by_cases hs : i ∈ s <;> simp [hi, hs, zeroVariable_X]

open scoped Classical in
def exists_integer_complement_elimination {H : Type*} [DecidableEq H]
    (block : B ⊕ C → H) (r : H → ℕ) (w : B → ℕ) (g : B → MvPolynomial C ℚ)
    (s : Finset C) (P : MvPolynomial (B ⊕ C) ℤ) (hP : P ≠ 0)
    (hhom : MultiBlockHomogeneous block r P) :
    ∃ r' : H → ℕ, ∃ Q : MvPolynomial (B ⊕ C) ℤ,
      (∀ h, r' h ≤ r h) ∧ Q ≠ 0 ∧ MultiBlockHomogeneous block r' Q ∧
      (∀ i, Q.degreeOf i ≤ P.degreeOf i) ∧ polynomialCoeffL1 Q ≤ polynomialCoeffL1 P ∧
      (∀ c ∈ s, Q.degreeOf (Sum.inr c) = 0) ∧
      complementHyperplaneIndex w g (MvPolynomial.map (Int.castRingHom ℚ) P) ≤
        complementHyperplaneIndex w (fun b => zeroVariables s (g b))
          (MvPolynomial.map (Int.castRingHom ℚ) Q) := by
  classical
  induction s using Finset.induction_on generalizing r P with
  | empty =>
    refine ⟨r, P, fun _ => le_rfl, hP, hhom, fun _ => le_rfl, le_rfl, ?_, ?_⟩
    · simp
    · simp only [zeroVariables_empty]
      exact le_rfl
  | @insert c s hc ih =>
    obtain ⟨r₁, P₁, hr₁, hP₁, hhom₁, hdeg₁, hnorm₁, hzero₁, hindex₁⟩ := ih r P hP hhom
    obtain ⟨k, Q, hQeq, hQ, hzero, hdeg, hnorm, hhomQ, hindex⟩ :=
      exists_integer_complement_specialization block r₁ w (fun b => zeroVariables s (g b))
        c P₁ hP₁ hhom₁
    refine ⟨fun h => r₁ h - if block (Sum.inr c) = h then k else 0,
      Q, ?_, hQ, hhomQ, ?_, hnorm.trans hnorm₁, ?_, ?_⟩
    · intro h
      exact (Nat.sub_le _ _).trans (hr₁ h)
    · intro i
      exact (hdeg i).trans (hdeg₁ i)
    · intro a ha
      rcases Finset.mem_insert.mp ha with rfl | ha
      · exact hzero
      · exact Nat.eq_zero_of_le_zero ((hdeg _).trans_eq (hzero₁ a ha))
    · simpa only [zeroVariables_insert] using hindex₁.trans hindex

open scoped Classical in
def MultiBlockHomogeneous_rename_pullback {H J : Type*} [DecidableEq H] [CommSemiring R]
    (f : I → J) (hf : Function.Injective f) (block : J → H) (r : H → ℕ)
    (P : MvPolynomial I R) (hP : MultiBlockHomogeneous block r (MvPolynomial.rename f P)) :
    MultiBlockHomogeneous (block ∘ f) r P := by
  intro h e he
  have hh : MvPolynomial.coeff (e.mapDomain f) (MvPolynomial.rename f P) ≠ 0 := by
    rwa [MvPolynomial.coeff_rename_mapDomain f hf]
  simpa only [specialization_weight_mapDomain, Function.comp_def] using hP h hh

open scoped Classical in
def multiBlockHomogeneous_pair_iff [CommSemiring R] (r : B → ℕ)
    (P : MvPolynomial (B ⊕ B) R) :
    MultiBlockHomogeneous (Sum.elim id id) r P ↔ BlockHomogeneous r P := by
  rw [blockHomogeneous_iff_weighted]
  have hw (h : B) : (fun i : B ⊕ B => if Sum.elim id id i = h then 1 else 0) =
      blockDegreeWeight h := by
    funext i
    cases i <;> simp [blockDegreeWeight, Pi.single_apply, eq_comm]
  simp only [MultiBlockHomogeneous, hw]

open scoped Classical in
def retainedPairEmbedding (t : B → C) : B ⊕ B → B ⊕ C := Sum.map id t

open scoped Classical in
def retainedPairEmbedding_injective (t : B → C) (ht : Function.Injective t) :
    Function.Injective (retainedPairEmbedding t) := Sum.map_injective.mpr ⟨Function.injective_id, ht⟩

open scoped Classical in
def exists_retainedPair_polynomial [CommSemiring R] (t : B → C) (ht : Function.Injective t)
    (Q : MvPolynomial (B ⊕ C) R)
    (hzero : ∀ c, c ∉ Set.range t → Q.degreeOf (Sum.inr c) = 0) :
    ∃ U : MvPolynomial (B ⊕ B) R, MvPolynomial.rename (retainedPairEmbedding t) U = Q := by
  apply MvPolynomial.exists_rename_eq_of_vars_subset_range Q _ (retainedPairEmbedding_injective t ht)
  intro i hi
  cases i with
  | inl b => exact ⟨Sum.inl b, rfl⟩
  | inr c =>
    have hc : c ∈ Set.range t := by
      by_contra hn
      exact (MvPolynomial.mem_vars_iff_degreeOf_ne_zero.mp hi) (hzero c hn)
    obtain ⟨b, rfl⟩ := hc
    exact ⟨Sum.inr b, rfl⟩

open scoped Classical in
def retainedPair_homogeneous [CommSemiring R] (q : C → B) (t : B → C)
    (hqt : ∀ b, q (t b) = b) (r : B → ℕ) (U : MvPolynomial (B ⊕ B) R)
    (hU : MultiBlockHomogeneous (Sum.elim id q) r (MvPolynomial.rename (retainedPairEmbedding t) U)) :
    BlockHomogeneous r U := by
  have ht : Function.Injective t := fun a b hab => by
    have := congrArg q hab
    simpa only [hqt] using this
  have hh := MultiBlockHomogeneous_rename_pullback (retainedPairEmbedding t)
    (retainedPairEmbedding_injective t ht) (Sum.elim id q) r U hU
  have hb : Sum.elim id q ∘ retainedPairEmbedding t = Sum.elim id id := by
    funext i
    cases i <;> simp [retainedPairEmbedding, hqt]
  rw [hb] at hh
  exact (multiBlockHomogeneous_pair_iff r U).mp hh

open scoped Classical in
def blockHomogeneous_map {S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (r : B → ℕ) (P : MvPolynomial (B ⊕ B) R) (hP : BlockHomogeneous r P) :
    BlockHomogeneous r (MvPolynomial.map f P) := by
  intro e he
  exact hP e (MvPolynomial.support_map_subset f P he)

open scoped Classical in
def complementShear_retainedPair (t : B → C) (β : B → ℚ)
    (P : MvPolynomial (B ⊕ B) ℚ) :
    complementShear (fun b => MvPolynomial.C (β b) * MvPolynomial.X (t b))
      (MvPolynomial.rename (retainedPairEmbedding t) P) =
      MvPolynomial.rename (retainedPairEmbedding t) (blockTaylor β P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    dsimp only [retainedPairEmbedding] at hP
    cases i <;> simp only [map_mul, MvPolynomial.rename_X, retainedPairEmbedding,
      Sum.map_inl, Sum.map_inr, id_eq, complementShear_X_inl, complementShear_X_inr,
      map_add, MvPolynomial.rename_C, blockTaylor_X_inl, blockTaylor_X_inr, hP]

open scoped Classical in
def retainedPair_hyperplane_index (t : B → C) (ht : Function.Injective t)
    (r w : B → ℕ) (β : B → ℚ) (P : MvPolynomial (B ⊕ B) ℚ) (hP : BlockHomogeneous r P) :
    complementHyperplaneIndex w (fun b => MvPolynomial.C (β b) * MvPolynomial.X (t b))
      (MvPolynomial.rename (retainedPairEmbedding t) P) =
      weightedPolynomialIndex w β (blockDehomogenize P) := by
  unfold complementHyperplaneIndex
  rw [complementShear_retainedPair, weightedPolynomialOrder_rename_injective _ _
    (retainedPairEmbedding_injective t ht)]
  have hw : Sum.elim w (fun _ : C => 0) ∘ retainedPairEmbedding t = Sum.elim w (fun _ : B => 0) := by
    funext i
    cases i <;> rfl
  rw [hw]
  exact blockDehomogenize_hyperplane_index r w β P hP

open scoped Classical in
def blockComplementLinear [Fintype C] (q : C → B) (a : C → ℚ) (b : B) : MvPolynomial C ℚ :=
  ∑ c ∈ Finset.univ.filter (fun c => q c = b), MvPolynomial.C (a c) * MvPolynomial.X c

open scoped Classical in
def zeroVariables_blockComplementLinear [Fintype C] (q : C → B) (t : B → C)
    (hqt : ∀ b, q (t b) = b) (a : C → ℚ) (b : B) :
    zeroVariables (Finset.univ.filter (fun c => c ∉ Set.range t)) (blockComplementLinear q a b) =
      MvPolynomial.C (a (t b)) * MvPolynomial.X (t b) := by
  classical
  unfold blockComplementLinear
  rw [map_sum, Finset.sum_eq_single (t b)]
  · simp only [map_mul, zeroVariables_C, zeroVariables_X]
    simp
  · intro c hc hct
    have hqc : q c = b := (Finset.mem_filter.mp hc).2
    have hn : c ∉ Set.range t := by
      rintro ⟨u, rfl⟩
      have hu : u = b := (hqt u).symm.trans hqc
      exact hct (congrArg t hu)
    rw [map_mul, zeroVariables_C, zeroVariables_X,
      if_pos (Finset.mem_filter.mpr ⟨Finset.mem_univ c, hn⟩), mul_zero]
  · intro hn
    exact False.elim (hn (by simp [hqt]))

/- Eliminate every unselected complement, then dehomogenize the actual
remaining integer polynomial.  No index-monotonicity assumption is supplied. -/
open scoped Classical in
def exists_integer_scalar_hyperplane_reduction [Fintype C]
    (q : C → B) (t : B → C) (hqt : ∀ b, q (t b) = b) (a : C → ℚ)
    (r w : B → ℕ) (P : MvPolynomial (B ⊕ C) ℤ) (hP : P ≠ 0)
    (hhom : MultiBlockHomogeneous (Sum.elim id q) r P) :
    ∃ R : MvPolynomial B ℤ, R ≠ 0 ∧ (∀ b, R.degreeOf b ≤ r b) ∧
      polynomialCoeffL1 R ≤ polynomialCoeffL1 P ∧
      complementHyperplaneIndex w (blockComplementLinear q a)
          (MvPolynomial.map (Int.castRingHom ℚ) P) ≤
        weightedPolynomialIndex w (fun b => a (t b)) (MvPolynomial.map (Int.castRingHom ℚ) R) := by
  classical
  let s : Finset C := Finset.univ.filter (fun c => c ∉ Set.range t)
  have ht : Function.Injective t := fun u v huv => by
    have := congrArg q huv
    simpa only [hqt] using this
  obtain ⟨r', Q, hr', hQ, hhomQ, hdegQ, hnormQ, hzero, hindex⟩ :=
    exists_integer_complement_elimination (Sum.elim id q) r w
      (blockComplementLinear q a) s P hP hhom
  obtain ⟨U, hUeq⟩ := exists_retainedPair_polynomial t ht Q
    (fun c hc => hzero c (Finset.mem_filter.mpr ⟨Finset.mem_univ c, hc⟩))
  have hU : U ≠ 0 := by intro hz; simp only [hz, map_zero] at hUeq; exact hQ hUeq.symm
  have hhomU : BlockHomogeneous r' U := retainedPair_homogeneous q t hqt r' U (hUeq.symm ▸ hhomQ)
  refine ⟨blockDehomogenize U, blockDehomogenize_ne_zero r' hhomU hU, ?_, ?_, ?_⟩
  · intro b
    exact (blockDehomogenize_degreeOf_le r' U hhomU b).trans (hr' b)
  · rw [blockDehomogenize_coeffL1 r' U hhomU,
      ← polynomialCoeffL1_rename_of_injective _ (retainedPairEmbedding_injective t ht), hUeq]
    exact hnormQ
  · have hg : (fun b => zeroVariables s (blockComplementLinear q a b)) =
        (fun b => MvPolynomial.C (a (t b)) * MvPolynomial.X (t b)) := by
      funext b
      exact zeroVariables_blockComplementLinear q t hqt a b
    rw [hg, ← hUeq, MvPolynomial.map_rename,
      retainedPair_hyperplane_index t ht r' w _ _
        (blockHomogeneous_map (Int.castRingHom ℚ) r' U hhomU), ← blockDehomogenize_map] at hindex
    exact hindex

open scoped Classical in
def normalizedComplementHyperplaneIndex {m : ℕ} (r : Fin m → ℕ)
    (g : Fin m → MvPolynomial C ℚ) (P : MvPolynomial (Fin m ⊕ C) ℚ) : ℝ :=
  ((complementHyperplaneIndex (rothWeight r) g P).toNat : ℝ) / rothDenominator r

/- The proved integer Roth theorem applied to the polynomial constructed by
finite saturation and dehomogenization.  Heights refer to the selected ratios. -/
open scoped Classical in
def integer_complement_hyperplane_roth_bound {n : ℕ} [Fintype C]
    (q : C → Fin (n + 1)) (t : Fin (n + 1) → C) (hqt : ∀ b, q (t b) = b)
    (a : C → ℚ) (r : Fin (n + 1) → ℕ) (hr : ∀ i, 0 < r i)
    (P : MvPolynomial (Fin (n + 1) ⊕ C) ℤ) (hP : P ≠ 0)
    (hhom : MultiBlockHomogeneous (Sum.elim id q) r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ i, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r i : ℝ) * Height.logHeight₁ (a (t i)))) :
    normalizedComplementHyperplaneIndex r (blockComplementLinear q a)
      (MvPolynomial.map (Int.castRingHom ℚ) P) ≤ 2 * (n + 1 : ℕ) * η := by
  obtain ⟨R, hR, hdegree, hnorm, hindex⟩ :=
    exists_integer_scalar_hyperplane_reduction q t hqt a r (rothWeight r) P hP hhom
  have hlog : Real.log (polynomialCoeffL1 R) ≤ Real.log (polynomialCoeffL1 P) :=
    Real.log_le_log (polynomialCoeffL1_pos hR) hnorm
  have hheightR (i) : Real.log (polynomialCoeffL1 R) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r i : ℝ) * Height.logHeight₁ (a (t i))) := by
    linarith [hheight i]
  have hroth := integer_roth_index_bound n R hR r hr hdegree (fun i => a (t i))
    η hη hηhalf hstep hheightR
  have hn := ENat.toNat_le_toNat hindex
    (weightedPolynomialIndex_finite (rothWeight r) (fun i => a (t i)) (integerMap_ne_zero hR)).ne
  have hnormalized : normalizedComplementHyperplaneIndex r (blockComplementLinear q a)
      (MvPolynomial.map (Int.castRingHom ℚ) P) ≤
      rothPolynomialIndex r (fun i => a (t i)) (MvPolynomial.map (Int.castRingHom ℚ) R) :=
    div_le_div_of_nonneg_right (by exact_mod_cast hn) (Nat.cast_nonneg _)
  exact hnormalized.trans hroth


end
end Bounty

end SubmissionComponent_RationalHyperplaneReduction

/- Component ProductHyperplaneRoth; SHA256 436a70c448518844c612e1d612a35c03f4b9b9bfb0dc017537490c974df85a33 -/
section SubmissionComponent_ProductHyperplaneRoth
/- Integer Roth's lemma for actual rational hyperplanes in product coordinates. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def pivotComplementCoefficient {m d : ℕ} (b : Fin m → Fin (d + 1) → ℚ)
    (p : Fin m → Fin (d + 1)) (x : HyperplaneComplement p) : ℚ :=
  -(b x.val.1 x.val.2 / b x.val.1 (p x.val.1))

def productHyperplaneIndex {m d : ℕ} (b : Fin m → Fin (d + 1) → ℚ)
    (p : Fin m → Fin (d + 1)) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin (d + 1)) ℚ) : ℝ :=
  normalizedComplementHyperplaneIndex r
    (blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
      (pivotComplementCoefficient b p))
    (MvPolynomial.rename (hyperplanePivotEquiv p) P)

def integer_product_hyperplane_roth_bound {n d : ℕ} (hd : 1 ≤ d)
    (b : Fin (n + 1) → Fin (d + 1) → ℚ) (p : Fin (n + 1) → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0)
    (r : Fin (n + 1) → ℕ) (hr : ∀ h, 0 < r h)
    (P : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ h, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d))) :
    productHyperplaneIndex b p r (MvPolynomial.map (Int.castRingHom ℚ) P) ≤
      2 * (n + 1 : ℕ) * η := by
  classical
  choose j hj hpair using fun h => exists_rational_hyperplane_height_pair hd (b h) (p h) (hp h)
  let t (h : Fin (n + 1)) : HyperplaneComplement p := ⟨(h, j h), hj h⟩
  let Q := MvPolynomial.rename (hyperplanePivotEquiv p) P
  have hQ : Q ≠ 0 := by
    exact fun hz => hP ((MvPolynomial.rename_eq_zero_iff_of_injective P
      (hyperplanePivotEquiv p).injective).mp hz)
  have hhomQ : MultiBlockHomogeneous
      (Sum.elim id (fun x : HyperplaneComplement p => x.val.1)) r Q :=
    productBlockHomogeneous_pivotRename p r P hhom
  have hheightQ (h : Fin (n + 1)) :
      Real.log (polynomialCoeffL1 Q) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * Height.logHeight₁ (pivotComplementCoefficient b p (t h))) := by
    rw [show polynomialCoeffL1 Q = polynomialCoeffL1 P from pivotRename_coeffL1 p P]
    apply (hheight h).trans
    apply mul_le_mul_of_nonneg_left _ (pow_nonneg hη.le _)
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
    simpa only [pivotComplementCoefficient, t, neg_div] using hpair h
  have hbound := integer_complement_hyperplane_roth_bound
    (fun x : HyperplaneComplement p => x.val.1) t (fun _ => rfl)
    (pivotComplementCoefficient b p) r hr Q hQ hhomQ η hη hηhalf hstep hheightQ
  simpa only [productHyperplaneIndex, Q, MvPolynomial.map_rename] using hbound


end
end Bounty

end SubmissionComponent_ProductHyperplaneRoth

/- Component BoundedGridNonvanishing; SHA256 40d6010e6df02fc5b50d10669a98e0f67bf0c4c84c4bb1d9dff779c65c85b3b7 -/
section SubmissionComponent_BoundedGridNonvanishing
/- A bounded integer grid detects a low-order divided derivative. -/

namespace Bounty
noncomputable section
open scoped BigOperators
open Polynomial

def sum_rootMultiplicity_le_natDegree {K : Type*} [CommRing K] [IsDomain K]
    (P : K[X]) (S : Finset K) :
    ∑ z ∈ S, P.rootMultiplicity z ≤ P.natDegree := by
  classical
  simp_rw [← Polynomial.count_roots]
  calc
    ∑ z ∈ S, P.roots.count z ≤ ∑ z ∈ S ∪ P.roots.toFinset, P.roots.count z :=
      Finset.sum_le_sum_of_subset Finset.subset_union_left
    _ = P.roots.card := Multiset.sum_count_eq_card (fun z hz =>
      Finset.mem_union_right S (Multiset.mem_toFinset.mpr hz))
    _ ≤ P.natDegree := Polynomial.card_roots' P

def hasseDeriv_rootMultiplicity_eval_ne_zero {K : Type*} [CommRing K]
    {P : K[X]} (hP : P ≠ 0) (z : K) :
    (Polynomial.hasseDeriv (P.rootMultiplicity z) P).eval z ≠ 0 := by
  rw [← Polynomial.taylor_coeff, Polynomial.rootMultiplicity_eq_natTrailingDegree]
  change (P.taylor z).coeff (P.taylor z).natTrailingDegree ≠ 0
  exact Polynomial.coeff_natTrailingDegree_ne_zero.mpr ((Polynomial.taylor_eq_zero z P).not.mpr hP)

def exists_finite_grid_hasseDeriv_ne_zero {K : Type*} [CommRing K] [IsDomain K]
    {P : K[X]} (hP : P ≠ 0) (S : Finset K) (k : ℕ)
    (hcard : P.natDegree < S.card * (k + 1)) :
    ∃ z ∈ S, ∃ i ≤ k, (Polynomial.hasseDeriv i P).eval z ≠ 0 := by
  classical
  by_contra hh
  push_neg at hh
  have hm (z) (hz : z ∈ S) : k + 1 ≤ P.rootMultiplicity z := by
    by_contra hn
    have hk : P.rootMultiplicity z ≤ k := by omega
    exact hasseDeriv_rootMultiplicity_eval_ne_zero hP z (hh z hz _ hk)
  have hsum := Finset.sum_le_sum hm
  have hdegree := sum_rootMultiplicity_le_natDegree P S
  simp only [Finset.sum_const, smul_eq_mul] at hsum
  omega

def exists_nat_grid_hasseDeriv_ne_zero {K : Type*} [CommRing K] [IsDomain K]
    [CharZero K] {P : K[X]} (hP : P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ z ≤ B, ∃ i ≤ P.natDegree / B,
      (Polynomial.hasseDeriv i P).eval (z : K) ≠ 0 := by
  classical
  let S : Finset K := (Finset.range (B + 1)).image (fun z : ℕ => (z : K))
  have hScard : S.card = B + 1 := by
    rw [Finset.card_image_of_injective _ Nat.cast_injective, Finset.card_range]
  have hsize : P.natDegree < S.card * (P.natDegree / B + 1) := by
    rw [hScard]
    have hdiv := Nat.mod_lt P.natDegree hB
    have hrepr := Nat.mod_add_div P.natDegree B
    nlinarith
  obtain ⟨z, hz, i, hi, hne⟩ := exists_finite_grid_hasseDeriv_ne_zero hP S _ hsize
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hz
  exact ⟨a, by simpa only [Finset.mem_range, Nat.lt_succ_iff] using ha, i, hi, hne⟩


end
end Bounty

end SubmissionComponent_BoundedGridNonvanishing

/- Component MultivariateGridNonvanishing; SHA256 e51477a995bbb4af6eb8a743834eaf047f8e03959d3a6bddd97daf11ee271ee9 -/
section SubmissionComponent_MultivariateGridNonvanishing
/- Iterated coefficient-exact divided derivatives on a bounded integer grid. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def firstVariableHasseJet {n : ℕ} (P : MvPolynomial (Fin (n + 1)) ℚ)
    (z i : ℕ) : MvPolynomial (Fin n) ℚ :=
  (Polynomial.hasseDeriv i (MvPolynomial.finSuccEquiv ℚ n P)).eval (z : MvPolynomial (Fin n) ℚ)

def firstVariableHasseJet_degreeOf {n : ℕ} (P : MvPolynomial (Fin (n + 1)) ℚ)
    (z i : ℕ) (j : Fin n) :
    (firstVariableHasseJet P z i).degreeOf j ≤ P.degreeOf j.succ := by
  classical
  rw [firstVariableHasseJet, Polynomial.eval_eq_sum, Polynomial.sum_def]
  apply (MvPolynomial.degreeOf_sum_le _ _ _).trans
  apply Finset.sup_le
  intro a ha
  rw [Polynomial.hasseDeriv_coeff]
  have hc : ((a + i).choose i : MvPolynomial (Fin n) ℚ) =
      MvPolynomial.C ((a + i).choose i : ℚ) := by simp
  have hz : (z : MvPolynomial (Fin n) ℚ) ^ a = MvPolynomial.C ((z : ℚ) ^ a) := by simp
  rw [hc, hz, mul_assoc, mul_comm _ (MvPolynomial.C _), ← mul_assoc,
    ← MvPolynomial.C_mul]
  exact (MvPolynomial.degreeOf_C_mul_le _ _ _).trans
    (MvPolynomial.degreeOf_coeff_finSuccEquiv P j (a + i))

def exists_firstVariableHasseJet_ne_zero {n : ℕ}
    {P : MvPolynomial (Fin (n + 1)) ℚ} (hP : P ≠ 0)
    (B : ℕ) (hB : 0 < B) :
    ∃ z ≤ B, ∃ i ≤ P.degreeOf 0 / B, firstVariableHasseJet P z i ≠ 0 := by
  have hp : MvPolynomial.finSuccEquiv ℚ n P ≠ 0 := by
    intro hz
    apply hP
    exact (MvPolynomial.finSuccEquiv ℚ n).injective (hz.trans (map_zero _).symm)
  simpa only [MvPolynomial.natDegree_finSuccEquiv, firstVariableHasseJet] using
    exists_nat_grid_hasseDeriv_ne_zero hp B hB

def gridHasseJet : {n : ℕ} → MvPolynomial (Fin n) ℚ → (Fin n → ℕ) → (Fin n → ℕ) → ℚ
  | 0, P, _, _ => MvPolynomial.eval (fun i => Fin.elim0 i) P
  | _n + 1, P, z, a => gridHasseJet (firstVariableHasseJet P (z 0) (a 0))
      (fun i => z i.succ) (fun i => a i.succ)

def exists_bounded_gridHasseJet_ne_zero (n : ℕ)
    (P : MvPolynomial (Fin n) ℚ) (hP : P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ z a : Fin n → ℕ, (∀ i, z i ≤ B) ∧
      (∀ i, a i ≤ P.degreeOf i / B) ∧ gridHasseJet P z a ≠ 0 := by
  induction n with
  | zero =>
    refine ⟨Fin.elim0, Fin.elim0, (fun i => Fin.elim0 i), (fun i => Fin.elim0 i), ?_⟩
    change MvPolynomial.eval (fun i : Fin 0 => Fin.elim0 i) P ≠ 0
    intro hz
    have hC : MvPolynomial.C (MvPolynomial.eval (fun i : Fin 0 => Fin.elim0 i) P) = P := by
      clear hP hz
      induction P using MvPolynomial.induction_on with
      | C c => simp
      | add P Q hP hQ => simp [map_add, hP, hQ]
      | mul_X P i h => exact Fin.elim0 i
    rw [hz, map_zero] at hC
    exact hP hC.symm
  | succ n ih =>
    obtain ⟨z0, hz0, a0, ha0, hjet⟩ := exists_firstVariableHasseJet_ne_zero hP B hB
    obtain ⟨z, a, hz, ha, hne⟩ := ih (firstVariableHasseJet P z0 a0) hjet
    refine ⟨Fin.cons z0 z, Fin.cons a0 a, ?_, ?_, ?_⟩
    · intro i
      refine Fin.cases hz0 (fun j => ?_) i
      exact hz j
    · intro i
      refine Fin.cases ha0 (fun j => ?_) i
      exact (ha j).trans (Nat.div_le_div_right (firstVariableHasseJet_degreeOf P z0 a0 j))
    · simpa only [gridHasseJet, Fin.cons_zero, Fin.cons_succ] using hne


end
end Bounty

end SubmissionComponent_MultivariateGridNonvanishing

/- Component GridTaylorNonvanishing; SHA256 65425dbe043c4776e958538248ccfdc33885d2afc6e656abbccb4ee5a08fe6f8 -/
section SubmissionComponent_GridTaylorNonvanishing
/- The recursive bounded-grid jets are the actual multivariate Taylor coefficients. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def polynomial_map_hasseDeriv {R S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (P : Polynomial R) (i : ℕ) :
    (Polynomial.hasseDeriv i P).map f = Polynomial.hasseDeriv i (P.map f) := by
  ext n
  simp [Polynomial.hasseDeriv_coeff]

def finSuccEquiv_weightedTaylor {n : ℕ} (β : Fin (n + 1) → ℚ)
    (P : MvPolynomial (Fin (n + 1)) ℚ) :
    MvPolynomial.finSuccEquiv ℚ n (weightedTaylor β P) =
      Polynomial.taylor (MvPolynomial.C (β 0))
        ((MvPolynomial.finSuccEquiv ℚ n P).map (weightedTaylor (fun i => β i.succ))) := by
  have hC (a : ℚ) : MvPolynomial.finSuccEquiv ℚ n (MvPolynomial.C a) =
      Polynomial.C (MvPolynomial.C a) := by simp [MvPolynomial.finSuccEquiv_apply]
  induction P using MvPolynomial.induction_on with
  | C a => simp [MvPolynomial.finSuccEquiv_apply, weightedTaylor_C]
  | add P Q hP hQ => simp only [map_add, Polynomial.map_add, hP, hQ]
  | mul_X P i hP =>
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [map_mul, map_add, hP, MvPolynomial.finSuccEquiv_X_zero,
        Polynomial.taylor_apply, Polynomial.mul_comp, hC, weightedTaylor_X]
    · simp [map_mul, map_add, hP, MvPolynomial.finSuccEquiv_X_succ,
        Polynomial.taylor_apply, Polynomial.mul_comp, hC, weightedTaylor_X]

def weightedTaylor_firstVariableHasseJet {n : ℕ}
    (P : MvPolynomial (Fin (n + 1)) ℚ) (z i : ℕ) (β : Fin n → ℚ) :
    weightedTaylor β (firstVariableHasseJet P z i) =
      (MvPolynomial.finSuccEquiv ℚ n
        (weightedTaylor (Fin.cons (z : ℚ) β) P)).coeff i := by
  rw [finSuccEquiv_weightedTaylor, Polynomial.taylor_coeff]
  simp only [Fin.cons_zero, Fin.cons_succ]
  rw [← polynomial_map_hasseDeriv]
  have hz : MvPolynomial.C (z : ℚ) = weightedTaylor β (z : MvPolynomial (Fin n) ℚ) := by simp
  rw [hz, Polynomial.eval_map_apply]
  rfl

def gridHasseJet_eq_taylorCoeff (n : ℕ) (P : MvPolynomial (Fin n) ℚ)
    (z a : Fin n → ℕ) :
    gridHasseJet P z a = MvPolynomial.coeff (Finsupp.equivFunOnFinite.symm a)
      (weightedTaylor (fun i => (z i : ℚ)) P) := by
  induction n with
  | zero =>
    have hz : (fun i : Fin 0 => (z i : ℚ)) = 0 := funext (fun i => Fin.elim0 i)
    have ha : Finsupp.equivFunOnFinite.symm a = 0 := by ext i; exact Fin.elim0 i
    have he : (fun i : Fin 0 => (Fin.elim0 i : ℚ)) = 0 := funext (fun i => Fin.elim0 i)
    simp only [gridHasseJet, hz, ha, he, weightedTaylor_zero,
      MvPolynomial.eval_zero, MvPolynomial.constantCoeff_eq]
  | succ n ih =>
    rw [gridHasseJet, ih]
    rw [weightedTaylor_firstVariableHasseJet]
    rw [MvPolynomial.finSuccEquiv_coeff_coeff]
    congr 1
    · ext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
    · congr 1
      apply congrArg weightedTaylor
      funext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp

def exists_bounded_grid_taylorCoeff_ne_zero (n : ℕ)
    (P : MvPolynomial (Fin n) ℚ) (hP : P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ (z : Fin n → ℕ) (a : Fin n →₀ ℕ), (∀ i, z i ≤ B) ∧
      (∀ i, a i ≤ P.degreeOf i / B) ∧
      MvPolynomial.coeff a (weightedTaylor (fun i => (z i : ℚ)) P) ≠ 0 := by
  obtain ⟨z, a, hz, ha, hne⟩ := exists_bounded_gridHasseJet_ne_zero n P hP B hB
  exact ⟨z, Finsupp.equivFunOnFinite.symm a, hz, ha,
    (gridHasseJet_eq_taylorCoeff n P z a) ▸ hne⟩


end
end Bounty

end SubmissionComponent_GridTaylorNonvanishing

/- Component GridDividedDerivative; SHA256 96225ae74321bcb2aa39fe73e035991612fea04ea64f7d7e086c5302ff0d1540 -/
section SubmissionComponent_GridDividedDerivative
/- Bounded-grid nonvanishing for the same divided derivative operators used by Roth. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def constantCoeff_weightedTaylor {I : Type*} (β : I → ℚ)
    (P : MvPolynomial I ℚ) :
    MvPolynomial.constantCoeff (weightedTaylor β P) = MvPolynomial.eval β P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [weightedTaylor_C]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP => simp [map_mul, map_add, hP, weightedTaylor_X]

def weightedTaylor_wordPDeriv {I : Type*} (β : I → ℚ)
    (s : List I) (P : MvPolynomial I ℚ) :
    weightedTaylor β (wordPDeriv s P) = wordPDeriv s (weightedTaylor β P) := by
  induction s with
  | nil => rfl
  | cons i s ih => rw [wordPDeriv_cons, weightedTaylor_pderiv, ih, wordPDeriv_cons]

def weightedTaylor_dividedWordPDeriv {I : Type*} [Fintype I] [DecidableEq I]
    (β : I → ℚ) (s : List I) (P : MvPolynomial I ℚ) :
    weightedTaylor β (dividedWordPDeriv s P) = dividedWordPDeriv s (weightedTaylor β P) := by
  change weightedTaylor β ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P) =
    (wordDerivativeFactorial s)⁻¹ • wordPDeriv s (weightedTaylor β P)
  simp only [MvPolynomial.smul_eq_C_mul, map_mul, weightedTaylor_C, weightedTaylor_wordPDeriv]

def eval_dividedWordPDeriv_eq_taylorCoeff {I : Type*} [Fintype I] [DecidableEq I]
    (β : I → ℚ) (s : List I) (P : MvPolynomial I ℚ) :
    MvPolynomial.eval β (dividedWordPDeriv s P) =
      MvPolynomial.coeff (wordDerivativeCounts s) (weightedTaylor β P) := by
  rw [← constantCoeff_weightedTaylor, MvPolynomial.constantCoeff_eq,
    weightedTaylor_dividedWordPDeriv, coeff_dividedWordPDeriv]
  simp

def exists_wordDerivativeCounts {I : Type*} [Fintype I] [DecidableEq I]
    (a : I →₀ ℕ) : ∃ s : List I, wordDerivativeCounts s = a := by
  refine ⟨a.toMultiset.toList, ?_⟩
  ext i
  rw [wordDerivativeCounts_apply, ← Multiset.coe_count, Multiset.coe_toList,
    Finsupp.count_toMultiset]

def exists_bounded_grid_dividedWordPDeriv_ne_zero (n : ℕ)
    (P : MvPolynomial (Fin n) ℚ) (hP : P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ (z : Fin n → ℕ) (s : List (Fin n)), (∀ i, z i ≤ B) ∧
      (∀ i, s.count i ≤ P.degreeOf i / B) ∧
      MvPolynomial.eval (fun i => (z i : ℚ)) (dividedWordPDeriv s P) ≠ 0 := by
  obtain ⟨z, a, hz, ha, hne⟩ := exists_bounded_grid_taylorCoeff_ne_zero n P hP B hB
  obtain ⟨s, hs⟩ := exists_wordDerivativeCounts a
  refine ⟨z, s, hz, ?_, ?_⟩
  · intro i
    simpa only [← hs, wordDerivativeCounts_apply] using ha i
  · rwa [eval_dividedWordPDeriv_eq_taylorCoeff, hs]


end
end Bounty

end SubmissionComponent_GridDividedDerivative

/- Component HyperplaneDerivativeWitness; SHA256 442ba4f39c72d251b0a37ee5e78d8be942cb30e28605dceb041aa3e53ea1f5a4 -/
section SubmissionComponent_HyperplaneDerivativeWitness
/- Actual coordinate derivatives witnessing the weighted hyperplane index. -/

namespace Bounty
noncomputable section
open scoped BigOperators

variable {B C : Type*}

def pderiv_inl_rename_inr (b : B) (P : MvPolynomial C ℚ) :
    MvPolynomial.pderiv (Sum.inl b) (MvPolynomial.rename (Sum.inr : C → B ⊕ C) P) = 0 := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ, add_zero]
  | mul_X P c hP => simp [map_mul, hP]

def pderiv_inl_complementShear (g : B → MvPolynomial C ℚ)
    (b : B) (P : MvPolynomial (B ⊕ C) ℚ) :
    MvPolynomial.pderiv (Sum.inl b) (complementShear g P) =
      complementShear g (MvPolynomial.pderiv (Sum.inl b) P) := by
  classical
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i <;> simp [map_mul, MvPolynomial.pderiv_X, Pi.single_apply,
      complementShear_X_inl, complementShear_X_inr, pderiv_inl_rename_inr, hP, apply_ite]

def wordPDeriv_inl_complementShear (g : B → MvPolynomial C ℚ)
    (s : List B) (P : MvPolynomial (B ⊕ C) ℚ) :
    wordPDeriv (s.map Sum.inl) (complementShear g P) =
      complementShear g (wordPDeriv (s.map Sum.inl) P) := by
  induction s with
  | nil => rfl
  | cons b s ih =>
    simp only [List.map_cons, wordPDeriv_cons, ih, pderiv_inl_complementShear]

def dividedWordPDeriv_inl_complementShear [Fintype B] [Fintype C]
    [DecidableEq B] [DecidableEq C] (g : B → MvPolynomial C ℚ)
    (s : List B) (P : MvPolynomial (B ⊕ C) ℚ) :
    dividedWordPDeriv (s.map Sum.inl) (complementShear g P) =
      complementShear g (dividedWordPDeriv (s.map Sum.inl) P) := by
  change (wordDerivativeFactorial (s.map Sum.inl))⁻¹ •
      wordPDeriv (s.map Sum.inl) (complementShear g P) =
    complementShear g ((wordDerivativeFactorial (s.map Sum.inl))⁻¹ •
      wordPDeriv (s.map Sum.inl) P)
  rw [map_smul, wordPDeriv_inl_complementShear]

def complementRestriction (g : B → MvPolynomial C ℚ)
    (P : MvPolynomial (B ⊕ C) ℚ) : MvPolynomial C ℚ :=
  (complementShear g P).killCompl Sum.inr_injective

def wordDerivativeCounts_map_inl [Fintype B] [Fintype C]
    [DecidableEq B] [DecidableEq C] (s : List B) :
    wordDerivativeCounts (s.map (Sum.inl : B → B ⊕ C)) =
      (wordDerivativeCounts s).mapDomain Sum.inl := by
  induction s with
  | nil => simp only [List.map_nil, wordDerivativeCounts_nil, Finsupp.mapDomain_zero]
  | cons b s ih =>
    rw [List.map_cons, wordDerivativeCounts_cons, wordDerivativeCounts_cons,
      Finsupp.mapDomain_add, Finsupp.mapDomain_single, ih]

def exponent_map_inr_inl (a : C →₀ ℕ) (b : B) :
    a.mapDomain (Sum.inr : C → B ⊕ C) (Sum.inl b) = 0 :=
  Finsupp.mapDomain_of_notMem_range _ _ (by simp)

def exponent_map_inl_inr (a : B →₀ ℕ) (c : C) :
    a.mapDomain (Sum.inl : B → B ⊕ C) (Sum.inr c) = 0 :=
  Finsupp.mapDomain_of_notMem_range _ _ (by simp)

def sum_exponent_parts (e : (B ⊕ C) →₀ ℕ) :
    (e.comapDomain Sum.inr Sum.inr_injective.injOn).mapDomain Sum.inr +
      (e.comapDomain Sum.inl Sum.inl_injective.injOn).mapDomain Sum.inl = e := by
  ext i
  cases i <;> simp only [Finsupp.add_apply,
    Finsupp.mapDomain_apply Sum.inl_injective, Finsupp.mapDomain_apply Sum.inr_injective,
    Finsupp.comapDomain_apply, exponent_map_inr_inl, exponent_map_inl_inr,
    zero_add, add_zero]

def coeff_restricted_pivot_derivative [Fintype B] [Fintype C]
    [DecidableEq B] [DecidableEq C] (P : MvPolynomial (B ⊕ C) ℚ)
    (e : (B ⊕ C) →₀ ℕ) (s : List B)
    (hs : wordDerivativeCounts s = e.comapDomain Sum.inl Sum.inl_injective.injOn) :
    MvPolynomial.coeff (e.comapDomain Sum.inr Sum.inr_injective.injOn)
        ((dividedWordPDeriv (s.map Sum.inl) P).killCompl Sum.inr_injective) =
      MvPolynomial.coeff e P := by
  rw [MvPolynomial.coeff_killCompl, coeff_dividedWordPDeriv]
  change MvPolynomial.coeff (_ + wordDerivativeCounts (s.map Sum.inl)) P *
    (∏ i, (((e.comapDomain Sum.inr Sum.inr_injective.injOn).mapDomain Sum.inr i +
      wordDerivativeCounts (s.map Sum.inl) i).choose
      (wordDerivativeCounts (s.map Sum.inl) i) : ℚ)) = _
  rw [wordDerivativeCounts_map_inl, hs, sum_exponent_parts]
  have hf (i : B ⊕ C) :
      (((e.comapDomain Sum.inr Sum.inr_injective.injOn).mapDomain Sum.inr i +
          (e.comapDomain Sum.inl Sum.inl_injective.injOn).mapDomain Sum.inl i).choose
        ((e.comapDomain Sum.inl Sum.inl_injective.injOn).mapDomain Sum.inl i) : ℚ) = 1 := by
    cases i <;> simp [exponent_map_inr_inl, exponent_map_inl_inr]
  simp only [hf, Finset.prod_const_one, mul_one]

def exists_pivot_derivative_restriction [Fintype B] [Fintype C]
    [DecidableEq B] [DecidableEq C] (w : B → ℕ) (g : B → MvPolynomial C ℚ)
    (P : MvPolynomial (B ⊕ C) ℚ) (hP : P ≠ 0) :
    ∃ s : List B,
      complementRestriction g (dividedWordPDeriv (s.map Sum.inl) P) ≠ 0 ∧
      Finsupp.weight w (wordDerivativeCounts s) = (complementHyperplaneIndex w g P).toNat := by
  have hS : complementShear g P ≠ 0 := by
    intro hz
    exact hP ((complementShear_injective g) (hz.trans (map_zero _).symm))
  obtain ⟨e, he, hweight⟩ := weightedPolynomialOrder_attained (Sum.elim w (fun _ : C => 0)) hS
  obtain ⟨s, hs⟩ := exists_wordDerivativeCounts
    (e.comapDomain Sum.inl Sum.inl_injective.injOn)
  refine ⟨s, ?_, ?_⟩
  · intro hz
    have hc := coeff_restricted_pivot_derivative (complementShear g P) e s hs
    rw [dividedWordPDeriv_inl_complementShear] at hc
    change MvPolynomial.coeff _ (complementRestriction g _) = _ at hc
    rw [hz, MvPolynomial.coeff_zero] at hc
    exact he hc.symm
  · have hn := congrArg ENat.toNat hweight
    simp only [ENat.toNat_natCast] at hn
    rw [hs]
    change _ = (weightedPolynomialOrder (Sum.elim w (fun _ : C => 0))
      (complementShear g P)).toNat
    rw [← hn, Finsupp.weight_eq_sum, Finsupp.weight_eq_sum, Fintype.sum_sum_type]
    simp [Finsupp.comapDomain_apply]

def exists_normalized_pivot_derivative_restriction {m : ℕ} [Fintype C] [DecidableEq C]
    (r : Fin m → ℕ) (hr : ∀ i, 0 < r i) (g : Fin m → MvPolynomial C ℚ)
    (P : MvPolynomial (Fin m ⊕ C) ℚ) (hP : P ≠ 0) :
    ∃ s : List (Fin m),
      complementRestriction g (dividedWordPDeriv (s.map Sum.inl) P) ≠ 0 ∧
      (∑ i, ((s.count i : ℕ) : ℝ) / r i) = normalizedComplementHyperplaneIndex r g P := by
  obtain ⟨s, hs, heq⟩ := exists_pivot_derivative_restriction (rothWeight r) g P hP
  refine ⟨s, hs, ?_⟩
  rw [normalizedComplementHyperplaneIndex, ← heq,
    rothMonomialWeight_eq_normalized_weight hr]
  rfl


end
end Bounty

end SubmissionComponent_HyperplaneDerivativeWitness

/- Component HyperplaneGraph; SHA256 8fbd8810802a6ac638830614b53e07561fbf7ef25dc4e1d34211e399372e0343 -/
section SubmissionComponent_HyperplaneGraph
/- The concrete shear restricts to the kernel of the given rational forms. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def sum_complement_fiber {m d : ℕ} {R : Type*} [AddCommMonoid R]
    (p : Fin m → Fin (d + 1)) (f : Fin m × Fin (d + 1) → R) (h : Fin m) :
    (∑ k ∈ Finset.univ.erase (p h), f (h, k)) =
      ∑ x ∈ Finset.univ.filter (fun x : HyperplaneComplement p => x.val.1 = h), f x.val := by
  classical
  refine Finset.sum_bij (fun k hk =>
    (⟨(h, k), (Finset.mem_erase.mp hk).1⟩ : HyperplaneComplement p)) ?_ ?_ ?_ ?_
  · intro k hk
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩
  · intro k hk l hl he
    exact congrArg (fun x : HyperplaneComplement p => x.val.2) he
  · intro x hx
    have hh : x.val.1 = h := (Finset.mem_filter.mp hx).2
    have hk : x.val.2 ≠ p h := by simpa only [← hh] using x.property
    refine ⟨x.val.2, Finset.mem_erase.mpr ⟨hk, Finset.mem_univ _⟩, ?_⟩
    apply Subtype.ext
    exact Prod.ext hh.symm rfl
  · intro k hk
    rfl

def productHyperplaneLinearForm {m d : ℕ} (b : Fin m → Fin (d + 1) → ℚ)
    (h : Fin m) : MvPolynomial (Fin m × Fin (d + 1)) ℚ :=
  ∑ k, MvPolynomial.C (b h k) * MvPolynomial.X (h, k)

def pivot_scaled_complement_form {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (h : Fin m) (hp : b h (p h) ≠ 0) :
    MvPolynomial.C (b h (p h)) *
      MvPolynomial.rename (Sum.inr : HyperplaneComplement p → Fin m ⊕ HyperplaneComplement p)
        (blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
          (pivotComplementCoefficient b p) h) =
      -(∑ x ∈ Finset.univ.filter (fun x : HyperplaneComplement p => x.val.1 = h),
        MvPolynomial.C (b x.val.1 x.val.2) * MvPolynomial.X (Sum.inr x)) := by
  classical
  unfold blockComplementLinear
  rw [map_sum, Finset.mul_sum, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr ?_ ?_
  · ext x
    simp
  intro x hx
  have hh : x.val.1 = h := (Finset.mem_filter.mp hx).2
  simp only [map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X,
    pivotComplementCoefficient, hh]
  rw [← mul_assoc, ← MvPolynomial.C_mul]
  have hc : b h (p h) * -(b h x.val.2 / b h (p h)) = -(b h x.val.2) := by
    field_simp
  rw [hc, MvPolynomial.C_neg, neg_mul]

def rename_productHyperplaneLinearForm {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (h : Fin m) (hp : b h (p h) ≠ 0) :
    MvPolynomial.rename (hyperplanePivotEquiv p) (productHyperplaneLinearForm b h) =
      MvPolynomial.C (b h (p h)) *
        (MvPolynomial.X (Sum.inl h) -
          MvPolynomial.rename Sum.inr
            (blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
              (pivotComplementCoefficient b p) h)) := by
  classical
  unfold productHyperplaneLinearForm
  rw [map_sum]
  simp only [map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X]
  rw [← Finset.sum_erase_add Finset.univ _ (Finset.mem_univ (p h))]
  rw [sum_complement_fiber p (fun x => MvPolynomial.C (b x.1 x.2) *
    MvPolynomial.X (hyperplanePivotEquiv p x)) h]
  simp only [hyperplanePivotEquiv_complement, hyperplanePivotEquiv_pivot]
  rw [mul_sub, pivot_scaled_complement_form b p h hp]
  ring

variable {B C : Type*}

def killCompl_inr_X_inl (b : B) :
    (MvPolynomial.X (R := ℚ) (Sum.inl b : B ⊕ C)).killCompl Sum.inr_injective = 0 := by
  change (MvPolynomial.monomial (Finsupp.single (Sum.inl b) 1) (1 : ℚ)).killCompl _ = 0
  apply MvPolynomial.killCompl_monomial_eq_zero_of_notMem_range _ _ (a := Sum.inl b)
  · simp
  · simp

def killCompl_inr_X_inr (c : C) :
    (MvPolynomial.X (R := ℚ) (Sum.inr c : B ⊕ C)).killCompl Sum.inr_injective = MvPolynomial.X c := by
  simpa only [MvPolynomial.rename_X] using MvPolynomial.killCompl_rename_app
    (f := (Sum.inr : C → B ⊕ C)) Sum.inr_injective (MvPolynomial.X (R := ℚ) c)

def complementRestriction_eq_aeval (g : B → MvPolynomial C ℚ)
    (P : MvPolynomial (B ⊕ C) ℚ) :
    complementRestriction g P = MvPolynomial.aeval (Sum.elim g MvPolynomial.X) P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [complementRestriction]
  | add P Q hP hQ => simpa only [complementRestriction, map_add] using congrArg₂ (· + ·) hP hQ
  | mul_X P i hP =>
    unfold complementRestriction at *
    cases i <;> simp only [map_mul, MvPolynomial.aeval_X, Sum.elim_inl, Sum.elim_inr,
      complementShear_X_inl, complementShear_X_inr, map_add,
      killCompl_inr_X_inl, killCompl_inr_X_inr, MvPolynomial.killCompl_rename_app,
      zero_add, hP]

def complementRestriction_productHyperplaneLinearForm {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (h : Fin m) (hp : b h (p h) ≠ 0) :
    complementRestriction
      (blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
        (pivotComplementCoefficient b p))
      (MvPolynomial.rename (hyperplanePivotEquiv p) (productHyperplaneLinearForm b h)) = 0 := by
  rw [rename_productHyperplaneLinearForm b p h hp]
  simp [complementRestriction, map_mul, map_sub, complementShear_rename_inr,
    complementShear_X_inl, killCompl_inr_X_inl]


end
end Bounty

end SubmissionComponent_HyperplaneGraph

/- Component DividedDerivativeRename; SHA256 0ac17492adcbfef7e918b335642f839749e74db7c48cee00cd6e567b23b78db1 -/
section SubmissionComponent_DividedDerivativeRename
/- Exact coordinate transport for divided derivative words. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def wordPDeriv_rename {I J : Type*} (f : I → J) (hf : Function.Injective f)
    (s : List I) (P : MvPolynomial I ℚ) :
    wordPDeriv (s.map f) (MvPolynomial.rename f P) =
      MvPolynomial.rename f (wordPDeriv s P) := by
  induction s with
  | nil => rfl
  | cons i s ih =>
    simp only [List.map_cons, wordPDeriv_cons, ih, MvPolynomial.pderiv_rename hf]

def wordDerivativeCounts_map_injective {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (f : I → J) (s : List I) :
    wordDerivativeCounts (s.map f) = (wordDerivativeCounts s).mapDomain f := by
  induction s with
  | nil => simp only [List.map_nil, wordDerivativeCounts_nil, Finsupp.mapDomain_zero]
  | cons i s ih =>
    rw [List.map_cons, wordDerivativeCounts_cons, wordDerivativeCounts_cons,
      Finsupp.mapDomain_add, Finsupp.mapDomain_single, ih]

def wordDerivativeFactorial_map_equiv {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (e : I ≃ J) (s : List I) : wordDerivativeFactorial (s.map e) = wordDerivativeFactorial s := by
  change (∏ j, ((wordDerivativeCounts (s.map e) j).factorial : ℚ)) =
    ∏ i, ((wordDerivativeCounts s i).factorial : ℚ)
  rw [wordDerivativeCounts_map_injective]
  calc
    _ = ∏ i, (((wordDerivativeCounts s).mapDomain e (e i)).factorial : ℚ) :=
      (Equiv.prod_comp e _).symm
    _ = _ := by simp only [Finsupp.mapDomain_apply e.injective]

def dividedWordPDeriv_rename_equiv {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (e : I ≃ J) (s : List I) (P : MvPolynomial I ℚ) :
    dividedWordPDeriv (s.map e) (MvPolynomial.rename e P) =
      MvPolynomial.rename e (dividedWordPDeriv s P) := by
  change (wordDerivativeFactorial (s.map e))⁻¹ • wordPDeriv (s.map e) (MvPolynomial.rename e P) =
    MvPolynomial.rename e ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P)
  rw [map_smul, wordPDeriv_rename _ e.injective, wordDerivativeFactorial_map_equiv]


end
end Bounty

end SubmissionComponent_DividedDerivativeRename

/- Component BalancedAuxiliaryHeight; SHA256 c0f42411c2cd8b645813e768c4d07ae693e05a3f2eb3cfee7212e78e2f635e05 -/
section SubmissionComponent_BalancedAuxiliaryHeight
/- Degree-uniform coefficient heights for the constructed balanced auxiliary
polynomial.  All counting estimates are for the actual composition-array type. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def weakComposition_card_le (d r : ℕ) :
    Fintype.card (WeakComposition d r) ≤ (r + 1) ^ d := by
  let f : WeakComposition d r → Fin d → Fin (r + 1) :=
    fun v i => ⟨v.val i, Nat.lt_succ_of_le (weakComposition_coord_le v i)⟩
  have hf : Function.Injective f := by
    intro v w hvw
    apply Subtype.ext
    funext i
    exact congrArg (fun z : Fin d → Fin (r + 1) => (z i).val) hvw
  simpa using Fintype.card_le_of_injective f hf

def compositionArray_card_le_product {m d : ℕ} (r : Fin m → ℕ) :
    Fintype.card (CompositionArray m d r) ≤ ∏ h, (r h + 1) ^ d := by
  rw [Fintype.card_pi]
  exact Finset.prod_le_prod (fun h _ => Nat.zero_le _)
    (fun h _ => weakComposition_card_le d (r h))

def compositionArray_card_le_two_pow {m d : ℕ} (r : Fin m → ℕ) :
    Fintype.card (CompositionArray m d r) ≤ 2 ^ (d * ∑ h, r h) := by
  calc
    _ ≤ ∏ h, (r h + 1) ^ d := compositionArray_card_le_product r
    _ ≤ ∏ h, (2 ^ r h) ^ d := Finset.prod_le_prod (fun h _ => Nat.zero_le _)
      (fun h _ => Nat.pow_le_pow_left (r h).lt_two_pow_self d)
    _ = _ := by
      simp_rw [← pow_mul]
      rw [Finset.prod_pow_eq_pow_sum]
      congr 1
      rw [← Finset.sum_mul, mul_comm]

def compositionArray_log_card_le {m d : ℕ} (r : Fin m → ℕ) (hd : 0 < d) :
    Real.log (Fintype.card (CompositionArray m d r)) ≤
      (d : ℝ) * (∑ h, (r h : ℝ)) * Real.log 2 := by
  have hN : (0 : ℝ) < Fintype.card (CompositionArray m d r) := by
    exact_mod_cast compositionArray_card_pos r hd
  have hbound : (Fintype.card (CompositionArray m d r) : ℝ) ≤
      (2 : ℝ) ^ (d * ∑ h, r h) := by
    exact_mod_cast compositionArray_card_le_two_pow (d := d) r
  have hh := Real.log_le_log hN hbound
  simpa only [Real.log_pow, Nat.cast_mul, Nat.cast_sum] using hh

def balanced_auxiliary_log_bound {m d : ℕ} (r : Fin m → ℕ) (hd : 0 < d)
    (P : MvPolynomial (Fin m × Fin d) ℤ) (hP : P ≠ 0)
    (C : ℝ) (hC : 1 ≤ C)
    (hbound : polynomialCoeffL1 P ≤
      (Fintype.card (CompositionArray m d r) : ℝ) ^ 2 * C ^ (∑ h, r h)) :
    Real.log (polynomialCoeffL1 P) ≤
      (2 * (d : ℝ) * Real.log 2 + Real.log C) * (∑ h, (r h : ℝ)) := by
  have hN : (0 : ℝ) < Fintype.card (CompositionArray m d r) := by
    exact_mod_cast compositionArray_card_pos r hd
  have hC0 : 0 < C := lt_of_lt_of_le zero_lt_one hC
  have hlogN := compositionArray_log_card_le r hd
  calc
    _ ≤ Real.log ((Fintype.card (CompositionArray m d r) : ℝ) ^ 2 * C ^ (∑ h, r h)) :=
      Real.log_le_log (polynomialCoeffL1_pos hP) hbound
    _ = 2 * Real.log (Fintype.card (CompositionArray m d r)) +
        (∑ h, (r h : ℝ)) * Real.log C := by
      rw [Real.log_mul (pow_ne_zero _ (ne_of_gt hN)) (pow_ne_zero _ (ne_of_gt hC0)),
        Real.log_pow, Real.log_pow]
      norm_num [Nat.cast_sum]
    _ ≤ _ := by nlinarith

def exists_balanced_integer_auxiliary_log_bound {m d s : ℕ}
    (r : Fin m → ℕ) (hm : 0 < m) (hd : 0 < d) (hr : ∀ h, 0 < r h)
    (η : ℝ) (hη : 0 ≤ η) (hlarge : 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2)
    (A : Fin s → Fin m → Fin d → Fin d → ℤ)
    (C : ℝ) (hC : 1 ≤ C) (hA : ∀ v h i, ∑ j, ‖A v h i j‖ ≤ C) :
    ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧
      ProductBlockHomogeneous r P ∧
      Real.log (polynomialCoeffL1 P) ≤
        (2 * (d : ℝ) * Real.log 2 + Real.log C) * (∑ h, (r h : ℝ)) ∧
      ∀ v e, MvPolynomial.coeff e (blockLinearSubstitution (A v) P) ≠ 0 →
        (∀ h, ∑ i, e (h, i) = r h) ∧
        ∀ i : Fin d, |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < (m : ℝ) * η := by
  obtain ⟨P, hP, hhom, hnorm, hbalance⟩ :=
    exists_balanced_integer_auxiliary r hm hd hr η hη hlarge A C hC hA
  exact ⟨P, hP, hhom, balanced_auxiliary_log_bound r hd P hP C hC hnorm, hbalance⟩


end
end Bounty

end SubmissionComponent_BalancedAuxiliaryHeight

/- Component RationalBalancedAuxiliary; SHA256 a2a9d196f4a912803c47e3a8ca6b684b434403b22380573724f497d074424dbe -/
section SubmissionComponent_RationalBalancedAuxiliary
/- Common-denominator transfer of the actual balanced integer auxiliary
polynomial to fixed rational changes of coordinates inside blocks. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rationalBlockLinearForm {m d : ℕ} (B : Fin m → Fin d → Fin d → ℚ)
    (x : Fin m × Fin d) : MvPolynomial (Fin m × Fin d) ℚ :=
  ∑ j, MvPolynomial.C (B x.1 x.2 j) * MvPolynomial.X (x.1, j)

def rationalBlockLinearSubstitution {m d : ℕ} (B : Fin m → Fin d → Fin d → ℚ) :
    MvPolynomial (Fin m × Fin d) ℚ →ₐ[ℚ] MvPolynomial (Fin m × Fin d) ℚ :=
  MvPolynomial.aeval (rationalBlockLinearForm B)

def integer_map_aeval {I : Type*} (g : I → MvPolynomial I ℤ)
    (P : MvPolynomial I ℤ) :
    MvPolynomial.map (Int.castRingHom ℚ) (MvPolynomial.aeval g P) =
      MvPolynomial.aeval (fun i => MvPolynomial.map (Int.castRingHom ℚ) (g i))
        (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp only [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
      MvPolynomial.map_C, Int.coe_castRingHom]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP => simp only [map_mul, MvPolynomial.aeval_X, MvPolynomial.map_X, hP]

def aeval_scaled_of_fixed_total {I : Type*} [Fintype I]
    (P : MvPolynomial I ℚ) (R : ℕ)
    (hP : ∀ e ∈ P.support, ∑ i, e i = R)
    (g : I → MvPolynomial I ℚ) (c : ℚ) :
    MvPolynomial.aeval (fun i => MvPolynomial.C c * g i) P =
      MvPolynomial.C (c ^ R) * MvPolynomial.aeval g P := by
  classical
  conv_lhs => rw [MvPolynomial.as_sum P]
  conv_rhs => rw [MvPolynomial.as_sum P]
  simp only [map_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e he
  rw [MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial]
  simp only [MvPolynomial.algebraMap_eq]
  rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
    Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  simp_rw [mul_pow]
  rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hP e he, ← map_pow]
  ring

def productBlockHomogeneous_integer_map_total {m d : ℕ} (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℤ) (hP : ProductBlockHomogeneous r P)
    (e : (Fin m × Fin d) →₀ ℕ)
    (he : e ∈ (MvPolynomial.map (Int.castRingHom ℚ) P).support) :
    ∑ x : Fin m × Fin d, e x = ∑ h, r h := by
  have hc : MvPolynomial.coeff e P ≠ 0 := by
    intro hz
    have hh := MvPolynomial.mem_support_iff.mp he
    simp [MvPolynomial.coeff_map, hz] at hh
  rw [Fintype.sum_prod_type]
  exact Finset.sum_congr rfl (fun h _ => hP e (MvPolynomial.mem_support_iff.mpr hc) h)

def map_blockLinearForm_scaled {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℤ) (B : Fin m → Fin d → Fin d → ℚ)
    (D : ℤ) (hAB : ∀ h i j, (A h i j : ℚ) = (D : ℚ) * B h i j)
    (x : Fin m × Fin d) :
    MvPolynomial.map (Int.castRingHom ℚ) (blockLinearForm A x) =
      MvPolynomial.C (D : ℚ) * rationalBlockLinearForm B x := by
  simp only [blockLinearForm, rationalBlockLinearForm, map_sum, map_mul,
    MvPolynomial.map_C, MvPolynomial.map_X, Int.coe_castRingHom, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [hAB, map_mul, mul_assoc]

def rationalBlockLinearSubstitution_scale_identity {m d : ℕ}
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) ℤ)
    (hP : ProductBlockHomogeneous r P)
    (A : Fin m → Fin d → Fin d → ℤ) (B : Fin m → Fin d → Fin d → ℚ)
    (D : ℤ) (hAB : ∀ h i j, (A h i j : ℚ) = (D : ℚ) * B h i j) :
    MvPolynomial.map (Int.castRingHom ℚ) (blockLinearSubstitution A P) =
      MvPolynomial.C ((D : ℚ) ^ (∑ h, r h)) *
        rationalBlockLinearSubstitution B (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  rw [blockLinearSubstitution, integer_map_aeval]
  simp_rw [map_blockLinearForm_scaled A B D hAB]
  exact aeval_scaled_of_fixed_total _ _ (productBlockHomogeneous_integer_map_total r P hP)
    (rationalBlockLinearForm B) (D : ℚ)

def rationalBlockLinearSubstitution_coeff_ne_zero {m d : ℕ}
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) ℤ)
    (hP : ProductBlockHomogeneous r P)
    (A : Fin m → Fin d → Fin d → ℤ) (B : Fin m → Fin d → Fin d → ℚ)
    (D : ℤ) (hD : D ≠ 0) (hAB : ∀ h i j, (A h i j : ℚ) = (D : ℚ) * B h i j)
    (e : (Fin m × Fin d) →₀ ℕ)
    (he : MvPolynomial.coeff e
      (rationalBlockLinearSubstitution B (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0) :
    MvPolynomial.coeff e (blockLinearSubstitution A P) ≠ 0 := by
  have hh := congrArg (MvPolynomial.coeff e)
    (rationalBlockLinearSubstitution_scale_identity r P hP A B D hAB)
  rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C_mul] at hh
  have hDq : (D : ℚ) ≠ 0 := by exact_mod_cast hD
  intro hz
  simp only [hz, map_zero] at hh
  exact (mul_ne_zero (pow_ne_zero _ hDq) he) hh.symm

def exists_integer_scaled_block_matrices {m d s : ℕ}
    (B : Fin s → Fin m → Fin d → Fin d → ℚ) :
    ∃ D : ℤ, 0 < D ∧ ∃ A : Fin s → Fin m → Fin d → Fin d → ℤ,
      ∀ v h i j, (A v h i j : ℚ) = (D : ℚ) * B v h i j := by
  obtain ⟨D, hD⟩ := IsLocalization.exist_integer_multiples_of_finite (Submonoid.pos ℤ)
    (fun z : Fin s × Fin m × Fin d × Fin d => B z.1 z.2.1 z.2.2.1 z.2.2.2)
  choose A hA using hD
  refine ⟨D.val, D.property, fun v h i j => A (v, h, i, j), ?_⟩
  intro v h i j
  simpa [Algebra.smul_def] using hA (v, h, i, j)

def exists_integer_block_matrix_norm_bound {m d s : ℕ}
    (A : Fin s → Fin m → Fin d → Fin d → ℤ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ v h i, ∑ j, ‖A v h i j‖ ≤ C := by
  let T : ℝ := ∑ v, ∑ h, ∑ i, ∑ j, ‖A v h i j‖
  have hT : 0 ≤ T := by dsimp [T]; positivity
  refine ⟨1 + T, by linarith, ?_⟩
  intro v h i
  have hi : (∑ j, ‖A v h i j‖) ≤ ∑ k, ∑ j, ‖A v h k j‖ :=
    Finset.single_le_sum (f := fun k : Fin d => ∑ j, ‖A v h k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ i)
  have hh : (∑ k, ∑ j, ‖A v h k j‖) ≤ ∑ t, ∑ k, ∑ j, ‖A v t k j‖ :=
    Finset.single_le_sum (f := fun t : Fin m => ∑ k, ∑ j, ‖A v t k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ h)
  have hv : (∑ t, ∑ k, ∑ j, ‖A v t k j‖) ≤ T :=
    Finset.single_le_sum (f := fun w : Fin s => ∑ t, ∑ k, ∑ j, ‖A w t k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ v)
  linarith [hi.trans (hh.trans hv)]

/-- The height constant is chosen from the fixed rational matrices before the
positive degree tuple and the balance tolerance.  Invertibility is not needed
for construction, so in particular the theorem applies to invertible matrices. -/
def exists_rational_balanced_auxiliary_constant {m d s : ℕ}
    (hm : 0 < m) (hd : 0 < d)
    (B : Fin s → Fin m → Fin d → Fin d → ℚ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (r : Fin m → ℕ), (∀ h, 0 < r h) →
      ∀ η : ℝ, 0 ≤ η → 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2 →
      ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧
        ProductBlockHomogeneous r P ∧
        Real.log (polynomialCoeffL1 P) ≤ K * (∑ h, (r h : ℝ)) ∧
        ∀ v e, MvPolynomial.coeff e
          (rationalBlockLinearSubstitution (B v) (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0 →
          (∀ h, ∑ i, e (h, i) = r h) ∧
          ∀ i : Fin d,
            |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < (m : ℝ) * η := by
  obtain ⟨D, hD, A, hAB⟩ := exists_integer_scaled_block_matrices B
  obtain ⟨C, hC, hA⟩ := exists_integer_block_matrix_norm_bound A
  refine ⟨2 * (d : ℝ) * Real.log 2 + Real.log C, ?_, ?_⟩
  · exact add_nonneg (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
      (Real.log_nonneg hC)
  · intro r hr η hη hlarge
    obtain ⟨P, hP, hhom, hnorm, hbalance⟩ :=
      exists_balanced_integer_auxiliary_log_bound r hm hd hr η hη hlarge A C hC hA
    refine ⟨P, hP, hhom, hnorm, ?_⟩
    intro v e he
    exact hbalance v e (rationalBlockLinearSubstitution_coeff_ne_zero r P hhom
      (A v) (B v) D (ne_of_gt hD) (hAB v) e he)


end
end Bounty

end SubmissionComponent_RationalBalancedAuxiliary

/- Component BalancedDerivativeSupport; SHA256 9b55965576a0bdab1f309355e0c9cd93c35b356c1083fa5013d7d41306f36468 -/
section SubmissionComponent_BalancedDerivativeSupport
/- Actual chain-rule support origins and preservation of balanced columns
under a small divided derivative in the original coordinates. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def pderiv_aeval_eq_sum_pderiv {I J : Type*} [Fintype I]
    (g : I → MvPolynomial J ℚ) (P : MvPolynomial I ℚ) (j : J) :
    MvPolynomial.pderiv j (MvPolynomial.aeval g P) =
      ∑ i, MvPolynomial.pderiv j (g i) * MvPolynomial.aeval g (MvPolynomial.pderiv i P) := by
  classical
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ, mul_add, Finset.sum_add_distrib]
  | mul_X P a hP =>
    simp only [map_mul, MvPolynomial.aeval_X, MvPolynomial.pderiv_mul, map_add,
      MvPolynomial.pderiv_X, Pi.single_apply, hP, mul_add, Finset.sum_add_distrib]
    have hfirst :
        ∑ i, MvPolynomial.pderiv j (g i) * (MvPolynomial.aeval g (MvPolynomial.pderiv i P) * g a) =
        (∑ i, MvPolynomial.pderiv j (g i) * MvPolynomial.aeval g (MvPolynomial.pderiv i P)) * g a := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl (fun _ _ => by ring)
    rw [hfirst]
    congr 1
    simp [mul_comm]

def rationalBlockLinearSubstitution_C {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (a : ℚ) :
    rationalBlockLinearSubstitution A (MvPolynomial.C a) = MvPolynomial.C a := by
  simp [rationalBlockLinearSubstitution]

def rationalBlockLinearSubstitution_X {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (x : Fin m × Fin d) :
    rationalBlockLinearSubstitution A (MvPolynomial.X x) = rationalBlockLinearForm A x := by
  simp [rationalBlockLinearSubstitution]

def pderiv_rationalBlockLinearForm {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (h a : Fin m) (j i : Fin d) :
    MvPolynomial.pderiv (h, j) (rationalBlockLinearForm A (a, i)) =
      if a = h then MvPolynomial.C (A a i j) else 0 := by
  classical
  unfold rationalBlockLinearForm
  simp only [map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_apply]
  by_cases hah : a = h
  · subst a
    simp only [Prod.mk.injEq, true_and]
    simp
  · simp [Prod.mk.injEq, hah]

def pderiv_rationalBlockLinearSubstitution {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (P : MvPolynomial (Fin m × Fin d) ℚ)
    (h : Fin m) (j : Fin d) :
    MvPolynomial.pderiv (h, j) (rationalBlockLinearSubstitution A P) =
      ∑ i, MvPolynomial.C (A h i j) * rationalBlockLinearSubstitution A (MvPolynomial.pderiv (h, i) P) := by
  change MvPolynomial.pderiv (h, j) (MvPolynomial.aeval (rationalBlockLinearForm A) P) =
    ∑ i, MvPolynomial.C (A h i j) * MvPolynomial.aeval (rationalBlockLinearForm A) (MvPolynomial.pderiv (h, i) P)
  rw [pderiv_aeval_eq_sum_pderiv, Fintype.sum_prod_type]
  simp only [pderiv_rationalBlockLinearForm, ite_mul, zero_mul]
  simp
  
def rationalBlockLinearSubstitution_linearForm {m d : ℕ}
    (A B : Fin m → Matrix (Fin d) (Fin d) ℚ) (x : Fin m × Fin d) :
    rationalBlockLinearSubstitution A (rationalBlockLinearForm B x) =
      rationalBlockLinearForm (fun h => B h * A h) x := by
  simp only [rationalBlockLinearForm, map_sum, map_mul, rationalBlockLinearSubstitution_C,
    rationalBlockLinearSubstitution_X, Matrix.mul_apply, Finset.mul_sum, map_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  exact (mul_assoc _ _ _).symm

def rationalBlockLinearSubstitution_comp {m d : ℕ}
    (A B : Fin m → Matrix (Fin d) (Fin d) ℚ) (P : MvPolynomial (Fin m × Fin d) ℚ) :
    rationalBlockLinearSubstitution A (rationalBlockLinearSubstitution B P) =
      rationalBlockLinearSubstitution (fun h => B h * A h) P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [map_mul, rationalBlockLinearSubstitution_X, rationalBlockLinearSubstitution_linearForm, hP]

def rationalBlockLinearSubstitution_one {m d : ℕ}
    (P : MvPolynomial (Fin m × Fin d) ℚ) :
    rationalBlockLinearSubstitution (fun _ => (1 : Matrix (Fin d) (Fin d) ℚ)) P = P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P x hP =>
    simp [map_mul, rationalBlockLinearSubstitution_X, rationalBlockLinearForm, Matrix.one_apply, hP]

/-- The inverse chain rule is derived from the actual invertible block matrices. -/
def rationalBlockLinearSubstitution_pderiv {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (h : Fin m) (i : Fin d) :
    rationalBlockLinearSubstitution A (MvPolynomial.pderiv (h, i) P) =
      ∑ j, MvPolynomial.C ((A h)⁻¹ j i) *
        MvPolynomial.pderiv (h, j) (rationalBlockLinearSubstitution A P) := by
  let Ainv : Fin m → Matrix (Fin d) (Fin d) ℚ := fun h => (A h)⁻¹
  change rationalBlockLinearSubstitution A (MvPolynomial.pderiv (h, i) P) =
    ∑ j, MvPolynomial.C (Ainv h j i) * MvPolynomial.pderiv (h, j) (rationalBlockLinearSubstitution A P)
  have hleft (Q : MvPolynomial (Fin m × Fin d) ℚ) :
      rationalBlockLinearSubstitution Ainv (rationalBlockLinearSubstitution A Q) = Q := by
    rw [rationalBlockLinearSubstitution_comp]
    have hh : (fun h => A h * Ainv h) = fun _ => (1 : Matrix (Fin d) (Fin d) ℚ) := by
      funext h
      exact Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (hA h))
    exact (congrArg (fun T : Fin m → Matrix (Fin d) (Fin d) ℚ =>
      rationalBlockLinearSubstitution T Q) hh).trans (rationalBlockLinearSubstitution_one Q)
  have hright (Q : MvPolynomial (Fin m × Fin d) ℚ) :
      rationalBlockLinearSubstitution A (rationalBlockLinearSubstitution Ainv Q) = Q := by
    rw [rationalBlockLinearSubstitution_comp]
    have hh : (fun h => Ainv h * A h) = fun _ => (1 : Matrix (Fin d) (Fin d) ℚ) := by
      funext h
      exact Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr (hA h))
    exact (congrArg (fun T : Fin m → Matrix (Fin d) (Fin d) ℚ =>
      rationalBlockLinearSubstitution T Q) hh).trans (rationalBlockLinearSubstitution_one Q)
  have hh := pderiv_rationalBlockLinearSubstitution Ainv
    (rationalBlockLinearSubstitution A P) h i
  rw [hleft] at hh
  have hh' := congrArg (rationalBlockLinearSubstitution A) hh
  simpa only [map_sum, map_mul, rationalBlockLinearSubstitution_C, hright] using hh'

/-- The number of differentiations made in a particular block. -/
def derivativeBlockCount {m d : ℕ} (s : List (Fin m × Fin d)) (h : Fin m) : ℕ :=
  ∑ i, wordDerivativeCounts s (h, i)

def derivativeBlockCount_nil {m d : ℕ} (h : Fin m) :
    derivativeBlockCount ([] : List (Fin m × Fin d)) h = 0 := by
  simp [derivativeBlockCount, wordDerivativeCounts_nil]

def sum_block_single {m d : ℕ} (x : Fin m × Fin d) (h : Fin m) :
    ∑ i : Fin d, (Finsupp.single x 1 : (Fin m × Fin d) →₀ ℕ) (h, i) =
      if x.1 = h then 1 else 0 := by
  classical
  rcases x with ⟨a, j⟩
  by_cases hah : a = h
  · subst a
    simp [Finsupp.single_apply, Prod.mk.injEq]
  · simp [Prod.mk.injEq, hah]

def derivativeBlockCount_cons {m d : ℕ} (x : Fin m × Fin d)
    (s : List (Fin m × Fin d)) (h : Fin m) :
    derivativeBlockCount (x :: s) h =
      (if x.1 = h then 1 else 0) + derivativeBlockCount s h := by
  simp only [derivativeBlockCount, wordDerivativeCounts_cons, Finsupp.add_apply,
    Finset.sum_add_distrib, sum_block_single]

/-- Invertible block substitutions can redistribute the derivative counts within
a block, but every surviving monomial comes from an original monomial with
exactly the prescribed total loss in each block. -/
def rationalBlockLinearSubstitution_wordPDeriv_support_origin {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0)
    (s : List (Fin m × Fin d)) (P : MvPolynomial (Fin m × Fin d) ℚ)
    (e : (Fin m × Fin d) →₀ ℕ)
    (he : MvPolynomial.coeff e (rationalBlockLinearSubstitution A (wordPDeriv s P)) ≠ 0) :
    ∃ K : (Fin m × Fin d) →₀ ℕ,
      MvPolynomial.coeff (e + K) (rationalBlockLinearSubstitution A P) ≠ 0 ∧
      ∀ h, ∑ i, K (h, i) = derivativeBlockCount s h := by
  classical
  induction s generalizing e with
  | nil => exact ⟨0, by simpa [wordPDeriv_nil] using he, by simp [derivativeBlockCount_nil]⟩
  | cons x s ih =>
    rw [wordPDeriv_cons, rationalBlockLinearSubstitution_pderiv A hA,
      MvPolynomial.coeff_sum] at he
    obtain ⟨j, _, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero he
    rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_pderiv] at hj
    have hcoeff : MvPolynomial.coeff (e + Finsupp.single (x.1, j) 1)
        (rationalBlockLinearSubstitution A (wordPDeriv s P)) ≠ 0 :=
      left_ne_zero_of_mul (right_ne_zero_of_mul hj)
    obtain ⟨K, hK, hcount⟩ := ih _ hcoeff
    refine ⟨Finsupp.single (x.1, j) 1 + K, ?_, ?_⟩
    · simpa only [add_assoc] using hK
    · intro h
      simp only [Finsupp.add_apply, Finset.sum_add_distrib, sum_block_single,
        hcount, derivativeBlockCount_cons]

def rationalBlockLinearSubstitution_dividedWordPDeriv_support_origin {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0)
    (s : List (Fin m × Fin d)) (P : MvPolynomial (Fin m × Fin d) ℚ)
    (e : (Fin m × Fin d) →₀ ℕ)
    (he : MvPolynomial.coeff e
      (rationalBlockLinearSubstitution A (dividedWordPDeriv s P)) ≠ 0) :
    ∃ K : (Fin m × Fin d) →₀ ℕ,
      MvPolynomial.coeff (e + K) (rationalBlockLinearSubstitution A P) ≠ 0 ∧
      ∀ h, ∑ i, K (h, i) = derivativeBlockCount s h := by
  change MvPolynomial.coeff e (rationalBlockLinearSubstitution A
    ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P)) ≠ 0 at he
  rw [map_smul, MvPolynomial.coeff_smul, smul_eq_mul] at he
  exact rationalBlockLinearSubstitution_wordPDeriv_support_origin A hA s P e
    (right_ne_zero_of_mul he)

/-- The total normalized number of derivatives, summed over the blocks. -/
def blockDerivativeWeight {m d : ℕ} (r : Fin m → ℕ)
    (s : List (Fin m × Fin d)) : ℝ :=
  ∑ h, (derivativeBlockCount s h : ℝ) / r h

def derivativeBlockCount_map_pivot {m d : ℕ}
    (p : Fin m → Fin d) (s : List (Fin m)) (h : Fin m) :
    derivativeBlockCount (s.map (fun a => (a, p a))) h = s.count h := by
  induction s with
  | nil => simp [derivativeBlockCount_nil]
  | cons a s ih =>
    by_cases ha : a = h
    · subst a
      simp [derivativeBlockCount_cons, ih, add_comm]
    · simp [derivativeBlockCount_cons, ih, ha]

def blockDerivativeWeight_map_pivot {m d : ℕ}
    (r : Fin m → ℕ) (p : Fin m → Fin d) (s : List (Fin m)) :
    blockDerivativeWeight r (s.map (fun h => (h, p h))) =
      ∑ h, (s.count h : ℝ) / r h := by
  simp [blockDerivativeWeight, derivativeBlockCount_map_pivot]

def blockDerivativeWeight_column_bound {m d : ℕ} (r : Fin m → ℕ)
    (s : List (Fin m × Fin d)) (K : (Fin m × Fin d) →₀ ℕ)
    (hK : ∀ h, ∑ i, K (h, i) = derivativeBlockCount s h) (i : Fin d) :
    (∑ h, (K (h, i) : ℝ) / r h) ≤ blockDerivativeWeight r s := by
  apply Finset.sum_le_sum
  intro h _
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact_mod_cast (show K (h, i) ≤ derivativeBlockCount s h from
    (Finset.single_le_sum (fun j _ => Nat.zero_le (K (h, j))) (Finset.mem_univ i)).trans_eq (hK h))

/-- A divided derivative with total normalized block count at most `m * η`
preserves strict column balance with tolerance enlarged from `m * η` to
`2 * m * η`.  This is proved from the actual inverse chain rule. -/
def rationalBlockLinearSubstitution_dividedWordPDeriv_balanced {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0)
    (r : Fin m → ℕ) (η : ℝ) (s : List (Fin m × Fin d))
    (P : MvPolynomial (Fin m × Fin d) ℚ)
    (hbalanced : ∀ e, MvPolynomial.coeff e (rationalBlockLinearSubstitution A P) ≠ 0 →
      ∀ i, |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < (m : ℝ) * η)
    (hsmall : blockDerivativeWeight r s ≤ (m : ℝ) * η) :
    ∀ e, MvPolynomial.coeff e
      (rationalBlockLinearSubstitution A (dividedWordPDeriv s P)) ≠ 0 →
      ∀ i, |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| < 2 * (m : ℝ) * η := by
  intro e he i
  obtain ⟨K, hK, hcount⟩ :=
    rationalBlockLinearSubstitution_dividedWordPDeriv_support_origin A hA s P e he
  have hbound := hbalanced (e + K) hK i
  have hcolumn := (blockDerivativeWeight_column_bound r s K hcount i).trans hsmall
  have hnonneg : 0 ≤ ∑ h, (K (h, i) : ℝ) / r h :=
    Finset.sum_nonneg (fun h _ => div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
  have heq : (∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d =
      ((∑ h, ((e + K) (h, i) : ℝ) / r h) - (m : ℝ) / d) -
        (∑ h, (K (h, i) : ℝ) / r h) := by
    simp only [Finsupp.add_apply, Nat.cast_add, add_div, Finset.sum_add_distrib]
    ring
  rw [heq]
  calc
    _ ≤ |(∑ h, ((e + K) (h, i) : ℝ) / r h) - (m : ℝ) / d| +
        |∑ h, (K (h, i) : ℝ) / r h| := abs_sub _ _
    _ < 2 * (m : ℝ) * η := by rw [abs_of_nonneg hnonneg]; linarith

/-- Block degrees drop by exactly the number of derivatives in that block,
even after an invertible change of coordinates within every block. -/
def rationalBlockLinearSubstitution_dividedWordPDeriv_block_degrees {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0)
    (r : Fin m → ℕ) (s : List (Fin m × Fin d))
    (P : MvPolynomial (Fin m × Fin d) ℚ)
    (hhom : ∀ e, MvPolynomial.coeff e (rationalBlockLinearSubstitution A P) ≠ 0 →
      ∀ h, ∑ i, e (h, i) = r h)
    (e : (Fin m × Fin d) →₀ ℕ)
    (he : MvPolynomial.coeff e
      (rationalBlockLinearSubstitution A (dividedWordPDeriv s P)) ≠ 0) :
    ∀ h, (∑ i, e (h, i)) + derivativeBlockCount s h = r h := by
  obtain ⟨K, hK, hcount⟩ :=
    rationalBlockLinearSubstitution_dividedWordPDeriv_support_origin A hA s P e he
  intro h
  simpa only [Finsupp.add_apply, Finset.sum_add_distrib, hcount] using hhom (e + K) hK h


end
end Bounty

end SubmissionComponent_BalancedDerivativeSupport

/- Component ProductHyperplaneNonvanishing; SHA256 54ef0fc14e019411677fd9f88ac9eaa976933a20be9c0d78739264695ca4748e -/
section SubmissionComponent_ProductHyperplaneNonvanishing
/- Small coordinate derivatives nonzero at actual points on rational hyperplanes. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def eval_complementRestriction {B C : Type*} (g : B → MvPolynomial C ℚ)
    (P : MvPolynomial (B ⊕ C) ℚ) (z : C → ℚ) :
    MvPolynomial.eval z (complementRestriction g P) =
      MvPolynomial.eval (Sum.elim (fun b => MvPolynomial.eval z (g b)) z) P := by
  rw [complementRestriction_eq_aeval]
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    cases i <;> simp only [map_mul, MvPolynomial.aeval_X, Sum.elim_inl,
      Sum.elim_inr, MvPolynomial.eval_X, hP]

def productHyperplanePoint {m d : ℕ} (b : Fin m → Fin (d + 1) → ℚ)
    (p : Fin m → Fin (d + 1)) (z : HyperplaneComplement p → ℚ) :
    Fin m × Fin (d + 1) → ℚ :=
  (Sum.elim (fun h => MvPolynomial.eval z
    (blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
      (pivotComplementCoefficient b p) h)) z) ∘ hyperplanePivotEquiv p

def eval_complementRestriction_pivotRename {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (z : HyperplaneComplement p → ℚ) (P : MvPolynomial (Fin m × Fin (d + 1)) ℚ) :
    MvPolynomial.eval z
      (complementRestriction (blockComplementLinear
        (fun x : HyperplaneComplement p => x.val.1) (pivotComplementCoefficient b p))
        (MvPolynomial.rename (hyperplanePivotEquiv p) P)) =
      MvPolynomial.eval (productHyperplanePoint b p z) P := by
  rw [eval_complementRestriction, MvPolynomial.eval_rename]
  rfl

def productHyperplanePoint_mem {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (z : HyperplaneComplement p → ℚ) (h : Fin m) :
    ∑ k, b h k * productHyperplanePoint b p z (h, k) = 0 := by
  have hc := congrArg (MvPolynomial.eval z)
    (complementRestriction_productHyperplaneLinearForm b p h (hp h))
  rw [eval_complementRestriction_pivotRename] at hc
  simpa only [productHyperplaneLinearForm, map_sum, map_mul, MvPolynomial.eval_C,
    MvPolynomial.eval_X, map_zero] using hc

def exists_nonzero_eval_on_product_hyperplanes {m d : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (P : MvPolynomial (Fin m × Fin (d + 1)) ℚ)
    (hP : complementRestriction (blockComplementLinear
      (fun x : HyperplaneComplement p => x.val.1) (pivotComplementCoefficient b p))
      (MvPolynomial.rename (hyperplanePivotEquiv p) P) ≠ 0) :
    ∃ x : Fin m × Fin (d + 1) → ℚ,
      (∀ h, ∑ k, b h k * x (h, k) = 0) ∧ MvPolynomial.eval x P ≠ 0 := by
  classical
  have hex : ∃ z : HyperplaneComplement p → ℚ,
      MvPolynomial.eval z (complementRestriction (blockComplementLinear
        (fun x : HyperplaneComplement p => x.val.1) (pivotComplementCoefficient b p))
        (MvPolynomial.rename (hyperplanePivotEquiv p) P)) ≠ 0 := by
    by_contra! hn
    apply hP
    apply MvPolynomial.funext
    intro z
    simpa only [map_zero] using hn z
  obtain ⟨z, hz⟩ := hex
  refine ⟨productHyperplanePoint b p z, productHyperplanePoint_mem b p hp z, ?_⟩
  rwa [eval_complementRestriction_pivotRename] at hz

def exists_product_hyperplane_derivative {n d : ℕ} (hd : 1 ≤ d)
    (b : Fin (n + 1) → Fin (d + 1) → ℚ) (p : Fin (n + 1) → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (r : Fin (n + 1) → ℕ) (hr : ∀ h, 0 < r h)
    (P : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ h, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d))) :
    ∃ s : List (Fin (n + 1) × Fin (d + 1)),
      blockDerivativeWeight r s ≤ 2 * (n + 1 : ℕ) * η ∧
      complementRestriction (blockComplementLinear
        (fun x : HyperplaneComplement p => x.val.1) (pivotComplementCoefficient b p))
        (MvPolynomial.rename (hyperplanePivotEquiv p)
          (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P))) ≠ 0 ∧
      ∃ x : Fin (n + 1) × Fin (d + 1) → ℚ,
        (∀ h, ∑ k, b h k * x (h, k) = 0) ∧
        MvPolynomial.eval x (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0 := by
  classical
  let Q := MvPolynomial.map (Int.castRingHom ℚ) P
  let g := blockComplementLinear (fun x : HyperplaneComplement p => x.val.1)
    (pivotComplementCoefficient b p)
  have hQ : MvPolynomial.rename (hyperplanePivotEquiv p) Q ≠ 0 := by
    exact fun hz => integerMap_ne_zero hP
      ((MvPolynomial.rename_eq_zero_iff_of_injective Q (hyperplanePivotEquiv p).injective).mp hz)
  obtain ⟨t, ht, hw⟩ := exists_normalized_pivot_derivative_restriction r hr g
    (MvPolynomial.rename (hyperplanePivotEquiv p) Q) hQ
  let s := t.map (fun h => (h, p h))
  have hmap : s.map (hyperplanePivotEquiv p) = t.map Sum.inl := by
    simp only [s, List.map_map]
    congr 1
    funext h
    exact hyperplanePivotEquiv_pivot p h
  have hderiv := dividedWordPDeriv_rename_equiv (hyperplanePivotEquiv p) s Q
  rw [hmap] at hderiv
  rw [hderiv] at ht
  refine ⟨s, ?_, ht, ?_⟩
  · rw [show blockDerivativeWeight r s = ∑ h, (t.count h : ℝ) / r h from
      blockDerivativeWeight_map_pivot r p t, hw]
    exact integer_product_hyperplane_roth_bound hd b p hp r hr P hP hhom
      η hη hηhalf hstep hheight
  · exact exists_nonzero_eval_on_product_hyperplanes b p hp _ ht


end
end Bounty

end SubmissionComponent_ProductHyperplaneNonvanishing

/- Component SpanningPolynomialNonvanishing; SHA256 48a2ff4315f7697eb2482ff61cc017765c1fc4c6fea9ce5960703d73a091894f -/
section SubmissionComponent_SpanningPolynomialNonvanishing
/- Polynomial nonvanishing is preserved by parametrizing an actual spanning family. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def eval_rational_aeval {I J : Type*} (f : I → MvPolynomial J ℚ)
    (P : MvPolynomial I ℚ) (z : J → ℚ) :
    MvPolynomial.eval z (MvPolynomial.aeval f P) =
      MvPolynomial.eval (fun i => MvPolynomial.eval z (f i)) P := by
  simpa only [MvPolynomial.aeval_eq_eval] using
    MvPolynomial.comp_aeval_apply (f := f) (MvPolynomial.aeval z) P

def blockSpanningSubstitution {m d k : ℕ} (y : Fin m → Fin k → Fin d → ℚ) :
    MvPolynomial (Fin m × Fin d) ℚ →ₐ[ℚ] MvPolynomial (Fin m × Fin k) ℚ :=
  MvPolynomial.aeval (fun x => ∑ j, MvPolynomial.C (y x.1 j x.2) * MvPolynomial.X (x.1, j))

def block_spanning_polynomial_ne_zero {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (x : Fin m × Fin d → ℚ)
    (hx : ∀ h, (fun i => x (h, i)) ∈ Submodule.span ℚ (Set.range (y h)))
    (P : MvPolynomial (Fin m × Fin d) ℚ) (hP : MvPolynomial.eval x P ≠ 0) :
    blockSpanningSubstitution y P ≠ 0 := by
  classical
  choose c hc using fun h => (Submodule.mem_span_range_iff_exists_fun ℚ).mp (hx h)
  let z (a : Fin m × Fin k) : ℚ := c a.1 a.2
  have he (a : Fin m × Fin d) :
      MvPolynomial.eval z (∑ j, MvPolynomial.C (y a.1 j a.2) * MvPolynomial.X (a.1, j)) = x a := by
    have hh := congrFun (hc a.1) a.2
    simpa only [map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, z, mul_comm] using hh
  intro hz
  have hh := congrArg (MvPolynomial.eval z) hz
  change MvPolynomial.eval z (MvPolynomial.aeval _ P) = _ at hh
  rw [eval_rational_aeval] at hh
  simp only [he, map_zero] at hh
  exact hP hh

def rationalHyperplaneKernel {d : ℕ} (b : Fin d → ℚ) : Submodule ℚ (Fin d → ℚ) :=
  LinearMap.ker (∑ i, b i • (LinearMap.proj i : (Fin d → ℚ) →ₗ[ℚ] ℚ))

def mem_rationalHyperplaneKernel {d : ℕ} (b x : Fin d → ℚ) :
    x ∈ rationalHyperplaneKernel b ↔ ∑ i, b i * x i = 0 := by
  simp [rationalHyperplaneKernel, LinearMap.mem_ker]

def hyperplane_spanning_substitution_ne_zero {m d k : ℕ}
    (b : Fin m → Fin (d + 1) → ℚ) (p : Fin m → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (y : Fin m → Fin k → Fin (d + 1) → ℚ)
    (hy : ∀ h, Submodule.span ℚ (Set.range (y h)) = rationalHyperplaneKernel (b h))
    (P : MvPolynomial (Fin m × Fin (d + 1)) ℚ)
    (hP : complementRestriction (blockComplementLinear
      (fun x : HyperplaneComplement p => x.val.1) (pivotComplementCoefficient b p))
      (MvPolynomial.rename (hyperplanePivotEquiv p) P) ≠ 0) :
    blockSpanningSubstitution y P ≠ 0 := by
  obtain ⟨x, hx, hne⟩ := exists_nonzero_eval_on_product_hyperplanes b p hp P hP
  apply block_spanning_polynomial_ne_zero y x _ P hne
  intro h
  rw [hy h, mem_rationalHyperplaneKernel]
  exact hx h

def product_hyperplane_derivative_spanning {n d k : ℕ} (hd : 1 ≤ d)
    (b : Fin (n + 1) → Fin (d + 1) → ℚ) (p : Fin (n + 1) → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (r : Fin (n + 1) → ℕ) (hr : ∀ h, 0 < r h)
    (y : Fin (n + 1) → Fin k → Fin (d + 1) → ℚ)
    (hy : ∀ h, Submodule.span ℚ (Set.range (y h)) = rationalHyperplaneKernel (b h))
    (P : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ h, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d))) :
    ∃ s : List (Fin (n + 1) × Fin (d + 1)),
      blockDerivativeWeight r s ≤ 2 * (n + 1 : ℕ) * η ∧
      blockSpanningSubstitution y (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0 := by
  obtain ⟨s, hs, hrestrict, _⟩ := exists_product_hyperplane_derivative hd b p hp r hr
    P hP hhom η hη hηhalf hstep hheight
  exact ⟨s, hs, hyperplane_spanning_substitution_ne_zero b p hp y hy _ hrestrict⟩


end
end Bounty

end SubmissionComponent_SpanningPolynomialNonvanishing

/- Component HyperplaneLocalArithmetic; SHA256 d73eaae49ae46441b317dadfec0c748cc1320d25ced8723ddd0cf03a280554f5 -/
section SubmissionComponent_HyperplaneLocalArithmetic
/- Integer pairings at three actual places and the rational kernels they
annihilate. These bounds support the finite support-pattern exception step. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def rationalHyperplaneKernel_ne_top {n : ℕ} (b : Fin n → ℚ) (hb : b ≠ 0) :
    rationalHyperplaneKernel b ≠ ⊤ := by
  obtain ⟨i, hi⟩ : ∃ i, b i ≠ 0 := by simpa [funext_iff] using hb
  intro h
  have hx : Pi.single i 1 ∈ rationalHyperplaneKernel b := by rw [h]; trivial
  apply hi
  simpa [mem_rationalHyperplaneKernel, Pi.single_apply] using hx

def independent_span_eq_hyperplane {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℚ) (hX : LinearIndependent ℚ X.col)
    (b : Fin (n + 1) → ℚ) (hb : b ≠ 0)
    (horth : ∀ j, dotProduct b (X.col j) = 0) :
    Submodule.span ℚ (Set.range X.col) = rationalHyperplaneKernel b := by
  apply Submodule.eq_of_le_of_finrank_le
  · apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact (mem_rationalHyperplaneKernel _ _).mpr (horth j)
  · have hk := Submodule.finrank_lt (rationalHyperplaneKernel_ne_top b hb)
    rw [finrank_span_eq_card hX]
    simpa using Nat.le_of_lt_succ (by simpa using hk)

def cofactorTransform_left_identity {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) :
    A.transpose * cofactorTransform A = A.det • 1 := by
  rw [cofactorTransform, ← Matrix.transpose_mul, Matrix.adjugate_mul,
    Matrix.transpose_smul, Matrix.transpose_one]

def cofactorTransform_mulVec_ne_zero {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (hA : IsUnit A.det)
    (b : Fin (n + 1) → ℚ) (hb : b ≠ 0) :
    (cofactorTransform A).mulVec b ≠ 0 := by
  intro h
  have hh := congrArg A.transpose.mulVec h
  rw [Matrix.mulVec_mulVec, cofactorTransform_left_identity, Matrix.smul_mulVec,
    Matrix.one_mulVec, Matrix.mulVec_zero] at hh
  exact hb ((smul_eq_zero.mp hh).resolve_left hA.ne_zero)

def cofactorTransform_pairing {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (b x : Fin (n + 1) → ℚ) :
    dotProduct ((cofactorTransform A).mulVec b) (A.mulVec x) =
      A.det * dotProduct b x := by
  rw [← Matrix.dotProduct_transpose_mulVec, Matrix.mulVec_mulVec,
    cofactorTransform_left_identity, Matrix.smul_mulVec, Matrix.one_mulVec,
    dotProduct_smul, dotProduct_comm]
  rfl

def cofactorEvaluationConstant {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (z : Fin (n + 1) → ℤ) : ℝ :=
  (∑ i, ‖(cofactorTransform A).mulVec (fun j => (z j : ℚ)) i‖) / ‖A.det‖

def integer_dot_archimedean_bound {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (hA : IsUnit A.det)
    (z x : Fin (n + 1) → ℤ) (c : Fin (n + 1) → ℝ) (t u : ℝ) (ht : 0 ≤ t)
    (hx : ∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c i * t))
    (hc : ∀ i, (cofactorTransform A).mulVec (fun j => (z j : ℚ)) i ≠ 0 → c i ≤ u) :
    |((∑ i, z i * x i : ℤ) : ℝ)| ≤ cofactorEvaluationConstant A z * Real.exp (u * t) := by
  let b : Fin (n + 1) → ℚ := fun i => z i
  let y : Fin (n + 1) → ℚ := fun i => x i
  have hp := congrArg norm (cofactorTransform_pairing A b y)
  have hsum : ‖dotProduct ((cofactorTransform A).mulVec b) (A.mulVec y)‖ ≤
      (∑ i, ‖(cofactorTransform A).mulVec b i‖) * Real.exp (u * t) := by
    calc
      _ ≤ ∑ i, ‖(cofactorTransform A).mulVec b i * A.mulVec y i‖ := norm_sum_le _ _
      _ ≤ ∑ i, ‖(cofactorTransform A).mulVec b i‖ * Real.exp (u * t) := by
        apply Finset.sum_le_sum
        intro i _
        rw [norm_mul]
        by_cases hi : (cofactorTransform A).mulVec b i = 0
        · simp [hi]
        · exact mul_le_mul_of_nonneg_left ((hx i).trans
            (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (hc i hi) ht))) (norm_nonneg _)
      _ = _ := by rw [Finset.sum_mul]
  have hdet : 0 < ‖A.det‖ := norm_pos_iff.mpr hA.ne_zero
  have hcast : ‖dotProduct b y‖ = |((∑ i, z i * x i : ℤ) : ℝ)| := by
    have hh : dotProduct b y = ((∑ i, z i * x i : ℤ) : ℚ) := by simp [b, y, dotProduct]
    rw [hh, Int.norm_cast_rat, Int.norm_eq_abs]
  rw [norm_mul, hcast] at hp
  change _ ≤ ((∑ i, ‖(cofactorTransform A).mulVec b i‖) / ‖A.det‖) * Real.exp (u * t)
  rw [div_mul_eq_mul_div]
  apply (le_div_iff₀ hdet).mpr
  nlinarith [hsum]

def integer_dot_padic_bound {n : ℕ}
    (p : ℕ) [Fact p.Prime] (z x : Fin n → ℤ) (c : Fin n → ℝ)
    (t u : ℝ) (ht : 0 ≤ t)
    (hx : ∀ i, (padicNorm p (x i : ℚ) : ℝ) ≤ Real.exp (c i * t))
    (hc : ∀ i, z i ≠ 0 → c i ≤ u) :
    (padicNorm p ((∑ i, z i * x i : ℤ) : ℚ) : ℝ) ≤ Real.exp (u * t) := by
  simp only [Int.cast_sum, Int.cast_mul]
  apply padicNorm_sum_cast_le _ _ _ _ (Real.exp_nonneg _)
  intro i _
  by_cases hi : z i = 0
  · simp [hi, (Real.exp_pos _).le]
  · rw [padicNorm.mul, Rat.cast_mul]
    have hz : (padicNorm p (z i : ℚ) : ℝ) ≤ 1 := by exact_mod_cast padicNorm.of_int (p := p) (z i)
    have hn : (0 : ℝ) ≤ padicNorm p (x i : ℚ) := by exact_mod_cast padicNorm.nonneg (x i : ℚ)
    exact (mul_le_mul_of_nonneg_right hz hn).trans (by
      simpa using (hx i).trans (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (hc i hi) ht)))

def integer_dot_zero_of_local_product {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (hA : IsUnit A.det)
    (z x : Fin (n + 1) → ℤ) (c : Fin 3 → Fin (n + 1) → ℝ)
    (t : ℝ) (u : Fin 3 → ℝ) (ht : 0 ≤ t)
    (hInf : ∀ i, ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ Real.exp (c 0 i * t))
    (h₂ : ∀ i, (padicNorm 2 (x i : ℚ) : ℝ) ≤ Real.exp (c 1 i * t))
    (h₃ : ∀ i, (padicNorm 3 (x i : ℚ) : ℝ) ≤ Real.exp (c 2 i * t))
    (hcInf : ∀ i, (cofactorTransform A).mulVec (fun j => (z j : ℚ)) i ≠ 0 → c 0 i ≤ u 0)
    (hc₂ : ∀ i, z i ≠ 0 → c 1 i ≤ u 1)
    (hc₃ : ∀ i, z i ≠ 0 → c 2 i ≤ u 2)
    (hsmall : cofactorEvaluationConstant A z * Real.exp ((∑ v, u v) * t) < 1) :
    ∑ i, z i * x i = 0 := by
  by_contra hn
  have hlow := integer_three_place_product_lower _ hn
  have h₀ := integer_dot_archimedean_bound A hA z x (c 0) t (u 0) ht hInf hcInf
  have h₂' := integer_dot_padic_bound 2 z x (c 1) t (u 1) ht h₂ hc₂
  have h₃' := integer_dot_padic_bound 3 z x (c 2) t (u 2) ht h₃ hc₃
  have hp₂ : (0 : ℝ) ≤ padicNorm 2 ((∑ i, z i * x i : ℤ) : ℚ) := by
    exact_mod_cast padicNorm.nonneg ((∑ i, z i * x i : ℤ) : ℚ)
  have hp₃ : (0 : ℝ) ≤ padicNorm 3 ((∑ i, z i * x i : ℤ) : ℚ) := by
    exact_mod_cast padicNorm.nonneg ((∑ i, z i * x i : ℤ) : ℚ)
  have hC : 0 ≤ cofactorEvaluationConstant A z := by unfold cofactorEvaluationConstant; positivity
  have hupper := mul_le_mul (mul_le_mul h₀ h₂' hp₂ (by positivity)) h₃' hp₃ (by positivity)
  have he : cofactorEvaluationConstant A z * Real.exp (u 0 * t) *
      Real.exp (u 1 * t) * Real.exp (u 2 * t) =
        cofactorEvaluationConstant A z * Real.exp ((∑ v, u v) * t) := by
    rw [mul_assoc, mul_assoc, ← Real.exp_add, ← Real.exp_add]
    congr 2
    simp [Fin.sum_univ_succ]
    ring
  rw [he] at hupper
  exact (not_lt_of_ge (hlow.trans hupper)) hsmall


end
end Bounty

end SubmissionComponent_HyperplaneLocalArithmetic

/- Component HyperplaneHeightDichotomy; SHA256 179dad553cbd5fbbb54819a9bdc21f98920523532c4b5543f6e4875387fddac0 -/
section SubmissionComponent_HyperplaneHeightDichotomy
/- A finite support-pattern choice of exceptional rational hyperplanes.
Outside this fixed finite collection the primitive normal has a logarithmic
height bounded below linearly in the profile parameter. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

abbrev HyperplaneSupportPattern (n : ℕ) :=
  Finset (Fin (n + 1)) × Finset (Fin (n + 1))

def RealizesHyperplanePattern {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ)
    (s : HyperplaneSupportPattern n) (a : Fin (n + 1) → ℤ) : Prop :=
  a ≠ 0 ∧
    (∀ i, (cofactorTransform A).mulVec (fun j => (a j : ℚ)) i ≠ 0 → i ∈ s.1) ∧
    (∀ i, a i ≠ 0 → i ∈ s.2)

def selectedPatternNormal {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ)
    (s : HyperplaneSupportPattern n) : Fin (n + 1) → ℤ := by
  classical
  exact if h : ∃ a, RealizesHyperplanePattern A s a then h.choose else Pi.single 0 1

def selectedPatternNormal_realizes {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (s : HyperplaneSupportPattern n)
    (h : ∃ a, RealizesHyperplanePattern A s a) :
    RealizesHyperplanePattern A s (selectedPatternNormal A s) := by
  classical
  rw [selectedPatternNormal, dif_pos h]
  exact h.choose_spec

def exceptionalPatternHyperplanes {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) :
    Finset (Submodule ℚ (Fin (n + 1) → ℚ)) := by
  classical
  exact Finset.univ.image (fun s : HyperplaneSupportPattern n =>
    rationalHyperplaneKernel (fun i => (selectedPatternNormal A s i : ℚ)))

def patternEvaluationBound {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) : ℝ :=
  1 + ∑ s : HyperplaneSupportPattern n, cofactorEvaluationConstant A (selectedPatternNormal A s)

def patternEvaluationBound_ge_one {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) : 1 ≤ patternEvaluationBound A := by
  have hn : 0 ≤ ∑ s : HyperplaneSupportPattern n,
      cofactorEvaluationConstant A (selectedPatternNormal A s) := by
    apply Finset.sum_nonneg
    intro s _
    unfold cofactorEvaluationConstant
    positivity
  unfold patternEvaluationBound
  linarith

def cofactorEvaluationConstant_le_patternBound {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (s : HyperplaneSupportPattern n) :
    cofactorEvaluationConstant A (selectedPatternNormal A s) ≤ patternEvaluationBound A := by
  have hn : ∀ t : HyperplaneSupportPattern n,
      0 ≤ cofactorEvaluationConstant A (selectedPatternNormal A t) := by
    intro t
    unfold cofactorEvaluationConstant
    positivity
  have hh := Finset.single_le_sum (fun t _ => hn t) (Finset.mem_univ s)
  change _ ≤ 1 + ∑ t : HyperplaneSupportPattern n, cofactorEvaluationConstant A (selectedPatternNormal A t)
  linarith

def exists_pattern_smallness_threshold {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ T : ℝ, 0 ≤ T ∧ ∀ t, T ≤ t →
      patternEvaluationBound A * Real.exp (-ρ * t / 2) < 1 := by
  let C := patternEvaluationBound A
  have hC1 : 1 ≤ C := patternEvaluationBound_ge_one A
  have hC : 0 < C := lt_of_lt_of_le (by norm_num) hC1
  have hlog : 0 ≤ Real.log C := Real.log_nonneg hC1
  refine ⟨2 * (Real.log C + 1) / ρ, by positivity, ?_⟩
  intro t ht
  have hh := (div_le_iff₀ hρ).mp ht
  have hn : Real.log C + (-ρ * t / 2) < 0 := by nlinarith
  calc
    _ = Real.exp (Real.log C + (-ρ * t / 2)) := by rw [Real.exp_add, Real.exp_log hC]
    _ < 1 := by simpa using Real.exp_lt_exp.mpr hn

def primitive_cofactor_span_eq {n : ℕ}
    (X : Matrix (Fin (n + 1)) (Fin n) ℤ)
    (hX : LinearIndependent ℚ (X.map (Int.castRingHom ℚ)).col)
    (g : ℤ) (hg : g ≠ 0) (a : Fin (n + 1) → ℤ) (ha : a ≠ 0)
    (hfactor : ∀ i, cofactorNormal X i = g * a i) :
    Submodule.span ℚ (Set.range (X.map (Int.castRingHom ℚ)).col) =
      rationalHyperplaneKernel (fun i => (a i : ℚ)) := by
  have haq : (fun i => (a i : ℚ)) ≠ 0 := by
    intro h
    apply ha
    ext i
    have hi : (a i : ℚ) = 0 := congrFun h i
    exact_mod_cast hi
  apply independent_span_eq_hyperplane _ hX _ haq
  intro j
  have hh := cofactorNormal_dot_column (X.map (Int.castRingHom ℚ)) j
  have hw : cofactorNormal (X.map (Int.castRingHom ℚ)) = (g : ℚ) • (fun i => (a i : ℚ)) := by
    ext i
    rw [cofactorNormal_map]
    change ((cofactorNormal X i : ℤ) : ℚ) = (g : ℚ) * (a i : ℚ)
    rw [hfactor, Int.cast_mul]
  rw [hw, smul_dotProduct] at hh
  exact (mul_eq_zero.mp hh).resolve_left (by exact_mod_cast hg)

def moving_hyperplane_height_dichotomy {n : ℕ}
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → Fin (n + 1) → ℝ) (ρ : ℝ) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ) :
    ∃ T C : ℝ, 0 ≤ T ∧ 0 ≤ C ∧ ∀ t, T ≤ t →
      ∀ X : Matrix (Fin (n + 1)) (Fin n) ℤ,
      LinearIndependent ℚ (X.map (Int.castRingHom ℚ)).col →
      (∀ i j, ‖(A * X.map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c 0 i * t)) →
      (∀ i j, (padicNorm 2 (X i j : ℚ) : ℝ) ≤ Real.exp (c 1 i * t)) →
      (∀ i j, (padicNorm 3 (X i j : ℚ) : ℝ) ≤ Real.exp (c 2 i * t)) →
      ∃ a : Fin (n + 1) → ℤ, a ≠ 0 ∧ Finset.univ.gcd a = 1 ∧
        Submodule.span ℚ (Set.range (X.map (Int.castRingHom ℚ)).col) =
          rationalHyperplaneKernel (fun i => (a i : ℚ)) ∧
        (rationalHyperplaneKernel (fun i => (a i : ℚ)) ∈ exceptionalPatternHyperplanes A ∨
          ρ * t / 4 - C ≤ Height.logHeight (fun i => (a i : ℚ))) := by
  classical
  obtain ⟨T, hT, hsmall⟩ := exists_pattern_smallness_threshold A ρ hρ
  obtain ⟨D, hD, hden⟩ := exists_cofactor_denominator A
  refine ⟨T, |Real.log ((D : ℝ) * (n.factorial : ℝ))| / 2, hT, by positivity, ?_⟩
  intro t ht X hX hInf h₂ h₃
  have ht0 : 0 ≤ t := hT.trans ht
  obtain ⟨g, a, hg, ha, hprim, hfactor⟩ := integer_cofactor_primitive_factor X hX
  have hspan := primitive_cofactor_span_eq X hX g hg.ne' a ha hfactor
  have haq : (fun i => (a i : ℚ)) ≠ 0 := by
    intro h
    apply ha
    ext i
    have hi : (a i : ℚ) = 0 := congrFun h i
    exact_mod_cast hi
  let S₀ : Finset (Fin (n + 1)) := Finset.univ.filter
    (fun i => (cofactorTransform A).mulVec (fun j => (a j : ℚ)) i ≠ 0)
  let S₁ : Finset (Fin (n + 1)) := Finset.univ.filter (fun i => a i ≠ 0)
  have hS₀ : S₀.Nonempty := by
    have hn := cofactorTransform_mulVec_ne_zero A hA _ haq
    obtain ⟨i, hi⟩ : ∃ i, (cofactorTransform A).mulVec (fun j => (a j : ℚ)) i ≠ 0 :=
      by simpa [funext_iff] using hn
    exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
  have hS₁ : S₁.Nonempty := by
    obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by simpa [funext_iff] using ha
    exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
  obtain ⟨i₀, hi₀, hmax₀⟩ := Finset.exists_max_image S₀ (c 0) hS₀
  obtain ⟨i₂, hi₂, hmax₂⟩ := Finset.exists_max_image S₁ (c 1) hS₁
  obtain ⟨i₃, hi₃, hmax₃⟩ := Finset.exists_max_image S₁ (c 2) hS₁
  let idx : Fin 3 → Fin (n + 1) := ![i₀, i₂, i₃]
  refine ⟨a, ha, hprim, hspan, ?_⟩
  by_cases hhigh : -ρ / 2 ≤ ∑ v, c v (idx v)
  · right
    obtain ⟨z, hz⟩ := hden a i₀
    have hl := primitive_cofactor_height_lower A X g hg.ne' a hprim hfactor c t ρ ht0
      hInf h₂ h₃ hc idx hhigh (Finset.mem_filter.mp hi₂).2 (Finset.mem_filter.mp hi₃).2
      D z hD (Finset.mem_filter.mp hi₀).2 hz
    have hab := le_abs_self (Real.log ((D : ℝ) * (n.factorial : ℝ)))
    exact le_trans (by linarith) hl
  · left
    let s : HyperplaneSupportPattern n := (S₀, S₁)
    have hreal : RealizesHyperplanePattern A s a := by
      refine ⟨ha, ?_, ?_⟩
      · intro i hi
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
      · intro i hi
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
    let z := selectedPatternNormal A s
    have hzreal := selectedPatternNormal_realizes A s ⟨a, hreal⟩
    let u : Fin 3 → ℝ := fun v => c v (idx v)
    have hu : (∑ v, u v) < -ρ / 2 := lt_of_not_ge hhigh
    have hC : 0 ≤ patternEvaluationBound A := (by norm_num : (0 : ℝ) ≤ 1).trans
      (patternEvaluationBound_ge_one A)
    have hzsmall : cofactorEvaluationConstant A z * Real.exp ((∑ v, u v) * t) < 1 := by
      calc
        _ ≤ patternEvaluationBound A * Real.exp ((∑ v, u v) * t) :=
          mul_le_mul_of_nonneg_right (cofactorEvaluationConstant_le_patternBound A s) (Real.exp_nonneg _)
        _ ≤ patternEvaluationBound A * Real.exp (-ρ * t / 2) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by nlinarith [mul_le_mul_of_nonneg_right hu.le ht0])) hC
        _ < 1 := hsmall t ht
    have horth : ∀ j, dotProduct (fun i => (z i : ℚ)) ((X.map (Int.castRingHom ℚ)).col j) = 0 := by
      intro j
      have hh := integer_dot_zero_of_local_product A hA z (fun i => X i j) c t u ht0
        (fun i => hInf i j) (fun i => h₂ i j) (fun i => h₃ i j)
        (fun i hi => hmax₀ i (hzreal.2.1 i hi))
        (fun i hi => hmax₂ i (hzreal.2.2 i hi))
        (fun i hi => hmax₃ i (hzreal.2.2 i hi)) hzsmall
      change ∑ i, (z i : ℚ) * (X i j : ℚ) = 0
      exact_mod_cast hh
    have hzq : (fun i => (z i : ℚ)) ≠ 0 := by
      intro h
      apply hzreal.1
      ext i
      have hi : (z i : ℚ) = 0 := congrFun h i
      exact_mod_cast hi
    have hspz := independent_span_eq_hyperplane _ hX _ hzq horth
    rw [← hspan, hspz]
    exact Finset.mem_image.mpr ⟨s, Finset.mem_univ s, rfl⟩


end
end Bounty

end SubmissionComponent_HyperplaneHeightDichotomy

/- Component DerivativeSubstitutionHeight; SHA256 11bad84064d35312f7a2cf9810b404f7de1be5676e5e70943b3776c5c632b557 -/
section SubmissionComponent_DerivativeSubstitutionHeight
/- A uniform coefficient-height bound for transformed integer divided derivatives. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rational_polynomialCoeffL1_aeval_monomial {I J : Type*} [Fintype I]
    (f : I → MvPolynomial J ℚ) (e : I →₀ ℕ) (a : ℚ) (C : ℝ)
    (hC : 0 ≤ C) (hf : ∀ i, polynomialCoeffL1 (f i) ≤ C) :
    polynomialCoeffL1 (MvPolynomial.aeval f (MvPolynomial.monomial e a)) ≤
      ‖a‖ * C ^ (∑ i, e i) := by
  classical
  rw [MvPolynomial.aeval_monomial]
  change polynomialCoeffL1 (MvPolynomial.C a * _) ≤ _
  rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  apply (polynomialCoeffL1_mul _ _).trans
  rw [polynomialCoeffL1_C]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  calc
    _ ≤ ∏ i, polynomialCoeffL1 (f i ^ e i) := polynomialCoeffL1_prod _ _
    _ ≤ ∏ i, polynomialCoeffL1 (f i) ^ e i := Finset.prod_le_prod
      (fun i _ => polynomialCoeffL1_nonneg _) (fun i _ => polynomialCoeffL1_pow _ _)
    _ ≤ ∏ i, C ^ e i := Finset.prod_le_prod
      (fun i _ => pow_nonneg (polynomialCoeffL1_nonneg _) _)
      (fun i _ => pow_le_pow_left₀ (polynomialCoeffL1_nonneg _) (hf i) _)
    _ = _ := Finset.prod_pow_eq_pow_sum _ _ _

def rational_polynomialCoeffL1_aeval_degree_bound {I J : Type*} [Fintype I]
    (f : I → MvPolynomial J ℚ) (P : MvPolynomial I ℚ) (D : ℕ) (C : ℝ)
    (hC : 1 ≤ C) (hf : ∀ i, polynomialCoeffL1 (f i) ≤ C)
    (hD : ∀ e ∈ P.support, ∑ i, e i ≤ D) :
    polynomialCoeffL1 (MvPolynomial.aeval f P) ≤ C ^ D * polynomialCoeffL1 P := by
  classical
  nth_rw 1 [MvPolynomial.as_sum P]
  rw [map_sum]
  calc
    _ ≤ ∑ e ∈ P.support, polynomialCoeffL1 (MvPolynomial.aeval f
        (MvPolynomial.monomial e (MvPolynomial.coeff e P))) := polynomialCoeffL1_sum _ _
    _ ≤ ∑ e ∈ P.support, ‖MvPolynomial.coeff e P‖ * C ^ D := by
      apply Finset.sum_le_sum
      intro e he
      exact (rational_polynomialCoeffL1_aeval_monomial f e _ C (zero_le_one.trans hC) hf).trans
        (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hC (hD e he)) (norm_nonneg _))
    _ = _ := by rw [← Finset.sum_mul]; exact mul_comm _ _

def productBlockHomogeneous_integerMap {m d : ℕ} (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℤ) (hP : ProductBlockHomogeneous r P) :
    ProductBlockHomogeneous r (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  intro e he
  exact hP e (MvPolynomial.support_map_subset _ _ he)

def productBlockHomogeneous_boxBound {m d : ℕ} (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (hP : ProductBlockHomogeneous r P) :
    PolynomialBoxBound (fun x => r x.1) P := by
  intro e he x
  exact (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ x.2)).trans_eq
    (hP e he x.1)

def productBlockHomogeneous_divided_total_le {m d : ℕ} (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (hP : ProductBlockHomogeneous r P)
    (s : List (Fin m × Fin d)) :
    ∀ e ∈ (dividedWordPDeriv s P).support, ∑ x, e x ≤ ∑ h, r h := by
  intro e he
  have hsource := hP _ (dividedWordPDeriv_support_shift s P he)
  calc
    _ ≤ ∑ x, (e + wordDerivativeCounts s) x :=
      Finset.sum_le_sum fun x _ => Nat.le_add_right _ _
    _ = _ := by rw [Fintype.sum_prod_type]; simp_rw [hsource]

def rationalBlockLinearForm_coeffL1_le {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℚ) (x : Fin m × Fin d) :
    polynomialCoeffL1 (rationalBlockLinearForm A x) ≤ ∑ j, ‖A x.1 x.2 j‖ := by
  calc
    _ ≤ ∑ j, polynomialCoeffL1
        (MvPolynomial.C (A x.1 x.2 j) * MvPolynomial.X (x.1, j)) := polynomialCoeffL1_sum _ _
    _ = _ := by
      apply Finset.sum_congr rfl
      intro j _
      rw [MvPolynomial.C_mul_X_eq_monomial, polynomialCoeffL1_monomial]

def transformed_integer_derivative_height {m d : ℕ}
    (A : Fin m → Fin d → Fin d → ℚ) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P) (s : List (Fin m × Fin d))
    (C K : ℝ) (hC : 1 ≤ C) (hA : ∀ h i, ∑ j, ‖A h i j‖ ≤ C)
    (hheight : Real.log (polynomialCoeffL1 P) ≤ K * (∑ h, (r h : ℝ)))
    (hF : rationalBlockLinearSubstitution A
      (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0) :
    Real.log (polynomialCoeffL1 (rationalBlockLinearSubstitution A
      (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P)))) ≤
        (K + (d : ℝ) * Real.log 2 + Real.log C) * (∑ h, (r h : ℝ)) := by
  let Q := MvPolynomial.map (Int.castRingHom ℚ) P
  have hhomQ : ProductBlockHomogeneous r Q := productBlockHomogeneous_integerMap r P hhom
  have hsub := rational_polynomialCoeffL1_aeval_degree_bound (rationalBlockLinearForm A)
    (dividedWordPDeriv s Q) (∑ h, r h) C hC
    (fun x => (rationalBlockLinearForm_coeffL1_le A x).trans (hA x.1 x.2))
    (productBlockHomogeneous_divided_total_le r Q hhomQ s)
  have hderiv := polynomialCoeffL1_dividedWordPDeriv s (fun x => r x.1) Q
    (productBlockHomogeneous_boxBound r Q hhomQ)
  have hsum : (∑ x : Fin m × Fin d, r x.1) = d * ∑ h, r h := by
    simp [Fintype.sum_prod_type, Finset.mul_sum, Nat.mul_comm]
  rw [hsum, polynomialCoeffL1_map_int_rat] at hderiv
  have hnorm : polynomialCoeffL1 (rationalBlockLinearSubstitution A (dividedWordPDeriv s Q)) ≤
      C ^ (∑ h, r h) * ((2 : ℝ) ^ (d * ∑ h, r h) * polynomialCoeffL1 P) :=
    hsub.trans (mul_le_mul_of_nonneg_left hderiv (pow_nonneg (zero_le_one.trans hC) _))
  have hlog := Real.log_le_log (polynomialCoeffL1_pos hF) hnorm
  have hCpos : 0 < C := zero_lt_one.trans_le hC
  have hPpos := polynomialCoeffL1_pos hP
  rw [Real.log_mul (pow_ne_zero _ hCpos.ne') (mul_ne_zero (pow_ne_zero _ (by norm_num)) hPpos.ne'),
    Real.log_mul (pow_ne_zero _ (by norm_num)) hPpos.ne', Real.log_pow, Real.log_pow] at hlog
  simp only [Nat.cast_mul, Nat.cast_sum] at hlog
  change Real.log (polynomialCoeffL1 (rationalBlockLinearSubstitution A (dividedWordPDeriv s Q))) ≤ _
  nlinarith [hheight]


end
end Bounty

end SubmissionComponent_DerivativeSubstitutionHeight

/- Component ThreePlacePolynomialBounds; SHA256 a51d88efc4e3bed754da254948a3a5de093d49ec4dd21088907ca360dc78d405 -/
section SubmissionComponent_ThreePlacePolynomialBounds
/- Actual polynomial evaluations at the real place and two finite places,
with independently selected supported monomials. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def blockExponentSum {m d : ℕ} (c : Fin d → ℝ) (q : Fin m → ℝ)
    (e : (Fin m × Fin d) →₀ ℕ) : ℝ :=
  ∑ i, ∑ h, c i * (e (h, i) : ℝ) * q h

def product_powers_le_exp_sum {I : Type*} [Fintype I]
    (a b : I → ℝ) (e : I → ℕ) (ha : ∀ i, 0 ≤ a i)
    (hab : ∀ i, a i ≤ Real.exp (b i)) :
    (∏ i, (a i) ^ e i) ≤ Real.exp (∑ i, (e i : ℝ) * b i) := by
  calc
    _ ≤ ∏ i, (Real.exp (b i)) ^ e i := Finset.prod_le_prod
      (fun i _ => pow_nonneg (ha i) _) (fun i _ => pow_le_pow_left₀ (ha i) (hab i) _)
    _ = _ := by simp only [← Real.exp_nat_mul, ← Real.exp_sum]

def block_exponent_sum_identity {m d : ℕ} (c : Fin d → ℝ) (q : Fin m → ℝ)
    (e : (Fin m × Fin d) →₀ ℕ) :
    (∑ x : Fin m × Fin d, (e x : ℝ) * (c x.2 * q x.1)) = blockExponentSum c q e := by
  rw [Fintype.sum_prod_type, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro h _
  ring

def block_monomial_exp_bound {m d : ℕ}
    (a : Fin m × Fin d → ℝ) (c : Fin d → ℝ) (q : Fin m → ℝ)
    (e : (Fin m × Fin d) →₀ ℕ) (ha : ∀ x, 0 ≤ a x)
    (hab : ∀ h i, a (h, i) ≤ Real.exp (c i * q h)) :
    (∏ x, (a x) ^ e x) ≤ Real.exp (blockExponentSum c q e) := by
  simpa only [block_exponent_sum_identity] using product_powers_le_exp_sum
    a (fun x => c x.2 * q x.1) e ha (fun x => hab x.1 x.2)

def block_monomial_exp_bound_with_constant {m d : ℕ}
    (r : Fin m → ℕ) (a : Fin m × Fin d → ℝ) (c : Fin d → ℝ) (q : Fin m → ℝ)
    (e : (Fin m × Fin d) →₀ ℕ) (K : ℝ) (hK : 1 ≤ K)
    (ha : ∀ x, 0 ≤ a x) (hab : ∀ h i, a (h, i) ≤ K * Real.exp (c i * q h))
    (hdegree : ∀ h, ∑ i, e (h, i) ≤ r h) :
    (∏ x, (a x) ^ e x) ≤ Real.exp
      (Real.log K * (∑ h, (r h : ℝ)) + blockExponentSum c q e) := by
  have hK0 : 0 < K := lt_of_lt_of_le zero_lt_one hK
  have hh := product_powers_le_exp_sum a (fun x => Real.log K + c x.2 * q x.1) e ha
    (fun x => by simpa only [Real.exp_add, Real.exp_log hK0] using hab x.1 x.2)
  have he : (∑ x : Fin m × Fin d, (e x : ℝ)) ≤ ∑ h, (r h : ℝ) := by
    rw [Fintype.sum_prod_type]
    exact Finset.sum_le_sum fun h _ => by exact_mod_cast hdegree h
  refine hh.trans (Real.exp_le_exp.mpr ?_)
  calc
    _ = Real.log K * (∑ x : Fin m × Fin d, (e x : ℝ)) + blockExponentSum c q e := by
      simp only [mul_add, Finset.sum_add_distrib, ← Finset.sum_mul,
        block_exponent_sum_identity]
      ring
    _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left he (Real.log_nonneg hK)) le_rfl

def blockMatrixValues {m d : ℕ} (A : Fin m → Matrix (Fin d) (Fin d) ℚ)
    (x : Fin m × Fin d → ℚ) : Fin m × Fin d → ℚ :=
  fun hi => (A hi.1).mulVec (fun j => x (hi.1, j)) hi.2

def rationalBlockLinearSubstitution_eval {m d : ℕ}
    (B : Fin m → Matrix (Fin d) (Fin d) ℚ)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (y : Fin m × Fin d → ℚ) :
    MvPolynomial.eval y (rationalBlockLinearSubstitution B P) =
      MvPolynomial.eval (blockMatrixValues B y) P := by
  change MvPolynomial.aeval y (MvPolynomial.aeval (rationalBlockLinearForm B) P) = _
  rw [MvPolynomial.comp_aeval_apply]
  change MvPolynomial.eval (fun i => MvPolynomial.eval y (rationalBlockLinearForm B i)) P = _
  apply congrArg (fun f => MvPolynomial.eval f P)
  funext x
  simp [rationalBlockLinearForm, blockMatrixValues, Matrix.mulVec, dotProduct]

def inverseBlockMatrices {m d : ℕ} (A : Fin m → Matrix (Fin d) (Fin d) ℚ) :
    Fin m → Matrix (Fin d) (Fin d) ℚ := fun h => (A h)⁻¹

def inverse_block_substitution_eval {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, IsUnit (A h).det)
    (T : MvPolynomial (Fin m × Fin d) ℤ) (x : Fin m × Fin d → ℤ) :
    MvPolynomial.eval (blockMatrixValues A (fun hi => (x hi : ℚ)))
      (rationalBlockLinearSubstitution (inverseBlockMatrices A)
        (MvPolynomial.map (Int.castRingHom ℚ) T)) = (MvPolynomial.eval x T : ℚ) := by
  rw [rationalBlockLinearSubstitution_eval]
  have hid : blockMatrixValues (inverseBlockMatrices A)
      (blockMatrixValues A (fun hi => (x hi : ℚ))) = (fun hi => (x hi : ℚ)) := by
    funext hi
    change ((A hi.1)⁻¹.mulVec ((A hi.1).mulVec (fun j => (x (hi.1, j) : ℚ)))) hi.2 = _
    rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ (hA hi.1), Matrix.one_mulVec]
  simp only [hid]
  simpa only [Int.coe_castRingHom, Function.comp_def] using
    (MvPolynomial.map_eval (Int.castRingHom ℚ) x T).symm

def integer_eval₂_cast {I : Type*} (T : MvPolynomial I ℤ) (x : I → ℤ) :
    MvPolynomial.eval₂ (Int.castRingHom ℚ) (fun i => (x i : ℚ)) T = (MvPolynomial.eval x T : ℚ) := by
  rw [MvPolynomial.eval₂_eq_eval_map]
  simpa only [Int.coe_castRingHom, Function.comp_def] using
    (MvPolynomial.map_eval (Int.castRingHom ℚ) x T).symm

def integer_padic_eval_le_exp_some_monomial {m d : ℕ}
    (p : ℕ) [Fact p.Prime] (T : MvPolynomial (Fin m × Fin d) ℤ) (hT : T ≠ 0)
    (x : Fin m × Fin d → ℤ) (q : Fin m → ℝ) (c : Fin d → ℝ)
    (hx : ∀ h i, (padicNorm p (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c i * q h)) :
    ∃ e ∈ T.support, (padicNorm p (MvPolynomial.eval x T : ℚ) : ℝ) ≤
      Real.exp (blockExponentSum c q e) := by
  obtain ⟨e, he, hbound⟩ := integer_polynomial_eval₂_padicNorm_le_some_monomial
    p T hT (fun i => (x i : ℚ))
  rw [integer_eval₂_cast] at hbound
  have hbound' : (padicNorm p (MvPolynomial.eval x T : ℚ) : ℝ) ≤
      ∏ i, (padicNorm p (x i : ℚ) : ℝ) ^ e i := by exact_mod_cast hbound
  exact ⟨e, he, hbound'.trans (block_monomial_exp_bound _ c q e
    (fun i => by exact_mod_cast (padicNorm.nonneg (p := p) (x i : ℚ))) hx)⟩

def rational_eval_le_exp_some_monomial {m d : ℕ}
    (F : MvPolynomial (Fin m × Fin d) ℚ) (hF : F ≠ 0) (y : Fin m × Fin d → ℚ)
    (r : Fin m → ℕ) (q : Fin m → ℝ) (c : Fin d → ℝ) (C K : ℝ) (hK : 1 ≤ K)
    (hdegree : ∀ e ∈ F.support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hheight : Real.log (polynomialCoeffL1 F) ≤ C * ∑ h, (r h : ℝ))
    (hy : ∀ h i, ‖y (h, i)‖ ≤ K * Real.exp (c i * q h)) :
    ∃ e ∈ F.support, ‖MvPolynomial.eval y F‖ ≤
      Real.exp ((C + Real.log K) * (∑ h, (r h : ℝ)) + blockExponentSum c q e) := by
  obtain ⟨e, he, hbound⟩ := rational_polynomial_eval_norm_le_some_monomial F hF y
  have hcoeff : polynomialCoeffL1 F ≤ Real.exp (C * ∑ h, (r h : ℝ)) := by
    simpa only [Real.exp_log (polynomialCoeffL1_pos hF)] using Real.exp_le_exp.mpr hheight
  have hmono := block_monomial_exp_bound_with_constant r (fun i => ‖y i‖) c q e K hK
    (fun i => norm_nonneg _) hy (hdegree e he)
  refine ⟨e, he, hbound.trans ?_⟩
  calc
    _ ≤ Real.exp (C * ∑ h, (r h : ℝ)) *
        Real.exp (Real.log K * (∑ h, (r h : ℝ)) + blockExponentSum c q e) :=
      mul_le_mul hcoeff hmono (Finset.prod_nonneg fun i _ => pow_nonneg (norm_nonneg _) _)
        (Real.exp_nonneg _)
    _ = _ := by rw [← Real.exp_add]; congr 1; ring


end
end Bounty

end SubmissionComponent_ThreePlacePolynomialBounds

/- Component UniformBalancedDerivativeAuxiliary; SHA256 f7c7e83edbb956f7ff073c5c91674fae6c9b30ece711f25e842226a4b34dac96 -/
section SubmissionComponent_UniformBalancedDerivativeAuxiliary
/- One auxiliary polynomial supplies integral, balanced, uniformly bounded derivatives. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rationalBlockLinearSubstitution_injective {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, (A h).det ≠ 0) :
    Function.Injective (rationalBlockLinearSubstitution A) := by
  intro P Q hPQ
  have hh := congrArg (rationalBlockLinearSubstitution (inverseBlockMatrices A)) hPQ
  have hmul : (fun h => A h * inverseBlockMatrices A h) =
      (fun _ => (1 : Matrix (Fin d) (Fin d) ℚ)) := by
    funext h
    exact Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (hA h))
  simpa only [rationalBlockLinearSubstitution_comp, hmul,
    rationalBlockLinearSubstitution_one] using hh

def exists_rational_block_matrix_norm_bound {m d s : ℕ}
    (A : Fin s → Fin m → Fin d → Fin d → ℚ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ v h i, ∑ j, ‖A v h i j‖ ≤ C := by
  let T : ℝ := ∑ v, ∑ h, ∑ i, ∑ j, ‖A v h i j‖
  have hT : 0 ≤ T := by dsimp [T]; positivity
  refine ⟨1 + T, by linarith, ?_⟩
  intro v h i
  have hi : (∑ j, ‖A v h i j‖) ≤ ∑ k, ∑ j, ‖A v h k j‖ :=
    Finset.single_le_sum (f := fun k : Fin d => ∑ j, ‖A v h k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ i)
  have hh : (∑ k, ∑ j, ‖A v h k j‖) ≤ ∑ t, ∑ k, ∑ j, ‖A v t k j‖ :=
    Finset.single_le_sum (f := fun t : Fin m => ∑ k, ∑ j, ‖A v t k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ h)
  have hv : (∑ t, ∑ k, ∑ j, ‖A v t k j‖) ≤ T :=
    Finset.single_le_sum (f := fun w : Fin s => ∑ t, ∑ k, ∑ j, ‖A w t k j‖)
      (fun _ _ => by positivity) (Finset.mem_univ v)
  linarith [hi.trans (hh.trans hv)]

def exists_balanced_integer_derivative_auxiliary {m d s : ℕ}
    (hm : 0 < m) (hd : 0 < d)
    (B : Fin s → Fin m → Matrix (Fin d) (Fin d) ℚ)
    (hB : ∀ v h, (B v h).det ≠ 0) :
    ∃ K L : ℝ, 0 ≤ K ∧ 0 ≤ L ∧
      ∀ (r : Fin m → ℕ), (∀ h, 0 < r h) →
      ∀ η : ℝ, 0 ≤ η → 4 * (s : ℝ) * d ≤ (m : ℝ) * η ^ 2 →
      ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧ ProductBlockHomogeneous r P ∧
        Real.log (polynomialCoeffL1 P) ≤ K * (∑ h, (r h : ℝ)) ∧
        ∀ t : List (Fin m × Fin d), blockDerivativeWeight r t ≤ (m : ℝ) * η →
          dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P) ≠ 0 →
          ∃ T : MvPolynomial (Fin m × Fin d) ℤ, T ≠ 0 ∧
            MvPolynomial.map (Int.castRingHom ℚ) T =
              dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P) ∧
            ∀ v : Fin s,
              (∀ e ∈ (rationalBlockLinearSubstitution (B v)
                (MvPolynomial.map (Int.castRingHom ℚ) T)).support,
                (∀ h, ∑ i, e (h, i) ≤ r h) ∧
                ∀ i : Fin d,
                  |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * (m : ℝ) * η) ∧
              Real.log (polynomialCoeffL1 (rationalBlockLinearSubstitution (B v)
                (MvPolynomial.map (Int.castRingHom ℚ) T))) ≤ L * (∑ h, (r h : ℝ)) := by
  obtain ⟨K, hK, haux⟩ := exists_rational_balanced_auxiliary_constant hm hd B
  obtain ⟨C, hC, hnormB⟩ := exists_rational_block_matrix_norm_bound B
  let L := K + (d : ℝ) * Real.log 2 + Real.log C
  have hL : 0 ≤ L := add_nonneg (add_nonneg hK
    (mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg (by norm_num)))) (Real.log_nonneg hC)
  refine ⟨K, L, hK, hL, ?_⟩
  intro r hr η hη hlarge
  obtain ⟨P, hP, hhom, hheight, hbalance⟩ := haux r hr η hη hlarge
  refine ⟨P, hP, hhom, hheight, ?_⟩
  intro t ht hderiv
  obtain ⟨T, hTmap⟩ := exists_integer_dividedWordPDeriv t P
  have hT : T ≠ 0 := by
    intro hz
    apply hderiv
    simpa only [hz, map_zero] using hTmap.symm
  refine ⟨T, hT, hTmap, ?_⟩
  intro v
  have htransformed : rationalBlockLinearSubstitution (B v)
      (dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0 := by
    intro hz
    exact hderiv ((rationalBlockLinearSubstitution_injective (B v) (hB v))
      (hz.trans (map_zero _).symm))
  constructor
  · intro e he
    have he' : MvPolynomial.coeff e (rationalBlockLinearSubstitution (B v)
        (dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P))) ≠ 0 := by
      simpa only [hTmap] using MvPolynomial.mem_support_iff.mp he
    constructor
    · intro h
      have hh := rationalBlockLinearSubstitution_dividedWordPDeriv_block_degrees
        (B v) (hB v) r t (MvPolynomial.map (Int.castRingHom ℚ) P)
        (fun e he => (hbalance v e he).1) e he' h
      omega
    · intro i
      exact (rationalBlockLinearSubstitution_dividedWordPDeriv_balanced
        (B v) (hB v) r η t (MvPolynomial.map (Int.castRingHom ℚ) P)
        (fun e he => (hbalance v e he).2) ht e he' i).le
  · rw [hTmap]
    exact transformed_integer_derivative_height (B v) r P hP hhom t C K hC
      (hnormB v) hheight htransformed


end
end Bounty

end SubmissionComponent_UniformBalancedDerivativeAuxiliary

/- Component BalancedExponentEstimate; SHA256 69dcab77191dbe80821fadc1a990d78a1b032b02e93b6d9e61689f660e3ce643 -/
section SubmissionComponent_BalancedExponentEstimate
/- Exact finite-sum exponent budgets.  The hypotheses are concrete scale,
coordinate, and balance inequalities; no geometry or limiting premise occurs. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def balanced_block_scale_error {m : ℕ} (r q e : Fin m → ℝ) (D : ℝ)
    (hr : ∀ h, 0 < r h) (he0 : ∀ h, 0 ≤ e h) (her : ∀ h, e h ≤ r h)
    (hscale : ∀ h, |r h * q h - D| ≤ q h) :
    |(∑ h, e h * q h) - D * (∑ h, e h / r h)| ≤ ∑ h, q h := by
  have hterm (h : Fin m) : |e h * q h - D * (e h / r h)| ≤ q h := by
    have hepos : 0 ≤ e h / r h := div_nonneg (he0 h) (le_of_lt (hr h))
    have hele : e h / r h ≤ 1 := (div_le_one (hr h)).mpr (her h)
    have hid : e h * q h - D * (e h / r h) =
        (e h / r h) * (r h * q h - D) := by
      field_simp [ne_of_gt (hr h)]
    rw [hid, abs_mul, abs_of_nonneg hepos]
    exact (mul_le_mul hele (hscale h) (abs_nonneg _) zero_le_one).trans_eq (one_mul _)
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun h _ => hterm h)

def balanced_coordinate_scale_estimate {m d : ℕ}
    (r q e : Fin m → ℝ) (D η : ℝ) (hD : 0 ≤ D)
    (hr : ∀ h, 0 < r h) (he0 : ∀ h, 0 ≤ e h) (her : ∀ h, e h ≤ r h)
    (hscale : ∀ h, |r h * q h - D| ≤ q h)
    (hbalance : |(∑ h, e h / r h) - (m : ℝ) / d| ≤ 2 * m * η) :
    |(∑ h, e h * q h) - D * (m : ℝ) / d| ≤ D * (2 * m * η) + ∑ h, q h := by
  have hid : (∑ h, e h * q h) - D * (m : ℝ) / d =
      ((∑ h, e h * q h) - D * (∑ h, e h / r h)) +
        D * ((∑ h, e h / r h) - (m : ℝ) / d) := by ring
  rw [hid]
  calc
    _ ≤ |(∑ h, e h * q h) - D * (∑ h, e h / r h)| +
        |D * ((∑ h, e h / r h) - (m : ℝ) / d)| := abs_add_le _ _
    _ ≤ (∑ h, q h) + D * (2 * m * η) := by
      rw [abs_mul, abs_of_nonneg hD]
      exact add_le_add (balanced_block_scale_error r q e D hr he0 her hscale)
        (mul_le_mul_of_nonneg_left hbalance hD)
    _ = _ := by ring

def signed_weight_of_abs_error (c S T E : ℝ) (herror : |S - T| ≤ E) :
    c * S ≤ c * T + |c| * E := by
  have hh : c * (S - T) ≤ |c| * E := calc
    _ ≤ |c * (S - T)| := le_abs_self _
    _ = |c| * |S - T| := abs_mul _ _
    _ ≤ _ := mul_le_mul_of_nonneg_left herror (abs_nonneg c)
  nlinarith

def exponentCoefficientMass {s d : ℕ} (c : Fin s → Fin d → ℝ) : ℝ :=
  ∑ v, ∑ i, |c v i|

def balanced_exponent_estimate_real {m d s : ℕ}
    (r q : Fin m → ℝ) (e : Fin s → Fin m → Fin d → ℝ)
    (c : Fin s → Fin d → ℝ) (D η ρ : ℝ) (hd : 0 < d) (hD : 0 ≤ D)
    (hr : ∀ h, 0 < r h)
    (he0 : ∀ v h i, 0 ≤ e v h i) (her : ∀ v h i, e v h i ≤ r h)
    (hscale : ∀ h, |r h * q h - D| ≤ q h)
    (hbalance : ∀ v i, |(∑ h, e v h i / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ) :
    (∑ v, ∑ i, ∑ h, c v i * e v h i * q h) ≤
      D * (-(m : ℝ) * ρ / d + 2 * m * η * exponentCoefficientMass c) +
        exponentCoefficientMass c * ∑ h, q h := by
  let T : ℝ := D * (m : ℝ) / d
  let E : ℝ := D * (2 * m * η) + ∑ h, q h
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hterm (v : Fin s) (i : Fin d) :
      c v i * (∑ h, e v h i * q h) ≤ c v i * T + |c v i| * E :=
    signed_weight_of_abs_error _ _ _ _ (balanced_coordinate_scale_estimate
      r q (fun h => e v h i) D η hD hr (fun h => he0 v h i) (fun h => her v h i)
        hscale (hbalance v i))
  calc
    _ = ∑ v, ∑ i, c v i * (∑ h, e v h i * q h) := by
      simp only [Finset.mul_sum, mul_assoc]
    _ ≤ ∑ v, ∑ i, (c v i * T + |c v i| * E) :=
      Finset.sum_le_sum fun v _ => Finset.sum_le_sum fun i _ => hterm v i
    _ = (∑ v, ∑ i, c v i) * T + exponentCoefficientMass c * E := by
      simp only [Finset.sum_add_distrib, ← Finset.sum_mul, exponentCoefficientMass]
    _ ≤ (-ρ) * T + exponentCoefficientMass c * E :=
      add_le_add (mul_le_mul_of_nonneg_right hc hT) le_rfl
    _ = _ := by dsimp [T, E]; ring

def balanced_exponent_estimate {m d s : ℕ}
    (r : Fin m → ℕ) (q : Fin m → ℝ) (e : Fin s → Fin m → Fin d → ℕ)
    (c : Fin s → Fin d → ℝ) (D η ρ : ℝ) (hd : 0 < d) (hD : 0 ≤ D)
    (hr : ∀ h, 0 < r h) (her : ∀ v h i, e v h i ≤ r h)
    (hscale : ∀ h, |(r h : ℝ) * q h - D| ≤ q h)
    (hbalance : ∀ v i, |(∑ h, (e v h i : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ) :
    (∑ v, ∑ i, ∑ h, c v i * (e v h i : ℝ) * q h) ≤
      D * (-(m : ℝ) * ρ / d + 2 * m * η * exponentCoefficientMass c) +
        exponentCoefficientMass c * ∑ h, q h := by
  exact balanced_exponent_estimate_real (fun h => (r h : ℝ)) q
    (fun v h i => (e v h i : ℝ)) c D η ρ hd hD (fun h => by exact_mod_cast hr h)
    (fun _ _ _ => by positivity) (fun v h i => by exact_mod_cast her v h i)
    hscale hbalance hc

def deficit_le_exponentCoefficientMass {s d : ℕ} (c : Fin s → Fin d → ℝ)
    (ρ : ℝ) (hc : (∑ v, ∑ i, c v i) ≤ -ρ) :
    ρ ≤ exponentCoefficientMass c := by
  have hh : -(∑ v, ∑ i, c v i) ≤ exponentCoefficientMass c := by
    calc
      _ = ∑ v, ∑ i, -(c v i) := by simp only [Finset.sum_neg_distrib]
      _ ≤ _ := Finset.sum_le_sum fun v _ => Finset.sum_le_sum fun i _ => neg_le_abs (c v i)
  linarith

def balanced_exponent_negative_coefficient {m d s : ℕ}
    (c : Fin s → Fin d → ℝ) (η ρ : ℝ) (hd : 0 < d) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hη : η ≤ ρ / (8 * (d : ℝ) * exponentCoefficientMass c)) :
    -(m : ℝ) * ρ / d + 2 * m * η * exponentCoefficientMass c ≤
      -3 * (m : ℝ) * ρ / (4 * d) := by
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hmass : 0 < exponentCoefficientMass c :=
    hρ.trans_le (deficit_le_exponentCoefficientMass c ρ hc)
  have hη' := (le_div_iff₀ (show 0 < 8 * (d : ℝ) * exponentCoefficientMass c by positivity)).mp hη
  have hsmall : 2 * (m : ℝ) * η * exponentCoefficientMass c ≤
      (m : ℝ) * ρ / (4 * d) := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 4 * d)).mpr
    calc
      _ = (m : ℝ) * (η * (8 * d * exponentCoefficientMass c)) := by ring
      _ ≤ (m : ℝ) * ρ := mul_le_mul_of_nonneg_left hη' (by positivity)
  calc
    _ ≤ -(m : ℝ) * ρ / d + (m : ℝ) * ρ / (4 * d) := add_le_add le_rfl hsmall
    _ = _ := by field_simp; ring

def balanced_exponent_estimate_negative {m d s : ℕ}
    (r : Fin m → ℕ) (q : Fin m → ℝ) (e : Fin s → Fin m → Fin d → ℕ)
    (c : Fin s → Fin d → ℝ) (D η ρ : ℝ) (hd : 0 < d) (hD : 0 ≤ D) (hρ : 0 < ρ)
    (hr : ∀ h, 0 < r h) (her : ∀ v h i, e v h i ≤ r h)
    (hscale : ∀ h, |(r h : ℝ) * q h - D| ≤ q h)
    (hbalance : ∀ v i, |(∑ h, (e v h i : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hη : η ≤ ρ / (8 * (d : ℝ) * exponentCoefficientMass c)) :
    (∑ v, ∑ i, ∑ h, c v i * (e v h i : ℝ) * q h) ≤
      -3 * (m : ℝ) * ρ * D / (4 * d) + exponentCoefficientMass c * ∑ h, q h := by
  calc
    _ ≤ D * (-(m : ℝ) * ρ / d + 2 * m * η * exponentCoefficientMass c) +
        exponentCoefficientMass c * ∑ h, q h :=
      balanced_exponent_estimate r q e c D η ρ hd hD hr her hscale hbalance hc
    _ ≤ D * (-3 * (m : ℝ) * ρ / (4 * d)) + exponentCoefficientMass c * ∑ h, q h :=
      add_le_add (mul_le_mul_of_nonneg_left
        (balanced_exponent_negative_coefficient c η ρ hd hρ hc hη) hD) le_rfl
    _ = _ := by ring

def exponent_quarter_budgets_of_large_scales {m d : ℕ}
    (C R q₀ M Q ρ D : ℝ) (hd : 0 < d) (hC : 0 ≤ C) (hD : 0 < D) (hq₀ : 0 < q₀)
    (hR : R ≤ 2 * D / q₀)
    (hqLarge : 8 * (d : ℝ) * C ≤ (m : ℝ) * ρ * q₀)
    (hDLarge : 4 * (d : ℝ) * M * Q ≤ (m : ℝ) * ρ * D) :
    C * R ≤ (m : ℝ) * ρ * D / (4 * d) ∧
      M * Q ≤ (m : ℝ) * ρ * D / (4 * d) := by
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  constructor
  · refine (mul_le_mul_of_nonneg_left hR hC).trans ?_
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 4 * d)).mpr
    have hh := mul_le_mul_of_nonneg_right hqLarge (le_of_lt hD)
    have hid : (C * (2 * D / q₀)) * (4 * (d : ℝ)) = (8 * d * C * D) / q₀ := by ring
    rw [hid]
    apply (div_le_iff₀ hq₀).mpr
    nlinarith
  · apply (le_div_iff₀ (by positivity : (0 : ℝ) < 4 * d)).mpr
    nlinarith

def exponent_three_quarter_budget_negative {m d : ℕ}
    (C R M Q ρ D E : ℝ) (hm : 0 < m) (hd : 0 < d) (hρ : 0 < ρ) (hD : 0 < D)
    (hR : C * R ≤ (m : ℝ) * ρ * D / (4 * d))
    (hQ : M * Q ≤ (m : ℝ) * ρ * D / (4 * d))
    (hE : E ≤ -3 * (m : ℝ) * ρ * D / (4 * d) + M * Q) :
    C * R + E < 0 := by
  have hpos : 0 < (m : ℝ) * ρ * D / (4 * d) := by positivity
  have hid : -3 * (m : ℝ) * ρ * D / (4 * d) =
      -3 * ((m : ℝ) * ρ * D / (4 * d)) := by ring
  rw [hid] at hE
  linarith

def balanced_exponent_contradiction {m d s : ℕ}
    (r : Fin m → ℕ) (q : Fin m → ℝ) (e : Fin s → Fin m → Fin d → ℕ)
    (c : Fin s → Fin d → ℝ) (D η ρ C q₀ : ℝ)
    (hm : 0 < m) (hd : 0 < d) (hD : 0 < D) (hρ : 0 < ρ) (hC : 0 ≤ C) (hq₀ : 0 < q₀)
    (hr : ∀ h, 0 < r h) (her : ∀ v h i, e v h i ≤ r h)
    (hscale : ∀ h, |(r h : ℝ) * q h - D| ≤ q h)
    (hbalance : ∀ v i, |(∑ h, (e v h i : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hη : η ≤ ρ / (8 * (d : ℝ) * exponentCoefficientMass c))
    (hR : (∑ h, (r h : ℝ)) ≤ 2 * D / q₀)
    (hqLarge : 8 * (d : ℝ) * C ≤ (m : ℝ) * ρ * q₀)
    (hDLarge : 4 * (d : ℝ) * exponentCoefficientMass c * (∑ h, q h) ≤ (m : ℝ) * ρ * D) :
    C * (∑ h, (r h : ℝ)) + (∑ v, ∑ i, ∑ h, c v i * (e v h i : ℝ) * q h) < 0 := by
  obtain ⟨hR', hQ'⟩ := exponent_quarter_budgets_of_large_scales
    C (∑ h, (r h : ℝ)) q₀ (exponentCoefficientMass c) (∑ h, q h) ρ D
    hd hC hD hq₀ hR hqLarge hDLarge
  exact exponent_three_quarter_budget_negative C (∑ h, (r h : ℝ))
    (exponentCoefficientMass c) (∑ h, q h) ρ D _ hm hd hρ hD hR' hQ'
    (balanced_exponent_estimate_negative r q e c D η ρ hd (le_of_lt hD) hρ hr her hscale hbalance hc hη)


end
end Bounty

end SubmissionComponent_BalancedExponentEstimate

/- Component ActualThreePlacePolynomialContradiction; SHA256 b9ee0dc12e43ce1f135678ffe33725fde4cc32ea061c3d14e3777fa199a69a65 -/
section SubmissionComponent_ActualThreePlacePolynomialContradiction
/- The actual three-place contradiction for a nonzero integer polynomial
evaluation.  Archimedean coefficients may be rational; finite-place estimates
are applied directly to the integer polynomial. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def actual_three_place_polynomial_upper {m d : ℕ}
    (T : MvPolynomial (Fin m × Fin d) ℤ) (F : MvPolynomial (Fin m × Fin d) ℚ)
    (x : Fin m × Fin d → ℤ) (y : Fin m × Fin d → ℚ)
    (heval : MvPolynomial.eval y F = (MvPolynomial.eval x T : ℚ))
    (hne : MvPolynomial.eval x T ≠ 0)
    (r : Fin m → ℕ) (q : Fin m → ℝ) (c : Fin 3 → Fin d → ℝ) (C K : ℝ) (hK : 1 ≤ K)
    (hdegree : ∀ e ∈ F.support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hheight : Real.log (polynomialCoeffL1 F) ≤ C * ∑ h, (r h : ℝ))
    (hy : ∀ h i, ‖y (h, i)‖ ≤ K * Real.exp (c 0 i * q h))
    (hx₂ : ∀ h i, (padicNorm 2 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 1 i * q h))
    (hx₃ : ∀ h i, (padicNorm 3 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 2 i * q h)) :
    ∃ eInf ∈ F.support, ∃ e₂ ∈ T.support, ∃ e₃ ∈ T.support,
      |(MvPolynomial.eval x T : ℝ)| * (padicNorm 2 (MvPolynomial.eval x T : ℚ) : ℝ) *
        (padicNorm 3 (MvPolynomial.eval x T : ℚ) : ℝ) ≤
      Real.exp ((C + Real.log K) * (∑ h, (r h : ℝ)) + blockExponentSum (c 0) q eInf +
        blockExponentSum (c 1) q e₂ + blockExponentSum (c 2) q e₃) := by
  have hT : T ≠ 0 := by intro hz; apply hne; simp [hz]
  have hF : F ≠ 0 := by
    intro hz
    have hh : (MvPolynomial.eval x T : ℚ) = 0 := by simpa [hz] using heval.symm
    apply hne
    exact_mod_cast hh
  obtain ⟨eInf, heInf, hbInf⟩ := rational_eval_le_exp_some_monomial F hF y r q (c 0) C K hK hdegree hheight hy
  obtain ⟨e₂, he₂, hb₂⟩ := integer_padic_eval_le_exp_some_monomial 2 T hT x q (c 1) hx₂
  obtain ⟨e₃, he₃, hb₃⟩ := integer_padic_eval_le_exp_some_monomial 3 T hT x q (c 2) hx₃
  have hbInf' : |(MvPolynomial.eval x T : ℝ)| ≤
      Real.exp ((C + Real.log K) * (∑ h, (r h : ℝ)) + blockExponentSum (c 0) q eInf) := by
    simpa only [heval, Int.norm_cast_rat, ← Real.norm_eq_abs, Int.norm_cast_real] using hbInf
  have hp₂ : 0 ≤ (padicNorm 2 (MvPolynomial.eval x T : ℚ) : ℝ) := by
    exact_mod_cast (padicNorm.nonneg (p := 2) (MvPolynomial.eval x T : ℚ))
  have hp₃ : 0 ≤ (padicNorm 3 (MvPolynomial.eval x T : ℚ) : ℝ) := by
    exact_mod_cast (padicNorm.nonneg (p := 3) (MvPolynomial.eval x T : ℚ))
  refine ⟨eInf, heInf, e₂, he₂, e₃, he₃, ?_⟩
  calc
    _ ≤ (Real.exp ((C + Real.log K) * (∑ h, (r h : ℝ)) + blockExponentSum (c 0) q eInf) *
        Real.exp (blockExponentSum (c 1) q e₂)) * Real.exp (blockExponentSum (c 2) q e₃) :=
      mul_le_mul (mul_le_mul hbInf' hb₂ hp₂ (Real.exp_nonneg _)) hb₃ hp₃
        (mul_nonneg (Real.exp_nonneg _) (Real.exp_nonneg _))
    _ = _ := by rw [← Real.exp_add, ← Real.exp_add]

def threePlaceExponents {m d : ℕ} (eInf e₂ e₃ : (Fin m × Fin d) →₀ ℕ) :
    Fin 3 → Fin m → Fin d → ℕ :=
  fun v h i => ![eInf, e₂, e₃] v (h, i)

def threePlaceExponents_sum {m d : ℕ}
    (c : Fin 3 → Fin d → ℝ) (q : Fin m → ℝ) (eInf e₂ e₃ : (Fin m × Fin d) →₀ ℕ) :
    (∑ v, ∑ i, ∑ h, c v i * (threePlaceExponents eInf e₂ e₃ v h i : ℝ) * q h) =
      blockExponentSum (c 0) q eInf + blockExponentSum (c 1) q e₂ + blockExponentSum (c 2) q e₃ := by
  simp [threePlaceExponents, blockExponentSum, Fin.sum_univ_succ, add_assoc]

def actual_three_place_polynomial_contradiction {m d : ℕ}
    (T : MvPolynomial (Fin m × Fin d) ℤ) (F : MvPolynomial (Fin m × Fin d) ℚ)
    (x : Fin m × Fin d → ℤ) (y : Fin m × Fin d → ℚ)
    (heval : MvPolynomial.eval y F = (MvPolynomial.eval x T : ℚ))
    (hne : MvPolynomial.eval x T ≠ 0)
    (r : Fin m → ℕ) (q : Fin m → ℝ) (c : Fin 3 → Fin d → ℝ) (D η ρ C K q₀ : ℝ)
    (hm : 0 < m) (hd : 0 < d) (hD : 0 < D) (hρ : 0 < ρ) (hC : 0 ≤ C)
    (hK : 1 ≤ K) (hq₀ : 0 < q₀) (hr : ∀ h, 0 < r h)
    (hdegreeF : ∀ e ∈ F.support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hdegreeT : ∀ e ∈ T.support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hbalanceF : ∀ e ∈ F.support, ∀ i : Fin d,
      |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hbalanceT : ∀ e ∈ T.support, ∀ i : Fin d,
      |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hscale : ∀ h, |(r h : ℝ) * q h - D| ≤ q h)
    (hheight : Real.log (polynomialCoeffL1 F) ≤ C * ∑ h, (r h : ℝ))
    (hy : ∀ h i, ‖y (h, i)‖ ≤ K * Real.exp (c 0 i * q h))
    (hx₂ : ∀ h i, (padicNorm 2 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 1 i * q h))
    (hx₃ : ∀ h i, (padicNorm 3 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 2 i * q h))
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hη : η ≤ ρ / (8 * (d : ℝ) * exponentCoefficientMass c))
    (hR : (∑ h, (r h : ℝ)) ≤ 2 * D / q₀)
    (hqLarge : 8 * (d : ℝ) * (C + Real.log K) ≤ (m : ℝ) * ρ * q₀)
    (hDLarge : 4 * (d : ℝ) * exponentCoefficientMass c * (∑ h, q h) ≤ (m : ℝ) * ρ * D) :
    False := by
  classical
  obtain ⟨eInf, heInf, e₂, he₂, e₃, he₃, hupper⟩ :=
    actual_three_place_polynomial_upper T F x y heval hne r q c C K hK hdegreeF hheight hy hx₂ hx₃
  have hpoint {e : (Fin m × Fin d) →₀ ℕ} (hdeg : ∀ h, ∑ i, e (h, i) ≤ r h)
      (h : Fin m) (i : Fin d) : e (h, i) ≤ r h :=
    (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)).trans (hdeg h)
  have her : ∀ v h i, threePlaceExponents eInf e₂ e₃ v h i ≤ r h := by
    intro v h i
    fin_cases v
    · exact hpoint (hdegreeF eInf heInf) h i
    · exact hpoint (hdegreeT e₂ he₂) h i
    · exact hpoint (hdegreeT e₃ he₃) h i
  have hbalance : ∀ v i, |(∑ h, (threePlaceExponents eInf e₂ e₃ v h i : ℝ) / r h) -
      (m : ℝ) / d| ≤ 2 * m * η := by
    intro v i
    fin_cases v
    · exact hbalanceF eInf heInf i
    · exact hbalanceT e₂ he₂ i
    · exact hbalanceT e₃ he₃ i
  have hnegative := balanced_exponent_contradiction r q (threePlaceExponents eInf e₂ e₃) c
    D η ρ (C + Real.log K) q₀ hm hd hD hρ (add_nonneg hC (Real.log_nonneg hK)) hq₀
    hr her hscale hbalance hc hη hR hqLarge hDLarge
  rw [threePlaceExponents_sum] at hnegative
  have hexp : Real.exp ((C + Real.log K) * (∑ h, (r h : ℝ)) + blockExponentSum (c 0) q eInf +
      blockExponentSum (c 1) q e₂ + blockExponentSum (c 2) q e₃) < 1 := by
    apply Real.exp_lt_one_iff.mpr
    simpa only [add_assoc] using hnegative
  have hlower := integer_three_place_product_lower (MvPolynomial.eval x T) hne
  exact (not_lt_of_ge hlower) (hupper.trans_lt hexp)

def inverseBlockPolynomial {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (T : MvPolynomial (Fin m × Fin d) ℤ) :
    MvPolynomial (Fin m × Fin d) ℚ :=
  rationalBlockLinearSubstitution (inverseBlockMatrices A) (MvPolynomial.map (Int.castRingHom ℚ) T)

/-- Specialization to actual invertible rational block matrices at infinity.
The two finite places still evaluate the original integer polynomial. -/
def inverse_block_three_place_polynomial_contradiction {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, IsUnit (A h).det)
    (T : MvPolynomial (Fin m × Fin d) ℤ) (x : Fin m × Fin d → ℤ)
    (hne : MvPolynomial.eval x T ≠ 0)
    (r : Fin m → ℕ) (q : Fin m → ℝ) (c : Fin 3 → Fin d → ℝ) (D η ρ C K q₀ : ℝ)
    (hm : 0 < m) (hd : 0 < d) (hD : 0 < D) (hρ : 0 < ρ) (hC : 0 ≤ C)
    (hK : 1 ≤ K) (hq₀ : 0 < q₀) (hr : ∀ h, 0 < r h)
    (hdegreeF : ∀ e ∈ (inverseBlockPolynomial A T).support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hdegreeT : ∀ e ∈ T.support, ∀ h, ∑ i, e (h, i) ≤ r h)
    (hbalanceF : ∀ e ∈ (inverseBlockPolynomial A T).support, ∀ i : Fin d,
      |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hbalanceT : ∀ e ∈ T.support, ∀ i : Fin d,
      |(∑ h : Fin m, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * m * η)
    (hscale : ∀ h, |(r h : ℝ) * q h - D| ≤ q h)
    (hheight : Real.log (polynomialCoeffL1 (inverseBlockPolynomial A T)) ≤ C * ∑ h, (r h : ℝ))
    (hy : ∀ h i, ‖blockMatrixValues A (fun hi => (x hi : ℚ)) (h, i)‖ ≤
      K * Real.exp (c 0 i * q h))
    (hx₂ : ∀ h i, (padicNorm 2 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 1 i * q h))
    (hx₃ : ∀ h i, (padicNorm 3 (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c 2 i * q h))
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (hη : η ≤ ρ / (8 * (d : ℝ) * exponentCoefficientMass c))
    (hR : (∑ h, (r h : ℝ)) ≤ 2 * D / q₀)
    (hqLarge : 8 * (d : ℝ) * (C + Real.log K) ≤ (m : ℝ) * ρ * q₀)
    (hDLarge : 4 * (d : ℝ) * exponentCoefficientMass c * (∑ h, q h) ≤ (m : ℝ) * ρ * D) :
    False := by
  exact actual_three_place_polynomial_contradiction T (inverseBlockPolynomial A T)
    x (blockMatrixValues A (fun hi => (x hi : ℚ)))
    (inverse_block_substitution_eval A hA T x) hne r q c D η ρ C K q₀
    hm hd hD hρ hC hK hq₀ hr hdegreeF hdegreeT hbalanceF hbalanceT hscale hheight
    hy hx₂ hx₃ hc hη hR hqLarge hDLarge


end
end Bounty

end SubmissionComponent_ActualThreePlacePolynomialContradiction

/- Component TwoBasisBalancedAuxiliary; SHA256 a9090b89e1ca3dd9ded374ffb3c77455ac89b5510bdd69ba81bdd001e3336526 -/
section SubmissionComponent_TwoBasisBalancedAuxiliary
/- Balanced integer auxiliaries in the inverse archimedean basis and the identity basis. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def threePlaceAuxiliaryBases {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) :
    Fin 2 → Fin m → Matrix (Fin d) (Fin d) ℚ :=
  ![inverseBlockMatrices A, fun _ => 1]

structure ThreePlaceDerivativeBounds {m d : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (r : Fin m → ℕ) (η L : ℝ)
    (T : MvPolynomial (Fin m × Fin d) ℤ) : Prop where
  degreeInf : ∀ e ∈ (inverseBlockPolynomial A T).support, ∀ h, ∑ i, e (h, i) ≤ r h
  degreeInt : ∀ e ∈ T.support, ∀ h, ∑ i, e (h, i) ≤ r h
  balanceInf : ∀ e ∈ (inverseBlockPolynomial A T).support, ∀ i : Fin d,
    |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * (m : ℝ) * η
  balanceInt : ∀ e ∈ T.support, ∀ i : Fin d,
    |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * (m : ℝ) * η
  heightInf : Real.log (polynomialCoeffL1 (inverseBlockPolynomial A T)) ≤
    L * (∑ h, (r h : ℝ))

def exists_two_basis_balanced_auxiliary {m d : ℕ} (hm : 0 < m) (hd : 0 < d)
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ) (hA : ∀ h, IsUnit (A h).det) :
    ∃ K L : ℝ, 0 ≤ K ∧ 0 ≤ L ∧
      ∀ (r : Fin m → ℕ), (∀ h, 0 < r h) →
      ∀ η : ℝ, 0 ≤ η → 8 * (d : ℝ) ≤ (m : ℝ) * η ^ 2 →
      ∃ P : MvPolynomial (Fin m × Fin d) ℤ, P ≠ 0 ∧ ProductBlockHomogeneous r P ∧
        Real.log (polynomialCoeffL1 P) ≤ K * (∑ h, (r h : ℝ)) ∧
        ∀ t : List (Fin m × Fin d), blockDerivativeWeight r t ≤ (m : ℝ) * η →
          dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P) ≠ 0 →
          ∃ T : MvPolynomial (Fin m × Fin d) ℤ, T ≠ 0 ∧
            MvPolynomial.map (Int.castRingHom ℚ) T =
              dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P) ∧
            ThreePlaceDerivativeBounds A r η L T := by
  classical
  have hB : ∀ v h, (threePlaceAuxiliaryBases A v h).det ≠ 0 := by
    intro v h
    fin_cases v
    · exact (Matrix.isUnit_nonsing_inv_det (A h) (hA h)).ne_zero
    · simp [threePlaceAuxiliaryBases]
  obtain ⟨K, L, hK, hL, haux⟩ := exists_balanced_integer_derivative_auxiliary
    hm hd (threePlaceAuxiliaryBases A) hB
  refine ⟨K, L, hK, hL, ?_⟩
  intro r hr η hη hlarge
  have hlarge' : 4 * (2 : ℝ) * d ≤ (m : ℝ) * η ^ 2 := by norm_num; exact hlarge
  obtain ⟨P, hP, hhom, hheight, hderiv⟩ := haux r hr η hη hlarge'
  refine ⟨P, hP, hhom, hheight, ?_⟩
  intro t ht htne
  obtain ⟨T, hT, hTmap, hbounds⟩ := hderiv t ht htne
  have hInf := hbounds 0
  have hInt := hbounds 1
  change (∀ e ∈ (inverseBlockPolynomial A T).support,
      (∀ h, ∑ i, e (h, i) ≤ r h) ∧
      ∀ i, |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * (m : ℝ) * η) ∧
    Real.log (polynomialCoeffL1 (inverseBlockPolynomial A T)) ≤ L * (∑ h, (r h : ℝ)) at hInf
  have hInt' : ∀ e ∈ T.support,
      (∀ h, ∑ i, e (h, i) ≤ r h) ∧
      ∀ i, |(∑ h, (e (h, i) : ℝ) / r h) - (m : ℝ) / d| ≤ 2 * (m : ℝ) * η := by
    intro e he
    have hmap : e ∈ (MvPolynomial.map (Int.castRingHom ℚ) T).support := by
      rw [MvPolynomial.support_map_of_injective _ Int.cast_injective]
      exact he
    have hh := hInt.1 e
    simpa only [threePlaceAuxiliaryBases, Matrix.cons_val_one, Matrix.cons_val_zero,
      rationalBlockLinearSubstitution_one] using hh (by simpa [threePlaceAuxiliaryBases, rationalBlockLinearSubstitution_one] using hmap)
  refine ⟨T, hT, hTmap, ?_⟩
  exact ⟨fun e he => (hInf.1 e he).1, fun e he => (hInt' e he).1,
    fun e he => (hInf.1 e he).2, fun e he => (hInt' e he).2, hInf.2⟩


end
end Bounty

end SubmissionComponent_TwoBasisBalancedAuxiliary

/- Component LinearParametrizationGridDerivative; SHA256 4d07eb4b75a2218bb6326c7d27926a0aadb57961461642cf53c1ae7ea422548c -/
section SubmissionComponent_LinearParametrizationGridDerivative
/- Actual coordinate derivatives detected on a bounded grid after a rectangular
linear parametrization.  No inverse or injectivity of the parametrization is
assumed. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def rationalLinearParametrization {I J : Type*} [Fintype J]
    (A : I → J → ℚ) (i : I) : MvPolynomial J ℚ :=
  ∑ j, MvPolynomial.C (A i j) * MvPolynomial.X j

def rationalLinearSubstitution {I J : Type*} [Fintype J]
    (A : I → J → ℚ) : MvPolynomial I ℚ →ₐ[ℚ] MvPolynomial J ℚ :=
  MvPolynomial.aeval (rationalLinearParametrization A)

def rationalLinearPoint {I J : Type*} [Fintype J]
    (A : I → J → ℚ) (z : J → ℚ) (i : I) : ℚ := ∑ j, A i j * z j

def eval_rationalLinearParametrization {I J : Type*} [Fintype J]
    (A : I → J → ℚ) (z : J → ℚ) (i : I) :
    MvPolynomial.eval z (rationalLinearParametrization A i) = rationalLinearPoint A z i := by
  simp [rationalLinearParametrization, rationalLinearPoint]

def eval_rationalLinearSubstitution {I J : Type*} [Fintype J]
    (A : I → J → ℚ) (z : J → ℚ) (P : MvPolynomial I ℚ) :
    MvPolynomial.eval z (rationalLinearSubstitution A P) =
      MvPolynomial.eval (rationalLinearPoint A z) P := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [rationalLinearSubstitution]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP =>
    simp only [rationalLinearSubstitution] at hP
    simp only [map_mul, rationalLinearSubstitution, MvPolynomial.aeval_X, hP,
      eval_rationalLinearParametrization, MvPolynomial.eval_X]

def pderiv_rationalLinearParametrization {I J : Type*} [Fintype J]
    (A : I → J → ℚ) (i : I) (j : J) :
    MvPolynomial.pderiv j (rationalLinearParametrization A i) = MvPolynomial.C (A i j) := by
  classical
  simp [rationalLinearParametrization, MvPolynomial.pderiv_X,
    Pi.single_apply]

def pderiv_rationalLinearSubstitution {I J : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℚ) (j : J) (P : MvPolynomial I ℚ) :
    MvPolynomial.pderiv j (rationalLinearSubstitution A P) =
      ∑ i, MvPolynomial.C (A i j) * rationalLinearSubstitution A (MvPolynomial.pderiv i P) := by
  rw [rationalLinearSubstitution, pderiv_aeval_eq_sum_pderiv]
  simp only [pderiv_rationalLinearParametrization]

def wordPDeriv_C_mul {I : Type*} (s : List I) (c : ℚ) (P : MvPolynomial I ℚ) :
    wordPDeriv s (MvPolynomial.C c * P) = MvPolynomial.C c * wordPDeriv s P := by
  simpa only [MvPolynomial.smul_eq_C_mul] using (wordPDeriv s).map_smul c P

def eval_dividedWordPDeriv_ne_zero_iff {I : Type*} [Fintype I] [DecidableEq I]
    (z : I → ℚ) (s : List I) (P : MvPolynomial I ℚ) :
    MvPolynomial.eval z (dividedWordPDeriv s P) ≠ 0 ↔
      MvPolynomial.eval z (wordPDeriv s P) ≠ 0 := by
  change MvPolynomial.eval z ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P) ≠ 0 ↔ _
  simp only [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.eval_C]
  exact mul_ne_zero_iff.trans (and_iff_right (inv_ne_zero (wordDerivativeFactorial_ne_zero s)))

/-- A nonzero parameter derivative contains an actual source coordinate
derivative with the identical sequence of block labels. -/
def rationalLinearSubstitution_wordPDeriv_detection
    {I J H : Type*} [Fintype I] [Fintype J]
    (A : I → J → ℚ) (qI : I → H) (qJ : J → H)
    (hA : ∀ i j, A i j ≠ 0 → qI i = qJ j)
    (z : J → ℚ) (s : List J) (P : MvPolynomial I ℚ)
    (hne : MvPolynomial.eval z (wordPDeriv s (rationalLinearSubstitution A P)) ≠ 0) :
    ∃ t : List I, t.map qI = s.map qJ ∧
      MvPolynomial.eval (rationalLinearPoint A z) (wordPDeriv t P) ≠ 0 := by
  classical
  induction s using List.reverseRecOn generalizing P with
  | nil => exact ⟨[], rfl, by simpa [wordPDeriv_nil, eval_rationalLinearSubstitution] using hne⟩
  | append_singleton s j ih =>
    simp only [wordPDeriv_append, wordPDeriv_cons, wordPDeriv_nil,
      pderiv_rationalLinearSubstitution, map_sum, wordPDeriv_C_mul, map_mul,
      MvPolynomial.eval_C] at hne
    obtain ⟨i, _, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    obtain ⟨t, ht, hnonzero⟩ := ih (MvPolynomial.pderiv i P) (right_ne_zero_of_mul hi)
    refine ⟨t ++ [i], ?_, ?_⟩
    · simp only [List.map_append, List.map_cons, List.map_nil, ht,
        hA i j (left_ne_zero_of_mul hi)]
    · simpa only [wordPDeriv_append, wordPDeriv_cons, wordPDeriv_nil] using hnonzero

def rationalLinearSubstitution_dividedWordPDeriv_detection
    {I J H : Type*} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (A : I → J → ℚ) (qI : I → H) (qJ : J → H)
    (hA : ∀ i j, A i j ≠ 0 → qI i = qJ j)
    (z : J → ℚ) (s : List J) (P : MvPolynomial I ℚ)
    (hne : MvPolynomial.eval z (dividedWordPDeriv s (rationalLinearSubstitution A P)) ≠ 0) :
    ∃ t : List I, t.map qI = s.map qJ ∧
      MvPolynomial.eval (rationalLinearPoint A z) (dividedWordPDeriv t P) ≠ 0 := by
  obtain ⟨t, ht, hne'⟩ := rationalLinearSubstitution_wordPDeriv_detection A qI qJ hA z s P
    ((eval_dividedWordPDeriv_ne_zero_iff z s _).mp hne)
  exact ⟨t, ht, (eval_dividedWordPDeriv_ne_zero_iff _ t P).mpr hne'⟩

def linearParametrization_wordPDeriv_rename {I J : Type*} (f : I → J) (hf : Function.Injective f)
    (s : List I) (P : MvPolynomial I ℚ) :
    wordPDeriv (s.map f) (MvPolynomial.rename f P) = MvPolynomial.rename f (wordPDeriv s P) := by
  induction s with
  | nil => rfl
  | cons i s ih => simp only [List.map_cons, wordPDeriv_cons, ih, MvPolynomial.pderiv_rename hf]

/-- The checked finite grid theorem, transported to any finite variable type. -/
def exists_fintype_bounded_grid_dividedWordPDeriv_ne_zero
    {J : Type*} [Fintype J] [DecidableEq J]
    (P : MvPolynomial J ℚ) (hP : P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ (z : J → ℕ) (s : List J), (∀ j, z j ≤ B) ∧
      (∀ j, s.count j ≤ P.degreeOf j / B) ∧
      MvPolynomial.eval (fun j => (z j : ℚ)) (dividedWordPDeriv s P) ≠ 0 := by
  classical
  let e := Fintype.equivFin J
  let Q := MvPolynomial.rename e P
  have hQ : Q ≠ 0 := by
    intro hh
    apply hP
    apply MvPolynomial.rename_injective e e.injective
    simpa only [map_zero] using hh
  obtain ⟨z, s, hz, hs, hne⟩ := exists_bounded_grid_dividedWordPDeriv_ne_zero _ Q hQ B hB
  refine ⟨fun j => z (e j), s.map e.symm, fun j => hz (e j), ?_, ?_⟩
  · intro j
    have hc : (s.map e.symm).count j = s.count (e j) := by
      simpa only [Equiv.symm_apply_apply] using List.count_map_of_injective s e.symm e.symm.injective (e j)
    rw [hc]
    simpa only [Q, MvPolynomial.degreeOf_rename_of_injective e.injective] using hs (e j)
  · apply (eval_dividedWordPDeriv_ne_zero_iff _ _ _).mpr
    have hne' := (eval_dividedWordPDeriv_ne_zero_iff _ _ _).mp hne
    have hback : MvPolynomial.rename e.symm Q = P := by simp [Q, MvPolynomial.rename_rename]
    rw [← hback, linearParametrization_wordPDeriv_rename e.symm e.symm.injective]
    simpa only [MvPolynomial.eval_rename, Function.comp_def, Equiv.apply_symm_apply] using hne'

def sum_count_mul_eq_sum_map {J : Type*} [Fintype J] [DecidableEq J]
    (s : List J) (w : J → ℝ) :
    (∑ j, (s.count j : ℝ) * w j) = (s.map w).sum := by
  classical
  induction s with
  | nil => simp
  | cons a s ih =>
    have hc (j : J) : ((a :: s).count j : ℝ) =
        (if j = a then 1 else 0) + (s.count j : ℝ) := by
      by_cases hj : j = a
      · subst j; simp; ring
      · simp [hj, Ne.symm hj]
    simp only [hc, add_mul, Finset.sum_add_distrib, ih, List.map_cons, List.sum_cons]
    simp

def sum_count_div_eq_of_map_eq {I J H : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (qI : I → H) (qJ : J → H) (r : H → ℕ)
    (t : List I) (s : List J) (ht : t.map qI = s.map qJ) :
    (∑ i, (t.count i : ℝ) / r (qI i)) = ∑ j, (s.count j : ℝ) / r (qJ j) := by
  simp only [div_eq_mul_inv]
  rw [sum_count_mul_eq_sum_map, sum_count_mul_eq_sum_map]
  have hh := congrArg (fun l : List H => (l.map (fun h => ((r h : ℝ)⁻¹))).sum) ht
  simpa only [List.map_map, Function.comp_def] using hh

/-- A nonzero polynomial on a linear parametrization has a nonzero actual
coordinate divided derivative at a bounded parameter grid point.  The extra
weight is bounded by the sum of the parameter degrees divided by the grid
size and the corresponding block degree. -/
def exists_linearParametrization_bounded_grid_derivative
    {I J H : Type*} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (A : I → J → ℚ) (qI : I → H) (qJ : J → H)
    (hA : ∀ i j, A i j ≠ 0 → qI i = qJ j)
    (r : H → ℕ) (P : MvPolynomial I ℚ)
    (hP : rationalLinearSubstitution A P ≠ 0) (B : ℕ) (hB : 0 < B) :
    ∃ (z : J → ℕ) (t : List I), (∀ j, z j ≤ B) ∧
      MvPolynomial.eval (rationalLinearPoint A (fun j => (z j : ℚ)))
        (dividedWordPDeriv t P) ≠ 0 ∧
      (∑ i, (t.count i : ℝ) / r (qI i)) ≤
        ∑ j, ((rationalLinearSubstitution A P).degreeOf j : ℝ) / ((B : ℝ) * r (qJ j)) := by
  obtain ⟨z, s, hz, hs, hne⟩ :=
    exists_fintype_bounded_grid_dividedWordPDeriv_ne_zero _ hP B hB
  obtain ⟨t, ht, hnonzero⟩ :=
    rationalLinearSubstitution_dividedWordPDeriv_detection A qI qJ hA _ s P hne
  refine ⟨z, t, hz, hnonzero, ?_⟩
  rw [sum_count_div_eq_of_map_eq qI qJ r t s ht]
  apply Finset.sum_le_sum
  intro j _
  have hc : (s.count j : ℝ) ≤ (rationalLinearSubstitution A P).degreeOf j / (B : ℝ) :=
    (show (s.count j : ℝ) ≤ ((rationalLinearSubstitution A P).degreeOf j / B : ℕ) by
      exact_mod_cast hs j).trans Nat.cast_div_le
  calc
    _ ≤ (((rationalLinearSubstitution A P).degreeOf j : ℝ) / B) / r (qJ j) :=
      div_le_div_of_nonneg_right hc (Nat.cast_nonneg _)
    _ = _ := div_div _ _ _

def blockDerivativeWeight_eq_sum_count_div {m d : ℕ} (r : Fin m → ℕ)
    (s : List (Fin m × Fin d)) :
    blockDerivativeWeight r s = ∑ i : Fin m × Fin d, (s.count i : ℝ) / r i.1 := by
  simp only [blockDerivativeWeight, derivativeBlockCount, wordDerivativeCounts_apply,
    Nat.cast_sum, Finset.sum_div, Fintype.sum_prod_type, List.count_eq_countP,
    Bool.beq_eq_decide_eq]

def exists_blockLinearParametrization_bounded_grid_derivative {m d e : ℕ}
    (A : (Fin m × Fin d) → (Fin m × Fin e) → ℚ)
    (hA : ∀ i j, A i j ≠ 0 → i.1 = j.1)
    (r : Fin m → ℕ) (hr : ∀ h, 0 < r h)
    (P : MvPolynomial (Fin m × Fin d) ℚ)
    (hP : rationalLinearSubstitution A P ≠ 0)
    (hdeg : ∀ j, (rationalLinearSubstitution A P).degreeOf j ≤ r j.1)
    (B : ℕ) (hB : 0 < B) :
    ∃ (z : (Fin m × Fin e) → ℕ) (t : List (Fin m × Fin d)),
      (∀ j, z j ≤ B) ∧
      MvPolynomial.eval (rationalLinearPoint A (fun j => (z j : ℚ)))
        (dividedWordPDeriv t P) ≠ 0 ∧
      blockDerivativeWeight r t ≤ (m : ℝ) * e / B := by
  obtain ⟨z, t, hz, hne, hweight⟩ :=
    exists_linearParametrization_bounded_grid_derivative A Prod.fst Prod.fst hA r P hP B hB
  refine ⟨z, t, hz, hne, ?_⟩
  rw [blockDerivativeWeight_eq_sum_count_div]
  simp only [List.count_eq_countP, Bool.beq_eq_decide_eq] at hweight ⊢
  apply hweight.trans
  calc
    _ ≤ ∑ _j : Fin m × Fin e, (1 : ℝ) / B := by
      apply Finset.sum_le_sum
      intro j _
      have hrj : (0 : ℝ) < r j.1 := by exact_mod_cast hr j.1
      have hBr : (0 : ℝ) < B := by exact_mod_cast hB
      calc
        _ ≤ (r j.1 : ℝ) / ((B : ℝ) * r j.1) :=
          div_le_div_of_nonneg_right (by exact_mod_cast hdeg j) (le_of_lt (mul_pos hBr hrj))
        _ = _ := by field_simp
    _ = _ := by simp [Fintype.card_prod, Nat.cast_mul, div_eq_mul_inv, mul_assoc]

/-- Composing divided coordinate derivatives changes the concatenated divided
derivative only by a nonzero rational factor, hence preserves evaluated
nonvanishing. -/
def eval_dividedWordPDeriv_comp_ne_zero_iff {I : Type*} [Fintype I] [DecidableEq I]
    (z : I → ℚ) (t s : List I) (P : MvPolynomial I ℚ) :
    MvPolynomial.eval z (dividedWordPDeriv t (dividedWordPDeriv s P)) ≠ 0 ↔
      MvPolynomial.eval z (dividedWordPDeriv (t ++ s) P) ≠ 0 := by
  rw [eval_dividedWordPDeriv_ne_zero_iff, eval_dividedWordPDeriv_ne_zero_iff,
    wordPDeriv_append]
  change MvPolynomial.eval z (wordPDeriv t ((wordDerivativeFactorial s)⁻¹ • wordPDeriv s P)) ≠ 0 ↔ _
  rw [map_smul, MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.eval_C]
  exact mul_ne_zero_iff.trans (and_iff_right (inv_ne_zero (wordDerivativeFactorial_ne_zero s)))

def blockDerivativeWeight_append {m d : ℕ} (r : Fin m → ℕ)
    (t s : List (Fin m × Fin d)) :
    blockDerivativeWeight r (t ++ s) = blockDerivativeWeight r t + blockDerivativeWeight r s := by
  simp only [blockDerivativeWeight_eq_sum_count_div, List.count_append,
    Nat.cast_add, add_div, Finset.sum_add_distrib]


end
end Bounty

end SubmissionComponent_LinearParametrizationGridDerivative

/- Component SpanningGridDerivative; SHA256 73ab8f53bac50f59990a474549f20588fd8431f313816c3ee4affd26f2a91b01 -/
section SubmissionComponent_SpanningGridDerivative
/- A bounded integer combination of spanning hyperplane vectors detects an
actual divided coordinate derivative, with its full normalized weight bounded
by the Roth index estimate plus the explicit grid loss. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def weightedHomogeneous_aeval_between {I J : Type*}
    (w : I → ℕ) (v : J → ℕ) (g : I → MvPolynomial J ℚ)
    (hg : ∀ i, MvPolynomial.IsWeightedHomogeneous v (g i) (w i))
    (P : MvPolynomial I ℚ) (n : ℕ) (hP : MvPolynomial.IsWeightedHomogeneous w P n) :
    MvPolynomial.IsWeightedHomogeneous v (MvPolynomial.aeval g P) n := by
  classical
  nth_rw 1 [MvPolynomial.as_sum P]
  rw [map_sum]
  apply MvPolynomial.IsWeightedHomogeneous.sum
  intro a ha
  rw [MvPolynomial.aeval_monomial]
  change MvPolynomial.IsWeightedHomogeneous v
    (MvPolynomial.C (MvPolynomial.coeff a P) * a.prod (fun i b => g i ^ b)) n
  have hprod := MvPolynomial.IsWeightedHomogeneous.prod a.support
    (fun i => g i ^ a i) (fun i => a i • w i) (fun i _ => (hg i).pow (a i))
  have hsum : ∑ i ∈ a.support, a i • w i = n := hP (MvPolynomial.mem_support_iff.mp ha)
  rw [hsum] at hprod
  exact hprod.C_mul _

def productBlockHomogeneous_integer_map {m d : ℕ}
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) ℤ)
    (hP : ProductBlockHomogeneous r P) :
    ProductBlockHomogeneous r (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  intro a ha
  apply hP a
  rw [MvPolynomial.mem_support_iff] at ha ⊢
  intro hz
  exact ha (by simp [MvPolynomial.coeff_map, hz])

def productBlockHomogeneous_dividedWordPDeriv {m d : ℕ}
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) ℚ)
    (hP : ProductBlockHomogeneous r P) (s : List (Fin m × Fin d)) :
    ProductBlockHomogeneous (fun h => r h - derivativeBlockCount s h) (dividedWordPDeriv s P) := by
  intro a ha h
  have hc := MvPolynomial.mem_support_iff.mp ha
  rw [coeff_dividedWordPDeriv] at hc
  have hh := hP (a + wordDerivativeCounts s)
    (MvPolynomial.mem_support_iff.mpr (left_ne_zero_of_mul hc)) h
  simp only [Finsupp.add_apply, Finset.sum_add_distrib] at hh
  change (∑ i, a (h, i)) + derivativeBlockCount s h = r h at hh
  change (∑ i, a (h, i)) = r h - derivativeBlockCount s h
  omega

def blockSpanningSubstitution_homogeneous {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (hP : ProductBlockHomogeneous r P) :
    ProductBlockHomogeneous r (blockSpanningSubstitution y P) := by
  apply (productBlockHomogeneous_iff_weighted r _).mpr
  intro h
  apply weightedHomogeneous_aeval_between (productBlockWeight h) (productBlockWeight h)
  · intro x
    apply MvPolynomial.IsWeightedHomogeneous.sum
    intro j _
    exact (MvPolynomial.isWeightedHomogeneous_X ℚ (productBlockWeight h) (x.1, j)).C_mul _
  · exact (productBlockHomogeneous_iff_weighted r P).mp hP h

def productBlockHomogeneous_degreeOf_le {m d : ℕ}
    (r : Fin m → ℕ) (P : MvPolynomial (Fin m × Fin d) ℚ)
    (hP : ProductBlockHomogeneous r P) (x : Fin m × Fin d) :
    P.degreeOf x ≤ r x.1 := by
  apply MvPolynomial.degreeOf_le_iff.mpr
  intro a ha
  exact (Finset.single_le_sum (fun i _ => Nat.zero_le (a (x.1, i)))
    (Finset.mem_univ x.2)).trans_eq (hP a ha x.1)

def blockSpanningSubstitution_dividedWordPDeriv_degreeOf_le {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (r : Fin m → ℕ)
    (P : MvPolynomial (Fin m × Fin d) ℚ) (hP : ProductBlockHomogeneous r P)
    (s : List (Fin m × Fin d)) (x : Fin m × Fin k) :
    (blockSpanningSubstitution y (dividedWordPDeriv s P)).degreeOf x ≤ r x.1 := by
  exact (productBlockHomogeneous_degreeOf_le _ _
    (blockSpanningSubstitution_homogeneous y _ _ (productBlockHomogeneous_dividedWordPDeriv r P hP s)) x).trans
      (Nat.sub_le _ _)

def blockSpanningMatrix {m d k : ℕ} (y : Fin m → Fin k → Fin d → ℚ)
    (x : Fin m × Fin d) (z : Fin m × Fin k) : ℚ :=
  if x.1 = z.1 then y x.1 z.2 x.2 else 0

def blockSpanningMatrix_block {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (x : Fin m × Fin d) (z : Fin m × Fin k)
    (h : blockSpanningMatrix y x z ≠ 0) : x.1 = z.1 := by
  by_contra hh
  exact h (if_neg hh)

def rationalLinearSubstitution_blockSpanningMatrix {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (P : MvPolynomial (Fin m × Fin d) ℚ) :
    rationalLinearSubstitution (blockSpanningMatrix y) P = blockSpanningSubstitution y P := by
  have hg (x : Fin m × Fin d) : rationalLinearParametrization (blockSpanningMatrix y) x =
      ∑ j, MvPolynomial.C (y x.1 j x.2) * MvPolynomial.X (x.1, j) := by
    classical
    simp only [rationalLinearParametrization, blockSpanningMatrix, Fintype.sum_prod_type]
    simp_rw [apply_ite MvPolynomial.C, map_zero, ite_mul, zero_mul]
    simp
  exact congrArg (fun g : (Fin m × Fin d) → MvPolynomial (Fin m × Fin k) ℚ =>
    MvPolynomial.aeval g P) (funext hg)

def blockSpanningPoint {m d k : ℕ} (y : Fin m → Fin k → Fin d → ℚ)
    (z : Fin m → Fin k → ℕ) (x : Fin m × Fin d) : ℚ :=
  ∑ j, (z x.1 j : ℚ) * y x.1 j x.2

def rationalLinearPoint_blockSpanningMatrix {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℚ) (z : (Fin m × Fin k) → ℕ) :
    rationalLinearPoint (blockSpanningMatrix y) (fun x => (z x : ℚ)) =
      blockSpanningPoint y (fun h j => z (h, j)) := by
  classical
  funext x
  simp [rationalLinearPoint, blockSpanningMatrix, Fintype.sum_prod_type,
    blockSpanningPoint, mul_comm]

def product_hyperplane_bounded_grid_derivative {n d k : ℕ} (hd : 1 ≤ d)
    (b : Fin (n + 1) → Fin (d + 1) → ℚ) (p : Fin (n + 1) → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (r : Fin (n + 1) → ℕ) (hr : ∀ h, 0 < r h)
    (y : Fin (n + 1) → Fin k → Fin (d + 1) → ℚ)
    (hy : ∀ h, Submodule.span ℚ (Set.range (y h)) = rationalHyperplaneKernel (b h))
    (P : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ h, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d)))
    (B : ℕ) (hB : 0 < B) :
    ∃ (z : Fin (n + 1) → Fin k → ℕ) (t : List (Fin (n + 1) × Fin (d + 1))),
      (∀ h j, z h j ≤ B) ∧
      MvPolynomial.eval (blockSpanningPoint y z)
        (dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0 ∧
      blockDerivativeWeight r t ≤ 2 * (n + 1 : ℕ) * η + (n + 1 : ℕ) * k / (B : ℝ) := by
  obtain ⟨s, hs, hne⟩ := product_hyperplane_derivative_spanning hd b p hp r hr y hy
    P hP hhom η hη hηhalf hstep hheight
  let Q := MvPolynomial.map (Int.castRingHom ℚ) P
  have hQ : ProductBlockHomogeneous r Q := productBlockHomogeneous_integer_map r P hhom
  have hparam : rationalLinearSubstitution (blockSpanningMatrix y) (dividedWordPDeriv s Q) ≠ 0 := by
    simpa only [rationalLinearSubstitution_blockSpanningMatrix] using hne
  have hdeg (x : Fin (n + 1) × Fin k) :
      (rationalLinearSubstitution (blockSpanningMatrix y) (dividedWordPDeriv s Q)).degreeOf x ≤ r x.1 := by
    rw [rationalLinearSubstitution_blockSpanningMatrix]
    exact blockSpanningSubstitution_dividedWordPDeriv_degreeOf_le y r Q hQ s x
  obtain ⟨z, t, hz, htne, htweight⟩ := exists_blockLinearParametrization_bounded_grid_derivative
    (blockSpanningMatrix y) (blockSpanningMatrix_block y) r hr (dividedWordPDeriv s Q)
      hparam hdeg B hB
  refine ⟨fun h j => z (h, j), t ++ s, fun h j => hz (h, j), ?_, ?_⟩
  · rw [rationalLinearPoint_blockSpanningMatrix] at htne
    exact (eval_dividedWordPDeriv_comp_ne_zero_iff _ t s Q).mp htne
  · rw [blockDerivativeWeight_append]
    linarith


end
end Bounty

end SubmissionComponent_SpanningGridDerivative

/- Component IntegerHyperplaneGrid; SHA256 430330693af6be165db67f46f58fc3782a6bdd1d398c69535b478fd895db86de -/
section SubmissionComponent_IntegerHyperplaneGrid
/- Integer grid points, actual nonzero integer evaluations, and archimedean
and finite-place bounds for their rational linear forms. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def integerLinearCombination {d k : ℕ} (y : Fin k → Fin d → ℤ)
    (z : Fin k → ℕ) (i : Fin d) : ℤ := ∑ j, (z j : ℤ) * y j i

def integerBlockSpanningPoint {m d k : ℕ} (y : Fin m → Fin k → Fin d → ℤ)
    (z : Fin m → Fin k → ℕ) (x : Fin m × Fin d) : ℤ :=
  integerLinearCombination (y x.1) (z x.1) x.2

def integerBlockSpanningPoint_cast {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℤ) (z : Fin m → Fin k → ℕ) :
    (fun x => (integerBlockSpanningPoint y z x : ℚ)) =
      blockSpanningPoint (fun h j i => (y h j i : ℚ)) z := by
  funext x
  simp [integerBlockSpanningPoint, integerLinearCombination, blockSpanningPoint]

def integer_eval_map_cast {I : Type*} (T : MvPolynomial I ℤ) (x : I → ℤ) :
    MvPolynomial.eval (fun i => (x i : ℚ)) (MvPolynomial.map (Int.castRingHom ℚ) T) =
      (MvPolynomial.eval x T : ℚ) := by
  simpa only [Int.coe_castRingHom, Function.comp_def] using
    (MvPolynomial.map_eval (Int.castRingHom ℚ) x T).symm

def integer_grid_derivative_eval_ne_zero {m d k : ℕ}
    (y : Fin m → Fin k → Fin d → ℤ) (z : Fin m → Fin k → ℕ)
    (P T : MvPolynomial (Fin m × Fin d) ℤ) (s : List (Fin m × Fin d))
    (hT : MvPolynomial.map (Int.castRingHom ℚ) T =
      dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P))
    (hne : MvPolynomial.eval (blockSpanningPoint (fun h j i => (y h j i : ℚ)) z)
      (dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P)) ≠ 0) :
    MvPolynomial.eval (integerBlockSpanningPoint y z) T ≠ 0 := by
  rw [← hT, ← integerBlockSpanningPoint_cast, integer_eval_map_cast] at hne
  exact_mod_cast hne

def integerLinearCombination_linear_form {d k : ℕ} (a : Fin d → ℚ)
    (y : Fin k → Fin d → ℤ) (z : Fin k → ℕ) :
    (∑ i, a i * (integerLinearCombination y z i : ℚ)) =
      ∑ j, (z j : ℚ) * (∑ i, a i * (y j i : ℚ)) := by
  simp only [integerLinearCombination, Int.cast_sum, Int.cast_mul, Int.cast_natCast,
    Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro i _
  ring

def rational_nat_combination_arch_bound {k : ℕ} (f : Fin k → ℚ)
    (z : Fin k → ℕ) (B : ℕ) (hz : ∀ j, z j ≤ B)
    (M : ℝ) (hf : ∀ j, |(f j : ℝ)| ≤ M) :
    |((∑ j, (z j : ℚ) * f j : ℚ) : ℝ)| ≤ (k : ℝ) * B * M := by
  simp only [Rat.cast_sum, Rat.cast_mul, Rat.cast_natCast]
  calc
    _ ≤ ∑ j, |(z j : ℝ) * (f j : ℝ)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : Fin k, (B : ℝ) * M := by
      apply Finset.sum_le_sum
      intro j _
      rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
      exact mul_le_mul (by exact_mod_cast hz j) (hf j) (abs_nonneg _) (Nat.cast_nonneg _)
    _ = _ := by simp [mul_assoc]

def padicNorm_real_sum_le {J : Type*} (p : ℕ) [Fact p.Prime]
    (S : Finset J) (f : J → ℚ) (M : ℝ) (hM : 0 ≤ M)
    (hf : ∀ j ∈ S, (padicNorm p (f j) : ℝ) ≤ M) :
    (padicNorm p (∑ j ∈ S, f j) : ℝ) ≤ M := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using hM
  | @insert a S ha ih =>
    rw [Finset.sum_insert ha]
    have hh : (padicNorm p (f a + ∑ j ∈ S, f j) : ℝ) ≤
        max (padicNorm p (f a) : ℝ) (padicNorm p (∑ j ∈ S, f j) : ℝ) := by
      exact_mod_cast (padicNorm.nonarchimedean (p := p) (q := f a) (r := ∑ j ∈ S, f j))
    exact hh.trans (max_le (hf a (Finset.mem_insert_self _ _))
      (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))))

/-- Integer coefficients cause no enlargement at any prime, including 2 and 3. -/
def rational_integer_combination_padic_bound {J : Type*} [Fintype J]
    (p : ℕ) [Fact p.Prime] (f : J → ℚ) (z : J → ℤ)
    (M : ℝ) (hM : 0 ≤ M) (hf : ∀ j, (padicNorm p (f j) : ℝ) ≤ M) :
    (padicNorm p (∑ j, (z j : ℚ) * f j) : ℝ) ≤ M := by
  apply padicNorm_real_sum_le p Finset.univ _ M hM
  intro j _
  rw [padicNorm.mul, Rat.cast_mul]
  have hz : (padicNorm p (z j : ℚ) : ℝ) ≤ 1 := by exact_mod_cast padicNorm.of_int (p := p) (z j)
  have hn : (0 : ℝ) ≤ padicNorm p (f j) := by exact_mod_cast padicNorm.nonneg (p := p) (f j)
  exact (mul_le_mul_of_nonneg_right hz hn).trans (by simpa using hf j)

def integerLinearCombination_arch_bound {d k : ℕ} (a : Fin d → ℚ)
    (y : Fin k → Fin d → ℤ) (z : Fin k → ℕ) (B : ℕ) (hz : ∀ j, z j ≤ B)
    (E : ℝ) (hy : ∀ j, |((∑ i, a i * (y j i : ℚ) : ℚ) : ℝ)| ≤ Real.exp E) :
    |((∑ i, a i * (integerLinearCombination y z i : ℚ) : ℚ) : ℝ)| ≤
      (k : ℝ) * B * Real.exp E := by
  rw [integerLinearCombination_linear_form]
  exact rational_nat_combination_arch_bound _ z B hz _ hy

def integerLinearCombination_padic_bound {d k : ℕ} (p : ℕ) [Fact p.Prime]
    (a : Fin d → ℚ) (y : Fin k → Fin d → ℤ) (z : Fin k → ℕ)
    (E : ℝ) (hy : ∀ j, (padicNorm p (∑ i, a i * (y j i : ℚ)) : ℝ) ≤ Real.exp E) :
    (padicNorm p (∑ i, a i * (integerLinearCombination y z i : ℚ)) : ℝ) ≤ Real.exp E := by
  rw [integerLinearCombination_linear_form]
  simpa only [Int.cast_natCast] using rational_integer_combination_padic_bound p
    (fun j => ∑ i, a i * (y j i : ℚ)) (fun j => (z j : ℤ)) _ (Real.exp_pos _).le hy

def integerBlockSpanningPoint_arch_bound {m d k : ℕ}
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ)
    (y : Fin m → Fin k → Fin d → ℤ) (z : Fin m → Fin k → ℕ)
    (B : ℕ) (hz : ∀ h j, z h j ≤ B) (c : Fin d → ℝ) (q : Fin m → ℝ)
    (hy : ∀ h j i, |((∑ a, A h i a * (y h j a : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c i * q h)) :
    ∀ h i, |((∑ a, A h i a * (integerBlockSpanningPoint y z (h, a) : ℚ) : ℚ) : ℝ)| ≤
      (k : ℝ) * B * Real.exp (c i * q h) := by
  intro h i
  exact integerLinearCombination_arch_bound (A h i) (y h) (z h) B (hz h) _ (fun j => hy h j i)

def integerBlockSpanningPoint_padic_bound {m d k : ℕ} (p : ℕ) [Fact p.Prime]
    (A : Fin m → Matrix (Fin d) (Fin d) ℚ)
    (y : Fin m → Fin k → Fin d → ℤ) (z : Fin m → Fin k → ℕ)
    (c : Fin d → ℝ) (q : Fin m → ℝ)
    (hy : ∀ h j i, (padicNorm p (∑ a, A h i a * (y h j a : ℚ)) : ℝ) ≤ Real.exp (c i * q h)) :
    ∀ h i, (padicNorm p (∑ a, A h i a * (integerBlockSpanningPoint y z (h, a) : ℚ)) : ℝ) ≤
      Real.exp (c i * q h) := by
  intro h i
  exact integerLinearCombination_padic_bound p (A h i) (y h) (z h) _ (fun j => hy h j i)

def product_hyperplane_integer_grid_derivative {n d k : ℕ} (hd : 1 ≤ d)
    (b : Fin (n + 1) → Fin (d + 1) → ℚ) (p : Fin (n + 1) → Fin (d + 1))
    (hp : ∀ h, b h (p h) ≠ 0) (r : Fin (n + 1) → ℕ) (hr : ∀ h, 0 < r h)
    (y : Fin (n + 1) → Fin k → Fin (d + 1) → ℤ)
    (hy : ∀ h, Submodule.span ℚ (Set.range (fun j i => (y h j i : ℚ))) = rationalHyperplaneKernel (b h))
    (P : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ) (hP : P ≠ 0)
    (hhom : ProductBlockHomogeneous r P)
    (η : ℝ) (hη : 0 < η) (hηhalf : η ≤ 1 / 2)
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ η ^ (2 ^ n) * r i.castSucc)
    (hheight : ∀ h, Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      η ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d)))
    (B : ℕ) (hB : 0 < B) :
    ∃ (z : Fin (n + 1) → Fin k → ℕ) (s : List (Fin (n + 1) × Fin (d + 1)))
      (T : MvPolynomial (Fin (n + 1) × Fin (d + 1)) ℤ),
      (∀ h j, z h j ≤ B) ∧
      MvPolynomial.map (Int.castRingHom ℚ) T =
        dividedWordPDeriv s (MvPolynomial.map (Int.castRingHom ℚ) P) ∧
      MvPolynomial.eval (integerBlockSpanningPoint y z) T ≠ 0 ∧
      blockDerivativeWeight r s ≤ 2 * (n + 1 : ℕ) * η + (n + 1 : ℕ) * k / (B : ℝ) := by
  obtain ⟨z, s, hz, hne, hweight⟩ := product_hyperplane_bounded_grid_derivative hd b p hp r hr
    (fun h j i => (y h j i : ℚ)) hy P hP hhom η hη hηhalf hstep hheight B hB
  obtain ⟨T, hT⟩ := exists_integer_dividedWordPDeriv s P
  exact ⟨z, s, T, hz, hT, integer_grid_derivative_eval_ne_zero y z P T s hT hne, hweight⟩


end
end Bounty

end SubmissionComponent_IntegerHyperplaneGrid

/- Component FiniteHyperplaneConfiguration; SHA256 5e56536ce4fa0c1765c5563b36db58022982373f82554ceed54e89e68b55238a -/
section SubmissionComponent_FiniteHyperplaneConfiguration
/- A concrete finite hyperplane configuration is excluded by the polynomial argument. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def exists_finite_hyperplane_configuration_constants {n d : ℕ} (hd : 1 ≤ d)
    (A : Fin (n + 1) → Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ)
    (hA : ∀ h, IsUnit (A h).det) :
    ∃ K L : ℝ, 0 ≤ K ∧ 0 ≤ L ∧
      ∀ (r : Fin (n + 1) → ℕ) (q : Fin (n + 1) → ℝ)
        (c : Fin 3 → Fin (d + 1) → ℝ) (D η ρ : ℝ) (B : ℕ),
      (∀ h, 0 < r h) → 0 < q 0 → 0 < D → 0 < ρ → 0 < η → η ≤ 1 / 2 →
      0 < B → (d : ℝ) / B ≤ η / 2 →
      8 * (d + 1 : ℕ) ≤ (n + 1 : ℕ) * η ^ 2 →
      (∀ i : Fin n, (r i.succ : ℝ) ≤ (η / 4) ^ (2 ^ n) * r i.castSucc) →
      (∀ h, |(r h : ℝ) * q h - D| ≤ q h) →
      (∑ v, ∑ i, c v i) ≤ -ρ →
      η ≤ ρ / (8 * (d + 1 : ℕ) * exponentCoefficientMass c) →
      (∑ h, (r h : ℝ)) ≤ 2 * D / q 0 →
      8 * (d + 1 : ℕ) * (L + Real.log ((d : ℝ) * B)) ≤ (n + 1 : ℕ) * ρ * q 0 →
      4 * (d + 1 : ℕ) * exponentCoefficientMass c * (∑ h, q h) ≤ (n + 1 : ℕ) * ρ * D →
      ∀ (b : Fin (n + 1) → Fin (d + 1) → ℚ)
        (p : Fin (n + 1) → Fin (d + 1)),
      (∀ h, b h (p h) ≠ 0) →
      (∀ h, K * (∑ j, (r j : ℝ)) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
        (η / 4) ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d))) →
      ∀ y : Fin (n + 1) → Fin d → Fin (d + 1) → ℤ,
      (∀ h, Submodule.span ℚ (Set.range (fun j i => (y h j i : ℚ))) = rationalHyperplaneKernel (b h)) →
      (∀ h j i, |((∑ a, A h i a * (y h j a : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c 0 i * q h)) →
      (∀ h j i, (padicNorm 2 (y h j i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q h)) →
      (∀ h j i, (padicNorm 3 (y h j i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q h)) → False := by
  obtain ⟨K, L, hK, hL, haux⟩ := exists_two_basis_balanced_auxiliary
    (by omega : 0 < n + 1) (by omega : 0 < d + 1) A hA
  refine ⟨K, L, hK, hL, ?_⟩
  intro r q c D η ρ B hr hq0 hD hρ hη hηhalf hB hgrid hlarge hstep hscale
    hc hηmass hR hqLarge hDLarge b p hp hheight y hy hyInf hy2 hy3
  obtain ⟨P, hP, hhom, hheightP, hderiv⟩ := haux r hr η hη.le hlarge
  have hRothHeight (h : Fin (n + 1)) :
      Real.log (polynomialCoeffL1 P) + 4 * (n + 1 : ℕ) * (r 0 : ℝ) ≤
      (η / 4) ^ (2 ^ n) * ((r h : ℝ) * (Height.logHeight (b h) / d)) := by
    linarith [hheight h]
  obtain ⟨z, t, T₀, hz, hT₀map, hT₀eval, ht⟩ := product_hyperplane_integer_grid_derivative
    hd b p hp r hr y hy P hP hhom (η / 4) (by positivity) (by linarith)
      hstep hRothHeight B hB
  have hsmall : blockDerivativeWeight r t ≤ (n + 1 : ℕ) * η := by
    have hh := mul_le_mul_of_nonneg_left hgrid (Nat.cast_nonneg (α := ℝ) (n + 1))
    rw [← mul_div_assoc] at hh
    linarith
  have hT₀ : T₀ ≠ 0 := by intro hz; apply hT₀eval; simp [hz]
  have hdiv : dividedWordPDeriv t (MvPolynomial.map (Int.castRingHom ℚ) P) ≠ 0 := by
    rw [← hT₀map]
    exact integerMap_ne_zero hT₀
  obtain ⟨T, hT, hTmap, hbounds⟩ := hderiv t hsmall hdiv
  have heq : T = T₀ := MvPolynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective
    (hTmap.trans hT₀map.symm)
  subst T₀
  let x := integerBlockSpanningPoint y z
  have hgridConst : 1 ≤ (d : ℝ) * B := by
    have hdR : (1 : ℝ) ≤ d := by exact_mod_cast hd
    have hBR : (1 : ℝ) ≤ B := by exact_mod_cast (show 1 ≤ B by omega)
    nlinarith
  have harch : ∀ h i, ‖blockMatrixValues A (fun hi => (x hi : ℚ)) (h, i)‖ ≤
      ((d : ℝ) * B) * Real.exp (c 0 i * q h) := by
    intro h i
    have hh := integerBlockSpanningPoint_arch_bound A y z B hz (c 0) q hyInf h i
    simpa only [x, blockMatrixValues, Matrix.mulVec, dotProduct,
      ← Rat.norm_cast_real, Real.norm_eq_abs] using hh
  have hfinite (p' : ℕ) [Fact p'.Prime] (v : Fin 3)
      (hyv : ∀ h j i, (padicNorm p' (y h j i : ℚ) : ℝ) ≤ Real.exp (c v i * q h)) :
      ∀ h i, (padicNorm p' (x (h, i) : ℚ) : ℝ) ≤ Real.exp (c v i * q h) := by
    have hh := integerBlockSpanningPoint_padic_bound p'
      (fun _ => (1 : Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ)) y z (c v) q
      (by simpa [Matrix.one_apply] using hyv)
    simpa [x, Matrix.one_apply] using hh
  exact inverse_block_three_place_polynomial_contradiction A hA T x hT₀eval r q c D η ρ L
    ((d : ℝ) * B) (q 0) (by omega) (by omega) hD hρ hL hgridConst hq0 hr
    hbounds.degreeInf hbounds.degreeInt hbounds.balanceInf hbounds.balanceInt hscale
    hbounds.heightInf harch (hfinite 2 1 hy2) (hfinite 3 2 hy3)
    hc hηmass hR hqLarge hDLarge


end
end Bounty

end SubmissionComponent_FiniteHyperplaneConfiguration

/- Component BalancedDegreeSelection; SHA256 c1ec687a7c050225cea4ca0f680c7546536ce2b49212da54986db0f5ea832647 -/
section SubmissionComponent_BalancedDegreeSelection
/- Explicit floor choices for the block degrees in the polynomial contradiction. -/

namespace Bounty
noncomputable section

def balancedBlockDegree (D q : ℝ) : ℕ := ⌊D / q⌋₊

def balancedBlockDegree_bounds {D q : ℝ} (hq : 0 < q) (hD : 2 * q ≤ D) :
    0 < balancedBlockDegree D q ∧
      (balancedBlockDegree D q : ℝ) * q ≤ D ∧
      D ≤ 2 * (balancedBlockDegree D q : ℝ) * q ∧
      |(balancedBlockDegree D q : ℝ) * q - D| ≤ q := by
  have hDpos : 0 < D := by linarith
  have ht : 2 ≤ D / q := (le_div_iff₀ hq).mpr (by simpa using hD)
  have hlo := Nat.floor_le (div_nonneg hDpos.le hq.le)
  have hhi := Nat.lt_floor_add_one (D / q)
  have hpos : 0 < balancedBlockDegree D q := by
    change 0 < ⌊D / q⌋₊
    by_contra hh
    have hz : ⌊D / q⌋₊ = 0 := by omega
    rw [hz] at hhi
    norm_num at hhi
    linarith
  change (balancedBlockDegree D q : ℝ) ≤ D / q at hlo
  change D / q < (balancedBlockDegree D q : ℝ) + 1 at hhi
  have hlomul := (le_div_iff₀ hq).mp hlo
  have hhimul := (div_lt_iff₀ hq).mp hhi
  refine ⟨hpos, hlomul, ?_, ?_⟩
  · nlinarith
  · rw [abs_le]
    constructor <;> nlinarith

def balancedBlockDegree_ratio {D q q' θ : ℝ}
    (hq : 0 < q) (hq' : 0 < q') (hD : 2 * q ≤ D) (hD' : 2 * q' ≤ D)
    (hθ : 0 ≤ θ) (hsep : 2 * q ≤ θ * q') :
    (balancedBlockDegree D q' : ℝ) ≤ θ * balancedBlockDegree D q := by
  have hb := balancedBlockDegree_bounds hq hD
  have hb' := balancedBlockDegree_bounds hq' hD'
  have hs := mul_le_mul_of_nonneg_left hsep (Nat.cast_nonneg (α := ℝ) (balancedBlockDegree D q))
  apply (mul_le_mul_iff_left₀ hq').mp
  nlinarith

def balancedBlockDegree_height_budget {D q q0 a θ H C : ℝ}
    (hq : 0 < q) (hq0 : 0 < q0) (hD : 2 * q ≤ D) (hD0 : 2 * q0 ≤ D)
    (ha : 0 ≤ a) (hθ : 0 ≤ θ) (hH : a * q ≤ H)
    (hbudget : 2 * C ≤ θ * a * q0) :
    C * (balancedBlockDegree D q0 : ℝ) ≤ θ * ((balancedBlockDegree D q : ℝ) * H) := by
  have hb := balancedBlockDegree_bounds hq hD
  have hb0 := balancedBlockDegree_bounds hq0 hD0
  have hr : (0 : ℝ) ≤ balancedBlockDegree D q := Nat.cast_nonneg _
  have hr0 : (0 : ℝ) ≤ balancedBlockDegree D q0 := Nat.cast_nonneg _
  have h1 := mul_le_mul_of_nonneg_right hbudget hr0
  have h2 := mul_le_mul_of_nonneg_left hb0.2.1 (mul_nonneg hθ ha)
  have h3 := mul_le_mul_of_nonneg_left hb.2.2.1 (mul_nonneg hθ ha)
  have h4 := mul_le_mul_of_nonneg_left hH (mul_nonneg hθ hr)
  nlinarith

end
end Bounty

end SubmissionComponent_BalancedDegreeSelection

/- Component AuxiliaryParameterSelection; SHA256 ebd95c4b38ec2be80494c73c506acd03a8f229eecf6fd958bcdbdf7d20a86859 -/
section SubmissionComponent_AuxiliaryParameterSelection
/- Explicit finite parameter selection for the auxiliary polynomial argument.
The common scale is chosen by a finite sum, not an asymptotic premise. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def exists_separated_logs_in_unbounded_set (S : Set ℝ) (hS : ¬ BddAbove S)
    (θ M : ℝ) (hθ : 0 < θ) (n : ℕ) :
    ∃ q : Fin (n + 1) → ℝ, (∀ i, q i ∈ S) ∧ (∀ i, 0 < q i) ∧ M ≤ q 0 ∧
      ∀ i : Fin n, 2 * q i.castSucc ≤ θ * q i.succ := by
  classical
  choose pick hpick hgt using (not_bddAbove_iff.mp hS)
  let u : ℕ → ℝ := Nat.rec (pick (max M 1)) (fun _ v => pick (max 1 (2 * v / θ)))
  have hu0 : u 0 = pick (max M 1) := rfl
  have hus (j : ℕ) : u (j + 1) = pick (max 1 (2 * u j / θ)) := rfl
  have hmem (j : ℕ) : u j ∈ S := by
    cases j with
    | zero => rw [hu0]; exact hpick _
    | succ j => rw [hus]; exact hpick _
  have hpos (j : ℕ) : 0 < u j := by
    cases j with
    | zero => rw [hu0]; linarith [le_max_right M (1 : ℝ), hgt (max M 1)]
    | succ j => rw [hus]; linarith [le_max_left (1 : ℝ) (2 * u j / θ), hgt (max 1 (2 * u j / θ))]
  have hstep (j : ℕ) : 2 * u j ≤ θ * u (j + 1) := by
    have hh : 2 * u j / θ ≤ u (j + 1) := by
      rw [hus]
      exact (le_max_right _ _).trans (le_of_lt (hgt _))
    have hh' := (div_le_iff₀ hθ).mp hh
    nlinarith
  refine ⟨fun i => u i.val, fun i => hmem i.val, fun i => hpos i.val, ?_, ?_⟩
  · change M ≤ u 0
    rw [hu0]
    exact (le_max_left _ _).trans (le_of_lt (hgt _))
  · intro i
    exact hstep i.val

def half_decay_degree_sum {n : ℕ} (r : Fin (n + 1) → ℕ) (θ : ℝ)
    (hθ : θ ≤ (1 / 2 : ℝ))
    (hstep : ∀ i : Fin n, (r i.succ : ℝ) ≤ θ * r i.castSucc) :
    (∑ i, (r i : ℝ)) ≤ 2 * r 0 := by
  have ht : (∑ i : Fin n, (r i.succ : ℝ)) ≤
      (1 / 2 : ℝ) * (∑ i : Fin n, (r i.castSucc : ℝ)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro i _
    exact (hstep i).trans (mul_le_mul_of_nonneg_right hθ (Nat.cast_nonneg _))
  have hhead : (∑ i : Fin n, (r i.castSucc : ℝ)) ≤ ∑ i : Fin (n + 1), (r i : ℝ) := by
    rw [Fin.sum_univ_castSucc]
    exact le_add_of_nonneg_right (Nat.cast_nonneg _)
  have hs := Fin.sum_univ_succ (fun i : Fin (n + 1) => (r i : ℝ))
  nlinarith

def auxiliaryFirstLogThreshold (m d : ℕ) (a θ K C₂ ρ : ℝ) : ℝ :=
  max 1 (max (2 * (2 * K + 4 * m) / (θ * a)) (8 * d * C₂ / ((m : ℝ) * ρ)))

def auxiliaryFirstLogThreshold_budgets {m d : ℕ}
    (a θ K C₂ ρ q₀ : ℝ) (hm : 0 < m) (ha : 0 < a) (hθ : 0 < θ) (hρ : 0 < ρ)
    (hfirst : auxiliaryFirstLogThreshold m d a θ K C₂ ρ ≤ q₀) :
    0 < q₀ ∧ 2 * (2 * K + 4 * m) ≤ θ * a * q₀ ∧
      8 * (d : ℝ) * C₂ ≤ (m : ℝ) * ρ * q₀ := by
  have h1 : (1 : ℝ) ≤ q₀ := (le_max_left _ _).trans hfirst
  have htwo : 2 * (2 * K + 4 * m) / (θ * a) ≤ q₀ :=
    (le_max_left _ _).trans ((le_max_right _ _).trans hfirst)
  have hthree : 8 * (d : ℝ) * C₂ / ((m : ℝ) * ρ) ≤ q₀ :=
    (le_max_right _ _).trans ((le_max_right _ _).trans hfirst)
  refine ⟨by linarith, ?_, ?_⟩
  · have hh := (div_le_iff₀ (mul_pos hθ ha)).mp htwo
    nlinarith
  · have hh := (div_le_iff₀ (show (0 : ℝ) < m * ρ by positivity)).mp hthree
    nlinarith

def auxiliaryCommonScale {m : ℕ} (q : Fin m → ℝ) (d : ℕ) (Cc ρ : ℝ) : ℝ :=
  1 + (∑ i, |2 * q i|) + |4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ)|

def auxiliaryCommonScale_budgets {m : ℕ} (q : Fin m → ℝ)
    (d : ℕ) (Cc ρ D : ℝ) (hm : 0 < m) (hρ : 0 < ρ)
    (hD : auxiliaryCommonScale q d Cc ρ ≤ D) :
    0 < D ∧ (∀ i, 2 * q i ≤ D) ∧
      4 * (d : ℝ) * Cc * (∑ i, q i) ≤ (m : ℝ) * ρ * D := by
  have hsum : 0 ≤ ∑ i, |2 * q i| := Finset.sum_nonneg fun i _ => abs_nonneg _
  have hraw : 1 + (∑ i, |2 * q i|) +
      |4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ)| ≤ D := hD
  refine ⟨by linarith [abs_nonneg (4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ))], ?_, ?_⟩
  · intro i
    have hh := Finset.single_le_sum (s := Finset.univ) (f := fun i => |2 * q i|)
      (fun j _ => abs_nonneg _) (Finset.mem_univ i)
    linarith [le_abs_self (2 * q i), abs_nonneg (4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ))]
  · have hh : 4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ) ≤ D := by
      linarith [le_abs_self (4 * (d : ℝ) * Cc * (∑ i, q i) / ((m : ℝ) * ρ))]
    have hh' := (div_le_iff₀ (show (0 : ℝ) < m * ρ by positivity)).mp hh
    nlinarith

def selectedAuxiliaryDegrees {n : ℕ} (D : ℝ) (q : Fin (n + 1) → ℝ) : Fin (n + 1) → ℕ :=
  fun i => balancedBlockDegree D (q i)

/-- Every field concerns the actual floor degrees at this common scale. -/
structure AuxiliaryDegreeBudgets {n : ℕ} (q H : Fin (n + 1) → ℝ)
    (d : ℕ) (θ K C₂ Cc ρ D : ℝ) : Prop where
  scale_pos : 0 < D
  degree_pos : ∀ i, 0 < selectedAuxiliaryDegrees D q i
  scale_error : ∀ i, |(selectedAuxiliaryDegrees D q i : ℝ) * q i - D| ≤ q i
  degree_separation : ∀ i : Fin n,
    (selectedAuxiliaryDegrees D q i.succ : ℝ) ≤ θ * selectedAuxiliaryDegrees D q i.castSucc
  total_degree : (∑ i, (selectedAuxiliaryDegrees D q i : ℝ)) ≤ 2 * D / q 0
  roth_budget : ∀ i,
    K * (∑ j, (selectedAuxiliaryDegrees D q j : ℝ)) +
      4 * (↑(n + 1) : ℝ) * selectedAuxiliaryDegrees D q 0 ≤
        θ * ((selectedAuxiliaryDegrees D q i : ℝ) * H i)
  first_scale_budget : 8 * (d : ℝ) * C₂ ≤ (↑(n + 1) : ℝ) * ρ * q 0
  error_budget : 4 * (d : ℝ) * Cc * (∑ i, q i) ≤ (↑(n + 1) : ℝ) * ρ * D

def auxiliary_selected_degree_budgets {n : ℕ} (q H : Fin (n + 1) → ℝ)
    (d : ℕ) (a θ K C₂ Cc ρ D : ℝ)
    (hq : ∀ i, 0 < q i) (ha : 0 < a) (hθ : 0 < θ) (hθhalf : θ ≤ 1 / 2)
    (hK : 0 ≤ K) (hρ : 0 < ρ)
    (hsep : ∀ i : Fin n, 2 * q i.castSucc ≤ θ * q i.succ)
    (hH : ∀ i, a * q i ≤ H i)
    (hfirst : auxiliaryFirstLogThreshold (n + 1) d a θ K C₂ ρ ≤ q 0)
    (hD : auxiliaryCommonScale q d Cc ρ ≤ D) :
    AuxiliaryDegreeBudgets q H d θ K C₂ Cc ρ D := by
  obtain ⟨hDpos, hDscale, herror⟩ := auxiliaryCommonScale_budgets q d Cc ρ D (by omega) hρ hD
  obtain ⟨_, hfirstRoth, hfirstError⟩ :=
    auxiliaryFirstLogThreshold_budgets a θ K C₂ ρ (q 0) (by omega) ha hθ hρ hfirst
  have hb (i : Fin (n + 1)) := balancedBlockDegree_bounds (hq i) (hDscale i)
  have hstep : ∀ i : Fin n,
      (selectedAuxiliaryDegrees D q i.succ : ℝ) ≤ θ * selectedAuxiliaryDegrees D q i.castSucc := by
    intro i
    exact balancedBlockDegree_ratio (hq i.castSucc) (hq i.succ)
      (hDscale i.castSucc) (hDscale i.succ) hθ.le (hsep i)
  have hsum := half_decay_degree_sum (selectedAuxiliaryDegrees D q) θ hθhalf hstep
  have hhead : (selectedAuxiliaryDegrees D q 0 : ℝ) ≤ D / q 0 :=
    (le_div_iff₀ (hq 0)).mpr (hb 0).2.1
  refine ⟨hDpos, fun i => (hb i).1, fun i => (hb i).2.2.2, hstep, ?_, ?_, hfirstError, herror⟩
  · exact hsum.trans (by simpa only [mul_div_assoc] using
      mul_le_mul_of_nonneg_left hhead (show (0 : ℝ) ≤ 2 by norm_num))
  · intro i
    calc
      _ ≤ K * (2 * (selectedAuxiliaryDegrees D q 0 : ℝ)) +
          4 * (↑(n + 1) : ℝ) * selectedAuxiliaryDegrees D q 0 :=
        add_le_add (mul_le_mul_of_nonneg_left hsum hK) le_rfl
      _ = (2 * K + 4 * (↑(n + 1) : ℝ)) * selectedAuxiliaryDegrees D q 0 := by ring
      _ ≤ _ := balancedBlockDegree_height_budget (hq i) (hq 0) (hDscale i) (hDscale 0)
        ha.le hθ.le (hH i) hfirstRoth

def exists_complete_auxiliary_parameters (S : Set ℝ) (hS : ¬ BddAbove S)
    (H : ℝ → ℝ) (n d : ℕ) (a θ K C₂ Cc ρ M : ℝ)
    (ha : 0 < a) (hθ : 0 < θ) (hθhalf : θ ≤ 1 / 2) (hK : 0 ≤ K) (hρ : 0 < ρ)
    (hH : ∀ t ∈ S, a * t ≤ H t) :
    ∃ q : Fin (n + 1) → ℝ, (∀ i, q i ∈ S) ∧ (∀ i, 0 < q i) ∧ M ≤ q 0 ∧
      (∀ i : Fin n, 2 * q i.castSucc ≤ θ * q i.succ) ∧
      0 < auxiliaryCommonScale q d Cc ρ ∧
      ∀ D ≥ auxiliaryCommonScale q d Cc ρ,
        AuxiliaryDegreeBudgets q (fun i => H (q i)) d θ K C₂ Cc ρ D := by
  obtain ⟨q, hmem, hq, hfirst, hsep⟩ := exists_separated_logs_in_unbounded_set S hS θ
    (max M (auxiliaryFirstLogThreshold (n + 1) d a θ K C₂ ρ)) hθ n
  have hbase : auxiliaryFirstLogThreshold (n + 1) d a θ K C₂ ρ ≤ q 0 :=
    (le_max_right _ _).trans hfirst
  refine ⟨q, hmem, hq, (le_max_left _ _).trans hfirst, hsep, ?_, ?_⟩
  · exact (auxiliaryCommonScale_budgets q d Cc ρ _ (by omega) hρ le_rfl).1
  · intro D hD
    exact auxiliary_selected_degree_budgets q (fun i => H (q i)) d a θ K C₂ Cc ρ D
      hq ha hθ hθhalf hK hρ hsep (fun i => hH (q i) (hmem i)) hbase hD


end
end Bounty

end SubmissionComponent_AuxiliaryParameterSelection

/- Component HighHyperplaneBoundedness; SHA256 8b87455601f31b371afde983c083a2bd4660c2d304724004328a8adf9e8a19b4 -/
section SubmissionComponent_HighHyperplaneBoundedness
/- Families of large-height hyperplanes satisfying a fixed negative profile are bounded. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def exists_hyperplane_polynomial_parameters {d : ℕ} (hd : 1 ≤ d)
    (c : Fin 3 → Fin (d + 1) → ℝ) (ρ : ℝ) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ) :
    ∃ (η : ℝ) (n B : ℕ), 0 < η ∧ η ≤ 1 / 2 ∧
      η ≤ ρ / (8 * (d + 1 : ℕ) * exponentCoefficientMass c) ∧
      0 < B ∧ (d : ℝ) / B ≤ η / 2 ∧
      8 * (d + 1 : ℕ) ≤ (n + 1 : ℕ) * η ^ 2 := by
  have hmass : 0 < exponentCoefficientMass c :=
    hρ.trans_le (deficit_le_exponentCoefficientMass c ρ hc)
  let η : ℝ := min (1 / 2) (ρ / (8 * (d + 1 : ℕ) * exponentCoefficientMass c))
  have hη : 0 < η := lt_min (by norm_num) (by positivity)
  obtain ⟨n, hn⟩ := exists_nat_ge (8 * (d + 1 : ℕ) / η ^ 2)
  obtain ⟨B, hB⟩ := exists_nat_ge (1 + 2 * (d : ℝ) / η)
  have hBreal : (0 : ℝ) < B := by
    have hh : 0 ≤ 2 * (d : ℝ) / η := by positivity
    linarith
  refine ⟨η, n, B, hη, min_le_left _ _, min_le_right _ _,
    by exact_mod_cast hBreal, ?_, ?_⟩
  · apply (div_le_iff₀ hBreal).mpr
    have hh : 2 * (d : ℝ) / η ≤ B := by linarith
    have hmul := (div_le_iff₀ hη).mp hh
    nlinarith
  · have hmul := (div_le_iff₀ (sq_pos_of_pos hη)).mp hn
    simp only [Nat.cast_add, Nat.cast_one] at hmul ⊢
    nlinarith [sq_nonneg η]

def bounded_high_hyperplane_family {d : ℕ} (hd : 1 ≤ d)
    (A : Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → Fin (d + 1) → ℝ) (ρ a : ℝ) (hρ : 0 < ρ) (ha : 0 < a)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (S : Set ℝ) (b : ℝ → Fin (d + 1) → ℚ) (p : ℝ → Fin (d + 1))
    (y : ℝ → Fin d → Fin (d + 1) → ℤ)
    (hp : ∀ q ∈ S, b q (p q) ≠ 0)
    (hheight : ∀ q ∈ S, a * q ≤ Height.logHeight (b q) / d)
    (hspan : ∀ q ∈ S, Submodule.span ℚ (Set.range (fun j i => (y q j i : ℚ))) =
      rationalHyperplaneKernel (b q))
    (hInf : ∀ q ∈ S, ∀ j i,
      |((∑ k, A i k * (y q j k : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ j i, (padicNorm 2 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q))
    (hThree : ∀ q ∈ S, ∀ j i, (padicNorm 3 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) :
    BddAbove S := by
  classical
  by_contra hS
  obtain ⟨η, n, B, hη, hηhalf, hηmass, hB, hgrid, hlarge⟩ :=
    exists_hyperplane_polynomial_parameters hd c ρ hρ hc
  obtain ⟨K, L, hK, hL, hconfig⟩ := exists_finite_hyperplane_configuration_constants
    (n := n) hd (fun _ => A) (fun _ => hA)
  let θ : ℝ := (η / 4) ^ (2 ^ n)
  have hθ : 0 < θ := by positivity
  have hθhalf : θ ≤ 1 / 2 := by
    have hh : (η / 4) ^ (2 ^ n) ≤ η / 4 := by
      simpa only [pow_one] using pow_le_pow_of_le_one (by positivity : 0 ≤ η / 4)
        (by linarith : η / 4 ≤ 1)
        (show 1 ≤ 2 ^ n by have hh : 0 < (2 : ℕ) ^ n := pow_pos (by decide) n; omega)
    dsimp [θ]
    linarith
  obtain ⟨q, hqmem, hqpos, _, hqsep, hDpos, hbudgets⟩ :=
    exists_complete_auxiliary_parameters S hS (fun q => Height.logHeight (b q) / d)
      n (d + 1) a θ K (L + Real.log ((d : ℝ) * B)) (exponentCoefficientMass c) ρ 0
      ha hθ hθhalf hK hρ hheight
  let D := auxiliaryCommonScale q (d + 1) (exponentCoefficientMass c) ρ
  have hb := hbudgets D le_rfl
  let r := selectedAuxiliaryDegrees D q
  exact hconfig r q c D η ρ B hb.degree_pos (hqpos 0) hb.scale_pos hρ hη hηhalf hB hgrid hlarge
    hb.degree_separation hb.scale_error hc hηmass hb.total_degree hb.first_scale_budget hb.error_budget
    (fun h => b (q h)) (fun h => p (q h)) (fun h => hp (q h) (hqmem h))
    hb.roth_budget (fun h => y (q h)) (fun h => hspan (q h) (hqmem h))
    (fun h => hInf (q h) (hqmem h)) (fun h => hTwo (q h) (hqmem h))
    (fun h => hThree (q h) (hqmem h))


end
end Bounty

end SubmissionComponent_HighHyperplaneBoundedness

/- Component BoundedRationalBoxes; SHA256 0106503e3eb71b650e68873dc0bb21dc7ec2e0d0436464f23e4cbc0cc7f20b40 -/
section SubmissionComponent_BoundedRationalBoxes
/- Finiteness of actual integer points and rational spans in bounded rational boxes. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def finite_rational_box_integer_points {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (B : Fin d → ℝ) (hB : ∀ i, 0 < B i) :
    Set.Finite {z : Fin d → ℤ | ∀ i,
      |((∑ j, A i j * (z j : ℚ) : ℚ) : ℝ)| ≤ B i} := by
  let N : Fin d → ℕ := fun _ => 1
  have hN : ∀ i, 0 < N i := by intro i; exact Nat.zero_lt_one
  let L := rationalBoxLattice A B N hA hB hN
  letI : DiscreteTopology L := by dsimp [L]; infer_instance
  let f : (Fin d → ℤ) → BoxEuclidean d := fun z =>
    rationalBoxTransform A B hA hB (diagonalIntegerPoint N z)
  have hf : Function.Injective f := by
    intro z w h
    have hh := (rationalBoxTransform A B hA hB).injective h
    funext i
    have hi := congrArg (fun x : BoxEuclidean d => x i) hh
    simpa [diagonalIntegerPoint, N] using hi
  have hclosed : IsClosed (L : Set (BoxEuclidean d)) :=
    AddSubgroup.isClosed_of_discrete (H := L.toAddSubgroup)
  have hfin : Set.Finite (Metric.closedBall (0 : BoxEuclidean d) (Real.sqrt d) ∩
      (L : Set (BoxEuclidean d))) :=
    Metric.finite_isBounded_inter_isClosed DiscreteTopology.isDiscrete
      Metric.isBounded_closedBall hclosed
  apply (Set.Finite.preimage hf.injOn hfin).subset
  intro z hz
  refine ⟨?_, ?_⟩
  · rw [Metric.mem_closedBall, dist_zero_right]
    apply rationalBoxContains_norm_le_sqrt A B hA hB
    intro i
    simpa [Matrix.mulVec, dotProduct, diagonalIntegerPoint, N,
      Matrix.map_apply, Rat.cast_sum, Rat.cast_mul] using hz i
  · exact (rationalBoxLattice_mem_iff A B N hA hB hN (f z)).mpr ⟨z, rfl⟩

def finite_bounded_exponential_integer_points {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : Fin d → ℝ) (M : ℝ) :
    Set.Finite {z : Fin d → ℤ | ∃ q : ℝ, 0 ≤ q ∧ q ≤ M ∧
      ∀ i, |((∑ j, A i j * (z j : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c i * q)} := by
  let B : Fin d → ℝ := fun i => Real.exp (|c i| * max M 0)
  apply (finite_rational_box_integer_points A hA B (fun i => Real.exp_pos _)).subset
  rintro z ⟨q, hq, hqM, hz⟩ i
  apply (hz i).trans
  apply Real.exp_le_exp.mpr
  exact (mul_le_mul_of_nonneg_right (le_abs_self _) hq).trans
    (mul_le_mul_of_nonneg_left (hqM.trans (le_max_left _ _)) (abs_nonneg _))

def finite_spans_of_finite_integer_points {d : ℕ} (s : Set (Fin d → ℤ))
    (hs : s.Finite) :
    Set.Finite {V : Submodule ℚ (Fin d → ℚ) | ∃ t : Set (Fin d → ℤ),
      t ⊆ s ∧ V = Submodule.span ℚ ((fun z i => (z i : ℚ)) '' t)} := by
  apply (hs.powerset.image (fun t => Submodule.span ℚ ((fun z i => (z i : ℚ)) '' t))).subset
  rintro V ⟨t, ht, rfl⟩
  exact ⟨t, ht, rfl⟩

def finite_bounded_exponential_spans {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : Fin d → ℝ) (M : ℝ) :
    Set.Finite {V : Submodule ℚ (Fin d → ℚ) | ∃ (q : ℝ) (t : Set (Fin d → ℤ)),
      0 ≤ q ∧ q ≤ M ∧
      (∀ z ∈ t, ∀ i, |((∑ j, A i j * (z j : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c i * q)) ∧
      V = Submodule.span ℚ ((fun z i => (z i : ℚ)) '' t)} := by
  apply (finite_spans_of_finite_integer_points _
    (finite_bounded_exponential_integer_points A hA c M)).subset
  rintro V ⟨q, t, hq, hqM, ht, rfl⟩
  refine ⟨t, ?_, rfl⟩
  intro z hz
  exact ⟨q, hq, hqM, ht z hz⟩

end
end Bounty

end SubmissionComponent_BoundedRationalBoxes

/- Component FiniteHyperplaneFamilies; SHA256 b09df8a57dd0eb66dacb0cf8c379ee875717aed7d4bc9f0538a0271731e1dee3 -/
section SubmissionComponent_FiniteHyperplaneFamilies
/- Affine height growth, together with actual box bounds, gives finite kernel families. -/

namespace Bounty
noncomputable section
open scoped BigOperators

def bounded_hyperplane_family_of_affine_height {d : ℕ} (hd : 1 ≤ d)
    (A : Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → Fin (d + 1) → ℝ) (ρ a C : ℝ) (hρ : 0 < ρ) (ha : 0 < a)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (S : Set ℝ) (b : ℝ → Fin (d + 1) → ℚ) (p : ℝ → Fin (d + 1))
    (y : ℝ → Fin d → Fin (d + 1) → ℤ)
    (hp : ∀ q ∈ S, b q (p q) ≠ 0)
    (hheight : ∀ q ∈ S, a * q - C ≤ Height.logHeight (b q) / d)
    (hspan : ∀ q ∈ S, Submodule.span ℚ (Set.range (fun j i => (y q j i : ℚ))) =
      rationalHyperplaneKernel (b q))
    (hInf : ∀ q ∈ S, ∀ j i,
      |((∑ k, A i k * (y q j k : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ j i, (padicNorm 2 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q))
    (hThree : ∀ q ∈ S, ∀ j i, (padicNorm 3 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) :
    BddAbove S := by
  let T : Set ℝ := {q | q ∈ S ∧ 2 * C / a ≤ q}
  have hT : BddAbove T := bounded_high_hyperplane_family hd A hA c ρ (a / 2) hρ
    (by positivity) hc T b p y
    (fun q hq => hp q hq.1)
    (fun q hq => by
      have hmul := (div_le_iff₀ ha).mp hq.2
      have hh := hheight q hq.1
      linarith)
    (fun q hq => hspan q hq.1)
    (fun q hq => hInf q hq.1)
    (fun q hq => hTwo q hq.1)
    (fun q hq => hThree q hq.1)
  obtain ⟨M, hM⟩ := hT
  refine ⟨max M (2 * C / a), ?_⟩
  intro q hq
  by_cases hlarge : 2 * C / a ≤ q
  · exact (hM ⟨hq, hlarge⟩).trans (le_max_left _ _)
  · exact (le_of_not_ge hlarge).trans (le_max_right _ _)

def finite_hyperplane_family_of_height_dichotomy {d : ℕ} (hd : 1 ≤ d)
    (A : Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → Fin (d + 1) → ℝ) (ρ a C : ℝ) (hρ : 0 < ρ) (ha : 0 < a)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (b : ℝ → Fin (d + 1) → ℚ) (p : ℝ → Fin (d + 1))
    (y : ℝ → Fin d → Fin (d + 1) → ℤ)
    (F : Set (Submodule ℚ (Fin (d + 1) → ℚ))) (hF : F.Finite)
    (hp : ∀ q ∈ S, b q (p q) ≠ 0)
    (hheight : ∀ q ∈ S, rationalHyperplaneKernel (b q) ∈ F ∨
      a * q - C ≤ Height.logHeight (b q) / d)
    (hspan : ∀ q ∈ S, Submodule.span ℚ (Set.range (fun j i => (y q j i : ℚ))) =
      rationalHyperplaneKernel (b q))
    (hInf : ∀ q ∈ S, ∀ j i,
      |((∑ k, A i k * (y q j k : ℚ) : ℚ) : ℝ)| ≤ Real.exp (c 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ j i, (padicNorm 2 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 1 i * q))
    (hThree : ∀ q ∈ S, ∀ j i, (padicNorm 3 (y q j i : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) :
    Set.Finite ((fun q => rationalHyperplaneKernel (b q)) '' S) := by
  classical
  let T : Set ℝ := {q | q ∈ S ∧ rationalHyperplaneKernel (b q) ∉ F}
  have hT : BddAbove T := bounded_hyperplane_family_of_affine_height hd A hA c ρ a C
    hρ ha hc T b p y
    (fun q hq => hp q hq.1)
    (fun q hq => (hheight q hq.1).resolve_left hq.2)
    (fun q hq => hspan q hq.1)
    (fun q hq => hInf q hq.1)
    (fun q hq => hTwo q hq.1)
    (fun q hq => hThree q hq.1)
  obtain ⟨M, hM⟩ := hT
  have hsmall := finite_bounded_exponential_spans A (isUnit_iff_ne_zero.mp hA) (c 0) M
  apply (hF.union hsmall).subset
  rintro V ⟨q, hq, rfl⟩
  by_cases hex : rationalHyperplaneKernel (b q) ∈ F
  · exact Or.inl hex
  · right
    refine ⟨q, Set.range (y q), hS q hq, hM ⟨hq, hex⟩, ?_, ?_⟩
    · rintro z ⟨j, rfl⟩ i
      exact hInf q hq j i
    · change rationalHyperplaneKernel (b q) = _
      rw [← hspan q hq]
      congr 1
      exact Set.range_comp (fun z i => (z i : ℚ)) (y q)

end
end Bounty

end SubmissionComponent_FiniteHyperplaneFamilies

/- Component FixedProfileHyperplanes; SHA256 c39d60a9a0df37c84145d5fc0618ab79d308788400edc67f25ece9bd73ac9451 -/
section SubmissionComponent_FixedProfileHyperplanes
/- Finiteness of actual codimension-one integer spans in a fixed negative profile. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def finite_fixed_profile_hyperplane_spans {d : ℕ} (hd : 1 ≤ d)
    (A : Matrix (Fin (d + 1)) (Fin (d + 1)) ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → Fin (d + 1) → ℝ) (ρ : ℝ) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (X : ℝ → Matrix (Fin (d + 1)) (Fin d) ℤ)
    (hX : ∀ q ∈ S, LinearIndependent ℚ ((X q).map (Int.castRingHom ℚ)).col)
    (hInf : ∀ q ∈ S, ∀ i j,
      ‖(A * (X q).map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i j,
      (padicNorm 2 (X q i j : ℚ) : ℝ) ≤ Real.exp (c 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i j,
      (padicNorm 3 (X q i j : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) :
    Set.Finite ((fun q => Submodule.span ℚ
      (Set.range ((X q).map (Int.castRingHom ℚ)).col)) '' S) := by
  classical
  obtain ⟨T, C, hT, _, hdichotomy⟩ := moving_hyperplane_height_dichotomy A hA c ρ hρ hc
  let U : Set ℝ := {q | q ∈ S ∧ T ≤ q}
  have hex : ∀ q : ℝ, ∃ a : Fin (d + 1) → ℤ, q ∈ U →
      a ≠ 0 ∧ Finset.univ.gcd a = 1 ∧
      Submodule.span ℚ (Set.range ((X q).map (Int.castRingHom ℚ)).col) =
        rationalHyperplaneKernel (fun i => (a i : ℚ)) ∧
      (rationalHyperplaneKernel (fun i => (a i : ℚ)) ∈ exceptionalPatternHyperplanes A ∨
        ρ * q / 4 - C ≤ Height.logHeight (fun i => (a i : ℚ))) := by
    intro q
    by_cases hq : q ∈ U
    · obtain ⟨a, ha⟩ := hdichotomy q hq.2 (X q) (hX q hq.1)
        (hInf q hq.1) (hTwo q hq.1) (hThree q hq.1)
      exact ⟨a, fun _ => ha⟩
    · exact ⟨0, fun h => False.elim (hq h)⟩
  choose a ha using hex
  let b : ℝ → Fin (d + 1) → ℚ := fun q i => (a q i : ℚ)
  have hp_exists : ∀ q : ℝ, ∃ p : Fin (d + 1), q ∈ U → b q p ≠ 0 := by
    intro q
    by_cases hq : q ∈ U
    · obtain ⟨i, hi⟩ : ∃ i, a q i ≠ 0 := by simpa [funext_iff] using (ha q hq).1
      exact ⟨i, fun _ => by dsimp [b]; exact_mod_cast hi⟩
    · exact ⟨0, fun h => False.elim (hq h)⟩
  choose p hp using hp_exists
  have hdreal : (0 : ℝ) < d := by exact_mod_cast hd
  have hfinite : Set.Finite ((fun q => rationalHyperplaneKernel (b q)) '' U) :=
    finite_hyperplane_family_of_height_dichotomy hd A hA c ρ (ρ / (4 * d)) (C / d)
      hρ (by positivity) hc U (fun q hq => hS q hq.1) b p (fun q j i => X q i j)
      (exceptionalPatternHyperplanes A : Set _) (exceptionalPatternHyperplanes A).finite_toSet hp
      (by
        intro q hq
        rcases (ha q hq).2.2.2 with h | h
        · exact Or.inl h
        · right
          have hh := div_le_div_of_nonneg_right h hdreal.le
          dsimp [b]
          calc
            ρ / (4 * (d : ℝ)) * q - C / d = (ρ * q / 4 - C) / d := by ring
            _ ≤ _ := hh)
      (fun q hq => (ha q hq).2.2.1)
      (by
        intro q hq j i
        rw [← Real.norm_eq_abs, Rat.norm_cast_real]
        exact hInf q hq.1 i j)
      (fun q hq j i => hTwo q hq.1 i j)
      (fun q hq j i => hThree q hq.1 i j)
  have hsmall := finite_bounded_exponential_spans A (isUnit_iff_ne_zero.mp hA) (c 0) T
  apply (hfinite.union hsmall).subset
  rintro V ⟨q, hq, rfl⟩
  by_cases hlarge : T ≤ q
  · left
    refine ⟨q, ⟨hq, hlarge⟩, ?_⟩
    exact ((ha q ⟨hq, hlarge⟩).2.2.1).symm
  · right
    refine ⟨q, Set.range (fun j i => X q i j), hS q hq,
      le_of_not_ge hlarge, ?_, ?_⟩
    · rintro z ⟨j, rfl⟩ i
      rw [← Real.norm_eq_abs, Rat.norm_cast_real]
      exact hInf q hq i j
    · change Submodule.span ℚ (Set.range (fun j i => (X q i j : ℚ))) = _
      congr 1
      exact Set.range_comp (fun z i => (z i : ℚ)) (fun j i => X q i j)

end
end Bounty

end SubmissionComponent_FixedProfileHyperplanes

/- Component FiniteIndexProfileHyperplanes; SHA256 16e6aacc0800fd6936926bf23485f6746739cb92b9d754a6ea6939051c97d89c -/
section SubmissionComponent_FiniteIndexProfileHyperplanes
/- Transport of fixed-profile hyperplane finiteness to arbitrary finite coordinate types. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

/-- The coordinate change induced by an actual bijection of row labels. -/
def profileCoordinateEquiv {I I' : Type*} (e : I ≃ I') :
    (I → ℚ) ≃ₗ[ℚ] (I' → ℚ) where
  toFun x i := x (e.symm i)
  invFun y i := y (e i)
  left_inv x := by funext i; simp
  right_inv y := by funext i; simp
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def profile_column_span_reindex {I I' J J' : Type*}
    (e : I ≃ I') (f : J ≃ J') (X : Matrix I J ℚ) :
    (Submodule.span ℚ (Set.range X.col)).map (profileCoordinateEquiv e).toLinearMap =
      Submodule.span ℚ (Set.range (Matrix.reindex e f X).col) := by
  rw [Submodule.map_span, ← Set.range_comp]
  congr 1
  ext v
  constructor
  · rintro ⟨j, rfl⟩
    refine ⟨f j, ?_⟩
    ext i
    simp [profileCoordinateEquiv, Matrix.reindex_apply, Matrix.col, Matrix.submatrix]
    rfl
  · rintro ⟨j, rfl⟩
    exact ⟨f.symm j, rfl⟩

def profile_column_independent_reindex {I I' J J' : Type*}
    (e : I ≃ I') (f : J ≃ J') (X : Matrix I J ℚ)
    (hX : LinearIndependent ℚ X.col) :
    LinearIndependent ℚ (Matrix.reindex e f X).col := by
  exact (hX.map' (profileCoordinateEquiv e).toLinearMap
    (LinearMap.ker_eq_bot.mpr (profileCoordinateEquiv e).injective)).comp f.symm f.symm.injective

def profile_reindex_mul {I I' J J' : Type*} [Fintype I] [Fintype I']
    (e : I ≃ I') (f : J ≃ J') (A : Matrix I I ℚ) (X : Matrix I J ℚ) :
    Matrix.reindex e e A * Matrix.reindex e f X = Matrix.reindex e f (A * X) :=
  Matrix.submatrix_mul_equiv A X e.symm e.symm f.symm

/-- The finite-index form of the checked fixed-profile theorem, with genuine transported spans. -/
def finite_fixed_profile_hyperplane_spans_fintype
    {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I]
    (hcard : Fintype.card I = Fintype.card J + 1) (hJ : 1 ≤ Fintype.card J)
    (A : Matrix I I ℚ) (hA : IsUnit A.det)
    (c : Fin 3 → I → ℝ) (ρ : ℝ) (hρ : 0 < ρ)
    (hc : (∑ v, ∑ i, c v i) ≤ -ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (X : ℝ → Matrix I J ℤ)
    (hX : ∀ q ∈ S, LinearIndependent ℚ ((X q).map (Int.castRingHom ℚ)).col)
    (hInf : ∀ q ∈ S, ∀ i j,
      ‖(A * (X q).map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i j,
      (padicNorm 2 (X q i j : ℚ) : ℝ) ≤ Real.exp (c 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i j,
      (padicNorm 3 (X q i j : ℚ) : ℝ) ≤ Real.exp (c 2 i * q)) :
    Set.Finite ((fun q => Submodule.span ℚ
      (Set.range ((X q).map (Int.castRingHom ℚ)).col)) '' S) := by
  classical
  let e : I ≃ Fin (Fintype.card J + 1) := Fintype.equivFinOfCardEq hcard
  let f : J ≃ Fin (Fintype.card J) := Fintype.equivFin J
  let A' := Matrix.reindex e e A
  let c' : Fin 3 → Fin (Fintype.card J + 1) → ℝ := fun v i => c v (e.symm i)
  let X' : ℝ → Matrix (Fin (Fintype.card J + 1)) (Fin (Fintype.card J)) ℤ :=
    fun q => Matrix.reindex e f (X q)
  have hcast (q : ℝ) : (X' q).map (Int.castRingHom ℚ) =
      Matrix.reindex e f ((X q).map (Int.castRingHom ℚ)) := rfl
  have hA' : IsUnit A'.det := by
    simpa only [A', Matrix.det_reindex_self] using hA
  have hc' : (∑ v, ∑ i, c' v i) ≤ -ρ := by
    simpa only [c', Equiv.sum_comp] using hc
  have hX' : ∀ q ∈ S, LinearIndependent ℚ ((X' q).map (Int.castRingHom ℚ)).col := by
    intro q hq
    rw [hcast]
    exact profile_column_independent_reindex e f _ (hX q hq)
  have hInf' : ∀ q ∈ S, ∀ i j,
      ‖(A' * (X' q).map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c' 0 i * q) := by
    intro q hq i j
    rw [hcast, profile_reindex_mul]
    exact hInf q hq (e.symm i) (f.symm j)
  have hTwo' : ∀ q ∈ S, ∀ i j,
      (padicNorm 2 (X' q i j : ℚ) : ℝ) ≤ Real.exp (c' 1 i * q) := by
    intro q hq i j
    exact hTwo q hq (e.symm i) (f.symm j)
  have hThree' : ∀ q ∈ S, ∀ i j,
      (padicNorm 3 (X' q i j : ℚ) : ℝ) ≤ Real.exp (c' 2 i * q) := by
    intro q hq i j
    exact hThree q hq (e.symm i) (f.symm j)
  have hfinite := finite_fixed_profile_hyperplane_spans hJ A' hA' c' ρ hρ hc' S hS
    X' hX' hInf' hTwo' hThree'
  have himage : Submodule.map (profileCoordinateEquiv e).toLinearMap ''
      ((fun q => Submodule.span ℚ (Set.range ((X q).map (Int.castRingHom ℚ)).col)) '' S) =
      ((fun q => Submodule.span ℚ (Set.range ((X' q).map (Int.castRingHom ℚ)).col)) '' S) := by
    rw [Set.image_image]
    congr 1
    funext q
    rw [hcast]
    exact profile_column_span_reindex e f _
  rw [← himage] at hfinite
  exact hfinite.of_finite_image
    (Submodule.map_injective_of_injective (profileCoordinateEquiv e).injective).injOn


end
end Bounty

end SubmissionComponent_FiniteIndexProfileHyperplanes

/- Component VaryingProfileHyperplanes; SHA256 aa918076e45a3ae1625d5dbade003a3eb62eff09e77e5f95e4747906b84e5141 -/
section SubmissionComponent_VaryingProfileHyperplanes
/- Bounded varying profiles reduce to an actual finite collection of fixed upper profiles. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def finite_varying_profile_hyperplane_spans
    {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I]
    (hcard : Fintype.card I = Fintype.card J + 1) (hJ : 1 ≤ Fintype.card J)
    (A : Matrix I I ℚ) (hA : IsUnit A.det)
    (c : ℝ → Fin 3 → I → ℝ) (M ρ : ℝ) (hρ : 0 < ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (hcBound : ∀ q ∈ S, ∀ v i, |c q v i| ≤ M)
    (hcSum : ∀ q ∈ S, (∑ v, ∑ i, c q v i) ≤ -ρ)
    (X : ℝ → Matrix I J ℤ)
    (hX : ∀ q ∈ S, LinearIndependent ℚ ((X q).map (Int.castRingHom ℚ)).col)
    (hInf : ∀ q ∈ S, ∀ i j,
      ‖(A * (X q).map (Int.castRingHom ℚ)) i j‖ ≤ Real.exp (c q 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i j,
      (padicNorm 2 (X q i j : ℚ) : ℝ) ≤ Real.exp (c q 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i j,
      (padicNorm 3 (X q i j : ℚ) : ℝ) ≤ Real.exp (c q 2 i * q)) :
    Set.Finite ((fun q => Submodule.span ℚ
      (Set.range ((X q).map (Int.castRingHom ℚ)).col)) '' S) := by
  classical
  let : Nonempty I := Fintype.card_pos_iff.mp (by omega)
  obtain ⟨C, hC, hcover⟩ := exists_finite_exponent_profiles_nonpos_on
    (Fin 3 × I) ∅ M ρ hρ
  let U (a : Fin 3 × I → ℝ) : Set ℝ :=
    {q | q ∈ S ∧ ∀ v i, c q v i ≤ a (v, i)}
  let V (q : ℝ) := Submodule.span ℚ (Set.range ((X q).map (Int.castRingHom ℚ)).col)
  have hfinite (a : Fin 3 × I → ℝ) (ha : a ∈ C) : Set.Finite (V '' U a) := by
    have hsum : (∑ v, ∑ i, a (v, i)) ≤ -(ρ / 2) := by
      have hh := (hC a ha).2.1
      simpa only [Fintype.sum_prod_type, neg_div] using hh
    apply finite_fixed_profile_hyperplane_spans_fintype hcard hJ A hA
      (fun v i => a (v, i)) (ρ / 2) (by positivity) hsum (U a)
      (fun q hq => hS q hq.1) X (fun q hq => hX q hq.1)
    · intro q hq i j
      exact (hInf q hq.1 i j).trans (Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_right (hq.2 0 i) (hS q hq.1)))
    · intro q hq i j
      exact (hTwo q hq.1 i j).trans (Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_right (hq.2 1 i) (hS q hq.1)))
    · intro q hq i j
      exact (hThree q hq.1 i j).trans (Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_right (hq.2 2 i) (hS q hq.1)))
  have hU : Set.Finite (⋃ a ∈ (C : Set (Fin 3 × I → ℝ)), V '' U a) :=
    C.finite_toSet.biUnion hfinite
  apply hU.subset
  rintro W ⟨q, hq, rfl⟩
  obtain ⟨a, ha, hle, _⟩ := hcover (fun x => c q x.1 x.2)
    (fun x => hcBound q hq x.1 x.2)
    (by simpa only [Fintype.sum_prod_type] using hcSum q hq)
    (by simp)
  exact Set.mem_iUnion.mpr ⟨a, Set.mem_iUnion.mpr
    ⟨ha, q, ⟨hq, fun v i => hle (v, i)⟩, rfl⟩⟩


end
end Bounty

end SubmissionComponent_VaryingProfileHyperplanes

/- Component CompoundProfileHyperplanes; SHA256 9e4bc642b774e9ffa674c1de21a5a8c3919549f227ac1815272769454fb1c0c0 -/
section SubmissionComponent_CompoundProfileHyperplanes
/- Finiteness for the actual integer compound columns with one column removed. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def compoundDeletedColumns {d ell : ℕ} (s₀ : CompoundIndex d ell)
    (H : Matrix (Fin d) (Fin d) ℤ) :
    Matrix (CompoundIndex d ell) {t : CompoundIndex d ell // t ≠ s₀} ℤ :=
  (compoundMatrix ell H).submatrix id Subtype.val

def compoundDeletedColumns_map {d ell : ℕ} (s₀ : CompoundIndex d ell)
    (H : Matrix (Fin d) (Fin d) ℤ) :
    (compoundDeletedColumns s₀ H).map (Int.castRingHom ℚ) =
      (compoundMatrix ell (H.map (Int.castRingHom ℚ))).submatrix id Subtype.val := by
  exact (congrArg (fun X : Matrix (CompoundIndex d ell) (CompoundIndex d ell) ℚ =>
    X.submatrix id (Subtype.val : {t : CompoundIndex d ell // t ≠ s₀} → CompoundIndex d ell))
    (compoundMatrix_map (Int.castRingHom ℚ) ell H)).symm

def compoundIndex_two_le_card {d ell : ℕ} (hell : 0 < ell) (held : ell < d) :
    2 ≤ Fintype.card (CompoundIndex d ell) := by
  rw [compoundIndex_card]
  have hp := Nat.choose_pos held.le
  have hn : d.choose ell ≠ 1 := by
    intro heq
    have hh := Nat.choose_eq_one_iff.mp heq
    omega
  omega

def compoundIndex_deleted_card {d ell : ℕ} (s₀ : CompoundIndex d ell) :
    Fintype.card {t : CompoundIndex d ell // t ≠ s₀} =
      Fintype.card (CompoundIndex d ell) - 1 := by
  classical
  simpa only [Fintype.card_subtype_eq] using
    Fintype.card_subtype_compl (fun t : CompoundIndex d ell => t = s₀)

def compoundDeletedColumns_independent {d ell : ℕ} (s₀ : CompoundIndex d ell)
    (H : Matrix (Fin d) (Fin d) ℤ) (hH : (H.map (Int.castRingHom ℚ)).det ≠ 0) :
    LinearIndependent ℚ ((compoundDeletedColumns s₀ H).map (Int.castRingHom ℚ)).col := by
  classical
  rw [compoundDeletedColumns_map]
  exact (Matrix.linearIndependent_cols_of_det_ne_zero
    (compoundMatrix_det_ne_zero ell _ hH)).comp Subtype.val Subtype.val_injective

def compoundDeletedColumns_span {d ell : ℕ} (s₀ : CompoundIndex d ell)
    (H : Matrix (Fin d) (Fin d) ℤ) :
    Submodule.span ℚ (Set.range ((compoundDeletedColumns s₀ H).map (Int.castRingHom ℚ)).col) =
      Submodule.span ℚ ((compoundMatrix ell (H.map (Int.castRingHom ℚ))).col '' {t | t ≠ s₀}) := by
  rw [compoundDeletedColumns_map, Set.image_eq_range]
  rfl

def compoundDeletedColumns_span_ne_top {d ell : ℕ} (s₀ : CompoundIndex d ell)
    (H : Matrix (Fin d) (Fin d) ℚ) (hH : H.det ≠ 0) :
    Submodule.span ℚ ((compoundMatrix ell H).col '' {t | t ≠ s₀}) ≠ ⊤ := by
  classical
  have hli := Matrix.linearIndependent_cols_of_det_ne_zero
    (compoundMatrix_det_ne_zero ell H hH)
  have hn := hli.notMem_span_image (s := {t | t ≠ s₀}) (x := s₀) (by simp)
  intro heq
  rw [heq] at hn
  exact hn (Submodule.mem_top : (compoundMatrix ell H).col s₀ ∈ ⊤)

def finite_varying_profile_compound_deleted_spans {d ell : ℕ}
    (hell : 0 < ell) (held : ell < d) (s₀ : CompoundIndex d ell)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : ℝ → Fin 3 → CompoundIndex d ell → ℝ) (M ρ : ℝ) (hρ : 0 < ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (hcBound : ∀ q ∈ S, ∀ v i, |c q v i| ≤ M)
    (hcSum : ∀ q ∈ S, (∑ v, ∑ i, c q v i) ≤ -ρ)
    (H : ℝ → Matrix (Fin d) (Fin d) ℤ)
    (hH : ∀ q ∈ S, ((H q).map (Int.castRingHom ℚ)).det ≠ 0)
    (hInf : ∀ q ∈ S, ∀ i t, t ≠ s₀ →
      ‖(compoundMatrix ell A * compoundMatrix ell ((H q).map (Int.castRingHom ℚ))) i t‖ ≤
        Real.exp (c q 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i t, t ≠ s₀ →
      (padicNorm 2 (compoundMatrix ell ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i t, t ≠ s₀ →
      (padicNorm 3 (compoundMatrix ell ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 2 i * q)) :
    Set.Finite ((fun q => Submodule.span ℚ
      ((compoundMatrix ell ((H q).map (Int.castRingHom ℚ))).col '' {t | t ≠ s₀})) '' S) := by
  classical
  have hN := compoundIndex_two_le_card hell held
  have hcard := compoundIndex_deleted_card s₀
  have hfinite := finite_varying_profile_hyperplane_spans (I := CompoundIndex d ell)
    (J := {t : CompoundIndex d ell // t ≠ s₀}) (by omega) (by omega)
    (compoundMatrix ell A) (isUnit_iff_ne_zero.mpr (compoundMatrix_det_ne_zero ell A hA))
    c M ρ hρ S hS hcBound hcSum (fun q => compoundDeletedColumns s₀ (H q))
    (fun q hq => compoundDeletedColumns_independent s₀ (H q) (hH q hq))
    (by
      intro q hq i t
      rw [compoundDeletedColumns_map]
      have heq := Matrix.submatrix_mul_equiv (compoundMatrix ell A)
        (compoundMatrix ell ((H q).map (Int.castRingHom ℚ))) id
        (Equiv.refl (CompoundIndex d ell))
        (Subtype.val : {t : CompoundIndex d ell // t ≠ s₀} → CompoundIndex d ell)
      simp only [Equiv.coe_refl, Matrix.submatrix_id_id] at heq
      rw [heq]
      exact hInf q hq i t.val t.property)
    (by
      intro q hq i t
      have heq := congrArg (fun X : Matrix (CompoundIndex d ell)
          {t : CompoundIndex d ell // t ≠ s₀} ℚ => X i t)
        (compoundDeletedColumns_map s₀ (H q))
      change (padicNorm 2 (((compoundDeletedColumns s₀ (H q)).map (Int.castRingHom ℚ)) i t) : ℝ) ≤ _
      rw [heq]
      exact hTwo q hq i t.val t.property)
    (by
      intro q hq i t
      have heq := congrArg (fun X : Matrix (CompoundIndex d ell)
          {t : CompoundIndex d ell // t ≠ s₀} ℚ => X i t)
        (compoundDeletedColumns_map s₀ (H q))
      change (padicNorm 3 (((compoundDeletedColumns s₀ (H q)).map (Int.castRingHom ℚ)) i t) : ℝ) ≤ _
      rw [heq]
      exact hThree q hq i t.val t.property)
  simpa only [compoundDeletedColumns_span] using hfinite

def finite_varying_profile_compound_tail_spans {d k : ℕ}
    (hkpos : 1 ≤ k) (hk : k < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : ℝ → Fin 3 → CompoundIndex d (d - k) → ℝ) (M ρ : ℝ) (hρ : 0 < ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (hcBound : ∀ q ∈ S, ∀ v i, |c q v i| ≤ M)
    (hcSum : ∀ q ∈ S, (∑ v, ∑ i, c q v i) ≤ -ρ)
    (H : ℝ → Matrix (Fin d) (Fin d) ℤ)
    (hH : ∀ q ∈ S, ((H q).map (Int.castRingHom ℚ)).det ≠ 0)
    (hInf : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      ‖(compoundMatrix (d - k) A * compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ))) i t‖ ≤
        Real.exp (c q 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 2 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 3 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 2 i * q)) :
    Set.Finite ((fun q => Submodule.span ℚ
      ((compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ))).col ''
        {t | t ≠ compoundTailIndex d k})) '' S) :=
  finite_varying_profile_compound_deleted_spans (by omega) (by omega)
    (compoundTailIndex d k) A hA c M ρ hρ S hS hcBound hcSum H hH hInf hTwo hThree


end
end Bounty

end SubmissionComponent_CompoundProfileHyperplanes

/- Component CompoundProfileFamilies; SHA256 32c64d9b5347c90026d25a15f33a7908bc0087968d6b4b809db5702ec270a959 -/
section SubmissionComponent_CompoundProfileFamilies
/- A finite family of proper compound hyperplanes for the varying-profile construction. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def exists_finite_varying_profile_compound_tail_family {d k : ℕ}
    (hkpos : 1 ≤ k) (hk : k < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : ℝ → Fin 3 → CompoundIndex d (d - k) → ℝ) (M ρ : ℝ) (hρ : 0 < ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (hcBound : ∀ q ∈ S, ∀ v i, |c q v i| ≤ M)
    (hcSum : ∀ q ∈ S, (∑ v, ∑ i, c q v i) ≤ -ρ)
    (H : ℝ → Matrix (Fin d) (Fin d) ℤ)
    (hH : ∀ q ∈ S, ((H q).map (Int.castRingHom ℚ)).det ≠ 0)
    (hInf : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      ‖(compoundMatrix (d - k) A * compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ))) i t‖ ≤
        Real.exp (c q 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 2 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 3 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 2 i * q)) :
    ∃ F : Finset (Submodule ℚ (CompoundIndex d (d - k) → ℚ)),
      (∀ V ∈ F, V ≠ ⊤) ∧ ∀ q ∈ S,
        Submodule.span ℚ ((compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ))).col ''
          {t | t ≠ compoundTailIndex d k}) ∈ F := by
  classical
  have hfinite := finite_varying_profile_compound_tail_spans hkpos hk A hA c M ρ hρ
    S hS hcBound hcSum H hH hInf hTwo hThree
  refine ⟨hfinite.toFinset, ?_, ?_⟩
  · intro V hV
    obtain ⟨q, hq, rfl⟩ := hfinite.mem_toFinset.mp hV
    exact compoundDeletedColumns_span_ne_top (compoundTailIndex d k)
      ((H q).map (Int.castRingHom ℚ)) (hH q hq)
  · intro q hq
    exact hfinite.mem_toFinset.mpr ⟨q, hq, rfl⟩


end
end Bounty

end SubmissionComponent_CompoundProfileFamilies

/- Component CompoundRecoveryCore; SHA256 7f925663a82a946efc9d5f5c6fdf4c64b932f80c884e0acba76929aecbed15ba -/
section SubmissionComponent_CompoundRecoveryCore
/- Canonical recovery of an original subspace from a compound subspace,
using all wedge tuples with one prescribed vector. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def compoundSlotMap {d ell : ℕ} (v : Fin ell → Fin d → ℚ) (j : Fin ell) :
    (Fin d → ℚ) →ₗ[ℚ] (CompoundIndex d ell → ℚ) where
  toFun x := compoundWedgeCoordinates (Function.update v j x)
  map_add' x y := by
    ext s
    simp [compoundWedgeCoordinates, AlternatingMap.map_update_add]
  map_smul' c x := by
    ext s
    simp [compoundWedgeCoordinates, AlternatingMap.map_update_smul]

def compoundRecovery {d ell : ℕ} (H : Submodule ℚ (CompoundIndex d ell → ℚ)) :
    Submodule ℚ (Fin d → ℚ) :=
  ⨅ v : Fin ell → Fin d → ℚ, ⨅ j : Fin ell, H.comap (compoundSlotMap v j)

def mem_compoundRecovery {d ell : ℕ}
    (H : Submodule ℚ (CompoundIndex d ell → ℚ)) (x : Fin d → ℚ) :
    x ∈ compoundRecovery H ↔ ∀ (v : Fin ell → Fin d → ℚ) (j : Fin ell),
      compoundWedgeCoordinates (Function.update v j x) ∈ H := by
  simp only [compoundRecovery, Submodule.mem_iInf, Submodule.mem_comap]
  rfl

def mem_compoundRecovery_iff_tuple {d ell : ℕ}
    (H : Submodule ℚ (CompoundIndex d ell → ℚ)) (x : Fin d → ℚ) :
    x ∈ compoundRecovery H ↔ ∀ (v : Fin ell → Fin d → ℚ) (j : Fin ell),
      v j = x → compoundWedgeCoordinates v ∈ H := by
  rw [mem_compoundRecovery]
  constructor
  · intro h v j hj
    simpa [← hj, Function.update_eq_self] using h v j
  · intro h v j
    exact h (Function.update v j x) j (Function.update_self _ _ _)

def compoundCoordinateHyperplane {d ell : ℕ} (s : CompoundIndex d ell) :
    Submodule ℚ (CompoundIndex d ell → ℚ) := LinearMap.ker (LinearMap.proj s)

def mem_compoundCoordinateHyperplane {d ell : ℕ}
    (s : CompoundIndex d ell) (x : CompoundIndex d ell → ℚ) :
    x ∈ compoundCoordinateHyperplane s ↔ x s = 0 := Iff.rfl

def det_identity_updateCol {I : Type*} [Fintype I] [DecidableEq I]
    (j : I) (x : I → ℚ) : ((1 : Matrix I I ℚ).updateCol j x).det = x j := by
  have h := Matrix.det_updateCol_sum (1 : Matrix I I ℚ) j x
  simpa [Matrix.one_apply] using h

def compoundWedgeCoordinates_basis_update {d ell : ℕ}
    (s : CompoundIndex d ell) (j : Fin ell) (x : Fin d → ℚ) :
    compoundWedgeCoordinates
      (Function.update (fun k => Pi.single (compoundIndexEmbedding s k) (1 : ℚ)) j x) s =
        x (compoundIndexEmbedding s j) := by
  classical
  let v : Fin ell → Fin d → ℚ := fun k => Pi.single (compoundIndexEmbedding s k) 1
  change compoundWedgeCoordinates (Function.update v j x) s = _
  rw [compoundWedgeCoordinates_apply]
  have hmat : (Matrix.of (fun i k : Fin ell =>
      Function.update v j x k
        (compoundIndexEmbedding s i))) =
      (1 : Matrix (Fin ell) (Fin ell) ℚ).updateCol j (fun i => x (compoundIndexEmbedding s i)) := by
    ext i k
    by_cases hk : k = j
    · simp [hk]
    · simp [v, hk, Pi.single_apply, Matrix.one_apply, (compoundIndexEmbedding s).injective.eq_iff]
  rw [hmat, det_identity_updateCol]

def mem_compoundRecovery_coordinate {d ell : ℕ}
    (s : CompoundIndex d ell) (x : Fin d → ℚ) :
    x ∈ compoundRecovery (compoundCoordinateHyperplane s) ↔
      ∀ j, x (compoundIndexEmbedding s j) = 0 := by
  classical
  rw [mem_compoundRecovery]
  constructor
  · intro h j
    have hh := h (fun k => Pi.single (compoundIndexEmbedding s k) (1 : ℚ)) j
    simpa only [mem_compoundCoordinateHyperplane, compoundWedgeCoordinates_basis_update] using hh
  · intro hx v j
    rw [mem_compoundCoordinateHyperplane, compoundWedgeCoordinates_apply]
    apply Matrix.det_eq_zero_of_column_eq_zero j
    intro i
    simpa using hx i

def compoundWedgeCoordinates_basis {d ell : ℕ} (s : CompoundIndex d ell) :
    compoundWedgeCoordinates (fun j => Pi.single (compoundIndexEmbedding s j) (1 : ℚ)) =
      Pi.single s 1 := by
  classical
  have hv : (fun j => Pi.single (compoundIndexEmbedding s j) (1 : ℚ)) =
      (fun j i => (1 : Matrix (Fin d) (Fin d) ℚ) i (compoundIndexEmbedding s j)) := by
    funext j i
    simp [Matrix.one_apply, Pi.single_apply]
  rw [hv, compoundMatrix_column, compoundMatrix_one]
  funext t
  simp [Matrix.one_apply, Pi.single_apply, eq_comm]

def compoundRecovery_ne_top {d ell : ℕ} (hell : 0 < ell)
    (H : Submodule ℚ (CompoundIndex d ell → ℚ)) (hH : H ≠ ⊤) :
    compoundRecovery H ≠ ⊤ := by
  classical
  intro htop
  apply hH
  apply eq_top_iff.mpr
  intro x _
  have hb : ∀ s : CompoundIndex d ell, Pi.single s (1 : ℚ) ∈ H := by
    intro s
    let v : Fin ell → Fin d → ℚ := fun j => Pi.single (compoundIndexEmbedding s j) 1
    have hv : v ⟨0, hell⟩ ∈ compoundRecovery H := by rw [htop]; trivial
    have hh := (mem_compoundRecovery_iff_tuple H _).mp hv v ⟨0, hell⟩ rfl
    simpa only [v, compoundWedgeCoordinates_basis] using hh
  have he : x = ∑ s, x s • Pi.single s (1 : ℚ) := by
    ext s
    simp [Pi.single_apply]
  rw [he]
  exact H.sum_mem (fun s _ => H.smul_mem (x s) (hb s))


end
end Bounty

end SubmissionComponent_CompoundRecoveryCore

/- Component CompoundHyperplaneRecovery; SHA256 5c956447589b5be0e4cd523737e55d1b309d07e0e08728df2d882067e37b7bf1 -/
section SubmissionComponent_CompoundHyperplaneRecovery
/- Recovery commutes with invertible column changes. In particular, the
compound hyperplane omitting a subset recovers the original columns outside
that subset. Finite families therefore pull back without a height argument. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def compoundRecovery_map {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) ℚ) (hM : M.det ≠ 0)
    (H : Submodule ℚ (CompoundIndex d ell → ℚ)) :
    compoundRecovery (H.map (Matrix.toLin' (compoundMatrix ell M))) =
      (compoundRecovery H).map (Matrix.toLin' M) := by
  classical
  have hu : IsUnit M.det := isUnit_iff_ne_zero.mpr hM
  have hCinj : Function.Injective (compoundMatrix ell M).mulVec :=
    Matrix.mulVec_injective_iff_isUnit.mpr
      ((compoundMatrix ell M).isUnit_iff_isUnit_det.mpr
        (isUnit_iff_ne_zero.mpr (compoundMatrix_det_ne_zero ell M hM)))
  ext x
  constructor
  · intro hx
    let y := M⁻¹.mulVec x
    have hMy : M.mulVec y = x := by
      dsimp [y]
      rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv M hu, Matrix.one_mulVec]
    refine Submodule.mem_map.mpr ⟨y, ?_, hMy⟩
    rw [mem_compoundRecovery_iff_tuple]
    intro v j hj
    have hh := (mem_compoundRecovery_iff_tuple _ _).mp hx
      (fun k => M.mulVec (v k)) j (by rw [hj]; exact hMy)
    rw [← compoundMatrix_wedge_action] at hh
    obtain ⟨w, hw, he⟩ := Submodule.mem_map.mp hh
    have he' : w = compoundWedgeCoordinates v := hCinj he
    simpa [he'] using hw
  · rintro ⟨y, hy, rfl⟩
    rw [mem_compoundRecovery_iff_tuple]
    intro v j hj
    let w : Fin ell → Fin d → ℚ := fun k => M⁻¹.mulVec (v k)
    have hwj : w j = y := by
      dsimp [w]
      rw [hj]
      change M⁻¹.mulVec (M.mulVec y) = y
      rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul M hu, Matrix.one_mulVec]
    have hh := (mem_compoundRecovery_iff_tuple _ _).mp hy w j hwj
    refine Submodule.mem_map.mpr ⟨compoundWedgeCoordinates w, hh, ?_⟩
    change (compoundMatrix ell M).mulVec (compoundWedgeCoordinates w) = _
    rw [compoundMatrix_wedge_action]
    congr 1
    funext k
    dsimp [w]
    rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv M hu, Matrix.one_mulVec]

def coordinateVanishingSpace {I : Type*} (s : Finset I) : Submodule ℚ (I → ℚ) where
  carrier := {x | ∀ i ∈ s, x i = 0}
  zero_mem' := by simp
  add_mem' hx hy := by intro i hi; simp [hx i hi, hy i hi]
  smul_mem' c x hx := by intro i hi; simp [hx i hi]

def mem_coordinateVanishingSpace {I : Type*} (s : Finset I) (x : I → ℚ) :
    x ∈ coordinateVanishingSpace s ↔ ∀ i ∈ s, x i = 0 := Iff.rfl

def coordinateVanishingSpace_eq_span {I : Type*} [Fintype I] [DecidableEq I]
    (s : Finset I) :
    coordinateVanishingSpace s =
      Submodule.span ℚ ((fun i => Pi.single i (1 : ℚ)) '' {i | i ∉ s}) := by
  apply le_antisymm
  · intro x hx
    have he : x = ∑ i, x i • Pi.single i (1 : ℚ) := by
      ext i
      simp [Pi.single_apply]
    rw [he]
    apply Submodule.sum_mem
    intro i _
    by_cases hi : i ∈ s
    · simp [(mem_coordinateVanishingSpace s x).mp hx i hi]
    · exact Submodule.smul_mem _ (x i) (Submodule.subset_span ⟨i, hi, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    intro j hj
    have hij : j ≠ i := by intro h; subst j; exact hi hj
    simp [Pi.single_apply, hij, Ne.symm hij]

def coordinateVanishingSpace_map_matrix {I : Type*} [Fintype I] [DecidableEq I]
    (M : Matrix I I ℚ) (s : Finset I) :
    (coordinateVanishingSpace s).map (Matrix.toLin' M) =
      Submodule.span ℚ (M.col '' {i | i ∉ s}) := by
  rw [coordinateVanishingSpace_eq_span, Submodule.map_span, Set.image_image]
  congr 1
  congr 1
  funext i
  exact Matrix.mulVec_single_one M i

def compoundRecovery_coordinate_eq {d ell : ℕ} (s : CompoundIndex d ell) :
    compoundRecovery (compoundCoordinateHyperplane s) = coordinateVanishingSpace s.val := by
  ext x
  rw [mem_compoundRecovery_coordinate, mem_coordinateVanishingSpace]
  constructor
  · intro hx i hi
    obtain ⟨j, rfl⟩ := (Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem s i).mpr hi
    exact hx j
  · intro hx j
    apply hx
    exact (Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem s _).mp ⟨j, rfl⟩

def compoundCoordinateHyperplane_eq_vanishing {d ell : ℕ} (s : CompoundIndex d ell) :
    compoundCoordinateHyperplane s = coordinateVanishingSpace {s} := by
  classical
  ext x
  simp [mem_compoundCoordinateHyperplane, mem_coordinateVanishingSpace]

def compound_hyperplane_span_eq_map {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) ℚ) (s : CompoundIndex d ell) :
    Submodule.span ℚ ((compoundMatrix ell M).col '' {t | t ≠ s}) =
      (compoundCoordinateHyperplane s).map (Matrix.toLin' (compoundMatrix ell M)) := by
  classical
  rw [compoundCoordinateHyperplane_eq_vanishing, coordinateVanishingSpace_map_matrix]
  simp

def compoundRecovery_span_except {d ell : ℕ}
    (M : Matrix (Fin d) (Fin d) ℚ) (hM : M.det ≠ 0) (s : CompoundIndex d ell) :
    compoundRecovery (Submodule.span ℚ ((compoundMatrix ell M).col '' {t | t ≠ s})) =
      Submodule.span ℚ (M.col '' {i | i ∉ s.val}) := by
  rw [compound_hyperplane_span_eq_map, compoundRecovery_map M hM,
    compoundRecovery_coordinate_eq, coordinateVanishingSpace_map_matrix]

def finite_compound_hyperplane_recovery {d ell : ℕ} (hell : 0 < ell)
    (F : Finset (Submodule ℚ (CompoundIndex d ell → ℚ)))
    (hF : ∀ H ∈ F, H ≠ ⊤) :
    ∃ G : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ G, V ≠ ⊤) ∧
      ∀ (M : Matrix (Fin d) (Fin d) ℚ), M.det ≠ 0 → ∀ s : CompoundIndex d ell,
        Submodule.span ℚ ((compoundMatrix ell M).col '' {t | t ≠ s}) ∈ F →
        Submodule.span ℚ (M.col '' {i | i ∉ s.val}) ∈ G := by
  classical
  refine ⟨F.image compoundRecovery, ?_, ?_⟩
  · intro V hV
    obtain ⟨H, hH, rfl⟩ := Finset.mem_image.mp hV
    exact compoundRecovery_ne_top hell H (hF H hH)
  · intro M hM s hs
    exact Finset.mem_image.mpr ⟨_, hs, compoundRecovery_span_except M hM s⟩


end
end Bounty

end SubmissionComponent_CompoundHyperplaneRecovery

/- Component CompoundPrefixRecovery; SHA256 66e943858f76ab65cf702a8e9cc60f9d96a156756ef627dded008ba12ff1481f -/
section SubmissionComponent_CompoundPrefixRecovery
/- The canonical tail compound hyperplane recovers exactly the original prefix. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def matrix_prefix_image_eq_range {d k : ℕ} (hk : k ≤ d)
    (M : Matrix (Fin d) (Fin d) ℚ) :
    M.col '' {i | i.val < k} = Set.range (fun i : Fin k => M.col (i.castLE hk)) := by
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i.val, hi⟩, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i.castLE hk, i.isLt, rfl⟩

def finite_compound_prefix_recovery {d k : ℕ} (hk : k < d)
    (F : Finset (Submodule ℚ (CompoundIndex d (d - k) → ℚ)))
    (hF : ∀ H ∈ F, H ≠ ⊤) :
    ∃ G : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ G, V ≠ ⊤) ∧
      ∀ (M : Matrix (Fin d) (Fin d) ℚ), M.det ≠ 0 →
        Submodule.span ℚ
          ((compoundMatrix (d - k) M).col '' {t | t ≠ compoundTailIndex d k}) ∈ F →
        Submodule.span ℚ (Set.range (fun i : Fin k => M.col (i.castLE hk.le))) ∈ G := by
  obtain ⟨G, hG, hcover⟩ := finite_compound_hyperplane_recovery (Nat.sub_pos_of_lt hk) F hF
  refine ⟨G, hG, ?_⟩
  intro M hM hmem
  have hh := hcover M hM (compoundTailIndex d k) hmem
  simpa only [compoundIndex_mem_tail, not_le, matrix_prefix_image_eq_range hk.le] using hh


end
end Bounty

end SubmissionComponent_CompoundPrefixRecovery

/- Component VaryingProfilePrefixFamilies; SHA256 547289eb7f89beb1ade727de55e1c63c382aaff003ca252b27b0d5713c022625 -/
section SubmissionComponent_VaryingProfilePrefixFamilies
/- Actual bounded compound profiles give a finite family of proper original prefix spans. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def exists_finite_varying_profile_prefix_family {d k : ℕ}
    (hkpos : 1 ≤ k) (hk : k < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (hA : A.det ≠ 0)
    (c : ℝ → Fin 3 → CompoundIndex d (d - k) → ℝ) (M ρ : ℝ) (hρ : 0 < ρ)
    (S : Set ℝ) (hS : ∀ q ∈ S, 0 ≤ q)
    (hcBound : ∀ q ∈ S, ∀ v i, |c q v i| ≤ M)
    (hcSum : ∀ q ∈ S, (∑ v, ∑ i, c q v i) ≤ -ρ)
    (H : ℝ → Matrix (Fin d) (Fin d) ℤ)
    (hH : ∀ q ∈ S, ((H q).map (Int.castRingHom ℚ)).det ≠ 0)
    (hInf : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      ‖(compoundMatrix (d - k) A * compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ))) i t‖ ≤
        Real.exp (c q 0 i * q))
    (hTwo : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 2 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 1 i * q))
    (hThree : ∀ q ∈ S, ∀ i t, t ≠ compoundTailIndex d k →
      (padicNorm 3 (compoundMatrix (d - k) ((H q).map (Int.castRingHom ℚ)) i t) : ℝ) ≤
        Real.exp (c q 2 i * q)) :
    ∃ G : Finset (Submodule ℚ (Fin d → ℚ)), (∀ V ∈ G, V ≠ ⊤) ∧
      ∀ q ∈ S, Submodule.span ℚ (((H q).map (Int.castRingHom ℚ)).col '' {i | i.val < k}) ∈ G := by
  obtain ⟨F, hF, hcover⟩ := exists_finite_varying_profile_compound_tail_family
    hkpos hk A hA c M ρ hρ S hS hcBound hcSum H hH hInf hTwo hThree
  obtain ⟨G, hG, hprefix⟩ := finite_compound_prefix_recovery hk F hF
  refine ⟨G, hG, ?_⟩
  intro q hq
  have hh := hprefix ((H q).map (Int.castRingHom ℚ)) (hH q hq) (hcover q hq)
  simpa only [matrix_prefix_image_eq_range hk.le] using hh


end
end Bounty

end SubmissionComponent_VaryingProfilePrefixFamilies

/- Component ActualLocalValueBounds; SHA256 9e0824591f0829076dbf6db3287517e909c0db7c64e17a0b9aae1ee6a2796414 -/
section SubmissionComponent_ActualLocalValueBounds
/- Actual rational matrix values and finite-place coordinates lie in a
uniform logarithmic box. The constants depend only on the fixed matrix. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def matrixEntryBound {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) : ℝ :=
  1 + ∑ i, ∑ j, ‖A i j‖

def matrixEntryBound_ge_one {d : ℕ} (A : Matrix (Fin d) (Fin d) ℚ) :
    1 ≤ matrixEntryBound A := by
  have hh : 0 ≤ ∑ i, ∑ j, ‖A i j‖ := Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => norm_nonneg _))
  unfold matrixEntryBound
  linarith

def rational_matrix_integer_norm_upper {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (x : Fin d → ℤ) (hx : x ≠ 0) (i : Fin d) :
    ‖A.mulVec (fun j => (x j : ℚ)) i‖ ≤ matrixEntryBound A * integerVectorMax x := by
  have hH : 0 ≤ integerVectorMax x := (by norm_num : (0 : ℝ) ≤ 1).trans (integerVectorMax_ge_one x hx)
  have hrow : (∑ j, ‖A i j‖) ≤ matrixEntryBound A := by
    have hh : (∑ j, ‖A i j‖) ≤ ∑ k, ∑ j, ‖A k j‖ :=
      Finset.single_le_sum (fun k _ => Finset.sum_nonneg (fun j _ => norm_nonneg (A k j))) (Finset.mem_univ i)
    unfold matrixEntryBound
    linarith
  calc
    _ ≤ ∑ j, ‖A i j * (x j : ℚ)‖ := norm_sum_le _ _
    _ ≤ ∑ j, ‖A i j‖ * integerVectorMax x := by
      apply Finset.sum_le_sum
      intro j _
      rw [norm_mul, Int.norm_cast_rat, Int.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left (integer_coord_abs_le_max x j) (norm_nonneg _)
    _ = (∑ j, ‖A i j‖) * integerVectorMax x := (Finset.sum_mul _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right hrow hH

def rational_matrix_integer_norm_lower {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (D : ℤ) (hD : 0 < D)
    (B : Matrix (Fin d) (Fin d) ℤ) (hB : ∀ i j, (B i j : ℚ) = (D : ℚ) * A i j)
    (x : Fin d → ℤ) (i : Fin d) (hi : A.mulVec (fun j => (x j : ℚ)) i ≠ 0) :
    1 / (D : ℝ) ≤ ‖A.mulVec (fun j => (x j : ℚ)) i‖ := by
  apply nonzero_rational_scaled_integer_norm_lower _ D (∑ j, B i j * x j) hD hi
  simp only [Matrix.mulVec, dotProduct, Finset.mul_sum, Int.cast_sum, Int.cast_mul, hB]
  apply Finset.sum_congr rfl
  intro j _
  ring

def actualThreePlaceValues {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (x : Fin d → ℤ) : Fin 3 → Fin d → ℝ :=
  ![(fun i => ‖A.mulVec (fun j => (x j : ℚ)) i‖),
    (fun i => (padicNorm 2 (x i : ℚ) : ℝ)),
    (fun i => (padicNorm 3 (x i : ℚ) : ℝ))]

def actualThreePlaceValues_finite_le_one {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) (x : Fin d → ℤ) :
    ∀ v i, v ≠ 0 → actualThreePlaceValues A x v i ≤ 1 := by
  intro v i hv
  fin_cases v
  · exact (hv rfl).elim
  · change (padicNorm 2 (x i : ℚ) : ℝ) ≤ 1
    exact_mod_cast padicNorm.of_int (p := 2) (x i)
  · change (padicNorm 3 (x i : ℚ) : ℝ) ≤ 1
    exact_mod_cast padicNorm.of_int (p := 3) (x i)

def exists_actual_three_place_log_bounds {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℚ) :
    ∃ M : ℝ, 1 ≤ M ∧ ∀ (q : ℝ) (x : Fin d → ℤ),
      1 ≤ q → x ≠ 0 → integerVectorMax x ≤ Real.exp q →
      (∀ i, x i ≠ 0) → (∀ i, A.mulVec (fun j => (x j : ℚ)) i ≠ 0) →
      ∀ v i, Real.exp (-M * q) ≤ actualThreePlaceValues A x v i ∧
        actualThreePlaceValues A x v i ≤ Real.exp (M * q) := by
  obtain ⟨D, hD, B, hB⟩ := exists_integer_scaled_rational_matrix A
  have hDr : (0 : ℝ) < D := by exact_mod_cast hD
  have hD1 : (1 : ℝ) ≤ D := by exact_mod_cast (show (1 : ℤ) ≤ D by omega)
  let C := matrixEntryBound A
  have hC1 : 1 ≤ C := matrixEntryBound_ge_one A
  have hC : 0 < C := lt_of_lt_of_le (by norm_num) hC1
  have hlogD : 0 ≤ Real.log (D : ℝ) := Real.log_nonneg hD1
  have hlogC : 0 ≤ Real.log C := Real.log_nonneg hC1
  let M : ℝ := 1 + Real.log (D : ℝ) + Real.log C
  have hM : 1 ≤ M := by dsimp [M]; linarith
  refine ⟨M, hM, ?_⟩
  intro q x hq hx hH hxn hAx v i
  have hq0 : 0 ≤ q := (by norm_num : (0 : ℝ) ≤ 1).trans hq
  have hM0 : 0 ≤ M := (by norm_num : (0 : ℝ) ≤ 1).trans hM
  have hMq : q ≤ M * q := by nlinarith
  have hH0 : 0 < integerVectorMax x := lt_of_lt_of_le (by norm_num) (integerVectorMax_ge_one x hx)
  have hloInf : Real.exp (-M * q) ≤ 1 / (D : ℝ) := by
    calc
      _ ≤ Real.exp (-Real.log (D : ℝ)) := Real.exp_le_exp.mpr (by
        have hMm : M ≤ M * q := by nlinarith
        dsimp [M] at hMm ⊢
        linarith)
      _ = _ := by rw [Real.exp_neg, Real.exp_log hDr, one_div]
  have hhiInf : C * Real.exp q ≤ Real.exp (M * q) := by
    calc
      _ = Real.exp (Real.log C + q) := by rw [Real.exp_add, Real.exp_log hC]
      _ ≤ _ := Real.exp_le_exp.mpr (by dsimp [M]; nlinarith)
  have hloFin (p : ℕ) (hp : p.Prime) :
      Real.exp (-M * q) ≤ (padicNorm p (x i : ℚ) : ℝ) := by
    calc
      _ ≤ Real.exp (-q) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / Real.exp q := by rw [Real.exp_neg, one_div]
      _ ≤ 1 / integerVectorMax x := one_div_le_one_div_of_le hH0 hH
      _ ≤ _ := padicNorm_integer_le_height_reciprocal p hp x i (hxn i)
  have hhiFin (p : ℕ) [Fact p.Prime] :
      (padicNorm p (x i : ℚ) : ℝ) ≤ Real.exp (M * q) := by
    have hh : (padicNorm p (x i : ℚ) : ℝ) ≤ 1 := by exact_mod_cast padicNorm.of_int (p := p) (x i)
    exact hh.trans (Real.one_le_exp (mul_nonneg hM0 hq0))
  fin_cases v
  · exact ⟨hloInf.trans (rational_matrix_integer_norm_lower A D hD B hB x i (hAx i)),
      (rational_matrix_integer_norm_upper A x hx i).trans
        ((mul_le_mul_of_nonneg_left hH hC.le).trans hhiInf)⟩
  · exact ⟨hloFin 2 (by norm_num), hhiFin 2⟩
  · exact ⟨hloFin 3 (by norm_num), hhiFin 3⟩

def primitive_integer_mulHeight {d : ℕ} (hd : 0 < d)
    (x : Fin d → ℤ) (hx : Finset.univ.gcd x = 1) :
    Height.mulHeight (fun i => (x i : ℚ)) = integerVectorMax x := by
  let : NeZero d := ⟨hd.ne'⟩
  exact Rat.mulHeight_eq_max_abs_of_gcd_eq_one hx

def primitive_integer_exp_logHeight {d : ℕ} (hd : 0 < d)
    (x : Fin d → ℤ) (hx : Finset.univ.gcd x = 1) :
    Real.exp (Height.logHeight (fun i => (x i : ℚ))) = integerVectorMax x := by
  rw [Height.logHeight_eq_log_mulHeight, Real.exp_log (Height.mulHeight_pos _)]
  exact primitive_integer_mulHeight hd x hx


end
end Bounty

end SubmissionComponent_ActualLocalValueBounds

/- Component ActualProductProfiles; SHA256 f89629e531498930902081c66e4ce99bd6d6ef3e3e5876a1ba69f28924b36691 -/
section SubmissionComponent_ActualProductProfiles
/- Fixed finite exponent profiles for actual local values of primitive
integer points, with the parameter equal to their projective log height. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def exists_finite_actual_three_place_profiles {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ M : ℝ, 1 ≤ M ∧ ∃ C : Finset (Fin 3 → Fin d → ℝ),
      (∀ c ∈ C, (∀ v i, |c v i| ≤ M + ρ / (6 * d)) ∧
        (∑ v, ∑ i, c v i) ≤ -ρ / 2 ∧ (∀ v i, v ≠ 0 → c v i ≤ 0)) ∧
      ∀ (q : ℝ) (x : Fin d → ℤ), 1 ≤ q → x ≠ 0 →
        integerVectorMax x ≤ Real.exp q →
        (∀ i, x i ≠ 0) → (∀ i, A.mulVec (fun j => (x j : ℚ)) i ≠ 0) →
        (∏ v, ∏ i, actualThreePlaceValues A x v i) ≤ Real.exp (-ρ * q) →
        ∃ c ∈ C, ∀ v i, actualThreePlaceValues A x v i ≤ Real.exp (c v i * q) := by
  obtain ⟨M, hM, hb⟩ := exists_actual_three_place_log_bounds A
  obtain ⟨C, hC, hcover⟩ := exists_finite_three_place_product_profiles d hd M ρ hρ
  refine ⟨M, hM, C, hC, ?_⟩
  intro q x hq hx hH hxn hAx hprod
  have hbounds := hb q x hq hx hH hxn hAx
  exact hcover q (actualThreePlaceValues A x) (lt_of_lt_of_le (by norm_num) hq)
    (fun v i => (hbounds v i).1) (fun v i => (hbounds v i).2) hprod
    (actualThreePlaceValues_finite_le_one A x)

def exists_finite_primitive_three_place_profiles {d : ℕ} (hd : 0 < d)
    (A : Matrix (Fin d) (Fin d) ℚ) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ M : ℝ, 1 ≤ M ∧ ∃ C : Finset (Fin 3 → Fin d → ℝ),
      (∀ c ∈ C, (∀ v i, |c v i| ≤ M + ρ / (6 * d)) ∧
        (∑ v, ∑ i, c v i) ≤ -ρ / 2 ∧ (∀ v i, v ≠ 0 → c v i ≤ 0)) ∧
      ∀ x : Fin d → ℤ, Finset.univ.gcd x = 1 →
        1 ≤ Height.logHeight (fun i => (x i : ℚ)) →
        (∀ i, x i ≠ 0) → (∀ i, A.mulVec (fun j => (x j : ℚ)) i ≠ 0) →
        (∏ v, ∏ i, actualThreePlaceValues A x v i) ≤
          Height.mulHeight (fun i => (x i : ℚ)) ^ (-ρ) →
        ∃ c ∈ C, ∀ v i, actualThreePlaceValues A x v i ≤
          Real.exp (c v i * Height.logHeight (fun i => (x i : ℚ))) := by
  obtain ⟨M, hM, C, hC, hcover⟩ := exists_finite_actual_three_place_profiles hd A ρ hρ
  refine ⟨M, hM, C, hC, ?_⟩
  intro x hprim hq hxn hAx hprod
  have hx : x ≠ 0 := by
    intro h
    exact hxn ⟨0, hd⟩ (congrFun h ⟨0, hd⟩)
  have hprod' : (∏ v, ∏ i, actualThreePlaceValues A x v i) ≤
      Real.exp (-ρ * Height.logHeight (fun i => (x i : ℚ))) := by
    convert hprod using 1
    rw [Real.rpow_def_of_pos (Height.mulHeight_pos _), Height.logHeight_eq_log_mulHeight]
    congr 1
    ring
  exact hcover _ x hq hx (primitive_integer_exp_logHeight hd x hprim).ge hxn hAx hprod'


end
end Bounty

end SubmissionComponent_ActualProductProfiles

/- Component FiniteEventGap; SHA256 2a751e67763f8e1e3084fdcbc7f65f0fc1c289decdc2ba54c7a6c124cfaa4b8c -/
section SubmissionComponent_FiniteEventGap
/- A fixed-size empty interval among at most 48 event times. -/

namespace Bounty

def finite_events_gap (E : Finset ℝ) (hcard : E.card ≤ 48) {L : ℝ}
    (hL : 0 < L) (a : ℝ) :
    ∃ t : ℝ, a < t ∧ t + L / 0x64 < a + L ∧
      ∀ x ∈ E, x < t ∨ t + L / 0x64 < x := by
  classical
  let t : Fin 50 → ℝ := fun j => a + (4 * (j.val : ℝ) + 1) * L / 0xc8
  have hsep {i j : Fin 50} (hij : i.val < j.val) : t i + L / 0x64 < t j := by
    have hR : (i.val : ℝ) + 1 ≤ j.val := by exact_mod_cast (Nat.succ_le_of_lt hij)
    have hp := mul_le_mul_of_nonneg_right hR hL.le
    dsimp only [t]
    nlinarith
  have hgap : ∃ j : Fin 50, ∀ x ∈ E, x < t j ∨ t j + L / 0x64 < x := by
    by_contra hh
    push_neg at hh
    let f : Fin 50 → E := fun j => ⟨(hh j).choose, (hh j).choose_spec.1⟩
    have hf (j : Fin 50) : t j ≤ (f j : ℝ) ∧ (f j : ℝ) ≤ t j + L / 0x64 :=
      (hh j).choose_spec.2
    have hinj : Function.Injective f := by
      intro i j hij
      apply Fin.ext
      have he : (f i : ℝ) = (f j : ℝ) := congrArg Subtype.val hij
      have hi := hf i
      have hj := hf j
      by_contra hne
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · have hs := hsep hlt
        linarith
      · have hs := hsep hgt
        linarith
    have hc : 50 ≤ E.card := by
      simpa using Fintype.card_le_of_injective f hinj
    omega
  obtain ⟨j, hj⟩ := hgap
  refine ⟨t j, ?_, ?_, hj⟩
  · have hj0 : (0 : ℝ) ≤ j.val := Nat.cast_nonneg _
    have hp := mul_nonneg hj0 hL.le
    dsimp only [t]
    nlinarith
  · have hj49 : (j.val : ℝ) ≤ 49 := by exact_mod_cast (by have hh := j.isLt; omega : j.val ≤ 49)
    have hp := mul_le_mul_of_nonneg_right hj49 hL.le
    dsimp only [t]
    nlinarith

end Bounty

end SubmissionComponent_FiniteEventGap

/- Component SeparatedEventCount; SHA256 3e9cc6c7b4f5e8642d0f5bee936d390507a410aaa0aabd233309789a25d43e77 -/
section SubmissionComponent_SeparatedEventCount
/- Count event times separated by half the window length. -/

namespace Bounty

def separated_events_card_le_three (E : Finset ℝ) {a L : ℝ} (hL : 0 < L)
    (hbounds : ∀ x ∈ E, a ≤ x ∧ x ≤ a + L)
    (hsep : ∀ x ∈ E, ∀ y ∈ E, x ≠ y → L / 2 ≤ |x - y|) : E.card ≤ 3 := by
  classical
  have hz (x : E) : 0 ≤ 2 * ((x : ℝ) - a) / L ∧ 2 * ((x : ℝ) - a) / L ≤ 2 := by
    have hx := hbounds x x.property
    constructor
    · exact div_nonneg (by linarith) hL.le
    · apply (div_le_iff₀ hL).mpr
      linarith
  let f : E → ↥(Finset.Icc (0 : ℤ) 2) := fun x =>
    ⟨⌊2 * ((x : ℝ) - a) / L⌋, Finset.mem_Icc.mpr
      ⟨Int.floor_nonneg.mpr (hz x).1, Int.floor_le_iff.mpr (by
        norm_num only [Int.cast_ofNat]
        linarith [(hz x).2])⟩⟩
  have hinj : Function.Injective f := by
    intro x y hf
    apply Subtype.ext
    by_contra hxy
    have heq : ⌊2 * ((x : ℝ) - a) / L⌋ = ⌊2 * ((y : ℝ) - a) / L⌋ :=
      congrArg Subtype.val hf
    have hh := Int.abs_sub_lt_one_of_floor_eq_floor heq
    have he : 2 * ((x : ℝ) - a) / L - 2 * ((y : ℝ) - a) / L =
        2 * ((x : ℝ) - y) / L := by ring
    rw [he, abs_div, abs_mul, abs_of_pos hL] at hh
    norm_num at hh
    have hsmall := (div_lt_iff₀ hL).mp hh
    have hlarge := hsep x x.property y y.property hxy
    linarith
  have hc := Fintype.card_le_of_injective f hinj
  simpa using hc

end Bounty

end SubmissionComponent_SeparatedEventCount

/- Component LinearEventWindows; SHA256 bbe21ef6c1c85bfeec8e6c48b48fda451fb6cc20db19df9c45f5f973f8b067e0 -/
section SubmissionComponent_LinearEventWindows
/- Finite windows of linearly indexed events and simultaneous gaps for finitely many families. -/

namespace Bounty

noncomputable def linearEventWindow (step offset a b : ℝ) (visit : ℕ → Prop) : Finset ℝ := by
  classical
  exact ((Finset.range (⌈(b + offset) / step⌉₊ + 1)).filter
    (fun n => visit n ∧ a ≤ (n : ℝ) * step - offset ∧ (n : ℝ) * step - offset ≤ b)).image
      (fun n : ℕ => (n : ℝ) * step - offset)

def mem_linearEventWindow {step offset a b x : ℝ} {visit : ℕ → Prop}
    (hstep : 0 < step) :
    x ∈ linearEventWindow step offset a b visit ↔
      ∃ n : ℕ, visit n ∧ x = (n : ℝ) * step - offset ∧ a ≤ x ∧ x ≤ b := by
  classical
  constructor
  · intro hx
    obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hx
    obtain ⟨_, hv, hlo, hhi⟩ := Finset.mem_filter.mp hn
    exact ⟨n, hv, he.symm, he ▸ hlo, he ▸ hhi⟩
  · rintro ⟨n, hv, rfl, hlo, hhi⟩
    have hnr : (n : ℝ) ≤ (b + offset) / step := (le_div_iff₀ hstep).mpr (by linarith)
    have hn : n ≤ ⌈(b + offset) / step⌉₊ := by
      exact_mod_cast hnr.trans (Nat.le_ceil _)
    exact Finset.mem_image.mpr ⟨n, Finset.mem_filter.mpr
      ⟨Finset.mem_range.mpr (by omega), hv, hlo, hhi⟩, rfl⟩

def linearEventWindow_card {step offset a L : ℝ} {visit : ℕ → Prop}
    (hstep : 0 < step) (hL : 0 < L)
    (hsep : ∀ m n : ℕ, visit m → visit n → m < n →
      L / 2 ≤ (n : ℝ) * step - (m : ℝ) * step) :
    (linearEventWindow step offset a (a + L) visit).card ≤ 3 := by
  apply separated_events_card_le_three _ hL
  · intro x hx
    obtain ⟨n, hv, he, hlo, hhi⟩ := (mem_linearEventWindow hstep).mp hx
    exact ⟨hlo, hhi⟩
  · intro x hx y hy hxy
    obtain ⟨m, hm, rfl, _, _⟩ := (mem_linearEventWindow hstep).mp hx
    obtain ⟨n, hn, rfl, _, _⟩ := (mem_linearEventWindow hstep).mp hy
    have hmn : m ≠ n := by rintro rfl; exact hxy rfl
    rcases lt_or_gt_of_ne hmn with hlt | hgt
    · have hh := hsep m n hm hn hlt
      have ha := neg_le_abs (((m : ℝ) * step - offset) - ((n : ℝ) * step - offset))
      linarith
    · have hh := hsep n m hn hm hgt
      have ha := le_abs_self (((m : ℝ) * step - offset) - ((n : ℝ) * step - offset))
      linarith

def linear_event_families_gap {ι : Type*} [Fintype ι]
    (hcard : Fintype.card ι ≤ 16) (step offset : ι → ℝ) (visit : ι → ℕ → Prop)
    (hstep : ∀ i, 0 < step i) {L : ℝ} (hL : 0 < L)
    (hsep : ∀ i m n, visit i m → visit i n → m < n →
      L / 2 ≤ (n : ℝ) * step i - (m : ℝ) * step i) (a : ℝ) :
    ∃ t : ℝ, a < t ∧ t + L / 0x64 < a + L ∧
      ∀ i n, visit i n → (n : ℝ) * step i - offset i < t ∨
        t + L / 0x64 < (n : ℝ) * step i - offset i := by
  classical
  let E (i : ι) := linearEventWindow (step i) (offset i) a (a + L) (visit i)
  have hc (i : ι) : (E i).card ≤ 3 := linearEventWindow_card (hstep i) hL (hsep i)
  have htotal : (Finset.univ.biUnion E).card ≤ 48 := by
    calc
      (Finset.univ.biUnion E).card ≤ ∑ i ∈ Finset.univ, (E i).card := Finset.card_biUnion_le
      _ ≤ ∑ i ∈ (Finset.univ : Finset ι), 3 := Finset.sum_le_sum (fun i _ => hc i)
      _ = 3 * Fintype.card ι := by simp [mul_comm]
      _ ≤ 48 := by omega
  obtain ⟨t, hlo, hhi, hgap⟩ := finite_events_gap (Finset.univ.biUnion E) htotal hL a
  refine ⟨t, hlo, hhi, ?_⟩
  intro i n hv
  by_cases hna : a ≤ (n : ℝ) * step i - offset i
  · by_cases hnb : (n : ℝ) * step i - offset i ≤ a + L
    · have hm : (n : ℝ) * step i - offset i ∈ E i :=
        (mem_linearEventWindow (hstep i)).mpr ⟨n, hv, rfl, hna, hnb⟩
      exact hgap _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hm⟩)
    · exact Or.inr (hhi.trans (lt_of_not_ge hnb))
  · exact Or.inl ((lt_of_not_ge hna).trans hlo)


end Bounty

end SubmissionComponent_LinearEventWindows

/- Component CoprimeCount; SHA256 d3495edc8911ccfeed9ad95a1ddfd61d334116e615f37cd5a7c52791c29af056 -/
section SubmissionComponent_CoprimeCount
/- Exact counts of the cores, and a uniform error from density one third. -/

namespace Bounty

def coprime_six_iff_mod (n : ℕ) : n.Coprime 6 ↔ n % 6 = 1 ∨ n % 6 = 5 := by
  rw [Nat.coprime_iff_gcd_eq_one, Nat.gcd_comm n 6, Nat.gcd_rec]
  have hmod : n % 6 < 6 := Nat.mod_lt _ (by omega)
  interval_cases hm : n % 6 <;> norm_num

def coprimeCores_succ (n : ℕ) :
    coprimeCores (n + 1) = if (n + 1).Coprime 6 then insert (n + 1) (coprimeCores n)
      else coprimeCores n := by
  ext q
  by_cases hc : (n + 1).Coprime 6
  · simp only [if_pos hc, coprimeCores, Finset.mem_filter, Finset.mem_Icc, Finset.mem_insert]
    constructor
    · rintro ⟨⟨hq1, hqn⟩, hq6⟩
      by_cases he : q = n + 1
      · exact Or.inl he
      · exact Or.inr ⟨⟨hq1, by omega⟩, hq6⟩
    · rintro (rfl | ⟨⟨hq1, hqn⟩, hq6⟩)
      · exact ⟨⟨by omega, le_rfl⟩, hc⟩
      · exact ⟨⟨hq1, by omega⟩, hq6⟩
  · simp only [if_neg hc, coprimeCores, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨hq1, hqn⟩, hq6⟩
      have he : q ≠ n + 1 := by intro hh; apply hc; simpa only [← hh] using hq6
      exact ⟨⟨hq1, by omega⟩, hq6⟩
    · rintro ⟨⟨hq1, hqn⟩, hq6⟩
      exact ⟨⟨hq1, by omega⟩, hq6⟩

def coprimeCores_card_succ (n : ℕ) :
    (coprimeCores (n + 1)).card = (coprimeCores n).card + if (n + 1).Coprime 6 then 1 else 0 := by
  rw [coprimeCores_succ]
  have hn : n + 1 ∉ coprimeCores n := by simp [coprimeCores]
  by_cases hc : (n + 1).Coprime 6
  · rw [if_pos hc, if_pos hc, Finset.card_insert_of_notMem hn]
  · simp only [if_neg hc, Nat.add_zero]

def coprimeCores_card (n : ℕ) :
    (coprimeCores n).card = (n + 5) / 6 + (n + 1) / 6 := by
  induction n with
  | zero => norm_num [coprimeCores]
  | succ n ih =>
    rw [coprimeCores_card_succ, ih]
    simp only [coprime_six_iff_mod]
    split_ifs <;> omega

def coprimeCores_card_error (n : ℕ) :
    |(coprimeCores n).card - (n : ℝ) / 3| ≤ 1 := by
  have hcount := coprimeCores_card n
  have hlo : n ≤ 3 * (coprimeCores n).card + 3 := by omega
  have hhi : 3 * (coprimeCores n).card ≤ n + 3 := by omega
  have hlo' : (n : ℝ) ≤ 3 * (coprimeCores n).card + 3 := by exact_mod_cast hlo
  have hhi' : (3 : ℝ) * (coprimeCores n).card ≤ n + 3 := by exact_mod_cast hhi
  rw [abs_le]
  constructor <;> linarith


end Bounty

end SubmissionComponent_CoprimeCount

/- Component CoreConvolution; SHA256 8fda3cecf413fae36aeb718236e89c2e458b686f124119f34b2049d30b18ee99 -/
section SubmissionComponent_CoreConvolution
/- Write the extremal bound as a signed convolution with the core-count function. -/

namespace Bounty

noncomputable def signedRank (n : ℕ) : ℝ := by
  classical
  exact (smoothRankBound n : ℝ) - if badWindow n then 1 else 0

def signedRank_zero : signedRank 0 = 0 := by
  have hb : ¬badWindow 0 := by intro h; have hh := badWindow_ge_ten h; omega
  simp [signedRank, hb, smoothRankBound]

def globalUpper_cast_sum (n : ℕ) :
    (globalUpper n : ℝ) = ∑ q ∈ coprimeCores n, signedRank (n / q) := by
  classical
  have hle : (lossCores n).card ≤ ∑ q ∈ coprimeCores n, smoothRankBound (n / q) := by
    have hh := forkFree_card_with_losses (n := n) (A := ∅) (by simp)
      (by simpa only [Finset.coe_empty] using forkFree_empty)
    simpa only [Finset.card_empty, zero_add] using hh
  unfold globalUpper
  rw [Nat.cast_sub hle]
  simp only [lossCores, Finset.card_filter, Nat.cast_sum]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro q hq
  by_cases hb : badWindow (n / q) <;> simp [signedRank, hb]

def sum_rank_jumps (g : ℕ → ℝ) (hg : g 0 = 0) (n m : ℕ) (hm : m ≤ n) :
    g m = ∑ j ∈ Finset.range n, if j < m then g (j + 1) - g j else 0 := by
  have he : (Finset.range n).filter (fun j => j < m) = Finset.range m := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_range]
    omega
  rw [← Finset.sum_filter, he, Finset.sum_range_sub, hg, sub_zero]

def coprimeCores_filter_quotient (n j : ℕ) :
    (coprimeCores n).filter (fun q => j < n / q) = coprimeCores (n / (j + 1)) := by
  ext q
  simp only [coprimeCores, Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨⟨hq1, _⟩, hq6⟩, hj⟩
    have hm : (j + 1) * q ≤ n := (Nat.le_div_iff_mul_le hq1).mp (by omega)
    have hqhi : q ≤ n / (j + 1) :=
      (Nat.le_div_iff_mul_le (Nat.succ_pos j)).mpr (by simpa only [Nat.mul_comm] using hm)
    exact ⟨⟨hq1, hqhi⟩, hq6⟩
  · rintro ⟨⟨hq1, hqhi⟩, hq6⟩
    have hm : q * (j + 1) ≤ n := (Nat.le_div_iff_mul_le (Nat.succ_pos j)).mp hqhi
    have hj : j + 1 ≤ n / q :=
      (Nat.le_div_iff_mul_le hq1).mpr (by simpa only [Nat.mul_comm] using hm)
    exact ⟨⟨⟨hq1, hqhi.trans (Nat.div_le_self _ _)⟩, hq6⟩, by omega⟩

def sum_over_cores_eq_jumps (g : ℕ → ℝ) (hg : g 0 = 0) (n : ℕ) :
    (∑ q ∈ coprimeCores n, g (n / q)) =
      ∑ j ∈ Finset.range n, (g (j + 1) - g j) * ((coprimeCores (n / (j + 1))).card : ℝ) := by
  classical
  calc
    (∑ q ∈ coprimeCores n, g (n / q)) =
        ∑ q ∈ coprimeCores n, ∑ j ∈ Finset.range n,
          if j < n / q then g (j + 1) - g j else 0 := by
      apply Finset.sum_congr rfl
      intro q hq
      exact sum_rank_jumps g hg n (n / q) (Nat.div_le_self n q)
    _ = ∑ j ∈ Finset.range n, ∑ q ∈ coprimeCores n,
          if j < n / q then g (j + 1) - g j else 0 := Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro j hj
      rw [← Finset.sum_filter, coprimeCores_filter_quotient]
      simp only [Finset.sum_const, nsmul_eq_mul, mul_comm]

noncomputable def signedRankJump (j : ℕ) : ℝ := signedRank (j + 1) - signedRank j

def globalUpper_cast_jumps (n : ℕ) :
    (globalUpper n : ℝ) = ∑ j ∈ Finset.range n,
      signedRankJump j * ((coprimeCores (n / (j + 1))).card : ℝ) := by
  rw [globalUpper_cast_sum, sum_over_cores_eq_jumps signedRank signedRank_zero]
  rfl


end Bounty

end SubmissionComponent_CoreConvolution

/- Component ObstructionJumps; SHA256 98ee629ddd001c1b697421382d013d544107233c299e4a1b0766a16b39d4ecb7 -/
section SubmissionComponent_ObstructionJumps
/- Changes in the obstruction indicator occur on four geometric sequences. -/

namespace Bounty

noncomputable def obstructionIndicator (n : ℕ) : ℝ := by
  classical
  exact if badWindow n then 1 else 0

def obstructionEndpoint (m : ℕ) : Prop :=
  (∃ j, m = 4 ^ j) ∨ (∃ j, m = 5 * 4 ^ j) ∨
    (∃ b, m = 10 * 3 ^ b) ∨ (∃ b, m = 12 * 3 ^ b)

def badWindow_enter {n : ℕ} (hn : ¬badWindow n) (hs : badWindow (n + 1)) :
    (∃ j, n + 1 = 4 ^ j) ∨ (∃ b, n + 1 = 10 * 3 ^ b) := by
  obtain ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩ := hs
  by_cases he4 : n + 1 = 4 ^ j
  · exact Or.inl ⟨j, he4⟩
  by_cases he3 : n + 1 = 10 * 3 ^ b
  · exact Or.inr ⟨b, he3⟩
  exact (hn ⟨j, b, by omega, by omega, by omega, by omega⟩).elim

def badWindow_exit {n : ℕ} (hn : badWindow n) (hs : ¬badWindow (n + 1)) :
    (∃ j, n + 1 = 5 * 4 ^ j) ∨ (∃ b, n + 1 = 12 * 3 ^ b) := by
  obtain ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩ := hn
  have h3pos : 0 < (3 : ℕ) ^ b := by positivity
  have hj : j ≠ 0 := by
    intro he
    simp only [he, pow_zero] at h4hi
    omega
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj
  have h4pow : (4 : ℕ) ^ (j + 1) = 4 ^ j * 4 := pow_succ 4 j
  by_cases he4 : n + 1 = 5 * 4 ^ j
  · exact Or.inl ⟨j, he4⟩
  by_cases he3 : n + 1 = 12 * 3 ^ b
  · exact Or.inr ⟨b, he3⟩
  exact (hs ⟨j + 1, b, by omega, by omega, by omega, by omega⟩).elim

def obstruction_change_endpoint {n : ℕ}
    (h : obstructionIndicator (n + 1) ≠ obstructionIndicator n) : obstructionEndpoint (n + 1) := by
  classical
  by_cases hs : badWindow (n + 1)
  · by_cases hn : badWindow n
    · exact (h (by simp [obstructionIndicator, hn, hs])).elim
    · rcases badWindow_enter hn hs with h4 | h3
      · exact Or.inl h4
      · exact Or.inr (Or.inr (Or.inl h3))
  · by_cases hn : badWindow n
    · rcases badWindow_exit hn hs with h4 | h3
      · exact Or.inr (Or.inl h4)
      · exact Or.inr (Or.inr (Or.inr h3))
    · exact (h (by simp [obstructionIndicator, hn, hs])).elim

def obstruction_jump_abs_le_one (n : ℕ) :
    |obstructionIndicator (n + 1) - obstructionIndicator n| ≤ 1 := by
  classical
  by_cases hs : badWindow (n + 1) <;> by_cases hn : badWindow n <;>
    norm_num [obstructionIndicator, hn, hs]


end Bounty

end SubmissionComponent_ObstructionJumps

/- Component GeometricSupport; SHA256 fe012c70b951305de3c432c8e1992cd49aa85e02a370e7be8a3e5ef6c65ff895 -/
section SubmissionComponent_GeometricSupport
/- Weighted indicators of geometric sets, and summability of obstruction jumps. -/

namespace Bounty

noncomputable def geometricEndpointTerm (a b m : ℕ) : ℝ := by
  classical
  exact if ∃ j, m = a * b ^ j then 1 / (m : ℝ) else 0

def geometricEndpointTerm_nonneg (a b m : ℕ) : 0 ≤ geometricEndpointTerm a b m := by
  classical
  unfold geometricEndpointTerm
  split_ifs <;> positivity

def geometricEndpointTerm_at {a b m : ℕ} (h : ∃ j, m = a * b ^ j) :
    geometricEndpointTerm a b m = 1 / (m : ℝ) := by
  classical
  simp only [geometricEndpointTerm, if_pos h]

def geometricEndpointTerm_summable {a b : ℕ} (ha : 0 < a) (hb : 1 < b) :
    Summable (geometricEndpointTerm a b) := by
  classical
  have hi : Function.Injective (fun j : ℕ => a * b ^ j) := by
    intro i j hij
    apply Nat.pow_right_injective (by omega : 2 ≤ b)
    nlinarith
  apply (hi.summable_iff (f := geometricEndpointTerm a b) ?_).mp
  · have hs : Summable (fun j : ℕ => (1 / (a : ℝ)) / (b : ℝ) ^ j) :=
      weighted_summable (by exact_mod_cast hb) (fun _ => le_refl |1 / (a : ℝ)|)
    apply hs.congr
    intro j
    simp only [Function.comp_apply, geometricEndpointTerm_at ⟨j, rfl⟩,
      Nat.cast_mul, Nat.cast_pow, div_div]
  · intro m hm
    have hn : ¬∃ j, m = a * b ^ j := by simpa only [Set.mem_range, eq_comm] using hm
    simp only [geometricEndpointTerm, if_neg hn]

def geometricEndpointTerm_summable_shift {a b : ℕ} (ha : 0 < a) (hb : 1 < b) :
    Summable (fun n : ℕ => geometricEndpointTerm a b (n + 1)) :=
  (summable_nat_add_iff 1).mpr (geometricEndpointTerm_summable ha hb)

def obstruction_jump_geometric_bound (n : ℕ) :
    |obstructionIndicator (n + 1) - obstructionIndicator n| / (n + 1 : ℕ) ≤
      geometricEndpointTerm 1 4 (n + 1) + geometricEndpointTerm 5 4 (n + 1) +
        geometricEndpointTerm 10 3 (n + 1) + geometricEndpointTerm 12 3 (n + 1) := by
  have h1 := geometricEndpointTerm_nonneg 1 4 (n + 1)
  have h5 := geometricEndpointTerm_nonneg 5 4 (n + 1)
  have h10 := geometricEndpointTerm_nonneg 10 3 (n + 1)
  have h12 := geometricEndpointTerm_nonneg 12 3 (n + 1)
  by_cases he : obstructionIndicator (n + 1) = obstructionIndicator n
  · simp only [he, sub_self, abs_zero, zero_div]
    linarith
  · have hb := div_le_div_of_nonneg_right (obstruction_jump_abs_le_one n)
      (Nat.cast_nonneg (α := ℝ) (n + 1))
    rcases obstruction_change_endpoint he with h | h | h | h
    · have ht := geometricEndpointTerm_at (a := 1) (b := 4) (by simpa only [one_mul] using h)
      linarith
    · have ht := geometricEndpointTerm_at h
      linarith
    · have ht := geometricEndpointTerm_at h
      linarith
    · have ht := geometricEndpointTerm_at h
      linarith

def obstruction_jumps_summable :
    Summable (fun n : ℕ => |obstructionIndicator (n + 1) - obstructionIndicator n| / (n + 1 : ℕ)) := by
  have h1 := geometricEndpointTerm_summable_shift (a := 1) (b := 4) (by norm_num) (by norm_num)
  have h5 := geometricEndpointTerm_summable_shift (a := 5) (b := 4) (by norm_num) (by norm_num)
  have h10 := geometricEndpointTerm_summable_shift (a := 10) (b := 3) (by norm_num) (by norm_num)
  have h12 := geometricEndpointTerm_summable_shift (a := 12) (b := 3) (by norm_num) (by norm_num)
  apply (((h1.add h5).add h10).add h12).of_norm_bounded
  intro n
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity :
    0 ≤ |obstructionIndicator (n + 1) - obstructionIndicator n| / (n + 1 : ℕ))]
  exact obstruction_jump_geometric_bound n


end Bounty

end SubmissionComponent_GeometricSupport

/- Component RankJumps; SHA256 bc15f246c20c419c82f9b29f9d97eca9e81b4ceecb888445aea0284ee5e7def8 -/
section SubmissionComponent_RankJumps
/- Rank jumps have bounded size and lie on three geometric sequences. -/

namespace Bounty

def rankEndpoint (m : ℕ) : Prop :=
  (∃ j, m = 2 ^ j) ∨ (∃ j, m = 3 ^ j) ∨ (∃ j, m = 2 * 3 ^ j)

def nat_log_succ_eq_of_not_power {b n : ℕ} (hb : 1 < b)
    (he : n + 1 ≠ b ^ Nat.log b (n + 1)) : Nat.log b (n + 1) = Nat.log b n := by
  have hlo := Nat.pow_log_le_self b (Nat.succ_ne_zero n)
  have hhi := Nat.lt_pow_succ_log_self hb (n + 1)
  simp only [Nat.succ_eq_add_one] at hlo hhi
  symm
  exact Nat.log_eq_of_pow_le_of_lt_pow (by omega) (by omega)

def nat_log_succ_bounds {b n : ℕ} (hb : 1 < b) (hn : 0 < n) :
    Nat.log b n ≤ Nat.log b (n + 1) ∧ Nat.log b (n + 1) ≤ Nat.log b n + 1 := by
  constructor
  · exact Nat.log_mono_right (by omega)
  · have hnle : n + 1 ≤ n * b := by nlinarith
    have hh := Nat.log_mono_right (b := b) hnle
    rwa [Nat.log_mul_base hb (ne_of_gt hn)] at hh

def smoothRank_change_endpoint {n : ℕ}
    (h : smoothRankBound (n + 1) ≠ smoothRankBound n) : rankEndpoint (n + 1) := by
  by_cases hn : n = 0
  · subst n
    exact Or.inl ⟨0, by norm_num⟩
  by_cases h2 : n + 1 = 2 ^ Nat.log 2 (n + 1)
  · exact Or.inl ⟨_, h2⟩
  by_cases h3 : n + 1 = 3 ^ Nat.log 3 (n + 1)
  · exact Or.inr (Or.inl ⟨_, h3⟩)
  by_cases he : n + 1 = 2 * 3 ^ Nat.log 3 n
  · exact Or.inr (Or.inr ⟨_, he⟩)
  have hl2 := nat_log_succ_eq_of_not_power (by norm_num : 1 < 2) h2
  have hl3 := nat_log_succ_eq_of_not_power (by norm_num : 1 < 3) h3
  have hc : (2 * 3 ^ Nat.log 3 n ≤ n + 1) ↔ (2 * 3 ^ Nat.log 3 n ≤ n) := by omega
  apply False.elim
  apply h
  simp only [smoothRankBound, hn, Nat.succ_ne_zero, ↓reduceIte, hl2, hl3, hc]

def smoothRank_succ_bounds (n : ℕ) :
    smoothRankBound (n + 1) ≤ smoothRankBound n + 3 ∧
      smoothRankBound n ≤ smoothRankBound (n + 1) + 3 := by
  by_cases hn : n = 0
  · subst n
    norm_num [smoothRankBound]
  have h2 := nat_log_succ_bounds (b := 2) (by norm_num) (by omega : 0 < n)
  have h3 := nat_log_succ_bounds (b := 3) (by norm_num) (by omega : 0 < n)
  simp only [smoothRankBound, hn, Nat.succ_ne_zero, ↓reduceIte]
  split_ifs <;> omega

def smoothRank_jump_abs (n : ℕ) :
    |(smoothRankBound (n + 1) : ℝ) - smoothRankBound n| ≤ 3 := by
  have hh := smoothRank_succ_bounds n
  have hlo : (smoothRankBound (n + 1) : ℝ) ≤ smoothRankBound n + 3 := by exact_mod_cast hh.1
  have hhi : (smoothRankBound n : ℝ) ≤ smoothRankBound (n + 1) + 3 := by exact_mod_cast hh.2
  rw [abs_le]
  constructor <;> linarith


end Bounty

end SubmissionComponent_RankJumps

/- Component JumpSummability; SHA256 fd83812df6869dbb62b2b08ed3d540559b8755bdab642a09f419f6ff42ea744c -/
section SubmissionComponent_JumpSummability
/- Absolute weighted summability of every jump in the exact extremal formula. -/

namespace Bounty

def rank_jump_geometric_bound (n : ℕ) :
    |(smoothRankBound (n + 1) : ℝ) - smoothRankBound n| / (n + 1 : ℕ) ≤
      3 * (geometricEndpointTerm 1 2 (n + 1) + geometricEndpointTerm 1 3 (n + 1) +
        geometricEndpointTerm 2 3 (n + 1)) := by
  have h2 := geometricEndpointTerm_nonneg 1 2 (n + 1)
  have h3 := geometricEndpointTerm_nonneg 1 3 (n + 1)
  have h23 := geometricEndpointTerm_nonneg 2 3 (n + 1)
  by_cases he : smoothRankBound (n + 1) = smoothRankBound n
  · simp only [he, sub_self, abs_zero, zero_div]
    linarith
  · have hb := div_le_div_of_nonneg_right (smoothRank_jump_abs n)
      (Nat.cast_nonneg (α := ℝ) (n + 1))
    rcases smoothRank_change_endpoint he with h | h | h
    · have ht := geometricEndpointTerm_at (a := 1) (b := 2) (by simpa only [one_mul] using h)
      rw [show (3 : ℝ) / (n + 1 : ℕ) = 3 * (1 / (n + 1 : ℕ)) by ring] at hb
      linarith
    · have ht := geometricEndpointTerm_at (a := 1) (b := 3) (by simpa only [one_mul] using h)
      rw [show (3 : ℝ) / (n + 1 : ℕ) = 3 * (1 / (n + 1 : ℕ)) by ring] at hb
      linarith
    · have ht := geometricEndpointTerm_at h
      rw [show (3 : ℝ) / (n + 1 : ℕ) = 3 * (1 / (n + 1 : ℕ)) by ring] at hb
      linarith

def rank_jumps_summable :
    Summable (fun n : ℕ => |(smoothRankBound (n + 1) : ℝ) - smoothRankBound n| / (n + 1 : ℕ)) := by
  have h2 := geometricEndpointTerm_summable_shift (a := 1) (b := 2) (by norm_num) (by norm_num)
  have h3 := geometricEndpointTerm_summable_shift (a := 1) (b := 3) (by norm_num) (by norm_num)
  have h23 := geometricEndpointTerm_summable_shift (a := 2) (b := 3) (by norm_num) (by norm_num)
  apply (((h2.add h3).add h23).mul_left 3).of_norm_bounded
  intro n
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity :
    0 ≤ |(smoothRankBound (n + 1) : ℝ) - smoothRankBound n| / (n + 1 : ℕ))]
  exact rank_jump_geometric_bound n

def signedRankJump_decomposition (n : ℕ) :
    signedRankJump n = ((smoothRankBound (n + 1) : ℝ) - smoothRankBound n) -
      (obstructionIndicator (n + 1) - obstructionIndicator n) := by
  unfold signedRankJump signedRank obstructionIndicator
  ring

def signedRank_jumps_summable :
    Summable (fun n : ℕ => |signedRankJump n| / (n + 1 : ℕ)) := by
  apply (rank_jumps_summable.add obstruction_jumps_summable).of_norm_bounded
  intro n
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ |signedRankJump n| / (n + 1 : ℕ)),
    signedRankJump_decomposition]
  have hh : |((smoothRankBound (n + 1) : ℝ) - smoothRankBound n) -
        (obstructionIndicator (n + 1) - obstructionIndicator n)| ≤
      |(smoothRankBound (n + 1) : ℝ) - smoothRankBound n| +
        |obstructionIndicator (n + 1) - obstructionIndicator n| := by
    simpa only [sub_zero, zero_sub, abs_neg] using
      abs_sub_le ((smoothRankBound (n + 1) : ℝ) - smoothRankBound n) 0
        (obstructionIndicator (n + 1) - obstructionIndicator n)
  simpa only [add_div] using div_le_div_of_nonneg_right hh (Nat.cast_nonneg (α := ℝ) (n + 1))


end Bounty

end SubmissionComponent_JumpSummability

/- Component CoprimeLimit; SHA256 69cbf0abef3ea6690a02d6a04f8adab64f01cc41e052e2ab277e95973d957e72 -/
section SubmissionComponent_CoprimeLimit
/- Uniform approximation and limiting density for dilated core counts. -/

open Filter
open scoped Topology

namespace Bounty

def coprimeCores_div_error {n d : ℕ} (hn : 0 < n) (hd : 0 < d) :
    |((coprimeCores (n / d)).card : ℝ) / n - 1 / (3 * d)| ≤ (4 / 3 : ℝ) / n := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
  have hd0 : (0 : ℝ) < d := by exact_mod_cast hd
  have hdown : n / d * d ≤ n := Nat.div_mul_le_self n d
  have hup : n < (n / d + 1) * d := by
    have hr := Nat.mod_lt n hd
    have he := Nat.div_add_mod n d
    nlinarith
  have hdown' : (n / d : ℕ) ≤ (n : ℝ) / d := by
    apply (le_div_iff₀ hd0).mpr
    exact_mod_cast hdown
  have hup' : (n : ℝ) / d - 1 ≤ (n / d : ℕ) := by
    have hh : (n : ℝ) / d < (n / d : ℕ) + 1 := by
      apply (div_lt_iff₀ hd0).mpr
      exact_mod_cast hup
    linarith
  have hc := abs_le.mp (coprimeCores_card_error (n / d))
  have hc' : |((coprimeCores (n / d)).card : ℝ) - (n : ℝ) / (3 * d)| ≤ 4 / 3 := by
    have he : (n : ℝ) / (3 * d) = ((n : ℝ) / d) / 3 := by ring
    rw [he, abs_le]
    constructor <;> linarith
  have he : ((coprimeCores (n / d)).card : ℝ) / n - 1 / (3 * d) =
      (((coprimeCores (n / d)).card : ℝ) - (n : ℝ) / (3 * d)) / n := by
    field_simp
  rw [he, abs_div, abs_of_pos hn0]
  exact div_le_div_of_nonneg_right hc' hn0.le

def tendsto_coprimeCores_div {d : ℕ} (hd : 0 < d) :
    Tendsto (fun n : ℕ => ((coprimeCores (n / d)).card : ℝ) / n)
      atTop (nhds (1 / (3 * (d : ℝ)))) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have he : ∀ᶠ n : ℕ in atTop, (4 / 3 : ℝ) / n < ε :=
    (tendsto_const_div_atTop_nhds_zero_nat (4 / 3 : ℝ)).eventually (gt_mem_nhds hε)
  filter_upwards [he, eventually_ge_atTop 1] with n hn hn1
  rw [Real.dist_eq]
  exact (coprimeCores_div_error (by omega) hd).trans_lt hn

def coprimeCores_card_le (n : ℕ) : (coprimeCores n).card ≤ n := by
  have hh : (coprimeCores n).card ≤ (Finset.Icc 1 n).card :=
    Finset.card_le_card (Finset.filter_subset _ _)
  simpa only [Nat.card_Icc, Nat.add_sub_cancel] using hh

def coprimeCores_div_bound {n d : ℕ} (hn : 0 < n) (hd : 0 < d) :
    0 ≤ ((coprimeCores (n / d)).card : ℝ) / n ∧
      ((coprimeCores (n / d)).card : ℝ) / n ≤ 1 / (d : ℝ) := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast hn
  have hd0 : (0 : ℝ) < d := by exact_mod_cast hd
  constructor
  · positivity
  · apply (div_le_div_iff₀ hn0 hd0).mpr
    have hh := Nat.mul_le_mul_right d (coprimeCores_card_le (n / d))
    have he := Nat.div_mul_le_self n d
    norm_num only [one_mul]
    exact_mod_cast hh.trans he


end Bounty

end SubmissionComponent_CoprimeLimit

/- Component CoreConvolutionLimit; SHA256 91f1c53b10af5e40623001278220dac12a8fc796fa5ed144d7726ab4c6a7e408 -/
section SubmissionComponent_CoreConvolutionLimit
/- A dominated-convergence theorem for signed core convolutions. -/

open Filter
open scoped Topology

namespace Bounty

def tendsto_core_weighted_series {a : ℕ → ℝ}
    (ha : Summable (fun d : ℕ => |a d| / (d + 1 : ℕ))) :
    Tendsto (fun n : ℕ => ∑' d : ℕ,
        a d * (((coprimeCores (n / (d + 1))).card : ℝ) / n))
      atTop (nhds (∑' d : ℕ, a d / (3 * (d + 1 : ℕ)))) := by
  apply tendsto_tsum_of_dominated_convergence ha
  · intro d
    have hh := (tendsto_coprimeCores_div (Nat.succ_pos d)).const_mul (a d)
    simpa only [mul_one_div] using hh
  · filter_upwards [eventually_ge_atTop 1] with n hn d
    have hb := coprimeCores_div_bound (n := n) (d := d + 1) (by omega) (by omega)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hb.1]
    have hh := mul_le_mul_of_nonneg_left hb.2 (abs_nonneg (a d))
    simpa only [mul_one_div] using hh

def core_weighted_series_eq_sum (a : ℕ → ℝ) (n : ℕ) :
    (∑' d : ℕ, a d * (((coprimeCores (n / (d + 1))).card : ℝ) / n)) =
      (∑ d ∈ Finset.range n, a d * ((coprimeCores (n / (d + 1))).card : ℝ)) / n := by
  have hz : ∀ d ∉ Finset.range n,
      a d * (((coprimeCores (n / (d + 1))).card : ℝ) / n) = 0 := by
    intro d hd
    have hnd : n < d + 1 := by simp only [Finset.mem_range] at hd; omega
    simp [Nat.div_eq_of_lt hnd, coprimeCores]
  rw [tsum_eq_sum hz]
  simp only [Finset.sum_div, mul_div_assoc]

def tendsto_core_weighted_sum {a : ℕ → ℝ}
    (ha : Summable (fun d : ℕ => |a d| / (d + 1 : ℕ))) :
    Tendsto (fun n : ℕ =>
        (∑ d ∈ Finset.range n, a d * ((coprimeCores (n / (d + 1))).card : ℝ)) / n)
      atTop (nhds (∑' d : ℕ, a d / (3 * (d + 1 : ℕ)))) := by
  simpa only [core_weighted_series_eq_sum] using tendsto_core_weighted_series ha


end Bounty

end SubmissionComponent_CoreConvolutionLimit

/- Component JumpDensity; SHA256 a84b8cfc4532cf67cd97fd894fdd3ea011a8cc194d70fec31ef8b8c90f5f20cc -/
section SubmissionComponent_JumpDensity
/- The remaining analytic hypothesis for the exact bound is weighted summability of its jumps. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def jumpDensity : ℝ := ∑' j : ℕ, signedRankJump j / (3 * (j + 1 : ℕ))

def tendsto_globalUpper_of_summable_jumps
    (h : Summable (fun j : ℕ => |signedRankJump j| / (j + 1 : ℕ))) :
    Tendsto (fun n : ℕ => (globalUpper n : ℝ) / n) atTop (nhds jumpDensity) := by
  simpa only [← globalUpper_cast_jumps, jumpDensity, Nat.cast_mul, Nat.cast_ofNat] using tendsto_core_weighted_sum h

def tendsto_f_of_exact_and_summable_jumps
    (he : ∀ n, Erdos1062.f n = globalUpper n)
    (h : Summable (fun j : ℕ => |signedRankJump j| / (j + 1 : ℕ))) :
    Tendsto (fun n : ℕ => (Erdos1062.f n : ℝ) / n) atTop (nhds jumpDensity) := by
  simpa only [he] using tendsto_globalUpper_of_summable_jumps h


end Bounty

end SubmissionComponent_JumpDensity

/- Component DiscreteAbel; SHA256 83ad651cb91b1992dca3cdb7b8d3d82fa6a008b7ccf13e1f406c16b0a2d610ad -/
section SubmissionComponent_DiscreteAbel
/- Summation by parts for reciprocal weights, with an explicit boundary term. -/

open Filter
open scoped Topology

namespace Bounty

def sum_reciprocal_kernel (N : ℕ) :
    (∑ n ∈ Finset.range N, (1 : ℝ) / ((n + 1 : ℕ) * (n + 2 : ℕ))) =
      1 - 1 / (N + 1 : ℕ) := by
  induction N with
  | zero => norm_num
  | succ N ih =>
    rw [Finset.sum_range_succ, ih]
    push_cast
    have h1 : (N : ℝ) + 1 ≠ 0 := by positivity
    have h2 : (N : ℝ) + 2 ≠ 0 := by positivity
    field_simp
    ring

def hasSum_reciprocal_kernel :
    HasSum (fun n : ℕ => (1 : ℝ) / ((n + 1 : ℕ) * (n + 2 : ℕ))) 1 := by
  apply (hasSum_iff_tendsto_nat_of_nonneg (fun n => by positivity) 1).mpr
  simp only [sum_reciprocal_kernel]
  have h : Tendsto (fun n : ℕ => (1 : ℝ) / (n + 1 : ℕ)) atTop (nhds 0) :=
    (tendsto_const_div_atTop_nhds_zero_nat (1 : ℝ)).comp (tendsto_add_atTop_nat 1)
  simpa only [sub_zero] using tendsto_const_nhds.sub h

def bounded_reciprocal_kernel_summable {w : ℕ → ℝ} {M : ℝ}
    (hw : ∀ n, |w n| ≤ M) :
    Summable (fun n : ℕ => w (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ))) := by
  apply (hasSum_reciprocal_kernel.summable.mul_left M).of_norm_bounded
  intro n
  rw [Real.norm_eq_abs, abs_div, abs_of_nonneg (by positivity :
    (0 : ℝ) ≤ (n + 1 : ℕ) * (n + 2 : ℕ))]
  simpa only [mul_one_div] using
    div_le_div_of_nonneg_right (hw (n + 1))
      (by positivity : (0 : ℝ) ≤ (n + 1 : ℕ) * (n + 2 : ℕ))

def sum_reciprocal_jumps (w : ℕ → ℝ) (hw : w 0 = 0) (N : ℕ) :
    (∑ n ∈ Finset.range N, (w (n + 1) - w n) / (n + 1 : ℕ)) =
      w N / (N + 1 : ℕ) +
        ∑ n ∈ Finset.range N, w (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ)) := by
  induction N with
  | zero => simp [hw]
  | succ N ih =>
    rw [Finset.sum_range_succ, Finset.sum_range_succ, ih]
    push_cast
    have h1 : (N : ℝ) + 1 ≠ 0 := by positivity
    have h2 : (N : ℝ) + 2 ≠ 0 := by positivity
    field_simp
    ring

def tsum_reciprocal_jumps {w : ℕ → ℝ} (hw : w 0 = 0)
    (hj : Summable (fun n : ℕ => (w (n + 1) - w n) / (n + 1 : ℕ)))
    (hk : Summable (fun n : ℕ => w (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ))))
    (ht : Tendsto (fun N : ℕ => w N / (N + 1 : ℕ)) atTop (nhds 0)) :
    (∑' n : ℕ, (w (n + 1) - w n) / (n + 1 : ℕ)) =
      ∑' n : ℕ, w (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ)) := by
  have hlim := ht.add hk.hasSum.tendsto_sum_nat
  simp only [zero_add, ← sum_reciprocal_jumps w hw] at hlim
  exact tendsto_nhds_unique hj.hasSum.tendsto_sum_nat hlim

def bounded_div_nat_tendsto_zero {w : ℕ → ℝ} {M : ℝ}
    (hw : ∀ n, |w n| ≤ M) :
    Tendsto (fun N : ℕ => w N / (N + 1 : ℕ)) atTop (nhds 0) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have ht : Tendsto (fun N : ℕ => M / (N + 1 : ℕ)) atTop (nhds 0) :=
    (tendsto_const_div_atTop_nhds_zero_nat M).comp (tendsto_add_atTop_nat 1)
  filter_upwards [ht.eventually (gt_mem_nhds hε)] with n hn
  rw [Real.dist_eq, sub_zero, abs_div,
    abs_of_nonneg (Nat.cast_nonneg (α := ℝ) (n + 1))]
  exact (div_le_div_of_nonneg_right (hw n) (Nat.cast_nonneg (α := ℝ) (n + 1))).trans_lt hn


end Bounty

end SubmissionComponent_DiscreteAbel

/- Component LogJumpSeries; SHA256 4c47fb1149ab0a63731fa53ef000a1700531467cf90e09cdb9962dbd60656a5d -/
section SubmissionComponent_LogJumpSeries
/- The reciprocal jumps of the integer logarithm have an exact rational sum. -/

namespace Bounty

def geometricEndpointTerm_hasSum {a b : ℕ} (ha : 0 < a) (hb : 1 < b) :
    HasSum (geometricEndpointTerm a b) ((1 / (a : ℝ)) * (1 - 1 / (b : ℝ))⁻¹) := by
  classical
  have hi : Function.Injective (fun j : ℕ => a * b ^ j) := by
    intro i j hij
    apply Nat.pow_right_injective (by omega : 2 ≤ b)
    nlinarith
  apply (hi.hasSum_iff (f := geometricEndpointTerm a b) ?_).mp
  · have hbr : (1 : ℝ) < b := by exact_mod_cast hb
    have hgeo := (hasSum_geometric_of_lt_one
      (by positivity : (0 : ℝ) ≤ 1 / (b : ℝ))
      (by simpa only [one_div] using inv_lt_one_of_one_lt₀ hbr)).mul_left (1 / (a : ℝ))
    apply hgeo.congr_fun
    intro j
    simp only [Function.comp_apply, geometricEndpointTerm_at ⟨j, rfl⟩,
      Nat.cast_mul, Nat.cast_pow, div_pow, one_pow]
    ring
  · intro m hm
    have hn : ¬∃ j, m = a * b ^ j := by simpa only [Set.mem_range, eq_comm] using hm
    simp only [geometricEndpointTerm, if_neg hn]

def geometricEndpointTerm_zero {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    geometricEndpointTerm a b 0 = 0 := by
  classical
  have hn : ¬∃ j, 0 = a * b ^ j := by
    rintro ⟨j, hj⟩
    have hp : 0 < a * b ^ j := by positivity
    omega
  simp only [geometricEndpointTerm, if_neg hn]

def geometricEndpointTerm_tsum_shift {a b : ℕ} (ha : 0 < a) (hb : 1 < b) :
    (∑' n : ℕ, geometricEndpointTerm a b (n + 1)) =
      (1 / (a : ℝ)) * (1 - 1 / (b : ℝ))⁻¹ := by
  have hs := geometricEndpointTerm_hasSum ha hb
  have he := hs.summable.sum_add_tsum_nat_add 1
  simpa only [Finset.sum_range_one, geometricEndpointTerm_zero ha (by omega : 0 < b),
    zero_add, hs.tsum_eq] using he

open scoped Classical in
def nat_log_jump {b : ℕ} (hb : 1 < b) (n : ℕ) :
    ((Nat.log b (n + 1) : ℝ) - Nat.log b n) =
      if ∃ j, n + 1 = b * b ^ j then 1 else 0 := by
  classical
  by_cases he : ∃ j, n + 1 = b * b ^ j
  · obtain ⟨j, hj⟩ := he
    have hp : n + 1 = b ^ (j + 1) := by simpa only [pow_succ', Nat.succ_eq_add_one] using hj
    have hpow : 0 < b ^ j := by positivity
    have hlo : b ^ j ≤ n := by nlinarith
    have hl := Nat.log_eq_of_pow_le_of_lt_pow hlo (by omega : n < b ^ (j + 1))
    rw [if_pos ⟨j, hj⟩, hl, hp, Nat.log_pow hb]
    push_cast
    ring
  · rw [if_neg he]
    by_cases hn : n = 0
    · subst n
      simp
    have hh : n + 1 ≠ b ^ Nat.log b (n + 1) := by
      intro hh
      have hk : Nat.log b (n + 1) ≠ 0 := by
        intro hk
        rw [hk, pow_zero] at hh
        omega
      obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero hk
      apply he
      exact ⟨j, by simpa only [hj, pow_succ', Nat.succ_eq_add_one] using hh⟩
    rw [nat_log_succ_eq_of_not_power hb hh, sub_self]

def nat_log_jump_div {b : ℕ} (hb : 1 < b) (n : ℕ) :
    ((Nat.log b (n + 1) : ℝ) - Nat.log b n) / (n + 1 : ℕ) =
      geometricEndpointTerm b b (n + 1) := by
  classical
  rw [nat_log_jump hb]
  unfold geometricEndpointTerm
  split_ifs <;> simp

def nat_log_jumps_summable {b : ℕ} (hb : 1 < b) :
    Summable (fun n : ℕ => ((Nat.log b (n + 1) : ℝ) - Nat.log b n) / (n + 1 : ℕ)) := by
  simpa only [nat_log_jump_div hb] using
    geometricEndpointTerm_summable_shift (a := b) (b := b) (by omega) hb

def nat_log_jumps_tsum {b : ℕ} (hb : 1 < b) :
    (∑' n : ℕ, ((Nat.log b (n + 1) : ℝ) - Nat.log b n) / (n + 1 : ℕ)) =
      1 / ((b : ℝ) - 1) := by
  simp only [nat_log_jump_div hb]
  rw [geometricEndpointTerm_tsum_shift (by omega : 0 < b) hb]
  have hbr : (1 : ℝ) < b := by exact_mod_cast hb
  field_simp


end Bounty

end SubmissionComponent_LogJumpSeries

/- Component DensityCorrection; SHA256 48f32369bac030c9134216d1427de234afac9a29afe301a6f01c0f5de3303c91 -/
section SubmissionComponent_DensityCorrection
/- The density is a rational contribution plus the overlap minus obstruction correction. -/

namespace Bounty

def overlapWindow (n : ℕ) : Prop :=
  0 < n ∧ 2 * 4 ^ Nat.log 4 n ≤ n ∧ 2 * 3 ^ Nat.log 3 n ≤ n

noncomputable def overlapIndicator (n : ℕ) : ℝ := by
  classical
  exact if overlapWindow n then 1 else 0

noncomputable def correctionIndicator (n : ℕ) : ℝ :=
  overlapIndicator n - obstructionIndicator n

def overlapWindow_iff_intervals (n : ℕ) :
    overlapWindow n ↔ ∃ j b : ℕ, 2 * 4 ^ j ≤ n ∧ n < 4 ^ (j + 1) ∧
      2 * 3 ^ b ≤ n ∧ n < 3 ^ (b + 1) := by
  constructor
  · rintro ⟨hn, h4, h3⟩
    exact ⟨Nat.log 4 n, Nat.log 3 n, h4,
      Nat.lt_pow_succ_log_self (by norm_num) n, h3,
      Nat.lt_pow_succ_log_self (by norm_num) n⟩
  · rintro ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩
    have h4pos : 0 < (4 : ℕ) ^ j := by positivity
    have h4 := Nat.log_eq_of_pow_le_of_lt_pow (by omega : 4 ^ j ≤ n) h4hi
    have h3 := Nat.log_eq_of_pow_le_of_lt_pow (by omega : 3 ^ b ≤ n) h3hi
    exact ⟨by omega, by rwa [h4], by rwa [h3]⟩

def correctionIndicator_zero : correctionIndicator 0 = 0 := by
  classical
  have hn : ¬badWindow 0 := by
    rintro ⟨j, b, hj, _, _, _⟩
    have hp : 0 < (4 : ℕ) ^ j := by positivity
    omega
  simp [correctionIndicator, overlapIndicator, overlapWindow, obstructionIndicator, hn]

def correctionIndicator_bound (n : ℕ) : |correctionIndicator n| ≤ 1 := by
  classical
  unfold correctionIndicator overlapIndicator obstructionIndicator
  split_ifs <;> norm_num

def signedRank_log_decomposition (n : ℕ) :
    signedRank n = (if n = 0 then 0 else 1) + (Nat.log 3 n : ℝ) + Nat.log 4 n +
      correctionIndicator n := by
  classical
  by_cases hn : n = 0
  · subst n
    simp [signedRank_zero, correctionIndicator_zero]
  have hp := log_two_odd_iff_four_threshold (by omega : 0 < n)
  simp only [signedRank, smoothRankBound, hn, ↓reduceIte, correctionIndicator,
    overlapIndicator, obstructionIndicator, overlapWindow, show 0 < n by omega,
    true_and, ← log_four_eq, hp]
  split_ifs <;> push_cast <;> ring

def signedRankJump_log_decomposition (n : ℕ) :
    signedRankJump n / (n + 1 : ℕ) =
      (if n = 0 then 1 else 0) +
      ((Nat.log 3 (n + 1) : ℝ) - Nat.log 3 n) / (n + 1 : ℕ) +
      ((Nat.log 4 (n + 1) : ℝ) - Nat.log 4 n) / (n + 1 : ℕ) +
      (correctionIndicator (n + 1) - correctionIndicator n) / (n + 1 : ℕ) := by
  unfold signedRankJump
  rw [signedRank_log_decomposition, signedRank_log_decomposition]
  by_cases hn : n = 0
  · subst n
    norm_num
    ring
  · simp only [hn, Nat.succ_ne_zero, ↓reduceIte]
    ring

def signedRank_jumps_summable_signed :
    Summable (fun n : ℕ => signedRankJump n / (n + 1 : ℕ)) := by
  apply signedRank_jumps_summable.of_norm_bounded
  intro n
  simp only [Real.norm_eq_abs, abs_div, abs_of_nonneg (Nat.cast_nonneg (α := ℝ) (n + 1))]
  exact le_refl _

def correction_jumps_summable :
    Summable (fun n : ℕ => (correctionIndicator (n + 1) - correctionIndicator n) / (n + 1 : ℕ)) := by
  have hs := (((signedRank_jumps_summable_signed.sub (hasSum_ite_eq 0 (1 : ℝ)).summable).sub
    (nat_log_jumps_summable (by norm_num : 1 < 3))).sub
    (nat_log_jumps_summable (by norm_num : 1 < 4)))
  apply hs.congr
  intro n
  rw [signedRankJump_log_decomposition]
  ring

def correction_kernel_summable :
    Summable (fun n : ℕ => correctionIndicator (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ))) :=
  bounded_reciprocal_kernel_summable correctionIndicator_bound

def correction_jumps_eq_kernel :
    (∑' n : ℕ, (correctionIndicator (n + 1) - correctionIndicator n) / (n + 1 : ℕ)) =
      ∑' n : ℕ, correctionIndicator (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ)) :=
  tsum_reciprocal_jumps correctionIndicator_zero correction_jumps_summable
    correction_kernel_summable (bounded_div_nat_tendsto_zero correctionIndicator_bound)

def jumpDensity_eq_correction_series :
    jumpDensity = 11 / 18 +
      (∑' n : ℕ, correctionIndicator (n + 1) / ((n + 1 : ℕ) * (n + 2 : ℕ))) / 3 := by
  have h3 := (nat_log_jumps_summable (by norm_num : 1 < 3)).hasSum
  have h4 := (nat_log_jumps_summable (by norm_num : 1 < 4)).hasSum
  rw [nat_log_jumps_tsum (by norm_num : 1 < 3)] at h3
  rw [nat_log_jumps_tsum (by norm_num : 1 < 4)] at h4
  have hsum := (((hasSum_ite_eq 0 (1 : ℝ)).add h3).add h4).add correction_jumps_summable.hasSum
  have hs : HasSum (fun n : ℕ => signedRankJump n / (n + 1 : ℕ))
      (1 + 1 / ((3 : ℝ) - 1) + 1 / ((4 : ℝ) - 1) +
        ∑' n : ℕ, (correctionIndicator (n + 1) - correctionIndicator n) / (n + 1 : ℕ)) := by
    apply hsum.congr_fun
    exact signedRankJump_log_decomposition
  have he : jumpDensity = (∑' n : ℕ, signedRankJump n / (n + 1 : ℕ)) / 3 := by
    rw [← tsum_div_const]
    apply tsum_congr
    intro n
    ring
  rw [he, hs.tsum_eq, correction_jumps_eq_kernel]
  ring


end Bounty

end SubmissionComponent_DensityCorrection

/- Component GeometricBands; SHA256 d5b9fae9327a431c11cce647ce104ea0599c4155229e60ebf7f08698b0da2817 -/
section SubmissionComponent_GeometricBands
/- Exact boundary jumps of disjoint families of geometric intervals. -/

namespace Bounty

def geometricBand (lo hi b n : ℕ) : Prop :=
  ∃ j : ℕ, lo * b ^ j ≤ n ∧ n < hi * b ^ j

noncomputable def geometricBandIndicator (lo hi b n : ℕ) : ℝ := by
  classical
  exact if geometricBand lo hi b n then 1 else 0

def geometricBand_enter {lo hi b n : ℕ}
    (hn : ¬geometricBand lo hi b n) (hs : geometricBand lo hi b (n + 1)) :
    ∃ j : ℕ, n + 1 = lo * b ^ j := by
  obtain ⟨j, hjlo, hjhi⟩ := hs
  by_contra hh
  have he : n + 1 ≠ lo * b ^ j := by aesop
  exact hn ⟨j, by omega, by omega⟩

def geometricBand_exit {lo hi b n : ℕ}
    (hn : geometricBand lo hi b n) (hs : ¬geometricBand lo hi b (n + 1)) :
    ∃ j : ℕ, n + 1 = hi * b ^ j := by
  obtain ⟨j, hjlo, hjhi⟩ := hn
  by_contra hh
  have he : n + 1 ≠ hi * b ^ j := by aesop
  exact hs ⟨j, by omega, by omega⟩

def geometricBand_at_lower {lo hi b : ℕ} (hl : lo < hi) (hb : 0 < b) (j : ℕ) :
    geometricBand lo hi b (lo * b ^ j) := by
  have hp : 0 < b ^ j := by positivity
  exact ⟨j, le_refl _, by nlinarith⟩

def geometricBand_before_lower {lo hi b n j : ℕ} (hgap : hi < lo * b)
    (hb : 1 < b) (he : n + 1 = lo * b ^ j) : ¬geometricBand lo hi b n := by
  rintro ⟨k, hklo, hkhi⟩
  rcases le_or_gt j k with hjk | hkj
  · have hp := Nat.pow_le_pow_right (by omega : 0 < b) hjk
    have hm := Nat.mul_le_mul_left lo hp
    omega
  · have hp := Nat.pow_le_pow_right (by omega : 0 < b) (by omega : k + 1 ≤ j)
    have hkpos : 0 < b ^ k := by positivity
    have hm := Nat.mul_le_mul_left lo hp
    rw [pow_succ] at hm
    nlinarith

def geometricBand_at_upper_false {lo hi b j : ℕ} (hgap : hi < lo * b)
    (hb : 1 < b) : ¬geometricBand lo hi b (hi * b ^ j) := by
  rintro ⟨k, hklo, hkhi⟩
  rcases le_or_gt k j with hkj | hjk
  · have hp := Nat.pow_le_pow_right (by omega : 0 < b) hkj
    have hm := Nat.mul_le_mul_left hi hp
    omega
  · have hp := Nat.pow_le_pow_right (by omega : 0 < b) (by omega : j + 1 ≤ k)
    have hjpos : 0 < b ^ j := by positivity
    have hm := Nat.mul_le_mul_left lo hp
    rw [pow_succ] at hm
    nlinarith

def geometricBand_before_upper {lo hi b n j : ℕ} (hl : lo < hi)
    (hb : 0 < b) (he : n + 1 = hi * b ^ j) : geometricBand lo hi b n := by
  have hp : 0 < b ^ j := by positivity
  exact ⟨j, by nlinarith, by omega⟩

def geometricBand_endpoints_disjoint {lo hi b n : ℕ} (hl : lo < hi)
    (hgap : hi < lo * b) (hb : 1 < b)
    (hs : ∃ j, n = lo * b ^ j) : ¬∃ j, n = hi * b ^ j := by
  obtain ⟨j, rfl⟩ := hs
  rintro ⟨k, hk⟩
  have h := geometricBand_at_lower hl (by omega : 0 < b) j
  rw [hk] at h
  exact geometricBand_at_upper_false hgap hb h

open scoped Classical in
def geometricBandIndicator_jump {lo hi b : ℕ} (hl : lo < hi)
    (hgap : hi < lo * b) (hb : 1 < b) (n : ℕ) :
    geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n =
      (if ∃ j, n + 1 = lo * b ^ j then 1 else 0) -
        (if ∃ j, n + 1 = hi * b ^ j then 1 else 0) := by
  classical
  by_cases hs : ∃ j, n + 1 = lo * b ^ j
  · have hnend := geometricBand_endpoints_disjoint hl hgap hb hs
    obtain ⟨j, hj⟩ := hs
    have hcurr : geometricBand lo hi b (n + 1) := by
      rw [hj]
      exact geometricBand_at_lower hl (by omega) j
    have hprev := geometricBand_before_lower hgap hb hj
    simp only [geometricBandIndicator, if_pos hcurr, if_neg hprev,
      if_pos (show ∃ j, n + 1 = lo * b ^ j from ⟨j, hj⟩), if_neg hnend]
  · by_cases he : ∃ j, n + 1 = hi * b ^ j
    · obtain ⟨j, hj⟩ := he
      have hcurr : ¬geometricBand lo hi b (n + 1) := by
        rw [hj]
        exact geometricBand_at_upper_false hgap hb
      have hprev := geometricBand_before_upper hl (by omega : 0 < b) hj
      simp only [geometricBandIndicator, if_neg hcurr, if_pos hprev,
        if_neg hs, if_pos (show ∃ j, n + 1 = hi * b ^ j from ⟨j, hj⟩)]
    · by_cases hn : geometricBand lo hi b n
      · have hcurr : geometricBand lo hi b (n + 1) := by
          by_contra hh
          exact he (geometricBand_exit hn hh)
        simp only [geometricBandIndicator, if_pos hn, if_pos hcurr,
          if_neg hs, if_neg he, sub_self]
      · have hcurr : ¬geometricBand lo hi b (n + 1) := by
          intro hh
          exact hs (geometricBand_enter hn hh)
        simp only [geometricBandIndicator, if_neg hn, if_neg hcurr,
          if_neg hs, if_neg he, sub_self]

def geometricBandIndicator_bound (lo hi b n : ℕ) :
    |geometricBandIndicator lo hi b n| ≤ 1 := by
  classical
  unfold geometricBandIndicator
  split_ifs <;> norm_num

def product_jump (f g : ℕ → ℝ) (n : ℕ) :
    f (n + 1) * g (n + 1) - f n * g n =
      (f (n + 1) - f n) * g (n + 1) +
      (g (n + 1) - g n) * f (n + 1) -
      (f (n + 1) - f n) * (g (n + 1) - g n) := by ring


end Bounty

end SubmissionComponent_GeometricBands

/- Component WeightedGeometric; SHA256 e238b9a2e8227418e3daa0bdecaa241f30e5df6efef6369f24e1bf68c19a7731 -/
section SubmissionComponent_WeightedGeometric
/- Regrouping weighted boundary events by their geometric exponents. -/

namespace Bounty

noncomputable def endpointSeries (a b : ℕ) (w : ℕ → ℝ) : ℝ :=
  ∑' j : ℕ, w (a * b ^ j) / (a * b ^ j : ℕ)

def weighted_geometric_summable {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (ha : 0 < a) (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    Summable (fun n : ℕ => w n * geometricEndpointTerm a b n) := by
  apply ((geometricEndpointTerm_summable ha hb).mul_left M).of_norm_bounded
  intro n
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (geometricEndpointTerm_nonneg a b n)]
  exact mul_le_mul_of_nonneg_right (hw n) (geometricEndpointTerm_nonneg a b n)

def weighted_geometric_summable_shift {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (ha : 0 < a) (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    Summable (fun n : ℕ => w (n + 1) * geometricEndpointTerm a b (n + 1)) :=
  (summable_nat_add_iff 1).mpr (weighted_geometric_summable ha hb hw)

def weighted_geometric_tsum {a b : ℕ} (ha : 0 < a) (hb : 1 < b) (w : ℕ → ℝ) :
    (∑' n : ℕ, w n * geometricEndpointTerm a b n) = endpointSeries a b w := by
  classical
  have hi : Function.Injective (fun j : ℕ => a * b ^ j) := by
    intro i j hij
    apply Nat.pow_right_injective (by omega : 2 ≤ b)
    nlinarith
  have hs : Function.support (fun n => w n * geometricEndpointTerm a b n) ⊆
      Set.range (fun j : ℕ => a * b ^ j) := by
    intro n hn
    by_contra he
    have hh : ¬∃ j, n = a * b ^ j := by simpa only [Set.mem_range, eq_comm] using he
    simp only [Function.mem_support, geometricEndpointTerm, if_neg hh, mul_zero, ne_eq,
      not_true_eq_false] at hn
  rw [← hi.tsum_eq hs]
  unfold endpointSeries
  apply tsum_congr
  intro j
  rw [geometricEndpointTerm_at ⟨j, rfl⟩]
  ring

def weighted_geometric_tsum_shift {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (ha : 0 < a) (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    (∑' n : ℕ, w (n + 1) * geometricEndpointTerm a b (n + 1)) = endpointSeries a b w := by
  have he := (weighted_geometric_summable ha hb hw).sum_add_tsum_nat_add 1
  simpa only [Finset.sum_range_one, geometricEndpointTerm_zero ha (by omega : 0 < b),
    mul_zero, zero_add, weighted_geometric_tsum ha hb w] using he

def band_weighted_jump_decomposition {lo hi b : ℕ} (hl : lo < hi)
    (hgap : hi < lo * b) (hb : 1 < b) (w : ℕ → ℝ) (n : ℕ) :
    (geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n) *
        w (n + 1) / (n + 1 : ℕ) =
      w (n + 1) * geometricEndpointTerm lo b (n + 1) -
        w (n + 1) * geometricEndpointTerm hi b (n + 1) := by
  classical
  rw [geometricBandIndicator_jump hl hgap hb]
  unfold geometricEndpointTerm
  split_ifs <;> ring

def band_weighted_jumps_summable {lo hi b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hlo : 0 < lo) (hl : lo < hi) (hgap : hi < lo * b) (hb : 1 < b)
    (hw : ∀ n, |w n| ≤ M) :
    Summable (fun n : ℕ =>
      (geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n) *
        w (n + 1) / (n + 1 : ℕ)) := by
  simp only [band_weighted_jump_decomposition hl hgap hb]
  exact (weighted_geometric_summable_shift hlo hb hw).sub
    (weighted_geometric_summable_shift (by omega : 0 < hi) hb hw)

def band_weighted_jumps_tsum {lo hi b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hlo : 0 < lo) (hl : lo < hi) (hgap : hi < lo * b) (hb : 1 < b)
    (hw : ∀ n, |w n| ≤ M) :
    (∑' n : ℕ, (geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n) *
        w (n + 1) / (n + 1 : ℕ)) = endpointSeries lo b w - endpointSeries hi b w := by
  simp only [band_weighted_jump_decomposition hl hgap hb]
  rw [(weighted_geometric_summable_shift hlo hb hw).tsum_sub
    (weighted_geometric_summable_shift (by omega : 0 < hi) hb hw),
    weighted_geometric_tsum_shift hlo hb hw,
    weighted_geometric_tsum_shift (by omega : 0 < hi) hb hw]


end Bounty

end SubmissionComponent_WeightedGeometric

/- Component SpecialBands; SHA256 ed3571155a75f6251241def6d8f27c212f7cef9e386e828c9e18a68e6cbc2358 -/
section SubmissionComponent_SpecialBands
/- The overlap and obstruction as products of geometric interval indicators. -/

namespace Bounty

def overlapWindow_iff_bands (n : ℕ) :
    overlapWindow n ↔ geometricBand 2 4 4 n ∧ geometricBand 2 3 3 n := by
  rw [overlapWindow_iff_intervals]
  constructor
  · rintro ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩
    exact ⟨⟨j, h4lo, by simpa only [pow_succ'] using h4hi⟩,
      ⟨b, h3lo, by simpa only [pow_succ'] using h3hi⟩⟩
  · rintro ⟨⟨j, h4lo, h4hi⟩, ⟨b, h3lo, h3hi⟩⟩
    exact ⟨j, b, h4lo, by simpa only [pow_succ'] using h4hi,
      h3lo, by simpa only [pow_succ'] using h3hi⟩

def badWindow_iff_bands (n : ℕ) :
    badWindow n ↔ geometricBand 4 5 4 n ∧ geometricBand 10 12 3 n := by
  constructor
  · rintro ⟨j, b, h4lo, h4hi, h3lo, h3hi⟩
    have h3pos : 0 < (3 : ℕ) ^ b := by positivity
    have hj : j ≠ 0 := by
      intro hj
      simp only [hj, pow_zero] at h4hi
      omega
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj
    rw [pow_succ'] at h4lo h4hi
    exact ⟨⟨k, h4lo, by omega⟩, ⟨b, h3lo, h3hi⟩⟩
  · rintro ⟨⟨j, h4lo, h4hi⟩, ⟨b, h3lo, h3hi⟩⟩
    refine ⟨j + 1, b, ?_, ?_, h3lo, h3hi⟩
    · simpa only [pow_succ'] using h4lo
    · rw [pow_succ']
      omega

def overlapIndicator_eq_product (n : ℕ) :
    overlapIndicator n = geometricBandIndicator 2 4 4 n * geometricBandIndicator 2 3 3 n := by
  classical
  simp only [overlapIndicator, overlapWindow_iff_bands, geometricBandIndicator]
  split_ifs <;> norm_num <;> tauto

def obstructionIndicator_eq_product (n : ℕ) :
    obstructionIndicator n = geometricBandIndicator 4 5 4 n * geometricBandIndicator 10 12 3 n := by
  classical
  simp only [obstructionIndicator, badWindow_iff_bands, geometricBandIndicator]
  split_ifs <;> norm_num <;> tauto

def geometricBand_change_endpoint {lo hi b n : ℕ} (hl : lo < hi)
    (hgap : hi < lo * b) (hb : 1 < b)
    (h : geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n ≠ 0) :
    (∃ j, n + 1 = lo * b ^ j) ∨ (∃ j, n + 1 = hi * b ^ j) := by
  classical
  by_cases hs : ∃ j, n + 1 = lo * b ^ j
  · exact Or.inl hs
  by_cases he : ∃ j, n + 1 = hi * b ^ j
  · exact Or.inr he
  rw [geometricBandIndicator_jump hl hgap hb, if_neg hs, if_neg he, sub_self] at h
  exact (h rfl).elim

def three_not_dvd_scaled_four {a : ℕ} (ha : ¬3 ∣ a) (j : ℕ) : ¬3 ∣ a * 4 ^ j := by
  intro hh
  rcases Nat.prime_three.dvd_mul.mp hh with h | h
  · exact ha h
  · have ht := Nat.prime_three.dvd_of_dvd_pow h
    norm_num at ht

def endpoint_two_three_or_dvd {a b m : ℕ} (he : m = a * 3 ^ b) :
    m = a ∨ 3 ∣ m := by
  by_cases hb : b = 0
  · exact Or.inl (by simpa only [hb, pow_zero, mul_one] using he)
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hb
    apply Or.inr
    refine ⟨a * 3 ^ k, ?_⟩
    rw [he, pow_succ']
    ring

def overlap_common_endpoint {m : ℕ}
    (h4 : (∃ j, m = 2 * 4 ^ j) ∨ (∃ j, m = 4 * 4 ^ j))
    (h3 : (∃ j, m = 2 * 3 ^ j) ∨ (∃ j, m = 3 * 3 ^ j)) : m = 2 := by
  have hn : ¬3 ∣ m := by
    rcases h4 with ⟨j, rfl⟩ | ⟨j, rfl⟩
    · exact three_not_dvd_scaled_four (by decide) j
    · exact three_not_dvd_scaled_four (by decide) j
  rcases h3 with ⟨j, hj⟩ | ⟨j, hj⟩
  · exact (endpoint_two_three_or_dvd hj).resolve_right hn
  · exact (hn (hj ▸ dvd_mul_right 3 (3 ^ j))).elim

def obstruction_endpoints_disjoint {m : ℕ}
    (h4 : (∃ j, m = 4 * 4 ^ j) ∨ (∃ j, m = 5 * 4 ^ j)) :
    ¬((∃ j, m = 10 * 3 ^ j) ∨ (∃ j, m = 12 * 3 ^ j)) := by
  have hn3 : ¬3 ∣ m := by
    rcases h4 with ⟨j, rfl⟩ | ⟨j, rfl⟩
    · exact three_not_dvd_scaled_four (by decide) j
    · exact three_not_dvd_scaled_four (by decide) j
  intro h3
  have hm : m = 10 := by
    rcases h3 with ⟨j, hj⟩ | ⟨j, hj⟩
    · exact (endpoint_two_three_or_dvd hj).resolve_right hn3
    · have hd : 3 ∣ m := by
        rw [hj]
        exact dvd_mul_of_dvd_left (by decide : 3 ∣ 12) _
      exact (hn3 hd).elim
  rcases h4 with ⟨j, hj⟩ | ⟨j, hj⟩
  · have hd : 4 ∣ m := hj ▸ dvd_mul_right 4 (4 ^ j)
    norm_num [hm] at hd
  · by_cases hz : j = 0
    · simp only [hz, pow_zero, mul_one, hm] at hj
      omega
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hz
      have hd : 4 ∣ m := by
        refine ⟨5 * 4 ^ k, ?_⟩
        rw [hj, pow_succ']
        ring
      norm_num [hm] at hd

def band_two_jump {hi b : ℕ} (hl : 2 < hi) (hgap : hi < 2 * b) (hb : 1 < b) :
    geometricBandIndicator 2 hi b 2 - geometricBandIndicator 2 hi b 1 = 1 := by
  classical
  have hs : geometricBand 2 hi b 2 := by
    simpa only [pow_zero, mul_one] using geometricBand_at_lower hl (by omega : 0 < b) 0
  have hn : ¬geometricBand 2 hi b 1 :=
    geometricBand_before_lower (j := 0) hgap hb (by norm_num)
  simp only [geometricBandIndicator, if_pos hs, if_neg hn, sub_zero]

def overlap_jump_product (n : ℕ) :
    (geometricBandIndicator 2 4 4 (n + 1) - geometricBandIndicator 2 4 4 n) *
      (geometricBandIndicator 2 3 3 (n + 1) - geometricBandIndicator 2 3 3 n) =
        if n = 1 then 1 else 0 := by
  by_cases hn : n = 1
  · subst n
    norm_num only [Nat.reduceAdd, if_pos rfl, if_true]
    rw [band_two_jump (by norm_num : 2 < 4) (by norm_num) (by norm_num),
      band_two_jump (by norm_num : 2 < 3) (by norm_num) (by norm_num), one_mul]
  · rw [if_neg hn]
    by_contra hh
    have h4 : geometricBandIndicator 2 4 4 (n + 1) - geometricBandIndicator 2 4 4 n ≠ 0 := by
      intro he
      exact hh (by rw [he, zero_mul])
    have h3 : geometricBandIndicator 2 3 3 (n + 1) - geometricBandIndicator 2 3 3 n ≠ 0 := by
      intro he
      exact hh (by rw [he, mul_zero])
    have he := overlap_common_endpoint
      (geometricBand_change_endpoint (by norm_num) (by norm_num) (by norm_num) h4)
      (geometricBand_change_endpoint (by norm_num) (by norm_num) (by norm_num) h3)
    omega

def obstruction_jump_product (n : ℕ) :
    (geometricBandIndicator 4 5 4 (n + 1) - geometricBandIndicator 4 5 4 n) *
      (geometricBandIndicator 10 12 3 (n + 1) - geometricBandIndicator 10 12 3 n) = 0 := by
  by_contra hh
  have h4 : geometricBandIndicator 4 5 4 (n + 1) - geometricBandIndicator 4 5 4 n ≠ 0 := by
    intro he
    exact hh (by rw [he, zero_mul])
  have h3 : geometricBandIndicator 10 12 3 (n + 1) - geometricBandIndicator 10 12 3 n ≠ 0 := by
    intro he
    exact hh (by rw [he, mul_zero])
  exact obstruction_endpoints_disjoint
    (geometricBand_change_endpoint (by norm_num) (by norm_num) (by norm_num) h4)
    (geometricBand_change_endpoint (by norm_num) (by norm_num) (by norm_num) h3)


end Bounty

end SubmissionComponent_SpecialBands

/- Component EndpointDensity; SHA256 aa1b5970cac720866a807cc0a3c594f92e9b3205c8a157cd12aa8b6ca27e9db1 -/
section SubmissionComponent_EndpointDensity
/- Group the correction jumps into their eight geometric boundary series. -/

namespace Bounty

def band_weighted_jumps_hasSum {lo hi b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hlo : 0 < lo) (hl : lo < hi) (hgap : hi < lo * b) (hb : 1 < b)
    (hw : ∀ n, |w n| ≤ M) :
    HasSum (fun n : ℕ =>
      (geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n) *
        w (n + 1) / (n + 1 : ℕ)) (endpointSeries lo b w - endpointSeries hi b w) := by
  have hs := (band_weighted_jumps_summable hlo hl hgap hb hw).hasSum
  rwa [band_weighted_jumps_tsum hlo hl hgap hb hw] at hs

def product_bands_jumps_hasSum {lo hi b lo' hi' b' : ℕ} {cross : ℕ → ℝ} {C : ℝ}
    (hlo : 0 < lo) (hl : lo < hi) (hgap : hi < lo * b) (hb : 1 < b)
    (hlo' : 0 < lo') (hl' : lo' < hi') (hgap' : hi' < lo' * b') (hb' : 1 < b')
    (hcross : ∀ n,
      (geometricBandIndicator lo hi b (n + 1) - geometricBandIndicator lo hi b n) *
        (geometricBandIndicator lo' hi' b' (n + 1) - geometricBandIndicator lo' hi' b' n) /
          (n + 1 : ℕ) = cross n)
    (hc : HasSum cross C) :
    HasSum (fun n : ℕ =>
      (geometricBandIndicator lo hi b (n + 1) * geometricBandIndicator lo' hi' b' (n + 1) -
        geometricBandIndicator lo hi b n * geometricBandIndicator lo' hi' b' n) / (n + 1 : ℕ))
      ((endpointSeries lo b (geometricBandIndicator lo' hi' b') -
        endpointSeries hi b (geometricBandIndicator lo' hi' b')) +
       (endpointSeries lo' b' (geometricBandIndicator lo hi b) -
        endpointSeries hi' b' (geometricBandIndicator lo hi b)) - C) := by
  have h1 := band_weighted_jumps_hasSum hlo hl hgap hb (geometricBandIndicator_bound lo' hi' b')
  have h2 := band_weighted_jumps_hasSum hlo' hl' hgap' hb' (geometricBandIndicator_bound lo hi b)
  apply ((h1.add h2).sub hc).congr_fun
  intro n
  rw [product_jump, ← hcross n]
  ring

def overlap_jumps_hasSum :
    HasSum (fun n : ℕ => (overlapIndicator (n + 1) - overlapIndicator n) / (n + 1 : ℕ))
      ((endpointSeries 2 4 (geometricBandIndicator 2 3 3) -
        endpointSeries 4 4 (geometricBandIndicator 2 3 3)) +
       (endpointSeries 2 3 (geometricBandIndicator 2 4 4) -
        endpointSeries 3 3 (geometricBandIndicator 2 4 4)) - 1 / 2) := by
  have hc : ∀ n : ℕ,
      (geometricBandIndicator 2 4 4 (n + 1) - geometricBandIndicator 2 4 4 n) *
        (geometricBandIndicator 2 3 3 (n + 1) - geometricBandIndicator 2 3 3 n) /
          (n + 1 : ℕ) = if n = 1 then (1 / 2 : ℝ) else 0 := by
    intro n
    rw [overlap_jump_product]
    by_cases hn : n = 1 <;> simp [hn]
  simpa only [← overlapIndicator_eq_product] using
    product_bands_jumps_hasSum (by norm_num : 0 < 2) (by norm_num : 2 < 4)
      (by norm_num : 4 < 2 * 4) (by norm_num : 1 < 4)
      (by norm_num : 0 < 2) (by norm_num : 2 < 3)
      (by norm_num : 3 < 2 * 3) (by norm_num : 1 < 3) hc (hasSum_ite_eq 1 (1 / 2 : ℝ))

def obstruction_jumps_hasSum :
    HasSum (fun n : ℕ => (obstructionIndicator (n + 1) - obstructionIndicator n) / (n + 1 : ℕ))
      ((endpointSeries 4 4 (geometricBandIndicator 10 12 3) -
        endpointSeries 5 4 (geometricBandIndicator 10 12 3)) +
       (endpointSeries 10 3 (geometricBandIndicator 4 5 4) -
        endpointSeries 12 3 (geometricBandIndicator 4 5 4))) := by
  have hc : ∀ n : ℕ,
      (geometricBandIndicator 4 5 4 (n + 1) - geometricBandIndicator 4 5 4 n) *
        (geometricBandIndicator 10 12 3 (n + 1) - geometricBandIndicator 10 12 3 n) /
          (n + 1 : ℕ) = 0 := by
    intro n
    rw [obstruction_jump_product, zero_div]
  simpa only [← obstructionIndicator_eq_product, sub_zero] using
    product_bands_jumps_hasSum (by norm_num : 0 < 4) (by norm_num : 4 < 5)
      (by norm_num : 5 < 4 * 4) (by norm_num : 1 < 4)
      (by norm_num : 0 < 10) (by norm_num : 10 < 12)
      (by norm_num : 12 < 10 * 3) (by norm_num : 1 < 3) hc (hasSum_zero (α := ℝ))

def correction_jumps_tsum_endpoints :
    (∑' n : ℕ, (correctionIndicator (n + 1) - correctionIndicator n) / (n + 1 : ℕ)) =
      ((endpointSeries 2 4 (geometricBandIndicator 2 3 3) -
        endpointSeries 4 4 (geometricBandIndicator 2 3 3)) +
       (endpointSeries 2 3 (geometricBandIndicator 2 4 4) -
        endpointSeries 3 3 (geometricBandIndicator 2 4 4)) - 1 / 2) -
      ((endpointSeries 4 4 (geometricBandIndicator 10 12 3) -
        endpointSeries 5 4 (geometricBandIndicator 10 12 3)) +
       (endpointSeries 10 3 (geometricBandIndicator 4 5 4) -
        endpointSeries 12 3 (geometricBandIndicator 4 5 4))) := by
  apply HasSum.tsum_eq
  apply (overlap_jumps_hasSum.sub obstruction_jumps_hasSum).congr_fun
  intro n
  simp only [correctionIndicator]
  ring


end Bounty

end SubmissionComponent_EndpointDensity

/- Component BandLocalization; SHA256 9f737571e217be11e84d598de91d992c50a071d4e0772ab28595d344486328f9 -/
section SubmissionComponent_BandLocalization
/- Localizing a geometric interval index from bounds on a scaled argument. -/

namespace Bounty

def band_index_lower {hi b x z k d a c j : ℕ}
    (hb : 1 < b) (ha : 0 < a) (hx : b ^ k ≤ x) (he : a * z = c * x)
    (hscale : a * hi * b ^ d ≤ c * b) (hj : z < hi * b ^ j) : k + d ≤ j := by
  by_contra hh
  have hp := Nat.pow_le_pow_right (by omega : 0 < b) (by omega : j + 1 ≤ k + d)
  rw [pow_succ', pow_add] at hp
  have hu : a * (hi * b ^ j) ≤ c * b ^ k := by
    apply (mul_le_mul_iff_left₀ (by omega : 0 < b)).mp
    calc
      a * (hi * b ^ j) * b = (a * hi) * (b * b ^ j) := by ring
      _ ≤ (a * hi) * (b ^ k * b ^ d) := Nat.mul_le_mul_left _ hp
      _ = b ^ k * (a * hi * b ^ d) := by ring
      _ ≤ b ^ k * (c * b) := Nat.mul_le_mul_left _ hscale
      _ = c * b ^ k * b := by ring
  have hzl := Nat.mul_lt_mul_of_pos_left hj ha
  have hxl := Nat.mul_le_mul_left c hx
  omega

def band_index_upper {lo b x z k d a c j : ℕ}
    (hb : 1 < b) (hc : 0 < c) (hx : x < b * b ^ k) (he : a * z = c * x)
    (hscale : c ≤ a * lo * b ^ d) (hj : lo * b ^ j ≤ z) : j ≤ k + d := by
  by_contra hh
  have hp := Nat.pow_le_pow_right (by omega : 0 < b) (by omega : k + d + 1 ≤ j)
  rw [pow_succ', pow_add] at hp
  have hl : c * (b * b ^ k) ≤ a * (lo * b ^ j) := by
    calc
      c * (b * b ^ k) ≤ (a * lo * b ^ d) * (b * b ^ k) := Nat.mul_le_mul_right _ hscale
      _ = (a * lo) * (b * (b ^ k * b ^ d)) := by ring
      _ ≤ (a * lo) * b ^ j := Nat.mul_le_mul_left _ hp
      _ = a * (lo * b ^ j) := by ring
  have hzl := Nat.mul_le_mul_left a hj
  have hxu := Nat.mul_lt_mul_of_pos_left hx hc
  omega

def band_scaled_iff_single {lo hi b x z k d a c : ℕ}
    (hb : 1 < b) (ha : 0 < a) (hc : 0 < c)
    (hxlo : b ^ k ≤ x) (hxhi : x < b * b ^ k) (he : a * z = c * x)
    (hbelow : a * hi * b ^ d ≤ c * b) (habove : c ≤ a * lo * b ^ d) :
    geometricBand lo hi b z ↔ lo * b ^ (k + d) ≤ z ∧ z < hi * b ^ (k + d) := by
  constructor
  · rintro ⟨j, hjlo, hjhi⟩
    have hjl := band_index_lower hb ha hxlo he hbelow hjhi
    have hju := band_index_upper hb hc hxhi he habove hjlo
    have hj : j = k + d := by omega
    simpa only [hj] using And.intro hjlo hjhi
  · intro hz
    exact ⟨k + d, hz⟩

def band_scaled_iff_two {lo hi b x z k a c : ℕ}
    (hb : 1 < b) (ha : 0 < a) (hc : 0 < c)
    (hxlo : b ^ k ≤ x) (hxhi : x < b * b ^ k) (he : a * z = c * x)
    (hbelow : a * hi ≤ c * b) (habove : c ≤ a * lo * b) :
    geometricBand lo hi b z ↔
      (lo * b ^ k ≤ z ∧ z < hi * b ^ k) ∨
      (lo * b ^ (k + 1) ≤ z ∧ z < hi * b ^ (k + 1)) := by
  constructor
  · rintro ⟨j, hjlo, hjhi⟩
    have hjl := band_index_lower (d := 0) hb ha hxlo he
      (by simpa only [pow_zero, mul_one] using hbelow) hjhi
    have hju := band_index_upper (d := 1) hb hc hxhi he
      (by simpa only [pow_one] using habove) hjlo
    have hh : j = k ∨ j = k + 1 := by omega
    rcases hh with rfl | rfl
    · exact Or.inl ⟨hjlo, hjhi⟩
    · exact Or.inr ⟨hjlo, hjhi⟩
  · rintro (hz | hz)
    · exact ⟨k, hz⟩
    · exact ⟨k + 1, hz⟩


end Bounty

end SubmissionComponent_BandLocalization

/- Component ThirdSeriesTable; SHA256 ed92cbf86f0cc0a2074b0e2579cc2833b74d2d855a687fc5a8ea26918ba78fc7 -/
section SubmissionComponent_ThirdSeriesTable
/- The five coefficient values in the powers-of-three boundary series. -/

namespace Bounty

def fourBand_at_self {x : ℕ} (hx : 0 < x) :
    geometricBand 2 4 4 x ↔ 2 * 4 ^ Nat.log 4 x ≤ x := by
  have hlo := Nat.pow_log_le_self 4 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 4) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 4) (lo := 2) (hi := 4)
    (k := Nat.log 4 x) (d := 0) (a := 1) (c := 1) (x := x) (z := x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi rfl (by norm_num) (by norm_num)
  simpa only [Nat.add_zero, and_iff_left hhi] using he

def fourBand_at_double {x : ℕ} (hx : 0 < x) :
    geometricBand 2 4 4 (2 * x) ↔ x < 2 * 4 ^ Nat.log 4 x := by
  have hlo := Nat.pow_log_le_self 4 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 4) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 4) (lo := 2) (hi := 4)
    (k := Nat.log 4 x) (d := 0) (a := 1) (c := 2) (x := x) (z := 2 * x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  simp only [Nat.add_zero] at he
  exact he.trans (by omega)

def fourGap_at_ten {x : ℕ} (hx : 0 < x) :
    geometricBand 4 5 4 (10 * x) ↔
      8 * 4 ^ Nat.log 4 x ≤ 5 * x ∧ x < 2 * 4 ^ Nat.log 4 x := by
  have hlo := Nat.pow_log_le_self 4 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 4) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 4) (lo := 4) (hi := 5)
    (k := Nat.log 4 x) (d := 1) (a := 1) (c := 10) (x := x) (z := 10 * x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  rw [pow_succ'] at he
  exact he.trans (by omega)

def fourGap_at_twelve {x : ℕ} (hx : 0 < x) :
    geometricBand 4 5 4 (12 * x) ↔
      4 * 4 ^ Nat.log 4 x ≤ 3 * x ∧ 3 * x < 5 * 4 ^ Nat.log 4 x := by
  have hlo := Nat.pow_log_le_self 4 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 4) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 4) (lo := 4) (hi := 5)
    (k := Nat.log 4 x) (d := 1) (a := 1) (c := 12) (x := x) (z := 12 * x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  rw [pow_succ'] at he
  exact he.trans (by omega)

def coefficient3_eq_boundaries (n : ℕ) :
    (coefficient3 n : ℝ) / 60 =
      geometricBandIndicator 2 4 4 (2 * 3 ^ n) / 2 -
      geometricBandIndicator 2 4 4 (3 ^ n) -
      geometricBandIndicator 4 5 4 (10 * 3 ^ n) / 10 +
      geometricBandIndicator 4 5 4 (12 * 3 ^ n) / 12 := by
  classical
  have hp : 0 < (3 : ℕ) ^ n := by positivity
  simp only [geometricBandIndicator, fourBand_at_double hp, fourBand_at_self hp,
    fourGap_at_ten hp, fourGap_at_twelve hp]
  unfold coefficient3
  dsimp only
  split_ifs <;> norm_num <;> omega


end Bounty

end SubmissionComponent_ThirdSeriesTable

/- Component FourthSeriesTable; SHA256 6d2b329f015a6e365ffef6e8dde629b8996ab0674be4f9336bdbb46be4304619 -/
section SubmissionComponent_FourthSeriesTable
/- The seven coefficient values in the powers-of-four boundary series. -/

namespace Bounty

def threeBand_at_self {x : ℕ} (hx : 0 < x) :
    geometricBand 2 3 3 x ↔ 2 * 3 ^ Nat.log 3 x ≤ x := by
  have hlo := Nat.pow_log_le_self 3 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 3) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 3) (lo := 2) (hi := 3)
    (k := Nat.log 3 x) (d := 0) (a := 1) (c := 1) (x := x) (z := x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi rfl (by norm_num) (by norm_num)
  simpa only [Nat.add_zero, and_iff_left hhi] using he

def threeBand_at_double {x : ℕ} (hx : 0 < x) :
    geometricBand 2 3 3 (2 * x) ↔ 2 * x < 3 * 3 ^ Nat.log 3 x := by
  have hlo := Nat.pow_log_le_self 3 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 3) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 3) (lo := 2) (hi := 3)
    (k := Nat.log 3 x) (d := 0) (a := 1) (c := 2) (x := x) (z := 2 * x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  simp only [Nat.add_zero] at he
  exact he.trans (by omega)

def threeGap_mul_nine (x : ℕ) :
    geometricBand 10 12 3 (9 * x) ↔ geometricBand 10 12 3 x := by
  constructor
  · rintro ⟨j, hjlo, hjhi⟩
    have hj : 2 ≤ j := by
      by_contra hh
      have hj : j = 0 ∨ j = 1 := by omega
      rcases hj with rfl | rfl <;> norm_num at hjlo hjhi <;> omega
    have he : j = j - 2 + 2 := by omega
    have hp : (3 : ℕ) ^ j = 9 * 3 ^ (j - 2) := by
      rw [he, pow_add]
      norm_num
      ring
    rw [hp] at hjlo hjhi
    exact ⟨j - 2, by omega, by omega⟩
  · rintro ⟨j, hjlo, hjhi⟩
    refine ⟨j + 2, ?_, ?_⟩ <;> rw [pow_add] <;> norm_num <;> omega

def threeGap_at_self {x : ℕ} (hx : 0 < x) :
    geometricBand 10 12 3 x ↔
      10 * 3 ^ Nat.log 3 x ≤ 9 * x ∧ 3 * x < 4 * 3 ^ Nat.log 3 x := by
  have hlo := Nat.pow_log_le_self 3 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 3) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_single (b := 3) (lo := 10) (hi := 12)
    (k := Nat.log 3 x) (d := 0) (a := 1) (c := 9) (x := x) (z := 9 * x)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  rw [threeGap_mul_nine] at he
  simp only [Nat.add_zero] at he
  exact he.trans (by omega)

def threeGap_at_five_quarters {x z : ℕ} (hx : 0 < x) (hz : 4 * z = 5 * x) :
    geometricBand 10 12 3 z ↔
      15 * x < 16 * 3 ^ Nat.log 3 x ∨ 8 * 3 ^ Nat.log 3 x ≤ 3 * x := by
  have hlo := Nat.pow_log_le_self 3 (ne_of_gt hx)
  have hhi := Nat.lt_pow_succ_log_self (by norm_num : 1 < 3) x
  rw [pow_succ'] at hhi
  have he := band_scaled_iff_two (b := 3) (lo := 10) (hi := 12)
    (k := Nat.log 3 x) (a := 4) (c := 45) (x := x) (z := 9 * z)
    (by norm_num) (by norm_num) (by norm_num) hlo hhi (by omega) (by norm_num) (by norm_num)
  rw [threeGap_mul_nine, pow_succ'] at he
  exact he.trans (by omega)

def coefficient4_succ_eq_boundaries (n : ℕ) :
    (coefficient4 (n + 1) : ℝ) / 60 =
      geometricBandIndicator 2 3 3 (2 * 4 ^ (n + 1)) / 2 -
      geometricBandIndicator 2 3 3 (4 ^ (n + 1)) -
      geometricBandIndicator 10 12 3 (4 ^ (n + 1)) +
      4 / 5 * geometricBandIndicator 10 12 3 (5 * 4 ^ n) := by
  classical
  have hp : 0 < (4 : ℕ) ^ (n + 1) := by positivity
  have he : 4 * (5 * 4 ^ n) = 5 * 4 ^ (n + 1) := by rw [pow_succ']; ring
  simp only [geometricBandIndicator, threeBand_at_double hp, threeBand_at_self hp,
    threeGap_at_self hp, threeGap_at_five_quarters hp he]
  unfold coefficient4
  dsimp only
  split_ifs <;> norm_num <;> omega


end Bounty

end SubmissionComponent_FourthSeriesTable

/- Component EndpointSeriesAlgebra; SHA256 06bdc8cadbc5417e7be7d7f2b3e877ef90a53fafa56ba020359594a7f34d8f43 -/
section SubmissionComponent_EndpointSeriesAlgebra
/- Absolute convergence, scaling, and removal of the first geometric term. -/

namespace Bounty

def endpointSeries_summable {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    Summable (fun j : ℕ => w (a * b ^ j) / (a * b ^ j : ℕ)) := by
  have hh : ∀ j, |w (a * b ^ j) / (a : ℝ)| ≤ M / |(a : ℝ)| := by
    intro j
    rw [abs_div]
    exact div_le_div_of_nonneg_right (hw _) (abs_nonneg _)
  simpa only [div_div, Nat.cast_mul, Nat.cast_pow] using
    weighted_summable (by exact_mod_cast hb) hh

def endpointSeries_hasSum {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    HasSum (fun j : ℕ => w (a * b ^ j) / (a * b ^ j : ℕ)) (endpointSeries a b w) :=
  (endpointSeries_summable hb hw).hasSum

def endpointSeries_hasSum_weighted {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    HasSum (fun j : ℕ => (w (a * b ^ j) / (a : ℝ)) / (b : ℝ) ^ j) (endpointSeries a b w) := by
  simpa only [div_div, Nat.cast_mul, Nat.cast_pow] using endpointSeries_hasSum (a := a) hb hw

def hasSum_nat_tail_sub {f : ℕ → ℝ} (hs : Summable f) :
    HasSum (fun n : ℕ => f (n + 1)) ((∑' n : ℕ, f n) - f 0) := by
  have ht := ((summable_nat_add_iff 1).mpr hs).hasSum
  have he := hs.sum_add_tsum_nat_add 1
  simp only [Finset.sum_range_one] at he
  have hh : (∑' n : ℕ, f (n + 1)) = (∑' n : ℕ, f n) - f 0 := by linarith
  rwa [hh] at ht

def endpointSeries_hasSum_tail {a b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    HasSum (fun j : ℕ => w (a * b ^ (j + 1)) / (a * b ^ (j + 1) : ℕ))
      (endpointSeries a b w - w a / (a : ℝ)) := by
  simpa only [pow_zero, mul_one, endpointSeries] using
    hasSum_nat_tail_sub (endpointSeries_summable (a := a) hb hw)

def endpointSeries_base {b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) :
    endpointSeries b b w = (∑' j : ℕ, w (b ^ j) / (b : ℝ) ^ j) - w 1 := by
  have hs : Summable (fun j : ℕ => w (b ^ j) / (b : ℝ) ^ j) :=
    weighted_summable (by exact_mod_cast hb) (fun j => hw _)
  have ht := hasSum_nat_tail_sub hs
  simp only [pow_zero, div_one] at ht
  have he : (fun j : ℕ => w (b ^ (j + 1)) / (b : ℝ) ^ (j + 1)) =
      (fun j : ℕ => w (b * b ^ j) / (b * b ^ j : ℕ)) := by
    funext j
    simp only [pow_succ', Nat.cast_mul, Nat.cast_pow]
  rw [he] at ht
  exact ht.tsum_eq

def powers_hasSum_endpoint {b : ℕ} {w : ℕ → ℝ} {M : ℝ}
    (hb : 1 < b) (hw : ∀ n, |w n| ≤ M) (h1 : w 1 = 0) :
    HasSum (fun j : ℕ => w (b ^ j) / (b : ℝ) ^ j) (endpointSeries b b w) := by
  have hs : Summable (fun j : ℕ => w (b ^ j) / (b : ℝ) ^ j) :=
    weighted_summable (by exact_mod_cast hb) (fun j => hw _)
  simpa only [endpointSeries_base hb hw, h1, sub_zero] using hs.hasSum

def geometricBandIndicator_one {lo hi b : ℕ} (hlo : 1 < lo) (hb : 0 < b) :
    geometricBandIndicator lo hi b 1 = 0 := by
  classical
  have hh : ¬geometricBand lo hi b 1 := by
    rintro ⟨j, hj, _⟩
    have hp : 0 < b ^ j := by positivity
    nlinarith
  simp only [geometricBandIndicator, if_neg hh]


end Bounty

end SubmissionComponent_EndpointSeriesAlgebra

/- Component CoefficientSeries; SHA256 9fe75861c055132b578a720545607a030921e23b520e8787428075f3d285bd89 -/
section SubmissionComponent_CoefficientSeries
/- Identification of the two grouped boundary sums with their coefficient series. -/

namespace Bounty

def third_endpoints_eq_series :
    (endpointSeries 2 3 (geometricBandIndicator 2 4 4) -
      endpointSeries 3 3 (geometricBandIndicator 2 4 4)) -
    (endpointSeries 10 3 (geometricBandIndicator 4 5 4) -
      endpointSeries 12 3 (geometricBandIndicator 4 5 4)) =
        (∑' n : ℕ, (coefficient3 n : ℝ) / (3 : ℝ) ^ n) / 60 := by
  have h2 := endpointSeries_hasSum_weighted (a := 2) (by norm_num : 1 < 3)
    (geometricBandIndicator_bound 2 4 4)
  have h3 := powers_hasSum_endpoint (by norm_num : 1 < 3)
    (geometricBandIndicator_bound 2 4 4) (geometricBandIndicator_one (by norm_num) (by norm_num))
  have h10 := endpointSeries_hasSum_weighted (a := 10) (by norm_num : 1 < 3)
    (geometricBandIndicator_bound 4 5 4)
  have h12 := endpointSeries_hasSum_weighted (a := 12) (by norm_num : 1 < 3)
    (geometricBandIndicator_bound 4 5 4)
  have h : HasSum (fun n : ℕ => ((coefficient3 n : ℝ) / (3 : ℝ) ^ n) / 60)
      (((endpointSeries 2 3 (geometricBandIndicator 2 4 4) -
        endpointSeries 3 3 (geometricBandIndicator 2 4 4)) -
        endpointSeries 10 3 (geometricBandIndicator 4 5 4)) +
        endpointSeries 12 3 (geometricBandIndicator 4 5 4)) := by
    apply (((h2.sub h3).sub h10).add h12).congr_fun
    intro n
    rw [show ((coefficient3 n : ℝ) / (3 : ℝ) ^ n) / 60 =
      ((coefficient3 n : ℝ) / 60) / (3 : ℝ) ^ n by ring, coefficient3_eq_boundaries]
    norm_num only [Nat.cast_ofNat]
    ring
  have he := h.tsum_eq
  rw [tsum_div_const] at he
  linarith

def fourth_endpoints_eq_series :
    (endpointSeries 2 4 (geometricBandIndicator 2 3 3) -
      endpointSeries 4 4 (geometricBandIndicator 2 3 3)) -
    (endpointSeries 4 4 (geometricBandIndicator 10 12 3) -
      endpointSeries 5 4 (geometricBandIndicator 10 12 3)) =
        (∑' n : ℕ, (coefficient4 n : ℝ) / (4 : ℝ) ^ n) / 60 - 4 / 5 := by
  have htwo : geometricBandIndicator 2 3 3 2 = 1 := by
    classical
    have hh : geometricBand 2 3 3 2 := ⟨0, by norm_num, by norm_num⟩
    simp only [geometricBandIndicator, if_pos hh]
  have h2 := endpointSeries_hasSum_tail (a := 2) (by norm_num : 1 < 4)
    (geometricBandIndicator_bound 2 3 3)
  rw [htwo] at h2
  have h4 := endpointSeries_hasSum (a := 4) (by norm_num : 1 < 4)
    (geometricBandIndicator_bound 2 3 3)
  have hg4 := endpointSeries_hasSum (a := 4) (by norm_num : 1 < 4)
    (geometricBandIndicator_bound 10 12 3)
  have hg5 := endpointSeries_hasSum (a := 5) (by norm_num : 1 < 4)
    (geometricBandIndicator_bound 10 12 3)
  have h : HasSum (fun n : ℕ => ((coefficient4 (n + 1) : ℝ) / (4 : ℝ) ^ (n + 1)) / 60)
      ((((endpointSeries 2 4 (geometricBandIndicator 2 3 3) - 1 / 2) -
        endpointSeries 4 4 (geometricBandIndicator 2 3 3)) -
        endpointSeries 4 4 (geometricBandIndicator 10 12 3)) +
        endpointSeries 5 4 (geometricBandIndicator 10 12 3)) := by
    apply (((h2.sub h4).sub hg4).add hg5).congr_fun
    intro n
    rw [show ((coefficient4 (n + 1) : ℝ) / (4 : ℝ) ^ (n + 1)) / 60 =
      ((coefficient4 (n + 1) : ℝ) / 60) / (4 : ℝ) ^ (n + 1) by ring,
      coefficient4_succ_eq_boundaries]
    simp only [pow_succ', Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
    ring
  have ht := (hasSum_nat_tail_sub coefficient4_summable).div_const 60
  have hz : (coefficient4 0 : ℝ) = 78 := by norm_num [coefficient4]
  simp only [pow_zero, div_one, hz] at ht
  have he := ht.unique h
  norm_num only [Nat.cast_ofNat] at he
  linarith


end Bounty

end SubmissionComponent_CoefficientSeries

/- Component DensityIdentification; SHA256 585e75d7cbb68e7546dd75fed239dd3ea4ce2252dfa86f7955a1bf90dce6e723 -/
section SubmissionComponent_DensityIdentification
/- The checked jump density equals the explicit mixed-base coefficient series. -/

namespace Bounty

def jumpDensity_eq_explicitDensity : jumpDensity = explicitDensity := by
  rw [jumpDensity_eq_correction_series, ← correction_jumps_eq_kernel,
    correction_jumps_tsum_endpoints]
  unfold explicitDensity
