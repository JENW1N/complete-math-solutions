section SubmissionComponent_OneFormCoverReindex
/- Reindexing the actual one-form product completes the conditional bridge
to the existing arithmetic application. The geometric contract remains an
explicit hypothesis throughout; no unconditional target is declared. -/

namespace Bounty
noncomputable section
open scoped BigOperators Matrix

def twoThreeOneFormProduct_comp_equiv {I J : Type*}
    [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (e : I ≃ J) (a x : J → ℚ) (k : I) :
    twoThreeOneFormProduct (a ∘ e) (x ∘ e) k = twoThreeOneFormProduct a x (e k) := by
  have hs : (∑ i, a (e i) * x (e i)) = ∑ j, a j * x j :=
    Equiv.sum_comp e (fun j => a j * x j)
  have hp : (∏ i ∈ Finset.univ.erase k, |x (e i)|) =
      ∏ j ∈ Finset.univ.erase (e k), |x j| := by
    apply Finset.prod_equiv e
    · intro i
      simp
    · intro i _
      rfl
  have hf : (∏ i, padicNorm 2 (x (e i)) * padicNorm 3 (x (e i))) =
      ∏ j, padicNorm 2 (x j) * padicNorm 3 (x j) :=
    Equiv.prod_comp e (fun j => padicNorm 2 (x j) * padicNorm 3 (x j))
  simpa only [twoThreeOneFormProduct, Function.comp_apply, hs, hp, hf]

def integer_oneForm_cover_of_three_place (hST : RationalThreePlaceSubspaceCover) :
    IntegerOneFormCover405 := by
  classical
  intro I instF instD hmin _hmax a k hak
  let e : Fin (Fintype.card I) ≃ I := (Fintype.equivFin I).symm
  obtain ⟨F, hF, hcover⟩ := integer_oneForm_finite_cover_of_three_place hST hmin
    (a ∘ e) (e.symm k) (by simpa using hak) oneFormExponent (by norm_num [oneFormExponent])
  refine ⟨F.image (fun b => b ∘ e.symm), ?_, ?_⟩
  · intro b hb
    obtain ⟨b', hb', rfl⟩ := Finset.mem_image.mp hb
    intro hz
    apply hF b' hb'
    funext i
    have hh := congrFun hz (e i)
    simpa using hh
  · intro x hx hsmall
    have hx' : (x ∘ e) ≠ 0 := by
      intro hz
      apply hx
      funext i
      have hh := congrFun hz (e.symm i)
      simpa using hh
    have hp : twoThreeOneFormProduct (a ∘ e) (fun i => ((x ∘ e) i : ℚ)) (e.symm k) =
        twoThreeOneFormProduct a (fun i => (x i : ℚ)) k := by
      simpa only [Function.comp_def, Equiv.apply_symm_apply] using
        twoThreeOneFormProduct_comp_equiv e a (fun i => (x i : ℚ)) (e.symm k)
    have hH : Height.mulHeight (fun i => ((x ∘ e) i : ℚ)) =
        Height.mulHeight (fun i => (x i : ℚ)) :=
      Height.mulHeight_comp_equiv e (fun i => (x i : ℚ))
    obtain ⟨b, hb, hbx⟩ := hcover (x ∘ e) hx' (by
      simpa only [hp, hH, oneFormHeightFactor] using hsmall)
    refine ⟨b ∘ e.symm, Finset.mem_image.mpr ⟨b, hb, rfl⟩, ?_⟩
    have heq := Equiv.sum_comp e (fun i => (b ∘ e.symm) i * (x i : ℚ))
    exact heq.symm.trans (by simpa using hbx)


end
