/- Component ClosureAssertedCheck; SHA256 b1b31b6c0c15606432c29c9ab888a88faa693174539af829c27a55b07c55227d. -/
section PolicySubmissionPart67
/- A checked unit clause connects a semantic input fact to the SAT database. -/
namespace ClosureAssertedCheck
open ClosureSemantics Bounty

def checkEntry (clauses : Nat → List Int) (record : List Nat) : Bool :=
  decide (clauses (record.headD 0) = [((record.getD 1 0 + 1 : Nat) : Int)])

def checkEntry_sound (clauses : Nat → List Int) (record : List Nat)
    (values : Valuation) (hc : checkEntry clauses record = true)
    (ht : (values (record.getD 1 0)).b = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true)
      (clauses (record.headD 0)) := by
  have hshape : clauses (record.headD 0) = [((record.getD 1 0 + 1 : Nat) : Int)] :=
    of_decide_eq_true hc
  rw [hshape]
  refine ⟨((record.getD 1 0 + 1 : Nat) : Int), by simp, ?_⟩
  apply (ClosureCircuit.signed_pos (fun v => (values (v - 1)).b)
    (Nat.succ_pos (record.getD 1 0))).mpr
  simpa using ht

def checkBlock (clauses : Nat → List Int) (records : Nat → List Nat)
    (start count : Nat) : Bool :=
  (List.range count).all fun i => checkEntry clauses (records (start + i))

def checkBlock_sound (clauses : Nat → List Int) (records : Nat → List Nat)
    (start count : Nat) (hc : checkBlock clauses records start count = true)
    (i : Nat) (hi : i < count) (values : Valuation)
    (ht : (values ((records (start + i)).getD 1 0)).b = true) :
    policySignedClauseHolds (fun v => (values (v - 1)).b = true)
      (clauses ((records (start + i)).headD 0)) := by
  have h : ∀ j ∈ List.range count, checkEntry clauses (records (start + j)) = true := by
    simpa only [checkBlock, List.all_eq_true] using hc
  exact checkEntry_sound clauses (records (start + i)) values
    (h i (List.mem_range.mpr hi)) ht

end ClosureAssertedCheck

end PolicySubmissionPart67

