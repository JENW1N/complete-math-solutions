/- Component PreviousLevels; SHA256 9d2bcf6dd070c4d44702e2d8c626018e68ce2d18f724987a42bfb234449da2f9 -/
section SubmissionComponent_PreviousLevels
/- The preceding cutoff level, separated according to its last threshold. -/

namespace Bounty

def lowerCutoff_zero_previous_four {n : ℕ} (hn : 0 < n)
    (horder : 3 ^ Nat.log 3 n < 4 ^ Nat.log 4 n) :
    lowerCutoff 0 (cutoffCount 0 n - 1) =
      max (4 ^ (Nat.log 4 n - 1)) (3 ^ Nat.log 3 n) := by
  have hj : 0 < Nat.log 4 n := by
    by_contra hh
    have hz : Nat.log 4 n = 0 := by omega
    have hp : 0 < (3 : ℕ) ^ Nat.log 3 n := by positivity
    simp only [hz, pow_zero] at horder
    omega
  have hs : Nat.log 4 n - 1 + 1 = Nat.log 4 n := by omega
  have hp : 4 ^ (Nat.log 4 n - 1) * 4 = 4 ^ Nat.log 4 n := by
    rw [← pow_succ, hs]
  have hp0 : 0 < (4 : ℕ) ^ (Nat.log 4 n - 1) := by positivity
  let m := 4 ^ Nat.log 4 n - 1
  have hm : 0 < m := by dsimp [m]; omega
  have hmn : m ≤ n := by
    have hh := Nat.pow_log_le_self 4 (Nat.ne_of_gt hn)
    dsimp [m]
    omega
  have h4 : Nat.log 4 m = Nat.log 4 n - 1 := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · dsimp [m]
      omega
    · rw [hs]
      dsimp [m]
      omega
  have h3 : Nat.log 3 m = Nat.log 3 n := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · dsimp [m]
      omega
    · exact lt_of_le_of_lt hmn (Nat.lt_pow_succ_log_self (by norm_num) n)
  have hc : cutoffCount 0 m = cutoffCount 0 n - 1 := by
    simp [cutoffCount, Nat.ne_of_gt hn, Nat.ne_of_gt hm, h4, h3]
    omega
  rw [← hc, lowerCutoff_zero_at_count hm, h4, h3]

def lowerCutoff_zero_previous_three {n : ℕ} (hn : 0 < n)
    (horder : 4 ^ Nat.log 4 n < 3 ^ Nat.log 3 n) :
    lowerCutoff 0 (cutoffCount 0 n - 1) =
      max (4 ^ Nat.log 4 n) (3 ^ (Nat.log 3 n - 1)) := by
  have hj : 0 < Nat.log 3 n := by
    by_contra hh
    have hz : Nat.log 3 n = 0 := by omega
    have hp : 0 < (4 : ℕ) ^ Nat.log 4 n := by positivity
    simp only [hz, pow_zero] at horder
    omega
  have hs : Nat.log 3 n - 1 + 1 = Nat.log 3 n := by omega
  have hp : 3 ^ (Nat.log 3 n - 1) * 3 = 3 ^ Nat.log 3 n := by
    rw [← pow_succ, hs]
  have hp0 : 0 < (3 : ℕ) ^ (Nat.log 3 n - 1) := by positivity
  let m := 3 ^ Nat.log 3 n - 1
  have hm : 0 < m := by dsimp [m]; omega
  have hmn : m ≤ n := by
    have hh := Nat.pow_log_le_self 3 (Nat.ne_of_gt hn)
    dsimp [m]
    omega
  have h3 : Nat.log 3 m = Nat.log 3 n - 1 := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · dsimp [m]
      omega
    · rw [hs]
      dsimp [m]
      omega
  have h4 : Nat.log 4 m = Nat.log 4 n := by
    apply Nat.log_eq_of_pow_le_of_lt_pow
    · dsimp [m]
      omega
    · exact lt_of_le_of_lt hmn (Nat.lt_pow_succ_log_self (by norm_num) n)
  have hc : cutoffCount 0 m = cutoffCount 0 n - 1 := by
    simp [cutoffCount, Nat.ne_of_gt hn, Nat.ne_of_gt hm, h4, h3]
    omega
  rw [← hc, lowerCutoff_zero_at_count hm, h4, h3]


end Bounty

end SubmissionComponent_PreviousLevels

