/- Component BaseIntervalArithmetic; SHA256 7553e19db62313e1f2bc843865d3a34593cca755ddb9daca4960e95c6a26bd48 -/
section SubmissionComponent_BaseIntervalArithmetic

/- Finite endpoint certificates for the repeated arithmetic in the base intervals. -/

namespace Bounty

abbrev intervalAffineLE (lo hi a b c d : ℚ) : Prop :=
  a * lo + b ≤ c * lo + d ∧ a * hi + b ≤ c * hi + d

abbrev intervalAffineLT (lo hi a b c d : ℚ) : Prop :=
  a * lo + b < c * lo + d ∧ a * hi + b ≤ c * hi + d

def intervalAffineLE_sound {lo hi a b c d u : ℚ}
    (h : intervalAffineLE lo hi a b c d) (hlo : lo ≤ u) (hhi : u ≤ hi) :
    a * u + b ≤ c * u + d := by
  rcases h with ⟨hl, hh⟩
  by_cases hac : a ≤ c
  · have := mul_nonpos_of_nonpos_of_nonneg (sub_nonpos.mpr hac) (sub_nonneg.mpr hlo)
    nlinarith
  · have := mul_nonneg (sub_nonneg.mpr (le_of_not_ge hac)) (sub_nonneg.mpr hhi)
    nlinarith

def intervalAffineLT_sound {lo hi a b c d u : ℚ}
    (h : intervalAffineLT lo hi a b c d) (hlo : lo ≤ u) (hhi : u < hi) :
    a * u + b < c * u + d := by
  rcases h with ⟨hl, hh⟩
  by_cases hac : a ≤ c
  · have := mul_nonpos_of_nonpos_of_nonneg (sub_nonpos.mpr hac) (sub_nonneg.mpr hlo)
    nlinarith
  · have := mul_pos (sub_pos.mpr (lt_of_not_ge hac)) (sub_pos.mpr hhi)
    nlinarith

abbrev compactRankConditions (lo hi : ℚ) (a b rank : ℕ) : Prop :=
  1 ≤ lo ∧ (2 ^ a : ℕ) ≤ lo ∧ hi ≤ (2 ^ (a + 1) : ℕ) ∧
  (3 ^ b : ℕ) ≤ lo ∧ hi ≤ (3 ^ (b + 1) : ℕ) ∧
  ((a % 2 = 1 ∧ (2 * 3 ^ b : ℕ) ≤ lo ∧ rank = b + 1 + a / 2 + 1) ∨
   ((a % 2 ≠ 1 ∨ hi ≤ (2 * 3 ^ b : ℕ)) ∧ rank = b + 1 + a / 2))

def compactRankConditions_sound {lo hi u : ℚ} {a b rank : ℕ}
    (h : compactRankConditions lo hi a b rank) (hlo : lo ≤ u) (hhi : u < hi) :
    Nat.log 2 ⌊u⌋₊ = a ∧ smoothRankBound ⌊u⌋₊ = rank := by
  rcases h with ⟨h1, h2l, h2h, h3l, h3h, hx⟩
  have hu : 1 ≤ u := h1.trans hlo
  have hu0 : 0 ≤ u := by linarith
  have ha := log_floor_of_bounds hu0 (h2l.trans hlo) (hhi.trans_le h2h)
  have hb := log_floor_of_bounds hu0 (h3l.trans hlo) (hhi.trans_le h3h)
  refine ⟨ha, ?_⟩
  rw [smoothRank_floor_of_indices hu ha hb]
  rcases hx with ⟨hodd, hcut, hr⟩ | ⟨hcut, hr⟩
  · rw [if_pos ⟨hodd, hcut.trans hlo⟩, hr]
  · rw [if_neg (by
      intro hc
      rcases hcut with heven | hcut
      · exact heven hc.1
      · exact (not_le_of_gt (hhi.trans_le hcut)) hc.2), hr, Nat.add_zero]

abbrev compactBadConditions (lo hi : ℚ) (j b low high : ℕ) (bad : Bool) : Prop :=
  (low : ℚ) ≤ 5 * lo ∧ 5 * hi ≤ high ∧
  4 ^ j ≤ low ∧ high ≤ 4 ^ (j + 1) ∧ 3 ^ b ≤ low ∧ high ≤ 3 ^ (b + 1) ∧
  if bad then
    4 * (high - 1) < 5 * 4 ^ j ∧ 10 * 3 ^ (b - 2) ≤ low ∧ high ≤ 12 * 3 ^ (b - 2)
  else
    5 * 4 ^ j ≤ 4 * low ∨ high ≤ 10 * 3 ^ (b - 2) ∨ 12 * 3 ^ (b - 2) ≤ low

def compactBadConditions_sound {lo hi u : ℚ} {j b low high : ℕ} {bad : Bool}
    (h : compactBadConditions lo hi j b low high bad) (hu : 0 ≤ u)
    (hlo : lo ≤ u) (hhi : u < hi) : badWindow ⌊5 * u⌋₊ ↔ bad = true := by
  rcases h with ⟨hlo5, hhi5, h4lo, h4hi, h3lo, h3hi, hb⟩
  have hu5 : 0 ≤ 5 * u := by positivity
  have hnlo : low ≤ ⌊5 * u⌋₊ := (Nat.le_floor_iff hu5).mpr (by linarith)
  have hnhi : ⌊5 * u⌋₊ < high := (Nat.floor_lt hu5).mpr (by linarith)
  have hj : Nat.log 4 ⌊5 * u⌋₊ = j :=
    Nat.log_eq_of_pow_le_of_lt_pow (h4lo.trans hnlo) (hnhi.trans_le h4hi)
  have hc : Nat.log 3 ⌊5 * u⌋₊ = b :=
    Nat.log_eq_of_pow_le_of_lt_pow (h3lo.trans hnlo) (hnhi.trans_le h3hi)
  rw [badWindow_iff_canonical, hj, hc]
  cases bad with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte, iff_false] at hb ⊢
    intro hbad
    rcases hbad with ⟨_, hn4, hn3l, hn3h⟩
    rcases hb with hb | hb | hb <;> omega
  | true =>
    simp only [↓reduceIte] at hb
    simp only [iff_true]
    omega

abbrev compactQuotaConditions (eps : Bool) (lo hi : ℚ) (a b rank quota j c low high : ℕ)
    (bad : Bool) : Prop :=
  compactRankConditions lo hi a b rank ∧
  if eps then compactBadConditions lo hi j c low high bad ∧
    quota = rank - if bad then 1 else 0
  else quota = rank

def compactQuotaConditions_sound {eps : Bool} {lo hi u : ℚ}
    {a b rank quota j c low high : ℕ} {bad : Bool}
    (h : compactQuotaConditions eps lo hi a b rank quota j c low high bad)
    (hlo : lo ≤ u) (hhi : u < hi) :
    Nat.log 2 ⌊u⌋₊ = a ∧ quotaValue eps u = quota := by
  obtain ⟨ha, hrank⟩ := compactRankConditions_sound h.1 hlo hhi
  refine ⟨ha, ?_⟩
  have hu : 0 ≤ u := by have := h.1.1; linarith
  cases eps with
  | false =>
    have hq : quota = rank := h.2
    simp [quotaValue, hrank, hq]
  | true =>
    have hb := compactBadConditions_sound h.2.1 hu hlo hhi
    have hq : quota = rank - if bad then 1 else 0 := h.2.2
    simp only [quotaValue, hrank, true_and, hb, ← hq]


end Bounty

end SubmissionComponent_BaseIntervalArithmetic

/- Component BaseIntervalCutoff; SHA256 e7c7ee03ca5ad20713a0fbdb69658ee2d84715448053f98d30d7c59f9d3dde41 -/
section SubmissionComponent_BaseIntervalCutoff

/- A single ordinary proof turns finite affine endpoint checks into a valid base interval. -/

namespace Bounty

structure CompactQuotaData where
  logTwo : ℕ
  logThree : ℕ
  rank : ℕ
  quota : ℕ
  logFourFive : ℕ
  logThreeFive : ℕ
  lowFive : ℕ
  highFive : ℕ
  bad : Bool

abbrev compactQuotaDataConditions (eps : Bool) (lo hi : ℚ) (d : CompactQuotaData) : Prop :=
  compactQuotaConditions eps lo hi d.logTwo d.logThree d.rank d.quota
    d.logFourFive d.logThreeFive d.lowFive d.highFive d.bad

abbrev compactTrialConditions (lo hi : ℚ) (p p5 p7 level next : ℕ)
    (s t s5 t5 s7 t7 : ℚ) : Prop :=
  intervalAffineLE lo hi (3 / 4) 0 s t ∧
  intervalAffineLE lo hi 0 level s t ∧
  intervalAffineLE lo hi ((if p = p5 then 4 else 6) * s5 / 5)
    ((if p = p5 then 4 else 6) * t5) s t ∧
  intervalAffineLE lo hi ((if p = p7 then 4 else 6) * s7 / 7)
    ((if p = p7 then 4 else 6) * t7) s t ∧
  ((s = 3 / 4 ∧ t = 0) ∨ (s = 0 ∧ t = level) ∨
    (s = (if p = p5 then 4 else 6) * s5 / 5 ∧ t = (if p = p5 then 4 else 6) * t5) ∨
    (s = (if p = p7 then 4 else 6) * s7 / 7 ∧ t = (if p = p7 then 4 else 6) * t7)) ∧
  intervalAffineLE lo hi s t 1 0 ∧ intervalAffineLT lo hi s t 0 next

def compactTrialConditions_sound {lo hi u s t s5 t5 s7 t7 : ℚ}
    {p p5 p7 k level next : ℕ}
    (hlo : lo ≤ u) (hhi : u < hi)
    (hlevel : lowerCutoff p k = level) (hnext : lowerCutoff p (k + 1) = next)
    (h : compactTrialConditions lo hi p p5 p7 level next s t s5 t5 s7 t7) :
    cutoffTrial u k p (p5, s5 * (u / 5) + t5) (p7, s7 * (u / 7) + t7) = s * u + t ∧
    cutoffAvailable u k p (p5, s5 * (u / 5) + t5) (p7, s7 * (u / 7) + t7) := by
  rcases h with ⟨hbase, hlev, hfive, hseven, heq, hself, hupper⟩
  have ht : cutoffTrial u k p (p5, s5 * (u / 5) + t5)
      (p7, s7 * (u / 7) + t7) = s * u + t := by
    apply cutoffTrial_eq_of_bounds
    · have := intervalAffineLE_sound hbase hlo hhi.le
      linarith
    · rw [hlevel]
      simpa only [zero_mul, zero_add] using intervalAffineLE_sound hlev hlo hhi.le
    · have := intervalAffineLE_sound hfive hlo hhi.le
      dsimp at this ⊢
      convert this using 1 <;> ring
    · have := intervalAffineLE_sound hseven hlo hhi.le
      dsimp at this ⊢
      convert this using 1 <;> ring
    · rcases heq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact Or.inl (by ring)
      · exact Or.inr (Or.inl (by rw [hlevel]; ring))
      · exact Or.inr (Or.inr (Or.inl (by dsimp; ring)))
      · exact Or.inr (Or.inr (Or.inr (by dsimp; ring)))
  refine ⟨ht, ?_⟩
  unfold cutoffAvailable
  rw [ht, hnext]
  constructor
  · simpa only [one_mul, add_zero] using intervalAffineLE_sound hself hlo hhi.le
  · simpa only [zero_mul, zero_add] using intervalAffineLT_sound hupper hlo hhi

def compactBaseInterval_preferred (d : CompactQuotaData)
    {eps : Bool} {lo hi u s t s5 t5 s7 t7 : ℚ} {p p5 p7 level next : ℕ}
    (hlo : lo ≤ u) (hhi : u < hi)
    (hp : cutoffTableEval (basePieces eps) u = (p, s * u + t))
    (h5 : cutoffTableEval (basePieces true) (u / 5) = (p5, s5 * (u / 5) + t5))
    (h7 : cutoffTableEval (basePieces eps) (u / 7) = (p7, s7 * (u / 7) + t7))
    (hlevel : lowerCutoff p d.quota = level)
    (hnext : lowerCutoff p (d.quota + 1) = next)
    (hquota : compactQuotaDataConditions eps lo hi d)
    (hpar : d.logTwo % 2 = p)
    (htrial : compactTrialConditions lo hi p p5 p7 level next s t s5 t5 s7 t7) :
    baseStepValid eps u := by
  obtain ⟨hlog, hq⟩ := compactQuotaConditions_sound hquota hlo hhi
  have hpreferred : Nat.log 2 ⌊u⌋₊ % 2 = p := by rw [hlog]; exact hpar
  obtain ⟨ht, hav⟩ := compactTrialConditions_sound hlo hhi hlevel hnext htrial
  unfold baseStepValid
  rw [hp, h5, h7]
  constructor
  · rw [cutoffCandidate_eq_preferred hq hpreferred hav, ht]
  · simpa only [hq] using hav


