/- Component PackedNatHead; SHA256 eef459d79e09719dc8d62d18a6f1a4903e0d7d3ae951e2bd312a01e7f9060fc4. -/
section PolicySubmissionPart52
/- Read the first field without decoding the rest of a packed numerical record. -/
namespace CompactNatData

def headAux : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, _ => 0
  | fuel + 1, packed, value, multiplier =>
      let digit := packed % 64
      let next := value + digit % 32 * multiplier
      if digit < 32 then next
      else headAux fuel (packed / 64) next (multiplier * 32)

def head (digits packed : Nat) : Nat := headAux digits packed 0 1

def read_preserves_first (fuel packed value multiplier first : Nat) (xs : List Nat) :
    ((read fuel packed (xs ++ [first], value, multiplier)).1.reverse).headD 0 = first := by
  induction fuel generalizing packed value multiplier xs with
  | zero => simp [read]
  | succ fuel ih =>
    by_cases h : packed % 64 < 32
    · simpa only [read, step, h, ↓reduceIte, List.cons_append] using
        ih (packed / 64) 0 1 ((value + packed % 64 % 32 * multiplier) :: xs)
    · simpa only [read, step, h, ↓reduceIte] using
        ih (packed / 64) (value + packed % 64 % 32 * multiplier) (multiplier * 32) xs

def headAux_eq (fuel packed value multiplier : Nat) :
    headAux fuel packed value multiplier =
      ((read fuel packed ([], value, multiplier)).1.reverse).headD 0 := by
  induction fuel generalizing packed value multiplier with
  | zero => rfl
  | succ fuel ih =>
    by_cases h : packed % 64 < 32
    · simp only [headAux, read, step, h, ↓reduceIte]
      symm
      simpa only [List.nil_append] using
        read_preserves_first fuel (packed / 64) 0 1
          (value + packed % 64 % 32 * multiplier) []
    · simpa only [headAux, read, step, h, ↓reduceIte] using
        ih (packed / 64) (value + packed % 64 % 32 * multiplier) (multiplier * 32)

def head_eq_decode_head (digits packed : Nat) :
    head digits packed = (decode digits packed).headD 0 :=
  headAux_eq digits packed 0 1

end CompactNatData

namespace PackedNatTable

def Block.head (b : Block) (i : Nat) : Nat :=
  let first := b.start i
  let count := b.start (i + 1) - first
  let packed := (b.data >>> (6 * first)) &&& ((1 <<< (6 * count)) - 1)
  CompactNatData.head count packed

def Block.head_eq_get_head (b : Block) (i : Nat) :
    b.head i = (b.get i).headD 0 :=
  CompactNatData.head_eq_decode_head _ _

def recordHead (t : Table Block) (i : Nat) : Nat :=
  (t.get emptyBlock (i / 32)).head (i % 32)

def recordHead_eq (t : Table Block) (i : Nat) :
    recordHead t i = (records t i).headD 0 :=
  Block.head_eq_get_head _ _

def recordHead16 (t : Table Block) (i : Nat) : Nat :=
  recordHead t (32 * (i / 16) + i % 16)

def recordHead16_eq (t : Table Block) (i : Nat) :
    recordHead16 t i = (records t (32 * (i / 16) + i % 16)).headD 0 :=
  recordHead_eq _ _

end PackedNatTable

end PolicySubmissionPart52

