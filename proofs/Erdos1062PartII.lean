section PolicySubmissionPart45
/- The first three comparisons avoid evaluating the underlying program on hits.
Only semantic Equations transfer is claimed; the programs need not be equal. -/
namespace PolicyHotLiteralOverrides
open ClosureSemantics

def program (base : ℕ → Node) (zeroId negativeId oneId i : ℕ) : Node :=
  if i = zeroId then ⟨.qConst 0, []⟩
  else if i = negativeId then ⟨.qConst (-1), []⟩
  else if i = oneId then ⟨.qConst 1, []⟩
  else base i

def equations (base : ℕ → Node) (zeroId negativeId oneId : ℕ)
    (input values : Valuation) (he : Equations base input values)
    (hz : values zeroId = ratValue 0)
    (hn : values negativeId = ratValue (-1))
    (ho : values oneId = ratValue 1) :
    Equations (program base zeroId negativeId oneId) input values := by
  intro i
  unfold program
  split_ifs with h0 h1 h2
  · subst i
    exact hz
  · subst i
    exact hn
  · subst i
    exact ho
  · exact he i

end PolicyHotLiteralOverrides

end PolicySubmissionPart45

