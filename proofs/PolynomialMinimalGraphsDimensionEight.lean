/- Component: GraphTangentLimit.inc -/
namespace Source29GraphTangentLimit

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics Source29GraphDilationFields
open Source29GraphRadialGeometry Source29GraphAreaConvexity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def tangentHeight (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) : ℝ := evalFDeriv P 0 x

theorem height_tendsto_tangent (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    (x : Fin n → ℝ) : Tendsto (fun r ↦ height P r x) (𝓝[>] 0) (𝓝 (tangentHeight P x)) := by
  have hc : HasDerivAt (fun t : ℝ ↦ t • x) x 0 := by
    simpa only [one_smul, id_eq] using (hasDerivAt_id (0 : ℝ)).smul_const x
  have hd := (hasFDerivAt_eval P ((0 : ℝ) • x)).comp_hasDerivAt (0 : ℝ) hc
  have ht := hd.tendsto_slope_zero_right
  simpa only [Function.comp_def, zero_add, zero_smul, hP, sub_zero, smul_eq_mul,
    height, tangentHeight, div_eq_mul_inv, mul_comm] using ht

theorem gradient_tendsto (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i : Fin n) :
    Tendsto (fun r ↦ gradient P r x i) (𝓝[>] 0) (𝓝 (evaluatedGradient P 0 i)) := by
  have ht : Tendsto (fun r : ℝ ↦ r • x) (𝓝[>] 0) (𝓝 0) := by
    have hc : Continuous (fun r : ℝ ↦ r • x) := continuous_id.smul continuous_const
    simpa only [zero_smul] using (hc.continuousAt (x := 0)).tendsto.mono_left
      (show 𝓝[>] (0 : ℝ) ≤ 𝓝 0 from nhdsWithin_le_nhds)
  exact (contDiff_eval (pderiv i P)).continuous.continuousAt.tendsto.comp ht

theorem density_tendsto (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    {f : ℝ → ℝ} (hf : Continuous f) (x : Fin n → ℝ) :
    Tendsto (fun r ↦ f (graphRadiusSq (height P r) x) * areaDensity (gradient P r x))
      (𝓝[>] 0) (𝓝 (f (graphRadiusSq (tangentHeight P) x) * areaDensity (evaluatedGradient P 0))) := by
  have hh := height_tendsto_tangent P hP x
  have hs : Tendsto (fun r ↦ graphRadiusSq (height P r) x) (𝓝[>] 0)
      (𝓝 (graphRadiusSq (tangentHeight P) x)) := tendsto_const_nhds.add (hh.pow 2)
  have hw : Tendsto (fun r ↦ areaDensity (gradient P r x)) (𝓝[>] 0)
      (𝓝 (areaDensity (evaluatedGradient P 0))) := by
    apply Tendsto.sqrt
    exact tendsto_const_nhds.add (tendsto_finsetSum _ (fun i _ ↦ (gradient_tendsto P x i).pow 2))
  exact (hf.continuousAt.tendsto.comp hs).mul hw

end
