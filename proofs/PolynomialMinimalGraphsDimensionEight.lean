/- Component: GraphAreaConvexity.inc -/
/- The elementary convexity and integrability part of the graph calibration.
The conclusion concerns compactly supported vertical graph variations. -/
namespace Source29GraphAreaConvexity

open MeasureTheory
open scoped BigOperators

noncomputable section

def areaDensity {n : ℕ} (a : Fin n → ℝ) : ℝ :=
  Real.sqrt (1 + ∑ i, a i ^ 2)

theorem areaDensity_pos {n : ℕ} (a : Fin n → ℝ) : 0 < areaDensity a := by
  apply Real.sqrt_pos.mpr
  have h : 0 ≤ ∑ i, a i ^ 2 := Finset.sum_nonneg fun i _ ↦ sq_nonneg (a i)
  linarith

theorem areaDensity_sq {n : ℕ} (a : Fin n → ℝ) :
    areaDensity a ^ 2 = 1 + ∑ i, a i ^ 2 := by
  apply Real.sq_sqrt
  have h : 0 ≤ ∑ i, a i ^ 2 := Finset.sum_nonneg fun i _ ↦ sq_nonneg (a i)
  linarith

/-- Supporting-hyperplane inequality for the area integrand. -/
theorem areaDensity_support {n : ℕ} (a b : Fin n → ℝ) :
    (∑ i, (b i - a i) * (a i / areaDensity a)) ≤
      areaDensity b - areaDensity a := by
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ
    (Fin.cons (1 : ℝ) a) (Fin.cons (1 : ℝ) b)
  simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ, one_pow, one_mul] at hcs
  change 1 + ∑ i, a i * b i ≤ areaDensity a * areaDensity b at hcs
  have he : (∑ i, (b i - a i) * (a i / areaDensity a)) =
      ((∑ i, a i * b i) - ∑ i, a i ^ 2) / areaDensity a := by
    rw [← Finset.sum_sub_distrib, Finset.sum_div]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [he]
  apply (div_le_iff₀ (areaDensity_pos a)).mpr
  nlinarith [areaDensity_sq a]

theorem areaDensity_add_support {n : ℕ} (a h : Fin n → ℝ) :
    (∑ i, h i * (a i / areaDensity a)) ≤
      areaDensity (a + h) - areaDensity a := by
  simpa only [Pi.add_apply, add_sub_cancel_left] using areaDensity_support a (a + h)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {n : ℕ}

def areaIncrement (g : E → Fin n → ℝ) (v : Fin n → E) (φ : E → ℝ) (x : E) : ℝ :=
  areaDensity (g x + fun i ↦ fderiv ℝ φ x (v i)) - areaDensity (g x)

omit [NormedSpace ℝ E] in
theorem areaDensity_continuous (g : E → Fin n → ℝ)
    (hg : ∀ i, Continuous (fun x ↦ g x i)) :
    Continuous (fun x ↦ areaDensity (g x)) := by
  apply Continuous.sqrt
  exact continuous_const.add (continuous_finsetSum _ fun i _ ↦ (hg i).pow 2)

theorem areaIncrement_continuous (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hg : ∀ i, Continuous (fun x ↦ g x i))
    (hφ : ContDiff ℝ 1 φ) : Continuous (areaIncrement g v φ) := by
  apply Continuous.sub
  · apply areaDensity_continuous
    intro i
    exact (hg i).add ((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const)
  · exact areaDensity_continuous g hg

theorem areaIncrement_hasCompactSupport (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hcφ : HasCompactSupport φ) :
    HasCompactSupport (areaIncrement g v φ) := by
  apply HasCompactSupport.of_support_subset_isCompact hcφ
  intro x hx
  by_contra hnot
  have hd : fderiv ℝ φ x = 0 := fderiv_of_notMem_tsupport ℝ hnot
  have hz : areaIncrement g v φ x = 0 := by
    simp only [areaIncrement, hd, zero_apply]
    change areaDensity (g x + 0) - areaDensity (g x) = 0
    simp
  exact hx hz

variable [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E]
  {μ : Measure E} [μ.IsAddHaarMeasure]

omit [FiniteDimensional ℝ E] in
theorem areaIncrement_integrable (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hg : ∀ i, Continuous (fun x ↦ g x i))
    (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    Integrable (areaIncrement g v φ) μ :=
  (areaIncrement_continuous g v hg hφ).integrable_of_hasCompactSupport
    (areaIncrement_hasCompactSupport g v hcφ)

end
end Source29GraphAreaConvexity

/- Component: GraphCalibration.inc -/
namespace Source29GraphCalibration

open MeasureTheory MvPolynomial
open Source29GraphAreaConvexity
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open scoped BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {n : ℕ}

/-- A divergence-free normalized field calibrates the convex graph-area
functional against every compactly supported C¹ vertical variation. -/
theorem area_minimizing_of_divergence_zero
    (g : E → Fin n → ℝ) (v : Fin n → E)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdiv : ∀ x, divergence v (normalizedField g) x = 0)
    {φ : E → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    0 ≤ ∫ x, areaIncrement g v φ x ∂μ := by
  have hF := normalizedField_contDiff hg
  have hf := testFlux_integrable (μ := μ) v hφ hcφ (fun i ↦ (hF i).continuous)
  have ha := areaIncrement_integrable (μ := μ) g v
    (fun i ↦ (hg i).continuous) hφ hcφ
  have hle : ∫ x, testFlux v φ (normalizedField g) x ∂μ ≤
      ∫ x, areaIncrement g v φ x ∂μ := by
    apply integral_mono hf ha
    intro x
    exact areaDensity_add_support (g x) (fun i ↦ fderiv ℝ φ x (v i))
  rw [integral_testFlux_eq_zero v hφ hcφ hF hdiv] at hle
  exact hle

theorem polynomial_normalizedGradient_divergence_zero
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (normalizedField (evaluatedGradient P)) x = 0 := by
  apply divergence_normalizedField_eq_zero
    (fun i ↦ Pi.single i 1) (fun i ↦ FluxPolynomial.contDiff_eval (pderiv i P))
  intro y
  change minimalFieldNumerator (fun i ↦ Pi.single i 1) (evaluatedGradient P) y = 0
  rw [FluxPolynomial.minimalFieldNumerator_evaluatedGradient]
  change Source29QuarticReuse.QuarticPolynomialBasics.minimalGraphOperator P = 0 at hmin
  rw [hmin, map_zero]

/-- Every polynomial satisfying the full minimal graph equation minimizes
graph area under compactly supported C¹ vertical perturbations. -/
theorem polynomial_graph_area_minimizing
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    0 ≤ ∫ x, areaIncrement (evaluatedGradient P) (fun i ↦ Pi.single i 1) φ x := by
  apply area_minimizing_of_divergence_zero (evaluatedGradient P) (fun i ↦ Pi.single i 1)
    (fun i ↦ FluxPolynomial.contDiff_eval (pderiv i P))
    (polynomial_normalizedGradient_divergence_zero P hmin) hφ hcφ

end
end Source29GraphCalibration

/- Component: TopWeakCalibration.inc -/
namespace Source29TopWeakCalibration

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29QuarticReuse.FluxPolynomial
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem evaluatedGradient_ne_zero_of_eval_ne_zero
    (p : MvPolynomial (Fin n) ℝ) {d : ℕ} (hh : p.IsHomogeneous d)
    (hd : 0 < d) {x : Fin n → ℝ} (hx : eval x p ≠ 0) :
    evaluatedGradient p x ≠ 0 := by
  intro hz
  have he := euler_evaluatedGradient p hh x
  simp only [hz, Pi.zero_apply, mul_zero, Finset.sum_const_zero] at he
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  exact hx ((mul_eq_zero.mp he.symm).resolve_left hd')

/-- Polynomial scaling gives almost-everywhere convergence of the regularized
gradient directions to the unit gradient direction of the leading term. -/
theorem normalizedGradient_dilates_tendsto_ae
    (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree) :
    ∀ᵐ x : Fin n → ℝ, ∀ i,
      Tendsto (fun k ↦ normalizedField (evaluatedGradient P) (dilationRadius k • x) i)
        atTop (𝓝 (leadingNormalizedField (homogeneousComponent P.totalDegree P) x i)) := by
  let d := P.totalDegree - 1
  have hd : 0 < d := by dsimp [d]; omega
  have hdegree : d + 1 = P.totalDegree := by dsimp [d]; omega
  let top := homogeneousComponent (d + 1) P
  have htop : top.IsHomogeneous (d + 1) := homogeneousComponent_isHomogeneous _ _
  have hne : top ≠ 0 := by
    dsimp [top]
    rw [hdegree]
    exact top_homogeneousComponent_ne_zero P (by omega)
  have hlim : ∀ᵐ x : Fin n → ℝ, ∀ i,
      Tendsto (fun k ↦ normalizedField (evaluatedGradient P) (dilationRadius k • x) i)
        atTop (𝓝 (leadingNormalizedField top x i)) := by
    filter_upwards [mvPolynomial_eval_ne_zero_ae n top hne] with x hx
    have hgrad : evaluatedGradient top x ≠ 0 :=
      evaluatedGradient_ne_zero_of_eval_ne_zero top htop (by omega) hx
    intro i
    apply normalized_ratio_tendsto (r := fun k ↦ (dilationRadius k)⁻¹ ^ d)
    · intro k
      exact pow_pos (inv_pos.mpr (dilationRadius_pos k)) d
    · have hr := (tendsto_inv_atTop_zero.comp dilationRadius_tendsto).pow d
      simpa only [zero_pow hd.ne', Function.comp_def] using hr
    · intro j
      have hpd : (pderiv j P).totalDegree ≤ d :=
        totalDegree_pderiv_le_of_totalDegree_le P j d (by omega)
      have hh := (eval_dilate_div_pow_tendsto (pderiv j P) hd hpd x).comp
        dilationRadius_tendsto
      simpa only [evaluatedGradient, top, pderiv_homogeneousComponent,
        Function.comp_def, div_eq_mul_inv, inv_pow, mul_comm] using hh
    · exact hgrad
  simpa only [top, hdegree] using hlim

/-- The leading term inherits a weak divergence-free unit gradient field.
Integrability and the zero-flux identity include its critical set by an
almost-everywhere limiting argument. -/
theorem top_weak_calibration
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    Integrable (testFlux (fun i ↦ Pi.single i 1) φ
      (leadingNormalizedField (homogeneousComponent P.totalDegree P))) ∧
    (∫ x, testFlux (fun i ↦ Pi.single i 1) φ
      (leadingNormalizedField (homogeneousComponent P.totalDegree P)) x) = 0 := by
  have hg : ∀ i, ContDiff ℝ 1 (fun x ↦ evaluatedGradient P x i) :=
    fun i ↦ contDiff_eval (pderiv i P)
  have hnorm := normalizedField_contDiff hg
  let F : ℕ → (Fin n → ℝ) → Fin n → ℝ := fun k x ↦
    normalizedField (evaluatedGradient P) (dilationRadius k • x)
  have hF : ∀ k i, ContDiff ℝ 1 (fun x ↦ F k x i) := by
    intro k i
    exact (hnorm i).comp (by fun_prop)
  have hdiv : ∀ k x, divergence (fun i ↦ Pi.single i 1) (F k) x = 0 := by
    intro k x
    change divergence (fun i ↦ Pi.single i 1)
      (fun y ↦ normalizedField (evaluatedGradient P) (dilationRadius k • y)) x = 0
    rw [divergence_dilate _ hnorm,
      Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin,
      mul_zero]
  have hbound : ∀ k x i, ‖F k x i‖ ≤ 1 := by
    intro k x i
    exact normalizedField_norm_le_one _ _ _
  have hlim := normalizedGradient_dilates_tendsto_ae P hdeg
  exact ⟨testFlux_limit_integrable (fun i ↦ Pi.single i 1) hφ hcφ
      (fun k i ↦ (hF k i).continuous) hbound hlim,
    integral_testFlux_limit_eq_zero (fun i ↦ Pi.single i 1) hφ hcφ hF hdiv hbound hlim⟩

end
end Source29TopWeakCalibration

/- Component: VariationConvexity.inc -/
namespace Source29VariationConvexity

open MeasureTheory
open scoped BigOperators

noncomputable section

def variationDensity {n : ℕ} (a : Fin n → ℝ) : ℝ :=
  Real.sqrt (∑ i, a i ^ 2)

theorem variationDensity_sq {n : ℕ} (a : Fin n → ℝ) :
    variationDensity a ^ 2 = ∑ i, a i ^ 2 :=
  Real.sq_sqrt (Finset.sum_nonneg fun i _ ↦ sq_nonneg (a i))

theorem variationDensity_pos {n : ℕ} {a : Fin n → ℝ} (ha : a ≠ 0) :
    0 < variationDensity a := by
  apply Real.sqrt_pos.mpr
  obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by
    by_contra h
    apply ha
    ext i
    simpa using not_exists.mp h i
  exact (sq_pos_of_ne_zero hi).trans_le
    (Finset.single_le_sum (fun j _ ↦ sq_nonneg (a j)) (Finset.mem_univ i))

/-- Convexity of the Euclidean norm, with the zero subgradient chosen at zero. -/
theorem variationDensity_support {n : ℕ} (a b : Fin n → ℝ) :
    (∑ i, (b i - a i) * (a i / variationDensity a)) ≤
      variationDensity b - variationDensity a := by
  by_cases ha : a = 0
  · subst a
    simp [variationDensity]
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ a b
  change (∑ i, a i * b i) ≤ variationDensity a * variationDensity b at hcs
  have he : (∑ i, (b i - a i) * (a i / variationDensity a)) =
      ((∑ i, a i * b i) - ∑ i, a i ^ 2) / variationDensity a := by
    rw [← Finset.sum_sub_distrib, Finset.sum_div]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [he]
  apply (div_le_iff₀ (variationDensity_pos ha)).mpr
  nlinarith [variationDensity_sq a]

theorem variationDensity_add_support {n : ℕ} (a h : Fin n → ℝ) :
    (∑ i, h i * (a i / variationDensity a)) ≤
      variationDensity (a + h) - variationDensity a := by
  simpa only [Pi.add_apply, add_sub_cancel_left] using variationDensity_support a (a + h)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {n : ℕ}

def variationIncrement (g : E → Fin n → ℝ) (v : Fin n → E) (φ : E → ℝ) (x : E) : ℝ :=
  variationDensity (g x + fun i ↦ fderiv ℝ φ x (v i)) - variationDensity (g x)

omit [NormedSpace ℝ E] in
theorem variationDensity_continuous (g : E → Fin n → ℝ)
    (hg : ∀ i, Continuous (fun x ↦ g x i)) :
    Continuous (fun x ↦ variationDensity (g x)) := by
  apply Continuous.sqrt
  exact continuous_finsetSum _ fun i _ ↦ (hg i).pow 2

theorem variationIncrement_continuous (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hg : ∀ i, Continuous (fun x ↦ g x i))
    (hφ : ContDiff ℝ 1 φ) : Continuous (variationIncrement g v φ) := by
  apply Continuous.sub
  · apply variationDensity_continuous
    intro i
    exact (hg i).add ((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const)
  · exact variationDensity_continuous g hg

theorem variationIncrement_hasCompactSupport (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hcφ : HasCompactSupport φ) :
    HasCompactSupport (variationIncrement g v φ) := by
  apply HasCompactSupport.of_support_subset_isCompact hcφ
  intro x hx
  by_contra hnot
  have hd : fderiv ℝ φ x = 0 := fderiv_of_notMem_tsupport ℝ hnot
  have hz : variationIncrement g v φ x = 0 := by
    simp only [variationIncrement, hd, zero_apply]
    change variationDensity (g x + 0) - variationDensity (g x) = 0
    simp
  exact hx hz

variable [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [μ.IsAddHaarMeasure]

theorem variationIncrement_integrable (g : E → Fin n → ℝ) (v : Fin n → E)
    {φ : E → ℝ} (hg : ∀ i, Continuous (fun x ↦ g x i))
    (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    Integrable (variationIncrement g v φ) μ :=
  (variationIncrement_continuous g v hg hφ).integrable_of_hasCompactSupport
    (variationIncrement_hasCompactSupport g v hcφ)

theorem variation_minimizing_of_calibration
    (g : E → Fin n → ℝ) (v : Fin n → E)
    (hg : ∀ i, Continuous (fun x ↦ g x i))
    {φ : E → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ)
    (hflux : Integrable (fun x ↦ ∑ i, fderiv ℝ φ x (v i) *
      (g x i / variationDensity (g x))) μ)
    (hzero : (∫ x, ∑ i, fderiv ℝ φ x (v i) *
      (g x i / variationDensity (g x)) ∂μ) = 0) :
    0 ≤ ∫ x, variationIncrement g v φ x ∂μ := by
  have hle := integral_mono hflux (variationIncrement_integrable g v hg hφ hcφ)
    (fun x ↦ variationDensity_add_support (g x) (fun i ↦ fderiv ℝ φ x (v i)))
  rw [hzero] at hle
  exact hle

end
end Source29VariationConvexity

/- Component: TopVariationMinimizing.inc -/
namespace Source29TopVariationMinimizing

open MeasureTheory MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity

noncomputable section

/-- The leading homogeneous polynomial of an entire polynomial minimal graph
minimizes total variation against compactly supported C¹ perturbations.
The difference of the two densities is integrable although their separate
whole-space integrals need not be finite. -/
theorem top_minimizes_total_variation {n : ℕ}
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) :
    Integrable (variationIncrement (evaluatedGradient (homogeneousComponent P.totalDegree P))
      (fun i ↦ Pi.single i 1) φ) ∧
    0 ≤ ∫ x, variationIncrement (evaluatedGradient (homogeneousComponent P.totalDegree P))
      (fun i ↦ Pi.single i 1) φ x := by
  have hg : ∀ i, Continuous (fun x ↦
      evaluatedGradient (homogeneousComponent P.totalDegree P) x i) :=
    fun i ↦ (FluxPolynomial.contDiff_eval (pderiv i _)).continuous
  obtain ⟨hi, hz⟩ := Source29TopWeakCalibration.top_weak_calibration P hmin hdeg hφ hcφ
  exact ⟨variationIncrement_integrable _ _ hg hφ hcφ,
    variation_minimizing_of_calibration _ _ hg hφ hcφ hi hz⟩

end
end Source29TopVariationMinimizing

/- Component: LengthNullCoverings.inc -/
/- A direct covering formulation of one-dimensional Hausdorff nullity.
No Hausdorff-measure library import or geometric regularity theorem is assumed. -/
namespace Source29LengthNullCoverings

open Set MeasureTheory
open scoped ENNReal NNReal

noncomputable section

def HasZeroLengthCoverings {E : Type*} [PseudoMetricSpace E] (s : Set E) : Prop :=
  ∀ ε : ℝ≥0∞, 0 < ε → ∃ (c : ℕ → E) (r : ℕ → ℝ≥0),
    s ⊆ ⋃ j, Metric.ball (c j) (r j) ∧
    (∑' j, (2 : ℝ≥0∞) * r j) < ε

theorem HasZeroLengthCoverings.mono {E : Type*} [PseudoMetricSpace E]
    {s t : Set E} (ht : HasZeroLengthCoverings t) (hst : s ⊆ t) :
    HasZeroLengthCoverings s := by
  intro ε hε
  obtain ⟨c, r, hcover, hsum⟩ := ht ε hε
  exact ⟨c, r, hst.trans hcover, hsum⟩

/-- A distance-nonincreasing real-valued image of a length-null set has
Lebesgue measure zero. This statement also applies to nonmeasurable sets. -/
theorem image_volume_eq_zero {E : Type*} [PseudoMetricSpace E]
    {s : Set E} (hs : HasZeroLengthCoverings s)
    {f : E → ℝ} (hf : LipschitzWith 1 f) : volume (f '' s) = 0 := by
  by_contra hne
  obtain ⟨c, r, hcover, hsum⟩ := hs (volume (f '' s)) (pos_iff_ne_zero.mpr hne)
  have hcover' : f '' s ⊆ ⋃ j, Metric.ball (f (c j)) (r j) := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨j, hj⟩ := mem_iUnion.mp (hcover hx)
    refine mem_iUnion.mpr ⟨j, ?_⟩
    change dist (f x) (f (c j)) < (r j : ℝ)
    have hd := hf.dist_le_mul x (c j)
    simp only [NNReal.coe_one, one_mul] at hd
    exact hd.trans_lt hj
  have hvol : volume (f '' s) ≤ ∑' j, (2 : ℝ≥0∞) * r j := calc
    volume (f '' s) ≤ volume (⋃ j, Metric.ball (f (c j)) (r j)) := measure_mono hcover'
    _ ≤ ∑' j, volume (Metric.ball (f (c j)) (r j)) := measure_iUnion_le _
    _ = ∑' j, (2 : ℝ≥0∞) * r j := by
      apply tsum_congr
      intro j
      simp [Real.volume_ball, ENNReal.ofReal_mul]
  exact (not_lt_of_ge hvol) hsum

/-- A length-null set in a finite Cartesian space cannot contain an entire
line through a nonzero vector. A nonzero coordinate maps that line onto ℝ. -/
theorem no_nonzero_line {n : ℕ} {s : Set (Fin n → ℝ)}
    (hs : HasZeroLengthCoverings s) {x : Fin n → ℝ} (hx : x ≠ 0)
    (hline : ∀ a : ℝ, a • x ∈ s) : False := by
  obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := by
    by_contra h
    apply hx
    ext i
    simpa using not_exists.mp h i
  have hf : LipschitzWith 1 (fun y : Fin n → ℝ ↦ y i) := by
    apply LipschitzWith.of_dist_le_mul
    intro y z
    simpa only [NNReal.coe_one, one_mul] using dist_le_pi_dist y z i
  have hv := image_volume_eq_zero hs hf
  have himage : (fun y : Fin n → ℝ ↦ y i) '' s = univ := by
    apply eq_univ_of_forall
    intro a
    refine ⟨(a / x i) • x, hline _, ?_⟩
    change (a / x i) * x i = a
    exact div_mul_cancel₀ a hi
  rw [himage, Real.volume_univ] at hv
  exact ENNReal.top_ne_zero hv

end
end Source29LengthNullCoverings

/- Component: HomogeneousZeroCoverings.inc -/
namespace Source29HomogeneousZeroCoverings

open MvPolynomial Source29LengthNullCoverings

noncomputable section

/-- Nonnegativity becomes strict away from the origin when a homogeneous
polynomial's zero set admits arbitrarily short countable ball coverings. -/
theorem positive_away_of_zero_length_coverings {n d : ℕ}
    (Q : MvPolynomial (Fin n) ℝ) (hh : Q.IsHomogeneous d)
    (hnonneg : ∀ x, 0 ≤ eval x Q)
    (hsmall : HasZeroLengthCoverings {x : Fin n → ℝ | eval x Q = 0}) :
    ∀ x : Fin n → ℝ, x ≠ 0 → 0 < eval x Q := by
  intro x hx
  apply lt_of_le_of_ne (hnonneg x)
  intro hzero
  apply no_nonzero_line hsmall hx
  intro a
  change eval (a • x) Q = 0
  rw [Source29QuarticReuse.FluxObstruction.eval_dilate_homogeneous Q hh,
    hzero.symm, mul_zero]

theorem nonnegative_homogeneous_divisor_is_constant
    (F Q : MvPolynomial (Fin 8) ℝ) (d : ℕ)
    (hF : F ≠ 0) (hFhom : F.IsHomogeneous d)
    (hL : Source29FactorInheritance.cubicOperator F = 0)
    (hQhom : Q.IsHomogeneous Q.totalDegree) (hnonneg : ∀ x, 0 ≤ eval x Q)
    (hsmall : HasZeroLengthCoverings {x : Fin 8 → ℝ | eval x Q = 0})
    (hdiv : Q ∣ F) : Q.totalDegree = 0 := by
  exact Source29ComplexObstruction.positive_divisor_obstruction F Q d hF hFhom hL hQhom
    (positive_away_of_zero_length_coverings Q hQhom hnonneg hsmall) hdiv

end
end Source29HomogeneousZeroCoverings

/- Component: RealAnalyticMaximum.inc -/
namespace Source29RealAnalyticMaximum

open Filter
open scoped Topology

noncomputable section

lemma second_deriv_of_quadratic_factor (f g : ℝ → ℝ)
    (hg : AnalyticAt ℝ g 0)
    (hfg : f =ᶠ[𝓝 (0 : ℝ)] (fun t ↦ t^2 * g t)) :
    deriv (deriv f) 0 = 2 * g 0 := by
  let K : ℝ → ℝ := fun t ↦ 2*(t*g t) + t^2*deriv g t
  have hfirst : deriv f =ᶠ[𝓝 (0 : ℝ)] K := by
    filter_upwards [hfg.deriv, hg.eventually_analyticAt] with t ht hgt
    rw [ht]
    have hd := ((hasDerivAt_id t).pow 2).mul hgt.differentiableAt.hasDerivAt
    simpa [K, mul_assoc, Pi.mul_def, Pi.pow_def] using hd.deriv
  have hsecond : HasDerivAt K (2*g 0) 0 := by
    have h1 := ((hasDerivAt_id (0 : ℝ)).mul hg.differentiableAt.hasDerivAt).const_mul 2
    have h2 := ((hasDerivAt_id (0 : ℝ)).pow 2).mul hg.deriv.differentiableAt.hasDerivAt
    simpa [K, Pi.add_def, Pi.mul_def, Pi.pow_def] using h1.add h2
  rw [hfirst.deriv_eq]
  exact hsecond.deriv

theorem quadratic_factor_of_double_zero (f : ℝ → ℝ)
    (hf : AnalyticAt ℝ f 0) (hf0 : f 0 = 0) (hdf0 : deriv f 0 = 0) :
    ∃ g : ℝ → ℝ, AnalyticAt ℝ g 0 ∧
      f =ᶠ[𝓝 (0 : ℝ)] (fun t ↦ t^2 * g t) := by
  by_cases hz : f =ᶠ[𝓝 (0 : ℝ)] (fun _ ↦ 0)
  · exact ⟨fun _ ↦ 0, analyticAt_const, by simpa using hz⟩
  obtain ⟨d, g, hg, hg0, hfactor⟩ := hf.exists_eventuallyEq_pow_smul_nonzero_iff.mpr hz
  have hfactor' : f =ᶠ[𝓝 (0 : ℝ)] (fun t ↦ t^d * g t) := by
    change ∀ᶠ t in 𝓝 (0 : ℝ), f t = t^d * g t
    simpa only [sub_zero, smul_eq_mul] using hfactor
  have hd0 : d ≠ 0 := by
    intro hd
    have h := hfactor'.self_of_nhds
    change f 0 = (0 : ℝ)^d * g 0 at h
    rw [hd, pow_zero, one_mul, hf0] at h
    exact hg0 h.symm
  have hd1 : d ≠ 1 := by
    intro hd
    have heq : f =ᶠ[𝓝 (0 : ℝ)] (fun t ↦ t * g t) := by simpa only [hd, pow_one] using hfactor'
    have hderiv : deriv f 0 = g 0 := by
      rw [heq.deriv_eq]
      simpa only [Pi.mul_def, id_eq, zero_mul, one_mul, add_zero] using
        ((hasDerivAt_id (0 : ℝ)).mul hg.differentiableAt.hasDerivAt).deriv
    exact hg0 (hderiv.symm.trans hdf0)
  have hd : 2 ≤ d := by omega
  refine ⟨fun t ↦ t^(d-2)*g t, (analyticAt_id.pow _).mul hg, ?_⟩
  filter_upwards [hfactor'] with t ht
  rw [ht, ← mul_assoc, ← pow_add, Nat.add_sub_of_le hd]

/-- The second derivative of a real analytic function is nonpositive at a
local maximum. The proof uses its actual quadratic Taylor factor. -/
theorem second_deriv_nonpos (f : ℝ → ℝ) (hf : AnalyticAt ℝ f 0)
    (hmax : IsLocalMax f 0) : deriv (deriv f) 0 ≤ 0 := by
  let F : ℝ → ℝ := fun t ↦ f t - f 0
  have hF : AnalyticAt ℝ F 0 := hf.sub analyticAt_const
  have hF0 : F 0 = 0 := sub_self _
  have hFm : IsLocalMax F 0 := by
    change ∀ᶠ t in 𝓝 (0 : ℝ), F t ≤ F 0
    filter_upwards [hmax] with t ht
    simpa only [F, sub_self, sub_nonpos] using ht
  obtain ⟨g, hg, hfactor⟩ := quadratic_factor_of_double_zero F hF hF0 hFm.deriv_eq_zero
  have hle : ∀ᶠ t in 𝓝[>] (0 : ℝ), g t ≤ 0 := by
    filter_upwards [hfactor.filter_mono nhdsWithin_le_nhds,
      hFm.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht hm hp
    have htpos : 0 < t := hp
    rw [ht, hF0] at hm
    exact (mul_le_mul_iff_right₀ (sq_pos_of_pos htpos)).mp (by simpa using hm)
  have hg0 : g 0 ≤ 0 := le_of_tendsto
    (hg.continuousAt.tendsto.mono_left nhdsWithin_le_nhds) hle
  have hsecond := second_deriv_of_quadratic_factor F g hg hfactor
  have hdF : deriv F = deriv f := by
    funext t
    exact deriv_sub_const (f 0)
  rw [hdF] at hsecond
  linarith

theorem second_deriv_linear_combination (f g : ℝ → ℝ)
    (hf : AnalyticAt ℝ f 0) (hg : AnalyticAt ℝ g 0) (a b : ℝ) :
    deriv (deriv (fun t ↦ a * f t - b * g t)) 0 =
      a * deriv (deriv f) 0 - b * deriv (deriv g) 0 := by
  have hfirst : deriv (fun t ↦ a*f t-b*g t) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ a*deriv f t-b*deriv g t) := by
    filter_upwards [hf.eventually_analyticAt, hg.eventually_analyticAt] with t hft hgt
    exact ((hft.differentiableAt.hasDerivAt.const_mul a).sub
      (hgt.differentiableAt.hasDerivAt.const_mul b)).deriv
  rw [hfirst.deriv_eq]
  exact ((hf.deriv.differentiableAt.hasDerivAt.const_mul a).sub
    (hg.deriv.differentiableAt.hasDerivAt.const_mul b)).deriv

end
end Source29RealAnalyticMaximum

/- Component: LocalEigenvalueComparison.inc -/
/- The local analytic comparison behind the compact-link eigenvalue bound.
The geometric Simons and Jacobi identities are explicit hypotheses here;
they are derived later in RegularLinkSimons for the polynomial's regular link. -/
namespace Source29LocalEigenvalueComparison

open Filter
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- Compare a positive Jacobi profile with the curvature norm at a maximum
of their quotient. The curves represent orthonormal geodesic directions. -/
theorem eigenvalue_bound_at_ratio_maximum
    (h φ : ι → ℝ → ℝ) (h0 φ0 V m lam : ℝ)
    (hh : ∀ i, AnalyticAt ℝ (h i) 0) (hφ : ∀ i, AnalyticAt ℝ (φ i) 0)
    (hh0 : ∀ i, h i 0 = h0) (hφ0 : ∀ i, φ i 0 = φ0)
    (hpositive : 0 < h0) (φpositive : 0 < φ0)
    (hmax : ∀ i, IsLocalMax (fun t ↦ h i t / φ i t) 0)
    (hSimons : (m - V) * h0 ≤ ∑ i, deriv (deriv (h i)) 0)
    (hJacobi : (∑ i, deriv (deriv (φ i)) 0) + (V + lam) * φ0 = 0) :
    lam ≤ -m := by
  have hi : ∀ i, φ0 * deriv (deriv (h i)) 0 -
      h0 * deriv (deriv (φ i)) 0 ≤ 0 := by
    intro i
    let q : ℝ → ℝ := fun t ↦ φ0 * h i t - h0 * φ i t
    have hq : AnalyticAt ℝ q 0 :=
      (analyticAt_const.mul (hh i)).sub (analyticAt_const.mul (hφ i))
    have hq0 : q 0 = 0 := by simp [q, hh0, hφ0, mul_comm]
    have hqmax : IsLocalMax q 0 := by
      have hp : ∀ᶠ t in 𝓝 (0 : ℝ), 0 < φ i t :=
        (hφ i).continuousAt.eventually (eventually_gt_nhds (by simpa [hφ0] using φpositive))
      change ∀ᶠ t in 𝓝 (0 : ℝ), q t ≤ q 0
      filter_upwards [hmax i, hp] with t ht hpt
      rw [hh0, hφ0] at ht
      have hmul := (div_le_div_iff₀ hpt φpositive).mp ht
      rw [hq0]
      dsimp [q]
      nlinarith
    have hs := Source29RealAnalyticMaximum.second_deriv_nonpos q hq hqmax
    change deriv (deriv (fun t ↦ φ0 * h i t - h0 * φ i t)) 0 ≤ 0 at hs
    rw [Source29RealAnalyticMaximum.second_deriv_linear_combination
      (h i) (φ i) (hh i) (hφ i)] at hs
    exact hs
  have hsum : φ0 * (∑ i, deriv (deriv (h i)) 0) -
      h0 * (∑ i, deriv (deriv (φ i)) 0) ≤ 0 := by
    have hs := Finset.sum_nonpos (s := Finset.univ) (fun i _ ↦ hi i)
    simpa only [Finset.sum_sub_distrib, ← Finset.mul_sum] using hs
  have hweighted := mul_le_mul_of_nonneg_left hSimons φpositive.le
  have hidentity := congrArg (fun t : ℝ ↦ h0 * t) hJacobi
  have hproduct : (m + lam) * (h0 * φ0) ≤ 0 := by nlinarith
  have h : m + lam ≤ 0 := (mul_le_mul_iff_left₀ (mul_pos hpositive φpositive)).mp
    (by simpa using hproduct)
  linarith

/-- Compactness supplies the quotient maximum. This version uses actual
analytic test curves on the compact set, so no spectral existence theorem is
needed after the indicated geometric differential inequalities are proved. -/
theorem eigenvalue_bound_on_compact_set
    {E : Type*} [TopologicalSpace E] (s : Set E) (hs : IsCompact s)
    (h φ V : E → ℝ) (m lam : ℝ)
    (hc : ContinuousOn h s) (φc : ContinuousOn φ s)
    (φpos : ∀ x ∈ s, 0 < φ x) (hpos : ∃ x ∈ s, 0 < h x)
    (curve : E → ι → ℝ → E)
    (curve0 : ∀ x ∈ s, ∀ i, curve x i 0 = x)
    (curve_mem : ∀ x ∈ s, ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), curve x i t ∈ s)
    (ha : ∀ x ∈ s, 0 < h x → ∀ i, AnalyticAt ℝ (fun t ↦ h (curve x i t)) 0)
    (φa : ∀ x ∈ s, ∀ i, AnalyticAt ℝ (fun t ↦ φ (curve x i t)) 0)
    (hSimons : ∀ x ∈ s, 0 < h x → (m - V x) * h x ≤
      ∑ i, deriv (deriv (fun t ↦ h (curve x i t))) 0)
    (hJacobi : ∀ x ∈ s, (∑ i, deriv (deriv (fun t ↦ φ (curve x i t))) 0) +
      (V x + lam) * φ x = 0) : lam ≤ -m := by
  obtain ⟨b, hb, hpb⟩ := hpos
  have hrc : ContinuousOn (fun x ↦ h x / φ x) s :=
    hc.div φc (fun x hx ↦ (φpos x hx).ne')
  obtain ⟨a, hsa, hmax⟩ := hs.exists_isMaxOn ⟨b, hb⟩ hrc
  have hratio : 0 < h a / φ a := (div_pos hpb (φpos b hb)).trans_le (hmax hb)
  have hpa : 0 < h a := by
    have hh := (lt_div_iff₀ (φpos a hsa)).mp hratio
    simpa using hh
  apply eigenvalue_bound_at_ratio_maximum
    (fun i t ↦ h (curve a i t)) (fun i t ↦ φ (curve a i t))
    (h a) (φ a) (V a) m lam (ha a hsa hpa) (φa a hsa)
    (fun i ↦ congrArg h (curve0 a hsa i))
    (fun i ↦ congrArg φ (curve0 a hsa i)) hpa (φpos a hsa)
    _ (hSimons a hsa hpa) (hJacobi a hsa)
  intro i
  change ∀ᶠ t in 𝓝 (0 : ℝ),
    h (curve a i t) / φ (curve a i t) ≤ h (curve a i 0) / φ (curve a i 0)
  filter_upwards [curve_mem a hsa i] with t ht
  simpa only [curve0 a hsa i, Set.mem_setOf_eq] using hmax ht

/-- In dimension eight the comparison constant is six. Substituting the
homogeneity exponent gives the closed degree interval [3,4]. -/
theorem degree_interval_eight (D lam : ℝ)
    (hlam : lam = (D - 1)^2 - 5*(D - 1)) (hbound : lam ≤ -(6 : ℝ)) :
    3 ≤ D ∧ D ≤ 4 := by
  constructor
  · nlinarith [sq_nonneg (D - 3)]
  · nlinarith [sq_nonneg (D - 4)]

end
end Source29LocalEigenvalueComparison

/- Component: SimonsNormAlgebra.inc -/
/- Algebra converting the tensor Simons identity to the scalar inequality.
The tensor identity and the norm differentiation identities remain inputs. -/
namespace Source29SimonsNormAlgebra

open scoped BigOperators

noncomputable section

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- Cauchy--Schwarz bounds the derivative of a positive tensor norm. -/
theorem norm_derivative_sq_le (A B : κ → ℝ) (h dh : ℝ)
    (hh : 0 < h) (hnorm : h^2 = ∑ j, A j^2)
    (hfirst : h * dh = ∑ j, A j * B j) :
    dh^2 ≤ ∑ j, B j^2 := by
  have hc := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ A B
  rw [← hfirst, ← hnorm, mul_pow] at hc
  exact (mul_le_mul_iff_right₀ (sq_pos_of_pos hh)).mp hc

/-- Given the tensor Laplacian equation and differentiated norm identities,
the tensor norm satisfies the scalar Simons inequality at a positive point. -/
theorem scalar_simons_inequality
    (A : κ → ℝ) (dA ddA : ι → κ → ℝ) (dh ddh : ι → ℝ) (h m : ℝ)
    (hh : 0 < h) (hnorm : h^2 = ∑ j, A j^2)
    (hfirst : ∀ i, h * dh i = ∑ j, A j * dA i j)
    (hsecond : ∀ i, h * ddh i + (dh i)^2 =
      (∑ j, (dA i j)^2) + ∑ j, A j * ddA i j)
    (htensor : ∀ j, (∑ i, ddA i j) = (m - h^2) * A j) :
    (m - h^2) * h ≤ ∑ i, ddh i := by
  have hk : (∑ i, (dh i)^2) ≤ ∑ i, ∑ j, (dA i j)^2 := by
    apply Finset.sum_le_sum
    intro i _
    exact norm_derivative_sq_le A (dA i) h (dh i) hh hnorm (hfirst i)
  have hC : (∑ i, ∑ j, A j * ddA i j) = (m - h^2) * h^2 := by
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum, htensor]
    calc
      (∑ j, A j * ((m - h^2) * A j)) = (m - h^2) * ∑ j, A j^2 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = (m - h^2) * h^2 := by rw [← hnorm]
  have heq : h * (∑ i, ddh i) + (∑ i, (dh i)^2) =
      (∑ i, ∑ j, (dA i j)^2) + (m - h^2) * h^2 := by
    have hs := Finset.sum_congr (s₁ := Finset.univ) rfl (fun i _ ↦ hsecond i)
    simpa only [Finset.sum_add_distrib, ← Finset.mul_sum, hC] using hs
  apply (mul_le_mul_iff_right₀ hh).mp
  nlinarith

end
end Source29SimonsNormAlgebra

/- Component: AnalyticNormDerivatives.inc -/
namespace Source29AnalyticNormDerivatives

open Filter
open scoped Topology BigOperators

noncomputable section

theorem first_deriv_square (f : ℝ → ℝ) (hf : AnalyticAt ℝ f 0) :
    deriv (fun t ↦ (f t)^2) 0 = 2 * f 0 * deriv f 0 := by
  simpa [Pi.pow_def] using (hf.differentiableAt.hasDerivAt.pow 2).deriv

theorem second_deriv_square (f : ℝ → ℝ) (hf : AnalyticAt ℝ f 0) :
    deriv (deriv (fun t ↦ (f t)^2)) 0 =
      2 * (deriv f 0)^2 + 2 * f 0 * deriv (deriv f) 0 := by
  have hfirst : deriv (fun t ↦ (f t)^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ 2 * f t * deriv f t) := by
    filter_upwards [hf.eventually_analyticAt] with t ht
    simpa [Pi.pow_def] using (ht.differentiableAt.hasDerivAt.pow 2).deriv
  rw [hfirst.deriv_eq]
  have hd := ((hf.differentiableAt.hasDerivAt.const_mul 2).mul
    hf.deriv.differentiableAt.hasDerivAt).deriv
  convert hd using 1 <;> ring

variable {κ : Type*} [Fintype κ]

theorem first_deriv_sum (f : κ → ℝ → ℝ) (hf : ∀ j, AnalyticAt ℝ (f j) 0) :
    deriv (fun t ↦ ∑ j, f j t) 0 = ∑ j, deriv (f j) 0 := by
  exact (HasDerivAt.fun_sum (fun j _ ↦ (hf j).differentiableAt.hasDerivAt)).deriv

theorem second_deriv_sum (f : κ → ℝ → ℝ) (hf : ∀ j, AnalyticAt ℝ (f j) 0) :
    deriv (deriv (fun t ↦ ∑ j, f j t)) 0 = ∑ j, deriv (deriv (f j)) 0 := by
  have hnear : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ j, AnalyticAt ℝ (f j) t :=
    Filter.eventually_all.mpr (fun j ↦ (hf j).eventually_analyticAt)
  have hfirst : deriv (fun t ↦ ∑ j, f j t) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ ∑ j, deriv (f j) t) := by
    filter_upwards [hnear] with t ht
    exact (HasDerivAt.fun_sum (fun j _ ↦ (ht j).differentiableAt.hasDerivAt)).deriv
  rw [hfirst.deriv_eq]
  exact (HasDerivAt.fun_sum (fun j _ ↦ (hf j).deriv.differentiableAt.hasDerivAt)).deriv

/-- Differentiate an actual local squared-norm identity twice. -/
theorem norm_first_second (h : ℝ → ℝ) (A : κ → ℝ → ℝ)
    (hh : AnalyticAt ℝ h 0) (hA : ∀ j, AnalyticAt ℝ (A j) 0)
    (hnorm : (fun t ↦ (h t)^2) =ᶠ[𝓝 (0 : ℝ)] (fun t ↦ ∑ j, (A j t)^2)) :
    h 0 * deriv h 0 = (∑ j, A j 0 * deriv (A j) 0) ∧
    h 0 * deriv (deriv h) 0 + (deriv h 0)^2 =
      (∑ j, (deriv (A j) 0)^2) + ∑ j, A j 0 * deriv (deriv (A j)) 0 := by
  have hsq : ∀ j, AnalyticAt ℝ (fun t ↦ (A j t)^2) 0 := fun j ↦ (hA j).pow 2
  have hfirst := hnorm.deriv_eq
  rw [first_deriv_square h hh, first_deriv_sum _ hsq] at hfirst
  simp_rw [first_deriv_square _ (hA _)] at hfirst
  have hsecond := hnorm.deriv.deriv_eq
  rw [second_deriv_square h hh, second_deriv_sum _ hsq] at hsecond
  simp_rw [second_deriv_square _ (hA _)] at hsecond
  have hm : (∑ j, 2 * A j 0 * deriv (A j) 0) =
      2 * ∑ j, A j 0 * deriv (A j) 0 := by
    simp only [Finset.mul_sum, mul_assoc]
  have hm2 : (∑ j, (2 * (deriv (A j) 0)^2 +
      2 * A j 0 * deriv (deriv (A j)) 0)) =
      2 * (∑ j, (deriv (A j) 0)^2) +
      2 * ∑ j, A j 0 * deriv (deriv (A j)) 0 := by
    simp only [Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]
  rw [hm] at hfirst
  rw [hm2] at hsecond
  constructor <;> linarith

variable {ι : Type*} [Fintype ι]

/-- For analytic component curves, the scalar Simons inequality follows
from the tensor trace equation and the local norm identity. -/
theorem scalar_simons_of_analytic_components
    (A : ι → κ → ℝ → ℝ) (h : ι → ℝ → ℝ) (A0 : κ → ℝ) (h0 m : ℝ)
    (hh : ∀ i, AnalyticAt ℝ (h i) 0)
    (hA : ∀ i j, AnalyticAt ℝ (A i j) 0)
    (hh0 : ∀ i, h i 0 = h0) (hA0 : ∀ i j, A i j 0 = A0 j)
    (hpos : 0 < h0) (hzero : h0^2 = ∑ j, (A0 j)^2)
    (hnorm : ∀ i, (fun t ↦ (h i t)^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ ∑ j, (A i j t)^2))
    (htensor : ∀ j, (∑ i, deriv (deriv (A i j)) 0) = (m - h0^2) * A0 j) :
    (m - h0^2) * h0 ≤ ∑ i, deriv (deriv (h i)) 0 := by
  apply Source29SimonsNormAlgebra.scalar_simons_inequality A0
    (fun i j ↦ deriv (A i j) 0) (fun i j ↦ deriv (deriv (A i j)) 0)
    (fun i ↦ deriv (h i) 0) (fun i ↦ deriv (deriv (h i)) 0) h0 m hpos hzero
  · intro i
    simpa only [hh0, hA0] using (norm_first_second (h i) (A i) (hh i) (hA i) (hnorm i)).1
  · intro i
    simpa only [hh0, hA0] using (norm_first_second (h i) (A i) (hh i) (hA i) (hnorm i)).2
  · exact htensor

end
end Source29AnalyticNormDerivatives

/- Component: RealAnalyticSqrt.inc -/
/- The two local inverse lemmas are adapted to ℝ from
Mathlib/Analysis/Calculus/InverseFunctionTheorem/Analytic.lean.
Copyright (c) 2025 David Loeffler. Released under Apache 2.0.
The full license is included in the reused QuarticReuse component. -/
namespace Source29RealAnalyticSqrt

open Filter
open scoped Topology

noncomputable section

theorem local_inverse_analytic {f : ℝ → ℝ} {x : ℝ}
    (hf : AnalyticAt ℝ f x) (hf' : deriv f x ≠ 0) :
    AnalyticAt ℝ (hf.hasStrictDerivAt.localInverse _ _ _ hf') (f x) := by
  let i : ℝ ≃L[ℝ] ℝ := .unitsEquivAut ℝ (.mk0 _ hf')
  have hfd : HasStrictFDerivAt f i.toContinuousLinearMap x := hf.hasStrictDerivAt
  let R : OpenPartialHomeomorph ℝ ℝ := hfd.toOpenPartialHomeomorph _
  have hx : x ∈ R.source := HasStrictFDerivAt.mem_toOpenPartialHomeomorph_source _
  refine R.hasFPowerSeriesAt_symm hx hf.hasFPowerSeriesAt (i := i) ?_ |>.analyticAt
  ext
  simp [i]

theorem analytic_comp_iff {f g : ℝ → ℝ} {x : ℝ}
    (hf : AnalyticAt ℝ f x) (hf' : deriv f x ≠ 0) :
    AnalyticAt ℝ (g ∘ f) x ↔ AnalyticAt ℝ g (f x) := by
  refine ⟨fun hg ↦ ?_, (AnalyticAt.comp · hf)⟩
  let r := hf.hasStrictDerivAt.localInverse _ _ _ hf'
  have hra : AnalyticAt ℝ r (f x) := local_inverse_analytic hf hf'
  have hr : r (f x) = x := HasStrictFDerivAt.localInverse_apply_image ..
  rw [← hr] at hg
  exact (hg.comp hra).congr <| .fun_comp (HasStrictFDerivAt.eventually_right_inverse ..) g

/-- The positive real square root is real analytic on the positive axis. -/
theorem sqrt_analyticAt {a : ℝ} (ha : 0 < a) : AnalyticAt ℝ Real.sqrt a := by
  let b := Real.sqrt a
  have hb : 0 < b := Real.sqrt_pos.mpr ha
  have hb2 : b^2 = a := Real.sq_sqrt ha.le
  have hs : AnalyticAt ℝ (fun t : ℝ ↦ t^2) b := analyticAt_id.pow 2
  have hd : deriv (fun t : ℝ ↦ t^2) b ≠ 0 := by
    have he : deriv (fun t : ℝ ↦ t^2) b = 2*b := by
      simpa using ((hasDerivAt_id b).pow 2).deriv
    rw [he]
    positivity
  have heq : (id : ℝ → ℝ) =ᶠ[𝓝 b] (Real.sqrt ∘ fun t : ℝ ↦ t^2) := by
    filter_upwards [eventually_gt_nhds hb] with t ht
    exact (Real.sqrt_sq ht.le).symm
  have hc : AnalyticAt ℝ (Real.sqrt ∘ fun t : ℝ ↦ t^2) b := analyticAt_id.congr heq
  have hroot := (analytic_comp_iff hs hd).mp hc
  rwa [hb2] at hroot

theorem sqrt_comp_analyticAt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f : E → ℝ} {x : E} (hf : AnalyticAt ℝ f x) (hpos : 0 < f x) :
    AnalyticAt ℝ (fun y ↦ Real.sqrt (f y)) x :=
  (sqrt_analyticAt hpos).comp hf

end
end Source29RealAnalyticSqrt

/- Component: AnalyticTensorNorm.inc -/
namespace Source29AnalyticTensorNorm

open Filter
open scoped Topology BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ]

def tensorNorm (a : κ → ℝ) : ℝ := Real.sqrt (∑ j, (a j)^2)

theorem tensorNorm_sq (a : κ → ℝ) : (tensorNorm a)^2 = ∑ j, (a j)^2 :=
  Real.sq_sqrt (Finset.sum_nonneg fun j _ ↦ sq_nonneg (a j))

theorem tensorNorm_pos {a : κ → ℝ} (ha : a ≠ 0) : 0 < tensorNorm a := by
  apply Real.sqrt_pos.mpr
  obtain ⟨j, hj⟩ : ∃ j, a j ≠ 0 := by
    by_contra h
    apply ha
    ext j
    simpa using not_exists.mp h j
  exact (sq_pos_of_ne_zero hj).trans_le
    (Finset.single_le_sum (fun k _ ↦ sq_nonneg (a k)) (Finset.mem_univ j))

theorem tensorNorm_analyticAt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A : E → κ → ℝ) (x : E) (hA : ∀ j, AnalyticAt ℝ (fun y ↦ A y j) x)
    (hpos : A x ≠ 0) : AnalyticAt ℝ (fun y ↦ tensorNorm (A y)) x := by
  have hs : AnalyticAt ℝ (fun y ↦ ∑ j, (A y j)^2) x := by
    convert Finset.analyticAt_sum Finset.univ (fun j _ ↦ (hA j).pow 2) using 1
    ext y
    simp only [Finset.sum_apply, Pi.pow_apply]
  apply Source29RealAnalyticSqrt.sqrt_comp_analyticAt hs
  rw [← tensorNorm_sq]
  exact sq_pos_of_pos (tensorNorm_pos hpos)

variable {ι : Type*} [Fintype ι]

/-- The scalar curvature inequality for the actual tensor norm along
analytic component curves. Only the tensor trace equation is assumed. -/
theorem scalar_simons_for_tensor_norm
    (A : ι → κ → ℝ → ℝ) (A0 : κ → ℝ) (m : ℝ)
    (hA : ∀ i j, AnalyticAt ℝ (A i j) 0)
    (hA0 : ∀ i j, A i j 0 = A0 j) (hne : A0 ≠ 0)
    (htensor : ∀ j, (∑ i, deriv (deriv (A i j)) 0) =
      (m - (tensorNorm A0)^2) * A0 j) :
    (m - (tensorNorm A0)^2) * tensorNorm A0 ≤
      ∑ i, deriv (deriv (fun t ↦ tensorNorm (fun j ↦ A i j t))) 0 := by
  have hinit : ∀ i, (fun j ↦ A i j 0) = A0 := by
    intro i
    funext j
    exact hA0 i j
  apply Source29AnalyticNormDerivatives.scalar_simons_of_analytic_components
    A (fun i t ↦ tensorNorm (fun j ↦ A i j t)) A0 (tensorNorm A0) m
  · intro i
    apply tensorNorm_analyticAt (fun t j ↦ A i j t) 0 (hA i)
    simpa only [hinit] using hne
  · exact hA
  · intro i
    rw [hinit]
  · exact hA0
  · exact tensorNorm_pos hne
  · exact tensorNorm_sq A0
  · intro i
    exact Filter.Eventually.of_forall (fun t ↦ tensorNorm_sq (fun j ↦ A i j t))
  · exact htensor

end
end Source29AnalyticTensorNorm

/- Component: GaussSimonsAlgebra.inc -/
/- Contraction of the Gauss and Codazzi identities for a trace-free
second fundamental form. Realizing these arrays geometrically remains a
separate obligation. -/
namespace Source29GaussSimonsAlgebra

open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def delta (i j : ι) : ℝ := if i = j then 1 else 0

def gaussTensor (A : ι → ι → ℝ) (a b c d : ι) : ℝ :=
  delta a c * delta b d - delta a d * delta b c +
    A a c * A b d - A a d * A b c

def normSq (A : ι → ι → ℝ) : ℝ := ∑ k, ∑ l, (A k l)^2

theorem gauss_contraction (A : ι → ι → ℝ)
    (hA : ∀ i j, A i j = A j i) (htrace : (∑ k, A k k) = 0) (i j : ι) :
    (∑ k, ∑ l, (A l j * gaussTensor A l k i k +
      A k l * gaussTensor A l j i k)) =
      ((Fintype.card ι : ℝ) - normSq A) * A i j := by
  have hsphere : (∑ k, ∑ l, (A l j * (delta l i * delta k k - delta l k * delta k i) +
      A k l * (delta l i * delta j k - delta l k * delta j i))) =
      (Fintype.card ι : ℝ) * A i j := by
    simp only [delta, if_true, mul_one, mul_sub, Finset.sum_add_distrib,
      Finset.sum_sub_distrib, mul_ite, ite_mul, mul_zero,
      Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ]
    simp only [if_true, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    simp only [Finset.sum_ite_irrel, Finset.sum_ite_eq, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true, htrace, Finset.sum_const_zero, ite_self, sub_zero]
    rw [hA j i]
    ring
  have htraceTerm : (∑ k, ∑ l, A l j * (A l i * A k k)) = 0 := by
    have he : ∀ k l, A l j * (A l i * A k k) = A k k * (A l i * A l j) := by
      intro k l
      ring
    simp_rw [he, ← Finset.mul_sum]
    rw [← Finset.sum_mul, htrace, zero_mul]
  have hcross : (∑ k, ∑ l, A l j * (A l k * A k i)) =
      ∑ k, ∑ l, A k l * (A l i * A j k) := by
    conv_rhs => rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k _
    apply Finset.sum_congr rfl
    intro l _
    rw [hA j l]
    ring
  have hnormTerm : (∑ k, ∑ l, A k l * (A l k * A j i)) = normSq A * A i j := by
    have he : ∀ k l, A k l * (A l k * A j i) = (A k l)^2 * A i j := by
      intro k l
      rw [hA l k, hA j i]
      ring
    simp_rw [he]
    simp only [normSq, Finset.sum_mul]
  have hexpand : (∑ k, ∑ l, (A l j * gaussTensor A l k i k +
      A k l * gaussTensor A l j i k)) =
      (∑ k, ∑ l, (A l j * (delta l i * delta k k - delta l k * delta k i) +
        A k l * (delta l i * delta j k - delta l k * delta j i))) +
      (∑ k, ∑ l, A l j * (A l i * A k k)) -
      (∑ k, ∑ l, A l j * (A l k * A k i)) +
      (∑ k, ∑ l, A k l * (A l i * A j k)) -
      (∑ k, ∑ l, A k l * (A l k * A j i)) := by
    simp only [gaussTensor, mul_add, mul_sub, Finset.sum_add_distrib,
      Finset.sum_sub_distrib]
    ring
  rw [hexpand, hsphere, htraceTerm, hcross, hnormTerm]
  ring

/-- Tensor Simons identity obtained by commuting derivatives and contracting
the Gauss curvature formula. The index order is A_{ab;cd}. -/
theorem simons_of_gauss_codazzi (A : ι → ι → ℝ) (D : ι → ι → ι → ι → ℝ)
    (hA : ∀ i j, A i j = A j i) (htrace : (∑ k, A k k) = 0)
    (hSym : ∀ a b c d, D a b c d = D b a c d)
    (hCodazzi : ∀ a b c d, D a b c d = D c b a d)
    (hTraceD : ∀ c d, (∑ k, D k k c d) = 0)
    (hComm : ∀ a b c d, D a b c d - D a b d c =
      ∑ l, (A l b * gaussTensor A l a c d + A a l * gaussTensor A l b c d))
    (i j : ι) :
    (∑ k, D i j k k) = ((Fintype.card ι : ℝ) - normSq A) * A i j := by
  have he : ∀ k, D i j k k = D k k j i +
      ∑ l, (A l j * gaussTensor A l k i k + A k l * gaussTensor A l j i k) := by
    intro k
    have hc := hComm k j i k
    rw [← hCodazzi i j k k, hSym k j k i, hCodazzi j k k i] at hc
    linarith
  simp_rw [he]
  rw [Finset.sum_add_distrib, hTraceD, zero_add]
  exact gauss_contraction A hA htrace i j

end
end Source29GaussSimonsAlgebra

/- Component: AnalyticInverseNorm.inc -/
namespace Source29AnalyticInverseNorm

open Filter
open scoped Topology BigOperators

noncomputable section

theorem second_deriv_product (f g : ℝ → ℝ)
    (hf : AnalyticAt ℝ f 0) (hg : AnalyticAt ℝ g 0) :
    deriv (deriv (fun t ↦ f t * g t)) 0 =
      deriv (deriv f) 0 * g 0 + 2 * deriv f 0 * deriv g 0 +
        f 0 * deriv (deriv g) 0 := by
  have he : deriv (fun t ↦ f t * g t) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ deriv f t * g t + f t * deriv g t) := by
    filter_upwards [hf.eventually_analyticAt, hg.eventually_analyticAt] with t hft hgt
    exact (hft.differentiableAt.hasDerivAt.mul hgt.differentiableAt.hasDerivAt).deriv
  rw [he.deriv_eq]
  have hd := ((hf.deriv.differentiableAt.hasDerivAt.mul hg.differentiableAt.hasDerivAt).add
    (hf.differentiableAt.hasDerivAt.mul hg.deriv.differentiableAt.hasDerivAt)).deriv
  convert hd using 1 <;> ring

/-- The second derivative of the reciprocal of an actual analytic norm curve. -/
theorem second_deriv_inv (f : ℝ → ℝ) (hf : AnalyticAt ℝ f 0) (hne : f 0 ≠ 0) :
    deriv (deriv (fun t ↦ (f t)⁻¹)) 0 =
      (2 * (deriv f 0)^2 - f 0 * deriv (deriv f) 0) / (f 0)^3 := by
  let g : ℝ → ℝ := fun t ↦ (f t)⁻¹
  have hg : AnalyticAt ℝ g 0 := hf.inv hne
  have he : (fun t ↦ f t * g t) =ᶠ[𝓝 (0 : ℝ)] (fun _ ↦ (1 : ℝ)) := by
    filter_upwards [hf.continuousAt.eventually_ne hne] with t ht
    exact mul_inv_cancel₀ ht
  have hd : deriv g 0 = -deriv f 0 / (f 0)^2 := by
    exact (hf.differentiableAt.hasDerivAt.inv hne).deriv
  have hsecond := he.deriv.deriv_eq
  rw [second_deriv_product f g hf hg] at hsecond
  simp only [deriv_const', deriv_const] at hsecond
  rw [hd] at hsecond
  change deriv (deriv f) 0 * (f 0)⁻¹ +
    2 * deriv f 0 * (-deriv f 0 / (f 0)^2) + f 0 * deriv (deriv g) 0 = 0 at hsecond
  change deriv (deriv g) 0 = _
  field_simp [hne] at hsecond ⊢
  nlinarith

end
end Source29AnalyticInverseNorm

/- Component: PolynomialNormalTrace.inc -/
namespace Source29PolynomialNormalTrace

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- In coordinates with gradient along the distinguished normal, Lp=0
forces the tangential Hessian trace to vanish. -/
theorem tangential_trace_zero
    (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ) (g : ℝ)
    (hg : g ≠ 0) (hL : cubicOperator P = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ i, eval x (pderiv (some i) P) = 0) :
    (∑ i, eval x (pderiv (some i) (pderiv (some i) P))) = 0 := by
  have he := congrArg (eval x) hL
  simp [cubicOperator, Fintype.sum_option, hgn, hgt] at he
  have hh : g^2 * (∑ i, eval x (pderiv (some i) (pderiv (some i) P))) = 0 := by
    nlinarith [he]
  exact (mul_eq_zero.mp hh).resolve_left (pow_ne_zero _ hg)

/-- Differentiating the polynomial equation in the normal direction gives
the third-derivative trace used by the Jacobi profile. -/
theorem normal_derivative_trace
    (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ) (g : ℝ)
    (hg : g ≠ 0) (hL : cubicOperator P = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ i, eval x (pderiv (some i) P) = 0) :
    g * (∑ i, eval x (pderiv none (pderiv (some i) (pderiv (some i) P)))) =
      2 * (∑ i, (eval x (pderiv none (pderiv (some i) P)))^2) := by
  have htrace := tangential_trace_zero P x g hg hL hgn hgt
  have hsym : ∀ i, eval x (pderiv (some i) (pderiv none P)) =
      eval x (pderiv none (pderiv (some i) P)) := by
    intro i
    rw [second_partial_comm]
  have he := congrArg (eval x) (congrArg (pderiv none) hL)
  simp [cubicOperator, pderiv_mul, pderiv_pow, Fintype.sum_option,
    hgn, hgt, hsym, htrace] at he
  have hsquare : ∀ i, eval x (pderiv none (pderiv (some i) P)) *
      (g * eval x (pderiv none (pderiv (some i) P))) =
      g * (eval x (pderiv none (pderiv (some i) P)))^2 := by
    intro i
    ring
  simp_rw [hsquare, ← Finset.mul_sum] at he
  have hh : g * (g * (∑ i, eval x (pderiv none (pderiv (some i) (pderiv (some i) P)))) -
      2 * (∑ i, (eval x (pderiv none (pderiv (some i) P)))^2)) = 0 := by
    nlinarith [he]
  exact sub_eq_zero.mp ((mul_eq_zero.mp hh).resolve_left hg)

end
end Source29PolynomialNormalTrace

/- Component: HomogeneousRadialJets.inc -/
namespace Source29HomogeneousRadialJets

open MvPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29QuarticReuse.QuarticCompatibility
open scoped BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem radial_hessian (P : MvPolynomial κ ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 1 ≤ d) (x : κ → ℝ) (j : κ) :
    (∑ i, x i * eval x (pderiv i (pderiv j P))) =
      ((d : ℝ)-1) * eval x (pderiv j P) := by
  have he := evalFDeriv_self_of_isHomogeneous (pderiv j P) (d-1)
    (homogeneous_pderiv hP) x
  simpa only [evalFDeriv_apply, mul_comm, Nat.cast_sub hd, Nat.cast_one] using he

theorem radial_third_derivative (P : MvPolynomial κ ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (x : κ → ℝ) (j k : κ) :
    (∑ i, x i * eval x (pderiv i (pderiv j (pderiv k P)))) =
      ((d : ℝ)-2) * eval x (pderiv j (pderiv k P)) := by
  have he := evalFDeriv_self_of_isHomogeneous (pderiv j (pderiv k P)) ((d-1)-1)
    (homogeneous_pderiv (homogeneous_pderiv hP)) x
  have heq : d-1-1 = d-2 := by omega
  rw [heq] at he
  simpa only [evalFDeriv_apply, mul_comm, Nat.cast_sub hd, Nat.cast_ofNat] using he

/-- Euler's identities in a frame whose radial vector is a coordinate vector. -/
theorem radial_coordinate_jets (P : MvPolynomial κ ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (r n : κ) :
    eval (Pi.single r 1) (pderiv r (pderiv n P)) =
        ((d : ℝ)-1) * eval (Pi.single r 1) (pderiv n P) ∧
    eval (Pi.single r 1) (pderiv r (pderiv r (pderiv n P))) =
        ((d : ℝ)-2)*((d : ℝ)-1) * eval (Pi.single r 1) (pderiv n P) := by
  have h1 := radial_hessian P d hP (by omega) (Pi.single r 1) n
  have h2 := radial_third_derivative P d hP hd (Pi.single r 1) r n
  simp only [Pi.single_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true] at h1 h2
  exact ⟨h1, by rw [h1] at h2; simpa only [mul_assoc] using h2⟩

end
end Source29HomogeneousRadialJets

/- Component: JacobiProfileJets.inc -/
namespace Source29JacobiProfileJets

open Filter
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- The normal derivative of Lp=0 and the radial Euler identities yield
Jacobi's equation for the inverse gradient norm. Here the scalar norm
jets are supplied explicitly; the conclusion uses actual derivatives. -/
theorem jacobi_from_norm_jets
    (h : ι → ℝ → ℝ) (g D b : ℝ) (v q a T : ι → ℝ)
    (hg : 0 < g) (hh : ∀ i, AnalyticAt ℝ (h i) 0)
    (hh0 : ∀ i, h i 0 = g) (hh1 : ∀ i, deriv (h i) 0 = v i)
    (hh2 : ∀ i, g * deriv (deriv (h i)) 0 =
      q i + g*T i - (D-1)*g^2 - b*a i)
    (ha : (∑ i, a i) = 0)
    (hT : g * (∑ i, T i) = 2*(∑ i, (v i)^2) + D*(D-1)*g^2) :
    (∑ i, deriv (deriv (fun t ↦ (h i t)⁻¹)) 0) +
      ((∑ i, q i)/g^2 + (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹ = 0 := by
  have hne : g ≠ 0 := hg.ne'
  have hi : ∀ i, g^3 * deriv (deriv (fun t ↦ (h i t)⁻¹)) 0 =
      2*(v i)^2 - q i - g*T i + (D-1)*g^2 + b*a i := by
    intro i
    rw [Source29AnalyticInverseNorm.second_deriv_inv (h i) (hh i)
      (by simpa only [hh0] using hne), hh0, hh1]
    rw [mul_div_cancel₀ _ (pow_ne_zero 3 hne)]
    rw [hh2]
    ring
  have hs := congrArg (fun z : ι → ℝ ↦ ∑ i, z i) (funext hi)
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib,
    ← Finset.mul_sum, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ha, mul_zero,
    add_zero, hT] at hs
  apply (mul_eq_zero.mp (show g^3 * ((∑ i, deriv (deriv (fun t ↦ (h i t)⁻¹)) 0) +
      ((∑ i, q i)/g^2 + (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹) = 0 from ?_)).resolve_left
    (pow_ne_zero 3 hne)
  rw [mul_add, hs]
  field_simp
  ring

/-- A gradient written in a normal/radial/tangential frame determines the
required scalar norm jets without any assumed norm-derivative formula. -/
theorem jacobi_for_gradient_curves
    (G : ι → Option (Option ι) → ℝ → ℝ)
    (g D b : ℝ) (v T : ι → ℝ) (H : ι → ι → ℝ)
    (hg : 0 < g) (hG : ∀ i j, AnalyticAt ℝ (G i j) 0)
    (hG0n : ∀ i, G i none 0 = g)
    (hG0t : ∀ i j, G i (some j) 0 = 0)
    (hG1n : ∀ i, deriv (G i none) 0 = v i)
    (hG1r : ∀ i, deriv (G i (some none)) 0 = 0)
    (hG1t : ∀ i j, deriv (G i (some (some j))) 0 = H j i)
    (hG2n : ∀ i, deriv (deriv (G i none)) 0 =
      T i - (D-1)*g - b*H i i/g)
    (htrace : (∑ i, H i i) = 0)
    (hT : g * (∑ i, T i) = 2*(∑ i, (v i)^2) + D*(D-1)*g^2) :
    (∑ i, deriv (deriv (fun t ↦
      (Source29AnalyticTensorNorm.tensorNorm (fun j ↦ G i j t))⁻¹)) 0) +
      ((∑ i, ∑ j, (H j i)^2)/g^2 +
        (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹ = 0 := by
  let h : ι → ℝ → ℝ := fun i t ↦
    Source29AnalyticTensorNorm.tensorNorm (fun j ↦ G i j t)
  have hh0 : ∀ i, h i 0 = g := by
    intro i
    simp [h, Source29AnalyticTensorNorm.tensorNorm, Fintype.sum_option,
      hG0n, hG0t, Real.sqrt_sq hg.le]
  have hh : ∀ i, AnalyticAt ℝ (h i) 0 := by
    intro i
    apply Source29AnalyticTensorNorm.tensorNorm_analyticAt _ _ (hG i)
    intro he
    have hz := congrFun he none
    simp only [hG0n, Pi.zero_apply] at hz
    exact hg.ne' hz
  have hjets : ∀ i, g * deriv (h i) 0 = g*v i ∧
      g * deriv (deriv (h i)) 0 + (deriv (h i) 0)^2 =
        (v i)^2 + (∑ j, (H j i)^2) +
          g*(T i - (D-1)*g - b*H i i/g) := by
    intro i
    have he := Source29AnalyticNormDerivatives.norm_first_second
      (h i) (G i) (hh i) (hG i)
      (Filter.Eventually.of_forall (fun t ↦
        Source29AnalyticTensorNorm.tensorNorm_sq (fun j ↦ G i j t)))
    simpa only [hh0, Fintype.sum_option, hG0n, hG0t, hG1n, hG1r, hG1t,
      hG2n, zero_mul, Finset.sum_const_zero, add_zero, zero_add, zero_pow (by decide : 2 ≠ 0)] using he
  have hh1 : ∀ i, deriv (h i) 0 = v i := by
    intro i
    exact (mul_left_cancel₀ hg.ne') (hjets i).1
  have hh2 : ∀ i, g * deriv (deriv (h i)) 0 =
      (∑ j, (H j i)^2) + g*T i - (D-1)*g^2 - b*H i i := by
    intro i
    have he := (hjets i).2
    rw [hh1] at he
    have hdiv : g*(b*H i i/g) = b*H i i := mul_div_cancel₀ _ hg.ne'
    rw [mul_sub, mul_sub, hdiv] at he
    nlinarith [he]
  exact jacobi_from_norm_jets h g D b v (fun i ↦ ∑ j, (H j i)^2)
    (fun i ↦ H i i) T hg hh hh0 hh1 hh2 htrace hT

end
end Source29JacobiProfileJets

/- Component: RealPolynomialCurveJets.inc -/
namespace Source29RealPolynomialCurveJets

open Filter MvPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ]

theorem analytic_eval_curve (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ) (s : ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) s) :
    AnalyticAt ℝ (fun t ↦ eval (fun j ↦ γ j t) P) s := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa only [eval_C] using (analyticAt_const : AnalyticAt ℝ (fun _ : ℝ ↦ c) s)
  | add P Q hP hQ => simpa only [eval_add, Pi.add_def] using hP.add hQ
  | mul_X P j hP => simpa only [eval_mul, eval_X, Pi.mul_def] using hP.mul (hγ j)

theorem first_deriv_eval_curve (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ) (s : ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) s) :
    deriv (fun t ↦ eval (fun j ↦ γ j t) P) s =
      ∑ j, eval (fun k ↦ γ k s) (pderiv j P) * deriv (γ j) s := by
  have hdγ : HasDerivAt (fun t j ↦ γ j t) (fun j ↦ deriv (γ j) s) s :=
    hasDerivAt_pi.mpr (fun j ↦ (hγ j).differentiableAt.hasDerivAt)
  simpa only [Function.comp_def, evalFDeriv_apply] using
    ((hasFDerivAt_eval P (fun j ↦ γ j s)).comp_hasDerivAt s hdγ).deriv

/-- Chain rule to second order, stated in polynomial partial derivatives
and the actual first and second coordinate derivatives of the curve. -/
theorem second_deriv_eval_curve (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) :
    deriv (deriv (fun t ↦ eval (fun j ↦ γ j t) P)) 0 =
      (∑ j, ∑ k, eval (fun a ↦ γ a 0) (pderiv k (pderiv j P)) *
        deriv (γ k) 0 * deriv (γ j) 0) +
      ∑ j, eval (fun a ↦ γ a 0) (pderiv j P) * deriv (deriv (γ j)) 0 := by
  have he : deriv (fun t ↦ eval (fun j ↦ γ j t) P) =ᶠ[𝓝 (0 : ℝ)]
      (fun t ↦ ∑ j, eval (fun k ↦ γ k t) (pderiv j P) * deriv (γ j) t) := by
    have hn := Filter.eventually_all.mpr (fun j ↦ (hγ j).eventually_analyticAt)
    filter_upwards [hn] with t ht
    exact first_deriv_eval_curve P γ t ht
  rw [he.deriv_eq]
  have hd := (HasDerivAt.fun_sum (fun j (_ : j ∈ Finset.univ) ↦
    ((analytic_eval_curve (pderiv j P) γ 0 hγ).differentiableAt.hasDerivAt.mul
      (hγ j).deriv.differentiableAt.hasDerivAt))).deriv
  simp only [Pi.mul_apply] at hd
  rw [hd]
  simp only [first_deriv_eval_curve _ γ 0 hγ, Finset.sum_add_distrib, Finset.sum_mul]

end
end Source29RealPolynomialCurveJets

/- Component: PolynomialConeTrace.inc -/
namespace Source29PolynomialConeTrace

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- At a regular point of a homogeneous zero cone, the normal derivative
of its minimal-level-set equation has the link trace required by Jacobi. -/
theorem link_third_trace
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (g : ℝ) (hg : g ≠ 0)
    (hL : cubicOperator P = 0)
    (hgn : eval (Pi.single (some none) 1) (pderiv none P) = g)
    (hgt : ∀ i, eval (Pi.single (some none) 1) (pderiv (some i) P) = 0) :
    g * (∑ i, eval (Pi.single (some none) 1)
      (pderiv none (pderiv (some (some i)) (pderiv (some (some i)) P)))) =
      2 * (∑ i, (eval (Pi.single (some none) 1)
        (pderiv none (pderiv (some (some i)) P)))^2) +
      (d : ℝ)*((d : ℝ)-1)*g^2 := by
  have he := Source29PolynomialNormalTrace.normal_derivative_trace P
    (Pi.single (some none) 1) g hg hL hgn hgt
  have hj := Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
    (some none) none
  rw [hgn] at hj
  have hH : eval (Pi.single (some none) 1) (pderiv none (pderiv (some none) P)) =
      ((d : ℝ)-1)*g := by
    rw [second_partial_comm]
    exact hj.1
  have hT : eval (Pi.single (some none) 1)
      (pderiv none (pderiv (some none) (pderiv (some none) P))) =
        ((d : ℝ)-2)*((d : ℝ)-1)*g := by
    rw [second_partial_comm (pderiv (some none) P) none (some none)]
    rw [second_partial_comm P none (some none)]
    exact hj.2
  rw [Fintype.sum_option, Fintype.sum_option, hH, hT] at he
  nlinarith [he]

end
end Source29PolynomialConeTrace

/- Component: PolynomialCurveCoordinateJets.inc -/
namespace Source29PolynomialCurveCoordinateJets

open MvPolynomial Source29RealPolynomialCurveJets
open scoped BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem coordinate_velocity_first (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ)
    (x : κ → ℝ) (v : κ) (hγ : ∀ j, AnalyticAt ℝ (γ j) 0)
    (hγ0 : ∀ j, γ j 0 = x j)
    (hγ1 : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ ↦ ℝ) v (1 : ℝ) j) :
    deriv (fun t ↦ eval (fun j ↦ γ j t) P) 0 = eval x (pderiv v P) := by
  rw [first_deriv_eval_curve P γ 0 hγ]
  have h0 : (fun j ↦ γ j 0) = x := funext hγ0
  simp [h0, hγ1, Pi.single_apply]

theorem coordinate_velocity_second (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ)
    (x : κ → ℝ) (v : κ) (hγ : ∀ j, AnalyticAt ℝ (γ j) 0)
    (hγ0 : ∀ j, γ j 0 = x j)
    (hγ1 : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ ↦ ℝ) v (1 : ℝ) j) :
    deriv (deriv (fun t ↦ eval (fun j ↦ γ j t) P)) 0 =
      eval x (pderiv v (pderiv v P)) +
        ∑ j, eval x (pderiv j P) * deriv (deriv (γ j)) 0 := by
  rw [second_deriv_eval_curve P γ hγ]
  have h0 : (fun j ↦ γ j 0) = x := funext hγ0
  simp [h0, hγ1, Pi.single_apply]

end
end Source29PolynomialCurveCoordinateJets

/- Component: PolynomialLinkJacobi.inc -/
namespace Source29PolynomialLinkJacobi

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open Source29PolynomialCurveCoordinateJets
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Jacobi's equation for the actual inverse gradient norm along analytic
curves with the second-order jets of geodesics of the spherical link.
The existence of such curves on a regular link is a separate obligation. -/
theorem jacobi_of_link_curve_jets
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (g : ℝ) (hg : 0 < g)
    (hL : cubicOperator P = 0)
    (hgn : eval (Pi.single (M := fun _ ↦ ℝ) (some none) 1) (pderiv none P) = g)
    (hgt : ∀ j, eval (Pi.single (M := fun _ ↦ ℝ) (some none) 1) (pderiv (some j) P) = 0)
    (γ : ι → Option (Option ι) → ℝ → ℝ)
    (hγ : ∀ i j, AnalyticAt ℝ (γ i j) 0)
    (hγ0 : ∀ i j, γ i j 0 = Pi.single (M := fun _ ↦ ℝ) (some none) (1 : ℝ) j)
    (hγ1 : ∀ i j, deriv (γ i j) 0 = Pi.single (M := fun _ ↦ ℝ) (some (some i)) (1 : ℝ) j)
    (hγ2 : ∀ i j, deriv (deriv (γ i j)) 0 =
      -Pi.single (M := fun _ ↦ ℝ) (some none) (1 : ℝ) j -
      (eval (Pi.single (M := fun _ ↦ ℝ) (some none) 1)
        (pderiv (some (some i)) (pderiv (some (some i)) P)) / g) *
          Pi.single (M := fun _ ↦ ℝ) none (1 : ℝ) j) :
    (∑ i, deriv (deriv (fun t ↦
      (Source29AnalyticTensorNorm.tensorNorm
        (fun j ↦ eval (fun a ↦ γ i a t) (pderiv j P)))⁻¹)) 0) +
      ((∑ i, ∑ j, (eval (Pi.single (M := fun _ ↦ ℝ) (some none) 1)
        (pderiv (some (some j)) (pderiv (some (some i)) P)))^2)/g^2 +
        ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) * g⁻¹ = 0 := by
  let x : Option (Option ι) → ℝ := Pi.single (M := fun _ ↦ ℝ) (some none) 1
  let H : ι → ι → ℝ := fun j i ↦ eval x
    (pderiv (some (some j)) (pderiv (some (some i)) P))
  let G : ι → Option (Option ι) → ℝ → ℝ := fun i j t ↦
    eval (fun a ↦ γ i a t) (pderiv j P)
  let v : ι → ℝ := fun i ↦ eval x (pderiv none (pderiv (some (some i)) P))
  let T : ι → ℝ := fun i ↦ eval x
    (pderiv none (pderiv (some (some i)) (pderiv (some (some i)) P)))
  let b : ℝ := eval x (pderiv none (pderiv none P))
  have hx : ∀ i, (fun j ↦ γ i j 0) = x := fun i ↦ funext (hγ0 i)
  have hr := Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
    (some none) none
  rw [hgn] at hr
  have hrad : eval x (pderiv (some none) (pderiv none P)) = ((d : ℝ)-1)*g := hr.1
  have hradzero : ∀ j, eval x (pderiv (some none) (pderiv (some j) P)) = 0 := by
    intro j
    have he := Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
      (some none) (some j)
    rw [hgt] at he
    simpa only [mul_zero] using he.1
  have hfirst : ∀ i j, deriv (G i j) 0 =
      eval x (pderiv (some (some i)) (pderiv j P)) := by
    intro i j
    exact coordinate_velocity_first (pderiv j P) (γ i) x (some (some i))
      (hγ i) (hγ0 i) (hγ1 i)
  have hsecond : ∀ i, deriv (deriv (G i none)) 0 =
      T i - ((d : ℝ)-1)*g - b*H i i/g := by
    intro i
    rw [show G i none = (fun t ↦ eval (fun a ↦ γ i a t) (pderiv none P)) from rfl,
      coordinate_velocity_second (pderiv none P) (γ i) x (some (some i))
        (hγ i) (hγ0 i) (hγ1 i)]
    have ht : eval x (pderiv (some (some i)) (pderiv (some (some i)) (pderiv none P))) = T i := by
      dsimp [T]
      rw [second_partial_comm P (some (some i)) none,
        second_partial_comm (pderiv (some (some i)) P) (some (some i)) none]
    rw [ht]
    simp only [hγ2, mul_sub, mul_neg, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
      Pi.single_apply, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    rw [hrad]
    dsimp [b, H, x]
    ring
  have htrace : (∑ i, H i i) = 0 := by
    have he := Source29PolynomialNormalTrace.tangential_trace_zero P x g hg.ne' hL hgn hgt
    rw [Fintype.sum_option, hradzero none, zero_add] at he
    exact he
  apply Source29JacobiProfileJets.jacobi_for_gradient_curves G g (d : ℝ) b v T H hg
  · intro i j
    exact Source29RealPolynomialCurveJets.analytic_eval_curve (pderiv j P) (γ i) 0 (hγ i)
  · intro i
    change eval (fun a ↦ γ i a 0) (pderiv none P) = g
    rw [hx]
    exact hgn
  · intro i j
    change eval (fun a ↦ γ i a 0) (pderiv (some j) P) = 0
    rw [hx]
    exact hgt j
  · intro i
    rw [hfirst, second_partial_comm]
  · intro i
    rw [hfirst, second_partial_comm]
    exact hradzero (some i)
  · intro i j
    rw [hfirst, second_partial_comm]
  · exact hsecond
  · exact htrace
  · exact Source29PolynomialConeTrace.link_third_trace P d hP hd g hg.ne' hL hgn hgt

end
end Source29PolynomialLinkJacobi

/- Component: RealAnalyticInverse.inc -/
namespace Source29RealAnalyticInverse

open scoped Topology

noncomputable section

/-- The analytic inverse theorem, packaged as a local right inverse. -/
theorem exists_analytic_local_inverse
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (f : E → F) (a : E) (e : E ≃L[ℝ] F)
    (ha : AnalyticAt ℝ f a) (hd : HasStrictFDerivAt f (e : E →L[ℝ] F) a) :
    ∃ u : F → E, AnalyticAt ℝ u (f a) ∧ u (f a) = a ∧
      ∀ᶠ y in 𝓝 (f a), f (u y) = y := by
  let L := hd.toOpenPartialHomeomorph f
  have hL : (L : E → F) = f := hd.toOpenPartialHomeomorph_coe
  have hLa : a ∈ L.source := hd.mem_toOpenPartialHomeomorph_source
  refine ⟨L.symm, ?_, ?_, ?_⟩
  · have h := L.analyticAt_symm' (i := e) hLa
      (show AnalyticAt ℝ L a by simpa only [hL] using ha)
      (show fderiv ℝ L a = e by simpa only [hL] using hd.hasFDerivAt.fderiv)
    simpa only [hL] using h
  · simpa only [hL] using L.left_inv hLa
  · have ht := L.open_target.mem_nhds (L.map_source hLa)
    have hright : ∀ᶠ y in 𝓝 (L a), L (L.symm y) = y :=
      Filter.Eventually.mono ht (fun _ hy => L.right_inv hy)
    simpa only [hL] using hright


end
end Source29RealAnalyticInverse

/- Component: PolynomialLinkChart.inc -/
namespace Source29PolynomialLinkChart

open Filter MvPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

abbrev Ambient (ι : Type*) := Option (Option ι) → ℝ

def base : Ambient ι := Pi.single (some none) 1

def radialScale (g : ℝ) : Option (Option ι) → ℝ
  | none => g
  | some none => 2
  | some (some _) => 1

def diagonalEquiv {κ : Type*} [Fintype κ] (a : κ → ℝ) (ha : ∀ j, a j ≠ 0) :
    (κ → ℝ) ≃L[ℝ] (κ → ℝ) :=
  LinearEquiv.toContinuousLinearEquiv
    { toFun := fun x j => a j * x j
      invFun := fun y j => y j / a j
      left_inv := by intro x; ext j; exact mul_div_cancel_left₀ _ (ha j)
      right_inv := by intro y; ext j; exact mul_div_cancel₀ _ (ha j)
      map_add' := by intro x y; ext j; exact mul_add _ _ _
      map_smul' := by
        intro c x
        ext j
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        ring }

theorem diagonalEquiv_apply {κ : Type*} [Fintype κ] (a : κ → ℝ) (ha : ∀ j, a j ≠ 0)
    (x : κ → ℝ) (j : κ) : diagonalEquiv a ha x j = a j * x j := rfl

def constraintPolynomial (P : MvPolynomial (Option (Option ι)) ℝ) :
    Option (Option ι) → MvPolynomial (Option (Option ι)) ℝ
  | none => P
  | some none => spherePolynomial
  | some (some i) => X (some (some i))

def constraintMap (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι) : Ambient ι :=
  fun j => eval x (constraintPolynomial P j)

def parameterEmbed (y : ι → ℝ) : Ambient ι
  | none => 0
  | some none => 1
  | some (some i) => y i

theorem analyticAt_eval_real {κ : Type*} [Fintype κ]
    (P : MvPolynomial κ ℝ) (x : κ → ℝ) : AnalyticAt ℝ (fun y => eval y P) x := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa only [eval_C] using (analyticAt_const : AnalyticAt ℝ (fun _ : κ → ℝ => c) x)
  | add P Q hP hQ => simpa only [eval_add, Pi.add_def] using hP.add hQ
  | mul_X P j hP =>
    have hj : AnalyticAt ℝ (fun y : κ → ℝ => y j) x :=
      (ContinuousLinearMap.proj j : (κ → ℝ) →L[ℝ] ℝ).analyticAt x
    simpa only [eval_mul, eval_X, Pi.mul_def] using hP.mul hj

theorem constraintMap_base (P : MvPolynomial (Option (Option ι)) ℝ)
    (hP : eval base P = 0) : constraintMap P base = parameterEmbed 0 := by
  ext j
  cases j with
  | none => exact hP
  | some j =>
    cases j with
    | none => simp [constraintMap, constraintPolynomial, eval_spherePolynomial, base, parameterEmbed, Pi.single_apply]
    | some j => simp [constraintMap, constraintPolynomial, base, parameterEmbed, Pi.single_apply]

theorem analytic_parameterEmbed (y : ι → ℝ) : AnalyticAt ℝ parameterEmbed y := by
  apply AnalyticAt.pi
  intro j
  cases j with
  | none => exact analyticAt_const
  | some j =>
    cases j with
    | none => exact analyticAt_const
    | some j => exact (ContinuousLinearMap.proj j : (ι → ℝ) →L[ℝ] ℝ).analyticAt y

/-- An analytic chart of the regular polynomial link in a frame with
radial base vector and nonzero gradient along the distinguished normal. -/
theorem exists_link_chart
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : g ≠ 0)
    (hP : eval base P = 0) (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) :
    ∃ φ : (ι → ℝ) → Ambient ι, AnalyticAt ℝ φ 0 ∧ φ 0 = base ∧
      ∀ᶠ y in 𝓝 (0 : ι → ℝ), constraintMap P (φ y) = parameterEmbed y := by
  have hscale : ∀ j : Option (Option ι), radialScale g j ≠ 0 := by
    intro j
    cases j with
    | none => exact hg
    | some j => cases j <;> norm_num [radialScale]
  let e : Ambient ι ≃L[ℝ] Ambient ι := diagonalEquiv (radialScale g) hscale
  have ha : AnalyticAt ℝ (constraintMap P) base :=
    AnalyticAt.pi (fun j => analyticAt_eval_real (constraintPolynomial P j) base)
  have hd : HasStrictFDerivAt (constraintMap P) (e : Ambient ι →L[ℝ] Ambient ι) base := by
    apply hasStrictFDerivAt_pi'.mpr
    intro j
    change HasStrictFDerivAt (fun z => eval z (constraintPolynomial P j)) _ _
    have hj := hasStrictFDerivAt_eval (constraintPolynomial P j) base
    convert hj using 1
    ext v
    change e v j = evalFDeriv (constraintPolynomial P j) base v
    rw [diagonalEquiv_apply]
    cases j with
    | none =>
      simp [constraintPolynomial, evalFDeriv_apply, Fintype.sum_option, hgn, hgt, radialScale]
    | some j =>
      cases j with
      | none =>
        simp [constraintPolynomial, evalFDeriv_spherePolynomial, base, Pi.single_apply, radialScale]
      | some j => simp [constraintPolynomial, evalFDeriv_X, radialScale]
  obtain ⟨u, hu, hu0, hnear⟩ := Source29RealAnalyticInverse.exists_analytic_local_inverse
    (constraintMap P) base e ha hd
  have hbase := constraintMap_base P hP
  rw [hbase] at hu hu0 hnear
  refine ⟨fun y => u (parameterEmbed y), hu.comp (analytic_parameterEmbed 0), hu0, ?_⟩
  exact (analytic_parameterEmbed 0).continuousAt.tendsto.eventually hnear

end
end Source29PolynomialLinkChart

/- Component: PolynomialLinkCurves.inc -/
namespace Source29PolynomialLinkCurves

open Filter MvPolynomial Source29PolynomialLinkChart
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Actual analytic curves in the regular link with prescribed linear
tangential coordinates. Their normal and radial jets follow by differentiating
the two constraints. -/
theorem exists_link_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : g ≠ 0)
    (hP : eval base P = 0) (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) :
    ∃ γ : ι → Option (Option ι) → ℝ → ℝ,
      (∀ i j, AnalyticAt ℝ (γ i j) 0) ∧
      (∀ i j, γ i j 0 = base j) ∧
      (∀ i, (fun t => eval (fun j => γ i j t) P) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0)) ∧
      (∀ i, (fun t => ∑ j, (γ i j t)^2) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1)) ∧
      (∀ i j, γ i (some (some j)) =ᶠ[𝓝 (0 : ℝ)]
        (fun t => t * (Pi.single (M := fun _ => ℝ) i 1 j))) := by
  obtain ⟨φ, hφ, hφ0, hnear⟩ := exists_link_chart P g hg hP hgn hgt
  let line : ι → ℝ → (ι → ℝ) := fun i t => t • Pi.single i 1
  have hline0 : ∀ i, line i 0 = 0 := by intro i; simp [line]
  have hline : ∀ i, AnalyticAt ℝ (line i) 0 := by
    intro i
    exact analyticAt_id.smul analyticAt_const
  have hc : ∀ i, AnalyticAt ℝ (fun t => φ (line i t)) 0 := by
    intro i
    apply AnalyticAt.comp _ (hline i)
    simpa only [hline0] using hφ
  let γ : ι → Option (Option ι) → ℝ → ℝ := fun i j t => φ (line i t) j
  have hconstraints : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ),
      constraintMap P (φ (line i t)) = parameterEmbed (line i t) := by
    intro i
    have ht := (hline i).continuousAt.tendsto
    rw [hline0] at ht
    exact ht.eventually hnear
  refine ⟨γ, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j
    exact ((ContinuousLinearMap.proj j : Ambient ι →L[ℝ] ℝ).analyticAt _).comp (hc i)
  · intro i j
    dsimp [γ]
    rw [hline0, hφ0]
  · intro i
    filter_upwards [hconstraints i] with t ht
    exact congrFun ht none
  · intro i
    filter_upwards [hconstraints i] with t ht
    have he := congrFun ht (some none)
    simpa only [constraintMap, constraintPolynomial, eval_spherePolynomial,
      parameterEmbed] using he
  · intro i j
    filter_upwards [hconstraints i] with t ht
    have he := congrFun ht (some (some j))
    simpa only [constraintMap, constraintPolynomial, eval_X,
      parameterEmbed, line, Pi.smul_apply, smul_eq_mul] using he

end
end Source29PolynomialLinkCurves

/- Component: PolynomialLinkCurveJets.inc -/
namespace Source29PolynomialLinkCurveJets

open Filter MvPolynomial Source29PolynomialLinkChart
open Source29RealPolynomialCurveJets Source29PolynomialCurveCoordinateJets
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem linear_deriv (c t : ℝ) : deriv (fun s : ℝ => s*c) t = c := by
  simpa using ((hasDerivAt_id t).mul_const c).deriv

theorem linear_second_deriv (c : ℝ) : deriv (deriv (fun s : ℝ => s*c)) 0 = 0 := by
  have he : deriv (fun s : ℝ => s*c) = fun _ => c := funext (linear_deriv c)
  rw [he]
  exact deriv_const _ _

/-- Differentiating the actual two link constraints fixes the first and
second normal/radial derivatives of each coordinate curve. -/
theorem link_curve_jets
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : g ≠ 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (γ : Option (Option ι) → ℝ → ℝ) (i : ι)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (hγ0 : ∀ j, γ j 0 = base j)
    (hzero : (fun t => eval (fun j => γ j t) P) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0))
    (hsphere : (fun t => ∑ j, (γ j t)^2) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1))
    (htangent : ∀ j, γ (some (some j)) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => t * (Pi.single (M := fun _ => ℝ) i 1 j))) :
    (∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j) ∧
    (∀ j, deriv (deriv (γ j)) 0 =
      -Pi.single (M := fun _ => ℝ) (some none) 1 j -
      (eval base (pderiv (some (some i)) (pderiv (some (some i)) P))/g) *
        Pi.single (M := fun _ => ℝ) none 1 j) := by
  have h0 : (fun j => γ j 0) = base := funext hγ0
  have hn1 := hzero.deriv_eq
  rw [first_deriv_eval_curve P γ 0 hγ, deriv_const, h0] at hn1
  simp only [Fintype.sum_option, hgn, hgt, zero_mul, Finset.sum_const_zero, add_zero] at hn1
  have hn : deriv (γ none) 0 = 0 := (mul_eq_zero.mp hn1).resolve_left hg
  have hS : (fun t => eval (fun j => γ j t)
      (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ)) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1) := by
    simpa only [eval_spherePolynomial] using hsphere
  have hr1 := hS.deriv_eq
  rw [first_deriv_eval_curve spherePolynomial γ 0 hγ, deriv_const, h0,
    ← evalFDeriv_apply, evalFDeriv_spherePolynomial] at hr1
  simp only [base, Pi.single_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hr1
  have hr : deriv (γ (some none)) 0 = 0 := by linarith
  have ht1 : ∀ j, deriv (γ (some (some j))) 0 = Pi.single (M := fun _ => ℝ) i 1 j := by
    intro j
    rw [(htangent j).deriv_eq, linear_deriv]
  have hv : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j := by
    intro j
    cases j with
    | none => simp [hn, Pi.single_apply]
    | some j => cases j with
      | none => simp [hr, Pi.single_apply]
      | some j => simpa only [Pi.single_apply, Option.some.injEq] using ht1 j
  have hn2 := hzero.deriv.deriv_eq
  rw [coordinate_velocity_second P γ base (some (some i)) hγ hγ0 hv,
    deriv_const', deriv_const] at hn2
  simp only [Fintype.sum_option, hgn, hgt, zero_mul, Finset.sum_const_zero, add_zero] at hn2
  have hnsecond : deriv (deriv (γ none)) 0 =
      -eval base (pderiv (some (some i)) (pderiv (some (some i)) P))/g := by
    apply (eq_div_iff hg).mpr
    nlinarith [hn2]
  have hr2 := hS.deriv.deriv_eq
  rw [coordinate_velocity_second spherePolynomial γ base (some (some i)) hγ hγ0 hv,
    deriv_const', deriv_const] at hr2
  have hdiag : eval base (pderiv (some (some i)) (pderiv (some (some i))
      (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ))) = 2 := by
    simp [pderiv_spherePolynomial, pderiv_mul, base, Pi.single_apply]
  rw [hdiag, ← evalFDeriv_apply, evalFDeriv_spherePolynomial] at hr2
  simp only [base, Pi.single_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hr2
  have hrsecond : deriv (deriv (γ (some none))) 0 = -1 := by linarith
  have ht2 : ∀ j, deriv (deriv (γ (some (some j)))) 0 = 0 := by
    intro j
    rw [(htangent j).deriv.deriv_eq, linear_second_deriv]
  refine ⟨hv, ?_⟩
  intro j
  cases j with
  | none => simpa [Pi.single_apply, neg_div] using hnsecond
  | some j => cases j with
    | none => simpa [Pi.single_apply] using hrsecond
    | some j => simpa [Pi.single_apply] using ht2 j

end
end Source29PolynomialLinkCurveJets

/- Component: PolynomialJacobiCurves.inc -/
namespace Source29PolynomialJacobiCurves

open Filter MvPolynomial Source29PolynomialLinkChart
open Source29PolynomialLinkCurves Source29PolynomialLinkCurveJets
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def jacobiProfile (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι) : ℝ :=
  (Source29AnalyticTensorNorm.tensorNorm (fun j => eval x (pderiv j P)))⁻¹

theorem jacobiProfile_positive (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (hg : (fun j => eval x (pderiv j P)) ≠ 0) : 0 < jacobiProfile P x :=
  inv_pos.mpr (Source29AnalyticTensorNorm.tensorNorm_pos hg)

theorem jacobiProfile_analyticAt (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (hg : (fun j => eval x (pderiv j P)) ≠ 0) : AnalyticAt ℝ (jacobiProfile P) x := by
  have hn := Source29AnalyticTensorNorm.tensorNorm_analyticAt
    (fun y j => eval y (pderiv j P)) x (fun j => analyticAt_eval_real (pderiv j P) x) hg
  exact hn.inv (Source29AnalyticTensorNorm.tensorNorm_pos hg).ne'

theorem jacobiProfile_at_base (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) : jacobiProfile P base = g⁻¹ := by
  simp [jacobiProfile, Source29AnalyticTensorNorm.tensorNorm,
    Fintype.sum_option, hgn, hgt, Real.sqrt_sq hg.le]

/-- The Jacobi equation holds along actual analytic curves in the regular
spherical link of a homogeneous polynomial satisfying Lp=0. The curves and
their first/second jets are constructed, not assumed. This is in a normalized
frame with the radial vector and gradient in the two distinguished coordinates. -/
theorem exists_jacobi_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (g : ℝ) (hg : 0 < g)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hzero : eval base P = 0) (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) :
    ∃ γ : ι → Option (Option ι) → ℝ → ℝ,
      (∀ i j, AnalyticAt ℝ (γ i j) 0) ∧
      (∀ i j, γ i j 0 = base j) ∧
      (∀ i j, deriv (γ i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j) ∧
      (∀ i j, deriv (deriv (γ i j)) 0 =
        -Pi.single (M := fun _ => ℝ) (some none) 1 j -
        (eval base (pderiv (some (some i)) (pderiv (some (some i)) P))/g) *
          Pi.single (M := fun _ => ℝ) none 1 j) ∧
      (∀ i, ∀ᶠ t in 𝓝 (0 : ℝ),
        eval (fun j => γ i j t) P = 0 ∧ (∑ j, (γ i j t)^2) = 1) ∧
      (∀ i, AnalyticAt ℝ (fun t => jacobiProfile P (fun j => γ i j t)) 0) ∧
      ((∑ i, deriv (deriv (fun t => jacobiProfile P (fun j => γ i j t))) 0) +
        ((∑ i, ∑ j, (eval base
          (pderiv (some (some j)) (pderiv (some (some i)) P)))^2)/g^2 +
          ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) * jacobiProfile P base = 0) := by
  obtain ⟨γ, hγ, hγ0, hγzero, hγsphere, hγtangent⟩ :=
    exists_link_curves P g hg.ne' hzero hgn hgt
  have hjets : ∀ i,
      (∀ j, deriv (γ i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j) ∧
      (∀ j, deriv (deriv (γ i j)) 0 =
        -Pi.single (M := fun _ => ℝ) (some none) 1 j -
        (eval base (pderiv (some (some i)) (pderiv (some (some i)) P))/g) *
          Pi.single (M := fun _ => ℝ) none 1 j) := fun i =>
    link_curve_jets P g hg.ne' hgn hgt (γ i) i (hγ i) (hγ0 i)
      (hγzero i) (hγsphere i) (hγtangent i)
  have hgrad : (fun j => eval base (pderiv j P)) ≠ 0 := by
    intro he
    have hz := congrFun he none
    simp only [hgn, Pi.zero_apply] at hz
    exact hg.ne' hz
  refine ⟨γ, hγ, hγ0, (fun i => (hjets i).1), (fun i => (hjets i).2), ?_, ?_, ?_⟩
  · intro i
    filter_upwards [hγzero i, hγsphere i] with t ht hs
    exact ⟨ht, hs⟩
  · intro i
    have hp : AnalyticAt ℝ (jacobiProfile P) (fun j => γ i j 0) := by
      have he : (fun j => γ i j 0) = base := funext (hγ0 i)
      rw [he]
      exact jacobiProfile_analyticAt P base hgrad
    have hc := hp.comp (AnalyticAt.pi (hγ i))
    exact hc
  · rw [jacobiProfile_at_base P g hg hgn hgt]
    exact Source29PolynomialLinkJacobi.jacobi_of_link_curve_jets P d hP hd g hg hL hgn hgt
      γ hγ hγ0 (fun i => (hjets i).1) (fun i => (hjets i).2)

end
end Source29PolynomialJacobiCurves

/- Component: OrthogonalFrame.inc -/
namespace Source29OrthogonalFrame

open scoped BigOperators Matrix

noncomputable section

/-- Two successive reflections carry one orthogonal pair to another
with the same individual lengths. -/
theorem exists_isometry_of_orthogonal_pairs
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (u v x y : E) (hux : ‖u‖ = ‖x‖) (hvy : ‖v‖ = ‖y‖)
    (huv : inner ℝ u v = 0) (hxy : inner ℝ x y = 0) :
    ∃ T : E ≃ₗᵢ[ℝ] E, T u = x ∧ T v = y := by
  let R := (ℝ ∙ (u-x))ᗮ.reflection
  have hR : R u = x := Submodule.reflection_sub hux
  let S := (ℝ ∙ (R v-y))ᗮ.reflection
  have hS : S (R v) = y := Submodule.reflection_sub ((R.norm_map v).trans hvy)
  have hi : inner ℝ x (R v) = 0 := by
    rw [← hR, R.inner_map_map, huv]
  have hfix : S x = x := by
    apply Submodule.reflection_mem_subspace_eq_self
    rw [Submodule.mem_orthogonal_singleton_iff_inner_left, inner_sub_right, hi, hxy, sub_self]
  exact ⟨R.trans S, by simpa only [LinearIsometryEquiv.trans_apply, hR] using hfix, hS⟩

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def coordinateUnit (i : κ) : EuclideanSpace ℝ κ := WithLp.toLp 2 (Pi.single i 1)

theorem coordinateUnit_norm (i : κ) : ‖coordinateUnit i‖ = 1 := by
  have hs : ‖coordinateUnit i‖^2 = 1 := by
    simp [coordinateUnit, EuclideanSpace.norm_sq_eq, Pi.single_apply]
  nlinarith [norm_nonneg (coordinateUnit i)]

theorem coordinateUnit_inner (i j : κ) :
    inner ℝ (coordinateUnit i) (coordinateUnit j) = if i = j then 1 else 0 := by
  simp [coordinateUnit, PiLp.inner_apply, Pi.single_apply, eq_comm]

/-- An orthogonal matrix whose two chosen columns are an arbitrary
orthonormal pair. It supplies the radial/normal normalization of the link. -/
theorem exists_orthogonal_matrix_pair (r n : κ) (hrn : r ≠ n)
    (x y : EuclideanSpace ℝ κ) (hx : ‖x‖ = 1) (hy : ‖y‖ = 1)
    (hxy : inner ℝ x y = 0) :
    ∃ U : Matrix κ κ ℝ, U.transpose * U = 1 ∧ U * U.transpose = 1 ∧
      (∀ a, U a r = x a) ∧ (∀ a, U a n = y a) := by
  obtain ⟨T, hTr, hTn⟩ := exists_isometry_of_orthogonal_pairs
    (coordinateUnit r) (coordinateUnit n) x y
    ((coordinateUnit_norm r).trans hx.symm) ((coordinateUnit_norm n).trans hy.symm)
    (by simp [coordinateUnit_inner, hrn]) hxy
  let U : Matrix κ κ ℝ := fun a b => T (coordinateUnit b) a
  have hU : U.transpose * U = 1 := by
    ext i j
    have he := T.inner_map_map (coordinateUnit i) (coordinateUnit j)
    rw [coordinateUnit_inner] at he
    simpa only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial, mul_comm,
      Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  exact ⟨U, hU, mul_eq_one_comm.mp hU,
    fun a => congrArg (fun z : EuclideanSpace ℝ κ => z a) hTr,
    fun a => congrArg (fun z : EuclideanSpace ℝ κ => z a) hTn⟩

end
end Source29OrthogonalFrame

/- Component: PolynomialNormalFrame.inc -/
namespace Source29PolynomialNormalFrame

open MvPolynomial Source29PolynomialLinkChart
open Source29QuarticReuse.QuarticMinimal
open Source29QuarticReuse.QuarticPolynomialBasics (evalFDeriv_self_of_isHomogeneous evalFDeriv_apply)
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- At any regular point of the spherical zero set of a homogeneous
polynomial, an orthogonal change of variables puts its point and gradient
in the radial and normal coordinates used by the link chart. -/
theorem exists_normalized_polynomial
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hregular : (fun a => eval x (pderiv a P)) ≠ 0) :
    ∃ (g : ℝ) (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ),
      0 < g ∧ U.transpose * U = 1 ∧ U * U.transpose = 1 ∧ U *ᵥ base = x ∧
      (changeVariables U P).IsHomogeneous d ∧
      Source29FactorInheritance.cubicOperator (changeVariables U P) = 0 ∧
      eval base (changeVariables U P) = 0 ∧
      eval base (pderiv none (changeVariables U P)) = g ∧
      (∀ j, eval base (pderiv (some j) (changeVariables U P)) = 0) := by
  let X : EuclideanSpace ℝ (Option (Option ι)) := WithLp.toLp 2 x
  let G : EuclideanSpace ℝ (Option (Option ι)) :=
    WithLp.toLp 2 (fun a => eval x (pderiv a P))
  have hG : G ≠ 0 := by
    intro he
    apply hregular
    funext a
    exact congrArg (fun z : EuclideanSpace ℝ (Option (Option ι)) => z a) he
  let g : ℝ := ‖G‖
  have hg : 0 < g := norm_pos_iff.mpr hG
  have hX : ‖X‖ = 1 := by
    have he : ‖X‖^2 = 1 := by simpa only [X, EuclideanSpace.real_norm_sq_eq] using hx
    nlinarith [norm_nonneg X]
  have horth : inner ℝ X G = 0 := by
    have he := evalFDeriv_self_of_isHomogeneous P d hP x
    rw [hzero, mul_zero] at he
    simpa only [evalFDeriv_apply, X, G, PiLp.inner_apply, RCLike.inner_apply,
      conj_trivial, mul_comm] using he
  have hY : ‖g⁻¹ • G‖ = 1 := by
    rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hg]
    exact inv_mul_cancel₀ hg.ne'
  have hXY : inner ℝ X (g⁻¹ • G) = 0 := by simp [inner_smul_right, horth]
  obtain ⟨U, hUt, hU, hUr, hUn⟩ := Source29OrthogonalFrame.exists_orthogonal_matrix_pair
    (some none) none (by simp) X (g⁻¹ • G) hX hY hXY
  have hbase : U *ᵥ base = x := by
    funext a
    simpa [Matrix.mulVec, dotProduct, base, Pi.single_apply, X] using hUr a
  have hgrad : ∀ a, eval x (pderiv a P) = g * U a none := by
    intro a
    rw [hUn]
    change eval x (pderiv a P) = g * (g⁻¹ * eval x (pderiv a P))
    rw [← mul_assoc, mul_inv_cancel₀ hg.ne', one_mul]
  have hcol : ∀ j, (∑ a, U a none * U a j) = if none = j then 1 else 0 := by
    intro j
    have he := congrArg (fun M : Matrix (Option (Option ι)) (Option (Option ι)) ℝ => M none j) hUt
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  have hpartial : ∀ j, eval base (pderiv j (changeVariables U P)) =
      g * (if none = j then 1 else 0) := by
    intro j
    rw [pderiv_changeVariables, map_sum]
    simp only [map_mul, eval_C, eval_changeVariables, hbase]
    simp_rw [hgrad, mul_assoc]
    rw [← Finset.mul_sum, hcol]
  refine ⟨g, U, hg, hUt, hU, hbase, isHomogeneous_changeVariables U P d hP, ?_, ?_, ?_, ?_⟩
  · exact leadingOperator_changeVariables_eq_zero U hU P hL
  · rw [eval_changeVariables, hbase, hzero]
  · simpa using hpartial none
  · intro j
    simpa using hpartial (some j)

end
end Source29PolynomialNormalFrame

/- Component: PolynomialJacobiTransport.inc -/
namespace Source29PolynomialJacobiTransport

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialJacobiCurves
open Source29QuarticReuse.QuarticMinimal
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The squared gradient norm is unchanged by an orthogonal coordinate
change, evaluated at corresponding points. -/
theorem gradient_square_sum_changeVariables
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial (Option (Option ι)) ℝ) (z : Ambient ι) :
    (∑ j, (eval z (pderiv j (changeVariables U P)))^2) =
      ∑ j, (eval (U *ᵥ z) (pderiv j P))^2 := by
  have hgrad : (fun j => eval z (pderiv j (changeVariables U P))) =
      U.transpose *ᵥ (fun j => eval (U *ᵥ z) (pderiv j P)) := by
    funext j
    simp only [pderiv_changeVariables, map_sum, map_mul, eval_C, eval_changeVariables,
      Matrix.mulVec, dotProduct, Matrix.transpose_apply]
    apply Finset.sum_congr rfl
    intro a _
    ring
  have he := MatrixAlgebra.dot_transpose_mulVec U hU
    (fun j => eval (U *ᵥ z) (pderiv j P)) (fun j => eval (U *ᵥ z) (pderiv j P))
  rw [← hgrad] at he
  simpa only [dotProduct, ← pow_two] using he

theorem jacobiProfile_changeVariables
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial (Option (Option ι)) ℝ) (z : Ambient ι) :
    jacobiProfile (changeVariables U P) z = jacobiProfile P (U *ᵥ z) := by
  unfold jacobiProfile Source29AnalyticTensorNorm.tensorNorm
  rw [gradient_square_sum_changeVariables U hU]

theorem norm_square_mulVec
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hUt : U.transpose * U = 1) (z : Ambient ι) :
    (∑ j, (U *ᵥ z) j ^ 2) = ∑ j, (z j)^2 := by
  have he := MatrixAlgebra.dot_transpose_mulVec U.transpose
    (by simpa only [Matrix.transpose_transpose] using hUt) z z
  simpa only [Matrix.transpose_transpose, dotProduct, ← pow_two] using he

/-- Orthogonal transport preserves the real-analytic Jacobi profile along
any curves, including its actual second derivatives. -/
theorem jacobiProfile_curve_second
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial (Option (Option ι)) ℝ)
    (γ : ℝ → Ambient ι) :
    deriv (deriv (fun t => jacobiProfile (changeVariables U P) (γ t))) 0 =
      deriv (deriv (fun t => jacobiProfile P (U *ᵥ γ t))) 0 := by
  simp_rw [jacobiProfile_changeVariables U hU]

end
end Source29PolynomialJacobiTransport

/- Component: CompactPolynomialLink.inc -/
namespace Source29CompactPolynomialLink

open MvPolynomial
open scoped BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ]

theorem continuous_eval (P : MvPolynomial κ ℝ) : Continuous (fun x : κ → ℝ => eval x P) := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa only [eval_C] using (continuous_const : Continuous (fun _ : κ → ℝ => c))
  | add P Q hP hQ => simpa only [eval_add, Pi.add_def] using hP.add hQ
  | mul_X P j hP => simpa only [eval_mul, eval_X, Pi.mul_def] using hP.mul (continuous_apply j)

/-- The full spherical polynomial zero set is compact. Regularity is
not asserted here and must be proved separately where needed. -/
theorem isCompact_link (P : MvPolynomial κ ℝ) :
    IsCompact {x : κ → ℝ | eval x P = 0 ∧ (∑ j, (x j)^2) = 1} := by
  classical
  have hs : Continuous (fun x : κ → ℝ => ∑ j, (x j)^2) := by fun_prop
  have hc : IsClosed {x : κ → ℝ | eval x P = 0 ∧ (∑ j, (x j)^2) = 1} :=
    (isClosed_eq (continuous_eval P) continuous_const).inter (isClosed_eq hs continuous_const)
  apply (isCompact_Icc : IsCompact (Set.Icc (fun _ : κ => (-1 : ℝ)) (fun _ => (1 : ℝ)))).of_isClosed_subset hc
  intro x hx
  have hsq : ∀ j, (x j)^2 ≤ 1 := by
    intro j
    exact (Finset.single_le_sum (fun k _ => sq_nonneg (x k)) (Finset.mem_univ j)).trans_eq hx.2
  constructor <;> intro j
  · nlinarith [hsq j, sq_nonneg (x j + 1)]
  · nlinarith [hsq j, sq_nonneg (x j - 1)]

end
end Source29CompactPolynomialLink

/- Component: CurvaturePotentialAlgebra.inc -/
namespace Source29CurvaturePotentialAlgebra

open Source29QuarticReuse.QuarticMinimal
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def vectorSq (v : κ → ℝ) : ℝ := v ⬝ᵥ v

def matrixSq (H : Matrix κ κ ℝ) : ℝ := ∑ i, ∑ j, (H i j)^2

/-- Squared norm of the Hessian restricted to the gradient-orthogonal
hyperplane, divided by the squared gradient norm. Its interpretation
as curvature is established below at regular polynomial link points. -/
def potential (v : κ → ℝ) (H : Matrix κ κ ℝ) : ℝ :=
  matrixSq H / vectorSq v - 2 * vectorSq (H *ᵥ v) / (vectorSq v)^2 +
    (v ⬝ᵥ (H *ᵥ v))^2 / (vectorSq v)^3

theorem matrixSq_left (U H : Matrix κ κ ℝ) (hU : U * U.transpose = 1) :
    matrixSq (U.transpose * H) = matrixSq H := by
  unfold matrixSq
  rw [Finset.sum_comm, Finset.sum_comm (f := fun i j => (H i j)^2)]
  apply Finset.sum_congr rfl
  intro j _
  have he := MatrixAlgebra.dot_transpose_mulVec U hU (fun i => H i j) (fun i => H i j)
  simpa only [dotProduct, Matrix.mulVec, Matrix.mul_apply, pow_two] using he

theorem matrixSq_right (U H : Matrix κ κ ℝ) (hU : U * U.transpose = 1) :
    matrixSq (H * U) = matrixSq H := by
  unfold matrixSq
  apply Finset.sum_congr rfl
  intro i _
  have he := MatrixAlgebra.dot_transpose_mulVec U hU (H i) (H i)
  simpa only [dotProduct, Matrix.mulVec, Matrix.mul_apply, Matrix.transpose_apply,
    mul_comm, pow_two] using he

theorem matrixSq_conjugate (U H : Matrix κ κ ℝ) (hU : U * U.transpose = 1) :
    matrixSq (U.transpose * H * U) = matrixSq H := by
  rw [matrixSq_right U _ hU, matrixSq_left U H hU]

theorem potential_conjugate (U H : Matrix κ κ ℝ) (v : κ → ℝ)
    (hU : U * U.transpose = 1) :
    potential (U.transpose *ᵥ v) (U.transpose * H * U) = potential v H := by
  unfold potential vectorSq
  rw [matrixSq_conjugate U H hU,
    MatrixAlgebra.conjugate_mulVec U hU H v,
    MatrixAlgebra.dot_transpose_mulVec U hU v v,
    MatrixAlgebra.dot_transpose_mulVec U hU (H *ᵥ v) (H *ᵥ v),
    MatrixAlgebra.dot_transpose_mulVec U hU v (H *ᵥ v)]

end
end Source29CurvaturePotentialAlgebra

/- Component: CurvaturePotentialAxis.inc -/
namespace Source29CurvaturePotentialAxis

open Source29CurvaturePotentialAlgebra
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def axis (g : ℝ) : Option ι → ℝ
  | none => g
  | some _ => 0

/-- On a normal coordinate axis the invariant expression is exactly the
sum of squares of the tangential Hessian block divided by g². -/
theorem potential_axis (H : Matrix (Option ι) (Option ι) ℝ) (g : ℝ) (hg : g ≠ 0)
    (hH : ∀ i j, H i j = H j i) :
    potential (axis g) H = (∑ i, ∑ j, (H (some i) (some j))^2)/g^2 := by
  have hcol : ∀ i, H (some i) none = H none (some i) := fun i => hH _ _
  simp only [potential, vectorSq, matrixSq, dotProduct, Matrix.mulVec,
    Fintype.sum_option, axis, mul_zero, zero_mul, Finset.sum_const_zero, add_zero,
    hcol, Finset.sum_add_distrib]
  simp only [mul_pow, ← Finset.sum_mul]
  field_simp [hg]
  simp only [← Finset.mul_sum]
  ring

theorem potential_axis_link
    (H : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (g : ℝ) (hg : g ≠ 0)
    (hH : ∀ i j, H i j = H j i)
    (hrad : ∀ j, H (some none) (some j) = 0) :
    potential (axis g) H =
      (∑ i, ∑ j, (H (some (some i)) (some (some j)))^2)/g^2 := by
  rw [potential_axis H g hg hH]
  have hc : ∀ i, H (some i) (some none) = 0 := by
    intro i
    rw [hH, hrad]
  simp only [Fintype.sum_option, hrad, hc, zero_pow (by decide : 2 ≠ 0),
    Finset.sum_const_zero, zero_add]

end
end Source29CurvaturePotentialAxis

/- Component: PolynomialCurvaturePotential.inc -/
namespace Source29PolynomialCurvaturePotential

open MvPolynomial Source29CurvaturePotentialAlgebra
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def gradientAt (P : MvPolynomial κ ℝ) (x : κ → ℝ) : κ → ℝ := fun i => eval x (pderiv i P)

def curvaturePotential (P : MvPolynomial κ ℝ) (x : κ → ℝ) : ℝ :=
  potential (gradientAt P x) (realHessian P x)

def curvatureNorm (P : MvPolynomial κ ℝ) (x : κ → ℝ) : ℝ := Real.sqrt (curvaturePotential P x)

theorem gradientAt_changeVariables (U : Matrix κ κ ℝ) (P : MvPolynomial κ ℝ) (x : κ → ℝ) :
    gradientAt (changeVariables U P) x = U.transpose *ᵥ gradientAt P (U *ᵥ x) := by
  funext j
  simp only [gradientAt, pderiv_changeVariables, map_sum, map_mul, eval_C,
    eval_changeVariables, Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  apply Finset.sum_congr rfl
  intro a _
  ring

theorem curvaturePotential_changeVariables (U : Matrix κ κ ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial κ ℝ) (x : κ → ℝ) :
    curvaturePotential (changeVariables U P) x = curvaturePotential P (U *ᵥ x) := by
  unfold curvaturePotential
  rw [gradientAt_changeVariables, realHessian_changeVariables, potential_conjugate U _ _ hU]

theorem curvatureNorm_changeVariables (U : Matrix κ κ ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial κ ℝ) (x : κ → ℝ) :
    curvatureNorm (changeVariables U P) x = curvatureNorm P (U *ᵥ x) := by
  unfold curvatureNorm
  rw [curvaturePotential_changeVariables U hU]

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

open Source29PolynomialLinkChart Source29CurvaturePotentialAxis

theorem curvaturePotential_at_base
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (g : ℝ) (hg : g ≠ 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) :
    curvaturePotential P base =
      (∑ i, ∑ j, (eval base (pderiv (some (some j)) (pderiv (some (some i)) P)))^2)/g^2 := by
  have hgrad : gradientAt P base = axis g := by
    funext j
    cases j with
    | none => exact hgn
    | some j => exact hgt j
  have hs : ∀ i j, realHessian P base i j = realHessian P base j i := by
    intro i j
    simp only [realHessian_apply]
    rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
  have hr : ∀ j, realHessian P base (some none) (some j) = 0 := by
    intro j
    have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
      (some none) (some j)).1
    change realHessian P base (some none) (some j) = ((d : ℝ)-1)*eval base (pderiv (some j) P) at he
    rw [hgt, mul_zero] at he
    exact he
  unfold curvaturePotential
  rw [hgrad, potential_axis_link _ g hg hs hr]
  exact congrArg (fun a : ℝ => a/g^2)
    (Finset.sum_comm (f := fun i j : ι =>
      (realHessian P base (some (some i)) (some (some j)))^2))

end
end Source29PolynomialCurvaturePotential

/- Component: CurvaturePotentialAnalytic.inc -/
namespace Source29CurvaturePotentialAnalytic

open Source29CurvaturePotentialAlgebra
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem analytic_sum (f : κ → E → ℝ) (x : E) (hf : ∀ j, AnalyticAt ℝ (f j) x) :
    AnalyticAt ℝ (fun y => ∑ j, f j y) x := by
  convert Finset.analyticAt_sum Finset.univ (fun j _ => hf j) using 1
  ext y
  simp only [Finset.sum_apply]

theorem vectorSq_pos (v : κ → ℝ) (hv : v ≠ 0) : 0 < vectorSq v := by
  have he := sq_pos_of_pos (Source29AnalyticTensorNorm.tensorNorm_pos hv)
  rw [Source29AnalyticTensorNorm.tensorNorm_sq] at he
  simpa only [vectorSq, dotProduct, pow_two] using he

theorem vectorSq_analytic (v : E → κ → ℝ) (x : E)
    (hv : ∀ j, AnalyticAt ℝ (fun y => v y j) x) :
    AnalyticAt ℝ (fun y => vectorSq (v y)) x := by
  exact analytic_sum (fun j y => v y j * v y j) x (fun j => (hv j).mul (hv j))

theorem potential_analytic (v : E → κ → ℝ) (H : E → Matrix κ κ ℝ) (x : E)
    (hv : ∀ j, AnalyticAt ℝ (fun y => v y j) x)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x) (hne : v x ≠ 0) :
    AnalyticAt ℝ (fun y => potential (v y) (H y)) x := by
  have hs := vectorSq_analytic v x hv
  have hn : vectorSq (v x) ≠ 0 := (vectorSq_pos (v x) hne).ne'
  have hm : AnalyticAt ℝ (fun y => matrixSq (H y)) x := by
    apply analytic_sum (fun i y => ∑ j, (H y i j)^2) x
    intro i
    exact analytic_sum (fun j y => (H y i j)^2) x (fun j => (hH i j).pow 2)
  have hw : ∀ i, AnalyticAt ℝ (fun y => (H y *ᵥ v y) i) x := by
    intro i
    exact analytic_sum (fun j y => H y i j * v y j) x (fun j => (hH i j).mul (hv j))
  have ht := vectorSq_analytic (fun y => H y *ᵥ v y) x hw
  have hq : AnalyticAt ℝ (fun y => v y ⬝ᵥ (H y *ᵥ v y)) x :=
    analytic_sum (fun j y => v y j * (H y *ᵥ v y) j) x (fun j => (hv j).mul (hw j))
  exact ((hm.div hs hn).sub ((analyticAt_const.mul ht).div (hs.pow 2) (pow_ne_zero 2 hn))).add
    ((hq.pow 2).div (hs.pow 3) (pow_ne_zero 3 hn))

end
end Source29CurvaturePotentialAnalytic

/- Component: PolynomialCurvatureRegularity.inc -/
namespace Source29PolynomialCurvatureRegularity

open MvPolynomial Source29PolynomialCurvaturePotential Source29CurvaturePotentialAnalytic
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open Source29PolynomialLinkChart
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem curvaturePotential_analyticAt (P : MvPolynomial κ ℝ) (x : κ → ℝ)
    (hreg : gradientAt P x ≠ 0) : AnalyticAt ℝ (curvaturePotential P) x :=
  potential_analytic (gradientAt P) (realHessian P) x
    (fun j => analyticAt_eval_real (pderiv j P) x)
    (fun i j => analyticAt_eval_real (pderiv i (pderiv j P)) x) hreg

theorem curvatureNorm_continuousAt (P : MvPolynomial κ ℝ) (x : κ → ℝ)
    (hreg : gradientAt P x ≠ 0) : ContinuousAt (curvatureNorm P) x :=
  Real.continuous_sqrt.continuousAt.comp (curvaturePotential_analyticAt P x hreg).continuousAt

theorem curvatureNorm_analyticAt (P : MvPolynomial κ ℝ) (x : κ → ℝ)
    (hreg : gradientAt P x ≠ 0) (hpos : 0 < curvaturePotential P x) :
    AnalyticAt ℝ (curvatureNorm P) x :=
  Source29RealAnalyticSqrt.sqrt_comp_analyticAt (curvaturePotential_analyticAt P x hreg) hpos

theorem curvatureNorm_continuousOn (P : MvPolynomial κ ℝ) (s : Set (κ → ℝ))
    (hreg : ∀ x ∈ s, gradientAt P x ≠ 0) : ContinuousOn (curvatureNorm P) s :=
  fun x hx => (curvatureNorm_continuousAt P x (hreg x hx)).continuousWithinAt

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem curvaturePotential_nonneg_on_link
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) : 0 ≤ curvaturePotential P x := by
  obtain ⟨g, U, hg, hUt, hU, hbase, hQ, hLQ, hQzero, hgn, hgt⟩ :=
    Source29PolynomialNormalFrame.exists_normalized_polynomial P d hP hL x hx hzero hreg
  have he := curvaturePotential_changeVariables U hU P base
  rw [hbase, curvaturePotential_at_base _ d hQ hd g hg.ne' hgn hgt] at he
  rw [← he]
  exact div_nonneg (Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => sq_nonneg _)))
    (sq_nonneg g)

theorem curvatureNorm_sq_on_link
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) : (curvatureNorm P x)^2 = curvaturePotential P x :=
  Real.sq_sqrt (curvaturePotential_nonneg_on_link P d hP hd hL x hx hzero hreg)

end
end Source29PolynomialCurvatureRegularity

/- Component: LinearCurveTransport.inc -/
namespace Source29LinearCurveTransport

open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem analytic_mulVec (U : Matrix κ κ ℝ) (γ : κ → ℝ → ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) :
    AnalyticAt ℝ (fun t => U *ᵥ (fun j => γ j t)) 0 := by
  apply AnalyticAt.pi
  intro a
  exact Source29CurvaturePotentialAnalytic.analytic_sum
    (fun j t => U a j * γ j t) 0 (fun j => analyticAt_const.mul (hγ j))

theorem first_mulVec (U : Matrix κ κ ℝ) (γ : κ → ℝ → ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (a : κ) :
    deriv (fun t => (U *ᵥ (fun j => γ j t)) a) 0 = ∑ j, U a j * deriv (γ j) 0 := by
  change deriv (fun t => ∑ j, U a j * γ j t) 0 = _
  rw [Source29AnalyticNormDerivatives.first_deriv_sum (fun j t => U a j * γ j t)
    (fun j => analyticAt_const.mul (hγ j))]
  apply Finset.sum_congr rfl
  intro j _
  exact ((hγ j).differentiableAt.hasDerivAt.const_mul (U a j)).deriv

theorem second_mulVec (U : Matrix κ κ ℝ) (γ : κ → ℝ → ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (a : κ) :
    deriv (deriv (fun t => (U *ᵥ (fun j => γ j t)) a)) 0 =
      ∑ j, U a j * deriv (deriv (γ j)) 0 := by
  change deriv (deriv (fun t => ∑ j, U a j * γ j t)) 0 = _
  rw [Source29AnalyticNormDerivatives.second_deriv_sum (fun j t => U a j * γ j t)
    (fun j => analyticAt_const.mul (hγ j))]
  apply Finset.sum_congr rfl
  intro j _
  have he := Source29RealAnalyticMaximum.second_deriv_linear_combination
    (γ j) (fun _ => 0) (hγ j) analyticAt_const (U a j) 0
  simpa only [zero_mul, sub_zero] using he

end
end Source29LinearCurveTransport

/- Component: RegularLinkJacobi.inc -/
namespace Source29RegularLinkJacobi

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialJacobiCurves
open Source29PolynomialCurvaturePotential Source29PolynomialJacobiTransport
open Source29QuarticReuse.QuarticMinimal
open scoped Topology BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The Jacobi equation on the original polynomial link, with a coordinate
invariant potential and actual analytic curves. The returned first and
second jets are the orthonormal link jets needed by the Simons comparison. -/
theorem exists_regular_link_jacobi_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) :
    ∃ (g : ℝ) (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
      (C : ι → ℝ → Ambient ι),
      0 < g ∧ U.transpose * U = 1 ∧ U * U.transpose = 1 ∧ U *ᵥ base = x ∧
      eval base (pderiv none (changeVariables U P)) = g ∧
      (∀ j, eval base (pderiv (some j) (changeVariables U P)) = 0) ∧
      (∀ i, AnalyticAt ℝ (C i) 0) ∧ (∀ i, C i 0 = x) ∧
      (∀ i a, deriv (fun t => C i t a) 0 = U a (some (some i))) ∧
      (∀ i a, deriv (deriv (fun t => C i t a)) 0 = -x a -
        (eval base (pderiv (some (some i)) (pderiv (some (some i)) (changeVariables U P)))/g) * U a none) ∧
      (∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1) ∧
      (∀ i, AnalyticAt ℝ (fun t => jacobiProfile P (C i t)) 0) ∧
      ((∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
        (curvaturePotential P x + ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) * jacobiProfile P x = 0) := by
  obtain ⟨g, U, hg, hUt, hU, hbase, hQ, hLQ, hQzero, hgn, hgt⟩ :=
    Source29PolynomialNormalFrame.exists_normalized_polynomial P d hP hL x hx hzero hreg
  obtain ⟨γ, hγ, hγ0, hγ1, hγ2, hγmem, hγa, hJ⟩ :=
    exists_jacobi_curves (changeVariables U P) d hQ hd g hg hLQ hQzero hgn hgt
  let C : ι → ℝ → Ambient ι := fun i t => U *ᵥ (fun a => γ i a t)
  have hC : ∀ i, AnalyticAt ℝ (C i) 0 :=
    fun i => Source29LinearCurveTransport.analytic_mulVec U (γ i) (hγ i)
  have hC0 : ∀ i, C i 0 = x := by
    intro i
    have he : (fun a => γ i a 0) = base := funext (hγ0 i)
    change U *ᵥ (fun a => γ i a 0) = x
    rw [he, hbase]
  have hrad : ∀ a, U a (some none) = x a := by
    intro a
    have he := congrFun hbase a
    simpa [Matrix.mulVec, dotProduct, base, Pi.single_apply] using he
  refine ⟨g, U, C, hg, hUt, hU, hbase, hgn, hgt, hC, hC0, ?_, ?_, ?_, ?_, ?_⟩
  · intro i a
    change deriv (fun t => (U *ᵥ (fun b => γ i b t)) a) 0 = _
    rw [Source29LinearCurveTransport.first_mulVec U (γ i) (hγ i) a]
    simp [hγ1, Pi.single_apply]
  · intro i a
    change deriv (deriv (fun t => (U *ᵥ (fun b => γ i b t)) a)) 0 = _
    rw [Source29LinearCurveTransport.second_mulVec U (γ i) (hγ i) a]
    simp only [hγ2, mul_sub, mul_neg, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
      Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true]
    rw [hrad]
    ring
  · intro i
    filter_upwards [hγmem i] with t ht
    constructor
    · change eval (U *ᵥ (fun a => γ i a t)) P = 0
      rw [← eval_changeVariables]
      exact ht.1
    · change (∑ a, (U *ᵥ (fun b => γ i b t)) a ^ 2) = 1
      rw [norm_square_mulVec U hUt]
      exact ht.2
  · intro i
    have hp : AnalyticAt ℝ (jacobiProfile P) (C i 0) := by
      rw [hC0]
      exact jacobiProfile_analyticAt P x hreg
    have he := hp.comp (hC i)
    exact he
  · rw [← curvaturePotential_at_base (changeVariables U P) d hQ hd g hg.ne' hgn hgt,
      curvaturePotential_changeVariables U hU P base, hbase] at hJ
    simp_rw [jacobiProfile_changeVariables U hU] at hJ
    simpa only [hbase] using hJ

end
end Source29RegularLinkJacobi

/- Component: PolynomialTangentialDerivative.inc -/
namespace Source29PolynomialTangentialDerivative

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- The derivative of the tangential Hessian trace in any ambient direction,
obtained by differentiating the polynomial equation at a normalized point. -/
theorem derivative_trace
    (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ) (g : ℝ)
    (hg : g ≠ 0) (hL : cubicOperator P = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ i, eval x (pderiv (some i) P) = 0) (a : Option ι) :
    g * (∑ i, eval x (pderiv a (pderiv (some i) (pderiv (some i) P)))) =
      2 * (∑ i, eval x (pderiv a (pderiv (some i) P)) *
        eval x (pderiv none (pderiv (some i) P))) := by
  have htrace := Source29PolynomialNormalTrace.tangential_trace_zero P x g hg hL hgn hgt
  have hsym : ∀ i, eval x (pderiv (some i) (pderiv none P)) =
      eval x (pderiv none (pderiv (some i) P)) := by
    intro i
    rw [second_partial_comm]
  have he := congrArg (eval x) (congrArg (pderiv a) hL)
  simp [cubicOperator, pderiv_mul, pderiv_pow, Fintype.sum_option,
    hgn, hgt, hsym, htrace] at he
  have heq : ∀ i, eval x (pderiv none (pderiv (some i) P)) *
      (g * eval x (pderiv a (pderiv (some i) P))) =
      g * (eval x (pderiv a (pderiv (some i) P)) *
        eval x (pderiv none (pderiv (some i) P))) := by
    intro i
    ring
  simp_rw [heq, ← Finset.mul_sum] at he
  have hh : g * (g * (∑ i, eval x (pderiv a (pderiv (some i) (pderiv (some i) P)))) -
      2 * (∑ i, eval x (pderiv a (pderiv (some i) P)) *
        eval x (pderiv none (pderiv (some i) P)))) = 0 := by
    nlinarith [he]
  exact sub_eq_zero.mp ((mul_eq_zero.mp hh).resolve_left hg)

def hessian (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (a b : Option ι) : ℝ := eval x (pderiv a (pderiv b P))

def third (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (a b c : Option ι) : ℝ := eval x (pderiv a (pderiv b (pderiv c P)))

theorem hessian_symm (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (a b : Option ι) : hessian P x a b = hessian P x b a := by
  unfold hessian
  rw [second_partial_comm]

theorem third_swap12 (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (a b c : Option ι) : third P x a b c = third P x b a c := by
  unfold third
  rw [second_partial_comm (pderiv c P) a b]

theorem third_swap23 (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (a b c : Option ι) : third P x a b c = third P x a c b := by
  unfold third
  rw [second_partial_comm P b c]

/-- The polynomial expression for the first covariant derivative of the
normalized tangential Hessian. Its geometric realization is separate. -/
def firstCovariant (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (g : ℝ) (a b c : ι) : ℝ :=
  third P x (some a) (some b) (some c) / g -
    (hessian P x none (some a) * hessian P x (some b) (some c) +
      hessian P x none (some b) * hessian P x (some a) (some c) +
      hessian P x none (some c) * hessian P x (some a) (some b)) / g^2

theorem firstCovariant_swap12 (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (g : ℝ) (a b c : ι) : firstCovariant P x g a b c = firstCovariant P x g b a c := by
  unfold firstCovariant
  rw [third_swap12 P x (some a) (some b), hessian_symm P x (some b) (some a)]
  ring

theorem firstCovariant_swap23 (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ)
    (g : ℝ) (a b c : ι) : firstCovariant P x g a b c = firstCovariant P x g a c b := by
  unfold firstCovariant
  rw [third_swap23 P x (some a) (some b), hessian_symm P x (some c) (some b)]
  ring

/-- Differentiated minimality makes this symmetric third-order tensor
trace-free. This follows directly from Lp=0, not from a geometric hypothesis. -/
theorem firstCovariant_trace_zero
    (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ) (g : ℝ)
    (hg : g ≠ 0) (hL : cubicOperator P = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ i, eval x (pderiv (some i) P) = 0) (a : ι) :
    (∑ i, firstCovariant P x g a i i) = 0 := by
  have ht := Source29PolynomialNormalTrace.tangential_trace_zero P x g hg hL hgn hgt
  have hd := derivative_trace P x g hg hL hgn hgt (some a)
  change (∑ i, hessian P x (some i) (some i)) = 0 at ht
  change g * (∑ i, third P x (some a) (some i) (some i)) =
    2 * (∑ i, hessian P x (some a) (some i) * hessian P x none (some i)) at hd
  simp only [firstCovariant, Finset.sum_sub_distrib, ← Finset.sum_div,
    Finset.sum_add_distrib, ← Finset.mul_sum, ht, mul_zero, zero_add]
  have hc : (∑ i, hessian P x none (some i) * hessian P x (some a) (some i)) =
      ∑ i, hessian P x (some a) (some i) * hessian P x none (some i) := by
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hc]
  field_simp
  nlinarith [hd]

end
end Source29PolynomialTangentialDerivative

/- Component: PolynomialSecondTrace.inc -/
namespace Source29PolynomialSecondTrace

open MvPolynomial Source29FactorInheritance Source29PolynomialTangentialDerivative
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- A fourth-order trace identity from two derivatives of Lp=0. -/
theorem second_derivative_trace
    (P : MvPolynomial (Option ι) ℝ) (x : Option ι → ℝ) (g : ℝ)
    (hg : g ≠ 0) (hL : cubicOperator P = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ i, eval x (pderiv (some i) P) = 0) (a b : Option ι) :
    g^2 * (∑ i, eval x (pderiv a (pderiv b (pderiv (some i) (pderiv (some i) P))))) =
      2 * (∑ i, ∑ j, hessian P x a (some i) * hessian P x b (some j) *
        hessian P x (some i) (some j)) -
      2 * hessian P x none none * (∑ i, hessian P x a (some i) * hessian P x b (some i)) +
      2 * g * (∑ i, (third P x a b (some i) * hessian P x none (some i) +
        hessian P x a (some i) * third P x b none (some i) +
        hessian P x b (some i) * third P x a none (some i))) -
      2 * hessian P x a none * (∑ i, hessian P x b (some i) * hessian P x none (some i)) -
      2 * hessian P x b none * (∑ i, hessian P x a (some i) * hessian P x none (some i)) := by
  have ht := Source29PolynomialNormalTrace.tangential_trace_zero P x g hg hL hgn hgt
  have ha := derivative_trace P x g hg hL hgn hgt a
  have hb := derivative_trace P x g hg hL hgn hgt b
  have hsym : ∀ i, eval x (pderiv (some i) (pderiv none P)) =
      eval x (pderiv none (pderiv (some i) P)) := by
    intro i
    rw [second_partial_comm]
  have hta : ∀ i, eval x (pderiv a (pderiv (some i) (pderiv none P))) =
      eval x (pderiv a (pderiv none (pderiv (some i) P))) := by
    intro i
    rw [second_partial_comm P (some i) none]
  have htb : ∀ i, eval x (pderiv b (pderiv (some i) (pderiv none P))) =
      eval x (pderiv b (pderiv none (pderiv (some i) P))) := by
    intro i
    rw [second_partial_comm P (some i) none]
  have he := congrArg (eval x) (congrArg (pderiv a) (congrArg (pderiv b) hL))
  simp [cubicOperator, pderiv_mul, pderiv_pow, Fintype.sum_option,
    hgn, hgt, hsym, hta, htb, ht] at he
  have htwo : pderiv a (2 : MvPolynomial (Option ι) ℝ) = 0 := by
    simpa only [map_ofNat] using (pderiv_C (i := a) (a := (2 : ℝ)))
  simp only [htwo, map_zero, mul_zero, add_zero, mul_add, add_mul,
    Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul] at he
  ring_nf at he
  have hH : ∀ c e, eval x (pderiv c (pderiv e P)) = hessian P x c e := by
    intro c e
    rfl
  have hT : ∀ c e f, eval x (pderiv c (pderiv e (pderiv f P))) = third P x c e f := by
    intro c e f
    rfl
  simp only [hH, hT] at he ha hb
  simp only [mul_assoc, ← Finset.mul_sum] at he
  have hcross : (∑ i, ∑ j, hessian P x (some i) (some j) *
      (hessian P x b (some i) * hessian P x a (some j))) =
      ∑ i, ∑ j, hessian P x (some i) (some j) *
        (hessian P x b (some j) * hessian P x a (some i)) := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hessian_symm P x (some j) (some i)]
  rw [hcross] at he
  simp only [Finset.sum_add_distrib]
  simp only [mul_comm, mul_left_comm, mul_assoc] at he ha hb ⊢
  linear_combination he - 2 * hessian P x a none * hb - 2 * hessian P x b none * ha

end
end Source29PolynomialSecondTrace

/- Component: HomogeneousHigherRadialJets.inc -/
namespace Source29HomogeneousHigherRadialJets

open MvPolynomial Source29HomogeneousRadialJets
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.QuarticCompatibility

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- Euler's third- and fourth-order identities at a coordinate radial point.
These remove the radial direction from the twice differentiated equation. -/
theorem radial_coordinate_higher_jets (P : MvPolynomial κ ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d) (r a b : κ) :
    eval (Pi.single r 1) (pderiv r (pderiv a (pderiv b P))) =
        ((d : ℝ)-2) * eval (Pi.single r 1) (pderiv a (pderiv b P)) ∧
    eval (Pi.single r 1) (pderiv r (pderiv r (pderiv a (pderiv b P)))) =
        ((d : ℝ)-3)*((d : ℝ)-2) * eval (Pi.single r 1) (pderiv a (pderiv b P)) := by
  have h := radial_coordinate_jets (pderiv b P) (d-1) (homogeneous_pderiv hP)
    (by omega) r a
  rw [Nat.cast_sub (by omega : 1 ≤ d), Nat.cast_one] at h
  constructor
  · convert h.1 using 1 <;> ring
  · convert h.2 using 1 <;> ring

end
end Source29HomogeneousHigherRadialJets

/- Component: SimonsJetCorrection.inc -/
namespace Source29SimonsJetCorrection

open Source29GaussSimonsAlgebra
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def matrixSquare (A : ι → ι → ℝ) (a b : ι) : ℝ := ∑ k, A a k * A k b

def matrixCube (A : ι → ι → ℝ) (a b : ι) : ℝ := ∑ k, matrixSquare A a k * A k b

def correction (A : ι → ι → ℝ) (a b c d : ι) : ℝ :=
  delta a d * A b c + delta b d * A a c + delta c d * A a b -
    matrixSquare A a d * A b c - matrixSquare A b d * A a c - matrixSquare A c d * A a b

theorem matrixSquare_symm (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a) (a b : ι) :
    matrixSquare A a b = matrixSquare A b a := by
  apply Finset.sum_congr rfl
  intro k _
  rw [hA a k, hA k b]
  ring

theorem delta_symm (a b : ι) : delta a b = delta b a := by
  simp only [delta, eq_comm]

theorem correction_swap12 (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (a b c d : ι) : correction A a b c d = correction A b a c d := by
  unfold correction
  rw [hA b a]
  ring

theorem correction_swap13 (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (a b c d : ι) : correction A a b c d = correction A c b a d := by
  unfold correction
  rw [hA b a, hA c a, hA c b]
  ring

theorem correction_trace (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (htrace : (∑ k, A k k) = 0) (c d : ι) :
    (∑ k, correction A k k c d) = 2 * A c d - 2 * matrixCube A d c := by
  have hm : (∑ k, matrixSquare A k d * A k c) = matrixCube A d c := by
    unfold matrixCube
    apply Finset.sum_congr rfl
    intro k _
    rw [matrixSquare_symm A hA k d]
  simp only [correction, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    ← Finset.mul_sum, htrace, mul_zero, delta, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.sum_ite_irrel, Finset.sum_const_zero, ite_self, Finset.mem_univ, ite_true, hm]
  rw [hA d c]
  ring

theorem gauss_action (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (a b c d : ι) :
    (∑ l, (A l b * gaussTensor A l a c d + A a l * gaussTensor A l b c d)) =
      delta a d * A b c - delta a c * A b d + delta b d * A a c - delta b c * A a d +
        matrixSquare A b c * A a d - matrixSquare A b d * A a c +
        matrixSquare A a c * A b d - matrixSquare A a d * A b c := by
  have hp : ∀ b c d e, (∑ l, A l b * (A l c * A d e)) = matrixSquare A b c * A d e := by
    intro b c d e
    simp only [matrixSquare, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro l _
    rw [hA l b]
    ring
  have hq : ∀ a c d e, (∑ l, A a l * (A l c * A d e)) = matrixSquare A a c * A d e := by
    intro a c d e
    simp only [matrixSquare, Finset.sum_mul, mul_assoc]
  simp only [gaussTensor, mul_add, mul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib, hp, hq]
  simp only [delta, mul_ite, ite_mul, mul_one, one_mul, mul_zero, zero_mul,
    Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.mem_univ, ite_true]
  rw [hA c b, hA d b]
  ring

theorem correction_commutator (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (a b c d : ι) :
    correction A a b c d - correction A a b d c =
      ∑ l, (A l b * gaussTensor A l a c d + A a l * gaussTensor A l b c d) := by
  rw [gauss_action A hA]
  unfold correction
  rw [delta_symm d c, matrixSquare_symm A hA d c]
  ring

/-- A fully symmetric fourth-order tensor with the indicated trace gives
the full Simons identity after the explicit curvature correction. -/
theorem simons_of_symmetric_fourth (A : ι → ι → ℝ) (F : ι → ι → ι → ι → ℝ)
    (hA : ∀ a b, A a b = A b a) (htrace : (∑ k, A k k) = 0)
    (hF12 : ∀ a b c d, F a b c d = F b a c d)
    (hF13 : ∀ a b c d, F a b c d = F c b a d)
    (hF34 : ∀ a b c d, F a b c d = F a b d c)
    (hFtrace : ∀ c d, (∑ k, F k k c d) = 2 * matrixCube A d c - 2 * A c d)
    (i j : ι) :
    (∑ k, (F i j k k + correction A i j k k)) =
      ((Fintype.card ι : ℝ) - normSq A) * A i j := by
  apply simons_of_gauss_codazzi A (fun a b c d => F a b c d + correction A a b c d)
    hA htrace
  · intro a b c d
    rw [hF12 a b c d, correction_swap12 A hA a b c d]
  · intro a b c d
    rw [hF13 a b c d, correction_swap13 A hA a b c d]
  · intro c d
    rw [Finset.sum_add_distrib, hFtrace, correction_trace A hA htrace]
    ring
  · intro a b c d
    rw [hF34 a b c d]
    simpa only [add_sub_add_left_eq_sub] using correction_commutator A hA a b c d

end
end Source29SimonsJetCorrection

/- Component: SimonsFourthTensor.inc -/
namespace Source29SimonsFourthTensor

open Source29SimonsJetCorrection
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def fourthTensor (A V : ι → ι → ℝ) (B : ι → ι → ι → ℝ)
    (Q : ι → ι → ι → ι → ℝ) (w : ι → ℝ) (z : ℝ) (a b c d : ι) : ℝ :=
  Q a b c d - (A a d * V b c + A b d * V a c + A c d * V a b +
    V a d * A b c + V b d * A a c + V c d * A a b) +
    z * (A a d * A b c + A b d * A a c + A c d * A a b) -
    (w d * B a b c + w a * B b c d + w b * B a c d + w c * B a b d)

theorem fourthTensor_swap12 (A V : ι → ι → ℝ) (B : ι → ι → ι → ℝ)
    (Q : ι → ι → ι → ι → ℝ) (w : ι → ℝ) (z : ℝ)
    (hA : ∀ a b, A a b = A b a) (hV : ∀ a b, V a b = V b a)
    (hB : ∀ a b c, B a b c = B b a c)
    (hQ : ∀ a b c d, Q a b c d = Q b a c d) (a b c d : ι) :
    fourthTensor A V B Q w z a b c d = fourthTensor A V B Q w z b a c d := by
  unfold fourthTensor
  rw [hQ a b c d, hB a b c, hB a b d, hA a b, hV a b]
  ring

theorem fourthTensor_swap13 (A V : ι → ι → ℝ) (B : ι → ι → ι → ℝ)
    (Q : ι → ι → ι → ι → ℝ) (w : ι → ℝ) (z : ℝ)
    (hA : ∀ a b, A a b = A b a) (hV : ∀ a b, V a b = V b a)
    (hB12 : ∀ a b c, B a b c = B b a c) (hB13 : ∀ a b c, B a b c = B c b a)
    (hQ : ∀ a b c d, Q a b c d = Q c b a d) (a b c d : ι) :
    fourthTensor A V B Q w z a b c d = fourthTensor A V B Q w z c b a d := by
  unfold fourthTensor
  rw [hQ a b c d, hB13 a b c, hB12 b c d, hB12 a c d, hB12 a b d,
    hA b a, hA c a, hA c b, hV b a, hV c a, hV c b]
  ring

theorem fourthTensor_swap34 (A V : ι → ι → ℝ) (B : ι → ι → ι → ℝ)
    (Q : ι → ι → ι → ι → ℝ) (w : ι → ℝ) (z : ℝ)
    (hA : ∀ a b, A a b = A b a) (hV : ∀ a b, V a b = V b a)
    (hB23 : ∀ a b c, B a b c = B a c b)
    (hQ : ∀ a b c d, Q a b c d = Q a b d c) (a b c d : ι) :
    fourthTensor A V B Q w z a b c d = fourthTensor A V B Q w z a b d c := by
  unfold fourthTensor
  rw [hQ a b c d, hB23 b c d, hB23 a c d, hA c d, hV c d]
  ring

/-- The polynomial trace identities imply the trace needed for Simons.
The fourth-order expression is explicit; no curvature commutator is assumed. -/
theorem fourthTensor_trace (A V : ι → ι → ℝ) (B S : ι → ι → ι → ℝ)
    (Q : ι → ι → ι → ι → ℝ) (w : ι → ℝ) (z t : ℝ)
    (hA : ∀ a b, A a b = A b a) (hAtr : (∑ k, A k k) = 0)
    (hB : ∀ a b c, B a b c = S a b c - w a * A b c - w b * A a c - w c * A a b)
    (hBtr : ∀ c, (∑ k, B k k c) = 0)
    (hVtr : (∑ k, V k k) = 2 * (∑ k, (w k)^2) + t)
    (hQtr : ∀ c d, (∑ k, Q k k c d) =
      2 * matrixCube A d c - 2 * z * matrixSquare A c d +
      2 * (∑ k, (S k c d * w k + A k c * V k d + A k d * V k c)) -
      2 * w c * (∑ k, A k d * w k) - 2 * w d * (∑ k, A k c * w k) + (t-2)*A c d)
    (c d : ι) :
    (∑ k, fourthTensor A V B Q w z k k c d) =
      2 * matrixCube A d c - 2 * A c d := by
  have hsquare : (∑ k, A k d * A k c) = matrixSquare A c d := by
    unfold matrixSquare
    apply Finset.sum_congr rfl
    intro k _
    rw [hA k c]
    ring
  have hsumB : (∑ k, w k * B k c d) =
      (∑ k, S k c d * w k) - A c d * (∑ k, (w k)^2) -
      w c * (∑ k, A k d * w k) - w d * (∑ k, A k c * w k) := by
    calc
      _ = ∑ k, (S k c d * w k - A c d * (w k)^2 -
          w c * (A k d * w k) - w d * (A k c * w k)) := by
        apply Finset.sum_congr rfl
        intro k _
        rw [hB]
        ring
      _ = _ := by simp only [Finset.sum_sub_distrib, ← Finset.mul_sum]
  have hcross : (∑ k, V k d * A k c) = ∑ k, A k c * V k d := by
    apply Finset.sum_congr rfl
    intro k _
    ring
  simp only [fourthTensor, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    ← Finset.mul_sum, hAtr, hBtr, mul_zero, zero_add, add_zero, sub_zero,
    hsquare, hsumB, hcross, hVtr, hQtr]
  ring

end
end Source29SimonsFourthTensor

/- Component: PolynomialLinkFourthTrace.inc -/
namespace Source29PolynomialLinkFourthTrace

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialTangentialDerivative
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The twice differentiated polynomial equation, with the radial direction
removed by homogeneity. All remaining sums run over the spherical link. -/
theorem link_fourth_trace
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d) (g : ℝ) (hg : g ≠ 0)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) (a b : ι) :
    g^2 * (∑ i, eval base (pderiv (some (some a)) (pderiv (some (some b))
      (pderiv (some (some i)) (pderiv (some (some i)) P))))) =
      2 * (∑ i, ∑ j, hessian P base (some (some a)) (some (some i)) *
        hessian P base (some (some b)) (some (some j)) *
        hessian P base (some (some i)) (some (some j))) -
      2 * hessian P base none none * (∑ i, hessian P base (some (some a)) (some (some i)) *
        hessian P base (some (some b)) (some (some i))) +
      2 * g * (∑ i, (third P base (some (some a)) (some (some b)) (some (some i)) *
          hessian P base none (some (some i)) +
        hessian P base (some (some a)) (some (some i)) *
          third P base (some (some b)) none (some (some i)) +
        hessian P base (some (some b)) (some (some i)) *
          third P base (some (some a)) none (some (some i)))) -
      2 * hessian P base (some (some a)) none * (∑ i,
        hessian P base (some (some b)) (some (some i)) * hessian P base none (some (some i))) -
      2 * hessian P base (some (some b)) none * (∑ i,
        hessian P base (some (some a)) (some (some i)) * hessian P base none (some (some i))) +
      ((d : ℝ)*((d : ℝ)-1)-2) * g^2 * hessian P base (some (some a)) (some (some b)) := by
  have hR : ∀ j, hessian P base (some none) (some j) = 0 := by
    intro j
    have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP
      (by omega) (some none) (some j)).1
    change hessian P base (some none) (some j) = ((d : ℝ)-1)*eval base (pderiv (some j) P) at he
    simpa only [hgt, mul_zero] using he
  have hR' : ∀ j, hessian P base (some j) (some none) = 0 := by
    intro j
    rw [hessian_symm, hR]
  have hNR : hessian P base none (some none) = ((d : ℝ)-1)*g := by
    rw [hessian_symm]
    have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP
      (by omega) (some none) none).1
    change hessian P base (some none) none = ((d : ℝ)-1)*eval base (pderiv none P) at he
    rw [hgn] at he
    exact he
  have hTR : third P base (some (some a)) (some (some b)) (some none) =
      ((d : ℝ)-2) * hessian P base (some (some a)) (some (some b)) := by
    have he := (Source29HomogeneousHigherRadialJets.radial_coordinate_higher_jets P d hP hd
      (some none) (some (some a)) (some (some b))).1
    simpa only [third, hessian, base, second_partial_comm] using he
  have hQR : eval base (pderiv (some (some a)) (pderiv (some (some b))
      (pderiv (some none) (pderiv (some none) P)))) =
      ((d : ℝ)-3)*((d : ℝ)-2) * hessian P base (some (some a)) (some (some b)) := by
    have he := (Source29HomogeneousHigherRadialJets.radial_coordinate_higher_jets P d hP hd
      (some none) (some (some a)) (some (some b))).2
    simpa only [hessian, base, second_partial_comm] using he
  have he := Source29PolynomialSecondTrace.second_derivative_trace P base g hg hL hgn hgt
    (some (some a)) (some (some b))
  simp only [Fintype.sum_option, hR, hR', hNR, hTR, hQR, mul_zero, zero_mul, zero_add, add_zero, Finset.sum_const_zero] at he
  linear_combination he

end
end Source29PolynomialLinkFourthTrace

/- Component: NormalizedLinkJets.inc -/
namespace Source29NormalizedLinkJets

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialTangentialDerivative
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def tangent (a : ι) : Option (Option ι) := some (some a)

def A (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b : ι) : ℝ :=
  hessian P base (tangent a) (tangent b) / g

def w (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a : ι) : ℝ :=
  hessian P base none (tangent a) / g

def z (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) : ℝ := hessian P base none none / g

def S (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) : ℝ :=
  third P base (tangent a) (tangent b) (tangent c) / g

def V (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b : ι) : ℝ :=
  third P base none (tangent a) (tangent b) / g

def Q (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c d : ι) : ℝ :=
  eval base (pderiv (tangent a) (pderiv (tangent b) (pderiv (tangent c) (pderiv (tangent d) P)))) / g

def B (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) : ℝ :=
  S P g a b c - w P g a * A P g b c - w P g b * A P g a c - w P g c * A P g a b

theorem A_symm (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b : ι) :
    A P g a b = A P g b a := by simp only [A, hessian, second_partial_comm]

theorem V_symm (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b : ι) :
    V P g a b = V P g b a := by simp only [V, third, second_partial_comm]

theorem S_swap12 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    S P g a b c = S P g b a c := by simp only [S, third, second_partial_comm]

theorem S_swap23 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    S P g a b c = S P g a c b := by simp only [S, third, second_partial_comm]

theorem Q_swap12 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c d : ι) :
    Q P g a b c d = Q P g b a c d := by simp only [Q, second_partial_comm]

theorem Q_swap13 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c d : ι) :
    Q P g a b c d = Q P g c b a d := by simp only [Q, second_partial_comm]

theorem Q_swap34 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c d : ι) :
    Q P g a b c d = Q P g a b d c := by simp only [Q, second_partial_comm]

theorem B_eq_firstCovariant (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    B P g a b c = firstCovariant P base g (some a) (some b) (some c) := by
  simp only [B, S, w, A, tangent, firstCovariant]
  ring

theorem B_swap12 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    B P g a b c = B P g b a c := by
  simp only [B_eq_firstCovariant]
  exact firstCovariant_swap12 P base g (some a) (some b) (some c)

theorem B_swap23 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    B P g a b c = B P g a c b := by
  simp only [B_eq_firstCovariant]
  exact firstCovariant_swap23 P base g (some a) (some b) (some c)

theorem B_swap13 (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c : ι) :
    B P g a b c = B P g c b a := by
  rw [B_swap12 P g a b c, B_swap23 P g b a c, B_swap12 P g b c a]

end
end Source29NormalizedLinkJets

/- Component: NormalizedLinkTraces.inc -/
namespace Source29NormalizedLinkTraces

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialTangentialDerivative
open Source29NormalizedLinkJets
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

variable (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d) (g : ℝ) (hg : g ≠ 0)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)

include hP hd hgt in
theorem radial_hessian_zero (j : Option ι) : hessian P base (some none) (some j) = 0 := by
  have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP
    (by omega) (some none) (some j)).1
  change hessian P base (some none) (some j) = ((d : ℝ)-1)*eval base (pderiv (some j) P) at he
  simpa only [hgt, mul_zero] using he

include hP hd hg hL hgn hgt

theorem A_trace : (∑ i, A P g i i) = 0 := by
  have ht := Source29PolynomialNormalTrace.tangential_trace_zero P base g hg hL hgn hgt
  have hr := radial_hessian_zero P d hP hd hgt none
  change eval base (pderiv (some none) (pderiv (some none) P)) = 0 at hr
  rw [Fintype.sum_option, hr, zero_add] at ht
  change (∑ i, eval base (pderiv (tangent i) (pderiv (tangent i) P)) / g) = 0
  rw [← Finset.sum_div]
  exact div_eq_zero_iff.mpr (Or.inl ht)

theorem B_trace (c : ι) : (∑ i, B P g i i c) = 0 := by
  have hR := radial_hessian_zero P d hP hd hgt
  have hR' : ∀ j, hessian P base (some j) (some none) = 0 := by
    intro j
    rw [hessian_symm, hR]
  have hT : third P base (tangent c) (some none) (some none) = 0 := by
    have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP
      (by omega) (some none) (tangent c)).2
    change third P base (some none) (some none) (tangent c) =
      ((d : ℝ)-2)*((d : ℝ)-1)*eval base (pderiv (some (some c)) P) at he
    rw [hgt, mul_zero] at he
    simpa only [third, second_partial_comm] using he
  change third P base (some (some c)) (some none) (some none) = 0 at hT
  have hBr : firstCovariant P base g (some c) none none = 0 := by
    simpa only [firstCovariant, tangent, hT, hR, hR', mul_zero, zero_mul, zero_add,
      sub_zero, zero_div] using (rfl : (0 : ℝ) = 0)
  have ht := firstCovariant_trace_zero P base g hg hL hgn hgt (some c)
  rw [Fintype.sum_option, hBr, zero_add] at ht
  calc
    (∑ i, B P g i i c) = ∑ i, B P g c i i := by
      apply Finset.sum_congr rfl
      intro i _
      exact B_swap13 P g i i c
    _ = 0 := by simpa only [B_eq_firstCovariant] using ht

theorem V_trace : (∑ i, V P g i i) = 2 * (∑ i, (w P g i)^2) + (d : ℝ)*((d : ℝ)-1) := by
  have ht := Source29PolynomialConeTrace.link_third_trace P d hP (by omega) g hg hL hgn hgt
  change g * (∑ i, third P base none (tangent i) (tangent i)) =
    2 * (∑ i, (hessian P base none (tangent i))^2) + (d : ℝ)*((d : ℝ)-1)*g^2 at ht
  simp only [V, w, div_pow, ← Finset.sum_div]
  field_simp [hg]
  nlinarith [ht]

theorem Q_trace_natural (a b : ι) : (∑ i, Q P g a b i i) =
    2 * (∑ i, ∑ j, A P g a i * A P g b j * A P g i j) -
    2 * z P g * (∑ i, A P g a i * A P g b i) +
    2 * (∑ i, (S P g a b i * w P g i + A P g a i * V P g b i + A P g b i * V P g a i)) -
    2 * w P g a * (∑ i, A P g b i * w P g i) -
    2 * w P g b * (∑ i, A P g a i * w P g i) +
    ((d : ℝ)*((d : ℝ)-1)-2) * A P g a b := by
  have he := Source29PolynomialLinkFourthTrace.link_fourth_trace P d hP hd g hg hL hgn hgt a b
  have hHN : ∀ c, hessian P base (some (some c)) none = hessian P base none (some (some c)) := by
    intro c
    exact hessian_symm P base (some (some c)) none
  have hTN : ∀ c i, third P base (some (some c)) none (some (some i)) = third P base none (some (some c)) (some (some i)) := by
    intro c i
    exact third_swap12 P base (some (some c)) none (some (some i))
  simp only [hHN, hTN] at he
  simp only [Q, A, z, S, w, V, tangent, div_mul_div_comm, ← add_div, ← Finset.sum_div]
  field_simp [hg]
  linear_combination he

end
end Source29NormalizedLinkTraces

/- Component: PolynomialSimonsTensor.inc -/
namespace Source29PolynomialSimonsTensor

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialTangentialDerivative
open Source29NormalizedLinkJets Source29SimonsJetCorrection Source29SimonsFourthTensor
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem cubic_contraction (M : ι → ι → ℝ) (hM : ∀ a b, M a b = M b a) (c d : ι) :
    (∑ i, ∑ j, M c i * M d j * M i j) = matrixCube M d c := by
  simp only [matrixCube, matrixSquare, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [hM c i, hM i j]
  ring

theorem square_contraction (M : ι → ι → ℝ) (hM : ∀ a b, M a b = M b a) (c d : ι) :
    (∑ i, M c i * M d i) = matrixSquare M c d := by
  unfold matrixSquare
  apply Finset.sum_congr rfl
  intro i _
  rw [hM d i]

def F (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) : ι → ι → ι → ι → ℝ :=
  fourthTensor (A P g) (V P g) (B P g) (Q P g) (w P g) (z P g)

/-- Explicit polynomial candidate for the second covariant derivative.
Identification with derivatives of an actual moving frame is still separate. -/
def D (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (a b c d : ι) : ℝ :=
  F P g a b c d + correction (A P g) a b c d

variable (P : MvPolynomial (Option (Option ι)) ℝ) (degree : ℕ)
    (hP : P.IsHomogeneous degree) (hdegree : 3 ≤ degree) (g : ℝ) (hg : g ≠ 0)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)

include hP hdegree hg hL hgn hgt

theorem Q_trace (c d : ι) : (∑ k, Q P g k k c d) =
    2 * matrixCube (A P g) d c - 2 * z P g * matrixSquare (A P g) c d +
    2 * (∑ k, (S P g k c d * w P g k + A P g k c * V P g k d + A P g k d * V P g k c)) -
    2 * w P g c * (∑ k, A P g k d * w P g k) -
    2 * w P g d * (∑ k, A P g k c * w P g k) +
    ((degree : ℝ)*((degree : ℝ)-1)-2) * A P g c d := by
  have hrot : (∑ k, Q P g k k c d) = ∑ k, Q P g c d k k := by
    apply Finset.sum_congr rfl
    intro k _
    simp only [Q, second_partial_comm]
  rw [hrot, Source29NormalizedLinkTraces.Q_trace_natural P degree hP hdegree g hg hL hgn hgt,
    cubic_contraction (A P g) (A_symm P g), square_contraction (A P g) (A_symm P g)]
  have hS : ∀ k, S P g c d k = S P g k c d := by
    intro k
    simp only [S, third, second_partial_comm]
  simp only [hS, A_symm, V_symm]

theorem F_trace (c d : ι) : (∑ k, F P g k k c d) =
    2 * matrixCube (A P g) d c - 2 * A P g c d := by
  apply fourthTensor_trace (A P g) (V P g) (B P g) (S P g) (Q P g) (w P g) (z P g)
    ((degree : ℝ)*((degree : ℝ)-1)) (A_symm P g)
    (Source29NormalizedLinkTraces.A_trace P degree hP hdegree g hg hL hgn hgt)
    (fun a b c => rfl)
    (Source29NormalizedLinkTraces.B_trace P degree hP hdegree g hg hL hgn hgt)
    (Source29NormalizedLinkTraces.V_trace P degree hP hdegree g hg hL hgn hgt)
    (Q_trace P degree hP hdegree g hg hL hgn hgt)

/-- Tensor Simons for explicit normalized polynomial jets. No Gauss, Codazzi,
or commutator assumptions are needed. Geometric realization of D remains. -/
theorem tensor_simons (i j : ι) :
    (∑ k, D P g i j k k) =
      ((Fintype.card ι : ℝ) - Source29GaussSimonsAlgebra.normSq (A P g)) * A P g i j := by
  apply simons_of_symmetric_fourth (A P g) (F P g) (A_symm P g)
    (Source29NormalizedLinkTraces.A_trace P degree hP hdegree g hg hL hgn hgt)
  · exact fourthTensor_swap12 (A P g) (V P g) (B P g) (Q P g) (w P g) (z P g)
      (A_symm P g) (V_symm P g) (B_swap12 P g) (Q_swap12 P g)
  · exact fourthTensor_swap13 (A P g) (V P g) (B P g) (Q P g) (w P g) (z P g)
      (A_symm P g) (V_symm P g) (B_swap12 P g) (B_swap13 P g) (Q_swap13 P g)
  · exact fourthTensor_swap34 (A P g) (V P g) (B P g) (Q P g) (w P g) (z P g)
      (A_symm P g) (V_symm P g) (B_swap23 P g) (Q_swap34 P g)
  · exact F_trace P degree hP hdegree g hg hL hgn hgt

/-- The algebraic tensor norm is the already defined invariant potential. -/
theorem normSq_A_eq_curvaturePotential : Source29GaussSimonsAlgebra.normSq (A P g) =
    Source29PolynomialCurvaturePotential.curvaturePotential P base := by
