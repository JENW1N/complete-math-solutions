namespace Source29LowDimensionalEigenvalueGap

/-- The real-degree Jacobi parameter stays strictly above the Simons bound
for link dimensions one through five. -/
theorem gap (D m : ℝ) (hm : 1 ≤ m) (hm' : m ≤ 5) :
    1 ≤ (D-1)*(D-m)+m := by
  have hp : 0 ≤ (m-1)*(5-m) := mul_nonneg (by linarith) (by linarith)
  nlinarith [sq_nonneg (2*D-m-1)]

theorem no_eigenvalue_bound (D m : ℝ) (hm : 1 ≤ m) (hm' : m ≤ 5)
    (hbound : (D-1)*(D-m) ≤ -m) : False := by
  have hg := gap D m hm hm'
  linarith

theorem no_eigenvalue_bound_nat (D : ℝ) (m : ℕ) (hm : 1 ≤ m) (hm' : m ≤ 5)
    (hbound : (D-1)*(D-(m : ℝ)) ≤ -(m : ℝ)) : False :=
  no_eigenvalue_bound D m (by exact_mod_cast hm) (by exact_mod_cast hm') hbound

end Source29LowDimensionalEigenvalueGap


