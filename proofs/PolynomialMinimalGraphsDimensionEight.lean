/- Component: EvenCompactPrimitive.inc -/
namespace Source29EvenCompactPrimitive

open MeasureTheory Set
open scoped Interval

noncomputable section

theorem integral_neg {h : ℝ → ℝ} (he : ∀ t, h (-t) = h t) (z : ℝ) :
    (∫ t in 0..(-z), h t) = -(∫ t in 0..z, h t) := by
  have hi := intervalIntegral.integral_comp_neg h (a := 0) (b := z)
  simp only [he, neg_zero] at hi
  rw [intervalIntegral.integral_symm, ← hi]

theorem integral_eq_at_two {h : ℝ → ℝ} (hh : Continuous h)
    (hz : ∀ t, 2 ≤ t → h t = 0) {z : ℝ} (hzbig : 2 ≤ z) :
    (∫ t in 0..z, h t) = ∫ t in (0 : ℝ)..2, h t := by
  have hi : (∫ t in (2 : ℝ)..z, h t) = 0 := by
    calc
      (∫ t in (2 : ℝ)..z, h t) = ∫ _t in (2 : ℝ)..z, (0 : ℝ) := by
        apply intervalIntegral.integral_congr
        intro t ht
        exact hz t ((uIcc_of_le hzbig ▸ ht).1)
      _ = 0 := by simp
  have ha := intervalIntegral.integral_add_adjacent_intervals (μ := volume) (hh.intervalIntegrable 0 2) (hh.intervalIntegrable 2 z)
  rw [hi, add_zero] at ha
  exact ha.symm

theorem integral_eq_at_neg_two {h : ℝ → ℝ} (hh : Continuous h)
    (he : ∀ t, h (-t) = h t) (hz : ∀ t, 2 ≤ t → h t = 0) {z : ℝ} (hzneg : z ≤ -2) :
    (∫ t in 0..z, h t) = -(∫ t in (0 : ℝ)..2, h t) := by
  have hi := integral_neg he (-z)
  simp only [neg_neg] at hi
  rw [hi, integral_eq_at_two hh hz (by linarith)]

theorem integral_norm_le {h : ℝ → ℝ} (hh : Continuous h)
    (he : ∀ t, h (-t) = h t) (hz : ∀ t, 2 ≤ t → h t = 0)
    {M : ℝ} (hb : ∀ t, ‖h t‖ ≤ M) (z : ℝ) : ‖∫ t in 0..z, h t‖ ≤ 2*M := by
  have hM : 0 ≤ M := (norm_nonneg (h 0)).trans (hb 0)
  have hbound (t : ℝ) (ht : |t| ≤ 2) : ‖∫ s in 0..t, h s‖ ≤ 2*M := by
    have hi := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := t) (fun x _ ↦ hb x)
    simp only [sub_zero] at hi
    exact hi.trans (by nlinarith)
  by_cases hp : 2 ≤ z
  · rw [integral_eq_at_two hh hz hp]
    exact hbound 2 (by norm_num)
  by_cases hm : z ≤ -2
  · rw [integral_eq_at_neg_two hh he hz hm, norm_neg]
    exact hbound 2 (by norm_num)
  exact hbound z (abs_le.mpr ⟨by linarith, by linarith⟩)

end
