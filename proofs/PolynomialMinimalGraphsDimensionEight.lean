/- Component: PositiveLeadingStructureReduction.inc -/
namespace Source29PositiveLeadingStructureReduction

open MvPolynomial Source29Closing

noncomputable section

/-- Positive residual factor data, allowing either a linear or nonlinear irreducible factor. -/
def PositiveLeadingFactorData8 (P : Polynomial8) : Prop :=
  ∃ (p Q : Polynomial8) (k : ℕ),
    1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
    Q.IsHomogeneous Q.totalDegree ∧
    homogeneousComponent P.totalDegree P = p ^ k * Q ∧
    PositiveAwayFromZero Q

/-- Both the linear and nonlinear factors are handled; only the positive
residual factorization is assumed. -/
theorem problem29_of_positive_leading_factor
    (hstructure : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → PositiveLeadingFactorData8 P) : Math30.Problem29 := by
  intro P hminimal
  change P.totalDegree ≤ 1
  by_contra hn
  have hd : 2 ≤ P.totalDegree := by omega
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQpos⟩ := hstructure P hminimal hd
  obtain ⟨hodd, hpos, hneg⟩ :=
    Source29PositiveResidualSign.minimal_graph_factor_changes_sign P p Q k hminimal hd hfactor hQpos
  obtain ⟨hne, hhom, hL⟩ := QuarticPolynomialBasics.leading_component_data P hminimal hd
  have hQdiv : Q ∣ homogeneousComponent P.totalDegree P := ⟨p ^ k, hfactor.trans (mul_comm _ _)⟩
  have hQdegree := Source29ComplexObstruction.positive_divisor_obstruction
    (homogeneousComponent P.totalDegree P) Q P.totalDegree hne hhom hL hQhom hQpos hQdiv
  have hQconst : Q = C (Q.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hQdegree
  have ha : Q.coeff 0 ≠ 0 := by
    intro hz
    apply hne
    rw [hfactor, hQconst, hz, map_zero, mul_zero]
  have hpL : Source29FactorInheritance.cubicOperator p = 0 := by
    apply Source29PowerOperator.cubicOperator_pow_mul_C_zero_imp p hp.ne_zero k (by omega)
      (Q.coeff 0) ha
    change QuarticPolynomialBasics.cubicOperator (p ^ k * C (Q.coeff 0)) = 0
    rw [← hQconst, ← hfactor]
    exact hL
  have hpd := Source29IrreducibleHomogeneousRigidity.degree_le_one p hp hphom hpL hpos hneg
  have hpdegree : p.totalDegree = 1 := by
    have hz : p.totalDegree ≠ 0 := by
      intro he
      have hc : p = C (p.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp he
      obtain ⟨x, hx⟩ := hpos
      obtain ⟨y, hy⟩ := hneg
      rw [hc, eval_C] at hx hy
      linarith
    omega
  have hlinear : p.IsHomogeneous 1 := hpdegree ▸ hphom
  apply hn
  apply Source29PolynomialLinearLeadingRigidity.affine_of_odd_homogeneous_linear_leading
    P hminimal p hp.ne_zero hlinear ha hodd
  exact hfactor.trans ((congrArg (fun q ↦ p ^ k * q) hQconst).trans (mul_comm _ _))

end
end Source29PositiveLeadingStructureReduction

