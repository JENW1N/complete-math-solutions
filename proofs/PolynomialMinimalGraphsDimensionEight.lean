noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem hasDerivAt_dot (u v : ℝ → κ → ℝ) (du dv : κ → ℝ)
    (hu : ∀ a, HasDerivAt (fun t => u t a) (du a) 0)
    (hv : ∀ a, HasDerivAt (fun t => v t a) (dv a) 0) :
    HasDerivAt (fun t => u t ⬝ᵥ v t) (du ⬝ᵥ v 0 + u 0 ⬝ᵥ dv) 0 := by
  simpa only [dotProduct, Finset.sum_add_distrib, Pi.mul_def] using
    (HasDerivAt.fun_sum (fun a (_ : a ∈ Finset.univ) => (hu a).mul (hv a)))

theorem dot_reflect (u v w : κ → ℝ) : v ⬝ᵥ reflect u w =
    2 * ((u ⬝ᵥ w)/(u ⬝ᵥ u)) * (v ⬝ᵥ u) - v ⬝ᵥ w := by
  calc
    _ = ∑ a, (2*((u ⬝ᵥ w)/(u ⬝ᵥ u))*(v a*u a) - v a*w a) := by
      apply Finset.sum_congr rfl
      intro a _
      rw [reflect_apply]
      ring
    _ = _ := by simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, dotProduct]

theorem self_dot_reflect (u v : κ → ℝ) : u ⬝ᵥ reflect u v = u ⬝ᵥ v := by
  have he := reflect_dot u u v
  rwa [reflect_self] at he

theorem hasDerivAt_reflect (u v : ℝ → κ → ℝ) (du dv : κ → ℝ)
    (hu : ∀ a, HasDerivAt (fun t => u t a) (du a) 0)
    (hv : ∀ a, HasDerivAt (fun t => v t a) (dv a) 0) (hne : u 0 ≠ 0) (a : κ) :
    HasDerivAt (fun t => reflect (u t) (v t) a)
      (2 * (((du ⬝ᵥ v 0 + u 0 ⬝ᵥ dv)*(u 0 ⬝ᵥ u 0) -
        (u 0 ⬝ᵥ v 0)*(du ⬝ᵥ u 0 + u 0 ⬝ᵥ du))/(u 0 ⬝ᵥ u 0)^2) * u 0 a +
        2*((u 0 ⬝ᵥ v 0)/(u 0 ⬝ᵥ u 0))*du a - dv a) 0 := by
  have hp := hasDerivAt_dot u v du dv hu hv
  have hs := hasDerivAt_dot u u du du hu hu
  have hn : u 0 ⬝ᵥ u 0 ≠ 0 := (Source29CurvaturePotentialAnalytic.vectorSq_pos (u 0) hne).ne'
  have he := ((((hp.div hs hn).const_mul 2).mul (hu a)).sub (hv a))
  simpa only [reflect_apply, Pi.mul_def, Pi.div_def, Pi.sub_def] using he

theorem hasDerivAt_reflect_const (u : κ → ℝ) (v : ℝ → κ → ℝ) (dv : κ → ℝ)
    (hv : ∀ a, HasDerivAt (fun t => v t a) (dv a) 0) (a : κ) :
    HasDerivAt (fun t => reflect u (v t) a) (reflect u dv a) 0 := by
  have hp := hasDerivAt_dot (fun _ => u) v 0 dv (fun a => hasDerivAt_const 0 (u a)) hv
