theorem first_normal_tangent (i a : ι)
    (hC1 : ∀ c, deriv (fun t => C t c) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 c) :
    deriv (normalizedHessian P C none (tangent a)) 0 = V P g i a - w P g i * w P g a := by
  rw [normalizedHessian_first P g hg hgn hgt C hC hC0 i hC1]
  simp only [V, w, third, hessian, second_partial_comm]
  ring

include hP hd hg hgn hgt hC hC0 in
theorem first_radial_tangent (i a : ι)
    (hC1 : ∀ c, deriv (fun t => C t c) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 c) :
    deriv (normalizedHessian P C (some none) (tangent a)) 0 = ((d : ℝ)-2) * A P g i a := by
  rw [normalizedHessian_first P g hg hgn hgt C hC hC0 i hC1]
  have hH := Source29NormalizedLinkTraces.radial_hessian_zero P d hP hd hgt (some a)
  change hessian P base (some none) (tangent a) = 0 at hH
  rw [hH, mul_zero, sub_zero]
  have he := (Source29HomogeneousHigherRadialJets.radial_coordinate_higher_jets P d hP hd
    (some none) (tangent i) (tangent a)).1
  change third P base (some none) (tangent i) (tangent a) =
    ((d : ℝ)-2)*hessian P base (tangent i) (tangent a) at he
  rw [third_swap12, he]
  unfold A
  ring

