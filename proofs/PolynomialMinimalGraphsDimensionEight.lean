/- Component: GraphSmallDensity.inc -/
namespace Source29GraphSmallDensity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29GraphDilationFields Source29GraphRadialGeometry Source29GraphRadialSupport
open Source29GraphAreaConvexity Source29GraphTangentLimit Source29GraphMassMonotonicity
open scoped Topology

noncomputable section
variable {n : ℕ}

theorem rescaled_weight_continuous (P : MvPolynomial (Fin n) ℝ) :
    Continuous (fun p : ℝ × (Fin n → ℝ) ↦ areaDensity (gradient P p.1 p.2)) := by
  apply areaDensity_continuous
  intro i
  exact (contDiff_eval (pderiv i P)).continuous.comp (continuous_fst.smul continuous_snd)

theorem cutoff_zero_outside_box (u : (Fin n → ℝ) → ℝ) {f : ℝ → ℝ} {R : ℝ}
    (hR : 0 ≤ R) (hz : ∀ t, R ≤ t → f t = 0) (x : Fin n → ℝ) (hx : x ∉ supportBox n R) :
    f (graphRadiusSq u x) = 0 := by
  apply hz
  exact (lt_of_not_ge fun hle ↦ hx (mem_supportBox_of_radius_le u x hR hle)).le

/-- Dominated convergence on a fixed compact base box gives the actual
small-radius graph density as the tangent-plane integral. -/
theorem small_radius_limit (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    {f : ℝ → ℝ} (hf : Continuous f) (hb : ∀ t, ‖f t‖ ≤ 1) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) :
    Tendsto (normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) f) (𝓝[>] 0)
      (𝓝 (∫ x, f (graphRadiusSq (tangentHeight P) x) * areaDensity (evaluatedGradient P 0))) := by
  classical
  let K := supportBox n R
  have hK : IsCompact K := supportBox_compact n R
  obtain ⟨M, hM⟩ := ((isCompact_Icc : IsCompact (Icc (0 : ℝ) 1)).prod hK).exists_bound_of_continuousOn
    (rescaled_weight_continuous P).continuousOn
  have hc (r : ℝ) : Continuous (fun x ↦ f (graphRadiusSq (height P r) x) * areaDensity (gradient P r x)) :=
    (hf.comp (graphRadiusSq_contDiff (height_contDiff P r)).continuous).mul
      (areaDensity_continuous _ (fun i ↦ (gradient_contDiff P r i).continuous))
  have ht : Tendsto (fun r ↦ ∫ x, f (graphRadiusSq (height P r) x) * areaDensity (gradient P r x))
      (𝓝[>] 0) (𝓝 (∫ x, f (graphRadiusSq (tangentHeight P) x) * areaDensity (evaluatedGradient P 0))) := by
    apply tendsto_integral_filter_of_dominated_convergence (K.indicator (fun _ ↦ M))
    · exact Filter.Eventually.of_forall fun r ↦ (hc r).aestronglyMeasurable
    · filter_upwards [self_mem_nhdsWithin, mem_nhdsWithin_of_mem_nhds (gt_mem_nhds (show (0 : ℝ) < 1 by norm_num))] with r hr hr1
      apply Filter.Eventually.of_forall
      intro x
      by_cases hx : x ∈ K
      · rw [Set.indicator_of_mem hx, norm_mul]
        exact (mul_le_mul_of_nonneg_right (hb _) (norm_nonneg _)).trans
          (by simpa only [one_mul] using hM (r,x) ⟨⟨hr.le,hr1.le⟩,hx⟩)
      · rw [Set.indicator_of_notMem hx, cutoff_zero_outside_box (height P r) hR hz x hx, zero_mul, norm_zero]
    · exact (integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hK.measure_lt_top.ne)
    · exact Filter.Eventually.of_forall (density_tendsto P hP hf)
  apply ht.congr'
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact (Source29GraphMassDilation.normalizedMass_eq_rescaled P f hr).symm

end
end Source29GraphSmallDensity

/- Component: PlaneFlattening.inc -/
namespace Source29PlaneFlattening

open Matrix
open Source29GraphAreaConvexity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def flattening (a : Fin n → ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  1 + vecMulVec (fun i ↦ a i / (areaDensity a + 1)) a

theorem flattening_apply (a x : Fin n → ℝ) (i : Fin n) :
    (flattening a *ᵥ x) i = x i + (a ⬝ᵥ x) * (a i / (areaDensity a + 1)) := by
  simp only [flattening, add_mulVec, one_mulVec, vecMulVec_mulVec, Pi.add_apply,
    Pi.smul_apply]
  change x i + (a i / (areaDensity a + 1)) * (a ⬝ᵥ x) = _
  rw [mul_comm (a i / (areaDensity a + 1))]

theorem flattening_det (a : Fin n → ℝ) : (flattening a).det = areaDensity a := by
  rw [flattening, vecMulVec_eq Unit, det_one_add_replicateCol_mul_replicateRow]
  have he : (a ⬝ᵥ (fun i ↦ a i / (areaDensity a + 1))) =
      (∑ i, a i ^ 2) / (areaDensity a + 1) := by
    simp only [dotProduct, ← mul_div_assoc, ← pow_two, ← Finset.sum_div]
  rw [he]
  have hp := areaDensity_pos a
  have hs := areaDensity_sq a
  have hn : areaDensity a + 1 ≠ 0 := by linarith
  field_simp
  nlinarith

theorem flattening_sqNorm (a x : Fin n → ℝ) :
    (∑ i, (flattening a *ᵥ x) i ^ 2) = (∑ i, x i ^ 2) + (a ⬝ᵥ x)^2 := by
  let c := (areaDensity a + 1)⁻¹
  let b := a ⬝ᵥ x
  have hp := areaDensity_pos a
  have hs := areaDensity_sq a
  have hcoef : 2*c + c^2*(∑ i, a i ^ 2) = 1 := by
    dsimp [c]
    have hn : areaDensity a + 1 ≠ 0 := by linarith
    field_simp
    nlinarith
  have he i : (flattening a *ᵥ x) i ^ 2 = x i ^ 2 +
      (2*c*b)*(a i*x i) + (c^2*b^2)*(a i^2) := by
    rw [flattening_apply]
    dsimp [c,b]
    ring
  simp_rw [he]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
  change (∑ i, x i ^ 2) + (2*c*b)*b + (c^2*b^2)*(∑ i, a i^2) =
    (∑ i, x i ^ 2) + b^2
  have hm := congrArg (fun t : ℝ ↦ t * b^2) hcoef
  nlinarith [hm]

end
end Source29PlaneFlattening

/- Component: PlaneRadialIntegral.inc -/
namespace Source29PlaneRadialIntegral

open Matrix MeasureTheory
open Source29GraphAreaConvexity Source29PlaneFlattening
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- The radial mass of a plane does not depend on its slope. -/
theorem tilted_integral (a : Fin n → ℝ) {f : ℝ → ℝ} (hf : Continuous f) :
    (∫ x : Fin n → ℝ, f ((∑ i, x i ^ 2) + (a ⬝ᵥ x)^2) * areaDensity a) =
      ∫ x : Fin n → ℝ, f (∑ i, x i ^ 2) := by
  let T := flattening a
  let G := fun x : Fin n → ℝ ↦ f (∑ i, x i ^ 2)
  have hG : Continuous G := hf.comp (continuous_finsetSum _ fun i _ ↦ (continuous_apply i).pow 2)
  have hT : Continuous (Matrix.toLin' T) := (Matrix.toLin' T).continuous_on_pi
  have hd : T.det = areaDensity a := flattening_det a
  have hp := areaDensity_pos a
  have hm := Real.map_matrix_volume_pi_eq_smul_volume_pi (M := T) (by rw [hd]; exact ne_of_gt hp)
  have hi := integral_map (μ := (volume : Measure (Fin n → ℝ))) hT.aemeasurable hG.aestronglyMeasurable
  rw [hm, integral_smul_measure, hd, abs_of_pos (inv_pos.mpr hp), ENNReal.toReal_ofReal (inv_nonneg.mpr hp.le), smul_eq_mul] at hi
  have he : (∫ x : Fin n → ℝ, f ((∑ i, x i ^ 2) + (a ⬝ᵥ x)^2)) =
      (areaDensity a)⁻¹ * ∫ x : Fin n → ℝ, f (∑ i, x i ^ 2) := by
    rw [hi]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x ↦ by
      change f ((∑ i, x i ^ 2) + (a ⬝ᵥ x)^2) = f (∑ i, (flattening a *ᵥ x) i ^ 2)
      rw [flattening_sqNorm]
  rw [integral_mul_const, he]
  field_simp

end
end Source29PlaneRadialIntegral

/- Component: PolynomialSmallDensity.inc -/
namespace Source29PolynomialSmallDensity

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
