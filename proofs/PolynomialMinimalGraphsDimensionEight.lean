noncomputable section
variable {n : ℕ}

/-- Full residuals have no nonvertex zeros once every nonvertex zero admits a phase chart. -/
theorem cofactor_ne_zero_away_zero
    (F P Q : MvPolynomial (Fin (n+3)) ℝ) (D k : ℕ) (hk : 0 < k)
    (hfac : F=P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hhom : F.IsHomogeneous D) (hF : cubicOperator F=0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hcharts : ∀ a : Fin (n+3) → ℝ, a ≠ 0 → eval a F=0 → HasFlatMinimalPhaseChart F a)
    (hPunit : ∃ x : Fin (n+3) → ℝ, eval x P=0 ∧ (∑ j, (x j)^2)=1) :
    ∀ a : Fin (n+3) → ℝ, a ≠ 0 → eval a Q ≠ 0 := by
  have hQne : Q ≠ 0 := fun h ↦ hPQ (h ▸ dvd_zero P)
  have hFne : F ≠ 0 := by rw [hfac]; exact mul_ne_zero (pow_ne_zero k hP.ne_zero) hQne
  have hPF : P ∣ F := (dvd_pow_self P hk.ne').trans ⟨Q,hfac⟩
  have hPhom := Source29HomogeneousFactor.divisor_isHomogeneous F P hFne hhom hPF
  have hPL := irreducible_divisor_cubic_dvd F P hFne hP hPF hF
  have hPreg := Source29PhaseChartFactorRegularity.irreducible_factor_regular_away_zero
    F P hFne hP hPF hF hcal hcharts
  have hunit_ne_zero (x : Fin (n+3) → ℝ) (hx : (∑ j, (x j)^2)=1) : x ≠ 0 := by
    intro he
    simp only [he,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at hx
    norm_num at hx
  have hdP : 1 ≤ P.totalDegree := by
    obtain ⟨x,hx,_⟩ := hPunit
    exact totalDegree_pos_of_zero P hP.ne_zero x hx
  intro a hane hQa
  obtain ⟨R,hR,hRQ,hRa⟩ := exists_irreducible_zero Q hQne a hQa
  have hRF : R ∣ F := hRQ.trans ⟨P^k,hfac.trans (mul_comm _ _)⟩
  have hRhom := Source29HomogeneousFactor.divisor_isHomogeneous F R hFne hhom hRF
  have hRL := irreducible_divisor_cubic_dvd F R hFne hR hRF hF
  have hRreg := Source29PhaseChartFactorRegularity.irreducible_factor_regular_away_zero
    F R hFne hR hRF hF hcal hcharts
  have hRunit := exists_unit_zero R R.totalDegree hRhom a hane hRa
  obtain ⟨x,hxP,hxR,hxu⟩ := Source29HigherDimensionalLinkIntersection.exists_common_unit_zero P R
    P.totalDegree R.totalDegree hdP (totalDegree_pos_of_zero R hR.ne_zero a hRa) hPhom hRhom
    (fun x hx hu ↦ hPreg x (hunit_ne_zero x hu) hx)
    (fun x hx hu ↦ hRreg x (hunit_ne_zero x hu) hx) hPL hRL hPunit hRunit
  have hxF : eval x F=0 := by rw [hfac,map_mul,map_pow,hxP,zero_pow hk.ne',zero_mul]
  have hxQ := (Source29PhaseChartFactorRegularity.regularity_and_cofactor_nonzero
    F P Q k hk hfac hP hPQ hF hcal x hxP (hcharts x (hunit_ne_zero x hxu) hxF)).2.1
  apply hxQ
  obtain ⟨A,hA⟩ := hRQ
  rw [hA,map_mul,hxR,zero_mul]


theorem constant_sign_away_zero (Q : MvPolynomial (Fin (n+3)) ℝ)
    (hhom : Q.IsHomogeneous Q.totalDegree)
    (hQ : ∀ x : Fin (n+3) → ℝ, x ≠ 0 → eval x Q ≠ 0) :
    (∀ x : Fin (n+3) → ℝ, x ≠ 0 → 0 < eval x Q) ∨
      (∀ x : Fin (n+3) → ℝ, x ≠ 0 → eval x Q < 0) := by
  by_cases hpos : ∀ x : Fin (n+3) → ℝ, x ≠ 0 → 0 < eval x Q
  · exact Or.inl hpos
  right
  push Not at hpos
  obtain ⟨a,ha,hale⟩ := hpos
  have hneg : eval a Q < 0 := lt_of_le_of_ne hale (hQ a ha)
  intro b hb
  by_contra hnb
  have hposb : 0 < eval b Q := lt_of_le_of_ne (le_of_not_gt hnb) (hQ b hb).symm
  by_cases hd : Q.totalDegree=0
  · have hc := totalDegree_eq_zero_iff_eq_C.mp hd
    rw [hc,eval_C] at hneg hposb
    linarith
  · obtain ⟨x,hx,hu⟩ := Source29HigherDimensionalRealZero.exists_unit_zero_of_sign_change
      Q Q.totalDegree hhom (Nat.pos_of_ne_zero hd) ⟨b,hposb⟩ ⟨a,hneg⟩
    have hxne : x ≠ 0 := by
      intro he
      simp only [he,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at hu
      norm_num at hu
    exact hQ x hxne hx

/-- A calibrated homogeneous polynomial of positive degree with phase charts
away from the vertex has one regular real factor and a strictly positive residual.
All regularity and multiplicity conclusions are derived from the charts. -/
theorem exists_positive_regular_factor
    (F : MvPolynomial (Fin (n+3)) ℝ) (d : ℕ) (hd : 0 < d)
    (hFne : F ≠ 0) (hhom : F.IsHomogeneous d) (hF : cubicOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hcharts : ∀ x : Fin (n+3) → ℝ, x ≠ 0 → eval x F = 0 → HasFlatMinimalPhaseChart F x) :
    ∃ (P Q : MvPolynomial (Fin (n+3)) ℝ) (k : ℕ),
      0 < k ∧ Odd k ∧ Irreducible P ∧ P.IsHomogeneous P.totalDegree ∧
      Q.IsHomogeneous Q.totalDegree ∧ F = P^k*Q ∧ ¬P ∣ Q ∧
      (∃ x : Fin (n+3) → ℝ, eval x P = 0 ∧ (∑ j, (x j)^2) = 1) ∧
      (∀ x : Fin (n+3) → ℝ, x ≠ 0 → eval x P = 0 → evaluatedGradient P x ≠ 0) ∧
      (∀ x : Fin (n+3) → ℝ, x ≠ 0 → 0 < eval x Q) := by
  obtain ⟨hneg,hpos⟩ := Source29WeakHomogeneousSign.homogeneous_changes_sign F hhom hd hFne hcal
  obtain ⟨P,Q,k,hk,hP,hPhom,hQhom,hfac,hPQ,hPpos,hPneg,_⟩ :=
    Source29RealLeadingFactor.exists_sign_changing_homogeneous_factor F d hhom hF hpos hneg
  have hdp : 1 ≤ P.totalDegree := by
    by_contra hn
    have he : P.totalDegree = 0 := by omega
    have hc := totalDegree_eq_zero_iff_eq_C.mp he
    obtain ⟨x,hx⟩ := hPpos
    obtain ⟨y,hy⟩ := hPneg
    rw [hc,eval_C] at hx hy
    linarith
  have hunit := Source29HigherDimensionalRealZero.exists_unit_zero_of_sign_change
    P P.totalDegree hPhom hdp hPpos hPneg
  have hQnonzero := cofactor_ne_zero_away_zero F P Q d k hk hfac hP hPQ hhom hF hcal hcharts hunit
  have hPF : P ∣ F := (dvd_pow_self P (by omega : k ≠ 0)).trans ⟨Q,hfac⟩
  have hPreg := Source29PhaseChartFactorRegularity.irreducible_factor_regular_away_zero
    F P hFne hP hPF hF hcal hcharts
  have hodd : Odd k := by
    obtain ⟨x,hx,hxu⟩ := hunit
    have hxne : x ≠ 0 := by
      intro he
      simp only [he,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at hxu
      norm_num at hxu
    have hxF : eval x F = 0 := by rw [hfac,map_mul,map_pow,hx,zero_pow (by omega : k ≠ 0),zero_mul]
    exact (Source29PhaseChartFactorRegularity.regularity_and_cofactor_nonzero
      F P Q k hk hfac hP hPQ hF hcal x hx (hcharts x hxne hxF)).2.2
  rcases constant_sign_away_zero Q hQhom hQnonzero with hQpos | hQneg
  · exact ⟨P,Q,k,hk,hodd,hP,hPhom,hQhom,hfac,hPQ,hunit,hPreg,hQpos⟩
  · refine ⟨-P,-Q,k,hk,hodd,Source29ConnectedFactorStructure.irreducible_neg_of_irreducible P hP,
      ?_,?_,?_,?_,?_,?_,?_⟩
    · simpa only [totalDegree_neg] using hPhom.neg
    · simpa only [totalDegree_neg] using hQhom.neg
    · rw [hodd.neg_pow,neg_mul_neg]
      exact hfac
    · simpa only [neg_dvd,dvd_neg] using hPQ
    · obtain ⟨x,hx,hu⟩ := hunit
      exact ⟨x,by simpa only [map_neg,neg_eq_zero] using hx,hu⟩
    · intro x hx hz hgrad
      have hpzero : eval x P = 0 := by simpa only [map_neg,neg_eq_zero] using hz
      apply hPreg x hx hpzero
      funext i
      have hi := congrFun hgrad i
      simpa only [evaluatedGradient,map_neg,Pi.zero_apply,neg_eq_zero] using hi
    · intro x hx
      simpa only [map_neg,neg_pos] using hQneg x hx

end
end Source29HigherDimensionalPhaseStructure


/- Final component: LinearFactorPhaseRigidity -/
namespace Source29LinearFactorPhaseRigidity

open MvPolynomial Matrix Source29LinearForm
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- A positive residual and an odd linear factor give the two halfspace signs.
Calibrated halfspace rigidity then removes the residual completely. -/
theorem eq_odd_linear_power
    (F Q : MvPolynomial (Fin (n+1)) ℝ) (d k : ℕ) (hd : 0 < d)
    (b : Fin (n+1) → ℝ) (hb : b ≠ 0) (hk : Odd k)
    (hhom : F.IsHomogeneous d) (hFne : F ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hfac : F = (linearForm b)^k * Q)
    (hQpos : ∀ x : Fin (n+1) → ℝ, x ≠ 0 → 0 < eval x Q) :
    ∃ (c : ℝ) (a : Fin (n+1) → ℝ), c ≠ 0 ∧ a ≠ 0 ∧ Odd d ∧
      F = C c * (linearForm a)^d := by
  obtain ⟨U,hUt,hU,hcol⟩ := Source29LinearNormalRotation.exists_rotation b hb
  have hn : 0 < Real.sqrt (radiusSq b) := Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hb)
  have hlin (x : Fin (n+1) → ℝ) : eval (U *ᵥ x) (linearForm b) =
      Real.sqrt (radiusSq b) * x 0 :=
    Source29LinearEndpointRotation.linearForm_eval_rotation b hb U hUt hcol x
  have hune (x : Fin (n+1) → ℝ) (hx : x ≠ 0) : U *ᵥ x ≠ 0 := by
    intro he
    apply hx
    have hh := congrArg (fun y => U.transpose *ᵥ y) he
    simpa only [Matrix.mulVec_mulVec,hUt,Matrix.one_mulVec,Matrix.mulVec_zero] using hh
  have hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x (changeVariables U F) := by
    intro x hx
    have hxne : x ≠ 0 := fun he => hx.ne' (congrFun he 0)
    rw [eval_changeVariables,hfac,map_mul,map_pow,hlin]
    exact (mul_pos (hk.pow_pos_iff.mpr (mul_pos hn hx)) (hQpos _ (hune x hxne))).le
  have hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x (changeVariables U F) ≤ 0 := by
    intro x hx
    have hxne : x ≠ 0 := fun he => hx.ne (congrFun he 0)
    rw [eval_changeVariables,hfac,map_mul,map_pow,hlin]
    exact (mul_neg_of_neg_of_pos (hk.pow_neg_iff.mpr (mul_neg_of_pos_of_neg hn hx))
      (hQpos _ (hune x hxne))).le
  have hrotne : changeVariables U F ≠ 0 := by
    intro he
    have hh := congrArg (changeVariables U.transpose) he
    rw [changeVariables_comp,hU,changeVariables_one,map_zero] at hh
    exact hFne hh
  obtain ⟨c,hc,hodd,hpure⟩ := Source29CalibratedHalfspaceRigidity.eq_positive_odd_normal_power
    (changeVariables U F) d (isHomogeneous_changeVariables U F d hhom) hrotne
    (Source29OrthogonalCalibration.weakCalibration_changeVariables U hU F hcal) hpos hneg
  let L : MvPolynomial (Fin (n+1)) ℝ := changeVariables U.transpose (X 0)
  have hL : L.IsHomogeneous 1 := isHomogeneous_changeVariables U.transpose (X 0) 1 (isHomogeneous_X ℝ 0)
  have hback : F = C c * L^d := by
    have he := congrArg (changeVariables U.transpose) hpure
    rw [changeVariables_comp,hU,changeVariables_one] at he
    simpa only [L,map_mul,map_pow,changeVariables,aeval_C,algebraMap_eq] using he
  have hlinL : L = linearForm (evaluatedGradient L 0) := by
    rw [← Source29RegularPhaseDensity.homogeneousComponent_one_eq_linearForm,
      homogeneousComponent_eq_self hL]
  refine ⟨c,evaluatedGradient L 0,hc.ne',?_,hodd,?_⟩
  · intro hz
    have hLzero : L = 0 := by rw [hlinL,hz]; simp [linearForm]
    exact hFne (by rw [hback,hLzero,zero_pow hd.ne',mul_zero])
  · rwa [hlinL] at hback

end
end Source29LinearFactorPhaseRigidity


/- Final component: LowDimensionalRigidityInduction -/
namespace Source29LowDimensionalRigidityInduction

open MvPolynomial Source29LinearForm
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits Source29RadialPhaseChartInduction
open scoped BigOperators

noncomputable section

/-- Reindex the low-dimensional factor into the radial/normal/link coordinates
used by the compact curvature comparison. -/
theorem factor_degree_le_one (n : ℕ) (hn : n ≤ 4)
    (P Q : MvPolynomial (Fin (n+3)) ℝ) (k : ℕ) (hk : 0 < k)
    (hP : P.IsHomogeneous P.totalDegree) (hQ : Q.IsHomogeneous Q.totalDegree)
    (hirr : Irreducible P) (hF : leadingOperator (P^k*Q) = 0)
    (hQpos : ∀ x : Fin (n+3) → ℝ, x ≠ 0 → 0 < eval x Q)
    (hreg : ∀ x : Fin (n+3) → ℝ, x ≠ 0 → eval x P = 0 → evaluatedGradient P x ≠ 0)
    (hunit : ∃ x : Fin (n+3) → ℝ, eval x P = 0 ∧ (∑ j, (x j)^2) = 1) :
    P.totalDegree ≤ 1 := by
  let e : Fin (n+3) ≃ Option (Option (Fin (n+1))) := Fintype.equivOfCardEq (by simp)
  have hunit' (x : Option (Option (Fin (n+1))) → ℝ) (hx : (∑ j, (x j)^2) = 1) :
      (∑ j, ((x ∘ e) j)^2) = 1 := by
    change (∑ j, (x (e j))^2) = 1
    rwa [e.sum_comp (fun j => (x j)^2)]
  have hne (x : Option (Option (Fin (n+1))) → ℝ) (hx : (∑ j, (x j)^2) = 1) :
      x ∘ e ≠ 0 := by
    intro hz
    have he := hunit' x hx
    simp only [hz,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at he
    norm_num at he
  have hi : Irreducible (rename e P) := (MulEquiv.irreducible_iff (renameEquiv ℝ e)).mpr hirr
  have hL : leadingOperator ((rename e P)^k*rename e Q) = 0 := by
    change Source29FactorInheritance.cubicOperator ((rename e P)^k*rename e Q) = 0
    rw [← map_pow, ← map_mul, Source29PolynomialReindex.cubicOperator_rename]
    exact congrArg (rename e) hF
  have hpositive : ∀ x : Option (Option (Fin (n+1))) → ℝ,
      eval x (rename e P) = 0 ∧ (∑ j, (x j)^2) = 1 → 0 < eval x (rename e Q) := by
    intro x hx
    simpa only [eval_rename] using hQpos (x ∘ e) (hne x hx.2)
  have hregular : ∀ x : Option (Option (Fin (n+1))) → ℝ,
      eval x (rename e P) = 0 ∧ (∑ j, (x j)^2) = 1 →
      Source29PolynomialCurvaturePotential.gradientAt (rename e P) x ≠ 0 := by
    intro x hx
    apply Source29PolynomialReindex.gradientAt_rename_ne_zero e P x
    exact hreg (x ∘ e) (hne x hx.2) (by simpa only [eval_rename] using hx.1)
  have hnonempty : ∃ x : Option (Option (Fin (n+1))) → ℝ,
      eval x (rename e P) = 0 ∧ (∑ j, (x j)^2) = 1 := by
    obtain ⟨x,hx,hu⟩ := hunit
    refine ⟨x ∘ e.symm,?_,?_⟩
    · simpa only [eval_rename,Function.comp_assoc,e.symm_comp_self,Function.comp_id] using hx
    · change (∑ j, (x (e.symm j))^2) = 1
      rwa [e.symm.sum_comp (fun j => (x j)^2)]
  have hsmall := Source29CompactPositiveRootRigidity.degree_le_one
    (rename e P) (rename e Q) P.totalDegree Q.totalDegree k hk
    hP.rename_isHomogeneous hQ.rename_isHomogeneous hi hL
    (by simp) (by simpa using Nat.add_le_add_right hn 1) hpositive hregular hnonempty
  calc
    P.totalDegree = (rename e P).totalDegree := (totalDegree_renameEquiv e P).symm
    _ ≤ 1 := hsmall

/-- Rigidity in the preceding dimension supplies phase charts; the compact
positive-root comparison makes the unique real factor linear, completing
calibrated homogeneous rigidity in ambient dimensions three through seven. -/
theorem step (n : ℕ) (hn : n ≤ 4) (hIH : LinearRigidity (n+2)) : LinearRigidity (n+3) := by
  intro F d hhom hd hFne hF hcal
  have hcharts := fun x hx hzero => phase_chart_at_nonzero_zero hIH F d hhom hFne hF hcal x hx hzero
  obtain ⟨P,Q,k,hk,hodd,hirr,hP,hQ,hfac,hPQ,hunit,hreg,hQpos⟩ :=
    Source29HigherDimensionalPhaseStructure.exists_positive_regular_factor
      F d hd hFne hhom hF hcal hcharts
  have hsmall := factor_degree_le_one n hn P Q k hk hP hQ hirr (by rwa [← hfac]) hQpos hreg hunit
  have hdegree : P.totalDegree = 1 := by
    obtain ⟨x,hx,_⟩ := hunit
    have hpos := Source29GlobalPhaseFactor.totalDegree_pos_of_zero P hirr.ne_zero x hx
    omega
  have hlinear : P = linearForm (evaluatedGradient P 0) := by
    rw [← Source29RegularPhaseDensity.homogeneousComponent_one_eq_linearForm,
      homogeneousComponent_eq_self (show P.IsHomogeneous 1 by simpa only [hdegree] using hP)]
  have hb : evaluatedGradient P 0 ≠ 0 := by
    intro hz
    apply hirr.ne_zero
    rw [hlinear,hz]
    simp [linearForm]
  exact Source29LinearFactorPhaseRigidity.eq_odd_linear_power F Q d k hd
    (evaluatedGradient P 0) hb hodd hhom hFne hcal (by rwa [← hlinear]) hQpos

end
end Source29LowDimensionalRigidityInduction


/- Final component: FiniteDimensionalRigidity -/
namespace Source29FiniteDimensionalRigidity

open MvPolynomial
open Source29RadialPhaseChartInduction Source29GeometricPhaseChart
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits

noncomputable section

/-- Starting from the proved binary base, the regular-cone induction reaches
ambient dimension seven. -/
theorem linearRigidity_seven : LinearRigidity 7 := by
  have h2 := Source29HomogeneousTwoDimension.linearRigidity_two
  have h3 := Source29LowDimensionalRigidityInduction.step 0 (by omega) h2
  have h4 := Source29LowDimensionalRigidityInduction.step 1 (by omega) h3
  have h5 := Source29LowDimensionalRigidityInduction.step 2 (by omega) h4
  have h6 := Source29LowDimensionalRigidityInduction.step 3 (by omega) h5
  exact Source29LowDimensionalRigidityInduction.step 4 (by omega) h6

/-- The seven-dimensional classification gives actual analytic minimal phase
charts at every nonvertex zero in eight dimensions. -/
theorem phase_chart_dimension_eight
    (F : MvPolynomial (Fin 8) ℝ) (D : ℕ) (hhom : F.IsHomogeneous D)
    (hne : F ≠ 0) (hF : leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (p : Fin 8 → ℝ) (hp : p ≠ 0) (hzero : eval p F = 0) :
    HasFlatMinimalPhaseChart F p :=
  phase_chart_at_nonzero_zero linearRigidity_seven F D hhom hne hF hcal p hp hzero

/-- Apply the derived nonvertex charts to the leading form of every
polynomial minimal graph in eight variables. -/
theorem problem29 : Math30.Problem29 := by
  apply Source29PhaseChartsPositiveStructure.problem29_of_phase_charts_away_zero
  intro P hmin hdeg p hp hzero
  obtain ⟨hne,hhom,hL⟩ := QuarticPolynomialBasics.leading_component_data P hmin hdeg
  exact phase_chart_dimension_eight (homogeneousComponent P.totalDegree P) P.totalDegree
    hhom hne hL (Source29TopPhasePerimeter.top_weakCalibration P hmin hdeg) p hp hzero

end
