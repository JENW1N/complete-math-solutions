noncomputable section

section ArrayCalculus
variable {E I : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [Fintype I]

lemma second_sub (f g : E → ℝ) (x u v : E)
    (hf : AnalyticAt ℝ f x) (hg : AnalyticAt ℝ g x) :
    second (fun y => f y - g y) x u v = second f x u v - second g x u v := by
  have he : (fun y => fderiv ℝ (fun z => f z - g z) y v) =ᶠ[𝓝 x]
      (fun y => fderiv ℝ f y v - fderiv ℝ g y v) := by
    filter_upwards [hf.eventually_analyticAt, hg.eventually_analyticAt] with y hyf hyg
    rw [fderiv_fun_sub hyf.differentiableAt hyg.differentiableAt]
    rfl
  unfold second
  rw [he.fderiv_eq, fderiv_fun_sub
    (Source29NewtonRootHarmonic.analyticAt_directional f x v hf).differentiableAt
    (Source29NewtonRootHarmonic.analyticAt_directional g x v hg).differentiableAt]
  rfl

lemma second_dot (V W : E → I → ℝ) (x u v : E)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    second (fun y => dot (V y) (W y)) x u v =
      dot (fun i => second (fun y => V y i) x u v) (W x) +
      dot (V x) (fun i => second (fun y => W y i) x u v) +
      dot (fun i => fderiv ℝ (fun y => V y i) x u) (fun i => fderiv ℝ (fun y => W y i) x v) +
      dot (fun i => fderiv ℝ (fun y => V y i) x v) (fun i => fderiv ℝ (fun y => W y i) x u) := by
  unfold dot
  rw [second_sum Finset.univ (fun i y => V y i * W y i) x u v
    (fun i _ => (hV i).mul (hW i))]
  simp_rw [second_mul (fun y => V y _) (fun y => W y _) x u v (hV _) (hW _)]
  simp only [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma second_trace (H : E → I → I → ℝ) (x u v : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x) :
    second (fun y => trace (H y)) x u v =
      trace (fun i j => second (fun y => H y i j) x u v) :=
  second_sum Finset.univ (fun i y => H y i i) x u v (fun i _ => hH i i)

lemma second_bilinear (H : E → I → I → ℝ) (V W : E → I → ℝ) (x u v : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    second (fun y => bilinear (H y) (V y) (W y)) x u v =
      bilinear (fun i j => second (fun y => H y i j) x u v) (V x) (W x) +
      bilinear (H x) (fun i => second (fun y => V y i) x u v) (W x) +
      bilinear (H x) (V x) (fun i => second (fun y => W y i) x u v) +
      bilinear (fun i j => fderiv ℝ (fun y => H y i j) x u)
        (fun i => fderiv ℝ (fun y => V y i) x v) (W x) +
      bilinear (fun i j => fderiv ℝ (fun y => H y i j) x v)
        (fun i => fderiv ℝ (fun y => V y i) x u) (W x) +
      bilinear (fun i j => fderiv ℝ (fun y => H y i j) x u)
        (V x) (fun i => fderiv ℝ (fun y => W y i) x v) +
      bilinear (fun i j => fderiv ℝ (fun y => H y i j) x v)
        (V x) (fun i => fderiv ℝ (fun y => W y i) x u) +
      bilinear (H x) (fun i => fderiv ℝ (fun y => V y i) x u)
        (fun i => fderiv ℝ (fun y => W y i) x v) +
      bilinear (H x) (fun i => fderiv ℝ (fun y => V y i) x v)
        (fun i => fderiv ℝ (fun y => W y i) x u) := by
  have hi (i : I) :
      second (fun y => ∑ j : I, H y i j * V y i * W y j) x u v =
      ∑ j : I, second (fun y => H y i j * V y i * W y j) x u v :=
    second_sum Finset.univ (fun j y => H y i j * V y i * W y j) x u v
      (fun j _ => ((hH i j).mul (hV i)).mul (hW j))
  unfold bilinear
  rw [second_sum Finset.univ (fun i y => ∑ j : I, H y i j * V y i * W y j) x u v
    (fun i _ => Finset.analyticAt_fun_sum _
      (fun j _ => ((hH i j).mul (hV i)).mul (hW j)))]
  simp only [hi, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [second_mul (fun y => H y i j * V y i) (fun y => W y j) x u v
    ((hH i j).mul (hV i)) (hW j),
    second_mul (fun y => H y i j) (fun y => V y i) x u v (hH i j) (hV i),
    first_mul (fun y => H y i j) (fun y => V y i) x u (hH i j) (hV i),
    first_mul (fun y => H y i j) (fun y => V y i) x v (hH i j) (hV i)]
  ring

end ArrayCalculus

section Coordinates
variable {I : Type*} [Fintype I] [DecidableEq I]

def fourth (f : (I → ℝ) → ℝ) (x : I → ℝ) (a b c d : I) : ℝ :=
  coordPartial (coordPartial (coordPartial (coordPartial f d) c) b) a x

lemma fourth_swap12 (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (a b c d : I) :
    fourth f x a b c d = fourth f x b a c d :=
  hess_symm _ x (hess_analyticAt f x hf c d) a b

lemma fourth_swap23 (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (a b c d : I) :
    fourth f x a b c d = fourth f x a c b d :=
  third_swap23 (coordPartial f d) x (partial_analyticAt f x hf d) a b c

lemma fourth_swap34 (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (a b c d : I) :
    fourth f x a b c d = fourth f x a b d c := by
  have he : (fun y => third f y b c d) =ᶠ[𝓝 x] (fun y => third f y b d c) :=
    hf.eventually_analyticAt.mono (fun y hy => third_swap23 f y hy b c d)
  exact congrArg (fun D : (I → ℝ) →L[ℝ] ℝ => D (Pi.single a 1)) he.fderiv_eq

end Coordinates

section NormalTrace
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Twice differentiating the local analytic cubic equation yields the
fourth-order trace needed by the normalized Simons tensor. -/
theorem second_derivative_trace
    (f : (Option I → ℝ) → ℝ) (x : Option I → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f x) (hL : ∀ᶠ y in 𝓝 x, levelOperator f y = 0)
    (hgn : grad f x none = g) (hgt : ∀ i, grad f x (some i) = 0) (a b : Option I) :
    g^2 * (∑ i, fourth f x a b (some i) (some i)) =
      2 * (∑ i, ∑ j, hess f x a (some i) * hess f x b (some j) * hess f x (some i) (some j)) -
      2 * hess f x none none * (∑ i, hess f x a (some i) * hess f x b (some i)) +
      2 * g * (∑ i, (third f x a b (some i) * hess f x none (some i) +
        hess f x a (some i) * third f x b none (some i) +
        hess f x b (some i) * third f x a none (some i))) -
      2 * hess f x a none * (∑ i, hess f x b (some i) * hess f x none (some i)) -
      2 * hess f x b none * (∑ i, hess f x a (some i) * hess f x none (some i)) := by
  have hV : ∀ i, AnalyticAt ℝ (fun y => grad f y i) x := fun i => partial_analyticAt f x hf i
  have hH : ∀ i j, AnalyticAt ℝ (fun y => hess f y i j) x := hess_analyticAt f x hf
  have ht := tangential_trace_zero f x g hg hL.self_of_nhds hgn hgt
  have ha := derivative_trace f x g hg hf hL hgn hgt a
  have hb := derivative_trace f x g hg hf hL hgn hgt b
  have he : second (levelOperator f) x (Pi.single a 1) (Pi.single b 1) = 0 := by
    have heq : levelOperator f =ᶠ[𝓝 x] (fun _ => 0) := hL
    have hd : (fun y => fderiv ℝ (levelOperator f) y (Pi.single b 1)) =ᶠ[𝓝 x] (fun _ => 0) := by
      filter_upwards [heq.fderiv (𝕜 := ℝ)] with y hy
      rw [hy]
      simp
    unfold second
    rw [hd.fderiv_eq]
    simp
  unfold levelOperator cubicLevel at he
  rw [second_sub (fun y => dot (grad f y) (grad f y) * trace (hess f y))
    (fun y => bilinear (hess f y) (grad f y) (grad f y)) x (Pi.single a 1) (Pi.single b 1)
    ((analyticAt_dot _ _ _ hV hV).mul (analyticAt_trace _ _ hH))
    (analyticAt_bilinear _ _ _ _ hH hV hV)] at he
  rw [second_mul (fun y => dot (grad f y) (grad f y)) (fun y => trace (hess f y))
    x (Pi.single a 1) (Pi.single b 1)
    (analyticAt_dot _ _ _ hV hV) (analyticAt_trace _ _ hH),
    second_dot _ _ _ _ _ hV hV, second_trace _ _ _ _ hH,
    first_dot _ _ _ _ hV hV, first_trace _ _ _ hH,
    first_dot _ _ _ _ hV hV, first_trace _ _ _ hH,
    second_bilinear _ _ _ _ _ _ hH hV hV] at he
  change dot (grad f x) (grad f x) * trace (fourth f x a b) +
    trace (hess f x) *
      (dot (third f x a b) (grad f x) + dot (grad f x) (third f x a b) +
        dot (hess f x a) (hess f x b) + dot (hess f x b) (hess f x a)) +
    (dot (hess f x a) (grad f x) + dot (grad f x) (hess f x a)) * trace (third f x b) +
    trace (third f x a) * (dot (hess f x b) (grad f x) + dot (grad f x) (hess f x b)) -
    (bilinear (fourth f x a b) (grad f x) (grad f x) +
      bilinear (hess f x) (third f x a b) (grad f x) +
      bilinear (hess f x) (grad f x) (third f x a b) +
      bilinear (third f x a) (hess f x b) (grad f x) +
      bilinear (third f x b) (hess f x a) (grad f x) +
      bilinear (third f x a) (grad f x) (hess f x b) +
      bilinear (third f x b) (grad f x) (hess f x a) +
      bilinear (hess f x) (hess f x a) (hess f x b) +
      bilinear (hess f x) (hess f x b) (hess f x a)) = 0 at he
  have hs : ∀ i, hess f x (some i) none = hess f x none (some i) :=
    fun i => hess_symm f x hf _ _
  have hta : ∀ i, third f x a (some i) none = third f x a none (some i) :=
    fun i => third_swap23 f x hf _ _ _
  have htb : ∀ i, third f x b (some i) none = third f x b none (some i) :=
    fun i => third_swap23 f x hf _ _ _
  simp only [dot, trace, bilinear, Fintype.sum_option, hgn, hgt, hs, hta, htb, ht,
    zero_mul, mul_zero, Finset.sum_const_zero, add_zero] at he
  simp only [mul_add, add_mul, Finset.sum_add_distrib, ← Finset.sum_mul] at he
  ring_nf at he
  simp only [mul_assoc, ← Finset.mul_sum] at he
  have hcross : (∑ i, ∑ j, hess f x (some i) (some j) *
      (hess f x b (some i) * hess f x a (some j))) =
      ∑ i, ∑ j, hess f x (some i) (some j) *
        (hess f x b (some j) * hess f x a (some i)) := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hess_symm f x hf (some j) (some i)]
  simp only [mul_comm, mul_left_comm, mul_assoc] at he ha hb hcross ⊢
  rw [hcross] at he
  simp only [Finset.sum_add_distrib]
  linear_combination he - 2 * hess f x a none * hb - 2 * hess f x b none * ha

end NormalTrace
end
end Source29AnalyticSecondTrace

/- Component: AnalyticNormalizedHessianCurve.inc -/
namespace Source29AnalyticNormalizedHessianCurve

open Filter Source29AnalyticNormalTrace Source29AnalyticTensorNorm
open Source29AnalyticCurveCoordinateJets
open Source29PolynomialLinkChart (Ambient base)
open Source29NormalizedLinkJets (tangent)
open scoped Topology BigOperators

noncomputable section

section Coordinates
variable {I : Type*} [Fintype I] [DecidableEq I]

def profile (f : (I → ℝ) → ℝ) (x : I → ℝ) : ℝ := (tensorNorm (grad f x))⁻¹

def normalizedHessian (f : (I → ℝ) → ℝ) (C : ℝ → I → ℝ)
    (a b : I) (t : ℝ) : ℝ := profile f (C t) * hess f (C t) a b

theorem profile_pos (f : (I → ℝ) → ℝ) (x : I → ℝ) (hreg : grad f x ≠ 0) :
    0 < profile f x := inv_pos.mpr (tensorNorm_pos hreg)

theorem profile_analyticAt (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (hreg : grad f x ≠ 0) :
    AnalyticAt ℝ (profile f) x :=
  (tensorNorm_analyticAt (grad f) x (partial_analyticAt f x hf) hreg).inv
    (tensorNorm_pos hreg).ne'

theorem normalizedHessian_analyticAt (f : (I → ℝ) → ℝ) (C : ℝ → I → ℝ)
    (hf : AnalyticAt ℝ f (C 0)) (hC : AnalyticAt ℝ C 0)
    (hreg : grad f (C 0) ≠ 0) (a b : I) :
    AnalyticAt ℝ (normalizedHessian f C a b) 0 :=
  ((profile_analyticAt f (C 0) hf hreg).comp hC).mul
    ((hess_analyticAt f (C 0) hf a b).comp hC)

end Coordinates

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [Fintype ι] in
theorem regular_at_base (f : Ambient ι → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hgn : grad f base none = g) : grad f base ≠ 0 := by
  intro he
  have hn := congrFun he none
  exact hg (by simpa only [hgn, Pi.zero_apply] using hn)

theorem profile_at_base (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0) :
    profile f base = g⁻¹ := by
  simp [profile, tensorNorm, Fintype.sum_option, hgn, hgt, Real.sqrt_sq hg.le]

theorem profile_tangent_deriv (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (fun t => profile f (C t)) 0 = -hess f base (tangent i) none / g^2 := by
  let G := fun a t => grad f (C t) a
  let q := fun t => tensorNorm (fun a => G a t)
  have hG : ∀ a, AnalyticAt ℝ (G a) 0 := fun a =>
    ((hC0.symm ▸ partial_analyticAt f base hf a).comp hC)
  have hq0 : q 0 = g := by
    simp [q, G, hC0, tensorNorm, Fintype.sum_option, hgn, hgt, Real.sqrt_sq hg.le]
  have hreg : (fun a => G a 0) ≠ 0 := by
    simpa only [G, hC0] using regular_at_base f g hg.ne' hgn
  have hq : AnalyticAt ℝ q 0 := tensorNorm_analyticAt _ _ hG hreg
  have hnorm := (Source29AnalyticNormDerivatives.norm_first_second q G hq hG
    (Eventually.of_forall (fun t => tensorNorm_sq (fun a => G a t)))).1
  have hgrad : ∀ a, G a 0 = grad f base a := by intro a; simp only [G, hC0]
  simp only [hq0, hgrad, Fintype.sum_option, hgn, hgt, zero_mul,
    Finset.sum_const_zero, add_zero] at hnorm
  have hq1 : deriv q 0 = hess f base (tangent i) none := by
    rw [mul_left_cancel₀ hg.ne' hnorm]
    exact coordinate_velocity_first (coordPartial f none)
      (fun a t => C t a) base (tangent i) (partial_analyticAt f base hf none)
      (analyticAt_pi_iff.mp hC) (fun a => congrFun hC0 a) hC1
  change deriv (fun t => (q t)⁻¹) 0 = _
  have he := (hq.differentiableAt.hasDerivAt.inv (by simpa only [hq0] using hg.ne')).deriv
  simp only [Pi.inv_def] at he
  rw [he, hq0, hq1]

theorem normalizedHessian_zero (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC0 : C 0 = base) (a b : Option (Option ι)) :
    normalizedHessian f C a b 0 = hess f base a b / g := by
  rw [normalizedHessian, hC0, profile_at_base f g hg hgn hgt]
  ring

theorem normalizedHessian_first (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) (a b : Option (Option ι)) :
    deriv (normalizedHessian f C a b) 0 =
      (third f base (tangent i) a b -
        hess f base (tangent i) none * hess f base a b / g) / g := by
  have hφ := ((hC0.symm ▸ profile_analyticAt f base hf
    (regular_at_base f g hg.ne' hgn)).comp hC)
  have hH := ((hC0.symm ▸ hess_analyticAt f base hf a b).comp hC)
  have he := (hφ.differentiableAt.hasDerivAt.mul hH.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  unfold normalizedHessian
  rw [he, profile_tangent_deriv f g hg hf hgn hgt C hC hC0 i hC1,
    coordinate_velocity_first (fun x => hess f x a b) (fun c t => C t c)
      base (tangent i) (hess_analyticAt f base hf a b)
      (analyticAt_pi_iff.mp hC) (fun c => congrFun hC0 c) hC1,
    hC0, profile_at_base f g hg hgn hgt]
  change -hess f base (tangent i) none / g^2 * hess f base a b +
    g⁻¹ * third f base (tangent i) a b = _
  field_simp
  ring

/-- The second derivative of the actual normalized Hessian along a link
curve; the radial third jet is supplied directly by real homogeneity. -/
theorem normalizedHessian_second (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, deriv (deriv (fun t => C t a)) 0 =
      -base a - (hess f base (tangent i) (tangent i) / g) *
        Pi.single (M := fun _ => ℝ) none 1 a)
    (a b : Option (Option ι))
    (hrad : third f base (some none) a b = (D-2)*hess f base a b) :
    deriv (deriv (normalizedHessian f C a b)) 0 =
      hess f base a b * deriv (deriv (fun t => profile f (C t))) 0 -
        2 * hess f base (tangent i) none * third f base (tangent i) a b / g^2 +
        (coordPartial (fun x => third f x (tangent i) a b) (tangent i) base -
          (D-2)*hess f base a b -
          (hess f base (tangent i) (tangent i)/g)*third f base none a b) / g := by
  let H := fun t => hess f (C t) a b
  have hH : AnalyticAt ℝ H 0 := (hC0.symm ▸ hess_analyticAt f base hf a b).comp hC
  have hH0 : H 0 = hess f base a b := by simp only [H, hC0]
  have hH1 : deriv H 0 = third f base (tangent i) a b :=
    coordinate_velocity_first (fun x => hess f x a b) (fun c t => C t c)
      base (tangent i) (hess_analyticAt f base hf a b)
      (analyticAt_pi_iff.mp hC) (fun c => congrFun hC0 c) hC1
  have hH2 : deriv (deriv H) 0 =
      coordPartial (fun x => third f x (tangent i) a b) (tangent i) base -
        (D-2)*hess f base a b -
        (hess f base (tangent i) (tangent i)/g)*third f base none a b := by
    have he := coordinate_velocity_second (fun x => hess f x a b)
      (fun c t => C t c) base (tangent i) (hess_analyticAt f base hf a b)
      (analyticAt_pi_iff.mp hC) (fun c => congrFun hC0 c) hC1
    change deriv (deriv H) 0 =
      coordPartial (fun x => third f x (tangent i) a b) (tangent i) base +
        ∑ c, third f base c a b * deriv (deriv (fun t => C t c)) 0 at he
    rw [he]
    have hb : ∀ c, (base : Ambient ι) c = if c = some none then 1 else 0 := by
      intro c
      simp [base, Pi.single_apply]
    simp only [hC2, hb, Pi.single_apply, mul_sub, mul_neg, mul_ite,
      mul_one, mul_zero, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    rw [hrad]
    ring
  have hφ := (hC0.symm ▸ profile_analyticAt f base hf
    (regular_at_base f g hg.ne' hgn)).comp hC
  change deriv (deriv (fun t => profile f (C t) * H t)) 0 = _
  rw [Source29AnalyticInverseNorm.second_deriv_product (fun t => profile f (C t)) H hφ hH, hH0, hH1, hH2,
    profile_tangent_deriv f g hg hf hgn hgt C hC hC0 i hC1,
    hC0, profile_at_base f g hg hgn hgt]
  ring

end
end Source29AnalyticNormalizedHessianCurve

/- Component: ClosestPairStationarity.inc -/
namespace Source29ClosestPairStationarity

open Filter Source29SynchronizedCurveFrankel Source29AnalyticNormDerivatives
open scoped Topology BigOperators Matrix

noncomputable section
variable {κ : Type*} [Fintype κ]

/-- Differentiating the actual local sphere constraint makes every curve
velocity perpendicular to its base point. -/
theorem velocity_orthogonal_base (C : ℝ → κ → ℝ) (x : κ → ℝ)
    (hC : ∀ a, AnalyticAt ℝ (fun t ↦ C t a) 0) (hC0 : C 0 = x)
    (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2 = 1) :
    x ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0) = 0 := by
  have heq : (fun t ↦ ∑ a, (C t a)^2) =ᶠ[𝓝 0] (fun _ ↦ (1 : ℝ)) := hunit
  have hd := heq.deriv_eq
  rw [first_deriv_sum (fun a t ↦ (C t a)^2) (fun a ↦ (hC a).pow 2),
    deriv_const] at hd
  simp_rw [first_deriv_square _ (hC _),hC0] at hd
  have he : (∑ a, 2*x a*deriv (fun t ↦ C t a) 0) =
      2*(x ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0)) := by
    simp only [dotProduct,Finset.mul_sum,mul_assoc]
  rw [he] at hd
  linarith

/-- The first variation of distance at a closest pair makes the velocity
perpendicular to the opposite endpoint as well. -/
theorem velocity_orthogonal_opposite (C : ℝ → κ → ℝ) (x y : κ → ℝ)
    (hC : ∀ a, AnalyticAt ℝ (fun t ↦ C t a) 0) (hC0 : C 0 = x)
    (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2 = 1)
    (hmin : IsLocalMin (fun t ↦ squaredDistance (C t) y) 0) :
    y ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0) = 0 := by
  have hd := hmin.deriv_eq_zero
  change deriv (fun t ↦ ∑ a, (C t a-y a)^2) 0 = 0 at hd
  rw [first_deriv_sum (fun a t ↦ (C t a-y a)^2)
    (fun a ↦ ((hC a).sub analyticAt_const).pow 2)] at hd
  have hder (a : κ) : deriv (fun t ↦ C t a-y a) 0 = deriv (fun t ↦ C t a) 0 := by
    simpa only [sub_zero] using ((hC a).differentiableAt.hasDerivAt.sub_const (y a)).deriv
  have hdj (a : κ) : deriv (fun t ↦ (C t a-y a)^2) 0 =
      2*(x a-y a)*deriv (fun t ↦ C t a) 0 := by
    rw [first_deriv_square (fun t ↦ C t a-y a) ((hC a).sub analyticAt_const),hder,hC0]
  simp_rw [hdj] at hd
  have he : (∑ a, 2*(x a-y a)*deriv (fun t ↦ C t a) 0) =
      2*((x ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0))-
         (y ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0))) := by
    simp only [dotProduct,← Finset.sum_sub_distrib,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    ring
  rw [he,velocity_orthogonal_base C x hC hC0 hunit] at hd
  linarith

/-- Set-level stationarity uses only actual local curve membership. -/
theorem closest_pair_velocity (S T : Set (κ → ℝ)) (x y : κ → ℝ) (hy : y ∈ T)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (C : ℝ → κ → ℝ) (hC : ∀ a, AnalyticAt ℝ (fun t ↦ C t a) 0)
    (hC0 : C 0 = x) (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2 = 1)
    (hmem : ∀ᶠ t in 𝓝 0, C t ∈ S) :
    x ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0) = 0 ∧
    y ⬝ᵥ (fun a ↦ deriv (fun t ↦ C t a) 0) = 0 := by
  refine ⟨velocity_orthogonal_base C x hC hC0 hunit,
    velocity_orthogonal_opposite C x y hC hC0 hunit ?_⟩
  change ∀ᶠ t in 𝓝 0, squaredDistance (C 0) y ≤ squaredDistance (C t) y
  filter_upwards [hmem] with t ht
  simpa only [hC0] using hclosest (C t) ht y hy

variable [DecidableEq κ]

def column (U : Matrix κ κ ℝ) (i : κ) : κ → ℝ := fun a ↦ U a i

lemma column_dot (U : Matrix κ κ ℝ) (hU : U.transpose*U = 1) (i j : κ) :
    column U i ⬝ᵥ column U j = if i=j then 1 else 0 := by
  have h := congrArg (fun M : Matrix κ κ ℝ ↦ M i j) hU
  simpa only [column,dotProduct,Matrix.mul_apply,Matrix.transpose_apply,Matrix.one_apply] using h

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Vanishing tangent coordinates in an orthogonal frame puts the opposite
endpoint in the radial-normal plane, with explicit coefficients. -/
theorem radial_normal_decomposition (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hU : U*U.transpose = 1) (y : Option (Option ι) → ℝ)
    (hy : ∀ i, column U (some (some i)) ⬝ᵥ y = 0) :
    y = (column U (some none) ⬝ᵥ y) • column U (some none) +
        (column U none ⬝ᵥ y) • column U none := by
  have h := congrArg (fun M ↦ M *ᵥ y) hU
  rw [← Matrix.mulVec_mulVec,Matrix.one_mulVec] at h
  ext a
  have ha := congrFun h a
  change (∑ b, U a b*(column U b ⬝ᵥ y)) = y a at ha
  simp only [Fintype.sum_option,hy,mul_zero,Finset.sum_const_zero,add_zero] at ha
  change y a=(column U (some none) ⬝ᵥ y)*U a (some none)+(column U none ⬝ᵥ y)*U a none
  rw [← ha]
  ring

omit [DecidableEq κ] in
/-- At nonidentical, nonantipodal unit endpoints, the normal coefficient of
that decomposition is nonzero. -/
theorem normal_coefficient_ne_zero
    (x y n : κ → ℝ) (hx : x ⬝ᵥ x = 1) (hy : y ⬝ᵥ y = 1)
    (hdecomp : y = (x ⬝ᵥ y) • x + (n ⬝ᵥ y) • n)
    (hne : y ≠ x) (hanti : y ≠ -x) : n ⬝ᵥ y ≠ 0 := by
  intro hzero
  have he : y = (x ⬝ᵥ y) • x := by simpa only [hzero,zero_smul,add_zero] using hdecomp
  have hs : (x ⬝ᵥ y)^2 = 1 := by
    conv_lhs at hy => rw [he]
    simpa only [dotProduct_smul,smul_dotProduct,smul_eq_mul,hx,mul_one,pow_two] using hy
  have hp : x ⬝ᵥ y = 1 ∨ x ⬝ᵥ y = -1 := by
    have hh : (x ⬝ᵥ y-1)*(x ⬝ᵥ y+1) = 0 := by nlinarith
    rcases mul_eq_zero.mp hh with hh | hh
    · left; linarith
    · right; linarith
  rcases hp with hp | hp
  · exact hne (by simpa only [hp,one_smul] using he)
  · exact hanti (by simpa only [hp,neg_one_smul] using he)

end
end Source29ClosestPairStationarity

/- Component: ClosestPairCommonFrame.inc -/
namespace Source29ClosestPairCommonFrame

open Filter Source29ClosestPairStationarity Source29AnalyticPairRotation
open Source29SynchronizedCurveFrankel
open scoped Topology BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Stationarity identifies the tangent hyperplanes at a nonidentical,
nonantipodal closest pair. An orthogonal matrix at the second endpoint
can therefore retain every tangent column of the first matrix. -/
theorem common_frame
    (U V : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (hU : U.transpose*U=1) (hV : V.transpose*V=1)
    (x y : (Option (Option ι)) → ℝ) (hUx : column U (some none)=x) (hVy : column V (some none)=y)
    (hne : y ≠ x) (hanti : y ≠ -x)
    (hstatU : ∀ i, column U (some (some i)) ⬝ᵥ y=0)
    (hstatV : ∀ i, column V (some (some i)) ⬝ᵥ x=0) :
    ∃ W : Matrix (Option (Option ι)) (Option (Option ι)) ℝ, W.transpose*W=1 ∧ W*W.transpose=1 ∧
      column W (some none)=y ∧
      (∀ i, column W (some (some i))=column U (some (some i))) ∧
      (column W none=column V none ∨ column W none= -column V none) := by
  have hx : x ⬝ᵥ x=1 := by simpa only [hUx,ite_true] using column_dot U hU (some none) (some none)
  have hy : y ⬝ᵥ y=1 := by simpa only [hVy,ite_true] using column_dot V hV (some none) (some none)
  have hxt (i : ι) : x ⬝ᵥ column U (some (some i))=0 := by
    simpa only [hUx,Option.some.injEq,reduceCtorEq,ite_false] using column_dot U hU (some none) (some (some i))
  have hyt (i : ι) : y ⬝ᵥ column U (some (some i))=0 := by
    rw [dotProduct_comm]; exact hstatU i
  have hdecomp : x=(y ⬝ᵥ x) • y + (column V none ⬝ᵥ x) • column V none := by
    simpa only [hVy] using radial_normal_decomposition V (mul_eq_one_comm.mp hV) x hstatV
  have hb : column V none ⬝ᵥ x ≠ 0 := by
    apply normal_coefficient_ne_zero y x (column V none) hy hx hdecomp (Ne.symm hne)
    intro he
    apply hanti
    simp only [he,neg_neg]
  have hnt (i : ι) : column V none ⬝ᵥ column U (some (some i))=0 := by
    have he := congrArg (fun z ↦ z ⬝ᵥ column U (some (some i))) hdecomp
    rw [hxt,add_dotProduct,smul_dotProduct,smul_dotProduct,hyt,smul_eq_mul,
      smul_eq_mul,mul_zero,zero_add] at he
    exact (mul_eq_zero.mp he.symm).resolve_left hb
  let W : Matrix (Option (Option ι)) (Option (Option ι)) ℝ := fun a b ↦ rotation x y (column U b) a
  have hcol (b : (Option (Option ι))) : column W b=rotation x y (column U b) := rfl
  have hW : W.transpose*W=1 := by
    ext i j
    change column W i ⬝ᵥ column W j = (1 : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) i j
    rw [hcol,hcol,rotation_dot,column_dot U hU,Matrix.one_apply]
  have hWr : column W (some none)=y := by
    rw [hcol,hUx,rotation_move x y (hx.trans hy.symm)]
  have hWt (i : ι) : column W (some (some i))=column U (some (some i)) := by
    rw [hcol,rotation_fix x y _ (hxt i) (hyt i)]
  have hnrad : column W (some none) ⬝ᵥ column V none=0 := by
    rw [hWr,← hVy]
    simpa only [reduceCtorEq,ite_false] using column_dot V hV (some none) none
  have hntan (i : ι) : column W (some (some i)) ⬝ᵥ column V none=0 := by
    rw [hWt,dotProduct_comm]
    exact hnt i
  have hline : column V none = (column W none ⬝ᵥ column V none) • column W none := by
    simpa only [hnrad,zero_smul,zero_add] using
      radial_normal_decomposition W (mul_eq_one_comm.mp hW) (column V none) hntan
  have hnV : column V none ⬝ᵥ column V none=1 := by
    simpa only [ite_true] using column_dot V hV none none
  have hnW : column W none ⬝ᵥ column W none=1 := by
    simpa only [ite_true] using column_dot W hW none none
  have hs : (column W none ⬝ᵥ column V none)^2=1 := by
    conv_lhs at hnV => rw [hline]
    simpa only [dotProduct_smul,smul_dotProduct,smul_eq_mul,hnW,mul_one,pow_two] using hnV
  have hp : column W none ⬝ᵥ column V none=1 ∨ column W none ⬝ᵥ column V none= -1 := by
    have hz : (column W none ⬝ᵥ column V none-1)*
        (column W none ⬝ᵥ column V none+1)=0 := by nlinarith
    rcases mul_eq_zero.mp hz with hz | hz
    · left; linarith
    · right; linarith
  refine ⟨W,hW,mul_eq_one_comm.mp hW,hWr,hWt,?_⟩
  rcases hp with hp | hp
  · left
    simpa only [hp,one_smul] using hline.symm
  · right
    have he : column V none= -column W none := by simpa only [hp,neg_one_smul] using hline
    rw [he,neg_neg]

/-- The common frame follows from actual local spherical curves at a closest
pair. A nonzero tangent direction also excludes the antipodal case. -/
theorem common_frame_of_closest_pair
    (S T : Set ((Option (Option ι)) → ℝ)) (x y : (Option (Option ι)) → ℝ) (hx : x ∈ S) (hy : y ∈ T)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (U V : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (hU : U.transpose*U=1) (hV : V.transpose*V=1)
    (hUx : column U (some none)=x) (hVy : column V (some none)=y)
    (hne : y ≠ x) (i0 : ι)
    (C D : ι → ℝ → (Option (Option ι)) → ℝ)
    (hC : ∀ i a, AnalyticAt ℝ (fun t ↦ C i t a) 0)
    (hD : ∀ i a, AnalyticAt ℝ (fun t ↦ D i t a) 0)
    (hC0 : ∀ i, C i 0=x) (hD0 : ∀ i, D i 0=y)
    (hCunit : ∀ i, ∀ᶠ t in 𝓝 0, ∑ a, (C i t a)^2=1)
    (hDunit : ∀ i, ∀ᶠ t in 𝓝 0, ∑ a, (D i t a)^2=1)
    (hCmem : ∀ i, ∀ᶠ t in 𝓝 0, C i t ∈ S)
    (hDmem : ∀ i, ∀ᶠ t in 𝓝 0, D i t ∈ T)
    (hCv : ∀ i a, deriv (fun t ↦ C i t a) 0=U a (some (some i)))
    (hDv : ∀ i a, deriv (fun t ↦ D i t a) 0=V a (some (some i))) :
    ∃ W : Matrix (Option (Option ι)) (Option (Option ι)) ℝ, W.transpose*W=1 ∧ W*W.transpose=1 ∧
      column W (some none)=y ∧
      (∀ i, column W (some (some i))=column U (some (some i))) ∧
      (column W none=column V none ∨ column W none= -column V none) := by
  have hswap (a b : (Option (Option ι)) → ℝ) : squaredDistance a b=squaredDistance b a := by
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hclosest' : ∀ z ∈ T, ∀ w ∈ S, squaredDistance y x ≤ squaredDistance z w := by
    intro z hz w hw
    rw [hswap y x,hswap z w]
    exact hclosest w hw z hz
  have hstatU (i : ι) : column U (some (some i)) ⬝ᵥ y=0 := by
    have hs := (closest_pair_velocity S T x y hy hclosest (C i) (hC i)
      (hC0 i) (hCunit i) (hCmem i)).2
    simp only [hCv] at hs
    rw [dotProduct_comm]
    exact hs
  have hstatV (i : ι) : column V (some (some i)) ⬝ᵥ x=0 := by
    have hs := (closest_pair_velocity T S y x hx hclosest' (D i) (hD i)
      (hD0 i) (hDunit i) (hDmem i)).2
    simp only [hDv] at hs
    rw [dotProduct_comm]
    exact hs
  have hxunit : ∑ a, (x a)^2=1 := by
    have hh := column_dot U hU (some none) (some none)
    simpa only [hUx,ite_true,dotProduct,pow_two] using hh
  have hvelocity : ∃ a, deriv (fun t ↦ C i0 t a) 0 ≠ 0 := by
    by_contra hh
    push Not at hh
    have hz : column U (some (some i0))=0 := by
      ext a
      change U a (some (some i0))=0
      simpa only [hCv] using hh a
    have hn := column_dot U hU (some (some i0)) (some (some i0))
    simp only [hz,dotProduct_zero,ite_true] at hn
    norm_num at hn
  have hanti := Source29AntipodalLinkExclusion.closest_pair_not_antipodal S T x y hy
    hclosest (C i0) (hC0 i0) hxunit (hCunit i0) (hCmem i0) hvelocity
  exact common_frame U V hU hV x y hUx hVy hne hanti hstatU hstatV

end
end Source29ClosestPairCommonFrame

/- Component: RegularLinkCurvesInFrame.inc -/
namespace Source29RegularLinkCurvesInFrame

open Filter MvPolynomial Source29PolynomialLinkChart Source29ClosestPairStationarity
open Source29QuarticReuse.QuarticMinimal
open scoped Topology BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Actual minimal spherical-link curves in any prescribed radial-normal
orthogonal frame. Only pointwise vanishing of the cubic operator is used. -/
theorem exists_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hd : 1 ≤ d) (hP : P.IsHomogeneous d)
    (x : (Option (Option ι)) → ℝ) (hzero : eval x P=0)
    (hL : eval x (Source29FactorInheritance.cubicOperator P)=0)
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (hU : U.transpose*U=1) (hUx : column U (some none)=x)
    (g : ℝ) (hg : g ≠ 0) (hgrad : ∀ a, eval x (pderiv a P)=g*U a none) :
    ∃ C : ι → ℝ → (Option (Option ι)) → ℝ,
      (∀ i a, AnalyticAt ℝ (fun t ↦ C i t a) 0) ∧
      (∀ i, C i 0=x) ∧
      (∀ i, ∀ᶠ t in 𝓝 0, eval (C i t) P=0) ∧
      (∀ i, ∀ᶠ t in 𝓝 0, ∑ a, (C i t a)^2=1) ∧
      (∀ i a, deriv (fun t ↦ C i t a) 0=U a (some (some i))) ∧
      (∀ a, (∑ i, deriv (deriv (fun t ↦ C i t a)) 0)= -(Fintype.card ι : ℝ)*x a) := by
  have hbase : U *ᵥ base=x := by
    funext a
    have he := congrFun hUx a
    simpa only [Matrix.mulVec,dotProduct,base,Pi.single_apply,mul_ite,mul_one,mul_zero,
      Finset.sum_ite_eq',Finset.mem_univ,ite_true,column] using he
  have hpartial (j : (Option (Option ι))) : eval base (pderiv j (changeVariables U P))=
      g*(if none=j then 1 else 0) := by
    rw [pderiv_changeVariables,map_sum]
    simp only [map_mul,eval_C,eval_changeVariables,hbase]
    simp_rw [hgrad,mul_assoc]
    rw [← Finset.mul_sum]
    exact congrArg (fun q : ℝ ↦ g*q) (column_dot U hU none j)
  have hQzero : eval base (changeVariables U P)=0 := by
    rw [eval_changeVariables,hbase,hzero]
  have hQL : eval base (Source29FactorInheritance.cubicOperator (changeVariables U P))=0 := by
    change eval base (leadingOperator (changeVariables U P))=0
    rw [leadingOperator_changeVariables U (mul_eq_one_comm.mp hU),eval_changeVariables,hbase]
    exact hL
  obtain ⟨γ,hγ,hγ0,hγzero,hγunit,hγv,hγacc⟩ :=
    Source29RegularLinkMeanAcceleration.exists_regular_link_curves (changeVariables U P) d hd
      (isHomogeneous_changeVariables U P d hP) g hg hQzero
      (by simpa using hpartial none) (fun j ↦ by simpa using hpartial (some j)) hQL
  let C : ι → ℝ → (Option (Option ι)) → ℝ := fun i t ↦ U *ᵥ γ i t
  have hC (i : ι) : AnalyticAt ℝ (C i) 0 :=
    Source29LinearCurveTransport.analytic_mulVec U (fun a t ↦ γ i t a) (hγ i)
  refine ⟨C,fun i ↦ analyticAt_pi_iff.mp (hC i),?_,?_,?_,?_,?_⟩
  · intro i
    change U *ᵥ γ i 0=x
    rw [hγ0,hbase]
  · intro i
    filter_upwards [hγzero i] with t ht
    change eval (U *ᵥ γ i t) P=0
    rw [← eval_changeVariables]
    exact ht
  · intro i
    filter_upwards [hγunit i] with t ht
    change (∑ a, (U *ᵥ γ i t) a ^ 2)=1
    rw [Source29PolynomialJacobiTransport.norm_square_mulVec U hU]
    exact ht
  · intro i a
    change deriv (fun t ↦ (U *ᵥ γ i t) a) 0=U a (some (some i))
    rw [Source29LinearCurveTransport.first_mulVec U (fun b t ↦ γ i t b) (hγ i) a]
    simp only [hγv,Pi.single_apply,mul_ite,mul_one,mul_zero,Finset.sum_ite_eq',
      Finset.mem_univ,ite_true]
  · intro a
    change (∑ i, deriv (deriv (fun t ↦ (U *ᵥ γ i t) a)) 0)= _
    simp_rw [Source29LinearCurveTransport.second_mulVec U (fun b t ↦ γ _ t b) (hγ _) a]
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum,hγacc]
    calc
      (∑ b, U a b * (-(Fintype.card ι : ℝ)*base b)) =
          -(Fintype.card ι : ℝ)*(U *ᵥ base) a := by
        change (∑ b, U a b * (-(Fintype.card ι : ℝ)*base b)) =
          -(Fintype.card ι : ℝ)*(∑ b, U a b*base b)
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro b _
        ring
      _ = _ := by rw [hbase]

end
end Source29RegularLinkCurvesInFrame

/- Component: RegularPolynomialLinkFrankel.inc -/
namespace Source29RegularPolynomialLinkFrankel

open Filter MvPolynomial Source29ClosestPairStationarity Source29SynchronizedCurveFrankel
open scoped Topology BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [DecidableEq ι] in
/-- A local inclusion of the polynomial link gives set membership for every
actual analytic link curve, including curves in a newly chosen frame. -/
lemma curve_eventually_mem (P : MvPolynomial (Option (Option ι)) ℝ) (S : Set ((Option (Option ι)) → ℝ))
    (x : (Option (Option ι)) → ℝ)
    (hlocal : ∀ᶠ z in 𝓝 x, eval z P=0 → (∑ a, (z a)^2)=1 → z ∈ S)
    (C : ℝ → (Option (Option ι)) → ℝ) (hC : ∀ a, AnalyticAt ℝ (fun t ↦ C t a) 0)
    (hC0 : C 0=x) (hzero : ∀ᶠ t in 𝓝 0, eval (C t) P=0)
    (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2=1) :
    ∀ᶠ t in 𝓝 0, C t ∈ S := by
  have hCa : AnalyticAt ℝ C 0 := analyticAt_pi_iff.mpr hC
  have ht : Tendsto C (𝓝 0) (𝓝 x) := by
    simpa only [hC0] using hCa.continuousAt.tendsto
  filter_upwards [ht.eventually hlocal,hzero,hunit] with t hlocalt hzt hut
  exact hlocalt hzt hut

/-- Distinct regular homogeneous minimal links cannot be locally contained
in two sets at a closest pair. Minimality is used only at the endpoints;
all curves and their synchronized velocities are constructed explicitly. -/
theorem eq_of_closest_pair
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d e : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e)
    (hP : P.IsHomogeneous d) (hQ : Q.IsHomogeneous e)
    (S T : Set ((Option (Option ι)) → ℝ)) (x y : (Option (Option ι)) → ℝ) (hx : x ∈ S) (hy : y ∈ T)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (hPzero : eval x P=0) (hQzero : eval y Q=0)
    (hPL : eval x (Source29FactorInheritance.cubicOperator P)=0)
    (hQL : eval y (Source29FactorInheritance.cubicOperator Q)=0)
    (hS : ∀ᶠ z in 𝓝 x, eval z P=0 → (∑ a, (z a)^2)=1 → z ∈ S)
    (hT : ∀ᶠ z in 𝓝 y, eval z Q=0 → (∑ a, (z a)^2)=1 → z ∈ T)
    (U V : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (hU : U.transpose*U=1) (hV : V.transpose*V=1)
    (hUx : column U (some none)=x) (hVy : column V (some none)=y)
    (g h : ℝ) (hg : g ≠ 0) (hh : h ≠ 0)
    (hgradP : ∀ a, eval x (pderiv a P)=g*U a none)
    (hgradQ : ∀ a, eval y (pderiv a Q)=h*V a none) (i0 : ι) : x=y := by
  by_contra hne
  obtain ⟨C,hC,hC0,hCzero,hCunit,hCv,hCacc⟩ :=
    Source29RegularLinkCurvesInFrame.exists_curves P d hd hP x hPzero hPL U hU hUx g hg hgradP
  obtain ⟨D,hD,hD0,hDzero,hDunit,hDv,hDacc⟩ :=
    Source29RegularLinkCurvesInFrame.exists_curves Q e he hQ y hQzero hQL V hV hVy h hh hgradQ
  have hCmem (i : ι) := curve_eventually_mem P S x hS (C i) (hC i) (hC0 i) (hCzero i) (hCunit i)
  have hDmem (i : ι) := curve_eventually_mem Q T y hT (D i) (hD i) (hD0 i) (hDzero i) (hDunit i)
  obtain ⟨W,hW,hWW,hWy,hWt,hWn⟩ :=
    Source29ClosestPairCommonFrame.common_frame_of_closest_pair S T x y hx hy hclosest
      U V hU hV hUx hVy (Ne.symm hne) i0 C D hC hD hC0 hD0 hCunit hDunit hCmem hDmem hCv hDv
  obtain ⟨k,hk,hgradW⟩ : ∃ k : ℝ, k ≠ 0 ∧ ∀ a, eval y (pderiv a Q)=k*W a none := by
    rcases hWn with hn | hn
    · refine ⟨h,hh,fun a ↦ ?_⟩
      have hna : W a none=V a none := congrFun hn a
      rw [hna,hgradQ]
    · refine ⟨-h,neg_ne_zero.mpr hh,fun a ↦ ?_⟩
      have hna : W a none= -(V a none) := congrFun hn a
      rw [hna,hgradQ]
      ring
  obtain ⟨E,hE,hE0,hEzero,hEunit,hEv,hEacc⟩ :=
    Source29RegularLinkCurvesInFrame.exists_curves Q e he hQ y hQzero hQL W hW hWy k hk hgradW
  have hEmem (i : ι) := curve_eventually_mem Q T y hT (E i) (hE i) (hE0 i) (hEzero i) (hEunit i)
  have hvelocity (i : ι) (a : (Option (Option ι))) : deriv (fun t ↦ C i t a) 0=deriv (fun t ↦ E i t a) 0 := by
    rw [hCv,hEv]
    exact (congrFun (hWt i) a).symm
  have hm : (0 : ℝ) < Fintype.card ι := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨i0⟩
  exact hne (Source29SynchronizedCurveFrankel.eq_of_closest_pair S T x y hclosest
    C E (Fintype.card ι : ℝ) hm hC hE hC0 hE0 hvelocity hCacc hEacc hCmem hEmem)

/-- A regular point on a homogeneous polynomial's unit link admits the
radial-normal frame, without any global differential-equation assumption. -/
theorem exists_radial_normal_frame
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (x : (Option (Option ι)) → ℝ) (hx : (∑ a, (x a)^2)=1) (hzero : eval x P=0)
    (hregular : (fun a ↦ eval x (pderiv a P)) ≠ 0) :
    ∃ (g : ℝ) (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ), 0 < g ∧ U.transpose*U=1 ∧
      column U (some none)=x ∧ (∀ a, eval x (pderiv a P)=g*U a none) := by
  let X : EuclideanSpace ℝ (Option (Option ι)) := WithLp.toLp 2 x
  let G : EuclideanSpace ℝ (Option (Option ι)) := WithLp.toLp 2 (fun a ↦ eval x (pderiv a P))
  have hG : G ≠ 0 := by
    intro he
    apply hregular
    funext a
    exact congrArg (fun z : EuclideanSpace ℝ (Option (Option ι)) ↦ z a) he
  let g : ℝ := ‖G‖
  have hg : 0 < g := norm_pos_iff.mpr hG
  have hX : ‖X‖=1 := by
    have he : ‖X‖^2=1 := by simpa only [X,EuclideanSpace.real_norm_sq_eq] using hx
    nlinarith [norm_nonneg X]
  have horth : inner ℝ X G=0 := by
    have he := Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_self_of_isHomogeneous P d hP x
    rw [hzero,mul_zero] at he
    simpa only [Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_apply,X,G,
      PiLp.inner_apply,RCLike.inner_apply,conj_trivial,mul_comm] using he
  have hY : ‖g⁻¹ • G‖=1 := by
    rw [norm_smul,norm_inv,Real.norm_eq_abs,abs_of_pos hg]
    exact inv_mul_cancel₀ hg.ne'
  have hXY : inner ℝ X (g⁻¹ • G)=0 := by simp [inner_smul_right,horth]
  obtain ⟨U,hUt,hU,hUr,hUn⟩ := Source29OrthogonalFrame.exists_orthogonal_matrix_pair
    (some none) none (by simp) X (g⁻¹ • G) hX hY hXY
  refine ⟨g,U,hg,hUt,funext hUr,fun a ↦ ?_⟩
  rw [hUn]
  change eval x (pderiv a P)=g*(g⁻¹*eval x (pderiv a P))
  rw [← mul_assoc,mul_inv_cancel₀ hg.ne',one_mul]

/-- The frame-free local Frankel theorem for regular homogeneous polynomial
links. The local-inclusion hypotheses isolate the remaining component
topology; no connectedness or global cubic equation is assumed. -/
theorem eq_of_regular_closest_pair
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d e : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e)
    (hP : P.IsHomogeneous d) (hQ : Q.IsHomogeneous e)
    (S T : Set ((Option (Option ι)) → ℝ)) (x y : (Option (Option ι)) → ℝ) (hx : x ∈ S) (hy : y ∈ T)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (hxunit : (∑ a, (x a)^2)=1) (hyunit : (∑ a, (y a)^2)=1)
    (hPzero : eval x P=0) (hQzero : eval y Q=0)
    (hPreg : (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hQreg : (fun a ↦ eval y (pderiv a Q)) ≠ 0)
    (hPL : eval x (Source29FactorInheritance.cubicOperator P)=0)
    (hQL : eval y (Source29FactorInheritance.cubicOperator Q)=0)
    (hS : ∀ᶠ z in 𝓝 x, eval z P=0 → (∑ a, (z a)^2)=1 → z ∈ S)
    (hT : ∀ᶠ z in 𝓝 y, eval z Q=0 → (∑ a, (z a)^2)=1 → z ∈ T)
    (i0 : ι) : x=y := by
  obtain ⟨g,U,hg,hU,hUx,hgradP⟩ := exists_radial_normal_frame P d hP x hxunit hPzero hPreg
  obtain ⟨h,V,hh,hV,hVy,hgradQ⟩ := exists_radial_normal_frame Q e hQ y hyunit hQzero hQreg
  exact eq_of_closest_pair P Q d e hd he hP hQ S T x y hx hy hclosest hPzero hQzero hPL hQL
    hS hT U V hU hV hUx hVy g h hg.ne' hh.ne' hgradP hgradQ i0

end
end Source29RegularPolynomialLinkFrankel

/- Component: AnalyticFourthRadialJets.inc -/
namespace Source29AnalyticFourthRadialJets

open Source29AnalyticHomogeneousRadialJets

noncomputable section

section General
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- One radial entry in the fourth derivative of a real-degree homogeneous function. -/
theorem radial_fourth_derivative (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (u v w : E) :
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ (fun q => fderiv ℝ f q w) y v) z u) x x =
      (D-3) * fderiv ℝ (fun y => fderiv ℝ (fun q => fderiv ℝ f q w) y v) x u := by
  have he := radial_third_derivative (fun y => fderiv ℝ f y w) (D-1) U hU hcone
    (fun y hy => Source29NewtonRootHarmonic.analyticAt_directional f y w (hf y hy))
    (fun y hy t ht => directional_smul f D U hU hcone hf hhom y hy w t ht) x hx u v
  have h3 : D-1-2 = D-3 := by ring
  simpa only [h3] using he

/-- Two radial entries in the fourth derivative; the real degree is unrestricted. -/
theorem radial_radial_fourth (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (u v : E) :
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ (fun q => fderiv ℝ f q v) y u) z x) x x =
      (D-3)*(D-2) * fderiv ℝ (fun y => fderiv ℝ f y v) x u := by
  have he := radial_radial_third (fun y => fderiv ℝ f y v) (D-1) U hU hcone
    (fun y hy => Source29NewtonRootHarmonic.analyticAt_directional f y v (hf y hy))
    (fun y hy t ht => directional_smul f D U hU hcone hf hhom y hy v t ht) x hx u
  have h3 : D-1-2 = D-3 := by ring
  have h2 : D-1-1 = D-2 := by ring
  simpa only [h3, h2] using he

end General

open Source29AnalyticNormalTrace Source29AnalyticSecondTrace

/-- The last two coordinate slots can be radial, using analytic fourth-order symmetry. -/
theorem fourth_radial_coordinates {I : Type*} [Fintype I] [DecidableEq I]
    (f : (I → ℝ) → ℝ) (D : ℝ) (U : Set (I → ℝ)) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (r a b : I) (hx : Pi.single r 1 ∈ U) :
    fourth f (Pi.single r 1) a b r r = (D-3)*(D-2) * hess f (Pi.single r 1) a b := by
  rw [fourth_swap23 f _ (hf _ hx) a b r r,
    fourth_swap12 f _ (hf _ hx) a r b r,
    fourth_swap34 f _ (hf _ hx) r a b r,
    fourth_swap23 f _ (hf _ hx) r a r b]
  exact radial_radial_fourth f D U hU hcone hf hhom (Pi.single r 1) hx
    (Pi.single a 1) (Pi.single b 1)

end
end Source29AnalyticFourthRadialJets

/- Component: CompactRegularLinkConnectedness.inc -/
namespace Source29CompactRegularLinkConnectedness

open Filter Set MvPolynomial Source29SynchronizedCurveFrankel
open scoped Topology BigOperators

noncomputable section
variable {κ : Type*} [Fintype κ]

/-- Squared Euclidean coordinate distance attains its minimum on two
nonempty compact sets. This does not use the default function-space norm. -/
theorem exists_closest_pair (S T : Set (κ → ℝ)) (hS : IsCompact S) (hT : IsCompact T)
    (hSne : S.Nonempty) (hTne : T.Nonempty) :
    ∃ x ∈ S, ∃ y ∈ T, ∀ z ∈ S, ∀ w ∈ T,
      squaredDistance x y ≤ squaredDistance z w := by
  have hc : Continuous (fun p : (κ → ℝ) × (κ → ℝ) ↦ squaredDistance p.1 p.2) := by
    unfold squaredDistance
    fun_prop
  obtain ⟨p,hp,hmin⟩ := (hS.prod hT).exists_isMinOn (hSne.prod hTne) hc.continuousOn
  exact ⟨p.1,hp.1,p.2,hp.2,fun z hz w hw ↦ hmin (show (z,w) ∈ S ×ˢ T from ⟨hz,hw⟩)⟩

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The full regular spherical zero link of a homogeneous polynomial is
preconnected when its cubic operator vanishes pointwise on the link.
Compact open separation, rather than an assumption on its components,
provides the local link inclusions required by the Frankel argument. -/
theorem isPreconnected_link (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hd : 1 ≤ d)
    (hP : P.IsHomogeneous d)
    (hregular : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hminimal : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      eval x (Source29FactorInheritance.cubicOperator P)=0)
    (i0 : ι) : IsPreconnected {x : (Option (Option ι)) → ℝ | eval x P=0 ∧ (∑ a, (x a)^2)=1} := by
  let L : Set ((Option (Option ι)) → ℝ) := {x | eval x P=0 ∧ (∑ a, (x a)^2)=1}
  have hcompact : IsCompact L := Source29CompactPolynomialLink.isCompact_link P
  change IsPreconnected L
  intro U V hU hV hcover hUne hVne
  by_contra hdisj
  have hno (x : (Option (Option ι)) → ℝ) (hx : x ∈ L) (hu : x ∈ U) (hv : x ∈ V) : False :=
    hdisj ⟨x,hx,hu,hv⟩
  have hSU : L ∩ U=L \ V := by
    ext x
    constructor
    · rintro ⟨hx,hu⟩
      exact ⟨hx,fun hv ↦ hno x hx hu hv⟩
    · rintro ⟨hx,hv⟩
      exact ⟨hx,(hcover hx).resolve_right hv⟩
  have hTV : L ∩ V=L \ U := by
    ext x
    constructor
    · rintro ⟨hx,hv⟩
      exact ⟨hx,fun hu ↦ hno x hx hu hv⟩
    · rintro ⟨hx,hu⟩
      exact ⟨hx,(hcover hx).resolve_left hu⟩
  have hScompact : IsCompact (L ∩ U) := hSU.symm ▸ hcompact.diff hV
  have hTcompact : IsCompact (L ∩ V) := hTV.symm ▸ hcompact.diff hU
  obtain ⟨x,hx,y,hy,hclosest⟩ := exists_closest_pair (L ∩ U) (L ∩ V)
    hScompact hTcompact hUne hVne
  have hS : ∀ᶠ z in 𝓝 x, eval z P=0 → (∑ a, (z a)^2)=1 → z ∈ L ∩ U := by
    filter_upwards [hU.mem_nhds hx.2] with z hz hp hs
    exact ⟨⟨hp,hs⟩,hz⟩
  have hT : ∀ᶠ z in 𝓝 y, eval z P=0 → (∑ a, (z a)^2)=1 → z ∈ L ∩ V := by
    filter_upwards [hV.mem_nhds hy.2] with z hz hp hs
    exact ⟨⟨hp,hs⟩,hz⟩
  have hxy := Source29RegularPolynomialLinkFrankel.eq_of_regular_closest_pair P P d d hd hd
    hP hP (L ∩ U) (L ∩ V) x y hx hy hclosest hx.1.2 hy.1.2 hx.1.1 hy.1.1
    (hregular x hx.1.1 hx.1.2) (hregular y hy.1.1 hy.1.2)
    (hminimal x hx.1.1 hx.1.2) (hminimal y hy.1.1 hy.1.2) hS hT i0
  exact hno y hy.1 (hxy ▸ hx.2) hy.2

/-- A nonempty regular minimal polynomial link is connected. -/
theorem isConnected_link (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hd : 1 ≤ d)
    (hP : P.IsHomogeneous d)
    (hregular : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hminimal : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      eval x (Source29FactorInheritance.cubicOperator P)=0)
    (hne : ∃ x : (Option (Option ι)) → ℝ, eval x P=0 ∧ (∑ a, (x a)^2)=1)
    (i0 : ι) : IsConnected {x : (Option (Option ι)) → ℝ | eval x P=0 ∧ (∑ a, (x a)^2)=1} :=
  ⟨hne,isPreconnected_link P d hd hP hregular hminimal i0⟩

/-- Polynomial divisibility of the cubic operator suffices: only its
restriction to the zero link enters the geometric proof. -/
theorem isPreconnected_link_of_dvd (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hd : 1 ≤ d)
    (hP : P.IsHomogeneous d)
    (hregular : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hdiv : P ∣ Source29FactorInheritance.cubicOperator P) (i0 : ι) :
    IsPreconnected {x : (Option (Option ι)) → ℝ | eval x P=0 ∧ (∑ a, (x a)^2)=1} := by
  apply isPreconnected_link P d hd hP hregular _ i0
  intro x hx _
  obtain ⟨Q,hQ⟩ := hdiv
  rw [hQ,map_mul,hx,zero_mul]

end
end Source29CompactRegularLinkConnectedness

/- Component: AnalyticLinkFourthTrace.inc -/
namespace Source29AnalyticLinkFourthTrace

open Filter Source29AnalyticNormalTrace Source29AnalyticSecondTrace
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Remove the radial direction from the twice differentiated analytic level equation.
The radial jets are explicit; no integrality or lower bound on the real degree is used. -/
theorem link_fourth_trace
    (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (hthird : ∀ a b, third f base (some none) a b = (D-2)*hess f base a b)
    (hfourth : ∀ a b, fourth f base a b (some none) (some none) =
      (D-3)*(D-2)*hess f base a b) (a b : ι) :
    g^2 * (∑ i, fourth f base (some (some a)) (some (some b)) (some (some i)) (some (some i))) =
      2 * (∑ i, ∑ j, hess f base (some (some a)) (some (some i)) *
        hess f base (some (some b)) (some (some j)) *
        hess f base (some (some i)) (some (some j))) -
      2 * hess f base none none * (∑ i, hess f base (some (some a)) (some (some i)) *
        hess f base (some (some b)) (some (some i))) +
      2 * g * (∑ i, (third f base (some (some a)) (some (some b)) (some (some i)) *
          hess f base none (some (some i)) +
        hess f base (some (some a)) (some (some i)) *
          third f base (some (some b)) none (some (some i)) +
        hess f base (some (some b)) (some (some i)) *
          third f base (some (some a)) none (some (some i)))) -
      2 * hess f base (some (some a)) none * (∑ i,
        hess f base (some (some b)) (some (some i)) * hess f base none (some (some i))) -
      2 * hess f base (some (some b)) none * (∑ i,
        hess f base (some (some a)) (some (some i)) * hess f base none (some (some i))) +
      (D*(D-1)-2) * g^2 * hess f base (some (some a)) (some (some b)) := by
  have hR : ∀ j, hess f base (some none) (some j) = 0 := by
    intro j
    rw [hrad, hgt, mul_zero]
  have hR' : ∀ j, hess f base (some j) (some none) = 0 := by
    intro j
    rw [hess_symm f base hf, hR]
  have hNR : hess f base none (some none) = (D-1)*g := by
    rw [hess_symm f base hf, hrad, hgn]
  have hTR : third f base (some (some a)) (some (some b)) (some none) =
      (D-2)*hess f base (some (some a)) (some (some b)) := by
    rw [third_swap23 f base hf, third_swap12 f base hf, hthird]
  have he := second_derivative_trace f base g hg hf hL hgn hgt
    (some (some a)) (some (some b))
  simp only [Fintype.sum_option, hR, hR', hNR, hTR, hfourth,
    mul_zero, zero_mul, zero_add, add_zero, Finset.sum_const_zero] at he
  linear_combination he

end
end Source29AnalyticLinkFourthTrace

/- Component: AnalyticNormalizedLinkJets.inc -/
namespace Source29AnalyticNormalizedLinkJets

open Source29AnalyticNormalTrace Source29AnalyticSecondTrace
open Source29PolynomialLinkChart (base)
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def tangent (a : ι) : Option (Option ι) := some (some a)

def A (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b : ι) : ℝ :=
  hess f base (tangent a) (tangent b) / g

def w (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a : ι) : ℝ :=
  hess f base none (tangent a) / g

def z (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) : ℝ := hess f base none none / g

def S (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b c : ι) : ℝ :=
  third f base (tangent a) (tangent b) (tangent c) / g

def V (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b : ι) : ℝ :=
  third f base none (tangent a) (tangent b) / g

def Q (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b c d : ι) : ℝ :=
  fourth f base (tangent a) (tangent b) (tangent c) (tangent d) / g

def B (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b c : ι) : ℝ :=
  S f g a b c - w f g a * A f g b c - w f g b * A f g a c - w f g c * A f g a b

theorem A_symm (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b : ι) : A f g a b = A f g b a := by
  unfold A
  rw [hess_symm f base hf]

theorem V_symm (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b : ι) : V f g a b = V f g b a := by
  unfold V
  rw [third_swap23 f base hf]

theorem S_swap12 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c : ι) : S f g a b c = S f g b a c := by
  unfold S
  rw [third_swap12 f base hf]

theorem S_swap23 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c : ι) : S f g a b c = S f g a c b := by
  unfold S
  rw [third_swap23 f base hf]

theorem Q_swap12 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c d : ι) : Q f g a b c d = Q f g b a c d := by
  unfold Q
  rw [fourth_swap12 f base hf]

theorem Q_swap23 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c d : ι) : Q f g a b c d = Q f g a c b d := by
  unfold Q
  rw [fourth_swap23 f base hf]

theorem Q_swap13 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c d : ι) : Q f g a b c d = Q f g c b a d := by
  rw [Q_swap12 f g hf a b c d, Q_swap23 f g hf b a c d, Q_swap12 f g hf b c a d]

theorem Q_swap34 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c d : ι) : Q f g a b c d = Q f g a b d c := by
  unfold Q
  rw [fourth_swap34 f base hf]

theorem B_swap12 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c : ι) : B f g a b c = B f g b a c := by
  unfold B
  rw [S_swap12 f g hf a b c, A_symm f g hf a b]
  ring

theorem B_swap23 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c : ι) : B f g a b c = B f g a c b := by
  unfold B
  rw [S_swap23 f g hf a b c, A_symm f g hf b c]
  ring

theorem B_swap13 (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ)
    (hf : AnalyticAt ℝ f base) (a b c : ι) : B f g a b c = B f g c b a := by
  rw [B_swap12 f g hf a b c, B_swap23 f g hf b a c, B_swap12 f g hf b c a]

end
end Source29AnalyticNormalizedLinkJets

/- Component: AnalyticNormalizedLinkTraces.inc -/
namespace Source29AnalyticNormalizedLinkTraces

open Filter Source29AnalyticNormalTrace Source29AnalyticSecondTrace
open Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

variable (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (hthird : ∀ a b, third f base (some none) a b = (D-2)*hess f base a b)
    (hfourth : ∀ a b, fourth f base a b (some none) (some none) =
      (D-3)*(D-2)*hess f base a b)

omit [Fintype ι] in
include hgt hrad in
theorem radial_hessian_zero (j : Option ι) : hess f base (some none) (some j) = 0 := by
  rw [hrad, hgt, mul_zero]

include hg hL hgn hgt hrad in
theorem A_trace : (∑ i, A f g i i) = 0 := by
  have ht := tangential_trace_zero f base g hg hL.self_of_nhds hgn hgt
  rw [Fintype.sum_option, radial_hessian_zero f D hgt hrad none, zero_add] at ht
  simp only [A, tangent, ← Finset.sum_div, ht, zero_div]

include hg hf hL hgn hgt hrad hthird in
theorem B_trace (c : ι) : (∑ i, B f g i i c) = 0 := by
  have hR := radial_hessian_zero f D hgt hrad
  have hR' : ∀ j, hess f base (some j) (some none) = 0 := by
    intro j
    rw [hess_symm f base hf, hR]
  have hT : third f base (tangent c) (some none) (some none) = 0 := by
    rw [third_swap12 f base hf, hthird]
    simp only [tangent, hR', mul_zero]
  have ht := derivative_trace f base g hg hf hL hgn hgt (tangent c)
  change g * (∑ i, third f base (tangent c) (some i) (some i)) =
    2 * (∑ i, hess f base (tangent c) (some i) * hess f base none (some i)) at ht
  rw [Fintype.sum_option, Fintype.sum_option, hT] at ht
  simp only [tangent, hR', zero_mul, zero_add] at ht
  have hS : (∑ i, S f g c i i) = 2 * (∑ i, w f g i * A f g c i) := by
    simp only [S, w, A, tangent, div_mul_div_comm, ← Finset.sum_div]
    have hcomm : (∑ i, hess f base none (some (some i)) *
        hess f base (some (some c)) (some (some i))) =
        ∑ i, hess f base (some (some c)) (some (some i)) * hess f base none (some (some i)) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hcomm]
    field_simp [hg]
    linear_combination ht
  calc
    (∑ i, B f g i i c) = ∑ i, B f g c i i := by
      apply Finset.sum_congr rfl
      intro i _
      exact B_swap13 f g hf i i c
    _ = (∑ i, S f g c i i) - w f g c * (∑ i, A f g i i) -
        2 * (∑ i, w f g i * A f g c i) := by
      simp only [B, Finset.sum_sub_distrib, ← Finset.mul_sum]
      ring
    _ = 0 := by rw [hS, A_trace f D g hg hL hgn hgt hrad]; ring

include hg hf hL hgn hgt hrad hthird in
theorem V_trace : (∑ i, V f g i i) = 2 * (∑ i, (w f g i)^2) + D*(D-1) := by
  have ht := normal_derivative_trace f base g hg hf hL hgn hgt
  have hH : hess f base none (some none) = (D-1)*g := by
    rw [hess_symm f base hf, hrad, hgn]
  have hT : third f base none (some none) (some none) = (D-2)*(D-1)*g := by
    rw [third_swap12 f base hf, hthird, hH]
    ring
  rw [Fintype.sum_option, Fintype.sum_option, hH, hT] at ht
  simp only [V, w, tangent, div_pow, ← Finset.sum_div]
  field_simp [hg]
  nlinarith [ht]

include hg hf hL hgn hgt hrad hthird hfourth in
theorem Q_trace_natural (a b : ι) : (∑ i, Q f g a b i i) =
    2 * (∑ i, ∑ j, A f g a i * A f g b j * A f g i j) -
    2 * z f g * (∑ i, A f g a i * A f g b i) +
    2 * (∑ i, (S f g a b i * w f g i + A f g a i * V f g b i + A f g b i * V f g a i)) -
    2 * w f g a * (∑ i, A f g b i * w f g i) -
    2 * w f g b * (∑ i, A f g a i * w f g i) +
    (D*(D-1)-2) * A f g a b := by
  have he := Source29AnalyticLinkFourthTrace.link_fourth_trace f D g hg hf hL hgn hgt hrad hthird hfourth a b
  have hHN : ∀ c, hess f base (some (some c)) none = hess f base none (some (some c)) := by
    intro c
    exact hess_symm f base hf (some (some c)) none
  have hTN : ∀ c i, third f base (some (some c)) none (some (some i)) = third f base none (some (some c)) (some (some i)) := by
    intro c i
    exact third_swap12 f base hf (some (some c)) none (some (some i))
  simp only [hHN, hTN] at he
  simp only [Q, A, z, S, w, V, tangent, div_mul_div_comm, ← add_div, ← Finset.sum_div]
  field_simp [hg]
  linear_combination he

end
end Source29AnalyticNormalizedLinkTraces

/- Component: AnalyticSimonsTensor.inc -/
namespace Source29AnalyticSimonsTensor

open Filter Source29AnalyticNormalTrace Source29AnalyticSecondTrace
open Source29PolynomialLinkChart (base)
open Source29AnalyticNormalizedLinkJets Source29SimonsJetCorrection Source29SimonsFourthTensor
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

open Source29PolynomialSimonsTensor (cubic_contraction square_contraction)

def F (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) : ι → ι → ι → ι → ℝ :=
  fourthTensor (A f g) (V f g) (B f g) (Q f g) (w f g) (z f g)

/-- Explicit analytic candidate for the second covariant derivative.
Identification with derivatives of an actual moving frame is still separate. -/
def D (f : (Option (Option ι) → ℝ) → ℝ) (g : ℝ) (a b c d : ι) : ℝ :=
  F f g a b c d + correction (A f g) a b c d

variable (f : (Option (Option ι) → ℝ) → ℝ) (degree g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (degree-1)*grad f base j)
    (hthird : ∀ a b, third f base (some none) a b = (degree-2)*hess f base a b)
    (hfourth : ∀ a b, fourth f base a b (some none) (some none) =
      (degree-3)*(degree-2)*hess f base a b)

include hg hf hL hgn hgt hrad hthird hfourth

theorem Q_trace (c d : ι) : (∑ k, Q f g k k c d) =
    2 * matrixCube (A f g) d c - 2 * z f g * matrixSquare (A f g) c d +
    2 * (∑ k, (S f g k c d * w f g k + A f g k c * V f g k d + A f g k d * V f g k c)) -
    2 * w f g c * (∑ k, A f g k d * w f g k) -
    2 * w f g d * (∑ k, A f g k c * w f g k) +
    ((degree : ℝ)*((degree : ℝ)-1)-2) * A f g c d := by
  have hrot : (∑ k, Q f g k k c d) = ∑ k, Q f g c d k k := by
    apply Finset.sum_congr rfl
    intro k _
    rw [Q_swap23 f g hf k k c d, Q_swap12 f g hf k c k d,
      Q_swap34 f g hf c k k d, Q_swap23 f g hf c k d k]
  rw [hrot, Source29AnalyticNormalizedLinkTraces.Q_trace_natural f degree g hg hf hL hgn hgt hrad hthird hfourth,
    cubic_contraction (A f g) (A_symm f g hf), square_contraction (A f g) (A_symm f g hf)]
  have hS : ∀ k, S f g c d k = S f g k c d := by
    intro k
    rw [S_swap23 f g hf c d k, S_swap12 f g hf c k d]
  simp only [hS, A_symm f g hf, V_symm f g hf]

theorem F_trace (c d : ι) : (∑ k, F f g k k c d) =
    2 * matrixCube (A f g) d c - 2 * A f g c d := by
  apply fourthTensor_trace (A f g) (V f g) (B f g) (S f g) (Q f g) (w f g) (z f g)
    ((degree : ℝ)*((degree : ℝ)-1)) (A_symm f g hf)
    (Source29AnalyticNormalizedLinkTraces.A_trace f degree g hg hL hgn hgt hrad)
    (fun a b c => rfl)
    (Source29AnalyticNormalizedLinkTraces.B_trace f degree g hg hf hL hgn hgt hrad hthird)
    (Source29AnalyticNormalizedLinkTraces.V_trace f degree g hg hf hL hgn hgt hrad hthird)
    (Q_trace f degree g hg hf hL hgn hgt hrad hthird hfourth)

/-- Tensor Simons for explicit normalized analytic jets with any real homogeneous degree. No Gauss, Codazzi,
or commutator assumptions are needed. Geometric realization of D remains. -/
theorem tensor_simons (i j : ι) :
    (∑ k, D f g i j k k) =
      ((Fintype.card ι : ℝ) - Source29GaussSimonsAlgebra.normSq (A f g)) * A f g i j := by
  apply simons_of_symmetric_fourth (A f g) (F f g) (A_symm f g hf)
    (Source29AnalyticNormalizedLinkTraces.A_trace f degree g hg hL hgn hgt hrad)
  · exact fourthTensor_swap12 (A f g) (V f g) (B f g) (Q f g) (w f g) (z f g)
      (A_symm f g hf) (V_symm f g hf) (B_swap12 f g hf) (Q_swap12 f g hf)
  · exact fourthTensor_swap13 (A f g) (V f g) (B f g) (Q f g) (w f g) (z f g)
      (A_symm f g hf) (V_symm f g hf) (B_swap12 f g hf) (B_swap13 f g hf) (Q_swap13 f g hf)
  · exact fourthTensor_swap34 (A f g) (V f g) (B f g) (Q f g) (w f g) (z f g)
      (A_symm f g hf) (V_symm f g hf) (B_swap23 f g hf) (Q_swap34 f g hf)
  · exact F_trace f degree g hg hf hL hgn hgt hrad hthird hfourth

end
end Source29AnalyticSimonsTensor

/- Component: AnalyticHomogeneousSimonsTensor.inc -/
namespace Source29AnalyticHomogeneousSimonsTensor

open Filter Source29AnalyticNormalTrace Source29AnalyticSecondTrace
open Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Positive real homogeneity supplies every radial jet used in the analytic
link tensor calculation, with no restriction on the degree. -/
theorem radial_coordinate_jets
    (f : (Option (Option ι) → ℝ) → ℝ) (degree : ℝ)
    (U : Set (Option (Option ι) → ℝ)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^degree * f x) :
    (∀ j, hess f base (some none) j = (degree-1)*grad f base j) ∧
    (∀ a b, third f base (some none) a b = (degree-2)*hess f base a b) ∧
    (∀ a b, fourth f base a b (some none) (some none) =
      (degree-3)*(degree-2)*hess f base a b) := by
  refine ⟨?_, ?_, ?_⟩
  · intro j
    exact Source29AnalyticHomogeneousRadialJets.radial_hessian f degree U hU hcone hf hhom
      base hx (Pi.single j 1)
  · intro a b
    exact Source29AnalyticHomogeneousRadialJets.radial_third_derivative f degree U hU hcone hf hhom
      base hx (Pi.single a 1) (Pi.single b 1)
  · intro a b
    exact Source29AnalyticFourthRadialJets.fourth_radial_coordinates f degree U hU hcone hf hhom
      (some none) a b hx

/-- Tensor Simons for actual derivatives of an analytic homogeneous solution
of the local cubic level equation. Geometric realization of the tensor is separate. -/
theorem tensor_simons
    (f : (Option (Option ι) → ℝ) → ℝ) (degree g : ℝ) (hg : g ≠ 0)
    (U : Set (Option (Option ι) → ℝ)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^degree * f x)
    (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (i j : ι) :
    (∑ k, Source29AnalyticSimonsTensor.D f g i j k k) =
      ((Fintype.card ι : ℝ) - Source29GaussSimonsAlgebra.normSq (A f g)) * A f g i j := by
  obtain ⟨hr, ht, hq⟩ := radial_coordinate_jets f degree U hU hx hcone hf hhom
  exact Source29AnalyticSimonsTensor.tensor_simons f degree g hg (hf base hx)
    hL hgn hgt hr ht hq i j

end
end Source29AnalyticHomogeneousSimonsTensor

/- Component: AnalyticPositiveRootSimons.inc -/
namespace Source29AnalyticPositiveRootSimons

open Filter MvPolynomial Source29AnalyticNormalTrace
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The real-degree tensor Simons identity for the positive defining root of
P^kQ. The PDE is assumed only for P^kQ, and not for P. -/
theorem definingRoot_tensor_simons
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (p q k : ℕ) (hk : 0 < k)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator (P^k*Q) = 0)
    (hzero : eval base P = 0) (hpos : 0 < eval base Q)
    (a : ℝ) (ha : 0 < a) (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0) :
    ∀ i j : ι, let f := Source29FinitePositiveCofactorRoot.definingRoot P Q k
      let g := (eval base Q)^((k : ℝ)⁻¹)*a
      (∑ v, Source29AnalyticSimonsTensor.D f g i j v v) =
        ((Fintype.card ι : ℝ) - Source29GaussSimonsAlgebra.normSq
          (Source29AnalyticNormalizedLinkJets.A f g)) *
            Source29AnalyticNormalizedLinkJets.A f g i j := by
  intro i j
  let f := Source29FinitePositiveCofactorRoot.definingRoot P Q k
  let U : Set (Option (Option ι) → ℝ) := {x | 0 < eval x Q}
  have hU : IsOpen U := isOpen_lt continuous_const
    (show Continuous (fun x => eval x Q) from continuous_iff_continuousAt.mpr
      (fun x => (Source29PolynomialLinkChart.analyticAt_eval_real Q x).continuousAt))
  have hreg : (fun i => eval base (pderiv i P)) ≠ 0 := by
    intro he
    have he' := congrFun he none
    rw [hpn] at he'
    exact ha.ne' he'
  have hg : 0 < (eval base Q)^((k : ℝ)⁻¹)*a := mul_pos (Real.rpow_pos_of_pos hpos _) ha
  have hgn : grad f base none = (eval base Q)^((k : ℝ)⁻¹)*a := by
    rw [Source29FinitePositiveCofactorRoot.definingRoot_gradient P Q k hk base hzero hpos]
    simp only [hpn]
  have hgt : ∀ j, grad f base (some j) = 0 := by
    intro j
    rw [Source29FinitePositiveCofactorRoot.definingRoot_gradient P Q k hk base hzero hpos]
    simp only [hpt, mul_zero]
  exact Source29AnalyticHomogeneousSimonsTensor.tensor_simons f
    ((p : ℝ)+(q : ℝ)/(k : ℝ)) _ hg.ne' U hU hpos
    (fun x hx t ht => Source29FinitePositiveCofactorRoot.eval_smul_pos Q q hQ x hx t ht)
    (fun x hx => Source29FinitePositiveCofactorRoot.definingRoot_analyticAt P Q k hk x hx)
    (fun x hx t ht => Source29FinitePositiveCofactorRoot.definingRoot_smul P Q p q k hP hQ x hx t ht)
    (Source29FinitePositiveCofactorRoot.definingRoot_levelOperator_zero P Q k hk hF base hzero hpos hreg)
    hgn hgt i j

end
end Source29AnalyticPositiveRootSimons

/- Component: AnalyticPositiveRootCurvature.inc -/
namespace Source29AnalyticPositiveRootCurvature

open MvPolynomial Source29AnalyticNormalTrace
open Source29FinitePositiveCofactorRoot
open Source29PolynomialLinkChart (base)
open Source29AnalyticNormalizedLinkJets (A tangent)
open scoped Topology BigOperators Matrix

noncomputable section

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Tangential Hessian entries of the positive defining root scale by the
positive unit; derivatives of that unit vanish from this restriction. -/
theorem definingRoot_hess_of_tangent (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q) (i j : I)
    (hi : eval x (pderiv i P) = 0) (hj : eval x (pderiv j P) = 0) :
    hess (definingRoot P Q k) x i j =
      (eval x Q)^((k : ℝ)⁻¹) * eval x (pderiv i (pderiv j P)) := by
  have he := Source29FiniteJetConvergence.second_mul (fun y => eval y P)
    (fun y => (eval y Q)^((k : ℝ)⁻¹)) x (Pi.single i 1) (Pi.single j 1)
    (Source29PolynomialLinkChart.analyticAt_eval_real P x) (rootUnit_analyticAt Q k hk x hQ)
  change hess (definingRoot P Q k) x i j =
    eval x P * hess (fun y => (eval y Q)^((k : ℝ)⁻¹)) x i j +
    (eval x Q)^((k : ℝ)⁻¹) * hess (fun y => eval y P) x i j +
    coordPartial (fun y => eval y P) i x * coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) j x +
    coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) i x * coordPartial (fun y => eval y P) j x at he
  simpa only [hP, partial_eval, hi, hj, hess_eval, zero_mul, mul_zero, zero_add, add_zero] using he

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The positive unit cancels from the normalized tangential Hessian. -/
theorem normalized_hessian_eq
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (hk : 0 < k)
    (hP : eval base P = 0) (hQ : 0 < eval base Q) (a : ℝ)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0) (i j : ι) :
    A (definingRoot P Q k) ((eval base Q)^((k : ℝ)⁻¹)*a) i j =
      eval base (pderiv (tangent i) (pderiv (tangent j) P)) / a := by
  unfold A
  rw [definingRoot_hess_of_tangent P Q k hk base hP hQ (tangent i) (tangent j)
    (hpt (some i)) (hpt (some j))]
  exact mul_div_mul_left _ _ (Real.rpow_pos_of_pos hQ _).ne'

/-- The base curvature formula also holds in degrees zero and one. -/
theorem curvaturePotential_at_base
    (P : MvPolynomial (Option (Option ι)) ℝ) (p : ℕ) (hP : P.IsHomogeneous p)
    (a : ℝ) (ha : a ≠ 0) (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0) :
    Source29PolynomialCurvaturePotential.curvaturePotential P base =
      (∑ i, ∑ j, (eval base (pderiv (tangent i) (pderiv (tangent j) P)))^2) / a^2 := by
  have hg : Source29PolynomialCurvaturePotential.gradientAt P base =
      Source29CurvaturePotentialAxis.axis a := by
    funext j
    cases j with
    | none => exact hpn
    | some j => exact hpt j
  have hs : ∀ i j, Source29QuarticReuse.QuarticMinimal.AmbientQuartic.realHessian P base i j =
      Source29QuarticReuse.QuarticMinimal.AmbientQuartic.realHessian P base j i := by
    intro i j
    simp only [Source29QuarticReuse.QuarticMinimal.AmbientQuartic.realHessian_apply]
    rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
