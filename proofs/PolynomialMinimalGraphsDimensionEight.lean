theorem centered_totalDegree (P : MvPolynomial (Fin n) ℝ) :
    (centered P).totalDegree = P.totalDegree := by
  apply le_antisymm (totalDegree_sub_C_le P (eval 0 P))
  have h := totalDegree_add (P - C (eval 0 P)) (C (eval 0 P))
  simpa only [sub_add_cancel, totalDegree_C, max_zero] using h

theorem centered_top_eq (P : MvPolynomial (Fin n) ℝ) (hd : 0 < P.totalDegree) :
    homogeneousComponent (centered P).totalDegree (centered P) =
      homogeneousComponent P.totalDegree P := by
  rw [centered_totalDegree, centered, map_sub]
  have hc : homogeneousComponent P.totalDegree (C (eval 0 P) : MvPolynomial (Fin n) ℝ) = 0 :=
    homogeneousComponent_eq_zero P.totalDegree (C (eval 0 P)) (by simpa only [totalDegree_C] using hd)
  rw [hc, sub_zero]

/-- A polynomial minimal graph with an odd power of a linear leading form is affine. -/
theorem affine_of_odd_linear_leading (P : MvPolynomial (Fin (n+1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (a : Fin (n+1) → ℝ) (ha : a ≠ 0) {c : ℝ} (hc : c ≠ 0) {k : ℕ} (hk : Odd k)
    (htop : homogeneousComponent P.totalDegree P = C c * (linearForm a)^k) :
    Math30.MinimalGraphs.IsAffine P := by
  by_cases hd : P.totalDegree ≤ 1
  · exact hd
  have hdeg : 2 ≤ P.totalDegree := by omega
  have hminQ := (centered_minimal_iff P).mpr hmin
  have hdegQ : 2 ≤ (centered P).totalDegree := by rwa [centered_totalDegree]
  apply (centered_affine_iff P).mp
  apply affine_of_radial_sequence_limit (centered P) (centered_eval_zero P) hminQ
    dilationRadius_tendsto
  have ht := radialCutoff_mass_tendsto (centered P) hminQ hdegQ
  rw [centered_top_eq P (by omega), htop,
    radialPhaseFlux_odd_linear_power a ha hc hk radialCutoff_contDiff radialCutoff_zero] at ht
  exact ht

theorem affine_of_odd_homogeneous_linear_leading (P : MvPolynomial (Fin (n+1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (p : MvPolynomial (Fin (n+1)) ℝ) (hp : p ≠ 0) (hphom : p.IsHomogeneous 1)
    {c : ℝ} (hc : c ≠ 0) {k : ℕ} (hk : Odd k)
    (htop : homogeneousComponent P.totalDegree P = C c * p^k) :
    Math30.MinimalGraphs.IsAffine P := by
  classical
  let a : Fin (n+1) → ℝ := fun i ↦ (pderiv i p).coeff 0
  have he : p = linearForm a :=
    Source29QuarticReuse.QuarticMinimal.homogeneous_linear_expansion p hphom
  have ha : a ≠ 0 := by
    intro hz
    apply hp
    rw [he, hz]
    simp [linearForm]
  apply affine_of_odd_linear_leading P hmin a ha hc hk
  rwa [← he]

end
