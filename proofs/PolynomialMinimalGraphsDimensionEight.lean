noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The weighted inverse-gradient profile, defined on a neighborhood of every
regular zero where the cofactor is positive. -/
def weightedProfile (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (x : Ambient ι) : ℝ :=
  ((eval x Q)^((k : ℝ)⁻¹))⁻¹ * jacobiProfile P x

theorem weightedProfile_positive (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ)
    (x : Ambient ι) (hQ : 0 < eval x Q) (hreg : (fun a => eval x (pderiv a P)) ≠ 0) :
    0 < weightedProfile P Q k x :=
  mul_pos (inv_pos.mpr (Real.rpow_pos_of_pos hQ _)) (jacobiProfile_positive P x hreg)

theorem weightedProfile_analyticAt (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Ambient ι) (hQ : 0 < eval x Q) (hreg : (fun a => eval x (pderiv a P)) ≠ 0) :
