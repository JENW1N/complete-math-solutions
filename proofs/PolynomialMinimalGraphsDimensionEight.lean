noncomputable section
variable {n : ℕ}

theorem graphRadiusSq_dilate (P : MvPolynomial (Fin n) ℝ) {r : ℝ} (hr : r ≠ 0) (x : Fin n → ℝ) :
    graphRadiusSq (fun y ↦ eval y P) (r • x) / r^2 = graphRadiusSq (height P r) x := by
  simp only [graphRadiusSq, height, Pi.smul_apply, smul_eq_mul, mul_pow, ← Finset.mul_sum]
  field_simp

theorem massDensity_dilate (P : MvPolynomial (Fin n) ℝ) (f : ℝ → ℝ) {r : ℝ} (hr : r ≠ 0)
    (x : Fin n → ℝ) :
    massDensity (fun y ↦ eval y P) (evaluatedGradient P) f r (r • x) =
      f (graphRadiusSq (height P r) x) * areaDensity (gradient P r x) := by
  unfold massDensity
  rw [graphRadiusSq_dilate P hr]
  rfl

/-- Normalized graph mass equals the unnormalized weighted mass of the
geometrically rescaled graph. -/
theorem normalizedMass_eq_rescaled (P : MvPolynomial (Fin n) ℝ) (f : ℝ → ℝ)
    {r : ℝ} (hr : 0 < r) :
    normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) f r =
      ∫ x, f (graphRadiusSq (height P r) x) * areaDensity (gradient P r x) := by
  have he := Measure.integral_comp_smul_of_nonneg volume
    (massDensity (fun y ↦ eval y P) (evaluatedGradient P) f r) r (hR := hr.le)
  simp_rw [massDensity_dilate P f hr.ne'] at he
  simpa [normalizedMass, mass, Module.finrank_pi, smul_eq_mul, div_eq_mul_inv, mul_comm] using he.symm

end
