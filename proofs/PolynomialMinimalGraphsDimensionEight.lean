noncomputable section
variable {n : ℕ}

theorem phase_perimeter_comparison (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) (K V : Set (Fin n → ℝ))
    (hflat : ∀ x ∈ K, fderiv ℝ ρ x = 0)
    (hV : ∀ x ∉ K, (x ∈ V ↔ 0 < eval x P)) :
    weightedPerimeter {x | 0 < eval x P} ρ ≤ weightedPerimeter V ρ := by
  classical
  apply phase_variation_minimizing P hP hcal ha hρ hcρ hρpos
  apply Filter.Eventually.of_forall
  intro x
  by_cases hx : x ∈ K
  · exact Or.inr (hflat x hx)
  · left
    change (if x ∈ V then (1 : ℝ) else 0) = if 0 < eval x P then 1 else 0
    rw [hV x hx]

theorem phase_local_perimeter_comparison (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P))
    (U K V : Set (Fin n → ℝ)) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (hV : ∀ x ∉ K, (x ∈ V ↔ 0 < eval x P)) :
    localPerimeter {x | 0 < eval x P} U ≤ localPerimeter V U := by
  classical
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  let L := K ∪ ⋃ i, tsupport (fun x ↦ X x i)
  have hcL : IsCompact L := hK.union (isCompact_iUnion (fun i ↦ hX.test.compact i))
  have hLU : L ⊆ U := Set.union_subset hKU (Set.iUnion_subset hX.within)
  obtain ⟨ρ, hρ, hcρ, hρU, hρb, hρone, hρflat⟩ := exists_local_cutoff L U hcL hU hLU
  have hXρ : VariationTest ρ X := local_test_weighted L X hX.test
    (fun i x hx ↦ Or.inr (Set.mem_iUnion.mpr ⟨i, hx⟩)) ρ (fun x ↦ (hρb x).1) hρone
  calc
    _ ≤ weightedPerimeter {x | 0 < eval x P} ρ := test_le_weightedVariation _ _ _ hXρ
    _ ≤ weightedPerimeter V ρ := phase_perimeter_comparison P hP hcal ha hρ hcρ
      (fun x ↦ (hρb x).1) K V (fun x hx ↦ hρflat x (Or.inl hx)) hV
    _ ≤ localPerimeter V U := weightedVariation_le_local _ _ _ hρU (fun x ↦ (hρb x).2)

theorem phase_local_perimeter_finite (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (U : Set (Fin n → ℝ)) (hU : IsCompact (closure U)) :
    localPerimeter {x | 0 < eval x P} U < ⊤ := by
  obtain ⟨ρ, hρ, hcρ, _, hρb, hρone, _⟩ :=
    exists_local_cutoff (closure U) Set.univ hU isOpen_univ (Set.subset_univ _)
  have hb : localPerimeter {x | 0 < eval x P} U ≤
      ENNReal.ofReal (Source29PhaseMassLimit.phaseMass P ρ) := by
    apply iSup_le
    intro X
    apply iSup_le
    intro hX
    have hXρ := local_test_weighted (closure U) X hX.test
      (fun i ↦ (hX.within i).trans subset_closure) ρ (fun x ↦ (hρb x).1) hρone
    exact (test_le_weightedVariation _ _ _ hXρ).trans (phase_variation_le_mass P hP hcal hρ hcρ)
  exact hb.trans_lt ENNReal.ofReal_lt_top

theorem phase_locally_perimeter_minimizing (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P)) :
    LocallyPerimeterMinimizing {x | 0 < eval x P} := by
  exact ⟨phase_local_perimeter_finite P hP hcal, phase_local_perimeter_comparison P hP hcal ha⟩

end
end Source29CalibratedPhaseLocalPerimeter

/- Component: LeadingLevelPerimeter.inc -/
namespace Source29LeadingLevelPerimeter

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29WeakCalibrationLimits Source29SmoothCalibrationRecovery
open Source29WeightedPhaseVariation Source29TopPhasePerimeter Source29LocalPhasePerimeter
open Source29CalibratedPhaseLocalPerimeter Source29PerimeterRepresentatives
open Source29PhaseMassLimit
open scoped Topology ENNReal

noncomputable section
variable {n : ℕ}

def levelPolynomial (P : MvPolynomial (Fin n) ℝ) (t : ℝ) : MvPolynomial (Fin n) ℝ :=
  homogeneousComponent P.totalDegree P - C t

theorem levelPolynomial_ne_zero (P : MvPolynomial (Fin n) ℝ) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) : levelPolynomial P t ≠ 0 := by
  intro hz
  have he : homogeneousComponent P.totalDegree P = C t := sub_eq_zero.mp hz
  have hdegree := (homogeneousComponent_isHomogeneous P.totalDegree P).totalDegree
    (top_homogeneousComponent_ne_zero P (by omega))
  rw [he, totalDegree_C] at hdegree
  omega

theorem levelPolynomial_gradient (P : MvPolynomial (Fin n) ℝ) (t : ℝ) :
    evaluatedGradient (levelPolynomial P t) =
      evaluatedGradient (homogeneousComponent P.totalDegree P) := by
  funext x i
  simp [levelPolynomial, evaluatedGradient]

theorem levelPolynomial_normalizedField (P : MvPolynomial (Fin n) ℝ) (t : ℝ) :
    leadingNormalizedField (levelPolynomial P t) =
      leadingNormalizedField (homogeneousComponent P.totalDegree P) := by
  funext x i
  simp only [leadingNormalizedField, levelPolynomial_gradient]

theorem levelPolynomial_weakCalibration (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) : WeakCalibration (leadingNormalizedField (levelPolynomial P t)) := by
  rw [levelPolynomial_normalizedField]
  exact top_weakCalibration P hmin hd

theorem levelPolynomial_approximation (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) : Approximation (graphField P) (leadingNormalizedField (levelPolynomial P t)) := by
  rw [levelPolynomial_normalizedField]
  exact graphField_approximation P hmin hd

/-- Every strict superlevel, including nonzero levels, minimizes local perimeter. -/
theorem top_superlevel_minimizing (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) : LocallyPerimeterMinimizing {x | t < eval x (homogeneousComponent P.totalDegree P)} := by
  simpa only [levelPolynomial, map_sub, eval_C, sub_pos] using
    phase_locally_perimeter_minimizing (levelPolynomial P t) (levelPolynomial_ne_zero P hd t)
      (levelPolynomial_weakCalibration P hmin hd t) (levelPolynomial_approximation P hmin hd t)

theorem top_sublevel_minimizing (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) : LocallyPerimeterMinimizing {x | eval x (homogeneousComponent P.totalDegree P) < t} := by
  apply locallyPerimeterMinimizing_congr_ae _
    (locallyPerimeterMinimizing_compl (top_superlevel_minimizing P hmin hd t))
  filter_upwards [mvPolynomial_eval_ne_zero_ae n (levelPolynomial P t) (levelPolynomial_ne_zero P hd t)] with x hx
  have hne : eval x (homogeneousComponent P.totalDegree P) ≠ t := by
    apply sub_ne_zero.mp
    simpa only [levelPolynomial, map_sub, eval_C] using hx
  change (¬ t < eval x (homogeneousComponent P.totalDegree P)) ↔
    eval x (homogeneousComponent P.totalDegree P) < t
  exact ⟨fun h ↦ lt_of_le_of_ne (le_of_not_gt h) hne, fun h ↦ not_lt_of_ge h.le⟩

theorem top_superlevel_perimeter_eq_mass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (t : ℝ) {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    (hcρ : HasCompactSupport ρ) (hρpos : ∀ x, 0 ≤ ρ x) :
    weightedPerimeter {x | t < eval x (homogeneousComponent P.totalDegree P)} ρ =
      ENNReal.ofReal (phaseMass (levelPolynomial P t) ρ) := by
  have he : Source29WeightedPhaseVariation.positivePhase (levelPolynomial P t) =
      fun x ↦ if t < eval x (homogeneousComponent P.totalDegree P) then (1 : ℝ) else 0 := by
    funext x
    simp [Source29WeightedPhaseVariation.positivePhase, levelPolynomial]
  change weightedVariation (fun x ↦ if t < eval x (homogeneousComponent P.totalDegree P) then (1 : ℝ) else 0) ρ = _
  rw [← he]
  exact phase_variation_eq_mass (levelPolynomial P t) (levelPolynomial_ne_zero P hd t)
    (levelPolynomial_weakCalibration P hmin hd t) (levelPolynomial_approximation P hmin hd t)
    hρ hcρ hρpos

/-- Euler's identity makes every nonzero leading level regular. -/
theorem top_nonzero_level_gradient (P : MvPolynomial (Fin n) ℝ) (hd : 2 ≤ P.totalDegree)
    {t : ℝ} (ht : t ≠ 0) {x : Fin n → ℝ}
    (hx : eval x (homogeneousComponent P.totalDegree P) = t) :
    evaluatedGradient (homogeneousComponent P.totalDegree P) x ≠ 0 := by
  exact Source29TopWeakCalibration.evaluatedGradient_ne_zero_of_eval_ne_zero _
    (homogeneousComponent_isHomogeneous _ _) (by omega) (hx ▸ ht)

end
end Source29LeadingLevelPerimeter

/- Component: LeadingLevelMassContinuity.inc -/
namespace Source29LeadingLevelMassContinuity

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29LeadingLevelPerimeter Source29PhaseMassLimit Source29TopPhasePerimeter
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A moving polynomial threshold has continuous weighted volume because every level is null. -/
theorem integral_superlevel_continuous (F : MvPolynomial (Fin n) ℝ)
    (hF : ∀ t : ℝ, F - C t ≠ 0) {w : (Fin n → ℝ) → ℝ} (hw : Integrable w) :
    Continuous (fun t : ℝ ↦ ∫ x, w x * (if t < eval x F then 1 else 0)) := by
  apply continuous_iff_continuousAt.mpr
  intro t₀
  apply continuousAt_of_dominated (bound := fun x ↦ ‖w x‖)
  · apply Filter.Eventually.of_forall
    intro t
    have hs : MeasurableSet {x : Fin n → ℝ | t < eval x F} :=
      (isOpen_lt continuous_const (contDiff_eval F).continuous).measurableSet
    convert (hw.indicator hs).aestronglyMeasurable using 1
    funext x
    by_cases hx : t < eval x F <;> simp [Set.indicator, hx]
  · apply Filter.Eventually.of_forall
    intro t
    apply Filter.Eventually.of_forall
    intro x
    split_ifs <;> simp
  · exact hw.norm
  · filter_upwards [mvPolynomial_eval_ne_zero_ae n (F - C t₀) (hF t₀)] with x hx
    have hne : eval x F ≠ t₀ := sub_ne_zero.mp (by simpa only [map_sub, eval_C] using hx)
    have he : (fun t : ℝ ↦ w x * (if t < eval x F then 1 else 0)) =ᶠ[𝓝 t₀]
        (fun _ ↦ w x * (if t₀ < eval x F then 1 else 0)) := by
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · filter_upwards [lt_mem_nhds hlt] with t ht
        simp only [not_lt_of_ge hlt.le, not_lt_of_ge ht.le, ite_false, mul_zero]
      · filter_upwards [gt_mem_nhds hgt] with t ht
        simp only [hgt, ht, ite_true, mul_one]
    exact continuousAt_const.congr_of_eventuallyEq he

theorem level_phaseMass_eq (P : MvPolynomial (Fin n) ℝ) (t : ℝ)
    (ρ : (Fin n → ℝ) → ℝ) :
    phaseMass (levelPolynomial P t) ρ =
      -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ
        (leadingNormalizedField (homogeneousComponent P.totalDegree P)) x *
        (if t < eval x (homogeneousComponent P.totalDegree P) then 1 else 0)) := by
  unfold phaseMass
  rw [levelPolynomial_normalizedField]
  simp only [levelPolynomial, map_sub, eval_C, sub_pos]

/-- The calibrated perimeter masses vary continuously with the level, including at zero. -/
theorem level_phaseMass_continuous (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Continuous (fun t : ℝ ↦ phaseMass (levelPolynomial P t) ρ) := by
  simp_rw [level_phaseMass_eq]
  apply Continuous.neg
  apply integral_superlevel_continuous _ (fun t ↦ levelPolynomial_ne_zero P hd t)
  exact (top_weakCalibration P hmin hd).2 ρ hρ hcρ |>.1

theorem level_weightedPerimeter_continuous (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    Continuous (fun t : ℝ ↦ weightedPerimeter
      {x | t < eval x (homogeneousComponent P.totalDegree P)} ρ) := by
  simp_rw [top_superlevel_perimeter_eq_mass P hmin hd _ hρ hcρ hρpos]
  exact ENNReal.continuous_ofReal.comp (level_phaseMass_continuous P hmin hd hρ hcρ)

end
end Source29LeadingLevelMassContinuity

/- Component: LeadingLevelContinuousMass.inc -/
namespace Source29LeadingLevelContinuousMass

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29LeadingLevelPerimeter
open Source29PhaseMassLimit Source29PhaseMassFunctional Source29SmoothMassLimits
open Source29SmoothMassExtension Source29LocalPhasePerimeter Source29LeadingLevelMassContinuity
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- One compact-support bound works for all levels, including through singular levels. -/
theorem level_phaseMass_bounded_on_compact (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ t : ℝ, ∀ σ : (Fin n → ℝ) → ℝ,
      ContDiff ℝ 1 σ → HasCompactSupport σ → tsupport σ ⊆ K →
      ∀ C : ℝ, 0 ≤ C → (∀ x, |σ x| ≤ C) → |phaseMass (levelPolynomial P t) σ| ≤ C * M := by
  obtain ⟨ρ, hρ, hcρ, _, hρb, hρone, _⟩ :=
    exists_local_cutoff K Set.univ hK isOpen_univ (Set.subset_univ K)
  let M := ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x
  refine ⟨M, integral_nonneg (fun x ↦ Finset.sum_nonneg (fun i _ ↦ norm_nonneg _)), ?_⟩
  intro t σ hσ hcσ hsσ C hC hb
  have hcal := levelPolynomial_weakCalibration P hmin hd t
  have hne := levelPolynomial_ne_zero P hd t
  have hbound : |phaseMass (levelPolynomial P t) σ| ≤ C * phaseMass (levelPolynomial P t) ρ := by
    apply phaseMass_abs_le _ hne hcal hρ hcρ hσ hcσ C
    intro x
    by_cases hx : x ∈ K
    · simpa only [hρone x hx, mul_one] using hb x
    · have hz : σ x = 0 := image_eq_zero_of_notMem_tsupport (fun ht ↦ hx (hsσ ht))
      rw [hz, abs_zero]
      exact mul_nonneg hC (hρb x).1
  exact hbound.trans (mul_le_mul_of_nonneg_left
    (phaseMass_bounds _ hne hcal hρ hcρ (fun x ↦ (hρb x).1)).2 hC)

theorem level_approximation_error (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {f : (Fin n → ℝ) → ℝ} (a : Approximation f) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ k t,
      |phaseMass (levelPolynomial P t) (a.fn k) - continuousMass (levelPolynomial P t) f| ≤
        a.error k * M := by
  obtain ⟨M, hM, hbound⟩ := level_phaseMass_bounded_on_compact P hmin hd a.carrier a.compact_carrier
  refine ⟨M, hM, ?_⟩
  intro k t
  have ht := (tendsto_const_nhds (x := phaseMass (levelPolynomial P t) (a.fn k))).sub
    (continuousMass_tendsto _ (levelPolynomial_ne_zero P hd t)
      (levelPolynomial_weakCalibration P hmin hd t) a)
  have he : Tendsto (fun j ↦ (a.error k + a.error j) * M) atTop (𝓝 (a.error k * M)) := by
    simpa only [add_zero] using (a.tends.const_add (a.error k)).mul_const M
  apply le_of_tendsto_of_tendsto ht.abs he
  apply Filter.Eventually.of_forall
  intro j
  have hs : tsupport (fun x ↦ a.fn k x - a.fn j x) ⊆ a.carrier :=
    (tsupport_binop_subset (fun b c : ℝ ↦ b - c) (sub_self 0) _ _).trans
      (Set.union_subset (a.within k) (a.within j))
  have hb : ∀ x, |a.fn k x - a.fn j x| ≤ a.error k + a.error j := by
    intro x
    calc
      _ ≤ |a.fn k x - f x| + |f x - a.fn j x| := abs_sub_le _ _ _
      _ = |a.fn k x - f x| + |a.fn j x - f x| := by rw [abs_sub_comm (f x)]
      _ ≤ _ := add_le_add (a.bound k x) (a.bound j x)
  have h := hbound t (fun x ↦ a.fn k x - a.fn j x)
    ((a.smooth k).sub (a.smooth j)) ((a.compact k).sub (a.compact j)) hs
    (a.error k + a.error j) (add_nonneg (a.nonneg k) (a.nonneg j)) hb
  rwa [phaseMass_sub _ (levelPolynomial_ne_zero P hd t)
    (levelPolynomial_weakCalibration P hmin hd t) (a.smooth k) (a.compact k)
    (a.smooth j) (a.compact j)] at h

/-- Smooth approximation is uniform in the level parameter. -/
theorem level_mass_tendstoUniformly (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {f : (Fin n → ℝ) → ℝ} (a : Approximation f) :
    TendstoUniformly (fun (k : ℕ) (t : ℝ) ↦ phaseMass (levelPolynomial P t) (a.fn k))
      (fun t ↦ continuousMass (levelPolynomial P t) f) atTop := by
  obtain ⟨M, _, hb⟩ := level_approximation_error P hmin hd a
  apply Metric.tendstoUniformly_iff.mpr
  intro ε hε
  have he : Tendsto (fun k ↦ a.error k * M) atTop (𝓝 0) := by simpa using a.tends.mul_const M
  filter_upwards [he.eventually (gt_mem_nhds hε)] with k hk
  intro t
  rw [Real.dist_eq, abs_sub_comm]
  exact (hb k t).trans_lt hk

/-- Level perimeter mass is continuous against every compact continuous weight. -/
theorem level_continuousMass_continuous (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {f : (Fin n → ℝ) → ℝ} (hf : Continuous f) (hcf : HasCompactSupport f) :
    Continuous (fun t : ℝ ↦ continuousMass (levelPolynomial P t) f) := by
  obtain ⟨a⟩ := exists_approximation f hf hcf
  apply (level_mass_tendstoUniformly P hmin hd a).continuous
  exact (Filter.Eventually.of_forall fun k ↦ level_phaseMass_continuous P hmin hd (a.smooth k) (a.compact k)).frequently

end
end Source29LeadingLevelContinuousMass

/- Component: LevelRadialStress.inc -/
namespace Source29LevelRadialStress

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29PolynomialStress
open Source29NormalBall Source29NormalPenalty Source29ProjectedTraceAlgebra
open Source29GradientBarrierCalculus Source29VariationConvexity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def radialWeight (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ := f (radiusSq x / r^2)
def radialField (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) (j : Fin n) : ℝ := radialWeight f r x * x j

theorem radialWeight_contDiff {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ) :
    ContDiff ℝ 1 (radialWeight (n := n) f r) := hf.comp (radiusSq_contDiff.div_const _)

theorem radialWeight_compact {f : ℝ → ℝ} {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ s, R ≤ s → f s = 0) : HasCompactSupport (radialWeight (n := n) f r) := by
  change HasCompactSupport (fun x : Fin n → ℝ ↦ f (radiusSq x/r^2))
  simpa only [Source29GraphRadialGeometry.graphRadiusSq, Pi.zero_apply,
    zero_pow (by decide : 2 ≠ 0), add_zero, radiusSq] using
    Source29GraphRadialSupport.scaled_cutoff_compact (0 : (Fin n → ℝ) → ℝ) hR hr hz

theorem radialWeight_fderiv {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (radialWeight f r) x (Pi.single i 1) =
      (2 / r^2) * deriv f (radiusSq x / r^2) * x i := by
  have hzero : Source29GraphRadialGeometry.graphRadiusSq (0 : (Fin n → ℝ) → ℝ) = radiusSq := by
    funext y
    simp [Source29GraphRadialGeometry.graphRadiusSq, radiusSq]
  have hs : fderiv ℝ (radiusSq : (Fin n → ℝ) → ℝ) x (Pi.single i 1) = 2 * x i := by
    have h := Source29GraphRadialGeometry.graphRadiusSq_fderiv
      (u := (0 : (Fin n → ℝ) → ℝ)) (g := (0 : (Fin n → ℝ) → Fin n → ℝ))
      contDiff_const (by intro y j; simp) x i
    rw [hzero] at h
    simpa using h
  have hq : HasFDerivAt (fun y : Fin n → ℝ ↦ radiusSq y / r^2)
      ((r^2)⁻¹ • fderiv ℝ radiusSq x) x := by
    simpa only [Function.comp_def, id_eq, one_div] using
      (((hasDerivAt_id (radiusSq x)).div_const (r^2)).comp_hasFDerivAt x
        ((radiusSq_contDiff.differentiable (by norm_num) x).hasFDerivAt))
  have hd := ((hf.differentiable (by norm_num) (radiusSq x / r^2)).hasDerivAt).comp_hasFDerivAt x hq
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  change fderiv ℝ (radialWeight f r) x (Pi.single i 1) = _ at he
  simp only [_root_.smul_apply, smul_eq_mul, hs] at he
  rw [he]
  ring

theorem radialField_contDiff {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ) (j : Fin n) :
    ContDiff ℝ 1 (fun x ↦ radialField f r x j) :=
  (radialWeight_contDiff hf r).mul (contDiff_apply ℝ ℝ j)

theorem radialField_compact {f : ℝ → ℝ} {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ s, R ≤ s → f s = 0) (j : Fin n) :
    HasCompactSupport (fun x ↦ radialField f r x j) := (radialWeight_compact hR hr hz).mul_right

theorem radialField_jacobian {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ)
    (x : Fin n → ℝ) (i j : Fin n) :
    coordinateJacobian (radialField f r) x i j =
      radialWeight f r x * (if i = j then 1 else 0) +
      ((2 / r^2) * deriv f (radiusSq x / r^2)) * (x i * x j) := by
  have hd := (((radialWeight_contDiff hf r).differentiable (by norm_num) x).hasFDerivAt).fun_mul
    (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) j x)
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  change coordinateJacobian (radialField f r) x i j = _ at he
  simp only [ContinuousLinearMap.add_apply, _root_.smul_apply, smul_eq_mul,
    ContinuousLinearMap.proj_apply, Pi.single_apply, radialWeight_fderiv hf] at he
  rw [he]
  simp only [eq_comm]
  ring

theorem projectedTrace_identity (N : Fin n → ℝ) :
    projectedTrace (fun i j : Fin n ↦ if i = j then (1 : ℝ) else 0) N = (n : ℝ) - sqNorm N := by
  simp [projectedTrace, trace, quad, sqNorm, ite_mul, pow_two]

theorem normalizedField_sqNorm (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ)
    (hg : evaluatedGradient P x ≠ 0) : sqNorm (leadingNormalizedField P x) = 1 := by
  have hp := Source29NormalBall.sqNorm_pos hg
  simp only [sqNorm, leadingNormalizedField, div_pow, ← Finset.sum_div]
  change sqNorm (evaluatedGradient P x) / (Real.sqrt (sqNorm (evaluatedGradient P x)))^2 = 1
  rw [Real.sq_sqrt hp.le, div_self hp.ne']

/-- Radial first variation, including the critical set where its density is zero. -/
theorem stressPair_radial (P : MvPolynomial (Fin (n+1)) ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ) (x : Fin (n+1) → ℝ) :
    stressPair P (radialField f r) x = variationDensity (evaluatedGradient P x) *
      ((n : ℝ) * radialWeight f r x + (2/r^2) * deriv f (radiusSq x/r^2) *
        (radiusSq x - (dot (leadingNormalizedField P x) x)^2)) := by
  rw [stressPair_eq_tangentialDivergence]
  by_cases hg : evaluatedGradient P x = 0
  · simp [hg, variationDensity]
  · rw [tangentialDivergence_eq_projectedTrace]
    have hj : coordinateJacobian (radialField f r) x =
        fun i j ↦ radialWeight f r x * (if i = j then 1 else 0) +
          ((2/r^2) * deriv f (radiusSq x/r^2)) * (x i * x j) := by
      funext i j
      exact radialField_jacobian hf r x i j
    rw [hj, projectedTrace_add, projectedTrace_smul, projectedTrace_smul,
      projectedTrace_identity, projectedTrace_square, normalizedField_sqNorm P x hg]
    simp only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right, penalty, sqNorm, radiusSq]
    ring

end
end Source29LevelRadialStress

/- Component: WeightedRadialDerivative.inc -/
namespace Source29WeightedRadialDerivative

open MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29LevelRadialStress Source29GraphRadialSupport
open scoped Topology

noncomputable section
variable {n : ℕ}

def density (w : (Fin n → ℝ) → ℝ) (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ :=
  radialWeight f r x * w x
def densityDeriv (w : (Fin n → ℝ) → ℝ) (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ :=
  (-2 * radiusSq x / r^3) * deriv f (radiusSq x / r^2) * w x
def mass (w : (Fin n → ℝ) → ℝ) (f : ℝ → ℝ) (r : ℝ) : ℝ := ∫ x, density w f r x

theorem density_hasDerivAt (w : (Fin n → ℝ) → ℝ) {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : r ≠ 0) (x : Fin n → ℝ) :
    HasDerivAt (fun t ↦ density w f t x) (densityDeriv w f r x) r := by
  have ha : HasDerivAt (fun t : ℝ ↦ radiusSq x / t^2) (-2 * radiusSq x / r^3) r := by
    convert (hasDerivAt_const r (radiusSq x)).div ((hasDerivAt_id r).pow 2) (pow_ne_zero 2 hr) using 1
    · funext t
      rfl
    · simp only [Pi.pow_apply, id_eq]
      field_simp
      <;> ring
  have hd := ((hf.differentiable (by norm_num) (radiusSq x/r^2)).hasDerivAt.comp r ha).mul_const (w x)
  convert hd using 1
  · funext t
    rfl
  · unfold densityDeriv
    ring

theorem density_continuous {w : (Fin n → ℝ) → ℝ} (hw : Continuous w)
    {f : ℝ → ℝ} (hf : Continuous f) (r : ℝ) : Continuous (density w f r) :=
  (hf.comp (radiusSq_contDiff.continuous.div_const _)).mul hw

theorem densityDeriv_continuous {w : (Fin n → ℝ) → ℝ} (hw : Continuous w)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ) : Continuous (densityDeriv w f r) :=
  (((radiusSq_contDiff.continuous.const_mul (-2)).div_const _).mul
    (hf.continuous_deriv_one.comp (radiusSq_contDiff.continuous.div_const _))).mul hw

theorem densityDeriv_continuousAt {w : (Fin n → ℝ) → ℝ} (hw : Continuous w)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (p : ℝ × (Fin n → ℝ)) (hp : p.1 ≠ 0) :
    ContinuousAt (fun q : ℝ × (Fin n → ℝ) ↦ densityDeriv w f q.1 q.2) p := by
  have hs := (radiusSq_contDiff.continuous.comp continuous_snd).continuousAt (x := p)
  have harg := hs.div ((continuous_fst.pow 2).continuousAt) (pow_ne_zero 2 hp)
  exact ((((hs.const_mul (-2)).div ((continuous_fst.pow 3).continuousAt) (pow_ne_zero 3 hp)).mul
    (hf.continuous_deriv_one.continuousAt.comp harg)).mul (hw.comp continuous_snd).continuousAt)

theorem radialWeight_zero_outside_box {f : ℝ → ℝ} {R b r : ℝ} (hR : 0 ≤ R)
    (hr : 0 < r) (hrb : r ≤ b) (hz : ∀ s, R ≤ s → f s = 0)
    (x : Fin n → ℝ) (hx : x ∉ supportBox n (R*b^2)) : radialWeight f r x = 0 := by
  change f (radiusSq x / r^2) = 0
  simpa only [Source29GraphRadialGeometry.graphRadiusSq, Pi.zero_apply,
    zero_pow (by decide : 2 ≠ 0), add_zero, radiusSq] using
    scaled_cutoff_zero_outside_box (0 : (Fin n → ℝ) → ℝ) hR hr hrb hz x hx

theorem density_integrable {w : (Fin n → ℝ) → ℝ} (hw : Continuous w)
    {f : ℝ → ℝ} (hf : Continuous f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ s, R ≤ s → f s = 0) : Integrable (density w f r) :=
  (density_continuous hw hf r).integrable_of_hasCompactSupport (radialWeight_compact hR hr hz).mul_right

theorem mass_hasDerivAt {w : (Fin n → ℝ) → ℝ} (hw : Continuous w)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ s, R ≤ s → f s = 0) (hdz : ∀ s, R ≤ s → deriv f s = 0) :
    Integrable (densityDeriv w f r) ∧ HasDerivAt (mass w f) (∫ x, densityDeriv w f r x) r := by
  apply Source29CompactParameterIntegral.hasDerivAt_integral
    (a := r/2) (b := 2*r) (K := supportBox n (R*(2*r)^2))
    (by linarith) (by linarith) (supportBox_compact _ _)
  · intro t ht
    exact density_continuous hw hf.continuous t
  · intro t ht
    exact densityDeriv_continuous hw hf t
  · intro p hp
    exact (densityDeriv_continuousAt hw hf p (by linarith [hp.1.1])).continuousWithinAt
  · intro t ht x hx
    unfold density
    rw [radialWeight_zero_outside_box hR (by linarith [ht.1]) ht.2 hz x hx, zero_mul]
  · intro t ht x hx
    have hzero := radialWeight_zero_outside_box hR (by linarith [ht.1]) ht.2 hdz x hx
    change deriv f (radiusSq x/t^2) = 0 at hzero
    unfold densityDeriv
    rw [hzero, mul_zero, zero_mul]
  · intro x t ht
    exact density_hasDerivAt w hf (by linarith [ht.1]) x

end
end Source29WeightedRadialDerivative

/- Component: LevelRadialMonotonicity.inc -/
namespace Source29LevelRadialMonotonicity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits
open Source29PolynomialStress Source29LevelStressStationarity Source29LevelRadialStress
open Source29WeightedRadialDerivative Source29PhaseMassLimit Source29SmoothPhaseTransition
open scoped Topology

noncomputable section
variable {n : ℕ}

def diffuseWeight (P : MvPolynomial (Fin n) ℝ) (h : ℝ → ℝ) (x : Fin n → ℝ) : ℝ :=
  h (eval x P) * variationDensity (evaluatedGradient P x)

theorem diffuseWeight_continuous (P : MvPolynomial (Fin n) ℝ) {h : ℝ → ℝ} (hh : Continuous h) :
    Continuous (diffuseWeight P h) :=
  (hh.comp (contDiff_eval P).continuous).mul
    (variationDensity_continuous _ (fun i ↦ (contDiff_eval (pderiv i P)).continuous))

def normalizedDiffuseMass (P : MvPolynomial (Fin (n+1)) ℝ) (h f : ℝ → ℝ) (r : ℝ) : ℝ :=
  mass (diffuseWeight P h) f r / r^n

/-- Radial stationarity makes the derivative numerator of normalized mass nonnegative. -/
theorem diffuse_radius_inequality (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hhpos : ∀ t, 0 ≤ h t)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (hdec : ∀ t, deriv f t ≤ 0) :
    0 ≤ r * (∫ x, densityDeriv (diffuseWeight P h) f r x) -
      (n : ℝ) * mass (diffuseWeight P h) f r := by
  have hw := diffuseWeight_continuous P hh.continuous
  have hd := mass_hasDerivAt hw hf hR hr hz hdz
  have hi := density_integrable hw hf.continuous hR hr hz
  have hs := weighted_stress_integral_zero P hcal (radialField f r)
    (radialField_contDiff hf r) (radialField_compact hR hr hz) hh
  have hpt (x : Fin (n+1) → ℝ) :
      -(h (eval x P) * stressPair P (radialField f r) x) ≤
        r * densityDeriv (diffuseWeight P h) f r x - (n : ℝ) * density (diffuseWeight P h) f r x := by
    have he : r * densityDeriv (diffuseWeight P h) f r x - (n : ℝ) * density (diffuseWeight P h) f r x +
        h (eval x P) * stressPair P (radialField f r) x =
        (-2/r^2) * deriv f (radiusSq x/r^2) *
          (Source29NormalPenalty.dot (leadingNormalizedField P x) x)^2 * diffuseWeight P h x := by
      rw [stressPair_radial P hf]
      unfold densityDeriv density diffuseWeight Source29LevelRadialStress.radialWeight
      have hn := hr.ne'
      field_simp
      <;> ring
    have hwp : 0 ≤ diffuseWeight P h x := mul_nonneg (hhpos _) (Real.sqrt_nonneg _)
    have hp : 0 ≤ (-2/r^2) * deriv f (radiusSq x/r^2) *
        (Source29NormalPenalty.dot (leadingNormalizedField P x) x)^2 * diffuseWeight P h x :=
      mul_nonneg (mul_nonneg (mul_nonneg_of_nonpos_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg (by norm_num) (sq_nonneg r)) (hdec _)) (sq_nonneg _)) hwp
    linarith
  have hm := integral_mono hs.1.neg ((hd.1.const_mul r).sub (hi.const_mul (n : ℝ))) hpt
  simp only [Pi.neg_apply, Pi.sub_apply] at hm
  rw [integral_neg, hs.2, neg_zero,
    integral_sub (hd.1.const_mul r) (hi.const_mul (n : ℝ)), integral_const_mul, integral_const_mul] at hm
  exact hm

theorem normalizedDiffuseMass_monotoneOn (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hhpos : ∀ t, 0 ≤ h t)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (hdec : ∀ t, deriv f t ≤ 0) : MonotoneOn (normalizedDiffuseMass P h f) (Ioi 0) := by
  have hd (r : ℝ) (hr : 0 < r) := Source29GraphMassMonotonicity.normalized_hasDerivAt
    (mass_hasDerivAt (diffuseWeight_continuous P hh.continuous) hf hR hr hz hdz).2 hr.ne' n
  apply monotoneOn_of_deriv_nonneg (convex_Ioi (0 : ℝ))
  · intro r hr
    exact (hd r hr).continuousAt.continuousWithinAt
  · intro r hr
    exact (hd r (by simpa only [interior_Ioi, mem_Ioi] using hr)).differentiableAt.differentiableWithinAt
  · intro r hr
    have hr' : 0 < r := by simpa only [interior_Ioi, mem_Ioi] using hr
    change 0 ≤ deriv (fun t ↦ mass (diffuseWeight P h) f t / t^n) r
    rw [(hd r hr').deriv]
    exact div_nonneg (diffuse_radius_inequality P hcal hh hhpos hf hR hr' hz hdz hdec)
      (pow_pos hr' _).le

def normalizedPhaseMass (P : MvPolynomial (Fin (n+1)) ℝ) (f : ℝ → ℝ) (r : ℝ) : ℝ :=
  phaseMass P (radialWeight f r) / r^n

theorem normalizedDiffuseMass_tendsto (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r) (hz : ∀ t, R ≤ t → f t = 0) :
    Tendsto (fun k ↦ normalizedDiffuseMass P (deriv (transition k)) f r) atTop
      (𝓝 (normalizedPhaseMass P f r)) := by
  have ht := phaseMass_tendsto P hP hcal (radialWeight_contDiff hf r) (radialWeight_compact hR hr hz)
  unfold normalizedPhaseMass
  convert ht.div_const (r^n) using 1
  funext k
  unfold normalizedDiffuseMass mass
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ by unfold density diffuseWeight; ring

/-- Smoothed perimeter divided by radius to the hypersurface dimension is monotone. -/
theorem normalizedPhaseMass_monotoneOn (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ t, R ≤ t → f t = 0)
    (hdz : ∀ t, R ≤ t → deriv f t = 0) (hdec : ∀ t, deriv f t ≤ 0) :
    MonotoneOn (normalizedPhaseMass P f) (Ioi 0) := by
  intro r hr s hs hrs
  apply le_of_tendsto_of_tendsto (normalizedDiffuseMass_tendsto P hP hcal hf hR hr hz)
    (normalizedDiffuseMass_tendsto P hP hcal hf hR hs hz)
  exact Filter.Eventually.of_forall fun k ↦ normalizedDiffuseMass_monotoneOn P hcal
    (transition_deriv_contDiff k) (transition_deriv_nonneg k) hf hR hz hdz hdec hr hs hrs

end
end Source29LevelRadialMonotonicity

/- Component: LeadingLevelRadialMonotonicity.inc -/
namespace Source29LeadingLevelRadialMonotonicity

open MvPolynomial Set
open Source29QuarticReuse.FluxObstruction
open Source29PolynomialTranslation Source29WeakCalibrationLimits Source29TopLocalInitial
open Source29LeadingLevelPerimeter Source29LevelRadialMonotonicity
open Source29PolynomialGraphMonotonicity

noncomputable section

variable {n : ℕ}

theorem translated_level_ne_zero (P : MvPolynomial (Fin n) ℝ)
    (hd : 2 ≤ P.totalDegree) (t : ℝ) (c : Fin n → ℝ) :
    translate (levelPolynomial P t) c ≠ 0 :=
  translate_ne_zero (levelPolynomial P t) c (levelPolynomial_ne_zero P hd t)

/-- Translation and subtraction of a level leave exactly the translated
normalized gradient of the leading homogeneous polynomial. -/
theorem translated_level_normalizedField (P : MvPolynomial (Fin n) ℝ)
    (t : ℝ) (c : Fin n → ℝ) :
    leadingNormalizedField (translate (levelPolynomial P t) c) =
      fun x => leadingNormalizedField (homogeneousComponent P.totalDegree P) (c + x) := by
  funext x
  rw [leadingNormalizedField_translate, levelPolynomial_normalizedField]

theorem translated_level_weakCalibration (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hd : 2 ≤ P.totalDegree) (t : ℝ) (c : Fin n → ℝ) :
    WeakCalibration (leadingNormalizedField (translate (levelPolynomial P t) c)) := by
  rw [translated_level_normalizedField]
  simpa only [one_smul] using top_affine_weakCalibration P hmin hd c 1 one_ne_zero

/-- Every leading level of a full polynomial minimal graph has monotone
normalized smoothed phase mass about every center. The level may be singular. -/
theorem translated_level_normalizedPhaseMass_monotoneOn
    (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hd : 2 ≤ P.totalDegree) (t : ℝ) (c : Fin (n + 1) → ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ s, R ≤ s → f s = 0) (hdz : ∀ s, R ≤ s → deriv f s = 0)
    (hdec : ∀ s, deriv f s ≤ 0) :
    MonotoneOn (normalizedPhaseMass (translate (levelPolynomial P t) c) f) (Ioi 0) :=
  normalizedPhaseMass_monotoneOn (translate (levelPolynomial P t) c)
    (translated_level_ne_zero P hd t c) (translated_level_weakCalibration P hmin hd t c)
    hf hR hz hdz hdec

theorem translated_level_radialMass_monotoneOn
    (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hd : 2 ≤ P.totalDegree) (t : ℝ) (c : Fin (n + 1) → ℝ) :
    MonotoneOn (normalizedPhaseMass (translate (levelPolynomial P t) c) radialCutoff) (Ioi 0) :=
  translated_level_normalizedPhaseMass_monotoneOn P hmin hd t c
    radialCutoff_contDiff (R := 2) (by norm_num)
    radialCutoff_zero radialCutoff_deriv_zero radialCutoff_deriv_nonpos

end
end Source29LeadingLevelRadialMonotonicity

/- Component: PhaseMassDilation.inc -/
namespace Source29PhaseMassDilation

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29LevelRadialStress Source29LevelRadialMonotonicity Source29PhaseMassLimit
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- The phase flux on the unit radial scale after dilating its field and phase. -/
def rescaledPhaseMass (P : MvPolynomial (Fin (n+1)) ℝ) (f : ℝ → ℝ) (r : ℝ) : ℝ :=
  -(∫ x, testFlux (fun i ↦ Pi.single i 1) (radialWeight f 1)
    (fun y ↦ leadingNormalizedField P (r • y)) x *
      (if 0 < eval (r • x) P then 1 else 0))

lemma radiusSq_dilate {r : ℝ} (hr : r ≠ 0) (x : Fin n → ℝ) :
    radiusSq (r • x) / r^2 = radiusSq x := by
  simp only [radiusSq, Pi.smul_apply, smul_eq_mul, mul_pow, ← Finset.mul_sum]
  field_simp

lemma testFlux_radial_dilate {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (F : (Fin n → ℝ) → Fin n → ℝ) {r : ℝ} (hr : r ≠ 0) (x : Fin n → ℝ) :
    r * testFlux (fun i ↦ Pi.single i 1) (radialWeight f r) F (r • x) =
      testFlux (fun i ↦ Pi.single i 1) (radialWeight f 1) (fun y ↦ F (r • y)) x := by
  simp only [testFlux, radialWeight_fderiv hf, radiusSq_dilate hr, one_pow, div_one,
    Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  field_simp
  <;> ring

/-- The ambient Jacobian contributes r^(n+1), while the radial differential
contributes r⁻¹. Thus the normalized phase mass is a fixed-scale flux integral. -/
theorem normalizedPhaseMass_eq_rescaled (P : MvPolynomial (Fin (n+1)) ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : 0 < r) :
    normalizedPhaseMass P f r = rescaledPhaseMass P f r := by
  let g : (Fin (n+1) → ℝ) → ℝ := fun x ↦
    testFlux (fun i ↦ Pi.single i 1) (radialWeight f r) (leadingNormalizedField P) x *
      (if 0 < eval x P then 1 else 0)
  have he := Measure.integral_comp_smul_of_nonneg volume g r (hR := hr.le)
  simp only [Module.finrank_pi, Module.finrank_self, Fintype.card_fin, mul_one, smul_eq_mul] at he
  have halgebra (a : ℝ) : -a / r^n = -(r * ((r^(n+1))⁻¹ * a)) := by
    rw [pow_succ]
    field_simp
    <;> ring
  change -(∫ x, g x) / r^n = _
  rw [halgebra, ← he, ← integral_const_mul]
  unfold rescaledPhaseMass
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ by
    dsimp only [g]
    rw [← mul_assoc, testFlux_radial_dilate hf _ hr.ne']

end
end Source29PhaseMassDilation

/- Component: InitialPhaseFluxLimit.inc -/
namespace Source29InitialPhaseFluxLimit

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29InitialGradientLimit Source29RealLowestRescale
open Source29PhaseMassLimit
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem normalizedField_smul_measurable (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (i : Fin n) :
    Measurable (fun x : Fin n → ℝ ↦ leadingNormalizedField P (r • x) i) := by
  have hg (j : Fin n) : Continuous (fun x : Fin n → ℝ ↦ evaluatedGradient P (r • x) j) :=
    (contDiff_eval (pderiv j P)).continuous.comp (by fun_prop)
  have hs : Continuous (fun x : Fin n → ℝ ↦ radiusSq (evaluatedGradient P (r • x))) := by
    exact continuous_finsetSum _ (fun j _ ↦ (hg j).pow 2)
  exact (hg i).measurable.div hs.sqrt.measurable

theorem scaled_phase_measurable (P : MvPolynomial (Fin n) ℝ) (r : ℝ) :
    Measurable (fun x : Fin n → ℝ ↦ if 0 < eval (r • x) P then (1 : ℝ) else 0) := by
  have hc : Continuous (fun x : Fin n → ℝ ↦ eval (r • x) P) :=
    (contDiff_eval P).continuous.comp (by fun_prop)
  exact Measurable.ite (isOpen_lt continuous_const hc).measurableSet measurable_const measurable_const

theorem scaled_flux_measurable (P : MvPolynomial (Fin n) ℝ) (r : ℝ)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) :
    Measurable (testFlux (fun i ↦ Pi.single i 1) ρ (fun x ↦ leadingNormalizedField P (r • x))) := by
  apply Finset.measurable_sum
  intro i hi
  exact ((hρ.continuous_fderiv (by norm_num)).clm_apply continuous_const).measurable.mul
    (normalizedField_smul_measurable P r i)

theorem scaled_phase_initial_limit (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s+1, homogeneousComponent k P = 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    (x : Fin n → ℝ) (hx : eval x (homogeneousComponent (s+1) P) ≠ 0) :
    Tendsto (fun k ↦ if 0 < eval (t k • x) P then (1 : ℝ) else 0) atTop
      (𝓝 (if 0 < eval x (homogeneousComponent (s+1) P) then (1 : ℝ) else 0)) := by
  have hl := ((continuous_eval_rescale P (s+1) x).tendsto 0).comp ht0
  rw [rescale_zero P (s+1) hlow] at hl
  have he (k : ℕ) : (0 < eval (t k • x) P) ↔ 0 < eval x (rescale P (s+1) (t k)) := by
    change (0 < eval (fun i ↦ t k * x i) P) ↔ _
    rw [← eval_rescale_mul P (s+1) hlow]
    exact mul_pos_iff_of_pos_left (pow_pos (ht k) _)
  by_cases hp : 0 < eval x (homogeneousComponent (s+1) P)
  · have hpos := hl.eventually (eventually_gt_nhds hp)
    apply tendsto_const_nhds.congr'
    filter_upwards [hpos] with k hk
    simp only [ite_eq_left hp, ite_eq_left ((he k).mpr hk)]
  · have hn : eval x (homogeneousComponent (s+1) P) < 0 := lt_of_le_of_ne (le_of_not_gt hp) hx
    have hneg := hl.eventually (eventually_lt_nhds hn)
    apply tendsto_const_nhds.congr'
    filter_upwards [hneg] with k hk
    simp only [ite_eq_right hp, ite_eq_right (fun h ↦ (not_lt_of_ge hk.le) ((he k).mp h))]

/-- Every polynomial's phase flux converges under shrinking dilations to the flux
of its first nonzero positive-degree homogeneous component. -/
theorem phaseFlux_initial_limit (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s+1, homogeneousComponent k P = 0)
    (hne : homogeneousComponent (s+1) P ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k ↦ -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ
        (fun y ↦ leadingNormalizedField P (t k • y)) x *
          (if 0 < eval (t k • x) P then 1 else 0))) atTop
      (𝓝 (phaseMass (homogeneousComponent (s+1) P) ρ)) := by
  apply Tendsto.neg
  apply tendsto_integral_of_dominated_convergence (testBound (fun i ↦ Pi.single i 1) ρ)
  · intro k
    exact ((scaled_flux_measurable P (t k) hρ).mul (scaled_phase_measurable P (t k))).aestronglyMeasurable
  · exact testBound_integrable _ hρ hcρ
  · intro k
    exact Filter.Eventually.of_forall fun x ↦ by
      rw [norm_mul]
      have hb := norm_testFlux_le_testBound (fun i ↦ Pi.single i 1) ρ
        (fun y ↦ leadingNormalizedField P (t k • y)) x (leadingNormalizedField_bound P _)
      split_ifs
      · simpa using hb
      · simpa using (norm_nonneg _).trans hb
  · filter_upwards [normalized_gradient_initial_limit_ae P s hlow hne ht ht0,
      mvPolynomial_eval_ne_zero_ae n _ hne] with x hx hpx
    exact (testFlux_tendsto (fun i ↦ Pi.single i 1) ρ hx).mul
      (scaled_phase_initial_limit P s hlow ht ht0 x hpx)

end
end Source29InitialPhaseFluxLimit

/- Component: InitialRadialMassLimit.inc -/
namespace Source29InitialRadialMassLimit

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29LevelRadialStress Source29LevelRadialMonotonicity Source29PhaseMassDilation
open Source29InitialPhaseFluxLimit Source29PhaseMassLimit
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The normalized radial phase mass tends to the mass of the first nonzero
homogeneous term under any sequence of positive dilations approaching zero. -/
theorem normalizedPhaseMass_initial_limit (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ k < s+1, homogeneousComponent k P = 0)
    (hne : homogeneousComponent (s+1) P ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ a, R ≤ a → f a = 0) :
    Tendsto (fun k ↦ normalizedPhaseMass P f (t k)) atTop
      (𝓝 (phaseMass (homogeneousComponent (s+1) P) (radialWeight f 1))) := by
  have hl := phaseFlux_initial_limit P s hlow hne ht ht0 (radialWeight_contDiff hf 1)
    (radialWeight_compact hR zero_lt_one hz)
  have he : (fun k ↦ normalizedPhaseMass P f (t k)) = fun k ↦ rescaledPhaseMass P f (t k) := by
    funext k
    exact normalizedPhaseMass_eq_rescaled P hf (ht k)
  rw [he]
  exact hl

/-- At every scale, monotonicity bounds the mass of the tangent polynomial by
the normalized phase mass of the calibrated polynomial. -/
theorem initial_phaseMass_le_normalized (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ k < s+1, homogeneousComponent k P = 0)
    (hne : homogeneousComponent (s+1) P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ a, R ≤ a → f a = 0) (hdz : ∀ a, R ≤ a → deriv f a = 0)
    (hdec : ∀ a, deriv f a ≤ 0) {r : ℝ} (hr : 0 < r) :
    phaseMass (homogeneousComponent (s+1) P) (radialWeight f 1) ≤ normalizedPhaseMass P f r := by
  have hP : P ≠ 0 := by
    intro hp
    apply hne
    simp [hp]
  let t : ℕ → ℝ := fun k ↦ (Source29QuarticReuse.FluxPolynomial.dilationRadius k)⁻¹
  have ht (k : ℕ) : 0 < t k := inv_pos.mpr (Source29QuarticReuse.FluxPolynomial.dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp Source29QuarticReuse.FluxPolynomial.dilationRadius_tendsto
  apply le_of_tendsto (normalizedPhaseMass_initial_limit P s hlow hne ht ht0 hf hR hz)
  filter_upwards [ht0.eventually (eventually_lt_nhds hr)] with k hk
  exact normalizedPhaseMass_monotoneOn P hP hcal hf hR hz hdz hdec (ht k) hr hk.le

end
end Source29InitialRadialMassLimit

/- Component: LinearRadialMass.inc -/
namespace Source29LinearRadialMass

open Matrix MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29LinearForm
open Source29LinearNormalRotation Source29LinearEndpointRotation Source29LinearPhaseMass
open Source29CoordinatePhaseMass Source29PhaseMassLimit Source29PolynomialSmallDensity
open Source29LevelRadialStress
open scoped BigOperators

noncomputable section
variable {n : ℕ}

lemma radialWeight_rotation (f : ℝ → ℝ) (r : ℝ)
    (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U.transpose * U = 1)
    (x : Fin (n+1) → ℝ) : radialWeight f r (U *ᵥ x) = radialWeight f r x := by
  unfold Source29LevelRadialStress.radialWeight
  rw [radiusSq_mulVec U hU x]

lemma radialWeight_testFlux_rotation {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ)
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) (hcol : ∀ i, U i 0 = unitVector a i)
    (x : Fin (n+1) → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (radialWeight f r)
      (leadingNormalizedField (linearForm a)) (U *ᵥ x) =
      fderiv ℝ (radialWeight f r) x (Pi.single 0 1) := by
  have hn : leadingNormalizedField (linearForm a) = fun _ ↦ unitVector a := by
    funext y
    exact normalizedField_linearForm a y
  rw [hn, testFlux_const]
  let L : (Fin (n+1) → ℝ) →L[ℝ] (Fin (n+1) → ℝ) := (Matrix.toLin' U).toContinuousLinearMap
  have hp := ((radialWeight_contDiff hf r).differentiable (by norm_num)
    (U *ᵥ x)).hasFDerivAt.comp x L.hasFDerivAt
  have he : (fun y ↦ radialWeight f r (L y)) = radialWeight f r := by
    funext y
    exact radialWeight_rotation f r U hU y
  change HasFDerivAt (fun y ↦ radialWeight f r (L y)) _ x at hp
  rw [he] at hp
  have hb := congrArg (fun D : (Fin (n+1) → ℝ) →L[ℝ] ℝ ↦ D (Pi.single 0 1)) hp.fderiv
  change fderiv ℝ (radialWeight f r) x (Pi.single 0 1) =
    fderiv ℝ (radialWeight f r) (U *ᵥ x) (U *ᵥ Pi.single 0 1) at hb
  rw [column_mulVec a U hcol] at hb
  exact hb.symm

/-- Rotation identifies the unit-scale radial phase mass of any nonzero linear
form with that of the first coordinate. -/
theorem phaseMass_linearForm_eq_coordinate (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ s, R ≤ s → f s = 0) :
    phaseMass (linearForm a) (radialWeight f 1) =
      phaseMass (X (0 : Fin (n+1))) (radialWeight f 1) := by
  obtain ⟨U,hU,hUt,hcol⟩ := exists_rotation a ha
  let W := testFlux (fun i ↦ Pi.single i 1) (radialWeight f 1)
    (leadingNormalizedField (linearForm a))
  let J := fun x ↦ W x * (if 0 < eval x (linearForm a) then 1 else 0)
  have hW : Integrable W := linear_flux_integrable a
    (radialWeight_contDiff hf 1) (radialWeight_compact hR zero_lt_one hz)
  have hJ : Integrable J := Source29PhaseApproximation.phase_weight_integrable
    (linearForm a) (linearForm_ne_zero_of_vector a ha) W hW
  have hr : 0 < Real.sqrt (radiusSq a) := Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero ha)
  have he (x : Fin (n+1) → ℝ) : J (U *ᵥ x) =
      fderiv ℝ (radialWeight f 1) x (Pi.single 0 1) * (if 0 < x 0 then 1 else 0) := by
    dsimp only [J,W]
    rw [radialWeight_testFlux_rotation hf 1 a U hU hcol x,
      linearForm_eval_rotation a ha U hU hcol x]
    simp only [mul_pos_iff_of_pos_left hr]
  have hi := integral_comp_rotation U hU hJ.aestronglyMeasurable
  change -(∫ x, J x) = _
  rw [← hi]
  simp_rw [he]
  simp only [phaseMass, testFlux_X, eval_X]

/-- A nonzero linear form has exactly the radial mass of an n-dimensional
plane, for an arbitrary compactly supported C1 radial cutoff. -/
theorem phaseMass_linearForm (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ s, R ≤ s → f s = 0) :
    phaseMass (linearForm a) (radialWeight f 1) = planeMass n f := by
  rw [phaseMass_linearForm_eq_coordinate a ha hf hR hz,
    phaseMass_X (radialWeight_contDiff hf 1) (radialWeight_compact hR zero_lt_one hz)]
  unfold planeMass
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ by
    simp [Source29LevelRadialStress.radialWeight, radiusSq, Fin.sum_univ_succ]

end
end Source29LinearRadialMass

/- Component: RegularPhaseDensity.inc -/
namespace Source29RegularPhaseDensity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29LinearForm Source29LinearPhaseMass Source29LinearRadialMass
open Source29WeakCalibrationLimits Source29LevelRadialStress Source29LevelRadialMonotonicity
open Source29InitialRadialMassLimit Source29PolynomialSmallDensity Source29PolynomialGraphMonotonicity
open Source29PolynomialTranslation Source29LeadingLevelPerimeter Source29LeadingLevelRadialMonotonicity
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- The linear Taylor term is the linear form given by the gradient at zero. -/
theorem homogeneousComponent_one_eq_linearForm (P : MvPolynomial (Fin n) ℝ) :
    homogeneousComponent 1 P = linearForm (evaluatedGradient P 0) := by
  rw [Source29QuarticReuse.QuarticMinimal.homogeneous_linear_expansion _
    (homogeneousComponent_isHomogeneous 1 P)]
  unfold linearForm
  apply Finset.sum_congr rfl
  intro i _
  rw [pderiv_homogeneousComponent P i 0, homogeneousComponent_zero]
  simp [evaluatedGradient, eval_zero, constantCoeff_eq]

theorem homogeneousComponent_zero_eq_zero (P : MvPolynomial (Fin n) ℝ)
    (hP : eval 0 P = 0) : homogeneousComponent 0 P = 0 := by
  rw [homogeneousComponent_zero]
  have hc : P.coeff 0 = 0 := by simpa only [eval_zero, constantCoeff_eq] using hP
  rw [hc, map_zero]

theorem homogeneousComponent_one_ne_zero (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hreg : evaluatedGradient P 0 ≠ 0) : homogeneousComponent 1 P ≠ 0 := by
  rw [homogeneousComponent_one_eq_linearForm]
  exact linearForm_ne_zero_of_vector _ hreg

/-- At a regular zero, every sequence of positive radii approaching zero has
the plane mass as its normalized radial phase-mass limit. No calibration
hypothesis is needed for this local density calculation. -/
theorem normalizedPhaseMass_regular_limit (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hP : eval 0 P = 0) (hreg : evaluatedGradient P 0 ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ a, R ≤ a → f a = 0) :
    Tendsto (fun k => normalizedPhaseMass P f (t k)) atTop (𝓝 (planeMass n f)) := by
  have hlow : ∀ k < 0 + 1, homogeneousComponent k P = 0 := by
    intro k hk
    have hk0 : k = 0 := by omega
    subst k
    exact homogeneousComponent_zero_eq_zero P hP
  have hl := normalizedPhaseMass_initial_limit P 0 hlow
    (homogeneousComponent_one_ne_zero P hreg) ht ht0 hf hR hz
  simpa only [Nat.zero_add, homogeneousComponent_one_eq_linearForm,
    phaseMass_linearForm (evaluatedGradient P 0) hreg hf hR hz] using hl

/-- For a calibrated polynomial, the density of its regular zero gives a
plane-mass lower bound at every positive radius. -/
theorem planeMass_le_normalizedPhaseMass (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hP : eval 0 P = 0) (hreg : evaluatedGradient P 0 ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ a, R ≤ a → f a = 0) (hdz : ∀ a, R ≤ a → deriv f a = 0)
    (hdec : ∀ a, deriv f a ≤ 0) {r : ℝ} (hr : 0 < r) :
    planeMass n f ≤ normalizedPhaseMass P f r := by
  have hlow : ∀ k < 0 + 1, homogeneousComponent k P = 0 := by
    intro k hk
    have hk0 : k = 0 := by omega
    subst k
    exact homogeneousComponent_zero_eq_zero P hP
  have hl := initial_phaseMass_le_normalized P 0 hlow
    (homogeneousComponent_one_ne_zero P hreg) hcal hf hR hz hdz hdec hr
  simpa only [Nat.zero_add, homogeneousComponent_one_eq_linearForm,
    phaseMass_linearForm (evaluatedGradient P 0) hreg hf hR hz] using hl

theorem radialCutoff_regular_limit (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hP : eval 0 P = 0) (hreg : evaluatedGradient P 0 ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0)) :
    Tendsto (fun k => normalizedPhaseMass P radialCutoff (t k)) atTop
      (𝓝 (planeMass n radialCutoff)) :=
  normalizedPhaseMass_regular_limit P hP hreg ht ht0 radialCutoff_contDiff
    (R := 2) (by norm_num) radialCutoff_zero

theorem planeMass_le_radialCutoff (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hP : eval 0 P = 0) (hreg : evaluatedGradient P 0 ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) {r : ℝ} (hr : 0 < r) :
    planeMass n radialCutoff ≤ normalizedPhaseMass P radialCutoff r :=
  planeMass_le_normalizedPhaseMass P hP hreg hcal radialCutoff_contDiff
    (R := 2) (by norm_num) radialCutoff_zero radialCutoff_deriv_zero
    radialCutoff_deriv_nonpos hr

theorem translated_level_eval_zero (P : MvPolynomial (Fin n) ℝ)
    (t : ℝ) (c : Fin n → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = t) :
    eval 0 (translate (levelPolynomial P t) c) = 0 := by
  rw [eval_zero_translate]
  simp only [levelPolynomial, map_sub, eval_C, hc, sub_self]

theorem translated_level_gradient_zero (P : MvPolynomial (Fin n) ℝ)
    (t : ℝ) (c : Fin n → ℝ) :
    evaluatedGradient (translate (levelPolynomial P t) c) 0 =
      evaluatedGradient (homogeneousComponent P.totalDegree P) c := by
  rw [← levelPolynomial_gradient P t]
  funext i
  change eval 0 (pderiv i (translate (levelPolynomial P t) c)) =
    eval c (pderiv i (levelPolynomial P t))
  rw [pderiv_translate, eval_zero_translate]

/-- Every point on a nonzero leading level has plane density. This local
statement uses homogeneity and regularity, without a minimality hypothesis. -/
theorem translated_nonzero_level_regular_limit
    (P : MvPolynomial (Fin (n + 1)) ℝ) (hd : 2 ≤ P.totalDegree)
    {t : ℝ} (ht : t ≠ 0) (c : Fin (n + 1) → ℝ)
    (hc : eval c (homogeneousComponent P.totalDegree P) = t)
    {a : ℕ → ℝ} (ha : ∀ k, 0 < a k) (ha0 : Tendsto a atTop (𝓝 0))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ b, R ≤ b → f b = 0) :
    Tendsto (fun k => normalizedPhaseMass (translate (levelPolynomial P t) c) f (a k))
      atTop (𝓝 (planeMass n f)) := by
  apply normalizedPhaseMass_regular_limit _ (translated_level_eval_zero P t c hc) _ ha ha0 hf hR hz
  rw [translated_level_gradient_zero]
  exact top_nonzero_level_gradient P hd ht hc

/-- Every nonzero leading level of a polynomial minimal graph has at least
plane mass at every positive radius about each point of the level. -/
theorem planeMass_le_translated_nonzero_level
    (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {t : ℝ} (ht : t ≠ 0) (c : Fin (n + 1) → ℝ)
    (hc : eval c (homogeneousComponent P.totalDegree P) = t)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ b, R ≤ b → f b = 0) (hdz : ∀ b, R ≤ b → deriv f b = 0)
    (hdec : ∀ b, deriv f b ≤ 0) {r : ℝ} (hr : 0 < r) :
    planeMass n f ≤ normalizedPhaseMass (translate (levelPolynomial P t) c) f r := by
  apply planeMass_le_normalizedPhaseMass _ (translated_level_eval_zero P t c hc) _
    (translated_level_weakCalibration P hmin hd t c) hf hR hz hdz hdec hr
  rw [translated_level_gradient_zero]
  exact top_nonzero_level_gradient P hd ht hc

theorem planeMass_le_translated_nonzero_level_radialCutoff
    (P : MvPolynomial (Fin (n + 1)) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hd : 2 ≤ P.totalDegree)
    {t : ℝ} (ht : t ≠ 0) (c : Fin (n + 1) → ℝ)
    (hc : eval c (homogeneousComponent P.totalDegree P) = t) {r : ℝ} (hr : 0 < r) :
    planeMass n radialCutoff ≤ normalizedPhaseMass (translate (levelPolynomial P t) c) radialCutoff r :=
  planeMass_le_translated_nonzero_level P hmin hd ht c hc radialCutoff_contDiff
    (R := 2) (by norm_num) radialCutoff_zero radialCutoff_deriv_zero radialCutoff_deriv_nonpos hr

end
end Source29RegularPhaseDensity

/- Component: PolynomialOdeNonvanishing.inc -/
namespace Source29PolynomialOdeNonvanishing

open Polynomial

/-- A nonzero polynomial solution of A g' = B g cannot vanish at a point
where A is nonzero. Root multiplicity drops under differentiation in
characteristic zero, whereas multiplication by A preserves it at that point. -/
theorem eval_ne_zero_of_derivative_mul_eq {K : Type*} [Field K] [CharZero K]
    (A B g : Polynomial K) (a : K) (hg : g ≠ 0) (hA : A.eval a ≠ 0)
    (hode : A * g.derivative = B * g) : g.eval a ≠ 0 := by
  intro hga
  apply hA
  have hdiv : g ∣ g.derivative * A := by
    refine ⟨B, ?_⟩
    rw [mul_comm g.derivative A, hode, mul_comm B g]
  exact Polynomial.isRoot_of_isRoot_of_dvd_derivative_mul hg hdiv hga

end Source29PolynomialOdeNonvanishing

/- Component: NewtonNormalDerivative.inc -/
namespace Source29NewtonNormalDerivative

open MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.QuarticMinimal.DistinguishedVariable
open Source29PolynomialOdeNonvanishing
open scoped BigOperators

noncomputable section

variable {n : ℕ}

/-- Fix the tangential variables and retain the normal variable, indexed by zero. -/
def sliceHom (y : Fin n → ℝ) : MvPolynomial (Fin (n + 1)) ℝ →+* Polynomial ℝ :=
  (Polynomial.mapRingHom (eval y)).comp (finSuccEquiv ℝ n).toRingHom

lemma eval_sliceHom (N : MvPolynomial (Fin (n + 1)) ℝ) (y : Fin n → ℝ) (x : ℝ) :
    (sliceHom y N).eval x = eval (Fin.cons x y) N := by
  change ((finSuccEquiv ℝ n N).map (eval y)).eval x = _
  calc
    _ = eval y ((finSuccEquiv ℝ n N).eval (C x)) := by
      simpa only [eval_C] using
        (Polynomial.eval_map_apply (f := eval y) (p := finSuccEquiv ℝ n N) (C x))
    _ = _ := by
      rw [Source29QuarticReuse.QuarticCompatibility.eval_polynomial_eval_finSuccEquiv]
      simp only [eval_C]
      apply congrArg (fun v : Fin (n + 1) → ℝ => eval v N)
      funext i
      exact Fin.cases rfl (fun j => rfl) i

lemma sliceHom_pderiv_zero (N : MvPolynomial (Fin (n + 1)) ℝ) (y : Fin n → ℝ) :
    sliceHom y (pderiv 0 N) = (sliceHom y N).derivative := by
  change (finSuccEquiv ℝ n (pderiv 0 N)).map (eval y) =
    ((finSuccEquiv ℝ n N).map (eval y)).derivative
  rw [finSuccEquiv_pderiv_zero, Polynomial.derivative_map]

def tangentialEnergy (N : MvPolynomial (Fin (n + 1)) ℝ) : MvPolynomial (Fin (n + 1)) ℝ :=
  ∑ i : Fin n, (pderiv i.succ N) ^ 2

def tangentialLaplacian (N : MvPolynomial (Fin (n + 1)) ℝ) : MvPolynomial (Fin (n + 1)) ℝ :=
  ∑ i : Fin n, pderiv i.succ (pderiv i.succ N)

def tangentialMixed (N : MvPolynomial (Fin (n + 1)) ℝ) : MvPolynomial (Fin (n + 1)) ℝ :=
  ∑ i : Fin n, pderiv i.succ N * pderiv i.succ (pderiv 0 N)

/-- The Newton-face equation appearing after the normal/tangential scaling. -/
def newtonResidual (N : MvPolynomial (Fin (n + 1)) ℝ) : MvPolynomial (Fin (n + 1)) ℝ :=
  (pderiv 0 N)^2 * tangentialLaplacian N -
    2 * pderiv 0 N * tangentialMixed N +
    pderiv 0 (pderiv 0 N) * tangentialEnergy N

def normalDrift (N : MvPolynomial (Fin (n + 1)) ℝ) : MvPolynomial (Fin (n + 1)) ℝ :=
  2 * tangentialMixed N - pderiv 0 N * tangentialLaplacian N

lemma newtonResidual_eq (N : MvPolynomial (Fin (n + 1)) ℝ) :
    newtonResidual N = tangentialEnergy N * pderiv 0 (pderiv 0 N) -
      normalDrift N * pderiv 0 N := by
  unfold newtonResidual normalDrift
  ring

/-- On a fixed tangential slice, the Newton equation is the exact polynomial
ODE A*g'=B*g, where A is tangential gradient energy and g is the normal derivative. -/
theorem slice_derivative_ode (N : MvPolynomial (Fin (n + 1)) ℝ)
    (hE : newtonResidual N = 0) (y : Fin n → ℝ) :
    sliceHom y (tangentialEnergy N) * (sliceHom y (pderiv 0 N)).derivative =
      sliceHom y (normalDrift N) * sliceHom y (pderiv 0 N) := by
  have h := congrArg (sliceHom y) hE
  rw [newtonResidual_eq, map_sub, map_mul, map_mul, map_zero,
    sliceHom_pderiv_zero] at h
  exact sub_eq_zero.mp h

def WeightedEuler (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) : Prop :=
  C α * X 0 * pderiv 0 N + (∑ i : Fin n, X i.succ * pderiv i.succ N) = C D * N

/-- At a nonzero value with zero normal derivative, weighted Euler forces
strictly positive tangential gradient energy. -/
theorem tangentialEnergy_pos_of_normal_zero (N : MvPolynomial (Fin (n + 1)) ℝ)
    (α D : ℝ) (hD : D ≠ 0) (hEuler : WeightedEuler N α D)
    (z : Fin (n + 1) → ℝ) (hN : eval z N ≠ 0) (hg : eval z (pderiv 0 N) = 0) :
    0 < eval z (tangentialEnergy N) := by
  have hex : ∃ i : Fin n, eval z (pderiv i.succ N) ≠ 0 := by
    by_contra hn
    have hz : ∀ i : Fin n, eval z (pderiv i.succ N) = 0 := by
      intro i
      exact not_ne_iff.mp (fun hi => hn ⟨i, hi⟩)
    have he := congrArg (eval z) hEuler
    change eval z (C α * X 0 * pderiv 0 N +
      (∑ i : Fin n, X i.succ * pderiv i.succ N)) = eval z (C D * N) at he
    simp only [map_add, map_mul, map_sum, eval_C, eval_X, hg, hz, mul_zero,
      Finset.sum_const_zero, add_zero] at he
    exact (mul_ne_zero hD hN) he.symm
  obtain ⟨i, hi⟩ := hex
  simp only [tangentialEnergy, map_sum, map_pow]
  exact Finset.sum_pos' (fun j _ => sq_nonneg _) ⟨i, Finset.mem_univ i, sq_pos_of_ne_zero hi⟩

/-- The normal derivative cannot vanish at a nonzero value of a real Newton
polynomial. The slice nonvanishing hypothesis is a polynomial statement,
not an assumption about pointwise derivatives. -/
theorem normal_derivative_ne_zero (N : MvPolynomial (Fin (n + 1)) ℝ)
    (α D : ℝ) (hD : 0 < D) (hEuler : WeightedEuler N α D)
    (hE : newtonResidual N = 0)
    (hslice : ∀ y : Fin n → ℝ, sliceHom y (pderiv 0 N) ≠ 0)
    (z : Fin (n + 1) → ℝ) (hN : eval z N ≠ 0) : eval z (pderiv 0 N) ≠ 0 := by
  intro hg
  let y : Fin n → ℝ := fun i => z i.succ
  have hz : Fin.cons (z 0) y = z := by
    funext i
    exact Fin.cases rfl (fun j => rfl) i
  have hA : (sliceHom y (tangentialEnergy N)).eval (z 0) ≠ 0 := by
    rw [eval_sliceHom, hz]
    exact ne_of_gt (tangentialEnergy_pos_of_normal_zero N α D hD.ne' hEuler z hN hg)
  have hno := eval_ne_zero_of_derivative_mul_eq
    (sliceHom y (tangentialEnergy N)) (sliceHom y (normalDrift N))
    (sliceHom y (pderiv 0 N)) (z 0) (hslice y) hA (slice_derivative_ode N hE y)
  apply hno
  rwa [eval_sliceHom, hz]

/-- A fixed nonzero coefficient of positive normal degree already guarantees
that every normal derivative slice is a nonzero polynomial. In particular,
this applies to a constant nonzero leading normal coefficient. -/
theorem slice_derivative_ne_zero_of_constant_coefficient
    (N : MvPolynomial (Fin (n + 1)) ℝ) (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    sliceHom y (pderiv 0 N) ≠ 0 := by
  cases d with
  | zero => omega
  | succ k =>
    rw [sliceHom_pderiv_zero]
    intro hz
    have he := congrArg (fun Q : Polynomial ℝ => Q.coeff k) hz
    change ((finSuccEquiv ℝ n N).map (eval y)).derivative.coeff k = (0 : Polynomial ℝ).coeff k at he
    simp only [Polynomial.coeff_derivative, Polynomial.coeff_map, hcoeff, eval_C,
      Polynomial.coeff_zero] at he
    have hk : (k : ℝ) + 1 ≠ 0 := by positivity
    exact (mul_ne_zero hc hk) he

theorem normal_derivative_ne_zero_of_constant_coefficient
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (z : Fin (n + 1) → ℝ) (hN : eval z N ≠ 0) : eval z (pderiv 0 N) ≠ 0 :=
  normal_derivative_ne_zero N α D hD hEuler hE
    (slice_derivative_ne_zero_of_constant_coefficient N d hd c hc hcoeff) z hN

end
end Source29NewtonNormalDerivative

/- Component: PolynomialPhaseRoot.inc -/
namespace Source29PolynomialPhaseRoot

open Polynomial Set Filter
open scoped Topology

noncomputable section

theorem exists_eval_ne_zero_in_interval (p : ℝ[X]) (hp : p ≠ 0)
    {a b : ℝ} (hab : a < b) : ∃ x ∈ Ioo a b, p.eval x ≠ 0 := by
  by_contra hn
  push Not at hn
  apply hp
  apply p.eq_zero_of_infinite_isRoot
  apply (Set.Ioo_infinite hab).mono
  intro x hx
  exact hn x hx

/-- A nonzero polynomial nonnegative on the positive half-line, vanishing at
zero, cannot have a further positive zero if all its nonzero values are regular. -/
theorem eval_pos_of_pos (p : ℝ[X]) (hp : p ≠ 0) (hzero : p.eval 0 = 0)
    (hpos : ∀ x, 0 < x → 0 ≤ p.eval x)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    {a : ℝ} (ha : 0 < a) : 0 < p.eval a := by
  apply lt_of_le_of_ne (hpos a ha)
  intro he
  have hza : p.eval a = 0 := he.symm
  obtain ⟨b,hb,hbn⟩ := exists_eval_ne_zero_in_interval p hp ha
  have hbp : 0 < p.eval b := lt_of_le_of_ne (hpos b hb.1) (Ne.symm hbn)
  obtain ⟨c,hc,hmax⟩ := (isCompact_Icc : IsCompact (Icc 0 a)).exists_isMaxOn
    ⟨0, by simp [ha.le]⟩ p.continuous.continuousOn
  have hbc : p.eval b ≤ p.eval c := hmax ⟨hb.1.le,hb.2.le⟩
  have hcp : 0 < p.eval c := lt_of_lt_of_le hbp hbc
  have hc0 : 0 < c := lt_of_le_of_ne hc.1 (by intro h; subst c; simpa [hzero] using hcp)
  have hca : c < a := lt_of_le_of_ne hc.2 (by intro h; subst c; simpa [hza] using hcp)
  have hder : deriv (fun x ↦ p.eval x) c = 0 :=
    (hmax.isLocalMax (Icc_mem_nhds hc0 hca)).deriv_eq_zero
  have hd : p.derivative.eval c = 0 := by
    simpa only [p.deriv] using hder
  exact hreg c hcp.ne' hd

theorem eval_injOn_nonnegative (p : ℝ[X]) (hp : p ≠ 0) (hzero : p.eval 0 = 0)
    (hpos : ∀ x, 0 < x → 0 ≤ p.eval x)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0) :
    InjOn p.eval (Ici 0) := by
  have hcontra {a b : ℝ} (ha : 0 ≤ a) (hab : a < b) (he : p.eval a = p.eval b) : False := by
    obtain ⟨c,hc,hcder⟩ := exists_deriv_eq_zero hab p.continuous.continuousOn he
    have hcpos : 0 < c := lt_of_le_of_lt ha hc.1
    apply hreg c (eval_pos_of_pos p hp hzero hpos hreg hcpos).ne'
    simpa only [p.deriv] using hcder
  intro a ha b hb he
  rcases lt_trichotomy a b with hab | hab | hab
  · exact (hcontra ha hab he).elim
  · exact hab
  · exact (hcontra hb hab he.symm).elim

theorem eval_strictMonoOn_nonnegative (p : ℝ[X]) (hp : p ≠ 0) (hzero : p.eval 0 = 0)
    (hpos : ∀ x, 0 < x → 0 ≤ p.eval x)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0) :
    StrictMonoOn p.eval (Ici 0) := by
  have hinj := eval_injOn_nonnegative p hp hzero hpos hreg
  intro a ha b hb hab
  have hpb : 0 < p.eval b := eval_pos_of_pos p hp hzero hpos hreg (lt_of_le_of_lt ha hab)
  have hm := p.continuous.continuousOn.strictMonoOn_of_injOn_Icc hb
    (show p.eval 0 ≤ p.eval b by rw [hzero]; exact hpb.le)
    (hinj.mono (fun x hx ↦ hx.1))
  exact hm ⟨ha,hab.le⟩ ⟨hb,le_rfl⟩ hab

theorem eval_zero_of_sign (p : ℝ[X])
    (hpos : ∀ x, 0 < x → 0 ≤ p.eval x) (hneg : ∀ x, x < 0 → p.eval x ≤ 0) :
    p.eval 0 = 0 := by
  have hp : Tendsto p.eval (𝓝[>] 0) (𝓝 (p.eval 0)) := p.continuous.continuousAt.mono_left nhdsWithin_le_nhds
  have hn : Tendsto p.eval (𝓝[<] 0) (𝓝 (p.eval 0)) := p.continuous.continuousAt.mono_left nhdsWithin_le_nhds
  apply le_antisymm
  · exact le_of_tendsto hn (eventually_nhdsWithin_of_forall hneg)
  · exact ge_of_tendsto hp (eventually_nhdsWithin_of_forall hpos)

/-- Every positive value has a unique positive preimage. -/
theorem existsUnique_positive_root (p : ℝ[X]) (hp : p ≠ 0) (hzero : p.eval 0 = 0)
    (hpos : ∀ x, 0 < x → 0 ≤ p.eval x)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    (hdeg : 0 < p.degree) {t : ℝ} (ht : 0 < t) :
    ∃! x : ℝ, 0 < x ∧ p.eval x = t := by
  have hnorm : Tendsto (fun x : ℝ ↦ ‖x‖) atTop atTop := by
    apply tendsto_id.congr'
    filter_upwards [eventually_ge_atTop (0 : ℝ)] with x hx
    exact (Real.norm_of_nonneg hx).symm
  have htop : Tendsto p.eval atTop atTop := by
    apply (p.tendsto_norm_atTop hdeg hnorm).congr'
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
    exact Real.norm_of_nonneg (hpos x hx)
  obtain ⟨x,hx,hxt⟩ := intermediate_value_Ici p.continuous.continuousOn htop
    (show t ∈ Ici (p.eval 0) by simpa only [hzero,mem_Ici] using ht.le)
  have hxpos : 0 < x := lt_of_le_of_ne hx (by
    intro he
    subst x
    change p.eval 0 = t at hxt
    rw [hzero] at hxt
    exact ht.ne hxt)
  refine ⟨x,⟨hxpos,hxt⟩,?_⟩
  intro y hy
  exact eval_injOn_nonnegative p hp hzero hpos hreg hy.1.le hx (hy.2.trans hxt.symm)

end
end Source29PolynomialPhaseRoot

/- Component: NewtonPositiveRoot.inc -/
namespace Source29NewtonPositiveRoot

open MvPolynomial Polynomial
open Source29NewtonNormalDerivative Source29PolynomialPhaseRoot

noncomputable section

variable {n : ℕ}

lemma slice_coefficient (N : MvPolynomial (Fin (n + 1)) ℝ)
    (d : ℕ) (c : ℝ) (hcoeff : (finSuccEquiv ℝ n N).coeff d = MvPolynomial.C c)
    (y : Fin n → ℝ) : (sliceHom y N).coeff d = c := by
  change ((finSuccEquiv ℝ n N).map (MvPolynomial.eval y)).coeff d = c
  simp only [Polynomial.coeff_map, hcoeff, MvPolynomial.eval_C]

lemma slice_degree_pos (N : MvPolynomial (Fin (n + 1)) ℝ)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = MvPolynomial.C c) (y : Fin n → ℝ) :
    0 < (sliceHom y N).degree := by
  have hnonzero : (sliceHom y N).coeff d ≠ 0 := by
    rwa [slice_coefficient N d c hcoeff y]
  have hdle := Polynomial.le_degree_of_ne_zero hnonzero
  exact lt_of_lt_of_le (by exact_mod_cast hd) hdle

lemma slice_ne_zero (N : MvPolynomial (Fin (n + 1)) ℝ)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = MvPolynomial.C c) (y : Fin n → ℝ) :
    sliceHom y N ≠ 0 := by
  intro hz
  have he := congrArg (fun p : Polynomial ℝ => p.coeff d) hz
  rw [slice_coefficient N d c hcoeff y, Polynomial.coeff_zero] at he
  exact hc he

/-- Every positive level of a Newton polynomial has exactly one positive
normal root above each tangential point. Only a fixed nonzero coefficient
of positive normal degree is required; it need not be the leading coefficient. -/
theorem existsUnique_positive_normal_root
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ MvPolynomial.eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → MvPolynomial.eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = MvPolynomial.C c)
    (t : ℝ) (ht : 0 < t) (y : Fin n → ℝ) :
    ∃! x : ℝ, 0 < x ∧ MvPolynomial.eval (Fin.cons x y) N = t := by
  have hp : ∀ x, 0 < x → 0 ≤ (sliceHom y N).eval x := by
    intro x hx
    rw [eval_sliceHom]
    exact hpos (Fin.cons x y) hx
  have hn : ∀ x, x < 0 → (sliceHom y N).eval x ≤ 0 := by
    intro x hx
    rw [eval_sliceHom]
    exact hneg (Fin.cons x y) hx
  have hz := eval_zero_of_sign (sliceHom y N) hp hn
  have hreg : ∀ x, (sliceHom y N).eval x ≠ 0 → (sliceHom y N).derivative.eval x ≠ 0 := by
    intro x hx
    rw [← sliceHom_pderiv_zero, eval_sliceHom]
    apply normal_derivative_ne_zero_of_constant_coefficient N α D hD hEuler hE d hd c hc hcoeff
    rwa [eval_sliceHom] at hx
  simpa only [eval_sliceHom] using existsUnique_positive_root (sliceHom y N)
    (slice_ne_zero N d c hc hcoeff y) hz hp hreg (slice_degree_pos N d hd c hc hcoeff y) ht

/-- The positive normal root, with a zero fallback outside the existence domain.
Theorems below prove existence and all properties on positive levels. -/
def positiveRoot (N : MvPolynomial (Fin (n + 1)) ℝ) (t : ℝ) (y : Fin n → ℝ) : ℝ := by
  classical
  exact if hex : ∃ x : ℝ, 0 < x ∧ MvPolynomial.eval (Fin.cons x y) N = t then
    Classical.choose hex
  else 0

theorem positiveRoot_spec (N : MvPolynomial (Fin (n + 1)) ℝ) (t : ℝ) (y : Fin n → ℝ)
    (hex : ∃ x : ℝ, 0 < x ∧ MvPolynomial.eval (Fin.cons x y) N = t) :
    0 < positiveRoot N t y ∧ MvPolynomial.eval (Fin.cons (positiveRoot N t y) y) N = t := by
  simpa only [positiveRoot, dite_eq_left hex] using Classical.choose_spec hex

theorem positiveRoot_eq_of_root (N : MvPolynomial (Fin (n + 1)) ℝ) (t : ℝ) (y : Fin n → ℝ)
    (hex : ∃! x : ℝ, 0 < x ∧ MvPolynomial.eval (Fin.cons x y) N = t)
    {x : ℝ} (hx : 0 < x) (hroot : MvPolynomial.eval (Fin.cons x y) N = t) :
    positiveRoot N t y = x := by
  obtain ⟨r, hr, huniq⟩ := hex
  have hs := positiveRoot_spec N t y ⟨r, hr⟩
  exact (huniq _ hs).trans (huniq x ⟨hx, hroot⟩).symm

/-- The global root choice is positive, solves the level equation, and has
nonzero normal derivative. These are the inputs for local implicit-function
regularity; no analytic or harmonic claim is assumed here. -/
theorem positiveRoot_properties
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ MvPolynomial.eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → MvPolynomial.eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = MvPolynomial.C c)
    (t : ℝ) (ht : 0 < t) (y : Fin n → ℝ) :
    0 < positiveRoot N t y ∧
      MvPolynomial.eval (Fin.cons (positiveRoot N t y) y) N = t ∧
      MvPolynomial.eval (Fin.cons (positiveRoot N t y) y) (pderiv 0 N) ≠ 0 := by
  have he := existsUnique_positive_normal_root N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht y
  have hs := positiveRoot_spec N t y he.exists
  refine ⟨hs.1, hs.2, ?_⟩
  apply normal_derivative_ne_zero_of_constant_coefficient N α D hD hEuler hE d hd c hc hcoeff
  rw [hs.2]
  exact ht.ne'

end
end Source29NewtonPositiveRoot

/- Component: RealImplicitPolynomialRoot.inc -/
namespace Source29RealImplicitPolynomialRoot

open MvPolynomial Filter
open Source29PolynomialLinkChart Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- The derivative of (N(x,y),y) is triangular. Its first row may have
arbitrary tangential entries; only the normal entry must be nonzero. -/
def triangularEquiv (a : Fin (n + 1) → ℝ) (ha : a 0 ≠ 0) :
    (Fin (n + 1) → ℝ) ≃L[ℝ] (Fin (n + 1) → ℝ) :=
  LinearEquiv.toContinuousLinearEquiv
    { toFun := fun v => Fin.cons (∑ i, a i * v i) (fun j => v j.succ)
      invFun := fun w => Fin.cons
        ((w 0 - ∑ j : Fin n, a j.succ * w j.succ) / a 0) (fun j => w j.succ)
      left_inv := by
        intro v
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero, Fin.cons_succ, Fin.sum_univ_succ]
          field_simp
          ring
        · rfl
      right_inv := by
        intro w
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero, Fin.cons_succ, Fin.sum_univ_succ]
          field_simp
          ring
        · rfl
      map_add' := by
        intro v w
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp [mul_add, Finset.sum_add_distrib]
        · rfl
      map_smul' := by
        intro c v
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero, Pi.smul_apply, smul_eq_mul, RingHom.id_apply,
            Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro j _
          ring
        · rfl }

lemma triangularEquiv_zero (a : Fin (n + 1) → ℝ) (ha : a 0 ≠ 0) (v : Fin (n + 1) → ℝ) :
    triangularEquiv a ha v 0 = ∑ i, a i * v i := rfl

lemma triangularEquiv_succ (a : Fin (n + 1) → ℝ) (ha : a 0 ≠ 0) (v : Fin (n + 1) → ℝ)
    (i : Fin n) : triangularEquiv a ha v i.succ = v i.succ := rfl

def coordinatePolynomial (N : MvPolynomial (Fin (n + 1)) ℝ) :
    Fin (n + 1) → MvPolynomial (Fin (n + 1)) ℝ :=
  Fin.cons N (fun i => X i.succ)

def coordinateMap (N : MvPolynomial (Fin (n + 1)) ℝ) (z : Fin (n + 1) → ℝ) :
    Fin (n + 1) → ℝ := fun i => eval z (coordinatePolynomial N i)

lemma analyticAt_levelEmbed (t : ℝ) (y : Fin n → ℝ) :
    AnalyticAt ℝ (fun v : Fin n → ℝ => (Fin.cons t v : Fin (n + 1) → ℝ)) y := by
  apply AnalyticAt.pi
  intro i
  refine Fin.cases ?_ (fun j => ?_) i
  · exact analyticAt_const
  · exact (ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ).analyticAt y

/-- A polynomial level is an analytic normal graph near every point with
nonzero normal derivative. Tangential derivatives are unrestricted. -/
theorem exists_local_level_graph (N : MvPolynomial (Fin (n + 1)) ℝ)
    (z : Fin (n + 1) → ℝ) (hz : eval z (pderiv 0 N) ≠ 0) :
    ∃ g : (Fin n → ℝ) → ℝ,
      AnalyticAt ℝ g (fun i => z i.succ) ∧
      g (fun i => z i.succ) = z 0 ∧
      ∀ᶠ y in 𝓝 (fun i => z i.succ), eval (Fin.cons (g y) y) N = eval z N := by
  let a : Fin (n + 1) → ℝ := fun i => eval z (pderiv i N)
  let e := triangularEquiv a hz
  have ha : AnalyticAt ℝ (coordinateMap N) z :=
    AnalyticAt.pi (fun i => analyticAt_eval_real (coordinatePolynomial N i) z)
  have hd : HasStrictFDerivAt (coordinateMap N) (e : _ →L[ℝ] _) z := by
    apply hasStrictFDerivAt_pi'.mpr
    intro i
    change HasStrictFDerivAt (fun v => eval v (coordinatePolynomial N i)) _ _
    convert hasStrictFDerivAt_eval (coordinatePolynomial N i) z using 1
    ext v
    change e v i = evalFDeriv (coordinatePolynomial N i) z v
    refine Fin.cases ?_ (fun j => ?_) i
    · rw [triangularEquiv_zero]
      simp [coordinatePolynomial, evalFDeriv_apply, a]
    · rw [triangularEquiv_succ]
      simp [coordinatePolynomial, evalFDeriv_X]
  obtain ⟨u, hu, huz, hnear⟩ :=
    Source29RealAnalyticInverse.exists_analytic_local_inverse (coordinateMap N) z e ha hd
  have hbase : coordinateMap N z = Fin.cons (eval z N) (fun i => z i.succ) := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · simp [coordinateMap, coordinatePolynomial]
  rw [hbase] at hu huz hnear
  let g : (Fin n → ℝ) → ℝ := fun y => u (Fin.cons (eval z N) y) 0
  have hcomp : AnalyticAt ℝ (fun y : Fin n → ℝ => u (Fin.cons (eval z N) y))
      (fun i => z i.succ) :=
    AnalyticAt.comp (g := u) (f := fun y => Fin.cons (eval z N) y) hu (analyticAt_levelEmbed _ _)
  refine ⟨g, ?_, ?_, ?_⟩
  · exact AnalyticAt.comp (g := fun v : Fin (n + 1) → ℝ => v 0)
      ((ContinuousLinearMap.proj 0 : (Fin (n + 1) → ℝ) →L[ℝ] ℝ).analyticAt _) hcomp
  · exact congrFun huz 0
  · have hn := (analyticAt_levelEmbed (eval z N) (fun i => z i.succ)).continuousAt.tendsto.eventually hnear
    filter_upwards [hn] with y hy
    have he : u (Fin.cons (eval z N) y) = Fin.cons (g y) y := by
      funext i
      refine Fin.cases ?_ (fun j => ?_) i
      · rfl
      · have hj := congrFun hy j.succ
        simpa [coordinateMap, coordinatePolynomial] using hj
    have hval := congrFun hy 0
    change eval (u (Fin.cons (eval z N) y)) N = eval z N at hval
    rwa [he] at hval

end
end Source29RealImplicitPolynomialRoot

/- Component: NewtonRootAnalytic.inc -/
namespace Source29NewtonRootAnalytic

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonPositiveRoot Source29RealImplicitPolynomialRoot
open scoped Topology

noncomputable section

variable {n : ℕ}

/-- The unique positive normal root is analytic in every tangential variable.
Local inverse branches agree with the global choice by positivity and uniqueness. -/
theorem analyticAt_positiveRoot
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (t : ℝ) (ht : 0 < t) (y : Fin n → ℝ) :
    AnalyticAt ℝ (positiveRoot N t) y := by
  have hs := positiveRoot_properties N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht y
  obtain ⟨g, hg, hgy, hroot⟩ := exists_local_level_graph N
    (Fin.cons (positiveRoot N t y) y) hs.2.2
  simp only [Fin.cons_succ, Fin.cons_zero] at hg hgy hroot
  rw [hs.2.1] at hroot
  have hgypos : 0 < g y := by rw [hgy]; exact hs.1
  have hgpos : ∀ᶠ v in 𝓝 y, 0 < g v :=
    hg.continuousAt.tendsto.eventually (eventually_gt_nhds hgypos)
  apply hg.congr
  filter_upwards [hroot, hgpos] with v hv hpv
  exact (positiveRoot_eq_of_root N t v
    (existsUnique_positive_normal_root N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht v)
    hpv hv).symm

theorem analyticOnNhd_positiveRoot
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (t : ℝ) (ht : 0 < t) :
    AnalyticOnNhd ℝ (positiveRoot N t) Set.univ := by
  intro y _
  exact analyticAt_positiveRoot N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht y

end
end Source29NewtonRootAnalytic

/- Component: NewtonRootHarmonic.inc -/
namespace Source29NewtonRootHarmonic

open Filter MvPolynomial
open Source29RealPolynomialCurveJets Source29NewtonNormalDerivative
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

def coordinateGradient (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (i : Fin n) : ℝ :=
  fderiv ℝ f y (Pi.single i 1)

def coordinateLaplacian (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) : ℝ :=
  ∑ i, fderiv ℝ (fun z => coordinateGradient f z i) y (Pi.single i 1)

lemma divergence_coordinateGradient (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) :
    Source29QuarticReuse.FluxObstruction.divergence (fun i => Pi.single i 1)
      (coordinateGradient f) y = coordinateLaplacian f y := rfl

section Lines
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

lemma line_hasDerivAt (y v : E) (s : ℝ) :
    HasDerivAt (fun t : ℝ => y + t • v) v s := by
  simpa using ((hasDerivAt_id s).smul_const v).const_add y

lemma deriv_line (f : E → ℝ) (y v : E) (s : ℝ)
    (hf : DifferentiableAt ℝ f (y + s • v)) :
    deriv (fun t : ℝ => f (y + t • v)) s = fderiv ℝ f (y + s • v) v :=
  (hf.hasFDerivAt.comp_hasDerivAt s (line_hasDerivAt y v s)).deriv

lemma analyticAt_directional (f : E → ℝ) (y v : E) (hf : AnalyticAt ℝ f y) :
    AnalyticAt ℝ (fun z => fderiv ℝ f z v) y :=
  AnalyticAt.comp (f := fderiv ℝ f) (g := fun L : E →L[ℝ] ℝ => L v)
    ((ContinuousLinearMap.apply ℝ ℝ v).analyticAt _) hf.fderiv

lemma line_tendsto (y v : E) :
    Tendsto (fun t : ℝ => y + t • v) (𝓝 0) (𝓝 y) := by
  simpa using (line_hasDerivAt y v 0).continuousAt.tendsto

lemma second_deriv_line (f : E → ℝ) (y v : E) (hf : AnalyticAt ℝ f y) :
    deriv (deriv (fun t : ℝ => f (y + t • v))) 0 =
      fderiv ℝ (fun z => fderiv ℝ f z v) y v := by
  have hn := (line_tendsto y v).eventually hf.eventually_analyticAt
  have he : deriv (fun t : ℝ => f (y + t • v)) =ᶠ[𝓝 0]
      (fun t : ℝ => fderiv ℝ f (y + t • v) v) := by
    filter_upwards [hn] with t ht
    exact deriv_line f y v t ht.differentiableAt
  rw [he.deriv_eq]
  simpa using deriv_line (fun z => fderiv ℝ f z v) y v 0
    (by simpa using (analyticAt_directional f y v hf).differentiableAt)

end Lines

def graphCurve (φ : ℝ → ℝ) (y : Fin n → ℝ) (i : Fin n) : Fin (n+1) → ℝ → ℝ :=
  Fin.cons φ (fun j s => y j + s * (if j = i then 1 else 0))

lemma graphCurve_analytic (φ : ℝ → ℝ) (y : Fin n → ℝ) (i : Fin n)
    (hφ : AnalyticAt ℝ φ 0) (j : Fin (n+1)) : AnalyticAt ℝ (graphCurve φ y i j) 0 := by
  refine Fin.cases hφ (fun k => ?_) j
  exact analyticAt_const.add (analyticAt_id.mul analyticAt_const)

lemma deriv_affine (c d s : ℝ) : deriv (fun t : ℝ => c + t*d) s = d := by
  simpa using (((hasDerivAt_id s).mul_const d).const_add c).deriv

lemma second_deriv_affine (c d : ℝ) : deriv (deriv (fun t : ℝ => c + t*d)) 0 = 0 := by
  have he : deriv (fun t : ℝ => c+t*d) = fun _ => d := funext (deriv_affine c d)
  rw [he]
  simp

lemma graphCurve_value (φ : ℝ → ℝ) (y : Fin n → ℝ) (i : Fin n) :
    (fun j => graphCurve φ y i j 0) = Fin.cons (φ 0) y := by
  funext j
  refine Fin.cases rfl (fun k => ?_) j
  simp [graphCurve]

lemma first_deriv_graphCurve (N : MvPolynomial (Fin (n+1)) ℝ)
    (φ : ℝ → ℝ) (y : Fin n → ℝ) (i : Fin n) (hφ : AnalyticAt ℝ φ 0) :
    deriv (fun s => eval (fun j => graphCurve φ y i j s) N) 0 =
      eval (Fin.cons (φ 0) y) (pderiv 0 N) * deriv φ 0 +
      eval (Fin.cons (φ 0) y) (pderiv i.succ N) := by
  rw [first_deriv_eval_curve N _ 0 (graphCurve_analytic φ y i hφ), graphCurve_value]
  simp only [Fin.sum_univ_succ, graphCurve, Fin.cons_zero, Fin.cons_succ, deriv_affine]
  simp

lemma second_deriv_graphCurve (N : MvPolynomial (Fin (n+1)) ℝ)
    (φ : ℝ → ℝ) (y : Fin n → ℝ) (i : Fin n) (hφ : AnalyticAt ℝ φ 0) :
    deriv (deriv (fun s => eval (fun j => graphCurve φ y i j s) N)) 0 =
      eval (Fin.cons (φ 0) y) (pderiv 0 (pderiv 0 N)) * (deriv φ 0)^2 +
      2 * eval (Fin.cons (φ 0) y) (pderiv i.succ (pderiv 0 N)) * deriv φ 0 +
      eval (Fin.cons (φ 0) y) (pderiv i.succ (pderiv i.succ N)) +
      eval (Fin.cons (φ 0) y) (pderiv 0 N) * deriv (deriv φ) 0 := by
  rw [second_deriv_eval_curve N _ (graphCurve_analytic φ y i hφ), graphCurve_value]
  simp only [Fin.sum_univ_succ, graphCurve, Fin.cons_zero, Fin.cons_succ,
    deriv_affine, second_deriv_affine]
  simp only [mul_ite, ite_mul, mul_one, mul_zero, Finset.sum_add_distrib]
  simp only [Finset.sum_ite_eq', Finset.mem_univ, ite_true,
    Finset.sum_const_zero, add_zero]
  simp
  rw [second_partial_comm N (0 : Fin (n+1)) i.succ]
  ring


lemma analyticAt_line {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (y v : E) (hf : AnalyticAt ℝ f y) :
    AnalyticAt ℝ (fun s : ℝ => f (y + s • v)) 0 := by
  have hl : AnalyticAt ℝ (fun s : ℝ => y + s • v) 0 :=
    analyticAt_const.add (analyticAt_id.smul analyticAt_const)
  exact AnalyticAt.comp (f := fun s : ℝ => y + s • v) (g := f) (x := (0 : ℝ))
    (by simpa using hf) hl

lemma graphCurve_line (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (i : Fin n) (s : ℝ) :
    (fun j => graphCurve (fun t => f (y + t • Pi.single i 1)) y i j s) =
      Fin.cons (f (y + s • Pi.single i 1)) (y + s • Pi.single i 1) := by
  funext j
  refine Fin.cases rfl (fun k => ?_) j
  simp [graphCurve, Pi.single_apply, eq_comm]

lemma root_coordinate_identities (N : MvPolynomial (Fin (n+1)) ℝ)
    (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (t : ℝ) (hf : AnalyticAt ℝ f y)
    (hlevel : ∀ᶠ z in 𝓝 y, eval (Fin.cons (f z) z) N = t) (i : Fin n) :
    eval (Fin.cons (f y) y) (pderiv 0 N) * coordinateGradient f y i +
      eval (Fin.cons (f y) y) (pderiv i.succ N) = 0 ∧
    eval (Fin.cons (f y) y) (pderiv 0 (pderiv 0 N)) * (coordinateGradient f y i)^2 +
      2 * eval (Fin.cons (f y) y) (pderiv i.succ (pderiv 0 N)) * coordinateGradient f y i +
      eval (Fin.cons (f y) y) (pderiv i.succ (pderiv i.succ N)) +
      eval (Fin.cons (f y) y) (pderiv 0 N) *
        fderiv ℝ (fun z => coordinateGradient f z i) y (Pi.single i 1) = 0 := by
  let φ : ℝ → ℝ := fun s => f (y + s • Pi.single i 1)
  have hφ : AnalyticAt ℝ φ 0 := analyticAt_line f y _ hf
  have hφ0 : φ 0 = f y := by simp [φ]
  have hd : deriv φ 0 = coordinateGradient f y i := by
    simpa [φ, coordinateGradient] using deriv_line f y (Pi.single i 1) 0
      (by simpa using hf.differentiableAt)
  have hdd : deriv (deriv φ) 0 =
      fderiv ℝ (fun z => coordinateGradient f z i) y (Pi.single i 1) :=
    second_deriv_line f y (Pi.single i 1) hf
  have he : (fun s => eval (fun j => graphCurve φ y i j s) N) =ᶠ[𝓝 0] (fun _ => t) := by
    filter_upwards [(line_tendsto y (Pi.single i 1)).eventually hlevel] with s hs
    change eval (fun j => graphCurve (fun r => f (y + r • Pi.single i 1)) y i j s) N = t
    rw [graphCurve_line]
    exact hs
  have hfirst : deriv (fun s => eval (fun j => graphCurve φ y i j s) N) 0 = 0 := by
    rw [he.deriv_eq]
    simp
  have hsecond : deriv (deriv (fun s => eval (fun j => graphCurve φ y i j s) N)) 0 = 0 := by
    rw [he.deriv.deriv_eq]
    simp
  rw [first_deriv_graphCurve N φ y i hφ, hφ0, hd] at hfirst
  rw [second_deriv_graphCurve N φ y i hφ, hφ0, hd, hdd] at hsecond
  exact ⟨hfirst, hsecond⟩

lemma coordinate_second_mul (N : MvPolynomial (Fin (n+1)) ℝ)
    (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (t : ℝ) (hf : AnalyticAt ℝ f y)
    (hlevel : ∀ᶠ z in 𝓝 y, eval (Fin.cons (f z) z) N = t) (i : Fin n) :
    (eval (Fin.cons (f y) y) (pderiv 0 N))^3 *
      fderiv ℝ (fun z => coordinateGradient f z i) y (Pi.single i 1) =
    -((eval (Fin.cons (f y) y) (pderiv 0 N))^2 *
        eval (Fin.cons (f y) y) (pderiv i.succ (pderiv i.succ N)) -
      2 * eval (Fin.cons (f y) y) (pderiv 0 N) *
        eval (Fin.cons (f y) y) (pderiv i.succ N) *
        eval (Fin.cons (f y) y) (pderiv i.succ (pderiv 0 N)) +
      eval (Fin.cons (f y) y) (pderiv 0 (pderiv 0 N)) *
        (eval (Fin.cons (f y) y) (pderiv i.succ N))^2) := by
  obtain ⟨hfirst, hsecond⟩ := root_coordinate_identities N f y t hf hlevel i
  let a := eval (Fin.cons (f y) y) (pderiv 0 N)
  let b := eval (Fin.cons (f y) y) (pderiv i.succ N)
  let c := eval (Fin.cons (f y) y) (pderiv i.succ (pderiv i.succ N))
  let d := eval (Fin.cons (f y) y) (pderiv 0 (pderiv 0 N))
  let m := eval (Fin.cons (f y) y) (pderiv i.succ (pderiv 0 N))
  let p := coordinateGradient f y i
  let q := fderiv ℝ (fun z => coordinateGradient f z i) y (Pi.single i 1)
  change a*p+b = 0 at hfirst
  change d*p^2+2*m*p+c+a*q = 0 at hsecond
  change a^3*q = -(a^2*c-2*a*b*m+d*b^2)
  linear_combination a^2*hsecond - (d*(a*p-b)+2*a*m)*hfirst

/-- Differentiating the polynomial level equation twice gives the Newton
residual as the normal derivative cubed times the negative root Laplacian. -/
theorem coordinateLaplacian_mul (N : MvPolynomial (Fin (n+1)) ℝ)
    (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (t : ℝ) (hf : AnalyticAt ℝ f y)
    (hlevel : ∀ᶠ z in 𝓝 y, eval (Fin.cons (f z) z) N = t) :
    (eval (Fin.cons (f y) y) (pderiv 0 N))^3 * coordinateLaplacian f y =
      -eval (Fin.cons (f y) y) (newtonResidual N) := by
  unfold coordinateLaplacian
  rw [Finset.mul_sum]
  simp_rw [coordinate_second_mul N f y t hf hlevel]
  simp only [newtonResidual, tangentialEnergy, tangentialLaplacian, tangentialMixed,
    map_add, map_sub, map_mul, map_pow, map_ofNat, map_sum,
    Finset.sum_neg_distrib, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.mul_sum]
  ring

/-- The implicit polynomial root has Laplacian -E(N)/(N_x)^3. -/
theorem coordinateLaplacian_eq (N : MvPolynomial (Fin (n+1)) ℝ)
    (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (t : ℝ) (hf : AnalyticAt ℝ f y)
    (hlevel : ∀ᶠ z in 𝓝 y, eval (Fin.cons (f z) z) N = t)
    (hnormal : eval (Fin.cons (f y) y) (pderiv 0 N) ≠ 0) :
    coordinateLaplacian f y =
      -eval (Fin.cons (f y) y) (newtonResidual N) /
        (eval (Fin.cons (f y) y) (pderiv 0 N))^3 := by
  apply (eq_div_iff (pow_ne_zero 3 hnormal)).mpr
  simpa only [mul_comm] using coordinateLaplacian_mul N f y t hf hlevel

/-- Vanishing Newton residual makes every regular analytic level root harmonic. -/
theorem coordinateLaplacian_eq_zero (N : MvPolynomial (Fin (n+1)) ℝ)
    (hE : newtonResidual N = 0) (f : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (t : ℝ)
    (hf : AnalyticAt ℝ f y) (hlevel : ∀ᶠ z in 𝓝 y, eval (Fin.cons (f z) z) N = t)
    (hnormal : eval (Fin.cons (f y) y) (pderiv 0 N) ≠ 0) :
    coordinateLaplacian f y = 0 := by
  rw [coordinateLaplacian_eq N f y t hf hlevel hnormal, hE, map_zero, neg_zero, zero_div]

lemma coordinateGradient_contDiff (f : (Fin n → ℝ) → ℝ)
    (hf : ∀ y, AnalyticAt ℝ f y) (i : Fin n) :
    ContDiff ℝ 1 (fun y => coordinateGradient f y i) := by
  rw [contDiff_iff_contDiffAt]
  intro y
  exact (analyticAt_directional f y (Pi.single i 1) (hf y)).contDiffAt


/-- The coordinate gradient of a global regular level root is divergence-free. -/
theorem coordinateGradient_divergence_eq_zero (N : MvPolynomial (Fin (n+1)) ℝ)
    (hE : newtonResidual N = 0) (f : (Fin n → ℝ) → ℝ) (t : ℝ)
    (hf : ∀ y, AnalyticAt ℝ f y) (hlevel : ∀ y, eval (Fin.cons (f y) y) N = t)
    (hnormal : ∀ y, eval (Fin.cons (f y) y) (pderiv 0 N) ≠ 0) (y : Fin n → ℝ) :
    Source29QuarticReuse.FluxObstruction.divergence (fun i => Pi.single i 1)
      (coordinateGradient f) y = 0 := by
  rw [divergence_coordinateGradient]
  exact coordinateLaplacian_eq_zero N hE f y t (hf y)
    (Filter.Eventually.of_forall hlevel) (hnormal y)

end
end Source29NewtonRootHarmonic

/- Component: HarmonicRadialPrimitive.inc -/
namespace Source29HarmonicRadialPrimitive

open MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29LevelRadialStress
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def primitive (f : ℝ → ℝ) (R s : ℝ) : ℝ := ∫ t in R..s, f t

theorem primitive_hasDerivAt {f : ℝ → ℝ} (hf : Continuous f) (R s : ℝ) :
    HasDerivAt (primitive f R) (f s) s :=
  intervalIntegral.integral_hasDerivAt_right (hf.intervalIntegrable R s)
    hf.stronglyMeasurable.stronglyMeasurableAtFilter hf.continuousAt

theorem primitive_deriv {f : ℝ → ℝ} (hf : Continuous f) (R s : ℝ) :
    deriv (primitive f R) s = f s := (primitive_hasDerivAt hf R s).deriv

theorem primitive_contDiff {f : ℝ → ℝ} (hf : Continuous f) (R : ℝ) :
    ContDiff ℝ 1 (primitive f R) := by
  apply contDiff_one_iff_deriv.mpr
  refine ⟨fun s ↦ (primitive_hasDerivAt hf R s).differentiableAt, ?_⟩
  have he : deriv (primitive f R) = f := funext (primitive_deriv hf R)
  rw [he]
  exact hf

theorem primitive_zero {f : ℝ → ℝ} {R s : ℝ}
    (hz : ∀ t, R ≤ t → f t = 0) (hs : R ≤ s) : primitive f R s = 0 := by
  unfold primitive
  calc
    (∫ t in R..s, f t) = ∫ _t in R..s, (0 : ℝ) := by
      apply intervalIntegral.integral_congr
      intro t ht
      rw [uIcc_of_le hs] at ht
      exact hz t ht.1
    _ = 0 := intervalIntegral.integral_zero

/-- A compact radial primitive tests a divergence-free field against the
radially weighted position vector without introducing sphere integrals. -/
theorem radial_moment_zero {g : (Fin n → ℝ) → Fin n → ℝ}
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : Continuous f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) :
    (∫ x, radialWeight f r x * (∑ i, x i * g x i)) = 0 := by
  have hφ := radialWeight_contDiff (n := n) (primitive_contDiff hf R) r
  have hcφ := radialWeight_compact (n := n) hR hr (fun s hs ↦ primitive_zero hz hs)
  have he := integral_testFlux_eq_zero (μ := volume) (fun i ↦ Pi.single i 1) hφ hcφ hg hdiv
  have hpt (x : Fin n → ℝ) :
      testFlux (fun i ↦ Pi.single i 1) (radialWeight (primitive f R) r) g x =
        (2/r^2) * (radialWeight f r x * (∑ i, x i * g x i)) := by
    simp only [testFlux, radialWeight_fderiv (primitive_contDiff hf R), primitive_deriv hf]
    unfold Source29LevelRadialStress.radialWeight
    rw [Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  simp_rw [hpt] at he
  rw [integral_const_mul] at he
  exact (mul_eq_zero.mp he).resolve_left (div_ne_zero (by norm_num) (pow_ne_zero 2 hr.ne'))

end
end Source29HarmonicRadialPrimitive

/- Component: HarmonicRadialStationarity.inc -/
namespace Source29HarmonicRadialStationarity

open MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29LevelRadialStress
open Source29WeightedRadialDerivative Source29HarmonicRadialPrimitive
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def dilationField (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i : Fin n) : ℝ := u x * x i

theorem dilationField_contDiff {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 1 u) (i : Fin n) :
    ContDiff ℝ 1 (fun x ↦ dilationField u x i) := hu.mul (contDiff_apply ℝ ℝ i)

theorem dilationField_deriv {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 1 u)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ dilationField u y i) x (Pi.single i 1) =
      fderiv ℝ u x (Pi.single i 1) * x i + u x := by
  have hd := ((hu.differentiable (by norm_num) x).hasFDerivAt).fun_mul
    (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) i x)
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  change fderiv ℝ (fun y ↦ dilationField u y i) x (Pi.single i 1) = _ at he
  simpa only [add_apply, _root_.smul_apply, smul_eq_mul,
    ContinuousLinearMap.proj_apply, Pi.single_apply, ite_true, mul_one, mul_comm, add_comm] using he

theorem dilationField_divergence {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 1 u)
    {g : (Fin n → ℝ) → Fin n → ℝ}
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i) (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (dilationField u) x =
      (n : ℝ) * u x + ∑ i, x i * g x i := by
  simp only [divergence, dilationField_deriv hu, hdu, Finset.sum_add_distrib,
    Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  simp only [mul_comm, add_comm]

def normalizedMass (u : (Fin n → ℝ) → ℝ) (f : ℝ → ℝ) (r : ℝ) : ℝ := mass u f r / r^n

/-- Harmonicity kills the radial first moment, making the ordinary volume
normalization of every smooth compact radial average stationary. -/
theorem mass_stationarity {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    (n : ℝ) * mass u f r = r * ∫ x, densityDeriv u f r x := by
  have hρ := radialWeight_contDiff (n := n) hf r
  have hcρ := radialWeight_compact (n := n) hR hr hz
  have hm : Integrable (fun x ↦ radialWeight f r x * (∑ i, x i * g x i)) := by
    apply (hρ.continuous.mul _).integrable_of_hasCompactSupport hcρ.mul_right
    exact continuous_finsetSum _ (fun i _ ↦ (continuous_apply i).mul (hg i).continuous)
  have hi := density_integrable hu.continuous hf.continuous hR hr hz
  have hd := (mass_hasDerivAt hu.continuous hf hR hr hz hdz).1
  have he := integral_mul_divergence_eq_neg_testFlux (μ := volume) (fun i ↦ Pi.single i 1)
    hρ hcρ (dilationField_contDiff hu)
  have hl (x : Fin n → ℝ) :
      radialWeight f r x * divergence (fun i ↦ Pi.single i 1) (dilationField u) x =
        (n : ℝ) * density u f r x + radialWeight f r x * (∑ i, x i * g x i) := by
    rw [dilationField_divergence hu hdu]
    unfold density
    ring
  have hright (x : Fin n → ℝ) :
      testFlux (fun i ↦ Pi.single i 1) (radialWeight f r) (dilationField u) x =
        (-r) * densityDeriv u f r x := by
    have hsum : testFlux (fun i ↦ Pi.single i 1) (radialWeight f r) (dilationField u) x =
        (2/r^2) * deriv f (radiusSq x/r^2) * u x * radiusSq x := by
      simp only [testFlux, radialWeight_fderiv hf, dilationField]
      unfold radiusSq
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hsum]
    unfold densityDeriv
    have hnr := hr.ne'
    field_simp
  simp_rw [hl, hright] at he
  rw [integral_add (hi.const_mul (n : ℝ)) hm, integral_const_mul,
    radial_moment_zero hg hdiv hf.continuous hR hr hz, add_zero, integral_const_mul] at he
  change (n : ℝ) * mass u f r = -((-r) * ∫ x, densityDeriv u f r x) at he
  linarith

theorem normalizedMass_hasDerivAt_zero {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    HasDerivAt (normalizedMass u f) 0 r := by
  change HasDerivAt (fun t : ℝ ↦ mass u f t / t^n) 0 r
  have hd := Source29GraphMassMonotonicity.normalized_hasDerivAt
    (mass_hasDerivAt hu.continuous hf hR hr hz hdz).2 hr.ne' n
  have hs := mass_stationarity hu hg hdu hdiv hf hR hr hz hdz
  have he : r * (∫ x, densityDeriv u f r x) - (n : ℝ) * mass u f r = 0 := by linarith
  simpa only [he, zero_div, Source29HarmonicRadialStationarity.normalizedMass] using hd

theorem normalizedMass_eq {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r s : ℝ} (hR : 0 ≤ R)
    (hr : 0 < r) (hs : 0 < s) (hz : ∀ t, R ≤ t → f t = 0)
    (hdz : ∀ t, R ≤ t → deriv f t = 0) : normalizedMass u f r = normalizedMass u f s := by
  have hd (t : ℝ) (ht : 0 < t) := normalizedMass_hasDerivAt_zero hu hg hdu hdiv hf hR ht hz hdz
  exact isOpen_Ioi.is_const_of_deriv_eq_zero (convex_Ioi (0 : ℝ)).isPreconnected
    (fun t ht ↦ (hd t ht).differentiableAt.differentiableWithinAt)
    (fun {t} ht ↦ (hd t ht).deriv) hr hs

end
end Source29HarmonicRadialStationarity

/- Component: HarmonicRadialSmallLimit.inc -/
namespace Source29HarmonicRadialSmallLimit

open MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29LevelRadialStress
open Source29WeightedRadialDerivative Source29GraphRadialSupport Source29PhaseMassDilation
open scoped Topology

noncomputable section

variable {n : ℕ}

/-- Ordinary volume normalization removes exactly the ambient-dimensional
Jacobian of the dilation. This identity requires no regularity assumptions. -/
theorem normalizedMass_eq_rescaled (u : (Fin n → ℝ) → ℝ) (f : ℝ → ℝ)
    {r : ℝ} (hr : 0 < r) :
    mass u f r / r ^ n = ∫ x : Fin n → ℝ, f (radiusSq x) * u (r • x) := by
  have he := Measure.integral_comp_smul_of_nonneg volume (density u f r) r (hR := hr.le)
  simp only [Module.finrank_pi, Fintype.card_fin, smul_eq_mul] at he
  calc
    mass u f r / r ^ n = ∫ x : Fin n → ℝ, density u f r (r • x) := by
      simpa only [mass, div_eq_mul_inv, mul_comm] using he.symm
    _ = _ := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by
        simp only [density, Source29LevelRadialStress.radialWeight, radiusSq_dilate hr.ne']

lemma rescaled_integrand_continuous {u : (Fin n → ℝ) → ℝ} (hu : Continuous u)
    {f : ℝ → ℝ} (hf : Continuous f) :
    Continuous (fun p : ℝ × (Fin n → ℝ) => f (radiusSq p.2) * u (p.1 • p.2)) :=
  (hf.comp (radiusSq_contDiff.continuous.comp continuous_snd)).mul
    (hu.comp (continuous_fst.smul continuous_snd))

lemma radial_cutoff_zero_outside_box {f : ℝ → ℝ} {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (x : Fin n → ℝ) (hx : x ∉ supportBox n R) :
    f (radiusSq x) = 0 := by
  simpa only [Source29GraphRadialGeometry.graphRadiusSq, Pi.zero_apply,
    zero_pow (by decide : 2 ≠ 0), add_zero, radiusSq] using
    Source29GraphSmallDensity.cutoff_zero_outside_box (0 : (Fin n → ℝ) → ℝ) hR hz x hx

/-- Compact support of the radial cutoff gives a common integrable bound.
Only continuity of u is needed; no global bound on u is assumed. -/
theorem normalizedMass_small_radius_limit {u : (Fin n → ℝ) → ℝ} (hu : Continuous u)
    {f : ℝ → ℝ} (hf : Continuous f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) :
    Tendsto (fun r : ℝ => mass u f r / r ^ n) (𝓝[>] 0)
      (𝓝 (u 0 * ∫ x : Fin n → ℝ, f (radiusSq x))) := by
  classical
  let K := supportBox n R
  have hK : IsCompact K := supportBox_compact n R
  obtain ⟨M, hM⟩ := ((isCompact_Icc : IsCompact (Icc (0 : ℝ) 1)).prod hK).exists_bound_of_continuousOn
    (rescaled_integrand_continuous hu hf).continuousOn
  have hc (r : ℝ) : Continuous (fun x : Fin n → ℝ => f (radiusSq x) * u (r • x)) :=
    (hf.comp radiusSq_contDiff.continuous).mul (hu.comp (continuous_const_smul r))
  have ht : Tendsto (fun r : ℝ => ∫ x : Fin n → ℝ, f (radiusSq x) * u (r • x))
      (𝓝[>] 0) (𝓝 (∫ x : Fin n → ℝ, f (radiusSq x) * u 0)) := by
    apply tendsto_integral_filter_of_dominated_convergence (K.indicator (fun _ => M))
    · exact Filter.Eventually.of_forall fun r => (hc r).aestronglyMeasurable
    · filter_upwards [self_mem_nhdsWithin,
        mem_nhdsWithin_of_mem_nhds (gt_mem_nhds (show (0 : ℝ) < 1 by norm_num))] with r hr hr1
      apply Filter.Eventually.of_forall
      intro x
      by_cases hx : x ∈ K
      · rw [Set.indicator_of_mem hx]
        exact hM (r, x) ⟨⟨hr.le, hr1.le⟩, hx⟩
      · rw [Set.indicator_of_notMem hx, radial_cutoff_zero_outside_box hR hz x hx,
          zero_mul, norm_zero]
    · exact (integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hK.measure_lt_top.ne)
    · apply Filter.Eventually.of_forall
      intro x
      have hx : Continuous (fun r : ℝ => f (radiusSq x) * u (r • x)) :=
        continuous_const.mul (hu.comp (continuous_id.smul continuous_const))
      simpa only [zero_smul] using (hx.tendsto 0).mono_left nhdsWithin_le_nhds
  rw [integral_mul_const, mul_comm] at ht
  apply ht.congr'
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact (normalizedMass_eq_rescaled u f hr).symm

/-- The same limit along any sequence of positive radii tending to zero. -/
theorem normalizedMass_small_radius_sequence {u : (Fin n → ℝ) → ℝ} (hu : Continuous u)
    {f : ℝ → ℝ} (hf : Continuous f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0)
    {r : ℕ → ℝ} (hr : ∀ k, 0 < r k) (hr0 : Tendsto r atTop (𝓝 0)) :
    Tendsto (fun k => mass u f (r k) / r k ^ n) atTop
      (𝓝 (u 0 * ∫ x : Fin n → ℝ, f (radiusSq x))) := by
  apply (normalizedMass_small_radius_limit hu hf hR hz).comp
  exact tendsto_nhdsWithin_iff.mpr ⟨hr0, Filter.Eventually.of_forall hr⟩

end
end Source29HarmonicRadialSmallLimit

/- Component: HarmonicRadialMeanValue.inc -/
namespace Source29HarmonicRadialMeanValue

open MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29LevelRadialStress
open Source29HarmonicRadialStationarity Source29HarmonicRadialSmallLimit
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Stationarity and the small-radius limit identify every radial average. -/
theorem normalizedMass_mean_value {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    normalizedMass u f r = u 0 * ∫ x : Fin n → ℝ, f (radiusSq x) := by
  have ht := normalizedMass_small_radius_limit hu.continuous hf.continuous hR hz
  have hc : Tendsto (fun _s : ℝ => normalizedMass u f r) (𝓝[>] 0)
      (𝓝 (u 0 * ∫ x : Fin n → ℝ, f (radiusSq x))) := by
    apply ht.congr'
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact (normalizedMass_eq hu hg hdu hdiv hf hR hr hs hz hdz).symm
  exact tendsto_nhds_unique tendsto_const_nhds hc

/-- The radial mean-value identity holds about every center. -/
theorem radial_mean_value {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (a : Fin n → ℝ) :
    (∫ x : Fin n → ℝ, f (radiusSq x) * u (a + r • x)) =
      u a * ∫ x : Fin n → ℝ, f (radiusSq x) := by
  have hu' : ContDiff ℝ 1 (fun x ↦ u (a + x)) := hu.comp (contDiff_const.add contDiff_id)
  have hg' (i : Fin n) : ContDiff ℝ 1 (fun x ↦ g (a + x) i) :=
    (hg i).comp (contDiff_const.add contDiff_id)
  have hdu' (x : Fin n → ℝ) (i : Fin n) :
      fderiv ℝ (fun y ↦ u (a + y)) x (Pi.single i 1) = g (a + x) i := by
    rw [fderiv_comp_add_left]
    exact hdu (a + x) i
  have hdiv' (x : Fin n → ℝ) :
      divergence (fun i ↦ Pi.single i 1) (fun y ↦ g (a + y)) x = 0 := by
    have he (i : Fin n) : fderiv ℝ (fun y ↦ g (a + y) i) x =
        fderiv ℝ (fun y ↦ g y i) (a + x) :=
      fderiv_comp_add_left (f := fun y ↦ g y i) a
    simpa only [divergence, he] using hdiv (a + x)
  have he := normalizedMass_mean_value hu' hg' hdu' hdiv' hf hR hr hz hdz
  rw [normalizedMass, normalizedMass_eq_rescaled _ _ hr] at he
  simpa only [add_zero] using he

end
end Source29HarmonicRadialMeanValue

/- Component: HarmonicRadialKernels.inc -/
namespace Source29HarmonicRadialKernels

open MeasureTheory
open Source29PolynomialGraphMonotonicity
open Source29QuarticReuse.FluxObstruction

noncomputable section

/-- A wider cutoff which equals one on the support of the first cutoff's derivative. -/
def outerCutoff (s : ℝ) : ℝ := radialCutoff (s - 2)

theorem outerCutoff_contDiff : ContDiff ℝ 1 outerCutoff :=
  radialCutoff_contDiff.comp (contDiff_id.sub contDiff_const)

theorem outerCutoff_nonneg (s : ℝ) : 0 ≤ outerCutoff s :=
  (radialCutoff_bounds (s - 2)).1

theorem outerCutoff_le_one (s : ℝ) : outerCutoff s ≤ 1 :=
  (radialCutoff_bounds (s - 2)).2

theorem outerCutoff_deriv (s : ℝ) : deriv outerCutoff s = deriv radialCutoff (s - 2) := by
  have h := ((radialCutoff_contDiff.differentiable (by norm_num) (s - 2)).hasDerivAt).comp s
    ((hasDerivAt_id s).sub_const 2)
  change deriv (fun t : ℝ ↦ radialCutoff (t - 2)) s = _
  simpa only [Function.comp_def, id_eq, mul_one] using h.deriv

theorem outerCutoff_zero (s : ℝ) (hs : 4 ≤ s) : outerCutoff s = 0 :=
  radialCutoff_zero (s - 2) (by linarith)

theorem outerCutoff_deriv_zero (s : ℝ) (hs : 4 ≤ s) : deriv outerCutoff s = 0 := by
  rw [outerCutoff_deriv]
  exact radialCutoff_deriv_zero (s - 2) (by linarith)

theorem radialCutoff_one_of_nonpos (s : ℝ) (hs : s ≤ 0) : radialCutoff s = 1 := by
  rw [radialCutoff, Real.smoothTransition.zero_of_nonpos hs, sub_zero]

theorem outerCutoff_one_of_le_two (s : ℝ) (hs : s ≤ 2) : outerCutoff s = 1 :=
  radialCutoff_one_of_nonpos (s - 2) (by linarith)

theorem radialCutoff_compact (n : ℕ) :
    HasCompactSupport (fun x : Fin n → ℝ ↦ radialCutoff (radiusSq x)) := by
  have h := Source29LevelRadialStress.radialWeight_compact (n := n) (R := 2) (r := 1)
    (by norm_num) (by norm_num) radialCutoff_zero
  change HasCompactSupport (fun x : Fin n → ℝ ↦ radialCutoff (radiusSq x / 1^2)) at h
  simpa only [one_pow, div_one] using h

theorem outerCutoff_compact (n : ℕ) :
    HasCompactSupport (fun x : Fin n → ℝ ↦ outerCutoff (radiusSq x)) := by
  have h := Source29LevelRadialStress.radialWeight_compact (n := n) (R := 4) (r := 1)
    (by norm_num) (by norm_num) outerCutoff_zero
  change HasCompactSupport (fun x : Fin n → ℝ ↦ outerCutoff (radiusSq x / 1^2)) at h
  simpa only [one_pow, div_one] using h

theorem radialCutoff_integrable (n : ℕ) :
    Integrable (fun x : Fin n → ℝ ↦ radialCutoff (radiusSq x)) :=
  (radialCutoff_contDiff.continuous.comp radiusSq_contDiff.continuous).integrable_of_hasCompactSupport (radialCutoff_compact n)

theorem outerCutoff_integrable (n : ℕ) :
    Integrable (fun x : Fin n → ℝ ↦ outerCutoff (radiusSq x)) :=
  (outerCutoff_contDiff.continuous.comp radiusSq_contDiff.continuous).integrable_of_hasCompactSupport (outerCutoff_compact n)

/-- The normalization mass is positive, including in dimension zero. -/
theorem radialCutoff_mass_pos (n : ℕ) :
    0 < ∫ x : Fin n → ℝ, radialCutoff (radiusSq x) := by
  apply integral_pos_of_integrable_nonneg_nonzero (x := (0 : Fin n → ℝ))
    (radialCutoff_contDiff.continuous.comp radiusSq_contDiff.continuous)
    (radialCutoff_integrable n)
  · exact fun x ↦ (radialCutoff_bounds (radiusSq x)).1
  · have h0 : radiusSq (0 : Fin n → ℝ) = 0 := by simp [radiusSq]
    change radialCutoff (radiusSq (0 : Fin n → ℝ)) ≠ 0
    rw [h0, radialCutoff_one_of_nonpos 0 le_rfl]
    norm_num

theorem outerCutoff_mass_pos (n : ℕ) :
    0 < ∫ x : Fin n → ℝ, outerCutoff (radiusSq x) := by
  apply integral_pos_of_integrable_nonneg_nonzero (x := (0 : Fin n → ℝ))
    (outerCutoff_contDiff.continuous.comp radiusSq_contDiff.continuous)
    (outerCutoff_integrable n)
  · exact fun x ↦ outerCutoff_nonneg (radiusSq x)
  · have h0 : radiusSq (0 : Fin n → ℝ) = 0 := by simp [radiusSq]
    change outerCutoff (radiusSq (0 : Fin n → ℝ)) ≠ 0
    rw [h0, outerCutoff_one_of_le_two 0 (by norm_num)]
    norm_num

/-- A single constant bounds every coordinate derivative in every dimension by the wider kernel. -/
theorem exists_uniform_fderiv_bound :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (n : ℕ) (i : Fin n) (x : Fin n → ℝ),
      |fderiv ℝ (Source29LevelRadialStress.radialWeight radialCutoff 1) x
        (Pi.single i 1)| ≤ B * outerCutoff (radiusSq x) := by
  obtain ⟨M, hM⟩ := Source29GraphHeightProfile.profile_deriv_bounded
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM 0)
  refine ⟨4 * M, by positivity, ?_⟩
  intro n i x
  rw [Source29LevelRadialStress.radialWeight_fderiv radialCutoff_contDiff]
  norm_num only [one_pow, div_one]
  by_cases hx : radiusSq x ≤ 2
  · rw [outerCutoff_one_of_le_two _ hx, mul_one]
    have hxi : |x i| ≤ 2 := by
      have hi : (x i)^2 ≤ radiusSq x := by
        exact Finset.single_le_sum (fun j _ ↦ sq_nonneg (x j)) (Finset.mem_univ i)
      nlinarith [sq_abs (x i), abs_nonneg (x i)]
    have hd : |deriv radialCutoff (radiusSq x)| ≤ M := by
      simpa [radialCutoff_deriv, Real.norm_eq_abs] using hM (radiusSq x)
    rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    nlinarith [abs_nonneg (deriv radialCutoff (radiusSq x)), abs_nonneg (x i),
      mul_le_mul hd hxi (abs_nonneg (x i)) hM0]
  · rw [radialCutoff_deriv_zero _ (by linarith), mul_zero, zero_mul, abs_zero]
    exact mul_nonneg (by positivity) (outerCutoff_nonneg _)

end
end Source29HarmonicRadialKernels

/- Component: CompactConvolutionDerivative.inc -/
namespace Source29CompactConvolutionDerivative

open MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29CompactParameterIntegral
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Translate the centre of a compact convolution along an arbitrary vector.
The differentiated function need only be C1, with no global growth bound. -/
theorem integral_hasDerivAt {ρ u : (Fin n → ℝ) → ℝ}
    (hρ : Continuous ρ) (hcρ : HasCompactSupport ρ) (hu : ContDiff ℝ 1 u)
    (a v : Fin n → ℝ) (r t : ℝ) :
    Integrable (fun x ↦ ρ x * fderiv ℝ u (a + t • v + r • x) v) ∧
    HasDerivAt (fun s : ℝ ↦ ∫ x, ρ x * u (a + s • v + r • x))
      (∫ x, ρ x * fderiv ℝ u (a + t • v + r • x) v) t := by
  have hdv : Continuous (fun x ↦ fderiv ℝ u x v) :=
    (hu.continuous_fderiv (by norm_num)).clm_apply continuous_const
  apply hasDerivAt_integral
    (F := fun s x ↦ ρ x * u (a + s • v + r • x))
    (F' := fun s x ↦ ρ x * fderiv ℝ u (a + s • v + r • x) v)
    (r := t) (a := t-1) (b := t+1) (K := tsupport ρ)
    (by linarith) (by linarith) hcρ
  · intro s hs
    exact hρ.mul (hu.continuous.comp (by fun_prop))
  · intro s hs
    exact hρ.mul (hdv.comp (by fun_prop))
  · exact ((hρ.comp continuous_snd).mul (hdv.comp (by fun_prop))).continuousOn
  · intro s hs x hx
    rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  · intro s hs x hx
    rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  · intro x s hs
    have ha : HasDerivAt (fun b : ℝ ↦ a + b • v + r • x) v s := by
      simpa only [one_smul, id_eq] using (((hasDerivAt_id s).smul_const v).const_add a).add_const (r • x)
    exact (((hu.differentiable (by norm_num) _).hasFDerivAt).comp_hasDerivAt s ha).const_mul (ρ x)

/-- Differentiating a function after an affine scalar dilation multiplies
its directional derivative by the dilation radius. -/
theorem affine_fderiv {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 1 u)
    (a v x : Fin n → ℝ) (r : ℝ) :
    fderiv ℝ (fun y ↦ u (a + r • y)) x v = r * fderiv ℝ u (a + r • x) v := by
  have hd := ((hu.differentiable (by norm_num) _).hasFDerivAt).comp x
    (((hasFDerivAt_id x).const_smul r).const_add a)
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D v) hd.fderiv
  simpa only [Function.comp_def, ContinuousLinearMap.comp_apply, _root_.smul_apply,
    ContinuousLinearMap.id_apply, map_smul, smul_eq_mul, id_eq, Pi.smul_apply] using he

/-- Integration by parts moves a directional derivative onto the compact
kernel, recording the scalar dilation exactly. -/
theorem scaled_integral_derivative {ρ u : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) (hu : ContDiff ℝ 1 u)
    (a v : Fin n → ℝ) (r : ℝ) :
    r * (∫ x, ρ x * fderiv ℝ u (a + r • x) v) =
      -(∫ x, fderiv ℝ ρ x v * u (a + r • x)) := by
  have he := integral_mul_fderiv_eq_neg_of_compactSupport (μ := volume)
    hρ hcρ (hu.comp (by fun_prop : ContDiff ℝ 1 (fun x : Fin n → ℝ ↦ a + r • x))) v
  change (∫ x, ρ x * fderiv ℝ (fun y ↦ u (a + r • y)) x v) =
    -(∫ x, fderiv ℝ ρ x v * u (a + r • x)) at he
  simp_rw [affine_fderiv hu a v] at he
  have hp : (fun x ↦ ρ x * (r * fderiv ℝ u (a + r • x) v)) =
      fun x ↦ r * (ρ x * fderiv ℝ u (a + r • x) v) := by
    funext x
    ring
  rw [hp, integral_const_mul] at he
  exact he

/-- A mean-value identity for every centre also holds after differentiation
in the centre. This uses C1 regularity, not harmonicity of the derivative. -/
theorem derivative_mean_value {ρ u : (Fin n → ℝ) → ℝ}
    (hρ : Continuous ρ) (hcρ : HasCompactSupport ρ) (hu : ContDiff ℝ 1 u)
    (r C : ℝ) (hmean : ∀ a : Fin n → ℝ, (∫ x, ρ x * u (a + r • x)) = C * u a)
    (a v : Fin n → ℝ) :
    (∫ x, ρ x * fderiv ℝ u (a + r • x) v) = C * fderiv ℝ u a v := by
  have hd := (integral_hasDerivAt hρ hcρ hu a v r 0).2
  have he : (fun s : ℝ ↦ ∫ x, ρ x * u (a + s • v + r • x)) =
      fun s : ℝ ↦ C * u (a + s • v) := by
    funext s
    exact hmean (a + s • v)
  rw [he] at hd
  have ha : HasDerivAt (fun s : ℝ ↦ a + s • v) v 0 := by
    simpa only [one_smul, id_eq] using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add a
  have hu' := (((hu.differentiable (by norm_num) _).hasFDerivAt).comp_hasDerivAt 0 ha).const_mul C
  simpa only [zero_smul, add_zero] using hd.unique hu'

end
end Source29CompactConvolutionDerivative

/- Component: MeanValueGradientBound.inc -/
namespace Source29MeanValueGradientBound

open MeasureTheory Set
open Source29CompactConvolutionDerivative
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem directional_bound {u ρ σ : (Fin n → ℝ) → ℝ}
    (hu : ContDiff ℝ 1 u) (hupos : ∀ x, 0 ≤ u x)
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : Continuous σ) (hcσ : HasCompactSupport σ)
    (C S B r : ℝ) (hC : 0 < C) (hr : 0 < r)
    (hmeanρ : ∀ a : Fin n → ℝ, (∫ x, ρ x * u (a + r • x)) = C * u a)
    (hmeanσ : ∀ a : Fin n → ℝ, (∫ x, σ x * u (a + r • x)) = S * u a)
    (v : Fin n → ℝ) (hbound : ∀ x, |fderiv ℝ ρ x v| ≤ B * σ x) (a : Fin n → ℝ) :
    r * C * |fderiv ℝ u a v| ≤ B * S * u a := by
  have huc : Continuous (fun x : Fin n → ℝ ↦ u (a + r • x)) := hu.continuous.comp (by fun_prop)
  have hdc : Continuous (fun x ↦ fderiv ℝ ρ x v) :=
    (hρ.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hJ : Integrable (fun x ↦ fderiv ℝ ρ x v * u (a + r • x)) :=
    (hdc.mul huc).integrable_of_hasCompactSupport (hcρ.fderiv_apply ℝ v).mul_right
  have hK : Integrable (fun x ↦ σ x * u (a + r • x)) :=
    (hσ.mul huc).integrable_of_hasCompactSupport hcσ.mul_right
  have hi : |∫ x, fderiv ℝ ρ x v * u (a + r • x)| ≤ B * S * u a := by
    calc
      _ ≤ ∫ x, |fderiv ℝ ρ x v * u (a + r • x)| := abs_integral_le_integral_abs
      _ ≤ ∫ x, B * (σ x * u (a + r • x)) := by
        apply integral_mono hJ.abs (hK.const_mul B)
        intro x
        change |fderiv ℝ ρ x v * u (a + r • x)| ≤ B * (σ x * u (a + r • x))
        rw [abs_mul, abs_of_nonneg (hupos _)]
        calc
          _ ≤ (B * σ x) * u (a + r • x) := mul_le_mul_of_nonneg_right (hbound x) (hupos _)
          _ = _ := by ring
      _ = B * S * u a := by rw [integral_const_mul, hmeanσ a]; ring
  have he := scaled_integral_derivative hρ hcρ hu a v r
  rw [derivative_mean_value hρ.continuous hcρ hu r C hmeanρ a v] at he
  have ha := congrArg abs he
  simp only [abs_mul, abs_of_pos hr, abs_of_pos hC, abs_neg] at ha
  calc
    _ = |∫ x, fderiv ℝ ρ x v * u (a + r • x)| := by nlinarith [ha]
    _ ≤ _ := hi

/-- Two compact mean-value kernels, one controlling the first derivatives of
the other, force every nonnegative C1 function with those mean values to be constant. -/
theorem constant_of_mean_value_kernels {u ρ σ : (Fin n → ℝ) → ℝ}
    (hu : ContDiff ℝ 1 u) (hupos : ∀ x, 0 ≤ u x)
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : Continuous σ) (hcσ : HasCompactSupport σ)
    (C S : ℝ) (hC : 0 < C)
    (hmeanρ : ∀ r : ℝ, 0 < r → ∀ a : Fin n → ℝ, (∫ x, ρ x * u (a + r • x)) = C * u a)
    (hmeanσ : ∀ r : ℝ, 0 < r → ∀ a : Fin n → ℝ, (∫ x, σ x * u (a + r • x)) = S * u a)
    (hbound : ∀ i : Fin n, ∃ B : ℝ, ∀ x, |fderiv ℝ ρ x (Pi.single i 1)| ≤ B * σ x)
    (a b : Fin n → ℝ) : u a = u b := by
  have hz (x : Fin n → ℝ) (i : Fin n) : fderiv ℝ u x (Pi.single i 1) = 0 := by
    obtain ⟨B,hB⟩ := hbound i
    by_contra hn
    have hD : 0 < C * |fderiv ℝ u x (Pi.single i 1)| := mul_pos hC (abs_pos.mpr hn)
    let M := B * S * u x
    let r := (|M|+1) / (C * |fderiv ℝ u x (Pi.single i 1)|)
    have hr : 0 < r := div_pos (by positivity) hD
    have hbnd := directional_bound hu hupos hρ hcρ hσ hcσ C S B r hC hr
      (hmeanρ r hr) (hmeanσ r hr) (Pi.single i 1) hB x
    have he : r * C * |fderiv ℝ u x (Pi.single i 1)| = |M|+1 := by
      dsimp only [r]
      field_simp
    rw [he] at hbnd
    change |M|+1 ≤ M at hbnd
    linarith [le_abs_self M]
  have hzero (x : Fin n → ℝ) : fderiv ℝ u x = 0 := by
    ext v
    have hv : v = ∑ i, v i • Pi.single i 1 := by
      funext j
      simp [Pi.single_apply]
    rw [hv, map_sum]
    simp only [map_smul, smul_eq_mul, hz, mul_zero, Finset.sum_const_zero,
      zero_apply]
  exact is_const_of_fderiv_eq_zero (hu.differentiable (by norm_num)) hzero a b

end
end Source29MeanValueGradientBound

/- Component: PositiveHarmonicLiouville.inc -/
namespace Source29PositiveHarmonicLiouville

open MeasureTheory
open Source29QuarticReuse.FluxObstruction
open Source29PolynomialGraphMonotonicity Source29HarmonicRadialKernels

noncomputable section
variable {n : ℕ}

/-- A nonnegative entire real harmonic function is constant, in any finite dimension. -/
theorem eq_of_nonnegative_harmonic {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) g x = 0)
    (hupos : ∀ x, 0 ≤ u x) (a b : Fin n → ℝ) : u a = u b := by
  let ρ : (Fin n → ℝ) → ℝ := fun x ↦ radialCutoff (radiusSq x)
  let σ : (Fin n → ℝ) → ℝ := fun x ↦ outerCutoff (radiusSq x)
  have hρ : ContDiff ℝ 1 ρ := radialCutoff_contDiff.comp radiusSq_contDiff
  have hσ : Continuous σ := outerCutoff_contDiff.continuous.comp radiusSq_contDiff.continuous
  have hmρ (r : ℝ) (hr : 0 < r) (a : Fin n → ℝ) :
      (∫ x, ρ x * u (a + r • x)) = (∫ x, ρ x) * u a := by
    simpa only [ρ, mul_comm] using Source29HarmonicRadialMeanValue.radial_mean_value
      hu hg hdu hdiv radialCutoff_contDiff (by norm_num : (0 : ℝ) ≤ 2) hr
      radialCutoff_zero radialCutoff_deriv_zero a
  have hmσ (r : ℝ) (hr : 0 < r) (a : Fin n → ℝ) :
      (∫ x, σ x * u (a + r • x)) = (∫ x, σ x) * u a := by
    simpa only [σ, mul_comm] using Source29HarmonicRadialMeanValue.radial_mean_value
      hu hg hdu hdiv outerCutoff_contDiff (by norm_num : (0 : ℝ) ≤ 4) hr
      outerCutoff_zero outerCutoff_deriv_zero a
  have hb (i : Fin n) : ∃ B : ℝ, ∀ x, |fderiv ℝ ρ x (Pi.single i 1)| ≤ B * σ x := by
    obtain ⟨B, _, hB⟩ := exists_uniform_fderiv_bound
    refine ⟨B, ?_⟩
    intro x
    have he : Source29LevelRadialStress.radialWeight radialCutoff 1 = ρ := by
      funext y
      simp [Source29LevelRadialStress.radialWeight, ρ]
    simpa only [he] using hB n i x
  exact Source29MeanValueGradientBound.constant_of_mean_value_kernels hu hupos hρ
    (radialCutoff_compact n) hσ (outerCutoff_compact n)
    (∫ x, ρ x) (∫ x, σ x) (radialCutoff_mass_pos n) hmρ hmσ hb a b

end
end Source29PositiveHarmonicLiouville

/- Component: NewtonRootConstant.inc -/
namespace Source29NewtonRootConstant

open MvPolynomial
open Source29NewtonNormalDerivative Source29NewtonPositiveRoot
open Source29NewtonRootAnalytic Source29NewtonRootHarmonic
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable

noncomputable section
variable {n : ℕ}

/-- The positive normal root is an entire nonnegative harmonic function,
and hence is constant in the tangential variables. -/
theorem positiveRoot_constant
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (t : ℝ) (ht : 0 < t) (a b : Fin n → ℝ) :
    positiveRoot N t a = positiveRoot N t b := by
  have ha := analyticAt_positiveRoot N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht
  have hp := positiveRoot_properties N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht
  have hu : ContDiff ℝ 1 (positiveRoot N t) := by
    rw [contDiff_iff_contDiffAt]
    exact fun y => (ha y).contDiffAt
  exact Source29PositiveHarmonicLiouville.eq_of_nonnegative_harmonic hu
    (coordinateGradient_contDiff (positiveRoot N t) ha) (fun _ _ => rfl)
    (coordinateGradient_divergence_eq_zero N hE (positiveRoot N t) t ha
      (fun y => (hp y).2.1) (fun y => (hp y).2.2))
    (fun y => (hp y).1.le) a b

/-- Weak sign and the Newton equation imply strict positivity throughout the
positive normal half-space. -/
theorem eval_pos_of_normal_pos
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (y : Fin n → ℝ) {x : ℝ} (hx : 0 < x) : 0 < eval (Fin.cons x y) N := by
  have hp : ∀ s, 0 < s → 0 ≤ (sliceHom y N).eval s := by
    intro s hs
    rw [eval_sliceHom]
    exact hpos (Fin.cons s y) hs
  have hn : ∀ s, s < 0 → (sliceHom y N).eval s ≤ 0 := by
    intro s hs
    rw [eval_sliceHom]
    exact hneg (Fin.cons s y) hs
  have hr : ∀ s, (sliceHom y N).eval s ≠ 0 → (sliceHom y N).derivative.eval s ≠ 0 := by
    intro s hs
    rw [← sliceHom_pderiv_zero, eval_sliceHom]
    apply normal_derivative_ne_zero_of_constant_coefficient N α D hD hEuler hE d hd c hc hcoeff
    rwa [eval_sliceHom] at hs
  simpa only [eval_sliceHom] using Source29PolynomialPhaseRoot.eval_pos_of_pos
    (sliceHom y N) (slice_ne_zero N d c hc hcoeff y)
    (Source29PolynomialPhaseRoot.eval_zero_of_sign (sliceHom y N) hp hn) hp hr hx

/-- All normal slices coincide as polynomials, since their positive level
roots coincide and their values are strictly positive on the positive axis. -/
theorem sliceHom_independent
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    sliceHom y N = sliceHom 0 N := by
  apply Polynomial.eq_of_infinite_eval_eq
  apply (Set.Ioi_infinite (0 : ℝ)).mono
  intro x hx
  let t := eval (Fin.cons x (0 : Fin n → ℝ)) N
  have ht : 0 < t := eval_pos_of_normal_pos N α D hD hEuler hE hpos hneg d hd c hc hcoeff 0 hx
  have he : positiveRoot N t 0 = x := positiveRoot_eq_of_root N t 0
    (existsUnique_positive_normal_root N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht 0)
    hx rfl
  have hy : positiveRoot N t y = x :=
    (positiveRoot_constant N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht y 0).trans he
  have hv := (positiveRoot_properties N α D hD hEuler hE hpos hneg d hd c hc hcoeff t ht y).2.1
  rw [hy] at hv
  change (sliceHom y N).eval x = (sliceHom 0 N).eval x
  simpa only [eval_sliceHom] using hv

/-- Evaluation of N is independent of all tangential variables, including
at negative normal coordinates. Polynomial identity extends the positive-axis result. -/
theorem eval_independent_of_tangential
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (x : ℝ) (y : Fin n → ℝ) :
    eval (Fin.cons x y) N = eval (Fin.cons x (0 : Fin n → ℝ)) N := by
  simpa only [eval_sliceHom] using congrArg (fun p : Polynomial ℝ => p.eval x)
    (sliceHom_independent N α D hD hEuler hE hpos hneg d hd c hc hcoeff y)

/-- The polynomial in the distinguished variable has scalar coefficients. -/
theorem finSuccEquiv_eq_map
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) :
    finSuccEquiv ℝ n N = (sliceHom 0 N).map (C : ℝ →+* MvPolynomial (Fin n) ℝ) := by
  apply Polynomial.ext
  intro k
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro y
  rw [Polynomial.coeff_map, eval_C]
  have he := congrArg (fun p : Polynomial ℝ => p.coeff k)
    (sliceHom_independent N α D hD hEuler hE hpos hneg d hd c hc hcoeff y)
  change (((finSuccEquiv ℝ n N).map (eval y)).coeff k) = _ at he
  simpa only [Polynomial.coeff_map] using he

/-- Every tangential partial derivative of N vanishes. -/
theorem tangential_pderiv_eq_zero
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (i : Fin n) :
    pderiv i.succ N = 0 := by
  apply (finSuccEquiv ℝ n).injective
  apply Polynomial.ext
  intro k
  rw [map_zero, Polynomial.coeff_zero, coeff_finSuccEquiv_pderiv_succ,
    finSuccEquiv_eq_map N α D hD hEuler hE hpos hneg d hd c hc hcoeff,
    Polynomial.coeff_map, pderiv_C]

end
end Source29NewtonRootConstant

/- Component: NewtonPureNormalPower.inc -/
namespace Source29NewtonPureNormalPower

open MvPolynomial
open Source29NewtonNormalDerivative
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable

noncomputable section

lemma coeff_X_mul_derivative {R : Type*} [CommSemiring R]
    (P : Polynomial R) (k : ℕ) :
    (Polynomial.X * P.derivative).coeff k = P.coeff k * (k : R) := by
  cases k with
  | zero => simp
  | succ k => simp only [Polynomial.coeff_X_mul, Polynomial.coeff_derivative, Nat.cast_succ]

lemma weighted_derivative_coefficient {R : Type*} [CommRing R]
    (P : Polynomial R) (a b : R)
    (he : Polynomial.C a * Polynomial.X * P.derivative = Polynomial.C b * P)
    (k : ℕ) : a * (k : R) * P.coeff k = b * P.coeff k := by
  have hk := congrArg (fun Q : Polynomial R ↦ Q.coeff k) he
  rw [mul_assoc, Polynomial.coeff_C_mul, coeff_X_mul_derivative,
    Polynomial.coeff_C_mul] at hk
  calc
    a * (k : R) * P.coeff k = a * (P.coeff k * (k : R)) := by ring
    _ = b * P.coeff k := hk

/-- A nonzero coefficient of a polynomial satisfying a weighted Euler equation
fixes its unique possible degree. -/
theorem eq_monomial_of_weighted_derivative {R : Type*} [CommRing R] [IsDomain R] [CharZero R]
    (P : Polynomial R) (a b : R) (ha : a ≠ 0)
    (he : Polynomial.C a * Polynomial.X * P.derivative = Polynomial.C b * P)
    (d : ℕ) (hd : P.coeff d ≠ 0) :
    P = Polynomial.C (P.coeff d) * Polynomial.X ^ d := by
  have hdegree : a * (d : R) = b :=
    mul_right_cancel₀ hd (weighted_derivative_coefficient P a b he d)
  apply Polynomial.ext
  intro k
  rw [Polynomial.coeff_C_mul_X_pow]
  by_cases hkd : k = d
  · simp [hkd]
  · rw [ite_eq_right hkd]
    by_contra hk
    have hkdegree : a * (k : R) = b :=
      mul_right_cancel₀ hk (weighted_derivative_coefficient P a b he k)
    exact hkd (Nat.cast_injective (mul_left_cancel₀ ha (hkdegree.trans hdegree.symm)))

variable {n : ℕ}

lemma finSuccEquiv_C_scalar (c : ℝ) :
    finSuccEquiv ℝ n (C c) = Polynomial.C (C c) := by
  rw [finSuccEquiv_apply]
  simp only [eval₂Hom_C, RingHom.comp_apply]

lemma normal_euler (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ)
    (hEuler : WeightedEuler N α D) (htangent : ∀ i : Fin n, pderiv i.succ N = 0) :
    Polynomial.C (C α) * Polynomial.X * (finSuccEquiv ℝ n N).derivative =
      Polynomial.C (C D) * finSuccEquiv ℝ n N := by
  have hsource : C α * X 0 * pderiv 0 N = C D * N := by
    simpa only [WeightedEuler, htangent, mul_zero, Finset.sum_const_zero, add_zero] using hEuler
  have h := congrArg (finSuccEquiv ℝ n) hsource
  simpa only [map_mul, finSuccEquiv_pderiv_zero, finSuccEquiv_X_zero,
    finSuccEquiv_C_scalar] using h

/-- After tangential independence, any nonzero constant normal coefficient and
nonzero normal weight determine the whole polynomial. -/
theorem eq_pure_normal_power (N : MvPolynomial (Fin (n + 1)) ℝ)
    (α D : ℝ) (hα : α ≠ 0) (hEuler : WeightedEuler N α D)
    (htangent : ∀ i : Fin n, pderiv i.succ N = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) :
    N = C c * (X 0)^d := by
  have hαC : (C α : MvPolynomial (Fin n) ℝ) ≠ 0 := by simpa using hα
  have hd : (finSuccEquiv ℝ n N).coeff d ≠ 0 := by rw [hcoeff]; simpa using hc
  have h := eq_monomial_of_weighted_derivative (finSuccEquiv ℝ n N) (C α) (C D)
    hαC (normal_euler N α D hEuler htangent) d hd
  apply (finSuccEquiv ℝ n).injective
  rw [h, hcoeff]
  simp only [map_mul, map_pow, finSuccEquiv_X_zero, finSuccEquiv_C_scalar]

/-- The nonzero total weighted degree already forces the normal weight to be
nonzero, so no additional weight hypothesis is needed after independence. -/
theorem eq_pure_normal_power_of_degree_ne_zero (N : MvPolynomial (Fin (n + 1)) ℝ)
    (α D : ℝ) (hD : D ≠ 0) (hEuler : WeightedEuler N α D)
    (htangent : ∀ i : Fin n, pderiv i.succ N = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) :
    N = C c * (X 0)^d := by
  have hα : α ≠ 0 := by
    intro hz
    have he := weighted_derivative_coefficient (finSuccEquiv ℝ n N) (C α) (C D)
      (normal_euler N α D hEuler htangent) d
    rw [hz, map_zero, zero_mul, zero_mul, hcoeff] at he
    have hDc : (C D : MvPolynomial (Fin n) ℝ) * C c ≠ 0 :=
      mul_ne_zero (by simpa using hD) (by simpa using hc)
    exact hDc he.symm
  exact eq_pure_normal_power N α D hα hEuler htangent d c hc hcoeff

/-- The surviving normal degree also determines the total weighted degree. -/
theorem weighted_degree_eq (N : MvPolynomial (Fin (n + 1)) ℝ)
    (α D : ℝ) (hEuler : WeightedEuler N α D)
    (htangent : ∀ i : Fin n, pderiv i.succ N = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) : D = α * (d : ℝ) := by
  have hd : (finSuccEquiv ℝ n N).coeff d ≠ 0 := by rw [hcoeff]; simpa using hc
  have he := mul_right_cancel₀ hd (weighted_derivative_coefficient (finSuccEquiv ℝ n N)
    (C α) (C D) (normal_euler N α D hEuler htangent) d)
  have hv := congrArg (eval (0 : Fin n → ℝ)) he
  simpa only [map_mul, eval_C, map_natCast] using hv.symm

/-- The two half-space signs make a nonzero pure normal power positive and odd. -/
theorem coefficient_pos_and_degree_odd (N : MvPolynomial (Fin (n + 1)) ℝ)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0) (hN : N = C c * (X 0)^d)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0) :
    0 < c ∧ Odd d := by
  have hp := hpos (fun _ ↦ 1) (by norm_num)
  have hm := hneg (fun _ ↦ -1) (by norm_num)
  rw [hN] at hp hm
  simp only [map_mul, map_pow, eval_C, eval_X, one_pow, mul_one] at hp hm
  have hcpos : 0 < c := lt_of_le_of_ne hp hc.symm
  refine ⟨hcpos, ?_⟩
  rcases Nat.even_or_odd d with hd | hd
  · rw [hd.neg_one_pow, mul_one] at hm
    linarith
  · exact hd

end
end Source29NewtonPureNormalPower

/- Component: NewtonPolynomialRigidity.inc -/
namespace Source29NewtonPolynomialRigidity

open MvPolynomial
open Source29NewtonNormalDerivative
open Source29NewtonRootConstant Source29NewtonPureNormalPower

noncomputable section
variable {n : ℕ}

/-- A Newton polynomial with the prescribed half-space sign and a fixed
nonzero positive-degree normal coefficient is a pure normal power. -/
theorem eq_pure_normal_power
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) :
    N = C c * (X 0)^d :=
  eq_pure_normal_power_of_degree_ne_zero N α D hD.ne' hEuler
    (tangential_pderiv_eq_zero N α D hD hEuler hE hpos hneg d hd c hc hcoeff)
    d c hc hcoeff

/-- The same hypotheses determine all signs, parity, and the weighted degree:
the surviving normal power is positive and odd, with D = α d and α > 0. -/
theorem classification
    (N : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z N)
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z N ≤ 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) :
    N = C c * (X 0)^d ∧ 0 < c ∧ Odd d ∧ D = α * (d : ℝ) ∧ 0 < α := by
  have hN := eq_pure_normal_power N α D hD hEuler hE hpos hneg d hd c hc hcoeff
  obtain ⟨hcpos, hodd⟩ := coefficient_pos_and_degree_odd N d c hc hN hpos hneg
  have hw := weighted_degree_eq N α D hEuler
    (tangential_pderiv_eq_zero N α D hD hEuler hE hpos hneg d hd c hc hcoeff)
    d c hc hcoeff
  have hdpos : 0 < (d : ℝ) := by exact_mod_cast hd
  refine ⟨hN, hcpos, hodd, hw, ?_⟩
  nlinarith

end
end Source29NewtonPolynomialRigidity

/- Component: LocalRegularPatchDensity.inc -/
namespace Source29LocalRegularPatchDensity

open MvPolynomial MeasureTheory Filter Set
open Source29NewtonNormalDerivative
open Source29QuarticReuse.FluxPolynomial Source29QuarticReuse.FluxObstruction
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- An irreducible polynomial sharing a root with a cofactor on an open
parameter germ must divide that cofactor. No regularity of the root choice is needed. -/
theorem dvd_of_common_root_germ
    (p q : Polynomial (MvPolynomial (Fin n) ℝ)) (hp : Irreducible p)
    (hdeg : p.natDegree ≠ 0) (a : Fin n → ℝ) (g : (Fin n → ℝ) → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a,
      (p.map (eval y)).eval (g y) = 0 ∧ (q.map (eval y)).eval (g y) = 0) : p ∣ q := by
  by_contra hnd
  obtain ⟨D, A, B, hD, hcert⟩ := Source29RealSliceBezout.exists_coprime_certificate
    (FractionRing (MvPolynomial (Fin n) ℝ)) p q hp hdeg hnd
  obtain ⟨U, hUsub, hUopen, haU⟩ := mem_nhds_iff.mp hroot
  have hUpos : 0 < volume U := hUopen.measure_pos volume ⟨a, haU⟩
  obtain ⟨y, hyU, hyD⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hUpos.ne'
    (ae_restrict_of_ae (mvPolynomial_eval_ne_zero_ae n D hD))
  have hy := hUsub hyU
  exact (Source29RealSliceBezout.cofactor_ne_zero_of_certificate p q D A B hcert
    (eval y) hyD (g y) hy.1) hy.2

/-- A nonzero normal derivative forces positive degree in the normal variable. -/
theorem normal_natDegree_ne_zero (P : MvPolynomial (Fin (n + 1)) ℝ)
    (z : Fin (n + 1) → ℝ) (hn : eval z (pderiv 0 P) ≠ 0) :
    (finSuccEquiv ℝ n P).natDegree ≠ 0 := by
  intro hd
  let a : Fin n → ℝ := fun i ↦ z i.succ
  have hzcons : (Fin.cons (z 0) a : Fin (n + 1) → ℝ) = z := by
    funext i
    exact Fin.cases rfl (fun _ ↦ rfl) i
  have hslice : sliceHom a P = Polynomial.C (eval a ((finSuccEquiv ℝ n P).coeff 0)) := by
    change Polynomial.map (eval a) (finSuccEquiv ℝ n P) = _
    rw [Polynomial.eq_C_of_natDegree_eq_zero hd, Polynomial.map_C]
    simp
  apply hn
  rw [← hzcons, ← eval_sliceHom, sliceHom_pderiv_zero, hslice]
  simp

/-- Common vanishing on a local graph forces divisibility. -/
theorem dvd_of_common_graph_germ
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P)
    (z : Fin (n + 1) → ℝ) (hn : eval z (pderiv 0 P) ≠ 0)
    (a : Fin n → ℝ) (g : (Fin n → ℝ) → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0 ∧
      eval (Fin.cons (g y) y) Q = 0) : P ∣ Q := by
  have hdvd : finSuccEquiv ℝ n P ∣ finSuccEquiv ℝ n Q := by
    apply dvd_of_common_root_germ _ _ ((MulEquiv.irreducible_iff (finSuccEquiv ℝ n)).mpr hP)
      (normal_natDegree_ne_zero P z hn) a g
    filter_upwards [hroot] with y hy
    exact ⟨(eval_sliceHom P y (g y)).trans hy.1, (eval_sliceHom Q y (g y)).trans hy.2⟩
  exact (map_dvd_iff (finSuccEquiv ℝ n).toRingEquiv).mp hdvd

/-- The restriction of a nondivisible cofactor to a local regular graph
cannot vanish as a germ. This supplies a nonzero coefficient for Newton extraction. -/
theorem restriction_not_eventually_zero
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (z : Fin (n + 1) → ℝ) (hn : eval z (pderiv 0 P) ≠ 0)
    (a : Fin n → ℝ) (g : (Fin n → ℝ) → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    ¬ ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) Q = 0 := by
  intro hQ
  exact hPQ (dvd_of_common_graph_germ P Q hP z hn a g (hroot.and hQ))

/-- A cofactor vanishing on a neighborhood of one regular real point of an
irreducible hypersurface is divisible by its defining polynomial. -/
theorem dvd_of_vanishing_on_regular_patch
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P)
    (z : Fin (n + 1) → ℝ) (hz : eval z P = 0) (hn : eval z (pderiv 0 P) ≠ 0)
    (hQ : ∀ᶠ x in 𝓝 z, eval x P = 0 → eval x Q = 0) : P ∣ Q := by
  let a : Fin n → ℝ := fun i ↦ z i.succ
  obtain ⟨g, hg, hg0, hglevel⟩ :=
    Source29RealImplicitPolynomialRoot.exists_local_level_graph P z hn
  have hzcons : (Fin.cons (z 0) a : Fin (n + 1) → ℝ) = z := by
    funext i
    exact Fin.cases rfl (fun _ ↦ rfl) i
  have hcont : ContinuousAt (fun y : Fin n → ℝ ↦ (Fin.cons (g y) y : Fin (n + 1) → ℝ)) a := by
    apply continuousAt_pi.mpr
    intro i
    exact Fin.cases hg.continuousAt (fun j ↦ (continuous_apply j).continuousAt) i
  have hnear : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0 → eval (Fin.cons (g y) y) Q = 0 := by
    have he : (Fin.cons (g a) a : Fin (n + 1) → ℝ) = z := by rw [hg0]; exact hzcons
    have ht : Tendsto (fun y : Fin n → ℝ ↦ (Fin.cons (g y) y : Fin (n + 1) → ℝ)) (𝓝 a) (𝓝 z) := by
      simpa only [he] using hcont.tendsto
    exact ht.eventually hQ
  apply dvd_of_common_graph_germ P Q hP z hn a g
  filter_upwards [hglevel, hnear] with y hy hqy
  have hp : eval (Fin.cons (g y) y) P = 0 := hy.trans hz
  exact ⟨hp, hqy hp⟩

/-- A nondivisible cofactor is nonzero arbitrarily close to every regular
real point along the irreducible hypersurface. -/
theorem frequently_nonzero_on_regular_patch
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (z : Fin (n + 1) → ℝ) (hz : eval z P = 0) (hn : eval z (pderiv 0 P) ≠ 0) :
    ∃ᶠ x in 𝓝 z, eval x P = 0 ∧ eval x Q ≠ 0 := by
  by_contra h
  have he : ∀ᶠ x in 𝓝 z, eval x P = 0 → eval x Q = 0 := by
    simpa only [Filter.not_frequently, not_and, not_not] using h
  exact hPQ (dvd_of_vanishing_on_regular_patch P Q hP z hz hn he)

end
end Source29LocalRegularPatchDensity

/- Component: LevelRadialDefect.inc -/
namespace Source29LevelRadialDefect

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits
open Source29PolynomialStress Source29LevelStressStationarity Source29LevelRadialStress
open Source29WeightedRadialDerivative Source29LevelRadialMonotonicity

noncomputable section
variable {n : ℕ}

/-- The exact radial defect for a smooth level weight. -/
def radialDefect (P : MvPolynomial (Fin n) ℝ) (h f : ℝ → ℝ) (r : ℝ)
    (x : Fin n → ℝ) : ℝ :=
  (-2/r^2) * deriv f (radiusSq x/r^2) *
    (Source29NormalPenalty.dot (leadingNormalizedField P x) x)^2 * diffuseWeight P h x

/-- This identity holds at critical points too; no regularity of the normalized
field there is needed. -/
theorem radialDefect_identity (P : MvPolynomial (Fin (n+1)) ℝ)
    (h : ℝ → ℝ) {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : r ≠ 0)
    (x : Fin (n+1) → ℝ) :
    r * densityDeriv (diffuseWeight P h) f r x -
      (n : ℝ) * density (diffuseWeight P h) f r x +
      h (eval x P) * stressPair P (radialField f r) x = radialDefect P h f r x := by
  rw [stressPair_radial P hf]
  unfold radialDefect densityDeriv density diffuseWeight Source29LevelRadialStress.radialWeight
  field_simp
  ring

/-- Integrability follows from the exact identity and compactly supported stress,
without asserting continuity of the normalized field on the critical set. -/
theorem radialDefect_integrable (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    Integrable (radialDefect P h f r) := by
  have hw := diffuseWeight_continuous P hh.continuous
  have hd := (mass_hasDerivAt hw hf hR hr hz hdz).1
  have hi := density_integrable hw hf.continuous hR hr hz
  have hs := weighted_stress_integral_zero P hcal (radialField f r)
    (radialField_contDiff hf r) (radialField_compact hR hr hz) hh
  have he : radialDefect P h f r = (fun x ↦
      r * densityDeriv (diffuseWeight P h) f r x -
        (n : ℝ) * density (diffuseWeight P h) f r x +
        h (eval x P) * stressPair P (radialField f r) x) :=
    funext (fun x ↦ (radialDefect_identity P h hf hr.ne' x).symm)
  rw [he]
  exact ((hd.const_mul r).sub (hi.const_mul (n : ℝ))).add hs.1

/-- Radial stationarity identifies the entire radius numerator with the defect. -/
theorem radius_numerator_eq_integral (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    r * (∫ x, densityDeriv (diffuseWeight P h) f r x) -
      (n : ℝ) * mass (diffuseWeight P h) f r = ∫ x, radialDefect P h f r x := by
  have hw := diffuseWeight_continuous P hh.continuous
  have hd := (mass_hasDerivAt hw hf hR hr hz hdz).1
  have hi := density_integrable hw hf.continuous hR hr hz
  have hs := weighted_stress_integral_zero P hcal (radialField f r)
    (radialField_contDiff hf r) (radialField_compact hR hr hz) hh
  have he : (∫ x, r * densityDeriv (diffuseWeight P h) f r x -
        (n : ℝ) * density (diffuseWeight P h) f r x +
        h (eval x P) * stressPair P (radialField f r) x) =
      ∫ x, radialDefect P h f r x := by
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (radialDefect_identity P h hf hr.ne')
  have hadd := integral_add ((hd.const_mul r).sub (hi.const_mul (n : ℝ))) hs.1
  simp only [Pi.sub_apply] at hadd
  rw [hadd, integral_sub (hd.const_mul r) (hi.const_mul (n : ℝ)),
    integral_const_mul, integral_const_mul, hs.2, add_zero] at he
  exact he

/-- The exact derivative of normalized diffuse mass retains the radial defect. -/
theorem normalizedDiffuseMass_hasDerivAt (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    HasDerivAt (normalizedDiffuseMass P h f)
      ((∫ x, radialDefect P h f r x) / r^(n+1)) r := by
  have hd := Source29GraphMassMonotonicity.normalized_hasDerivAt
    (mass_hasDerivAt (diffuseWeight_continuous P hh.continuous) hf hR hr hz hdz).2 hr.ne' n
  rw [radius_numerator_eq_integral P hcal hh hf hR hr hz hdz] at hd
  exact hd

theorem radialDefect_nonneg (P : MvPolynomial (Fin n) ℝ)
    (h f : ℝ → ℝ) (hhpos : ∀ t, 0 ≤ h t) (hdec : ∀ t, deriv f t ≤ 0)
    (r : ℝ) (x : Fin n → ℝ) : 0 ≤ radialDefect P h f r x := by
  have hwp : 0 ≤ diffuseWeight P h x := mul_nonneg (hhpos _) (Real.sqrt_nonneg _)
  exact mul_nonneg (mul_nonneg (mul_nonneg_of_nonpos_of_nonpos
    (div_nonpos_of_nonpos_of_nonneg (by norm_num) (sq_nonneg r)) (hdec _)) (sq_nonneg _)) hwp

theorem integral_radialDefect_nonneg (P : MvPolynomial (Fin n) ℝ)
    (h f : ℝ → ℝ) (hhpos : ∀ t, 0 ≤ h t) (hdec : ∀ t, deriv f t ≤ 0) (r : ℝ) :
    0 ≤ ∫ x, radialDefect P h f r x :=
  integral_nonneg (radialDefect_nonneg P h f hhpos hdec r)

end
end Source29LevelRadialDefect

/- Component: NewtonShiftedFactorCoefficient.inc -/
namespace Source29NewtonShiftedFactorCoefficient

open MvPolynomial Filter
open scoped Topology

noncomputable section

/-- The first possible coefficient of a power of a polynomial with zero
constant term, multiplied by a cofactor. -/
theorem coeff_pow_mul_of_coeff_zero {R : Type*} [CommSemiring R]
    (p q : Polynomial R) (k : ℕ) (hp : p.coeff 0 = 0) :
    (p^k*q).coeff k = (p.coeff 1)^k * q.coeff 0 := by
  obtain ⟨r, rfl⟩ := Polynomial.X_dvd_iff.mpr hp
  rw [mul_pow, mul_assoc]
  have he := Polynomial.coeff_X_pow_mul (r^k*q) k 0
  simpa only [zero_add, Polynomial.coeff_X_mul, Polynomial.coeff_zero_eq_eval_zero,
    Polynomial.eval_mul, Polynomial.eval_pow] using he

/-- Every lower coefficient vanishes in the same factorization. -/
theorem coeff_pow_mul_eq_zero_of_lt {R : Type*} [CommSemiring R]
    (p q : Polynomial R) (k : ℕ) (hp : p.coeff 0 = 0)
    (j : ℕ) (hj : j < k) : (p^k*q).coeff j = 0 := by
  obtain ⟨r, rfl⟩ := Polynomial.X_dvd_iff.mpr hp
  rw [mul_pow, mul_assoc, Polynomial.coeff_X_pow_mul', ite_eq_right (not_le_of_gt hj)]


open Source29NewtonNormalDerivative

variable {n : ℕ}

/-- Translate the normal variable after fixing all tangential coordinates. -/
def shiftedSlice (F : MvPolynomial (Fin (n + 1)) ℝ)
    (s : ℝ) (y : Fin n → ℝ) : Polynomial ℝ :=
  Polynomial.taylor s (sliceHom y F)

theorem eval_shiftedSlice (F : MvPolynomial (Fin (n + 1)) ℝ)
    (s x : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).eval x = eval (Fin.cons (s + x) y) F := by
  rw [shiftedSlice, Polynomial.taylor_eval, eval_sliceHom, add_comm x s]

theorem shiftedSlice_coeff_zero (F : MvPolynomial (Fin (n + 1)) ℝ)
    (s : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).coeff 0 = eval (Fin.cons s y) F := by
  rw [shiftedSlice, Polynomial.taylor_coeff_zero, eval_sliceHom]

theorem shiftedSlice_coeff_one (F : MvPolynomial (Fin (n + 1)) ℝ)
    (s : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).coeff 1 = eval (Fin.cons s y) (pderiv 0 F) := by
  rw [shiftedSlice, Polynomial.taylor_coeff_one, ← sliceHom_pderiv_zero, eval_sliceHom]

theorem shiftedSlice_factor (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (s : ℝ) (y : Fin n → ℝ) :
    shiftedSlice F s y = (shiftedSlice P s y)^k * shiftedSlice Q s y := by
  simp only [shiftedSlice, hF, map_mul, map_pow, Polynomial.taylor_mul, Polynomial.taylor_pow]

/-- The coefficient at the factor multiplicity is the normal derivative to
that power times the restricted cofactor. Simplicity is not needed for the identity. -/
theorem coeff_shifted_factor (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (s : ℝ) (y : Fin n → ℝ)
    (hP : eval (Fin.cons s y) P = 0) :
    (shiftedSlice F s y).coeff k =
      (eval (Fin.cons s y) (pderiv 0 P))^k * eval (Fin.cons s y) Q := by
  rw [shiftedSlice_factor F P Q k hF s y,
    coeff_pow_mul_of_coeff_zero _ _ k (by rw [shiftedSlice_coeff_zero, hP]),
    shiftedSlice_coeff_one, shiftedSlice_coeff_zero]

theorem coeff_shifted_factor_eq_zero_of_lt (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (s : ℝ) (y : Fin n → ℝ)
    (hP : eval (Fin.cons s y) P = 0) (j : ℕ) (hj : j < k) :
    (shiftedSlice F s y).coeff j = 0 := by
  rw [shiftedSlice_factor F P Q k hF s y]
  exact coeff_pow_mul_eq_zero_of_lt _ _ k (by rw [shiftedSlice_coeff_zero, hP]) j hj

theorem eventually_coeff_shifted_factor (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff k =
      (eval (Fin.cons (g y) y) (pderiv 0 P))^k * eval (Fin.cons (g y) y) Q :=
  hroot.mono fun y hy => coeff_shifted_factor F P Q k hF (g y) y hy

theorem eventually_lower_coefficients_zero (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    ∀ᶠ y in 𝓝 a, ∀ j < k, (shiftedSlice F (g y) y).coeff j = 0 :=
  hroot.mono fun y hy j hj => coeff_shifted_factor_eq_zero_of_lt F P Q k hF (g y) y hy j hj

/-- The first possible coefficient is a nonzero germ on a regular branch
of an irreducible factor. The cofactor may vanish at the base point. -/
theorem coefficient_not_eventually_zero (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : ContinuousAt g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0) :
    ¬ ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff k = 0 := by
  have hgraph : ContinuousAt (fun y : Fin n → ℝ =>
      (Fin.cons (g y) y : Fin (n + 1) → ℝ)) a := by
    apply continuousAt_pi.mpr
    intro i
    exact Fin.cases hg (fun j => (continuous_apply j).continuousAt) i
  have hreg : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) (pderiv 0 P) ≠ 0 :=
    ((Source29PolynomialLinkChart.analyticAt_eval_real (pderiv 0 P) _).continuousAt.comp hgraph).eventually_ne hn
  intro hz
  apply Source29LocalRegularPatchDensity.restriction_not_eventually_zero
    P Q hP hPQ (Fin.cons (g a) a) hn a g hroot
  filter_upwards [hz, eventually_coeff_shifted_factor F P Q k hF g a hroot, hreg] with y hy he hn'
  rw [he] at hy
  exact (mul_eq_zero.mp hy).resolve_left (pow_ne_zero k hn')

/-- On an analytic branch the first possible coefficient is analytic, as
needed to extract a finite Taylor order from its nonzero germ. -/
theorem analyticAt_shifted_coefficient (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    AnalyticAt ℝ (fun y => (shiftedSlice F (g y) y).coeff k) a := by
  have hgraph : AnalyticAt ℝ (fun y : Fin n → ℝ =>
      (Fin.cons (g y) y : Fin (n + 1) → ℝ)) a := by
    apply AnalyticAt.pi
    intro i
    exact Fin.cases hg (fun j =>
      (ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ).analyticAt a) i
  have hp := (Source29PolynomialLinkChart.analyticAt_eval_real (pderiv 0 P) _).comp hgraph
  have hq := (Source29PolynomialLinkChart.analyticAt_eval_real Q _).comp hgraph
  apply ((hp.pow k).mul hq).congr
  filter_upwards [eventually_coeff_shifted_factor F P Q k hF g a hroot] with y hy
  exact hy.symm

end
end Source29NewtonShiftedFactorCoefficient

/- Component: NormalShiftAlgebra.inc -/
namespace Source29NormalShiftAlgebra

open scoped BigOperators

noncomputable section
variable {ι R : Type*} [Fintype ι] [CommRing R]

def dot (v w : ι → R) : R := ∑ i, v i * w i
def trace (H : ι → ι → R) : R := ∑ i, H i i
def bilinear (H : ι → ι → R) (v w : ι → R) : R := ∑ i, ∑ j, H i j * v i * w j

def traceComplement (H : ι → ι → R) (v w : ι → R) : R :=
  dot v w * trace H - bilinear H v w

lemma dot_comm (v w : ι → R) : dot v w = dot w v := by
  unfold dot
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma dot_sub_left (v w u : ι → R) :
    dot (fun i ↦ v i - w i) u = dot v u - dot w u := by
  simp only [dot, sub_mul, Finset.sum_sub_distrib]

lemma dot_sub_right (v w u : ι → R) :
    dot u (fun i ↦ v i - w i) = dot u v - dot u w := by
  simp only [dot, mul_sub, Finset.sum_sub_distrib]

lemma dot_mul_left (c : R) (v w : ι → R) :
    dot (fun i ↦ c * v i) w = c * dot v w := by
  simp only [dot, mul_assoc, Finset.mul_sum]

lemma dot_mul_right (c : R) (v w : ι → R) :
    dot v (fun i ↦ c * w i) = c * dot v w := by
  rw [dot_comm, dot_mul_left, dot_comm w v]

lemma trace_sub (H K : ι → ι → R) :
    trace (fun i j ↦ H i j - K i j) = trace H - trace K := by
  simp only [trace, Finset.sum_sub_distrib]

lemma trace_add (H K : ι → ι → R) :
    trace (fun i j ↦ H i j + K i j) = trace H + trace K := by
  simp only [trace, Finset.sum_add_distrib]

lemma trace_mul (c : R) (H : ι → ι → R) :
    trace (fun i j ↦ c * H i j) = c * trace H := by
  simp only [trace, Finset.mul_sum]

lemma trace_rank_one (v w : ι → R) : trace (fun i j ↦ v i * w j) = dot v w := rfl

lemma bilinear_sub_matrix (H K : ι → ι → R) (v w : ι → R) :
    bilinear (fun i j ↦ H i j - K i j) v w = bilinear H v w - bilinear K v w := by
  simp only [bilinear, sub_mul, Finset.sum_sub_distrib]

lemma bilinear_add_matrix (H K : ι → ι → R) (v w : ι → R) :
    bilinear (fun i j ↦ H i j + K i j) v w = bilinear H v w + bilinear K v w := by
  simp only [bilinear, add_mul, Finset.sum_add_distrib]

lemma bilinear_mul_matrix (c : R) (H : ι → ι → R) (v w : ι → R) :
    bilinear (fun i j ↦ c * H i j) v w = c * bilinear H v w := by
  simp only [bilinear, mul_assoc, Finset.mul_sum]

lemma bilinear_sub_left (H : ι → ι → R) (v w u : ι → R) :
    bilinear H (fun i ↦ v i - w i) u = bilinear H v u - bilinear H w u := by
  simp only [bilinear, mul_sub, sub_mul, Finset.sum_sub_distrib]

lemma bilinear_sub_right (H : ι → ι → R) (v w u : ι → R) :
    bilinear H u (fun i ↦ v i - w i) = bilinear H u v - bilinear H u w := by
  simp only [bilinear, mul_sub, Finset.sum_sub_distrib]

lemma bilinear_mul_left (H : ι → ι → R) (c : R) (v w : ι → R) :
    bilinear H (fun i ↦ c * v i) w = c * bilinear H v w := by
  simp only [bilinear, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

lemma bilinear_mul_right (H : ι → ι → R) (c : R) (v w : ι → R) :
    bilinear H v (fun i ↦ c * w i) = c * bilinear H v w := by
  simp only [bilinear, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

lemma bilinear_rank_one (a b v w : ι → R) :
    bilinear (fun i j ↦ a i * b j) v w = dot a v * dot b w := by
  calc
    _ = ∑ i, (a i * v i) * (∑ j, b j * w j) := by
      apply Finset.sum_congr rfl
      intro i _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = _ := by rw [← Finset.sum_mul]; rfl

/-- Tangential Hessian block after the coordinate change z=x+g(y). -/
def shiftedHessian (A S : R) (T a : ι → R) (U G : ι → ι → R) (i j : ι) : R :=
  U i j - T i * a j - a i * T j + S * (a i * a j) - A * G i j

lemma trace_shiftedHessian (A S : R) (T a : ι → R) (U G : ι → ι → R) :
    trace (shiftedHessian A S T a U G) =
      trace U - 2 * dot a T + S * dot a a - A * trace G := by
  change trace (fun i j ↦ U i j - T i * a j - a i * T j + S * (a i * a j) - A * G i j) = _
  rw [trace_sub, trace_add, trace_sub, trace_sub, trace_mul, trace_mul,
    trace_rank_one, trace_rank_one, trace_rank_one]
  rw [dot_comm T a]
  ring

lemma bilinear_shiftedHessian (A S : R) (T a : ι → R) (U G : ι → ι → R) (v : ι → R) :
    bilinear (shiftedHessian A S T a U G) v v =
      bilinear U v v - 2 * dot T v * dot a v + S * (dot a v)^2 - A * bilinear G v v := by
  change bilinear (fun i j ↦ U i j - T i * a j - a i * T j + S * (a i * a j) - A * G i j) v v = _
  rw [bilinear_sub_matrix, bilinear_add_matrix, bilinear_sub_matrix, bilinear_sub_matrix,
    bilinear_mul_matrix, bilinear_mul_matrix, bilinear_rank_one, bilinear_rank_one, bilinear_rank_one]
  ring

/-- Cubic level operator, written in its normal and tangential blocks. -/
def shiftedLevelOperator (A S : R) (B T a : ι → R) (U G : ι → ι → R) : R :=
  let C := fun i ↦ B i - A * a i
  let H := shiftedHessian A S T a U G
  (A^2 + dot C C) * (S + trace H) -
    (A^2 * S + 2 * A * dot C (fun i ↦ T i - S * a i) + bilinear H C C)

def newtonResidual (A S : R) (B T : ι → R) (U : ι → ι → R) : R :=
  A^2 * trace U - 2 * A * dot B T + S * dot B B

def backgroundGraphOperator (a : ι → R) (G : ι → ι → R) : R :=
  (1 + dot a a) * trace G - bilinear G a a

/-- Every correction term is displayed explicitly; no symmetry hypotheses on
U or G and no analytic scaling assertion are used. -/
def correction (A S : R) (B T a : ι → R) (U G : ι → ι → R) : R :=
  traceComplement U B B - A * (traceComplement U B a + traceComplement U a B) +
    A^2 * traceComplement U a a + S * (dot a a * dot B B - (dot a B)^2) +
    2 * (dot a B * dot B T - dot B B * dot a T) -
    2 * A * (dot a a * dot B T - dot a B * dot a T) -
    A * traceComplement G B B + A^2 * (traceComplement G B a + traceComplement G a B)

/-- Exact nonlinear normal-shift formula. The background term has the negative
sign dictated by z=x+g(y); the remaining terms are the Newton residual plus
explicit corrections. -/
theorem normal_shift_identity (A S : R) (B T a : ι → R) (U G : ι → ι → R) :
    shiftedLevelOperator A S B T a U G =
      newtonResidual A S B T U - A^3 * backgroundGraphOperator a G + correction A S B T a U G := by
  dsimp only [shiftedLevelOperator]
  rw [trace_shiftedHessian, bilinear_shiftedHessian]
  simp only [dot_sub_left, dot_sub_right, dot_mul_left, dot_mul_right,
    bilinear_sub_left, bilinear_sub_right, bilinear_mul_left, bilinear_mul_right]
  unfold newtonResidual backgroundGraphOperator correction traceComplement
  rw [dot_comm B a, dot_comm T a, dot_comm T B]
  ring

/-- The cubic level operator |v|² tr(H)−H(v,v), with its finite sums exposed. -/
def cubicLevel (v : ι → R) (H : ι → ι → R) : R :=
  dot v v * trace H - bilinear H v v

def blockHessian {n : ℕ} (S : R) (D : Fin n → R) (H : Fin n → Fin n → R) :
    Fin (n+1) → Fin (n+1) → R :=
  Fin.cons (Fin.cons S D) (fun i ↦ Fin.cons (D i) (H i))

lemma cubicLevel_blocks {n : ℕ} (A S : R) (C D : Fin n → R) (H : Fin n → Fin n → R) :
    cubicLevel (Fin.cons A C) (blockHessian S D H) =
      (A^2 + dot C C) * (S + trace H) -
        (A^2 * S + 2 * A * dot C D + bilinear H C C) := by
  have hv : dot (Fin.cons A C) (Fin.cons A C) = A^2 + dot C C := by
    simp only [dot, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ, pow_two]
  have ht : trace (blockHessian S D H) = S + trace H := by
    simp only [trace, blockHessian, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
  have hleft : (∑ i, D i * A * C i) = A * dot C D := by
    rw [dot, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hright : (∑ i, D i * C i * A) = A * dot C D := by
    rw [dot, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hq : bilinear (blockHessian S D H) (Fin.cons A C) (Fin.cons A C) =
      A^2 * S + 2 * A * dot C D + bilinear H C C := by
    simp only [bilinear, blockHessian, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      Finset.sum_add_distrib]
    rw [hleft, hright]
    ring
  rw [cubicLevel, hv, ht, hq]

/-- The full ambient gradient after z=x+g(y). -/
def ambientGradient {n : ℕ} (A : R) (B a : Fin n → R) : Fin (n+1) → R :=
  Fin.cons A (fun i ↦ B i - A * a i)

/-- The full ambient Hessian after z=x+g(y). -/
def ambientHessian {n : ℕ} (A S : R) (T a : Fin n → R) (U G : Fin n → Fin n → R) :
    Fin (n+1) → Fin (n+1) → R :=
  blockHessian S (fun i ↦ T i - S * a i) (shiftedHessian A S T a U G)

/-- The exact identity for the full finite-dimensional gradient/Hessian arrays. -/
theorem cubicLevel_normal_shift {n : ℕ} (A S : R) (B T a : Fin n → R)
    (U G : Fin n → Fin n → R) :
    cubicLevel (ambientGradient A B a) (ambientHessian A S T a U G) =
      newtonResidual A S B T U - A^3 * backgroundGraphOperator a G + correction A S B T a U G := by
  change cubicLevel (Fin.cons A (fun i ↦ B i - A * a i))
    (blockHessian S (fun i ↦ T i - S * a i) (shiftedHessian A S T a U G)) = _
  rw [cubicLevel_blocks]
  exact normal_shift_identity A S B T a U G

end
end Source29NormalShiftAlgebra

/- Component: AnalyticInitialOrder.inc -/
namespace Source29AnalyticInitialOrder

open Filter
open scoped Topology

noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- If every diagonal term of a convergent power series vanishes, its
represented function vanishes in a neighborhood of its center. -/
theorem eventually_zero_of_diagonal_zero {f : E → ℝ}
    {p : FormalMultilinearSeries ℝ E ℝ} {a : E}
    (hp : HasFPowerSeriesAt f p a)
    (hz : ∀ k (y : E), p k (fun _ ↦ y) = 0) :
    ∀ᶠ x in 𝓝 a, f x = 0 := by
  filter_upwards [hp.eventually_hasSum_sub] with x hx
  have hs : HasSum (fun _k : ℕ ↦ (0 : ℝ)) (f x) := by
    simpa only [hz] using hx
  exact hs.unique hasSum_zero

/-- Every nonzero real analytic germ has a finite first nonzero diagonal
homogeneous term. Lower diagonal terms vanish identically, not just on one ray. -/
theorem exists_first_nonzero_diagonal {f : E → ℝ} {a : E}
    (hf : AnalyticAt ℝ f a) (hne : ¬ ∀ᶠ x in 𝓝 a, f x = 0) :
    ∃ (p : FormalMultilinearSeries ℝ E ℝ) (d : ℕ),
      HasFPowerSeriesAt f p a ∧
      (∃ y : E, p d (fun _ ↦ y) ≠ 0) ∧
      (∀ k < d, ∀ y : E, p k (fun _ ↦ y) = 0) := by
  classical
  obtain ⟨p, hp⟩ := hf
  have hex : ∃ d : ℕ, ∃ y : E, p d (fun _ ↦ y) ≠ 0 := by
    by_contra h
    push Not at h
    exact hne (eventually_zero_of_diagonal_zero hp h)
  refine ⟨p, Nat.find hex, hp, Nat.find_spec hex, ?_⟩
  intro k hk y
  by_contra hy
  exact (Nat.find_min hex hk) ⟨y, hy⟩

/-- At a zero of a nonzero analytic germ, its first nonzero diagonal term
has strictly positive degree. -/
theorem exists_positive_first_nonzero_diagonal {f : E → ℝ} {a : E}
    (hf : AnalyticAt ℝ f a) (hne : ¬ ∀ᶠ x in 𝓝 a, f x = 0) (hz : f a = 0) :
    ∃ (p : FormalMultilinearSeries ℝ E ℝ) (d : ℕ),
      HasFPowerSeriesAt f p a ∧ 0 < d ∧
      (∃ y : E, p d (fun _ ↦ y) ≠ 0) ∧
      (∀ k < d, ∀ y : E, p k (fun _ ↦ y) = 0) := by
  obtain ⟨p, d, hp, hd, hlow⟩ := exists_first_nonzero_diagonal hf hne
  refine ⟨p, d, hp, ?_, hd, hlow⟩
  by_contra h
  have hd0 : d = 0 := Nat.eq_zero_of_not_pos h
  obtain ⟨y, hy⟩ := hd
  subst d
  exact hy ((hp.coeff_zero (fun _ ↦ y)).trans hz)

end
end Source29AnalyticInitialOrder

/- Component: MultilinearDiagonalPolynomial.inc -/
namespace Source29MultilinearDiagonalPolynomial

open MvPolynomial
open scoped BigOperators

noncomputable section
variable {m n : ℕ}

/-- The coordinate polynomial representing the diagonal of a multilinear form. -/
def diagonalPolynomial
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ) :
    MvPolynomial (Fin n) ℝ :=
  ∑ s : Fin m → Fin n,
    C (L (fun j => Pi.single (s j) 1)) * ∏ j : Fin m, X (s j)

/-- Expand each argument in the standard coordinate basis. No symmetry of
L is required to represent its diagonal. -/
theorem diagonal_expansion
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ)
    (x : Fin n → ℝ) :
    L (fun _ => x) = ∑ s : Fin m → Fin n,
      L (fun j => Pi.single (s j) 1) * ∏ j : Fin m, x (s j) := by
  classical
  calc
    L (fun _ => x) = L (fun _ : Fin m => ∑ i : Fin n, x i • Pi.single i 1) := by
      congr 1
      funext j
      exact pi_eq_sum_univ' x
    _ = ∑ s : Fin m → Fin n, L (fun j => x (s j) • Pi.single (s j) 1) :=
      L.map_sum (fun (_ : Fin m) (i : Fin n) => x i • Pi.single i 1)
    _ = _ := by
      apply Finset.sum_congr rfl
      intro s _
      rw [L.map_smul_univ]
      exact mul_comm _ _

theorem eval_diagonalPolynomial
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ)
    (x : Fin n → ℝ) : eval x (diagonalPolynomial L) = L (fun _ => x) := by
  classical
  simp only [diagonalPolynomial, map_sum, map_mul, map_prod, eval_C, eval_X]
  exact (diagonal_expansion L x).symm

theorem diagonalPolynomial_isHomogeneous
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ) :
    (diagonalPolynomial L).IsHomogeneous m := by
  classical
  unfold diagonalPolynomial
  apply IsHomogeneous.sum
  intro s _
  have hprod : (∏ j : Fin m, (X (s j) : MvPolynomial (Fin n) ℝ)).IsHomogeneous m := by
    simpa using IsHomogeneous.prod Finset.univ
      (fun j : Fin m => (X (s j) : MvPolynomial (Fin n) ℝ)) (fun _ => 1)
      (fun j _ => isHomogeneous_X ℝ (s j))
  exact hprod.C_mul _

theorem diagonalPolynomial_ne_zero
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ)
    (x : Fin n → ℝ) (hx : L (fun _ => x) ≠ 0) : diagonalPolynomial L ≠ 0 := by
  intro hz
  have he := eval_diagonalPolynomial L x
  rw [hz, map_zero] at he
  exact hx he.symm

/-- A nonzero diagonal value supplies a nonzero homogeneous polynomial
representative of the full diagonal function. -/
theorem exists_diagonalPolynomial
    (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin n → ℝ) ℝ)
    (hx : ∃ x : Fin n → ℝ, L (fun _ => x) ≠ 0) :
    ∃ P : MvPolynomial (Fin n) ℝ,
      P ≠ 0 ∧ P.IsHomogeneous m ∧ ∀ x, eval x P = L (fun _ => x) := by
  obtain ⟨x, hx⟩ := hx
  exact ⟨diagonalPolynomial L, diagonalPolynomial_ne_zero L x hx,
    diagonalPolynomial_isHomogeneous L, eval_diagonalPolynomial L⟩

end
end Source29MultilinearDiagonalPolynomial

/- Component: AnalyticInitialPolynomial.inc -/
namespace Source29AnalyticInitialPolynomial

open MvPolynomial Filter
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A nonzero analytic germ has a nonzero homogeneous polynomial as its first
Taylor term, with all lower diagonal terms identically zero. -/
theorem exists_homogeneous_initial_term {f : (Fin n → ℝ) → ℝ} {a : Fin n → ℝ}
    (hf : AnalyticAt ℝ f a) (hne : ¬ ∀ᶠ x in 𝓝 a, f x = 0) :
    ∃ (p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ) (d : ℕ)
      (H : MvPolynomial (Fin n) ℝ),
      HasFPowerSeriesAt f p a ∧ H ≠ 0 ∧ H.IsHomogeneous d ∧
      (∀ x, eval x H = p d (fun _ ↦ x)) ∧
      (∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) := by
  obtain ⟨p,d,hp,hd,hlow⟩ := Source29AnalyticInitialOrder.exists_first_nonzero_diagonal hf hne
  obtain ⟨H,hH,hhom,heval⟩ := Source29MultilinearDiagonalPolynomial.exists_diagonalPolynomial (p d) hd
  exact ⟨p,d,H,hp,hH,hhom,heval,hlow⟩

/-- If the germ vanishes at the center, the first homogeneous polynomial
has positive degree. -/
theorem exists_positive_homogeneous_initial_term {f : (Fin n → ℝ) → ℝ} {a : Fin n → ℝ}
    (hf : AnalyticAt ℝ f a) (hne : ¬ ∀ᶠ x in 𝓝 a, f x = 0) (hz : f a = 0) :
    ∃ (p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ) (d : ℕ)
      (H : MvPolynomial (Fin n) ℝ),
      HasFPowerSeriesAt f p a ∧ 0 < d ∧ H ≠ 0 ∧ H.IsHomogeneous d ∧
      (∀ x, eval x H = p d (fun _ ↦ x)) ∧
      (∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) := by
  obtain ⟨p,d,hp,hpos,hd,hlow⟩ :=
    Source29AnalyticInitialOrder.exists_positive_first_nonzero_diagonal hf hne hz
  obtain ⟨H,hH,hhom,heval⟩ := Source29MultilinearDiagonalPolynomial.exists_diagonalPolynomial (p d) hd
  exact ⟨p,d,H,hp,hpos,hH,hhom,heval,hlow⟩

/-- At a regular branch of a full-multiplicity factor, the first normal
coefficient has a finite nonzero homogeneous tangential Taylor term. -/
theorem exists_shifted_factor_initial_term (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hF : F = P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0) :
    ∃ (p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ) (d : ℕ)
      (H : MvPolynomial (Fin n) ℝ),
      HasFPowerSeriesAt (fun y ↦ (Source29NewtonShiftedFactorCoefficient.shiftedSlice F (g y) y).coeff k) p a ∧
      H ≠ 0 ∧ H.IsHomogeneous d ∧
      (∀ x, eval x H = p d (fun _ ↦ x)) ∧
      (∀ j < d, ∀ x, p j (fun _ ↦ x) = 0) := by
  exact exists_homogeneous_initial_term
    (Source29NewtonShiftedFactorCoefficient.analyticAt_shifted_coefficient F P Q k hF g a hg hroot)
    (Source29NewtonShiftedFactorCoefficient.coefficient_not_eventually_zero
      F P Q k hF hP hPQ g a hg.continuousAt hroot hn)

end
end Source29AnalyticInitialPolynomial

/- Component: AnalyticInitialRemainder.inc -/
namespace Source29AnalyticInitialRemainder

open Filter Asymptotics
open scoped Topology

noncomputable section
variable {E V : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

lemma partialSum_eq_initial (p : FormalMultilinearSeries ℝ E V) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) (y : E) :
    p.partialSum (d+1) y = p d (fun _ ↦ y) := by
  rw [FormalMultilinearSeries.partialSum, Finset.sum_range_succ]
  have hz : (∑ k ∈ Finset.range d, p k (fun _ ↦ y)) = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    exact hlow k (Finset.mem_range.mp hk) y
  rw [hz, zero_add]

/-- The remainder after the first nonzero diagonal term has one higher
order, on a full neighborhood of the origin. -/
theorem remainder_isBigO {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) :
    (fun y ↦ f (a+y) - p d (fun _ ↦ y)) =O[𝓝 0] (fun y : E ↦ ‖y‖^(d+1)) := by
  simpa only [partialSum_eq_initial p d hlow] using hp.isBigO_sub_partialSum_pow (d+1)

theorem remainder_isLittleO {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) :
    (fun y ↦ f (a+y) - p d (fun _ ↦ y)) =o[𝓝 0] (fun y : E ↦ ‖y‖^d) :=
  (remainder_isBigO hp d hlow).trans_isLittleO (isLittleO_norm_pow_norm_pow (Nat.lt_succ_self d))

lemma diagonal_smul (p : FormalMultilinearSeries ℝ E V) (d : ℕ) (t : ℝ) (x : E) :
    p d (fun _ ↦ t • x) = t^d • p d (fun _ ↦ x) := by
  rw [ContinuousMultilinearMap.map_smul_univ]
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]


end
end Source29AnalyticInitialRemainder

/- Component: HomogeneousRescalingLimit.inc -/
namespace Source29HomogeneousRescalingLimit

open Filter Asymptotics Set
open scoped Topology

noncomputable section
variable {E V : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- A norm estimate for a higher-order remainder gives an explicit uniform
estimate for the normalized function on bounded sets of directions. -/
theorem exists_uniform_scaled_bound {f q : E → V} {a : E} (d : ℕ)
    (hrem : (fun y ↦ f (a+y) - q y) =O[𝓝 0] (fun y : E ↦ ‖y‖^(d+1)))
    (hq : ∀ (t : ℝ), 0 < t → ∀ x, q (t•x) = t^d • q x) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (M t : ℝ) (x : E),
      0 ≤ M → 0 < t → ‖x‖ ≤ M → t*M < δ →
      ‖(t^d)⁻¹ • f (a+t•x) - q x‖ ≤ C*t*M^(d+1) := by
  obtain ⟨K, hK⟩ := hrem.bound
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.mp hK
  refine ⟨|K|+1, δ, by positivity, hδ, ?_⟩
  intro M t x hM ht hx hsmall
  have htx : ‖t • x‖ ≤ t*M := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
    exact mul_le_mul_of_nonneg_left hx ht.le
  have hb := hball (show t•x ∈ Metric.ball (0 : E) δ from by
    simpa only [Metric.mem_ball, dist_zero_right] using lt_of_le_of_lt htx hsmall)
  change ‖f (a+t•x) - q (t•x)‖ ≤ K * ‖‖t•x‖^(d+1)‖ at hb
  have hpow : ‖t•x‖^(d+1) ≤ (t*M)^(d+1) := pow_le_pow_left₀ (norm_nonneg _) htx _
  have hbnd : ‖f (a+t•x) - q (t•x)‖ ≤ (|K|+1)*(t*M)^(d+1) := by
    rw [Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)] at hb
    calc
      _ ≤ K * ‖t•x‖^(d+1) := hb
      _ ≤ (|K|+1) * ‖t•x‖^(d+1) := mul_le_mul_of_nonneg_right (by linarith [le_abs_self K]) (by positivity)
      _ ≤ _ := mul_le_mul_of_nonneg_left hpow (by positivity)
  have htd : 0 < t^d := pow_pos ht d
  have he : (t^d)⁻¹ • f (a+t•x) - q x = (t^d)⁻¹ • (f (a+t•x) - q (t•x)) := by
    rw [smul_sub, hq t ht x, smul_smul, inv_mul_cancel₀ htd.ne', one_smul]
  rw [he, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos htd]
  calc
    _ ≤ (t^d)⁻¹ * ((|K|+1)*(t*M)^(d+1)) := mul_le_mul_of_nonneg_left hbnd (inv_nonneg.mpr htd.le)
    _ = _ := by
      rw [mul_pow, pow_succ]
      field_simp

/-- The normalized function converges uniformly on every norm-bounded set. -/
theorem tendstoUniformlyOn_of_norm_bound {f q : E → V} {a : E} (d : ℕ)
    (hrem : (fun y ↦ f (a+y) - q y) =O[𝓝 0] (fun y : E ↦ ‖y‖^(d+1)))
    (hq : ∀ (t : ℝ), 0 < t → ∀ x, q (t•x) = t^d • q x)
    (S : Set E) (M : ℝ) (hM : 0 < M) (hS : ∀ x ∈ S, ‖x‖ ≤ M) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ (t^d)⁻¹ • f (a+t•x)) q (𝓝[>] 0) S := by
  obtain ⟨C,δ,hC,hδ,hbound⟩ := exists_uniform_scaled_bound d hrem hq
  rw [Metric.tendstoUniformlyOn_iff]
  intro ε hε
  have hCM : 0 < C*M^(d+1) := mul_pos hC (pow_pos hM _)
  filter_upwards [self_mem_nhdsWithin,
    (eventually_lt_nhds (div_pos hδ hM)).filter_mono nhdsWithin_le_nhds,
    (eventually_lt_nhds (div_pos hε hCM)).filter_mono nhdsWithin_le_nhds] with t ht htδ htε
  intro x hx
  have hs : t*M < δ := (lt_div_iff₀ hM).mp htδ
  have hb := hbound M t x hM.le ht (hS x hx) hs
  have hc : C*t*M^(d+1) < ε := by
    have h := (lt_div_iff₀ hCM).mp htε
    nlinarith
  simpa only [dist_eq_norm, norm_sub_rev] using lt_of_le_of_lt hb hc

theorem tendstoUniformlyOn_of_isBounded {f q : E → V} {a : E} (d : ℕ)
    (hrem : (fun y ↦ f (a+y) - q y) =O[𝓝 0] (fun y : E ↦ ‖y‖^(d+1)))
    (hq : ∀ (t : ℝ), 0 < t → ∀ x, q (t•x) = t^d • q x)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ (t^d)⁻¹ • f (a+t•x)) q (𝓝[>] 0) S := by
  obtain ⟨M,hM,hSM⟩ := hS.exists_pos_norm_le
  exact tendstoUniformlyOn_of_norm_bound d hrem hq S M hM hSM

theorem tendstoUniformlyOn_of_isCompact {f q : E → V} {a : E} (d : ℕ)
    (hrem : (fun y ↦ f (a+y) - q y) =O[𝓝 0] (fun y : E ↦ ‖y‖^(d+1)))
    (hq : ∀ (t : ℝ), 0 < t → ∀ x, q (t•x) = t^d • q x)
    (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ (t^d)⁻¹ • f (a+t•x)) q (𝓝[>] 0) S :=
  tendstoUniformlyOn_of_isBounded d hrem hq S hS.isBounded

end
end Source29HomogeneousRescalingLimit

/- Component: AnalyticInitialScaling.inc -/
namespace Source29AnalyticInitialScaling

open Filter Set Asymptotics
open scoped Topology

noncomputable section
variable {E V : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- An analytic initial term is the uniform limit of normalized dilations
on every bounded set. This statement applies to operator-valued functions too. -/
theorem initial_tendstoUniformlyOn {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ (t^d)⁻¹ • f (a+t•x))
      (fun x ↦ p d (fun _ ↦ x)) (𝓝[>] 0) S :=
  Source29HomogeneousRescalingLimit.tendstoUniformlyOn_of_isBounded d
    (Source29AnalyticInitialRemainder.remainder_isBigO hp d hlow)
    (fun t _ x ↦ Source29AnalyticInitialRemainder.diagonal_smul p d t x) S hS

/-- The scalar version is written with division for later weighted-face sums. -/
theorem initial_polynomial_tendstoUniformlyOn {n : ℕ} {f : (Fin n → ℝ) → ℝ} {a : Fin n → ℝ}
    {p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ} (hp : HasFPowerSeriesAt f p a)
    (d : ℕ) (H : MvPolynomial (Fin n) ℝ)
    (hH : ∀ x, MvPolynomial.eval x H = p d (fun _ ↦ x))
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0)
    (S : Set (Fin n → ℝ)) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ f (a+t•x)/t^d)
      (fun x ↦ MvPolynomial.eval x H) (𝓝[>] 0) S := by
  have ht := initial_tendstoUniformlyOn hp d hlow S hS
  simpa only [smul_eq_mul, div_eq_mul_inv, mul_comm, ← hH] using ht

end
end Source29AnalyticInitialScaling

/- Component: WeightedInitialScaling.inc -/
namespace Source29WeightedInitialScaling

open Filter Set Asymptotics
open scoped Topology

noncomputable section
variable {E V : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- A scalar tending to zero kills a uniformly convergent, uniformly bounded
family. Only a bound for the limiting function is needed. -/
theorem scalar_smul_tendstoUniformlyOn_zero {ι : Type*} {l : Filter ι}
    {F : ι → E → V} {q : E → V} {g : ι → ℝ} {S : Set E}
    (hF : TendstoUniformlyOn F q l S) (hg : Tendsto g l (𝓝 0))
    (B : ℝ) (hB : ∀ x ∈ S, ‖q x‖ ≤ B) :
    TendstoUniformlyOn (fun t x ↦ g t • F t x) (fun _ ↦ 0) l S := by
  rw [Metric.tendstoUniformlyOn_iff] at hF ⊢
  intro ε hε
  have hgc : Tendsto (fun t ↦ ‖g t‖*(|B|+1)) l (𝓝 0) := by
    simpa using hg.norm.mul_const (|B|+1)
  filter_upwards [hF 1 zero_lt_one, hgc.eventually_lt_const hε] with t ht hgt
  intro x hx
  have he : ‖F t x-q x‖ < 1 := by simpa only [dist_eq_norm, norm_sub_rev] using ht x hx
  have hb : ‖F t x‖ ≤ |B|+1 := by
    calc
      _ = ‖(F t x-q x)+q x‖ := by rw [sub_add_cancel]
      _ ≤ ‖F t x-q x‖+‖q x‖ := norm_add_le _ _
      _ ≤ _ := by linarith [hB x hx, le_abs_self B]
  rw [dist_zero_left, norm_smul]
  exact lt_of_le_of_lt (mul_le_mul_of_nonneg_left hb (norm_nonneg _)) hgt

lemma diagonal_norm_bound (p : FormalMultilinearSeries ℝ E V) (d : ℕ)
    (M : ℝ) (_hM : 0 ≤ M) (x : E) (hx : ‖x‖ ≤ M) :
    ‖p d (fun _ ↦ x)‖ ≤ ‖p d‖*M^d := by
  calc
    _ ≤ ‖p d‖*‖x‖^d := by
      simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using
        (p d).le_opNorm (fun _ ↦ x)
    _ ≤ _ := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hx d) (norm_nonneg _)

lemma weighted_factor (t β : ℝ) (d : ℕ) (ht : 0 < t) (z : V) :
    t^((d : ℝ)-β) • ((t^d)⁻¹ • z) = t^(-β) • z := by
  rw [smul_smul, Real.rpow_sub ht, Real.rpow_natCast, Real.rpow_neg ht.le]
  congr 1
  field_simp

/-- A weight strictly below the first Taylor order has zero normalized limit,
uniformly on every bounded set of directions. -/
theorem below_order_tendstoUniformlyOn_zero {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a)
    (d : ℕ) (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0)
    (β : ℝ) (hβ : β < (d : ℝ)) (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ t^(-β) • f (a+t•x))
      (fun _ ↦ 0) (𝓝[>] 0) S := by
  have hF := Source29AnalyticInitialScaling.initial_tendstoUniformlyOn hp d hlow S hS
  obtain ⟨M,hM,hSM⟩ := hS.exists_pos_norm_le
  have hg : Tendsto (fun t : ℝ ↦ t^((d : ℝ)-β)) (𝓝[>] 0) (𝓝 0) := by
    have hc := (Real.continuousAt_rpow_const 0 ((d : ℝ)-β) (Or.inr (by linarith))).tendsto
    have hz : (0 : ℝ)^((d : ℝ)-β) = 0 := Real.zero_rpow (by linarith)
    rw [hz] at hc
    exact hc.mono_left nhdsWithin_le_nhds
  have ht := scalar_smul_tendstoUniformlyOn_zero hF hg (‖p d‖*M^d)
    (fun x hx ↦ diagonal_norm_bound p d M hM.le x (hSM x hx))
  apply ht.congr
  filter_upwards [self_mem_nhdsWithin] with t ht
  intro x _
  exact weighted_factor t β d ht (f (a+t•x))

/-- At the first Taylor order, the weighted limit is exactly the initial term. -/
theorem at_order_tendstoUniformlyOn {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a)
    (d : ℕ) (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ t^(-(d : ℝ)) • f (a+t•x))
      (fun x ↦ p d (fun _ ↦ x)) (𝓝[>] 0) S := by
  apply (Source29AnalyticInitialScaling.initial_tendstoUniformlyOn hp d hlow S hS).congr
  filter_upwards [self_mem_nhdsWithin] with t ht
  intro x _
  rw [Real.rpow_neg (le_of_lt ht), Real.rpow_natCast]

/-- A zero germ stays zero uniformly after small dilations on any bounded set. -/
theorem eventually_uniform_zero_of_germ {f : E → V} {a : E}
    (hz : ∀ᶠ y in 𝓝 a, f y = 0) (S : Set E) (hS : Bornology.IsBounded S) :
    ∀ᶠ t : ℝ in 𝓝 0, ∀ x ∈ S, f (a+t•x) = 0 := by
  obtain ⟨δ,hδ,hball⟩ := Metric.mem_nhds_iff.mp hz
  obtain ⟨M,hM,hSM⟩ := hS.exists_pos_norm_le
  filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (div_pos hδ hM)] with t ht
  intro x hx
  apply hball
  rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul]
  have ht' : ‖t‖ < δ/M := by simpa only [Metric.mem_ball, dist_zero_right] using ht
  exact lt_of_le_of_lt (mul_le_mul_of_nonneg_left (hSM x hx) (norm_nonneg _))
    ((lt_div_iff₀ hM).mp ht')

/-- Even an unbounded scalar normalization preserves the uniform zero limit
of a germ which vanishes on a neighborhood. -/
theorem zero_germ_tendstoUniformlyOn {f : E → V} {a : E}
    (hz : ∀ᶠ y in 𝓝 a, f y = 0) (S : Set E) (hS : Bornology.IsBounded S)
    (w : ℝ → ℝ) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ w t • f (a+t•x))
      (fun _ ↦ 0) (𝓝[>] 0) S := by
  rw [Metric.tendstoUniformlyOn_iff]
  intro ε hε
  filter_upwards [(eventually_uniform_zero_of_germ hz S hS).filter_mono nhdsWithin_le_nhds] with t ht
  intro x hx
  rw [ht x hx, smul_zero, dist_self]
  exact hε

/-- The face coefficient survives precisely when its order equals the weight. -/
theorem at_or_below_order_tendstoUniformlyOn {f : E → V} {a : E}
    {p : FormalMultilinearSeries ℝ E V} (hp : HasFPowerSeriesAt f p a)
    (d : ℕ) (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0)
    (β : ℝ) (hβ : β ≤ (d : ℝ)) (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ ↦ fun x ↦ t^(-β) • f (a+t•x))
      (fun x ↦ if β = (d : ℝ) then p d (fun _ ↦ x) else 0) (𝓝[>] 0) S := by
  classical
  rcases lt_or_eq_of_le hβ with hlt | heq
  · simpa only [ne_of_lt hlt, ite_false] using below_order_tendstoUniformlyOn_zero hp d hlow β hlt S hS
  · subst β
    simpa only [ite_true] using at_order_tendstoUniformlyOn hp d hlow S hS

end
end Source29WeightedInitialScaling

/- Component: LocalWeightedSignLimit.inc -/
namespace Source29LocalWeightedSignLimit

open Filter
open scoped Topology

noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def scaledPoint (α t : ℝ) (z : ℝ × E) : ℝ × E := (t^α*z.1, t•z.2)

theorem scaledPoint_tendsto (α : ℝ) (hα : 0 < α) (z : ℝ × E) :
    Tendsto (fun t : ℝ ↦ scaledPoint α t z) (𝓝[>] 0) (𝓝 0) := by
  have ha : Tendsto (fun t : ℝ ↦ t^α) (𝓝 0) (𝓝 0) := by
    simpa only [Real.zero_rpow hα.ne'] using
      (Real.continuousAt_rpow_const 0 α (Or.inr hα.le)).tendsto
  have hb : Tendsto (fun t : ℝ ↦ t•z.2) (𝓝 0) (𝓝 (0 : E)) := by
    simpa only [zero_smul, id_eq] using (tendsto_id.smul (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ z.2) (𝓝 0) (𝓝 z.2)))
  have hc := (ha.mul_const z.1).prodMk_nhds hb
  change Tendsto (fun t : ℝ ↦ scaledPoint α t z) (𝓝[>] 0) (𝓝 ((0 : ℝ), (0 : E)))
  simpa only [zero_mul, scaledPoint] using hc.mono_left nhdsWithin_le_nhds

/-- Local half-space signs pass to a weighted blow-up limit because the
normalizing power and the normal-coordinate dilation are positive. -/
theorem sign_inherited (f N : ℝ × E → ℝ) (α D : ℝ) (hα : 0 < α)
    (hpos : ∀ᶠ z in 𝓝 (0 : ℝ × E), 0 < z.1 → 0 ≤ f z)
    (hneg : ∀ᶠ z in 𝓝 (0 : ℝ × E), z.1 < 0 → f z ≤ 0)
    (hlim : ∀ z, Tendsto (fun t : ℝ ↦ f (scaledPoint α t z)/t^D) (𝓝[>] 0) (𝓝 (N z))) :
    (∀ z, 0 < z.1 → 0 ≤ N z) ∧ (∀ z, z.1 < 0 → N z ≤ 0) := by
  constructor
  · intro z hz
    apply ge_of_tendsto (hlim z)
    filter_upwards [self_mem_nhdsWithin, (scaledPoint_tendsto α hα z).eventually hpos] with t ht hs
    apply div_nonneg
    · apply hs
      exact mul_pos (Real.rpow_pos_of_pos ht α) hz
    · exact (Real.rpow_pos_of_pos ht D).le
  · intro z hz
    apply le_of_tendsto (hlim z)
    filter_upwards [self_mem_nhdsWithin, (scaledPoint_tendsto α hα z).eventually hneg] with t ht hs
    apply div_nonpos_of_nonpos_of_nonneg
    · apply hs
      exact mul_neg_of_pos_of_neg (Real.rpow_pos_of_pos ht α) hz
    · exact (Real.rpow_pos_of_pos ht D).le

end
end Source29LocalWeightedSignLimit

/- Component: NormalShiftDerivatives.inc -/
namespace Source29NormalShiftDerivatives

open Filter
open Source29NewtonRootHarmonic
open scoped Topology

noncomputable section

section RankOne
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def shift (h : E → ℝ) (e x : E) : E := x - h x • e

def second (f : E → ℝ) (x u v : E) : ℝ :=
  fderiv ℝ (fun y ↦ fderiv ℝ f y v) x u

lemma analyticAt_shift (h : E → ℝ) (e x : E) (hh : AnalyticAt ℝ h x) :
    AnalyticAt ℝ (shift h e) x :=
  analyticAt_id.sub (hh.smul analyticAt_const)

lemma first_shift (f h : E → ℝ) (e x v : E)
    (hf : DifferentiableAt ℝ f (shift h e x)) (hh : DifferentiableAt ℝ h x) :
    fderiv ℝ (fun y ↦ f (shift h e y)) x v =
      fderiv ℝ f (shift h e x) v - fderiv ℝ h x v * fderiv ℝ f (shift h e x) e := by
  have hs : HasFDerivAt (shift h e)
      (ContinuousLinearMap.id ℝ E - (fderiv ℝ h x).smulRight e) x :=
    (hasFDerivAt_id x).sub (hh.hasFDerivAt.smul_const e)
  have he := congrArg (fun L : E →L[ℝ] ℝ ↦ L v) (hf.hasFDerivAt.comp x hs).fderiv
  simpa only [Function.comp_def, ContinuousLinearMap.comp_apply, _root_.sub_apply,
    ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply,
    map_sub, map_smul, smul_eq_mul] using he

/-- The second derivative of a nonlinear rank-one shift, with its two mixed
orders kept separate. This needs no symmetry theorem. -/
theorem second_shift (f h : E → ℝ) (e x u v : E)
    (hf : AnalyticAt ℝ f (shift h e x)) (hh : AnalyticAt ℝ h x) :
    second (fun y ↦ f (shift h e y)) x u v =
      second f (shift h e x) u v - fderiv ℝ h x u * second f (shift h e x) e v -
      fderiv ℝ h x v * second f (shift h e x) u e +
      fderiv ℝ h x u * fderiv ℝ h x v * second f (shift h e x) e e -
      fderiv ℝ f (shift h e x) e * second h x u v := by
  have hs := analyticAt_shift h e x hh
  have heq : (fun y ↦ fderiv ℝ (fun z ↦ f (shift h e z)) y v) =ᶠ[𝓝 x]
      (fun y ↦ fderiv ℝ f (shift h e y) v -
        fderiv ℝ h y v * fderiv ℝ f (shift h e y) e) := by
    filter_upwards [hh.eventually_analyticAt,
      hs.continuousAt.tendsto.eventually hf.eventually_analyticAt] with y hyh hyf
    exact first_shift f h e y v hyf.differentiableAt hyh.differentiableAt
  have hfv := analyticAt_directional f (shift h e x) v hf
  have hfe := analyticAt_directional f (shift h e x) e hf
  have hhv := analyticAt_directional h x v hh
  have hcv : AnalyticAt ℝ (fun y ↦ fderiv ℝ f (shift h e y) v) x :=
    AnalyticAt.comp (f := shift h e) (g := fun y ↦ fderiv ℝ f y v) hfv hs
  have hce : AnalyticAt ℝ (fun y ↦ fderiv ℝ f (shift h e y) e) x :=
    AnalyticAt.comp (f := shift h e) (g := fun y ↦ fderiv ℝ f y e) hfe hs
  change fderiv ℝ (fun y ↦ fderiv ℝ (fun z ↦ f (shift h e z)) y v) x u = _
  rw [heq.fderiv_eq, fderiv_fun_sub
    (f := fun y ↦ fderiv ℝ f (shift h e y) v)
    (g := fun y ↦ fderiv ℝ h y v * fderiv ℝ f (shift h e y) e)
    hcv.differentiableAt (hhv.mul hce).differentiableAt]
  simp only [_root_.sub_apply]
  rw [fderiv_fun_mul hhv.differentiableAt hce.differentiableAt]
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
  rw [first_shift (fun y ↦ fderiv ℝ f y v) h e x u hfv.differentiableAt hh.differentiableAt,
    first_shift (fun y ↦ fderiv ℝ f y e) h e x u hfe.differentiableAt hh.differentiableAt]
  unfold second
  ring

lemma second_eq_fderiv_fderiv (f : E → ℝ) (x u v : E) (hf : AnalyticAt ℝ f x) :
    second f x u v = fderiv ℝ (fderiv ℝ f) x u v := by
  have h := (ContinuousLinearMap.apply ℝ ℝ v).hasFDerivAt.comp x
    hf.fderiv.differentiableAt.hasFDerivAt
  exact congrArg (fun L : E →L[ℝ] ℝ ↦ L u) h.fderiv

lemma second_neg (h : E → ℝ) (x u v : E) :
    second (fun y ↦ -h y) x u v = -second h x u v := by
  simp only [second, fderiv_fun_neg, neg_apply]

end RankOne

section Linear
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

lemma first_linear (f : F → ℝ) (L : E →L[ℝ] F) (x v : E)
    (hf : DifferentiableAt ℝ f (L x)) :
    fderiv ℝ (fun y ↦ f (L y)) x v = fderiv ℝ f (L x) (L v) := by
  have hd := congrArg (fun D : E →L[ℝ] ℝ ↦ D v) (hf.hasFDerivAt.comp x L.hasFDerivAt).fderiv
  simpa only [Function.comp_def, ContinuousLinearMap.comp_apply] using hd

lemma second_linear (f : F → ℝ) (L : E →L[ℝ] F) (x u v : E)
    (hf : AnalyticAt ℝ f (L x)) :
    second (fun y ↦ f (L y)) x u v = second f (L x) (L u) (L v) := by
  have he : (fun y ↦ fderiv ℝ (fun z ↦ f (L z)) y v) =ᶠ[𝓝 x]
      (fun y ↦ fderiv ℝ f (L y) (L v)) := by
    filter_upwards [L.continuous.continuousAt.tendsto.eventually hf.eventually_analyticAt] with y hy
    exact first_linear f L y v hy.differentiableAt
  unfold second
  rw [he.fderiv_eq]
  exact first_linear (fun y ↦ fderiv ℝ f y (L v)) L x u
    (analyticAt_directional f (L x) (L v) hf).differentiableAt

end Linear

section Coordinates
variable {n : ℕ}

def tail : (Fin (n+1) → ℝ) →L[ℝ] (Fin n → ℝ) :=
  ContinuousLinearMap.pi (fun i ↦ ContinuousLinearMap.proj i.succ)

def lift (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) : ℝ := g (tail x)

def basis (i : Fin n) : Fin n → ℝ := Pi.single i 1

lemma tail_basis_zero : tail (basis (0 : Fin (n+1))) = 0 := by
  funext i
  simp [tail, basis]

lemma tail_basis_succ (i : Fin n) : tail (basis i.succ) = basis i := by
  funext j
  simp [tail, basis, Pi.single_apply]

lemma analyticAt_lift (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) : AnalyticAt ℝ (lift g) x :=
  AnalyticAt.comp (f := tail) (g := g) hg (tail.analyticAt x)

lemma first_lift_zero (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) : fderiv ℝ (lift g) x (basis 0) = 0 := by
  change fderiv ℝ (fun y ↦ g (tail y)) x (basis 0) = 0
  rw [first_linear g tail x (basis 0) hg.differentiableAt, tail_basis_zero, map_zero]

lemma first_lift_succ (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) (i : Fin n) :
    fderiv ℝ (lift g) x (basis i.succ) = fderiv ℝ g (tail x) (basis i) := by
  change fderiv ℝ (fun y ↦ g (tail y)) x (basis i.succ) = _
  rw [first_linear g tail x (basis i.succ) hg.differentiableAt, tail_basis_succ]

lemma second_lift (g : (Fin n → ℝ) → ℝ) (x u v : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) :
    second (lift g) x u v = second g (tail x) (tail u) (tail v) :=
  second_linear g tail x u v hg

lemma second_zero_left {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (g : E → ℝ) (x v : E) : second g x 0 v = 0 := by
  simp [second]

lemma second_zero_right {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (g : E → ℝ) (x u : E) : second g x u 0 = 0 := by
  simp [second]


def gradient (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i : Fin n) : ℝ :=
  fderiv ℝ f x (basis i)

def hessian (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i j : Fin n) : ℝ :=
  second f x (basis i) (basis j)

/-- The actual forward normal chart (x,y) ↦ (x+g(y),y). -/
def chart (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) : Fin (n+1) → ℝ :=
  shift (fun y ↦ -lift g y) (basis 0) x

lemma chart_eq (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) :
    chart g x = Fin.cons (x 0 + g (tail x)) (tail x) := by
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · simp [chart, shift, lift, basis]
  · simp [chart, shift, basis, tail]

def pullback (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (x : Fin (n+1) → ℝ) : ℝ := MvPolynomial.eval (chart g x) P

lemma analyticAt_pullback (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    AnalyticAt ℝ (pullback P g) x :=
  AnalyticAt.comp (f := chart g) (g := fun y ↦ MvPolynomial.eval y P)
    (Source29PolynomialLinkChart.analyticAt_eval_real P (chart g x))
    (analyticAt_shift (fun y ↦ -lift g y) (basis 0) x (analyticAt_lift g x hg).neg)

lemma gradient_eval (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i : Fin n) :
    gradient (fun y ↦ MvPolynomial.eval y P) x i = MvPolynomial.eval x (MvPolynomial.pderiv i P) := by
  unfold gradient basis
  rw [Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval,
    Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis]

lemma hessian_eval (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i j : Fin n) :
    hessian (fun y ↦ MvPolynomial.eval y P) x i j =
      MvPolynomial.eval x (MvPolynomial.pderiv i (MvPolynomial.pderiv j P)) := by
  have he : (fun y ↦ fderiv ℝ (fun z ↦ MvPolynomial.eval z P) y (basis j)) =
      (fun y ↦ MvPolynomial.eval y (MvPolynomial.pderiv j P)) :=
    funext (fun y ↦ gradient_eval P y j)
  unfold hessian second
  rw [he]
  exact gradient_eval (MvPolynomial.pderiv j P) x i

lemma hessian_eval_symm (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i j : Fin n) :
    hessian (fun y ↦ MvPolynomial.eval y P) x i j =
      hessian (fun y ↦ MvPolynomial.eval y P) x j i := by
  rw [hessian_eval, hessian_eval,
    Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm P i j]

lemma gradient_pullback (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x))
    (i : Fin (n+1)) :
    gradient (pullback P g) x i =
      gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) i +
      gradient (lift g) x i * gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 := by
  have hp := Source29PolynomialLinkChart.analyticAt_eval_real P (chart g x)
  have hh := (analyticAt_lift g x hg).neg
  unfold gradient
  change fderiv ℝ (fun y ↦ MvPolynomial.eval (shift (fun z ↦ -lift g z) (basis 0) y) P) x
    (basis i) = _
  rw [first_shift _ _ _ _ _ hp.differentiableAt hh.differentiableAt]
  simp only [fderiv_fun_neg, neg_apply]
  unfold chart
  ring

lemma hessian_pullback (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x))
    (i j : Fin (n+1)) :
    hessian (pullback P g) x i j =
      hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i j +
      gradient (lift g) x i * hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 j +
      gradient (lift g) x j * hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i 0 +
      gradient (lift g) x i * gradient (lift g) x j *
        hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 0 +
      gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 * hessian (lift g) x i j := by
  have hp := Source29PolynomialLinkChart.analyticAt_eval_real P (chart g x)
  have hh := (analyticAt_lift g x hg).neg
  unfold hessian
  change second (fun y ↦ MvPolynomial.eval (shift (fun z ↦ -lift g z) (basis 0) y) P) x
    (basis i) (basis j) = _
  rw [second_shift _ _ _ _ _ _ hp hh]
  simp only [fderiv_fun_neg, neg_apply, second_neg]
  unfold gradient chart
  ring

lemma gradient_lift_zero (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) : gradient (lift g) x 0 = 0 := first_lift_zero g x hg

lemma gradient_lift_succ (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) (i : Fin n) :
    gradient (lift g) x i.succ = gradient g (tail x) i := first_lift_succ g x hg i

lemma hessian_lift_zero_left (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) (i : Fin (n+1)) : hessian (lift g) x 0 i = 0 := by
  rw [hessian, second_lift g x _ _ hg, tail_basis_zero, second_zero_left]

lemma hessian_lift_zero_right (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) (i : Fin (n+1)) : hessian (lift g) x i 0 = 0 := by
  rw [hessian, second_lift g x _ _ hg, tail_basis_zero, second_zero_right]

lemma hessian_lift_succ_succ (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (tail x)) (i j : Fin n) :
    hessian (lift g) x i.succ j.succ = hessian g (tail x) i j := by
  rw [hessian, second_lift g x _ _ hg, tail_basis_succ, tail_basis_succ]
  rfl

lemma gradient_pullback_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    gradient (pullback P g) x 0 = gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 := by
  rw [gradient_pullback P g x hg, gradient_lift_zero g x hg, zero_mul, add_zero]

lemma gradient_pullback_succ (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) (i : Fin n) :
    gradient (pullback P g) x i.succ = gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) i.succ +
      gradient g (tail x) i * gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 := by
  rw [gradient_pullback P g x hg, gradient_lift_succ g x hg]

lemma hessian_pullback_zero_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    hessian (pullback P g) x 0 0 = hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 0 := by
  rw [hessian_pullback P g x hg]
  simp only [gradient_lift_zero g x hg, hessian_lift_zero_left g x hg, zero_mul, mul_zero, add_zero]

lemma hessian_pullback_succ_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) (i : Fin n) :
    hessian (pullback P g) x i.succ 0 =
      hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i.succ 0 +
      gradient g (tail x) i * hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 0 := by
  rw [hessian_pullback P g x hg]
  simp only [gradient_lift_zero g x hg, gradient_lift_succ g x hg,
    hessian_lift_zero_right g x hg, zero_mul, mul_zero, add_zero]

lemma hessian_pullback_succ_succ (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) (i j : Fin n) :
    hessian (pullback P g) x i.succ j.succ =
      hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i.succ j.succ +
      gradient g (tail x) i * hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 j.succ +
      gradient g (tail x) j * hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i.succ 0 +
      gradient g (tail x) i * gradient g (tail x) j *
        hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 0 +
      gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 * hessian g (tail x) i j := by
  rw [hessian_pullback P g x hg]
  simp only [gradient_lift_succ g x hg, hessian_lift_succ_succ g x hg]

/-- The ambient gradient reconstructed from the actual derivatives of the
polynomial pulled back along the nonlinear normal chart. -/
theorem polynomial_gradient_transform (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) =
      Source29NormalShiftAlgebra.ambientGradient (gradient (pullback P g) x 0)
        (fun i ↦ gradient (pullback P g) x i.succ) (gradient g (tail x)) := by
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · change gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 = gradient (pullback P g) x 0
    exact (gradient_pullback_zero P g x hg).symm
  · change gradient (fun y ↦ MvPolynomial.eval y P) (chart g x) j.succ =
      gradient (pullback P g) x j.succ - gradient (pullback P g) x 0 * gradient g (tail x) j
    rw [gradient_pullback_succ P g x hg, gradient_pullback_zero P g x hg]
    ring

/-- The full ambient Hessian reconstructed from actual derivatives. Polynomial
mixed-partial commutation discharges the normal mixed symmetry internally. -/
theorem polynomial_hessian_transform (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) =
      Source29NormalShiftAlgebra.ambientHessian (gradient (pullback P g) x 0)
        (hessian (pullback P g) x 0 0) (fun i ↦ hessian (pullback P g) x i.succ 0)
        (gradient g (tail x)) (fun i j ↦ hessian (pullback P g) x i.succ j.succ)
        (hessian g (tail x)) := by
  funext i j
  refine Fin.cases ?_ (fun i' ↦ ?_) i
  · refine Fin.cases ?_ (fun j' ↦ ?_) j
    · change hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 0 = hessian (pullback P g) x 0 0
      exact (hessian_pullback_zero_zero P g x hg).symm
    · change hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) 0 j'.succ =
        hessian (pullback P g) x j'.succ 0 - hessian (pullback P g) x 0 0 * gradient g (tail x) j'
      rw [hessian_pullback_succ_zero P g x hg, hessian_pullback_zero_zero P g x hg,
        hessian_eval_symm P (chart g x) 0 j'.succ]
      ring
  · refine Fin.cases ?_ (fun j' ↦ ?_) j
    · change hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i'.succ 0 =
        hessian (pullback P g) x i'.succ 0 - hessian (pullback P g) x 0 0 * gradient g (tail x) i'
      rw [hessian_pullback_succ_zero P g x hg, hessian_pullback_zero_zero P g x hg]
      ring
    · change hessian (fun y ↦ MvPolynomial.eval y P) (chart g x) i'.succ j'.succ =
        hessian (pullback P g) x i'.succ j'.succ -
          hessian (pullback P g) x i'.succ 0 * gradient g (tail x) j' -
          gradient g (tail x) i' * hessian (pullback P g) x j'.succ 0 +
          hessian (pullback P g) x 0 0 * (gradient g (tail x) i' * gradient g (tail x) j') -
          gradient (pullback P g) x 0 * hessian g (tail x) i' j'
      rw [hessian_pullback_succ_succ P g x hg, hessian_pullback_succ_zero P g x hg,
        hessian_pullback_succ_zero P g x hg, hessian_pullback_zero_zero P g x hg,
        gradient_pullback_zero P g x hg, hessian_eval_symm P (chart g x) 0 j'.succ]
      ring

/-- The finite-sum normal-shift identity applies to the actual derivative
arrays of a polynomial and its analytic normal pullback. -/
theorem polynomial_cubicLevel_transform (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x)) :
    let A := gradient (pullback P g) x 0
    let S := hessian (pullback P g) x 0 0
    let B := fun i : Fin n ↦ gradient (pullback P g) x i.succ
    let T := fun i : Fin n ↦ hessian (pullback P g) x i.succ 0
    let U := fun i j : Fin n ↦ hessian (pullback P g) x i.succ j.succ
    let a := gradient g (tail x)
    let G := hessian g (tail x)
    Source29NormalShiftAlgebra.cubicLevel (gradient (fun y ↦ MvPolynomial.eval y P) (chart g x))
      (hessian (fun y ↦ MvPolynomial.eval y P) (chart g x)) =
      Source29NormalShiftAlgebra.newtonResidual A S B T U -
      A^3 * Source29NormalShiftAlgebra.backgroundGraphOperator a G +
      Source29NormalShiftAlgebra.correction A S B T a U G := by
  dsimp only
  rw [polynomial_gradient_transform P g x hg, polynomial_hessian_transform P g x hg,
    Source29NormalShiftAlgebra.cubicLevel_normal_shift]

/-- The actual coordinate derivative arrays recover the polynomial cubic
leading operator, with the same sign convention as the normal-shift formula. -/
theorem cubicLevel_eval (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    Source29NormalShiftAlgebra.cubicLevel (gradient (fun y ↦ MvPolynomial.eval y P) x)
      (hessian (fun y ↦ MvPolynomial.eval y P) x) =
      MvPolynomial.eval x (Source29QuarticReuse.QuarticMinimal.leadingOperator P) := by
  simp only [Source29NormalShiftAlgebra.cubicLevel, Source29NormalShiftAlgebra.dot,
    Source29NormalShiftAlgebra.trace, Source29NormalShiftAlgebra.bilinear,
    Source29QuarticReuse.QuarticMinimal.leadingOperator,
    Source29QuarticReuse.QuarticMinimal.laplacian, gradient_eval, hessian_eval,
    map_sub, map_mul, map_sum, pow_two]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- A zero leading operator and a minimal background leave precisely the
Newton residual plus the explicitly displayed correction terms. -/
theorem newton_plus_correction_eq_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (tail x))
    (hP : MvPolynomial.eval (chart g x) (Source29QuarticReuse.QuarticMinimal.leadingOperator P) = 0)
    (hgmin : Source29NormalShiftAlgebra.backgroundGraphOperator (gradient g (tail x))
      (hessian g (tail x)) = 0) :
    let A := gradient (pullback P g) x 0
    let S := hessian (pullback P g) x 0 0
    let B := fun i : Fin n ↦ gradient (pullback P g) x i.succ
    let T := fun i : Fin n ↦ hessian (pullback P g) x i.succ 0
    let U := fun i j : Fin n ↦ hessian (pullback P g) x i.succ j.succ
    Source29NormalShiftAlgebra.newtonResidual A S B T U +
      Source29NormalShiftAlgebra.correction A S B T (gradient g (tail x)) U (hessian g (tail x)) = 0 := by
  have he := polynomial_cubicLevel_transform P g x hg
  dsimp only at he ⊢
  rw [cubicLevel_eval, hP, hgmin, mul_zero, sub_zero] at he
  exact he.symm

end Coordinates

end
end Source29NormalShiftDerivatives

/- Component: NormalShiftScaling.inc -/
namespace Source29NormalShiftScaling

open Source29NormalShiftAlgebra

noncomputable section
variable {ι K : Type*} [Fintype ι] [Field K]

/-- The tangential cubic correction. -/
def rhoCorrection (B : ι → K) (U : ι → ι → K) : K := traceComplement U B B

/-- The correction with mixed normal/tangential scaling. -/
def mixedCorrection (A : K) (B T a : ι → K) (U G : ι → ι → K) : K :=
  -A * (traceComplement U B a + traceComplement U a B) +
    2 * (dot a B * dot B T - dot B B * dot a T) - A * traceComplement G B B

/-- The correction with quadratic background-gradient scaling. -/
def epsilonCorrection (A S : K) (B T a : ι → K) (U G : ι → ι → K) : K :=
  A^2 * traceComplement U a a + S * (dot a a * dot B B - (dot a B)^2) -
    2 * A * (dot a a * dot B T - dot a B * dot a T) +
    A^2 * (traceComplement G B a + traceComplement G a B)

lemma correction_grouping (A S : K) (B T a : ι → K) (U G : ι → ι → K) :
    correction A S B T a U G =
      rhoCorrection B U + mixedCorrection A B T a U G + epsilonCorrection A S B T a U G := by
  unfold correction rhoCorrection mixedCorrection epsilonCorrection
  ring

lemma newtonResidual_scaling (κ ε ρ A S : K) (B T : ι → K) (U : ι → ι → K)
    (hε : ε ≠ 0) (hρ : ρ ≠ 0) :
    newtonResidual (κ*A) (κ/(ε*ρ)*S) (fun i ↦ κ*ρ*B i) (fun i ↦ κ/ε*T i)
      (fun i j ↦ κ*ρ/ε*U i j) = (κ^3*ρ/ε) * newtonResidual A S B T U := by
  unfold newtonResidual
  rw [trace_mul, dot_mul_left, dot_mul_right, dot_mul_left, dot_mul_right]
  field_simp

/-- Exact algebraic separation of the three vanishing correction factors. -/
theorem correction_scaling (κ ε ρ A S : K) (B T a : ι → K) (U G : ι → ι → K)
    (hε : ε ≠ 0) (hρ : ρ ≠ 0) :
    correction (κ*A) (κ/(ε*ρ)*S) (fun i ↦ κ*ρ*B i) (fun i ↦ κ/ε*T i)
      (fun i ↦ ε*a i) (fun i j ↦ κ*ρ/ε*U i j) G =
      (κ^3*ρ/ε) * (ρ^2*rhoCorrection B U + ε*ρ*mixedCorrection A B T a U G +
        ε^2*epsilonCorrection A S B T a U G) := by
  unfold correction rhoCorrection mixedCorrection epsilonCorrection traceComplement
  simp only [dot_mul_left, dot_mul_right, trace_mul, bilinear_mul_matrix,
    bilinear_mul_left, bilinear_mul_right]
  field_simp
  ring

/-- The scaled full level operator, with the background minimal-graph term
retained rather than assumed to vanish under a nonlinear coordinate change. -/
theorem normal_shift_scaling (κ ε ρ A S : K) (B T a : ι → K) (U G : ι → ι → K)
    (hε : ε ≠ 0) (hρ : ρ ≠ 0) :
    shiftedLevelOperator (κ*A) (κ/(ε*ρ)*S) (fun i ↦ κ*ρ*B i) (fun i ↦ κ/ε*T i)
      (fun i ↦ ε*a i) (fun i j ↦ κ*ρ/ε*U i j) G =
      (κ^3*ρ/ε) * (newtonResidual A S B T U -
        (ε/ρ)*A^3*backgroundGraphOperator (fun i ↦ ε*a i) G +
        ρ^2*rhoCorrection B U + ε*ρ*mixedCorrection A B T a U G +
        ε^2*epsilonCorrection A S B T a U G) := by
  rw [normal_shift_identity, newtonResidual_scaling κ ε ρ A S B T U hε hρ,
    correction_scaling κ ε ρ A S B T a U G hε hρ]
  field_simp
  ring

/-- Once the actual background graph equation is zero, the scaled level
equation reduces to the Newton residual and the three explicit corrections. -/
theorem scaled_equation (κ ε ρ A S : K) (B T a : ι → K) (U G : ι → ι → K)
    (hκ : κ ≠ 0) (hε : ε ≠ 0) (hρ : ρ ≠ 0)
    (hlevel : shiftedLevelOperator (κ*A) (κ/(ε*ρ)*S) (fun i ↦ κ*ρ*B i)
      (fun i ↦ κ/ε*T i) (fun i ↦ ε*a i) (fun i j ↦ κ*ρ/ε*U i j) G = 0)
    (hbackground : backgroundGraphOperator (fun i ↦ ε*a i) G = 0) :
    newtonResidual A S B T U + ρ^2*rhoCorrection B U + ε*ρ*mixedCorrection A B T a U G +
      ε^2*epsilonCorrection A S B T a U G = 0 := by
  rw [normal_shift_scaling κ ε ρ A S B T a U G hε hρ, hbackground, mul_zero, sub_zero] at hlevel
  exact (mul_eq_zero.mp hlevel).resolve_left (div_ne_zero (mul_ne_zero (pow_ne_zero 3 hκ) hρ) hε)

end
end Source29NormalShiftScaling

/- Component: NormalShiftScalingLimit.inc -/
namespace Source29NormalShiftScalingLimit

open Filter Source29NormalShiftAlgebra Source29NormalShiftScaling
open scoped Topology

noncomputable section
variable {ι : Type*} [Fintype ι]

/-- A tuple of normalized scalar, vector, and matrix jets. -/
abbrev Jet (ι : Type*) := (ℝ × ℝ) × ((ι → ℝ) × (ι → ℝ) × (ι → ℝ)) ×
  ((ι → ι → ℝ) × (ι → ι → ℝ))

def residual (j : Jet ι) : ℝ := newtonResidual j.1.1 j.1.2 j.2.1.1 j.2.1.2.1 j.2.2.1
def rhoTerm (j : Jet ι) : ℝ := rhoCorrection j.2.1.1 j.2.2.1
def mixedTerm (j : Jet ι) : ℝ := mixedCorrection j.1.1 j.2.1.1 j.2.1.2.1 j.2.1.2.2 j.2.2.1 j.2.2.2
def epsilonTerm (j : Jet ι) : ℝ :=
  epsilonCorrection j.1.1 j.1.2 j.2.1.1 j.2.1.2.1 j.2.1.2.2 j.2.2.1 j.2.2.2

lemma residual_continuous : Continuous (residual : Jet ι → ℝ) := by
  unfold residual newtonResidual dot trace
  fun_prop

lemma rhoTerm_continuous : Continuous (rhoTerm : Jet ι → ℝ) := by
  unfold rhoTerm rhoCorrection traceComplement dot trace bilinear
  fun_prop

lemma mixedTerm_continuous : Continuous (mixedTerm : Jet ι → ℝ) := by
  unfold mixedTerm mixedCorrection traceComplement dot trace bilinear
  fun_prop

lemma epsilonTerm_continuous : Continuous (epsilonTerm : Jet ι → ℝ) := by
  unfold epsilonTerm epsilonCorrection traceComplement dot trace bilinear
  fun_prop

/-- The grouped corrections vanish when both scale parameters tend to zero
and the normalized jets converge. This assumes jet convergence explicitly. -/
theorem residual_eq_zero_of_tendsto {α : Type*} {l : Filter α} [NeBot l]
    (ε ρ : α → ℝ) (j : α → Jet ι) (j₀ : Jet ι)
    (hε : Tendsto ε l (𝓝 0)) (hρ : Tendsto ρ l (𝓝 0)) (hj : Tendsto j l (𝓝 j₀))
    (heq : ∀ᶠ t in l, residual (j t) + (ρ t)^2 * rhoTerm (j t) +
      ε t * ρ t * mixedTerm (j t) + (ε t)^2 * epsilonTerm (j t) = 0) :
    residual j₀ = 0 := by
  have hE := residual_continuous.continuousAt.tendsto.comp hj
  have hR := rhoTerm_continuous.continuousAt.tendsto.comp hj
  have hM := mixedTerm_continuous.continuousAt.tendsto.comp hj
  have hS := epsilonTerm_continuous.continuousAt.tendsto.comp hj
  have htotal : Tendsto (fun t ↦ residual (j t) + (ρ t)^2 * rhoTerm (j t) +
      ε t * ρ t * mixedTerm (j t) + (ε t)^2 * epsilonTerm (j t)) l (𝓝 (residual j₀)) := by
    simpa using ((hE.add ((hρ.pow 2).mul hR)).add ((hε.mul hρ).mul hM)).add ((hε.pow 2).mul hS)
  have hzero : Tendsto (fun t ↦ residual (j t) + (ρ t)^2 * rhoTerm (j t) +
      ε t * ρ t * mixedTerm (j t) + (ε t)^2 * epsilonTerm (j t)) l (𝓝 0) :=
    tendsto_const_nhds.congr' (Filter.Eventually.mono heq (fun _ ht ↦ ht.symm))
  exact tendsto_nhds_unique htotal hzero

/-- Coordinate-wise inputs to the normalized-jet limit theorem. No special
values for the limiting background gradient or Hessian are assumed. -/
theorem newtonResidual_eq_zero_of_tendsto {α : Type*} {l : Filter α} [NeBot l]
    (ε ρ A S : α → ℝ) (B T a : α → ι → ℝ) (U G : α → ι → ι → ℝ)
    (A₀ S₀ : ℝ) (B₀ T₀ a₀ : ι → ℝ) (U₀ G₀ : ι → ι → ℝ)
    (hε : Tendsto ε l (𝓝 0)) (hρ : Tendsto ρ l (𝓝 0))
    (hA : Tendsto A l (𝓝 A₀)) (hS : Tendsto S l (𝓝 S₀))
    (hB : Tendsto B l (𝓝 B₀)) (hT : Tendsto T l (𝓝 T₀)) (ha : Tendsto a l (𝓝 a₀))
    (hU : Tendsto U l (𝓝 U₀)) (hG : Tendsto G l (𝓝 G₀))
    (heq : ∀ᶠ t in l, newtonResidual (A t) (S t) (B t) (T t) (U t) +
      (ρ t)^2 * rhoCorrection (B t) (U t) +
      ε t * ρ t * mixedCorrection (A t) (B t) (T t) (a t) (U t) (G t) +
      (ε t)^2 * epsilonCorrection (A t) (S t) (B t) (T t) (a t) (U t) (G t) = 0) :
    newtonResidual A₀ S₀ B₀ T₀ U₀ = 0 := by
  exact residual_eq_zero_of_tendsto ε ρ
    (fun t ↦ ((A t, S t), (B t, T t, a t), (U t, G t)))
    ((A₀, S₀), (B₀, T₀, a₀), (U₀, G₀)) hε hρ
    ((hA.prodMk_nhds hS).prodMk_nhds ((hB.prodMk_nhds (hT.prodMk_nhds ha)).prodMk_nhds (hU.prodMk_nhds hG))) heq

end
end Source29NormalShiftScalingLimit

/- Component: AnalyticDerivativeRemainder.inc -/
namespace Source29AnalyticDerivativeRemainder

open Filter Asymptotics
open scoped Topology

noncomputable section

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- A finite truncation retaining the original multilinear coefficients. -/
def truncateSeries (p : FormalMultilinearSeries ℝ E F) (N : ℕ) :
    FormalMultilinearSeries ℝ E F :=
  fun k => if k < N then p k else 0

theorem partialSum_hasFiniteFPowerSeries (p : FormalMultilinearSeries ℝ E F) (N : ℕ) :
    HasFiniteFPowerSeriesOnBall (p.partialSum N) (truncateSeries p N) 0 N ⊤ := by
  apply HasFiniteFPowerSeriesOnBall.mk'
  · intro k hk
    simp only [truncateSeries, ite_eq_right (not_lt.mpr hk)]
  · simp
  · intro y _
    simp only [zero_add, FormalMultilinearSeries.partialSum]
    apply Finset.sum_congr rfl
    intro k hk
    simp only [truncateSeries, ite_eq_left (Finset.mem_range.mp hk)]

/-- A coefficient of the differentiated series depends only on the next
coefficient of the original series. -/
theorem derivSeries_congr_coeff (p q : FormalMultilinearSeries ℝ E F)
    (k : ℕ) (h : p (k + 1) = q (k + 1)) : p.derivSeries k = q.derivSeries k := by
  have h' : p (1 + k) = q (1 + k) := by
    rw [Nat.add_comm 1 k]
    exact h
  simp only [FormalMultilinearSeries.derivSeries,
    ContinuousLinearMap.compFormalMultilinearSeries_apply,
    FormalMultilinearSeries.changeOriginSeries,
    FormalMultilinearSeries.changeOriginSeriesTerm, h']

/-- Differentiation of a finite Taylor polynomial is exact. -/
theorem fderiv_partialSum (p : FormalMultilinearSeries ℝ E F) (N : ℕ) (x : E) :
    fderiv ℝ (p.partialSum (N + 1)) x = p.derivSeries.partialSum N x := by
  have h := (partialSum_hasFiniteFPowerSeries p (N + 1)).fderiv
  have he := h.eq_partialSum x (by simp) N le_rfl
  simp only [zero_add] at he
  rw [he]
  unfold FormalMultilinearSeries.partialSum
  apply Finset.sum_congr rfl
  intro k hk
  have hklt : k < N := Finset.mem_range.mp hk
  rw [derivSeries_congr_coeff (truncateSeries p (N + 1)) p k]
  simp only [truncateSeries, ite_eq_left (by omega : k + 1 < N + 1)]


/-- The second derivative of a finite Taylor polynomial is also exact. -/
theorem fderiv_fderiv_partialSum (p : FormalMultilinearSeries ℝ E F) (N : ℕ) (x : E) :
    fderiv ℝ (fderiv ℝ (p.partialSum (N + 2))) x =
      p.derivSeries.derivSeries.partialSum N x := by
  have he : fderiv ℝ (p.partialSum (N + 2)) = p.derivSeries.partialSum (N + 1) :=
    funext (fderiv_partialSum p (N + 1))
  rw [he, fderiv_partialSum]

section Complete
variable [CompleteSpace F]

/-- Taylor remainder for the first derivative, proved from the differentiated
convergent series rather than from convergence of function values. -/
theorem fderiv_remainder_isBigO {f : E → F} {p : FormalMultilinearSeries ℝ E F} {a : E}
    (hp : HasFPowerSeriesAt f p a) (N : ℕ) :
    (fun y => fderiv ℝ f (a + y) - fderiv ℝ (p.partialSum (N + 1)) y)
      =O[𝓝 0] (fun y : E => ‖y‖^N) := by
  obtain ⟨r, hr⟩ := hp
  have hd : HasFPowerSeriesAt (fderiv ℝ f) p.derivSeries a := ⟨r, hr.fderiv⟩
  simpa only [fderiv_partialSum] using hd.isBigO_sub_partialSum_pow N

/-- Taylor remainder for the second derivative in the full operator norm. -/
theorem fderiv_fderiv_remainder_isBigO {f : E → F} {p : FormalMultilinearSeries ℝ E F} {a : E}
    (hp : HasFPowerSeriesAt f p a) (N : ℕ) :
    (fun y => fderiv ℝ (fderiv ℝ f) (a + y) -
      fderiv ℝ (fderiv ℝ (p.partialSum (N + 2))) y)
      =O[𝓝 0] (fun y : E => ‖y‖^N) := by
  obtain ⟨r, hr⟩ := hp
  have hd : HasFPowerSeriesAt (fderiv ℝ (fderiv ℝ f)) p.derivSeries.derivSeries a :=
    ⟨r, by convert! hr.fderiv.fderiv⟩
  simpa only [fderiv_fderiv_partialSum] using hd.isBigO_sub_partialSum_pow N

/-- An exact identification of the initial Taylor polynomial gives its first
derivative as the leading term, with one higher order of remainder. -/
theorem fderiv_initial_remainder_isBigO {f H : E → F}
    {p : FormalMultilinearSeries ℝ E F} {a : E}
    (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d + 1) y = H y) :
    (fun y => fderiv ℝ f (a + y) - fderiv ℝ H y)
      =O[𝓝 0] (fun y : E => ‖y‖^d) := by
  have he : p.partialSum (d + 1) = H := funext hpoly
  simpa only [he] using fderiv_remainder_isBigO hp d

/-- For an initial term of positive degree d, the second derivative remainder
has order d-1. The degree-one case is included. -/
theorem fderiv_fderiv_initial_remainder_isBigO {f H : E → F}
    {p : FormalMultilinearSeries ℝ E F} {a : E}
    (hp : HasFPowerSeriesAt f p a) (d : ℕ) (hd : 0 < d)
    (hpoly : ∀ y, p.partialSum (d + 1) y = H y) :
    (fun y => fderiv ℝ (fderiv ℝ f) (a + y) - fderiv ℝ (fderiv ℝ H) y)
      =O[𝓝 0] (fun y : E => ‖y‖^(d - 1)) := by
  have he : p.partialSum ((d - 1) + 2) = H := by
    rw [show d - 1 + 2 = d + 1 by omega]
    exact funext hpoly
  simpa only [he] using fderiv_fderiv_remainder_isBigO hp (d - 1)

end Complete
end
end Source29AnalyticDerivativeRemainder

/- Component: HomogeneousDerivativeScaling.inc -/
namespace Source29HomogeneousDerivativeScaling

open Filter
open scoped Topology

noncomputable section
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- The exact chain rule for an affine dilation, including the canonical
zero derivative at points where differentiability fails. -/
theorem fderiv_affine_input (f : E → F) (a : E) (t : ℝ) (x : E) :
    fderiv ℝ (fun y => f (a + t • y)) x = t • fderiv ℝ f (a + t • x) := by
  have he := fderiv_comp_smul (𝕜 := ℝ) (f := fun z => f (a + z)) (x := x) t
  rw [fderiv_comp_add_left] at he
  convert! he

theorem fderiv_rescaled (f : E → F) (a : E) (d : ℕ) (t : ℝ) (x : E) :
    fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y)) x =
      ((t^d)⁻¹ * t) • fderiv ℝ f (a + t • x) := by
  change fderiv ℝ ((t^d)⁻¹ • (fun y => f (a + t • y))) x = _
  rw [fderiv_const_smul_field]
  change (t^d)⁻¹ • fderiv ℝ (fun y => f (a + t • y)) x = _
  rw [fderiv_affine_input, smul_smul]

theorem fderiv_fderiv_rescaled (f : E → F) (a : E) (d : ℕ) (t : ℝ) (x : E) :
    fderiv ℝ (fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y))) x =
      ((t^d)⁻¹ * t^2) • fderiv ℝ (fderiv ℝ f) (a + t • x) := by
  have he : fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y)) =
      fun y => ((t^d)⁻¹ * t) • fderiv ℝ f (a + t • y) :=
    funext (fderiv_rescaled f a d t)
  rw [he]
  change fderiv ℝ (((t^d)⁻¹ * t) • (fun y => fderiv ℝ f (a + t • y))) x = _
  have hs := congrFun (fderiv_const_smul_field (𝕜 := ℝ)
    (f := fun y => fderiv ℝ f (a + t • y)) ((t^d)⁻¹ * t)) x
  calc
    _ = ((t^d)⁻¹ * t) • fderiv ℝ (fun y => fderiv ℝ f (a + t • y)) x := by
      convert! hs
    _ = _ := by
      rw [fderiv_affine_input (fderiv ℝ f) a t x, smul_smul]
      congr 1
      ring

/-- Homogeneity lowers by one under the first derivative. This follows from
exact equivariance of the Fréchet derivative under invertible dilations. -/
theorem fderiv_homogeneous {H : E → F} (d : ℕ)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^(d+1) • H x) :
    ∀ (t : ℝ), 0 < t → ∀ x,
      fderiv ℝ H (t • x) = t^d • fderiv ℝ H x := by
  intro t ht x
  have hf : (fun y => H (t • y)) = t^(d+1) • H := funext (hH t ht)
  have he := congrArg (fun f : E → F => fderiv ℝ f x) hf
  rw [fderiv_comp_smul, fderiv_const_smul_field] at he
  change t • fderiv ℝ H (t • x) = t^(d+1) • fderiv ℝ H x at he
  have hm := congrArg (fun L : E →L[ℝ] F => t⁻¹ • L) he
  simpa only [smul_smul, inv_mul_cancel₀ ht.ne', one_smul, pow_succ',
    ← mul_assoc, inv_mul_cancel₀ ht.ne', one_mul] using hm

/-- Homogeneity lowers by two under the second derivative. -/
theorem fderiv_fderiv_homogeneous {H : E → F} (d : ℕ)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^(d+2) • H x) :
    ∀ (t : ℝ), 0 < t → ∀ x,
      fderiv ℝ (fderiv ℝ H) (t • x) = t^d • fderiv ℝ (fderiv ℝ H) x :=
  fderiv_homogeneous d (fderiv_homogeneous (d+1) hH)

omit [NormedSpace ℝ F] in
/-- A degree-zero homogeneous function continuous at the origin is constant. -/
theorem eq_origin_of_homogeneous_zero {H : E → F} (hcont : ContinuousAt H 0)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = H x) (x : E) : H x = H 0 := by
  have hx : Tendsto (fun t : ℝ => t • x) (𝓝 0) (𝓝 (0 : E)) := by
    have hc : Continuous (fun t : ℝ => t • x) := by fun_prop
    have ht := hc.tendsto (0 : ℝ)
    simpa only [zero_smul] using ht
  have hc : Tendsto (fun t : ℝ => H (t • x)) (𝓝 0) (𝓝 (H 0)) := hcont.tendsto.comp hx
  have ht : Tendsto (fun _t : ℝ => H x) (𝓝[>] 0) (𝓝 (H 0)) := by
    apply (hc.mono_left nhdsWithin_le_nhds).congr'
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact hH t ht x
  exact tendsto_nhds_unique tendsto_const_nhds ht

theorem fderiv_eq_zero_of_homogeneous_zero {H : E → F} (hcont : ContinuousAt H 0)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = H x) : fderiv ℝ H = 0 := by
  have he : H = fun _ => H 0 := funext (eq_origin_of_homogeneous_zero hcont hH)
  rw [he]
  funext x
  exact fderiv_const_apply (H 0)

/-- In degree one the second derivative vanishes, using continuity of the
first derivative at the origin. -/
theorem fderiv_fderiv_eq_zero_of_homogeneous_one {H : E → F}
    (hcont : ContinuousAt (fderiv ℝ H) 0)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t • H x) :
    fderiv ℝ (fderiv ℝ H) = 0 := by
  apply fderiv_eq_zero_of_homogeneous_zero hcont
  have he := fderiv_homogeneous 0 (H := H) (by simpa only [zero_add, pow_one] using hH)
  simpa only [pow_zero, one_smul] using he

end
end Source29HomogeneousDerivativeScaling

/- Component: AnalyticDerivativeScaling.inc -/
namespace Source29AnalyticDerivativeScaling

open Filter
open Source29AnalyticDerivativeRemainder Source29HomogeneousDerivativeScaling
open scoped Topology

noncomputable section
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

omit [CompleteSpace F] in
lemma analyticAt_of_partialSum_eq (p : FormalMultilinearSeries ℝ E F) (N : ℕ)
    {H : E → F} (hpoly : ∀ y, p.partialSum N y = H y) : AnalyticAt ℝ H 0 := by
  have he : p.partialSum N = H := funext hpoly
  rw [← he]
  exact (partialSum_hasFiniteFPowerSeries p N).toHasFPowerSeriesOnBall.analyticAt

/-- First derivatives of normalized analytic dilations converge uniformly on
bounded sets to the derivative of the initial homogeneous term. -/
theorem fderiv_tendstoUniformlyOn {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y)) x)
      (fderiv ℝ H) (𝓝[>] 0) S := by
  cases d with
  | zero =>
    obtain ⟨r, hr⟩ := hp
    have hpd : HasFPowerSeriesAt (fderiv ℝ f) p.derivSeries a := ⟨r, hr.fderiv⟩
    have ht := Source29WeightedInitialScaling.below_order_tendstoUniformlyOn_zero hpd 0
      (by intro k hk; omega) (-1) (by norm_num) S hS
    have hz : fderiv ℝ H = 0 := fderiv_eq_zero_of_homogeneous_zero
      (analyticAt_of_partialSum_eq p 1 hpoly).continuousAt
      (by simpa only [pow_zero, one_smul] using hH)
    rw [hz]
    apply ht.congr
    filter_upwards [self_mem_nhdsWithin] with t _
    intro x _
    dsimp only
    rw [fderiv_rescaled]
    simp only [neg_neg, Real.rpow_one, pow_zero, inv_one, one_mul]
  | succ d =>
    have ht := Source29HomogeneousRescalingLimit.tendstoUniformlyOn_of_isBounded d
      (fderiv_initial_remainder_isBigO hp (d+1) hpoly) (fderiv_homogeneous d hH) S hS
    apply ht.congr
    filter_upwards [self_mem_nhdsWithin] with t ht
    intro x _
    dsimp only
    rw [fderiv_rescaled]
    congr 1
    rw [pow_succ]
    field_simp [(show 0 < t from ht).ne']

/-- Second derivatives of normalized analytic dilations converge uniformly
on bounded sets. Degrees zero and one are included explicitly. -/
theorem fderiv_fderiv_tendstoUniformlyOn {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y))) x)
      (fderiv ℝ (fderiv ℝ H)) (𝓝[>] 0) S := by
  obtain ⟨r, hr⟩ := hp
  have hp : HasFPowerSeriesAt f p a := ⟨r, hr⟩
  have hpd : HasFPowerSeriesAt (fderiv ℝ (fderiv ℝ f)) p.derivSeries.derivSeries a :=
    ⟨r, by convert! hr.fderiv.fderiv⟩
  cases d with
  | zero =>
    have ht := Source29WeightedInitialScaling.below_order_tendstoUniformlyOn_zero hpd 0
      (by intro k hk; omega) (-2) (by norm_num) S hS
    have hz : fderiv ℝ H = 0 := fderiv_eq_zero_of_homogeneous_zero
      (analyticAt_of_partialSum_eq p 1 hpoly).continuousAt
      (by simpa only [pow_zero, one_smul] using hH)
    have hzz : fderiv ℝ (fderiv ℝ H) = 0 := by
      rw [hz]
      funext x
      exact fderiv_const_apply 0
    rw [hzz]
    apply ht.congr
    filter_upwards [self_mem_nhdsWithin] with t _
    intro x _
    dsimp only
    rw [fderiv_fderiv_rescaled]
    simp only [neg_neg, Real.rpow_two, pow_zero, inv_one, one_mul]
  | succ d =>
    cases d with
    | zero =>
      have ht := Source29WeightedInitialScaling.below_order_tendstoUniformlyOn_zero hpd 0
        (by intro k hk; omega) (-1) (by norm_num) S hS
      have hz : fderiv ℝ (fderiv ℝ H) = 0 := fderiv_fderiv_eq_zero_of_homogeneous_one
        (analyticAt_of_partialSum_eq p 2 hpoly).fderiv.continuousAt
        (by simpa only [Nat.zero_add, pow_one] using hH)
      rw [hz]
      apply ht.congr
      filter_upwards [self_mem_nhdsWithin] with t ht
      intro x _
      dsimp only
      rw [fderiv_fderiv_rescaled]
      simp only [neg_neg, Real.rpow_one, Nat.zero_add, pow_one]
      congr 1
      field_simp [(show 0 < t from ht).ne']
    | succ d =>
      have hrem := fderiv_fderiv_initial_remainder_isBigO hp (d+2) (by omega) hpoly
      have ht := Source29HomogeneousRescalingLimit.tendstoUniformlyOn_of_isBounded
        (f := fderiv ℝ (fderiv ℝ f)) (q := fderiv ℝ (fderiv ℝ H)) (a := a) d
        (by simpa only [show d + 2 - 1 = d + 1 by omega] using hrem) (fderiv_fderiv_homogeneous d hH) S hS
      apply ht.congr
      filter_upwards [self_mem_nhdsWithin] with t ht
      intro x _
      dsimp only
      rw [fderiv_fderiv_rescaled]
      congr 1
      rw [pow_add]
      field_simp [(show 0 < t from ht).ne']
      ring

/-- Initial-series form of the first derivative limit. Only diagonal
vanishing is required of the lower Taylor coefficients. -/
theorem initial_fderiv_tendstoUniformlyOn {f : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ => x) = 0)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y)) x)
      (fderiv ℝ (fun x => p d (fun _ => x))) (𝓝[>] 0) S :=
  fderiv_tendstoUniformlyOn hp d
    (Source29AnalyticInitialRemainder.partialSum_eq_initial p d hlow)
    (fun t _ x => Source29AnalyticInitialRemainder.diagonal_smul p d t x) S hS

/-- Initial-series form of the second derivative limit, including degrees
zero and one. -/
theorem initial_fderiv_fderiv_tendstoUniformlyOn {f : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ => x) = 0)
    (S : Set E) (hS : Bornology.IsBounded S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => (t^d)⁻¹ • f (a + t • y))) x)
      (fderiv ℝ (fderiv ℝ (fun x => p d (fun _ => x)))) (𝓝[>] 0) S :=
  fderiv_fderiv_tendstoUniformlyOn hp d
    (Source29AnalyticInitialRemainder.partialSum_eq_initial p d hlow)
    (fun t _ x => Source29AnalyticInitialRemainder.diagonal_smul p d t x) S hS

end
end Source29AnalyticDerivativeScaling

/- Component: WeightedAnalyticDerivativeScaling.inc -/
namespace Source29WeightedAnalyticDerivativeScaling

open Filter
open Source29AnalyticDerivativeRemainder Source29AnalyticDerivativeScaling
open scoped Topology

noncomputable section
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

lemma analyticAt_of_partialSum_eq_all (p : FormalMultilinearSeries ℝ E F) (N : ℕ)
    {H : E → F} (hpoly : ∀ y, p.partialSum N y = H y) (x : E) :
    AnalyticAt ℝ H x := by
  have he : p.partialSum N = H := funext hpoly
  rw [← he]
  exact (partialSum_hasFiniteFPowerSeries p N).toHasFPowerSeriesOnBall.analyticAt_of_mem
    (by simp)

omit [CompleteSpace F] in
lemma weighted_fderiv_factor (f : E → F) (a : E) (d : ℕ) (β t : ℝ)
    (ht : 0 < t) (x : E) :
    t^((d : ℝ)-β) • fderiv ℝ (fun y => (t^d)⁻¹ • f (a+t•y)) x =
      fderiv ℝ (fun y => t^(-β) • f (a+t•y)) x := by
  have he : (fun y => t^(-β) • f (a+t•y)) =
      t^((d : ℝ)-β) • (fun y => (t^d)⁻¹ • f (a+t•y)) :=
    funext (fun y => (Source29WeightedInitialScaling.weighted_factor t β d ht (f (a+t•y))).symm)
  rw [he, fderiv_const_smul_field]
  rfl

omit [CompleteSpace F] in
lemma weighted_fderiv_fderiv_factor (f : E → F) (a : E) (d : ℕ) (β t : ℝ)
    (ht : 0 < t) (x : E) :
    t^((d : ℝ)-β) • fderiv ℝ (fderiv ℝ (fun y => (t^d)⁻¹ • f (a+t•y))) x =
      fderiv ℝ (fderiv ℝ (fun y => t^(-β) • f (a+t•y))) x := by
  have he : (fun y => t^(-β) • f (a+t•y)) =
      t^((d : ℝ)-β) • (fun y => (t^d)⁻¹ • f (a+t•y)) :=
    funext (fun y => (Source29WeightedInitialScaling.weighted_factor t β d ht (f (a+t•y))).symm)
  rw [he, fderiv_const_smul_field]
  have hs := congrFun (fderiv_const_smul_field (𝕜 := ℝ)
    (f := fderiv ℝ (fun y => (t^d)⁻¹ • f (a+t•y))) (t^((d : ℝ)-β))) x
  convert! hs.symm

lemma positive_power_tendsto_zero (d : ℕ) (β : ℝ) (hβ : β < (d : ℝ)) :
    Tendsto (fun t : ℝ => t^((d : ℝ)-β)) (𝓝[>] 0) (𝓝 0) := by
  have hc := (Real.continuousAt_rpow_const 0 ((d : ℝ)-β) (Or.inr (by linarith))).tendsto
  have hz : (0 : ℝ)^((d : ℝ)-β) = 0 := Real.zero_rpow (by linarith)
  rw [hz] at hc
  exact hc.mono_left nhdsWithin_le_nhds

/-- A weight strictly below the Taylor order kills the first derivative
uniformly on compact sets. The bound for the limiting derivative is derived
from the finite Taylor polynomial. -/
theorem below_order_fderiv_tendstoUniformlyOn_zero {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (β : ℝ) (hβ : β < (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fun y => t^(-β) • f (a+t•y)) x) (fun _ => 0) (𝓝[>] 0) S := by
  have hF := fderiv_tendstoUniformlyOn hp d hpoly hH S hS.isBounded
  have hc : Continuous (fderiv ℝ H) := continuous_iff_continuousAt.mpr
    (fun x => (analyticAt_of_partialSum_eq_all p (d+1) hpoly x).fderiv.continuousAt)
  obtain ⟨B,hB⟩ := (hS.image hc).isBounded.exists_norm_le
  have ht := Source29WeightedInitialScaling.scalar_smul_tendstoUniformlyOn_zero hF
    (positive_power_tendsto_zero d β hβ) B (fun x hx => hB _ ⟨x,hx,rfl⟩)
  apply ht.congr
  filter_upwards [self_mem_nhdsWithin] with t ht
  intro x _
  exact weighted_fderiv_factor f a d β t ht x

/-- The second derivative also vanishes under every strict lower weight,
including Taylor orders zero and one. -/
theorem below_order_fderiv_fderiv_tendstoUniformlyOn_zero {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (β : ℝ) (hβ : β < (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => t^(-β) • f (a+t•y))) x)
      (fun _ => 0) (𝓝[>] 0) S := by
  have hF := fderiv_fderiv_tendstoUniformlyOn hp d hpoly hH S hS.isBounded
  have hc : Continuous (fderiv ℝ (fderiv ℝ H)) := continuous_iff_continuousAt.mpr
    (fun x => (analyticAt_of_partialSum_eq_all p (d+1) hpoly x).fderiv.fderiv.continuousAt)
  have hbounded : Bornology.IsBounded ((fderiv ℝ (fderiv ℝ H)) '' S) := by
    apply IsCompact.isBounded
    convert! hS.image hc
  obtain ⟨B,hB⟩ := hbounded.exists_norm_le
  have ht := Source29WeightedInitialScaling.scalar_smul_tendstoUniformlyOn_zero
    (V := E →L[ℝ] (E →L[ℝ] F)) (q := fderiv ℝ (fderiv ℝ H))
    (F := fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => (t^d)⁻¹ • f (a+t•y))) x)
    (by convert! hF) (positive_power_tendsto_zero d β hβ) B
    (fun x hx => by convert! hB _ ⟨x,hx,rfl⟩)
  apply ht.congr
  filter_upwards [self_mem_nhdsWithin] with t ht
  intro x _
  exact weighted_fderiv_fderiv_factor f a d β t ht x

/-- The first derivative of a weighted dilation retains the initial
polynomial precisely at its Taylor weight. -/
theorem at_or_below_order_fderiv_tendstoUniformlyOn {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (β : ℝ) (hβ : β ≤ (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fun y => t^(-β) • f (a+t•y)) x)
      (fun x => if β = (d : ℝ) then fderiv ℝ H x else 0) (𝓝[>] 0) S := by
  classical
  rcases lt_or_eq_of_le hβ with hlt | heq
  · simpa only [ne_of_lt hlt, ite_false] using
      below_order_fderiv_tendstoUniformlyOn_zero hp d hpoly hH β hlt S hS
  · subst β
    simp only [ite_true]
    apply (fderiv_tendstoUniformlyOn hp d hpoly hH S hS.isBounded).congr
    filter_upwards [self_mem_nhdsWithin] with t ht
    intro x _
    simp only [Real.rpow_neg (le_of_lt ht), Real.rpow_natCast]

/-- The same weight selection holds for the second derivative. -/
theorem at_or_below_order_fderiv_fderiv_tendstoUniformlyOn {f H : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hpoly : ∀ y, p.partialSum (d+1) y = H y)
    (hH : ∀ (t : ℝ), 0 < t → ∀ x, H (t • x) = t^d • H x)
    (β : ℝ) (hβ : β ≤ (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => t^(-β) • f (a+t•y))) x)
      (fun x => if β = (d : ℝ) then fderiv ℝ (fderiv ℝ H) x else 0) (𝓝[>] 0) S := by
  classical
  rcases lt_or_eq_of_le hβ with hlt | heq
  · simpa only [ne_of_lt hlt, ite_false] using
      below_order_fderiv_fderiv_tendstoUniformlyOn_zero hp d hpoly hH β hlt S hS
  · subst β
    simp only [ite_true]
    apply (fderiv_fderiv_tendstoUniformlyOn hp d hpoly hH S hS.isBounded).congr
    filter_upwards [self_mem_nhdsWithin] with t ht
    intro x _
    simp only [Real.rpow_neg (le_of_lt ht), Real.rpow_natCast]

/-- Initial-series version of weighted first-derivative convergence. -/
theorem initial_fderiv_tendstoUniformlyOn {f : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ => x) = 0)
    (β : ℝ) (hβ : β ≤ (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fun y => t^(-β) • f (a+t•y)) x)
      (fun x => if β = (d : ℝ) then fderiv ℝ (fun y => p d (fun _ => y)) x else 0)
      (𝓝[>] 0) S :=
  at_or_below_order_fderiv_tendstoUniformlyOn hp d
    (Source29AnalyticInitialRemainder.partialSum_eq_initial p d hlow)
    (fun t _ x => Source29AnalyticInitialRemainder.diagonal_smul p d t x) β hβ S hS

/-- Initial-series version of weighted second-derivative convergence. -/
theorem initial_fderiv_fderiv_tendstoUniformlyOn {f : E → F} {a : E}
    {p : FormalMultilinearSeries ℝ E F} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ => x) = 0)
    (β : ℝ) (hβ : β ≤ (d : ℝ)) (S : Set E) (hS : IsCompact S) :
    TendstoUniformlyOn (fun t : ℝ => fun x =>
      fderiv ℝ (fderiv ℝ (fun y => t^(-β) • f (a+t•y))) x)
      (fun x => if β = (d : ℝ) then
        fderiv ℝ (fderiv ℝ (fun y => p d (fun _ => y))) x else 0) (𝓝[>] 0) S :=
  at_or_below_order_fderiv_fderiv_tendstoUniformlyOn hp d
    (Source29AnalyticInitialRemainder.partialSum_eq_initial p d hlow)
    (fun t _ x => Source29AnalyticInitialRemainder.diagonal_smul p d t x) β hβ S hS

end
end Source29WeightedAnalyticDerivativeScaling

/- Component: NewtonWeightedFace.inc -/
namespace Source29NewtonWeightedFace

open MvPolynomial
open Source29NewtonNormalDerivative Source29NewtonPureNormalPower
open Source29QuarticReuse
open scoped BigOperators

noncomputable section
variable {n d : ℕ}

/-- A finite Newton face with a fixed scalar top normal coefficient. -/
def face (c : ℝ) (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ) :
    MvPolynomial (Fin (n + 1)) ℝ :=
  C c * (X 0)^d + ∑ j ∈ S, rename Fin.succ (P j) * (X 0)^(j : ℕ)

lemma eval_face (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) (x : ℝ) (y : Fin n → ℝ) :
    eval (Fin.cons x y) (face c S P) =
      c * x^d + ∑ j ∈ S, eval y (P j) * x^(j : ℕ) := by
  simp only [face, map_add, map_sum, map_mul, map_pow, eval_C, eval_X,
    Fin.cons_zero, eval_rename, Function.comp_def, Fin.cons_succ]

lemma finSuccEquiv_rename_succ (P : MvPolynomial (Fin n) ℝ) :
    finSuccEquiv ℝ n (rename Fin.succ P) = Polynomial.C P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp only [rename_C, finSuccEquiv_C_scalar]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP => simp only [map_mul, rename_X, finSuccEquiv_X_succ, hP]

lemma finSuccEquiv_face (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) :
    finSuccEquiv ℝ n (face c S P) =
      Polynomial.C (C c) * Polynomial.X^d +
        ∑ j ∈ S, Polynomial.C (P j) * Polynomial.X^(j : ℕ) := by
  simp only [face, map_add, map_sum, map_mul, map_pow,
    finSuccEquiv_rename_succ, finSuccEquiv_C_scalar, finSuccEquiv_X_zero]

lemma top_coefficient (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) :
    (finSuccEquiv ℝ n (face c S P)).coeff d = C c := by
  rw [finSuccEquiv_face, Polynomial.coeff_add, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow, ↓reduceIte]
  have hz : ∑ j ∈ S, (if d = (j : ℕ) then P j else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro j hj
    exact ite_eq_right (ne_of_gt j.isLt)
  rw [hz, add_zero]

lemma coefficient_above (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : d < k) :
    (finSuccEquiv ℝ n (face c S P)).coeff k = 0 := by
  rw [finSuccEquiv_face, Polynomial.coeff_add, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow, ne_of_gt hk, ↓reduceIte, zero_add]
  apply Finset.sum_eq_zero
  intro j hj
  exact ite_eq_right (ne_of_gt (lt_trans j.isLt hk))

lemma normal_degree_le (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) :
    (finSuccEquiv ℝ n (face c S P)).natDegree ≤ d :=
  Polynomial.natDegree_le_iff_coeff_eq_zero.mpr (coefficient_above c S P)

lemma normal_degree_eq (c : ℝ) (hc : c ≠ 0) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) :
    (finSuccEquiv ℝ n (face c S P)).natDegree = d := by
  apply le_antisymm (normal_degree_le c S P)
  apply Polynomial.le_natDegree_of_ne_zero
  rw [top_coefficient]
  simpa only [ne_eq, C_eq_zero] using hc

lemma lower_coefficient (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) (j : Fin d) :
    (finSuccEquiv ℝ n (face c S P)).coeff (j : ℕ) = if j ∈ S then P j else 0 := by
  rw [finSuccEquiv_face, Polynomial.coeff_add, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow, ne_of_lt j.isLt, ↓reduceIte, zero_add]
  convert Finset.sum_ite_eq S j P using 1
  apply Finset.sum_congr rfl
  intro k hk
  simp only [Fin.ext_iff]

lemma ne_pure_normal_power (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) (j : Fin d) (hj : j ∈ S) (hP : P j ≠ 0) :
    face c S P ≠ C c * (X 0)^d := by
  intro he
  have hc := congrArg (fun N : MvPolynomial (Fin (n + 1)) ℝ ↦
    (finSuccEquiv ℝ n N).coeff (j : ℕ)) he
  rw [lower_coefficient, ite_eq_left hj] at hc
  simp only [map_mul, map_pow, finSuccEquiv_C_scalar, finSuccEquiv_X_zero,
    Polynomial.coeff_C_mul_X_pow, ne_of_lt j.isLt, ↓reduceIte] at hc
  exact hP hc

lemma pderiv_zero_rename_succ (P : MvPolynomial (Fin n) ℝ) :
    pderiv 0 (rename Fin.succ P) = 0 := by
  induction P using MvPolynomial.induction_on with
  | C c => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ, add_zero]
  | mul_X P i hP =>
    simp only [map_mul, rename_X, pderiv_mul, hP, zero_mul,
      pderiv_X_of_ne (Fin.succ_ne_zero i), mul_zero, add_zero]

lemma normal_term_euler (P : MvPolynomial (Fin n) ℝ) (j : ℕ) :
    X 0 * pderiv 0 (rename Fin.succ P * (X 0)^j) =
      C (j : ℝ) * (rename Fin.succ P * (X 0)^j) := by
  rw [pderiv_mul, pderiv_zero_rename_succ, zero_mul, zero_add,
    pderiv_pow, pderiv_X_self, mul_one]
  cases j with
  | zero => simp
  | succ j => simp only [Nat.add_sub_cancel, map_natCast, pow_succ]; ring

lemma tangential_term_euler (P : MvPolynomial (Fin n) ℝ) (j v : ℕ)
    (hP : P.IsHomogeneous v) :
    (∑ i : Fin n, X i.succ * pderiv i.succ (rename Fin.succ P * (X 0)^j)) =
      C (v : ℝ) * (rename Fin.succ P * (X 0)^j) := by
  have he := congrArg (rename Fin.succ) (QuarticCompatibility.sum_X_mul_pderiv hP)
  simp only [map_sum, map_mul, rename_X, nsmul_eq_mul] at he
  simp only [pderiv_mul, pderiv_pow, pderiv_X_of_ne (Fin.succ_ne_zero _).symm,
    mul_zero, add_zero, pderiv_rename (Fin.succ_injective n)]
  calc
    _ = (∑ i : Fin n, X i.succ * rename Fin.succ (pderiv i P)) * (X 0)^j := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ = _ := by rw [he]; simp only [map_natCast]; ring

lemma term_weightedEuler (P : MvPolynomial (Fin n) ℝ) (j v : ℕ)
    (hP : P.IsHomogeneous v) (α D : ℝ) (hw : α * j + v = D) :
    WeightedEuler (rename Fin.succ P * (X 0)^j) α D := by
  unfold WeightedEuler
  rw [mul_assoc, normal_term_euler, tangential_term_euler P j v hP]
  rw [← mul_assoc, ← map_mul, ← add_mul, ← map_add, hw]

lemma WeightedEuler_add (P Q : MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ)
    (hP : WeightedEuler P α D) (hQ : WeightedEuler Q α D) :
    WeightedEuler (P + Q) α D := by
  unfold WeightedEuler at *
  simp only [map_add, mul_add, Finset.sum_add_distrib]
  linear_combination hP + hQ

lemma WeightedEuler_sum {ι : Type*} (S : Finset ι)
    (P : ι → MvPolynomial (Fin (n + 1)) ℝ) (α D : ℝ)
    (hP : ∀ j ∈ S, WeightedEuler (P j) α D) :
    WeightedEuler (∑ j ∈ S, P j) α D := by
  classical
  induction S using Finset.induction_on with
  | empty => simp only [Finset.sum_empty, WeightedEuler, map_zero, mul_zero,
      Finset.sum_const_zero, add_zero]
  | @insert j S hj ih =>
    rw [Finset.sum_insert hj]
    apply WeightedEuler_add _ _ α D (hP j (Finset.mem_insert_self j S))
    exact ih (fun k hk ↦ hP k (Finset.mem_insert_of_mem hk))

/-- Weighted Euler is inherited from each selected tangential homogeneous coefficient. -/
theorem weightedEuler (c : ℝ) (S : Finset (Fin d))
    (P : Fin d → MvPolynomial (Fin n) ℝ) (v : Fin d → ℕ) (α : ℝ)
    (hP : ∀ j ∈ S, (P j).IsHomogeneous (v j))
    (hw : ∀ j ∈ S, (v j : ℝ) = α * ((d : ℝ) - (j : ℕ))) :
    WeightedEuler (face c S P) α (α * d) := by
  unfold face
  apply WeightedEuler_add
  · have hc : (C c : MvPolynomial (Fin n) ℝ).IsHomogeneous 0 := isHomogeneous_C _ _
    simpa only [rename_C] using term_weightedEuler (C c) d 0 hc α (α * d) (by ring)
  · apply WeightedEuler_sum
    intro j hj
    apply term_weightedEuler (P j) (j : ℕ) (v j) (hP j hj)
    rw [hw j hj]
    ring

end
end Source29NewtonWeightedFace

/- Component: NewtonFaceSelection.inc -/
namespace Source29NewtonFaceSelection

open MvPolynomial
open Source29NewtonNormalDerivative Source29NewtonWeightedFace
open scoped BigOperators

noncomputable section
variable {n d : ℕ}

/-- The first nontrivial Newton slope is attained in a finite coefficient family. -/
theorem exists_minimum_ratio (S : Finset (Fin d)) (hS : S.Nonempty)
    (v : Fin d → ℕ) (hv : ∀ j ∈ S, d - (j : ℕ) < v j) :
    ∃ α : ℝ, 1 < α ∧
      (∀ j ∈ S, α * ((d : ℝ) - (j : ℕ)) ≤ v j) ∧
      ∃ j ∈ S, (v j : ℝ) = α * ((d : ℝ) - (j : ℕ)) := by
  let q : Fin d → ℝ := fun j ↦ (v j : ℝ) / ((d : ℝ) - (j : ℕ))
  obtain ⟨j, hj, hmin⟩ := S.exists_min_image q hS
  have hden : ∀ k : Fin d, 0 < (d : ℝ) - (k : ℕ) := by
    intro k
    exact sub_pos.mpr (by exact_mod_cast k.isLt)
  have hlarge : (d : ℝ) - (j : ℕ) < (v j : ℝ) := by
    have hc : ((d - (j : ℕ) : ℕ) : ℝ) < (v j : ℝ) := by exact_mod_cast hv j hj
    simpa only [Nat.cast_sub j.isLt.le] using hc
  refine ⟨q j, ?_, ?_, j, hj, ?_⟩
  · exact (one_lt_div (hden j)).2 hlarge
  · intro k hk
    exact (le_div_iff₀ (hden k)).1 (hmin k hk)
  · exact (div_mul_cancel₀ (v j : ℝ) (hden j).ne').symm

/-- Select precisely the nonzero initial coefficients lying on the first face.
The other nonzero coefficient orders lie on or above it. -/
theorem exists_selected_face (P : Fin d → MvPolynomial (Fin n) ℝ)
    (v : Fin d → ℕ) (hne : ∃ j, P j ≠ 0)
    (hv : ∀ j, P j ≠ 0 → d - (j : ℕ) < v j) :
    ∃ (α : ℝ) (S : Finset (Fin d)), 1 < α ∧
      (∀ j, P j ≠ 0 → α * ((d : ℝ) - (j : ℕ)) ≤ v j) ∧
      (∀ j, j ∈ S ↔ P j ≠ 0 ∧ (v j : ℝ) = α * ((d : ℝ) - (j : ℕ))) ∧
      S.Nonempty := by
  classical
  let T : Finset (Fin d) := Finset.univ.filter fun j ↦ P j ≠ 0
  have hT : T.Nonempty := by
    obtain ⟨j, hj⟩ := hne
    exact ⟨j, by simp only [T, Finset.mem_filter, Finset.mem_univ, true_and]; exact hj⟩
  obtain ⟨α, hα, hlow, j, hj, heq⟩ := exists_minimum_ratio T hT v (by
    intro k hk
    exact hv k (Finset.mem_filter.mp hk).2)
  let S : Finset (Fin d) := T.filter fun j ↦ (v j : ℝ) = α * ((d : ℝ) - (j : ℕ))
  refine ⟨α, S, hα, ?_, ?_, j, ?_⟩
  · intro k hk
    exact hlow k (by simp only [T, Finset.mem_filter, Finset.mem_univ, true_and]; exact hk)
  · intro k
    simp only [S, T, Finset.mem_filter, Finset.mem_univ, true_and]
  · exact Finset.mem_filter.mpr ⟨hj, heq⟩

/-- A selected nonzero coefficient contradicts the Newton equation and the two
normal half-space signs, by the proved polynomial rigidity theorem. -/
theorem selected_face_contradiction (c : ℝ) (hc : c ≠ 0)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (v : Fin d → ℕ) (α : ℝ) (hα : 0 < α)
    (hP : ∀ j ∈ S, (P j).IsHomogeneous (v j))
    (hw : ∀ j ∈ S, (v j : ℝ) = α * ((d : ℝ) - (j : ℕ)))
    (j : Fin d) (hj : j ∈ S) (hne : P j ≠ 0)
    (hE : newtonResidual (face c S P) = 0)
    (hpos : ∀ z : Fin (n + 1) → ℝ, 0 < z 0 → 0 ≤ eval z (face c S P))
    (hneg : ∀ z : Fin (n + 1) → ℝ, z 0 < 0 → eval z (face c S P) ≤ 0) : False := by
  have hd : 0 < d := lt_of_le_of_lt (Nat.zero_le (j : ℕ)) j.isLt
  have hD : 0 < α * (d : ℝ) := mul_pos hα (by exact_mod_cast hd)
  apply ne_pure_normal_power c S P j hj hne
  exact Source29NewtonPolynomialRigidity.eq_pure_normal_power
    (face c S P) α (α * d) hD (weightedEuler c S P v α hP hw)
    hE hpos hneg d hd c hc (top_coefficient c S P)

end
end Source29NewtonFaceSelection

/- Component: NewtonFiniteRescaling.inc -/
namespace Source29NewtonFiniteRescaling

open Filter
open scoped BigOperators Topology

noncomputable section

/-- A fixed bounded multiplier preserves real uniform convergence. No bound
on the limiting function is required. -/
lemma uniform_mul_bounded {ι A : Type*} {l : Filter ι} {K : Set A}
    {F : ι → A → ℝ} {f g : A → ℝ} (hF : TendstoUniformlyOn F f l K)
    (B : ℝ) (hB : 0 ≤ B) (hg : ∀ x ∈ K, |g x| ≤ B) :
    TendstoUniformlyOn (fun t x ↦ F t x * g x) (fun x ↦ f x * g x) l K := by
  rw [Metric.tendstoUniformlyOn_iff] at hF ⊢
  intro ε hε
  have hBp : 0 < B + 1 := by linarith
  filter_upwards [hF (ε / (B + 1)) (div_pos hε hBp)] with t ht x hx
  calc
    dist (f x * g x) (F t x * g x) = dist (f x) (F t x) * |g x| := by
      simp only [Real.dist_eq, ← sub_mul, abs_mul]
    _ ≤ dist (f x) (F t x) * (B + 1) :=
      mul_le_mul_of_nonneg_left (le_trans (hg x hx) (by linarith)) dist_nonneg
    _ < (ε / (B + 1)) * (B + 1) := mul_lt_mul_of_pos_right (ht x hx) hBp
    _ = ε := div_mul_cancel₀ ε hBp.ne'

lemma uniform_finite_sum {ι J A : Type*} {l : Filter ι} {K : Set A}
    (S : Finset J) (F : J → ι → A → ℝ) (f : J → A → ℝ)
    (hF : ∀ j ∈ S, TendstoUniformlyOn (F j) (f j) l K) :
    TendstoUniformlyOn (fun t x ↦ ∑ j ∈ S, F j t x) (fun x ↦ ∑ j ∈ S, f j x) l K := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    filter_upwards [] with t x hx
    simpa only [Finset.sum_empty, dist_self] using hε
  | @insert j S hj ih =>
    have h1 := hF j (Finset.mem_insert_self j S)
    have h2 := ih (fun k hk ↦ hF k (Finset.mem_insert_of_mem hk))
    have h := h1.add h2
    change TendstoUniformlyOn (fun t x ↦ F j t x + ∑ k ∈ S, F k t x)
      (fun x ↦ f j x + ∑ k ∈ S, f k x) l K at h
    simpa only [Finset.sum_insert hj] using h

/-- A finite expansion in the normal variable, with arbitrary tangential coefficients. -/
def expansion {J : Type*} {A : Type*} (S : Finset J) (degree : J → ℕ)
    (a : J → A → ℝ) (x : ℝ) (y : A) : ℝ :=
  ∑ j ∈ S, a j y * x^(degree j)

lemma scaled_term (a x ε α D : ℝ) (j : ℕ) (hε : 0 < ε) :
    (a * (ε ^ α * x)^j) / ε ^ D =
      (ε ^ (α * (j : ℝ) - D) * a) * x^j := by
  rw [mul_pow, ← Real.rpow_mul_natCast hε.le, Real.rpow_sub hε]
  ring

/-- Exact algebra behind the coefficient-by-coefficient Newton scaling. -/
lemma scaled_expansion {J A : Type*} (S : Finset J) (degree : J → ℕ)
    (a : J → A → ℝ) (x ε α D : ℝ) (y : A) (hε : 0 < ε) :
    expansion S degree a (ε ^ α * x) y / ε ^ D =
      ∑ j ∈ S, (ε ^ (α * (degree j : ℝ) - D) * a j y) * x^(degree j) := by
  unfold expansion
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro j hj
  exact scaled_term _ _ _ _ _ _ hε

/-- Uniform limits of the scaled coefficient functions assemble into the
uniform Newton limit on every bounded set of normal coordinates. The index
set may contain arbitrary higher normal degrees, whose limiting coefficient
can be set to zero. -/
theorem expansion_uniform_limit {J : Type*} {n : ℕ}
    (S : Finset J) (degree : J → ℕ)
    (a b : J → (Fin n → ℝ) → ℝ) (α D R : ℝ) (hR : 0 ≤ R)
    (K : Set (Fin n → ℝ))
    (ha : ∀ j ∈ S, TendstoUniformlyOn
      (fun ε y ↦ ε ^ (α * (degree j : ℝ) - D) * a j (ε • y))
      (b j) (𝓝[>] (0 : ℝ)) K) :
    TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        expansion S degree a (ε ^ α * z.1) (ε • z.2) / ε ^ D)
      (fun z ↦ expansion S degree b z.1 z.2)
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
  have hterm : ∀ j ∈ S, TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        (ε ^ (α * (degree j : ℝ) - D) * a j (ε • z.2)) * z.1^(degree j))
      (fun z ↦ b j z.2 * z.1^(degree j))
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
    intro j hj
    have hcomp := ((ha j hj).comp (fun z : ℝ × (Fin n → ℝ) ↦ z.2)).mono
      (show ({x : ℝ | |x| ≤ R} ×ˢ K) ⊆ (fun z : ℝ × (Fin n → ℝ) ↦ z.2) ⁻¹' K from
        fun z hz ↦ hz.2)
    apply uniform_mul_bounded hcomp (R^(degree j)) (pow_nonneg hR _)
    intro z hz
    rw [abs_pow]
    exact pow_le_pow_left₀ (abs_nonneg _) hz.1 _
  have hsum := uniform_finite_sum S _ _ hterm
  apply hsum.congr
  filter_upwards [self_mem_nhdsWithin] with ε hε z hz
  exact (scaled_expansion S degree a z.1 ε α D (ε • z.2) hε).symm

/-- Identify the source and limit of a finite normal expansion with named functions. -/
theorem function_uniform_limit {J : Type*} {n : ℕ}
    (S : Finset J) (degree : J → ℕ)
    (a b : J → (Fin n → ℝ) → ℝ) (f g : ℝ → (Fin n → ℝ) → ℝ)
    (hf : ∀ x y, f x y = expansion S degree a x y)
    (hg : ∀ x y, g x y = expansion S degree b x y)
    (α D R : ℝ) (hR : 0 ≤ R) (K : Set (Fin n → ℝ))
    (ha : ∀ j ∈ S, TendstoUniformlyOn
      (fun ε y ↦ ε ^ (α * (degree j : ℝ) - D) * a j (ε • y))
      (b j) (𝓝[>] (0 : ℝ)) K) :
    TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        f (ε ^ α * z.1) (ε • z.2) / ε ^ D)
      (fun z ↦ g z.1 z.2)
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
  have h := expansion_uniform_limit S degree a b α D R hR K ha
  have hf' : f = fun x y ↦ expansion S degree a x y := by
    funext x y
    exact hf x y
  have hg' : g = fun x y ↦ expansion S degree b x y := by
    funext x y
    exact hg x y
  rw [hf', hg']
  exact h

end
end Source29NewtonFiniteRescaling

/- Component: NewtonShiftedExpansion.inc -/
namespace Source29NewtonShiftedExpansion

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonShiftedFactorCoefficient
open Source29NewtonFiniteRescaling
open scoped BigOperators Topology

noncomputable section
variable {n : ℕ}

lemma shiftedSlice_natDegree_le (F : MvPolynomial (Fin (n + 1)) ℝ)
    (s : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).natDegree ≤ (finSuccEquiv ℝ n F).natDegree := by
  rw [shiftedSlice, Polynomial.natDegree_taylor]
  change ((finSuccEquiv ℝ n F).map (eval y)).natDegree ≤ _
  exact Polynomial.natDegree_map_le

/-- The normal expansion remains finite after any tangentially dependent
normal shift; no regularity of the shift is needed for this identity. -/
theorem shifted_finite_expansion (F : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (m : ℕ) (hm : (finSuccEquiv ℝ n F).natDegree < m)
    (x : ℝ) (y : Fin n → ℝ) :
    eval (Fin.cons (g y + x) y) F =
      expansion (Finset.range m) id (fun j y ↦ (shiftedSlice F (g y) y).coeff j) x y := by
  rw [← eval_shiftedSlice]
  exact Polynomial.eval_eq_sum_range'
    (lt_of_le_of_lt (shiftedSlice_natDegree_le F (g y) y) hm) x

lemma slice_coefficient (F : MvPolynomial (Fin (n + 1)) ℝ)
    (y : Fin n → ℝ) (j : ℕ) :
    (sliceHom y F).coeff j = eval y ((finSuccEquiv ℝ n F).coeff j) := by
  change ((finSuccEquiv ℝ n F).map (eval y)).coeff j = _
  exact Polynomial.coeff_map (eval y) j

/-- An ordinary polynomial target has the same finite expansion with its
normal coefficients evaluated in the tangential variables. -/
theorem polynomial_finite_expansion (N : MvPolynomial (Fin (n + 1)) ℝ)
    (m : ℕ) (hm : (finSuccEquiv ℝ n N).natDegree < m)
    (x : ℝ) (y : Fin n → ℝ) :
    eval (Fin.cons x y) N = expansion (Finset.range m) id
      (fun j y ↦ eval y ((finSuccEquiv ℝ n N).coeff j)) x y := by
  rw [← eval_sliceHom]
  have hdeg : (sliceHom y N).natDegree < m := by
    apply lt_of_le_of_lt _ hm
    change ((finSuccEquiv ℝ n N).map (eval y)).natDegree ≤ _
    exact Polynomial.natDegree_map_le
  rw [Polynomial.eval_eq_sum_range' hdeg]
  simp only [expansion, id_eq, slice_coefficient]

/-- Once every scaled normal coefficient has its stated uniform limit, the
actual shifted polynomial converges to the claimed Newton polynomial.
The finite range includes all normal degrees of both polynomials. -/
theorem shifted_polynomial_uniform_limit (F N : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (m : ℕ)
    (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hN : (finSuccEquiv ℝ n N).natDegree < m)
    (α D R : ℝ) (hR : 0 ≤ R) (K : Set (Fin n → ℝ))
    (ha : ∀ j < m, TendstoUniformlyOn
      (fun ε y ↦ ε ^ (α * (j : ℝ) - D) *
        (shiftedSlice F (g (ε • y)) (ε • y)).coeff j)
      (fun y ↦ eval y ((finSuccEquiv ℝ n N).coeff j))
      (𝓝[>] (0 : ℝ)) K) :
    TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        eval (Fin.cons (g (ε • z.2) + ε ^ α * z.1) (ε • z.2)) F / ε ^ D)
      (fun z ↦ eval (Fin.cons z.1 z.2) N)
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
  apply function_uniform_limit (Finset.range m) id
    (fun j y ↦ (shiftedSlice F (g y) y).coeff j)
    (fun j y ↦ eval y ((finSuccEquiv ℝ n N).coeff j))
    (fun x y ↦ eval (Fin.cons (g y + x) y) F)
    (fun x y ↦ eval (Fin.cons x y) N)
    (shifted_finite_expansion F g m hF) (polynomial_finite_expansion N m hN)
    α D R hR K
  intro j hj
  exact ha j (Finset.mem_range.mp hj)

end
end Source29NewtonShiftedExpansion

/- Component: NewtonCoefficientAnalytic.inc -/
namespace Source29NewtonCoefficientAnalytic

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonShiftedFactorCoefficient
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The normal Hasse derivative is again a multivariate polynomial. -/
def normalHasse (F : MvPolynomial (Fin (n + 1)) ℝ) (j : ℕ) :
    MvPolynomial (Fin (n + 1)) ℝ :=
  (finSuccEquiv ℝ n).symm (Polynomial.hasseDeriv j (finSuccEquiv ℝ n F))

lemma slice_normalHasse (F : MvPolynomial (Fin (n + 1)) ℝ) (j : ℕ)
    (y : Fin n → ℝ) :
    sliceHom y (normalHasse F j) = Polynomial.hasseDeriv j (sliceHom y F) := by
  change (finSuccEquiv ℝ n ((finSuccEquiv ℝ n).symm _)).map (eval y) =
    Polynomial.hasseDeriv j ((finSuccEquiv ℝ n F).map (eval y))
  rw [AlgEquiv.apply_symm_apply, Polynomial.hasseDeriv_map]

/-- Every shifted normal coefficient is evaluation of a fixed polynomial
along the shifted graph. -/
theorem shifted_coefficient_eq (F : MvPolynomial (Fin (n + 1)) ℝ)
    (j : ℕ) (s : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).coeff j = eval (Fin.cons s y) (normalHasse F j) := by
  rw [shiftedSlice, Polynomial.taylor_coeff, ← slice_normalHasse, eval_sliceHom]

/-- All normal coefficients are analytic whenever the normal shift is analytic. -/
theorem analyticAt_shifted_coefficient (F : MvPolynomial (Fin (n + 1)) ℝ)
    (j : ℕ) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a) :
    AnalyticAt ℝ (fun y ↦ (shiftedSlice F (g y) y).coeff j) a := by
  have hgraph : AnalyticAt ℝ (fun y : Fin n → ℝ ↦
      (Fin.cons (g y) y : Fin (n + 1) → ℝ)) a := by
    apply AnalyticAt.pi
    intro i
    exact Fin.cases hg (fun k ↦
      (ContinuousLinearMap.proj k : (Fin n → ℝ) →L[ℝ] ℝ).analyticAt a) i
  have h := (Source29PolynomialLinkChart.analyticAt_eval_real (normalHasse F j) _).comp hgraph
  simpa only [shifted_coefficient_eq, Function.comp_def] using h

/-- Every nonzero shifted coefficient germ has a nonzero homogeneous initial
polynomial, without a factorization or a designated multiplicity index. -/
theorem exists_shifted_coefficient_initial_term (F : MvPolynomial (Fin (n + 1)) ℝ)
    (j : ℕ) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hne : ¬ ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff j = 0) :
    ∃ (p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ) (d : ℕ)
      (H : MvPolynomial (Fin n) ℝ),
      HasFPowerSeriesAt (fun y ↦ (shiftedSlice F (g y) y).coeff j) p a ∧
      H ≠ 0 ∧ H.IsHomogeneous d ∧ (∀ x, eval x H = p d (fun _ ↦ x)) ∧
      (∀ k < d, ∀ x, p k (fun _ ↦ x) = 0) :=
  Source29AnalyticInitialPolynomial.exists_homogeneous_initial_term
    (analyticAt_shifted_coefficient F j g a hg) hne

end
end Source29NewtonCoefficientAnalytic

/- Component: NewtonInitialDataLimit.inc -/
namespace Source29NewtonInitialDataLimit

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonShiftedExpansion
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Explicit Taylor data sufficient for a prescribed coefficient limit. A
zero germ permits arbitrary weights; otherwise the target is the initial
polynomial exactly at its order, and zero below that order. -/
def CoefficientData (f : (Fin n → ℝ) → ℝ) (β : ℝ)
    (Q : MvPolynomial (Fin n) ℝ) : Prop :=
  ((∀ᶠ y in 𝓝 0, f y = 0) ∧ Q = 0) ∨
  ∃ (p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ) (v : ℕ)
    (H : MvPolynomial (Fin n) ℝ),
    HasFPowerSeriesAt f p 0 ∧
    (∀ y, eval y H = p v (fun _ ↦ y)) ∧
    (∀ k < v, ∀ y, p k (fun _ ↦ y) = 0) ∧
    β ≤ (v : ℝ) ∧ Q = if β = (v : ℝ) then H else 0

/-- Every analytic coefficient disappears at a strictly negative weight. -/
theorem data_of_negative_weight {f : (Fin n → ℝ) → ℝ}
    (hf : AnalyticAt ℝ f 0) (β : ℝ) (hβ : β < 0) :
    CoefficientData f β 0 := by
  obtain ⟨p, hp⟩ := hf
  refine Or.inr ⟨p, 0, Source29MultilinearDiagonalPolynomial.diagonalPolynomial (p 0),
    hp, Source29MultilinearDiagonalPolynomial.eval_diagonalPolynomial (p 0), ?_, ?_, ?_⟩
  · intro k hk
    omega
  · simpa only [Nat.cast_zero] using hβ.le
  · simp only [Nat.cast_zero, ne_of_lt hβ, ite_false]

/-- At weight zero, an analytic coefficient limits to its value at the center. -/
theorem data_at_zero_weight {f : (Fin n → ℝ) → ℝ} (hf : AnalyticAt ℝ f 0) :
    CoefficientData f 0 (C (f 0)) := by
  obtain ⟨p, hp⟩ := hf
  refine Or.inr ⟨p, 0, C (f 0), hp, ?_, ?_, by simp, by simp⟩
  · intro y
    rw [eval_C]
    exact (hp.coeff_zero _).symm
  · intro k hk
    omega

/-- Taylor data give the required weighted coefficient limit on every
bounded tangential set. -/
theorem coefficient_uniform_limit {f : (Fin n → ℝ) → ℝ} (β : ℝ)
    (Q : MvPolynomial (Fin n) ℝ) (hdata : CoefficientData f β Q)
    (K : Set (Fin n → ℝ)) (hK : Bornology.IsBounded K) :
    TendstoUniformlyOn (fun (ε : ℝ) y ↦ ε ^ (-β) * f (ε • y))
      (fun y ↦ eval y Q) (𝓝[>] (0 : ℝ)) K := by
  rcases hdata with ⟨hz, hQ⟩ | ⟨p, v, H, hp, hH, hlow, hβ, hQ⟩
  · have ht := Source29WeightedInitialScaling.zero_germ_tendstoUniformlyOn
      hz K hK (fun ε : ℝ ↦ ε^(-β))
    simpa only [zero_add, smul_eq_mul, hQ, map_zero] using ht
  · have ht := Source29WeightedInitialScaling.at_or_below_order_tendstoUniformlyOn
      hp v hlow β hβ K hK
    simpa only [zero_add, smul_eq_mul, hQ, apply_ite, hH, map_zero] using ht

/-- The finite shifted-polynomial limit follows directly from its initial
Taylor data, including coefficients with zero germs and higher normal degree. -/
theorem shifted_uniform_limit_of_initial_data
    (F N : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (m : ℕ)
    (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hN : (finSuccEquiv ℝ n N).natDegree < m)
    (α D R : ℝ) (hR : 0 ≤ R) (K : Set (Fin n → ℝ)) (hK : Bornology.IsBounded K)
    (hdata : ∀ j < m, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff j)
      (D - α * (j : ℝ)) ((finSuccEquiv ℝ n N).coeff j)) :
    TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        eval (Fin.cons (g (ε • z.2) + ε ^ α * z.1) (ε • z.2)) F / ε ^ D)
      (fun z ↦ eval (Fin.cons z.1 z.2) N)
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
  apply shifted_polynomial_uniform_limit F N g m hF hN α D R hR K
  intro j hj
  have ht := coefficient_uniform_limit (D - α * (j : ℝ))
    ((finSuccEquiv ℝ n N).coeff j) (hdata j hj) K hK
  have he : -(D - α * (j : ℝ)) = α * (j : ℝ) - D := by ring
  simpa only [he] using ht

end
end Source29NewtonInitialDataLimit

/- Component: NewtonFaceCoefficientData.inc -/
namespace Source29NewtonFaceCoefficientData

open MvPolynomial Filter
open Source29NewtonWeightedFace Source29NewtonShiftedFactorCoefficient
open Source29NewtonInitialDataLimit
open scoped Topology

noncomputable section
variable {n d : ℕ}

/-- Higher normal coefficients have negative weights and vanish automatically. -/
theorem data_above_face (F : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 0 < α) (j : ℕ) (hj : d < j) :
    CoefficientData (fun y ↦ (shiftedSlice F (g y) y).coeff j)
      (α * (d : ℝ) - α * j) ((finSuccEquiv ℝ n (face c S P)).coeff j) := by
  rw [coefficient_above c S P j hj]
  apply data_of_negative_weight
    (Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F j g 0 hg)
  have hcast : (d : ℝ) < (j : ℝ) := by exact_mod_cast hj
  nlinarith

/-- The top face coefficient is the center value of the corresponding
analytic shifted coefficient. -/
theorem data_at_face_top (F : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (hc : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ) (α : ℝ) :
    CoefficientData (fun y ↦ (shiftedSlice F (g y) y).coeff d)
      (α * (d : ℝ) - α * d) ((finSuccEquiv ℝ n (face c S P)).coeff d) := by
  rw [sub_self, top_coefficient]
  have ht := data_at_zero_weight
    (Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F d g 0 hg)
  simpa only [hc] using ht

/-- Only the lower normal coefficients require nontrivial initial-order
information: analyticity handles the top and all higher coefficients. -/
theorem shifted_face_uniform_limit (F : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (hc : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 0 < α) (m : ℕ) (hm : d < m)
    (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α * (d : ℝ) - α * (j : ℕ)) (if j ∈ S then P j else 0))
    (R : ℝ) (hR : 0 ≤ R) (K : Set (Fin n → ℝ)) (hK : Bornology.IsBounded K) :
    TendstoUniformlyOn
      (fun (ε : ℝ) (z : ℝ × (Fin n → ℝ)) ↦
        eval (Fin.cons (g (ε • z.2) + ε ^ α * z.1) (ε • z.2)) F / ε ^ (α * d))
      (fun z ↦ eval (Fin.cons z.1 z.2) (face c S P))
      (𝓝[>] (0 : ℝ)) ({x : ℝ | |x| ≤ R} ×ˢ K) := by
  apply shifted_uniform_limit_of_initial_data F (face c S P) g m hF
    (lt_of_le_of_lt (normal_degree_le c S P) hm) α (α * d) R hR K hK
  intro j hj
  rcases lt_trichotomy j d with hlt | heq | hgt
  · have hd := hdata ⟨j, hlt⟩
    rw [lower_coefficient c S P ⟨j, hlt⟩]
    exact hd
  · subst j
    exact data_at_face_top F g hg c hc S P α
  · exact data_above_face F g hg c S P α hα j hgt

end
end Source29NewtonFaceCoefficientData

/- Component: NewtonShiftedLocalSigns.inc -/
namespace Source29NewtonShiftedLocalSigns

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonShiftedFactorCoefficient
open Source29NewtonShiftedExpansion Source29NewtonCoefficientAnalytic
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Remove the constant normal coefficient and divide by the normal variable. -/
def quotient (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (z : ℝ × (Fin n → ℝ)) : ℝ :=
  ((shiftedSlice P (g z.2) z.2).divX).eval z.1

lemma shifted_eval_eq (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (z : ℝ × (Fin n → ℝ)) :
    eval (Fin.cons (g z.2 + z.1) z.2) P =
      z.1 * quotient P g z + eval (Fin.cons (g z.2) z.2) P := by
  have h := congrArg (fun q : Polynomial ℝ ↦ q.eval z.1)
    (Polynomial.X_mul_divX_add (shiftedSlice P (g z.2) z.2))
  simpa only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X,
    Polynomial.eval_C, shiftedSlice_coeff_zero, eval_shiftedSlice, quotient] using h.symm

lemma quotient_at_zero (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) :
    quotient P g (0,a) = eval (Fin.cons (g a) a) (pderiv 0 P) := by
  change ((shiftedSlice P (g a) a).divX).eval 0 = _
  rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_divX,
    Nat.zero_add, shiftedSlice_coeff_one]

/-- The divided polynomial has analytic joint evaluation near every point
where the shift is analytic. -/
theorem analyticAt_quotient (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a) (x : ℝ) :
    AnalyticAt ℝ (quotient P g) (x,a) := by
  let m := (finSuccEquiv ℝ n P).natDegree + 1
  have heq : quotient P g = fun z : ℝ × (Fin n → ℝ) ↦
      ∑ j ∈ Finset.range m, (shiftedSlice P (g z.2) z.2).coeff (j+1) * z.1^j := by
    funext z
    have hdeg : (shiftedSlice P (g z.2) z.2).divX.natDegree < m :=
      lt_of_le_of_lt (Polynomial.natDegree_divX_le.trans
        (shiftedSlice_natDegree_le P (g z.2) z.2)) (Nat.lt_succ_self _)
    simp only [quotient, Polynomial.eval_eq_sum_range' hdeg, Polynomial.coeff_divX]
  rw [heq]
  apply Finset.analyticAt_fun_sum
  intro j hj
  have hc := (Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient
    P (j+1) g a hg).comp (analyticAt_snd : AnalyticAt ℝ Prod.snd (x,a))
  have hx : AnalyticAt ℝ (fun z : ℝ × (Fin n → ℝ) ↦ z.1^j) (x,a) := analyticAt_fst.pow j
  have h := hc.mul hx
  change AnalyticAt ℝ (fun z : ℝ × (Fin n → ℝ) ↦
    (shiftedSlice P (g z.2) z.2).coeff (j+1) * z.1^j) (x,a) at h
  exact h

/-- A simple positive normal derivative supplies a positive local quotient. -/
theorem eventually_quotient_pos (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hderiv : 0 < eval (Fin.cons (g a) a) (pderiv 0 P)) :
    ∀ᶠ z in 𝓝 ((0 : ℝ), a), 0 < quotient P g z := by
  have hq : 0 < quotient P g (0,a) := by rwa [quotient_at_zero]
  exact (analyticAt_quotient P g a hg 0).continuousAt.tendsto.eventually
    (isOpen_Ioi.mem_nhds hq)

/-- Near a regular branch with positive normal derivative, the polynomial
has the strict sign of the shifted normal coordinate. -/
theorem eventually_polynomial_signs (P : MvPolynomial (Fin (n + 1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hderiv : 0 < eval (Fin.cons (g a) a) (pderiv 0 P)) :
    ∀ᶠ z in 𝓝 ((0 : ℝ), a),
      (0 < z.1 → 0 < eval (Fin.cons (g z.2 + z.1) z.2) P) ∧
      (z.1 < 0 → eval (Fin.cons (g z.2 + z.1) z.2) P < 0) := by
  have hr : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      eval (Fin.cons (g z.2) z.2) P = 0 :=
    (continuous_snd.tendsto (0,a)).eventually hroot
  filter_upwards [eventually_quotient_pos P g a hg hderiv, hr] with z hq hz
  rw [shifted_eval_eq, hz, add_zero]
  exact ⟨fun hx ↦ mul_pos hx hq, fun hx ↦ mul_neg_of_neg_of_pos hx hq⟩

/-- An odd factor with a nonnegative cofactor gives the weak normal
half-space signs required by the weighted-limit argument. -/
theorem factor_halfspace_signs (F P Q : MvPolynomial (Fin (n + 1)) ℝ)
    (k : ℕ) (hk : Odd k) (hF : F = P^k*Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hderiv : 0 < eval (Fin.cons (g a) a) (pderiv 0 P))
    (hQ : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      0 ≤ eval (Fin.cons (g z.2 + z.1) z.2) Q) :
    (∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2 + z.1) z.2) F) ∧
    (∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      z.1 < 0 → eval (Fin.cons (g z.2 + z.1) z.2) F ≤ 0) := by
  have hs := eventually_polynomial_signs P g a hg hroot hderiv
  constructor
  · filter_upwards [hs, hQ] with z hz hq hx
    rw [hF, map_mul, map_pow]
    exact mul_nonneg (pow_nonneg (hz.1 hx).le k) hq
  · filter_upwards [hs, hQ] with z hz hq hx
    rw [hF, map_mul, map_pow]
    exact mul_nonpos_of_nonpos_of_nonneg (hk.pow_nonpos (hz.2 hx).le) hq

end
end Source29NewtonShiftedLocalSigns

/- Component: InitialOrderFromScaling.inc -/
namespace Source29InitialOrderFromScaling

open Filter
open scoped Topology

noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- If a weighted dilation vanishes and the first Taylor term is nonzero,
its Taylor order is strictly greater than that weight. -/
theorem order_gt_of_weighted_limit_zero {f : E → ℝ} {a : E}
    {p : FormalMultilinearSeries ℝ E ℝ} (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ ↦ x) = 0)
    (hne : ∃ x, p d (fun _ ↦ x) ≠ 0) (β : ℝ)
    (hzero : ∀ x, Tendsto (fun t : ℝ ↦ t^(-β) * f (a+t•x))
      (𝓝[>] 0) (𝓝 0)) : β < (d : ℝ) := by
  by_contra h
  have hle : (d : ℝ) ≤ β := le_of_not_gt h
  obtain ⟨x,hx⟩ := hne
  have hi := (Source29WeightedInitialScaling.at_order_tendstoUniformlyOn
    hp d hlow {x} Bornology.isBounded_singleton).tendsto_at (Set.mem_singleton x)
  have hr : Tendsto (fun t : ℝ ↦ t^(β-(d:ℝ))) (𝓝[>] 0)
      (𝓝 ((0:ℝ)^(β-(d:ℝ)))) :=
    (Real.continuousAt_rpow_const 0 (β-(d:ℝ)) (Or.inr (sub_nonneg.mpr hle))).tendsto.mono_left
      nhdsWithin_le_nhds
  have ht : Tendsto (fun t : ℝ ↦ t^(-(d:ℝ)) * f (a+t•x)) (𝓝[>] 0) (𝓝 0) := by
    have hh := hr.mul (hzero x)
    simp only [mul_zero] at hh
    apply hh.congr'
    filter_upwards [self_mem_nhdsWithin] with t ht
    change 0 < t at ht
    rw [← mul_assoc, ← Real.rpow_add ht]
    congr 2
    ring
  have he := tendsto_nhds_unique hi ht
  exact hx he

end
end Source29InitialOrderFromScaling

/- Component: PolynomialCoefficientLimit.inc -/
namespace Source29PolynomialCoefficientLimit

open Filter
open scoped Topology BigOperators Matrix

noncomputable section

/-- For a common finite degree bound, convergence at distinct evaluation
points implies convergence of every coefficient. -/
theorem tendsto_coefficients_of_evaluations {ι : Type*} {l : Filter ι} {m : ℕ}
    (v : Fin m → ℝ) (hv : Function.Injective v)
    (a : ι → Fin m → ℝ) (b : Fin m → ℝ)
    (h : ∀ i, Tendsto (fun t ↦ ∑ j : Fin m, v i ^ (j:ℕ) * a t j) l
      (𝓝 (∑ j : Fin m, v i ^ (j:ℕ) * b j))) :
    Tendsto a l (𝓝 b) := by
  let M : Matrix (Fin m) (Fin m) ℝ := Matrix.vandermonde v
  have hd : IsUnit M.det := isUnit_iff_ne_zero.mpr (Matrix.det_vandermonde_ne_zero_iff.mpr hv)
  have hi : M⁻¹ * M = 1 := Matrix.nonsing_inv_mul M hd
  have ht : Tendsto (fun t ↦ M⁻¹ *ᵥ (M *ᵥ a t)) l (𝓝 (M⁻¹ *ᵥ (M *ᵥ b))) := by
    apply tendsto_pi_nhds.mpr
    intro i
    change Tendsto (fun t ↦ ∑ j : Fin m, M⁻¹ i j * (∑ k : Fin m, v j ^ (k:ℕ) * a t k)) l
      (𝓝 (∑ j : Fin m, M⁻¹ i j * (∑ k : Fin m, v j ^ (k:ℕ) * b k)))
    apply tendsto_finsetSum
    intro j _
    exact (h j).const_mul (M⁻¹ i j)
  simpa only [Matrix.mulVec_mulVec, hi, Matrix.one_mulVec] using ht

/-- Natural-number evaluation points always suffice for a finite coefficient
family over the reals. -/
theorem tendsto_coefficients_of_nat_evaluations {ι : Type*} {l : Filter ι} {m : ℕ}
    (a : ι → Fin m → ℝ) (b : Fin m → ℝ)
    (h : ∀ i : Fin m, Tendsto (fun t ↦ ∑ j : Fin m, (i:ℝ) ^ (j:ℕ) * a t j) l
      (𝓝 (∑ j : Fin m, (i:ℝ) ^ (j:ℕ) * b j))) :
    Tendsto a l (𝓝 b) := by
  apply tendsto_coefficients_of_evaluations (fun i : Fin m ↦ (i:ℝ)) _ a b h
  intro i j hij
  apply Fin.ext
  change (i.val : ℝ) = (j.val : ℝ) at hij
  exact Nat.cast_injective hij

end
end Source29PolynomialCoefficientLimit

/- Component: NewtonCoefficientLimitExtraction.inc -/
namespace Source29NewtonCoefficientLimitExtraction

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonShiftedExpansion
open scoped BigOperators Topology

noncomputable section
variable {n : ℕ}

/-- Pointwise convergence of a finite normal polynomial forces convergence
of each rescaled normal coefficient. No regularity of the shift is assumed. -/
theorem coefficient_limit_of_shifted_limit
    (F N : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (m : ℕ) (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hN : (finSuccEquiv ℝ n N).natDegree < m) (D : ℝ)
    (hlim : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^D)
      (𝓝[>] 0) (𝓝 (eval (Fin.cons x y) N)))
    (j : Fin m) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ ↦ t^((j:ℕ)-D) * (shiftedSlice F (g (t•y)) (t•y)).coeff j)
      (𝓝[>] 0) (𝓝 (eval y ((finSuccEquiv ℝ n N).coeff j))) := by
  let a : ℝ → Fin m → ℝ := fun t j ↦
    t^((j:ℕ)-D) * (shiftedSlice F (g (t•y)) (t•y)).coeff j
  let b : Fin m → ℝ := fun j ↦ eval y ((finSuccEquiv ℝ n N).coeff j)
  have hs (t x : ℝ) (ht : 0 < t) :
      (∑ j : Fin m, x^(j:ℕ) * a t j) =
        eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^D := by
    rw [shifted_finite_expansion F g m hF]
    have he := Source29NewtonFiniteRescaling.scaled_expansion (Finset.range m) id
      (fun j y ↦ (shiftedSlice F (g y) y).coeff j) x t 1 D (t•y) ht
    simp only [Real.rpow_one, one_mul, id_eq] at he
    rw [he, ← Fin.sum_univ_eq_sum_range]
    apply Finset.sum_congr rfl
    intro k _
    exact mul_comm _ _
  have hb (x : ℝ) : (∑ j : Fin m, x^(j:ℕ) * b j) = eval (Fin.cons x y) N := by
    rw [polynomial_finite_expansion N m hN, Source29NewtonFiniteRescaling.expansion,
      ← Fin.sum_univ_eq_sum_range]
    apply Finset.sum_congr rfl
    intro k _
    exact mul_comm _ _
  have ht : Tendsto a (𝓝[>] (0:ℝ)) (𝓝 b) := by
    apply Source29PolynomialCoefficientLimit.tendsto_coefficients_of_nat_evaluations
    intro i
    rw [hb]
    apply (hlim (i:ℝ) y).congr'
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact (hs t (i:ℝ) ht).symm
  exact (tendsto_pi_nhds.mp ht) j

/-- A pure ordinary initial limit forces every lower normal coefficient
of the shifted polynomial to vanish at its corresponding ordinary weight. -/
theorem lower_coefficient_limit_zero_of_pure_initial
    (F : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ) (d : ℕ) (c : ℝ)
    (hlim : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d)))
    (j : Fin d) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ ↦ t^(-((d:ℝ)-(j:ℕ))) *
      (shiftedSlice F (g (t•y)) (t•y)).coeff (j:ℕ)) (𝓝[>] 0) (𝓝 0) := by
  classical
  let N := Source29NewtonWeightedFace.face c (∅ : Finset (Fin d))
    (fun _ ↦ (0 : MvPolynomial (Fin n) ℝ))
  let m := max (finSuccEquiv ℝ n F).natDegree d + 1
  have hF : (finSuccEquiv ℝ n F).natDegree < m := Nat.lt_succ_of_le (le_max_left _ _)
  have hd : d < m := Nat.lt_succ_of_le (le_max_right _ _)
  have hN : (finSuccEquiv ℝ n N).natDegree < m :=
    lt_of_le_of_lt (Source29NewtonWeightedFace.normal_degree_le _ _ _) hd
  have hNval (x : ℝ) (y : Fin n → ℝ) : eval (Fin.cons x y) N = c*x^d := by
    simp [N, Source29NewtonWeightedFace.face]
  have ht := coefficient_limit_of_shifted_limit F N g m hF hN d (by
    intro x y
    simpa only [Real.rpow_natCast, hNval] using hlim x y)
    ⟨j, lt_trans j.isLt hd⟩ y
  have hcoeff : (finSuccEquiv ℝ n N).coeff (j:ℕ) = 0 := by
    simpa only [N, ite_self] using
      Source29NewtonWeightedFace.lower_coefficient c (∅ : Finset (Fin d))
        (fun _ ↦ (0 : MvPolynomial (Fin n) ℝ)) j
  have he : -((d:ℝ)-(j:ℕ)) = (j:ℕ)-(d:ℝ) := by ring
  simpa only [he, hcoeff, map_zero] using ht

end
end Source29NewtonCoefficientLimitExtraction

/- Component: NewtonInitialCenterCoefficient.inc -/
namespace Source29NewtonInitialCenterCoefficient

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonWeightedFace
open Source29NewtonCoefficientLimitExtraction
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A pure ordinary initial limit fixes the top normal coefficient at the
center. This is a finite polynomial consequence and needs no regularity
of the tangentially dependent shift. -/
theorem center_coefficient_of_pure_initial
    (F : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ) (d : ℕ) (c : ℝ)
    (hlim : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d))) :
    (shiftedSlice F (g 0) 0).coeff d = c := by
  let N := face c (∅ : Finset (Fin d)) (fun _ ↦ (0 : MvPolynomial (Fin n) ℝ))
  let m := max (finSuccEquiv ℝ n F).natDegree d + 1
  have hF : (finSuccEquiv ℝ n F).natDegree < m := Nat.lt_succ_of_le (le_max_left _ _)
  have hd : d < m := Nat.lt_succ_of_le (le_max_right _ _)
  have hN : (finSuccEquiv ℝ n N).natDegree < m :=
    lt_of_le_of_lt (normal_degree_le _ _ _) hd
  have hNval (x : ℝ) (y : Fin n → ℝ) : eval (Fin.cons x y) N = c*x^d := by
    simp only [N, face, Finset.sum_empty, add_zero, map_mul, map_pow,
      eval_C, eval_X, Fin.cons_zero]
  have ht := coefficient_limit_of_shifted_limit F N g m hF hN d (by
    intro x y
    simpa only [Real.rpow_natCast, hNval] using hlim x y) ⟨d,hd⟩ 0
  have hcoeff : (finSuccEquiv ℝ n N).coeff d = C c := top_coefficient _ _ _
  have ht' : Tendsto (fun _t : ℝ ↦ (shiftedSlice F (g 0) 0).coeff d)
      (𝓝[>] (0 : ℝ)) (𝓝 c) := by
    simpa only [sub_self, Real.rpow_zero, smul_zero, one_mul, hcoeff, eval_C] using ht
  exact tendsto_nhds_unique tendsto_const_nhds ht'

end
end Source29NewtonInitialCenterCoefficient

/- Component: NewtonInitialDerivativeLimit.inc -/
namespace Source29NewtonInitialDerivativeLimit

open MvPolynomial Filter
open Source29NewtonInitialDataLimit
open scoped Topology

noncomputable section
variable {n : ℕ}

lemma dilation_tendsto_zero (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ => ε • y) (𝓝[>] 0) (𝓝 0) := by
  have hc : Continuous (fun ε : ℝ => ε • y) := by fun_prop
  have ht : Tendsto (fun ε : ℝ => ε • y) (𝓝 0) (𝓝 0) := by
    simpa only [zero_smul] using hc.tendsto (0 : ℝ)
  exact ht.mono_left nhdsWithin_le_nhds

/-- A zero germ remains a zero germ at each fixed rescaled point, even for
an arbitrary scalar normalization. -/
lemma eventually_zero_dilation_germ {f : (Fin n → ℝ) → ℝ}
    (hz : ∀ᶠ z in 𝓝 0, f z = 0) (w : ℝ → ℝ) (y : Fin n → ℝ) :
    ∀ᶠ ε : ℝ in 𝓝[>] 0,
      (fun z => w ε * f (ε • z)) =ᶠ[𝓝 y] (fun _ => 0) := by
  filter_upwards [(dilation_tendsto_zero y).eventually hz.eventually_nhds] with ε hε
  have hc : Continuous (fun z : Fin n → ℝ => ε • z) := by fun_prop
  filter_upwards [(hc.tendsto y).eventually hε] with z hz
  simp only [hz, mul_zero]

/-- The weighted coefficient is analytic near each fixed rescaled point
for every sufficiently small positive scale. -/
theorem eventually_analyticAt_dilation {f : (Fin n → ℝ) → ℝ}
    (hf : AnalyticAt ℝ f 0) (β : ℝ) (y : Fin n → ℝ) :
    ∀ᶠ ε : ℝ in 𝓝[>] 0, AnalyticAt ℝ (fun z => ε^(-β) * f (ε • z)) y := by
  filter_upwards [(dilation_tendsto_zero y).eventually hf.eventually_analyticAt] with ε hε
  have hin : AnalyticAt ℝ (fun z : Fin n → ℝ => ε • z) y := by
    convert! ((analyticAt_id : AnalyticAt ℝ (fun z : Fin n → ℝ => z) y).const_smul (c := ε))
  exact analyticAt_const.mul (hε.comp hin)

/-- Taylor coefficient data give convergence of the first derivative of the
weighted dilation, with no nonzero-germ assumption. -/
theorem coefficient_fderiv_limit {f : (Fin n → ℝ) → ℝ} (β : ℝ)
    (Q : MvPolynomial (Fin n) ℝ) (hdata : CoefficientData f β Q) (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ => fderiv ℝ (fun z => ε^(-β) * f (ε • z)) y)
      (𝓝[>] 0) (𝓝 (fderiv ℝ (fun z => eval z Q) y)) := by
  rcases hdata with ⟨hz,hQ⟩ | ⟨p,v,H,hp,hH,hlow,hβ,hQ⟩
  · subst Q
    simp only [map_zero, fderiv_const_apply]
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_zero_dilation_germ hz (fun ε => ε^(-β)) y] with ε hε
    simpa only [fderiv_const_apply] using hε.fderiv_eq.symm
  · have hpoly : ∀ z, p.partialSum (v+1) z = eval z H := fun z =>
      (Source29AnalyticInitialRemainder.partialSum_eq_initial p v hlow z).trans (hH z).symm
    have hhom : ∀ t : ℝ, 0 < t → ∀ z, eval (t • z) H = t^v • eval z H := by
      intro t _ z
      rw [hH, hH, Source29AnalyticInitialRemainder.diagonal_smul]
    have ht := (Source29WeightedAnalyticDerivativeScaling.at_or_below_order_fderiv_tendstoUniformlyOn
      hp v hpoly hhom β hβ {y} isCompact_singleton).tendsto_at (Set.mem_singleton y)
    by_cases he : β = (v : ℝ)
    · have hQ' : Q = H := by simpa only [he, ite_true] using hQ
      simpa only [hQ', he, ite_true, zero_add, smul_eq_mul] using ht
    · have hQ' : Q = 0 := by simpa only [he, ite_false] using hQ
      simpa only [hQ', he, ite_false, zero_add, smul_eq_mul, map_zero, fderiv_const_apply] using ht

/-- The corresponding second-derivative limit follows from the second
Taylor series and exact chain rule, also for zero germs. -/
theorem coefficient_fderiv_fderiv_limit {f : (Fin n → ℝ) → ℝ} (β : ℝ)
    (Q : MvPolynomial (Fin n) ℝ) (hdata : CoefficientData f β Q) (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ => fderiv ℝ (fderiv ℝ (fun z => ε^(-β) * f (ε • z))) y)
      (𝓝[>] 0) (𝓝 (fderiv ℝ (fderiv ℝ (fun z => eval z Q)) y)) := by
  rcases hdata with ⟨hz,hQ⟩ | ⟨p,v,H,hp,hH,hlow,hβ,hQ⟩
  · subst Q
    simp only [map_zero]
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_zero_dilation_germ hz (fun ε => ε^(-β)) y] with ε hε
    simpa only [fderiv_const, fderiv_const_apply] using hε.fderiv.fderiv_eq.symm
  · have hpoly : ∀ z, p.partialSum (v+1) z = eval z H := fun z =>
      (Source29AnalyticInitialRemainder.partialSum_eq_initial p v hlow z).trans (hH z).symm
    have hhom : ∀ t : ℝ, 0 < t → ∀ z, eval (t • z) H = t^v • eval z H := by
      intro t _ z
      rw [hH, hH, Source29AnalyticInitialRemainder.diagonal_smul]
    have ht := (Source29WeightedAnalyticDerivativeScaling.at_or_below_order_fderiv_fderiv_tendstoUniformlyOn
      hp v hpoly hhom β hβ {y} isCompact_singleton).tendsto_at (Set.mem_singleton y)
    by_cases he : β = (v : ℝ)
    · have hQ' : Q = H := by simpa only [he, ite_true] using hQ
      simpa only [hQ', he, ite_true, zero_add, smul_eq_mul] using ht
    · have hQ' : Q = 0 := by simpa only [he, ite_false] using hQ
      have hz2 : fderiv ℝ (fderiv ℝ (fun _z : Fin n → ℝ => (0 : ℝ))) y = 0 := by
        have hz1 : fderiv ℝ (fun _z : Fin n → ℝ => (0 : ℝ)) = fun _ => 0 := by
          funext z
          exact fderiv_const_apply 0
        rw [hz1]
        exact fderiv_const_apply 0
      simp only [hQ', map_zero]
      rw [hz2]
      simpa only [he, ite_false, zero_add, smul_eq_mul] using ht

end
end Source29NewtonInitialDerivativeLimit

/- Component: NewtonCoefficientSelection.inc -/
namespace Source29NewtonCoefficientSelection

open MvPolynomial Filter
open Source29NewtonInitialDataLimit
open scoped Topology

noncomputable section
variable {n d : ℕ}

/-- A coefficient with a vanishing weighted limit either has a zero germ or
has a nonzero homogeneous initial term of strictly larger order. -/
lemma exists_initial_data_of_limit_zero {f : (Fin n → ℝ) → ℝ}
    (hf : AnalyticAt ℝ f 0) (β : ℝ)
    (hzero : ∀ y, Tendsto (fun t : ℝ => t^(-β) * f (t • y)) (𝓝[>] 0) (𝓝 0)) :
    ∃ (v : ℕ) (P : MvPolynomial (Fin n) ℝ), P.IsHomogeneous v ∧
      ((P = 0 ∧ ∀ᶠ y in 𝓝 0, f y = 0) ∨
      ∃ p : FormalMultilinearSeries ℝ (Fin n → ℝ) ℝ,
        HasFPowerSeriesAt f p 0 ∧ P ≠ 0 ∧
        (∀ y, eval y P = p v (fun _ => y)) ∧
        (∀ k < v, ∀ y, p k (fun _ => y) = 0) ∧ β < (v : ℝ)) := by
  classical
  by_cases hz : ∀ᶠ y in 𝓝 0, f y = 0
  · exact ⟨0, 0, isHomogeneous_zero _ _ _, Or.inl ⟨rfl,hz⟩⟩
  · obtain ⟨p,v,hp,hne,hlow⟩ :=
      Source29AnalyticInitialOrder.exists_first_nonzero_diagonal hf hz
    obtain ⟨P,hP,hhom,heval⟩ :=
      Source29MultilinearDiagonalPolynomial.exists_diagonalPolynomial (p v) hne
    refine ⟨v,P,hhom,Or.inr ⟨p,hp,hP,heval,hlow,?_⟩⟩
    apply Source29InitialOrderFromScaling.order_gt_of_weighted_limit_zero hp v hlow hne β
    simpa only [zero_add] using hzero

/-- Analytic lower coefficients whose ordinary weighted limits vanish select
a nonempty Newton face of slope strictly greater than one. Each coefficient
comes with the actual Taylor data needed for its weighted limit. -/
theorem exists_selected_coefficient_data
    (f : Fin d → (Fin n → ℝ) → ℝ)
    (hf : ∀ j, AnalyticAt ℝ (f j) 0)
    (hne : ∃ j, ¬ ∀ᶠ y in 𝓝 0, f j y = 0)
    (hzero : ∀ (j : Fin d) y, Tendsto
      (fun t : ℝ => t^(-((d : ℝ) - (j : ℕ))) * f j (t • y)) (𝓝[>] 0) (𝓝 0)) :
    ∃ (α : ℝ) (S : Finset (Fin d))
      (P : Fin d → MvPolynomial (Fin n) ℝ) (v : Fin d → ℕ),
      1 < α ∧ S.Nonempty ∧
      (∀ j, (P j).IsHomogeneous (v j)) ∧
      (∀ j, P j ≠ 0 → d - (j : ℕ) < v j) ∧
      (∀ j, j ∈ S ↔ P j ≠ 0 ∧ (v j : ℝ) = α * ((d : ℝ) - (j : ℕ))) ∧
      (∀ j, CoefficientData (f j) (α * ((d : ℝ) - (j : ℕ)))
        (if j ∈ S then P j else 0)) := by
  classical
  choose v P hhom hdata using fun j =>
    exists_initial_data_of_limit_zero (hf j) ((d : ℝ) - (j : ℕ)) (hzero j)
  have hPne : ∃ j, P j ≠ 0 := by
    obtain ⟨j,hj⟩ := hne
    refine ⟨j,?_⟩
    rcases hdata j with ⟨_,hz⟩ | ⟨p,hp,hP,rest⟩
    · exact False.elim (hj hz)
    · exact hP
  have horder : ∀ j, P j ≠ 0 → d - (j : ℕ) < v j := by
    intro j hj
    rcases hdata j with ⟨hP,_⟩ | ⟨p,hp,hP,heval,hlow,hv⟩
    · exact False.elim (hj hP)
    · have hv' : ((d - (j : ℕ) : ℕ) : ℝ) < (v j : ℝ) := by
        simpa only [Nat.cast_sub j.isLt.le] using hv
      exact_mod_cast hv'
  obtain ⟨α,S,hα,hle,hS,hSpos⟩ :=
    Source29NewtonFaceSelection.exists_selected_face P v hPne horder
  refine ⟨α,S,P,v,hα,hSpos,hhom,horder,hS,?_⟩
  intro j
  rcases hdata j with ⟨hP,hz⟩ | ⟨p,hp,hP,heval,hlow,hv⟩
  · left
    refine ⟨hz,?_⟩
    simp only [hP, ite_self]
  · right
    refine ⟨p,v j,P j,hp,heval,hlow,hle j hP,?_⟩
    by_cases hj : j ∈ S
    · have he := (hS j).mp hj
      simp only [hj, ite_true, he.2.symm]
    · have he : α * ((d : ℝ) - (j : ℕ)) ≠ (v j : ℝ) := by
        intro heq
        exact hj ((hS j).mpr ⟨hP,heq.symm⟩)
      simp only [hj, he, ite_false]

end
end Source29NewtonCoefficientSelection

/- Component: NormalizedShiftJets.inc -/
namespace Source29NormalizedShiftJets

open Source29NormalShiftDerivatives
open scoped Topology

noncomputable section
variable {n : ℕ}

def dilationWeight (q ε : ℝ) : Fin (n+1) → ℝ := Fin.cons q (fun _ ↦ ε)

def dilation (q ε : ℝ) : (Fin (n+1) → ℝ) →L[ℝ] (Fin (n+1) → ℝ) :=
  ContinuousLinearMap.pi (fun i ↦ dilationWeight q ε i • ContinuousLinearMap.proj i)

lemma dilation_apply (q ε : ℝ) (x : Fin (n+1) → ℝ) (i : Fin (n+1)) :
    dilation q ε x i = dilationWeight q ε i * x i := rfl

lemma dilation_basis (q ε : ℝ) (i : Fin (n+1)) :
    dilation q ε (basis i) = dilationWeight q ε i • basis i := by
  funext j
  simp only [dilation_apply, basis, Pi.single_apply, Pi.smul_apply, smul_eq_mul]
  by_cases hij : j = i
  · subst j
    simp
  · simp [hij]

lemma tail_dilation (q ε : ℝ) (x : Fin (n+1) → ℝ) : tail (dilation q ε x) = ε • tail x := rfl

lemma second_smul_left {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x u v : E) (c : ℝ) : second f x (c • u) v = c * second f x u v := by
  simp only [second, map_smul, smul_eq_mul]

lemma second_smul_right {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x u v : E) (c : ℝ) : second f x u (c • v) = c * second f x u v := by
  unfold second
  simp only [map_smul, smul_eq_mul]
  have he := congrFun (fderiv_const_smul_field (𝕜 := ℝ) (f := fun y ↦ fderiv ℝ f y v) c) x
  exact congrArg (fun L : E →L[ℝ] ℝ ↦ L u) he

lemma first_const_mul {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x v : E) (c : ℝ) :
    fderiv ℝ (fun y ↦ c * f y) x v = c * fderiv ℝ f x v := by
  have he := congrFun (fderiv_const_smul_field (𝕜 := ℝ) (f := f) c) x
  exact congrArg (fun L : E →L[ℝ] ℝ ↦ L v) he

lemma second_const_mul {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x u v : E) (c : ℝ) :
    second (fun y ↦ c * f y) x u v = c * second f x u v := by
  unfold second
  simp_rw [first_const_mul]


def scaledFunction (f : (Fin (n+1) → ℝ) → ℝ) (κ ε ρ : ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  (κ*ε*ρ)⁻¹ * f (dilation (ε*ρ) ε x)

lemma gradient_scaled (f : (Fin (n+1) → ℝ) → ℝ) (κ ε ρ : ℝ) (x : Fin (n+1) → ℝ)
    (hf : AnalyticAt ℝ f (dilation (ε*ρ) ε x)) (i : Fin (n+1)) :
    gradient (scaledFunction f κ ε ρ) x i =
      (κ*ε*ρ)⁻¹ * dilationWeight (ε*ρ) ε i * gradient f (dilation (ε*ρ) ε x) i := by
  unfold Source29NormalShiftDerivatives.gradient scaledFunction
  rw [first_const_mul]
  rw [first_linear f (dilation (ε*ρ) ε) x (basis i) hf.differentiableAt,
    dilation_basis, map_smul, smul_eq_mul]
  ring

lemma hessian_scaled (f : (Fin (n+1) → ℝ) → ℝ) (κ ε ρ : ℝ) (x : Fin (n+1) → ℝ)
    (hf : AnalyticAt ℝ f (dilation (ε*ρ) ε x)) (i j : Fin (n+1)) :
    hessian (scaledFunction f κ ε ρ) x i j =
      (κ*ε*ρ)⁻¹ * dilationWeight (ε*ρ) ε i * dilationWeight (ε*ρ) ε j *
        hessian f (dilation (ε*ρ) ε x) i j := by
  unfold hessian scaledFunction
  rw [second_const_mul, second_linear f (dilation (ε*ρ) ε) x (basis i) (basis j) hf,
    dilation_basis, dilation_basis, second_smul_left, second_smul_right]
  ring

/-- The five unscaled jets expressed through the normalized function. -/
theorem original_jets (f : (Fin (n+1) → ℝ) → ℝ) (κ ε ρ : ℝ)
    (hκ : κ ≠ 0) (hε : ε ≠ 0) (hρ : ρ ≠ 0) (x : Fin (n+1) → ℝ)
    (hf : AnalyticAt ℝ f (dilation (ε*ρ) ε x)) :
    gradient f (dilation (ε*ρ) ε x) 0 = κ * gradient (scaledFunction f κ ε ρ) x 0 ∧
    (∀ i : Fin n, gradient f (dilation (ε*ρ) ε x) i.succ =
      κ*ρ*gradient (scaledFunction f κ ε ρ) x i.succ) ∧
    hessian f (dilation (ε*ρ) ε x) 0 0 = κ/(ε*ρ)*hessian (scaledFunction f κ ε ρ) x 0 0 ∧
    (∀ i : Fin n, hessian f (dilation (ε*ρ) ε x) i.succ 0 =
      κ/ε*hessian (scaledFunction f κ ε ρ) x i.succ 0) ∧
    (∀ i j : Fin n, hessian f (dilation (ε*ρ) ε x) i.succ j.succ =
      κ*ρ/ε*hessian (scaledFunction f κ ε ρ) x i.succ j.succ) := by
  simp only [gradient_scaled f κ ε ρ x hf, hessian_scaled f κ ε ρ x hf,
    dilationWeight, Fin.cons_zero, Fin.cons_succ]
  constructor
  · field_simp
  constructor
  · intro i
    field_simp
  constructor
  · field_simp
  constructor
  · intro i
    field_simp
  · intro i j
    field_simp

def scaleMap (α ε : ℝ) : (Fin (n+1) → ℝ) →L[ℝ] (Fin (n+1) → ℝ) := dilation (ε^α) ε

def family (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (α D ε : ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ε^(-D) * pullback P g (scaleMap α ε x)

lemma family_eq (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (α D ε : ℝ) (x : Fin (n+1) → ℝ) :
    family P g α D ε x = ε^(-D) * MvPolynomial.eval
      (Fin.cons (g (ε • tail x) + ε^α * x 0) (ε • tail x)) P := by
  unfold family pullback
  rw [chart_eq]
  simp only [scaleMap, tail_dilation, dilation_apply, dilationWeight, Fin.cons_zero]
  rw [add_comm (ε^α * x 0) (g (ε • tail x))]

lemma epsilon_rho (α ε : ℝ) (hε : 0 < ε) : ε * ε^(α-1) = ε^α := by
  calc
    _ = ε^(1 : ℝ) * ε^(α-1) := by rw [Real.rpow_one]
    _ = ε^((1 : ℝ)+(α-1)) := (Real.rpow_add hε _ _).symm
    _ = ε^α := by congr 1; ring

lemma kappa_epsilon_rho (α D ε : ℝ) (hε : 0 < ε) : ε^(D-α) * ε * ε^(α-1) = ε^D := by
  rw [mul_assoc, epsilon_rho α ε hε, ← Real.rpow_add hε]
  congr 1
  ring

lemma family_eq_scaledFunction (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (α D ε : ℝ) (hε : 0 < ε) :
    family P g α D ε = scaledFunction (pullback P g) (ε^(D-α)) ε (ε^(α-1)) := by
  funext x
  unfold family scaledFunction scaleMap
  rw [epsilon_rho α ε hε, kappa_epsilon_rho α D ε hε, Real.rpow_neg hε.le]

end
end Source29NormalizedShiftJets

/- Component: NormalizedShiftBackground.inc -/
namespace Source29NormalizedShiftBackground

open Filter Source29NormalShiftDerivatives Source29NewtonRootHarmonic
open scoped Topology

noncomputable section
variable {n : ℕ}

lemma dilation_tendsto (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ ↦ ε • y) (𝓝[>] 0) (𝓝 0) := by
  simpa using (line_tendsto (0 : Fin n → ℝ) y).mono_left nhdsWithin_le_nhds

/-- The rescaled background gradient has a finite limit given by its derivative
at the origin. The zero-gradient hypothesis is used explicitly. -/
theorem gradient_div_tendsto (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (hg0 : gradient g 0 = 0) (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ ↦ fun i ↦ gradient g (ε • y) i / ε) (𝓝[>] 0)
      (𝓝 (fun i ↦ second g 0 y (basis i))) := by
  apply tendsto_pi_nhds.mpr
  intro i
  have hdi := analyticAt_directional g (0 : Fin n → ℝ) (basis i) hg
  have hd : HasDerivAt (fun ε : ℝ ↦ gradient g (ε • y) i) (second g 0 y (basis i)) 0 := by
    have hdif : HasFDerivAt (fun z ↦ fderiv ℝ g z (basis i))
        (fderiv ℝ (fun z ↦ fderiv ℝ g z (basis i)) 0) ((0 : ℝ) • y) := by
      simpa only [zero_smul] using hdi.differentiableAt.hasFDerivAt
    have h := hdif.comp_hasDerivAt (0 : ℝ) ((hasDerivAt_id (0 : ℝ)).smul_const y)
    simpa only [zero_smul, Source29NormalShiftDerivatives.gradient, second, Function.comp_def, id_eq, one_smul] using h
  have hi : gradient g 0 i = 0 := congrFun hg0 i
  have hlim := hd.tendsto_slope_zero_right
  simpa only [zero_add, zero_smul, hi, sub_zero, smul_eq_mul, div_eq_mul_inv, mul_comm] using hlim

/-- Continuity of the actual second derivatives supplies the background Hessian
limit; no value or vanishing hypothesis on that Hessian is needed. -/
theorem hessian_tendsto (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (y : Fin n → ℝ) :
    Tendsto (fun ε : ℝ ↦ hessian g (ε • y)) (𝓝[>] 0) (𝓝 (hessian g 0)) := by
  apply tendsto_pi_nhds.mpr
  intro i
  apply tendsto_pi_nhds.mpr
  intro j
  have h1 := analyticAt_directional g (0 : Fin n → ℝ) (basis j) hg
  have h2 := analyticAt_directional (fun z ↦ fderiv ℝ g z (basis j)) (0 : Fin n → ℝ) (basis i) h1
  exact h2.continuousAt.tendsto.comp (dilation_tendsto y)

lemma scaled_gradient (g : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) (ε : ℝ) (hε : ε ≠ 0) :
    (fun i ↦ ε * (gradient g (ε • y) i / ε)) = gradient g (ε • y) := by
  funext i
  exact mul_div_cancel₀ _ hε

end
end Source29NormalizedShiftBackground

/- Component: NormalizedShiftResidual.inc -/
namespace Source29NormalizedShiftResidual

open Filter Source29NormalShiftDerivatives Source29NormalShiftAlgebra
  Source29NormalShiftScaling Source29NormalizedShiftJets Source29NormalizedShiftBackground
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The actual scaled polynomial pullback satisfies the normalized equation,
with the minimal graph equation for the background used explicitly. -/
theorem scaled_pullback_equation (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (κ ε ρ : ℝ) (hκ : κ ≠ 0) (hε : ε ≠ 0) (hρ : ρ ≠ 0)
    (v : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (ε • tail v))
    (hP : MvPolynomial.eval (chart g (dilation (ε*ρ) ε v))
      (Source29QuarticReuse.QuarticMinimal.leadingOperator P) = 0)
    (hbg : backgroundGraphOperator (gradient g (ε • tail v)) (hessian g (ε • tail v)) = 0) :
    let H := scaledFunction (pullback P g) κ ε ρ
    let A := gradient H v 0
    let S := hessian H v 0 0
    let B := fun i : Fin n ↦ gradient H v i.succ
    let T := fun i : Fin n ↦ hessian H v i.succ 0
    let U := fun i j : Fin n ↦ hessian H v i.succ j.succ
    let a := fun i ↦ gradient g (ε • tail v) i / ε
    let G := hessian g (ε • tail v)
    newtonResidual A S B T U + ρ^2*rhoCorrection B U +
      ε*ρ*mixedCorrection A B T a U G + ε^2*epsilonCorrection A S B T a U G = 0 := by
  dsimp only
  have hga : AnalyticAt ℝ g (tail (dilation (ε*ρ) ε v)) := hg
  have hf := analyticAt_pullback P g (dilation (ε*ρ) ε v) hga
  obtain ⟨hA, hB, hS, hT, hU⟩ := original_jets (pullback P g) κ ε ρ hκ hε hρ v hf
  have he := newton_plus_correction_eq_zero P g (dilation (ε*ρ) ε v) hga hP hbg
  dsimp only at he
  have hl : shiftedLevelOperator (gradient (pullback P g) (dilation (ε*ρ) ε v) 0)
      (hessian (pullback P g) (dilation (ε*ρ) ε v) 0 0)
      (fun i : Fin n ↦ gradient (pullback P g) (dilation (ε*ρ) ε v) i.succ)
      (fun i : Fin n ↦ hessian (pullback P g) (dilation (ε*ρ) ε v) i.succ 0)
      (gradient g (ε • tail v))
      (fun i j : Fin n ↦ hessian (pullback P g) (dilation (ε*ρ) ε v) i.succ j.succ)
      (hessian g (ε • tail v)) = 0 := by
    rw [normal_shift_identity, hbg, mul_zero, sub_zero]
    exact he
  simp_rw [hA, hB, hS, hT, hU] at hl
  rw [← scaled_gradient g (tail v) ε hε] at hl
  exact scaled_equation κ ε ρ _ _ _ _ _ _ _ hκ hε hρ hl
    (by simpa only [scaled_gradient g (tail v) ε hε] using hbg)

/-- The rpow-normalized family inherits the equation at every positive scale. -/
theorem family_equation (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D ε : ℝ) (hε : 0 < ε) (v : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (ε • tail v))
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0)
    (hbg : backgroundGraphOperator (gradient g (ε • tail v)) (hessian g (ε • tail v)) = 0) :
    let H := family P g α D ε
    let A := gradient H v 0
    let S := hessian H v 0 0
    let B := fun i : Fin n ↦ gradient H v i.succ
    let T := fun i : Fin n ↦ hessian H v i.succ 0
    let U := fun i j : Fin n ↦ hessian H v i.succ j.succ
    let a := fun i ↦ gradient g (ε • tail v) i / ε
    let G := hessian g (ε • tail v)
    newtonResidual A S B T U + (ε^(α-1))^2*rhoCorrection B U +
      ε*ε^(α-1)*mixedCorrection A B T a U G + ε^2*epsilonCorrection A S B T a U G = 0 := by
  rw [family_eq_scaledFunction P g α D ε hε]
  exact scaled_pullback_equation P g (ε^(D-α)) ε (ε^(α-1))
    (ne_of_gt (Real.rpow_pos_of_pos hε _)) (ne_of_gt hε)
    (ne_of_gt (Real.rpow_pos_of_pos hε _)) v hg (by rw [hP, map_zero]) hbg

/-- Agreement of the finite-sum residual of evaluated jets with the polynomial residual. -/
lemma newtonResidual_eval (N : MvPolynomial (Fin (n+1)) ℝ) (v : Fin (n+1) → ℝ) :
    newtonResidual (gradient (fun x ↦ MvPolynomial.eval x N) v 0)
      (hessian (fun x ↦ MvPolynomial.eval x N) v 0 0)
      (fun i : Fin n ↦ gradient (fun x ↦ MvPolynomial.eval x N) v i.succ)
      (fun i : Fin n ↦ hessian (fun x ↦ MvPolynomial.eval x N) v i.succ 0)
      (fun i j : Fin n ↦ hessian (fun x ↦ MvPolynomial.eval x N) v i.succ j.succ) =
    MvPolynomial.eval v (Source29NewtonNormalDerivative.newtonResidual N) := by
  simp only [newtonResidual, dot, trace, gradient_eval, hessian_eval,
    Source29NewtonNormalDerivative.newtonResidual,
    Source29NewtonNormalDerivative.tangentialLaplacian,
    Source29NewtonNormalDerivative.tangentialMixed,
    Source29NewtonNormalDerivative.tangentialEnergy,
    map_add, map_sub, map_mul, map_sum, map_ofNat, pow_two]

end
end Source29NormalizedShiftResidual

/- Component: NormalizedShiftLimit.inc -/
namespace Source29NormalizedShiftLimit

open Filter Source29NormalShiftDerivatives Source29NormalShiftAlgebra
  Source29NormalShiftScaling Source29NormalizedShiftJets Source29NormalizedShiftBackground
  Source29NormalizedShiftResidual
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A polynomial limit of the actual first and second normalized jets satisfies
the Newton residual equation. Function convergence alone is not an input. -/
theorem eval_newtonResidual_eq_zero (P N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D : ℝ) (hα : 1 < α)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (v : Fin (n+1) → ℝ)
    (hfirst : ∀ i, Tendsto (fun ε : ℝ ↦ gradient (family P g α D ε) v i) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i N))))
    (hsecond : ∀ i j, Tendsto (fun ε : ℝ ↦ hessian (family P g α D ε) v i j) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i (MvPolynomial.pderiv j N))))) :
    MvPolynomial.eval v (Source29NewtonNormalDerivative.newtonResidual N) = 0 := by
  have hε : Tendsto (fun ε : ℝ ↦ ε) (𝓝[>] 0) (𝓝 0) := tendsto_id.mono_left nhdsWithin_le_nhds
  have hρ : Tendsto (fun ε : ℝ ↦ ε^(α-1)) (𝓝[>] 0) (𝓝 0) := by
    have hp : Tendsto (fun ε : ℝ ↦ ε^(α-1)) (𝓝[>] 0) (𝓝 ((0 : ℝ)^(α-1))) :=
      (Real.continuousAt_rpow_const (0 : ℝ) (α-1)
      (Or.inr (le_of_lt (sub_pos.mpr hα)))).tendsto.mono_left nhdsWithin_le_nhds
    simpa only [Real.zero_rpow (ne_of_gt (sub_pos.mpr hα))] using hp
  have heq := fun ε (hp : 0 < ε) (ha : AnalyticAt ℝ g (ε • tail v))
      (hb : backgroundGraphOperator (gradient g (ε • tail v)) (hessian g (ε • tail v)) = 0) ↦
    family_equation P g α D ε hp v ha hP hb
  have hevent : ∀ᶠ ε : ℝ in 𝓝[>] 0,
      let H := family P g α D ε
      let A := gradient H v 0
      let S := hessian H v 0 0
      let B := fun i : Fin n ↦ gradient H v i.succ
      let T := fun i : Fin n ↦ hessian H v i.succ 0
      let U := fun i j : Fin n ↦ hessian H v i.succ j.succ
      let a := fun i ↦ gradient g (ε • tail v) i / ε
      let G := hessian g (ε • tail v)
      newtonResidual A S B T U + (ε^(α-1))^2*rhoCorrection B U +
        ε*ε^(α-1)*mixedCorrection A B T a U G + ε^2*epsilonCorrection A S B T a U G = 0 := by
    filter_upwards [self_mem_nhdsWithin, (dilation_tendsto (tail v)).eventually hg.eventually_analyticAt,
      (dilation_tendsto (tail v)).eventually hbg] with ε hp ha hb
    exact heq ε hp ha hb
  have hE := Source29NormalShiftScalingLimit.newtonResidual_eq_zero_of_tendsto
    (fun ε : ℝ ↦ ε) (fun ε : ℝ ↦ ε^(α-1))
    (fun ε ↦ gradient (family P g α D ε) v 0)
    (fun ε ↦ hessian (family P g α D ε) v 0 0)
    (fun ε (i : Fin n) ↦ gradient (family P g α D ε) v i.succ)
    (fun ε (i : Fin n) ↦ hessian (family P g α D ε) v i.succ 0)
    (fun ε (i : Fin n) ↦ gradient g (ε • tail v) i / ε)
    (fun ε (i j : Fin n) ↦ hessian (family P g α D ε) v i.succ j.succ)
    (fun ε ↦ hessian g (ε • tail v))
    (MvPolynomial.eval v (MvPolynomial.pderiv 0 N))
    (MvPolynomial.eval v (MvPolynomial.pderiv 0 (MvPolynomial.pderiv 0 N)))
    (fun i : Fin n ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ N))
    (fun i : Fin n ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ (MvPolynomial.pderiv 0 N)))
    (fun i ↦ second g 0 (tail v) (basis i))
    (fun i j : Fin n ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ (MvPolynomial.pderiv j.succ N)))
    (hessian g 0) hε hρ (hfirst 0) (hsecond 0 0)
    (tendsto_pi_nhds.mpr (fun i ↦ hfirst i.succ))
    (tendsto_pi_nhds.mpr (fun i ↦ hsecond i.succ 0))
    (gradient_div_tendsto g hg hg0 (tail v))
    (tendsto_pi_nhds.mpr (fun i ↦ tendsto_pi_nhds.mpr (fun j ↦ hsecond i.succ j.succ)))
    (hessian_tendsto g hg (tail v)) hevent
  rw [← newtonResidual_eval N v]
  simpa only [gradient_eval, hessian_eval] using hE

/-- Pointwise convergence of every actual first and second jet gives the
polynomial identity, with no residual equation assumed for the limit. -/
theorem newtonResidual_eq_zero (P N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D : ℝ) (hα : 1 < α)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (hfirst : ∀ v i, Tendsto (fun ε : ℝ ↦ gradient (family P g α D ε) v i) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i N))))
    (hsecond : ∀ v i j, Tendsto (fun ε : ℝ ↦ hessian (family P g α D ε) v i j) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i (MvPolynomial.pderiv j N))))) :
    Source29NewtonNormalDerivative.newtonResidual N = 0 := by
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro v
  simpa only [map_zero] using eval_newtonResidual_eq_zero P N g α D hα hg hg0 hP hbg v (hfirst v) (hsecond v)

end
end Source29NormalizedShiftLimit

/- Component: FiniteJetConvergence.inc -/
namespace Source29FiniteJetConvergence

open Filter
open Source29NormalShiftDerivatives Source29NewtonRootHarmonic
open scoped Topology BigOperators

noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

lemma first_mul (f g : E → ℝ) (x v : E)
    (hf : AnalyticAt ℝ f x) (hg : AnalyticAt ℝ g x) :
    fderiv ℝ (fun y ↦ f y * g y) x v =
      f x * fderiv ℝ g x v + g x * fderiv ℝ f x v := by
  rw [fderiv_fun_mul hf.differentiableAt hg.differentiableAt]
  rfl

lemma second_mul (f g : E → ℝ) (x u v : E)
    (hf : AnalyticAt ℝ f x) (hg : AnalyticAt ℝ g x) :
    second (fun y ↦ f y * g y) x u v =
      f x * second g x u v + g x * second f x u v +
      fderiv ℝ f x u * fderiv ℝ g x v + fderiv ℝ g x u * fderiv ℝ f x v := by
  have he : (fun y ↦ fderiv ℝ (fun z ↦ f z * g z) y v) =ᶠ[𝓝 x]
      (fun y ↦ f y * fderiv ℝ g y v + g y * fderiv ℝ f y v) := by
    filter_upwards [hf.eventually_analyticAt, hg.eventually_analyticAt] with y hyf hyg
    exact first_mul f g y v hyf hyg
  have hdf := analyticAt_directional f x v hf
  have hdg := analyticAt_directional g x v hg
  unfold second
  rw [he.fderiv_eq, fderiv_fun_add
    (f := fun y ↦ f y * fderiv ℝ g y v) (g := fun y ↦ g y * fderiv ℝ f y v)
    (hf.mul hdg).differentiableAt (hg.mul hdf).differentiableAt]
  simp only [add_apply]
  rw [first_mul f _ x u hf hdg, first_mul g _ x u hg hdf]
  ring

lemma first_sum {J : Type*} (S : Finset J) (f : J → E → ℝ) (x v : E)
    (hf : ∀ j ∈ S, AnalyticAt ℝ (f j) x) :
    fderiv ℝ (fun y ↦ ∑ j ∈ S, f j y) x v = ∑ j ∈ S, fderiv ℝ (f j) x v := by
  rw [fderiv_fun_sum (fun j hj ↦ (hf j hj).differentiableAt)]
  exact sum_apply _ _ _

lemma second_sum {J : Type*} (S : Finset J) (f : J → E → ℝ) (x u v : E)
    (hf : ∀ j ∈ S, AnalyticAt ℝ (f j) x) :
    second (fun y ↦ ∑ j ∈ S, f j y) x u v = ∑ j ∈ S, second (f j) x u v := by
  have hnear : ∀ᶠ y in 𝓝 x, ∀ j ∈ S, AnalyticAt ℝ (f j) y :=
    (eventually_all_finset S).2 (fun j hj ↦ (hf j hj).eventually_analyticAt)
  have he : (fun y ↦ fderiv ℝ (fun z ↦ ∑ j ∈ S, f j z) y v) =ᶠ[𝓝 x]
      (fun y ↦ ∑ j ∈ S, fderiv ℝ (f j) y v) :=
    hnear.mono (fun y hy ↦ first_sum S f y v hy)
  unfold second
  rw [he.fderiv_eq]
  exact first_sum S (fun j y ↦ fderiv ℝ (f j) y v) x u
    (fun j hj ↦ analyticAt_directional (f j) x v (hf j hj))

lemma second_eq_fderiv (f : E → ℝ) (x u v : E) (hf : AnalyticAt ℝ f x) :
    second f x u v = fderiv ℝ (fderiv ℝ f) x u v := by
  have h := (ContinuousLinearMap.apply ℝ ℝ v).hasFDerivAt.comp x
    hf.fderiv.differentiableAt.hasFDerivAt
  exact congrArg (fun L : E →L[ℝ] ℝ ↦ L u) h.fderiv

/-- Pointwise convergence of a scalar function and every ordered first and
second directional derivative at one point. -/
def JetConverges {ι : Type*} (l : Filter ι) (F : ι → E → ℝ) (f : E → ℝ) (x : E) : Prop :=
  Tendsto (fun t ↦ F t x) l (𝓝 (f x)) ∧
    (∀ v, Tendsto (fun t ↦ fderiv ℝ (F t) x v) l (𝓝 (fderiv ℝ f x v))) ∧
    (∀ u v, Tendsto (fun t ↦ second (F t) x u v) l (𝓝 (second f x u v)))

namespace JetConverges
variable {ι : Type*} {l : Filter ι} {F G : ι → E → ℝ} {f g : E → ℝ} {x : E}

lemma const (f : E → ℝ) (x : E) : JetConverges l (fun _ ↦ f) f x :=
  ⟨tendsto_const_nhds, fun _ ↦ tendsto_const_nhds, fun _ _ ↦ tendsto_const_nhds⟩

lemma congr (hF : JetConverges l F f x) (hFG : F =ᶠ[l] G) (hfg : f = g) :
    JetConverges l G g x := by
  subst g
  refine ⟨hF.1.congr' ?_, fun v ↦ (hF.2.1 v).congr' ?_, fun u v ↦ (hF.2.2 u v).congr' ?_⟩
  · exact hFG.mono (fun _ ht ↦ congrFun ht x)
  · exact hFG.mono (fun _ ht ↦ congrArg (fun h ↦ fderiv ℝ h x v) ht)
  · exact hFG.mono (fun _ ht ↦ congrArg (fun h ↦ second h x u v) ht)

lemma mul (hF : JetConverges l F f x) (hG : JetConverges l G g x)
    (hFa : ∀ᶠ t in l, AnalyticAt ℝ (F t) x) (hGa : ∀ᶠ t in l, AnalyticAt ℝ (G t) x)
    (hf : AnalyticAt ℝ f x) (hg : AnalyticAt ℝ g x) :
    JetConverges l (fun t y ↦ F t y * G t y) (fun y ↦ f y * g y) x := by
  refine ⟨hF.1.mul hG.1, ?_, ?_⟩
  · intro v
    rw [first_mul f g x v hf hg]
    apply ((hF.1.mul (hG.2.1 v)).add (hG.1.mul (hF.2.1 v))).congr'
    filter_upwards [hFa, hGa] with t htF htG
    exact (first_mul (F t) (G t) x v htF htG).symm
  · intro u v
    rw [second_mul f g x u v hf hg]
    apply ((((hF.1.mul (hG.2.2 u v)).add (hG.1.mul (hF.2.2 u v))).add
      ((hF.2.1 u).mul (hG.2.1 v))).add ((hG.2.1 u).mul (hF.2.1 v))).congr'
    filter_upwards [hFa, hGa] with t htF htG
    exact (second_mul (F t) (G t) x u v htF htG).symm

lemma comp_linear {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (L : V →L[ℝ] E) (z : V) (hF : JetConverges l F f (L z))
    (hFa : ∀ᶠ t in l, AnalyticAt ℝ (F t) (L z)) (hf : AnalyticAt ℝ f (L z)) :
    JetConverges l (fun t y ↦ F t (L y)) (fun y ↦ f (L y)) z := by
  refine ⟨hF.1, ?_, ?_⟩
  · intro v
    rw [first_linear f L z v hf.differentiableAt]
    apply (hF.2.1 (L v)).congr'
    filter_upwards [hFa] with t ht
    exact (first_linear (F t) L z v ht.differentiableAt).symm
  · intro u v
    rw [second_linear f L z u v hf]
    apply (hF.2.2 (L u) (L v)).congr'
    filter_upwards [hFa] with t ht
    exact (second_linear (F t) L z u v ht).symm

lemma sum {J : Type*} (S : Finset J) (F : J → ι → E → ℝ) (f : J → E → ℝ)
    (hF : ∀ j ∈ S, JetConverges l (F j) (f j) x)
    (hFa : ∀ j ∈ S, ∀ᶠ t in l, AnalyticAt ℝ (F j t) x)
    (hf : ∀ j ∈ S, AnalyticAt ℝ (f j) x) :
    JetConverges l (fun t y ↦ ∑ j ∈ S, F j t y) (fun y ↦ ∑ j ∈ S, f j y) x := by
  have hnear := (eventually_all_finset S).2 hFa
  refine ⟨tendsto_finsetSum S (fun j hj ↦ (hF j hj).1), ?_, ?_⟩
  · intro v
    rw [first_sum S f x v hf]
    apply (tendsto_finsetSum S (fun j hj ↦ (hF j hj).2.1 v)).congr'
    filter_upwards [hnear] with t ht
    exact (first_sum S (fun j ↦ F j t) x v ht).symm
  · intro u v
    rw [second_sum S f x u v hf]
    apply (tendsto_finsetSum S (fun j hj ↦ (hF j hj).2.2 u v)).congr'
    filter_upwards [hnear] with t ht
    exact (second_sum S (fun j ↦ F j t) x u v ht).symm

end JetConverges
end
end Source29FiniteJetConvergence

/- Component: NewtonFiniteJetAssembly.inc -/
namespace Source29NewtonFiniteJetAssembly

open Filter
open Source29NormalShiftDerivatives Source29FiniteJetConvergence
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def normalExpansion {J : Type*} (S : Finset J) (degree : J → ℕ)
    (a : J → (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ∑ j ∈ S, a j (tail x) * (x 0)^(degree j)

/-- Finite normal powers preserve convergence of all first and ordered
second jets of the tangential coefficient functions. -/
theorem normalExpansion_jet_limit {J ι : Type*} (l : Filter ι)
    (S : Finset J) (degree : J → ℕ)
    (a : J → ι → (Fin n → ℝ) → ℝ) (b : J → (Fin n → ℝ) → ℝ)
    (x : Fin (n+1) → ℝ)
    (ha : ∀ j ∈ S, JetConverges l (a j) (b j) (tail x))
    (haa : ∀ j ∈ S, ∀ᶠ t in l, AnalyticAt ℝ (a j t) (tail x))
    (hb : ∀ j ∈ S, AnalyticAt ℝ (b j) (tail x)) :
    JetConverges l (fun t ↦ normalExpansion S degree (fun j ↦ a j t))
      (normalExpansion S degree b) x := by
  unfold normalExpansion
  apply JetConverges.sum
  · intro j hj
    have hq : AnalyticAt ℝ (fun z : Fin (n+1) → ℝ ↦ (z 0)^(degree j)) x :=
      ((ContinuousLinearMap.proj 0 : (Fin (n+1) → ℝ) →L[ℝ] ℝ).analyticAt x).pow _
    apply ((ha j hj).comp_linear tail x (haa j hj) (hb j hj)).mul (JetConverges.const _ x)
    · filter_upwards [haa j hj] with t ht
      exact ht.comp (tail.analyticAt x)
    · exact Eventually.of_forall (fun _ ↦ hq)
    · exact (hb j hj).comp (tail.analyticAt x)
    · exact hq
  · intro j hj
    filter_upwards [haa j hj] with t ht
    exact (ht.comp (tail.analyticAt x)).mul
      (((ContinuousLinearMap.proj 0 : (Fin (n+1) → ℝ) →L[ℝ] ℝ).analyticAt x).pow _)
  · intro j hj
    exact ((hb j hj).comp (tail.analyticAt x)).mul
      (((ContinuousLinearMap.proj 0 : (Fin (n+1) → ℝ) →L[ℝ] ℝ).analyticAt x).pow _)

end
end Source29NewtonFiniteJetAssembly

/- Component: NewtonCoefficientJetLimit.inc -/
namespace Source29NewtonCoefficientJetLimit

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29FiniteJetConvergence
open Source29NewtonInitialDataLimit Source29NewtonInitialDerivativeLimit
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Initial coefficient data determine the value and all first and second
directional limits of its normalized dilation. -/
theorem coefficient_jet_limit {f : (Fin n → ℝ) → ℝ} (hf : AnalyticAt ℝ f 0)
    (β : ℝ) (Q : MvPolynomial (Fin n) ℝ) (hdata : CoefficientData f β Q)
    (y : Fin n → ℝ) :
    JetConverges (𝓝[>] (0 : ℝ)) (fun ε z ↦ ε^(-β) * f (ε • z))
      (fun z ↦ eval z Q) y := by
  have hval := (coefficient_uniform_limit β Q hdata {y} (isCompact_singleton.isBounded)).tendsto_at
    (Set.mem_singleton y)
  have hfirst := coefficient_fderiv_limit β Q hdata y
  have hsecond := coefficient_fderiv_fderiv_limit β Q hdata y
  have hQa := Source29PolynomialLinkChart.analyticAt_eval_real Q y
  refine ⟨hval, ?_, ?_⟩
  · intro v
    exact ((ContinuousLinearMap.apply ℝ ℝ v).continuous.tendsto _).comp hfirst
  · intro u v
    have hu := ((ContinuousLinearMap.apply ℝ ((Fin n → ℝ) →L[ℝ] ℝ) u).continuous.tendsto _).comp hsecond
    have huv := ((ContinuousLinearMap.apply ℝ ℝ v).continuous.tendsto _).comp hu
    rw [second_eq_fderiv (fun z ↦ eval z Q) y u v hQa]
    apply huv.congr'
    filter_upwards [eventually_analyticAt_dilation hf β y] with ε hε
    exact (second_eq_fderiv (fun z ↦ ε^(-β) * f (ε • z)) y u v hε).symm

end
end Source29NewtonCoefficientJetLimit

/- Component: NewtonNormalizedJetLimit.inc -/
namespace Source29NewtonNormalizedJetLimit

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalizedShiftJets
open Source29FiniteJetConvergence Source29NewtonFiniteJetAssembly
open Source29NewtonShiftedFactorCoefficient Source29NewtonShiftedExpansion
open Source29NewtonFiniteRescaling Source29NewtonInitialDataLimit
open Source29NewtonInitialDerivativeLimit Source29NewtonCoefficientJetLimit
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

lemma family_eq_normalExpansion (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (m : ℕ) (hm : (finSuccEquiv ℝ n F).natDegree < m)
    (α D ε : ℝ) (hε : 0 < ε) :
    family F g α D ε = normalExpansion (Finset.range m) id
      (fun j y ↦ ε^(α*(j : ℝ)-D) * (shiftedSlice F (g (ε • y)) (ε • y)).coeff j) := by
  funext x
  calc
    family F g α D ε x =
        eval (Fin.cons (g (ε • tail x) + ε^α*x 0) (ε • tail x)) F / ε^D := by
      rw [family_eq, Real.rpow_neg hε.le]
      ring
    _ = expansion (Finset.range m) id
        (fun j y ↦ (shiftedSlice F (g y) y).coeff j) (ε^α*x 0) (ε • tail x) / ε^D := by
      rw [shifted_finite_expansion F g m hm]
    _ = _ := scaled_expansion (Finset.range m) id
      (fun j y ↦ (shiftedSlice F (g y) y).coeff j) (x 0) ε α D (ε • tail x) hε

lemma eval_eq_normalExpansion (N : MvPolynomial (Fin (n+1)) ℝ)
    (m : ℕ) (hm : (finSuccEquiv ℝ n N).natDegree < m) :
    (fun x ↦ eval x N) = normalExpansion (Finset.range m) id
      (fun j y ↦ eval y ((finSuccEquiv ℝ n N).coeff j)) := by
  funext x
  have hc : Fin.cons (x 0) (tail x) = x := by
    funext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  have he := polynomial_finite_expansion N m hm (x 0) (tail x)
  rw [hc] at he
  exact he

/-- Explicit initial data for the finitely many shifted normal coefficients
imply convergence of the actual normalized polynomial through two derivatives. -/
theorem family_jet_limit (F N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (m : ℕ) (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hN : (finSuccEquiv ℝ n N).natDegree < m) (α D : ℝ)
    (hdata : ∀ j < m, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff j)
      (D-α*(j : ℝ)) ((finSuccEquiv ℝ n N).coeff j)) (x : Fin (n+1) → ℝ) :
    JetConverges (𝓝[>] (0 : ℝ)) (family F g α D) (fun z ↦ eval z N) x := by
  have hcoeff : ∀ j, AnalyticAt ℝ (fun y ↦ (shiftedSlice F (g y) y).coeff j) 0 :=
    fun j ↦ Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F j g 0 hg
  have he : ∀ j : ℕ, -(D-α*(j : ℝ)) = α*(j : ℝ)-D := by intro j; ring
  have hj := normalExpansion_jet_limit (𝓝[>] (0 : ℝ)) (Finset.range m) id
    (fun j ε y ↦ ε^(α*(j : ℝ)-D) * (shiftedSlice F (g (ε • y)) (ε • y)).coeff j)
    (fun j y ↦ eval y ((finSuccEquiv ℝ n N).coeff j)) x
    (fun j hj ↦ by
      simpa only [he j] using coefficient_jet_limit (hcoeff j) (D-α*(j : ℝ))
        ((finSuccEquiv ℝ n N).coeff j) (hdata j (Finset.mem_range.mp hj)) (tail x))
    (fun j _ ↦ by
      simpa only [he j] using eventually_analyticAt_dilation (hcoeff j) (D-α*(j : ℝ)) (tail x))
    (fun j _ ↦ Source29PolynomialLinkChart.analyticAt_eval_real _ (tail x))
  apply hj.congr
  · filter_upwards [self_mem_nhdsWithin] with ε hε
    exact (family_eq_normalExpansion F g m hF α D ε hε).symm
  · exact (eval_eq_normalExpansion N m hN).symm

/-- The coordinate form consumed by the scaled minimal-graph equation. -/
theorem coordinate_jets_tendsto (F N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (m : ℕ) (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hN : (finSuccEquiv ℝ n N).natDegree < m) (α D : ℝ)
    (hdata : ∀ j < m, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff j)
      (D-α*(j : ℝ)) ((finSuccEquiv ℝ n N).coeff j)) (x : Fin (n+1) → ℝ) :
    (∀ i, Tendsto (fun ε ↦ gradient (family F g α D ε) x i)
      (𝓝[>] (0 : ℝ)) (𝓝 (eval x (pderiv i N)))) ∧
    (∀ i j, Tendsto (fun ε ↦ hessian (family F g α D ε) x i j)
      (𝓝[>] (0 : ℝ)) (𝓝 (eval x (pderiv i (pderiv j N))))) := by
  have ht := family_jet_limit F N g hg m hF hN α D hdata x
  constructor
  · intro i
    rw [← gradient_eval N x i]
    exact ht.2.1 (basis i)
  · intro i j
    rw [← hessian_eval N x i j]
    exact ht.2.2 (basis i) (basis j)

end
end Source29NewtonNormalizedJetLimit

/- Component: NewtonFaceJetLimit.inc -/
namespace Source29NewtonFaceJetLimit

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalizedShiftJets
open Source29FiniteJetConvergence Source29NewtonNormalizedJetLimit
open Source29NewtonWeightedFace Source29NewtonShiftedFactorCoefficient
open Source29NewtonInitialDataLimit Source29NewtonFaceCoefficientData
open scoped Topology

noncomputable section
variable {n d : ℕ}

/-- Initial data below the selected face, its top coefficient, and
analyticity supply every coefficient needed for the finite jet limit. -/
lemma all_coefficient_data (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (hc : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 0 < α)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α*(d : ℝ)-α*(j : ℕ)) (if j ∈ S then P j else 0)) :
    ∀ j : ℕ, CoefficientData (fun y ↦ (shiftedSlice F (g y) y).coeff j)
      (α*(d : ℝ)-α*j) ((finSuccEquiv ℝ n (face c S P)).coeff j) := by
  intro j
  rcases lt_trichotomy j d with hlt | heq | hgt
  · rw [lower_coefficient c S P ⟨j,hlt⟩]
    exact hdata ⟨j,hlt⟩
  · subst j
    exact data_at_face_top F g hg c hc S P α
  · exact data_above_face F g hg c S P α hα j hgt

/-- The actual normalized shifted polynomial converges through order two
to its selected Newton face at every fixed point. -/
theorem face_jet_limit (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (hc : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 0 < α) (m : ℕ) (hm : d < m)
    (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α*(d : ℝ)-α*(j : ℕ)) (if j ∈ S then P j else 0)) (x : Fin (n+1) → ℝ) :
    JetConverges (𝓝[>] (0 : ℝ)) (family F g α (α*d)) (fun z ↦ eval z (face c S P)) x :=
  family_jet_limit F (face c S P) g hg m hF (lt_of_le_of_lt (normal_degree_le c S P) hm)
    α (α*d) (fun j _ ↦ all_coefficient_data F g hg c hc S P α hα hdata j) x

/-- Coordinate first and second derivatives of the normalized family have
the exact polynomial-derivative limits used by the Newton residual. -/
theorem face_coordinate_jets_tendsto (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0)
    (c : ℝ) (hc : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 0 < α) (m : ℕ) (hm : d < m)
    (hF : (finSuccEquiv ℝ n F).natDegree < m)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α*(d : ℝ)-α*(j : ℕ)) (if j ∈ S then P j else 0)) (x : Fin (n+1) → ℝ) :
    (∀ i, Tendsto (fun ε ↦ gradient (family F g α (α*d) ε) x i)
      (𝓝[>] (0 : ℝ)) (𝓝 (eval x (pderiv i (face c S P))))) ∧
    (∀ i j, Tendsto (fun ε ↦ hessian (family F g α (α*d) ε) x i j)
      (𝓝[>] (0 : ℝ)) (𝓝 (eval x (pderiv i (pderiv j (face c S P)))))) :=
  coordinate_jets_tendsto F (face c S P) g hg m hF (lt_of_le_of_lt (normal_degree_le c S P) hm)
    α (α*d) (fun j _ ↦ all_coefficient_data F g hg c hc S P α hα hdata j) x

end
end Source29NewtonFaceJetLimit

/- Component: NewtonRegularObstruction.inc -/
namespace Source29NewtonRegularObstruction

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonWeightedFace
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The exact shifted leading equation and a pure ordinary initial limit
exclude all lower normal coefficient germs. The Newton residual and the
strict Newton slope are derived, rather than imposed on a proposed face. -/
theorem lower_coefficient_germs_zero
    (F : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hinitial : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d) (𝓝[>] 0) (𝓝 (c*x^d)))
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    ∀ j : Fin d, ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0 := by
  classical
  by_contra h
  have hne := not_forall.mp h
  obtain ⟨α,S,P,v,hα,hS,hP,horder,hselected,hdata⟩ :=
    Source29NewtonCoefficientSelection.exists_selected_coefficient_data
      (fun (j : Fin d) y ↦ (shiftedSlice F (g y) y).coeff (j:ℕ))
      (fun j ↦ Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F j g 0 hg)
      hne (Source29NewtonCoefficientLimitExtraction.lower_coefficient_limit_zero_of_pure_initial
        F g d c hinitial)
  have hαpos : 0 < α := lt_trans zero_lt_one hα
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  have hdata' : ∀ j : Fin d, Source29NewtonInitialDataLimit.CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j:ℕ))
      (α*(d:ℝ)-α*(j:ℕ)) (if j ∈ S then P j else 0) := by
    intro j
    simpa only [mul_sub] using hdata j
  let m := max (finSuccEquiv ℝ n F).natDegree d + 1
  have hFm : (finSuccEquiv ℝ n F).natDegree < m := Nat.lt_succ_of_le (le_max_left _ _)
  have hdm : d < m := Nat.lt_succ_of_le (le_max_right _ _)
  have hjets := Source29NewtonFaceJetLimit.face_coordinate_jets_tendsto
    F g hg c htop S P α hαpos m hdm hFm hdata'
  have hE : Source29NewtonNormalDerivative.newtonResidual (face c S P) = 0 :=
    Source29NormalizedShiftLimit.newtonResidual_eq_zero F (face c S P) g α (α*d)
      hα hg hg0 hF hbg (fun x ↦ (hjets x).1) (fun x ↦ (hjets x).2)
  have hlimit : ∀ z : ℝ × (Fin n → ℝ), Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•z.2)+t^α*z.1) (t•z.2)) F / t^(α*d))
      (𝓝[>] 0) (𝓝 (eval (Fin.cons z.1 z.2) (face c S P))) := by
    intro z
    have ht := Source29NewtonFaceCoefficientData.shifted_face_uniform_limit
      F g hg c htop S P α hαpos m hdm hFm hdata' |z.1| (abs_nonneg _)
      {z.2} Bornology.isBounded_singleton
    exact ht.tendsto_at (show z ∈ ({x : ℝ | |x| ≤ |z.1|} ×ˢ {z.2}) from
      ⟨by change |z.1| ≤ |z.1|; exact le_rfl, Set.mem_singleton _⟩)
  obtain ⟨hspos,hsneg⟩ := Source29LocalWeightedSignLimit.sign_inherited
    (fun z : ℝ × (Fin n → ℝ) ↦ eval (Fin.cons (g z.2+z.1) z.2) F)
    (fun z ↦ eval (Fin.cons z.1 z.2) (face c S P)) α (α*d) hαpos hpos hneg hlimit
  obtain ⟨j,hj⟩ := hS
  apply Source29NewtonFaceSelection.selected_face_contradiction c hc S P v α hαpos
    (fun j _ ↦ hP j) (fun j hj ↦ ((hselected j).mp hj).2)
    j hj ((hselected j).mp hj).1 hE
  · intro z hz
    have ht := hspos (z 0, Fin.tail z) hz
    simpa only [Fin.cons_self_tail] using ht
  · intro z hz
    have ht := hsneg (z 0, Fin.tail z) hz
    simpa only [Fin.cons_self_tail] using ht

end
end Source29NewtonRegularObstruction

/- Component: PureInitialFlatShift.inc -/
namespace Source29PureInitialFlatShift

open Filter MvPolynomial
open scoped Topology

noncomputable section

/-- Uniform initial scaling permits directions that converge with the scale. -/
theorem initial_tendsto_moving_argument {E V : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V]
    {f : E → V} {a : E} {p : FormalMultilinearSeries ℝ E V}
    (hp : HasFPowerSeriesAt f p a) (d : ℕ)
    (hlow : ∀ k < d, ∀ x, p k (fun _ => x) = 0)
    (z : ℝ → E) (z₀ : E) (hz : Tendsto z (𝓝[>] 0) (𝓝 z₀)) :
    Tendsto (fun t : ℝ => (t^d)⁻¹ • f (a+t•z t))
      (𝓝[>] 0) (𝓝 (p d (fun _ => z₀))) := by
  have hU := Source29AnalyticInitialScaling.initial_tendstoUniformlyOn hp d hlow
    (Metric.closedBall z₀ 1) (Metric.isBounded_closedBall)
  have hc : Continuous (fun x : E => p d (fun _ => x)) :=
    (p d).cont.comp (continuous_pi (fun _ => continuous_id))
  have hz' : Tendsto z (𝓝[>] 0) (𝓝[Metric.closedBall z₀ 1] z₀) := by
    apply tendsto_nhdsWithin_iff.mpr
    exact ⟨hz, hz.eventually (Metric.closedBall_mem_nhds z₀ zero_lt_one)⟩
  exact hU.tendsto_comp hc.continuousAt.continuousWithinAt hz'

/-- A differentiable function with zero value and derivative at the origin
is negligible along each line after division by its scale. -/
theorem flat_shift_div_tendsto_zero {n : ℕ} {g : (Fin n → ℝ) → ℝ}
    (hg : DifferentiableAt ℝ g 0) (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ => g (t • y) / t) (𝓝[>] 0) (𝓝 0) := by
  have hgf : HasFDerivAt g (0 : (Fin n → ℝ) →L[ℝ] ℝ) 0 := by simpa only [hD] using hg.hasFDerivAt
  have ht : HasDerivAt (fun t : ℝ => t • y) y 0 := by
    convert! (hasDerivAt_id (0 : ℝ)).smul_const y using 1
    simp only [one_smul]
  have hgf' : HasFDerivAt g (0 : (Fin n → ℝ) →L[ℝ] ℝ) ((fun t : ℝ => t • y) 0) := by
    simpa only [zero_smul] using hgf
  have hline : HasDerivAt (fun t : ℝ => g (t • y)) 0 0 := by
    convert! hgf'.comp_hasDerivAt 0 ht using 1
  simpa only [zero_add, zero_smul, hg0, sub_zero, smul_eq_mul,
    div_eq_mul_inv, mul_comm] using hline.tendsto_slope_zero_right

/-- A flat differentiable normal shift preserves a pure normal homogeneous
initial term of the ambient polynomial under ordinary scaling. -/
theorem normal_shift_pure_initial_limit {n : ℕ}
    (F : MvPolynomial (Fin (n+1)) ℝ)
    {p : FormalMultilinearSeries ℝ (Fin (n+1) → ℝ) ℝ}
    (hp : HasFPowerSeriesAt (fun z => eval z F) p 0) (d : ℕ) (c : ℝ)
    (hlow : ∀ k < d, ∀ z, p k (fun _ => z) = 0)
    (hpure : ∀ z, p d (fun _ => z) = c * (z 0)^d)
    {g : (Fin n → ℝ) → ℝ} (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0) (x : ℝ) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t • y) + t*x) (t • y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d)) := by
  let z : ℝ → (Fin (n+1) → ℝ) := fun t => Fin.cons (x + g (t • y)/t) y
  have hratio := flat_shift_div_tendsto_zero hg hg0 hD y
  have hz : Tendsto z (𝓝[>] 0) (𝓝 (Fin.cons x y)) := by
    apply tendsto_pi_nhds.mpr
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa only [z, Fin.cons_zero, add_zero] using
        (tendsto_const_nhds.add hratio : Tendsto (fun t => x + g (t • y)/t)
          (𝓝[>] 0) (𝓝 (x+0)))
    · exact tendsto_const_nhds
  have hlim := initial_tendsto_moving_argument hp d hlow z (Fin.cons x y) hz
  simp only [hpure, Fin.cons_zero] at hlim
  apply hlim.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have he : t • z t = Fin.cons (g (t • y) + t*x) (t • y) := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [z, Pi.smul_apply, Fin.cons_zero, smul_eq_mul]
      field_simp [(show 0 < t from ht).ne']
      ring
    · rfl
  simp only [zero_add, he, smul_eq_mul, div_eq_mul_inv, mul_comm]

/-- Analytic form of the flat-shift preservation theorem. -/
theorem analytic_normal_shift_pure_initial_limit {n : ℕ}
    (F : MvPolynomial (Fin (n+1)) ℝ)
    {p : FormalMultilinearSeries ℝ (Fin (n+1) → ℝ) ℝ}
    (hp : HasFPowerSeriesAt (fun z => eval z F) p 0) (d : ℕ) (c : ℝ)
    (hlow : ∀ k < d, ∀ z, p k (fun _ => z) = 0)
    (hpure : ∀ z, p d (fun _ => z) = c * (z 0)^d)
    {g : (Fin n → ℝ) → ℝ} (hg : AnalyticAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0) (x : ℝ) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t • y) + t*x) (t • y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d)) :=
  normal_shift_pure_initial_limit F hp d c hlow hpure hg.differentiableAt hg0 hD x y

end
end Source29PureInitialFlatShift

/- Component: RealInitialRescaling.inc -/
namespace Source29RealInitialRescaling

open MvPolynomial Filter
open Source29RealLowestRescale
open scoped Topology

noncomputable section

/-- Real polynomial initial rescaling is jointly continuous in scale and direction. -/
theorem continuous_eval_rescale_joint {n : ℕ} (F : MvPolynomial (Fin n) ℝ) (d : ℕ) :
    Continuous (fun z : ℝ × (Fin n → ℝ) => eval z.2 (rescale F d z.1)) := by
  simp only [rescale, map_sum, map_mul, eval_C]
  apply continuous_finsetSum
  intro k hk
  exact (continuous_fst.pow (k-d)).mul
    ((Source29CompactPolynomialLink.continuous_eval _).comp continuous_snd)

/-- Vanishing lower homogeneous components give the initial polynomial as the
normalized limit along every convergent family of directions. No degree bound
or chosen analytic power series is required. -/
theorem eval_dilate_div_pow_tendsto_moving {n : ℕ}
    (F : MvPolynomial (Fin n) ℝ) (d : ℕ)
    (hlow : ∀ k < d, homogeneousComponent k F = 0)
    (z : ℝ → (Fin n → ℝ)) (z₀ : Fin n → ℝ)
    (hz : Tendsto z (𝓝[>] 0) (𝓝 z₀)) :
    Tendsto (fun t : ℝ => eval (t • z t) F / t^d)
      (𝓝[>] 0) (𝓝 (eval z₀ (homogeneousComponent d F))) := by
  have ht0 : Tendsto (fun t : ℝ => t) (𝓝[>] 0) (𝓝 0) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hpair := ht0.prodMk_nhds hz
  have ht := ((continuous_eval_rescale_joint F d).tendsto (0,z₀)).comp hpair
  simp only [rescale_zero F d hlow] at ht
  apply ht.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have he := eval_rescale_mul F d hlow t (z t)
  change t^d * eval (z t) (rescale F d t) = eval (t • z t) F at he
  exact (eq_div_iff (pow_ne_zero d (show 0 < t from ht).ne')).mpr
    (by simpa only [Function.comp_apply, mul_comm] using he)

end
end Source29RealInitialRescaling

/- Component: PolynomialPureInitialShift.inc -/
namespace Source29PolynomialPureInitialShift

open MvPolynomial Filter
open scoped Topology

noncomputable section

/-- A pure normal homogeneous component survives an ordinary dilation after
any flat differentiable normal shift. All hypotheses are stated directly for
the polynomial and the shift. -/
theorem normal_shift_pure_initial_limit {n : ℕ}
    (F : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (c : ℝ)
    (hlow : ∀ k < d, homogeneousComponent k F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d)
    {g : (Fin n → ℝ) → ℝ} (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0) (x : ℝ) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t • y) + t*x) (t • y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d)) := by
  let z : ℝ → (Fin (n+1) → ℝ) := fun t => Fin.cons (x + g (t • y)/t) y
  have hratio := Source29PureInitialFlatShift.flat_shift_div_tendsto_zero hg hg0 hD y
  have hz : Tendsto z (𝓝[>] 0) (𝓝 (Fin.cons x y)) := by
    apply tendsto_pi_nhds.mpr
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa only [z, Fin.cons_zero, add_zero] using
        (tendsto_const_nhds.add hratio : Tendsto (fun t => x + g (t • y)/t)
          (𝓝[>] 0) (𝓝 (x+0)))
    · exact tendsto_const_nhds
  have hlim := Source29RealInitialRescaling.eval_dilate_div_pow_tendsto_moving
    F d hlow z (Fin.cons x y) hz
  simp only [hpure, map_mul, map_pow, eval_C, eval_X, Fin.cons_zero] at hlim
  apply hlim.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have he : t • z t = Fin.cons (g (t • y) + t*x) (t • y) := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [z, Pi.smul_apply, Fin.cons_zero, smul_eq_mul]
      field_simp [(show 0 < t from ht).ne']
      ring
    · rfl
  rw [he]

/-- Analytic specialization of polynomial initial-form preservation. -/
theorem analytic_normal_shift_pure_initial_limit {n : ℕ}
    (F : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (c : ℝ)
    (hlow : ∀ k < d, homogeneousComponent k F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d)
    {g : (Fin n → ℝ) → ℝ} (hg : AnalyticAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0) (x : ℝ) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t • y) + t*x) (t • y)) F / t^d)
      (𝓝[>] 0) (𝓝 (c*x^d)) :=
  normal_shift_pure_initial_limit F d c hlow hpure hg.differentiableAt hg0 hD x y

end
end Source29PolynomialPureInitialShift

/- Component: NewtonRegularFactorPositivity.inc -/
namespace Source29NewtonRegularFactorPositivity

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NormalShiftDerivatives
open Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The first nonzero normal degree equals the multiplicity of a full
irreducible factor once all lower normal coefficient germs vanish. -/
theorem multiplicity_eq_initial_degree
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k d : ℕ) (hF : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : ContinuousAt g 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g 0) 0) (pderiv 0 P) ≠ 0)
    (htop : (shiftedSlice F (g 0) 0).coeff d ≠ 0)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0) :
    d = k := by
  have hroot0 : eval (Fin.cons (g 0) 0) P = 0 := hroot.self_of_nhds
  have hk : k ≤ d := by
    by_contra h
    exact htop (coeff_shifted_factor_eq_zero_of_lt F P Q k hF (g 0) 0 hroot0 d
      (Nat.lt_of_not_ge h))
  have hd : d ≤ k := by
    by_contra h
    have hkd : k < d := Nat.lt_of_not_ge h
    exact (coefficient_not_eventually_zero F P Q k hF hP hPQ g 0 hg hroot hn)
      (hlower ⟨k,hkd⟩)
  exact le_antisymm hd hk

/-- At a regular full-multiplicity factor point, a pure ordinary shifted
initial form and the leading/background equations force strict cofactor
positivity. They also identify the initial degree and scalar coefficient. -/
theorem cofactor_pos_and_degree
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : 0 < eval (Fin.cons (g 0) 0) (pderiv 0 P))
    (hQ : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 ≤ eval (Fin.cons (g z.2+z.1) z.2) Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hinitial : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d) (𝓝[>] 0) (𝓝 (c*x^d))) :
    0 < eval (Fin.cons (g 0) 0) Q ∧ d = k ∧
      c = (eval (Fin.cons (g 0) 0) (pderiv 0 P))^k * eval (Fin.cons (g 0) 0) Q := by
  obtain ⟨hpos,hneg⟩ := Source29NewtonShiftedLocalSigns.factor_halfspace_signs
    F P Q k hk hfac g 0 hg hroot hn hQ
  have hlower := Source29NewtonRegularObstruction.lower_coefficient_germs_zero
    F g hg hg0 hF hbg d c hc hinitial hpos hneg
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  have hdk := multiplicity_eq_initial_degree F P Q k d hfac hP hPQ g hg.continuousAt
    hroot hn.ne' (by rwa [htop]) hlower
  have hformula : c = (eval (Fin.cons (g 0) 0) (pderiv 0 P))^k *
      eval (Fin.cons (g 0) 0) Q := by
    rw [← htop, hdk]
    exact coeff_shifted_factor F P Q k hfac (g 0) 0 hroot.self_of_nhds
  have hQnonneg : 0 ≤ eval (Fin.cons (g 0) 0) Q := by
    simpa only [Prod.fst_zero, Prod.snd_zero, add_zero] using hQ.self_of_nhds
  have hQne : eval (Fin.cons (g 0) 0) Q ≠ 0 := by
    intro hz
    apply hc
    rw [hformula, hz, mul_zero]
  exact ⟨lt_of_le_of_ne hQnonneg hQne.symm, hdk, hformula⟩

end
end Source29NewtonRegularFactorPositivity

/- Component: RegularBranchBackgroundEquation.inc -/
namespace Source29RegularBranchBackgroundEquation

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Embed tangential coordinates into the zero normal hyperplane. -/
def zeroNormal : (Fin n → ℝ) →L[ℝ] (Fin (n+1) → ℝ) :=
  ContinuousLinearMap.pi (fun i ↦ Fin.cases 0 (fun j ↦ ContinuousLinearMap.proj j) i)

lemma zeroNormal_eq (y : Fin n → ℝ) : zeroNormal y = Fin.cons 0 y := by
  funext i
  exact Fin.cases rfl (fun j ↦ rfl) i

lemma tail_zeroNormal (y : Fin n → ℝ) : tail (zeroNormal y) = y := rfl

lemma zeroNormal_basis (i : Fin n) : zeroNormal (basis i) = basis i.succ := by
  funext j
  refine Fin.cases ?_ (fun k ↦ ?_) j
  · simp [zeroNormal, basis]
  · simp [zeroNormal, basis, Pi.single_apply]

lemma chart_zeroNormal (g : (Fin n → ℝ) → ℝ) (y : Fin n → ℝ) :
    chart g (zeroNormal y) = Fin.cons (g y) y := by
  rw [chart_eq, tail_zeroNormal]
  simp only [zeroNormal, ContinuousLinearMap.pi_apply, Fin.cases_zero, zero_apply, zero_add]

lemma first_zero_germ {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x v : E) (hz : f =ᶠ[𝓝 x] fun _ ↦ 0) : fderiv ℝ f x v = 0 := by
  rw [hz.fderiv_eq]
  simp only [fderiv_const_apply, zero_apply]

lemma second_zero_germ {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (x u v : E) (hz : f =ᶠ[𝓝 x] fun _ ↦ 0) : second f x u v = 0 := by
  have he : (fun y ↦ fderiv ℝ f y v) =ᶠ[𝓝 x] fun _ ↦ 0 := by
    filter_upwards [hz.fderiv (𝕜 := ℝ)] with y hy
    simpa only [fderiv_const_apply, zero_apply] using congrArg (fun L ↦ L v) hy
  exact first_zero_germ (fun y ↦ fderiv ℝ f y v) x u he

/-- The restriction to a root branch has zero tangential first and second jets. -/
theorem tangential_jets_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    (∀ i : Fin n, gradient (pullback P g) (zeroNormal a) i.succ = 0) ∧
    (∀ i j : Fin n, hessian (pullback P g) (zeroNormal a) i.succ j.succ = 0) := by
  have ha : AnalyticAt ℝ (pullback P g) (zeroNormal a) := analyticAt_pullback P g _ hg
  have hz : (fun y ↦ pullback P g (zeroNormal y)) =ᶠ[𝓝 a] fun _ ↦ 0 := by
    filter_upwards [hroot] with y hy
    simpa only [pullback, chart_zeroNormal] using hy
  constructor
  · intro i
    have he := first_linear (pullback P g) zeroNormal a (basis i) ha.differentiableAt
    rw [zeroNormal_basis] at he
    exact he.symm.trans (first_zero_germ _ a (basis i) hz)
  · intro i j
    have he := second_linear (pullback P g) zeroNormal a (basis i) (basis j) ha
    rw [zeroNormal_basis, zeroNormal_basis] at he
    exact he.symm.trans (second_zero_germ _ a (basis i) (basis j) hz)

/-- Divisibility of the cubic level operator makes every regular analytic
root branch a solution of the minimal-graph equation. -/
theorem background_at_of_dvd (P : MvPolynomial (Fin (n+1)) ℝ)
    (hdiv : P ∣ Source29QuarticReuse.QuarticMinimal.leadingOperator P)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0) :
    backgroundGraphOperator (gradient g a) (hessian g a) = 0 := by
  have heval : eval (chart g (zeroNormal a))
      (Source29QuarticReuse.QuarticMinimal.leadingOperator P) = 0 := by
    obtain ⟨R,hR⟩ := hdiv
    rw [hR, map_mul, chart_zeroNormal, hroot.self_of_nhds, zero_mul]
  obtain ⟨hB,hU⟩ := tangential_jets_zero P g a hg hroot
  have hA : gradient (pullback P g) (zeroNormal a) 0 =
      eval (Fin.cons (g a) a) (pderiv 0 P) := by
    rw [gradient_pullback_zero P g (zeroNormal a) hg, gradient_eval, chart_zeroNormal]
  have he := polynomial_cubicLevel_transform P g (zeroNormal a) hg
  dsimp only at he
  rw [cubicLevel_eval, heval] at he
  simp only [hB, hU, tail_zeroNormal, newtonResidual, correction, traceComplement,
    dot, trace, bilinear, mul_zero, zero_mul, Finset.sum_const_zero, zero_sub,
    sub_zero, add_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)] at he
  have hprod : (gradient (pullback P g) (zeroNormal a) 0)^3 *
      backgroundGraphOperator (gradient g a) (hessian g a) = 0 := by linarith
  exact (mul_eq_zero.mp hprod).resolve_left (pow_ne_zero 3 (by rwa [hA]))

/-- Local analyticity, regularity, and the branch equation yield the
background PDE throughout a neighborhood of the base tangential point. -/
theorem eventually_background_of_dvd (P : MvPolynomial (Fin (n+1)) ℝ)
    (hdiv : P ∣ Source29QuarticReuse.QuarticMinimal.leadingOperator P)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0) :
    ∀ᶠ y in 𝓝 a, backgroundGraphOperator (gradient g y) (hessian g y) = 0 := by
  have hgraph : ContinuousAt (fun y : Fin n → ℝ ↦
      (Fin.cons (g y) y : Fin (n+1) → ℝ)) a := by
    apply continuousAt_pi.mpr
    intro i
    exact Fin.cases hg.continuousAt (fun j ↦ (continuous_apply j).continuousAt) i
  have hnormal : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) (pderiv 0 P) ≠ 0 :=
    ((Source29PolynomialLinkChart.analyticAt_eval_real (pderiv 0 P) _).continuousAt.comp hgraph).eventually_ne hn
  filter_upwards [hg.eventually_analyticAt, hroot.eventually_nhds, hnormal] with y hgy hry hny
  exact background_at_of_dvd P hdiv g y hgy hry hny

end
end Source29RegularBranchBackgroundEquation

/- Component: NewtonRegularFactorCriterion.inc -/
namespace Source29NewtonRegularFactorCriterion

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Cubic factor inheritance supplies the background graph equation of
every regular analytic branch of a full-multiplicity irreducible factor. -/
theorem background_of_full_factor
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 1 ≤ k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (hn : eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0) :
    ∀ᶠ y in 𝓝 a, backgroundGraphOperator (gradient g y) (hessian g y) = 0 := by
  have hcub : Source29FactorInheritance.cubicOperator (P^k*Q) = 0 := by
    change Source29QuarticReuse.QuarticMinimal.leadingOperator (P^k*Q) = 0
    rwa [← hfac]
  have hdiv : P ∣ Source29QuarticReuse.QuarticMinimal.leadingOperator P :=
    Source29RealLeadingFactor.real_factor_inheritance P Q k hk hP hPQ hcub
  exact Source29RegularBranchBackgroundEquation.eventually_background_of_dvd P hdiv g a hg hroot hn

/-- A pure ordinary shifted initial form forces positive residual cofactor
at a regular factor point. The background PDE is derived from the leading
polynomial equation and full multiplicity, rather than assumed. -/
theorem cofactor_pos_of_pure_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : 0 < eval (Fin.cons (g 0) 0) (pderiv 0 P))
    (hQ : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 ≤ eval (Fin.cons (g z.2+z.1) z.2) Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hinitial : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d) (𝓝[>] 0) (𝓝 (c*x^d))) :
    0 < eval (Fin.cons (g 0) 0) Q ∧ d = k ∧
      c = (eval (Fin.cons (g 0) 0) (pderiv 0 P))^k * eval (Fin.cons (g 0) 0) Q := by
  have hbg := background_of_full_factor F P Q k hk.pos hfac hP hPQ hF g 0 hg hroot hn.ne'
  exact Source29NewtonRegularFactorPositivity.cofactor_pos_and_degree
    F P Q k hk hfac hP hPQ g hg hg0 hroot hn hQ hF hbg d c hc hinitial

end
end Source29NewtonRegularFactorCriterion

/- Component: NewtonRegularInitialFormPositivity.inc -/
namespace Source29NewtonRegularInitialFormPositivity

open MvPolynomial Filter
open Source29NormalShiftDerivatives
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The regular-factor positivity criterion stated entirely in terms of
actual polynomial homogeneous components and a flat analytic root branch.
The background equation and the shifted initial limit are both derived. -/
theorem cofactor_pos_of_pure_homogeneous_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hD : fderiv ℝ g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (hQ : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 ≤ eval (Fin.cons (g z.2+z.1) z.2) Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    0 < eval (0 : Fin (n+1) → ℝ) Q ∧ d = k ∧
      c = (eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k * eval (0 : Fin (n+1) → ℝ) Q := by
  have hgrad : gradient g 0 = 0 := by
    funext i
    change fderiv ℝ g 0 (basis i) = 0
    rw [hD]
    rfl
  have hbase : (Fin.cons (g 0) 0 : Fin (n+1) → ℝ) = 0 := by
    rw [hg0]
    funext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  have hn' : 0 < eval (Fin.cons (g 0) 0) (pderiv 0 P) := by rwa [hbase]
  have ht := Source29NewtonRegularFactorCriterion.cofactor_pos_of_pure_initial
    F P Q k hk hfac hP hPQ g hg hgrad hroot hn' hQ hF d c hc
    (Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
      F d c hlow hpure hg hg0 hD)
  simpa only [hbase] using ht

/-- Local ambient nonnegativity of the cofactor suffices for the same
criterion; the needed shifted sign condition follows by continuity. -/
theorem cofactor_pos_of_ambient_nonneg
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hD : fderiv ℝ g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    0 < eval (0 : Fin (n+1) → ℝ) Q ∧ d = k ∧
      c = (eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k * eval (0 : Fin (n+1) → ℝ) Q := by
  have hchart : Tendsto (fun z : ℝ × (Fin n → ℝ) ↦
      (Fin.cons (g z.2+z.1) z.2 : Fin (n+1) → ℝ)) (𝓝 0) (𝓝 0) := by
    apply tendsto_pi_nhds.mpr
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · have hsnd : Tendsto (Prod.snd : ℝ × (Fin n → ℝ) → (Fin n → ℝ))
          (𝓝 0) (𝓝 0) := continuous_snd.tendsto 0
      have hfst : Tendsto (Prod.fst : ℝ × (Fin n → ℝ) → ℝ)
          (𝓝 0) (𝓝 0) := continuous_fst.tendsto 0
      have ht := (hg.continuousAt.tendsto.comp hsnd).add hfst
      simpa only [hg0, zero_add, Pi.zero_apply, Fin.cons_zero, Function.comp_apply] using ht
    · exact ((continuous_apply j).comp continuous_snd).continuousAt.tendsto
  exact cofactor_pos_of_pure_homogeneous_initial F P Q k hk hfac hP hPQ g hg hg0 hD
    hroot hn (hchart.eventually hQ) hF d c hc hlow hpure

end
end Source29NewtonRegularInitialFormPositivity

/- Component: FlatRegularGraph.inc -/
namespace Source29FlatRegularGraph

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29RegularBranchBackgroundEquation
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Coordinate vanishing of the derivative is equivalent to vanishing of the
whole continuous linear map on the finite coordinate space. -/
lemma fderiv_eq_zero_of_gradient_eq_zero (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (h : gradient g a = 0) : fderiv ℝ g a = 0 := by
  ext v
  have hv : v = ∑ i : Fin n, v i • Pi.single i (1 : ℝ) := by
    funext j
    simp [Pi.single_apply]
  have hi (i : Fin n) : fderiv ℝ g a (Pi.single i 1) = 0 := congrFun h i
  rw [hv, map_sum]
  simp only [map_smul, smul_eq_mul, hi, mul_zero, Finset.sum_const_zero, zero_apply]

/-- A regular root branch has horizontal tangent when the polynomial's
normal derivative is nonzero and all its tangential derivatives vanish. -/
theorem gradient_zero_of_regular_branch (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : eval 0 (pderiv 0 P) ≠ 0)
    (ht : ∀ i : Fin n, eval 0 (pderiv i.succ P) = 0) : gradient g 0 = 0 := by
  have hbase : chart g (zeroNormal (0 : Fin n → ℝ)) = 0 := by
    rw [chart_zeroNormal, hg0]
    funext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  funext i
  have he := (tangential_jets_zero P g 0 hg hroot).1 i
  rw [gradient_pullback_succ P g (zeroNormal 0) hg i,
    hbase, tail_zeroNormal, gradient_eval, gradient_eval, ht i, zero_add] at he
  exact (mul_eq_zero.mp he).resolve_right hn

/-- Normal regularity and horizontal tangency produce an analytic root graph
whose value and full first derivative vanish at the origin. -/
theorem exists_flat_local_graph (P : MvPolynomial (Fin (n+1)) ℝ)
    (hP : eval 0 P = 0) (hn : eval 0 (pderiv 0 P) ≠ 0)
    (ht : ∀ i : Fin n, eval 0 (pderiv i.succ P) = 0) :
    ∃ g : (Fin n → ℝ) → ℝ, AnalyticAt ℝ g 0 ∧ g 0 = 0 ∧ gradient g 0 = 0 ∧
      fderiv ℝ g 0 = 0 ∧ (∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0) := by
  obtain ⟨g, hg, hg0, hroot⟩ := Source29RealImplicitPolynomialRoot.exists_local_level_graph P 0 hn
  change AnalyticAt ℝ g 0 at hg
  change g 0 = 0 at hg0
  change ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = eval 0 P at hroot
  rw [hP] at hroot
  have hgrad := gradient_zero_of_regular_branch P g hg hg0 hroot hn ht
  exact ⟨g, hg, hg0, hgrad, fderiv_eq_zero_of_gradient_eq_zero g 0 hgrad, hroot⟩

/-- Divisibility of the leading operator also gives the local minimal-graph
background equation for the produced flat analytic graph. -/
theorem exists_flat_local_minimal_graph (P : MvPolynomial (Fin (n+1)) ℝ)
    (hP : eval 0 P = 0) (hn : eval 0 (pderiv 0 P) ≠ 0)
    (ht : ∀ i : Fin n, eval 0 (pderiv i.succ P) = 0)
    (hdiv : P ∣ Source29QuarticReuse.QuarticMinimal.leadingOperator P) :
    ∃ g : (Fin n → ℝ) → ℝ, AnalyticAt ℝ g 0 ∧ g 0 = 0 ∧ gradient g 0 = 0 ∧
      fderiv ℝ g 0 = 0 ∧ (∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0) ∧
      (∀ᶠ y in 𝓝 0, Source29NormalShiftAlgebra.backgroundGraphOperator
        (gradient g y) (hessian g y) = 0) := by
  obtain ⟨g,hg,hg0,hgrad,hD,hroot⟩ := exists_flat_local_graph P hP hn ht
  refine ⟨g,hg,hg0,hgrad,hD,hroot,?_⟩
  apply eventually_background_of_dvd P hdiv g 0 hg hroot
  have he : (Fin.cons (g 0) (0 : Fin n → ℝ) : Fin (n+1) → ℝ) = 0 := by
    rw [hg0]
    funext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  rwa [he]

end
end Source29FlatRegularGraph

/- Component: RegularFactorPureInitialCriterion.inc -/
namespace Source29RegularFactorPureInitialCriterion

open MvPolynomial Filter
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- At a regular factor point in normal coordinates, a pure ordinary initial
form forces strict residual positivity. The analytic branch, its flatness,
its minimal equation, the weighted face, and the limiting Newton equation
are all derived inside the proof. -/
theorem cofactor_pos_of_pure_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hP0 : eval (0 : Fin (n+1) → ℝ) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (ht : ∀ i : Fin n, eval (0 : Fin (n+1) → ℝ) (pderiv i.succ P) = 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    0 < eval (0 : Fin (n+1) → ℝ) Q ∧ d = k ∧
      c = (eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k * eval (0 : Fin (n+1) → ℝ) Q := by
  obtain ⟨g,hg,hg0,_,hD,hroot⟩ :=
    Source29FlatRegularGraph.exists_flat_local_graph P hP0 hn.ne' ht
  exact Source29NewtonRegularInitialFormPositivity.cofactor_pos_of_ambient_nonneg
    F P Q k hk hfac hP hPQ g hg hg0 hD hroot hn hQ hF d c hc hlow hpure

end
end Source29RegularFactorPureInitialCriterion

/- Component: HalfspacePhaseMass.inc -/
namespace Source29HalfspacePhaseMass

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29NonlinearCalibration Source29PhaseMassLimit
open Source29PhaseApproximation Source29SmoothPhaseTransition Source29CoordinatePhaseMass
open Source29CoordinateHalfspaceFlux Source29VariationConvexity Source29SmoothCalibrationRecovery
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

lemma coordinate_weakCalibration :
    WeakCalibration (leadingNormalizedField (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ)) := by
  have hn : leadingNormalizedField (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) =
      (fun _ ↦ Pi.single 0 1) := funext normalizedField_X
  rw [hn]
  refine ⟨?_, ?_⟩
  · intro x i
    simp only [Pi.single_apply]
    split_ifs <;> norm_num
  · intro ρ hρ hcρ
    refine ⟨testFlux_integrable _ hρ hcρ (fun _ ↦ continuous_const), ?_⟩
    exact integral_testFlux_eq_zero _ hρ hcρ (fun _ ↦ contDiff_const)
      (fun x ↦ by simp [divergence])

lemma coordinate_gradient_density (x : Fin (n+1) → ℝ) :
    variationDensity (evaluatedGradient (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) x) = 1 := by
  simp [variationDensity, evaluatedGradient, pderiv_X, Pi.single_apply, eq_comm]

/-- Product rule with a transition in the normal coordinate and an arbitrary field. -/
lemma coordinate_product_flux (Z : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (x : Fin (n+1) → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (y 0)) Z x =
      h (x 0) * testFlux (fun i ↦ Pi.single i 1) ρ Z x +
      ρ x * deriv h (x 0) * Z x 0 := by
  have he := fun i ↦ composed_product_fderiv
    (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) hρ hh x i
  simp only [eval_X, evaluatedGradient, pderiv_X] at he
  simp only [Pi.single_apply, apply_ite (eval x), map_one, map_zero] at he
  simp only [testFlux, he, add_mul, Finset.sum_add_distrib, mul_assoc]
  rw [← Finset.mul_sum]
  simp

/-- Testing the weak calibration with a coordinate transition gives an exact
cross-flux identity, without a trace assumption on the field. -/
theorem coordinate_cross_flux_identity
    (Z : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ) (hZ : WeakCalibration Z)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hb : ∀ t, ‖h t‖ ≤ 1) :
    Integrable (fun x ↦ ρ x * deriv h (x 0) * Z x 0) ∧
    (∫ x, ρ x * deriv h (x 0) * Z x 0) =
      -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ Z x * h (x 0)) := by
  have hw : Integrable (fun x ↦ testFlux (fun i ↦ Pi.single i 1) ρ Z x * h (x 0)) :=
    ((hZ.2 ρ hρ hcρ).1).mul_bdd (hh.continuous.comp (continuous_apply 0)).aestronglyMeasurable
      (Filter.Eventually.of_forall (fun x ↦ hb (x 0)))
  have ht : ContDiff ℝ 1 (fun x : Fin (n+1) → ℝ ↦ ρ x * h (x 0)) :=
    hρ.mul (hh.comp (by simpa only [eval_X] using
      (contDiff_eval (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ))))
  have hp := hZ.2 _ ht hcρ.mul_right
  have he : (fun x ↦ ρ x * deriv h (x 0) * Z x 0) =
      (fun x ↦ testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (y 0)) Z x -
        testFlux (fun i ↦ Pi.single i 1) ρ Z x * h (x 0)) := by
    funext x
    rw [coordinate_product_flux Z hρ hh]
    ring
  refine ⟨he ▸ hp.1.sub hw, ?_⟩
  rw [he, integral_sub hp.1 hw, hp.2, zero_sub]

/-- A bounded divergence-free field has at most plane flux through a halfspace. -/
theorem coordinate_flux_le_plane
    (Z : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ) (hZ : WeakCalibration Z)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ Z x * (if 0 < x 0 then 1 else 0)) ≤
      ∫ y : Fin n → ℝ, ρ (Fin.cons 0 y) := by
  have hleft := (transition_weighted_integral
    (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) (X_ne_zero 0)
    (testFlux (fun i ↦ Pi.single i 1) ρ Z) (hZ.2 ρ hρ hcρ).1).neg
  simp only [eval_X] at hleft
  have hright := phaseMass_tendsto
    (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) (X_ne_zero 0)
    coordinate_weakCalibration hρ hcρ
  simp only [eval_X, coordinate_gradient_density, mul_one, phaseMass_X hρ hcρ] at hright
  apply le_of_tendsto_of_tendsto hleft hright
  apply Filter.Eventually.of_forall
  intro k
  have hc := coordinate_cross_flux_identity Z hZ hρ hcρ
    (transition_contDiff k) (transition_norm_le_one k)
  dsimp only
  rw [← hc.2]
  apply integral_mono hc.1
    ((hρ.continuous.mul ((transition_contDiff k).continuous_deriv_one.comp
      (continuous_apply 0))).integrable_of_hasCompactSupport hcρ.mul_right)
  intro x
  exact mul_le_of_le_one_right (mul_nonneg (hρpos x) (transition_deriv_nonneg k _))
    ((le_abs_self (Z x 0)).trans (by simpa only [Real.norm_eq_abs] using hZ.1 x 0))

lemma positive_phase_eq_halfspace_ae (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x P)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x P ≤ 0) :
    (fun x ↦ if 0 < eval x P then (1 : ℝ) else 0) =ᵐ[volume]
      (fun x ↦ if 0 < x 0 then (1 : ℝ) else 0) := by
  filter_upwards [mvPolynomial_eval_ne_zero_ae (n+1) P hP,
    mvPolynomial_eval_ne_zero_ae (n+1)
      (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) (X_ne_zero 0)] with x hp hx
  simp only [eval_X] at hx
  rcases lt_or_gt_of_ne hx with hn | hp0
  · simp only [not_lt_of_ge (hneg x hn), not_lt_of_ge hn.le, ite_false]
  · simp only [lt_of_le_of_ne (hpos x hp0) (Ne.symm hp), hp0, ite_true]

/-- A calibrated polynomial whose strict positive phase agrees almost everywhere
with the coordinate halfspace has exactly the plane mass. -/
theorem phaseMass_eq_plane_of_phase_ae (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (hphase : (fun x ↦ if 0 < eval x P then (1 : ℝ) else 0) =ᵐ[volume]
      (fun x ↦ if 0 < x 0 then (1 : ℝ) else 0))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    phaseMass P ρ = ∫ y : Fin n → ℝ, ρ (Fin.cons 0 y) := by
  apply le_antisymm
  · have he : phaseMass P ρ =
        -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x *
          (if 0 < x 0 then 1 else 0)) := by
      unfold phaseMass
      congr 1
      apply integral_congr_ae
      filter_upwards [hphase] with x hx
      rw [hx]
    rw [he]
    exact coordinate_flux_le_plane _ hcal hρ hcρ hρpos
  · let V : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ :=
      cutoffField ρ (fun _ ↦ Pi.single 0 1)
    have hV i : ContDiff ℝ 1 (fun x ↦ V x i) := hρ.mul contDiff_const
    have hcV i : HasCompactSupport (fun x ↦ V x i) := hcρ.mul_right
    have hbV x : variationDensity (V x) ≤ ρ x := by
      simp [V, cutoffField, variationDensity, Pi.single_apply, Real.sqrt_sq_eq_abs, abs_of_nonneg (hρpos x)]
    have hdV x : divergence (fun i ↦ Pi.single i 1) V x =
        fderiv ℝ ρ x (Pi.single 0 1) := by
      change divergence (fun i ↦ Pi.single i 1) (cutoffField ρ (fun _ ↦ Pi.single 0 1)) x = _
      rw [divergence_cutoffField (A := fun _ : Fin (n+1) → ℝ ↦ Pi.single 0 1) hρ
        (fun _ ↦ contDiff_const) x]
      simp [testFlux, divergence, Pi.single_apply]
    have hb := phase_divergence_le_mass P hP hcal hρ hcρ V hV hcV hbV
    have he : (∫ x, (if 0 < eval x P then (1 : ℝ) else 0) *
        divergence (fun i ↦ Pi.single i 1) V x) =
        ∫ x, fderiv ℝ ρ x (Pi.single 0 1) * (if 0 < x 0 then 1 else 0) := by
      apply integral_congr_ae
      filter_upwards [hphase] with x hx
      rw [hx, hdV, mul_comm]
    rw [he] at hb
    have hplane := coordinate_halfspace_flux hρ hcρ
    rw [← hplane]
    exact (neg_le_abs _).trans hb

/-- Weak halfspace signs suffice: additional polynomial zeros have measure zero.
Homogeneity and a pointwise trace of the normalized field are not required. -/
theorem phaseMass_eq_plane (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x P)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x P ≤ 0)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    phaseMass P ρ = ∫ y : Fin n → ℝ, ρ (Fin.cons 0 y) :=
  phaseMass_eq_plane_of_phase_ae P hP hcal (positive_phase_eq_halfspace_ae P hP hpos hneg)
    hρ hcρ hρpos

/-- At unit scale every nonnegative radial cutoff gives exactly the mass of
an n-dimensional plane. -/
theorem phaseMass_radial_eq_planeMass (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x P)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x P ≤ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hfpos : ∀ s, 0 ≤ f s)
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ s, R ≤ s → f s = 0) :
    phaseMass P (Source29LevelRadialStress.radialWeight f 1) =
      Source29PolynomialSmallDensity.planeMass n f := by
  rw [phaseMass_eq_plane P hP hcal hpos hneg
    (Source29LevelRadialStress.radialWeight_contDiff hf 1)
    (Source29LevelRadialStress.radialWeight_compact hR zero_lt_one hz)
    (fun x ↦ hfpos _)]
  unfold Source29PolynomialSmallDensity.planeMass
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ by
    simp [Source29LevelRadialStress.radialWeight, radiusSq, Fin.sum_univ_succ]

end
end Source29HalfspacePhaseMass

/- Component: HomogeneousLevelInfinity.inc -/
namespace Source29HomogeneousLevelInfinity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29PolynomialTranslation Source29TopLocalInitial Source29WeakCalibrationLimits
open Source29InitialGradientLimit Source29InitialPhaseFluxLimit
open Source29PhaseMassLimit Source29PhaseMassDilation
open Source29LevelRadialStress Source29LevelRadialMonotonicity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

lemma center_add_dilate (c x : Fin n → ℝ) {r : ℝ} (hr : r ≠ 0) :
    c + r • x = r • (x + r⁻¹ • c) := by
  rw [smul_add, smul_smul, mul_inv_cancel₀ hr, one_smul, add_comm]

lemma shifted_direction_tendsto (c x : Fin n → ℝ) :
    Tendsto (fun r : ℝ => x + r⁻¹ • c) atTop (𝓝 x) := by
  have hc : Tendsto (fun r : ℝ => r⁻¹ • c) atTop (𝓝 (0 : Fin n → ℝ)) := by
    simpa only [zero_smul] using (tendsto_inv_atTop_zero :
      Tendsto (fun r : ℝ => r⁻¹) atTop (𝓝 0)).smul_const c
  simpa only [add_zero] using tendsto_const_nhds.add hc

lemma normalizedField_sub_C (H : MvPolynomial (Fin n) ℝ) (t : ℝ) :
    leadingNormalizedField (H-C t) = leadingNormalizedField H := by
  have hg : evaluatedGradient (H-C t) = evaluatedGradient H := by
    funext x i
    simp [evaluatedGradient]
  funext x i
  simp only [leadingNormalizedField, hg]

lemma normalizedField_homogeneous (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) {r : ℝ} (hr : 0 < r) (x : Fin n → ℝ) :
    leadingNormalizedField H (r • x) = leadingNormalizedField H x := by
  have hg : evaluatedGradient H (r • x) = r^s • evaluatedGradient H x := by
    funext i
    exact eval_dilate_homogeneous (pderiv i H) (isHomogeneous_pderiv_succ H i s hH) x r
  funext i
  simp only [leadingNormalizedField, hg, Pi.smul_apply, smul_eq_mul]
  exact normalized_ratio_pos_scale (evaluatedGradient H x) (pow_pos hr s) i

lemma normalizedField_translated_level_scale (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) (t : ℝ) (c x : Fin n → ℝ)
    {r : ℝ} (hr : 0 < r) :
    leadingNormalizedField (translate (H-C t) c) (r • x) =
      leadingNormalizedField H (x + r⁻¹ • c) := by
  rw [leadingNormalizedField_translate, normalizedField_sub_C,
    center_add_dilate c x hr.ne', normalizedField_homogeneous H s hH hr]

lemma normalizedField_continuousAt (H : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ)
    (hx : evaluatedGradient H x ≠ 0) (i : Fin n) :
    ContinuousAt (fun y => leadingNormalizedField H y i) x := by
  have hg (j : Fin n) : Continuous (fun y => evaluatedGradient H y j) :=
    (contDiff_eval (pderiv j H)).continuous
  have hs : Continuous (fun y => radiusSq (evaluatedGradient H y)) :=
    continuous_finsetSum _ (fun j _ => (hg j).pow 2)
  exact (hg i).continuousAt.div hs.sqrt.continuousAt
    (Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hx)).ne'

lemma translated_level_normalizedField_atTop (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) (t : ℝ) (c x : Fin n → ℝ)
    (hx : evaluatedGradient H x ≠ 0) (i : Fin n) :
    Tendsto (fun r : ℝ => leadingNormalizedField (translate (H-C t) c) (r • x) i)
      atTop (𝓝 (leadingNormalizedField H x i)) := by
  have ht := (normalizedField_continuousAt H x hx i).tendsto.comp
    (shifted_direction_tendsto c x)
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
  exact congrFun (normalizedField_translated_level_scale H s hH t c x hr).symm i

lemma translated_level_eval_div (H : MvPolynomial (Fin n) ℝ) (d : ℕ)
    (hH : H.IsHomogeneous d) (t : ℝ) (c x : Fin n → ℝ) {r : ℝ} (hr : 0 < r) :
    eval (r • x) (translate (H-C t) c) / r^d =
      eval (x + r⁻¹ • c) H - t/r^d := by
  rw [eval_translate, map_sub, eval_C]
  change (eval (c + r • x) H-t)/r^d = _
  rw [center_add_dilate c x hr.ne', eval_dilate_homogeneous H hH,
    sub_div, mul_div_cancel_left₀ _ (pow_ne_zero d hr.ne')]

lemma translated_level_eval_div_atTop (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) (t : ℝ) (c x : Fin n → ℝ) :
    Tendsto (fun r : ℝ => eval (r • x) (translate (H-C t) c) / r^(s+1))
      atTop (𝓝 (eval x H)) := by
  have hc := (contDiff_eval H).continuous.continuousAt.tendsto.comp
    (shifted_direction_tendsto c x)
  have ht : Tendsto (fun r : ℝ => t/r^(s+1)) atTop (𝓝 0) := by
    simpa only [div_eq_mul_inv, ← inv_pow, zero_pow (by omega : s+1 ≠ 0), mul_zero] using
      ((tendsto_inv_atTop_zero : Tendsto (fun r : ℝ => r⁻¹) atTop (𝓝 0)).pow (s+1)).const_mul t
  have hh := hc.sub ht
  simp only [sub_zero] at hh
  apply hh.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
  exact (translated_level_eval_div H (s+1) hH t c x hr).symm

lemma translated_level_phase_atTop (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) (t : ℝ) (c x : Fin n → ℝ) (hx : eval x H ≠ 0) :
    Tendsto (fun r : ℝ => if 0 < eval (r • x) (translate (H-C t) c) then (1 : ℝ) else 0)
      atTop (𝓝 (if 0 < eval x H then (1 : ℝ) else 0)) := by
  have hl := translated_level_eval_div_atTop H s hH t c x
  by_cases hp : 0 < eval x H
  · apply tendsto_const_nhds.congr'
    filter_upwards [hl.eventually (eventually_gt_nhds hp), eventually_gt_atTop (0 : ℝ)] with r hr hpos
    have hval : 0 < eval (r • x) (translate (H-C t) c) :=
      (div_pos_iff_of_pos_right (pow_pos hpos (s+1))).mp hr
    simp only [hp, hval, ite_true]
  · have hn : eval x H < 0 := lt_of_le_of_ne (le_of_not_gt hp) hx
    apply tendsto_const_nhds.congr'
    filter_upwards [hl.eventually (eventually_lt_nhds hn), eventually_gt_atTop (0 : ℝ)] with r hr hpos
    have hval : ¬ 0 < eval (r • x) (translate (H-C t) c) := by
      intro hv
      exact (not_lt_of_ge hr.le) ((div_pos_iff_of_pos_right (pow_pos hpos (s+1))).mpr hv)
    simp only [hp, hval, ite_false]

/-- The fixed-scale phase flux of every translated homogeneous level tends
to the phase flux of the original homogeneous polynomial at large radius. -/
theorem phaseFlux_translated_level_atTop (H : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hH : H.IsHomogeneous (s+1)) (hHne : H ≠ 0) (t : ℝ) (c : Fin n → ℝ)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun r : ℝ => -(∫ x, testFlux (fun i => Pi.single i 1) ρ
      (fun y => leadingNormalizedField (translate (H-C t) c) (r • y)) x *
        (if 0 < eval (r • x) (translate (H-C t) c) then 1 else 0))) atTop
      (𝓝 (phaseMass H ρ)) := by
  apply Tendsto.neg
  apply tendsto_integral_filter_of_dominated_convergence (testBound (fun i => Pi.single i 1) ρ)
  · exact Eventually.of_forall fun r =>
      ((scaled_flux_measurable (translate (H-C t) c) r hρ).mul
        (scaled_phase_measurable (translate (H-C t) c) r)).aestronglyMeasurable
  · exact Eventually.of_forall fun r => Eventually.of_forall fun x => by
      rw [norm_mul]
      have hb := norm_testFlux_le_testBound (fun i => Pi.single i 1) ρ
        (fun y => leadingNormalizedField (translate (H-C t) c) (r • y)) x
          (leadingNormalizedField_bound (translate (H-C t) c) _)
      split_ifs
      · simpa using hb
      · simpa using (norm_nonneg _).trans hb
  · exact testBound_integrable _ hρ hcρ
  · filter_upwards [mvPolynomial_eval_ne_zero_ae n H hHne] with x hx
    have hgrad := Source29TopWeakCalibration.evaluatedGradient_ne_zero_of_eval_ne_zero
      H hH (by omega) hx
    have hf : Tendsto (fun r : ℝ => testFlux (fun i => Pi.single i 1) ρ
        (fun y => leadingNormalizedField (translate (H-C t) c) (r • y)) x) atTop
        (𝓝 (testFlux (fun i => Pi.single i 1) ρ (leadingNormalizedField H) x)) := by
      apply tendsto_finsetSum
      intro i hi
      exact tendsto_const_nhds.mul (translated_level_normalizedField_atTop H s hH t c x hgrad i)
    exact hf.mul (translated_level_phase_atTop H s hH t c x hx)

/-- Large-radius normalized phase mass of a translated nonconstant homogeneous
level is exactly the unit-scale phase mass of the homogeneous polynomial. -/
theorem normalizedPhaseMass_translated_level_atTop
    (H : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (hHne : H ≠ 0) (t : ℝ) (c : Fin (n+1) → ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ a, R ≤ a → f a = 0) :
    Tendsto (fun r : ℝ => normalizedPhaseMass (translate (H-C t) c) f r) atTop
      (𝓝 (phaseMass H (radialWeight f 1))) := by
  obtain ⟨s,rfl⟩ := Nat.exists_eq_succ_of_ne_zero hd.ne'
  have ht := phaseFlux_translated_level_atTop H s hH hHne t c
    (radialWeight_contDiff hf 1) (radialWeight_compact hR zero_lt_one hz)
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with r hr
  exact (normalizedPhaseMass_eq_rescaled (translate (H-C t) c) hf hr).symm

end
end Source29HomogeneousLevelInfinity

/- Component: TranslatedCalibration.inc -/
namespace Source29TranslatedCalibration

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PolynomialTranslation Source29TopLocalInitial

noncomputable section
variable {n : ℕ}

/-- Translation preserves the weak calibration identity by translating its
compactly supported test functions. -/
theorem weakCalibration_translate
    (Z : (Fin n → ℝ) → Fin n → ℝ) (hZ : WeakCalibration Z) (c : Fin n → ℝ) :
    WeakCalibration (fun x => Z (c+x)) := by
  refine ⟨fun x i => hZ.1 (c+x) i, ?_⟩
  intro φ hφ hcφ
  let ψ : (Fin n → ℝ) → ℝ := fun y => φ (-c+y)
  have hψ : ContDiff ℝ 1 ψ := hφ.comp (contDiff_const.add contDiff_id)
  have hcψ : HasCompactSupport ψ := hcφ.comp_homeomorph (Homeomorph.addLeft (-c))
  have hbase := hZ.2 ψ hψ hcψ
  have he : (fun x => testFlux (fun i => Pi.single i 1) φ (fun y => Z (c+y)) x) =
      (fun x => testFlux (fun i => Pi.single i 1) ψ Z (c+x)) := by
    funext x
    have hd : fderiv ℝ ψ (c+x) = fderiv ℝ φ x := by
      dsimp only [ψ]
      rw [fderiv_comp_add_left]
      simp only [neg_add_cancel_left]
    simp only [testFlux, hd]
  constructor
  · change Integrable (fun x => testFlux (fun i => Pi.single i 1) φ (fun y => Z (c+y)) x)
    rw [he]
    exact (measurePreserving_add_left (volume : Measure (Fin n → ℝ)) c).integrable_comp_of_integrable hbase.1
  · rw [he, integral_add_left_eq_self]
    exact hbase.2

/-- Subtracting a level and translating its polynomial preserves the normalized
field calibration. -/
theorem polynomial_translated_level_weakCalibration
    (H : MvPolynomial (Fin n) ℝ) (hcal : WeakCalibration (leadingNormalizedField H))
    (t : ℝ) (c : Fin n → ℝ) :
    WeakCalibration (leadingNormalizedField (translate (H-C t) c)) := by
  have he : leadingNormalizedField (H-C t) = leadingNormalizedField H := by
    have hg : evaluatedGradient (H-C t) = evaluatedGradient H := by
      funext x i
      simp [evaluatedGradient]
    funext x i
    simp only [leadingNormalizedField, hg]
  have ht : leadingNormalizedField (translate (H-C t) c) =
      fun x => leadingNormalizedField H (c+x) := by
    funext x
    rw [leadingNormalizedField_translate, he]
  rw [ht]
  exact weakCalibration_translate _ hcal c

end
end Source29TranslatedCalibration

/- Component: HomogeneousLevelPlaneMass.inc -/
namespace Source29HomogeneousLevelPlaneMass

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PolynomialTranslation Source29LevelRadialMonotonicity
open Source29TranslatedCalibration Source29HomogeneousLevelInfinity
open Source29HalfspacePhaseMass Source29RegularPhaseDensity
open Source29PolynomialSmallDensity
open scoped Topology

noncomputable section
variable {n : ℕ}

lemma translated_level_eval_zero (H : MvPolynomial (Fin n) ℝ)
    (t : ℝ) (c : Fin n → ℝ) (hc : eval c H = t) :
    eval 0 (translate (H-C t) c) = 0 := by
  rw [eval_zero_translate]
  simp only [map_sub, eval_C, hc, sub_self]

lemma translated_level_gradient (H : MvPolynomial (Fin n) ℝ)
    (t : ℝ) (c : Fin n → ℝ) :
    evaluatedGradient (translate (H-C t) c) 0 = evaluatedGradient H c := by
  funext i
  change eval 0 (pderiv i (translate (H-C t) c)) = eval c (pderiv i H)
  rw [pderiv_translate, eval_zero_translate]
  simp

/-- Monotonicity and the equal plane densities at zero and infinity force
exact plane mass at every positive radius about every regular level point. -/
theorem normalizedPhaseMass_eq_planeMass_of_regular
    (H : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (hHne : H ≠ 0) (hcal : WeakCalibration (leadingNormalizedField H))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x H ≤ 0)
    (t : ℝ) (c : Fin (n+1) → ℝ) (hc : eval c H = t)
    (hreg : evaluatedGradient H c ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hfpos : ∀ s, 0 ≤ f s)
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ s, R ≤ s → f s = 0)
    (hdz : ∀ s, R ≤ s → deriv f s = 0) (hdec : ∀ s, deriv f s ≤ 0)
    {r : ℝ} (hr : 0 < r) :
    normalizedPhaseMass (translate (H-C t) c) f r = planeMass n f := by
  have hQcal := polynomial_translated_level_weakCalibration H hcal t c
  have hQzero := translated_level_eval_zero H t c hc
  have hQreg : evaluatedGradient (translate (H-C t) c) 0 ≠ 0 := by
    rwa [translated_level_gradient]
  have hQne : translate (H-C t) c ≠ 0 := by
    intro hzero
    apply hQreg
    rw [hzero]
    funext i
    simp [evaluatedGradient]
  have hlim := normalizedPhaseMass_translated_level_atTop H d hH hd hHne t c hf hR hz
  rw [phaseMass_radial_eq_planeMass H hHne hcal hpos hneg hf hfpos hR hz] at hlim
  apply le_antisymm
  · apply ge_of_tendsto hlim
    filter_upwards [eventually_ge_atTop r] with s hrs
    exact normalizedPhaseMass_monotoneOn (translate (H-C t) c) hQne hQcal
      hf hR hz hdz hdec hr (lt_of_lt_of_le hr hrs) hrs
  · exact planeMass_le_normalizedPhaseMass (translate (H-C t) c)
      hQzero hQreg hQcal hf hR hz hdz hdec hr

/-- Every point on a nonzero level of a positive-degree homogeneous calibrated
polynomial with weak coordinate-halfspace signs has exactly plane mass at every
positive radius. Regularity is derived from Euler's identity. -/
theorem normalizedPhaseMass_eq_planeMass_of_nonzero_level
    (H : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (hcal : WeakCalibration (leadingNormalizedField H))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x H ≤ 0)
    {t : ℝ} (ht : t ≠ 0) (c : Fin (n+1) → ℝ) (hc : eval c H = t)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hfpos : ∀ s, 0 ≤ f s)
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ s, R ≤ s → f s = 0)
    (hdz : ∀ s, R ≤ s → deriv f s = 0) (hdec : ∀ s, deriv f s ≤ 0)
    {r : ℝ} (hr : 0 < r) :
    normalizedPhaseMass (translate (H-C t) c) f r = planeMass n f := by
  have hHne : H ≠ 0 := by
    intro hzero
    apply ht
    rw [← hc, hzero, map_zero]
  have hev : eval c H ≠ 0 := by rwa [hc]
  exact normalizedPhaseMass_eq_planeMass_of_regular H d hH hd hHne hcal hpos hneg t c hc
    (Source29TopWeakCalibration.evaluatedGradient_ne_zero_of_eval_ne_zero H hH hd hev)
    hf hfpos hR hz hdz hdec hr

end
end Source29HomogeneousLevelPlaneMass

/- Component: PhaseDefectIncrement.inc -/
namespace Source29PhaseDefectIncrement

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29VariationConvexity Source29NonlinearCalibration
open Source29LevelRadialMonotonicity Source29LevelRadialDefect Source29LevelStressStationarity
open Source29PhaseMassLimit Source29SmoothPhaseTransition
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The coefficient of the diffuse level weight in the derivative of
normalized radial mass. -/
def defectCoefficient (P : MvPolynomial (Fin (n+1)) ℝ) (f : ℝ → ℝ)
    (r : ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ((-2/r^2) * deriv f (radiusSq x/r^2) *
    (Source29NormalPenalty.dot (leadingNormalizedField P x) x)^2) / r^(n+1)

lemma defectCoefficient_mul (P : MvPolynomial (Fin (n+1)) ℝ) (h f : ℝ → ℝ)
    (r : ℝ) (x : Fin (n+1) → ℝ) :
    defectCoefficient P f r x * diffuseWeight P h x = radialDefect P h f r x / r^(n+1) := by
  unfold defectCoefficient radialDefect
  ring

lemma slope_lower_bound {F D : ℝ → ℝ} {a b C : ℝ} (hab : a ≤ b)
    (hF : ∀ r ∈ Icc a b, HasDerivAt F (D r) r)
    (hD : ∀ r ∈ Icc a b, C ≤ D r) : C * (b-a) ≤ F b - F a := by
  have hd (r : ℝ) (hr : r ∈ Icc a b) :
      HasDerivAt (fun t ↦ F t - C*t) (D r - C) r := by
    convert (hF r hr).sub ((hasDerivAt_id r).const_mul C) using 1 <;>
      simp only [mul_one, id_eq]
    rfl
  have hm : MonotoneOn (fun t ↦ F t - C*t) (Icc a b) := by
    apply monotoneOn_of_deriv_nonneg (convex_Icc a b)
    · intro r hr
      exact (hd r hr).continuousAt.continuousWithinAt
    · intro r hr
      exact (hd r (interior_subset hr)).differentiableAt.differentiableWithinAt
    · intro r hr
      rw [(hd r (interior_subset hr)).deriv]
      exact sub_nonneg.mpr (hD r (interior_subset hr))
  have h := hm (left_mem_Icc.mpr hab) (right_mem_Icc.mpr hab) hab
  linarith

/-- A uniform localized coefficient bound survives the diffuse approximation
and gives a quantitative increment of the actual phase mass. -/
theorem phaseMass_increment (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    {η : (Fin (n+1) → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    {a b δ : ℝ} (ha : 0 < a) (hab : a ≤ b)
    (hlower : ∀ r ∈ Icc a b, ∀ x, δ * η x ≤ defectCoefficient P f r x) :
    δ * phaseMass P η * (b-a) ≤ normalizedPhaseMass P f b - normalizedPhaseMass P f a := by
  have hb : 0 < b := ha.trans_le hab
  have hm := phaseMass_tendsto P hP hcal hη hcη
  have hla := normalizedDiffuseMass_tendsto P hP hcal hf hR ha hz
  have hlb := normalizedDiffuseMass_tendsto P hP hcal hf hR hb hz
  apply le_of_tendsto_of_tendsto ((hm.const_mul δ).mul_const (b-a)) (hlb.sub hla)
  apply Filter.Eventually.of_forall
  intro k
  dsimp only
  apply slope_lower_bound hab
    (fun r hr ↦ normalizedDiffuseMass_hasDerivAt P hcal (transition_deriv_contDiff k)
      hf hR (ha.trans_le hr.1) hz hdz)
  intro r hr
  have hrpos : 0 < r := ha.trans_le hr.1
  have hi := (localized_gradient_mass_identity P hcal hη hcη
    (transition_contDiff k) (transition_norm_le_one k)).1
  have hd := (radialDefect_integrable P hcal (transition_deriv_contDiff k) hf hR hrpos hz hdz).div_const (r^(n+1))
  rw [← integral_const_mul, ← integral_div]
  apply integral_mono (hi.const_mul δ) hd
  intro x
  have hw : 0 ≤ diffuseWeight P (deriv (transition k)) x :=
    mul_nonneg (transition_deriv_nonneg k _) (Real.sqrt_nonneg _)
  have h := mul_le_mul_of_nonneg_right (hlower r hr x) hw
  rw [defectCoefficient_mul] at h
  simpa only [diffuseWeight, mul_assoc] using h

/-- A positive phase mass in the localization turns the quantitative estimate
into a strict increment. -/
theorem phaseMass_strict_increment (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    {η : (Fin (n+1) → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hm : 0 < phaseMass P η) {a b δ : ℝ} (ha : 0 < a) (hab : a < b) (hδ : 0 < δ)
    (hlower : ∀ r ∈ Icc a b, ∀ x, δ * η x ≤ defectCoefficient P f r x) :
    normalizedPhaseMass P f a < normalizedPhaseMass P f b := by
  have h := phaseMass_increment P hP hcal hf hR hz hdz hη hcη ha hab.le hlower
  have hp := mul_pos (mul_pos hδ hm) (sub_pos.mpr hab)
  linarith

end
end Source29PhaseDefectIncrement

/- Component: RegularLocalPhaseMass.inc -/
namespace Source29RegularLocalPhaseMass

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29PolynomialTranslation Source29TopLocalInitial Source29PhaseMassLimit
open Source29LevelRadialStress Source29LevelRadialMonotonicity
open Source29PolynomialGraphMonotonicity Source29RegularPhaseDensity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Translate the polynomial or translate its test weight in the opposite direction. -/
theorem phaseMass_translate (P : MvPolynomial (Fin n) ℝ) (c : Fin n → ℝ)
    (ρ : (Fin n → ℝ) → ℝ) :
    phaseMass (translate P c) ρ = phaseMass P (fun x ↦ ρ (-c+x)) := by
  have he (x : Fin n → ℝ) :
      testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ (-c+y)) (leadingNormalizedField P) (c+x) =
      testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField (translate P c)) x := by
    simp only [testFlux, fderiv_comp_add_left, neg_add_cancel_left, leadingNormalizedField_translate]
  unfold phaseMass
  conv_rhs => rw [← integral_add_left_eq_self _ c]
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ by
    dsimp only
    rw [he, eval_translate]
    rfl

lemma translated_gradient_origin (P : MvPolynomial (Fin n) ℝ) (c : Fin n → ℝ) :
    evaluatedGradient (translate P c) 0 = evaluatedGradient P c := by
  funext i
  simp only [evaluatedGradient, pderiv_translate, eval_zero_translate]

/-- At any regular zero, arbitrarily small centered radial test weights have
strictly positive phase mass. Calibration is not needed for this density fact. -/
theorem exists_small_positive_radial_mass (P : MvPolynomial (Fin (n+1)) ℝ)
    (c : Fin (n+1) → ℝ) (hc : eval c P = 0) (hreg : evaluatedGradient P c ≠ 0)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ r < ε ∧
      0 < phaseMass P (fun x ↦ radialWeight radialCutoff r (-c+x)) := by
  let t : ℕ → ℝ := fun k ↦ (dilationRadius k)⁻¹
  have ht : ∀ k, 0 < t k := fun k ↦ inv_pos.mpr (dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) := tendsto_inv_atTop_zero.comp dilationRadius_tendsto
  have hzero : eval 0 (translate P c) = 0 := by rw [eval_zero_translate, hc]
  have hgrad : evaluatedGradient (translate P c) 0 ≠ 0 := by rwa [translated_gradient_origin]
  have hl := radialCutoff_regular_limit (translate P c) hzero hgrad ht ht0
  have hplane : 0 < Source29PolynomialSmallDensity.planeMass n radialCutoff :=
    Source29HarmonicRadialKernels.radialCutoff_mass_pos n
  have hevent : ∀ᶠ k in atTop, 0 < normalizedPhaseMass (translate P c) radialCutoff (t k) ∧ t k < ε :=
    (hl.eventually (lt_mem_nhds hplane)).and (ht0.eventually (gt_mem_nhds hε))
  obtain ⟨k,hk,hke⟩ := hevent.exists
  refine ⟨t k,ht k,hke,?_⟩
  rw [← phaseMass_translate]
  exact (div_pos_iff_of_pos_right (pow_pos (ht k) n)).mp hk

/-- The centered radial test has support in a ball proportional to its radius. -/
lemma centered_radial_support (c : Fin (n+1) → ℝ) (r : ℝ) (hr : 0 < r) :
    tsupport (fun x ↦ radialWeight radialCutoff r (-c+x)) ⊆ Metric.closedBall c (2*r) := by
  apply closure_minimal ?_ Metric.isClosed_closedBall
  intro x hx
  have hne : radialCutoff (radiusSq (-c+x) / r^2) ≠ 0 := hx
  have hs : radiusSq (-c+x) < 2*r^2 := by
    apply (div_lt_iff₀ (sq_pos_of_pos hr)).mp
    exact lt_of_not_ge (fun h ↦ hne (radialCutoff_zero _ h))
  have hnorm : ‖-c+x‖ ≤ 2*r := by
    apply (pi_norm_le_iff_of_nonneg (by positivity)).mpr
    intro i
    have hi : ((-c+x) i)^2 ≤ radiusSq (-c+x) :=
      Finset.single_le_sum (fun j _ ↦ sq_nonneg ((-c+x) j)) (Finset.mem_univ i)
    apply (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp
    rw [Real.norm_eq_abs, sq_abs]
    nlinarith
  simpa only [Metric.mem_closedBall, dist_eq_norm, sub_eq_add_neg, add_comm x (-c)] using hnorm

/-- Every neighborhood of a regular zero contains a nonnegative compact C1
test, bounded by one, with strictly positive phase mass. -/
theorem exists_positive_local_test (P : MvPolynomial (Fin (n+1)) ℝ)
    (c : Fin (n+1) → ℝ) (hc : eval c P = 0) (hreg : evaluatedGradient P c ≠ 0)
    (U : Set (Fin (n+1) → ℝ)) (hU : U ∈ 𝓝 c) :
    ∃ η : (Fin (n+1) → ℝ) → ℝ, ContDiff ℝ 1 η ∧ HasCompactSupport η ∧
      tsupport η ⊆ U ∧ (∀ x, 0 ≤ η x ∧ η x ≤ 1) ∧ 0 < phaseMass P η := by
  obtain ⟨ε,hε,hball⟩ := Metric.mem_nhds_iff.mp hU
  obtain ⟨r,hr,hre,hm⟩ := exists_small_positive_radial_mass P c hc hreg (ε/3) (by positivity)
  refine ⟨(fun x ↦ radialWeight radialCutoff r (-c+x)),?_,?_,?_,?_,hm⟩
  · exact (radialWeight_contDiff radialCutoff_contDiff r).comp (contDiff_const.add contDiff_id)
  · exact (radialWeight_compact (by norm_num : (0:ℝ) ≤ 2) hr radialCutoff_zero).comp_homeomorph
      (Homeomorph.addLeft (-c))
  · intro x hx
    have hd := centered_radial_support c r hr hx
    apply hball
    change dist x c < ε
    have : dist x c ≤ 2*r := hd
    linarith
  · intro x
    exact radialCutoff_bounds _

end
end Source29RegularLocalPhaseMass

/- Component: PhaseDefectLocalization.inc -/
namespace Source29PhaseDefectLocalization

open MvPolynomial Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics Source29PhaseDefectIncrement
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

lemma defectCoefficient_nonneg (P : MvPolynomial (Fin (n+1)) ℝ) {f : ℝ → ℝ}
    (hf : ∀ t, deriv f t ≤ 0) {r : ℝ} (hr : 0 < r) (x : Fin (n+1) → ℝ) :
    0 ≤ defectCoefficient P f r x := by
  apply div_nonneg _ (pow_nonneg hr.le _)
  apply mul_nonneg _ (sq_nonneg _)
  exact mul_nonneg_of_nonpos_of_nonpos (div_nonpos_of_nonpos_of_nonneg (by norm_num) (sq_nonneg r)) (hf _)

lemma defectCoefficient_pos (P : MvPolynomial (Fin (n+1)) ℝ) {f : ℝ → ℝ}
    (a : Fin (n+1) → ℝ) {r : ℝ} (hr : 0 < r)
    (hf : deriv f (radiusSq a/r^2) < 0)
    (ha : Source29NormalPenalty.dot (leadingNormalizedField P a) a ≠ 0) :
    0 < defectCoefficient P f r a := by
  exact div_pos (mul_pos (mul_pos_of_neg_of_neg
    (div_neg_of_neg_of_pos (by norm_num) (sq_pos_of_pos hr)) hf) (sq_pos_of_ne_zero ha))
    (pow_pos hr _)

lemma defectCoefficient_continuousAt (P : MvPolynomial (Fin (n+1)) ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (a : Fin (n+1) → ℝ)
    (ha : evaluatedGradient P a ≠ 0) {r : ℝ} (hr : r ≠ 0) :
    ContinuousAt (fun z : ℝ × (Fin (n+1) → ℝ) ↦ defectCoefficient P f z.1 z.2) (r,a) := by
  have hg (i : Fin (n+1)) : Continuous (fun y ↦ evaluatedGradient P y i) :=
    (contDiff_eval (pderiv i P)).continuous
  have hs : Continuous (fun y ↦ radiusSq (evaluatedGradient P y)) :=
    continuous_finsetSum _ (fun i _ ↦ (hg i).pow 2)
  have hn (i : Fin (n+1)) : ContinuousAt (fun y ↦ leadingNormalizedField P y i) a :=
    (hg i).continuousAt.div hs.sqrt.continuousAt
      (Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero ha)).ne'
  have hdot : ContinuousAt (fun y ↦ Source29NormalPenalty.dot (leadingNormalizedField P y) y) a := by
    apply tendsto_finsetSum
    intro i hi
    exact (hn i).mul (continuous_apply i).continuousAt
  have hdot' := hdot.comp (continuous_snd.continuousAt (x := (r,a)))
  have hsq := (radiusSq_contDiff.continuous.comp continuous_snd).continuousAt (x := (r,a))
  have harg := hsq.div ((continuous_fst.pow 2).continuousAt) (pow_ne_zero 2 hr)
  exact (((continuousAt_const.div ((continuous_fst.pow 2).continuousAt) (pow_ne_zero 2 hr)).mul
    (hf.continuous_deriv_one.continuousAt.comp harg)).mul (hdot'.pow 2)).div
    ((continuous_fst.pow (n+1)).continuousAt) (pow_ne_zero _ hr)

/-- Strict positivity of the actual defect at a regular point gives a
uniform positive interval-and-neighborhood lower bound. -/
theorem exists_localized_lower_bound (P : MvPolynomial (Fin (n+1)) ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hdec : ∀ t, deriv f t ≤ 0)
    (a : Fin (n+1) → ℝ) (ha : evaluatedGradient P a ≠ 0)
    (r₀ : ℝ) (hr₀ : 0 < r₀) (hderiv : deriv f (radiusSq a/r₀^2) < 0)
    (hradial : Source29NormalPenalty.dot (leadingNormalizedField P a) a ≠ 0) :
    ∃ lo hi δ : ℝ, 0 < lo ∧ lo < hi ∧ 0 < δ ∧
      ∃ U : Set (Fin (n+1) → ℝ), U ∈ 𝓝 a ∧
        ∀ η : (Fin (n+1) → ℝ) → ℝ,
          (∀ x, 0 ≤ η x) → (∀ x, η x ≤ 1) → tsupport η ⊆ U →
          ∀ r ∈ Icc lo hi, ∀ x, δ * η x ≤ defectCoefficient P f r x := by
  let δ := defectCoefficient P f r₀ a / 2
  have hp := defectCoefficient_pos P a hr₀ hderiv hradial
  have hδ : 0 < δ := half_pos hp
  have hb : δ < defectCoefficient P f r₀ a := by dsimp [δ]; linarith
  have he : {z : ℝ × (Fin (n+1) → ℝ) | δ < defectCoefficient P f z.1 z.2} ∈ 𝓝 (r₀,a) :=
    (defectCoefficient_continuousAt P hf a ha hr₀.ne').eventually (isOpen_Ioi.mem_nhds hb)
  obtain ⟨V,hV,U,hU,hVU⟩ := mem_nhds_prod_iff.mp he
  obtain ⟨ε,hε,hεV⟩ := Metric.mem_nhds_iff.mp hV
  let w := min (r₀/2) (ε/2)
  have hw : 0 < w := lt_min (half_pos hr₀) (half_pos hε)
  have hwr : w ≤ r₀/2 := min_le_left _ _
  have hwε : w ≤ ε/2 := min_le_right _ _
  have hlo : 0 < r₀-w := by linarith
  have hlh : r₀-w < r₀+w := by linarith
  refine ⟨r₀-w,r₀+w,δ,hlo,hlh,hδ,U,hU,?_⟩
  intro η _hη hη1 hηU r hr x
  have hrpos : 0 < r := hlo.trans_le hr.1
  have hrV : r ∈ V := by
    apply hεV
    change dist r r₀ < ε
    rw [Real.dist_eq, abs_lt]
    constructor <;> linarith [hr.1, hr.2]
  by_cases hx : x ∈ U
  · have hlocal : δ < defectCoefficient P f r x := hVU (show (r,x) ∈ V ×ˢ U from ⟨hrV,hx⟩)
    exact (mul_le_of_le_one_right hδ.le (hη1 x)).trans hlocal.le
  · have hzero : η x = 0 := image_eq_zero_of_notMem_tsupport (fun h ↦ hx (hηU h))
    rw [hzero, mul_zero]
    exact defectCoefficient_nonneg P hdec hrpos x

end
end Source29PhaseDefectLocalization

/- Component: RegularRadialStrictIncrement.inc -/
namespace Source29RegularRadialStrictIncrement

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29PhaseDefectIncrement
open Source29PhaseDefectLocalization Source29RegularLocalPhaseMass
open Source29LevelRadialMonotonicity Source29PolynomialGraphMonotonicity
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A negative radial cutoff derivative and a nonzero radial normal component
at a regular zero force a strict increment of normalized phase mass. -/
theorem exists_strict_increment (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hdec : ∀ t, deriv f t ≤ 0)
    {R : ℝ} (hR : 0 ≤ R) (hz : ∀ t, R ≤ t → f t = 0)
    (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (a : Fin (n+1) → ℝ) (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0)
    (r₀ : ℝ) (hr₀ : 0 < r₀) (hderiv : deriv f (radiusSq a / r₀^2) < 0)
    (hradial : Source29NormalPenalty.dot (leadingNormalizedField P a) a ≠ 0) :
    ∃ r s : ℝ, 0 < r ∧ r < s ∧ normalizedPhaseMass P f r < normalizedPhaseMass P f s := by
  have hP : P ≠ 0 := by
    intro he
    apply hreg
    subst P
    funext i
    simp [evaluatedGradient]
  obtain ⟨r,s,δ,hr,hrs,hδ,U,hU,hbound⟩ :=
    exists_localized_lower_bound P hf hdec a hreg r₀ hr₀ hderiv hradial
  obtain ⟨η,hη,hcη,hηU,hηb,hm⟩ := exists_positive_local_test P a ha hreg U hU
  exact ⟨r,s,hr,hrs,phaseMass_strict_increment P hP hcal hf hR hz hdz hη hcη hm hr hrs hδ
    (hbound η (fun x ↦ (hηb x).1) (fun x ↦ (hηb x).2) hηU)⟩

/-- The fixed smooth radial cutoff detects every nonzero radial normal defect
at a regular zero. -/
theorem exists_strict_increment_of_regular_defect (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (a : Fin (n+1) → ℝ) (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0)
    (hradial : Source29NormalPenalty.dot (leadingNormalizedField P a) a ≠ 0) :
    ∃ r s : ℝ, 0 < r ∧ r < s ∧
      normalizedPhaseMass P radialCutoff r < normalizedPhaseMass P radialCutoff s := by
  have hane : a ≠ 0 := by
    intro he
    apply hradial
    rw [he]
    simp [Source29NormalPenalty.dot]
  have hsq := radiusSq_pos_of_ne_zero hane
  let r₀ := Real.sqrt (2*radiusSq a)
  have hr₀ : 0 < r₀ := Real.sqrt_pos.mpr (by positivity)
  have hr₂ : r₀^2 = 2*radiusSq a := Real.sq_sqrt (by positivity)
  have harg : radiusSq a/r₀^2 = 1/2 := by
    rw [hr₂]
    field_simp
  apply exists_strict_increment P hcal radialCutoff_contDiff radialCutoff_deriv_nonpos
    (by norm_num : (0:ℝ) ≤ 2) radialCutoff_zero radialCutoff_deriv_zero a ha hreg r₀ hr₀ ?_ hradial
  rw [harg, Source29GraphMassRigidity.radialCutoff_deriv_half]
  norm_num

/-- Constancy of normalized phase mass forces radial tangency at every
regular zero, using only the diffuse defect identity and local density. -/
theorem radial_tangency_of_constant_mass (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P)) (C : ℝ)
    (hconstant : ∀ r : ℝ, 0 < r → normalizedPhaseMass P radialCutoff r = C)
    (a : Fin (n+1) → ℝ) (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0) :
    Source29NormalPenalty.dot (leadingNormalizedField P a) a = 0 := by
  by_contra hne
  obtain ⟨r,s,hr,hrs,hinc⟩ := exists_strict_increment_of_regular_defect P hcal a ha hreg hne
  rw [hconstant r hr, hconstant s (hr.trans hrs)] at hinc
  exact lt_irrefl _ hinc

end
end Source29RegularRadialStrictIncrement

/- Component: HomogeneousLevelTangencyRigidity.inc -/
namespace Source29HomogeneousLevelTangencyRigidity

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29NormalPenalty Source29LinearForm
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- Tangency to one positive homogeneous level determines the whole polynomial. -/
theorem eq_linearForm_pow_of_level_tangency
    (H : MvPolynomial (Fin n) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (x : Fin n → ℝ) (hx : 0 < eval x H)
    (htan : ∀ y, eval y H = eval x H →
      dot (evaluatedGradient H x) (x - y) = 0) :
    ∃ k : ℝ, k ≠ 0 ∧ H = C k * (linearForm (evaluatedGradient H x)) ^ d := by
  let a := evaluatedGradient H x
  let b := dot a x
  have hb : b = (d : ℝ) * eval x H := by
    simpa [b, dot, a, mul_comm] using euler_evaluatedGradient H hH x
  have hbpos : 0 < b := by rw [hb]; exact mul_pos (by exact_mod_cast hd) hx
  have hlocal (y : Fin n → ℝ) (hy : 0 < eval y H) :
      b ^ d * eval y H = eval x H * (eval y (linearForm a)) ^ d := by
    let r : ℝ := (eval x H / eval y H) ^ ((d : ℝ)⁻¹)
    have hrpow : r ^ d = eval x H / eval y H :=
      Real.rpow_inv_natCast_pow (le_of_lt (div_pos hx hy)) (Nat.ne_of_gt hd)
    have hrlevel : eval (r • y) H = eval x H := by
      rw [eval_dilate_homogeneous H hH, hrpow, div_mul_cancel₀ _ hy.ne']
    have hdot := htan (r • y) hrlevel
    have hbr : b = r * eval y (linearForm a) := by
      rw [eval_linearForm]
      change (∑ i, a i * x i) = r * ∑ i, a i * y i
      change (∑ i, a i * (x i - r * y i)) = 0 at hdot
      simp only [mul_sub, Finset.sum_sub_distrib] at hdot
      rw [sub_eq_zero] at hdot
      rw [hdot, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    rw [hbr, mul_pow, hrpow]
    field_simp
  have hzero : C (b ^ d) * H - C (eval x H) * (linearForm a) ^ d = 0 := by
    apply Source29LocalHyperplaneDivisor.polynomial_eq_zero_of_locally_zero _ x
    have hc := (Source29PolynomialLinkChart.analyticAt_eval_real H x).continuousAt
    filter_upwards [hc.eventually (eventually_gt_nhds hx)] with y hy
    simpa only [map_sub, map_mul, map_pow, eval_C, sub_eq_zero] using hlocal y hy
  refine ⟨eval x H / b ^ d, div_ne_zero hx.ne' (pow_ne_zero _ hbpos.ne'), ?_⟩
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro y
  have he := congrArg (eval y) hzero
  simp only [map_sub, map_mul, map_pow, eval_C, map_zero, sub_eq_zero] at he
  simp only [map_mul, eval_C, map_pow]
  rw [div_mul_eq_mul_div]
  apply (eq_div_iff (pow_ne_zero d hbpos.ne')).mpr
  simpa only [mul_comm] using he

/-- A nonzero polynomial with the weak positive half-space sign has a positive value. -/
theorem exists_positive_eval_of_halfspace_sign
    (H : MvPolynomial (Fin (n + 1)) ℝ) (hH : H ≠ 0)
    (hpos : ∀ x : Fin (n + 1) → ℝ, 0 < x 0 → 0 ≤ eval x H) :
    ∃ x, 0 < eval x H := by
  by_contra hn
  push Not at hn
  apply hH
  apply Source29LocalHyperplaneDivisor.polynomial_eq_zero_of_locally_zero H (fun _ => 1)
  have hx : ∀ᶠ x : Fin (n + 1) → ℝ in 𝓝 (fun _ => 1), 0 < x 0 :=
    (continuous_apply 0).continuousAt.eventually (eventually_gt_nhds (by norm_num))
  filter_upwards [hx] with x hx
  exact le_antisymm (hn x) (hpos x hx)

/-- Half-space signs force the linear form in a nonzero pure power to be normal. -/
theorem linearForm_pow_halfspace_rigidity
    (a : Fin (n + 1) → ℝ) (k : ℝ) (hk : k ≠ 0) (d : ℕ)
    (hpos : ∀ x : Fin (n + 1) → ℝ, 0 < x 0 →
      0 ≤ eval x (C k * (linearForm a) ^ d))
    (hneg : ∀ x : Fin (n + 1) → ℝ, x 0 < 0 →
      eval x (C k * (linearForm a) ^ d) ≤ 0) :
    ∀ j : Fin n, a j.succ = 0 := by
  intro j
  by_contra hj
  have hv (t : ℝ) :
      eval (Fin.cons t (Pi.single j ((1 - a 0 * t) / a j.succ))) (linearForm a) = 1 := by
    rw [eval_linearForm, Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, Pi.single_apply]
    simp only [mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    field_simp
    ring
  have hp := hpos (Fin.cons 1 (Pi.single j ((1 - a 0 * 1) / a j.succ))) (by simp)
  have hm := hneg (Fin.cons (-1) (Pi.single j ((1 - a 0 * (-1)) / a j.succ))) (by simp)
  simp only [map_mul, eval_C, map_pow] at hp hm
  rw [hv] at hp hm
  simp only [one_pow, mul_one] at hp hm
  exact hk (le_antisymm hm hp)

/-- Homogeneous level tangency and the weak half-space signs force an odd normal power. -/
theorem eq_positive_odd_normal_power
    (H : MvPolynomial (Fin (n + 1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (hHne : H ≠ 0)
    (hpos : ∀ x : Fin (n + 1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n + 1) → ℝ, x 0 < 0 → eval x H ≤ 0)
    (htan : ∀ c x, eval c H = eval x H → eval x H ≠ 0 →
      dot (evaluatedGradient H x) (x - c) = 0) :
    ∃ k : ℝ, 0 < k ∧ Odd d ∧ H = C k * (X 0) ^ d := by
  obtain ⟨x, hx⟩ := exists_positive_eval_of_halfspace_sign H hHne hpos
  obtain ⟨k, hk, he⟩ := eq_linearForm_pow_of_level_tangency H d hH hd x hx
    (fun y hy => htan y x hy hx.ne')
  have ha := linearForm_pow_halfspace_rigidity (evaluatedGradient H x) k hk d
    (by simpa only [← he] using hpos) (by simpa only [← he] using hneg)
  have hform : linearForm (evaluatedGradient H x) = C (evaluatedGradient H x 0) * X 0 := by
    unfold linearForm
    rw [Fin.sum_univ_succ]
    simp [ha]
  have hN : H = C (k * (evaluatedGradient H x 0) ^ d) * (X 0) ^ d := by
    nth_rewrite 1 [he]
    rw [hform, mul_pow, ← mul_assoc, ← map_pow, ← map_mul]
  have hc : k * (evaluatedGradient H x 0) ^ d ≠ 0 := by
    intro hc
    apply hHne
    simp [hc] at hN
    exact hN
  obtain ⟨hcpos, hodd⟩ := Source29NewtonPureNormalPower.coefficient_pos_and_degree_odd
    H d _ hc hN hpos hneg
  exact ⟨_, hcpos, hodd, hN⟩

/-- The two half-space signs exclude a nonzero homogeneous polynomial of degree zero. -/
theorem degree_pos_of_halfspace_sign
    (H : MvPolynomial (Fin (n + 1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hHne : H ≠ 0)
    (hpos : ∀ x : Fin (n + 1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n + 1) → ℝ, x 0 < 0 → eval x H ≤ 0) : 0 < d := by
  by_contra hd
  have hd0 : d = 0 := by omega
  have hv (x : Fin (n + 1) → ℝ) : eval x H = eval 0 H := by
    simpa [hd0] using (eval_dilate_homogeneous H hH x 0).symm
  have hp := hpos (fun _ => 1) (by norm_num)
  have hm := hneg (fun _ => -1) (by norm_num)
  rw [hv] at hp hm
  have hz : eval 0 H = 0 := le_antisymm hm hp
  apply hHne
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro x
  simpa only [map_zero, hv x] using hz

/-- No separate positive-degree assumption is needed for the classification. -/
theorem eq_positive_odd_normal_power_of_level_tangency
    (H : MvPolynomial (Fin (n + 1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hHne : H ≠ 0)
    (hpos : ∀ x : Fin (n + 1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n + 1) → ℝ, x 0 < 0 → eval x H ≤ 0)
    (htan : ∀ c x, eval c H = eval x H → eval x H ≠ 0 →
      dot (evaluatedGradient H x) (x - c) = 0) :
    ∃ k : ℝ, 0 < k ∧ Odd d ∧ H = C k * (X 0) ^ d := by
  exact eq_positive_odd_normal_power H d hH
    (degree_pos_of_halfspace_sign H d hH hHne hpos hneg) hHne hpos hneg htan

end
end Source29HomogeneousLevelTangencyRigidity

/- Component: HomogeneousLevelRadialTangency.inc -/
namespace Source29HomogeneousLevelRadialTangency

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PolynomialTranslation Source29PolynomialSmallDensity
open Source29PolynomialGraphMonotonicity Source29LevelRadialMonotonicity
open Source29NormalPenalty
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Every nonzero level of a homogeneous calibrated polynomial with weak
halfspace signs is tangent to every radius drawn from another point on that
level. This follows from the proved equality of its radial masses. -/
theorem level_radial_tangency
    (H : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hd : 0 < d) (hcal : WeakCalibration (leadingNormalizedField H))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x H ≤ 0)
    (c x : Fin (n+1) → ℝ) (hc : eval c H = eval x H) (hx : eval x H ≠ 0) :
    dot (evaluatedGradient H x) (x-c) = 0 := by
  let P := translate (H-C (eval x H)) c
  have hcx : c+(x-c) = x := by abel
  have hzero : eval (x-c) P = 0 := by
    change eval (x-c) (translate (H-C (eval x H)) c) = 0
    rw [eval_translate]
    change eval (c+(x-c)) (H-C (eval x H)) = 0
    rw [hcx, map_sub, eval_C, sub_self]
  have hgrad : evaluatedGradient P (x-c) = evaluatedGradient H x := by
    funext i
    change eval (x-c) (pderiv i (translate (H-C (eval x H)) c)) = eval x (pderiv i H)
    rw [pderiv_translate, eval_translate]
    change eval (c+(x-c)) (pderiv i (H-C (eval x H))) = eval x (pderiv i H)
    rw [hcx]
    simp
  have hregH := Source29TopWeakCalibration.evaluatedGradient_ne_zero_of_eval_ne_zero H hH hd hx
  have hreg : evaluatedGradient P (x-c) ≠ 0 := by rwa [hgrad]
  have hPcal := Source29TranslatedCalibration.polynomial_translated_level_weakCalibration
    H hcal (eval x H) c
  have hconstant : ∀ r, 0 < r → normalizedPhaseMass P radialCutoff r = planeMass n radialCutoff := by
    intro r hr
    exact Source29HomogeneousLevelPlaneMass.normalizedPhaseMass_eq_planeMass_of_nonzero_level
      H d hH hd hcal hpos hneg hx c hc radialCutoff_contDiff (fun s ↦ (radialCutoff_bounds s).1)
      (by norm_num : (0:ℝ) ≤ 2) radialCutoff_zero radialCutoff_deriv_zero
      radialCutoff_deriv_nonpos hr
  have ht := Source29RegularRadialStrictIncrement.radial_tangency_of_constant_mass
    P hPcal (planeMass n radialCutoff) hconstant (x-c) hzero hreg
  have hn : leadingNormalizedField P (x-c) = leadingNormalizedField H x := by
    funext i
    simp only [leadingNormalizedField, hgrad]
  rw [hn] at ht
  have he : dot (leadingNormalizedField H x) (x-c) =
      dot (evaluatedGradient H x) (x-c) / Real.sqrt (radiusSq (evaluatedGradient H x)) := by
    unfold dot leadingNormalizedField
    simp only [div_mul_eq_mul_div, Finset.sum_div]
  rw [he] at ht
  have hs : Real.sqrt (radiusSq (evaluatedGradient H x)) ≠ 0 :=
    (Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hregH)).ne'
  exact (div_eq_zero_iff.mp ht).resolve_right hs

end
end Source29HomogeneousLevelRadialTangency

/- Component: CalibratedHalfspaceRigidity.inc -/
namespace Source29CalibratedHalfspaceRigidity

open MvPolynomial
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits

noncomputable section
variable {n : ℕ}

/-- A nonzero homogeneous polynomial whose normalized gradient is a weak
calibration and whose signs agree weakly with the two normal halfspaces is
a positive scalar times an odd power of the normal coordinate. -/
theorem eq_positive_odd_normal_power
    (H : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (hHne : H ≠ 0) (hcal : WeakCalibration (leadingNormalizedField H))
    (hpos : ∀ x : Fin (n+1) → ℝ, 0 < x 0 → 0 ≤ eval x H)
    (hneg : ∀ x : Fin (n+1) → ℝ, x 0 < 0 → eval x H ≤ 0) :
    ∃ c : ℝ, 0 < c ∧ Odd d ∧ H = C c * (X 0)^d := by
  have hd := Source29HomogeneousLevelTangencyRigidity.degree_pos_of_halfspace_sign
    H d hH hHne hpos hneg
  apply Source29HomogeneousLevelTangencyRigidity.eq_positive_odd_normal_power_of_level_tangency
    H d hH hHne hpos hneg
  exact Source29HomogeneousLevelRadialTangency.level_radial_tangency H d hH hd hcal hpos hneg

end
end Source29CalibratedHalfspaceRigidity

/- Component: PolynomialInitialShift.inc -/
namespace Source29PolynomialInitialShift

open MvPolynomial Filter
open scoped Topology

noncomputable section

/-- The first possible nonzero homogeneous component survives an ordinary dilation after
any flat differentiable normal shift. All hypotheses are stated directly for
the polynomial and the shift. -/
theorem normal_shift_initial_limit {n : ℕ}
    (F : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ)
    (hlow : ∀ k < d, homogeneousComponent k F = 0)
    {g : (Fin n → ℝ) → ℝ} (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0) (x : ℝ) (y : Fin n → ℝ) :
    Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t • y) + t*x) (t • y)) F / t^d)
      (𝓝[>] 0) (𝓝 (eval (Fin.cons x y) (homogeneousComponent d F))) := by
  let z : ℝ → (Fin (n+1) → ℝ) := fun t => Fin.cons (x + g (t • y)/t) y
  have hratio := Source29PureInitialFlatShift.flat_shift_div_tendsto_zero hg hg0 hD y
  have hz : Tendsto z (𝓝[>] 0) (𝓝 (Fin.cons x y)) := by
    apply tendsto_pi_nhds.mpr
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa only [z, Fin.cons_zero, add_zero] using
        (tendsto_const_nhds.add hratio : Tendsto (fun t => x + g (t • y)/t)
          (𝓝[>] 0) (𝓝 (x+0)))
    · exact tendsto_const_nhds
  have hlim := Source29RealInitialRescaling.eval_dilate_div_pow_tendsto_moving
    F d hlow z (Fin.cons x y) hz
  apply hlim.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have he : t • z t = Fin.cons (g (t • y) + t*x) (t • y) := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [z, Pi.smul_apply, Fin.cons_zero, smul_eq_mul]
      field_simp [(show 0 < t from ht).ne']
      ring
    · rfl
  rw [he]

end
end Source29PolynomialInitialShift

/- Component: RegularInitialHalfspaceSigns.inc -/
namespace Source29RegularInitialHalfspaceSigns

open MvPolynomial Filter
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A flat regular odd factor with locally nonnegative cofactor gives the
first possible homogeneous component the global weak signs of its normal variable. -/
theorem halfspace_signs_of_flat_graph
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hD : fderiv ℝ g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (hQ : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 ≤ eval (Fin.cons (g z.2+z.1) z.2) Q)
    (d : ℕ) (hlow : ∀ j < d, homogeneousComponent j F = 0) :
    (∀ z : Fin (n+1) → ℝ, 0 < z 0 → 0 ≤ eval z (homogeneousComponent d F)) ∧
    (∀ z : Fin (n+1) → ℝ, z 0 < 0 → eval z (homogeneousComponent d F) ≤ 0) := by
  have hbase : (Fin.cons (g 0) 0 : Fin (n+1) → ℝ) = 0 := by
    rw [hg0]
    funext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  have hn' : 0 < eval (Fin.cons (g 0) 0) (pderiv 0 P) := by rwa [hbase]
  obtain ⟨hpos,hneg⟩ := Source29NewtonShiftedLocalSigns.factor_halfspace_signs
    F P Q k hk hfac g 0 hg hroot hn' hQ
  have hlim : ∀ z : ℝ × (Fin n → ℝ), Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•z.2)+t*z.1) (t•z.2)) F / t^d)
      (𝓝[>] 0) (𝓝 (eval (Fin.cons z.1 z.2) (homogeneousComponent d F))) := by
    intro z
    exact Source29PolynomialInitialShift.normal_shift_initial_limit
      F d hlow hg.differentiableAt hg0 hD z.1 z.2
  obtain ⟨hspos,hsneg⟩ := Source29LocalWeightedSignLimit.sign_inherited
    (fun z : ℝ × (Fin n → ℝ) ↦ eval (Fin.cons (g z.2+z.1) z.2) F)
    (fun z ↦ eval (Fin.cons z.1 z.2) (homogeneousComponent d F)) 1 d zero_lt_one
    hpos hneg (fun z ↦ by
      simpa only [Source29LocalWeightedSignLimit.scaledPoint, Real.rpow_one,
        Real.rpow_natCast] using hlim z)
  constructor
  · intro z hz
    have ht := hspos (z 0, Fin.tail z) hz
    simpa only [Fin.cons_self_tail] using ht
  · intro z hz
    have ht := hsneg (z 0, Fin.tail z) hz
    simpa only [Fin.cons_self_tail] using ht

/-- At an oriented regular factor point, the local cofactor sign forces the
ordinary homogeneous initial component to have the global normal halfspace signs.
No leading equation, irreducibility, degree bound or nonzero initial form is needed. -/
theorem halfspace_signs
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : eval 0 P = 0) (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (ht : ∀ i : Fin n, eval 0 (pderiv i.succ P) = 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (d : ℕ) (hlow : ∀ j < d, homogeneousComponent j F = 0) :
    (∀ z : Fin (n+1) → ℝ, 0 < z 0 → 0 ≤ eval z (homogeneousComponent d F)) ∧
    (∀ z : Fin (n+1) → ℝ, z 0 < 0 → eval z (homogeneousComponent d F) ≤ 0) := by
  obtain ⟨g,hg,hg0,_,hD,hroot⟩ :=
    Source29FlatRegularGraph.exists_flat_local_graph P hP hn.ne' ht
  have hchart : Tendsto (fun z : ℝ × (Fin n → ℝ) ↦
      (Fin.cons (g z.2+z.1) z.2 : Fin (n+1) → ℝ)) (𝓝 0) (𝓝 0) := by
    apply tendsto_pi_nhds.mpr
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · have hsnd : Tendsto (Prod.snd : ℝ × (Fin n → ℝ) → (Fin n → ℝ))
          (𝓝 0) (𝓝 0) := continuous_snd.tendsto 0
      have hfst : Tendsto (Prod.fst : ℝ × (Fin n → ℝ) → ℝ)
          (𝓝 0) (𝓝 0) := continuous_fst.tendsto 0
      have hs := (hg.continuousAt.tendsto.comp hsnd).add hfst
      simpa only [hg0, zero_add, Pi.zero_apply, Fin.cons_zero, Function.comp_apply] using hs
    · exact ((continuous_apply j).comp continuous_snd).continuousAt.tendsto
  exact halfspace_signs_of_flat_graph F P Q k hk hfac g hg hg0 hD hroot hn
    (hchart.eventually hQ) d hlow

end
end Source29RegularInitialHalfspaceSigns

/- Component: RegularFactorCalibratedInitial.inc -/
namespace Source29RegularFactorCalibratedInitial

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A calibrated first homogeneous term supplies the previously missing
flat-tangent input to the regular-factor Newton argument. -/
theorem cofactor_pos_of_calibrated_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hP0 : eval (0 : Fin (n+1) → ℝ) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (ht : ∀ i : Fin n, eval (0 : Fin (n+1) → ℝ) (pderiv i.succ P) = 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hne : homogeneousComponent d F ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField (homogeneousComponent d F))) :
    0 < eval (0 : Fin (n+1) → ℝ) Q ∧ d = k ∧
      homogeneousComponent d F =
        C ((eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k * eval (0 : Fin (n+1) → ℝ) Q) * (X 0)^d := by
  obtain ⟨hpos,hneg⟩ := Source29RegularInitialHalfspaceSigns.halfspace_signs
    F P Q k hk hfac hP0 hn ht hQ d hlow
  obtain ⟨c,hc,_,hpure⟩ := Source29CalibratedHalfspaceRigidity.eq_positive_odd_normal_power
    (homogeneousComponent d F) d (homogeneousComponent_isHomogeneous d F) hne hcal hpos hneg
  obtain ⟨hQpos,hdk,hformula⟩ := Source29RegularFactorPureInitialCriterion.cofactor_pos_of_pure_initial
    F P Q k hk hfac hP hPQ hP0 hn ht hQ hF d c hc.ne' hlow hpure
  exact ⟨hQpos,hdk,by rwa [hformula] at hpure⟩

end
end Source29RegularFactorCalibratedInitial

/- Component: AffinePolynomialTransport.inc -/
namespace Source29AffinePolynomialTransport

open MvPolynomial Source29PolynomialTranslation
open Source29QuarticReuse.QuarticMinimal
open scoped BigOperators Matrix
open Filter
open scoped Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def translationEquiv (a : ι → ℝ) : MvPolynomial ι ℝ ≃ₐ[ℝ] MvPolynomial ι ℝ :=
  AlgEquiv.ofBijective (aeval (fun i => X i + C (a i)))
    ⟨translate_injective a, fun P => ⟨translate P (-a), by
      change translate (translate P (-a)) a = P
      simpa using translate_inverse P (-a)⟩⟩

omit [Fintype ι] [DecidableEq ι] in
theorem translationEquiv_apply (a : ι → ℝ) (P : MvPolynomial ι ℝ) :
    translationEquiv a P = translate P a := rfl

def orthogonalEquiv (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1) :
    MvPolynomial ι ℝ ≃ₐ[ℝ] MvPolynomial ι ℝ :=
  AlgEquiv.ofBijective (changeVariables U)
    ⟨changeVariables_injective U hU, fun P => ⟨changeVariables U.transpose P, by
      rw [changeVariables_comp, mul_eq_one_comm.mp hU, changeVariables_one]⟩⟩

theorem orthogonalEquiv_apply (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1)
    (P : MvPolynomial ι ℝ) : orthogonalEquiv U hU P = changeVariables U P := rfl

/-- Pullback by the affine orthogonal map x ↦ a + Ux. -/
def affineEquiv (a : ι → ℝ) (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1) :
    MvPolynomial ι ℝ ≃ₐ[ℝ] MvPolynomial ι ℝ :=
  (translationEquiv a).trans (orthogonalEquiv U hU)

theorem affineEquiv_apply (a : ι → ℝ) (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1)
    (P : MvPolynomial ι ℝ) :
    affineEquiv a U hU P = changeVariables U (translate P a) := rfl

theorem eval_affineEquiv (a : ι → ℝ) (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1)
    (P : MvPolynomial ι ℝ) (x : ι → ℝ) :
    eval x (affineEquiv a U hU P) = eval (a + U *ᵥ x) P := by
  rw [affineEquiv_apply, eval_changeVariables, eval_translate]
  rfl

theorem eval_zero_affineEquiv (a : ι → ℝ) (U : Matrix ι ι ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial ι ℝ) :
    eval (0 : ι → ℝ) (affineEquiv a U hU P) = eval a P := by
  rw [eval_affineEquiv, Matrix.mulVec_zero, add_zero]

omit [DecidableEq ι] in
theorem leadingOperator_translate (P : MvPolynomial ι ℝ) (a : ι → ℝ) :
    leadingOperator (translate P a) = translate (leadingOperator P) a := by
  simp only [leadingOperator, laplacian, pderiv_translate]
  change (∑ i, translationEquiv a (pderiv i P) ^ 2) *
    (∑ i, translationEquiv a (pderiv i (pderiv i P))) -
    (∑ i, ∑ j, translationEquiv a (pderiv i P) * translationEquiv a (pderiv j P) *
      translationEquiv a (pderiv i (pderiv j P))) = translationEquiv a _
  simp only [map_sub, map_mul, map_sum, map_pow]

theorem leadingOperator_affineEquiv (a : ι → ℝ) (U : Matrix ι ι ℝ)
    (hU : U * U.transpose = 1) (P : MvPolynomial ι ℝ) :
    leadingOperator (affineEquiv a U hU P) = affineEquiv a U hU (leadingOperator P) := by
  rw [affineEquiv_apply, leadingOperator_changeVariables U hU, leadingOperator_translate,
    affineEquiv_apply]

theorem eventually_nonneg_affineEquiv (a : ι → ℝ) (U : Matrix ι ι ℝ)
    (hU : U * U.transpose = 1) (Q : MvPolynomial ι ℝ)
    (hQ : ∀ᶠ x in 𝓝 a, 0 ≤ eval x Q) :
    ∀ᶠ x in 𝓝 (0 : ι → ℝ), 0 ≤ eval x (affineEquiv a U hU Q) := by
  have hc : Continuous (fun x : ι → ℝ => a + U *ᵥ x) := by
    unfold Matrix.mulVec dotProduct
    fun_prop
  have ht : Tendsto (fun x : ι → ℝ => a + U *ᵥ x) (𝓝 0) (𝓝 a) := by
    simpa only [ContinuousAt, Matrix.mulVec_zero, add_zero] using hc.continuousAt (x := 0)
  filter_upwards [ht.eventually hQ] with x hx
  rwa [eval_affineEquiv]

end
end Source29AffinePolynomialTransport

/- Component: RegularNormalCoordinates.inc -/
namespace Source29RegularNormalCoordinates

open MvPolynomial Source29PolynomialTranslation Source29AffinePolynomialTransport
open Source29QuarticReuse.QuarticMinimal Source29OrthogonalFrame
open Source29QuarticReuse.FluxObstruction
open scoped BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem exists_orthogonal_matrix_column (i : ι) (v : EuclideanSpace ℝ ι)
    (hv : ‖v‖ = 1) :
    ∃ U : Matrix ι ι ℝ, U.transpose * U = 1 ∧ U * U.transpose = 1 ∧
      ∀ j, U j i = v j := by
  let T := (ℝ ∙ (coordinateUnit i - v))ᗮ.reflection
  have hT : T (coordinateUnit i) = v :=
    Submodule.reflection_sub ((coordinateUnit_norm i).trans hv.symm)
  let U : Matrix ι ι ℝ := fun a b => T (coordinateUnit b) a
  have hU : U.transpose * U = 1 := by
    ext a b
    have he := T.inner_map_map (coordinateUnit a) (coordinateUnit b)
    rw [coordinateUnit_inner] at he
    simpa only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial, mul_comm,
      Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  exact ⟨U, hU, mul_eq_one_comm.mp hU,
    fun j => congrArg (fun z : EuclideanSpace ℝ ι => z j) hT⟩

/-- Every regular zero has affine orthogonal coordinates with positive first
normal derivative and all tangential derivatives zero. -/
theorem exists_regular_normal_coordinates {n : ℕ}
    (P : MvPolynomial (Fin (n+1)) ℝ) (a : Fin (n+1) → ℝ)
    (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0) :
    ∃ (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U * U.transpose = 1),
      eval (0 : Fin (n+1) → ℝ) (affineEquiv a U hU P) = 0 ∧
      0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 (affineEquiv a U hU P)) ∧
      ∀ j : Fin n, eval (0 : Fin (n+1) → ℝ)
        (pderiv j.succ (affineEquiv a U hU P)) = 0 := by
  let G : EuclideanSpace ℝ (Fin (n+1)) := WithLp.toLp 2 (evaluatedGradient P a)
  have hG : G ≠ 0 := by
    intro hz
    apply hreg
    funext j
    exact congrArg (fun z : EuclideanSpace ℝ (Fin (n+1)) => z j) hz
  let g : ℝ := ‖G‖
  have hg : 0 < g := norm_pos_iff.mpr hG
  have hv : ‖g⁻¹ • G‖ = 1 := by
    rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hg]
    exact inv_mul_cancel₀ hg.ne'
  obtain ⟨U, hUt, hU, hcol⟩ := exists_orthogonal_matrix_column 0 (g⁻¹ • G) hv
  have hgrad : ∀ j, eval a (pderiv j P) = g * U j 0 := by
    intro j
    rw [hcol]
    change eval a (pderiv j P) = g * (g⁻¹ * eval a (pderiv j P))
    rw [← mul_assoc, mul_inv_cancel₀ hg.ne', one_mul]
  have hdot : ∀ j, (∑ i, U i 0 * U i j) = if 0 = j then 1 else 0 := by
    intro j
    have he := congrArg (fun M : Matrix (Fin (n+1)) (Fin (n+1)) ℝ => M 0 j) hUt
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  have hpartial : ∀ j, eval (0 : Fin (n+1) → ℝ) (pderiv j (affineEquiv a U hU P)) =
      g * (if 0 = j then 1 else 0) := by
    intro j
    rw [affineEquiv_apply, pderiv_changeVariables, map_sum]
    simp only [map_mul, eval_C, eval_changeVariables, Matrix.mulVec_zero,
      pderiv_translate, eval_zero_translate]
    simp_rw [hgrad, mul_assoc]
    rw [← Finset.mul_sum, hdot]
  refine ⟨U, hU, ?_, ?_, ?_⟩
  · rwa [eval_zero_affineEquiv]
  · simpa only [hpartial, ite_true, mul_one] using hg
  · intro j
    rw [hpartial, ite_eq_right (Ne.symm (Fin.succ_ne_zero j)), mul_zero]

end
end Source29RegularNormalCoordinates

/- Component: DilatedCalibration.inc -/
namespace Source29DilatedCalibration

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- Positive scalar changes of input preserve the weak calibration identity.
The inverse change of variables transports the compact test function. -/
theorem weakCalibration_dilate
    (Z : (Fin n → ℝ) → Fin n → ℝ) (hZ : WeakCalibration Z)
    (r : ℝ) (hr : 0 < r) : WeakCalibration (fun x ↦ Z (r • x)) := by
  refine ⟨fun x i ↦ hZ.1 (r • x) i, ?_⟩
  intro φ hφ hcφ
  let ψ : (Fin n → ℝ) → ℝ := fun y ↦ φ (r⁻¹ • y)
  have hψ : ContDiff ℝ 1 ψ := hφ.comp (contDiff_id.const_smul r⁻¹)
  have hcψ : HasCompactSupport ψ :=
    hcφ.comp_homeomorph (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr.ne'))
  have hbase := hZ.2 ψ hψ hcψ
  have he : (fun x ↦ testFlux (fun i ↦ Pi.single i 1) φ (fun y ↦ Z (r • y)) x) =
      (fun x ↦ r * testFlux (fun i ↦ Pi.single i 1) ψ Z (r • x)) := by
    funext x
    have hd : fderiv ℝ ψ (r • x) = r⁻¹ • fderiv ℝ φ x := by
      dsimp only [ψ]
      rw [fderiv_comp_smul, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    simp only [testFlux, hd, _root_.smul_apply, smul_eq_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    field_simp
  constructor
  · change Integrable (fun x ↦ testFlux (fun i ↦ Pi.single i 1) φ (fun y ↦ Z (r • y)) x)
    rw [he]
    exact (hbase.1.comp_smul hr.ne').const_mul r
  · rw [he, integral_const_mul, Measure.integral_comp_smul_of_nonneg volume
      (testFlux (fun i ↦ Pi.single i 1) ψ Z) r (hR := hr.le), hbase.2, smul_zero, mul_zero]

end
end Source29DilatedCalibration

/- Component: InitialWeakCalibration.inc -/
namespace Source29InitialWeakCalibration

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The first nonzero positive-degree homogeneous component of a calibrated
polynomial inherits the normalized-gradient weak calibration. -/
theorem initial_weakCalibration (F : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField F)) (s : ℕ)
    (hlow : ∀ k < s+1, homogeneousComponent k F = 0)
    (hne : homogeneousComponent (s+1) F ≠ 0) :
    WeakCalibration (leadingNormalizedField (homogeneousComponent (s+1) F)) := by
  let t : ℕ → ℝ := fun k ↦ (dilationRadius k)⁻¹
  have ht : ∀ k, 0 < t k := fun k ↦ inv_pos.mpr (dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) := tendsto_inv_atTop_zero.comp dilationRadius_tendsto
  apply weakCalibration_limit (F := fun k x ↦ leadingNormalizedField F (t k • x))
  · intro k
    exact Source29DilatedCalibration.weakCalibration_dilate _ hcal (t k) (ht k)
  · exact leadingNormalizedField_bound _
  · exact Source29InitialGradientLimit.normalized_gradient_initial_limit_ae F s hlow hne ht ht0

end
end Source29InitialWeakCalibration

/- Component: RegularCalibratedFactorPositivity.inc -/
namespace Source29RegularCalibratedFactorPositivity

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Calibration of the full polynomial determines its first homogeneous term
at a regular point of an odd irreducible factor, and makes the cofactor positive. -/
theorem cofactor_pos_and_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hP0 : eval (0 : Fin (n+1) → ℝ) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (ht : ∀ i : Fin n, eval (0 : Fin (n+1) → ℝ) (pderiv i.succ P) = 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F)) :
    0 < eval (0 : Fin (n+1) → ℝ) Q ∧
      (∀ j < k, homogeneousComponent j F = 0) ∧
      homogeneousComponent k F =
        C ((eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k *
          eval (0 : Fin (n+1) → ℝ) Q) * (X 0)^k := by
  have hQne : Q ≠ 0 := by
    intro hz
    apply hPQ
    rw [hz]
    exact dvd_zero P
  have hFne : F ≠ 0 := by
    rw [hfac]
    exact mul_ne_zero (pow_ne_zero k hP.ne_zero) hQne
  have hk0 : k ≠ 0 := by
    obtain ⟨j, hj⟩ := hk
    omega
  have hF0 : eval (0 : Fin (n+1) → ℝ) F = 0 := by
    rw [hfac, map_mul, map_pow, hP0, zero_pow hk0, zero_mul]
  obtain ⟨d, hd, _, hne, hlow⟩ :=
    Source29PolynomialTranslation.exists_lowest_nonzero_component F hFne hF0
  cases d with
  | zero => omega
  | succ s =>
      have hical := Source29InitialWeakCalibration.initial_weakCalibration F hcal s hlow hne
      obtain ⟨hqpos, hsk, hformula⟩ :=
        Source29RegularFactorCalibratedInitial.cofactor_pos_of_calibrated_initial
          F P Q k hk hfac hP hPQ hP0 hn ht hQ hF (s+1) hlow hne hical
      refine ⟨hqpos, ?_, ?_⟩
      · simpa only [hsk] using hlow
      · simpa only [hsk] using hformula

/-- The regular cofactor-positivity conclusion needs no separately supplied
initial form or initial calibration. -/
theorem cofactor_pos
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hP0 : eval (0 : Fin (n+1) → ℝ) P = 0)
    (hn : 0 < eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))
    (ht : ∀ i : Fin n, eval (0 : Fin (n+1) → ℝ) (pderiv i.succ P) = 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F)) :
    0 < eval (0 : Fin (n+1) → ℝ) Q :=
  (cofactor_pos_and_initial F P Q k hk hfac hP hPQ hP0 hn ht hQ hF hcal).1

end
end Source29RegularCalibratedFactorPositivity

/- Component: OrthogonalCalibration.inc -/
namespace Source29OrthogonalCalibration

open Matrix MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticMinimal
open Source29WeakCalibrationLimits
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- Orthogonal coordinate change on the usual finite coordinate space. -/
def rotationHomeomorph (U : Matrix (Fin n) (Fin n) ℝ) (hU : U * U.transpose = 1) :
    (Fin n → ℝ) ≃ₜ (Fin n → ℝ) where
  toFun := fun x ↦ U *ᵥ x
  invFun := fun x ↦ U.transpose *ᵥ x
  left_inv x := by
    change U.transpose *ᵥ (U *ᵥ x) = x
    rw [Matrix.mulVec_mulVec, mul_eq_one_comm.mp hU, Matrix.one_mulVec]
  right_inv x := by
    change U *ᵥ (U.transpose *ᵥ x) = x
    rw [Matrix.mulVec_mulVec, hU, Matrix.one_mulVec]
  continuous_toFun := (Matrix.toLin' U).continuous_on_pi
  continuous_invFun := (Matrix.toLin' U.transpose).continuous_on_pi

lemma rotation_measurePreserving (U : Matrix (Fin n) (Fin n) ℝ)
    (hU : U * U.transpose = 1) :
    MeasurePreserving (fun x : Fin n → ℝ ↦ U *ᵥ x) volume volume := by
  have hdet := congrArg Matrix.det hU
  rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hdet
  have hd : |U.det| = 1 := by
    have hs : |U.det|^2 = 1 := by rw [sq_abs, pow_two, hdet]
    nlinarith [abs_nonneg U.det]
  have hn : U.det ≠ 0 := by
    intro h
    rw [h, abs_zero] at hd
    exact zero_ne_one hd
  have hm := Real.map_matrix_volume_pi_eq_smul_volume_pi (M := U) hn
  rw [abs_inv, hd, inv_one, ENNReal.ofReal_one, one_smul] at hm
  exact ⟨(Matrix.toLin' U).continuous_on_pi.measurable, hm⟩

lemma normalizedField_changeVariables
    (U : Matrix (Fin n) (Fin n) ℝ) (hU : U * U.transpose = 1)
    (F : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    leadingNormalizedField (changeVariables U F) x =
      U.transpose *ᵥ leadingNormalizedField F (U *ᵥ x) := by
  have hg : evaluatedGradient (changeVariables U F) x =
      U.transpose *ᵥ evaluatedGradient F (U *ᵥ x) := by
    funext j
    simp only [evaluatedGradient, pderiv_changeVariables, map_sum, map_mul, eval_C,
      eval_changeVariables, Matrix.mulVec, dotProduct, Matrix.transpose_apply]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  have hs : radiusSq (evaluatedGradient (changeVariables U F) x) =
      radiusSq (evaluatedGradient F (U *ᵥ x)) := by
    rw [hg]
    have he := MatrixAlgebra.dot_transpose_mulVec U hU
      (evaluatedGradient F (U *ᵥ x)) (evaluatedGradient F (U *ᵥ x))
    simpa only [radiusSq, dotProduct, ← pow_two] using he
  rw [hg] at hs
  funext i
  simp only [leadingNormalizedField, hg, hs, Matrix.mulVec, dotProduct,
    mul_div_assoc, Finset.sum_div]

lemma testFlux_eq_fderiv (φ : (Fin n → ℝ) → ℝ)
    (Z : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) φ Z x = fderiv ℝ φ x (Z x) := by
  have hz : Z x = ∑ i, Z x i • Pi.single i 1 := by
    funext j
    simp [Pi.single_apply]
  conv_rhs => rw [hz, map_sum]
  simp only [testFlux, map_smul, smul_eq_mul, mul_comm]

/-- Orthogonal changes of variables preserve a polynomial's weak normalized
calibration. The bound follows from the transformed polynomial itself. -/
theorem weakCalibration_changeVariables
    (U : Matrix (Fin n) (Fin n) ℝ) (hU : U * U.transpose = 1)
    (F : MvPolynomial (Fin n) ℝ) (hcal : WeakCalibration (leadingNormalizedField F)) :
    WeakCalibration (leadingNormalizedField (changeVariables U F)) := by
  refine ⟨leadingNormalizedField_bound _, ?_⟩
  intro φ hφ hcφ
  let ψ : (Fin n → ℝ) → ℝ := fun y ↦ φ (U.transpose *ᵥ y)
  let L : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ) :=
    (Matrix.toLin' U.transpose).toContinuousLinearMap
  have hψ : ContDiff ℝ 1 ψ := hφ.comp L.contDiff
  have hcψ : HasCompactSupport ψ :=
    hcφ.comp_homeomorph (rotationHomeomorph U hU).symm
  have hbase := hcal.2 ψ hψ hcψ
  have he : (fun x ↦ testFlux (fun i ↦ Pi.single i 1) φ
      (leadingNormalizedField (changeVariables U F)) x) =
      (fun x ↦ testFlux (fun i ↦ Pi.single i 1) ψ (leadingNormalizedField F) (U *ᵥ x)) := by
    funext x
    have hcancel : U.transpose *ᵥ (U *ᵥ x) = x := by
      rw [Matrix.mulVec_mulVec, mul_eq_one_comm.mp hU, Matrix.one_mulVec]
    have hd := (hφ.differentiable (by norm_num) (L (U *ᵥ x))).hasFDerivAt.comp
      (U *ᵥ x) L.hasFDerivAt
    have hde : fderiv ℝ ψ (U *ᵥ x) = (fderiv ℝ φ x).comp L := by
      have hd' := hd.fderiv
      change fderiv ℝ ψ (U *ᵥ x) = (fderiv ℝ φ (L (U *ᵥ x))).comp L at hd'
      simpa only [show L (U *ᵥ x) = x from hcancel] using hd'
    rw [testFlux_eq_fderiv, testFlux_eq_fderiv, hde, normalizedField_changeVariables U hU]
    rfl
  have hmp := rotation_measurePreserving U hU
  constructor
  · change Integrable (fun x ↦ testFlux (fun i ↦ Pi.single i 1) φ
      (leadingNormalizedField (changeVariables U F)) x)
    rw [he]
    exact hmp.integrable_comp_of_integrable hbase.1
  · rw [he]
    have hi := hmp.integral_comp (rotationHomeomorph U hU).toMeasurableEquiv.measurableEmbedding
      (testFlux (fun i ↦ Pi.single i 1) ψ (leadingNormalizedField F))
    exact hi.trans hbase.2

end
end Source29OrthogonalCalibration

/- Component: RegularCofactorAtPoint.inc -/
namespace Source29RegularCofactorAtPoint

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29AffinePolynomialTransport Source29PolynomialTranslation
open scoped Topology Matrix

noncomputable section
variable {n : ℕ}

/-- Orthogonal affine coordinates preserve the normalized-gradient calibration. -/
theorem weakCalibration_affineEquiv
    (F : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin n → ℝ) (U : Matrix (Fin n) (Fin n) ℝ) (hU : U * U.transpose = 1) :
    WeakCalibration (leadingNormalizedField (affineEquiv a U hU F)) := by
  rw [affineEquiv_apply]
  apply Source29OrthogonalCalibration.weakCalibration_changeVariables U hU
  simpa only [map_zero, sub_zero] using
    Source29TranslatedCalibration.polynomial_translated_level_weakCalibration F hcal 0 a

/-- A locally nonnegative cofactor of an odd irreducible factor is strictly
positive at every regular zero of that factor, independently of coordinates. -/
theorem cofactor_pos_at_regular_zero_succ
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0)
    (hQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 a, 0 ≤ eval z Q) :
    0 < eval a Q := by
  obtain ⟨U, hU, hP0, hn, ht⟩ :=
    Source29RegularNormalCoordinates.exists_regular_normal_coordinates P a ha hreg
  let E := affineEquiv a U hU
  have hEP : Irreducible (E P) := (MulEquiv.irreducible_iff E).mpr hP
  have hEPQ : ¬ E P ∣ E Q := by
    intro hd
    exact hPQ ((map_dvd_iff E.toRingEquiv).mp hd)
  have hEfac : E F = (E P)^k * E Q := by
    rw [hfac, map_mul, map_pow]
  have hEF : Source29QuarticReuse.QuarticMinimal.leadingOperator (E F) = 0 := by
    change Source29QuarticReuse.QuarticMinimal.leadingOperator (affineEquiv a U hU F) = 0
    rw [leadingOperator_affineEquiv, hF, map_zero]
  have hEcal : WeakCalibration (leadingNormalizedField (E F)) :=
    weakCalibration_affineEquiv F hcal a U hU
  have hEQ : ∀ᶠ z : Fin (n+1) → ℝ in 𝓝 0, 0 ≤ eval z (E Q) :=
    eventually_nonneg_affineEquiv a U hU Q hQ
  have hpos := Source29RegularCalibratedFactorPositivity.cofactor_pos
    (E F) (E P) (E Q) k hk hEfac hEP hEPQ hP0 hn ht hEQ hEF hEcal
  simpa only [E, eval_zero_affineEquiv] using hpos

/-- The coordinate-free regular-cofactor result in every ambient dimension.
The zero-dimensional case has no regular zero. -/
theorem cofactor_pos_at_regular_zero
    (F P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : Odd k) (hfac : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin n → ℝ) (ha : eval a P = 0) (hreg : evaluatedGradient P a ≠ 0)
    (hQ : ∀ᶠ z : Fin n → ℝ in 𝓝 a, 0 ≤ eval z Q) :
    0 < eval a Q := by
  cases n with
  | zero => exact (hreg (Subsingleton.elim _ _)).elim
  | succ n =>
      exact cofactor_pos_at_regular_zero_succ F P Q k hk hfac hP hPQ hF hcal a ha hreg hQ

end
end Source29RegularCofactorAtPoint

/- Component: FlatGraphInitialSigns.inc -/
namespace Source29FlatGraphInitialSigns

open MvPolynomial Filter
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Signs on the two sides of a flat differentiable graph pass to the first
homogeneous term without assuming regularity of a polynomial factor. -/
theorem halfspace_signs
    (F : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (hg : DifferentiableAt ℝ g 0) (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0)
    (d : ℕ) (hlow : ∀ j < d, homogeneousComponent j F = 0) :
    (∀ z : Fin (n+1) → ℝ, 0 < z 0 → 0 ≤ eval z (homogeneousComponent d F)) ∧
    (∀ z : Fin (n+1) → ℝ, z 0 < 0 → eval z (homogeneousComponent d F) ≤ 0) := by
  have hlim : ∀ z : ℝ × (Fin n → ℝ), Tendsto (fun t : ℝ =>
      eval (Fin.cons (g (t•z.2)+t*z.1) (t•z.2)) F / t^d)
      (𝓝[>] 0) (𝓝 (eval (Fin.cons z.1 z.2) (homogeneousComponent d F))) := by
    intro z
    exact Source29PolynomialInitialShift.normal_shift_initial_limit F d hlow hg hg0 hD z.1 z.2
  obtain ⟨hspos, hsneg⟩ := Source29LocalWeightedSignLimit.sign_inherited
    (fun z : ℝ × (Fin n → ℝ) => eval (Fin.cons (g z.2+z.1) z.2) F)
    (fun z => eval (Fin.cons z.1 z.2) (homogeneousComponent d F)) 1 d zero_lt_one
    hpos hneg (fun z => by
      simpa only [Source29LocalWeightedSignLimit.scaledPoint, Real.rpow_one,
        Real.rpow_natCast] using hlim z)
  constructor
  · intro z hz
    simpa only [Fin.cons_self_tail] using hspos (z 0, Fin.tail z) hz
  · intro z hz
    simpa only [Fin.cons_self_tail] using hsneg (z 0, Fin.tail z) hz

end
end Source29FlatGraphInitialSigns

/- Component: CalibratedFlatGraphInitial.inc -/
namespace Source29CalibratedFlatGraphInitial

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A calibrated polynomial whose signs agree with a flat differentiable
graph has a positive odd normal power as its first nonzero homogeneous term. -/
theorem exists_pure_initial
    (F : MvPolynomial (Fin (n+1)) ℝ) (hF : F ≠ 0) (hF0 : eval 0 F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (g : (Fin n → ℝ) → ℝ) (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    ∃ (d : ℕ) (c : ℝ), 0 < c ∧ Odd d ∧
      (∀ j < d, homogeneousComponent j F = 0) ∧
      homogeneousComponent d F = C c * (X 0)^d := by
  obtain ⟨d, hd, _, hne, hlow⟩ :=
    Source29PolynomialTranslation.exists_lowest_nonzero_component F hF hF0
  have hds : d-1+1 = d := by omega
  have hcal' : WeakCalibration (leadingNormalizedField (homogeneousComponent d F)) := by
    have hc := Source29InitialWeakCalibration.initial_weakCalibration F hcal (d-1)
      (by simpa only [hds] using hlow) (by simpa only [hds] using hne)
    simpa only [hds] using hc
  obtain ⟨hspos, hsneg⟩ := Source29FlatGraphInitialSigns.halfspace_signs
    F g hg hg0 hD hpos hneg d hlow
  obtain ⟨c, hc, hodd, hpure⟩ := Source29CalibratedHalfspaceRigidity.eq_positive_odd_normal_power
    (homogeneousComponent d F) d (homogeneousComponent_isHomogeneous d F) hne hcal' hspos hsneg
  exact ⟨d, c, hc, hodd, hlow, hpure⟩

end
end Source29CalibratedFlatGraphInitial

/- Component: GraphRootMultiplicity.inc -/
namespace Source29GraphRootMultiplicity

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonShiftedFactorCoefficient
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A nonzero polynomial vanishing on a graph over an open parameter germ
must depend on the normal variable. No regularity of the graph is needed. -/
theorem normal_natDegree_ne_zero_of_graph_root
    (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    (finSuccEquiv ℝ n P).natDegree ≠ 0 := by
  intro hd
  have he := Polynomial.eq_C_of_natDegree_eq_zero hd
  have hz : (finSuccEquiv ℝ n P).coeff 0 = 0 := by
    apply Source29LocalHyperplaneDivisor.polynomial_eq_zero_of_locally_zero _ a
    filter_upwards [hroot] with y hy
    rw [← eval_sliceHom] at hy
    change ((finSuccEquiv ℝ n P).map (eval y)).eval (g y) = 0 at hy
    rw [he, Polynomial.map_C, Polynomial.eval_C] at hy
    exact hy
  apply hP
  apply (finSuccEquiv ℝ n).injective
  rw [map_zero, he, hz, Polynomial.C_0]

/-- Common vanishing on a graph germ forces divisibility by an irreducible
polynomial, even when its gradient vanishes at the base point. -/
theorem dvd_of_common_graph_germ
    (P Q : MvPolynomial (Fin (n+1)) ℝ) (hP : Irreducible P)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0 ∧
      eval (Fin.cons (g y) y) Q = 0) : P ∣ Q := by
  have hdvd : finSuccEquiv ℝ n P ∣ finSuccEquiv ℝ n Q := by
    apply Source29LocalRegularPatchDensity.dvd_of_common_root_germ _ _
      ((MulEquiv.irreducible_iff (finSuccEquiv ℝ n)).mpr hP)
      (normal_natDegree_ne_zero_of_graph_root P hP.ne_zero g a (hroot.mono fun _ h => h.1)) a g
    filter_upwards [hroot] with y hy
    exact ⟨(eval_sliceHom P y (g y)).trans hy.1, (eval_sliceHom Q y (g y)).trans hy.2⟩
  exact (map_dvd_iff (finSuccEquiv ℝ n).toRingEquiv).mp hdvd

/-- In characteristic zero, normal dependence prevents a polynomial from
dividing its own normal derivative. -/
theorem not_dvd_normal_derivative
    (P : MvPolynomial (Fin (n+1)) ℝ)
    (hdegree : (finSuccEquiv ℝ n P).natDegree ≠ 0) : ¬ P ∣ pderiv 0 P := by
  intro h
  have hdvd := (map_dvd_iff (finSuccEquiv ℝ n).toRingEquiv).mpr h
  change finSuccEquiv ℝ n P ∣ finSuccEquiv ℝ n (pderiv 0 P) at hdvd
  rw [finSuccEquiv_pderiv_zero] at hdvd
  exact hdegree (Polynomial.derivative_eq_zero.mp (Polynomial.dvd_derivative_iff.mp hdvd))

/-- The first possible normal coefficient is a nonzero germ on every graph
of a full irreducible factor. Base-point simplicity is a conclusion later. -/
theorem coefficient_not_eventually_zero_of_graph_root
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hF : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0) :
    ¬ ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff k = 0 := by
  intro hz
  have hdvd : P ∣ (pderiv 0 P)^k*Q := by
    apply dvd_of_common_graph_germ P _ hP g a
    filter_upwards [hroot, hz] with y hy hzero
    refine ⟨hy, ?_⟩
    simpa only [map_mul, map_pow, coeff_shifted_factor F P Q k hF (g y) y hy] using hzero
  rcases hP.prime.dvd_mul.mp hdvd with hderiv | hQ
  · exact not_dvd_normal_derivative P
      (normal_natDegree_ne_zero_of_graph_root P hP.ne_zero g a hroot)
      (hP.prime.dvd_of_dvd_pow hderiv)
  · exact hPQ hQ

/-- If all lower normal coefficient germs vanish and the next coefficient
is nonzero at the base, its degree is exactly the factor multiplicity. -/
theorem multiplicity_eq_initial_degree
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k d : ℕ) (hF : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (htop : (shiftedSlice F (g a) a).coeff d ≠ 0)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0) :
    d = k := by
  apply le_antisymm
  · by_contra h
    exact (coefficient_not_eventually_zero_of_graph_root F P Q k hF hP hPQ g a hroot)
      (hlower ⟨k,Nat.lt_of_not_ge h⟩)
  · by_contra h
    exact htop (coeff_shifted_factor_eq_zero_of_lt F P Q k hF (g a) a
      hroot.self_of_nhds d (Nat.lt_of_not_ge h))

/-- Constant normal multiplicity forces both simplicity of the irreducible
factor and nonvanishing of the cofactor at the base point. -/
theorem regularity_and_cofactor_nonzero
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k d : ℕ) (hk : 0 < k) (hF : F = P^k*Q)
    (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) P = 0)
    (htop : (shiftedSlice F (g a) a).coeff d ≠ 0)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0) :
    d = k ∧ eval (Fin.cons (g a) a) (pderiv 0 P) ≠ 0 ∧
      eval (Fin.cons (g a) a) Q ≠ 0 := by
  have hdk := multiplicity_eq_initial_degree F P Q k d hF hP hPQ g a hroot htop hlower
  have hprod : (eval (Fin.cons (g a) a) (pderiv 0 P))^k *
      eval (Fin.cons (g a) a) Q ≠ 0 := by
    rwa [hdk, coeff_shifted_factor F P Q k hF (g a) a hroot.self_of_nhds] at htop
  refine ⟨hdk, ?_, ?_⟩
  · intro hz
    apply hprod
    rw [hz, zero_pow hk.ne', zero_mul]
  · intro hz
    exact hprod (by rw [hz, mul_zero])

end
end Source29GraphRootMultiplicity

/- Component: GeometricRegularFactorPositivity.inc -/
namespace Source29GeometricRegularFactorPositivity

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NormalShiftDerivatives
open Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- An analytic minimal graph carrying a full irreducible factor becomes an
algebraically regular graph when the shifted polynomial has its prescribed
halfspace signs and a pure ordinary initial limit. Neither normal simplicity
of the factor nor nonvanishing of the cofactor is assumed. -/
theorem regularity_and_cofactor_pos_of_pure_initial
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F = P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hQ : 0 ≤ eval (Fin.cons (g 0) 0) Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (d : ℕ) (c : ℝ) (hc : c ≠ 0)
    (hinitial : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d) (𝓝[>] 0) (𝓝 (c*x^d)))
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    d = k ∧ eval (Fin.cons (g 0) 0) (pderiv 0 P) ≠ 0 ∧
      0 < eval (Fin.cons (g 0) 0) Q ∧
      c = (eval (Fin.cons (g 0) 0) (pderiv 0 P))^k * eval (Fin.cons (g 0) 0) Q := by
  have hlower := Source29NewtonRegularObstruction.lower_coefficient_germs_zero
    F g hg hg0 hF hbg d c hc hinitial hpos hneg
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  have htopne : (shiftedSlice F (g 0) 0).coeff d ≠ 0 := by rwa [htop]
  obtain ⟨hdk, hn, hQne⟩ := Source29GraphRootMultiplicity.regularity_and_cofactor_nonzero
    F P Q k d hk hfac hP hPQ g 0 hroot htopne hlower
  refine ⟨hdk, hn, lt_of_le_of_ne hQ hQne.symm, ?_⟩
  rw [← htop, hdk]
  exact coeff_shifted_factor F P Q k hfac (g 0) 0 hroot.self_of_nhds

end
end Source29GeometricRegularFactorPositivity

/- Component: CalibratedGeometricRegularity.inc -/
namespace Source29CalibratedGeometricRegularity

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Along an analytic minimal graph, calibration and the two side signs force
an irreducible defining factor to be regular and its full cofactor to be positive.
No algebraic regularity or prescribed initial form is assumed. -/
theorem regularity_and_cofactor_pos
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F = P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hgrad : gradient g 0 = 0)
    (hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P = 0)
    (hQ : 0 ≤ eval (0 : Fin (n+1) → ℝ) Q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    eval (0 : Fin (n+1) → ℝ) (pderiv 0 P) ≠ 0 ∧
      0 < eval (0 : Fin (n+1) → ℝ) Q ∧ Odd k ∧
      (∀ j < k, homogeneousComponent j F = 0) ∧
      homogeneousComponent k F =
        C ((eval (0 : Fin (n+1) → ℝ) (pderiv 0 P))^k *
          eval (0 : Fin (n+1) → ℝ) Q) * (X 0)^k := by
  have hbase : (Fin.cons (g 0) 0 : Fin (n+1) → ℝ) = 0 := by
    rw [hg0]
    funext i
    exact Fin.cases rfl (fun j => rfl) i
  have hP0 : eval (0 : Fin (n+1) → ℝ) P = 0 := by
    simpa only [hbase] using hroot.self_of_nhds
  have hQne : Q ≠ 0 := by
    intro he
    exact hPQ (he ▸ dvd_zero P)
  have hFne : F ≠ 0 := by
    rw [hfac]
    exact mul_ne_zero (pow_ne_zero k hP.ne_zero) hQne
  have hF0 : eval (0 : Fin (n+1) → ℝ) F = 0 := by
    rw [hfac, map_mul, map_pow, hP0, zero_pow hk.ne', zero_mul]
  have hD := Source29FlatRegularGraph.fderiv_eq_zero_of_gradient_eq_zero g 0 hgrad
  obtain ⟨d, c, hc, hodd, hlow, hpure⟩ :=
    Source29CalibratedFlatGraphInitial.exists_pure_initial F hFne hF0 hcal
      g hg.differentiableAt hg0 hD hpos hneg
  have hinitial := Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
    F d c hlow hpure hg hg0 hD
  obtain ⟨hdk, hn, hQpos, hformula⟩ :=
    Source29GeometricRegularFactorPositivity.regularity_and_cofactor_pos_of_pure_initial
      F P Q k hk hfac hP hPQ g hg hgrad hroot (by simpa only [hbase] using hQ)
      hF hbg d c hc.ne' hinitial hpos hneg
  rw [hbase] at hn hQpos hformula
  refine ⟨hn, hQpos, hdk ▸ hodd, ?_, ?_⟩
  · simpa only [hdk] using hlow
  · simpa only [hdk, hformula] using hpure

end
end Source29CalibratedGeometricRegularity

/- Component: GeometricPhaseChart.inc -/
namespace Source29GeometricPhaseChart

open MvPolynomial Filter
open Source29AffinePolynomialTransport Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped Topology Matrix

noncomputable section
variable {n : ℕ}

/-- An oriented analytic minimal graph chart of the zero phase boundary,
stated for the polynomial itself, independently of its factorization. -/
def HasFlatMinimalPhaseChart (F : MvPolynomial (Fin (n+1)) ℝ)
    (a : Fin (n+1) → ℝ) : Prop :=
  ∃ (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U * U.transpose = 1)
    (g : (Fin n → ℝ) → ℝ),
    AnalyticAt ℝ g 0 ∧ g 0 = 0 ∧ gradient g 0 = 0 ∧
    (∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0) ∧
    (∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) (affineEquiv a U hU F) = 0) ∧
    (∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F)) ∧
    (∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F) ≤ 0)

theorem affine_weakCalibration
    (F : MvPolynomial (Fin (n+1)) ℝ) (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U * U.transpose = 1) :
    WeakCalibration (leadingNormalizedField (affineEquiv a U hU F)) := by
  have ht : WeakCalibration (leadingNormalizedField (Source29PolynomialTranslation.translate F a)) := by
    simpa only [map_zero, sub_zero] using
      Source29TranslatedCalibration.polynomial_translated_level_weakCalibration F hcal 0 a
  exact Source29OrthogonalCalibration.weakCalibration_changeVariables U hU _ ht

/-- A chart of the actual phase boundary suffices for strict residual
positivity; no polynomial-gradient regularity is part of the chart data. -/
theorem cofactor_pos_of_phase_chart
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F = P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hQ : ∀ x, 0 ≤ eval x Q) (hzero : ∀ x, eval x Q = 0 → eval x P = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (hchart : HasFlatMinimalPhaseChart F a) :
    0 < eval a Q := by
  obtain ⟨U, hU, g, hg, hg0, hgrad, hbg, hrootF, hpos, hneg⟩ := hchart
  let E := affineEquiv a U hU
  have hfac' : E F = (E P)^k * E Q := by rw [hfac, map_mul, map_pow]
  have hP' : Irreducible (E P) := (MulEquiv.irreducible_iff E).mpr hP
  have hPQ' : ¬ E P ∣ E Q := fun h => hPQ ((map_dvd_iff E).mp h)
  have hF' : Source29QuarticReuse.QuarticMinimal.leadingOperator (E F) = 0 := by
    dsimp only [E]
    rw [leadingOperator_affineEquiv, hF, map_zero]
  have hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) (E P) = 0 := by
    filter_upwards [hrootF] with y hy
    change eval (Fin.cons (g y) y) (E F) = 0 at hy
    rw [hfac', map_mul, map_pow] at hy
    rcases mul_eq_zero.mp hy with hp | hq
    · by_contra h
      exact pow_ne_zero k h hp
    · dsimp only [E] at hq ⊢
      rw [eval_affineEquiv] at hq ⊢
      exact hzero _ hq
  have hQ0 : 0 ≤ eval (0 : Fin (n+1) → ℝ) (E Q) := by
    dsimp only [E]
    rw [eval_zero_affineEquiv]
    exact hQ a
  have result := Source29CalibratedGeometricRegularity.regularity_and_cofactor_pos
    (E F) (E P) (E Q) k hk hfac' hP' hPQ' g hg hg0 hgrad hroot hQ0 hF'
    (affine_weakCalibration F hcal a U hU) hbg hpos hneg
  simpa only [E, eval_zero_affineEquiv] using result.2.1

end
end Source29GeometricPhaseChart

/- Component: ZeroSetFactorGraph.inc -/
namespace Source29ZeroSetFactorGraph

open MvPolynomial Filter Set
open Source29AffinePolynomialTransport
open scoped Topology Matrix

noncomputable section

/-- If every real zero of the cofactor is already a zero of the factor,
the factor and the full polynomial have the same real zero set. -/
theorem eval_zero_iff {ι : Type*} (F P Q : MvPolynomial ι ℝ)
    (k : ℕ) (hk : 0 < k) (hfac : F = P^k*Q)
    (hzero : ∀ x : ι → ℝ, eval x Q = 0 → eval x P = 0) (x : ι → ℝ) :
    eval x F = 0 ↔ eval x P = 0 := by
  rw [hfac, map_mul, map_pow, mul_eq_zero]
  constructor
  · rintro (hp | hq)
    · exact eq_zero_of_pow_eq_zero hp
    · exact hzero x hq
  · intro hp
    exact Or.inl (by rw [hp, zero_pow hk.ne'])

/-- The zero-set equivalence is unchanged in orthogonal affine coordinates. -/
theorem eval_affine_zero_iff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (F P Q : MvPolynomial ι ℝ) (k : ℕ) (hk : 0 < k) (hfac : F = P^k*Q)
    (hzero : ∀ x : ι → ℝ, eval x Q = 0 → eval x P = 0)
    (a : ι → ℝ) (U : Matrix ι ι ℝ) (hU : U * U.transpose = 1) (x : ι → ℝ) :
    eval x (affineEquiv a U hU F) = 0 ↔ eval x (affineEquiv a U hU P) = 0 := by
  simp only [eval_affineEquiv]
  exact eval_zero_iff F P Q k hk hfac hzero _

theorem graph_root_of_full_root {n : ℕ} (F P Q : MvPolynomial (Fin (n+1)) ℝ)
    (k : ℕ) (hk : 0 < k) (hfac : F = P^k*Q)
    (hzero : ∀ x : Fin (n+1) → ℝ, eval x Q = 0 → eval x P = 0)
    (g : (Fin n → ℝ) → ℝ) (b : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 b, eval (Fin.cons (g y) y) F = 0) :
    ∀ᶠ y in 𝓝 b, eval (Fin.cons (g y) y) P = 0 := by
  filter_upwards [hroot] with y hy
  exact (eval_zero_iff F P Q k hk hfac hzero _).mp hy

theorem affine_graph_root_of_full_root {n : ℕ} (F P Q : MvPolynomial (Fin (n+1)) ℝ)
    (k : ℕ) (hk : 0 < k) (hfac : F = P^k*Q)
    (hzero : ∀ x : Fin (n+1) → ℝ, eval x Q = 0 → eval x P = 0)
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U * U.transpose = 1) (g : (Fin n → ℝ) → ℝ) (b : Fin n → ℝ)
    (hroot : ∀ᶠ y in 𝓝 b, eval (Fin.cons (g y) y) (affineEquiv a U hU F) = 0) :
    ∀ᶠ y in 𝓝 b, eval (Fin.cons (g y) y) (affineEquiv a U hU P) = 0 := by
  filter_upwards [hroot] with y hy
  exact (eval_affine_zero_iff F P Q k hk hfac hzero a U hU _).mp hy

lemma zero_of_local_side_signs {f : ℝ → ℝ} (hf : ContinuousAt f 0)
    (hpos : ∀ᶠ x in 𝓝 0, 0 < x → 0 ≤ f x)
    (hneg : ∀ᶠ x in 𝓝 0, x < 0 → f x ≤ 0) : f 0 = 0 := by
  have hn : Tendsto f (𝓝[<] 0) (𝓝 (f 0)) := hf.mono_left nhdsWithin_le_nhds
  have hp : Tendsto f (𝓝[>] 0) (𝓝 (f 0)) := hf.mono_left nhdsWithin_le_nhds
  apply le_antisymm
  · apply le_of_tendsto hn
    filter_upwards [hneg.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with x hx hlt
    exact hx hlt
  · apply ge_of_tendsto hp
    filter_upwards [hpos.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with x hx hlt
    exact hx hlt

/-- Weak opposite signs near the zero normal slice force that slice to vanish
on an open tangential neighborhood. Only normal-slice continuity is required. -/
theorem exists_open_zero_slice {Y : Type*} [TopologicalSpace Y]
    (f : ℝ × Y → ℝ) (b : Y) (hf : ∀ y, ContinuousAt (fun x : ℝ ↦ f (x,y)) 0)
    (hpos : ∀ᶠ z in 𝓝 ((0 : ℝ),b), 0 < z.1 → 0 ≤ f z)
    (hneg : ∀ᶠ z in 𝓝 ((0 : ℝ),b), z.1 < 0 → f z ≤ 0) :
    ∃ W : Set Y, IsOpen W ∧ b ∈ W ∧ ∀ y ∈ W, f (0,y) = 0 := by
  obtain ⟨V,W,hV,hV0,hW,hWb,hsub⟩ := mem_nhds_prod_iff'.mp (hpos.and hneg)
  refine ⟨W,hW,hWb,?_⟩
  intro y hy
  apply zero_of_local_side_signs (hf y)
  · filter_upwards [hV.mem_nhds hV0] with x hx
    exact (hsub (show (x,y) ∈ V ×ˢ W from ⟨hx,hy⟩)).1
  · filter_upwards [hV.mem_nhds hV0] with x hx
    exact (hsub (show (x,y) ∈ V ×ˢ W from ⟨hx,hy⟩)).2

/-- Polynomial shifted side signs imply an actual graph of zeros. No regularity
of the chosen graph function is needed for this implication. -/
theorem graph_root_of_side_signs {n : ℕ} (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (b : Fin n → ℝ)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,b),
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,b),
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    ∃ W : Set (Fin n → ℝ), IsOpen W ∧ b ∈ W ∧
      ∀ y ∈ W, eval (Fin.cons (g y) y) F = 0 := by
  have hc (y : Fin n → ℝ) :
      ContinuousAt (fun x : ℝ ↦ eval (Fin.cons (g y+x) y) F) 0 := by
    apply Continuous.continuousAt
    apply (Source29CompactPolynomialLink.continuous_eval F).comp
    apply continuous_pi
    intro i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · exact continuous_const.add continuous_id
    · exact continuous_const
  obtain ⟨W,hW,hWb,hr⟩ := exists_open_zero_slice
    (fun z : ℝ × (Fin n → ℝ) ↦ eval (Fin.cons (g z.2+z.1) z.2) F) b hc hpos hneg
  exact ⟨W,hW,hWb,fun y hy ↦ by simpa only [add_zero] using hr y hy⟩

/-- Explicit open-neighborhood version of the shifted sign-to-root implication. -/
theorem graph_root_of_open_side_signs {n : ℕ} (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (b : Fin n → ℝ)
    (V : Set (ℝ × (Fin n → ℝ))) (hV : IsOpen V) (hVb : (0,b) ∈ V)
    (hpos : ∀ z ∈ V, 0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ z ∈ V, z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    ∃ W : Set (Fin n → ℝ), IsOpen W ∧ b ∈ W ∧
      ∀ y ∈ W, eval (Fin.cons (g y) y) F = 0 := by
  apply graph_root_of_side_signs F g b
  · filter_upwards [hV.mem_nhds hVb] with z hz
    exact hpos z hz
  · filter_upwards [hV.mem_nhds hVb] with z hz
    exact hneg z hz

/-- A sign chart for the full polynomial is a zero graph for its selected
factor in the same affine coordinates. -/
theorem affine_factor_graph_of_side_signs {n : ℕ} (F P Q : MvPolynomial (Fin (n+1)) ℝ)
    (k : ℕ) (hk : 0 < k) (hfac : F = P^k*Q)
    (hzero : ∀ x : Fin (n+1) → ℝ, eval x Q = 0 → eval x P = 0)
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U * U.transpose = 1) (g : (Fin n → ℝ) → ℝ) (b : Fin n → ℝ)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,b),
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F))
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,b),
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F) ≤ 0) :
    ∃ W : Set (Fin n → ℝ), IsOpen W ∧ b ∈ W ∧
      ∀ y ∈ W, eval (Fin.cons (g y) y) (affineEquiv a U hU P) = 0 := by
  obtain ⟨W,hW,hWb,hr⟩ := graph_root_of_side_signs (affineEquiv a U hU F) g b hpos hneg
  exact ⟨W,hW,hWb,fun y hy ↦
    (eval_affine_zero_iff F P Q k hk hfac hzero a U hU _).mp (hr y hy)⟩

end
end Source29ZeroSetFactorGraph

/- Component: GeometricStructureReduction.inc -/
namespace Source29GeometricStructureReduction

open MvPolynomial Source29Closing Source29LengthNullCoverings
open Source29GeometricPhaseChart Source29PositiveLeadingStructureReduction
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits

noncomputable section

/-- The zero phase admits oriented flat analytic minimal-graph charts away
from a set with arbitrarily short countable ball coverings. -/
def GeometricChartRegularity {n : ℕ} (F : MvPolynomial (Fin (n+1)) ℝ) : Prop :=
  ∃ S : Set (Fin (n+1) → ℝ), HasZeroLengthCoverings S ∧
    ∀ a, eval a F = 0 → a ∉ S → HasFlatMinimalPhaseChart F a

/-- Every residual zero belongs to the geometric exceptional set; no
regularity of the polynomial gradient is assumed. -/
theorem cofactor_zero_length_coverings {n : ℕ}
    (F p Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F = p^k*Q) (hp : Irreducible p) (hpQ : ¬ p ∣ Q)
    (hQ : ∀ x, 0 ≤ eval x Q) (hzero : ∀ x, eval x Q = 0 → eval x p = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hcharts : GeometricChartRegularity F) :
    HasZeroLengthCoverings {x : Fin (n+1) → ℝ | eval x Q = 0} := by
  obtain ⟨S, hS, hchart⟩ := hcharts
  apply hS.mono
  intro a ha
  by_contra haS
  have hFa : eval a F = 0 := by
    rw [hfac, map_mul, map_pow, ha, mul_zero]
  have hpositive := cofactor_pos_of_phase_chart F p Q k hk hfac hp hpQ hQ hzero
    hF hcal a (hchart a hFa haS)
  exact hpositive.ne' ha

/-- Connected leading sign regions and geometric phase charts imply the
positive homogeneous residual factor data used by the closing theorem. -/
theorem positive_leading_factor_of_connectedness_and_phase_charts
    (P : Polynomial8) (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (hpos : IsPreconnected {x : Fin 8 → ℝ | 0 < eval x (homogeneousComponent P.totalDegree P)})
    (hneg : IsPreconnected {x : Fin 8 → ℝ | eval x (homogeneousComponent P.totalDegree P) < 0})
    (hcharts : GeometricChartRegularity (homogeneousComponent P.totalDegree P)) :
    PositiveLeadingFactorData8 P := by
  obtain ⟨p, Q, k, hk, _, hp, hphom, hQhom, hfac, hpQ, _, _, hQ, hzero, _, _⟩ :=
    Source29ConnectedFactorStructure.minimal_graph_nonnegative_leading_factor
      P hmin hdeg hpos hneg
  obtain ⟨_, _, hL⟩ := QuarticPolynomialBasics.leading_component_data P hmin hdeg
  have hcal := Source29TopPhasePerimeter.top_weakCalibration P hmin hdeg
  have hsmall := cofactor_zero_length_coverings (homogeneousComponent P.totalDegree P)
    p Q k (by omega) hfac hp hpQ hQ hzero hL hcal hcharts
  refine ⟨p, Q, k, hk, hp, hphom, hQhom, hfac, ?_⟩
  exact Source29HomogeneousZeroCoverings.positive_away_of_zero_length_coverings
    Q hQhom hQ hsmall

/-- Conditional geometric closing reduction. The only remaining inputs here
are preconnected leading sign regions and geometric phase-chart regularity. -/
theorem problem29_of_connectedness_and_phase_charts
    (hconnected : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      IsPreconnected {x : Fin 8 → ℝ | 0 < eval x (homogeneousComponent P.totalDegree P)} ∧
      IsPreconnected {x : Fin 8 → ℝ | eval x (homogeneousComponent P.totalDegree P) < 0})
    (hcharts : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      GeometricChartRegularity (homogeneousComponent P.totalDegree P)) :
    Math30.Problem29 := by
  apply problem29_of_positive_leading_factor
  intro P hmin hdeg
  obtain ⟨hpos, hneg⟩ := hconnected P hmin hdeg
  exact positive_leading_factor_of_connectedness_and_phase_charts P hmin hdeg hpos hneg
    (hcharts P hmin hdeg)

end
end Source29GeometricStructureReduction

/- Component: CoordinateTiltExcess.inc -/
namespace Source29CoordinateTiltExcess

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29VariationConvexity Source29PolynomialStress
open Source29SmoothPhaseTransition Source29PhaseApproximation Source29PhaseMassLimit
open Source29NonlinearCalibration
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def normalDeviation (P : MvPolynomial (Fin (n+1)) ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ∑ i, (leadingNormalizedField P x i - (Pi.single 0 1 : Fin (n+1) → ℝ) i)^2

def normalFlux (P : MvPolynomial (Fin (n+1)) ℝ) (ρ : (Fin (n+1) → ℝ) → ℝ) : ℝ :=
  -(∫ x, fderiv ℝ ρ x (Pi.single 0 1) * (if 0 < eval x P then 1 else 0))

def excess (P : MvPolynomial (Fin (n+1)) ℝ) (ρ : (Fin (n+1) → ℝ) → ℝ) : ℝ :=
  phaseMass P ρ - normalFlux P ρ

def diffuseTilt (P : MvPolynomial (Fin (n+1)) ℝ) (ρ : (Fin (n+1) → ℝ) → ℝ)
    (k : ℕ) (x : Fin (n+1) → ℝ) : ℝ :=
  (1/2 : ℝ) * ρ x * deriv (transition k) (eval x P) *
    variationDensity (evaluatedGradient P x) * normalDeviation P x

/-- The Euclidean normal identity remains valid at critical points after
multiplication by the gradient length. -/
theorem weighted_normalDeviation (P : MvPolynomial (Fin (n+1)) ℝ)
    (x : Fin (n+1) → ℝ) :
    (1/2 : ℝ) * variationDensity (evaluatedGradient P x) * normalDeviation P x =
      variationDensity (evaluatedGradient P x) - evaluatedGradient P x 0 := by
  by_cases hz : evaluatedGradient P x = 0
  · simp [hz, variationDensity]
  have hp := radiusSq_pos_of_ne_zero hz
  have hunit : (∑ i, leadingNormalizedField P x i ^ 2) = 1 := by
    simp only [leadingNormalizedField, div_pow, ← Finset.sum_div]
    change radiusSq (evaluatedGradient P x) /
      (Real.sqrt (radiusSq (evaluatedGradient P x)))^2 = 1
    rw [Real.sq_sqrt hp.le, div_self hp.ne']
  have he : normalDeviation P x =
      (∑ i, leadingNormalizedField P x i ^ 2) - 2 * leadingNormalizedField P x 0 + 1 := by
    simp only [normalDeviation, Fin.sum_univ_succ, Pi.single_eq_same, sub_zero,
      Pi.single_eq_of_ne (Fin.succ_ne_zero _)]
    ring
  rw [he, hunit]
  nlinarith [norm_mul_normal P x 0]

theorem diffuseTilt_eq (P : MvPolynomial (Fin (n+1)) ℝ)
    (ρ : (Fin (n+1) → ℝ) → ℝ) (k : ℕ) (x : Fin (n+1) → ℝ) :
    diffuseTilt P ρ k x =
      ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) -
      ρ x * deriv (transition k) (eval x P) * evaluatedGradient P x 0 := by
  calc
    _ = ρ x * deriv (transition k) (eval x P) *
        ((1/2 : ℝ) * variationDensity (evaluatedGradient P x) * normalDeviation P x) := by
      unfold diffuseTilt
      ring
    _ = _ := by rw [weighted_normalDeviation]; ring

lemma normal_pairing_integrable (P : MvPolynomial (Fin (n+1)) ℝ)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (k : ℕ) :
    Integrable (fun x => ρ x * deriv (transition k) (eval x P) * evaluatedGradient P x 0) := by
  exact ((hρ.continuous.mul ((transition_contDiff k).continuous_deriv_one.comp
    (contDiff_eval P).continuous)).mul (contDiff_eval (pderiv 0 P)).continuous).integrable_of_hasCompactSupport
      hcρ.mul_right.mul_right

lemma normal_pairing_eq (P : MvPolynomial (Fin (n+1)) ℝ)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (k : ℕ) :
    (∫ x, ρ x * deriv (transition k) (eval x P) * evaluatedGradient P x 0) =
      -(∫ x, fderiv ℝ ρ x (Pi.single 0 1) * transition k (eval x P)) := by
  have hb := integral_mul_fderiv_eq_neg_of_compactSupport (μ := volume)
    hρ hcρ ((transition_contDiff k).comp (contDiff_eval P)) (Pi.single 0 1)
  change (∫ x, ρ x * fderiv ℝ (fun y => transition k (eval y P)) x (Pi.single 0 1)) = _ at hb
  simp_rw [Source29PhaseDivergence.composed_fderiv P (transition_contDiff k)] at hb
  simpa only [mul_assoc, Function.comp_apply] using hb

theorem normal_pairing_tendsto (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k => ∫ x, ρ x * deriv (transition k) (eval x P) * evaluatedGradient P x 0)
      atTop (𝓝 (normalFlux P ρ)) := by
  have hi : Integrable (fun x => fderiv ℝ ρ x (Pi.single 0 1)) :=
    ((hρ.continuous_fderiv (by norm_num)).clm_apply continuous_const).integrable_of_hasCompactSupport
      (hcρ.fderiv_apply ℝ (Pi.single 0 1))
  have ht := (transition_weighted_integral P hP _ hi).neg
  simpa only [normal_pairing_eq P hρ hcρ, normalFlux] using ht

theorem diffuseTilt_integrable (P : MvPolynomial (Fin (n+1)) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (k : ℕ) : Integrable (diffuseTilt P ρ k) := by
  have hm := (localized_gradient_mass_identity P hcal hρ hcρ
    (transition_contDiff k) (transition_norm_le_one k)).1
  change Integrable (fun x => diffuseTilt P ρ k x)
  simp_rw [diffuseTilt_eq]
  exact hm.sub (normal_pairing_integrable P hρ hcρ k)

/-- The excess is an actual limit of nonnegative, squared-normal tilt
integrals. This does not assign a normal trace at singular zeroes. -/
theorem diffuseTilt_tendsto (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k => ∫ x, diffuseTilt P ρ k x) atTop (𝓝 (excess P ρ)) := by
  have ht := (phaseMass_tendsto P hP hcal hρ hcρ).sub (normal_pairing_tendsto P hP hρ hcρ)
  have he (k : ℕ) : (∫ x, diffuseTilt P ρ k x) =
      (∫ x, ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) -
      (∫ x, ρ x * deriv (transition k) (eval x P) * evaluatedGradient P x 0) := by
    simp_rw [diffuseTilt_eq]
    exact integral_sub
      (localized_gradient_mass_identity P hcal hρ hcρ
        (transition_contDiff k) (transition_norm_le_one k)).1
      (normal_pairing_integrable P hρ hcρ k)
  simpa only [he, excess] using ht

theorem excess_nonneg (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) : 0 ≤ excess P ρ := by
  apply ge_of_tendsto (diffuseTilt_tendsto P hP hcal hρ hcρ)
  apply Eventually.of_forall
  intro k
  apply integral_nonneg
  intro x
  exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num)
    (hρpos x)) (transition_deriv_nonneg k _)) (Real.sqrt_nonneg _))
    (Finset.sum_nonneg fun _ _ => sq_nonneg _)

end
end Source29CoordinateTiltExcess

/- Component: CoordinateTiltBlowup.inc -/
namespace Source29CoordinateTiltBlowup

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29CoordinateTiltExcess Source29WeakCalibrationLimits
open Source29InitialPhaseFluxLimit Source29PhaseMassLimit
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def scaledWeight (ρ : (Fin (n+1) → ℝ) → ℝ) (r : ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ρ (r⁻¹ • x)

def rescaledExcess (P : MvPolynomial (Fin (n+1)) ℝ)
    (ρ : (Fin (n+1) → ℝ) → ℝ) (r : ℝ) : ℝ :=
  -(∫ x, testFlux (fun i => Pi.single i 1) ρ
    (fun y => leadingNormalizedField P (r • y)) x *
      (if 0 < eval (r • x) P then 1 else 0)) +
  ∫ x, fderiv ℝ ρ x (Pi.single 0 1) * (if 0 < eval (r • x) P then 1 else 0)

lemma testFlux_scaledWeight (ρ : (Fin (n+1) → ℝ) → ℝ)
    (Z : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ) {r : ℝ} (hr : r ≠ 0)
    (x : Fin (n+1) → ℝ) :
    r * testFlux (fun i => Pi.single i 1) (scaledWeight ρ r) Z (r • x) =
      testFlux (fun i => Pi.single i 1) ρ (fun y => Z (r • y)) x := by
  have hd : fderiv ℝ (scaledWeight ρ r) (r • x) = r⁻¹ • fderiv ℝ ρ x := by
    unfold scaledWeight
    rw [fderiv_comp_smul, smul_smul, inv_mul_cancel₀ hr, one_smul]
  simp only [testFlux, hd, _root_.smul_apply, smul_eq_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  field_simp

/-- Exact scaling of a flux pairing, valid without continuity assumptions on
the paired field or scalar function. -/
lemma flux_integral_dilate (ρ : (Fin (n+1) → ℝ) → ℝ)
    (Z : (Fin (n+1) → ℝ) → Fin (n+1) → ℝ) (b : (Fin (n+1) → ℝ) → ℝ)
    {r : ℝ} (hr : 0 < r) :
    (∫ x, testFlux (fun i => Pi.single i 1) (scaledWeight ρ r) Z x * b x) / r^n =
      ∫ x, testFlux (fun i => Pi.single i 1) ρ (fun y => Z (r • y)) x * b (r • x) := by
  let f : (Fin (n+1) → ℝ) → ℝ := fun x =>
    testFlux (fun i => Pi.single i 1) (scaledWeight ρ r) Z x * b x
  have he := Measure.integral_comp_smul_of_nonneg volume f r (hR := hr.le)
  simp only [Module.finrank_pi, Fintype.card_fin, smul_eq_mul] at he
  have halgebra (a : ℝ) : a / r^n = r * ((r^(n+1))⁻¹ * a) := by
    rw [pow_succ]
    field_simp
  change (∫ x, f x) / r^n = _
  rw [halgebra, ← he, ← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall fun x => by
    dsimp only [f]
    rw [← mul_assoc, testFlux_scaledWeight ρ Z hr.ne']

lemma testFlux_coordinate (ρ : (Fin (n+1) → ℝ) → ℝ) (x : Fin (n+1) → ℝ) :
    testFlux (fun i => Pi.single i 1) ρ (fun _ => Pi.single 0 1) x =
      fderiv ℝ ρ x (Pi.single 0 1) := by
  simp [testFlux, Pi.single_apply]

/-- The blow-up excess is precisely the original excess with a dilated
cutoff, divided by the hypersurface scaling factor. -/
theorem excess_scaledWeight (P : MvPolynomial (Fin (n+1)) ℝ)
    (ρ : (Fin (n+1) → ℝ) → ℝ) {r : ℝ} (hr : 0 < r) :
    excess P (scaledWeight ρ r) / r^n = rescaledExcess P ρ r := by
  have hA := flux_integral_dilate ρ (leadingNormalizedField P)
    (fun x => if 0 < eval x P then (1 : ℝ) else 0) hr
  have hB := flux_integral_dilate ρ (fun _ => Pi.single 0 1)
    (fun x => if 0 < eval x P then (1 : ℝ) else 0) hr
  simp only [testFlux_coordinate] at hB
  unfold excess phaseMass normalFlux rescaledExcess
  rw [sub_neg_eq_add, add_div, neg_div, hA, hB]

theorem scaledWeight_contDiff {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (r : ℝ) : ContDiff ℝ 1 (scaledWeight ρ r) :=
  hρ.comp (contDiff_id.const_smul r⁻¹)

theorem scaledWeight_compact {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hcρ : HasCompactSupport ρ) {r : ℝ} (hr : r ≠ 0) :
    HasCompactSupport (scaledWeight ρ r) :=
  hcρ.comp_homeomorph (Homeomorph.smulOfNeZero r⁻¹ (inv_ne_zero hr))

/-- At every positive scale the rescaled excess is the limit of actual
normalized diffuse squared-normal tilt integrals. -/
theorem normalized_diffuseTilt_tendsto (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {r : ℝ} (hr : 0 < r) :
    Tendsto (fun k => (∫ x, diffuseTilt P (scaledWeight ρ r) k x) / r^n)
      atTop (𝓝 (rescaledExcess P ρ r)) := by
  have ht := (diffuseTilt_tendsto P hP hcal (scaledWeight_contDiff hρ r)
    (scaledWeight_compact hcρ hr.ne')).div_const (r^n)
  rwa [excess_scaledWeight P ρ hr] at ht

theorem rescaledExcess_nonneg (P : MvPolynomial (Fin (n+1)) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) {r : ℝ} (hr : 0 < r) : 0 ≤ rescaledExcess P ρ r := by
  rw [← excess_scaledWeight P ρ hr]
  exact div_nonneg (excess_nonneg P hP hcal (scaledWeight_contDiff hρ r)
    (scaledWeight_compact hcρ hr.ne') (fun x => hρpos _)) (pow_pos hr n).le

lemma normal_integral_initial_limit (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ j < s+1, homogeneousComponent j P = 0)
    (hne : homogeneousComponent (s+1) P ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k => ∫ x, fderiv ℝ ρ x (Pi.single 0 1) *
      (if 0 < eval (t k • x) P then 1 else 0)) atTop
      (𝓝 (∫ x, fderiv ℝ ρ x (Pi.single 0 1) *
        (if 0 < eval x (homogeneousComponent (s+1) P) then 1 else 0))) := by
  have hi : Integrable (fun x => fderiv ℝ ρ x (Pi.single 0 1)) :=
    ((hρ.continuous_fderiv (by norm_num)).clm_apply continuous_const).integrable_of_hasCompactSupport
      (hcρ.fderiv_apply ℝ (Pi.single 0 1))
  apply tendsto_integral_of_dominated_convergence (fun x => ‖fderiv ℝ ρ x (Pi.single 0 1)‖)
  · intro k
    exact hi.aestronglyMeasurable.mul (scaled_phase_measurable P (t k)).aestronglyMeasurable
  · exact hi.norm
  · intro k
    exact Eventually.of_forall fun x => by
      rw [norm_mul]
      split_ifs <;> simp
  · filter_upwards [mvPolynomial_eval_ne_zero_ae (n+1) _ hne] with x hx
    exact tendsto_const_nhds.mul (scaled_phase_initial_limit P s hlow ht ht0 x hx)

/-- Polynomial blow-ups carry the excess to that of their first homogeneous
term. The proof uses actual phase and normalized-gradient convergence. -/
theorem rescaledExcess_initial_limit (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ j < s+1, homogeneousComponent j P = 0)
    (hne : homogeneousComponent (s+1) P ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k => rescaledExcess P ρ (t k)) atTop
      (𝓝 (excess (homogeneousComponent (s+1) P) ρ)) := by
  have hA := phaseFlux_initial_limit P s hlow hne ht ht0 hρ hcρ
  have hB := normal_integral_initial_limit P s hlow hne ht ht0 hρ hcρ
  simpa only [rescaledExcess, excess, normalFlux, sub_neg_eq_add] using hA.add hB

theorem excess_positive_odd_normal_power (c : ℝ) (hc : 0 < c) (d : ℕ) (hd : Odd d)
    (ρ : (Fin (n+1) → ℝ) → ℝ) :
    excess (C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^d) ρ = 0 := by
  unfold excess phaseMass normalFlux
  have he : (∫ x, testFlux (fun i => Pi.single i 1) ρ
      (leadingNormalizedField (C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^d)) x *
        (if 0 < eval x (C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^d) then 1 else 0)) =
      ∫ x, fderiv ℝ ρ x (Pi.single 0 1) *
        (if 0 < eval x (C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^d) then 1 else 0) := by
    apply integral_congr_ae
    filter_upwards [mvPolynomial_eval_ne_zero_ae (n+1)
      (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) (X_ne_zero 0)] with x hx
    have hn : leadingNormalizedField (C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^d) x =
        Pi.single 0 1 := by
      funext i
      rw [Source29OddPowerNormalizedField.normalizedField_C_pow_pos _ hc hd x hx,
        Source29CoordinatePhaseMass.normalizedField_X]
    simp only [testFlux, hn]
    simp [Pi.single_apply]
  rw [he, sub_self]

/-- A positive odd normal-power initial form has vanishing averaged tilt
under every sequence of positive blow-up scales tending to zero. -/
theorem rescaledExcess_tendsto_zero (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ j < s+1, homogeneousComponent j P = 0)
    (c : ℝ) (hc : 0 < c) (hd : Odd (s+1))
    (hinit : homogeneousComponent (s+1) P = C c * (X 0)^ (s+1))
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k => rescaledExcess P ρ (t k)) atTop (𝓝 0) := by
  have hne : homogeneousComponent (s+1) P ≠ 0 := by
    rw [hinit]
    exact mul_ne_zero (C_ne_zero.mpr hc.ne') (pow_ne_zero _ (X_ne_zero 0))
  have ht' := rescaledExcess_initial_limit P s hlow hne ht ht0 hρ hcρ
  rwa [hinit, excess_positive_odd_normal_power c hc (s+1) hd ρ] at ht'

/-- The sequential blow-up statement gives the full one-sided small-radius
limit, so no prescribed sequence of scales is required. -/
theorem rescaledExcess_tendsto_zero_right (P : MvPolynomial (Fin (n+1)) ℝ) (s : ℕ)
    (hlow : ∀ j < s+1, homogeneousComponent j P = 0)
    (c : ℝ) (hc : 0 < c) (hd : Odd (s+1))
    (hinit : homogeneousComponent (s+1) P = C c * (X 0)^ (s+1))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (rescaledExcess P ρ) (𝓝[>] (0 : ℝ)) (𝓝 0) := by
  apply Filter.tendsto_of_seq_tendsto
  intro t ht
  have ht0 : Tendsto t atTop (𝓝 (0 : ℝ)) := ht.mono_right inf_le_left
  have htpos : ∀ᶠ k in atTop, 0 < t k := ht.eventually self_mem_nhdsWithin
  let u : ℕ → ℝ := fun k => if 0 < t k then t k else 1
  have hu (k : ℕ) : 0 < u k := by
    dsimp only [u]
    split_ifs with h
    · exact h
    · norm_num
  have he : u =ᶠ[atTop] t := htpos.mono fun k hk => by simp only [u, ite_eq_left hk]
  have hu0 : Tendsto u atTop (𝓝 (0 : ℝ)) := (tendsto_congr' he).mpr ht0
  have hl := rescaledExcess_tendsto_zero P s hlow c hc hd hinit hu hu0 hρ hcρ
  apply hl.congr'
  filter_upwards [he] with k hk
  simp only [Function.comp_apply, hk]

/-- Flat initial data give arbitrarily small averaged squared tilt: first
choose a sufficiently small spatial scale, then take a sufficiently sharp
phase transition. No smoothness of the zero set is used. -/
theorem eventually_small_normalized_diffuseTilt
    (P : MvPolynomial (Fin (n+1)) ℝ) (hcal : WeakCalibration (leadingNormalizedField P))
    (s : ℕ) (hlow : ∀ j < s+1, homogeneousComponent j P = 0)
    (c : ℝ) (hc : 0 < c) (hd : Odd (s+1))
    (hinit : homogeneousComponent (s+1) P = C c * (X 0)^ (s+1))
    {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ r in 𝓝[>] (0 : ℝ), ∀ᶠ k in atTop,
      0 ≤ (∫ x, diffuseTilt P (scaledWeight ρ r) k x) / r^n ∧
        (∫ x, diffuseTilt P (scaledWeight ρ r) k x) / r^n < ε := by
  have hne : P ≠ 0 := by
    intro hp
    have hcz : C c * (X 0 : MvPolynomial (Fin (n+1)) ℝ)^(s+1) = 0 := by
      rw [← hinit, hp, map_zero]
    exact (mul_ne_zero (C_ne_zero.mpr hc.ne') (pow_ne_zero _ (X_ne_zero 0))) hcz
  have hl := rescaledExcess_tendsto_zero_right P s hlow c hc hd hinit hρ hcρ
  filter_upwards [self_mem_nhdsWithin, hl.eventually (eventually_lt_nhds hε)] with r hr hsmall
  have hrd : 0 < r := hr
  have ht := normalized_diffuseTilt_tendsto P hne hcal hρ hcρ hrd
  filter_upwards [ht.eventually (eventually_lt_nhds hsmall)] with k hk
  refine ⟨div_nonneg ?_ (pow_pos hrd n).le, hk⟩
  apply integral_nonneg
  intro x
  unfold diffuseTilt scaledWeight normalDeviation
  exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num)
    (hρpos _)) (Source29SmoothPhaseTransition.transition_deriv_nonneg k _))
    (Real.sqrt_nonneg _)) (Finset.sum_nonneg fun _ _ => sq_nonneg _)

end
end Source29CoordinateTiltBlowup

/- Component: ConicalPhaseComponents.inc -/
namespace Source29ConicalPhaseComponents

open Set Filter MvPolynomial
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Invariance under positive dilations, with no convexity assumption. -/
def IsPositiveCone (S : Set E) : Prop :=
  ∀ t : ℝ, 0 < t → ∀ x ∈ S, t • x ∈ S

/-- The full positive ray stays in the same connected component. -/
theorem positive_smul_mem_component {S : Set E} (hcone : IsPositiveCone S)
    {x : E} (hx : x ∈ S) {t : ℝ} (ht : 0 < t) :
    t • x ∈ connectedComponentIn S x := by
  have hp : IsPreconnected ((fun r : ℝ => r • x) '' Ioi 0) :=
    isPreconnected_Ioi.image _ (by fun_prop)
  have hxray : x ∈ (fun r : ℝ => r • x) '' Ioi 0 :=
    ⟨1, by norm_num, one_smul ℝ x⟩
  apply hp.subset_connectedComponentIn hxray ?_ ⟨t, ht, rfl⟩
  rintro _ ⟨r, hr, rfl⟩
  exact hcone r hr x hx

/-- Every connected component of a cone is itself a cone. -/
theorem component_isPositiveCone {S : Set E} (hcone : IsPositiveCone S) (x : E) :
    IsPositiveCone (connectedComponentIn S x) := by
  intro t ht y hy
  have hys : y ∈ S := connectedComponentIn_subset S x hy
  have hr := positive_smul_mem_component hcone hys ht
  rwa [← connectedComponentIn_eq hy] at hr

/-- Positive dilation maps each component onto itself. -/
theorem image_smul_component {S : Set E} (hcone : IsPositiveCone S) (x : E)
    {t : ℝ} (ht : 0 < t) :
    (fun y => t • y) '' connectedComponentIn S x = connectedComponentIn S x := by
  have hc := component_isPositiveCone hcone x
  apply Set.Subset.antisymm
  · rintro _ ⟨y, hy, rfl⟩
    exact hc t ht y hy
  · intro y hy
    refine ⟨t⁻¹ • y, hc t⁻¹ (inv_pos.mpr ht) y hy, ?_⟩
    change t • (t⁻¹ • y) = y
    rw [smul_smul, mul_inv_cancel₀ ht.ne', one_smul]

/-- Every nonempty cone component accumulates at the vertex. -/
theorem zero_mem_closure_component {S : Set E} (hcone : IsPositiveCone S)
    {x : E} (hx : x ∈ S) : 0 ∈ closure (connectedComponentIn S x) := by
  let r : ℕ → ℝ := fun k => (Source29QuarticReuse.FluxPolynomial.dilationRadius k)⁻¹
  have hr : Tendsto r atTop (𝓝 0) := tendsto_inv_atTop_zero.comp
    Source29QuarticReuse.FluxPolynomial.dilationRadius_tendsto
  have hl : Tendsto (fun k => r k • x) atTop (𝓝 (0 : E)) := by
    have hxlim : Tendsto (fun _ : ℕ => x) atTop (𝓝 x) := tendsto_const_nhds
    simpa only [zero_smul] using hr.smul hxlim
  apply mem_closure_of_tendsto hl
  apply Filter.Eventually.of_forall
  intro k
  exact positive_smul_mem_component hcone hx
    (inv_pos.mpr (Source29QuarticReuse.FluxPolynomial.dilationRadius_pos k))

/-- There are no bounded nonempty components of a cone that omits its vertex. -/
theorem component_not_bounded {S : Set E} (hcone : IsPositiveCone S)
    (hzero : (0 : E) ∉ S) {x : E} (hx : x ∈ S) :
    ¬ Bornology.IsBounded (connectedComponentIn S x) := by
  intro hb
  obtain ⟨M, hM⟩ := hb.exists_norm_le
  have hxne : x ≠ 0 := fun h => hzero (h ▸ hx)
  have hnx : 0 < ‖x‖ := norm_pos_iff.mpr hxne
  let t : ℝ := (|M| + 1) / ‖x‖
  have ht : 0 < t := div_pos (by positivity) hnx
  have hbound := hM (t • x) (positive_smul_mem_component hcone hx ht)
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht, show t * ‖x‖ = |M| + 1 by
    exact div_mul_cancel₀ _ hnx.ne'] at hbound
  linarith [le_abs_self M]

/-- Radial normalization realizes the unit link as a continuous image. -/
theorem normalized_image_eq_link {S : Set E} (hcone : IsPositiveCone S)
    (hzero : (0 : E) ∉ S) :
    (fun x => ‖x‖⁻¹ • x) '' S = S ∩ {x | ‖x‖ = 1} := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hn : 0 < ‖x‖ := norm_pos_iff.mpr (fun h => hzero (h ▸ hx))
    refine ⟨hcone _ (inv_pos.mpr hn) x hx, ?_⟩
    change ‖‖x‖⁻¹ • x‖ = 1
    rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hn, inv_mul_cancel₀ hn.ne']
  · rintro ⟨hy, hn⟩
    refine ⟨y, hy, ?_⟩
    change ‖y‖ = 1 at hn
    change ‖y‖⁻¹ • y = y
    rw [hn, inv_one, one_smul]

/-- Cone connectedness is exactly connectedness of its unit link. -/
theorem isPreconnected_iff_link {S : Set E} (hcone : IsPositiveCone S)
    (hzero : (0 : E) ∉ S) :
    IsPreconnected S ↔ IsPreconnected (S ∩ {x | ‖x‖ = 1}) := by
  constructor
  · intro hS
    rw [← normalized_image_eq_link hcone hzero]
    apply hS.image
    intro x hx
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr (fun h => hzero (h ▸ hx))
    exact ((continuous_norm.continuousAt.inv₀ hn).smul continuousAt_id).continuousWithinAt
  · intro hlink
    have hp : IsPreconnected ((Ioi 0 : Set ℝ) ×ˢ (S ∩ {x | ‖x‖ = 1})) :=
      isPreconnected_Ioi.prod hlink
    have himage : (fun p : ℝ × E => p.1 • p.2) ''
        ((Ioi 0 : Set ℝ) ×ˢ (S ∩ {x | ‖x‖ = 1})) = S := by
      apply Set.Subset.antisymm
      · rintro _ ⟨⟨t, x⟩, ⟨ht, hx, _⟩, rfl⟩
        exact hcone t ht x hx
      · intro x hx
        have hn : 0 < ‖x‖ := norm_pos_iff.mpr (fun h => hzero (h ▸ hx))
        refine ⟨(‖x‖, ‖x‖⁻¹ • x), ⟨hn, ?_⟩, ?_⟩
        · rw [← normalized_image_eq_link hcone hzero]
          exact ⟨x, hx, rfl⟩
        · change ‖x‖ • (‖x‖⁻¹ • x) = x
          rw [smul_smul, mul_inv_cancel₀ hn.ne', one_smul]
    rw [← himage]
    exact hp.image _ (by fun_prop)

/-- In particular, every connected cone component has a connected unit link. -/
theorem component_link_isPreconnected {S : Set E} (hcone : IsPositiveCone S)
    (hzero : (0 : E) ∉ S) (x : E) :
    IsPreconnected (connectedComponentIn S x ∩ {y | ‖y‖ = 1}) := by
  apply (isPreconnected_iff_link (component_isPositiveCone hcone x) ?_).mp
    isPreconnected_connectedComponentIn
  intro hz
  exact hzero (connectedComponentIn_subset S x hz)

/-- Both strict sign regions of a homogeneous polynomial are positive cones. -/
theorem homogeneous_sign_regions_are_cones {n d : ℕ}
    (H : MvPolynomial (Fin n) ℝ) (hH : H.IsHomogeneous d) :
    IsPositiveCone {x | 0 < eval x H} ∧ IsPositiveCone {x | eval x H < 0} := by
  constructor
  · intro t ht x hx
    change 0 < eval (t • x) H
    rw [Source29QuarticReuse.FluxObstruction.eval_dilate_homogeneous H hH]
    exact mul_pos (pow_pos ht d) hx
  · intro t ht x hx
    change eval (t • x) H < 0
    rw [Source29QuarticReuse.FluxObstruction.eval_dilate_homogeneous H hH]
    exact mul_neg_of_pos_of_neg (pow_pos ht d) hx

end
end Source29ConicalPhaseComponents

/- Component: NormalHasseCentering.inc -/
namespace Source29NormalHasseCentering

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonShiftedFactorCoefficient
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The normal Hasse derivative is the normal iterated derivative divided by its factorial. -/
def normalHasse (j : ℕ) (F : MvPolynomial (Fin (n+1)) ℝ) :
    MvPolynomial (Fin (n+1)) ℝ :=
  (finSuccEquiv ℝ n).symm (Polynomial.hasseDeriv j (finSuccEquiv ℝ n F))

lemma sliceHom_normalHasse (j : ℕ) (F : MvPolynomial (Fin (n+1)) ℝ)
    (y : Fin n → ℝ) :
    sliceHom y (normalHasse j F) = Polynomial.hasseDeriv j (sliceHom y F) := by
  change ((finSuccEquiv ℝ n) ((finSuccEquiv ℝ n).symm _)).map (eval y) = _
  rw [AlgEquiv.apply_symm_apply]
  exact (Polynomial.hasseDeriv_map (eval y) j (finSuccEquiv ℝ n F)).symm

/-- The translated normal coefficient is evaluation of a fixed polynomial. -/
theorem shiftedSlice_coeff_eq_eval_normalHasse (F : MvPolynomial (Fin (n+1)) ℝ)
    (j : ℕ) (s : ℝ) (y : Fin n → ℝ) :
    (shiftedSlice F s y).coeff j = eval (Fin.cons s y) (normalHasse j F) := by
  rw [shiftedSlice, Polynomial.taylor_coeff, ← sliceHom_normalHasse, eval_sliceHom]

lemma coeff_normalHasse_cons (F : MvPolynomial (Fin (n+1)) ℝ)
    (j k : ℕ) (m : Fin n →₀ ℕ) :
    (normalHasse j F).coeff (m.cons k) =
      ((k+j).choose j : ℝ) * F.coeff (m.cons (k+j)) := by
  rw [← finSuccEquiv_coeff_coeff, normalHasse, AlgEquiv.apply_symm_apply,
    Polynomial.hasseDeriv_coeff]
  have hc : ((k+j).choose j : MvPolynomial (Fin n) ℝ) = C ((k+j).choose j : ℝ) := by simp
  rw [hc, coeff_C_mul, finSuccEquiv_coeff_coeff]

lemma eval_zero_pderiv (F : MvPolynomial (Fin (n+1)) ℝ) (i : Fin (n+1)) :
    eval (0 : Fin (n+1) → ℝ) (pderiv i F) = F.coeff (Finsupp.single i 1) := by
  simp [eval_zero, constantCoeff_eq, coeff_pderiv]

lemma coeff_eq_zero_of_lower_component (F : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (m : Fin (n+1) →₀ ℕ) (hm : m.degree < d) : F.coeff m = 0 := by
  have he := congrArg (fun Q : MvPolynomial (Fin (n+1)) ℝ => Q.coeff m) (hlow m.degree hm)
  simpa [coeff_homogeneousComponent] using he

lemma coeff_eq_of_initial (F : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (c : ℝ) (hpure : homogeneousComponent d F = C c * (X 0)^d)
    (m : Fin (n+1) →₀ ℕ) (hm : m.degree = d) :
    F.coeff m = c * (if Finsupp.single 0 d = m then 1 else 0) := by
  have he := congrArg (fun Q : MvPolynomial (Fin (n+1)) ℝ => Q.coeff m) hpure
  simpa only [coeff_homogeneousComponent, hm, eq_self_iff_true, ite_true, coeff_C_mul, coeff_X_pow] using he

lemma normalHasse_initial_jets (F : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (hd : 0 < d) (c : ℝ)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    eval (0 : Fin (n+1) → ℝ) (normalHasse (d-1) F) = 0 ∧
    eval (0 : Fin (n+1) → ℝ) (pderiv 0 (normalHasse (d-1) F)) = (d : ℝ)*c ∧
    ∀ i : Fin n, eval (0 : Fin (n+1) → ℝ)
      (pderiv i.succ (normalHasse (d-1) F)) = 0 := by
  have hd1 : 1+(d-1) = d := by omega
  constructor
  · rw [eval_zero, constantCoeff_eq, ← Finsupp.cons_zero_zero (n := n), coeff_normalHasse_cons]
    have hz : F.coeff ((0 : Fin n →₀ ℕ).cons (0+(d-1))) = 0 := by
      apply coeff_eq_zero_of_lower_component F d hlow
      simp only [Finsupp.cons_zero_eq_single_zero, Finsupp.degree_single]
      omega
    rw [hz, mul_zero]
  constructor
  · rw [eval_zero_pderiv, ← Finsupp.cons_zero_eq_single_zero (y := 1),
      coeff_normalHasse_cons, hd1]
    have hm : ((0 : Fin n →₀ ℕ).cons d).degree = d := by
      simp only [Finsupp.cons_zero_eq_single_zero, Finsupp.degree_single]
    rw [coeff_eq_of_initial F d c hpure _ hm]
    simp only [Finsupp.cons_zero_eq_single_zero, ite_true, mul_one]
    rw [Nat.choose_symm (by omega : 1 ≤ d), Nat.choose_one_right]
  · intro i
    rw [eval_zero_pderiv, ← Finsupp.cons_zero_single_eq_single_succ,
      coeff_normalHasse_cons]
    have hm : ((Finsupp.single i 1).cons (0+(d-1))).degree = d := by
      have he : (Finsupp.single i 1).cons (0+(d-1)) =
          Finsupp.single 0 (d-1) + Finsupp.single i.succ 1 := by
        ext j
        cases j using Fin.cases <;> simp [Finsupp.single_apply]
      rw [he, map_add, Finsupp.degree_single, Finsupp.degree_single]
      omega
    have hne : Finsupp.single 0 d ≠ (Finsupp.single i 1).cons (0+(d-1)) := by
      intro he
      have h := congrArg (fun m : Fin (n+1) →₀ ℕ => m i.succ) he
      simp [Fin.succ_ne_zero] at h
    rw [coeff_eq_of_initial F d c hpure _ hm, ite_eq_right hne, mul_zero, mul_zero]

/-- A pure nonzero normal initial term admits an analytic flat centering
that kills the penultimate normal coefficient. No minimality of the center is assumed. -/
theorem exists_flat_centering (F : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    ∃ g : (Fin n → ℝ) → ℝ, AnalyticAt ℝ g 0 ∧ g 0 = 0 ∧
      Source29NormalShiftDerivatives.gradient g 0 = 0 ∧ fderiv ℝ g 0 = 0 ∧
      (∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (d-1) = 0) := by
  obtain ⟨hA0, hAn, hAt⟩ := normalHasse_initial_jets F d hd c hlow hpure
  have hAn0 : eval (0 : Fin (n+1) → ℝ) (pderiv 0 (normalHasse (d-1) F)) ≠ 0 := by
    rw [hAn]
    exact mul_ne_zero (by exact_mod_cast (Nat.ne_of_gt hd)) hc
  obtain ⟨g, hg, hg0, hggrad, hgD, hroot⟩ :=
    Source29FlatRegularGraph.exists_flat_local_graph (normalHasse (d-1) F) hA0 hAn0 hAt
  refine ⟨g, hg, hg0, hggrad, hgD, ?_⟩
  filter_upwards [hroot] with y hy
  rwa [shiftedSlice_coeff_eq_eval_normalHasse]

end
end Source29NormalHasseCentering

/- Component: OddCriticalPolynomial.inc -/
namespace Source29OddCriticalPolynomial

open Polynomial Filter Set Asymptotics
open scoped Topology

noncomputable section

private lemma no_positive_between_roots (p : ℝ[X])
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    {a b z : ℝ} (ha : p.eval a = 0) (hb : p.eval b = 0)
    (hz : z ∈ Ioo a b) (hpz : 0 < p.eval z) : False := by
  obtain ⟨c,hc,hmax⟩ := (isCompact_Icc : IsCompact (Icc a b)).exists_isMaxOn
    ⟨a, by exact ⟨le_rfl,(lt_trans hz.1 hz.2).le⟩⟩ p.continuous.continuousOn
  have hpc : 0 < p.eval c := hpz.trans_le (hmax ⟨hz.1.le,hz.2.le⟩)
  have hac : a < c := lt_of_le_of_ne hc.1 (by intro h; subst c; simp [ha] at hpc)
  have hcb : c < b := lt_of_le_of_ne hc.2 (by intro h; subst c; simp [hb] at hpc)
  have hder : deriv (fun x => p.eval x) c = 0 :=
    (hmax.isLocalMax (Icc_mem_nhds hac hcb)).deriv_eq_zero
  exact hreg c hpc.ne' (by simpa only [p.deriv] using hder)

/-- A nonzero real polynomial whose critical values are all zero has at
most one real zero. This statement does not require an odd degree. -/
theorem root_unique (p : ℝ[X]) (hp : p ≠ 0)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    {a b : ℝ} (ha : p.eval a = 0) (hb : p.eval b = 0) : a = b := by
  have hcontra {a b : ℝ} (hab : a < b) (ha : p.eval a = 0) (hb : p.eval b = 0) : False := by
    obtain ⟨z,hz,hpz⟩ := Source29PolynomialPhaseRoot.exists_eval_ne_zero_in_interval p hp hab
    rcases lt_or_gt_of_ne hpz with hn | hpz
    · apply no_positive_between_roots (-p) ?_ (by simpa using ha) (by simpa using hb) hz
        (by simpa using neg_pos.mpr hn)
      intro x hx hder
      apply hreg x (by simpa using hx)
      simpa using hder
    · exact no_positive_between_roots p hreg ha hb hz hpz
  rcases lt_trichotomy a b with hab | hab | hab
  · exact (hcontra hab ha hb).elim
  · exact hab
  · exact (hcontra hab hb ha).elim

private lemma signs_at_unique_root (p : ℝ[X]) (hp : p ≠ 0)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    (htop : Tendsto p.eval atTop atTop) (hbot : Tendsto p.eval atBot atBot)
    {a : ℝ} (ha : p.eval a = 0) :
    (∀ x, x < a → p.eval x < 0) ∧ (∀ x, a < x → 0 < p.eval x) := by
  constructor
  · intro x hx
    have hne : p.eval x ≠ 0 := fun hz => hx.ne (root_unique p hp hreg hz ha)
    apply lt_of_le_of_ne ?_ hne
    by_contra! hpos
    obtain ⟨b,hbx,hpb⟩ := ((eventually_lt_atBot x).and
      (hbot.eventually (eventually_lt_atBot (0 : ℝ)))).exists
    obtain ⟨z,hz,hpz⟩ := intermediate_value_Icc hbx.le p.continuous.continuousOn
      (show 0 ∈ Icc (p.eval b) (p.eval x) from ⟨hpb.le,hpos.le⟩)
    have hza : z = a := root_unique p hp hreg hpz ha
    rw [hza] at hz
    exact (not_le_of_gt hx) hz.2
  · intro x hx
    have hne : p.eval x ≠ 0 := fun hz => hx.ne' (root_unique p hp hreg hz ha)
    apply lt_of_le_of_ne ?_ hne.symm
    by_contra! hneg
    obtain ⟨b,hxb,hpb⟩ := ((eventually_gt_atTop x).and
      (htop.eventually (eventually_gt_atTop (0 : ℝ)))).exists
    obtain ⟨z,hz,hpz⟩ := intermediate_value_Icc hxb.le p.continuous.continuousOn
      (show 0 ∈ Icc (p.eval x) (p.eval b) from ⟨hneg.le,hpb.le⟩)
    have hza : z = a := root_unique p hp hreg hpz ha
    rw [hza] at hz
    exact (not_le_of_gt hx) hz.1

/-- With opposite infinite ends, the restriction on critical values forces
global injectivity, including at the possibly multiple zero. -/
theorem injective_of_opposite_ends (p : ℝ[X]) (hp : p ≠ 0)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    (htop : Tendsto p.eval atTop atTop) (hbot : Tendsto p.eval atBot atBot) :
    Function.Injective p.eval := by
  have hcontra {a b : ℝ} (hab : a < b) (he : p.eval a = p.eval b) : False := by
    obtain ⟨c,hc,hder⟩ := exists_deriv_eq_zero hab p.continuous.continuousOn he
    have hpc : p.eval c = 0 := by
      by_contra hn
      exact hreg c hn (by simpa only [p.deriv] using hder)
    obtain ⟨hleft,hright⟩ := signs_at_unique_root p hp hreg htop hbot hpc
    have hl := hleft a hc.1
    have hr := hright b hc.2
    rw [he] at hl
    exact (not_lt_of_ge hr.le) hl
  intro a b he
  rcases lt_trichotomy a b with hab | hab | hab
  · exact (hcontra hab he).elim
  · exact hab
  · exact (hcontra hab he.symm).elim

theorem strictMono_of_opposite_ends (p : ℝ[X]) (hp : p ≠ 0)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0)
    (htop : Tendsto p.eval atTop atTop) (hbot : Tendsto p.eval atBot atBot) :
    StrictMono p.eval := by
  rcases p.continuous.strictMono_of_inj (injective_of_opposite_ends p hp hreg htop hbot) with hm | hm
  · exact hm
  · obtain ⟨b,hb,hpb⟩ := ((eventually_gt_atTop (0 : ℝ)).and
      (htop.eventually (eventually_gt_atTop (p.eval 0)))).exists
    exact ((not_lt_of_ge hpb.le) (hm hb)).elim

private lemma pow_littleO_pow {i d : ℕ} (hid : i < d) :
    (fun x : ℝ => x^i) =o[atTop] (fun x : ℝ => x^d) := by
  have hz : ∀ᶠ x : ℝ in atTop, x^d = 0 → x^i = 0 := by
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
    exact fun h => (pow_ne_zero d hx.ne' h).elim
  apply (isLittleO_iff_tendsto' hz).mpr
  have ht := (tendsto_inv_atTop_zero : Tendsto (fun x : ℝ => x⁻¹) atTop (𝓝 0)).pow (d-i)
  rw [zero_pow (by omega : d-i ≠ 0)] at ht
  apply ht.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
  have hpow : x^d = x^i * x^(d-i) := by rw [← pow_add, Nat.add_sub_of_le hid.le]
  rw [hpow, inv_pow]
  field_simp

private lemma eval_equivalent_leading (p : ℝ[X]) :
    p.eval ~[atTop] (fun x => p.leadingCoeff * x^p.natDegree) := by
  by_cases hp : p = 0
  · simp [hp, IsEquivalent.refl]
  · simp only [Polynomial.eval_eq_sum_range, Finset.sum_range_succ]
    exact IsLittleO.add_isEquivalent
      (IsLittleO.fun_sum fun i hi =>
        ((pow_littleO_pow (Finset.mem_range.mp hi)).const_mul_right
          (leadingCoeff_ne_zero.mpr hp)).const_mul_left (p.coeff i)) IsEquivalent.refl

theorem eval_tendsto_atTop (p : ℝ[X]) (hd : 0 < p.natDegree) (hc : 0 < p.leadingCoeff) :
    Tendsto p.eval atTop atTop :=
  (eval_equivalent_leading p).symm.tendsto_atTop (tendsto_const_mul_pow_atTop hd.ne' hc)

theorem eval_tendsto_atBot_of_odd (p : ℝ[X]) (hd : Odd p.natDegree)
    (hc : 0 < p.leadingCoeff) : Tendsto p.eval atBot atBot := by
  let q : ℝ[X] := -(p.comp (-X))
  have hqd : q.natDegree = p.natDegree := by simp [q, Polynomial.natDegree_comp]
  have hqc : q.leadingCoeff = p.leadingCoeff := by
    simp only [q, Polynomial.leadingCoeff_neg]
    rw [Polynomial.leadingCoeff_comp (by simp), Polynomial.leadingCoeff_neg,
      Polynomial.leadingCoeff_X, hd.neg_one_pow]
    ring
  have ht := eval_tendsto_atTop q (by rw [hqd]; exact hd.pos) (by rw [hqc]; exact hc)
  have hb := (tendsto_neg_atTop_atBot.comp ht).comp tendsto_neg_atBot_atTop
  simpa only [q, Function.comp_def, Polynomial.eval_neg, Polynomial.eval_comp,
    Polynomial.eval_X, neg_neg] using hb

/-- An odd-degree polynomial with positive leading coefficient is strictly
increasing when every nonzero value is regular. -/
theorem strictMono_of_odd (p : ℝ[X]) (hd : Odd p.natDegree) (hc : 0 < p.leadingCoeff)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0) : StrictMono p.eval := by
  exact strictMono_of_opposite_ends p (leadingCoeff_ne_zero.mp hc.ne') hreg
    (eval_tendsto_atTop p hd.pos hc) (eval_tendsto_atBot_of_odd p hd hc)

/-- Every real level has exactly one real preimage. Its derivative is nonzero
on every nonzero level. No phase-sign assumptions are required. -/
theorem existsUnique_level_root (p : ℝ[X]) (hd : Odd p.natDegree) (hc : 0 < p.leadingCoeff)
    (hreg : ∀ x, p.eval x ≠ 0 → p.derivative.eval x ≠ 0) (t : ℝ) :
    ∃! x : ℝ, p.eval x = t := by
  obtain ⟨x,hx⟩ := p.continuous.surjective
    (eval_tendsto_atTop p hd.pos hc) (eval_tendsto_atBot_of_odd p hd hc) t
  exact ⟨x,hx,fun y hy => (strictMono_of_odd p hd hc hreg).injective (hy.trans hx.symm)⟩

end
end Source29OddCriticalPolynomial

/- Component: NewtonOrderedRoot.inc -/
namespace Source29NewtonOrderedRoot

open MvPolynomial Filter
open Source29NewtonNormalDerivative Source29NewtonPositiveRoot Source29NewtonRootHarmonic
open Source29QuarticReuse.FluxObstruction
open scoped Topology

noncomputable section
variable {n : ℕ}

lemma slice_natDegree (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (c : ℝ)
    (hc : c ≠ 0) (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    (sliceHom y N).natDegree = d := by
  apply le_antisymm
  · exact (Polynomial.natDegree_map_le).trans hdegree
  · apply Polynomial.le_natDegree_of_ne_zero
    rw [slice_coefficient N d c hcoeff y]
    exact hc

lemma slice_leadingCoeff (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (c : ℝ)
    (hc : c ≠ 0) (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    (sliceHom y N).leadingCoeff = c := by
  change (sliceHom y N).coeff (sliceHom y N).natDegree = c
  rw [slice_natDegree N d c hc hdegree hcoeff y, slice_coefficient N d c hcoeff y]

/-- Every normal slice is strictly increasing, without any prescribed phase signs. -/
theorem strictMono_slice
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    StrictMono (fun x => eval (Fin.cons x y) N) := by
  have hr : ∀ x, (sliceHom y N).eval x ≠ 0 → (sliceHom y N).derivative.eval x ≠ 0 := by
    intro x hx
    rw [← sliceHom_pderiv_zero, eval_sliceHom]
    apply normal_derivative_ne_zero_of_constant_coefficient N α D hD hEuler hE d hd.pos c hc.ne' hcoeff
    rwa [eval_sliceHom] at hx
  simpa only [eval_sliceHom] using Source29OddCriticalPolynomial.strictMono_of_odd (sliceHom y N)
    (by rw [slice_natDegree N d c hc.ne' hdegree hcoeff y]; exact hd)
    (by rw [slice_leadingCoeff N d c hc.ne' hdegree hcoeff y]; exact hc) hr

theorem surjective_slice
    (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c) (y : Fin n → ℝ) :
    Function.Surjective (fun x => eval (Fin.cons x y) N) := by
  have hdeg : Odd (sliceHom y N).natDegree := by
    rw [slice_natDegree N d c hc.ne' hdegree hcoeff y]; exact hd
  have hlead : 0 < (sliceHom y N).leadingCoeff := by
    rw [slice_leadingCoeff N d c hc.ne' hdegree hcoeff y]; exact hc
  simpa only [eval_sliceHom] using (sliceHom y N).continuous.surjective
    (Source29OddCriticalPolynomial.eval_tendsto_atTop _ hdeg.pos hlead)
    (Source29OddCriticalPolynomial.eval_tendsto_atBot_of_odd _ hdeg hlead)

/-- Unrestricted real inverse level, with a harmless fallback when no root exists. -/
def levelRoot (N : MvPolynomial (Fin (n+1)) ℝ) (t : ℝ) (y : Fin n → ℝ) : ℝ := by
  classical
  exact if h : ∃ x, eval (Fin.cons x y) N = t then Classical.choose h else 0

lemma levelRoot_spec (N : MvPolynomial (Fin (n+1)) ℝ) (t : ℝ) (y : Fin n → ℝ)
    (hsurj : Function.Surjective (fun x => eval (Fin.cons x y) N)) :
    eval (Fin.cons (levelRoot N t y) y) N = t := by
  simpa only [levelRoot, dite_eq_left (hsurj t)] using Classical.choose_spec (hsurj t)

lemma levelRoot_eq_of_root (N : MvPolynomial (Fin (n+1)) ℝ) (t : ℝ) (y : Fin n → ℝ)
    (hmono : StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : Function.Surjective (fun x => eval (Fin.cons x y) N))
    {x : ℝ} (hx : eval (Fin.cons x y) N = t) : levelRoot N t y = x :=
  hmono.injective ((levelRoot_spec N t y hsurj).trans hx.symm)

lemma levelRoot_lt (N : MvPolynomial (Fin (n+1)) ℝ) (s t : ℝ) (y : Fin n → ℝ)
    (hmono : StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : Function.Surjective (fun x => eval (Fin.cons x y) N)) (hst : s < t) :
    levelRoot N s y < levelRoot N t y := by
  apply hmono.lt_iff_lt.mp
  rwa [levelRoot_spec N s y hsurj, levelRoot_spec N t y hsurj]

/-- Off the zero level, local implicit branches agree with the globally unique root. -/
theorem analyticAt_levelRoot (N : MvPolynomial (Fin (n+1)) ℝ)
    (hmono : ∀ y, StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : ∀ y, Function.Surjective (fun x => eval (Fin.cons x y) N))
    (hreg : ∀ z, eval z N ≠ 0 → eval z (pderiv 0 N) ≠ 0)
    (t : ℝ) (ht : t ≠ 0) (y : Fin n → ℝ) : AnalyticAt ℝ (levelRoot N t) y := by
  have hs := levelRoot_spec N t y (hsurj y)
  have hn := hreg (Fin.cons (levelRoot N t y) y) (by rwa [hs])
  obtain ⟨g,hg,hgy,hroot⟩ := Source29RealImplicitPolynomialRoot.exists_local_level_graph N
    (Fin.cons (levelRoot N t y) y) hn
  simp only [Fin.cons_succ, Fin.cons_zero] at hg hgy hroot
  rw [hs] at hroot
  apply hg.congr
  filter_upwards [hroot] with v hv
  exact (levelRoot_eq_of_root N t v (hmono v) (hsurj v) hv).symm

/-- Each nonzero inverse level is an entire real harmonic graph. -/
theorem levelRoot_divergence_eq_zero (N : MvPolynomial (Fin (n+1)) ℝ)
    (hE : newtonResidual N = 0)
    (hmono : ∀ y, StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : ∀ y, Function.Surjective (fun x => eval (Fin.cons x y) N))
    (hreg : ∀ z, eval z N ≠ 0 → eval z (pderiv 0 N) ≠ 0)
    (t : ℝ) (ht : t ≠ 0) (y : Fin n → ℝ) :
    divergence (fun i => Pi.single i 1) (coordinateGradient (levelRoot N t)) y = 0 := by
  apply coordinateGradient_divergence_eq_zero N hE (levelRoot N t) t
    (analyticAt_levelRoot N hmono hsurj hreg t ht)
    (fun z => levelRoot_spec N t z (hsurj z))
  intro z
  apply hreg
  rw [levelRoot_spec N t z (hsurj z)]
  exact ht

/-- Ordered entire harmonic functions have a constant difference. -/
theorem harmonic_difference_constant (f g : (Fin n → ℝ) → ℝ)
    (hf : ∀ y, AnalyticAt ℝ f y) (hg : ∀ y, AnalyticAt ℝ g y)
    (hdf : ∀ y, divergence (fun i => Pi.single i 1) (coordinateGradient f) y = 0)
    (hdg : ∀ y, divergence (fun i => Pi.single i 1) (coordinateGradient g) y = 0)
    (horder : ∀ y, g y ≤ f y) (a b : Fin n → ℝ) : f a - g a = f b - g b := by
  have hfc : ContDiff ℝ 1 f := by
    rw [contDiff_iff_contDiffAt]; exact fun y => (hf y).contDiffAt
  have hgc : ContDiff ℝ 1 g := by
    rw [contDiff_iff_contDiffAt]; exact fun y => (hg y).contDiffAt
  apply Source29PositiveHarmonicLiouville.eq_of_nonnegative_harmonic
    (u := fun y => f y - g y)
    (g := fun y i => coordinateGradient f y i - coordinateGradient g y i)
    (hfc.sub hgc)
    (fun i => (coordinateGradient_contDiff f hf i).sub (coordinateGradient_contDiff g hg i))
    ?_ ?_ (fun y => sub_nonneg.mpr (horder y)) a b
  · intro y i
    change fderiv ℝ (f-g) y (Pi.single i 1) = _
    rw [fderiv_sub (hf y).differentiableAt (hg y).differentiableAt]
    rfl
  · intro y
    have he : divergence (fun i => Pi.single i 1)
        (fun z i => coordinateGradient f z i - coordinateGradient g z i) y =
        divergence (fun i => Pi.single i 1) (coordinateGradient f) y -
          divergence (fun i => Pi.single i 1) (coordinateGradient g) y := by
      unfold divergence
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _
      change fderiv ℝ ((fun z => coordinateGradient f z i) -
        (fun z => coordinateGradient g z i)) y (Pi.single i 1) = _
      have hfi : DifferentiableAt ℝ (fun z => coordinateGradient f z i) y :=
        (analyticAt_directional f y (Pi.single i 1) (hf y)).differentiableAt
      have hgi : DifferentiableAt ℝ (fun z => coordinateGradient g z i) y :=
        (analyticAt_directional g y (Pi.single i 1) (hg y)).differentiableAt
      rw [fderiv_sub hfi hgi]
      rfl
    rw [he, hdf, hdg, sub_self]

/-- The displacement between two distinct nonzero inverse levels is constant
in every tangential variable. -/
theorem levelRoot_difference_constant (N : MvPolynomial (Fin (n+1)) ℝ)
    (hE : newtonResidual N = 0)
    (hmono : ∀ y, StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : ∀ y, Function.Surjective (fun x => eval (Fin.cons x y) N))
    (hreg : ∀ z, eval z N ≠ 0 → eval z (pderiv 0 N) ≠ 0)
    (s t : ℝ) (hs : s ≠ 0) (ht : t ≠ 0) (hst : s < t) (a b : Fin n → ℝ) :
    levelRoot N t a - levelRoot N s a = levelRoot N t b - levelRoot N s b := by
  exact harmonic_difference_constant (levelRoot N t) (levelRoot N s)
    (analyticAt_levelRoot N hmono hsurj hreg t ht)
    (analyticAt_levelRoot N hmono hsurj hreg s hs)
    (levelRoot_divergence_eq_zero N hE hmono hsurj hreg t ht)
    (levelRoot_divergence_eq_zero N hE hmono hsurj hreg s hs)
    (fun y => (levelRoot_lt N s t y (hmono y) (hsurj y) hst).le) a b

/-- All normal slice polynomials are translates of the slice at the origin. -/
theorem slice_translation (N : MvPolynomial (Fin (n+1)) ℝ)
    (hE : newtonResidual N = 0)
    (hmono : ∀ y, StrictMono (fun x => eval (Fin.cons x y) N))
    (hsurj : ∀ y, Function.Surjective (fun x => eval (Fin.cons x y) N))
    (hreg : ∀ z, eval z N ≠ 0 → eval z (pderiv 0 N) ≠ 0) (y : Fin n → ℝ) :
    (sliceHom y N).comp (Polynomial.X + Polynomial.C (levelRoot N 1 y - levelRoot N 1 0)) =
      sliceHom 0 N := by
  apply Polynomial.eq_of_infinite_eval_eq
  apply (Set.Ioi_infinite (levelRoot N 1 0)).mono
  intro x hx
  let t := eval (Fin.cons x (0 : Fin n → ℝ)) N
  have ht : 1 < t := by
    have hm := hmono 0 hx
    change eval (Fin.cons (levelRoot N 1 0) (0 : Fin n → ℝ)) N < t at hm
    rwa [levelRoot_spec N 1 0 (hsurj 0)] at hm
  have he : levelRoot N t 0 = x := levelRoot_eq_of_root N t 0 (hmono 0) (hsurj 0) rfl
  have hy : levelRoot N t y = x + (levelRoot N 1 y - levelRoot N 1 0) := by
    have hd := levelRoot_difference_constant N hE hmono hsurj hreg 1 t one_ne_zero
      (ne_of_gt (lt_trans zero_lt_one ht)) ht y 0
    rw [he] at hd
    linarith
  have hv := levelRoot_spec N t y (hsurj y)
  rw [hy] at hv
  change ((sliceHom y N).comp (Polynomial.X + Polynomial.C
    (levelRoot N 1 y - levelRoot N 1 0))).eval x = (sliceHom 0 N).eval x
  simpa only [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X,
    Polynomial.eval_C, eval_sliceHom] using hv

end
end Source29NewtonOrderedRoot

/- Component: DepressedPolynomialTranslation.inc -/
namespace Source29DepressedPolynomialTranslation

open Polynomial

noncomputable section

theorem hasse_penultimate_eq (p : Polynomial ℝ) (d : ℕ) (hd : 0 < d)
    (hdegree : p.natDegree ≤ d) :
    hasseDeriv (d-1) p = C (p.coeff (d-1)) + C ((d : ℝ)*p.coeff d)*X := by
  ext j
  rw [hasseDeriv_coeff]
  by_cases hj0 : j = 0
  · subst j
    simp
  by_cases hj1 : j = 1
  · subst j
    have he : 1+(d-1) = d := by omega
    simp only [he, coeff_add, coeff_C, one_ne_zero, ite_false, coeff_mul_X,
      ite_true, zero_add]
    rw [Nat.choose_symm (by omega : 1 ≤ d), Nat.choose_one_right]
  · have hj : 2 ≤ j := by omega
    have hzero : p.coeff (j+(d-1)) = 0 := coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hzero, mul_zero]
    simp only [coeff_add, coeff_C, coeff_C_mul, coeff_X, hj0, Ne.symm hj1, ite_false,
      mul_zero, add_zero]

theorem penultimate_taylor_coefficient (p : Polynomial ℝ) (d : ℕ)
    (hd : 0 < d) (hdegree : p.natDegree ≤ d) (a : ℝ) :
    (p.comp (X+C a)).coeff (d-1) = p.coeff (d-1)+(d:ℝ)*p.coeff d*a := by
  rw [← taylor_apply, taylor_coeff, hasse_penultimate_eq p d hd hdegree]
  simp only [eval_add, eval_C, eval_mul, eval_X]

/-- A nonzero leading coefficient makes the translation between two
polynomials with vanishing penultimate coefficient equal to zero. -/
theorem translation_eq_zero (p q : Polynomial ℝ) (d : ℕ) (hd : 0 < d)
    (hdegree : p.natDegree ≤ d) (hcoeff : p.coeff d ≠ 0)
    (hp : p.coeff (d-1) = 0) (hq : q.coeff (d-1) = 0)
    (a : ℝ) (htranslate : p.comp (X+C a) = q) : a = 0 := by
  have he := penultimate_taylor_coefficient p d hd hdegree a
  rw [htranslate, hp, hq, zero_add] at he
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hd)
  exact (mul_eq_zero.mp he.symm).resolve_left (mul_ne_zero hd' hcoeff)

end
end Source29DepressedPolynomialTranslation

/- Component: DepressedNewtonRigidity.inc -/
namespace Source29DepressedNewtonRigidity

open MvPolynomial
open Source29NewtonNormalDerivative Source29NewtonPositiveRoot Source29NewtonOrderedRoot
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable

noncomputable section
variable {n : ℕ}

/-- Depression removes the common translation of the inverse level graphs. -/
theorem sliceHom_independent
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (hdepressed : (finSuccEquiv ℝ n N).coeff (d-1) = 0) (y : Fin n → ℝ) :
    sliceHom y N = sliceHom 0 N := by
  have hm := strictMono_slice N α D hD hEuler hE d hd c hc hdegree hcoeff
  have hs := surjective_slice N d hd c hc hdegree hcoeff
  have hr : ∀ z, eval z N ≠ 0 → eval z (pderiv 0 N) ≠ 0 := by
    intro z hz
    exact normal_derivative_ne_zero_of_constant_coefficient
      N α D hD hEuler hE d hd.pos c hc.ne' hcoeff z hz
  have ht := slice_translation N hE hm hs hr y
  have hzero (v : Fin n → ℝ) : (sliceHom v N).coeff (d-1) = 0 := by
    change ((finSuccEquiv ℝ n N).map (eval v)).coeff (d-1) = 0
    rw [Polynomial.coeff_map, hdepressed, map_zero]
  have ha := Source29DepressedPolynomialTranslation.translation_eq_zero
    (sliceHom y N) (sliceHom 0 N) d hd.pos
    (le_of_eq (slice_natDegree N d c hc.ne' hdegree hcoeff y))
    (by rw [slice_coefficient N d c hcoeff y]; exact hc.ne')
    (hzero y) (hzero 0) (levelRoot N 1 y - levelRoot N 1 0) ht
  simpa only [ha, Polynomial.C_0, add_zero, Polynomial.comp_X] using ht

/-- A depressed odd-degree Newton polynomial has no tangential dependence. -/
theorem tangential_pderiv_eq_zero
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (hdepressed : (finSuccEquiv ℝ n N).coeff (d-1) = 0) (i : Fin n) :
    pderiv i.succ N = 0 := by
  have he : finSuccEquiv ℝ n N = (sliceHom 0 N).map (C : ℝ →+* MvPolynomial (Fin n) ℝ) := by
    apply Polynomial.ext
    intro k
    apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
    intro y
    rw [Polynomial.coeff_map, eval_C]
    have hk := congrArg (fun p : Polynomial ℝ => p.coeff k)
      (sliceHom_independent N α D hD hEuler hE d hd c hc hdegree hcoeff hdepressed y)
    change (((finSuccEquiv ℝ n N).map (eval y)).coeff k) = _ at hk
    simpa only [Polynomial.coeff_map] using hk
  apply (finSuccEquiv ℝ n).injective
  apply Polynomial.ext
  intro k
  rw [map_zero, Polynomial.coeff_zero, coeff_finSuccEquiv_pderiv_succ,
    he, Polynomial.coeff_map, pderiv_C]

/-- Sign-free Newton classification: an odd normal degree, constant positive
leading coefficient, and vanishing penultimate coefficient force a pure normal power. -/
theorem eq_pure_normal_power
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (hdepressed : (finSuccEquiv ℝ n N).coeff (d-1) = 0) :
    N = C c * (X 0)^d := by
  exact Source29NewtonPureNormalPower.eq_pure_normal_power_of_degree_ne_zero
    N α D hD.ne' hEuler
    (tangential_pderiv_eq_zero N α D hD hEuler hE d hd c hc hdegree hcoeff hdepressed)
    d c hc.ne' hcoeff

theorem classification
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (hdepressed : (finSuccEquiv ℝ n N).coeff (d-1) = 0) :
    N = C c * (X 0)^d ∧ D = α * (d : ℝ) ∧ 0 < α := by
  have htan := tangential_pderiv_eq_zero N α D hD hEuler hE d hd c hc hdegree hcoeff hdepressed
  have hweight := Source29NewtonPureNormalPower.weighted_degree_eq N α D hEuler htan d c hc.ne' hcoeff
  refine ⟨eq_pure_normal_power N α D hD hEuler hE d hd c hc hdegree hcoeff hdepressed,
    hweight, ?_⟩
  have hdreal : (0 : ℝ) < d := by exact_mod_cast hd.pos
  rw [hweight] at hD
  exact (mul_pos_iff_of_pos_right hdreal).mp hD

lemma weightedEuler_neg (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ)
    (hEuler : WeightedEuler N α D) : WeightedEuler (-N) α D := by
  unfold WeightedEuler at *
  simpa only [map_neg, mul_neg, Finset.sum_neg_distrib, ← neg_add] using congrArg Neg.neg hEuler

lemma newtonResidual_neg (N : MvPolynomial (Fin (n+1)) ℝ) :
    newtonResidual (-N) = -newtonResidual N := by
  simp only [newtonResidual, tangentialLaplacian, tangentialMixed, tangentialEnergy,
    map_neg, neg_mul_neg, neg_sq, Finset.sum_neg_distrib]
  ring

/-- The classification is independent of the sign chosen for the defining polynomial. -/
theorem eq_pure_normal_power_of_ne_zero
    (N : MvPolynomial (Fin (n+1)) ℝ) (α D : ℝ) (hD : 0 < D)
    (hEuler : WeightedEuler N α D) (hE : newtonResidual N = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : c ≠ 0)
    (hdegree : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (hcoeff : (finSuccEquiv ℝ n N).coeff d = C c)
    (hdepressed : (finSuccEquiv ℝ n N).coeff (d-1) = 0) :
    N = C c * (X 0)^d := by
  rcases lt_or_gt_of_ne hc with hc | hc
  · have h := eq_pure_normal_power (-N) α D hD (weightedEuler_neg N α D hEuler)
      (by rw [newtonResidual_neg, hE, neg_zero]) d hd (-c) (neg_pos.mpr hc)
      (by simpa only [map_neg, Polynomial.natDegree_neg] using hdegree)
      (by simpa only [map_neg, Polynomial.coeff_neg] using congrArg Neg.neg hcoeff)
      (by simp only [map_neg, Polynomial.coeff_neg, hdepressed, neg_zero])
    apply neg_injective
    simpa only [map_neg, neg_mul] using h
  · exact eq_pure_normal_power N α D hD hEuler hE d hd c hc hdegree hcoeff hdepressed

end
end Source29DepressedNewtonRigidity

/- Component: DepressedNewtonDegree.inc -/
namespace Source29DepressedNewtonDegree

open MvPolynomial
open Source29NewtonNormalDerivative
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable
open scoped BigOperators

noncomputable section
variable {n : ℕ}

lemma normal_degree_succ_le (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (i : Fin n) :
    (finSuccEquiv ℝ n (pderiv i.succ N)).natDegree ≤ d := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [coeff_finSuccEquiv_pderiv_succ,
    Polynomial.coeff_eq_zero_of_natDegree_lt (hN.trans_lt hk), map_zero]

lemma normal_degree_zero_le (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) :
    (finSuccEquiv ℝ n (pderiv 0 N)).natDegree ≤ d-1 := by
  rw [finSuccEquiv_pderiv_zero]
  exact (Polynomial.natDegree_derivative_le _).trans (Nat.sub_le_sub_right hN 1)

lemma tangent_coeff_high_zero (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : 0 < d)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (c : ℝ)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0)
    (i : Fin n) (k : ℕ) (hk : d-1 ≤ k) :
    (finSuccEquiv ℝ n (pderiv i.succ N)).coeff k = 0 := by
  rw [coeff_finSuccEquiv_pderiv_succ]
  by_cases hk1 : k = d-1
  · rw [hk1,hpen,map_zero]
  by_cases hkd : k = d
  · rw [hkd,htop,pderiv_C]
  rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hN.trans_lt (by omega)),map_zero]

lemma normal_degree_tangent_le (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : 2 ≤ d)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (c : ℝ)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0) (i : Fin n) :
    (finSuccEquiv ℝ n (pderiv i.succ N)).natDegree ≤ d-2 := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  exact tangent_coeff_high_zero N d (by omega) hN c htop hpen i k (by omega)

/-- Removing the penultimate normal coefficient strictly lowers the normal
degree of the Newton residual relative to the cube of the normal derivative. -/
theorem residual_normal_degree_le (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : 2 ≤ d)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (c : ℝ)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0) :
    (finSuccEquiv ℝ n (newtonResidual N)).natDegree ≤ 3*d-4 := by
  have hA := normal_degree_zero_le N d hN
  have hS : (finSuccEquiv ℝ n (pderiv 0 (pderiv 0 N))).natDegree ≤ d-1 :=
    (normal_degree_zero_le (pderiv 0 N) (d-1) hA).trans (Nat.sub_le _ _)
  have hB := normal_degree_tangent_le N d hd hN c htop hpen
  have hT (i : Fin n) : (finSuccEquiv ℝ n (pderiv i.succ (pderiv 0 N))).natDegree ≤ d-1 :=
    normal_degree_succ_le (pderiv 0 N) (d-1) hA i
  have hL : (finSuccEquiv ℝ n (tangentialLaplacian N)).natDegree ≤ d-2 := by
    simp only [tangentialLaplacian,map_sum]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro i hi
    exact normal_degree_succ_le (pderiv i.succ N) (d-2) (hB i) i
  have hM : (finSuccEquiv ℝ n (tangentialMixed N)).natDegree ≤ 2*d-3 := by
    simp only [tangentialMixed,map_sum,map_mul]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro i hi
    exact (Polynomial.natDegree_mul_le).trans (by have := hB i; have := hT i; omega)
  have hE : (finSuccEquiv ℝ n (tangentialEnergy N)).natDegree ≤ 2*d-4 := by
    simp only [tangentialEnergy,map_sum,map_pow]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro i hi
    exact Polynomial.natDegree_pow_le.trans (by have := hB i; omega)
  simp only [newtonResidual,map_add,map_sub,map_mul,map_pow,map_ofNat]
  apply Polynomial.natDegree_add_le_of_degree_le
  · apply (Polynomial.natDegree_sub_le _ _).trans
    apply max_le
    · exact Polynomial.natDegree_mul_le.trans (by
        have hp := Polynomial.natDegree_pow_le (p := finSuccEquiv ℝ n (pderiv 0 N)) (n := 2)
        omega)
    · exact Polynomial.natDegree_mul_le.trans (by
        have hp := Polynomial.natDegree_mul_le (p := (2 : Polynomial (MvPolynomial (Fin n) ℝ)))
          (q := finSuccEquiv ℝ n (pderiv 0 N))
        have hz : (2 : Polynomial (MvPolynomial (Fin n) ℝ)).natDegree = 0 := by simp
        omega)
  · exact Polynomial.natDegree_mul_le.trans (by omega)

lemma residual_top_coefficient_zero (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : 0 < d)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (c : ℝ)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0) :
    (finSuccEquiv ℝ n (newtonResidual N)).coeff (3*(d-1)) = 0 := by
  by_cases hd2 : 2 ≤ d
  · exact Polynomial.coeff_eq_zero_of_natDegree_lt
      ((residual_normal_degree_le N d hd2 hN c htop hpen).trans_lt (by omega))
  · have hd1 : d = 1 := by omega
    have hz (i : Fin n) : pderiv i.succ N = 0 := by
      apply (finSuccEquiv ℝ n).injective
      apply Polynomial.ext
      intro k
      simp only [map_zero,Polynomial.coeff_zero]
      exact tangent_coeff_high_zero N d hd hN c htop hpen i k (by omega)
    simp only [newtonResidual,tangentialLaplacian,tangentialMixed,tangentialEnergy,
      hz,map_zero,zero_mul,mul_zero,zero_pow (by decide : 2 ≠ 0),
      Finset.sum_const_zero,sub_zero,add_zero,Polynomial.coeff_zero]

/-- A residual proportional to the normal derivative cube must vanish when
the leading normal coefficient is constant and the penultimate one is zero. -/
theorem residual_eq_zero_of_background_factor
    (N : MvPolynomial (Fin (n+1)) ℝ) (d : ℕ) (hd : 0 < d)
    (hN : (finSuccEquiv ℝ n N).natDegree ≤ d) (c : ℝ) (hc : c ≠ 0)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0)
    (b : (Fin n → ℝ) → ℝ)
    (he : ∀ x y, eval (Fin.cons x y) (newtonResidual N) =
      (eval (Fin.cons x y) (pderiv 0 N))^3 * b y) :
    (∀ y, b y = 0) ∧ newtonResidual N = 0 := by
  have hb (y : Fin n → ℝ) : b y = 0 := by
    have hp : sliceHom y (newtonResidual N) = (sliceHom y (pderiv 0 N))^3 * Polynomial.C (b y) := by
      apply Polynomial.funext
      intro x
      simpa only [Polynomial.eval_mul,Polynomial.eval_pow,Polynomial.eval_C,eval_sliceHom]
        using he x y
    have hdegree : (sliceHom y (pderiv 0 N)).natDegree ≤ d-1 :=
      Polynomial.natDegree_map_le.trans (normal_degree_zero_le N d hN)
    have hcoeff : (sliceHom y (pderiv 0 N)).coeff (d-1) = c*(d:ℝ) := by
      rw [sliceHom_pderiv_zero,Polynomial.coeff_derivative]
      have hpred : d-1+1 = d := by omega
      simp only [hpred]
      have hcast : ((d-1:ℕ):ℝ)+1 = (d:ℝ) := by exact_mod_cast hpred
      rw [hcast]
      change (((finSuccEquiv ℝ n N).map (eval y)).coeff d) * (d:ℝ) = _
      rw [Polynomial.coeff_map,htop,eval_C]
    have hleft : (sliceHom y (newtonResidual N)).coeff (3*(d-1)) = 0 := by
      change (((finSuccEquiv ℝ n (newtonResidual N)).map (eval y)).coeff (3*(d-1))) = 0
      rw [Polynomial.coeff_map,residual_top_coefficient_zero N d hd hN c htop hpen,map_zero]
    have hv := congrArg (fun p : Polynomial ℝ ↦ p.coeff (3*(d-1))) hp
    rw [hleft,Polynomial.coeff_mul_C,Polynomial.coeff_pow_of_natDegree_le hdegree,hcoeff] at hv
    exact (mul_eq_zero.mp hv.symm).resolve_left (pow_ne_zero 3 (mul_ne_zero hc (by exact_mod_cast hd.ne')))
  refine ⟨hb,?_⟩
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro z
  have hz := he (z 0) (Fin.tail z)
  simpa only [hb,mul_zero,Fin.cons_self_tail,map_zero] using hz

end
end Source29DepressedNewtonDegree

/- Component: BackgroundFreeScaledResidual.inc -/
namespace Source29BackgroundFreeScaledResidual

open Filter Source29NormalShiftDerivatives Source29NormalShiftAlgebra
  Source29NormalShiftScaling Source29NormalizedShiftJets Source29NormalizedShiftBackground
  Source29NormalShiftScalingLimit
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- The exact normalized equation retains the background term. No equation
for the centering graph is assumed. -/
theorem scaled_pullback_equation (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (κ ε ρ : ℝ) (hκ : κ ≠ 0) (hε : ε ≠ 0) (hρ : ρ ≠ 0)
    (v : Fin (n+1) → ℝ) (hg : AnalyticAt ℝ g (ε • tail v))
    (hP : MvPolynomial.eval (chart g (dilation (ε*ρ) ε v))
      (Source29QuarticReuse.QuarticMinimal.leadingOperator P) = 0) :
    let H := scaledFunction (pullback P g) κ ε ρ
    let A := gradient H v 0
    let S := hessian H v 0 0
    let B := fun i : Fin n ↦ gradient H v i.succ
    let T := fun i : Fin n ↦ hessian H v i.succ 0
    let U := fun i j : Fin n ↦ hessian H v i.succ j.succ
    let a := fun i ↦ gradient g (ε • tail v) i / ε
    let G := hessian g (ε • tail v)
    newtonResidual A S B T U + ρ^2*rhoCorrection B U +
      ε*ρ*mixedCorrection A B T a U G + ε^2*epsilonCorrection A S B T a U G =
      A^3 * ((ε/ρ)*backgroundGraphOperator (gradient g (ε • tail v)) G) := by
  dsimp only
  have hga : AnalyticAt ℝ g (tail (dilation (ε*ρ) ε v)) := hg
  have hf := analyticAt_pullback P g (dilation (ε*ρ) ε v) hga
  obtain ⟨hA,hB,hS,hT,hU⟩ := original_jets (pullback P g) κ ε ρ hκ hε hρ v hf
  have he := polynomial_cubicLevel_transform P g (dilation (ε*ρ) ε v) hga
  dsimp only at he
  rw [cubicLevel_eval,hP] at he
  have hl : shiftedLevelOperator (gradient (pullback P g) (dilation (ε*ρ) ε v) 0)
      (hessian (pullback P g) (dilation (ε*ρ) ε v) 0 0)
      (fun i : Fin n ↦ gradient (pullback P g) (dilation (ε*ρ) ε v) i.succ)
      (fun i : Fin n ↦ hessian (pullback P g) (dilation (ε*ρ) ε v) i.succ 0)
      (gradient g (ε • tail v))
      (fun i j : Fin n ↦ hessian (pullback P g) (dilation (ε*ρ) ε v) i.succ j.succ)
      (hessian g (ε • tail v)) = 0 := by
    rw [normal_shift_identity]
    exact he.symm
  simp_rw [hA,hB,hS,hT,hU] at hl
  rw [← scaled_gradient g (tail v) ε hε] at hl
  rw [normal_shift_scaling κ ε ρ _ _ _ _ _ _ _ hε hρ] at hl
  have hz := (mul_eq_zero.mp hl).resolve_left
    (div_ne_zero (mul_ne_zero (pow_ne_zero 3 hκ) hρ) hε)
  rw [scaled_gradient g (tail v) ε hε] at hz
  linear_combination hz

/-- The tuple of actual normalized jets, including the bounded background jets. -/
def jets (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (α D ε : ℝ) (v : Fin (n+1) → ℝ) : Jet (Fin n) :=
  ((gradient (family P g α D ε) v 0,hessian (family P g α D ε) v 0 0),
    (fun i ↦ gradient (family P g α D ε) v i.succ,
     fun i ↦ hessian (family P g α D ε) v i.succ 0,
     fun i ↦ gradient g (ε • tail v) i / ε),
    (fun i j ↦ hessian (family P g α D ε) v i.succ j.succ,hessian g (ε • tail v)))

def total (P : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (α D ε : ℝ) (v : Fin (n+1) → ℝ) : ℝ :=
  Source29NormalShiftScalingLimit.residual (jets P g α D ε v) + (ε^(α-1))^2*rhoTerm (jets P g α D ε v) +
    ε*ε^(α-1)*mixedTerm (jets P g α D ε v) + ε^2*epsilonTerm (jets P g α D ε v)

def background (g : (Fin n → ℝ) → ℝ) (α ε : ℝ) (y : Fin n → ℝ) : ℝ :=
  (ε/ε^(α-1))*backgroundGraphOperator (gradient g (ε • y)) (hessian g (ε • y))

/-- At every positive scale the background depends only on the tangential
point, even though the normalized residual also depends on the normal point. -/
theorem family_equation (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D ε : ℝ) (hε : 0 < ε) (v : Fin (n+1) → ℝ)
    (hg : AnalyticAt ℝ g (ε • tail v))
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0) :
    total P g α D ε v = (gradient (family P g α D ε) v 0)^3 * background g α ε (tail v) := by
  unfold total jets Source29NormalShiftScalingLimit.residual rhoTerm mixedTerm epsilonTerm background
  dsimp only
  rw [family_eq_scaledFunction P g α D ε hε]
  exact scaled_pullback_equation P g (ε^(D-α)) ε (ε^(α-1))
    (ne_of_gt (Real.rpow_pos_of_pos hε _)) (ne_of_gt hε)
    (ne_of_gt (Real.rpow_pos_of_pos hε _)) v hg (by rw [hP,map_zero])

/-- Vanishing scale factors kill all correction terms for any analytic flat
centering graph. The graph need not satisfy a minimal surface equation. -/
theorem total_tendsto (P N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D : ℝ) (hα : 1 < α)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0) (v : Fin (n+1) → ℝ)
    (hfirst : ∀ i, Tendsto (fun ε : ℝ ↦ gradient (family P g α D ε) v i) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i N))))
    (hsecond : ∀ i j, Tendsto (fun ε : ℝ ↦ hessian (family P g α D ε) v i j) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (MvPolynomial.pderiv i (MvPolynomial.pderiv j N))))) :
    Tendsto (fun ε : ℝ ↦ total P g α D ε v) (𝓝[>] 0)
      (𝓝 (MvPolynomial.eval v (Source29NewtonNormalDerivative.newtonResidual N))) := by
  let j₀ : Jet (Fin n) :=
    ((MvPolynomial.eval v (MvPolynomial.pderiv 0 N),
      MvPolynomial.eval v (MvPolynomial.pderiv 0 (MvPolynomial.pderiv 0 N))),
     (fun i ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ N),
      fun i ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ (MvPolynomial.pderiv 0 N)),
      fun i ↦ second g 0 (tail v) (basis i)),
     (fun i j ↦ MvPolynomial.eval v (MvPolynomial.pderiv i.succ (MvPolynomial.pderiv j.succ N)),
      hessian g 0))
  have hj : Tendsto (fun ε : ℝ ↦ jets P g α D ε v) (𝓝[>] 0) (𝓝 j₀) :=
    ((hfirst 0).prodMk_nhds (hsecond 0 0)).prodMk_nhds
      (((tendsto_pi_nhds.mpr (fun i : Fin n ↦ hfirst i.succ)).prodMk_nhds
        ((tendsto_pi_nhds.mpr (fun i : Fin n ↦ hsecond i.succ 0)).prodMk_nhds
          (gradient_div_tendsto g hg hg0 (tail v)))).prodMk_nhds
        ((tendsto_pi_nhds.mpr (fun i : Fin n ↦ tendsto_pi_nhds.mpr
          (fun j : Fin n ↦ hsecond i.succ j.succ))).prodMk_nhds (hessian_tendsto g hg (tail v))))
  have hε : Tendsto (fun ε : ℝ ↦ ε) (𝓝[>] 0) (𝓝 0) := tendsto_id.mono_left nhdsWithin_le_nhds
  have hρ : Tendsto (fun ε : ℝ ↦ ε^(α-1)) (𝓝[>] 0) (𝓝 0) := by
    have hp : Tendsto (fun ε : ℝ ↦ ε^(α-1)) (𝓝[>] 0) (𝓝 ((0 : ℝ)^(α-1))) :=
      (Real.continuousAt_rpow_const (0 : ℝ) (α-1)
      (Or.inr (le_of_lt (sub_pos.mpr hα)))).tendsto.mono_left nhdsWithin_le_nhds
    simpa only [Real.zero_rpow (ne_of_gt (sub_pos.mpr hα))] using hp
  have hE := residual_continuous.continuousAt.tendsto.comp hj
  have hR := rhoTerm_continuous.continuousAt.tendsto.comp hj
  have hM := mixedTerm_continuous.continuousAt.tendsto.comp hj
  have hS := epsilonTerm_continuous.continuousAt.tendsto.comp hj
  have htotal : Tendsto (fun ε : ℝ ↦ total P g α D ε v) (𝓝[>] 0) (𝓝 (Source29NormalShiftScalingLimit.residual j₀)) := by
    simpa only [zero_pow (by decide : 2 ≠ 0),zero_mul,add_zero,total,Function.comp_def] using
      ((hE.add ((hρ.pow 2).mul hR)).add ((hε.mul hρ).mul hM)).add ((hε.pow 2).mul hS)
  convert htotal using 1
  congr 1
  rw [← Source29NormalizedShiftResidual.newtonResidual_eval N v]
  simp only [Source29NormalShiftScalingLimit.residual,j₀,gradient_eval,hessian_eval]

end
end Source29BackgroundFreeScaledResidual

/- Component: BackgroundFactorLimit.inc -/
namespace Source29BackgroundFactorLimit

open Filter
open scoped Topology

/-- A common scalar factor has a limit once one limiting multiplier is
nonzero; this determines every other limiting product. -/
theorem exists_limit_of_products {T X : Type*} {l : Filter T} [NeBot l]
    (A R : T → X → ℝ) (B : T → ℝ) (a r : X → ℝ)
    (hA : ∀ x, Tendsto (fun t ↦ A t x) l (𝓝 (a x)))
    (hR : ∀ x, Tendsto (fun t ↦ R t x) l (𝓝 (r x)))
    (he : ∀ x, ∀ᶠ t in l, R t x = A t x * B t)
    (ha : ∃ x, a x ≠ 0) :
    ∃ b : ℝ, Tendsto B l (𝓝 b) ∧ ∀ x, r x = a x * b := by
  obtain ⟨x₀,hx₀⟩ := ha
  have hb : Tendsto B l (𝓝 (r x₀ / a x₀)) := by
    apply ((hR x₀).div (hA x₀) hx₀).congr'
    filter_upwards [he x₀,(hA x₀).eventually (eventually_ne_nhds hx₀)] with t ht hn
    change R t x₀ / A t x₀ = B t
    rw [ht,mul_div_cancel_left₀ _ hn]
  refine ⟨r x₀ / a x₀,hb,fun x ↦ ?_⟩
  have hp : Tendsto (fun t ↦ R t x) l (𝓝 (a x * (r x₀/a x₀))) := by
    apply ((hA x).mul hb).congr'
    filter_upwards [he x] with t ht
    exact ht.symm
  exact tendsto_nhds_unique (hR x) hp

end Source29BackgroundFactorLimit

/- Component: BackgroundFreeNewtonLimit.inc -/
namespace Source29BackgroundFreeNewtonLimit

open Filter MvPolynomial Source29NormalShiftDerivatives Source29NormalizedShiftJets
  Source29NormalizedShiftBackground Source29BackgroundFreeScaledResidual
  Source29QuarticReuse.QuarticMinimal.DistinguishedVariable
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Every fixed tangential slice admits a limiting scalar background factor.
A nonzero constant normal coefficient supplies the required nonzero limiting
normal derivative somewhere on that slice. -/
theorem exists_background_factor (P N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D : ℝ) (hα : 1 < α)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0)
    (d : ℕ) (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hfirst : ∀ v i, Tendsto (fun ε : ℝ ↦ gradient (family P g α D ε) v i) (𝓝[>] 0)
      (𝓝 (eval v (pderiv i N))))
    (hsecond : ∀ v i j, Tendsto (fun ε : ℝ ↦ hessian (family P g α D ε) v i j) (𝓝[>] 0)
      (𝓝 (eval v (pderiv i (pderiv j N))))) :
    ∃ b : (Fin n → ℝ) → ℝ, ∀ x y,
      eval (Fin.cons x y) (Source29NewtonNormalDerivative.newtonResidual N) =
        (eval (Fin.cons x y) (pderiv 0 N))^3 * b y := by
  classical
  have hb (y : Fin n → ℝ) : ∃ b : ℝ, ∀ x,
      eval (Fin.cons x y) (Source29NewtonNormalDerivative.newtonResidual N) =
        (eval (Fin.cons x y) (pderiv 0 N))^3 * b := by
    have hex : ∃ x : ℝ, eval (Fin.cons x y) (pderiv 0 N) ≠ 0 := by
      by_contra! hz
      have hn := Source29NewtonNormalDerivative.slice_derivative_ne_zero_of_constant_coefficient
        N d hd c hc htop y
      apply hn
      apply Polynomial.funext
      intro x
      simpa only [Source29NewtonNormalDerivative.eval_sliceHom,Polynomial.eval_zero] using hz x
    have he (x : ℝ) : ∀ᶠ ε : ℝ in 𝓝[>] 0,
        total P g α D ε (Fin.cons x y) =
          (gradient (family P g α D ε) (Fin.cons x y) 0)^3 * background g α ε y := by
      filter_upwards [self_mem_nhdsWithin,(dilation_tendsto y).eventually hg.eventually_analyticAt]
        with ε hε hge
      have ht : tail (Fin.cons x y) = y := by ext i; rfl
      simpa only [ht] using family_equation P g α D ε hε (Fin.cons x y) hge hP
    obtain ⟨b,hbl,hb⟩ := Source29BackgroundFactorLimit.exists_limit_of_products
      (fun ε x ↦ (gradient (family P g α D ε) (Fin.cons x y) 0)^3)
      (fun ε x ↦ total P g α D ε (Fin.cons x y)) (fun ε ↦ background g α ε y)
      (fun x ↦ (eval (Fin.cons x y) (pderiv 0 N))^3)
      (fun x ↦ eval (Fin.cons x y) (Source29NewtonNormalDerivative.newtonResidual N))
      (fun x ↦ (hfirst (Fin.cons x y) 0).pow 3)
      (fun x ↦ total_tendsto P N g α D hα hg hg0 (Fin.cons x y)
        (hfirst (Fin.cons x y)) (hsecond (Fin.cons x y))) he
      (by obtain ⟨x,hx⟩ := hex; exact ⟨x,pow_ne_zero 3 hx⟩)
    exact ⟨b,hb⟩
  choose b hb using hb
  exact ⟨b,fun x y ↦ hb y x⟩

/-- A depressed Newton face obtained from actual normalized first and second
jets satisfies the Newton residual equation. No background graph equation
or sign assumption is required. -/
theorem newtonResidual_eq_zero (P N : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (α D : ℝ) (hα : 1 < α)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hP : Source29QuarticReuse.QuarticMinimal.leadingOperator P = 0)
    (d : ℕ) (hd : 0 < d) (hN : (finSuccEquiv ℝ n N).natDegree ≤ d)
    (c : ℝ) (hc : c ≠ 0) (htop : (finSuccEquiv ℝ n N).coeff d = C c)
    (hpen : (finSuccEquiv ℝ n N).coeff (d-1) = 0)
    (hfirst : ∀ v i, Tendsto (fun ε : ℝ ↦ gradient (family P g α D ε) v i) (𝓝[>] 0)
      (𝓝 (eval v (pderiv i N))))
    (hsecond : ∀ v i j, Tendsto (fun ε : ℝ ↦ hessian (family P g α D ε) v i j) (𝓝[>] 0)
      (𝓝 (eval v (pderiv i (pderiv j N))))) :
    Source29NewtonNormalDerivative.newtonResidual N = 0 := by
  obtain ⟨b,hb⟩ := exists_background_factor P N g α D hα hg hg0 hP d hd c hc htop hfirst hsecond
  exact (Source29DepressedNewtonDegree.residual_eq_zero_of_background_factor
    N d hd hN c hc htop hpen b hb).2

end
end Source29BackgroundFreeNewtonLimit

/- Component: DepressedNewtonFaceLimit.inc -/
namespace Source29DepressedNewtonFaceLimit

open Filter MvPolynomial Source29NewtonWeightedFace
  Source29NewtonInitialDataLimit Source29NewtonShiftedFactorCoefficient
  Source29NormalShiftDerivatives
open scoped Topology

noncomputable section
variable {n d : ℕ}

/-- A weighted initial coefficient of a zero analytic germ is zero. -/
theorem polynomial_eq_zero_of_zero_germ {f : (Fin n → ℝ) → ℝ}
    (β : ℝ) (Q : MvPolynomial (Fin n) ℝ) (hdata : CoefficientData f β Q)
    (hz : ∀ᶠ y in 𝓝 0, f y = 0) : Q = 0 := by
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro y
  have ht := (coefficient_uniform_limit β Q hdata {y} isCompact_singleton.isBounded).tendsto_at
    (Set.mem_singleton y)
  have hzlim : Tendsto (fun ε : ℝ ↦ ε^(-β)*f (ε • y)) (𝓝[>] 0) (𝓝 0) := by
    apply tendsto_const_nhds.congr'
    filter_upwards [(Source29NormalizedShiftBackground.dilation_tendsto y).eventually hz] with ε hε
    simp only [hε,mul_zero]
  simpa only [map_zero] using tendsto_nhds_unique ht hzlim

/-- Centering the original shifted polynomial removes the same coefficient
from every selected weighted face. -/
theorem penultimate_coefficient_zero (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hd : 0 < d)
    (c : ℝ) (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ) (α : ℝ)
    (hpen : ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (d-1) = 0)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α*(d : ℝ)-α*(j : ℕ)) (if j ∈ S then P j else 0)) :
    (finSuccEquiv ℝ n (face c S P)).coeff (d-1) = 0 := by
  let j : Fin d := ⟨d-1,by omega⟩
  have he := polynomial_eq_zero_of_zero_germ (α*(d : ℝ)-α*(j : ℕ))
    (if j ∈ S then P j else 0) (hdata j) hpen
  exact (lower_coefficient c S P j).trans he

/-- Actual coefficient data for a centered analytic shift directly yield
the selected face equation, without a background graph equation. -/
theorem face_residual_eq_zero (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hd : 0 < d) (c : ℝ) (hc : c ≠ 0)
    (htop : (shiftedSlice F (g 0) 0).coeff d = c)
    (S : Finset (Fin d)) (P : Fin d → MvPolynomial (Fin n) ℝ)
    (α : ℝ) (hα : 1 < α)
    (hpen : ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (d-1) = 0)
    (hdata : ∀ j : Fin d, CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j : ℕ))
      (α*(d : ℝ)-α*(j : ℕ)) (if j ∈ S then P j else 0)) :
    Source29NewtonNormalDerivative.newtonResidual (face c S P) = 0 := by
  let m := max (finSuccEquiv ℝ n F).natDegree d + 1
  have hFm : (finSuccEquiv ℝ n F).natDegree < m := Nat.lt_succ_of_le (le_max_left _ _)
  have hdm : d < m := Nat.lt_succ_of_le (le_max_right _ _)
  have hjets := Source29NewtonFaceJetLimit.face_coordinate_jets_tendsto
    F g hg c htop S P α (lt_trans zero_lt_one hα) m hdm hFm hdata
  exact Source29BackgroundFreeNewtonLimit.newtonResidual_eq_zero
    F (face c S P) g α (α*d) hα hg hg0 hF d hd (normal_degree_le c S P)
    c hc (top_coefficient c S P) (penultimate_coefficient_zero F g hd c S P α hpen hdata)
    (fun x ↦ (hjets x).1) (fun x ↦ (hjets x).2)

end
end Source29DepressedNewtonFaceLimit

/- Component: CenteredNewtonObstruction.inc -/
namespace Source29CenteredNewtonObstruction

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonWeightedFace
open Source29NormalShiftDerivatives
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- An odd pure ordinary initial limit and analytic centering exclude every
lower normal coefficient germ. The Newton residual follows from actual jets;
no root, sign, or background graph equation is an assumption. -/
theorem lower_coefficient_germs_zero
    (F : MvPolynomial (Fin (n+1)) ℝ) (g : (Fin n → ℝ) → ℝ)
    (hg : AnalyticAt ℝ g 0) (hg0 : gradient g 0 = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : c ≠ 0)
    (hinitial : ∀ x y, Tendsto (fun t : ℝ ↦
      eval (Fin.cons (g (t•y)+t*x) (t•y)) F / t^d) (𝓝[>] 0) (𝓝 (c*x^d)))
    (hpen : ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (d-1) = 0) :
    ∀ j : Fin d, ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0 := by
  classical
  by_contra h
  have hne := not_forall.mp h
  obtain ⟨α,S,P,v,hα,hS,hP,horder,hselected,hdata⟩ :=
    Source29NewtonCoefficientSelection.exists_selected_coefficient_data
      (fun (j : Fin d) y ↦ (shiftedSlice F (g y) y).coeff (j:ℕ))
      (fun j ↦ Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F j g 0 hg)
      hne (Source29NewtonCoefficientLimitExtraction.lower_coefficient_limit_zero_of_pure_initial
        F g d c hinitial)
  have hαpos : 0 < α := lt_trans zero_lt_one hα
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  have hdata' : ∀ j : Fin d, Source29NewtonInitialDataLimit.CoefficientData
      (fun y ↦ (shiftedSlice F (g y) y).coeff (j:ℕ))
      (α*(d:ℝ)-α*(j:ℕ)) (if j ∈ S then P j else 0) := by
    intro j
    simpa only [mul_sub] using hdata j
  have hE := Source29DepressedNewtonFaceLimit.face_residual_eq_zero
    F g hg hg0 hF hd.pos c hc htop S P α hα hpen hdata'
  have hdepressed := Source29DepressedNewtonFaceLimit.penultimate_coefficient_zero
    F g hd.pos c S P α hpen hdata'
  have heq := Source29DepressedNewtonRigidity.eq_pure_normal_power_of_ne_zero
    (face c S P) α (α*d) (mul_pos hαpos (by exact_mod_cast hd.pos))
    (weightedEuler c S P v α (fun j _ ↦ hP j) (fun j hj ↦ ((hselected j).mp hj).2))
    hE d hd c hc (normal_degree_le c S P) (top_coefficient c S P) hdepressed
  obtain ⟨j,hj⟩ := hS
  exact ne_pure_normal_power c S P j hj ((hselected j).mp hj).1 heq

end
end Source29CenteredNewtonObstruction

/- Component: ShiftedAnalyticUnit.inc -/
namespace Source29ShiftedAnalyticUnit

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NewtonShiftedExpansion
open scoped Topology BigOperators

noncomputable section

def dropCoefficients {R : Type*} [Semiring R] : ℕ → Polynomial R → Polynomial R
  | 0, p => p
  | d+1, p => dropCoefficients d p.divX

theorem coeff_dropCoefficients {R : Type*} [Semiring R]
    (p : Polynomial R) (d j : ℕ) :
    (dropCoefficients d p).coeff j = p.coeff (j+d) := by
  induction d generalizing p with
  | zero => simp [dropCoefficients]
  | succ d ih => simp only [dropCoefficients, ih, Polynomial.coeff_divX, Nat.add_assoc]

theorem natDegree_dropCoefficients_le {R : Type*} [Semiring R]
    (p : Polynomial R) (d : ℕ) : (dropCoefficients d p).natDegree ≤ p.natDegree := by
  induction d generalizing p with
  | zero => exact le_rfl
  | succ d ih => exact (ih p.divX).trans Polynomial.natDegree_divX_le

theorem eq_X_pow_mul_dropCoefficients {R : Type*} [Semiring R]
    (p : Polynomial R) (d : ℕ) (hlow : ∀ j < d, p.coeff j = 0) :
    p = Polynomial.X^d * dropCoefficients d p := by
  ext j
  rw [Polynomial.coeff_X_pow_mul']
  split_ifs with h
  · rw [coeff_dropCoefficients, Nat.sub_add_cancel h]
  · exact hlow j (Nat.lt_of_not_ge h)

variable {n : ℕ}

def unitFunction (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (z : ℝ × (Fin n → ℝ)) : ℝ :=
  (dropCoefficients d (shiftedSlice F (g z.2) z.2)).eval z.1

theorem unitFunction_zero (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (y : Fin n → ℝ) :
    unitFunction F g d (0,y) = (shiftedSlice F (g y) y).coeff d := by
  simp only [unitFunction, ← Polynomial.coeff_zero_eq_eval_zero, coeff_dropCoefficients, zero_add]

theorem unitFunction_analyticAt (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (z : ℝ × (Fin n → ℝ))
    (hg : AnalyticAt ℝ g z.2) : AnalyticAt ℝ (unitFunction F g d) z := by
  let m := (finSuccEquiv ℝ n F).natDegree+1
  have he : unitFunction F g d = fun w : ℝ × (Fin n → ℝ) =>
      ∑ j ∈ Finset.range m, (shiftedSlice F (g w.2) w.2).coeff (j+d) * w.1^j := by
    funext w
    have hm : (dropCoefficients d (shiftedSlice F (g w.2) w.2)).natDegree < m :=
      lt_of_le_of_lt ((natDegree_dropCoefficients_le _ _).trans
        (shiftedSlice_natDegree_le F _ _)) (Nat.lt_succ_self _)
    simp only [unitFunction, Polynomial.eval_eq_sum_range' hm, coeff_dropCoefficients]
  rw [he]
  apply Finset.analyticAt_fun_sum
  intro j hj
  have hc := Source29NewtonCoefficientAnalytic.analyticAt_shifted_coefficient F (j+d) g z.2 hg
  exact (hc.comp ((ContinuousLinearMap.snd ℝ ℝ (Fin n → ℝ)).analyticAt z)).mul
    (((ContinuousLinearMap.fst ℝ ℝ (Fin n → ℝ)).analyticAt z).pow j)

theorem eval_eq_pow_mul_unit (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (x : ℝ) (y : Fin n → ℝ)
    (hlow : ∀ j < d, (shiftedSlice F (g y) y).coeff j = 0) :
    eval (Fin.cons (g y+x) y) F = x^d * unitFunction F g d (x,y) := by
  rw [← eval_shiftedSlice, eq_X_pow_mul_dropCoefficients _ d hlow]
  simp only [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X, unitFunction]

theorem eventually_factor (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (a : Fin n → ℝ)
    (hlow : ∀ j : Fin d, ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0) :
    ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      eval (Fin.cons (g z.2+z.1) z.2) F = z.1^d * unitFunction F g d z := by
  have hy : ∀ᶠ y in 𝓝 a, ∀ j : Fin d, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0 :=
    Filter.eventually_all.mpr hlow
  filter_upwards [(continuous_snd.tendsto (0,a)).eventually hy] with z hz
  exact eval_eq_pow_mul_unit F g d z.1 z.2 (fun j hj => hz ⟨j,hj⟩)

/-- If all lower normal coefficient germs vanish and the next coefficient
does not, the local zero set is exactly the analytic center graph. -/
theorem eventually_zero_iff_normal_zero (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (hd : 0 < d) (a : Fin n → ℝ)
    (hg : AnalyticAt ℝ g a)
    (hlow : ∀ j : Fin d, ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0)
    (htop : (shiftedSlice F (g a) a).coeff d ≠ 0) :
    ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      (eval (Fin.cons (g z.2+z.1) z.2) F = 0 ↔ z.1 = 0) := by
  have hunit : unitFunction F g d (0,a) ≠ 0 := by rwa [unitFunction_zero]
  have hn := (unitFunction_analyticAt F g d (0,a) hg).continuousAt.eventually_ne hunit
  filter_upwards [eventually_factor F g d a hlow, hn] with z he hne
  rw [he, mul_eq_zero, or_iff_left hne, pow_eq_zero_iff hd.ne']

/-- Positive odd leading coefficient gives the exact two phase signs near
the center graph once all lower coefficient germs vanish. -/
theorem eventually_phase_equivalences (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (d : ℕ) (hd : Odd d) (a : Fin n → ℝ)
    (hg : AnalyticAt ℝ g a)
    (hlow : ∀ j : Fin d, ∀ᶠ y in 𝓝 a, (shiftedSlice F (g y) y).coeff (j:ℕ) = 0)
    (htop : 0 < (shiftedSlice F (g a) a).coeff d) :
    ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 (0,a),
      (0 < eval (Fin.cons (g z.2+z.1) z.2) F ↔ 0 < z.1) ∧
      (eval (Fin.cons (g z.2+z.1) z.2) F < 0 ↔ z.1 < 0) := by
  have hunit : 0 < unitFunction F g d (0,a) := by rwa [unitFunction_zero]
  have hn := (unitFunction_analyticAt F g d (0,a) hg).continuousAt.eventually (lt_mem_nhds hunit)
  filter_upwards [eventually_factor F g d a hlow, hn] with z he hpos
  rw [he]
  exact ⟨(mul_pos_iff_of_pos_right hpos).trans hd.pow_pos_iff,
    (show z.1^d * unitFunction F g d z < 0 ↔ z.1^d < 0 by
      constructor
      · intro h
        by_contra hn
        exact (not_lt_of_ge (mul_nonneg (le_of_not_gt hn) hpos.le)) h
      · exact fun h => mul_neg_of_neg_of_pos h hpos).trans hd.pow_neg_iff⟩

end
end Source29ShiftedAnalyticUnit

/- Component: AnalyticGraphFactor.inc -/
namespace Source29AnalyticGraphFactor

open MvPolynomial Filter Set
open scoped Topology

noncomputable section

/-- Real analytic germs in any real normed space have no zero divisors. -/
theorem zero_germ_of_mul_zero {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f g : E → ℝ) (a : E) (hf : AnalyticAt ℝ f a) (hg : AnalyticAt ℝ g a)
    (hfg : ∀ᶠ y in 𝓝 a, f y * g y = 0) :
    (∀ᶠ y in 𝓝 a, f y = 0) ∨ (∀ᶠ y in 𝓝 a, g y = 0) := by
  by_cases hfzero : ∀ᶠ y in 𝓝 a, f y = 0
  · exact Or.inl hfzero
  right
  have hevent : ∀ᶠ y in 𝓝 a, AnalyticAt ℝ f y ∧ AnalyticAt ℝ g y ∧ f y * g y = 0 := by
    filter_upwards [hf.eventually_analyticAt, hg.eventually_analyticAt, hfg] with y hyf hyg hy
    exact ⟨hyf, hyg, hy⟩
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp hevent
  obtain ⟨b, hb, hfb⟩ : ∃ b ∈ Metric.ball a r, f b ≠ 0 := by
    by_contra hn
    apply hfzero
    filter_upwards [Metric.ball_mem_nhds a hr] with y hy
    by_contra hyne
    exact hn ⟨y, hy, hyne⟩
  have hgn : ∀ᶠ y in 𝓝 b, g y = 0 := by
    have hfn := (hball b hb).1.continuousAt.eventually_ne hfb
    filter_upwards [Metric.isOpen_ball.mem_nhds hb, hfn] with y hy hyn
    exact (mul_eq_zero.mp (hball y hy).2.2).resolve_left hyn
  have hgon : AnalyticOnNhd ℝ g (Metric.ball a r) := fun y hy => (hball y hy).2.1
  have heq := hgon.eqOn_zero_of_preconnected_of_eventuallyEq_zero
    (convex_ball a r).isPreconnected hb hgn
  filter_upwards [Metric.ball_mem_nhds a hr] with y hy
  exact heq hy

variable {n : ℕ}

lemma analyticAt_graph_eval (P : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a) :
    AnalyticAt ℝ (fun y => eval (Fin.cons (g y) y) P) a := by
  apply (Source29PolynomialLinkChart.analyticAt_eval_real P _).comp
  apply AnalyticAt.pi
  intro i
  exact Fin.cases hg (fun j =>
    (ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ).analyticAt a) i

/-- Some irreducible divisor vanishes on any analytic graph germ carried by
a nonzero polynomial. The polynomial need not be regular on that graph. -/
theorem exists_irreducible_graph_factor (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : F ≠ 0) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) F = 0) :
    ∃ p : MvPolynomial (Fin (n+1)) ℝ, Irreducible p ∧ p ∣ F ∧
      ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) p = 0 := by
  induction F using WfDvdMonoid.induction_on_irreducible with
  | zero => exact (hF rfl).elim
  | unit u hu =>
      have hn : eval (Fin.cons (g a) a) u ≠ 0 :=
        isUnit_iff_ne_zero.mp (hu.map (eval (Fin.cons (g a) a)))
      exact (hn hroot.self_of_nhds).elim
  | mul q p hq hp ih =>
      have he : ∀ᶠ y in 𝓝 a,
          eval (Fin.cons (g y) y) p * eval (Fin.cons (g y) y) q = 0 := by
        simpa only [map_mul] using hroot
      rcases zero_germ_of_mul_zero _ _ a (analyticAt_graph_eval p g a hg)
        (analyticAt_graph_eval q g a hg) he with hpzero | hqzero
      · exact ⟨p, hp, dvd_mul_right p q, hpzero⟩
      · obtain ⟨r, hr, hrq, hrzero⟩ := ih hq hqzero
        exact ⟨r, hr, dvd_mul_of_dvd_right hrq p, hrzero⟩

/-- Choose the full multiplicity of a graph-vanishing irreducible factor. -/
theorem exists_full_graph_factor (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : F ≠ 0) (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) F = 0) :
    ∃ (p Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ),
      0 < k ∧ Irreducible p ∧ F = p^k*Q ∧ ¬ p ∣ Q ∧
      ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) p = 0 := by
  obtain ⟨p, hp, hpF, hproot⟩ := exists_irreducible_graph_factor F hF g a hg hroot
  have hfinite : FiniteMultiplicity p F := FiniteMultiplicity.of_not_isUnit hp.not_isUnit hF
  obtain ⟨Q, hfac, hnot⟩ := hfinite.exists_eq_pow_mul_and_not_dvd
  have hk : 0 < multiplicity p F := Nat.pos_of_ne_zero ((multiplicity_ne_zero hfinite).mpr hpF)
  exact ⟨p, Q, multiplicity p F, hk, hp, hfac, hnot, hproot⟩

end
end Source29AnalyticGraphFactor

/- Component: BackgroundFromNormalMultiplicity.inc -/
namespace Source29BackgroundFromNormalMultiplicity

open MvPolynomial Filter
open Source29NewtonShiftedFactorCoefficient Source29NormalShiftDerivatives
open Source29NormalShiftAlgebra
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Constant positive normal multiplicity and the cubic polynomial equation
force the analytic graph to satisfy the minimal-graph equation. -/
theorem eventually_background_eq_zero
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (g : (Fin n → ℝ) → ℝ) (a : Fin n → ℝ) (hg : AnalyticAt ℝ g a)
    (d : ℕ) (hd : 0 < d)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 a,
      (shiftedSlice F (g y) y).coeff (j : ℕ) = 0)
    (htop : (shiftedSlice F (g a) a).coeff d ≠ 0) :
    ∀ᶠ y in 𝓝 a, backgroundGraphOperator (gradient g y) (hessian g y) = 0 := by
  have hFne : F ≠ 0 := by
    intro hz
    apply htop
    simp [hz, shiftedSlice]
  have hroot : ∀ᶠ y in 𝓝 a, eval (Fin.cons (g y) y) F = 0 := by
    simpa only [shiftedSlice_coeff_zero] using hlower ⟨0, hd⟩
  obtain ⟨p, Q, k, hk, hp, hfac, hpQ, hproot⟩ :=
    Source29AnalyticGraphFactor.exists_full_graph_factor F hFne g a hg hroot
  obtain ⟨_, hnormal, _⟩ := Source29GraphRootMultiplicity.regularity_and_cofactor_nonzero
    F p Q k d hk hfac hp hpQ g a hproot htop hlower
  have hprod : Source29FactorInheritance.cubicOperator (p^k*Q) = 0 := by
    rw [← hfac]
    exact hF
  have hdiv : p ∣ Source29QuarticReuse.QuarticMinimal.leadingOperator p :=
    Source29RealLeadingFactor.real_factor_inheritance p Q k (by omega) hp hpQ hprod
  exact Source29RegularBranchBackgroundEquation.eventually_background_of_dvd
    p hdiv g a hg hproot hnormal

end
end Source29BackgroundFromNormalMultiplicity

/- Component: FlatInitialPhaseChart.inc -/
namespace Source29FlatInitialPhaseChart

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open Source29NewtonShiftedFactorCoefficient Source29GeometricPhaseChart
open Source29AffinePolynomialTransport
open scoped Topology Matrix

noncomputable section
variable {n : ℕ}

/-- Vanishing lower normal coefficients with a positive odd first coefficient
provide the actual minimal phase chart, including both oriented phase signs. -/
theorem phase_chart_of_centered_coefficients
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (hgrad : gradient g 0 = 0) (d : ℕ) (hd : Odd d)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 0,
      (shiftedSlice F (g y) y).coeff (j : ℕ) = 0)
    (htop : 0 < (shiftedSlice F (g 0) 0).coeff d) :
    HasFlatMinimalPhaseChart F 0 := by
  have hbg := Source29BackgroundFromNormalMultiplicity.eventually_background_eq_zero
    F hF g 0 hg d hd.pos hlower htop.ne'
  have hroot : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) F = 0 := by
    simpa only [shiftedSlice_coeff_zero] using hlower ⟨0, hd.pos⟩
  have hphase := Source29ShiftedAnalyticUnit.eventually_phase_equivalences
    F g d hd 0 hg hlower htop
  have hI : (1 : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) * (1 : Matrix (Fin (n+1)) (Fin (n+1)) ℝ).transpose = 1 := by simp
  have he : affineEquiv (0 : Fin (n+1) → ℝ) 1 hI F = F := by
    rw [affineEquiv_apply, Source29PolynomialTranslation.translate_zero_vector,
      Source29QuarticReuse.QuarticMinimal.changeVariables_one]
  refine ⟨1, hI, g, hg, hg0, hgrad, hbg, ?_, ?_, ?_⟩
  · rwa [he]
  · filter_upwards [hphase] with z hz
    intro hx
    rw [he]
    exact ((hz.1).mpr hx).le
  · filter_upwards [hphase] with z hz
    intro hx
    rw [he]
    exact ((hz.2).mpr hx).le

/-- A positive pure odd initial form of a cubic-equation solution produces a
flat analytic minimal phase chart; the graph and its phase signs are conclusions. -/
theorem phase_chart_of_positive_odd_initial
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    HasFlatMinimalPhaseChart F 0 := by
  obtain ⟨g, hg, hg0, hgrad, hD, hpen⟩ :=
    Source29NormalHasseCentering.exists_flat_centering F d hd.pos c hc.ne' hlow hpure
  have hinitial := Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
    F d c hlow hpure hg hg0 hD
  have hlower := Source29CenteredNewtonObstruction.lower_coefficient_germs_zero
    F g hg hgrad hF d hd c hc.ne' hinitial hpen
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  apply phase_chart_of_centered_coefficients F hF g hg hg0 hgrad d hd hlower
  rwa [htop]

/-- A chart in affine orthogonal coordinates transports to the original point. -/
theorem phase_chart_of_affine_phase_chart
    (F : MvPolynomial (Fin (n+1)) ℝ) (a : Fin (n+1) → ℝ)
    (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U * U.transpose = 1)
    (hchart : HasFlatMinimalPhaseChart (affineEquiv a U hU F) 0) :
    HasFlatMinimalPhaseChart F a := by
  obtain ⟨V, hV, g, hg, hg0, hgrad, hbg, hroot, hpos, hneg⟩ := hchart
  have hUV : (U * V) * (U * V).transpose = 1 := by
    calc
      _ = U * (V * V.transpose) * U.transpose := by
        rw [Matrix.transpose_mul]
        simp only [mul_assoc]
      _ = 1 := by rw [hV, mul_one, hU]
  have he : affineEquiv 0 V hV (affineEquiv a U hU F) =
      affineEquiv a (U * V) hUV F := by
    simp only [affineEquiv_apply, Source29PolynomialTranslation.translate_zero_vector,
      Source29QuarticReuse.QuarticMinimal.changeVariables_comp]
  refine ⟨U * V, hUV, g, hg, hg0, hgrad, hbg, ?_, ?_, ?_⟩
  · rwa [he] at hroot
  · rwa [he] at hpos
  · rwa [he] at hneg

/-- Pure positive odd initial data after a translated orthogonal change of
coordinates gives a minimal phase chart at the original point. -/
theorem phase_chart_of_affine_positive_odd_initial
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U * U.transpose = 1)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hlow : ∀ j < d, homogeneousComponent j (affineEquiv a U hU F) = 0)
    (hpure : homogeneousComponent d (affineEquiv a U hU F) = C c * (X 0)^d) :
    HasFlatMinimalPhaseChart F a := by
  apply phase_chart_of_affine_phase_chart F a U hU
  apply phase_chart_of_positive_odd_initial _ _ d hd c hc hlow hpure
  rw [leadingOperator_affineEquiv, hF, map_zero]

end
end Source29FlatInitialPhaseChart

/- Component: DifferentiablePhaseRegularity.inc -/
namespace Source29DifferentiablePhaseRegularity

open MvPolynomial Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29GeometricPhaseChart Source29AffinePolynomialTransport
open scoped Topology Matrix

noncomputable section
variable {n : ℕ}

/-- A flat differentiable description of the two phases upgrades to an
analytic minimal phase chart through the polynomial equation and calibration. -/
theorem phase_chart_of_differentiable_phase
    (F : MvPolynomial (Fin (n+1)) ℝ) (hne : F ≠ 0) (hzero : eval 0 F = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (g : (Fin n → ℝ) → ℝ) (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    HasFlatMinimalPhaseChart F 0 := by
  obtain ⟨d,c,hc,hd,hlow,hpure⟩ :=
    Source29CalibratedFlatGraphInitial.exists_pure_initial F hne hzero hcal
      g hg hg0 hD hpos hneg
  exact Source29FlatInitialPhaseChart.phase_chart_of_positive_odd_initial
    F hF d hd c hc hlow hpure

/-- The original differentiable phase graph itself is analytic near the
base point, since the polynomial has only the constructed analytic zero graph. -/
theorem analyticAt_of_differentiable_phase
    (F : MvPolynomial (Fin (n+1)) ℝ) (hne : F ≠ 0) (hzero : eval 0 F = 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (g : (Fin n → ℝ) → ℝ) (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    AnalyticAt ℝ g 0 := by
  obtain ⟨d,c,hc,hd,hlow,hpure⟩ :=
    Source29CalibratedFlatGraphInitial.exists_pure_initial F hne hzero hcal
      g hg hg0 hD hpos hneg
  obtain ⟨f,hf,hf0,hgrad,hDf,hpen⟩ :=
    Source29NormalHasseCentering.exists_flat_centering F d hd.pos c hc.ne' hlow hpure
  have hinitial := Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
    F d c hlow hpure hf hf0 hDf
  have hlower := Source29CenteredNewtonObstruction.lower_coefficient_germs_zero
    F f hf hgrad hF d hd c hc.ne' hinitial hpen
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F f d c hinitial
  have hunit := Source29ShiftedAnalyticUnit.eventually_zero_iff_normal_zero
    F f d hd.pos 0 hf hlower (by rw [htop]; exact hc.ne')
  obtain ⟨W,hW,hW0,hroot⟩ := Source29ZeroSetFactorGraph.graph_root_of_side_signs
    F g 0 hpos hneg
  have hlim : Tendsto (fun y : Fin n → ℝ => (g y-f y,y)) (𝓝 0) (𝓝 (0,0)) := by
    have h := (hg.continuousAt.sub hf.continuousAt).prodMk continuousAt_id
    simpa only [ContinuousAt, Pi.sub_apply, id_eq, hg0,hf0,sub_zero] using h
  apply hf.congr
  filter_upwards [hlim.eventually hunit, hW.mem_nhds hW0] with y hy hyW
  have hz : g y-f y = 0 := hy.mp (by simpa only [add_sub_cancel] using hroot y hyW)
  exact (sub_eq_zero.mp hz).symm

/-- The differentiable-to-analytic upgrade is invariant under orthogonal
coordinates centered at any zero of the polynomial. -/
theorem phase_chart_of_affine_differentiable_phase
    (F : MvPolynomial (Fin (n+1)) ℝ) (hne : F ≠ 0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (ha : eval a F = 0)
    (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U * U.transpose = 1)
    (g : (Fin n → ℝ) → ℝ) (hg : DifferentiableAt ℝ g 0)
    (hg0 : g 0 = 0) (hD : fderiv ℝ g 0 = 0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F))
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) (affineEquiv a U hU F) ≤ 0) :
    HasFlatMinimalPhaseChart F a := by
  apply Source29FlatInitialPhaseChart.phase_chart_of_affine_phase_chart F a U hU
  apply phase_chart_of_differentiable_phase (affineEquiv a U hU F)
    (fun h => hne ((map_eq_zero_iff (affineEquiv a U hU) (affineEquiv a U hU).injective).mp h))
    (by rwa [eval_zero_affineEquiv])
    (by rw [leadingOperator_affineEquiv,hF,map_zero])
    (affine_weakCalibration F hcal a U hU) g hg hg0 hD hpos hneg

end
end Source29DifferentiablePhaseRegularity

/- Component: FlatInitialExactGraph.inc -/
namespace Source29FlatInitialExactGraph

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open Source29NewtonShiftedFactorCoefficient
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Lower coefficient vanishing identifies both phases and the entire zero
set with the center graph in the original, unshifted normal coordinate. -/
theorem eventually_exact_graph_of_centered_coefficients
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0 = 0)
    (d : ℕ) (hd : Odd d)
    (hlower : ∀ j : Fin d, ∀ᶠ y in 𝓝 0,
      (shiftedSlice F (g y) y).coeff (j : ℕ) = 0)
    (htop : 0 < (shiftedSlice F (g 0) 0).coeff d) :
    ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      (eval (Fin.cons z.1 z.2) F = 0 ↔ z.1 = g z.2) ∧
      (0 < eval (Fin.cons z.1 z.2) F ↔ g z.2 < z.1) ∧
      (eval (Fin.cons z.1 z.2) F < 0 ↔ z.1 < g z.2) := by
  have hzero := Source29ShiftedAnalyticUnit.eventually_zero_iff_normal_zero
    F g d hd.pos 0 hg hlower htop.ne'
  have hphase := Source29ShiftedAnalyticUnit.eventually_phase_equivalences
    F g d hd 0 hg hlower htop
  have hgs : ContinuousAt (fun z : ℝ × (Fin n → ℝ) => g z.2) 0 :=
    ContinuousAt.comp (f := fun z : ℝ × (Fin n → ℝ) => z.2) (x := 0)
      hg.continuousAt continuousAt_snd
  have hcont : ContinuousAt (fun z : ℝ × (Fin n → ℝ) => (z.1 - g z.2, z.2)) 0 :=
    (continuousAt_fst.sub hgs).prodMk continuousAt_snd
  have ht : Tendsto (fun z : ℝ × (Fin n → ℝ) => (z.1 - g z.2, z.2))
      (𝓝 0) (𝓝 (0, (0 : Fin n → ℝ))) := by
    simpa only [Prod.fst_zero, Prod.snd_zero, hg0, sub_self] using hcont.tendsto
  filter_upwards [ht.eventually hzero, ht.eventually hphase] with z hz hp
  have he : g z.2 + (z.1 - g z.2) = z.1 := by ring
  simpa only [he, sub_eq_zero, sub_pos, sub_neg] using And.intro hz hp

/-- The pure positive odd initial term yields an actual analytic minimal
graph and exact local descriptions of its zero set and both phases. -/
theorem exists_exact_minimal_graph_of_positive_odd_initial
    (F : MvPolynomial (Fin (n+1)) ℝ)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F = 0)
    (d : ℕ) (hd : Odd d) (c : ℝ) (hc : 0 < c)
    (hlow : ∀ j < d, homogeneousComponent j F = 0)
    (hpure : homogeneousComponent d F = C c * (X 0)^d) :
    ∃ g : (Fin n → ℝ) → ℝ,
      AnalyticAt ℝ g 0 ∧ g 0 = 0 ∧ gradient g 0 = 0 ∧
      (∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y) = 0) ∧
      (∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
        (eval (Fin.cons z.1 z.2) F = 0 ↔ z.1 = g z.2) ∧
        (0 < eval (Fin.cons z.1 z.2) F ↔ g z.2 < z.1) ∧
        (eval (Fin.cons z.1 z.2) F < 0 ↔ z.1 < g z.2)) := by
  obtain ⟨g, hg, hg0, hgrad, hD, hpen⟩ :=
    Source29NormalHasseCentering.exists_flat_centering F d hd.pos c hc.ne' hlow hpure
  have hinitial := Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
    F d c hlow hpure hg hg0 hD
  have hlower := Source29CenteredNewtonObstruction.lower_coefficient_germs_zero
    F g hg hgrad hF d hd c hc.ne' hinitial hpen
  have htop : 0 < (shiftedSlice F (g 0) 0).coeff d := by
    rw [Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial F g d c hinitial]
    exact hc
  exact ⟨g, hg, hg0, hgrad,
    Source29BackgroundFromNormalMultiplicity.eventually_background_eq_zero
      F hF g 0 hg d hd.pos hlower htop.ne',
    eventually_exact_graph_of_centered_coefficients F g hg hg0 d hd hlower htop⟩

end
end Source29FlatInitialExactGraph

/- Component: RadialInitialSplitting.inc -/
namespace Source29RadialInitialSplitting

open MvPolynomial
open Source29PolynomialTranslation Source29QuarticReuse
open scoped BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι]

/-- The Euler operator acts diagonally on the homogeneous decomposition. -/
lemma euler_eq_sum_homogeneous (P : MvPolynomial ι ℝ) :
    (∑ i, X i * pderiv i P) =
      ∑ k ∈ Finset.range (P.totalDegree+1), k • homogeneousComponent k P := by
  classical
  calc
    (∑ i, X i * pderiv i P) =
        ∑ i, ∑ k ∈ Finset.range (P.totalDegree+1), X i * pderiv i (homogeneousComponent k P) := by
      conv_lhs => rw [← sum_homogeneousComponent P]
      simp only [map_sum, Finset.mul_sum]
    _ = ∑ k ∈ Finset.range (P.totalDegree+1), ∑ i, X i * pderiv i (homogeneousComponent k P) :=
      Finset.sum_comm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro k _
      exact QuarticCompatibility.sum_X_mul_pderiv (homogeneousComponent_isHomogeneous k P)

lemma homogeneousComponent_euler_zero (P : MvPolynomial ι ℝ) (s : ℕ)
    (hzero : homogeneousComponent s P = 0) :
    homogeneousComponent s (∑ i, X i * pderiv i P) = 0 := by
  classical
  rw [euler_eq_sum_homogeneous, map_sum]
  apply Finset.sum_eq_zero
  intro k _
  rw [map_nsmul]
  by_cases hsk : s = k
  · subst k
    rw [homogeneousComponent_eq_self (homogeneousComponent_isHomogeneous s P), hzero, nsmul_zero]
  · rw [homogeneousComponent_of_mem (homogeneousComponent_mem k P), ite_eq_right hsk, nsmul_zero]

/-- The translated Euler identity separates the radial and centered directions. -/
theorem translated_euler (H : MvPolynomial ι ℝ) (d : ℕ) (hH : H.IsHomogeneous d)
    (a : ι → ℝ) :
    (∑ i, X i * pderiv i (translate H a)) +
      (∑ i, C (a i) * pderiv i (translate H a)) = d • translate H a := by
  classical
  have he := congrArg (fun P : MvPolynomial ι ℝ => translate P a)
    (QuarticCompatibility.sum_X_mul_pderiv hH)
  simpa only [translate_sum, translate_mul, translate_X, ← pderiv_translate,
    add_mul, Finset.sum_add_distrib, nsmul_eq_mul, translate_C,
    show (d : MvPolynomial ι ℝ) = C (d : ℝ) by simp] using he

/-- If the preceding Taylor degree is absent, the next homogeneous term
has zero derivative in the radial direction through the expansion point. -/
theorem radial_derivative_eq_zero (H : MvPolynomial ι ℝ) (d : ℕ)
    (hH : H.IsHomogeneous d) (a : ι → ℝ) (s : ℕ)
    (hprevious : homogeneousComponent s (translate H a) = 0) :
    (∑ i, C (a i) * pderiv i (homogeneousComponent (s+1) (translate H a))) = 0 := by
  classical
  have he := congrArg (homogeneousComponent s) (translated_euler H d hH a)
  rw [map_add, homogeneousComponent_euler_zero _ s hprevious, zero_add,
    map_sum, map_nsmul, hprevious, nsmul_zero] at he
  simpa only [homogeneousComponent_C_mul,
    ← QuarticPolynomialBasics.pderiv_homogeneousComponent] using he

/-- A polynomial with a vanishing constant directional derivative is
constant on every affine line in that direction. -/
theorem eval_add_smul_eq_of_directional_derivative_zero (P : MvPolynomial ι ℝ)
    (a : ι → ℝ) (hdir : (∑ i, C (a i) * pderiv i P) = 0)
    (y : ι → ℝ) (t : ℝ) : eval (fun i => y i + t*a i) P = eval y P := by
  classical
  let γ : ι → ℝ → ℝ := fun i s => y i + s*a i
  have hγ (s : ℝ) (i : ι) : AnalyticAt ℝ (γ i) s :=
    analyticAt_const.add (analyticAt_id.mul analyticAt_const)
  have hf : Differentiable ℝ (fun s => eval (fun i => γ i s) P) :=
    fun s => (Source29RealPolynomialCurveJets.analytic_eval_curve P γ s (hγ s)).differentiableAt
  have hd (s : ℝ) : deriv (fun r => eval (fun i => γ i r) P) s = 0 := by
    rw [Source29RealPolynomialCurveJets.first_deriv_eval_curve P γ s (hγ s)]
    have he := congrArg (eval (fun i => γ i s)) hdir
    simpa only [γ, Source29NewtonRootHarmonic.deriv_affine,
      map_sum, map_mul, eval_C, map_zero, mul_comm] using he
  have he := is_const_of_deriv_eq_zero hf hd t 0
  simpa only [γ, zero_mul, add_zero] using he

theorem translate_eq_of_directional_derivative_zero (P : MvPolynomial ι ℝ)
    (a : ι → ℝ) (hdir : (∑ i, C (a i) * pderiv i P) = 0) (t : ℝ) :
    translate P (fun i => t*a i) = P := by
  classical
  apply QuarticCompatibility.polynomial_funext
  intro y
  rw [eval_translate]
  simpa only [add_comm] using eval_add_smul_eq_of_directional_derivative_zero P a hdir y t

/-- Every first nonzero Taylor form of a homogeneous polynomial is invariant
under all translations along the radial direction of its base point. -/
theorem initial_translate_eq (H : MvPolynomial ι ℝ) (d : ℕ)
    (hH : H.IsHomogeneous d) (a : ι → ℝ) (s : ℕ)
    (hprevious : homogeneousComponent s (translate H a) = 0) (t : ℝ) :
    translate (homogeneousComponent (s+1) (translate H a)) (fun i => t*a i) =
      homogeneousComponent (s+1) (translate H a) :=
  translate_eq_of_directional_derivative_zero _ a (radial_derivative_eq_zero H d hH a s hprevious) t

/-- At a nonzero zero, there is a nonzero positive-degree initial polynomial
with an actual nontrivial translation-invariance direction. -/
theorem exists_nonzero_radial_initial (H : MvPolynomial ι ℝ) (d : ℕ)
    (hH : H.IsHomogeneous d) (hne : H ≠ 0) (a : ι → ℝ)
    (ha : a ≠ 0) (hzero : eval a H = 0) :
    ∃ s : ℕ, 0 < s ∧ s ≤ (translate H a).totalDegree ∧
      homogeneousComponent s (translate H a) ≠ 0 ∧
      (homogeneousComponent s (translate H a)).IsHomogeneous s ∧
      a ≠ 0 ∧ (∀ k < s, homogeneousComponent k (translate H a) = 0) ∧
      (∀ t : ℝ, translate (homogeneousComponent s (translate H a)) (fun i => t*a i) =
        homogeneousComponent s (translate H a)) := by
  classical
  obtain ⟨s,hs,hdegree,hne',hlow⟩ := exists_lowest_component_at_root H hne a hzero
  refine ⟨s,hs,hdegree,hne',homogeneousComponent_isHomogeneous s _,ha,hlow,?_⟩
  obtain ⟨j,rfl⟩ := Nat.exists_eq_succ_of_ne_zero hs.ne'
  intro t
  exact initial_translate_eq H d hH a j (hlow j (by omega)) t

end
end Source29RadialInitialSplitting

/- Component: RadialCoordinateReduction.inc -/
namespace Source29RadialCoordinateReduction

open MvPolynomial Matrix
open Source29QuarticReuse.QuarticMinimal
open Source29QuarticReuse.QuarticMinimal.DistinguishedVariable
open Source29LinearNormalRotation Source29QuarticReuse.FluxObstruction
open scoped BigOperators

noncomputable section
variable {n : ℕ}

lemma finSuccEquiv_rename_succ (R : MvPolynomial (Fin n) ℝ) :
    finSuccEquiv ℝ n (rename Fin.succ R) = Polynomial.C R := by
  induction R using MvPolynomial.induction_on with
  | C c => simp only [rename_C, finSuccEquiv_apply, eval₂Hom_C, RingHom.comp_apply]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P i hP => simp only [map_mul, rename_X, finSuccEquiv_X_succ, hP]

/-- A vanishing first partial derivative removes that coordinate algebraically. -/
theorem exists_rename_succ_of_pderiv_zero (P : MvPolynomial (Fin (n+1)) ℝ)
    (hP : pderiv 0 P = 0) :
    ∃ R : MvPolynomial (Fin n) ℝ, P = rename Fin.succ R := by
  have hd : (finSuccEquiv ℝ n P).derivative = 0 := by
    rw [← finSuccEquiv_pderiv_zero, hP, map_zero]
  refine ⟨(finSuccEquiv ℝ n P).coeff 0, ?_⟩
  apply (finSuccEquiv ℝ n).injective
  rw [finSuccEquiv_rename_succ]
  exact Polynomial.eq_C_of_derivative_eq_zero hd

lemma changeVariables_C_scalar (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (c : ℝ) :
    changeVariables U (C c) = C c := by simp [changeVariables]

/-- A rotation whose first column is the radial unit vector kills the
first partial of a polynomial constant in that radial direction. -/
theorem pderiv_zero_of_radial_column (P : MvPolynomial (Fin (n+1)) ℝ)
    (a : Fin (n+1) → ℝ) (hdir : (∑ i, C (a i) * pderiv i P) = 0)
    (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hcol : ∀ i, U i 0 = unitVector a i) : pderiv 0 (changeVariables U P) = 0 := by
  rw [pderiv_changeVariables]
  have he := congrArg (changeVariables U) hdir
  have hr : (∑ i, changeVariables U (pderiv i P) * C (U i 0)) =
      C ((Real.sqrt (radiusSq a))⁻¹) * changeVariables U (∑ i, C (a i) * pderiv i P) := by
    rw [map_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [hcol, unitVector, div_eq_mul_inv, map_mul, map_mul, changeVariables_C_scalar]
    ring
  rw [hr, he, map_zero, mul_zero]

/-- Adding an unused coordinate preserves the cubic level-set operator. -/
theorem leadingOperator_rename_succ (R : MvPolynomial (Fin n) ℝ) :
    leadingOperator (rename Fin.succ R) = rename Fin.succ (leadingOperator R) := by
  simp only [leadingOperator, laplacian, Fin.sum_univ_succ,
    Source29NewtonWeightedFace.pderiv_zero_rename_succ, pderiv_rename (Fin.succ_injective n),
    map_sub, map_mul, map_pow, map_sum, map_zero, zero_pow (by decide : 2 ≠ 0),
    zero_mul, mul_zero, zero_add, Finset.sum_const_zero]

/-- A homogeneous polynomial with a nontrivial constant invariance direction
is the orthogonal lift of a nonzero polynomial in one fewer variables. -/
theorem exists_orthogonal_reduction (P : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (hP : P.IsHomogeneous d) (hne : P ≠ 0)
    (a : Fin (n+1) → ℝ) (ha : a ≠ 0) (hdir : (∑ i, C (a i) * pderiv i P) = 0) :
    ∃ (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (R : MvPolynomial (Fin n) ℝ),
      U.transpose * U = 1 ∧ U * U.transpose = 1 ∧
      (∀ i, U i 0 = unitVector a i) ∧ changeVariables U P = rename Fin.succ R ∧
      R ≠ 0 ∧ R.IsHomogeneous d ∧
      (leadingOperator P = 0 → leadingOperator R = 0) ∧
      (∀ x : Fin (n+1) → ℝ, eval (U *ᵥ x) P = eval (fun i => x i.succ) R) := by
  obtain ⟨U,hUt,hU,hcol⟩ := exists_rotation a ha
  obtain ⟨R,hR⟩ := exists_rename_succ_of_pderiv_zero (changeVariables U P)
    (pderiv_zero_of_radial_column P a hdir U hcol)
  have hRne : R ≠ 0 := by
    intro hz
    apply hne
    apply changeVariables_injective U hU
    simp only [hR, hz, map_zero]
  have hRhom : R.IsHomogeneous d := by
    have hh := isHomogeneous_changeVariables U P d hP
    rw [hR] at hh
    exact (IsHomogeneous.rename_isHomogeneous_iff (Fin.succ_injective n)).mp hh
  refine ⟨U,R,hUt,hU,hcol,hR,hRne,hRhom,?_,?_⟩
  · intro hL
    have he := leadingOperator_changeVariables_eq_zero U hU P hL
    rw [hR, leadingOperator_rename_succ] at he
    apply rename_injective Fin.succ (Fin.succ_injective n)
    simpa only [map_zero] using he
  · intro x
    rw [← eval_changeVariables, hR, eval_rename]
    rfl

/-- Radial invariance of the first Taylor form gives an actual reduction
from n+1 coordinates to n coordinates. -/
theorem initial_orthogonal_reduction (H : MvPolynomial (Fin (n+1)) ℝ)
    (d : ℕ) (hH : H.IsHomogeneous d) (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    (s : ℕ) (hprevious : homogeneousComponent s (Source29PolynomialTranslation.translate H a) = 0)
    (hne : homogeneousComponent (s+1) (Source29PolynomialTranslation.translate H a) ≠ 0) :
    ∃ (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (R : MvPolynomial (Fin n) ℝ),
      U.transpose * U = 1 ∧ U * U.transpose = 1 ∧
      changeVariables U (homogeneousComponent (s+1) (Source29PolynomialTranslation.translate H a)) =
        rename Fin.succ R ∧ R ≠ 0 ∧ R.IsHomogeneous (s+1) ∧
      (leadingOperator (homogeneousComponent (s+1) (Source29PolynomialTranslation.translate H a)) = 0 →
        leadingOperator R = 0) := by
  obtain ⟨U,R,hUt,hU,_,hR,hRn,hRh,hL,_⟩ := exists_orthogonal_reduction
    (homogeneousComponent (s+1) (Source29PolynomialTranslation.translate H a)) (s+1)
    (homogeneousComponent_isHomogeneous _ _) hne a ha
    (Source29RadialInitialSplitting.radial_derivative_eq_zero H d hH a s hprevious)
  exact ⟨U,R,hUt,hU,hR,hRn,hRh,hL⟩

end
end Source29RadialCoordinateReduction

/- Component: InitialLeadingOperator.inc -/
namespace Source29InitialLeadingOperator

open MvPolynomial Filter
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticPolynomialBasics
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29RealLowestRescale Source29InitialGradientLimit
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def cubic (g : Fin n → ℝ) (h : Fin n → Fin n → ℝ) : ℝ :=
  (∑ i, (g i)^2) * (∑ i, h i i) - ∑ i, ∑ j, g i*g j*h i j

lemma cubic_scale (g : Fin n → ℝ) (h : Fin n → Fin n → ℝ) (a b : ℝ) :
    cubic (fun i => a*g i) (fun i j => b*h i j) = a^2*b*cubic g h := by
  have h1 : (∑ i, (a*g i)^2) = a^2*(∑ i, (g i)^2) := by
    simp only [mul_pow, Finset.mul_sum]
  have h2 : (∑ i, b*h i i) = b*(∑ i, h i i) := (Finset.mul_sum ..).symm
  have h3 : (∑ i, ∑ j, (a*g i)*(a*g j)*(b*h i j)) =
      a^2*b*(∑ i, ∑ j, g i*g j*h i j) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  unfold cubic
  rw [h1,h2,h3]
  ring

lemma eval_leadingOperator (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    eval x (leadingOperator P) =
      cubic (fun i => eval x (pderiv i P)) (fun i j => eval x (pderiv i (pderiv j P))) := by
  simp only [leadingOperator, laplacian, cubic, map_sub, map_mul, map_sum, map_pow]

lemma cubic_tendsto {β : Type*} {l : Filter β}
    {g : β → Fin n → ℝ} {h : β → Fin n → Fin n → ℝ}
    {g0 : Fin n → ℝ} {h0 : Fin n → Fin n → ℝ}
    (hg : ∀ i, Tendsto (fun t => g t i) l (𝓝 (g0 i)))
    (hh : ∀ i j, Tendsto (fun t => h t i j) l (𝓝 (h0 i j))) :
    Tendsto (fun t => cubic (g t) (h t)) l (𝓝 (cubic g0 h0)) := by
  exact ((tendsto_finsetSum _ (fun i _ => (hg i).pow 2)).mul
    (tendsto_finsetSum _ (fun i _ => hh i i))).sub
    (tendsto_finsetSum _ (fun i _ => tendsto_finsetSum _ (fun j _ =>
      ((hg i).mul (hg j)).mul (hh i j))))

lemma second_pderiv_lowest_components (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s+2, homogeneousComponent k P = 0) (i j : Fin n) :
    ∀ k < s, homogeneousComponent k (pderiv i (pderiv j P)) = 0 :=
  pderiv_lowest_components (pderiv j P) s (pderiv_lowest_components P (s+1) hlow j) i

lemma rescaled_hessian_tendsto (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s+2, homogeneousComponent k P = 0) (x : Fin n → ℝ) (i j : Fin n) :
    Tendsto (fun t : ℝ => eval x (rescale (pderiv i (pderiv j P)) s t)) (𝓝 0)
      (𝓝 (eval x (pderiv i (pderiv j (homogeneousComponent (s+2) P))))) := by
  have hh := rescaled_gradient_tendsto (pderiv j P) s
    (pderiv_lowest_components P (s+1) hlow j) x i
  simpa only [evaluatedGradient, ← pderiv_homogeneousComponent] using hh

/-- Exact scaling of the cubic equation in the rescaled first and second jets. -/
theorem scaled_leadingOperator (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s+2, homogeneousComponent k P = 0) (x : Fin n → ℝ) (t : ℝ) :
    eval (fun i => t*x i) (leadingOperator P) = (t^(s+1))^2*t^s *
      cubic (fun i => eval x (rescale (pderiv i P) (s+1) t))
        (fun i j => eval x (rescale (pderiv i (pderiv j P)) s t)) := by
  have hg (i : Fin n) : eval (fun i => t*x i) (pderiv i P) =
      t^(s+1)*eval x (rescale (pderiv i P) (s+1) t) :=
    (eval_rescale_mul (pderiv i P) (s+1) (pderiv_lowest_components P (s+1) hlow i) t x).symm
  have hh (i j : Fin n) : eval (fun i => t*x i) (pderiv i (pderiv j P)) =
      t^s*eval x (rescale (pderiv i (pderiv j P)) s t) :=
    (eval_rescale_mul _ s (second_pderiv_lowest_components P s hlow i j) t x).symm
  rw [eval_leadingOperator]
  simp only [hg,hh]
  exact cubic_scale _ _ _ _

/-- The first possible homogeneous term of degree at least two inherits L=0. -/
theorem leadingOperator_initial_succ_succ (P : MvPolynomial (Fin n) ℝ)
    (hL : leadingOperator P = 0) (s : ℕ)
    (hlow : ∀ k < s+2, homogeneousComponent k P = 0) :
    leadingOperator (homogeneousComponent (s+2) P) = 0 := by
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro x
  rw [map_zero, eval_leadingOperator]
  let t : ℕ → ℝ := fun k => (dilationRadius k)⁻¹
  have ht (k : ℕ) : 0 < t k := inv_pos.mpr (dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) := tendsto_inv_atTop_zero.comp dilationRadius_tendsto
  have hzero (k : ℕ) :
      cubic (fun i => eval x (rescale (pderiv i P) (s+1) (t k)))
        (fun i j => eval x (rescale (pderiv i (pderiv j P)) s (t k))) = 0 := by
    have he := scaled_leadingOperator P s hlow x (t k)
    rw [hL, map_zero] at he
    exact (mul_eq_zero.mp he.symm).resolve_left
      (mul_ne_zero (pow_ne_zero 2 (pow_ne_zero (s+1) (ht k).ne')) (pow_ne_zero s (ht k).ne'))
  have hlim := cubic_tendsto
    (fun i => (rescaled_gradient_tendsto P (s+1) hlow x i).comp ht0)
    (fun i j => (rescaled_hessian_tendsto P s hlow x i j).comp ht0)
  exact tendsto_nhds_unique hlim (by simpa only [Function.comp_def, hzero] using
    (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0)))

/-- Vanishing lower homogeneous components suffices; nonvanishing of the
selected component is not required. This includes degrees zero and one. -/
theorem leadingOperator_initial (P : MvPolynomial (Fin n) ℝ)
    (hL : leadingOperator P = 0) (d : ℕ)
    (hlow : ∀ k < d, homogeneousComponent k P = 0) :
    leadingOperator (homogeneousComponent d P) = 0 := by
  by_cases hd : d ≤ 1
  · have hdegree : (homogeneousComponent d P).totalDegree ≤ 1 :=
      (homogeneousComponent_isHomogeneous d P).totalDegree_le.trans hd
    have hh := second_partials_zero_of_totalDegree_le_one _ hdegree
    simp only [leadingOperator, laplacian, hh, Finset.sum_const_zero, mul_zero, sub_zero]
  · obtain ⟨s,hs⟩ : ∃ s, d = s+2 := ⟨d-2, by omega⟩
    subst d
    exact leadingOperator_initial_succ_succ P hL s hlow

/-- The initial equation is available at every expansion center, before any
regularity or nonvanishing-gradient conclusion. -/
theorem leadingOperator_initial_at (P : MvPolynomial (Fin n) ℝ)
    (hL : leadingOperator P = 0) (a : Fin n → ℝ) (d : ℕ)
    (hlow : ∀ k < d, homogeneousComponent k (Source29PolynomialTranslation.translate P a) = 0) :
    leadingOperator (homogeneousComponent d (Source29PolynomialTranslation.translate P a)) = 0 := by
  apply leadingOperator_initial _ ?_ d hlow
  rw [Source29AffinePolynomialTransport.leadingOperator_translate, hL,
    Source29PolynomialTranslation.translate_zero_polynomial]

end
end Source29InitialLeadingOperator

/- Component: SynchronizedCurveFrankel.inc -/
namespace Source29SynchronizedCurveFrankel

open Filter
open Source29AnalyticNormDerivatives Source29RealAnalyticMaximum
open scoped Topology BigOperators

noncomputable section
variable {κ ι : Type*} [Fintype κ] [Fintype ι]

/-- Squared Euclidean distance in coordinates; this does not use the
supremum norm instance on a finite function space. -/
def squaredDistance (x y : κ → ℝ) : ℝ := ∑ a, (x a-y a)^2

lemma squaredDistance_pos {x y : κ → ℝ} (hne : x ≠ y) : 0 < squaredDistance x y := by
  classical
  obtain ⟨a,ha⟩ : ∃ a, x a ≠ y a := Function.ne_iff.mp hne
  exact Finset.sum_pos' (fun a _ ↦ sq_nonneg _) ⟨a,Finset.mem_univ a,
    sq_pos_of_ne_zero (sub_ne_zero.mpr ha)⟩

lemma second_deriv_nonneg (f : ℝ → ℝ) (hf : AnalyticAt ℝ f 0)
    (hmin : IsLocalMin f 0) : 0 ≤ deriv (deriv f) 0 := by
  have hmax : IsLocalMax (fun t ↦ -f t) 0 := by
    filter_upwards [hmin] with t ht
    exact neg_le_neg ht
  have hn := second_deriv_nonpos (fun t ↦ -f t) hf.neg hmax
  have hd : deriv (deriv (fun t ↦ -f t)) 0 = -deriv (deriv f) 0 := by
    simpa only [zero_mul,one_mul,zero_sub] using
      second_deriv_linear_combination (fun _ : ℝ ↦ (0 : ℝ)) f analyticAt_const hf 0 1
  rw [hd] at hn
  linarith

/-- Equal first velocities cancel the velocity-square term in the second
variation of the actual squared Euclidean distance. -/
theorem second_deriv_squaredDistance
    (u v : ℝ → κ → ℝ)
    (hu : ∀ a, AnalyticAt ℝ (fun t ↦ u t a) 0)
    (hv : ∀ a, AnalyticAt ℝ (fun t ↦ v t a) 0)
    (hvelocity : ∀ a, deriv (fun t ↦ u t a) 0 = deriv (fun t ↦ v t a) 0) :
    deriv (deriv (fun t ↦ squaredDistance (u t) (v t))) 0 =
      2 * ∑ a, (u 0 a-v 0 a) *
        (deriv (deriv (fun t ↦ u t a)) 0-deriv (deriv (fun t ↦ v t a)) 0) := by
  unfold squaredDistance
  rw [second_deriv_sum (fun a t ↦ (u t a-v t a)^2)
    (fun a ↦ ((hu a).sub (hv a)).pow 2),Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [second_deriv_square (fun t ↦ u t a-v t a) ((hu a).sub (hv a))]
  have hfirst : deriv (fun t ↦ u t a-v t a) 0 = 0 := by
    change deriv ((fun t ↦ u t a)-(fun t ↦ v t a)) 0 = 0
    rw [deriv_sub (hu a).differentiableAt (hv a).differentiableAt,hvelocity,sub_self]
  have hsecond : deriv (deriv (fun t ↦ u t a-v t a)) 0 =
      deriv (deriv (fun t ↦ u t a)) 0-deriv (deriv (fun t ↦ v t a)) 0 := by
    simpa only [one_mul] using
      second_deriv_linear_combination (fun t ↦ u t a) (fun t ↦ v t a) (hu a) (hv a) 1 1
  rw [hfirst,hsecond]
  ring

/-- The mean acceleration identities of minimal spherical links make the
sum of synchronized distance second variations strictly negative. -/
theorem sum_second_deriv_squaredDistance
    (u v : ι → ℝ → κ → ℝ) (x y : κ → ℝ) (m : ℝ)
    (hu : ∀ i a, AnalyticAt ℝ (fun t ↦ u i t a) 0)
    (hv : ∀ i a, AnalyticAt ℝ (fun t ↦ v i t a) 0)
    (hu0 : ∀ i, u i 0 = x) (hv0 : ∀ i, v i 0 = y)
    (hvelocity : ∀ i a, deriv (fun t ↦ u i t a) 0 = deriv (fun t ↦ v i t a) 0)
    (huacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ u i t a)) 0) = -m*x a)
    (hvacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ v i t a)) 0) = -m*y a) :
    (∑ i, deriv (deriv (fun t ↦ squaredDistance (u i t) (v i t))) 0) =
      -2*m*squaredDistance x y := by
  simp_rw [second_deriv_squaredDistance _ _ (hu _) (hv _) (hvelocity _),hu0,hv0]
  rw [← Finset.mul_sum,Finset.sum_comm]
  have hs : (∑ a, ∑ i, (x a-y a)*
      (deriv (deriv (fun t ↦ u i t a)) 0-deriv (deriv (fun t ↦ v i t a)) 0)) =
      ∑ a, -m*(x a-y a)^2 := by
    apply Finset.sum_congr rfl
    intro a _
    rw [← Finset.mul_sum,Finset.sum_sub_distrib,huacc,hvacc]
    ring
  rw [hs,← Finset.mul_sum]
  unfold squaredDistance
  ring

/-- The local spherical Frankel contradiction, expressed through actual
analytic curves. Matching velocities and minimal-link mean accelerations
exclude a distinct closest pair. -/
theorem eq_of_synchronized_local_minima
    (u v : ι → ℝ → κ → ℝ) (x y : κ → ℝ) (m : ℝ) (hm : 0 < m)
    (hu : ∀ i a, AnalyticAt ℝ (fun t ↦ u i t a) 0)
    (hv : ∀ i a, AnalyticAt ℝ (fun t ↦ v i t a) 0)
    (hu0 : ∀ i, u i 0 = x) (hv0 : ∀ i, v i 0 = y)
    (hvelocity : ∀ i a, deriv (fun t ↦ u i t a) 0 = deriv (fun t ↦ v i t a) 0)
    (huacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ u i t a)) 0) = -m*x a)
    (hvacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ v i t a)) 0) = -m*y a)
    (hmin : ∀ i, IsLocalMin (fun t ↦ squaredDistance (u i t) (v i t)) 0) : x = y := by
  by_contra hne
  have hnonneg : 0 ≤ ∑ i, deriv (deriv (fun t ↦ squaredDistance (u i t) (v i t))) 0 := by
    apply Finset.sum_nonneg
    intro i _
    apply second_deriv_nonneg _ _ (hmin i)
    exact Finset.univ.analyticAt_fun_sum (f := fun a t ↦ (u i t a-v i t a)^2)
      (fun a _ ↦ ((hu i a).sub (hv i a)).pow 2)
  rw [sum_second_deriv_squaredDistance u v x y m hu hv hu0 hv0 hvelocity huacc hvacc] at hnonneg
  have hp := mul_pos hm (squaredDistance_pos hne)
  nlinarith

/-- Set-level use at a closest pair: local curve membership supplies every
required local minimum of squared Euclidean distance. -/
theorem eq_of_closest_pair
    (S T : Set (κ → ℝ)) (x y : κ → ℝ)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (u v : ι → ℝ → κ → ℝ) (m : ℝ) (hm : 0 < m)
    (hu : ∀ i a, AnalyticAt ℝ (fun t ↦ u i t a) 0)
    (hv : ∀ i a, AnalyticAt ℝ (fun t ↦ v i t a) 0)
    (hu0 : ∀ i, u i 0 = x) (hv0 : ∀ i, v i 0 = y)
    (hvelocity : ∀ i a, deriv (fun t ↦ u i t a) 0 = deriv (fun t ↦ v i t a) 0)
    (huacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ u i t a)) 0) = -m*x a)
    (hvacc : ∀ a, (∑ i, deriv (deriv (fun t ↦ v i t a)) 0) = -m*y a)
    (huS : ∀ i, ∀ᶠ t in 𝓝 0, u i t ∈ S)
    (hvT : ∀ i, ∀ᶠ t in 𝓝 0, v i t ∈ T) : x = y := by
  apply eq_of_synchronized_local_minima u v x y m hm hu hv hu0 hv0 hvelocity huacc hvacc
  intro i
  change ∀ᶠ t in 𝓝 0, squaredDistance (u i 0) (v i 0) ≤ squaredDistance (u i t) (v i t)
  filter_upwards [huS i,hvT i] with t ht hs
  rw [hu0,hv0]
  exact hclosest _ ht _ hs

end
end Source29SynchronizedCurveFrankel

/- Component: RegularLinkMeanAcceleration.inc -/
namespace Source29RegularLinkMeanAcceleration

open Filter MvPolynomial Source29FactorInheritance Source29PolynomialLinkChart
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Pointwise minimality suffices for the tangential Hessian trace identity. -/
lemma tangential_trace_zero_at {κ : Type*} [Fintype κ]
    (P : MvPolynomial (Option κ) ℝ) (x : Option κ → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hL : eval x (cubicOperator P) = 0)
    (hgn : eval x (pderiv none P) = g)
    (hgt : ∀ j, eval x (pderiv (some j) P) = 0) :
    (∑ j, eval x (pderiv (some j) (pderiv (some j) P))) = 0 := by
  have he := hL
  simp [cubicOperator,Fintype.sum_option,hgn,hgt] at he
  have hh : g^2 * (∑ j, eval x (pderiv (some j) (pderiv (some j) P))) = 0 := by
    nlinarith [he]
  exact (mul_eq_zero.mp hh).resolve_left (pow_ne_zero 2 hg)

/-- The actual regular-link curves have the mean acceleration of a minimal
sphere hypersurface. Pointwise vanishing of the cubic operator is sufficient. -/
theorem exists_regular_link_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hd : 1 ≤ d)
    (hhom : P.IsHomogeneous d) (g : ℝ) (hg : g ≠ 0)
    (hP : eval base P = 0) (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (hL : eval base (cubicOperator P) = 0) :
    ∃ γ : ι → ℝ → Option (Option ι) → ℝ,
      (∀ i a, AnalyticAt ℝ (fun t ↦ γ i t a) 0) ∧
      (∀ i, γ i 0 = base) ∧
      (∀ i, ∀ᶠ t in 𝓝 0, eval (γ i t) P = 0) ∧
      (∀ i, ∀ᶠ t in 𝓝 0, (∑ a, (γ i t a)^2) = 1) ∧
      (∀ i a, deriv (fun t ↦ γ i t a) 0 = Pi.single (M := fun _ ↦ ℝ) (some (some i)) 1 a) ∧
      (∀ a, (∑ i, deriv (deriv (fun t ↦ γ i t a)) 0) = -(Fintype.card ι : ℝ)*base a) := by
  have hrad : eval base (pderiv (some none) (pderiv (some none) P)) = 0 := by
    have hr := Source29HomogeneousRadialJets.radial_hessian P d hhom hd base (some none)
    simp only [base,Pi.single_apply,ite_mul,one_mul,zero_mul,Finset.sum_ite_eq',
      Finset.mem_univ,ite_true] at hr
    rw [show eval (Pi.single (some none) 1) (pderiv (some none) P) = 0 from hgt none] at hr
    simpa only [base,mul_zero] using hr
  have htrace : (∑ i : ι, eval base (pderiv (some (some i)) (pderiv (some (some i)) P))) = 0 := by
    have ht := tangential_trace_zero_at P base g hg hL hgn hgt
    simpa only [Fintype.sum_option,hrad,zero_add] using ht
  obtain ⟨γ,hγ,hγ0,hzero,hsphere,htangent⟩ :=
    Source29PolynomialLinkCurves.exists_link_curves P g hg hP hgn hgt
  have hjets (i : ι) := Source29PolynomialLinkCurveJets.link_curve_jets P g hg hgn hgt
    (γ i) i (hγ i) (hγ0 i) (hzero i) (hsphere i) (htangent i)
  refine ⟨fun i t a ↦ γ i a t,hγ,fun i ↦ funext (hγ0 i),hzero,hsphere,
    fun i a ↦ (hjets i).1 a,fun a ↦ ?_⟩
  simp_rw [(hjets _).2]
  rw [Finset.sum_sub_distrib]
  simp only [Finset.sum_neg_distrib,Finset.sum_const,nsmul_eq_mul,
    ← Finset.sum_mul,← Finset.sum_div,htrace,zero_div,zero_mul,sub_zero]
  simp only [Finset.card_univ,base,neg_mul]

end
end Source29RegularLinkMeanAcceleration

/- Component: AntipodalLinkExclusion.inc -/
namespace Source29AntipodalLinkExclusion

open Filter Source29SynchronizedCurveFrankel
open scoped Topology BigOperators

noncomputable section
variable {κ : Type*} [Fintype κ]

theorem squaredDistance_add_antipode (x y : κ → ℝ) :
    squaredDistance y x + squaredDistance y (-x) =
      2 * (∑ a, (y a)^2) + 2 * (∑ a, (x a)^2) := by
  simp only [squaredDistance, Pi.neg_apply, ← Finset.sum_add_distrib,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _
  ring

/-- A curve with nonzero velocity on the unit sphere cannot have a closest
point at the antipode of its initial point. -/
theorem not_local_min_at_antipode
    (C : ℝ → κ → ℝ) (x : κ → ℝ) (hC : C 0 = x)
    (hx : ∑ a, (x a)^2 = 1)
    (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2 = 1)
    (hvelocity : ∃ a, deriv (fun t => C t a) 0 ≠ 0) :
    ¬ IsLocalMin (fun t => squaredDistance (C t) (-x)) 0 := by
  intro hmin
  have hxx : squaredDistance x x = 0 := by simp [squaredDistance]
  have hanti : squaredDistance x (-x) = 4 := by
    have h := squaredDistance_add_antipode x x
    rw [hxx, hx] at h
    linarith
  have heq : C =ᶠ[𝓝 0] (fun _ => x) := by
    filter_upwards [hunit, hmin] with t ht hm
    rw [hC, hanti] at hm
    have h := squaredDistance_add_antipode x (C t)
    rw [ht, hx] at h
    by_contra hn
    have hp := squaredDistance_pos hn
    linarith
  obtain ⟨a, ha⟩ := hvelocity
  have heqa : (fun t => C t a) =ᶠ[𝓝 0] (fun _ => x a) :=
    heq.fun_comp (fun y => y a)
  apply ha
  rw [heqa.deriv_eq, deriv_const]

/-- In a closest pair of spherical subsets, a nonconstant local curve in
the first subset rules out the antipodal case. -/
theorem closest_pair_not_antipodal
    (S T : Set (κ → ℝ)) (x y : κ → ℝ) (hy : y ∈ T)
    (hclosest : ∀ z ∈ S, ∀ w ∈ T, squaredDistance x y ≤ squaredDistance z w)
    (C : ℝ → κ → ℝ) (hC : C 0 = x)
    (hx : ∑ a, (x a)^2 = 1)
    (hunit : ∀ᶠ t in 𝓝 0, ∑ a, (C t a)^2 = 1)
    (hmem : ∀ᶠ t in 𝓝 0, C t ∈ S)
    (hvelocity : ∃ a, deriv (fun t => C t a) 0 ≠ 0) : y ≠ -x := by
  intro hanti
  apply not_local_min_at_antipode C x hC hx hunit hvelocity
  change ∀ᶠ t in 𝓝 0, squaredDistance (C 0) (-x) ≤ squaredDistance (C t) (-x)
  filter_upwards [hmem] with t ht
  simpa only [hC,hanti] using hclosest (C t) ht y hy

end
end Source29AntipodalLinkExclusion

/- Component: CalibrationCoordinateDescent.inc -/
namespace Source29CalibrationCoordinateDescent

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29NormalShiftDerivatives Source29CoordinateProductIntegral
open scoped BigOperators

noncomputable section
variable {n : ℕ}

lemma tail_cons (t : ℝ) (y : Fin n → ℝ) : tail (Fin.cons t y) = y := by
  ext i
  rfl

def liftedField (Z : (Fin n → ℝ) → Fin n → ℝ) (x : Fin (n+1) → ℝ) : Fin (n+1) → ℝ :=
  Fin.cons 0 (Z (tail x))

def productTest (ρ : ℝ → ℝ) (ψ : (Fin n → ℝ) → ℝ) (x : Fin (n+1) → ℝ) : ℝ :=
  ρ (x 0) * ψ (tail x)

lemma productTest_contDiff {ρ : ℝ → ℝ} {ψ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hψ : ContDiff ℝ 1 ψ) :
    ContDiff ℝ 1 (productTest ρ ψ) := by
  let L : (Fin (n+1) → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj 0
  change ContDiff ℝ 1 (fun x ↦ ρ (L x) * ψ (tail x))
  simpa only [Function.comp_def] using (hρ.comp L.contDiff).mul (hψ.comp tail.contDiff)

lemma productTest_compact {ρ : ℝ → ℝ} {ψ : (Fin n → ℝ) → ℝ}
    (hcρ : HasCompactSupport ρ) (hcψ : HasCompactSupport ψ) :
    HasCompactSupport (productTest ρ ψ) := by
  have hc : Continuous (fun p : ℝ × (Fin n → ℝ) ↦ (Fin.cons p.1 p.2 : Fin (n+1) → ℝ)) := by
    apply continuous_pi
    intro i
    exact Fin.cases continuous_fst (fun j ↦ (continuous_apply j).comp continuous_snd) i
  apply HasCompactSupport.of_support_subset_isCompact ((hcρ.prod hcψ).image hc)
  intro x hx
  have hne : ρ (x 0) ≠ 0 ∧ ψ (tail x) ≠ 0 := mul_ne_zero_iff.mp hx
  refine ⟨(x 0,tail x),⟨subset_tsupport _ hne.1,subset_tsupport _ hne.2⟩,?_⟩
  exact Fin.cons_self_tail x

/-- The product test has no contribution from the missing field coordinate. -/
lemma productTest_flux {ρ : ℝ → ℝ} {ψ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hψ : ContDiff ℝ 1 ψ)
    (Z : (Fin n → ℝ) → Fin n → ℝ) (x : Fin (n+1) → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (productTest ρ ψ) (liftedField Z) x =
      ρ (x 0) * testFlux (fun i ↦ Pi.single i 1) ψ Z (tail x) := by
  let L : (Fin (n+1) → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj 0
  have hr := ((hρ.differentiable (by norm_num) (x 0)).hasDerivAt).comp_hasFDerivAt x L.hasFDerivAt
  have hs := ((hψ.differentiable (by norm_num) (tail x)).hasFDerivAt).comp x tail.hasFDerivAt
  have hp := hr.fun_mul hs
  rw [Source29OrthogonalCalibration.testFlux_eq_fderiv,
    Source29OrthogonalCalibration.testFlux_eq_fderiv]
  change fderiv ℝ (fun z ↦ ρ (L z) * ψ (tail z)) x (liftedField Z x) = _
  have hpf := hp.fderiv
  change fderiv ℝ (fun z ↦ ρ (L z) * ψ (tail z)) x = _ at hpf
  rw [hpf]
  simp only [_root_.add_apply,_root_.smul_apply,smul_eq_mul,Function.comp_def,
    ContinuousLinearMap.comp_apply,liftedField,tail_cons,L,
    ContinuousLinearMap.proj_apply,Fin.cons_zero,mul_zero,add_zero]

/-- Calibration descends from a product field. Fubini also supplies the
integrability of every lower-dimensional test flux, with no extra measurability assumption. -/
theorem weakCalibration_of_liftedField
    (Z : (Fin n → ℝ) → Fin n → ℝ) (hZ : WeakCalibration (liftedField Z)) :
    WeakCalibration Z := by
  refine ⟨?_,?_⟩
  · intro x i
    simpa only [liftedField,tail_cons,Fin.cons_succ] using hZ.1 (Fin.cons 0 x) i.succ
  · intro ψ hψ hcψ
    let b : ContDiffBump (0 : ℝ) :=
      { rIn := 1, rOut := 2, rIn_pos := by norm_num, rIn_lt_rOut := by norm_num }
    let ρ : ℝ → ℝ := b
    have hρ : ContDiff ℝ 1 ρ := b.contDiff
    have hcρ : HasCompactSupport ρ := b.hasCompactSupport
    have hρint : (∫ t, ρ t) ≠ 0 := ne_of_gt
      (b.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero b.hasCompactSupport
        b.nonneg' (show b 0 ≠ 0 from (b.pos_of_mem_ball
          (by simpa only [Metric.mem_ball,dist_self] using b.rOut_pos)).ne'))
    have hbase := hZ.2 (productTest ρ ψ) (productTest_contDiff hρ hψ)
      (productTest_compact hcρ hcψ)
    have he (t : ℝ) (y : Fin n → ℝ) :
        testFlux (fun i ↦ Pi.single i 1) (productTest ρ ψ) (liftedField Z) (Fin.cons t y) =
          ρ t * testFlux (fun i ↦ Pi.single i 1) ψ Z y := by
      simpa only [tail_cons,Fin.cons_zero] using productTest_flux hρ hψ Z (Fin.cons t y)
    have hi := (cons_integrable hbase.1).integral_prod_right
    have hz := hbase.2
    rw [integral_cons hbase.1] at hz
    simp_rw [he,integral_mul_const] at hi hz
    have hi' := hi.const_mul (∫ t, ρ t)⁻¹
    have hflux : Integrable (testFlux (fun i ↦ Pi.single i 1) ψ Z) := by
      simpa only [← mul_assoc,inv_mul_cancel₀ hρint,one_mul] using hi'
    rw [integral_const_mul] at hz
    exact ⟨hflux,(mul_eq_zero.mp hz).resolve_left hρint⟩

lemma normalizedField_rename_succ (R : MvPolynomial (Fin n) ℝ) :
    leadingNormalizedField (rename Fin.succ R) = liftedField (leadingNormalizedField R) := by
  funext x
  have hg : evaluatedGradient (rename Fin.succ R) x = Fin.cons 0 (evaluatedGradient R (tail x)) := by
    funext i
    refine Fin.cases ?_ (fun j ↦ ?_) i
    · simp only [evaluatedGradient,Source29NewtonWeightedFace.pderiv_zero_rename_succ,
        map_zero,Fin.cons_zero]
    · simp only [evaluatedGradient,pderiv_rename (Fin.succ_injective n),eval_rename,Fin.cons_succ]
      rfl
  funext i
  have hd : radiusSq (evaluatedGradient (rename Fin.succ R) x) =
      radiusSq (evaluatedGradient R (tail x)) := by
    rw [hg]
    simp only [radiusSq,Fin.sum_univ_succ,Fin.cons_zero,Fin.cons_succ,
      zero_pow (by decide : 2 ≠ 0),zero_add]
  refine Fin.cases ?_ (fun j ↦ ?_) i
  · simp only [leadingNormalizedField,hg,liftedField,Fin.cons_zero,zero_div]
  · simp only [leadingNormalizedField,liftedField,Fin.cons_succ]
    rw [hd,hg]
    rfl

/-- A polynomial independent of the first coordinate passes its normalized
weak calibration to the polynomial in the remaining coordinates. -/
theorem weakCalibration_rename_succ (R : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField (rename Fin.succ R))) :
    WeakCalibration (leadingNormalizedField R) := by
  rw [normalizedField_rename_succ] at hcal
  exact weakCalibration_of_liftedField _ hcal

end
end Source29CalibrationCoordinateDescent

/- Component: PositiveCofactorRoot.inc -/
namespace Source29PositiveCofactorRoot

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29AnalyticTensorNorm
open scoped Topology

noncomputable section

/-- The positive real kth root is analytic on the positive axis. -/
theorem positive_root_analyticAt (k : ℕ) (hk : 0 < k) {a : ℝ} (ha : 0 < a) :
    AnalyticAt ℝ (fun t : ℝ => t ^ ((k : ℝ)⁻¹)) a := by
  let b := a ^ ((k : ℝ)⁻¹)
  have hb : 0 < b := Real.rpow_pos_of_pos ha _
  have hbpow : b ^ k = a := Real.rpow_inv_natCast_pow ha.le hk.ne'
  have hpow : AnalyticAt ℝ (fun t : ℝ => t^k) b := analyticAt_id.pow k
  have hd : deriv (fun t : ℝ => t^k) b ≠ 0 := by
    have he : deriv (fun t : ℝ => t^k) b = (k:ℝ) * b^(k-1) := by
      simp
    rw [he]
    exact mul_ne_zero (Nat.cast_ne_zero.mpr hk.ne') (pow_ne_zero _ hb.ne')
  have heq : (id : ℝ → ℝ) =ᶠ[𝓝 b]
      ((fun t : ℝ => t ^ ((k : ℝ)⁻¹)) ∘ fun t : ℝ => t^k) := by
    filter_upwards [eventually_gt_nhds hb] with t ht
    exact (Real.pow_rpow_inv_natCast ht.le hk.ne').symm
  have han := (Source29RealAnalyticSqrt.analytic_comp_iff hpow hd).mp
    (analyticAt_id.congr heq)
  rwa [hbpow] at han

variable {n : ℕ}

def rootUnit (Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (x : Fin n → ℝ) : ℝ :=
  (eval x Q) ^ ((k : ℝ)⁻¹)

def definingRoot (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (x : Fin n → ℝ) : ℝ :=
  eval x P * rootUnit Q k x

theorem rootUnit_pos (Q : MvPolynomial (Fin n) ℝ) (k : ℕ)
    (x : Fin n → ℝ) (hQ : 0 < eval x Q) : 0 < rootUnit Q k x :=
  Real.rpow_pos_of_pos hQ _

theorem rootUnit_analyticAt (Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hQ : 0 < eval x Q) : AnalyticAt ℝ (rootUnit Q k) x :=
  AnalyticAt.comp (f := fun y => eval y Q) (positive_root_analyticAt k hk hQ)
    (Source29PolynomialLinkChart.analyticAt_eval_real Q x)

theorem definingRoot_analyticAt (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hQ : 0 < eval x Q) : AnalyticAt ℝ (definingRoot P Q k) x :=
  (Source29PolynomialLinkChart.analyticAt_eval_real P x).mul (rootUnit_analyticAt Q k hk x hQ)

theorem definingRoot_pow (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hQ : 0 < eval x Q) :
    definingRoot P Q k x ^ k = eval x (P^k * Q) := by
  simp only [definingRoot, rootUnit, mul_pow, map_mul, map_pow,
    Real.rpow_inv_natCast_pow hQ.le hk.ne']

theorem eventually_definingRoot_pow (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hQ : 0 < eval x Q) :
    ∀ᶠ y in 𝓝 x, definingRoot P Q k y ^ k = eval y (P^k * Q) := by
  filter_upwards [(Source29PolynomialLinkChart.analyticAt_eval_real Q x).continuousAt.eventually
    (lt_mem_nhds hQ)] with y hy
  exact definingRoot_pow P Q k hk y hy

/-- On the regular zero hypersurface the new gradient is the old gradient
multiplied by the positive kth root of the cofactor. -/
theorem definingRoot_gradient (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q) :
    gradient (definingRoot P Q k) x = fun i => rootUnit Q k x * eval x (pderiv i P) := by
  funext i
  unfold Source29NormalShiftDerivatives.gradient definingRoot
  rw [fderiv_fun_mul (Source29PolynomialLinkChart.analyticAt_eval_real P x).differentiableAt
    (rootUnit_analyticAt Q k hk x hQ).differentiableAt]
  simp only [hP, zero_smul, zero_add, _root_.smul_apply, smul_eq_mul]
  change rootUnit Q k x * gradient (fun y => eval y P) x i = _
  rw [gradient_eval]

theorem definingRoot_gradient_ne_zero (P Q : MvPolynomial (Fin n) ℝ)
    (k : ℕ) (hk : 0 < k) (x : Fin n → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    gradient (definingRoot P Q k) x ≠ 0 := by
  rw [definingRoot_gradient P Q k hk x hP hQ]
  intro hz
  apply hreg
  funext i
  have hi := congrFun hz i
  exact (mul_eq_zero.mp hi).resolve_left (rootUnit_pos Q k x hQ).ne'

/-- This positive inverse-gradient profile is the candidate for the Jacobi
identity; this lemma establishes its regularity and positivity only. -/
theorem inverse_gradient_profile_analytic_positive
    (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    AnalyticAt ℝ (fun y => (tensorNorm (gradient (definingRoot P Q k) y))⁻¹) x ∧
      0 < (tensorNorm (gradient (definingRoot P Q k) x))⁻¹ := by
  have hg := definingRoot_analyticAt P Q k hk x hQ
  have hn := definingRoot_gradient_ne_zero P Q k hk x hP hQ hreg
  have ha : ∀ i, AnalyticAt ℝ (fun y => gradient (definingRoot P Q k) y i) x := by
    intro i
    exact Source29NewtonRootHarmonic.analyticAt_directional _ x _ hg
  have hnorm := tensorNorm_analyticAt (gradient (definingRoot P Q k)) x ha hn
  exact ⟨hnorm.inv (tensorNorm_pos hn).ne', inv_pos.mpr (tensorNorm_pos hn)⟩


lemma tensorNorm_scale_pos {ι : Type*} [Fintype ι] (v : ι → ℝ) (b : ℝ) (hb : 0 < b) :
    tensorNorm (fun i => b * v i) = b * tensorNorm v := by
  simp only [tensorNorm, mul_pow, ← Finset.mul_sum, Real.sqrt_mul (sq_nonneg b),
    Real.sqrt_sq hb.le]

/-- The inverse gradient norm agrees with the inverse kth root of the
leading coefficient measured in the positive unit-normal direction. -/
theorem inverse_gradient_profile_eq
    (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Fin n → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    (tensorNorm (gradient (definingRoot P Q k) x))⁻¹ =
      (tensorNorm (fun i => eval x (pderiv i P)) ^ k * eval x Q) ^ (-((k : ℝ)⁻¹)) := by
  have hn := tensorNorm_pos hreg
  rw [definingRoot_gradient P Q k hk x hP hQ,
    tensorNorm_scale_pos _ _ (rootUnit_pos Q k x hQ), Real.rpow_neg (mul_nonneg (pow_nonneg hn.le k) hQ.le),
    Real.mul_rpow (pow_nonneg hn.le k) hQ.le,
    Real.pow_rpow_inv_natCast hn.le hk.ne']
  unfold rootUnit
  rw [mul_comm]

end
end Source29PositiveCofactorRoot

/- Component: AnalyticScalarLevelOperator.inc -/
namespace Source29AnalyticScalarLevelOperator

open Filter Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open scoped Topology BigOperators

noncomputable section

section ChainRules
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

lemma first_comp (φ : ℝ → ℝ) (f : E → ℝ) (x v : E)
    (hφ : AnalyticAt ℝ φ (f x)) (hf : AnalyticAt ℝ f x) :
    fderiv ℝ (fun y => φ (f y)) x v = deriv φ (f x) * fderiv ℝ f x v := by
  have hd := hφ.differentiableAt.hasDerivAt.comp_hasFDerivAt x hf.differentiableAt.hasFDerivAt
  simpa only [Function.comp_def, _root_.smul_apply, smul_eq_mul] using
    congrArg (fun D : E →L[ℝ] ℝ => D v) hd.fderiv

lemma second_comp (φ : ℝ → ℝ) (f : E → ℝ) (x u v : E)
    (hφ : AnalyticAt ℝ φ (f x)) (hf : AnalyticAt ℝ f x) :
    second (fun y => φ (f y)) x u v =
      deriv φ (f x) * second f x u v +
      deriv (deriv φ) (f x) * (fderiv ℝ f x u * fderiv ℝ f x v) := by
  have he : (fun y => fderiv ℝ (fun z => φ (f z)) y v) =ᶠ[𝓝 x]
      (fun y => deriv φ (f y) * fderiv ℝ f y v) := by
    filter_upwards [hf.eventually_analyticAt,
      hf.continuousAt.tendsto.eventually hφ.eventually_analyticAt] with y hy hpy
    exact first_comp φ f y v hpy hy
  have ha : AnalyticAt ℝ (fun y => deriv φ (f y)) x :=
    AnalyticAt.comp (f := f) hφ.deriv hf
  have hb := Source29NewtonRootHarmonic.analyticAt_directional f x v hf
  unfold second
  rw [he.fderiv_eq, fderiv_fun_mul ha.differentiableAt hb.differentiableAt]
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
  rw [first_comp (deriv φ) f x u hφ.deriv hf]
  ring

end ChainRules

lemma cubicLevel_rank_one {ι : Type*} [Fintype ι]
    (g : ι → ℝ) (H : ι → ι → ℝ) (a b : ℝ) :
    cubicLevel (fun i => a * g i) (fun i j => a * H i j + b * (g i * g j)) =
      a^3 * cubicLevel g H := by
  simp only [cubicLevel, dot_mul_left, dot_mul_right, trace_add, trace_mul,
    trace_rank_one, bilinear_add_matrix, bilinear_mul_matrix,
    bilinear_mul_left, bilinear_mul_right, bilinear_rank_one]
  ring

variable {n : ℕ}

def levelOperator (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) : ℝ :=
  cubicLevel (gradient f x) (hessian f x)

/-- Reparametrizing the values of an analytic defining function multiplies
its cubic level-set operator by the cube of the scalar derivative. -/
theorem levelOperator_comp (φ : ℝ → ℝ) (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ)
    (hφ : AnalyticAt ℝ φ (f x)) (hf : AnalyticAt ℝ f x) :
    levelOperator (fun y => φ (f y)) x = (deriv φ (f x))^3 * levelOperator f x := by
  unfold levelOperator
  have hg : gradient (fun y => φ (f y)) x = fun i => deriv φ (f x) * gradient f x i := by
    funext i
    exact first_comp φ f x _ hφ hf
  have hh : hessian (fun y => φ (f y)) x = fun i j =>
      deriv φ (f x) * hessian f x i j + deriv (deriv φ) (f x) * (gradient f x i * gradient f x j) := by
    funext i j
    exact second_comp φ f x _ _ hφ hf
  rw [hg, hh, cubicLevel_rank_one]

theorem levelOperator_pow (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ)
    (hf : AnalyticAt ℝ f x) (k : ℕ) :
    levelOperator (fun y => f y ^ k) x = ((k:ℝ) * f x^(k-1))^3 * levelOperator f x := by
  have hd : deriv (fun t : ℝ => t^k) (f x) = (k:ℝ) * f x^(k-1) := by
    simp
  rw [levelOperator_comp (fun t : ℝ => t^k) f x (analyticAt_id.pow k) hf, hd]

theorem levelOperator_analyticAt (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ)
    (hf : AnalyticAt ℝ f x) : AnalyticAt ℝ (levelOperator f) x := by
  have hg : ∀ i, AnalyticAt ℝ (fun y => gradient f y i) x :=
    fun i => Source29NewtonRootHarmonic.analyticAt_directional f x _ hf
  have hH : ∀ i j, AnalyticAt ℝ (fun y => hessian f y i j) x := by
    intro i j
    exact Source29NewtonRootHarmonic.analyticAt_directional _ x _ (hg j)
  unfold levelOperator cubicLevel dot trace bilinear
  exact ((Finset.analyticAt_fun_sum _ (fun i _ => (hg i).mul (hg i))).mul
    (Finset.analyticAt_fun_sum _ (fun i _ => hH i i))).sub
    (Finset.analyticAt_fun_sum _ (fun i _ => Finset.analyticAt_fun_sum _
      (fun j _ => ((hH i j).mul (hg i)).mul (hg j))))

theorem levelOperator_congr {f g : (Fin n → ℝ) → ℝ} {x : Fin n → ℝ}
    (he : f =ᶠ[𝓝 x] g) : levelOperator f x = levelOperator g x := by
  have hg : gradient f x = gradient g x := by
    unfold Source29NormalShiftDerivatives.gradient
    rw [he.fderiv_eq]
  have hH : hessian f x = hessian g x := by
    funext i j
    unfold hessian second
    have hfirst : (fun y => fderiv ℝ f y (basis j)) =ᶠ[𝓝 x] (fun y => fderiv ℝ g y (basis j)) :=
      (he.fderiv (𝕜 := ℝ)).mono (fun y hy => congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ => D (basis j)) hy)
    rw [hfirst.fderiv_eq]
  unfold levelOperator
  rw [hg, hH]

end
end Source29AnalyticScalarLevelOperator

/- Component: AnalyticPowerInheritance.inc -/
namespace Source29AnalyticPowerInheritance

open MvPolynomial Filter
open Source29NormalShiftDerivatives Source29AnalyticScalarLevelOperator
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A noncritical analytic defining function inherits the cubic equation
from any positive integral power, as an identity on a full neighborhood. -/
theorem levelOperator_zero_of_power
    (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (hf : AnalyticAt ℝ f x)
    (hreg : gradient f x ≠ 0) (k : ℕ) (hk : 0 < k)
    (hpow : ∀ᶠ y in 𝓝 x, levelOperator (fun z => f z ^ k) y = 0) :
    ∀ᶠ y in 𝓝 x, levelOperator f y = 0 := by
  let A : (Fin n → ℝ) → ℝ := fun y => ((k:ℝ) * f y^(k-1))^3
  have hA : AnalyticAt ℝ A x := (analyticAt_const.mul (hf.pow (k-1))).pow 3
  have hprod : ∀ᶠ y in 𝓝 x, A y * levelOperator f y = 0 := by
    filter_upwards [hpow, hf.eventually_analyticAt] with y hy hay
    rwa [levelOperator_pow f y hay k] at hy
  rcases Source29AnalyticGraphFactor.zero_germ_of_mul_zero A (levelOperator f) x
    hA (levelOperator_analyticAt f x hf) hprod with hzero | hzero
  · have hflat : f =ᶠ[𝓝 x] (fun _ => 0) := by
      filter_upwards [hzero] with y hy
      have hm : (k:ℝ) * f y^(k-1) = 0 := eq_zero_of_pow_eq_zero hy
      exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp hm).resolve_left
        (Nat.cast_ne_zero.mpr hk.ne'))
    apply (hreg ?_).elim
    unfold Source29NormalShiftDerivatives.gradient
    rw [hflat.fderiv_eq]
    funext i
    simp
  · exact hzero

/-- The actual analytic kth root of p^k Q satisfies the cubic equation
near each regular zero of p where Q is positive. -/
theorem definingRoot_levelOperator_zero
    (P Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : 0 < k)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator (P^k * Q) = 0)
    (x : Fin n → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    ∀ᶠ y in 𝓝 x, levelOperator (Source29PositiveCofactorRoot.definingRoot P Q k) y = 0 := by
  let G := Source29PositiveCofactorRoot.definingRoot P Q k
  have he : (fun y => G y ^ k) =ᶠ[𝓝 x] (fun y => eval y (P^k * Q)) :=
    Source29PositiveCofactorRoot.eventually_definingRoot_pow P Q k hk x hQ
  apply levelOperator_zero_of_power G x
    (Source29PositiveCofactorRoot.definingRoot_analyticAt P Q k hk x hQ)
    (Source29PositiveCofactorRoot.definingRoot_gradient_ne_zero P Q k hk x hP hQ hreg) k hk
  filter_upwards [he.eventuallyEq_nhds] with y hy
  rw [levelOperator_congr hy]
  change Source29NormalShiftAlgebra.cubicLevel _ _ = 0
  rw [cubicLevel_eval, hF, map_zero]

end
end Source29AnalyticPowerInheritance

/- Component: PositiveRootHomogeneity.inc -/
namespace Source29PositiveRootHomogeneity

open MvPolynomial
open Source29PositiveCofactorRoot

noncomputable section

variable {n : ℕ}

/-- Positive dilation preserves the region where the cofactor is positive. -/
theorem eval_smul_pos (Q : MvPolynomial (Fin n) ℝ) (q : ℕ)
    (hQ : Q.IsHomogeneous q) (x : Fin n → ℝ) (hx : 0 < eval x Q)
    (t : ℝ) (ht : 0 < t) : 0 < eval (t • x) Q := by
  rw [show t • x = fun i => t * x i from rfl,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous Q q hQ x t]
  exact mul_pos (pow_pos ht q) hx

/-- The analytic positive defining root has a real, possibly nonintegral,
homogeneous degree. -/
theorem definingRoot_smul (P Q : MvPolynomial (Fin n) ℝ) (p q k : ℕ)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (x : Fin n → ℝ) (hx : 0 < eval x Q) (t : ℝ) (ht : 0 < t) :
    definingRoot P Q k (t • x) =
      t ^ ((p : ℝ) + (q : ℝ) / (k : ℝ)) * definingRoot P Q k x := by
  simp only [definingRoot, rootUnit]
  rw [show t • x = fun i => t * x i from rfl,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous P p hP x t,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous Q q hQ x t,
    Real.mul_rpow (pow_nonneg ht.le q) hx.le,
    Real.rpow_add ht, Real.rpow_natCast,
    div_eq_mul_inv, Real.rpow_natCast_mul ht.le]
  ring

/-- The degree of the product determines the real degree of its defining root. -/
theorem product_degree (P Q : MvPolynomial (Fin n) ℝ) (p q k d : ℕ)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (hF : (P^k * Q).IsHomogeneous d) (hne : P^k * Q ≠ 0) : d = p*k+q := by
  exact (hF.totalDegree hne).symm.trans (((hP.pow k).mul hQ).totalDegree hne)

theorem definingRoot_smul_product_degree (P Q : MvPolynomial (Fin n) ℝ)
    (p q k d : ℕ) (hk : 0 < k) (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (hF : (P^k * Q).IsHomogeneous d) (hne : P^k * Q ≠ 0)
    (x : Fin n → ℝ) (hx : 0 < eval x Q) (t : ℝ) (ht : 0 < t) :
    definingRoot P Q k (t • x) =
      t ^ ((d : ℝ) / (k : ℝ)) * definingRoot P Q k x := by
  rw [definingRoot_smul P Q p q k hP hQ x hx t ht, product_degree P Q p q k d hP hQ hF hne]
  have hk' : (k : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
  congr 2
  push_cast
  field_simp

end
end Source29PositiveRootHomogeneity

/- Component: AnalyticHomogeneousRadialJets.inc -/
namespace Source29AnalyticHomogeneousRadialJets

open Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Euler's identity needs only positive dilation near the base point. -/
theorem euler (f : E → ℝ) (D : ℝ) (x : E) (hf : AnalyticAt ℝ f x)
    (hhom : ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x) :
    fderiv ℝ f x x = D * f x := by
  have hcurve : HasDerivAt (fun t : ℝ => f (t • x)) (fderiv ℝ f x x) 1 := by
    have hf' : HasFDerivAt f (fderiv ℝ f x) ((1 : ℝ) • x) := by
      simpa using hf.differentiableAt.hasFDerivAt
    simpa only [Function.comp_def, id_eq, one_smul] using
      hf'.comp_hasDerivAt 1 ((hasDerivAt_id (1 : ℝ)).smul_const x)
  have hpow : HasDerivAt (fun t : ℝ => t^D * f x) (D * f x) 1 := by
    simpa using (Real.hasDerivAt_rpow_const (p := D) (Or.inl one_ne_zero)).mul_const (f x)
  have heq : (fun t : ℝ => f (t • x)) =ᶠ[𝓝 1] (fun t : ℝ => t^D * f x) := by
    filter_upwards [eventually_gt_nhds (show (0 : ℝ) < 1 by norm_num)] with t ht
    exact hhom t ht
  exact hcurve.unique (hpow.congr_of_eventuallyEq heq)

/-- Spatial differentiation lowers real homogeneous degree by one. -/
theorem directional_smul (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (v : E) (t : ℝ) (ht : 0 < t) :
    fderiv ℝ f (t • x) v = t^(D-1) * fderiv ℝ f x v := by
  let A : E →L[ℝ] E := t • ContinuousLinearMap.id ℝ E
  have heq : (fun y => f (t • y)) =ᶠ[𝓝 x] (fun y => t^D * f y) := by
    filter_upwards [hU.mem_nhds hx] with y hy
    exact hhom y hy t ht
  have hl := (hf (t • x) (hcone x hx t ht)).differentiableAt.hasFDerivAt.comp x A.hasFDerivAt
  change HasFDerivAt (fun y => f (t • y)) ((fderiv ℝ f (t • x)).comp A) x at hl
  have hr := (hf x hx).differentiableAt.hasFDerivAt.const_mul (t^D)
  have he := congrArg (fun L : E →L[ℝ] ℝ => L v) heq.fderiv_eq
  rw [hl.fderiv, hr.fderiv] at he
  simp only [ContinuousLinearMap.comp_apply, A, smul_apply,
    ContinuousLinearMap.id_apply, map_smul, smul_eq_mul] at he
  apply mul_left_cancel₀ ht.ne'
  calc
    t * fderiv ℝ f (t • x) v = t^D * fderiv ℝ f x v := he
    _ = t * (t^(D-1) * fderiv ℝ f x v) := by
      rw [Real.rpow_sub ht, Real.rpow_one]
      field_simp

/-- Euler's identity for the first directional derivative. -/
theorem radial_hessian (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (v : E) :
    fderiv ℝ (fun y => fderiv ℝ f y v) x x = (D-1) * fderiv ℝ f x v :=
  euler _ (D-1) x (Source29NewtonRootHarmonic.analyticAt_directional f x v (hf x hx))
    (fun t ht => directional_smul f D U hU hcone hf hhom x hx v t ht)

/-- A second spatial derivative lowers homogeneous degree by two. -/
theorem second_directional_smul (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (u v : E) (t : ℝ) (ht : 0 < t) :
    fderiv ℝ (fun y => fderiv ℝ f y v) (t • x) u =
      t^(D-2) * fderiv ℝ (fun y => fderiv ℝ f y v) x u := by
  have he := directional_smul (fun y => fderiv ℝ f y v) (D-1) U hU hcone
    (fun y hy => Source29NewtonRootHarmonic.analyticAt_directional f y v (hf y hy))
    (fun y hy t ht => directional_smul f D U hU hcone hf hhom y hy v t ht) x hx u t ht
  have heq : D-1-1 = D-2 := by ring
  rw [heq] at he
  exact he

/-- Euler's identity for the second directional derivative. -/
theorem radial_third_derivative (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (u v : E) :
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ f y v) z u) x x =
      (D-2) * fderiv ℝ (fun y => fderiv ℝ f y v) x u :=
  euler _ (D-2) x
    (Source29NewtonRootHarmonic.analyticAt_directional _ x u
      (Source29NewtonRootHarmonic.analyticAt_directional f x v (hf x hx)))
    (fun t ht => second_directional_smul f D U hU hcone hf hhom x hx u v t ht)

/-- Two radial entries in the third derivative, valid for every real degree. -/
theorem radial_radial_third (f : E → ℝ) (D : ℝ) (U : Set E) (hU : IsOpen U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (x : E) (hx : x ∈ U) (v : E) :
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ f y v) z x) x x =
      (D-2)*(D-1) * fderiv ℝ f x v := by
  rw [radial_third_derivative f D U hU hcone hf hhom x hx x v,
    radial_hessian f D U hU hcone hf hhom x hx v]
  ring

end
end Source29AnalyticHomogeneousRadialJets

/- Component: PositiveRootRadialJets.inc -/
namespace Source29PositiveRootRadialJets

open MvPolynomial Filter
open Source29PositiveCofactorRoot Source29PositiveRootHomogeneity
open Source29AnalyticHomogeneousRadialJets
open scoped Topology

noncomputable section

variable {n : ℕ}

/-- Actual radial Hessian and third derivatives of the positive defining root.
No integrality assumption is imposed on its homogeneous degree. -/
theorem definingRoot_radial_jets (P Q : MvPolynomial (Fin n) ℝ)
    (p q k : ℕ) (hk : 0 < k) (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (x : Fin n → ℝ) (hx : 0 < eval x Q) (v : Fin n → ℝ) :
    let f := definingRoot P Q k
    let D := (p : ℝ) + (q : ℝ) / (k : ℝ)
    fderiv ℝ f x x = D * f x ∧
    fderiv ℝ (fun y => fderiv ℝ f y v) x x = (D-1) * fderiv ℝ f x v ∧
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ f y v) z x) x x =
      (D-2)*(D-1) * fderiv ℝ f x v := by
  let U : Set (Fin n → ℝ) := {y | 0 < eval y Q}
  have hU : IsOpen U := isOpen_lt continuous_const
    (show Continuous (fun y => eval y Q) from
      continuous_iff_continuousAt.mpr (fun y =>
        (Source29PolynomialLinkChart.analyticAt_eval_real Q y).continuousAt))
  have hcone : ∀ y ∈ U, ∀ t : ℝ, 0 < t → t • y ∈ U :=
    fun y hy t ht => eval_smul_pos Q q hQ y hy t ht
  have hf : ∀ y ∈ U, AnalyticAt ℝ (definingRoot P Q k) y :=
    fun y hy => definingRoot_analyticAt P Q k hk y hy
  have hhom : ∀ y ∈ U, ∀ t : ℝ, 0 < t →
      definingRoot P Q k (t • y) = t ^ ((p : ℝ) + (q : ℝ) / (k : ℝ)) * definingRoot P Q k y :=
    fun y hy t ht => definingRoot_smul P Q p q k hP hQ y hy t ht
  exact ⟨euler _ _ x (hf x hx) (hhom x hx),
    radial_hessian _ _ U hU hcone hf hhom x hx v,
    radial_radial_third _ _ U hU hcone hf hhom x hx v⟩

/-- Normalized radial coordinates give the entries used by the Jacobi trace. -/
theorem definingRoot_coordinate_jets (P Q : MvPolynomial (Fin n) ℝ)
    (p q k : ℕ) (hk : 0 < k) (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (r j : Fin n) (hx : 0 < eval (Pi.single r 1) Q) :
    let f := definingRoot P Q k
    let x : Fin n → ℝ := Pi.single r 1
    let v : Fin n → ℝ := Pi.single j 1
    let D := (p : ℝ) + (q : ℝ) / (k : ℝ)
    fderiv ℝ (fun y => fderiv ℝ f y v) x (Pi.single r 1) =
        (D-1) * fderiv ℝ f x v ∧
    fderiv ℝ (fun z => fderiv ℝ (fun y => fderiv ℝ f y v) z (Pi.single r 1)) x
        (Pi.single r 1) = (D-2)*(D-1) * fderiv ℝ f x v :=
  (definingRoot_radial_jets P Q p q k hk hP hQ (Pi.single r 1) hx (Pi.single j 1)).2

end
end Source29PositiveRootRadialJets

/- Component: AnalyticSecondSymmetry.inc -/
namespace Source29AnalyticSecondSymmetry

open Filter
open scoped Topology

noncomputable section
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

lemma derivSeries_one_apply (p : FormalMultilinearSeries ℝ E F) (u v : E) :
    p.derivSeries 1 (fun _ => u) v = p 2 ![u,v] + p 2 ![v,u] := by
  classical
  have hu : (Finset.univ : Finset {s : Finset (Fin 2) // s.card = 1}) =
      {⟨{0}, by simp⟩, ⟨{1}, by simp⟩} := by decide
  simp only [FormalMultilinearSeries.derivSeries,
    ContinuousLinearMap.compFormalMultilinearSeries_apply,
    FormalMultilinearSeries.changeOriginSeries,
    ContinuousLinearMap.compContinuousMultilinearMap_coe,
    ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_coe,
    Function.comp_apply, map_sum, _root_.sum_apply,
    continuousMultilinearCurryFin1_apply, Fin.snoc_zero, FormalMultilinearSeries.changeOriginSeriesTerm_apply]
  rw [hu]
  simp only [Finset.sum_insert, Finset.sum_singleton, Finset.mem_singleton,
    Subtype.mk.injEq, Finset.singleton_inj, Fin.zero_ne_one, not_false_eq_true,
    Finset.mem_singleton, Subtype.coe_mk]
  congr 1 <;> congr 1 <;> funext i <;> fin_cases i <;> simp

variable [CompleteSpace F]

/-- Symmetry of the second derivative, proved directly from the analytic
power series so that no additional differentiability import is needed. -/
theorem second_symmetric (f : E → F) (x u v : E) (hf : AnalyticAt ℝ f x) :
    fderiv ℝ (fderiv ℝ f) x u v = fderiv ℝ (fderiv ℝ f) x v u := by
  obtain ⟨p, r, hp⟩ := hf
  rw [hp.fderiv.hasFPowerSeriesAt.fderiv_eq]
  simp only [continuousMultilinearCurryFin1_apply, Fin.snoc_zero, derivSeries_one_apply, add_comm]

end
end Source29AnalyticSecondSymmetry

/- Component: AnalyticNormalTrace.inc -/
namespace Source29AnalyticNormalTrace

open Filter Source29NormalShiftAlgebra
open Source29FiniteJetConvergence (first_mul first_sum)
open scoped Topology BigOperators

noncomputable section

section ArrayCalculus
variable {E I : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [Fintype I]

lemma analyticAt_dot (V W : E → I → ℝ) (x : E)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    AnalyticAt ℝ (fun y => dot (V y) (W y)) x :=
  Finset.analyticAt_fun_sum _ (fun i _ => (hV i).mul (hW i))

lemma analyticAt_trace (H : E → I → I → ℝ) (x : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x) :
    AnalyticAt ℝ (fun y => trace (H y)) x :=
  Finset.analyticAt_fun_sum _ (fun i _ => hH i i)

lemma analyticAt_bilinear (H : E → I → I → ℝ) (V W : E → I → ℝ) (x : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    AnalyticAt ℝ (fun y => bilinear (H y) (V y) (W y)) x :=
  Finset.analyticAt_fun_sum _ (fun i _ => Finset.analyticAt_fun_sum _
    (fun j _ => ((hH i j).mul (hV i)).mul (hW j)))

lemma first_dot (V W : E → I → ℝ) (x v : E)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    fderiv ℝ (fun y => dot (V y) (W y)) x v =
      dot (fun i => fderiv ℝ (fun y => V y i) x v) (W x) +
      dot (V x) (fun i => fderiv ℝ (fun y => W y i) x v) := by
  unfold dot
  rw [first_sum Finset.univ (fun i y => V y i * W y i) x v (fun i _ => (hV i).mul (hW i))]
  simp_rw [first_mul (fun y => V y _) (fun y => W y _) x v (hV _) (hW _)]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma first_trace (H : E → I → I → ℝ) (x v : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x) :
    fderiv ℝ (fun y => trace (H y)) x v =
      trace (fun i j => fderiv ℝ (fun y => H y i j) x v) :=
  first_sum _ _ x v (fun i _ => hH i i)

lemma first_bilinear (H : E → I → I → ℝ) (V W : E → I → ℝ) (x v : E)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hW : ∀ i, AnalyticAt ℝ (fun y => W y i) x) :
    fderiv ℝ (fun y => bilinear (H y) (V y) (W y)) x v =
      bilinear (fun i j => fderiv ℝ (fun y => H y i j) x v) (V x) (W x) +
      bilinear (H x) (fun i => fderiv ℝ (fun y => V y i) x v) (W x) +
      bilinear (H x) (V x) (fun j => fderiv ℝ (fun y => W y j) x v) := by
  have hi (i : I) :
      fderiv ℝ (fun y => ∑ j : I, H y i j * V y i * W y j) x v =
      ∑ j : I, fderiv ℝ (fun y => H y i j * V y i * W y j) x v :=
    first_sum Finset.univ (fun j y => H y i j * V y i * W y j) x v
      (fun j _ => ((hH i j).mul (hV i)).mul (hW j))
  have hij (i j : I) :
      fderiv ℝ (fun y => H y i j * V y i * W y j) x v =
      fderiv ℝ (fun y => H y i j) x v * V x i * W x j +
      H x i j * fderiv ℝ (fun y => V y i) x v * W x j +
      H x i j * V x i * fderiv ℝ (fun y => W y j) x v := by
    rw [first_mul (fun y => H y i j * V y i) (fun y => W y j) x v
      ((hH i j).mul (hV i)) (hW j),
      first_mul (fun y => H y i j) (fun y => V y i) x v (hH i j) (hV i)]
    ring
  unfold bilinear
  rw [first_sum Finset.univ (fun i y => ∑ j : I, H y i j * V y i * W y j) x v
    (fun i _ => Finset.analyticAt_fun_sum _
      (fun j _ => ((hH i j).mul (hV i)).mul (hW j)))]
  simp only [hi, hij, Finset.sum_add_distrib]

/-- Differentiating the cubic expression in actual analytic arrays. -/
theorem first_cubicLevel (V : E → I → ℝ) (H : E → I → I → ℝ) (x v : E)
    (hV : ∀ i, AnalyticAt ℝ (fun y => V y i) x)
    (hH : ∀ i j, AnalyticAt ℝ (fun y => H y i j) x) :
    fderiv ℝ (fun y => cubicLevel (V y) (H y)) x v =
      (dot (fun i => fderiv ℝ (fun y => V y i) x v) (V x) +
        dot (V x) (fun i => fderiv ℝ (fun y => V y i) x v)) * trace (H x) +
      dot (V x) (V x) * trace (fun i j => fderiv ℝ (fun y => H y i j) x v) -
      (bilinear (fun i j => fderiv ℝ (fun y => H y i j) x v) (V x) (V x) +
        bilinear (H x) (fun i => fderiv ℝ (fun y => V y i) x v) (V x) +
        bilinear (H x) (V x) (fun i => fderiv ℝ (fun y => V y i) x v)) := by
  unfold cubicLevel
  rw [fderiv_fun_sub (f := fun y => dot (V y) (V y) * trace (H y))
    (g := fun y => bilinear (H y) (V y) (V y)) ((analyticAt_dot V V x hV hV).mul
    (analyticAt_trace H x hH)).differentiableAt
    (analyticAt_bilinear H V V x hH hV hV).differentiableAt]
  simp only [_root_.sub_apply]
  rw [first_mul (fun y => dot (V y) (V y)) (fun y => trace (H y)) x v
    (analyticAt_dot V V x hV hV) (analyticAt_trace H x hH),
    first_dot V V x v hV hV, first_trace H x v hH, first_bilinear H V V x v hH hV hV]
  ring

end ArrayCalculus

section Coordinates
variable {I : Type*} [Fintype I] [DecidableEq I]

def coordPartial (f : (I → ℝ) → ℝ) (i : I) (x : I → ℝ) : ℝ :=
  fderiv ℝ f x (Pi.single i 1)

def grad (f : (I → ℝ) → ℝ) (x : I → ℝ) (i : I) : ℝ := coordPartial f i x

def hess (f : (I → ℝ) → ℝ) (x : I → ℝ) (i j : I) : ℝ := coordPartial (coordPartial f j) i x

def third (f : (I → ℝ) → ℝ) (x : I → ℝ) (i j k : I) : ℝ :=
  coordPartial (coordPartial (coordPartial f k) j) i x

def levelOperator (f : (I → ℝ) → ℝ) (x : I → ℝ) : ℝ := cubicLevel (grad f x) (hess f x)

lemma partial_analyticAt (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i : I) : AnalyticAt ℝ (coordPartial f i) x :=
  Source29NewtonRootHarmonic.analyticAt_directional f x _ hf

lemma hess_analyticAt (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i j : I) : AnalyticAt ℝ (fun y => hess f y i j) x :=
  partial_analyticAt _ x (partial_analyticAt f x hf j) i

lemma hess_eq_fderiv (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i j : I) :
    hess f x i j = fderiv ℝ (fderiv ℝ f) x (Pi.single i 1) (Pi.single j 1) :=
  Source29NormalShiftDerivatives.second_eq_fderiv_fderiv f x _ _ hf

lemma hess_symm (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i j : I) : hess f x i j = hess f x j i := by
  rw [hess_eq_fderiv f x hf i j, hess_eq_fderiv f x hf j i]
  exact Source29AnalyticSecondSymmetry.second_symmetric f x _ _ hf

lemma third_swap12 (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i j k : I) : third f x i j k = third f x j i k :=
  hess_symm (coordPartial f k) x (partial_analyticAt f x hf k) i j

lemma third_swap23 (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (i j k : I) : third f x i j k = third f x i k j := by
  have he : (fun y => hess f y j k) =ᶠ[𝓝 x] (fun y => hess f y k j) :=
    hf.eventually_analyticAt.mono (fun y hy => hess_symm f y hy j k)
  exact congrArg (fun D : (I → ℝ) →L[ℝ] ℝ => D (Pi.single i 1)) he.fderiv_eq

end Coordinates

section NormalTrace
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Tangential Hessian trace vanishes at a regular point whose gradient is
in the distinguished normal direction. -/
theorem tangential_trace_zero
    (f : (Option I → ℝ) → ℝ) (x : Option I → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hL : levelOperator f x = 0) (hgn : grad f x none = g)
    (hgt : ∀ i, grad f x (some i) = 0) :
    (∑ i, hess f x (some i) (some i)) = 0 := by
  have he := hL
  simp only [levelOperator, cubicLevel, dot, trace, bilinear, Fintype.sum_option,
    hgn, hgt, zero_mul, mul_zero, Finset.sum_const_zero, add_zero] at he
  have hh : g^2 * (∑ i, hess f x (some i) (some i)) = 0 := by nlinarith [he]
  exact (mul_eq_zero.mp hh).resolve_left (pow_ne_zero _ hg)

/-- The differentiated cubic equation yields the normal trace identity
for actual third coordinate derivatives of an analytic defining function. -/
theorem derivative_trace
    (f : (Option I → ℝ) → ℝ) (x : Option I → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f x) (hL : ∀ᶠ y in 𝓝 x, levelOperator f y = 0)
    (hgn : grad f x none = g) (hgt : ∀ i, grad f x (some i) = 0) (a : Option I) :
    g * (∑ i, third f x a (some i) (some i)) =
      2 * (∑ i, hess f x a (some i) * hess f x none (some i)) := by
  have ht := tangential_trace_zero f x g hg hL.self_of_nhds hgn hgt
  have he : fderiv ℝ (levelOperator f) x (Pi.single a 1) = 0 := by
    have heq : levelOperator f =ᶠ[𝓝 x] (fun _ => 0) := hL
    rw [heq.fderiv_eq]
    simp
  rw [show levelOperator f = (fun y => cubicLevel (grad f y) (hess f y)) from rfl,
    first_cubicLevel (grad f) (hess f) x (Pi.single a 1)
      (fun i => partial_analyticAt f x hf i) (hess_analyticAt f x hf)] at he
  change (dot (hess f x a) (grad f x) + dot (grad f x) (hess f x a)) * trace (hess f x) +
    dot (grad f x) (grad f x) * trace (third f x a) -
    (bilinear (third f x a) (grad f x) (grad f x) +
      bilinear (hess f x) (hess f x a) (grad f x) +
      bilinear (hess f x) (grad f x) (hess f x a)) = 0 at he
  have hs : ∀ i, hess f x (some i) none = hess f x none (some i) :=
    fun i => hess_symm f x hf _ _
  simp only [dot, trace, bilinear, Fintype.sum_option, hgn, hgt,
    zero_mul, mul_zero, Finset.sum_const_zero, add_zero, ht, hs] at he
  have heq : ∀ i, hess f x none (some i) * hess f x a (some i) * g =
      g * (hess f x a (some i) * hess f x none (some i)) := by intro i; ring
  have heq' : ∀ i, hess f x none (some i) * g * hess f x a (some i) =
      g * (hess f x a (some i) * hess f x none (some i)) := by intro i; ring
  simp_rw [heq, heq', ← Finset.mul_sum] at he
  have hh : g * (g * (∑ i, third f x a (some i) (some i)) -
      2 * (∑ i, hess f x a (some i) * hess f x none (some i))) = 0 := by nlinarith [he]
  exact sub_eq_zero.mp ((mul_eq_zero.mp hh).resolve_left hg)

theorem normal_derivative_trace
    (f : (Option I → ℝ) → ℝ) (x : Option I → ℝ) (g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f x) (hL : ∀ᶠ y in 𝓝 x, levelOperator f y = 0)
    (hgn : grad f x none = g) (hgt : ∀ i, grad f x (some i) = 0) :
    g * (∑ i, third f x none (some i) (some i)) =
      2 * (∑ i, (hess f x none (some i))^2) := by
  simpa only [pow_two] using derivative_trace f x g hg hf hL hgn hgt none

end NormalTrace

lemma levelOperator_fin_eq {n : ℕ} (f : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) :
    levelOperator f x = Source29AnalyticScalarLevelOperator.levelOperator f x := rfl
end
end Source29AnalyticNormalTrace

/- Component: AnalyticCurveCoordinateJets.inc -/
namespace Source29AnalyticCurveCoordinateJets

open Filter Source29NormalShiftDerivatives
open scoped Topology BigOperators

noncomputable section

section GeneralCurve
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem first_deriv_comp (f : E → ℝ) (C : ℝ → E) (t : ℝ)
    (hf : AnalyticAt ℝ f (C t)) (hC : AnalyticAt ℝ C t) :
    deriv (fun s => f (C s)) t = fderiv ℝ f (C t) (deriv C t) :=
  (hf.differentiableAt.hasFDerivAt.comp_hasDerivAt t
    hC.differentiableAt.hasDerivAt).deriv

variable [CompleteSpace E]

/-- The second curve derivative uses the actual velocity and acceleration,
and the actual second Frechet derivative of the analytic function. -/
theorem second_deriv_comp (f : E → ℝ) (C : ℝ → E)
    (hf : AnalyticAt ℝ f (C 0)) (hC : AnalyticAt ℝ C 0) :
    deriv (deriv (fun t => f (C t))) 0 =
      second f (C 0) (deriv C 0) (deriv C 0) +
      fderiv ℝ f (C 0) (deriv (deriv C) 0) := by
  have he : deriv (fun t => f (C t)) =ᶠ[𝓝 0]
      (fun t => fderiv ℝ f (C t) (deriv C t)) := by
    filter_upwards [hC.eventually_analyticAt,
      hC.continuousAt.tendsto.eventually hf.eventually_analyticAt] with t ht hft
    exact first_deriv_comp f C t hft ht
  rw [he.deriv_eq, second_eq_fderiv_fderiv f (C 0) _ _ hf]
  exact ((hf.fderiv.differentiableAt.hasFDerivAt.comp_hasDerivAt 0
    hC.differentiableAt.hasDerivAt).clm_apply
      hC.deriv.differentiableAt.hasDerivAt).deriv

end GeneralCurve

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem linear_apply_eq_sum (L : (κ → ℝ) →L[ℝ] ℝ) (v : κ → ℝ) :
    L v = ∑ j, L (Pi.single j 1) * v j := by
  conv_lhs => rw [← Finset.univ_sum_single v, map_sum]
  apply Finset.sum_congr rfl
  intro j _
  have he : Pi.single j (v j) = v j • (Pi.single j 1 : κ → ℝ) := by
    ext i
    simp only [Pi.single_apply, Pi.smul_apply, smul_eq_mul]
    split_ifs <;> simp
  rw [he, map_smul]
  simp only [smul_eq_mul, mul_comm]

theorem first_deriv_curve (f : (κ → ℝ) → ℝ) (γ : κ → ℝ → ℝ) (t : ℝ)
    (hf : AnalyticAt ℝ f (fun j => γ j t)) (hγ : ∀ j, AnalyticAt ℝ (γ j) t) :
    deriv (fun s => f (fun j => γ j s)) t =
      ∑ j, fderiv ℝ f (fun a => γ a t) (Pi.single j 1) * deriv (γ j) t := by
  rw [first_deriv_comp f _ t hf (AnalyticAt.pi hγ),
    deriv_pi (fun j => (hγ j).differentiableAt), linear_apply_eq_sum]

theorem coordinate_velocity_first (f : (κ → ℝ) → ℝ) (γ : κ → ℝ → ℝ)
    (x : κ → ℝ) (v : κ) (hf : AnalyticAt ℝ f x)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (hγ0 : ∀ j, γ j 0 = x j)
    (hγ1 : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) v 1 j) :
    deriv (fun t => f (fun j => γ j t)) 0 = fderiv ℝ f x (Pi.single v 1) := by
  have h0 : (fun j => γ j 0) = x := funext hγ0
  have hfa : AnalyticAt ℝ f (fun j => γ j 0) := h0.symm ▸ hf
  rw [first_deriv_curve f γ 0 hfa hγ]
  simp [h0,hγ1,Pi.single_apply]

/-- Coordinate velocity along an arbitrary analytic curve, with its actual
second derivatives supplying the acceleration term. -/
theorem coordinate_velocity_second (f : (κ → ℝ) → ℝ) (γ : κ → ℝ → ℝ)
    (x : κ → ℝ) (v : κ) (hf : AnalyticAt ℝ f x)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (hγ0 : ∀ j, γ j 0 = x j)
    (hγ1 : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) v 1 j) :
    deriv (deriv (fun t => f (fun j => γ j t))) 0 =
      second f x (Pi.single v 1) (Pi.single v 1) +
        ∑ j, fderiv ℝ f x (Pi.single j 1) * deriv (deriv (γ j)) 0 := by
  let C : ℝ → κ → ℝ := fun t j => γ j t
  have h0 : C 0 = x := funext hγ0
  have hC : AnalyticAt ℝ C 0 := AnalyticAt.pi hγ
  have hfirst : deriv C =ᶠ[𝓝 0] (fun t j => deriv (γ j) t) := by
    filter_upwards [Filter.eventually_all.mpr (fun j => (hγ j).eventually_analyticAt)] with t ht
    exact deriv_pi (fun j => (ht j).differentiableAt)
  have h1 : deriv C 0 = Pi.single v 1 := by
    rw [deriv_pi (fun j => (hγ j).differentiableAt)]
    exact funext hγ1
  have h2 : deriv (deriv C) 0 = fun j => deriv (deriv (γ j)) 0 := by
    rw [hfirst.deriv_eq]
    exact deriv_pi (fun j => (hγ j).deriv.differentiableAt)
  change deriv (deriv (fun t => f (C t))) 0 = _
  rw [second_deriv_comp f C (h0.symm ▸ hf) hC, h0, h1, h2, linear_apply_eq_sum]

end
end Source29AnalyticCurveCoordinateJets

/- Component: AnalyticLinkChart.inc -/
namespace Source29AnalyticLinkChart

open Filter MvPolynomial
open Source29PolynomialLinkChart (Ambient base radialScale diagonalEquiv
  diagonalEquiv_apply parameterEmbed analytic_parameterEmbed analyticAt_eval_real)
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def constraintMap (f : Ambient ι → ℝ) (x : Ambient ι) : Ambient ι
  | none => f x
  | some none => ∑ j, (x j)^2
  | some (some j) => x (some (some j))

theorem constraintMap_base (f : Ambient ι → ℝ) (hf : f base = 0) :
    constraintMap f base = parameterEmbed 0 := by
  ext j
  cases j with
  | none => exact hf
  | some j => cases j <;> simp [constraintMap, base, parameterEmbed, Pi.single_apply]

/-- The regular spherical link of an analytic defining function has an
actual analytic chart, without requiring a polynomial defining equation. -/
theorem exists_link_chart (f : Ambient ι → ℝ) (hf : AnalyticAt ℝ f base)
    (g : ℝ) (hg : g ≠ 0) (hzero : f base = 0)
    (hgn : fderiv ℝ f base (Pi.single none 1) = g)
    (hgt : ∀ j, fderiv ℝ f base (Pi.single (some j) 1) = 0) :
    ∃ φ : (ι → ℝ) → Ambient ι, AnalyticAt ℝ φ 0 ∧ φ 0 = base ∧
      ∀ᶠ y in 𝓝 (0 : ι → ℝ), constraintMap f (φ y) = parameterEmbed y := by
  have hscale : ∀ j : Option (Option ι), radialScale g j ≠ 0 := by
    intro j
    cases j with
    | none => exact hg
    | some j => cases j <;> norm_num [radialScale]
  let e : Ambient ι ≃L[ℝ] Ambient ι := diagonalEquiv (radialScale g) hscale
  have ha : AnalyticAt ℝ (constraintMap f) base := by
    apply AnalyticAt.pi
    intro j
    cases j with
    | none => exact hf
    | some j => cases j with
      | none =>
        change AnalyticAt ℝ (fun x : Ambient ι => ∑ j, (x j)^2) base
        simpa only [eval_spherePolynomial] using
          analyticAt_eval_real (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ) base
      | some j => exact (ContinuousLinearMap.proj (some (some j)) : Ambient ι →L[ℝ] ℝ).analyticAt base
  have hd : HasStrictFDerivAt (constraintMap f) (e : Ambient ι →L[ℝ] Ambient ι) base := by
    apply hasStrictFDerivAt_pi'.mpr
    intro j
    cases j with
    | none =>
      have hj := (hf.contDiffAt : ContDiffAt ℝ 1 f base).hasStrictFDerivAt one_ne_zero
      change HasStrictFDerivAt f _ base
      convert hj using 1
      ext v
      change e v none = fderiv ℝ f base v
      rw [diagonalEquiv_apply, Source29AnalyticCurveCoordinateJets.linear_apply_eq_sum]
      simp [Fintype.sum_option,hgn,hgt,radialScale]
    | some j => cases j with
      | none =>
        have hj := hasStrictFDerivAt_eval (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ) base
        simp only [eval_spherePolynomial] at hj
        change HasStrictFDerivAt (fun x : Ambient ι => ∑ j, (x j)^2) _ base
        convert hj using 1
        ext v
        change e v (some none) = evalFDeriv spherePolynomial base v
        rw [diagonalEquiv_apply]
        simp [evalFDeriv_spherePolynomial,base,Pi.single_apply,radialScale]
      | some j =>
        have hj := (ContinuousLinearMap.proj (some (some j)) : Ambient ι →L[ℝ] ℝ).hasStrictFDerivAt (x := base)
        change HasStrictFDerivAt (fun x : Ambient ι => x (some (some j))) _ base
        convert hj using 1 <;> ext v <;> simp [e,diagonalEquiv_apply,radialScale]
  obtain ⟨u,hu,hu0,hnear⟩ := Source29RealAnalyticInverse.exists_analytic_local_inverse
    (constraintMap f) base e ha hd
  rw [constraintMap_base f hzero] at hu hu0 hnear
  exact ⟨fun y => u (parameterEmbed y),hu.comp (analytic_parameterEmbed 0),hu0,
    (analytic_parameterEmbed 0).continuousAt.tendsto.eventually hnear⟩

/-- Analytic link curves with prescribed linear tangential coordinates. -/
theorem exists_link_curves (f : Ambient ι → ℝ) (hf : AnalyticAt ℝ f base)
    (g : ℝ) (hg : g ≠ 0) (hzero : f base = 0)
    (hgn : fderiv ℝ f base (Pi.single none 1) = g)
    (hgt : ∀ j, fderiv ℝ f base (Pi.single (some j) 1) = 0) :
    ∃ γ : ι → Option (Option ι) → ℝ → ℝ,
      (∀ i j, AnalyticAt ℝ (γ i j) 0) ∧
      (∀ i j, γ i j 0 = base j) ∧
      (∀ i, (fun t => f (fun j => γ i j t)) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0)) ∧
      (∀ i, (fun t => ∑ j, (γ i j t)^2) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1)) ∧
      (∀ i j, γ i (some (some j)) =ᶠ[𝓝 (0 : ℝ)]
        (fun t => t * (Pi.single (M := fun _ => ℝ) i 1 j))) := by
  obtain ⟨φ,hφ,hφ0,hnear⟩ := exists_link_chart f hf g hg hzero hgn hgt
  let line : ι → ℝ → (ι → ℝ) := fun i t => t • Pi.single i 1
  have hline0 : ∀ i, line i 0 = 0 := by intro i; simp [line]
  have hline : ∀ i, AnalyticAt ℝ (line i) 0 := fun _ => analyticAt_id.smul analyticAt_const
  have hc : ∀ i, AnalyticAt ℝ (fun t => φ (line i t)) 0 := by
    intro i
    apply AnalyticAt.comp _ (hline i)
    simpa only [hline0] using hφ
  let γ : ι → Option (Option ι) → ℝ → ℝ := fun i j t => φ (line i t) j
  have hconstraints : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ),
      constraintMap f (φ (line i t)) = parameterEmbed (line i t) := by
    intro i
    have ht := (hline i).continuousAt.tendsto
    rw [hline0] at ht
    exact ht.eventually hnear
  refine ⟨γ,?_,?_,?_,?_,?_⟩
  · intro i j
    exact ((ContinuousLinearMap.proj j : Ambient ι →L[ℝ] ℝ).analyticAt _).comp (hc i)
  · intro i j
    dsimp [γ]
    rw [hline0,hφ0]
  · intro i
    filter_upwards [hconstraints i] with t ht
    exact congrFun ht none
  · intro i
    filter_upwards [hconstraints i] with t ht
    exact congrFun ht (some none)
  · intro i j
    filter_upwards [hconstraints i] with t ht
    exact congrFun ht (some (some j))

end
end Source29AnalyticLinkChart

/- Component: AnalyticLinkCurveJets.inc -/
namespace Source29AnalyticLinkCurveJets

open Filter MvPolynomial Source29PolynomialLinkChart
open Source29RealPolynomialCurveJets Source29PolynomialCurveCoordinateJets
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29PolynomialLinkCurveJets (linear_deriv linear_second_deriv)
open Source29NormalShiftDerivatives (second)
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Differentiating the actual two link constraints fixes the first and
second normal/radial derivatives of each coordinate curve. -/
theorem link_curve_jets
    (f : Ambient ι → ℝ) (hf : AnalyticAt ℝ f base) (g : ℝ) (hg : g ≠ 0)
    (hgn : fderiv ℝ f base (Pi.single none 1) = g)
    (hgt : ∀ j, fderiv ℝ f base (Pi.single (some j) 1) = 0)
    (γ : Option (Option ι) → ℝ → ℝ) (i : ι)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) 0) (hγ0 : ∀ j, γ j 0 = base j)
    (hzero : (fun t => f (fun j => γ j t)) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0))
    (hsphere : (fun t => ∑ j, (γ j t)^2) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1))
    (htangent : ∀ j, γ (some (some j)) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => t * (Pi.single (M := fun _ => ℝ) i 1 j))) :
    (∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j) ∧
    (∀ j, deriv (deriv (γ j)) 0 =
      -Pi.single (M := fun _ => ℝ) (some none) 1 j -
      (second f base (Pi.single (some (some i)) 1) (Pi.single (some (some i)) 1)/g) *
        Pi.single (M := fun _ => ℝ) none 1 j) := by
  have h0 : (fun j => γ j 0) = base := funext hγ0
  have hn1 := hzero.deriv_eq
  rw [Source29AnalyticCurveCoordinateJets.first_deriv_curve f γ 0 (h0.symm ▸ hf) hγ, deriv_const, h0] at hn1
  simp only [Fintype.sum_option, hgn, hgt, zero_mul, Finset.sum_const_zero, add_zero] at hn1
  have hn : deriv (γ none) 0 = 0 := (mul_eq_zero.mp hn1).resolve_left hg
  have hS : (fun t => eval (fun j => γ j t)
      (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ)) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 1) := by
    simpa only [eval_spherePolynomial] using hsphere
  have hr1 := hS.deriv_eq
  rw [first_deriv_eval_curve spherePolynomial γ 0 hγ, deriv_const, h0,
    ← evalFDeriv_apply, evalFDeriv_spherePolynomial] at hr1
  simp only [base, Pi.single_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hr1
  have hr : deriv (γ (some none)) 0 = 0 := by linarith
  have ht1 : ∀ j, deriv (γ (some (some j))) 0 = Pi.single (M := fun _ => ℝ) i 1 j := by
    intro j
    rw [(htangent j).deriv_eq, linear_deriv]
  have hv : ∀ j, deriv (γ j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j := by
    intro j
    cases j with
    | none => simp [hn]
    | some j => cases j with
      | none => simp [hr]
      | some j => simpa only [Pi.single_apply, Option.some.injEq] using ht1 j
  have hn2 := hzero.deriv.deriv_eq
  rw [Source29AnalyticCurveCoordinateJets.coordinate_velocity_second f γ base (some (some i)) hf hγ hγ0 hv,
    deriv_const', deriv_const] at hn2
  simp only [Fintype.sum_option, hgn, hgt, zero_mul, Finset.sum_const_zero, add_zero] at hn2
  have hnsecond : deriv (deriv (γ none)) 0 =
      -second f base (Pi.single (some (some i)) 1) (Pi.single (some (some i)) 1)/g := by
    apply (eq_div_iff hg).mpr
    nlinarith [hn2]
  have hr2 := hS.deriv.deriv_eq
  rw [coordinate_velocity_second spherePolynomial γ base (some (some i)) hγ hγ0 hv,
    deriv_const', deriv_const] at hr2
  have hdiag : eval base (pderiv (some (some i)) (pderiv (some (some i))
      (spherePolynomial : MvPolynomial (Option (Option ι)) ℝ))) = 2 := by
    simp [pderiv_spherePolynomial, base]
  rw [hdiag, ← evalFDeriv_apply, evalFDeriv_spherePolynomial] at hr2
  simp only [base, Pi.single_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hr2
  have hrsecond : deriv (deriv (γ (some none))) 0 = -1 := by linarith
  have ht2 : ∀ j, deriv (deriv (γ (some (some j)))) 0 = 0 := by
    intro j
    rw [(htangent j).deriv.deriv_eq, linear_second_deriv]
  refine ⟨hv, ?_⟩
  intro j
  cases j with
  | none => simpa [Pi.single_apply, neg_div] using hnsecond
  | some j => cases j with
    | none => simpa [Pi.single_apply] using hrsecond
    | some j => simpa [Pi.single_apply] using ht2 j

/-- The analytic implicit chart supplies actual spherical-link curves with
all first and second coordinate jets fixed by the two constraints. -/
theorem exists_link_curves_with_jets
    (f : Ambient ι → ℝ) (hf : AnalyticAt ℝ f base) (g : ℝ) (hg : g ≠ 0)
    (hzero : f base = 0) (hgn : fderiv ℝ f base (Pi.single none 1) = g)
    (hgt : ∀ j, fderiv ℝ f base (Pi.single (some j) 1) = 0) :
    ∃ γ : ι → Option (Option ι) → ℝ → ℝ,
      (∀ i j, AnalyticAt ℝ (γ i j) 0) ∧
      (∀ i j, γ i j 0 = base j) ∧
      (∀ i j, deriv (γ i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j) ∧
      (∀ i j, deriv (deriv (γ i j)) 0 =
        -Pi.single (M := fun _ => ℝ) (some none) 1 j -
        (second f base (Pi.single (some (some i)) 1) (Pi.single (some (some i)) 1)/g) *
          Pi.single (M := fun _ => ℝ) none 1 j) ∧
      (∀ i, ∀ᶠ t in 𝓝 (0 : ℝ),
        f (fun j => γ i j t) = 0 ∧ (∑ j, (γ i j t)^2) = 1) := by
  obtain ⟨γ,hγ,hγ0,hγzero,hγsphere,hγtangent⟩ :=
    Source29AnalyticLinkChart.exists_link_curves f hf g hg hzero hgn hgt
  have hjets := fun i => link_curve_jets f hf g hg hgn hgt (γ i) i
    (hγ i) (hγ0 i) (hγzero i) (hγsphere i) (hγtangent i)
  refine ⟨γ,hγ,hγ0,(fun i => (hjets i).1),(fun i => (hjets i).2),?_⟩
  intro i
  filter_upwards [hγzero i,hγsphere i] with t ht hs
  exact ⟨ht,hs⟩

end
end Source29AnalyticLinkCurveJets

/- Component: AnalyticLinkJacobi.inc -/
namespace Source29AnalyticLinkJacobi

open Filter Source29AnalyticNormalTrace
open Source29AnalyticCurveCoordinateJets
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The differentiated level equation and real-degree radial identities give
the normal third-derivative trace along the spherical link. -/
theorem link_third_trace
    (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : g ≠ 0)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : hess f base (some none) none = (D-1)*g)
    (hrr : third f base (some none) (some none) none = (D-2)*(D-1)*g) :
    g * (∑ i, third f base none (some (some i)) (some (some i))) =
      2 * (∑ i, (hess f base none (some (some i)))^2) + D*(D-1)*g^2 := by
  have he := derivative_trace f base g hg hf hL hgn hgt none
  have hH : hess f base none (some none) = (D-1)*g := by
    rw [hess_symm f base hf]
    exact hrad
  have hT : third f base none (some none) (some none) = (D-2)*(D-1)*g := by
    rw [third_swap12 f base hf, third_swap23 f base hf]
    exact hrr
  rw [Fintype.sum_option, Fintype.sum_option, hH, hT] at he
  simp only [← pow_two] at he
  nlinarith [he]

/-- The actual inverse-gradient profile satisfies the Jacobi equation along
analytic curves with the spherical-link velocity and acceleration. -/
theorem jacobi_of_link_curve_jets
    (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : 0 < g)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (hrr : third f base (some none) (some none) none = (D-2)*(D-1)*g)
    (γ : ι → Option (Option ι) → ℝ → ℝ)
    (hγ : ∀ i j, AnalyticAt ℝ (γ i j) 0)
    (hγ0 : ∀ i j, γ i j 0 = base j)
    (hγ1 : ∀ i j, deriv (γ i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j)
    (hγ2 : ∀ i j, deriv (deriv (γ i j)) 0 =
      -Pi.single (M := fun _ => ℝ) (some none) 1 j -
        (hess f base (some (some i)) (some (some i))/g) * Pi.single (M := fun _ => ℝ) none 1 j) :
    (∑ i, deriv (deriv (fun t =>
      (Source29AnalyticTensorNorm.tensorNorm (grad f (fun a => γ i a t)))⁻¹)) 0) +
      ((∑ i, ∑ j, (hess f base (some (some j)) (some (some i)))^2)/g^2 +
        (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹ = 0 := by
  let H : ι → ι → ℝ := fun j i => hess f base (some (some j)) (some (some i))
  let G : ι → Option (Option ι) → ℝ → ℝ := fun i j t => grad f (fun a => γ i a t) j
  let v : ι → ℝ := fun i => hess f base none (some (some i))
  let T : ι → ℝ := fun i => third f base none (some (some i)) (some (some i))
  let b : ℝ := hess f base none none
  have hx : ∀ i, (fun j => γ i j 0) = (base : Option (Option ι) → ℝ) :=
    fun i => funext (hγ0 i)
  have hr : hess f base (some none) none = (D-1)*g := by rw [hrad, hgn]
  have hrzero : ∀ j, hess f base (some none) (some j) = 0 := by
    intro j
    rw [hrad, hgt, mul_zero]
  have hfirst : ∀ i j, deriv (G i j) 0 = hess f base (some (some i)) j := by
    intro i j
    exact coordinate_velocity_first (coordPartial f j) (γ i) base (some (some i))
      (partial_analyticAt f base hf j) (hγ i) (hγ0 i) (hγ1 i)
  have hsecond : ∀ i, deriv (deriv (G i none)) 0 = T i - (D-1)*g - b*H i i/g := by
    intro i
    have he := coordinate_velocity_second (coordPartial f none) (γ i) base (some (some i))
      (partial_analyticAt f base hf none) (hγ i) (hγ0 i) (hγ1 i)
    change deriv (deriv (G i none)) 0 =
      third f base (some (some i)) (some (some i)) none +
        ∑ j, hess f base j none * deriv (deriv (γ i j)) 0 at he
    have ht : third f base (some (some i)) (some (some i)) none = T i := by
      dsimp [T]
      rw [third_swap23 f base hf, third_swap12 f base hf]
    rw [he, ht]
    simp only [hγ2, mul_sub, mul_neg, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
      Pi.single_apply, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    rw [hr]
    dsimp [b, H]
    ring
  have htrace : (∑ i, H i i) = 0 := by
    have he := tangential_trace_zero f base g hg.ne' hL.self_of_nhds hgn hgt
    rw [Fintype.sum_option, hrzero none, zero_add] at he
    exact he
  apply Source29JacobiProfileJets.jacobi_for_gradient_curves G g D b v T H hg
  · intro i j
    have hp : AnalyticAt ℝ (coordPartial f j) (fun a => γ i a 0) :=
      (hx i).symm ▸ partial_analyticAt f base hf j
    exact AnalyticAt.comp (f := fun t a => γ i a t) hp (AnalyticAt.pi (hγ i))
  · intro i
    change grad f (fun a => γ i a 0) none = g
    rw [hx]
    exact hgn
  · intro i j
    change grad f (fun a => γ i a 0) (some j) = 0
    rw [hx]
    exact hgt j
  · intro i
    rw [hfirst, hess_symm f base hf]
  · intro i
    rw [hfirst, hess_symm f base hf]
    exact hrzero (some i)
  · intro i j
    rw [hfirst, hess_symm f base hf]
  · exact hsecond
  · exact htrace
  · exact link_third_trace f D g hg.ne' hf hL hgn hgt hr hrr

/-- Positive real-degree homogeneity supplies the radial identities in the
analytic Jacobi equation. -/
theorem jacobi_of_homogeneous_link_curve_jets
    (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Option (Option ι) → ℝ)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (γ : ι → Option (Option ι) → ℝ → ℝ)
    (hγ : ∀ i j, AnalyticAt ℝ (γ i j) 0) (hγ0 : ∀ i j, γ i j 0 = base j)
    (hγ1 : ∀ i j, deriv (γ i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j)
    (hγ2 : ∀ i j, deriv (deriv (γ i j)) 0 =
      -Pi.single (M := fun _ => ℝ) (some none) 1 j -
        (hess f base (some (some i)) (some (some i))/g) * Pi.single (M := fun _ => ℝ) none 1 j) :
    (∑ i, deriv (deriv (fun t =>
      (Source29AnalyticTensorNorm.tensorNorm (grad f (fun a => γ i a t)))⁻¹)) 0) +
      ((∑ i, ∑ j, (hess f base (some (some j)) (some (some i)))^2)/g^2 +
        (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹ = 0 := by
  have hr : ∀ j, hess f base (some none) j = (D-1)*grad f base j := by
    intro j
    exact Source29AnalyticHomogeneousRadialJets.radial_hessian f D U hU hcone hf hhom
      base hx (Pi.single j 1)
  have hrr : third f base (some none) (some none) none = (D-2)*(D-1)*g := by
    rw [← hgn]
    exact Source29AnalyticHomogeneousRadialJets.radial_radial_third f D U hU hcone hf hhom
      base hx (Pi.single none 1)
  exact jacobi_of_link_curve_jets f D g hg (hf base hx) hL hgn hgt hr hrr γ hγ hγ0 hγ1 hγ2

end
end Source29AnalyticLinkJacobi

/- Component: FinitePositiveCofactorRoot.inc -/
namespace Source29FinitePositiveCofactorRoot

open MvPolynomial Filter
open Source29AnalyticNormalTrace Source29NormalShiftAlgebra
open Source29AnalyticTensorNorm
open scoped Topology BigOperators

noncomputable section

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- The positive defining root, with an arbitrary finite coordinate index. -/
def definingRoot (P Q : MvPolynomial I ℝ) (k : ℕ) (x : I → ℝ) : ℝ :=
  eval x P * (eval x Q)^((k : ℝ)⁻¹)

lemma partial_eval (P : MvPolynomial I ℝ) (x : I → ℝ) (i : I) :
    coordPartial (fun y => eval y P) i x = eval x (pderiv i P) := by
  unfold coordPartial
  rw [Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval,
    Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis]

lemma hess_eval (P : MvPolynomial I ℝ) (x : I → ℝ) (i j : I) :
    hess (fun y => eval y P) x i j = eval x (pderiv i (pderiv j P)) := by
  have he : coordPartial (fun y => eval y P) j = (fun y => eval y (pderiv j P)) :=
    funext (fun y => partial_eval P y j)
  change coordPartial (coordPartial (fun y => eval y P) j) i x = _
  rw [he, partial_eval]

lemma levelOperator_eval (P : MvPolynomial I ℝ) (x : I → ℝ) :
    levelOperator (fun y => eval y P) x =
      eval x (Source29QuarticReuse.QuarticMinimal.leadingOperator P) := by
  simp only [levelOperator, cubicLevel, dot, trace, bilinear, grad, partial_eval, hess_eval,
    Source29QuarticReuse.QuarticMinimal.leadingOperator,
    Source29QuarticReuse.QuarticMinimal.laplacian, map_sub, map_mul, map_sum, pow_two]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

lemma levelOperator_analyticAt (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) : AnalyticAt ℝ (levelOperator f) x :=
  ((analyticAt_dot (grad f) (grad f) x (fun i => partial_analyticAt f x hf i)
    (fun i => partial_analyticAt f x hf i)).mul
      (analyticAt_trace (hess f) x (hess_analyticAt f x hf))).sub
    (analyticAt_bilinear (hess f) (grad f) (grad f) x (hess_analyticAt f x hf)
      (fun i => partial_analyticAt f x hf i) (fun i => partial_analyticAt f x hf i))

lemma levelOperator_congr {f g : (I → ℝ) → ℝ} {x : I → ℝ}
    (he : f =ᶠ[𝓝 x] g) : levelOperator f x = levelOperator g x := by
  have hg : grad f x = grad g x := by
    unfold grad coordPartial
    rw [he.fderiv_eq]
  have hH : hess f x = hess g x := by
    funext i j
    have hfirst : coordPartial f j =ᶠ[𝓝 x] coordPartial g j :=
      (he.fderiv (𝕜 := ℝ)).mono (fun y hy =>
        congrArg (fun D : (I → ℝ) →L[ℝ] ℝ => D (Pi.single j 1)) hy)
    change fderiv ℝ (coordPartial f j) x (Pi.single i 1) =
      fderiv ℝ (coordPartial g j) x (Pi.single i 1)
    exact congrArg (fun D : (I → ℝ) →L[ℝ] ℝ => D (Pi.single i 1)) hfirst.fderiv_eq
  unfold levelOperator
  rw [hg, hH]

lemma levelOperator_pow (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (k : ℕ) :
    levelOperator (fun y => f y^k) x = ((k : ℝ)*f x^(k-1))^3 * levelOperator f x := by
  let φ : ℝ → ℝ := fun t => t^k
  have hφ : AnalyticAt ℝ φ (f x) := analyticAt_id.pow k
  have hg : grad (fun y => φ (f y)) x = fun i => deriv φ (f x) * grad f x i := by
    funext i
    exact Source29AnalyticScalarLevelOperator.first_comp φ f x _ hφ hf
  have hH : hess (fun y => φ (f y)) x = fun i j =>
      deriv φ (f x) * hess f x i j +
        deriv (deriv φ) (f x) * (grad f x i * grad f x j) := by
    funext i j
    exact Source29AnalyticScalarLevelOperator.second_comp φ f x _ _ hφ hf
  change cubicLevel (grad (fun y => φ (f y)) x) (hess (fun y => φ (f y)) x) = _
  rw [hg, hH, Source29AnalyticScalarLevelOperator.cubicLevel_rank_one]
  have hd : deriv φ (f x) = (k : ℝ)*f x^(k-1) := by simp [φ]
  rw [hd]
  rfl

lemma levelOperator_zero_of_power (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (hreg : grad f x ≠ 0) (k : ℕ) (hk : 0 < k)
    (hpow : ∀ᶠ y in 𝓝 x, levelOperator (fun z => f z^k) y = 0) :
    ∀ᶠ y in 𝓝 x, levelOperator f y = 0 := by
  let A : (I → ℝ) → ℝ := fun y => ((k : ℝ)*f y^(k-1))^3
  have hA : AnalyticAt ℝ A x := (analyticAt_const.mul (hf.pow (k-1))).pow 3
  have hprod : ∀ᶠ y in 𝓝 x, A y * levelOperator f y = 0 := by
    filter_upwards [hpow, hf.eventually_analyticAt] with y hy hay
    rwa [levelOperator_pow f y hay k] at hy
  rcases Source29AnalyticGraphFactor.zero_germ_of_mul_zero A (levelOperator f) x
    hA (levelOperator_analyticAt f x hf) hprod with hz | hz
  · have hflat : f =ᶠ[𝓝 x] (fun _ => 0) := by
      filter_upwards [hz] with y hy
      have hm : (k : ℝ)*f y^(k-1) = 0 := eq_zero_of_pow_eq_zero hy
      exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp hm).resolve_left
        (Nat.cast_ne_zero.mpr hk.ne'))
    apply (hreg ?_).elim
    unfold grad coordPartial
    rw [hflat.fderiv_eq]
    funext i
    simp
  · exact hz

omit [DecidableEq I] in
lemma rootUnit_analyticAt (Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hQ : 0 < eval x Q) :
    AnalyticAt ℝ (fun y => (eval y Q)^((k : ℝ)⁻¹)) x :=
  AnalyticAt.comp (f := fun y => eval y Q)
    (Source29PositiveCofactorRoot.positive_root_analyticAt k hk hQ)
    (Source29PolynomialLinkChart.analyticAt_eval_real Q x)

omit [DecidableEq I] in
lemma definingRoot_analyticAt (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hQ : 0 < eval x Q) : AnalyticAt ℝ (definingRoot P Q k) x :=
  (Source29PolynomialLinkChart.analyticAt_eval_real P x).mul (rootUnit_analyticAt Q k hk x hQ)

omit [Fintype I] [DecidableEq I] in
lemma definingRoot_pow (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hQ : 0 < eval x Q) : definingRoot P Q k x ^ k = eval x (P^k*Q) := by
  simp only [definingRoot, mul_pow, map_mul, map_pow, Real.rpow_inv_natCast_pow hQ.le hk.ne']

lemma definingRoot_gradient (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q) :
    grad (definingRoot P Q k) x = fun i => (eval x Q)^((k : ℝ)⁻¹) * eval x (pderiv i P) := by
  funext i
  unfold grad coordPartial definingRoot
  rw [fderiv_fun_mul (Source29PolynomialLinkChart.analyticAt_eval_real P x).differentiableAt
    (rootUnit_analyticAt Q k hk x hQ).differentiableAt]
  simp only [hP, zero_smul, zero_add, smul_apply, smul_eq_mul]
  rw [Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval,
    Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis]

/-- A finite-index version of the positive-root PDE inheritance. -/
theorem definingRoot_levelOperator_zero (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator (P^k*Q) = 0)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    ∀ᶠ y in 𝓝 x, levelOperator (definingRoot P Q k) y = 0 := by
  have hn : grad (definingRoot P Q k) x ≠ 0 := by
    rw [definingRoot_gradient P Q k hk x hP hQ]
    intro hz
    apply hreg
    funext i
    exact (mul_eq_zero.mp (congrFun hz i)).resolve_left (Real.rpow_pos_of_pos hQ _).ne'
  have he : (fun y => definingRoot P Q k y ^ k) =ᶠ[𝓝 x] (fun y => eval y (P^k*Q)) := by
    filter_upwards [(Source29PolynomialLinkChart.analyticAt_eval_real Q x).continuousAt.eventually
      (lt_mem_nhds hQ)] with y hy
    exact definingRoot_pow P Q k hk y hy
  apply levelOperator_zero_of_power _ x (definingRoot_analyticAt P Q k hk x hQ) hn k hk
  filter_upwards [he.eventuallyEq_nhds] with y hy
  rw [levelOperator_congr hy, levelOperator_eval, hF, map_zero]

omit [Fintype I] [DecidableEq I] in
lemma eval_smul_pos (Q : MvPolynomial I ℝ) (q : ℕ) (hQ : Q.IsHomogeneous q)
    (x : I → ℝ) (hx : 0 < eval x Q) (t : ℝ) (ht : 0 < t) : 0 < eval (t • x) Q := by
  rw [show t • x = fun i => t*x i from rfl,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous Q q hQ x t]
  exact mul_pos (pow_pos ht q) hx

omit [Fintype I] [DecidableEq I] in
lemma definingRoot_smul (P Q : MvPolynomial I ℝ) (p q k : ℕ)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (x : I → ℝ) (hx : 0 < eval x Q) (t : ℝ) (ht : 0 < t) :
    definingRoot P Q k (t • x) = t^((p : ℝ)+(q : ℝ)/(k : ℝ)) * definingRoot P Q k x := by
  simp only [definingRoot]
  rw [show t • x = fun i => t*x i from rfl,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous P p hP x t,
    Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous Q q hQ x t,
    Real.mul_rpow (pow_nonneg ht.le q) hx.le, Real.rpow_add ht, Real.rpow_natCast,
    div_eq_mul_inv, Real.rpow_natCast_mul ht.le]
  ring

/-- The profile is the inverse kth root of the leading normal coefficient. -/
theorem inverse_gradient_profile_eq (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (hreg : (fun i => eval x (pderiv i P)) ≠ 0) :
    (tensorNorm (grad (definingRoot P Q k) x))⁻¹ =
      (tensorNorm (fun i => eval x (pderiv i P))^k * eval x Q)^(-((k : ℝ)⁻¹)) := by
  have hn := tensorNorm_pos hreg
  rw [definingRoot_gradient P Q k hk x hP hQ,
    Source29PositiveCofactorRoot.tensorNorm_scale_pos _ _ (Real.rpow_pos_of_pos hQ _),
    Real.rpow_neg (mul_nonneg (pow_nonneg hn.le k) hQ.le),
    Real.mul_rpow (pow_nonneg hn.le k) hQ.le, Real.pow_rpow_inv_natCast hn.le hk.ne']
  rw [mul_comm]

end
end Source29FinitePositiveCofactorRoot

/- Component: AnalyticPositiveRootJacobi.inc -/
namespace Source29AnalyticPositiveRootJacobi

open Filter MvPolynomial Source29AnalyticNormalTrace
open Source29PolynomialLinkChart (base)
open scoped Topology BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Actual analytic link curves and the Jacobi equation for their positive
inverse-gradient profile. The acceleration is that of the spherical link. -/
structure LinkJacobiData (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) where
  curve : ι → Option (Option ι) → ℝ → ℝ
  analytic : ∀ i j, AnalyticAt ℝ (curve i j) 0
  initial : ∀ i j, curve i j 0 = base j
  velocity : ∀ i j, deriv (curve i j) 0 = Pi.single (M := fun _ => ℝ) (some (some i)) 1 j
  acceleration : ∀ i j, deriv (deriv (curve i j)) 0 =
    -Pi.single (M := fun _ => ℝ) (some none) 1 j -
      (hess f base (some (some i)) (some (some i))/g) * Pi.single (M := fun _ => ℝ) none 1 j
  level_sphere : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ),
    f (fun j => curve i j t) = 0 ∧ (∑ j, (curve i j t)^2) = 1
  profile_analytic : ∀ i, AnalyticAt ℝ (fun t =>
    (Source29AnalyticTensorNorm.tensorNorm (grad f (fun j => curve i j t)))⁻¹) 0
  profile_positive : ∀ i, 0 <
    (Source29AnalyticTensorNorm.tensorNorm (grad f (fun j => curve i j 0)))⁻¹
  jacobi : (∑ i, deriv (deriv (fun t =>
    (Source29AnalyticTensorNorm.tensorNorm (grad f (fun j => curve i j t)))⁻¹)) 0) +
    ((∑ i, ∑ j, (hess f base (some (some j)) (some (some i)))^2)/g^2 +
      (D-1)*(D-(Fintype.card ι : ℝ))) * g⁻¹ = 0

/-- An analytic homogeneous minimal level function produces the actual
positive Jacobi profile, without assumptions about the existence of curves. -/
theorem exists_link_jacobi_data
    (f : (Option (Option ι) → ℝ) → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Option (Option ι) → ℝ)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hzero : f base = 0) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0) :
    Nonempty (LinkJacobiData f D g) := by
  obtain ⟨γ,hγ,hγ0,hγ1,hγ2,hγlevel⟩ :=
    Source29AnalyticLinkCurveJets.exists_link_curves_with_jets f (hf base hx) g hg.ne'
      hzero hgn hgt
  have hn : grad f base ≠ 0 := by
    intro he
    have he' := congrFun he none
    rw [hgn] at he'
    exact hg.ne' he'
  have ha : AnalyticAt ℝ (fun y => (Source29AnalyticTensorNorm.tensorNorm (grad f y))⁻¹) base :=
    (Source29AnalyticTensorNorm.tensorNorm_analyticAt (grad f) base
      (fun j => partial_analyticAt f base (hf base hx) j) hn).inv
        (Source29AnalyticTensorNorm.tensorNorm_pos hn).ne'
  refine ⟨⟨γ, hγ, hγ0, hγ1, hγ2, hγlevel, ?_, ?_, ?_⟩⟩
  · intro i
    have he : (fun j => γ i j 0) = (base : Option (Option ι) → ℝ) := funext (hγ0 i)
    exact AnalyticAt.comp (f := fun t j => γ i j t) (he.symm ▸ ha) (AnalyticAt.pi (hγ i))
  · intro i
    have he : (fun j => γ i j 0) = (base : Option (Option ι) → ℝ) := funext (hγ0 i)
    rw [he]
    exact inv_pos.mpr (Source29AnalyticTensorNorm.tensorNorm_pos hn)
  · exact Source29AnalyticLinkJacobi.jacobi_of_homogeneous_link_curve_jets f D g hg U hU hx
      hcone hf hhom hL hgn hgt γ hγ hγ0 hγ1 hγ2

/-- Applying the analytic Jacobi theorem to the positive kth root of P^kQ.
The cubic equation is required for P^kQ itself, and no equation for P is assumed. -/
theorem definingRoot_link_jacobi
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (p q k : ℕ) (hk : 0 < k)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator (P^k*Q) = 0)
    (hzero : eval base P = 0) (hpos : 0 < eval base Q)
    (a : ℝ) (ha : 0 < a) (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0) :
    Nonempty (LinkJacobiData (Source29FinitePositiveCofactorRoot.definingRoot P Q k)
      ((p : ℝ)+(q : ℝ)/(k : ℝ)) ((eval base Q)^((k : ℝ)⁻¹)*a)) := by
  let f := Source29FinitePositiveCofactorRoot.definingRoot P Q k
  let U : Set (Option (Option ι) → ℝ) := {x | 0 < eval x Q}
  have hU : IsOpen U := isOpen_lt continuous_const
    (show Continuous (fun x => eval x Q) from continuous_iff_continuousAt.mpr
      (fun x => (Source29PolynomialLinkChart.analyticAt_eval_real Q x).continuousAt))
  have hreg : (fun i => eval base (pderiv i P)) ≠ 0 := by
    intro he
    have he' := congrFun he none
    rw [hpn] at he'
    exact ha.ne' he'
  have hg : 0 < (eval base Q)^((k : ℝ)⁻¹)*a := mul_pos (Real.rpow_pos_of_pos hpos _) ha
  have hgn : grad f base none = (eval base Q)^((k : ℝ)⁻¹)*a := by
    rw [Source29FinitePositiveCofactorRoot.definingRoot_gradient P Q k hk base hzero hpos]
    simp only [hpn]
  have hgt : ∀ j, grad f base (some j) = 0 := by
    intro j
    rw [Source29FinitePositiveCofactorRoot.definingRoot_gradient P Q k hk base hzero hpos]
    simp only [hpt, mul_zero]
  apply exists_link_jacobi_data f _ _ hg U hU hpos
    (fun x hx t ht => Source29FinitePositiveCofactorRoot.eval_smul_pos Q q hQ x hx t ht)
    (fun x hx => Source29FinitePositiveCofactorRoot.definingRoot_analyticAt P Q k hk x hx)
    (fun x hx t ht => Source29FinitePositiveCofactorRoot.definingRoot_smul P Q p q k hP hQ x hx t ht)
    _ (Source29FinitePositiveCofactorRoot.definingRoot_levelOperator_zero P Q k hk hF base hzero hpos hreg)
    hgn hgt
  change eval base P * _ = 0
  rw [hzero, zero_mul]

end
end Source29AnalyticPositiveRootJacobi

/- Component: AnalyticSecondTrace.inc -/
namespace Source29AnalyticSecondTrace

