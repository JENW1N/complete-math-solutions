  · rfl
  · simp only [hv0, add_dotProduct, dotProduct_add, hunit, self_dot_reflect,
      dot_reflect, reflect_apply, Pi.add_apply, div_one]
    rw [dotProduct_comm dv u]
    ring

end
end Source29ReflectionCurveDerivative

/- Component: PairFrameDerivative.inc -/
