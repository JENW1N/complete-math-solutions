  rfl

theorem radialCutoff_mass_tendsto (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree) :
    Tendsto (fun k ↦ normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) radialCutoff (dilationRadius k))
      atTop (𝓝 (radialPhaseFlux (homogeneousComponent P.totalDegree P) radialCutoff)) := by
  apply radial_mass_tendsto P hmin hdeg radialCutoff_contDiff (M := 1) _ radialCutoff_zero radialCutoff_deriv_zero
  intro s
  rw [Real.norm_eq_abs, abs_of_nonneg (radialCutoff_bounds s).1]
  exact (radialCutoff_bounds s).2

end
end Source29PolynomialRadialLimit

/- Component: RadialEndpointFlux.inc -/
namespace Source29RadialEndpointFlux

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29RadialPrimitiveCalculus Source29RadialPrimitiveBounds
open Source29AmbientGraphCalculus Source29GraphRadialSupport Source29PolynomialRadialLimit
open Source29PhaseMassLimit
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def endpoint (f : ℝ → ℝ) (x : Fin n → ℝ) : ℝ := primitive f (x,2)

theorem endpoint_contDiff {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) : ContDiff ℝ 1 (endpoint (n := n) f) :=
  (primitive_contDiff hf).comp (contDiff_id.prodMk contDiff_const)

theorem endpoint_compact {f : ℝ → ℝ} (hz : ∀ s, 2 ≤ s → f s = 0) :
    HasCompactSupport (endpoint (n := n) f) :=
  graph_composition_compact (supportBox_compact n 2) (primitive_zero_outside hz) (fun _ ↦ 2)

theorem endpoint_fderiv {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (endpoint f) x (Pi.single i 1) = baseEndpoint f x i := by
  have hp := Source29CompactIntervalParameter.parameterDerivative_hasFDerivAt (primitive_contDiff hf) x 2
  change HasFDerivAt (endpoint f) _ x at hp
  rw [hp.fderiv]
  change baseDerivative (primitive f) x 2 i = baseEndpoint f x i
  exact primitive_baseDerivative hf x 2 i

theorem radialPhaseFlux_eq_twice_phaseMass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hz : ∀ s, 2 ≤ s → f s = 0) :
    radialPhaseFlux (homogeneousComponent P.totalDegree P) f =
      2 * phaseMass (homogeneousComponent P.totalDegree P) (endpoint f) := by
  let Q := homogeneousComponent P.totalDegree P
  have hQ : Q ≠ 0 := Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P (by omega)
  have hc := Source29TopWeakCalibration.top_weak_calibration P hmin hdeg (endpoint_contDiff hf) (endpoint_compact hz)
  let W := testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField Q)
  have hw : Integrable W := hc.1
  have hweighted := Source29PhaseApproximation.phase_weight_integrable Q hQ W hw
  have he (x : Fin n → ℝ) :
      (∑ i, (if 0 < eval x Q then baseEndpoint f x i else -baseEndpoint f x i) * leadingNormalizedField Q x i) =
      2 * (W x * (if 0 < eval x Q then 1 else 0)) - W x := by
    unfold W testFlux
    simp only [endpoint_fderiv hf]
    by_cases hp : 0 < eval x Q
    · simp only [ite_eq_left hp, mul_one]
      ring
    · simp only [ite_eq_right hp, neg_mul, Finset.sum_neg_distrib, mul_zero]
      ring
  have hs : (∫ x, 2 * (W x * (if 0 < eval x Q then 1 else 0)) - W x) =
      (∫ x, 2 * (W x * (if 0 < eval x Q then 1 else 0))) - ∫ x, W x :=
    integral_sub (hweighted.const_mul 2) hw
  change -(∫ x, ∑ i, (if 0 < eval x Q then baseEndpoint f x i else -baseEndpoint f x i) * leadingNormalizedField Q x i) = _
  simp_rw [he]
  rw [hs, integral_const_mul]
  have hzero : (∫ x, W x) = 0 := hc.2
  rw [hzero]
  change -(2 * (∫ x, W x * (if 0 < eval x Q then 1 else 0)) - 0) =
    2 * (-(∫ x, W x * (if 0 < eval x Q then 1 else 0)))
  ring

theorem radial_mass_tendsto_phaseMass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {M : ℝ} (hb : ∀ s, ‖f s‖ ≤ M)
    (hz : ∀ s, 2 ≤ s → f s = 0) (hdz : ∀ s, 2 ≤ s → deriv f s = 0) :
    Tendsto (fun k ↦ Source29GraphMassMonotonicity.normalizedMass (fun y ↦ eval y P)
      (evaluatedGradient P) f (dilationRadius k)) atTop
      (𝓝 (2 * phaseMass (homogeneousComponent P.totalDegree P) (endpoint f))) := by
  have ht := radial_mass_tendsto P hmin hdeg hf hb hz hdz
  rwa [radialPhaseFlux_eq_twice_phaseMass P hmin hdeg hf hz] at ht

end
end Source29RadialEndpointFlux

/- Component: CoordinateProductIntegral.inc -/
namespace Source29CoordinateProductIntegral

open MeasureTheory

noncomputable section
variable {n : ℕ}

def splitEquiv : (Fin (n+1) → ℝ) ≃ᵐ ℝ × (Fin n → ℝ) :=
  MeasurableEquiv.piFinSuccAbove (fun _ ↦ ℝ) 0

theorem splitEquiv_symm (p : ℝ × (Fin n → ℝ)) :
    splitEquiv.symm p = Fin.cons p.1 p.2 := by
  change @Fin.insertNth n (fun _ ↦ ℝ) 0 p.1 p.2 = _
  exact Fin.insertNth_zero' _ _

theorem splitEquiv_preserving : MeasurePreserving (splitEquiv (n := n)) :=
  volume_preserving_piFinSuccAbove (fun _ ↦ ℝ) 0

theorem cons_integrable {f : (Fin (n+1) → ℝ) → ℝ} (hf : Integrable f) :
    Integrable (fun p : ℝ × (Fin n → ℝ) ↦ f (Fin.cons p.1 p.2)) := by
  have h := splitEquiv_preserving.symm.integrable_comp_of_integrable hf
  simpa only [Function.comp_def, splitEquiv_symm] using h

theorem integral_cons {f : (Fin (n+1) → ℝ) → ℝ} (hf : Integrable f) :
    (∫ x, f x) = ∫ y : Fin n → ℝ, ∫ t : ℝ, f (Fin.cons t y) := by
  have h := splitEquiv_preserving.symm.integral_comp' f
  simp only [splitEquiv_symm] at h
  rw [← h]
  exact integral_prod_symm _ (cons_integrable hf)

end
end Source29CoordinateProductIntegral

/- Component: CoordinateHalfspaceFlux.inc -/
namespace Source29CoordinateHalfspaceFlux

open MeasureTheory MvPolynomial Set
open Source29CoordinateProductIntegral
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem cons_hasDerivAt (y : Fin n → ℝ) (t : ℝ) :
    HasDerivAt (fun s : ℝ ↦ (Fin.cons s y : Fin (n+1) → ℝ)) (Pi.single 0 1) t := by
  have he : Function.update (Fin.cons (0 : ℝ) y : Fin (n+1) → ℝ) 0 = (fun s : ℝ ↦ (Fin.cons s y : Fin (n+1) → ℝ)) := by funext s; exact Fin.update_cons_zero _ _ _
  simpa only [he] using hasDerivAt_update (Fin.cons (0 : ℝ) y : Fin (n+1) → ℝ) 0 t

theorem cons_contDiff (y : Fin n → ℝ) : ContDiff ℝ 1 (fun s : ℝ ↦ (Fin.cons s y : Fin (n+1) → ℝ)) := by
  have he : Function.update (Fin.cons (0 : ℝ) y : Fin (n+1) → ℝ) 0 = (fun s : ℝ ↦ (Fin.cons s y : Fin (n+1) → ℝ)) := by funext s; exact Fin.update_cons_zero _ _ _
  simpa only [he] using (contDiff_update (𝕜 := ℝ) 1 (Fin.cons (0 : ℝ) y : Fin (n+1) → ℝ) 0)

theorem slice_compact {ρ : (Fin (n+1) → ℝ) → ℝ} (hc : HasCompactSupport ρ) (y : Fin n → ℝ) :
    HasCompactSupport (fun t ↦ ρ (Fin.cons t y)) := by
  simpa only [Function.comp_def, Fin.update_cons_zero] using
    hc.comp_isClosedEmbedding (isClosedEmbedding_update (Fin.cons (0 : ℝ) y : Fin (n+1) → ℝ) 0)

theorem slice_deriv {ρ : (Fin (n+1) → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    (y : Fin n → ℝ) (t : ℝ) :
    deriv (fun s ↦ ρ (Fin.cons s y)) t = fderiv ℝ ρ (Fin.cons t y) (Pi.single 0 1) := by
  exact (((hρ.differentiable (by norm_num) (Fin.cons t y)).hasFDerivAt).comp_hasDerivAt t (cons_hasDerivAt y t)).deriv

theorem slice_halfline_integral {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hc : HasCompactSupport ρ) (y : Fin n → ℝ) :
    (∫ t : ℝ, fderiv ℝ ρ (Fin.cons t y) (Pi.single 0 1) * (if 0 < t then 1 else 0)) =
      -ρ (Fin.cons 0 y) := by
  have he : (fun t : ℝ ↦ fderiv ℝ ρ (Fin.cons t y) (Pi.single 0 1) * (if 0 < t then 1 else 0)) =
      (Ioi 0).indicator (deriv (fun s ↦ ρ (Fin.cons s y))) := by
    funext t
    rw [← slice_deriv hρ]
    by_cases ht : 0 < t <;> simp [ht]
  rw [he, integral_indicator measurableSet_Ioi]
  exact HasCompactSupport.integral_Ioi_deriv_eq (hρ.comp (cons_contDiff y)) (slice_compact hc y) 0

/-- The outward derivative flux through a halfspace is exactly its boundary mass. -/
theorem coordinate_halfspace_flux {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hc : HasCompactSupport ρ) :
    -(∫ x, fderiv ℝ ρ x (Pi.single 0 1) * (if 0 < x 0 then 1 else 0)) =
      ∫ y : Fin n → ℝ, ρ (Fin.cons 0 y) := by
  have hi : Integrable (fun x ↦ fderiv ℝ ρ x (Pi.single 0 1)) :=
    ((hρ.continuous_fderiv (by norm_num)).clm_apply continuous_const).integrable_of_hasCompactSupport
      (hc.fderiv_apply ℝ (Pi.single 0 1))
  have hJ : Integrable (fun x ↦ fderiv ℝ ρ x (Pi.single 0 1) * (if 0 < x 0 then 1 else 0)) := by
    simpa only [eval_X] using Source29PhaseApproximation.phase_weight_integrable
      (X (0 : Fin (n+1)) : MvPolynomial (Fin (n+1)) ℝ) (X_ne_zero 0) _ hi
  rw [integral_cons hJ]
  simp only [Fin.cons_zero, slice_halfline_integral hρ hc, integral_neg, neg_neg]

end
end Source29CoordinateHalfspaceFlux

/- Component: EvenRadialIntegral.inc -/
namespace Source29EvenRadialIntegral

open MeasureTheory Set
open Source29EvenCompactPrimitive Source29CoordinateProductIntegral
open Source29RadialPrimitiveCalculus Source29RadialPrimitiveBounds
open Source29RadialEndpointFlux Source29PolynomialSmallDensity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem integral_even_compact {h : ℝ → ℝ} (hh : Continuous h)
    (he : ∀ t, h (-t) = h t) (hz : ∀ t, 2 ≤ |t| → h t = 0) :
    (∫ t : ℝ, h t) = 2 * ∫ t in (0 : ℝ)..2, h t := by
  have hzero : ∀ t : ℝ, t ∉ Icc (-2) 2 → h t = 0 := by
    intro t ht
    apply hz
    by_contra hlt
    exact ht (abs_le.mp (le_of_lt (lt_of_not_ge hlt)))
  have hr := setIntegral_eq_integral_of_forall_compl_eq_zero (μ := volume) hzero
  have hm : (∫ t in (-2 : ℝ)..0, h t) = ∫ t in (0 : ℝ)..2, h t := by
    rw [intervalIntegral.integral_symm, integral_neg he 2, neg_neg]
  calc
    (∫ t : ℝ, h t) = ∫ t in Icc (-2 : ℝ) 2, h t := hr.symm
    _ = ∫ t in (-2 : ℝ)..2, h t := by
      rw [intervalIntegral.integral_of_le (by norm_num), integral_Icc_eq_integral_Ioc]
    _ = (∫ t in (-2 : ℝ)..0, h t) + ∫ t in (0 : ℝ)..2, h t :=
      (intervalIntegral.integral_add_adjacent_intervals (hh.intervalIntegrable (-2) 0) (hh.intervalIntegrable 0 2)).symm
    _ = 2 * ∫ t in (0 : ℝ)..2, h t := by rw [hm]; ring

theorem plane_weight_integrable {f : ℝ → ℝ} (hf : Continuous f)
    (hz : ∀ s, 2 ≤ s → f s = 0) : Integrable (fun x : Fin n → ℝ ↦ f (∑ i, x i^2)) := by
  have hc : Continuous (fun x : Fin n → ℝ ↦ f (∑ i, x i^2)) :=
    hf.comp (continuous_finsetSum _ (fun i _ ↦ (continuous_apply i).pow 2))
  apply hc.integrable_of_hasCompactSupport
  have hs := Source29GraphRadialSupport.scaled_cutoff_compact (fun _ : Fin n → ℝ ↦ (0 : ℝ))
    (r := 1) (by norm_num : (0 : ℝ) ≤ 2) (by norm_num) hz
  simpa only [Source29GraphRadialGeometry.graphRadiusSq, zero_pow (by decide : 2 ≠ 0), add_zero, one_pow, div_one] using hs

/-- Integrating the radial endpoint over a coordinate hyperplane gives half
of the mass of a plane of the original dimension. -/
theorem planeMass_eq_endpoint_integral {f : ℝ → ℝ} (hf : Continuous f)
    (hz : ∀ s, 2 ≤ s → f s = 0) :
    planeMass (n+1) f = 2 * ∫ y : Fin n → ℝ, endpoint f (Fin.cons 0 y) := by
  unfold planeMass
  rw [integral_cons (plane_weight_integrable hf hz)]
  have he (y : Fin n → ℝ) :
      (∫ t : ℝ, f (∑ i : Fin (n+1), (Fin.cons t y : Fin (n+1) → ℝ) i ^ 2)) = 2 * endpoint f (Fin.cons 0 y) := by
    simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
    have hi := integral_even_compact
      (hf.comp (continuous_const.add (continuous_id.pow 2)) : Continuous (fun t : ℝ ↦ f ((∑ i, y i^2)+t^2)))
      (fun t ↦ by simp only [Function.comp_def, neg_sq]) (fun t ht ↦ radialTest_zero_large hz y ht)
    simpa only [endpoint, primitive, radialTest, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      zero_pow (by decide : 2 ≠ 0), zero_add, add_comm, Function.comp_def] using hi
  simp_rw [he]
  exact integral_const_mul _ _

end
end Source29EvenRadialIntegral

