variable {n : ℕ}

theorem linearForm_ne_zero_of_vector (a : Fin (n+1) → ℝ) (ha : a ≠ 0) : linearForm a ≠ 0 := by
  apply linearForm_ne_zero
  by_contra hn
  apply ha
  funext i
  exact not_ne_iff.mp (fun hi ↦ hn ⟨i,hi⟩)

theorem linear_flux_integrable (a : Fin (n+1) → ℝ) {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hc : HasCompactSupport ρ) :
    Integrable (testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField (linearForm a))) := by
  apply Continuous.integrable_of_hasCompactSupport
  · apply testFlux_continuous _ hρ
    intro i
    have he : (fun x ↦ leadingNormalizedField (linearForm a) x i) = fun _ ↦ unitVector a i := by
      funext x
      rw [normalizedField_linearForm]
    rw [he]
    exact continuous_const
  · exact testFlux_hasCompactSupport _ hc

/-- Radial endpoint cutoffs have the same phase mass for every nonzero linear form. -/
theorem phaseMass_linearForm_eq_coordinate (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hz : ∀ s, 2 ≤ s → f s = 0) :
    phaseMass (linearForm a) (endpoint f) = phaseMass (X (0 : Fin (n+1))) (endpoint f) := by
  obtain ⟨U,hU,hUt,hcol⟩ := exists_rotation a ha
  let W := testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField (linearForm a))
  let J := fun x ↦ W x * (if 0 < eval x (linearForm a) then 1 else 0)
  have hW : Integrable W := linear_flux_integrable a (endpoint_contDiff hf) (endpoint_compact hz)
  have hJ : Integrable J := Source29PhaseApproximation.phase_weight_integrable
    (linearForm a) (linearForm_ne_zero_of_vector a ha) W hW
  have hr : 0 < Real.sqrt (radiusSq a) := Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero ha)
  have he (x : Fin (n+1) → ℝ) : J (U *ᵥ x) =
      fderiv ℝ (endpoint f) x (Pi.single 0 1) * (if 0 < x 0 then 1 else 0) := by
    dsimp only [J,W]
    rw [endpoint_testFlux_rotation hf a U hU hcol x, linearForm_eval_rotation a ha U hU hcol x]
    simp only [mul_pos_iff_of_pos_left hr]
  have hi := integral_comp_rotation U hU hJ.aestronglyMeasurable
  change -(∫ x, J x) = _
  rw [← hi]
  simp_rw [he]
  simp only [phaseMass, testFlux_X, eval_X]

theorem twice_linear_phaseMass (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hz : ∀ s, 2 ≤ s → f s = 0) :
    2 * phaseMass (linearForm a) (endpoint f) = planeMass (n+1) f := by
  rw [phaseMass_linearForm_eq_coordinate a ha hf hz]
  exact twice_coordinate_phaseMass hf hz

