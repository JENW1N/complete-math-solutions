noncomputable section
variable {n : ℕ}

theorem evaluatedGradient_linearForm (a x : Fin (n+1) → ℝ) :
    evaluatedGradient (linearForm a) x = a := by
  funext i
  simp [evaluatedGradient, linearForm, pderiv_X, Pi.single_apply, eq_comm]

theorem normalizedField_linearForm (a x : Fin (n+1) → ℝ) :
    leadingNormalizedField (linearForm a) x = unitVector a := by
  funext i
  simp only [leadingNormalizedField, evaluatedGradient_linearForm, unitVector]

theorem column_mulVec (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hcol : ∀ i, U i 0 = unitVector a i) : U *ᵥ Pi.single 0 1 = unitVector a := by
  funext i
  simp [Matrix.mulVec, dotProduct, Pi.single_apply, hcol]

theorem linearForm_eval_rotation (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ) (hU : U.transpose * U = 1)
    (hcol : ∀ i, U i 0 = unitVector a i) (x : Fin (n+1) → ℝ) :
    eval (U *ᵥ x) (linearForm a) = Real.sqrt (radiusSq a) * x 0 := by
  have hR := (Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero ha)).ne'
  have he := Source29QuarticReuse.QuarticMinimal.MatrixAlgebra.dot_transpose_mulVec U.transpose
    (by simpa only [Matrix.transpose_transpose] using hU) (Pi.single 0 1) x
  simp only [Matrix.transpose_transpose, column_mulVec a U hcol] at he
  have he' : unitVector a ⬝ᵥ (U *ᵥ x) = x 0 := by
    simpa [dotProduct, Pi.single_apply] using he
  rw [eval_linearForm]
  calc
    (∑ i, a i * (U *ᵥ x) i) = Real.sqrt (radiusSq a) * (unitVector a ⬝ᵥ (U *ᵥ x)) := by
      rw [dotProduct, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      unfold unitVector
      field_simp
    _ = Real.sqrt (radiusSq a) * x 0 := by rw [he']

theorem endpoint_rotation (f : ℝ → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) (x : Fin (n+1) → ℝ) : endpoint f (U *ᵥ x) = endpoint f x := by
  unfold endpoint primitive Source29RadialPrimitiveCalculus.radialTest
  have he := radiusSq_mulVec U hU x
  change (∫ t in (0 : ℝ)..2, f (radiusSq (U *ᵥ x) + t^2)) =
    ∫ t in (0 : ℝ)..2, f (radiusSq x + t^2)
  rw [he]

theorem testFlux_const (ρ : (Fin (n+1) → ℝ) → ℝ) (v x : Fin (n+1) → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) ρ (fun _ ↦ v) x = fderiv ℝ ρ x v := by
  have hv : v = ∑ i, v i • Pi.single i 1 := by
    funext j
    simp [Pi.single_apply]
  conv_rhs => rw [hv, map_sum]
  simp only [testFlux, map_smul, smul_eq_mul, mul_comm]

theorem endpoint_testFlux_rotation {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (a : Fin (n+1) → ℝ) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) (hcol : ∀ i, U i 0 = unitVector a i) (x : Fin (n+1) → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField (linearForm a)) (U *ᵥ x) =
      fderiv ℝ (endpoint f) x (Pi.single 0 1) := by
  have hn : leadingNormalizedField (linearForm a) = fun _ ↦ unitVector a := by
    funext y
    exact normalizedField_linearForm a y
  rw [hn, testFlux_const]
  let L : (Fin (n+1) → ℝ) →L[ℝ] (Fin (n+1) → ℝ) := (Matrix.toLin' U).toContinuousLinearMap
  have hp := ((endpoint_contDiff hf).differentiable (by norm_num) (U *ᵥ x)).hasFDerivAt.comp x L.hasFDerivAt
  have he : (fun y ↦ endpoint f (L y)) = endpoint f := by
    funext y
    exact endpoint_rotation f U hU y
  change HasFDerivAt (fun y ↦ endpoint f (L y)) _ x at hp
  rw [he] at hp
  have hb := congrArg (fun D : (Fin (n+1) → ℝ) →L[ℝ] ℝ ↦ D (Pi.single 0 1)) hp.fderiv
  change fderiv ℝ (endpoint f) x (Pi.single 0 1) = fderiv ℝ (endpoint f) (U *ᵥ x) (U *ᵥ Pi.single 0 1) at hb
  rw [column_mulVec a U hcol] at hb
  exact hb.symm

end
end Source29LinearEndpointRotation

