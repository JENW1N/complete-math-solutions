namespace Source29Quadric
open MvPolynomial
open scoped BigOperators Polynomial

/- The following compatibility lemma is adapted from
Mathlib/RingTheory/MvPolynomial/IrreducibleQuadratic.lean.
Copyright (c) 2025 Antoine Chambert-Loir. All rights reserved.
Released under Apache 2.0 license as described in mathlib's LICENSE.
Authors: Antoine Chambert-Loir, Johan Commelin, Andrew Yang. -/
lemma irreducible_mul_X_add {n R : Type*} [CommRing R] [IsDomain R]
    (f g : MvPolynomial n R) (i : n) (hf0 : f ≠ 0) (hif : i ∉ f.vars)
    (hig : i ∉ g.vars) (h : IsRelPrime f g) :
    Irreducible (f * X i + g) := by
  classical
  let S := MvPolynomial { j // j ≠ i } R
  let e : MvPolynomial n R ≃ₐ[R] S[X] :=
    (renameEquiv R (Equiv.optionSubtypeNe i).symm).trans (optionEquivLeft R _)
  have he : e.symm.toAlgHom.comp Polynomial.CAlgHom = rename (↑) := by
    ext
    simp [e, S, MvPolynomial.optionEquivLeft_X_none]
  obtain ⟨f, rfl⟩ : f ∈ (e.symm.toAlgHom.comp Polynomial.CAlgHom).range :=
    he ▸ exists_rename_eq_of_vars_subset_range _ _ Subtype.val_injective
      (by simpa [Set.subset_def])
  obtain ⟨g, rfl⟩ : g ∈ (e.symm.toAlgHom.comp Polynomial.CAlgHom).range :=
    he ▸ exists_rename_eq_of_vars_subset_range _ _ Subtype.val_injective
      (by simpa [Set.subset_def])
  refine .of_map (f := e) ?_
  simpa [e, S, MvPolynomial.optionEquivLeft_X_none] using Polynomial.irreducible_C_mul_X_add_C (by aesop)
    (IsRelPrime.of_map Polynomial.C (IsRelPrime.of_map e.symm h))

abbrev Poly := MvPolynomial (Fin 8) ℂ
noncomputable def tailQuadric : Poly :=
  X 2^2 + X 3^2 + X 4^2 + X 5^2 + X 6^2 + X 7^2

lemma tailQuadric_no_zero_var : (0 : Fin 8) ∉ tailQuadric.vars := by
  have hsum {p q : Poly} (hp : (0 : Fin 8) ∉ p.vars) (hq : (0 : Fin 8) ∉ q.vars) :
      (0 : Fin 8) ∉ (p+q).vars := by
    intro hm
    exact (Finset.mem_union.mp (vars_add_subset p q hm)).elim hp hq
  have hp (i : Fin 8) (hi : (0 : Fin 8) ≠ i) : (0 : Fin 8) ∉ (X i ^ 2 : Poly).vars := by
    intro hm
    have hx := vars_pow (X i : Poly) 2 hm
    simpa [hi] using hx
  exact hsum (hsum (hsum (hsum (hsum (hp 2 (by decide)) (hp 3 (by decide)))
    (hp 4 (by decide))) (hp 5 (by decide))) (hp 6 (by decide))) (hp 7 (by decide))

lemma X_one_not_dvd_tail : ¬ (X (1 : Fin 8) : Poly) ∣ tailQuadric := by
  rintro ⟨p, hp⟩
  have he := congrArg (eval (fun i : Fin 8 => if i = 2 then (1 : ℂ) else 0)) hp
  norm_num [tailQuadric] at he

lemma splitQuadric_irreducible :
    Irreducible (X (1 : Fin 8) * X 0 + tailQuadric) := by
  apply irreducible_mul_X_add
  · exact X_ne_zero 1
  · simp
  · exact tailQuadric_no_zero_var
  · exact (X_prime (R := ℂ) (i := (1 : Fin 8))).irreducible.isRelPrime_iff_not_dvd.mpr
      X_one_not_dvd_tail


lemma half_mul_two : C (1/2 : ℂ) * (2 : Poly) = 1 := by
  have hh := congrArg (C : ℂ →+* Poly) (show (1/2 : ℂ)*2=1 by norm_num)
  simpa only [map_mul, map_ofNat, map_one] using hh

noncomputable def forward : Poly →ₐ[ℂ] Poly :=
  aeval (fun i : Fin 8 => if i = 0 then X 0 + C Complex.I * X 1 else
    if i = 1 then X 0 - C Complex.I * X 1 else X i)

noncomputable def backward : Poly →ₐ[ℂ] Poly :=
  aeval (fun i : Fin 8 => if i = 0 then C (1/2 : ℂ) * (X 0 + X 1) else
    if i = 1 then -C Complex.I * C (1/2 : ℂ) * (X 0 - X 1) else X i)

lemma forward_backward : forward.comp backward = AlgHom.id ℂ Poly := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [forward, backward]
  all_goals ring_nf
  all_goals norm_num [← map_pow, Complex.I_sq]
  all_goals first
    | linear_combination (X 0 : Poly)*half_mul_two
    | linear_combination (X 1 : Poly)*half_mul_two

lemma backward_forward : backward.comp forward = AlgHom.id ℂ Poly := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [forward, backward]
  all_goals ring_nf
  all_goals norm_num [← map_pow, Complex.I_sq]
  all_goals first
    | linear_combination (X 0 : Poly)*half_mul_two
    | linear_combination (X 1 : Poly)*half_mul_two

noncomputable def splitEquiv : Poly ≃ₐ[ℂ] Poly :=
  AlgEquiv.ofAlgHom forward backward forward_backward backward_forward

noncomputable def quadric : Poly := ∑ i : Fin 8, X i^2

lemma forward_splitQuadric : forward (X (1 : Fin 8)*X 0+tailQuadric) = quadric := by
  simp [forward, tailQuadric, quadric, Fin.sum_univ_succ]
  ring_nf
  norm_num [← map_pow, Complex.I_sq]

theorem quadric_irreducible : Irreducible quadric := by
  have hh := splitQuadric_irreducible.map splitEquiv
  change Irreducible (forward _) at hh
  rwa [forward_splitQuadric] at hh

end Source29Quadric

/- Component: RadialIdentity.lean -/

namespace Source29Radial


open Finset

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

def dot (u v : ι → R) : R := ∑ i, u i * v i

def trace (H : ι → ι → R) : R := ∑ i, H i i

def contract (H : ι → ι → R) (u v : ι → R) : R :=
  ∑ i, ∑ j, u i * v j * H i j

def jetL (u : ι → R) (H : ι → ι → R) : R :=
  dot u u * trace H - contract H u u

lemma dot_add_left (u v w : ι → R) :
    dot (fun i => u i + v i) w = dot u w + dot v w := by
  simp [dot, add_mul, Finset.sum_add_distrib]

lemma dot_add_right (u v w : ι → R) :
    dot u (fun i => v i + w i) = dot u v + dot u w := by
  simp [dot, mul_add, Finset.sum_add_distrib]

lemma dot_mul_left (a : R) (u v : ι → R) :
    dot (fun i => a * u i) v = a * dot u v := by
  simp [dot, mul_assoc, Finset.mul_sum]

lemma dot_mul_right (a : R) (u v : ι → R) :
    dot u (fun i => a * v i) = a * dot u v := by
  simp [dot, ← mul_assoc, mul_comm _ a, Finset.mul_sum]

lemma dot_comm (u v : ι → R) : dot u v = dot v u := by
  simp [dot, mul_comm]

lemma contract_add_left (H : ι → ι → R) (u v w : ι → R) :
    contract H (fun i => u i + v i) w = contract H u w + contract H v w := by
  simp [contract, add_mul, Finset.sum_add_distrib]

lemma contract_add_right (H : ι → ι → R) (u v w : ι → R) :
    contract H u (fun i => v i + w i) = contract H u v + contract H u w := by
  simp [contract, mul_add, add_mul, Finset.sum_add_distrib]

lemma contract_mul_left (H : ι → ι → R) (a : R) (u v : ι → R) :
    contract H (fun i => a * u i) v = a * contract H u v := by
  simp [contract, mul_assoc, Finset.mul_sum]

lemma contract_mul_right (H : ι → ι → R) (a : R) (u v : ι → R) :
    contract H u (fun i => a * v i) = a * contract H u v := by
  simp [contract, ← mul_assoc, mul_comm _ a, Finset.mul_sum]

lemma contract_add_matrix (H K : ι → ι → R) (u v : ι → R) :
    contract (fun i j => H i j + K i j) u v = contract H u v + contract K u v := by
  simp [contract, mul_add, Finset.sum_add_distrib]

lemma contract_mul_matrix (a : R) (H : ι → ι → R) (u v : ι → R) :
    contract (fun i j => a * H i j) u v = a * contract H u v := by
  simp [contract, ← mul_assoc, mul_comm _ a, Finset.mul_sum]

lemma contract_outer (x y u v : ι → R) :
    contract (fun i j => x i * y j) u v = dot u x * dot v y := by
  unfold contract dot
  rw [Finset.sum_mul]
  simp only [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma contract_identity (u v : ι → R) :
    contract (fun i j => if i = j then (1 : R) else 0) u v = dot u v := by
  classical
  simp [contract, dot]

lemma trace_add (H K : ι → ι → R) :
    trace (fun i j => H i j + K i j) = trace H + trace K := by
  simp [trace, Finset.sum_add_distrib]

lemma trace_mul (a : R) (H : ι → ι → R) :
    trace (fun i j => a * H i j) = a * trace H := by
  simp [trace, Finset.mul_sum]

lemma trace_outer (x y : ι → R) : trace (fun i j => x i * y j) = dot x y := rfl

lemma trace_identity : trace (fun i j : ι => if i = j then (1 : R) else 0) =
    (Fintype.card ι : R) := by
  simp [trace]

lemma contract_right_action (H : ι → ι → R) (u v : ι → R) :
    contract H u v = dot u (fun i => ∑ j, H i j * v j) := by
  simp only [contract, dot, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma contract_symm (H : ι → ι → R) (hH : ∀ i j, H i j = H j i)
    (u v : ι → R) : contract H u v = contract H v u := by
  unfold contract
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [hH]
  ring

/-- The scaled gradient factor in q * grad(q^a g) = q^a * radialGradient. -/
def radialGradient (a q g : R) (z b : ι → R) : ι → R :=
  fun i => q * b i + (2 * a * g) * z i

/-- The scaled Hessian factor in q^2 * Hess(q^a g) = q^a * radialHessian. -/
def radialHessian (a q g : R) (z b : ι → R) (H : ι → ι → R) : ι → ι → R :=
  fun i j => q^2 * H i j + (2 * a * q) *
    (z i * b j + b i * z j + g * (if i = j then 1 else 0)) +
      (4 * a * (a - 1) * g) * (z i * z j)

lemma radialGradient_dot (a q g d : R) (z b : ι → R)
    (hq : dot z z = q) (hd : dot z b = d * g) :
    dot (radialGradient a q g z b) (radialGradient a q g z b) =
      q^2 * dot b b + 4 * a * (a + d) * q * g^2 := by
  have hd' : dot b z = d * g := (dot_comm b z).trans hd
  unfold radialGradient
  simp only [ dot_add_left, dot_add_right, dot_mul_left,
    dot_mul_right, hq, hd, hd']
  ring

lemma radialGradient_dot_z (a q g d : R) (z b : ι → R)
    (hq : dot z z = q) (hd : dot z b = d * g) :
    dot (radialGradient a q g z b) z = q * g * (d + 2 * a) := by
  have hd' : dot b z = d * g := (dot_comm b z).trans hd
  unfold radialGradient
  simp only [ dot_add_left, dot_mul_left, hq, hd']
  ring

lemma radialGradient_dot_b (a q g d : R) (z b : ι → R)
    (hd : dot z b = d * g) :
    dot (radialGradient a q g z b) b = q * dot b b + 2 * a * d * g^2 := by
  unfold radialGradient
  simp only [ dot_add_left, dot_mul_left, hd]
  ring

lemma radialHessian_trace (a q g d : R) (z b : ι → R) (H : ι → ι → R)
    (hq : dot z z = q) (hd : dot z b = d * g) :
    trace (radialHessian a q g z b H) =
      q^2 * trace H + 2 * a * q * (2 * d + Fintype.card ι + 2 * a - 2) * g := by
  have hd' : dot b z = d * g := (dot_comm b z).trans hd
  unfold radialHessian
  simp only [ trace_add, trace_mul, trace_outer, trace_identity, hq, hd, hd']
  ring

lemma radialGradient_contract (a q g d : R) (z b : ι → R) (H : ι → ι → R)
    (hH : ∀ i j, H i j = H j i) (hd : dot z b = d * g)
    (hEuler : ∀ i, (∑ j, H i j * z j) = (d - 1) * b i) :
    contract H (radialGradient a q g z b) (radialGradient a q g z b) =
      q^2 * contract H b b + 4 * a * (d - 1) * q * g * dot b b +
        4 * a^2 * d * (d - 1) * g^3 := by
  have hbz : contract H b z = (d - 1) * dot b b := by
    rw [contract_right_action]
    simp only [hEuler, dot_mul_right]
  have hzb : contract H z b = (d - 1) * dot b b := by
    rw [contract_symm H hH z b, hbz]
  have hzz : contract H z z = (d - 1) * d * g := by
    rw [contract_right_action]
    simp only [hEuler, dot_mul_right, hd]
    ring
  unfold radialGradient
  simp only [ contract_add_left, contract_add_right,
    contract_mul_left, contract_mul_right, hbz, hzb, hzz]
  ring

/-- Division-free finite-dimensional contraction form of equation (12) in the candidate.
The two Euler hypotheses are the first and differentiated Euler identities for g.
The formula is valid over every commutative ring, including at q=0. -/
theorem radial_jet_identity (a q g d : R) (z b : ι → R) (H : ι → ι → R)
    (hq : dot z z = q) (hd : dot z b = d * g)
    (hH : ∀ i j, H i j = H j i)
    (hEuler : ∀ i, (∑ j, H i j * z j) = (d - 1) * b i) :
    jetL (radialGradient a q g z b) (radialHessian a q g z b H) =
      q^2 * (q^2 * jetL b H +
        2 * a * (Fintype.card ι - 2 * d - 1 - 2 * a) * q * g * dot b b +
        4 * a * (a + d) * q * g^2 * trace H +
        4 * a * (a + d) * (2 * a * (Fintype.card ι - 1) + d) * g^3) := by
  unfold jetL
  rw [radialGradient_dot a q g d z b hq hd, radialHessian_trace a q g d z b H hq hd]
  unfold radialHessian
  simp only [ contract_add_matrix, contract_mul_matrix,
    contract_outer, contract_identity]
  rw [radialGradient_contract a q g d z b H hH hd hEuler,
    radialGradient_dot_z a q g d z b hq hd, radialGradient_dot_b a q g d z b hd,
    radialGradient_dot a q g d z b hq hd]
  ring

lemma jetL_scale (r s : R) (u : ι → R) (H : ι → ι → R) :
    jetL (fun i => r * u i) (fun i j => s * H i j) = r^2 * s * jetL u H := by
  unfold jetL
  simp only [dot_mul_left, dot_mul_right, trace_mul, contract_mul_matrix,
    contract_mul_left, contract_mul_right]
  ring

section Polynomial

open MvPolynomial Finsupp

noncomputable def radialPolynomial : MvPolynomial ι R := ∑ i : ι, (X i)^2

lemma pderiv_radialPolynomial (i : ι) :
    pderiv i (radialPolynomial : MvPolynomial ι R) = 2 * X i := by
  classical
  simp [radialPolynomial, pderiv_pow, pderiv_X, Pi.single_apply]

noncomputable def polynomialL (g : MvPolynomial ι R) : MvPolynomial ι R :=
  jetL (fun i => pderiv i g) (fun i j => pderiv i (pderiv j g))

lemma scaled_first_partial (a : ℕ) (g : MvPolynomial ι R) (i : ι) :
    radialPolynomial * pderiv i (radialPolynomial^a * g) =
      radialPolynomial^a *
        radialGradient (a : MvPolynomial ι R) radialPolynomial g X (fun j => pderiv j g) i := by
  cases a with
  | zero => simp [radialGradient]
  | succ a =>
    rw [pderiv_mul, pderiv_pow, pderiv_radialPolynomial]
    simp only [Nat.succ_sub_one, pow_succ, radialGradient, Nat.cast_succ]
    ring

lemma pderiv_natCast (n : ℕ) (i : ι) :
    pderiv i (n : MvPolynomial ι R) = 0 := by
  simpa only [map_natCast] using (pderiv_C (a := (n : R)) (i := i))

lemma scaled_second_partial (a : ℕ) (g : MvPolynomial ι R) (i j : ι) :
