  have hb : ‖b‖ = 1 := by
    simp only [b, norm_div, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (norm_nonneg a)]
    exact div_self (norm_ne_zero_iff.mpr ha)
  have hn : ‖c‖ ^ 2 = 1 := by rw [← norm_pow, hc, hb]
  refine ⟨c, ?_, ?_⟩
  · nlinarith [norm_nonneg c]
  · rw [hc]
    exact div_mul_cancel₀ _ ha

