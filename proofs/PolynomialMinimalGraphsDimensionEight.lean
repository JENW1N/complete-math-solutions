noncomputable section
variable {n : ℕ}

def radialTest (f : ℝ → ℝ) (p : (Fin n → ℝ) × ℝ) : ℝ := f ((∑ i, p.1 i ^ 2) + p.2 ^ 2)

def primitive (f : ℝ → ℝ) (p : (Fin n → ℝ) × ℝ) : ℝ := ∫ t in 0..p.2, radialTest f (p.1,t)

theorem radialTest_contDiff {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) : ContDiff ℝ 1 (radialTest (n := n) f) := by
  apply hf.comp
  exact (ContDiff.sum (fun i _ ↦ ((contDiff_apply ℝ ℝ i).comp contDiff_fst).pow 2)).add (contDiff_snd.pow 2)

theorem primitive_eq_unit_interval (f : ℝ → ℝ) (x : Fin n → ℝ) (z : ℝ) :
    primitive f (x,z) = z * ∫ t in (0 : ℝ)..1, radialTest f (x,z*t) := by
  simpa only [primitive, smul_eq_mul, mul_zero, mul_one] using
    (intervalIntegral.smul_integral_comp_mul_left (fun t ↦ radialTest f (x,t)) (a := 0) (b := 1) z).symm

theorem primitive_contDiff {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) :
    ContDiff ℝ 1 (primitive (n := n) f) := by
  have hc : ContDiff ℝ 1 (fun p : ((Fin n → ℝ) × ℝ) × ℝ ↦ radialTest f (p.1.1,p.1.2*p.2)) :=
    (radialTest_contDiff hf).comp ((contDiff_fst.comp contDiff_fst).prodMk ((contDiff_snd.comp contDiff_fst).mul contDiff_snd))
  have hi := contDiff_intervalIntegral hc 0 1
  have he : primitive (n := n) f = fun p ↦ p.2 * ∫ t in (0 : ℝ)..1, radialTest f (p.1,p.2*t) := by
    funext p
    exact primitive_eq_unit_interval f p.1 p.2
  rw [he]
  exact contDiff_snd.mul hi

theorem primitive_verticalDerivative {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (x : Fin n → ℝ) (z : ℝ) :
    verticalDerivative (primitive f) x z = radialTest f (x,z) := by
  have ht : Continuous (fun t ↦ radialTest f (x,t)) :=
    (radialTest_contDiff hf).continuous.comp (continuous_const.prodMk continuous_id)
  have hi := intervalIntegral.integral_hasDerivAt_right (ht.intervalIntegrable 0 z)
    ht.stronglyMeasurable.stronglyMeasurableAtFilter ht.continuousAt
  have hc : HasDerivAt (fun t : ℝ ↦ (x,t)) (0,1) z :=
    (hasDerivAt_const z x).prodMk (hasDerivAt_id z)
  have hd := ((primitive_contDiff hf).differentiable (by norm_num) (x,z)).hasFDerivAt.comp_hasDerivAt z hc
  exact hd.unique hi

theorem radialTest_parameter_basis {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (x : Fin n → ℝ) (t : ℝ) (i : Fin n) :
    parameterDerivative (radialTest f) (x,t) (Pi.single i 1) =
      2*x i*deriv f ((∑ j, x j ^ 2) + t^2) := by
  have hs : ContDiff ℝ 1 (graphRadiusSq (fun _ : Fin n → ℝ ↦ t)) := graphRadiusSq_contDiff contDiff_const
  have hd := ((hf.differentiable (by norm_num) (graphRadiusSq (fun _ : Fin n → ℝ ↦ t) x)).hasDerivAt).comp_hasFDerivAt x
    ((hs.differentiable (by norm_num) x).hasFDerivAt)
  have hp := parameterDerivative_hasFDerivAt (radialTest_contDiff hf) x t
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) (hp.unique hd)
  have hzero (y : Fin n → ℝ) (j : Fin n) : fderiv ℝ (fun _ : Fin n → ℝ ↦ t) y (Pi.single j 1) = (0 : Fin n → ℝ) j := by simp
  simpa only [smul_apply, smul_eq_mul, graphRadiusSq_fderiv contDiff_const hzero,
    Pi.zero_apply, mul_zero, add_zero, graphRadiusSq, mul_comm, mul_left_comm, mul_assoc] using he

theorem primitive_baseDerivative {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (x : Fin n → ℝ) (z : ℝ) (i : Fin n) :
    baseDerivative (primitive f) x z i = ∫ t in 0..z, 2*x i*deriv f ((∑ j, x j ^ 2) + t^2) := by
  have hi := hasFDerivAt_intervalIntegral (radialTest_contDiff hf).continuous
    (parameterDerivative_continuous (radialTest_contDiff hf))
    (parameterDerivative_hasFDerivAt (radialTest_contDiff hf)) 0 z x
  have hp : HasFDerivAt (primitive (n := n) f) (fderiv ℝ (primitive f) (x,z)) (x,z) :=
    ((primitive_contDiff hf).differentiable (by norm_num) (x,z)).hasFDerivAt
  have hcp : HasFDerivAt (fun y : Fin n → ℝ ↦ (y,z)) (ContinuousLinearMap.inl ℝ (Fin n → ℝ) ℝ) x := hasFDerivAt_prodMk_left x z
  have hc := hp.comp x hcp
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) (hc.unique hi)
  change baseDerivative (primitive f) x z i = (∫ t in 0..z, parameterDerivative (radialTest f) (x,t)) (Pi.single i 1) at he
  have hint : IntervalIntegrable (fun t ↦ parameterDerivative (radialTest f) (x,t)) volume 0 z :=
    ((parameterDerivative_continuous (radialTest_contDiff hf)).comp (continuous_const.prodMk continuous_id)).intervalIntegrable 0 z
  rw [ContinuousLinearMap.intervalIntegral_apply hint] at he
  simpa only [radialTest_parameter_basis hf] using he

end
