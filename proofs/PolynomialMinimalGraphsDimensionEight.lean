lemma eval_scale_of_isHomogeneous {ι : Type*} (h : MvPolynomial ι ℂ) (d : ℕ)
    (hh : h.IsHomogeneous d) (x : ι → ℂ) (c : ℂ) :
    eval (fun i => c * x i) h = c^d * eval x h := by
  rw [eval_eq, eval_eq, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r hr
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
    ← hh.degree_eq_sum_deg_support hr]
  ring

lemma continuous_polynomial_eval {n : ℕ} (h : MvPolynomial (Fin n) ℂ) :
    Continuous (fun z : CSpace n => eval (fun i => z i) h) := by
  apply MvPolynomial.induction_on h
  · intro c
    simpa using (continuous_const : Continuous (fun _ : CSpace n => c))
  · intro p q hp hq
    simpa only [map_add, Pi.add_def] using hp.add hq
  · intro p i hp
    have hi : Continuous (fun z : CSpace n => z i) :=
      PiLp.continuous_apply (p := 2) (β := fun _ : Fin n => ℂ) i
    simpa only [map_mul, eval_X, Pi.mul_def] using hp.mul hi

lemma continuous_quadricNorm {n : ℕ} : Continuous (@quadricNorm n) := by
  apply Continuous.norm
  apply continuous_finsetSum
  intro i hi
  exact (PiLp.continuous_apply (p := 2) (β := fun _ : Fin n => ℂ) i).pow 2

lemma sphericalZeroSet_isCompact {n : ℕ} (h : MvPolynomial (Fin n) ℂ) :
    IsCompact (sphericalZeroSet h) := by
  have hc : IsClosed (sphericalZeroSet h) :=
    (isClosed_eq continuous_norm continuous_const).inter
      (isClosed_eq (continuous_polynomial_eval h) continuous_const)
  apply (isCompact_sphere (0 : CSpace n) 1).of_isClosed_subset hc
  intro z hz
  simpa [Metric.mem_sphere] using hz.1

lemma sphericalZeroSet_nonempty {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d) (z : CSpace n) (hz : z ≠ 0)
    (hzero : eval (fun i => z i) h = 0) :
    (sphericalZeroSet h).Nonempty := by
  let c : ℂ := (‖z‖ : ℂ)⁻¹
  refine ⟨c • z, ?_, ?_⟩
  · rw [norm_smul]
    simp only [c, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (norm_nonneg z)]
    exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz)
  · change eval (fun i => c * z i) h = 0
    rw [eval_scale_of_isHomogeneous h d hh, hzero, mul_zero]

lemma quadricNorm_nonneg {n : ℕ} (z : CSpace n) : 0 ≤ quadricNorm z := norm_nonneg _

lemma quadricNorm_le_norm_sq {n : ℕ} (z : CSpace n) : quadricNorm z ≤ ‖z‖^2 := by
  unfold quadricNorm
  calc
    ‖∑ i : Fin n, (z i)^2‖ ≤ ∑ i : Fin n, ‖(z i)^2‖ := norm_sum_le _ _
    _ = ‖z‖^2 := by simp only [norm_pow, EuclideanSpace.norm_sq_eq]

lemma quadricNorm_le_one {n : ℕ} (z : CSpace n) (hz : ‖z‖ = 1) :
    quadricNorm z ≤ 1 := by
  simpa [hz] using quadricNorm_le_norm_sq z

/-- A homogeneous complex hypersurface with a nonzero zero has a compact,
nonempty unit-sphere slice, on which the quadric norm attains a maximum in [0,1]. -/
theorem exists_spherical_maximum {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d) (z : CSpace n) (hz : z ≠ 0)
    (hzero : eval (fun i => z i) h = 0) :
    ∃ (κ : ℝ) (zmax : CSpace n),
      0 ≤ κ ∧ κ ≤ 1 ∧ ‖zmax‖ = 1 ∧ eval (fun i => zmax i) h = 0 ∧
        quadricNorm zmax = κ ∧
        ∀ w ∈ sphericalZeroSet h, quadricNorm w ≤ κ := by
  obtain ⟨zmax, hzmax, hmax⟩ := (sphericalZeroSet_isCompact h).exists_isMaxOn
    (sphericalZeroSet_nonempty h hh z hz hzero) continuous_quadricNorm.continuousOn
  exact ⟨quadricNorm zmax, zmax, quadricNorm_nonneg zmax,
    quadricNorm_le_one zmax hzmax.1, hzmax.1, hzmax.2, rfl, hmax⟩

/-- Equality in the quadric norm bound forces a complex scalar multiple
of the vector to have real coordinates. This uses equality in Cauchy-Schwarz. -/
lemma real_multiple_of_quadricNorm_eq_one {n : ℕ} (z : CSpace n)
    (hzunit : ‖z‖ = 1) (hquad : quadricNorm z = 1) :
    ∃ (c : ℂ) (x : Fin n → ℝ), c ≠ 0 ∧ x ≠ 0 ∧ ∀ i, (x i : ℂ) = c * z i := by
  let zb : CSpace n := WithLp.toLp 2 (fun i => star (z i))
  have hnorm : ‖zb‖ = ‖z‖ := by
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    simp [EuclideanSpace.norm_sq_eq, zb]
  have hz : z ≠ 0 := by
    intro h
    simpa [h] using hzunit
  have hzb : zb ≠ 0 := by
    intro h
    have he := hnorm.trans hzunit
    simpa [h] using he
  have hinner : inner ℂ zb z = ∑ i : Fin n, (z i)^2 := by
    simp [PiLp.inner_apply, zb, pow_two]
  have hcs : ‖inner ℂ zb z‖ = ‖zb‖ * ‖z‖ := by
    rw [hinner, hnorm, hzunit]
    simpa [quadricNorm] using hquad
  obtain ⟨r, hr, hscale⟩ := (norm_inner_eq_norm_iff (𝕜 := ℂ) hzb hz).mp hcs
  have hcoords (j : Fin n) : z j = r * star (z j) := by
    have he := congrArg (fun v : CSpace n => v j) hscale
    simpa [zb] using he
  obtain ⟨i, hi⟩ : ∃ i : Fin n, z i ≠ 0 := by
    by_contra h
    push Not at h
    apply hz
    ext i
    exact h i
  let c : ℂ := star (z i)
  have hc : c ≠ 0 := by simpa [c] using hi
  have him (j : Fin n) : (c * z j).im = 0 := by
    have hconj : star (c * z j) = c * z j := by
      change star (star (z i) * z j) = star (z i) * z j
      rw [star_mul, star_star]
      calc
        star (z j) * z i = star (z j) * (r * star (z i)) :=
          congrArg (fun t : ℂ => star (z j) * t) (hcoords i)
        _ = star (z i) * (r * star (z j)) := by ring
        _ = star (z i) * z j :=
          congrArg (fun t : ℂ => star (z i) * t) (hcoords j).symm
    have he := congrArg Complex.im hconj
    simp only [Complex.star_def, Complex.conj_im] at he
    linarith
  let x : Fin n → ℝ := fun j => (c * z j).re
  have hreal (j : Fin n) : (x j : ℂ) = c * z j := by
    apply Complex.ext
    · rfl
    · simpa only [Complex.ofReal_im] using (him j).symm
  have hx : x ≠ 0 := by
    intro he
    have hxi := hreal i
    rw [he] at hxi
    simp only [Pi.zero_apply, Complex.ofReal_zero] at hxi
    exact (mul_ne_zero hc hi) hxi.symm
  exact ⟨c, x, hc, hx, hreal⟩

lemma quadricNorm_lt_one_of_no_real_zero {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d)
    (hreal : ∀ x : Fin n → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0)
    (z : CSpace n) (hzunit : ‖z‖ = 1) (hzero : eval (fun i => z i) h = 0) :
    quadricNorm z < 1 := by
  have hle := quadricNorm_le_one z hzunit
  by_contra hlt
  have heq : quadricNorm z = 1 := le_antisymm hle (le_of_not_gt hlt)
  obtain ⟨c, x, hc, hx, hcoords⟩ := real_multiple_of_quadricNorm_eq_one z hzunit heq
  apply hreal x hx
  calc
    eval (fun i => (x i : ℂ)) h = eval (fun i => c * z i) h := by
      rw [show (fun i => (x i : ℂ)) = (fun i => c * z i) from funext hcoords]
    _ = c^d * eval (fun i => z i) h := eval_scale_of_isHomogeneous h d hh _ c
    _ = 0 := by rw [hzero, mul_zero]

/-- The compact maximum is strictly below one when there is no nonzero real zero. -/
theorem exists_strict_spherical_maximum {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d)
    (hreal : ∀ x : Fin n → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0)
    (z : CSpace n) (hz : z ≠ 0) (hzero : eval (fun i => z i) h = 0) :
    ∃ (κ : ℝ) (zmax : CSpace n),
      0 ≤ κ ∧ κ < 1 ∧ ‖zmax‖ = 1 ∧ eval (fun i => zmax i) h = 0 ∧
        quadricNorm zmax = κ ∧
        ∀ w ∈ sphericalZeroSet h, quadricNorm w ≤ κ := by
  obtain ⟨κ, zmax, hk, hkle, hzunit, hzzero, hval, hmax⟩ :=
    exists_spherical_maximum h hh z hz hzero
  refine ⟨κ, zmax, hk, ?_, hzunit, hzzero, hval, hmax⟩
  rw [← hval]
  exact quadricNorm_lt_one_of_no_real_zero h hh hreal zmax hzunit hzzero

end Source29ProjectiveMaximum

/- Component: ProjectiveScaling.inc -/

namespace Source29ProjectiveMaximum

open Finset MvPolynomial

lemma quadricNorm_smul {n : ℕ} (c : ℂ) (z : CSpace n) :
    quadricNorm (c • z) = ‖c‖^2 * quadricNorm z := by
  unfold quadricNorm
  change ‖∑ i : Fin n, (c * z i)^2‖ = ‖c‖^2 * ‖∑ i : Fin n, (z i)^2‖
  simp_rw [mul_pow]
  rw [← Finset.mul_sum, norm_mul, norm_pow]

lemma normalized_mem_sphericalZeroSet {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d) (z : CSpace n) (hz : z ≠ 0)
    (hzero : eval (fun i => z i) h = 0) :
    ((‖z‖ : ℂ)⁻¹ • z) ∈ sphericalZeroSet h := by
  refine ⟨?_, ?_⟩
  · rw [norm_smul]
    simp only [norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (norm_nonneg z)]
    exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz)
  · change eval (fun i => (‖z‖ : ℂ)⁻¹ * z i) h = 0
    rw [eval_scale_of_isHomogeneous h d hh, hzero, mul_zero]

/-- A maximum on the unit-sphere slice gives the homogeneous inequality on the
entire complex zero set, including its origin. -/
theorem global_quadric_bound {n d : ℕ} (h : MvPolynomial (Fin n) ℂ)
    (hh : h.IsHomogeneous d) (κ : ℝ)
    (hmax : ∀ z ∈ sphericalZeroSet h, quadricNorm z ≤ κ)
    (w : CSpace n) (hwzero : eval (fun i => w i) h = 0) :
    quadricNorm w ≤ κ * ‖w‖^2 := by
  by_cases hw : w = 0
  · simp [hw, quadricNorm]
  have hm := hmax ((‖w‖ : ℂ)⁻¹ • w)
    (normalized_mem_sphericalZeroSet h hh w hw hwzero)
  rw [quadricNorm_smul] at hm
  simp only [norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg w), inv_pow] at hm
  have hn : 0 < ‖w‖^2 := sq_pos_of_pos (norm_pos_iff.mpr hw)
  calc
    quadricNorm w = ‖w‖^2 * ((‖w‖^2)⁻¹ * quadricNorm w) := by
      rw [← mul_assoc, mul_inv_cancel₀ hn.ne', one_mul]
    _ ≤ ‖w‖^2 * κ := mul_le_mul_of_nonneg_left hm hn.le
    _ = κ * ‖w‖^2 := mul_comm _ _

end Source29ProjectiveMaximum

/- Component: RootPersistence.lean -/

namespace Source29RootPersistence

open Polynomial Filter
open scoped Topology

noncomputable section

lemma product_bound (s : Multiset ℂ) (z : ℂ) (C : ℝ) (hC : 0 ≤ C)
    (hbound : ∀ r ∈ s, ‖z - r‖ ≤ C * ‖r‖) :
    ‖(s.map (fun r => z - r)).prod‖ ≤
      C ^ s.card * ‖(s.map (fun r => (0 : ℂ) - r)).prod‖ := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons r s ih =>
    have hr := hbound r (Multiset.mem_cons_self r s)
    have hs := ih (fun x hx => hbound x (Multiset.mem_cons_of_mem hx))
    simp only [Multiset.map_cons, Multiset.prod_cons, norm_mul,
      Multiset.card_cons, zero_sub, norm_neg] at *
    calc
      ‖z - r‖ * ‖(s.map (fun r => z - r)).prod‖ ≤
          (C * ‖r‖) * (C ^ s.card * ‖(s.map (fun r => -r)).prod‖) :=
        mul_le_mul hr hs (norm_nonneg _) (mul_nonneg hC (norm_nonneg _))
      _ = C ^ (s.card + 1) * (‖r‖ * ‖(s.map (fun r => -r)).prod‖) := by
        rw [pow_succ]
        ring

/-- A bounded-degree polynomial without a root near zero cannot be small at
zero while remaining large at another fixed point. This works even when a
limiting polynomial loses degree. -/
theorem eval_bound_of_no_small_roots (p : Polynomial ℂ) (hsplit : p.Splits)
    (D : ℕ) (hD : p.natDegree ≤ D) (ε : ℝ) (hε : 0 < ε)
    (hroots : ∀ r : ℂ, p.eval r = 0 → ε ≤ ‖r‖) (z : ℂ) :
    ‖p.eval z‖ ≤ (1 + ‖z‖ / ε) ^ D * ‖p.eval 0‖ := by
  let C : ℝ := 1 + ‖z‖ / ε
  have hC : 1 ≤ C := by
    dsimp [C]
    have := div_nonneg (norm_nonneg z) hε.le
    linarith
  have hbound : ∀ r ∈ p.roots, ‖z - r‖ ≤ C * ‖r‖ := by
    intro r hr
    have hrε := hroots r (isRoot_of_mem_roots hr)
    have hrz : ‖z‖ ≤ (‖z‖ / ε) * ‖r‖ := by
      have hh := mul_le_mul_of_nonneg_left hrε (div_nonneg (norm_nonneg z) hε.le)
      rwa [div_mul_cancel₀ _ hε.ne'] at hh
    calc
      ‖z - r‖ ≤ ‖z‖ + ‖r‖ := norm_sub_le _ _
      _ ≤ C * ‖r‖ := by dsimp [C]; nlinarith
  have hprod := product_bound p.roots z C (by positivity) hbound
  have hpow : C ^ p.roots.card ≤ C ^ D := by
    exact pow_le_pow_right₀ hC (le_trans (card_roots' p) hD)
  rw [hsplit.eval_eq_prod_roots z, hsplit.eval_eq_prod_roots 0, norm_mul, norm_mul]
  calc
    ‖p.leadingCoeff‖ * ‖(p.roots.map (fun r => z - r)).prod‖ ≤
        ‖p.leadingCoeff‖ * (C ^ p.roots.card *
          ‖(p.roots.map (fun r => (0 : ℂ) - r)).prod‖) :=
      mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
    _ ≤ ‖p.leadingCoeff‖ * (C ^ D *
          ‖(p.roots.map (fun r => (0 : ℂ) - r)).prod‖) := by
      gcongr
    _ = (1 + ‖z‖ / ε) ^ D *
        (‖p.leadingCoeff‖ * ‖(p.roots.map (fun r => (0 : ℂ) - r)).prod‖) := by
      dsimp [C]
      ring

/-- Roots persist under pointwise limits of bounded-degree split polynomials.
No assumption that the degrees or leading coefficients stay constant is needed. -/
theorem eventually_exists_root_near_zero {α : Type*} {l : Filter α}
    (p : α → Polynomial ℂ) (P : Polynomial ℂ) (D : ℕ)
    (hsplit : ∀ t, (p t).Splits)
    (hD : ∀ᶠ t in l, (p t).natDegree ≤ D)
    (hlim : ∀ z : ℂ, Tendsto (fun t => (p t).eval z) l (𝓝 (P.eval z)))
    (hP : P ≠ 0) (hzero : P.eval 0 = 0) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ t in l, ∃ z : ℂ, (p t).eval z = 0 ∧ ‖z‖ < ε := by
  obtain ⟨z, hz⟩ : ∃ z : ℂ, P.eval z ≠ 0 := by
    by_contra hn
    push Not at hn
    apply hP
    apply Polynomial.funext
    simpa using hn
  let C : ℝ := (1 + ‖z‖ / ε) ^ D
  have hsmall : Tendsto (fun t => C * ‖(p t).eval 0‖) l (𝓝 0) := by
    simpa [hzero] using tendsto_const_nhds.mul (hlim 0).norm
  have hlarge := (hlim z).norm
  have hlt : ∀ᶠ t in l, C * ‖(p t).eval 0‖ < ‖(p t).eval z‖ :=
    hsmall.eventually_lt hlarge (norm_pos_iff.mpr hz)
  filter_upwards [hD, hlt] with t htD htlt
  by_contra hnone
  push Not at hnone
  have hbound := eval_bound_of_no_small_roots (p t) (hsplit t) D htD ε hε hnone z
  exact (not_lt_of_ge hbound) htlt

end
end Source29RootPersistence

/- Component: SlicePolynomial.lean -/

/-!
# Restricting a multivariate polynomial to an affine complex line
-/

namespace Source29SlicePolynomial

open MvPolynomial
open scoped BigOperators

noncomputable section

/-- The univariate polynomial obtained by substituting v + tau*u. -/
def lineSlice {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (v u : Fin n → ℂ) : Polynomial ℂ :=
  eval₂ Polynomial.C (fun i => Polynomial.C (v i)+Polynomial.X*Polynomial.C (u i)) P

theorem eval_lineSlice {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (v u : Fin n → ℂ) (tau : ℂ) :
    Polynomial.eval tau (lineSlice P v u) = eval (fun i => v i+tau*u i) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [lineSlice]
  | add p q hp hq => simpa [lineSlice] using congrArg₂ (fun a b : ℂ => a+b) hp hq
  | mul_X p i hp =>
    simp only [lineSlice, eval₂_mul, eval₂_X, Polynomial.eval_mul,
      Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_X, eval_mul, eval_X]
    exact congrArg (fun a : ℂ => a*(v i+tau*u i)) hp

lemma affine_natDegree_le (v u : ℂ) :
    (Polynomial.C v+Polynomial.X*Polynomial.C u).natDegree ≤ 1 := by
  apply Polynomial.natDegree_add_le_of_degree_le
  · simp
  · exact (Polynomial.natDegree_mul_C_le _ _).trans (by simp)

lemma affine_pow_natDegree_le (v u : ℂ) (k : ℕ) :
    ((Polynomial.C v+Polynomial.X*Polynomial.C u)^k).natDegree ≤ k := by
  simpa using Polynomial.natDegree_pow_le_of_le k (affine_natDegree_le v u)

theorem natDegree_lineSlice_le {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (v u : Fin n → ℂ) : (lineSlice P v u).natDegree ≤ P.totalDegree := by
  classical
  rw [lineSlice, eval₂_eq]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro e he
  apply (Polynomial.natDegree_C_mul_le _ _).trans
  apply (Polynomial.natDegree_prod_le _ _).trans
  apply le_trans (Finset.sum_le_sum (fun i hi => affine_pow_natDegree_le (v i) (u i) (e i)))
  exact le_totalDegree he

/-- The coefficient at the sum of separate degree bounds is the product of
coefficients at those bounds, even when some factors have smaller degree. -/
lemma coeff_prod_sum_of_natDegree_le {R ι : Type*} [CommSemiring R]
    (s : Finset ι) (f : ι → Polynomial R) (d : ι → ℕ)
    (hd : ∀ i ∈ s, (f i).natDegree ≤ d i) :
    (∏ i ∈ s, f i).coeff (∑ i ∈ s, d i) = ∏ i ∈ s, (f i).coeff (d i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s his ih =>
    rw [Finset.prod_insert his, Finset.sum_insert his, Finset.prod_insert his]
    rw [Polynomial.coeff_mul_add_eq_of_natDegree_le (hd i (by simp))]
    · rw [ih (fun j hj => hd j (by simp [hj]))]
    · exact (Polynomial.natDegree_prod_le _ _).trans
        (Finset.sum_le_sum (fun j hj => hd j (by simp [hj])))

lemma affine_pow_top_coeff (v u : ℂ) (k : ℕ) :
    ((Polynomial.C v+Polynomial.X*Polynomial.C u)^k).coeff k = u^k := by
  have h := Polynomial.coeff_pow_of_natDegree_le (m := k) (affine_natDegree_le v u)
  simpa using h

/-- A homogeneous polynomial has a line-slice top coefficient independent of
the base point; it is evaluation of that polynomial on the direction vector. -/
theorem coeff_lineSlice_of_isHomogeneous {n s : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (hP : P.IsHomogeneous s) (v u : Fin n → ℂ) :
    (lineSlice P v u).coeff s = eval u P := by
  classical
  rw [lineSlice, eval₂_eq, Polynomial.finsetSum_coeff, eval_eq]
  apply Finset.sum_congr rfl
  intro e he
  rw [Polynomial.coeff_C_mul, hP.degree_eq_sum_deg_support he]
  congr 1
  rw [coeff_prod_sum_of_natDegree_le _ _ (fun i => e i)
    (fun i hi => affine_pow_natDegree_le (v i) (u i) (e i))]
  apply Finset.prod_congr rfl
  intro i hi
  exact affine_pow_top_coeff (v i) (u i) (e i)

/-- A direction where the homogeneous polynomial is nonzero ensures a
nonzero line restriction through every base point. -/
theorem lineSlice_ne_zero_of_isHomogeneous {n s : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (hP : P.IsHomogeneous s)
    (v u : Fin n → ℂ) (hu : eval u P ≠ 0) : lineSlice P v u ≠ 0 := by
  intro hz
  apply hu
  rw [← coeff_lineSlice_of_isHomogeneous P hP v u, hz, Polynomial.coeff_zero]

end
end Source29SlicePolynomial

/- Component: LowestRescale.inc -/
/- A polynomial rescaling at its first homogeneous component. The rescaled
family is defined without division, so it is continuous even at parameter zero. -/

namespace Source29LowestRescale

open MvPolynomial Finset
open scoped Topology

noncomputable section

def rescale {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ) (t : ℂ) :
    MvPolynomial (Fin n) ℂ :=
  ∑ k ∈ range (P.totalDegree + 1), C (t ^ (k - s)) * homogeneousComponent k P

theorem totalDegree_rescale_le {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (s : ℕ) (t : ℂ) : (rescale P s t).totalDegree ≤ P.totalDegree := by
  apply totalDegree_finsetSum_le
  intro k hk
  have hcomp := (homogeneousComponent_isHomogeneous k P).totalDegree_le
  calc
    (C (t ^ (k - s)) * homogeneousComponent k P).totalDegree ≤
        (C (t ^ (k - s)) : MvPolynomial (Fin n) ℂ).totalDegree +
          (homogeneousComponent k P).totalDegree := totalDegree_mul _ _
    _ ≤ P.totalDegree := by
      rw [totalDegree_C, zero_add]
      exact le_trans hcomp (Nat.le_of_lt_succ (mem_range.mp hk))

theorem rescale_zero {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree)
    (hlow : ∀ k < s, homogeneousComponent k P = 0) :
    rescale P s 0 = homogeneousComponent s P := by
  unfold rescale
  rw [Finset.sum_eq_single s]
  · simp
  · intro k hk hks
    by_cases hlt : k < s
    · simp [hlow k hlt]
    · have hpos : 0 < k - s := by omega
      simp [zero_pow hpos.ne']
  · intro hnot
    exact False.elim (hnot (mem_range.mpr (Nat.lt_succ_of_le hs)))

/-- Evaluating the rescaled family recovers the original polynomial under a
scalar dilation, with the lowest power removed. The equality holds at zero too. -/
theorem eval_rescale_mul {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hlow : ∀ k < s, homogeneousComponent k P = 0) (t : ℂ) (y : Fin n → ℂ) :
    t ^ s * eval y (rescale P s t) = eval (fun i => t * y i) P := by
  calc
    t ^ s * eval y (rescale P s t) =
        ∑ k ∈ range (P.totalDegree + 1),
          t ^ s * (t ^ (k - s) * eval y (homogeneousComponent k P)) := by
      simp only [rescale, map_sum, map_mul, eval_C, Finset.mul_sum]
    _ = ∑ k ∈ range (P.totalDegree + 1),
          t ^ k * eval y (homogeneousComponent k P) := by
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlt : k < s
      · simp [hlow k hlt]
      · rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le (Nat.le_of_not_gt hlt)]
    _ = eval (fun i => t * y i) P := by
      conv_rhs => rw [← sum_homogeneousComponent P]
      simp only [map_sum]
      apply Finset.sum_congr rfl
      intro k hk
      exact (Source29ProjectiveMaximum.eval_scale_of_isHomogeneous _ k
        (homogeneousComponent_isHomogeneous k P) y t).symm

theorem continuous_eval_rescale {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (s : ℕ) (y : Fin n → ℂ) :
    Continuous (fun t : ℂ => eval y (rescale P s t)) := by
  simp only [rescale, map_sum, map_mul, eval_C]
  apply continuous_finsetSum
  intro k hk
  exact (continuous_id.pow (k - s)).mul continuous_const

end
end Source29LowestRescale

/- Component: SmallZeroApprox.inc -/
/- Realization of zeros of the initial homogeneous form by nearby zeros.
The only root-persistence argument used here is the bounded-degree algebraic
estimate proved in Source29RootPersistence. -/

namespace Source29SmallZeroApprox

open MvPolynomial Filter
open Source29SlicePolynomial Source29LowestRescale
open scoped Topology

noncomputable section

theorem exists_small_scaled_zero {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (s : ℕ) (hs : s ≤ P.totalDegree)
    (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (v u : Fin n → ℂ)
    (hv : eval v (homogeneousComponent s P) = 0)
    (hu : eval u (homogeneousComponent s P) ≠ 0)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ t : ℝ, ∃ τ : ℂ, 0 < t ∧ t < ε ∧ ‖τ‖ < ε ∧
      eval (fun i => (t : ℂ) * (v i + τ * u i)) P = 0 := by
  letI : IsAlgClosed ℂ := Source29FTA.complex_isAlgClosed
  let family : ℝ → Polynomial ℂ := fun t => lineSlice (rescale P s (t : ℂ)) v u
  let initial : Polynomial ℂ := lineSlice (homogeneousComponent s P) v u
  have hsplit : ∀ t, (family t).Splits := fun t => IsAlgClosed.splits _
  have hdegree : ∀ᶠ t in 𝓝[>] (0 : ℝ), (family t).natDegree ≤ P.totalDegree := by
    apply Filter.Eventually.of_forall
    intro t
    exact (natDegree_lineSlice_le _ v u).trans (totalDegree_rescale_le P s _)
  have hlimit (τ : ℂ) :
      Tendsto (fun t => (family t).eval τ) (𝓝[>] (0 : ℝ)) (𝓝 (initial.eval τ)) := by
    have hc := (continuous_eval_rescale P s (fun i => v i + τ * u i)).comp
      Complex.continuous_ofReal
    have ht : Tendsto
        (fun t : ℝ => eval (fun i => v i + τ * u i) (rescale P s (t : ℂ)))
        (𝓝[>] (0 : ℝ))
        (𝓝 (eval (fun i => v i + τ * u i) (rescale P s (0 : ℂ)))) :=
      (hc.continuousAt (x := (0 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
    simpa [family, initial, eval_lineSlice, rescale_zero P s hs hlow] using ht
  have hinitial : initial ≠ 0 :=
    lineSlice_ne_zero_of_isHomogeneous _ (homogeneousComponent_isHomogeneous s P) v u hu
  have hinitial0 : initial.eval 0 = 0 := by
    simpa [initial, eval_lineSlice] using hv
  have hroots := Source29RootPersistence.eventually_exists_root_near_zero
    family initial P.totalDegree hsplit hdegree hlimit hinitial hinitial0 ε hε
  have hsmall : ∀ᶠ t in 𝓝[>] (0 : ℝ), t < ε :=
    (eventually_lt_nhds hε).filter_mono nhdsWithin_le_nhds
  have hpositive : ∀ᶠ t in 𝓝[>] (0 : ℝ), 0 < t := self_mem_nhdsWithin
  obtain ⟨t, htpos, htε, τ, hτ, hτnorm⟩ :=
    (hpositive.and (hsmall.and hroots)).exists
  refine ⟨t, τ, htpos, htε, hτnorm, ?_⟩
  rw [← eval_rescale_mul P s hlow]
  have heq : eval (fun i => v i + τ * u i) (rescale P s (t : ℂ)) = 0 := by
    simpa [family, eval_lineSlice] using hτ
  rw [heq, mul_zero]

end
end Source29SmallZeroApprox

/- Component: TangentRealization.lean -/

open Filter
open scoped Topology

namespace Source29TangentRealization

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedSpace ℝ E] [IsScalarTower ℝ ℂ E]

/-- A family of nearby zeros with positive real radial scale supplies a positive
real tangent direction. The complex correction may tend to zero at any rate. -/
theorem mem_posTangentConeAt_of_sequences {S : Set E} {z v u : E}
    (t : ℕ → ℝ) (τ : ℕ → ℂ) (htpos : ∀ n, 0 < t n)
    (ht : Tendsto t atTop (𝓝 0)) (hτ : Tendsto τ atTop (𝓝 0))
    (hS : ∀ n, z + t n • (v + τ n • u) ∈ S) :
    v ∈ posTangentConeAt S z := by
  let c : ℕ → NNReal := fun n => ⟨(t n)⁻¹, (inv_pos.mpr (htpos n)).le⟩
  let d : ℕ → E := fun n => t n • (v + τ n • u)
  have hv : Tendsto (fun n => v + τ n • u) atTop (𝓝 v) := by
    simpa using tendsto_const_nhds.add (hτ.smul_const u)
  refine mem_tangentConeAt_of_seq atTop c d ?_ (Filter.Eventually.of_forall hS) ?_
  · simpa [d] using ht.smul hv
  · have heq : (fun n => c n • d n) = fun n => v + τ n • u := by
      funext n
      change (t n)⁻¹ • (t n • (v + τ n • u)) = v + τ n • u
      rw [smul_smul, inv_mul_cancel₀ (ne_of_gt (htpos n)), one_smul]
    rw [heq]
    exact hv

/-- Quantitative approximation, convenient for use after persistence of roots of
one-variable polynomial slices, implies membership in the tangent cone. -/
theorem mem_posTangentConeAt_of_approximations {S : Set E} {z v u : E}
    (happrox : ∀ ε : ℝ, 0 < ε → ∃ t : ℝ, ∃ τ : ℂ,
      0 < t ∧ t < ε ∧ ‖τ‖ < ε ∧ z + t • (v + τ • u) ∈ S) :
    v ∈ posTangentConeAt S z := by
  let ε : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  have hεpos : ∀ n, 0 < ε n := by intro n; dsimp [ε]; positivity
  choose t τ htpos htbound hτbound hS using fun n => happrox (ε n) (hεpos n)
  have hε : Tendsto ε atTop (𝓝 0) := by
    simpa [ε] using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  have ht : Tendsto t atTop (𝓝 0) :=
    squeeze_zero (fun n => (htpos n).le) (fun n => (htbound n).le) hε
  have hτ : Tendsto τ atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    exact squeeze_zero (fun n => norm_nonneg _) (fun n => (hτbound n).le) hε
  exact mem_posTangentConeAt_of_sequences t τ htpos ht hτ hS

/-- An eventual small correction for each error tolerance is enough; no
continuous or holomorphic choice of the correcting root is required. -/
theorem mem_posTangentConeAt_of_eventual_corrections {S : Set E} {z v u : E}
    (hcorrection : ∀ ε : ℝ, 0 < ε → ∀ᶠ t : ℝ in 𝓝[>] 0,
      ∃ τ : ℂ, ‖τ‖ < ε ∧ z + t • (v + τ • u) ∈ S) :
    v ∈ posTangentConeAt S z := by
  apply mem_posTangentConeAt_of_approximations
  intro ε hε
  have hsmall : ∀ᶠ t : ℝ in 𝓝[>] 0, t ∈ Set.Ioo 0 ε := Ioo_mem_nhdsGT hε
  obtain ⟨t, ht, hroot⟩ := (hsmall.and (hcorrection ε hε)).exists
  obtain ⟨τ, hτ, hS⟩ := hroot
  exact ⟨t, τ, ht.1, ht.2, hτ, hS⟩

end
end Source29TangentRealization

/- Component: PolynomialTranslation.lean -/

namespace Source29PolynomialTranslation

open Finset MvPolynomial

noncomputable section

variable {R ι : Type*} [CommRing R]

/-- Translate the variables by the vector z. -/
def translate (P : MvPolynomial ι R) (z : ι → R) : MvPolynomial ι R :=
  eval₂ C (fun i => X i + C (z i)) P

lemma translate_C (r : R) (z : ι → R) : translate (C r) z = C r := by
  simp [translate]

lemma translate_X (i : ι) (z : ι → R) : translate (X i) z = X i + C (z i) := by
  simp [translate]

lemma translate_add (P Q : MvPolynomial ι R) (z : ι → R) :
    translate (P + Q) z = translate P z + translate Q z := by
  simp [translate]

lemma translate_mul (P Q : MvPolynomial ι R) (z : ι → R) :
    translate (P * Q) z = translate P z * translate Q z := by
  simp [translate]

lemma translate_zero_polynomial (z : ι → R) : translate (0 : MvPolynomial ι R) z = 0 := by
  simp [translate]

lemma eval_translate (P : MvPolynomial ι R) (z y : ι → R) :
    eval y (translate P z) = eval (fun i => z i + y i) P := by
  apply MvPolynomial.induction_on P
  · intro r
    simp [translate_C]
  · intro p q hp hq
    simp only [translate_add, map_add, hp, hq]
  · intro p i hp
    simp only [translate_mul, translate_X, map_mul, map_add, eval_X, eval_C, hp]
    ring

lemma translate_translate (P : MvPolynomial ι R) (z w : ι → R) :
    translate (translate P z) w = translate P (fun i => z i + w i) := by
  apply MvPolynomial.induction_on P
  · intro r
    simp only [translate_C]
  · intro p q hp hq
    simp only [translate_add, hp, hq]
  · intro p i hp
    simp only [translate_mul, translate_add, translate_X, translate_C, hp, map_add]
    ring

lemma translate_zero_vector (P : MvPolynomial ι R) : translate P (0 : ι → R) = P := by
  apply MvPolynomial.induction_on P
  · intro r
    exact translate_C r 0
  · intro p q hp hq
    rw [translate_add, hp, hq]
  · intro p i hp
    rw [translate_mul, hp, translate_X]
    simp

lemma translate_inverse (P : MvPolynomial ι R) (z : ι → R) :
    translate (translate P z) (fun i => -z i) = P := by
  rw [translate_translate]
  have hz : (fun i => z i + -z i) = (0 : ι → R) := by
    funext i
    simp
  rw [hz, translate_zero_vector]

lemma translate_injective (z : ι → R) : Function.Injective (fun P : MvPolynomial ι R => translate P z) := by
  intro P Q h
  have hh := congrArg (fun F : MvPolynomial ι R => translate F (fun i => -z i)) h
  simpa only [translate_inverse] using hh

lemma translate_eq_zero_iff (P : MvPolynomial ι R) (z : ι → R) :
    translate P z = 0 ↔ P = 0 := by
  constructor
  · intro h
    apply translate_injective z
    simpa only [translate_zero_polynomial] using h
  · intro h
    rw [h, translate_zero_polynomial]

lemma translate_ne_zero (P : MvPolynomial ι R) (z : ι → R) (hP : P ≠ 0) :
    translate P z ≠ 0 := by
  intro h
  exact hP ((translate_eq_zero_iff P z).mp h)

lemma eval_zero_translate (P : MvPolynomial ι R) (z : ι → R) :
    eval (0 : ι → R) (translate P z) = eval z P := by
  rw [eval_translate]
  simp

lemma homogeneousComponent_zero_of_eval_zero (P : MvPolynomial ι R)
    (hP : eval (0 : ι → R) P = 0) : homogeneousComponent 0 P = 0 := by
  rw [homogeneousComponent_zero]
  have hc : P.coeff 0 = 0 := by
    simpa only [eval_zero, constantCoeff_eq] using hP
  rw [hc, map_zero]

/-- A nonzero polynomial vanishing at the origin has a first nonzero homogeneous
component, whose degree is positive and bounded by its total degree. -/
theorem exists_lowest_nonzero_component (P : MvPolynomial ι R) (hne : P ≠ 0)
    (hzero : eval (0 : ι → R) P = 0) :
    ∃ s : ℕ, 0 < s ∧ s ≤ P.totalDegree ∧ homogeneousComponent s P ≠ 0 ∧
      ∀ k : ℕ, k < s → homogeneousComponent k P = 0 := by
  classical
  have hex : ∃ s : ℕ, homogeneousComponent s P ≠ 0 := by
    by_contra h
    push Not at h
    apply hne
    rw [← sum_homogeneousComponent P]
    simp only [h, Finset.sum_const_zero]
  let s : ℕ := Nat.find hex
  have hs : homogeneousComponent s P ≠ 0 := Nat.find_spec hex
  have hspos : 0 < s := by
    have hsz : s ≠ 0 := by
      intro heq
      apply hs
      rw [heq]
      exact homogeneousComponent_zero_of_eval_zero P hzero
    omega
  have hsdegree : s ≤ P.totalDegree := by
    by_contra h
    exact hs (homogeneousComponent_eq_zero s P (by omega))
  refine ⟨s, hspos, hsdegree, hs, ?_⟩
  intro k hk
  exact not_not.mp (Nat.find_min hex hk)

/-- Apply the lowest-component result to the polynomial expanded around a root. -/
theorem exists_lowest_component_at_root (P : MvPolynomial ι R) (hne : P ≠ 0)
    (z : ι → R) (hroot : eval z P = 0) :
    ∃ s : ℕ, 0 < s ∧ s ≤ (translate P z).totalDegree ∧
      homogeneousComponent s (translate P z) ≠ 0 ∧
      ∀ k : ℕ, k < s → homogeneousComponent k (translate P z) = 0 := by
  apply exists_lowest_nonzero_component (translate P z) (translate_ne_zero P z hne)
  rwa [eval_zero_translate]

lemma translate_one (z : ι → R) : translate (1 : MvPolynomial ι R) z = 1 := by
  simp [translate]

lemma translate_pow (P : MvPolynomial ι R) (z : ι → R) (n : ℕ) :
    translate (P^n) z = (translate P z)^n := by
  simp [translate]

lemma translate_sum {α : Type*} (s : Finset α) (f : α → MvPolynomial ι R) (z : ι → R) :
    translate (∑ a ∈ s, f a) z = ∑ a ∈ s, translate (f a) z := by
  simp [translate]

lemma translate_dvd (P Q : MvPolynomial ι R) (z : ι → R) (h : P ∣ Q) :
    translate P z ∣ translate Q z := by
  obtain ⟨v, hv⟩ := h
  use translate v z
  rw [hv, translate_mul]

/-- Partial differentiation commutes with translation by a constant vector. -/
lemma pderiv_translate (P : MvPolynomial ι R) (z : ι → R) (i : ι) :
    pderiv i (translate P z) = translate (pderiv i P) z := by
  classical
  apply MvPolynomial.induction_on P
  · intro r
    simp only [translate_C, pderiv_C, translate_zero_polynomial]
  · intro p q hp hq
    simp only [translate_add, map_add, hp, hq]
  · intro p j hp
    by_cases hij : j = i
    · subst j
      simp only [translate_mul, translate_X, pderiv_mul, map_add, pderiv_C,
        pderiv_X_self, translate_add, translate_one, hp, add_zero]
    · simp only [translate_mul, translate_X, pderiv_mul, map_add, pderiv_C,
        pderiv_X_of_ne hij, translate_add, translate_zero_polynomial, hp,
        zero_add, add_zero, mul_zero]

end
end Source29PolynomialTranslation

/- Component: ComplexTangent.lean -/

open scoped BigOperators Topology

namespace Source29ComplexTangent

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- Complex bilinear pairing, without conjugation. -/
def dot (z v : EuclideanSpace ℂ ι) : ℂ := ∑ i, z i * v i

/-- Squared Euclidean size. -/
def energy (z : EuclideanSpace ℂ ι) : ℝ := ‖z‖ ^ 2

/-- A polynomial objective for the projective maximum, avoiding `log` and division. -/
def objective (κ : ℝ) (z : EuclideanSpace ℂ ι) : ℝ :=
  ‖dot z z‖ ^ 2 - κ ^ 2 * energy z ^ 2

/-- The complex linear form associated to the bilinear pairing. -/
def dotCLM (z : EuclideanSpace ℂ ι) : EuclideanSpace ℂ ι →L[ℂ] ℂ :=
  ∑ i, z i • EuclideanSpace.proj i

theorem dotCLM_apply (z v : EuclideanSpace ℂ ι) : dotCLM z v = dot z v := by
  simp [dotCLM, dot]

/-- Differential of the quadric as a real differential. -/
theorem hasFDerivAt_quadric (z : EuclideanSpace ℂ ι) :
    HasFDerivAt (fun w : EuclideanSpace ℂ ι => dot w w)
      (2 • (dotCLM z).restrictScalars ℝ) z := by
  have h := HasFDerivAt.sum (u := Finset.univ)
    (fun i _ => ((EuclideanSpace.proj i).restrictScalars ℝ).hasFDerivAt.mul
      ((EuclideanSpace.proj i).restrictScalars ℝ).hasFDerivAt (x := z))
  convert h using 1
  · funext w
    simp [dot]
  · ext v
    simp [dotCLM, two_mul, Finset.sum_add_distrib]

/-- An extremum annihilates a complex tangent direction once its four real phases
belong to the positive tangent cone. This does not assume the algebraic tangent-cone
realization theorem: that geometric hypothesis remains explicit. -/
theorem annihilates_four_phases
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [NormedSpace ℝ E] [IsScalarTower ℝ ℂ E]
    {f : E → ℝ} {S : Set E} {z v : E} (L : E →L[ℂ] ℂ) (a : ℝ)
    (ha : a ≠ 0) (hmax : IsLocalMaxOn f S z)
    (hd : HasFDerivAt f (a • (Complex.reCLM.comp (L.restrictScalars ℝ))) z)
    (hv : v ∈ posTangentConeAt S z) (hmv : -v ∈ posTangentConeAt S z)
    (hiv : Complex.I • v ∈ posTangentConeAt S z)
    (hmiv : -(Complex.I • v) ∈ posTangentConeAt S z) : L v = 0 := by
  have hreal := hmax.hasFDerivWithinAt_eq_zero hd.hasFDerivWithinAt hv hmv
  have himag := hmax.hasFDerivWithinAt_eq_zero hd.hasFDerivWithinAt hiv hmiv
  have hr : (L v).re = 0 := by
    have hh : a * (L v).re = 0 := by simpa using hreal
    exact (mul_eq_zero.mp hh).resolve_left ha
  have hi : (L v).im = 0 := by
    have hh : a * -(L v).im = 0 := by
      simpa [map_smul, Complex.mul_re] using himag
    exact neg_eq_zero.mp ((mul_eq_zero.mp hh).resolve_left ha)
  exact Complex.ext hr hi

/-- Normal covector at a normalized maximum of the projective quadric ratio. -/
def normalCLM (κ : ℝ) (z : EuclideanSpace ℂ ι) : EuclideanSpace ℂ ι →L[ℂ] ℂ :=
  dotCLM z - (κ : ℂ) • innerSL ℂ z

theorem normalCLM_apply (κ : ℝ) (z v : EuclideanSpace ℂ ι) :
    normalCLM κ z v = ∑ i, (z i - (κ : ℂ) * star (z i)) * v i := by
  simp only [normalCLM, sub_apply,
    smul_apply, dotCLM_apply, dot, innerSL_apply_apply,
    PiLp.inner_apply, RCLike.inner_apply, smul_eq_mul, Finset.mul_sum,
    sub_mul, Finset.sum_sub_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  simp only [starRingEnd_apply]
  ring

/-- First derivative of the polynomial maximum objective. -/
theorem hasFDerivAt_objective (κ : ℝ) (z : EuclideanSpace ℂ ι)
    (hq : dot z z = κ) (hz : ‖z‖ = 1) :
    HasFDerivAt (objective κ)
      ((4 * κ) • (Complex.reCLM.comp ((normalCLM κ z).restrictScalars ℝ))) z := by
  have h₁ := (hasFDerivAt_quadric z).norm_sq
  have h₂ := (((hasFDerivAt_id z).norm_sq).pow 2).const_mul (κ ^ 2)
  convert h₁.sub h₂ using 1
  · funext w
    rfl
  · ext v
    simp [hq, hz, normalCLM, dotCLM_apply, real_inner_eq_re_inner ℂ, RCLike.inner_apply,
      Complex.mul_re, PiLp.inner_apply, Complex.re_sum]
    ring

/-- The pointwise bound supplied by the projective maximum makes this objective
nonpositive on the zero set, with value zero at the normalized maximizing point. -/
theorem objective_isLocalMaxOn (κ : ℝ) (S : Set (EuclideanSpace ℂ ι))
    (z : EuclideanSpace ℂ ι) (hκ : 0 ≤ κ) (hq : dot z z = κ) (hz : ‖z‖ = 1)
    (hbound : ∀ w ∈ S, ‖dot w w‖ ≤ κ * ‖w‖ ^ 2) :
    IsLocalMaxOn (objective κ) S z := by
  apply IsMaxOn.isLocalMaxOn
  intro w hw
  have hb := hbound w hw
  have hs : ‖dot w w‖ ^ 2 ≤ (κ * ‖w‖ ^ 2) ^ 2 := by
    exact pow_le_pow_left₀ (norm_nonneg _) hb 2
  have hn : ‖(κ : ℂ)‖ = κ := by simp [abs_of_nonneg hκ]
  change objective κ w ≤ objective κ z
  simp only [objective, energy, hq, hz, hn]
  nlinarith

/-- First-order hyperplane restriction at the projective maximum. The sole
geometric input here is membership of the four phases in the positive tangent
cone; obtaining this from the lowest homogeneous Taylor term is separate. -/
theorem tangent_in_normal_hyperplane (κ : ℝ) (S : Set (EuclideanSpace ℂ ι))
    (z v : EuclideanSpace ℂ ι) (hκ : 0 < κ) (hq : dot z z = κ) (hz : ‖z‖ = 1)
    (hbound : ∀ w ∈ S, ‖dot w w‖ ≤ κ * ‖w‖ ^ 2)
    (hv : v ∈ posTangentConeAt S z) (hmv : -v ∈ posTangentConeAt S z)
    (hiv : Complex.I • v ∈ posTangentConeAt S z)
    (hmiv : -(Complex.I • v) ∈ posTangentConeAt S z) :
    normalCLM κ z v = 0 := by
  exact annihilates_four_phases (normalCLM κ z) (4 * κ)
    (mul_ne_zero (by norm_num) (ne_of_gt hκ))
    (objective_isLocalMaxOn κ S z hκ.le hq hz hbound)
    (hasFDerivAt_objective κ z hq hz) hv hmv hiv hmiv

end
end Source29ComplexTangent

/- Component: InitialTangent.inc -/
/- The singular tangent-cone step of the maximum argument, realized through
bounded-degree polynomial roots rather than a complex-analytic perturbation theorem. -/

namespace Source29InitialTangent

open MvPolynomial
open Source29ProjectiveMaximum Source29PolynomialTranslation
open scoped BigOperators

noncomputable section

def zeroSet {n : ℕ} (h : MvPolynomial (Fin n) ℂ) : Set (CSpace n) :=
  {w | eval (fun i => w i) h = 0}

theorem initial_zero_mem_posTangentConeAt {n : ℕ}
    (h : MvPolynomial (Fin n) ℂ) (z : CSpace n) (s : ℕ)
    (hs : s ≤ (translate h (fun i => z i)).totalDegree)
    (hlow : ∀ k < s, homogeneousComponent k (translate h (fun i => z i)) = 0)
    (v : CSpace n) (u : Fin n → ℂ)
    (hv : eval (fun i => v i) (homogeneousComponent s (translate h (fun i => z i))) = 0)
    (hu : eval u (homogeneousComponent s (translate h (fun i => z i))) ≠ 0) :
    v ∈ posTangentConeAt (zeroSet h) z := by
  apply Source29TangentRealization.mem_posTangentConeAt_of_approximations
    (u := WithLp.toLp 2 u)
  intro ε hε
  obtain ⟨t, τ, htpos, htε, hτ, hzero⟩ :=
    Source29SmallZeroApprox.exists_small_scaled_zero
      (translate h (fun i => z i)) s hs hlow (fun i => v i) u hv hu ε hε
  refine ⟨t, τ, htpos, htε, hτ, ?_⟩
  rw [eval_translate] at hzero
  exact hzero

/-- At the normalized maximum, every zero of the first homogeneous Taylor form
lies in the complex normal hyperplane. This includes singular maximizing points. -/
theorem initial_zero_in_normal_hyperplane {n : ℕ}
    (h : MvPolynomial (Fin n) ℂ) (z : CSpace n) (s : ℕ)
    (hs : s ≤ (translate h (fun i => z i)).totalDegree)
    (hlow : ∀ k < s, homogeneousComponent k (translate h (fun i => z i)) = 0)
    (hne : homogeneousComponent s (translate h (fun i => z i)) ≠ 0)
    (κ : ℝ) (hk : 0 < κ) (hzunit : ‖z‖ = 1)
    (hzq : (∑ i : Fin n, (z i)^2) = (κ : ℂ))
    (hbound : ∀ w : CSpace n, eval (fun i => w i) h = 0 →
      quadricNorm w ≤ κ * ‖w‖^2)
    (v : CSpace n)
    (hv : eval (fun i => v i) (homogeneousComponent s (translate h (fun i => z i))) = 0) :
    ∑ i : Fin n, (z i - (κ : ℂ) * star (z i)) * v i = 0 := by
  let H := homogeneousComponent s (translate h (fun i => z i))
  have hhom : H.IsHomogeneous s := homogeneousComponent_isHomogeneous _ _
  obtain ⟨u, hu⟩ : ∃ u : Fin n → ℂ, eval u H ≠ 0 := by
    by_contra hnone
    push Not at hnone
    exact hne (hhom.eq_zero_of_forall_eval_eq_zero hnone)
  have hmem (w : CSpace n) (hw : eval (fun i => w i) H = 0) :
      w ∈ posTangentConeAt (zeroSet h) z :=
    initial_zero_mem_posTangentConeAt h z s hs hlow w u hw hu
  have hscale (a : ℂ) : eval (fun i => a * v i) H = 0 := by
    rw [eval_scale_of_isHomogeneous H s hhom, hv, mul_zero]
  have hq : Source29ComplexTangent.dot z z = (κ : ℂ) := by
    simpa only [Source29ComplexTangent.dot, pow_two] using hzq
  have hb : ∀ w ∈ zeroSet h,
      ‖Source29ComplexTangent.dot w w‖ ≤ κ * ‖w‖^2 := by
    intro w hw
    simpa only [Source29ComplexTangent.dot, quadricNorm, pow_two] using hbound w hw
  have hn := Source29ComplexTangent.tangent_in_normal_hyperplane κ (zeroSet h) z v
    hk hq hzunit hb (hmem v hv)
    (hmem (-v) (by simpa using hscale (-1)))
    (hmem (Complex.I • v) (by simpa using hscale Complex.I))
    (hmem (-(Complex.I • v)) (by simpa using hscale (-Complex.I)))
  simpa only [Source29ComplexTangent.normalCLM_apply] using hn

end
end Source29InitialTangent

/- Component: NormalCoordinates.lean -/

namespace Source29NormalCoordinates

open Finset

variable {ι : Type*} [Fintype ι]

def dot (z w : ι → ℂ) : ℂ := ∑ i, z i * w i

def conjugate (z : ι → ℂ) : ι → ℂ := fun i => star (z i)

def realPart (z : ι → ℂ) : ι → ℂ := fun i => ((z i).re : ℂ)

def imagPart (z : ι → ℂ) : ι → ℂ := fun i => ((z i).im : ℂ)

def normal (z : ι → ℂ) (κ : ℝ) : ι → ℂ :=
  fun i => z i - (κ : ℂ) * star (z i)

lemma dot_comm (z w : ι → ℂ) : dot z w = dot w z := by
  simp [dot, mul_comm]

lemma dot_add_left (z v w : ι → ℂ) :
    dot (fun i => z i + v i) w = dot z w + dot v w := by
  simp [dot, add_mul, Finset.sum_add_distrib]

lemma dot_sub_left (z v w : ι → ℂ) :
    dot (fun i => z i - v i) w = dot z w - dot v w := by
  simp [dot, sub_mul, Finset.sum_sub_distrib]

lemma dot_sub_right (z v w : ι → ℂ) :
    dot z (fun i => v i - w i) = dot z v - dot z w := by
  simp [dot, mul_sub, Finset.sum_sub_distrib]

lemma dot_mul_left (c : ℂ) (z w : ι → ℂ) :
    dot (fun i => c * z i) w = c * dot z w := by
  simp [dot, mul_assoc, Finset.mul_sum]

lemma dot_mul_right (c : ℂ) (z w : ι → ℂ) :
    dot z (fun i => c * w i) = c * dot z w := by
  rw [dot_comm, dot_mul_left, dot_comm w z]

lemma dot_realPart (z v : ι → ℂ) :
    2 * dot (realPart z) v = dot z v + dot (conjugate z) v := by
  unfold dot realPart conjugate
  rw [← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have he : (2 : ℂ) * ((z i).re : ℂ) = z i + star (z i) := by
    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring
  calc
    (2 : ℂ) * (((z i).re : ℂ) * v i) = (2 * ((z i).re : ℂ)) * v i := by ring
    _ = (z i + star (z i)) * v i := by rw [he]
    _ = z i * v i + star (z i) * v i := by ring

lemma dot_imagPart (z v : ι → ℂ) :
    (2 * Complex.I) * dot (imagPart z) v = dot z v - dot (conjugate z) v := by
  unfold dot imagPart conjugate
  rw [← Finset.sum_sub_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have he : (2 * Complex.I) * ((z i).im : ℂ) = z i - star (z i) := by
    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im] <;> ring
  calc
    (2 * Complex.I) * (((z i).im : ℂ) * v i) = ((2 * Complex.I) * ((z i).im : ℂ)) * v i := by ring
    _ = (z i - star (z i)) * v i := by rw [he]
    _ = z i * v i - star (z i) * v i := by ring

lemma real_imag_orthogonal_iff (z v : ι → ℂ) :
    (dot (realPart z) v = 0 ∧ dot (imagPart z) v = 0) ↔
      (dot z v = 0 ∧ dot (conjugate z) v = 0) := by
  have hr := dot_realPart z v
  have hi := dot_imagPart z v
  constructor
  · rintro ⟨hxr, hxi⟩
    rw [hxr, mul_zero] at hr
    rw [hxi, mul_zero] at hi
    constructor
    · linear_combination -(hr + hi) / 2
    · linear_combination -(hr - hi) / 2
  · rintro ⟨hz, hzb⟩
    rw [hz, hzb, add_zero] at hr
    rw [hz, hzb, sub_zero] at hi
    constructor
    · exact (mul_eq_zero.mp hr).resolve_left (by norm_num)
    · exact (mul_eq_zero.mp hi).resolve_left (by norm_num)

/-- Real and imaginary parts of a unit complex vector whose bilinear square is real. -/
theorem real_imag_normalization {n : ℕ} (z : EuclideanSpace ℂ (Fin n)) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    (∑ i : Fin n, (z i).re * (z i).im) = 0 ∧
      (∑ i : Fin n, (z i).re^2) = (1 + κ) / 2 ∧
      (∑ i : Fin n, (z i).im^2) = (1 - κ) / 2 := by
  have hr := congrArg Complex.re hq
  simp only [Complex.re_sum, pow_two, Complex.mul_re, Complex.ofReal_re,
    Finset.sum_sub_distrib] at hr
  have hi := congrArg Complex.im hq
  simp only [Complex.im_sum, pow_two, Complex.mul_im, Complex.ofReal_im,
    Finset.sum_add_distrib] at hi
  have hc : (∑ i : Fin n, (z i).im * (z i).re) = ∑ i : Fin n, (z i).re * (z i).im := by
    apply Finset.sum_congr rfl
    intro i hi
    ring
  rw [hc] at hi
  have hn := EuclideanSpace.norm_sq_eq z
  rw [hz] at hn
  simp only [one_pow, Complex.sq_norm, Complex.normSq_apply, Finset.sum_add_distrib] at hn
  simp only [pow_two]
  constructor
  · linarith
  constructor <;> linarith

lemma dot_add_right (z v w : ι → ℂ) :
    dot z (fun i => v i + w i) = dot z v + dot z w := by
  simp [dot, mul_add, Finset.sum_add_distrib]

lemma dot_single_right [DecidableEq ι] (z : ι → ℂ) (i : ι) :
    dot z (Pi.single i 1) = z i := by
  simp [dot, Pi.single_apply]

/-- A nonisotropic normal gives a nondegenerate bilinear metric on its perpendicular space. -/
theorem perpendicular_nondegenerate [DecidableEq ι] (N : ι → ℂ)
    (hN : dot N N ≠ 0) (w : ι → ℂ) (hw : dot N w = 0)
    (horth : ∀ v : ι → ℂ, dot N v = 0 → dot w v = 0) : w = 0 := by
  have hwN : dot w N = 0 := by rw [dot_comm]; exact hw
  ext i
  let v : ι → ℂ := fun j => ((Pi.single i (1 : ℂ)) : ι → ℂ) j - (N i / dot N N) * N j
  have hv : dot N v = 0 := by
    dsimp only [v]
    rw [dot_sub_right, dot_mul_right, dot_single_right]
    field_simp
    ring
  have hh := horth v hv
  dsimp only [v] at hh
  rw [dot_sub_right, dot_mul_right, dot_single_right, hwN, mul_zero, sub_zero] at hh
  exact hh

/-- The normal perpendicular space splits as the radial complex line plus the
space perpendicular to both real and imaginary parts. -/
theorem tangent_decomposition (z : ι → ℂ) (κ : ℝ)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1)
    (v : ι → ℂ) (hv : dot (normal z κ) v = 0) :
    ∃ (a : ℂ) (e : ι → ℂ), v = (fun i => a * z i + e i) ∧
      dot (realPart z) e = 0 ∧ dot (imagPart z) e = 0 := by
  let a : ℂ := dot (conjugate z) v
  let e : ι → ℂ := fun i => v i - a * z i
  have hez : dot z e = 0 := by
    change dot (fun i => z i - (κ : ℂ) * star (z i)) v = 0 at hv
    rw [dot_sub_left, dot_mul_left] at hv
    dsimp only [e]
    rw [dot_sub_right, dot_mul_right, hq]
    change dot z v - dot (conjugate z) v * (κ : ℂ) = 0
    change dot z v - (κ : ℂ) * dot (conjugate z) v = 0 at hv
    linear_combination hv
  have hebar : dot (conjugate z) e = 0 := by
    dsimp only [e]
    rw [dot_sub_right, dot_mul_right, hnorm]
    dsimp only [a]
    ring
  have he := (real_imag_orthogonal_iff z e).mpr ⟨hez, hebar⟩
  refine ⟨a, e, ?_, he.1, he.2⟩
  funext i
  dsimp only [e]
  ring

/-- The radial coefficient and complementary vector in the splitting are unique. -/
theorem tangent_decomposition_unique (z : ι → ℂ)
    (hnorm : dot (conjugate z) z = 1)
    (v : ι → ℂ) (a b : ℂ) (e f : ι → ℂ)
    (he : dot (realPart z) e = 0 ∧ dot (imagPart z) e = 0)
    (hf : dot (realPart z) f = 0 ∧ dot (imagPart z) f = 0)
    (hve : v = fun i => a * z i + e i)
    (hvf : v = fun i => b * z i + f i) : a = b ∧ e = f := by
  have hebar := ((real_imag_orthogonal_iff z e).mp he).2
  have hfbar := ((real_imag_orthogonal_iff z f).mp hf).2
  have hcoeff : a = b := by
    have hh := congrArg (dot (conjugate z)) (hve.symm.trans hvf)
    rw [dot_add_right, dot_add_right, dot_mul_right, dot_mul_right,
      hnorm, hebar, hfbar] at hh
    simpa using hh
  refine ⟨hcoeff, ?_⟩
  funext i
  have hh := congrArg (fun w : ι → ℂ => w i) (hve.symm.trans hvf)
  rw [hcoeff] at hh
  exact add_left_cancel hh

lemma hermitian_dot_eq_norm_sq {n : ℕ} (z : EuclideanSpace ℂ (Fin n)) :
    dot (conjugate (fun i => z i)) (fun i => z i) = ((‖z‖^2 : ℝ) : ℂ) := by
  calc
    dot (conjugate (fun i => z i)) (fun i => z i) =
        ∑ i : Fin n, ((‖z i‖^2 : ℝ) : ℂ) := by
      unfold dot conjugate
      apply Finset.sum_congr rfl
      intro i hi
      simpa only [Complex.normSq_eq_norm_sq, Complex.star_def] using
        (Complex.normSq_eq_conj_mul_self (z := z i)).symm
    _ = ((∑ i : Fin n, ‖z i‖^2 : ℝ) : ℂ) := by simp
    _ = ((‖z‖^2 : ℝ) : ℂ) := by rw [EuclideanSpace.norm_sq_eq]

lemma hermitian_dot_eq_one {n : ℕ} (z : EuclideanSpace ℂ (Fin n)) (hz : ‖z‖ = 1) :
    dot (conjugate (fun i => z i)) (fun i => z i) = 1 := by
  rw [hermitian_dot_eq_norm_sq, hz]
  norm_num

lemma normal_square (z : ι → ℂ) (κ : ℝ)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1) :
    dot (normal z κ) (normal z κ) = -(κ : ℂ) * (1 - (κ : ℂ)^2) := by
  have hconj : dot (conjugate z) (conjugate z) = (κ : ℂ) := by
    have he := congrArg star hq
    simpa [dot, conjugate, map_sum, map_mul] using he
  have hcross : dot z (conjugate z) = 1 := by rw [dot_comm]; exact hnorm
  unfold normal
  change dot (fun i => z i - (κ : ℂ) * conjugate z i)
    (fun i => z i - (κ : ℂ) * conjugate z i) = _
  rw [dot_sub_left, dot_sub_right, dot_sub_right, dot_mul_right,
    dot_mul_left, dot_mul_left, dot_mul_right, hq, hnorm, hcross, hconj]
  ring

lemma normal_square_ne_zero (z : ι → ℂ) (κ : ℝ) (hpos : 0 < κ) (hlt : κ < 1)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1) :
    dot (normal z κ) (normal z κ) ≠ 0 := by
  rw [normal_square z κ hq hnorm]
  have hr : -(κ : ℝ) * (1 - κ^2) ≠ 0 := by
    have hs : κ^2 < 1 := by nlinarith
    exact ne_of_lt (mul_neg_of_neg_of_pos (neg_neg_of_pos hpos) (sub_pos.mpr hs))
  exact_mod_cast hr

/-- Nondegeneracy of the complex bilinear metric on the tangent hyperplane. -/
theorem tangent_metric_nondegenerate [DecidableEq ι]
    (z : ι → ℂ) (κ : ℝ) (hpos : 0 < κ) (hlt : κ < 1)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1)
    (w : ι → ℂ) (hw : dot (normal z κ) w = 0)
    (horth : ∀ v : ι → ℂ, dot (normal z κ) v = 0 → dot w v = 0) : w = 0 :=
  perpendicular_nondegenerate (normal z κ) (normal_square_ne_zero z κ hpos hlt hq hnorm)
    w hw horth

/-- Nondegeneracy of the complex bilinear metric on the complement of the real
and imaginary parts of the normalized point. -/
theorem transverse_metric_nondegenerate [DecidableEq ι]
    (z : ι → ℂ) (κ : ℝ) (hpos : 0 < κ) (hlt : κ < 1)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1)
    (w : ι → ℂ) (hw : dot (realPart z) w = 0 ∧ dot (imagPart z) w = 0)
    (horth : ∀ v : ι → ℂ, dot (realPart z) v = 0 → dot (imagPart z) v = 0 → dot w v = 0) :
    w = 0 := by
  have hwc := (real_imag_orthogonal_iff z w).mp hw
  have hwn : dot (normal z κ) w = 0 := by
    unfold normal
    change dot (fun i => z i - (κ : ℂ) * conjugate z i) w = 0
    rw [dot_sub_left, dot_mul_left, hwc.1, hwc.2]
    ring
  have hwz : dot w z = 0 := by rw [dot_comm]; exact hwc.1
  apply tangent_metric_nondegenerate z κ hpos hlt hq hnorm w hwn
  intro v hv
  obtain ⟨a, e, hve, her, hei⟩ := tangent_decomposition z κ hq hnorm v hv
  have he := horth e her hei
  rw [hve, dot_add_right, dot_mul_right, hwz, he]
  ring

lemma normal_radial_orthogonal (z : ι → ℂ) (κ : ℝ)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1) :
    dot (normal z κ) z = 0 := by
  unfold normal
  change dot (fun i => z i - (κ : ℂ) * conjugate z i) z = 0
  rw [dot_sub_left, dot_mul_left, hq, hnorm]
  ring

lemma radial_plus_transverse_mem_tangent (z : ι → ℂ) (κ : ℝ)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1)
    (a : ℂ) (e : ι → ℂ)
    (he : dot (realPart z) e = 0 ∧ dot (imagPart z) e = 0) :
    dot (normal z κ) (fun i => a * z i + e i) = 0 := by
  have hec := (real_imag_orthogonal_iff z e).mp he
  have hen : dot (normal z κ) e = 0 := by
    unfold normal
    change dot (fun i => z i - (κ : ℂ) * conjugate z i) e = 0
    rw [dot_sub_left, dot_mul_left, hec.1, hec.2]
    ring
  rw [dot_add_right, dot_mul_right, normal_radial_orthogonal z κ hq hnorm, hen]
  ring

/-- An exact characterization of the tangent hyperplane as the orthogonal sum
of the radial complex line and the real/imaginary perpendicular space. -/
theorem tangent_decomposition_iff (z : ι → ℂ) (κ : ℝ)
    (hq : dot z z = (κ : ℂ)) (hnorm : dot (conjugate z) z = 1) (v : ι → ℂ) :
    dot (normal z κ) v = 0 ↔
      ∃ (a : ℂ) (e : ι → ℂ), v = (fun i => a * z i + e i) ∧
        dot (realPart z) e = 0 ∧ dot (imagPart z) e = 0 := by
  constructor
  · exact tangent_decomposition z κ hq hnorm v
  · rintro ⟨a, e, rfl, her, hei⟩
    exact radial_plus_transverse_mem_tangent z κ hq hnorm a e ⟨her, hei⟩

lemma real_imag_nonzero {n : ℕ} (z : EuclideanSpace ℂ (Fin n)) (κ : ℝ)
    (hpos : 0 < κ) (hlt : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    (fun i => (z i).re) ≠ 0 ∧ (fun i => (z i).im) ≠ 0 := by
  obtain ⟨hxy, hx, hy⟩ := real_imag_normalization z κ hz hq
  constructor
  · intro hzero
    have hh : (∑ i : Fin n, (z i).re^2) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      have he := congrArg (fun f : Fin n → ℝ => f i) hzero
      change (z i).re = 0 at he
      rw [he]
      norm_num
    linarith
  · intro hzero
    have hh : (∑ i : Fin n, (z i).im^2) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      have he := congrArg (fun f : Fin n → ℝ => f i) hzero
      change (z i).im = 0 at he
      rw [he]
      norm_num
    linarith

end Source29NormalCoordinates

/- Component: LinearForm.lean -/

namespace Source29LinearForm

open MvPolynomial
open scoped BigOperators

noncomputable section

variable {K ι : Type*} [Field K] [Fintype ι]

/-- The homogeneous linear polynomial associated to a coefficient vector. -/
def linearForm (a : ι → K) : MvPolynomial ι K := ∑ i, C (a i) * X i

theorem eval_linearForm (a x : ι → K) :
    eval x (linearForm a) = ∑ i, a i * x i := by
  simp [linearForm]

theorem coeff_linearForm (a : ι → K) (j : ι) :
    (linearForm a).coeff (Finsupp.single j 1) = a j := by
  classical
  simp only [linearForm, coeff_sum, coeff_C_mul, coeff_X]
  rw [Finset.sum_eq_single j]
  · simp
  · intro i _ hij
    have hd : Finsupp.single j 1 ≠ Finsupp.single i (1 : ℕ) := by
      simpa [Finsupp.single_left_inj Nat.one_ne_zero] using Ne.symm hij
    simp [Ne.symm hd]
  · simp

theorem linearForm_isHomogeneous (a : ι → K) : (linearForm a).IsHomogeneous 1 := by
  apply IsHomogeneous.sum
  intro i _
  exact (isHomogeneous_X K i).C_mul (a i)

theorem linearForm_ne_zero (a : ι → K) (ha : ∃ i, a i ≠ 0) : linearForm a ≠ 0 := by
  obtain ⟨i, hi⟩ := ha
  intro hz
  have hc := congrArg (fun p : MvPolynomial ι K => p.coeff (Finsupp.single i 1)) hz
  apply hi
  simpa [coeff_linearForm] using hc

theorem linearForm_totalDegree (a : ι → K) (ha : ∃ i, a i ≠ 0) :
    (linearForm a).totalDegree = 1 :=
  (linearForm_isHomogeneous a).totalDegree (linearForm_ne_zero a ha)

/-- Elementary degree proof, adapted from mathlib's
`RingTheory/MvPolynomial/IrreducibleQuadratic.lean`; that file is outside the
permitted import closure. Over a field a nonzero constant is a unit. -/
theorem irreducible_of_totalDegree_one (p : MvPolynomial ι K)
    (hp : p.totalDegree = 1) : Irreducible p := by
  have hpne : p ≠ 0 := by intro h; simp [h] at hp
  refine ⟨?_, ?_⟩
  · intro hu
    have hd := totalDegree_le_of_dvd_of_isDomain (hu.dvd : p ∣ (1 : MvPolynomial ι K))
      (one_ne_zero : (1 : MvPolynomial ι K) ≠ 0)
    simp [hp] at hd
  · intro f g hfg
    have hfn : f ≠ 0 := left_ne_zero_of_mul (hfg ▸ hpne)
    have hgn : g ≠ 0 := right_ne_zero_of_mul (hfg ▸ hpne)
    have hd : f.totalDegree + g.totalDegree = 1 := by
      rw [← totalDegree_mul_of_isDomain hfn hgn, ← hfg, hp]
    have hconst (q : MvPolynomial ι K) (hq : q ≠ 0) (hqd : q.totalDegree = 0) :
        IsUnit q := by
      have he := totalDegree_eq_zero_iff_eq_C.mp hqd
      rw [he]
      apply IsUnit.map C
      apply isUnit_iff_ne_zero.mpr
      intro hc
      apply hq
      rw [he, hc, map_zero]
    by_cases hf : f.totalDegree = 0
    · exact Or.inl (hconst f hfn hf)
    · exact Or.inr (hconst g hgn (by omega))

theorem linearForm_irreducible (a : ι → K) (ha : ∃ i, a i ≠ 0) :
    Irreducible (linearForm a) :=
  irreducible_of_totalDegree_one _ (linearForm_totalDegree a ha)

end
end Source29LinearForm

/- Component: HyperplanePower.lean -/

namespace Source29HyperplanePower

open MvPolynomial

noncomputable section

variable {K ι : Type*} [Field K] [IsAlgClosed K] [Fintype ι]

/-- A polynomial whose zero set lies in one irreducible hypersurface is a unit
times a power of its defining polynomial. Applied to a nonzero linear form,
this is the algebraic conclusion of the tangent-hyperplane argument. -/
theorem associated_pow_of_zero_set_subset
    (H L : MvPolynomial ι K) (hL : Irreducible L)
    (hvan : ∀ z : ι → K, eval z H = 0 → eval z L = 0) :
    ∃ s : ℕ, Associated H (L ^ s) := by
  let J : Ideal (MvPolynomial ι K) := Ideal.span {H}
  have hmem : L ∈ vanishingIdeal K (zeroLocus K J) := by
    intro z hz
    have hH : H ∈ J := Ideal.subset_span (Set.mem_singleton H)
    have hzH := hz H hH
    simpa using hvan z (by simpa using hzH)
  rw [vanishingIdeal_zeroLocus_eq_radical] at hmem
  obtain ⟨n, hn⟩ := hmem
  obtain ⟨s, _, hs⟩ := (dvd_prime_pow hL.prime n).mp (Ideal.mem_span_singleton.mp hn)
  exact ⟨s, hs⟩

/-- For a homogeneous polynomial and a degree-one defining form, the power is
exactly the homogeneous degree. -/
theorem associated_degree_pow_of_zero_set_subset
    (H L : MvPolynomial ι K) (s : ℕ) (hH : H.IsHomogeneous s) (hHne : H ≠ 0)
    (hL : Irreducible L) (hLdegree : L.totalDegree = 1)
    (hvan : ∀ z : ι → K, eval z H = 0 → eval z L = 0) :
    Associated H (L ^ s) := by
  obtain ⟨k, hk⟩ := associated_pow_of_zero_set_subset H L hL hvan
  have hpow : ∀ k : ℕ, (L ^ k).totalDegree = k := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, totalDegree_mul_of_isDomain (pow_ne_zero _ hL.ne_zero) hL.ne_zero,
        ih, hLdegree]
  have hd : H.totalDegree = (L ^ k).totalDegree :=
    le_antisymm (totalDegree_le_of_dvd_of_isDomain hk.dvd (pow_ne_zero _ hL.ne_zero))
      (totalDegree_le_of_dvd_of_isDomain hk.symm.dvd hHne)
  have hsk : s = k := by simpa only [hH.totalDegree hHne, hpow] using hd
  simpa only [← hsk] using hk

/-- Coordinate form of the tangent-cone conclusion, with an explicit nonzero
scalar coefficient. -/
theorem eq_C_mul_degree_pow_of_zero_set_subset
    (H L : MvPolynomial ι K) (s : ℕ) (hH : H.IsHomogeneous s) (hHne : H ≠ 0)
    (hL : Irreducible L) (hLdegree : L.totalDegree = 1)
    (hvan : ∀ z : ι → K, eval z H = 0 → eval z L = 0) :
    ∃ a : K, a ≠ 0 ∧ H = C a * L ^ s := by
  have hassoc := associated_degree_pow_of_zero_set_subset H L s hH hHne hL hLdegree hvan
  obtain ⟨u, hu⟩ := hassoc.symm
  have hdegree : (u : MvPolynomial ι K).totalDegree = 0 := by
    have hle := totalDegree_le_of_dvd_of_isDomain (u.isUnit.dvd : (u : MvPolynomial ι K) ∣ (1 : MvPolynomial ι K))
      (one_ne_zero : (1 : MvPolynomial ι K) ≠ 0)
    simpa using hle
  have hua := totalDegree_eq_zero_iff_eq_C.mp hdegree
  refine ⟨(u : MvPolynomial ι K).coeff 0, ?_, ?_⟩
  · intro hc
    apply u.ne_zero
    rw [hua, hc, map_zero]
  · rw [← hu, hua, mul_comm]
    simp

end
end Source29HyperplanePower

/- Component: InitialNormalPower.inc -/
/- At any possibly singular normalized maximum, the first nonzero Taylor
polynomial is a nonzero multiple of a power of the normal linear form. -/

namespace Source29InitialNormalPower

open MvPolynomial
