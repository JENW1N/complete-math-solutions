/-- The finite-dimensional contradiction at the end of the complex maximum argument. -/
theorem trace_contradiction {ι : Type*} [Fintype ι] [Nonempty ι]
    (u : ι → ℂ) (c : ℂ) (κ : ℝ)
    (hsum : ∑ i, u i = 0) (hκ : κ < 1)
    (hbound : ∀ i, ‖1 + c * u i‖ ≤ κ) : False := by
  have hpoint : ∀ i, (c * u i).re < 0 := by
    intro i
    have hr := Complex.re_le_norm (1 + c * u i)
    have hb := hbound i
    simp only [Complex.add_re, Complex.one_re] at hr
    linarith
  have hneg : ∑ i, (c * u i).re < 0 := by
    exact Finset.sum_neg (fun i _ => hpoint i) Finset.univ_nonempty
  have hzero : ∑ i, (c * u i).re = 0 := by
    rw [← Complex.re_sum, ← Finset.mul_sum, hsum, mul_zero, Complex.zero_re]
  linarith

/-- The bilinear form used in the paper has no conjugation in its definition. -/
def bilinear {ι : Type*} [Fintype ι] (z w : ι → ℂ) : ℂ :=
  ∑ i, z i * w i

theorem bilinear_comm {ι : Type*} [Fintype ι] (z w : ι → ℂ) :
    bilinear z w = bilinear w z := by
  unfold bilinear
  congr 1
  funext i
  ring

theorem bilinear_sub_left {ι : Type*} [Fintype ι] (z v w : ι → ℂ) :
    bilinear (fun i => z i - v i) w = bilinear z w - bilinear v w := by
  simp [bilinear, sub_mul, Finset.sum_sub_distrib]

theorem bilinear_sub_right {ι : Type*} [Fintype ι] (z v w : ι → ℂ) :
    bilinear z (fun i => v i - w i) = bilinear z v - bilinear z w := by
  simp [bilinear, mul_sub, Finset.sum_sub_distrib]

theorem bilinear_smul_left {ι : Type*} [Fintype ι] (a : ℂ) (z w : ι → ℂ) :
    bilinear (fun i => a * z i) w = a * bilinear z w := by
  simp [bilinear, mul_assoc, Finset.mul_sum]

theorem bilinear_smul_right {ι : Type*} [Fintype ι] (a : ℂ) (z w : ι → ℂ) :
    bilinear z (fun i => a * w i) = a * bilinear z w := by
  rw [bilinear_comm, bilinear_smul_left, bilinear_comm w z]

/-- The normal vector at a normalized maximum is bilinearly orthogonal to the point. -/
theorem normal_orthogonal {ι : Type*} [Fintype ι]
    (z : ι → ℂ) (κ : ℝ)
    (hq : bilinear z z = κ)
    (hnorm : bilinear (fun i => star (z i)) z = 1) :
    bilinear (fun i => z i - (κ : ℂ) * star (z i)) z = 0 := by
  rw [bilinear_sub_left, bilinear_smul_left, hq, hnorm]
  ring

/-- The normal's squared bilinear length is negative and nonzero for 0 < κ < 1. -/
theorem normal_square {ι : Type*} [Fintype ι]
    (z : ι → ℂ) (κ : ℝ)
    (hq : bilinear z z = κ)
    (hnorm : bilinear (fun i => star (z i)) z = 1) :
    bilinear (fun i => z i - (κ : ℂ) * star (z i))
      (fun i => z i - (κ : ℂ) * star (z i)) = -(κ : ℂ) * (1 - κ ^ 2) := by
  have hconj : bilinear (fun i => star (z i)) (fun i => star (z i)) = κ := by
    have hs := congrArg star hq
    simpa [bilinear, map_sum, map_mul] using hs
  have hcross : bilinear z (fun i => star (z i)) = 1 := by
    rw [bilinear_comm]
    exact hnorm
  rw [bilinear_sub_left, bilinear_sub_right, bilinear_sub_right,
    bilinear_smul_right, bilinear_smul_left, bilinear_smul_left,
    bilinear_smul_right, hq, hnorm, hcross, hconj]
  ring

theorem normal_square_ne_zero (κ : ℝ) (hpos : 0 < κ) (hlt : κ < 1) :
    -(κ : ℂ) * (1 - κ ^ 2) ≠ 0 := by
  have hr : -(κ : ℝ) * (1 - κ ^ 2) ≠ 0 := by
    have hs : κ ^ 2 < 1 := by nlinarith
    exact ne_of_lt (mul_neg_of_neg_of_pos (neg_neg_of_pos hpos) (sub_pos.mpr hs))
  exact_mod_cast hr

/-- The power-sum identity that controls imaginary parts in the sheet-bound lemma. -/
theorem imaginary_squares_identity {ι : Type*} [Fintype ι] (w : ι → ℂ) :
    ∑ i, (w i).im ^ 2 = (∑ i, (w i).re ^ 2) - (∑ i, w i ^ 2).re := by
  simp only [Complex.re_sum, pow_two, Complex.mul_re]
  rw [← Finset.sum_sub_distrib]
  congr 1
  funext i
  ring

/-- A finite root bound, independent of how the roots are locally labelled. -/
theorem imaginary_square_le {ι : Type*} [Fintype ι]
    (w : ι → ℂ) (A B : ℝ)
    (hre : ∑ i, (w i).re ^ 2 ≤ A)
    (hpower : -B ≤ (∑ i, w i ^ 2).re) (i : ι) :
    (w i).im ^ 2 ≤ A + B := by
  have hi : (w i).im ^ 2 ≤ ∑ j, (w j).im ^ 2 :=
    Finset.single_le_sum (fun j _ => sq_nonneg ((w j).im)) (Finset.mem_univ i)
  rw [imaginary_squares_identity] at hi
  linarith

end
