    baseIntegrand f x (-t) i = baseIntegrand f x t i := by simp only [baseIntegrand, neg_sq]

theorem baseIntegrand_zero_large {f : ℝ → ℝ} (hz : ∀ s, 2 ≤ s → deriv f s = 0)
    (x : Fin n → ℝ) (i : Fin n) {t : ℝ} (ht : 2 ≤ t) : baseIntegrand f x t i = 0 := by
  have hR : 2 ≤ (∑ j, x j ^ 2) + t^2 := by
    nlinarith [Finset.sum_nonneg (s := Finset.univ) (fun j _ ↦ sq_nonneg (x j))]
  simp only [baseIntegrand, hz _ hR, mul_zero]

theorem exists_baseIntegrand_bound {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (hz : ∀ s, 2 ≤ s → deriv f s = 0) :
    ∃ M : ℝ, ∀ (x : Fin n → ℝ) t i, ‖baseIntegrand f x t i‖ ≤ M := by
  obtain ⟨M,hM⟩ := (isCompact_Icc : IsCompact (Icc (0 : ℝ) 2)).exists_bound_of_continuousOn hf.continuous_deriv_one.continuousOn
  refine ⟨4 * max M 0, ?_⟩
  intro x t i
  by_cases hR : 2 ≤ (∑ j, x j ^ 2) + t^2
  · simp only [baseIntegrand, hz _ hR, mul_zero, norm_zero]
    positivity
  have hR0 := radius_nonneg x t
