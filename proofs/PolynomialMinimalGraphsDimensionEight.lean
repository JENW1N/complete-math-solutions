  have he := ((((hp.div_const (u ⬝ᵥ u)).const_mul 2).mul_const (u a)).sub (hv a))
  simpa only [reflect_apply, Pi.mul_def, Pi.div_def, Pi.sub_def] using he

/-- The two-reflection rotation has the usual infinitesimal skew action at
its identity point, proved for actual differentiable coordinate curves. -/
theorem hasDerivAt_rotation (u : κ → ℝ) (v w : ℝ → κ → ℝ) (dv dw : κ → ℝ)
    (hunit : u ⬝ᵥ u = 1) (hv0 : v 0 = u)
    (hv : ∀ a, HasDerivAt (fun t => v t a) (dv a) 0)
    (hw : ∀ a, HasDerivAt (fun t => w t a) (dw a) 0) (a : κ) :
    HasDerivAt (fun t => rotation u (v t) (w t) a)
      (dw a + (u ⬝ᵥ w 0)*dv a - (dv ⬝ᵥ w 0)*u a) 0 := by
  have hz : ∀ a, HasDerivAt (fun t => (u + v t) a) (dv a) 0 := by
    intro a
    simpa only [zero_add, Pi.add_def] using (hasDerivAt_const 0 (u a)).add (hv a)
  have hn : u + v 0 ≠ 0 := by
    intro he
    have hs : (u + v 0) ⬝ᵥ (u + v 0) = 4 := by
      simp only [hv0, add_dotProduct, dotProduct_add, hunit]
      norm_num
    rw [he, zero_dotProduct] at hs
