/-!
# Elementary fundamental theorem of algebra compatibility

A nonconstant complex polynomial attains a minimum of its norm. Factoring out
the lowest nonzero Taylor power gives a direction that strictly decreases any
positive minimum. This proof uses polynomial continuity and complex nth roots;
it does not use Liouville's theorem or a complex integration theorem.
-/

namespace Source29FTA

open Polynomial
open scoped Topology

/-- A nonzero constant plus a nontrivial lowest power can be made smaller in norm. -/
theorem exists_norm_lt_of_power_factor (a : ℂ) (ha : a ≠ 0)
    (q : Polynomial ℂ) (hq : q.eval 0 ≠ 0) (k : ℕ) (hk : 0 < k) :
    ∃ z : ℂ, ‖a + z ^ k * q.eval z‖ < ‖a‖ := by
  let b : ℂ := (-a / q.eval 0) ^ ((k : ℂ)⁻¹)
  have hb : b ^ k = -a / q.eval 0 := Complex.cpow_nat_inv_pow _ hk.ne'
  let E : ℝ → ℂ := fun t => b ^ k * q.eval ((t : ℂ) * b) + a
  have hE0 : E 0 = 0 := by
    simp [E, hb, hq]
  have hEcont : Continuous E := by
    exact (continuous_const.mul
      (q.continuous.comp (Complex.continuous_ofReal.mul_const b))).add continuous_const
  have haNorm : 0 < ‖a‖ := norm_pos_iff.mpr ha
  obtain ⟨δ, hδ, hbound⟩ := Metric.continuousAt_iff.mp hEcont.continuousAt
    (‖a‖ / 2) (by positivity)
  let t : ℝ := min δ 1 / 2
  have ht0 : 0 < t := by dsimp [t]; positivity
  have htδ : dist t 0 < δ := by
    rw [Real.dist_eq, sub_zero, abs_of_pos ht0]
    have hmin := min_le_left δ (1 : ℝ)
    dsimp [t]
    nlinarith
  have ht1 : t < 1 := by
    have hmin := min_le_right δ (1 : ℝ)
    dsimp [t]
    nlinarith
  have hsmall : ‖E t‖ < ‖a‖ / 2 := by
    simpa only [hE0, dist_zero_right] using hbound htδ
  have htk0 : 0 < t ^ k := pow_pos ht0 _
  have htk1 : t ^ k < 1 := pow_lt_one₀ ht0.le ht1 hk.ne'
  refine ⟨(t : ℂ) * b, ?_⟩
  have heq : a + ((t : ℂ) * b) ^ k * q.eval ((t : ℂ) * b) =
      ((1 - t ^ k : ℝ) : ℂ) * a + ((t ^ k : ℝ) : ℂ) * E t := by
    dsimp [E]
    push_cast
    rw [mul_pow]
    ring
  rw [heq]
  have hnorm : ‖((1 - t ^ k : ℝ) : ℂ) * a + ((t ^ k : ℝ) : ℂ) * E t‖ ≤
      (1 - t ^ k) * ‖a‖ + t ^ k * ‖E t‖ := by
    calc
      _ ≤ ‖((1 - t ^ k : ℝ) : ℂ) * a‖ + ‖((t ^ k : ℝ) : ℂ) * E t‖ :=
        norm_add_le _ _
      _ = _ := by
        simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (sub_nonneg.mpr htk1.le), abs_of_pos htk0]
  have hmul := mul_lt_mul_of_pos_left hsmall htk0
  nlinarith

/-- Every nonconstant complex polynomial has a root, by minimum modulus. -/
theorem exists_root {p : Polynomial ℂ} (hp : 0 < p.degree) :
    ∃ z : ℂ, p.IsRoot z := by
  obtain ⟨z₀, hmin⟩ := p.exists_forall_norm_le
  refine ⟨z₀, ?_⟩
  change p.eval z₀ = 0
  by_contra ha
  let r : Polynomial ℂ := taylor z₀ p - C (p.eval z₀)
  have hrne : r ≠ 0 := by
    intro hz
    have heq : taylor z₀ p = C (p.eval z₀) := sub_eq_zero.mp hz
    have hd := congrArg Polynomial.natDegree heq
    rw [natDegree_taylor, natDegree_C] at hd
    have hp' := natDegree_pos_iff_degree_pos.mpr hp
    omega
  have hr0 : r.IsRoot 0 := by
    simp [r, IsRoot, taylor_eval]
  let k := r.rootMultiplicity 0
  have hk : 0 < k := (rootMultiplicity_pos hrne).mpr hr0
  obtain ⟨q, hfactor, hq⟩ := r.exists_eq_pow_rootMultiplicity_mul_and_not_dvd hrne 0
  have hfactor' : r = X ^ k * q := by simpa [k] using hfactor
  have hq0 : q.eval 0 ≠ 0 := by
    intro hz
    exact hq (dvd_iff_isRoot.mpr hz)
  obtain ⟨z, hz⟩ := exists_norm_lt_of_power_factor (p.eval z₀) ha q hq0 k hk
  have heval : p.eval (z + z₀) = p.eval z₀ + z ^ k * q.eval z := by
    have heq := congrArg (Polynomial.eval z) hfactor'
    simp only [r, eval_sub, taylor_eval, eval_C, eval_mul, eval_pow, eval_X] at heq
    linear_combination heq
  have hmin' := hmin (z + z₀)
  rw [heval] at hmin'
  exact (not_lt_of_ge hmin') hz

/-- Algebraic closedness of ℂ, with all analytical prerequisites proved above. -/
theorem complex_isAlgClosed : IsAlgClosed ℂ :=
  IsAlgClosed.of_exists_root ℂ fun _p _ hp => exists_root (degree_pos_of_irreducible hp)

end Source29FTA

