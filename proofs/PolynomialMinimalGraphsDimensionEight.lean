noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def normalizedHessian (P : MvPolynomial (Option (Option ι)) ℝ)
    (C : ℝ → Ambient ι) (a b : Option (Option ι)) (t : ℝ) : ℝ :=
  jacobiProfile P (C t) * eval (C t) (pderiv a (pderiv b P))

theorem normalizedHessian_symm (P : MvPolynomial (Option (Option ι)) ℝ)
    (C : ℝ → Ambient ι) (a b : Option (Option ι)) :
    normalizedHessian P C a b = normalizedHessian P C b a := by
  unfold normalizedHessian
  rw [second_partial_comm P a b]

theorem secondForm_eq_normalized_bilinear
    (P : MvPolynomial (Option (Option ι)) ℝ) (C : ℝ → Ambient ι) (j k : ι) :
    tangentSecondForm P C j k = fun t =>
      ∑ b, ∑ a, Source29PolynomialTangentFrame.tangentFrame P C j t a *
        normalizedHessian P C a b t * Source29PolynomialTangentFrame.tangentFrame P C k t b := by
  funext t
  simp only [tangentSecondForm, normalizedHessian, Finset.mul_sum,
    Source29QuarticReuse.QuarticMinimal.AmbientQuartic.realHessian_apply]
  apply Finset.sum_congr rfl
  intro b _
  apply Finset.sum_congr rfl
  intro a _
  ring

variable (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)

include hg hgn hgt hC hC0 in
theorem normalizedHessian_analyticAt (a b : Option (Option ι)) :
    AnalyticAt ℝ (normalizedHessian P C a b) 0 := by
  exact ((jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC).mul
      ((analyticAt_eval_real (pderiv a (pderiv b P)) (C 0)).comp hC)

include hg hgn hgt hC0 in
theorem normalizedHessian_zero (a b : Option (Option ι)) :
    normalizedHessian P C a b 0 = hessian P base a b / g := by
  simp only [normalizedHessian, hC0, jacobiProfile_at_base P g hg hgn hgt, hessian]
  ring

include hg hgn hgt hC hC0 in
theorem normalizedHessian_first (i : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (a b : Option (Option ι)) :
    deriv (normalizedHessian P C a b) 0 =
      (third P base (tangent i) a b - w P g i * hessian P base a b) / g := by
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  have hH := (analyticAt_eval_real (pderiv a (pderiv b P)) (C 0)).comp hC
  have he := (hφ.differentiableAt.hasDerivAt.mul hH.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  unfold normalizedHessian
  rw [he, Source29PolynomialProfileFirst.jacobiProfile_tangent_deriv P g hg hgn hgt C hC hC0 i hC1,
    Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv a (pderiv b P))
      (fun c t => C t c) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun c => congrFun hC0 c) hC1, hC0, jacobiProfile_at_base P g hg hgn hgt]
  simp only [third, hessian]
  ring

include hg hgn hgt hC hC0 in
theorem normalizedHessian_second_tangent (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (i : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, acceleration C a = -base a - A P g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (a b : ι) :
    deriv (deriv (normalizedHessian P C (tangent a) (tangent b))) 0 =
      g * A P g a b * deriv (deriv (fun t => jacobiProfile P (C t))) 0 -
        2 * w P g i * S P g i a b + Q P g a b i i -
        ((d : ℝ)-2) * A P g a b - A P g i i * V P g a b := by
  let H := fun t => eval (C t) (pderiv (tangent a) (pderiv (tangent b) P))
  have hH : AnalyticAt ℝ H 0 :=
    (analyticAt_eval_real (pderiv (tangent a) (pderiv (tangent b) P)) (C 0)).comp hC
  have hH0 : H 0 = hessian P base (tangent a) (tangent b) := by simp only [H, hC0, hessian]
  have hH1 : deriv H 0 = third P base (tangent i) (tangent a) (tangent b) :=
    Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv (tangent a) (pderiv (tangent b) P))
      (fun c t => C t c) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun c => congrFun hC0 c) hC1
  have hH2 : deriv (deriv H) 0 =
      eval base (pderiv (tangent i) (pderiv (tangent i) (pderiv (tangent a) (pderiv (tangent b) P)))) -
        ((d : ℝ)-2) * hessian P base (tangent a) (tangent b) -
        A P g i i * third P base none (tangent a) (tangent b) := by
    have he := Source29PolynomialCurveCoordinateJets.coordinate_velocity_second
      (pderiv (tangent a) (pderiv (tangent b) P)) (fun c t => C t c) base (tangent i)
      (analyticAt_pi_iff.mp hC) (fun c => congrFun hC0 c) hC1
    change deriv (deriv H) 0 = _ at he
    rw [he]
    have hr := (Source29HomogeneousHigherRadialJets.radial_coordinate_higher_jets
      P d hP hd (some none) (tangent a) (tangent b)).1
    change eval base (pderiv (some none) (pderiv (tangent a) (pderiv (tangent b) P))) =
      ((d : ℝ)-2) * hessian P base (tangent a) (tangent b) at hr
    have hb : ∀ c, (base : Ambient ι) c = if c = some none then 1 else 0 := by
      intro c
      simp [base, Pi.single_apply]
    change _ + (∑ c, eval base (pderiv c (pderiv (tangent a) (pderiv (tangent b) P))) *
      acceleration C c) = _
    simp only [hC2, hb, Pi.single_apply, mul_sub, mul_neg, mul_ite, mul_one, mul_zero,
      Finset.sum_sub_distrib, Finset.sum_neg_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq,
      Finset.mem_univ, if_true, hr, third]
    ring
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  change deriv (deriv (fun t => jacobiProfile P (C t) * H t)) 0 = _
  rw [Source29AnalyticInverseNorm.second_deriv_product (fun t => jacobiProfile P (C t)) H hφ hH,
    hH0, hH1, hH2,
    Source29PolynomialProfileFirst.jacobiProfile_tangent_deriv P g hg hgn hgt C hC hC0 i hC1,
    hC0, jacobiProfile_at_base P g hg hgn hgt]
  simp only [A, S, V, Q, hessian, third, second_partial_comm]
  field_simp
  ring

end
end Source29NormalizedHessianCurve

/- Component: NormalizedHessianBlocks.inc -/
