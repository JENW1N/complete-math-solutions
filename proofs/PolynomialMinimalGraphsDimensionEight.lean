noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def frameLaplacian (P : MvPolynomial (Option (Option ι)) ℝ)
    (C : ι → ℝ → Ambient ι) (a b : ι) : ℝ :=
  ∑ i, acceleration (tangentFrame P (C i) a) (tangent b)

theorem frameLaplacian_symmetric_part
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (a b : ι) :
    frameLaplacian P C a b + frameLaplacian P C b a =
      -2 * ((if a=b then 1 else 0) + matrixSquare (A P g) a b) := by
  unfold frameLaplacian
  rw [← Finset.sum_add_distrib]
  simp_rw [Source29PolynomialTangentFrameSecond.tangentFrame_second_symmetric
    P d hP g hg hgn hgt (C _) (hC _) (hC0 _) (hmem _) _ a b (hC1 _)]
  rw [← Finset.mul_sum, Finset.sum_add_distrib]
  congr 1
  congr 1
  · simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  · unfold matrixSquare
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm P g i a]

end
end Source29FrameLaplacian

/- Component: MovingSecondFormTrace.inc -/
namespace Source29MovingSecondFormTrace

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29PolynomialMovingCurvature Source29PolynomialJacobiCurves
open Source29AnalyticDotSecond Source29SimonsJetCorrection Source29NormalizedHessianCurve
open Source29FrameLaplacian
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem secondForm_trace_with_frameLaplacian
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g) (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a - A P g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (K : ℝ)
    (hJac : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
      (K+((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))*g⁻¹ = 0)
    (a b : ι) :
    (∑ i, deriv (deriv (tangentSecondForm P (C i) a b)) 0) =
      ((Fintype.card ι : ℝ)+2-K)*A P g a b + 2*matrixCube (A P g) b a +
      (∑ l, frameLaplacian P C a l * A P g l b) +
      (∑ l, frameLaplacian P C b l * A P g l a) := by
  have hG : ∀ j k, (∑ i, ∑ l, acceleration (tangentFrame P (C i) j) (tangent l) * A P g l k) =
      ∑ l, frameLaplacian P C j l * A P g l k := by
    intro j k
    rw [Finset.sum_comm]
    simp only [frameLaplacian, Finset.sum_mul]
  have hN : ∀ j, (∑ i, acceleration (tangentFrame P (C i) j) none) = 0 := fun j =>
    Source29PolynomialFrameNormalAcceleration.tangentFrame_normal_acceleration_trace
      P d hP hd g hg hL hgn hgt C hC hC0 hmem hC1 hC2 j
  have hsq : (∑ i, A P g i a * A P g i b) = matrixSquare (A P g) a b := by
    unfold matrixSquare
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm P g i a]
  have hab := A_symm P g b a
  have hwa : (∑ i, w P g i * A P g i a) = ∑ i, A P g a i * w P g i := by
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm P g i a]
    ring
  have hwb : (∑ i, w P g i * A P g i b) = ∑ i, A P g b i * w P g i := by
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm P g i b]
    ring
  simp_rw [Source29MovingSecondFormJets.secondForm_second_deriv P d hP hd g hg hgn hgt
    (C _) (hC _) (hC0 _) (hmem _) _ a b (hC1 _)]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, hG,
    ← Finset.sum_mul, hN, zero_mul, add_zero]
  rw [Source29NormalizedHessianTrace.normalizedHessian_second_trace_reduced P d hP hd
    g hg hL hgn hgt C hC hC0 hC1 hC2 K (((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) hJac]
  simp only [mul_add, mul_assoc, Finset.sum_add_distrib, ← Finset.mul_sum,
    ← Finset.sum_mul, ite_mul, one_mul, zero_mul, mul_ite, mul_one,
    Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true, hsq, hwa, hwb, hab]
  ring_nf
  simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true, mul_assoc,
    ← Finset.mul_sum, hwa, hwb, hab]
  ring

end
end Source29MovingSecondFormTrace

/- Component: FrameContractionAlgebra.inc -/
namespace Source29FrameContractionAlgebra

open Source29SimonsJetCorrection Source29GaussSimonsAlgebra
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem left_contraction (A G : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a) :
    (∑ a, ∑ b, A a b * (∑ l, G a l * A l b)) =
      ∑ a, ∑ l, matrixSquare A a l * G a l := by
  simp only [matrixSquare, Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro l _
  apply Finset.sum_congr rfl
  intro b _
  rw [hA l b]
  ring

theorem right_contraction (A G : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a) :
    (∑ a, ∑ b, A a b * (∑ l, G b l * A l a)) =
      ∑ a, ∑ l, matrixSquare A a l * G a l := by
  rw [← left_contraction A G hA, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  rw [hA b a]

theorem cube_contraction (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a) :
    (∑ a, ∑ b, A a b * matrixCube A b a) =
      ∑ a, ∑ b, (matrixSquare A a b)^2 := by
  have hs : ∀ b l, (∑ a, A a b * A l a) = matrixSquare A b l := by
    intro b l
    unfold matrixSquare
    apply Finset.sum_congr rfl
    intro a _
    rw [hA a b, hA l a]
  calc
    _ = ∑ b, ∑ l, matrixSquare A b l * (∑ a, A a b * A l a) := by
      simp only [matrixCube, Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro b _
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro l _
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = _ := by simp only [hs, pow_two]

theorem trace_square (A : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a) :
    (∑ a, matrixSquare A a a) = normSq A := by
  simp only [matrixSquare, normSq]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  rw [hA b a, pow_two]

theorem frame_contraction (A G : ι → ι → ℝ) (hA : ∀ a b, A a b = A b a)
    (hG : ∀ a b, G a b + G b a = -2*((if a=b then 1 else 0) + matrixSquare A a b)) :
    (∑ a, ∑ b, matrixSquare A a b * G a b) =
      -normSq A - (∑ a, ∑ b, (matrixSquare A a b)^2) := by
  have he := Source29SymmetricFrameContraction.contract_of_symmetric_part
    (matrixSquare A) G (fun a b => (if a=b then 1 else 0) + matrixSquare A a b)
    (matrixSquare_symm A hA) hG
  rw [he]
  simp only [mul_add, Finset.sum_add_distrib, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq, Finset.mem_univ, if_true, ← pow_two, trace_square A hA]
  ring

/-- The unknown skew part of the actual frame Laplacian cancels from the
second-form contraction, leaving the scalar Simons right-hand side. -/
theorem contracted_trace (A G T : ι → ι → ℝ) (m K : ℝ)
    (hA : ∀ a b, A a b = A b a)
    (hG : ∀ a b, G a b + G b a = -2*((if a=b then 1 else 0) + matrixSquare A a b))
    (hT : ∀ a b, T a b = (m+2-K)*A a b + 2*matrixCube A b a +
      (∑ l, G a l * A l b) + (∑ l, G b l * A l a)) :
    (∑ a, ∑ b, A a b * T a b) = (m-K)*normSq A := by
  have hscale : (∑ a, ∑ b, A a b * ((m+2-K)*A a b)) = (m+2-K)*normSq A := by
    simp only [normSq, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    apply Finset.sum_congr rfl
    intro b _
    ring
  have hcube : (∑ a, ∑ b, A a b * (2*matrixCube A b a)) =
      2 * (∑ a, ∑ b, (matrixSquare A a b)^2) := by
    rw [← cube_contraction A hA]
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    apply Finset.sum_congr rfl
    intro b _
    ring
  simp_rw [hT]
  simp only [mul_add, Finset.sum_add_distrib]
  rw [hscale, hcube, left_contraction A G hA, right_contraction A G hA, frame_contraction A G hA hG]
  ring

end
end Source29FrameContractionAlgebra

