/- Component: ContractedSimonsNorm.inc -/
namespace Source29ContractedSimonsNorm

open Filter
open scoped BigOperators Topology

noncomputable section

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- The scalar estimate needs only the contraction of the tensor equation.
This permits changes of orthonormal frame whose extra derivative terms are
orthogonal to the tensor. -/
theorem scalar_simons_of_contraction
    (A : κ → ℝ) (dA ddA : ι → κ → ℝ) (dh ddh : ι → ℝ) (h m : ℝ)
    (hh : 0 < h) (hnorm : h^2 = ∑ j, A j^2)
    (hfirst : ∀ i, h * dh i = ∑ j, A j * dA i j)
    (hsecond : ∀ i, h * ddh i + (dh i)^2 =
      (∑ j, (dA i j)^2) + ∑ j, A j * ddA i j)
    (hcontract : (∑ i, ∑ j, A j * ddA i j) = (m - h^2)*h^2) :
    (m - h^2) * h ≤ ∑ i, ddh i := by
  have hk : (∑ i, (dh i)^2) ≤ ∑ i, ∑ j, (dA i j)^2 := by
    apply Finset.sum_le_sum
    intro i _
    exact Source29SimonsNormAlgebra.norm_derivative_sq_le A (dA i) h (dh i) hh hnorm (hfirst i)
  have heq : h * (∑ i, ddh i) + (∑ i, (dh i)^2) =
      (∑ i, ∑ j, (dA i j)^2) + (m - h^2) * h^2 := by
    have hs := Finset.sum_congr (s₁ := Finset.univ) rfl (fun i _ => hsecond i)
    simpa only [Finset.sum_add_distrib, ← Finset.mul_sum, hcontract] using hs
  apply (mul_le_mul_iff_right₀ hh).mp
  nlinarith

theorem scalar_simons_for_analytic_components
    (A : ι → κ → ℝ → ℝ) (h : ι → ℝ → ℝ) (A0 : κ → ℝ) (h0 m : ℝ)
    (hh : ∀ i, AnalyticAt ℝ (h i) 0)
    (hA : ∀ i j, AnalyticAt ℝ (A i j) 0)
    (hh0 : ∀ i, h i 0 = h0) (hA0 : ∀ i j, A i j 0 = A0 j)
    (hpos : 0 < h0) (hzero : h0^2 = ∑ j, (A0 j)^2)
    (hnorm : ∀ i, (fun t => (h i t)^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => ∑ j, (A i j t)^2))
    (hcontract : (∑ i, ∑ j, A0 j * deriv (deriv (A i j)) 0) = (m - h0^2)*h0^2) :
    (m - h0^2) * h0 ≤ ∑ i, deriv (deriv (h i)) 0 := by
  apply scalar_simons_of_contraction A0
    (fun i j => deriv (A i j) 0) (fun i j => deriv (deriv (A i j)) 0)
    (fun i => deriv (h i) 0) (fun i => deriv (deriv (h i)) 0) h0 m hpos hzero
  · intro i
    simpa only [hh0, hA0] using
      (Source29AnalyticNormDerivatives.norm_first_second (h i) (A i) (hh i) (hA i) (hnorm i)).1
  · intro i
    simpa only [hh0, hA0] using
      (Source29AnalyticNormDerivatives.norm_first_second (h i) (A i) (hh i) (hA i) (hnorm i)).2
  · exact hcontract

end
end Source29ContractedSimonsNorm

/- Component: AnalyticReflection.inc -/
namespace Source29AnalyticReflection

open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def reflect (u v : κ → ℝ) : κ → ℝ :=
  WithLp.ofLp ((ℝ ∙ (WithLp.toLp 2 u : EuclideanSpace ℝ κ)).reflection (WithLp.toLp 2 v))

theorem norm_sq_toLp (u : κ → ℝ) : ‖(WithLp.toLp 2 u : EuclideanSpace ℝ κ)‖^2 = u ⬝ᵥ u := by
  simpa only [dotProduct, pow_two] using EuclideanSpace.real_norm_sq_eq (WithLp.toLp 2 u)

theorem reflect_apply (u v : κ → ℝ) (a : κ) :
    reflect u v a = 2 * ((u ⬝ᵥ v) / (u ⬝ᵥ u)) * u a - v a := by
  simp [reflect, Submodule.reflection_singleton_apply, norm_sq_toLp,
    PiLp.inner_apply, RCLike.inner_apply, dotProduct, mul_comm] <;> ring

theorem reflect_dot (u v w : κ → ℝ) : reflect u v ⬝ᵥ reflect u w = v ⬝ᵥ w := by
  have he := (ℝ ∙ (WithLp.toLp 2 u : EuclideanSpace ℝ κ)).reflection.inner_map_map
    (WithLp.toLp 2 v) (WithLp.toLp 2 w)
  simpa only [reflect, dotProduct, PiLp.inner_apply, RCLike.inner_apply, conj_trivial, mul_comm] using he

theorem reflect_involutive (u v : κ → ℝ) : reflect u (reflect u v) = v := by
  exact congrArg WithLp.ofLp (Submodule.reflection_reflection
    (ℝ ∙ (WithLp.toLp 2 u : EuclideanSpace ℝ κ)) (WithLp.toLp 2 v))

theorem reflect_self (u : κ → ℝ) : reflect u u = u := by
  unfold reflect
  rw [Submodule.reflection_mem_subspace_eq_self (Submodule.mem_span_singleton_self _)]

theorem reflect_smul (u v : κ → ℝ) (c : ℝ) (hc : c ≠ 0) : reflect (c • u) v = reflect u v := by
  change WithLp.ofLp ((ℝ ∙ (c • WithLp.toLp 2 u : EuclideanSpace ℝ κ)).reflection (WithLp.toLp 2 v)) = _
  simp only [Submodule.span_singleton_smul_eq (isUnit_iff_ne_zero.mpr hc)]
  rfl

theorem reflect_orthogonal (u v : κ → ℝ) (h : u ⬝ᵥ v = 0) : reflect u v = -v := by
  funext a
  simp only [reflect_apply, h, zero_div, mul_zero, zero_mul, zero_sub, Pi.neg_apply]

theorem reflect_sum (u v : κ → ℝ) (h : u ⬝ᵥ u = v ⬝ᵥ v) : reflect (u+v) u = v := by
  have hn : ‖(WithLp.toLp 2 u : EuclideanSpace ℝ κ)‖ = ‖(WithLp.toLp 2 v : EuclideanSpace ℝ κ)‖ := by
    have hs : ‖(WithLp.toLp 2 u : EuclideanSpace ℝ κ)‖^2 = ‖(WithLp.toLp 2 v : EuclideanSpace ℝ κ)‖^2 := by
      simpa only [norm_sq_toLp] using h
    nlinarith [norm_nonneg (WithLp.toLp 2 u : EuclideanSpace ℝ κ), norm_nonneg (WithLp.toLp 2 v : EuclideanSpace ℝ κ)]
  have he := Submodule.reflection_sub (v := (WithLp.toLp 2 u : EuclideanSpace ℝ κ))
    (w := -(WithLp.toLp 2 v : EuclideanSpace ℝ κ)) (by simpa using hn)
  rw [sub_neg_eq_add, Submodule.reflection_orthogonal_apply] at he
  have he' := neg_injective he
  exact congrArg WithLp.ofLp he'

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem reflect_analyticAt (u v : E → κ → ℝ) (x : E)
    (hu : ∀ a, AnalyticAt ℝ (fun y => u y a) x)
    (hv : ∀ a, AnalyticAt ℝ (fun y => v y a) x) (hne : u x ≠ 0) :
    AnalyticAt ℝ (fun y => reflect (u y) (v y)) x := by
  have hs := Source29CurvaturePotentialAnalytic.vectorSq_analytic u x hu
  have hn := (Source29CurvaturePotentialAnalytic.vectorSq_pos (u x) hne).ne'
  have hp : AnalyticAt ℝ (fun y => u y ⬝ᵥ v y) x :=
    Source29CurvaturePotentialAnalytic.analytic_sum (fun a y => u y a * v y a) x
      (fun a => (hu a).mul (hv a))
  apply AnalyticAt.pi
  intro a
  simp only [reflect_apply]
  exact ((analyticAt_const.mul (hp.div hs hn)).mul (hu a)).sub (hv a)

end
end Source29AnalyticReflection

/- Component: AnalyticPairRotation.inc -/
namespace Source29AnalyticPairRotation

open Source29AnalyticReflection
