  ∫ t in (0 : ℝ)..2, baseIntegrand f x t i

theorem radius_nonneg (x : Fin n → ℝ) (t : ℝ) : 0 ≤ (∑ j, x j ^ 2) + t^2 :=
  add_nonneg (Finset.sum_nonneg (fun j _ ↦ sq_nonneg _)) (sq_nonneg _)

theorem radialTest_zero_large {f : ℝ → ℝ} (hz : ∀ s, 2 ≤ s → f s = 0)
    (x : Fin n → ℝ) {t : ℝ} (ht : 2 ≤ |t|) : radialTest f (x,t) = 0 := by
  apply hz
  have hs : 0 ≤ ∑ j, x j ^ 2 := Finset.sum_nonneg (fun j _ ↦ sq_nonneg _)
  have he := sq_abs t
  nlinarith [sq_nonneg (|t|-2)]

