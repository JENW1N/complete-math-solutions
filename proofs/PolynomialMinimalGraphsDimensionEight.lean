noncomputable section

theorem initial_is_normal_power {n : ℕ}
    (h : MvPolynomial (Fin n) ℂ) (z : CSpace n) (s : ℕ)
    (hs : s ≤ (translate h (fun i => z i)).totalDegree)
    (hlow : ∀ k < s, homogeneousComponent k (translate h (fun i => z i)) = 0)
    (hne : homogeneousComponent s (translate h (fun i => z i)) ≠ 0)
    (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hzunit : ‖z‖ = 1)
    (hzq : (∑ i : Fin n, (z i)^2) = (κ : ℂ))
    (hbound : ∀ w : CSpace n, eval (fun i => w i) h = 0 →
      quadricNorm w ≤ κ * ‖w‖^2) :
    ∃ a : ℂ, a ≠ 0 ∧
      homogeneousComponent s (translate h (fun i => z i)) =
        C a * (Source29LinearForm.linearForm
          (fun i => z i - (κ : ℂ) * star (z i))) ^ s := by
  letI : IsAlgClosed ℂ := Source29FTA.complex_isAlgClosed
  let N : Fin n → ℂ := fun i => z i - (κ : ℂ) * star (z i)
  have hq : Source29NormalCoordinates.dot (fun i => z i) (fun i => z i) = κ := by
    simpa only [Source29NormalCoordinates.dot, pow_two] using hzq
  have hnorm := Source29NormalCoordinates.hermitian_dot_eq_one z hzunit
  have hN : Source29NormalCoordinates.dot N N ≠ 0 :=
    Source29NormalCoordinates.normal_square_ne_zero (fun i => z i) κ hk hk1 hq hnorm
  have hNsome : ∃ i, N i ≠ 0 := by
    by_contra hnone
    push Not at hnone
    exact hN (by simp [Source29NormalCoordinates.dot, hnone])
  apply Source29HyperplanePower.eq_C_mul_degree_pow_of_zero_set_subset
    _ _ s (homogeneousComponent_isHomogeneous _ _) hne
    (Source29LinearForm.linearForm_irreducible N hNsome)
    (Source29LinearForm.linearForm_totalDegree N hNsome)
  intro x hx
  rw [Source29LinearForm.eval_linearForm]
  exact Source29InitialTangent.initial_zero_in_normal_hyperplane
    h z s hs hlow hne κ hk hzunit hzq hbound (WithLp.toLp 2 x) hx

/-- The complete initial-form conclusion needs only a nonzero polynomial and
a normalized maximum. No smoothness assumption on that point is made. -/
theorem exists_normal_power_initial {n : ℕ}
    (h : MvPolynomial (Fin n) ℂ) (hne : h ≠ 0) (z : CSpace n)
    (hzero : eval (fun i => z i) h = 0)
    (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hzunit : ‖z‖ = 1)
    (hzq : (∑ i : Fin n, (z i)^2) = (κ : ℂ))
    (hbound : ∀ w : CSpace n, eval (fun i => w i) h = 0 →
      quadricNorm w ≤ κ * ‖w‖^2) :
    ∃ (s : ℕ) (a : ℂ),
      0 < s ∧ s ≤ (translate h (fun i => z i)).totalDegree ∧ a ≠ 0 ∧
      (∀ k < s, homogeneousComponent k (translate h (fun i => z i)) = 0) ∧
      homogeneousComponent s (translate h (fun i => z i)) =
        C a * (Source29LinearForm.linearForm
          (fun i => z i - (κ : ℂ) * star (z i))) ^ s := by
  obtain ⟨s, hspos, hsdegree, hsne, hlow⟩ :=
    exists_lowest_component_at_root h hne (fun i => z i) hzero
  obtain ⟨a, ha, hform⟩ := initial_is_normal_power
    h z s hsdegree hlow hsne κ hk hk1 hzunit hzq hbound
  exact ⟨s, a, hspos, hsdegree, ha, hlow, hform⟩

end
