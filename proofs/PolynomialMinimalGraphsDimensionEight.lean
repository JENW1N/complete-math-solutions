    nlinarith [sq_nonneg t]
  have hxi : ‖x i‖ ≤ 2 := by
    rw [Real.norm_eq_abs, abs_le]
    constructor <;> nlinarith
  calc
    ‖baseIntegrand f x t i‖ = 2 * ‖x i‖ * ‖deriv f ((∑ j, x j ^ 2) + t^2)‖ := by
      unfold baseIntegrand
      rw [norm_mul, norm_mul]
      norm_num
    _ ≤ 2 * 2 * max M 0 := by
      gcongr
      exact hbound.trans (le_max_left _ _)
    _ = 4 * max M 0 := by ring

theorem exists_baseDerivative_bound {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (hz : ∀ s, 2 ≤ s → deriv f s = 0) :
    ∃ M : ℝ, ∀ (x : Fin n → ℝ) z i, ‖baseDerivative (primitive f) x z i‖ ≤ M := by
  obtain ⟨M,hM⟩ := exists_baseIntegrand_bound (n := n) hf hz
  refine ⟨2*M, ?_⟩
  intro x z i
  rw [primitive_baseDerivative hf]
  exact integral_norm_le (baseIntegrand_continuous hf x i) (baseIntegrand_even f x i)
    (fun t ht ↦ baseIntegrand_zero_large hz x i ht) (fun t ↦ hM x t i) z

end
