def movingCurvatureNorm (f : Ambient ι → ℝ) (C : ℝ → Ambient ι) (t : ℝ) : ℝ :=
  tensorNorm (fun j : ι × ι => tangentSecondForm f C j.1 j.2 t)

/-- The scalar Simons inequality for the actual norm of the moving second
fundamental form. Both Jacobi and all frame derivatives are derived. -/
theorem scalar_simons_for_link_curves
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), f (C i t) = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a -
      A f g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (hpos : 0 < normSq (A f g)) :
    ((Fintype.card ι : ℝ)-normSq (A f g)) * Real.sqrt (normSq (A f g)) ≤
      ∑ i, deriv (deriv (movingCurvatureNorm f (C i))) 0 := by
  have hJac := Source29AnalyticLinkJacobi.jacobi_of_homogeneous_link_curve_jets
    f D g hg U hU hx hcone hf hhom hL hgn hgt
    (fun i a t => C i t a) (fun i => analyticAt_pi_iff.mp (hC i))
    (fun i a => congrFun (hC0 i) a) hC1 hC2
  have hK : (∑ i, ∑ j, (hess f base (some (some j)) (some (some i)))^2)/g^2 =
      normSq (A f g) := by
    simp only [normSq, A, tangent, div_pow, Finset.sum_div]
    rw [Finset.sum_comm]
  rw [hK] at hJac
  change (∑ i, deriv (deriv (fun t => profile f (C i t))) 0) +
    (normSq (A f g)+(D-1)*(D-(Fintype.card ι : ℝ)))*g⁻¹ = 0 at hJac
  let AA : ι → ι × ι → ℝ → ℝ := fun i j => tangentSecondForm f (C i) j.1 j.2
  let A0 : ι × ι → ℝ := fun j => A f g j.1 j.2
  have hAA : ∀ i j, AnalyticAt ℝ (AA i j) 0 := by
    intro i j
