variable {n : ℕ}

theorem radialPhaseFlux_eq_twice_of_zeroFlux (Q : MvPolynomial (Fin (n+1)) ℝ) (hQ : Q ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (hi : Integrable (testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField Q)))
    (hz : (∫ x, testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField Q) x) = 0) :
    radialPhaseFlux Q f = 2 * phaseMass Q (endpoint f) := by
  let W := testFlux (fun i ↦ Pi.single i 1) (endpoint f) (leadingNormalizedField Q)
  have hw : Integrable W := hi
  have hweighted := Source29PhaseApproximation.phase_weight_integrable Q hQ W hw
  have he (x : Fin (n+1) → ℝ) :
      (∑ i, (if 0 < eval x Q then baseEndpoint f x i else -baseEndpoint f x i) * leadingNormalizedField Q x i) =
      2 * (W x * (if 0 < eval x Q then 1 else 0)) - W x := by
    unfold W testFlux
    simp only [endpoint_fderiv hf]
    by_cases hp : 0 < eval x Q
    · simp only [ite_eq_left hp, mul_one]
      ring
    · simp only [ite_eq_right hp, neg_mul, Finset.sum_neg_distrib, mul_zero]
      ring
  have hs : (∫ x, 2 * (W x * (if 0 < eval x Q then 1 else 0)) - W x) =
      (∫ x, 2 * (W x * (if 0 < eval x Q then 1 else 0))) - ∫ x, W x :=
    integral_sub (hweighted.const_mul 2) hw
  unfold radialPhaseFlux
  simp_rw [he]
  rw [hs, integral_const_mul]
  have hzero : (∫ x, W x) = 0 := hz
  rw [hzero]
  change -(2 * (∫ x, W x * (if 0 < eval x Q then 1 else 0)) - 0) =
    2 * (-(∫ x, W x * (if 0 < eval x Q then 1 else 0)))
  ring

theorem linear_flux_zero (a : Fin (n+1) → ℝ) {ρ : (Fin (n+1) → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hc : HasCompactSupport ρ) :
    (∫ x, testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField (linearForm a)) x) = 0 := by
  have hn : leadingNormalizedField (linearForm a) = fun _ ↦ unitVector a := by
    funext x
    exact normalizedField_linearForm a x
  rw [hn]
  apply integral_testFlux_eq_zero (μ := volume) (fun i ↦ Pi.single i 1) hρ hc
  · intro i
    exact contDiff_const
  · intro x
    simp [divergence]

theorem radialPhaseFlux_linearForm (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hz : ∀ s, 2 ≤ s → f s = 0) :
    radialPhaseFlux (linearForm a) f = planeMass (n+1) f := by
  rw [radialPhaseFlux_eq_twice_of_zeroFlux (linearForm a) (linearForm_ne_zero_of_vector a ha) hf
    (linear_flux_integrable a (endpoint_contDiff hf) (endpoint_compact hz))
    (linear_flux_zero a (endpoint_contDiff hf) (endpoint_compact hz))]
  exact twice_linear_phaseMass a ha hf hz

theorem radialPhaseFlux_odd_linear_power (a : Fin (n+1) → ℝ) (ha : a ≠ 0)
    {c : ℝ} (hc : c ≠ 0) {k : ℕ} (hk : Odd k)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hz : ∀ s, 2 ≤ s → f s = 0) :
