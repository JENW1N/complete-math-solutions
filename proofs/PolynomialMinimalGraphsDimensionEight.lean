    simp only [changeVariables, aeval_C, algebraMap_eq, mul_pow, map_pow, map_mul,
      mul_assoc]

end
end Source29LinearInitialPhaseChart


/- Final component: RadialPhaseChartInduction -/
namespace Source29RadialPhaseChartInduction

open MvPolynomial Matrix
open Source29LinearForm Source29QuarticReuse.QuarticMinimal
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29GeometricPhaseChart Source29PolynomialTranslation

noncomputable section
variable {n : ℕ}

/-- The classification required at the preceding induction dimension. -/
def LinearRigidity (n : ℕ) : Prop :=
  ∀ (R : MvPolynomial (Fin n) ℝ) (d : ℕ), R.IsHomogeneous d → 0 < d → R ≠ 0 →
    leadingOperator R = 0 → WeakCalibration (leadingNormalizedField R) →
    ∃ (c : ℝ) (b : Fin n → ℝ), c ≠ 0 ∧ b ≠ 0 ∧ Odd d ∧
      R = C c * (linearForm b)^d

/-- Reversing the radial rotation lifts a pure linear power to a pure linear
power in the original ambient space. -/
theorem linear_power_of_reduction (P : MvPolynomial (Fin (n+1)) ℝ)
    (hP : P ≠ 0) (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U * U.transpose = 1) (R : MvPolynomial (Fin n) ℝ)
    (hrot : changeVariables U P = rename Fin.succ R)
    (b : Fin n → ℝ) (c : ℝ) (d : ℕ) (hd : 0 < d)
    (hR : R = C c * (linearForm b)^d) :
    ∃ a : Fin (n+1) → ℝ, a ≠ 0 ∧ P = C c * (linearForm a)^d := by
  let L := changeVariables U.transpose (rename Fin.succ (linearForm b))
  have hL : L.IsHomogeneous 1 := isHomogeneous_changeVariables U.transpose _ 1
    (linearForm_isHomogeneous b).rename_isHomogeneous
  have hback : P = C c * L^d := by
    have he := congrArg (changeVariables U.transpose) hrot
    rw [changeVariables_comp, hU, changeVariables_one, hR] at he
    simpa only [L, map_mul, map_pow, rename_C, changeVariables, aeval_C, algebraMap_eq]
      using he
  have hlin : L = linearForm (evaluatedGradient L 0) := by
    rw [← Source29RegularPhaseDensity.homogeneousComponent_one_eq_linearForm,
      homogeneousComponent_eq_self hL]
  refine ⟨evaluatedGradient L 0, ?_, ?_⟩
  · intro hz
    have hLzero : L = 0 := by rw [hlin, hz]; simp [linearForm]
    apply hP
    rw [hback, hLzero, zero_pow (Nat.ne_of_gt hd), mul_zero]
  · rwa [hlin] at hback

/-- Lower-dimensional calibrated homogeneous rigidity gives an actual flat
minimal phase chart at every nonvertex zero in the next dimension. -/
theorem phase_chart_at_nonzero_zero
    (hIH : LinearRigidity n)
    (F : MvPolynomial (Fin (n+1)) ℝ) (D : ℕ) (hhom : F.IsHomogeneous D)
    (hne : F ≠ 0) (hF : leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (p : Fin (n+1) → ℝ) (hp : p ≠ 0) (hzero : eval p F = 0) :
    HasFlatMinimalPhaseChart F p := by
  obtain ⟨d,hd,_,hinit,hlow⟩ := exists_lowest_component_at_root F hne p hzero
  obtain ⟨s,rfl⟩ : ∃ s, d = s+1 := ⟨d-1, by omega⟩
  obtain ⟨U,R,hUt,hU,hrot,hRne,hRhom,hRL⟩ :=
    Source29RadialCoordinateReduction.initial_orthogonal_reduction F D hhom p hp s
      (hlow s (by omega)) hinit
  have hL := Source29InitialLeadingOperator.leadingOperator_initial_at F hF p (s+1) hlow
  have htranslate : WeakCalibration (leadingNormalizedField (translate F p)) := by
    simpa only [map_zero, sub_zero] using
      Source29TranslatedCalibration.polynomial_translated_level_weakCalibration F hcal 0 p
  have hcalinit := Source29InitialWeakCalibration.initial_weakCalibration
    (translate F p) htranslate s hlow hinit
  have hcalrot := Source29OrthogonalCalibration.weakCalibration_changeVariables U hU _ hcalinit
  rw [hrot] at hcalrot
  have hcalR := Source29CalibrationCoordinateDescent.weakCalibration_rename_succ R hcalrot
  obtain ⟨c,b,hc,_,hodd,hRform⟩ := hIH R (s+1) hRhom hd hRne (hRL hL) hcalR
  obtain ⟨a,ha,hform⟩ := linear_power_of_reduction _ hinit U hU R hrot b c (s+1) hd hRform
  exact Source29LinearInitialPhaseChart.phase_chart_of_linear_initial
    F hF p a ha c hc (s+1) hodd hlow hform

/-- The induction has a proved one-dimensional starting point. -/
theorem linearRigidity_one : LinearRigidity 1 := by
  intro R d hR hd hne _ hcal
  exact Source29HomogeneousOneDimension.exists_odd_linear_power R d hR hd hne hcal

/-- In ambient dimension two, every nonzero zero already has an analytic
minimal phase chart; no separate geometric regularity hypothesis is needed. -/
theorem phase_chart_dimension_two
    (F : MvPolynomial (Fin 2) ℝ) (D : ℕ) (hhom : F.IsHomogeneous D)
    (hne : F ≠ 0) (hF : leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (p : Fin 2 → ℝ) (hp : p ≠ 0) (hzero : eval p F = 0) :
    HasFlatMinimalPhaseChart F p :=
  phase_chart_at_nonzero_zero linearRigidity_one F D hhom hne hF hcal p hp hzero

end
end Source29RadialPhaseChartInduction


/- Final component: HomogeneousTwoDimension -/
namespace Source29HomogeneousTwoDimension

open MvPolynomial Matrix Filter
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticNormalization
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits Source29NewtonNormalDerivative
open Source29LinearForm Source29RadialPhaseChartInduction Source29GeometricPhaseChart
open scoped Topology BigOperators

noncomputable section

/-- In two variables the full cubic operator is exactly the Newton residual. -/
theorem leadingOperator_eq_newtonResidual (P : MvPolynomial (Fin 2) ℝ) :
    leadingOperator P = newtonResidual P := by
  simp only [leadingOperator, laplacian, newtonResidual, tangentialLaplacian,
    tangentialMixed, tangentialEnergy, Fin.sum_univ_two, Fin.sum_univ_one]
  simp only [show (0 : Fin 1).succ = (1 : Fin 2) from rfl]
  rw [second_partial_comm P (0 : Fin 2) 1]
  ring

/-- The slice x₁=1 determines a homogeneous polynomial in two variables. -/
theorem eq_zero_of_slice_one (P : MvPolynomial (Fin 2) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hslice : sliceHom (fun _ : Fin 1 => 1) P = 0) : P = 0 := by
  apply Source29LocalHyperplaneDivisor.polynomial_eq_zero_of_locally_zero P (fun _ => 1)
  have hne : ∀ᶠ x : Fin 2 → ℝ in 𝓝 (fun _ => 1), x 1 ≠ 0 :=
    (continuous_apply 1).continuousAt.eventually_ne (by norm_num)
  filter_upwards [hne] with x hx
  have hs : eval (Fin.cons (x 0 / x 1) (fun _ : Fin 1 => 1)) P = 0 := by
    rw [← eval_sliceHom, hslice, Polynomial.eval_zero]
  have he : x = x 1 • Fin.cons (x 0 / x 1) (fun _ : Fin 1 => 1) := by
    funext i
    fin_cases i
    · change x 0 = x 1 * (x 0 / x 1)
      field_simp
    · simp
  rw [he, eval_dilate_homogeneous P hP, hs, mul_zero]

/-- The cubic equation forces a homogeneous polynomial to be independent of
x₀ if its x₀ derivative vanishes, and its x₁ derivative does not, at (0,1). -/
theorem pderiv_zero_of_axis_critical (P : MvPolynomial (Fin 2) ℝ) (s : ℕ)
    (hP : P.IsHomogeneous (s+1)) (hL : leadingOperator P = 0)
    (hzero : eval (Pi.single (1 : Fin 2) 1) (pderiv 0 P) = 0)
    (htrans : eval (Pi.single (1 : Fin 2) 1) (pderiv 1 P) ≠ 0) :
    pderiv 0 P = 0 := by
  have haxis : (Fin.cons 0 (fun _ : Fin 1 => (1 : ℝ)) : Fin 2 → ℝ) = Pi.single (1 : Fin 2) 1 := by
    funext i
    fin_cases i <;> norm_num [Pi.single_apply]
  have hE : newtonResidual P = 0 := by rwa [← leadingOperator_eq_newtonResidual]
  have hA : (sliceHom (fun _ : Fin 1 => 1) (tangentialEnergy P)).eval 0 ≠ 0 := by
    rw [eval_sliceHom, haxis]
    simpa only [tangentialEnergy, Fin.sum_univ_one, map_pow,
      show (0 : Fin 1).succ = (1 : Fin 2) from rfl] using pow_ne_zero 2 htrans
  have hq : sliceHom (fun _ : Fin 1 => 1) (pderiv 0 P) = 0 := by
    by_contra hq
    have hno := Source29PolynomialOdeNonvanishing.eval_ne_zero_of_derivative_mul_eq
      (sliceHom (fun _ : Fin 1 => 1) (tangentialEnergy P))
      (sliceHom (fun _ : Fin 1 => 1) (normalDrift P))
      (sliceHom (fun _ : Fin 1 => 1) (pderiv 0 P)) 0 hq hA
      (slice_derivative_ode P hE (fun _ => 1))
    apply hno
    rwa [eval_sliceHom, haxis]
  exact eq_zero_of_slice_one _ s (isHomogeneous_pderiv_succ P 0 s hP) hq

/-- Every positive-degree calibrated homogeneous solution in two variables is
an odd power of a nonzero linear form. The spherical maximum supplies the
required regular nonzero level point. -/
theorem exists_odd_linear_power (P : MvPolynomial (Fin 2) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 0 < d) (hne : P ≠ 0)
    (hL : leadingOperator P = 0) (hcal : WeakCalibration (leadingNormalizedField P)) :
    ∃ (c : ℝ) (a : Fin 2 → ℝ), c ≠ 0 ∧ a ≠ 0 ∧ Odd d ∧
      P = C c * (linearForm a)^d := by
  obtain ⟨s,rfl⟩ : ∃ s, d = s+1 := ⟨d-1, by omega⟩
  obtain ⟨x,hx⟩ := (Source29WeakHomogeneousSign.homogeneous_changes_sign P hP hd hne hcal).2
  obtain ⟨U,hUt,hU,hpos,hcritical⟩ :=
    exists_normalized_positive_direction_of_value P s hP (1 : Fin 2) x hx
  let Q := changeVariables U P
  have hQ : Q.IsHomogeneous (s+1) := Source29QuarticReuse.QuarticMinimal.isHomogeneous_changeVariables U P (s+1) hP
  have hQne : Q ≠ 0 := by
    intro hz
    apply hne
    apply changeVariables_injective U hU
    simpa only [map_zero] using hz
  have hQcal := Source29OrthogonalCalibration.weakCalibration_changeVariables U hU P hcal
  have hQzero : eval (Pi.single (1 : Fin 2) 1) (pderiv 0 Q) = 0 := by
    rw [eval_pderiv_basis_of_isHomogeneous Q s hQ 1 0 (by decide)]
    exact hcritical 0 (by decide)
  have hQpos : 0 < eval (Pi.single (1 : Fin 2) 1) Q := by
    rwa [eval_basis_of_isHomogeneous Q (s+1) hQ 1]
  have hQtrans : eval (Pi.single (1 : Fin 2) 1) (pderiv 1 Q) ≠ 0 := by
    have he := euler_evaluatedGradient Q hQ (Pi.single (1 : Fin 2) 1)
    norm_num [Fin.sum_univ_two, Pi.single_apply, evaluatedGradient] at he
    rw [he]
    exact mul_ne_zero (by exact_mod_cast hd.ne') hQpos.ne'
  have hderiv : pderiv 0 Q = 0 := pderiv_zero_of_axis_critical Q s hQ
    (leadingOperator_changeVariables_eq_zero U hU P hL) hQzero hQtrans
  obtain ⟨R,hR⟩ := Source29RadialCoordinateReduction.exists_rename_succ_of_pderiv_zero Q hderiv
  have hRhom : R.IsHomogeneous (s+1) :=
    (IsHomogeneous.rename_isHomogeneous_iff (Fin.succ_injective 1)).mp (hR ▸ hQ)
  have hRne : R ≠ 0 := by
    intro hz
    apply hQne
    rw [hR, hz, map_zero]
  have hRcal : WeakCalibration (leadingNormalizedField R) := by
    apply Source29CalibrationCoordinateDescent.weakCalibration_rename_succ
    rwa [← hR]
  obtain ⟨c,b,hc,_,hodd,hform⟩ :=
    Source29HomogeneousOneDimension.exists_odd_linear_power R (s+1) hRhom hd hRne hRcal
  obtain ⟨a,ha,he⟩ := linear_power_of_reduction P hne U hU R hR b c (s+1) hd hform
  exact ⟨c,a,hc,ha,hodd,he⟩

/-- The second induction base, including every positive polynomial degree. -/
theorem linearRigidity_two : LinearRigidity 2 := by
  intro P d hP hd hne hL hcal
  exact exists_odd_linear_power P d hP hd hne hL hcal

/-- The binary base supplies actual phase charts at every nonvertex zero of
three-dimensional calibrated homogeneous solutions. -/
theorem phase_chart_dimension_three
    (F : MvPolynomial (Fin 3) ℝ) (D : ℕ) (hhom : F.IsHomogeneous D)
    (hne : F ≠ 0) (hF : leadingOperator F = 0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (p : Fin 3 → ℝ) (hp : p ≠ 0) (hzero : eval p F = 0) :
    HasFlatMinimalPhaseChart F p :=
  phase_chart_at_nonzero_zero linearRigidity_two F D hhom hne hF hcal p hp hzero

end
end Source29HomogeneousTwoDimension


/- Final component: HigherDimensionalRealZero -/
namespace Source29HigherDimensionalRealZero

open Source29PuncturedIntermediateValue
open MvPolynomial Source29QuarticReuse.QuarticNormalization
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem exists_perpendicular_unit (a : EuclideanSpace ℝ (Fin (n+3))) (ha : ‖a‖ = 1) :
    ∃ c : EuclideanSpace ℝ (Fin (n+3)), ‖c‖ = 1 ∧ inner ℝ a c = 0 := by
  let u := Source29OrthogonalFrame.coordinateUnit (0 : Fin (n+3))
  let v := Source29OrthogonalFrame.coordinateUnit (1 : Fin (n+3))
  let R := (ℝ ∙ (u-a))ᗮ.reflection
  have hRu : R u = a := Submodule.reflection_sub
    ((Source29OrthogonalFrame.coordinateUnit_norm (0 : Fin (n+3))).trans ha.symm)
  refine ⟨R v, ?_, ?_⟩
  · rw [R.norm_map]
    exact Source29OrthogonalFrame.coordinateUnit_norm (1 : Fin (n+3))
  · rw [← hRu, R.inner_map_map]
    norm_num [u, v, Source29OrthogonalFrame.coordinateUnit_inner]

theorem exists_nonzero_zero_of_unit_sign_change
    (f : EuclideanSpace ℝ (Fin (n+3)) → ℝ) (hf : Continuous f)
    (a b : EuclideanSpace ℝ (Fin (n+3))) (ha : ‖a‖ = 1) (hb : ‖b‖ = 1)
    (hfa : 0 < f a) (hfb : f b < 0) :
    ∃ x : EuclideanSpace ℝ (Fin (n+3)), x ≠ 0 ∧ f x = 0 := by
  by_cases hab : b = -a
  · obtain ⟨c, hc, hac⟩ := exists_perpendicular_unit a ha
    rcases lt_trichotomy (f c) 0 with hneg | hzero | hpos
    · exact exists_nonzero_zero_between_unit_points f hf a c ha hc
        (unit_orthogonal_not_antipodal a c ha hac) hfa hneg
    · exact ⟨c, by intro he; simp [he] at hc, hzero⟩
    · have hcb : inner ℝ c b = 0 := by
        rw [hab, inner_neg_right, real_inner_comm, hac, neg_zero]
      exact exists_nonzero_zero_between_unit_points f hf c b hc hb
        (unit_orthogonal_not_antipodal c b hc hcb) hpos hfb
  · exact exists_nonzero_zero_between_unit_points f hf a b ha hb hab hfa hfb


theorem exists_unit_zero_of_sign_change (P : MvPolynomial (Fin (n+3)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 1 ≤ d)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0) :
    ∃ x, eval x P = 0 ∧ (∑ a, (x a)^2) = 1 := by
  obtain ⟨xp, hxp⟩ := hpos
  obtain ⟨xn, hxn⟩ := hneg
  have hPs : P.IsHomogeneous ((d-1)+1) := by
    convert hP using 1
    omega
  obtain ⟨a, ha, hpa⟩ := exists_positive_sphere_value P (d-1) hPs xp hxp
  obtain ⟨b, hb, hnb⟩ := exists_positive_sphere_value (-P) (d-1) hPs.neg xn
    (by simpa only [map_neg] using neg_pos.mpr hxn)
  have hpb : eval b P < 0 := by
    simpa only [map_neg, neg_pos] using hnb
  let f : EuclideanSpace ℝ (Fin (n+3)) → ℝ := fun x => eval (fun i => x i) P
  have hf : Continuous f := (Source29CompactPolynomialLink.continuous_eval P).comp
    (show Continuous (fun x : EuclideanSpace ℝ (Fin (n+3)) => fun i => x i) by fun_prop)
  have hnorm (v : Fin (n+3) → ℝ) (hv : (∑ i, (v i)^2) = 1) :
      ‖(WithLp.toLp 2 v : EuclideanSpace ℝ (Fin (n+3)))‖ = 1 := by
    have he : ‖(WithLp.toLp 2 v : EuclideanSpace ℝ (Fin (n+3)))‖^2 = 1 := by
      simpa only [EuclideanSpace.real_norm_sq_eq] using hv
    nlinarith [norm_nonneg (WithLp.toLp 2 v : EuclideanSpace ℝ (Fin (n+3)))]
  obtain ⟨z, hz, hpz⟩ := exists_nonzero_zero_of_unit_sign_change
    f hf (WithLp.toLp 2 a) (WithLp.toLp 2 b) (hnorm a ha) (hnorm b hb) hpa hpb
  let v : Fin (n+3) → ℝ := fun i => z i
  have hv : v ≠ 0 := by
    intro he
    apply hz
    ext i
    exact congrFun he i
  let r := Source29AnalyticTensorNorm.tensorNorm v
  have hr : 0 < r := Source29AnalyticTensorNorm.tensorNorm_pos hv
  have hrsq : r^2 = ∑ i, (v i)^2 := Source29AnalyticTensorNorm.tensorNorm_sq v
  refine ⟨fun i => r⁻¹ * v i, ?_, ?_⟩
  · rw [eval_scale_of_isHomogeneous P d hP v r⁻¹]
    change r⁻¹ ^ d * f z = 0
    rw [hpz, mul_zero]
  · simp only [mul_pow, ← Finset.mul_sum, ← hrsq]
    field_simp


end
end Source29HigherDimensionalRealZero


/- Final component: HigherDimensionalLinkIntersection -/
namespace Source29HigherDimensionalLinkIntersection

open MvPolynomial Filter Source29FactorInheritance
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Two regular minimal homogeneous links intersect in every ambient dimension at least three. -/
theorem exists_common_unit_zero
    (P Q : MvPolynomial (Fin (n+3)) ℝ) (d e : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e)
    (hP : P.IsHomogeneous d) (hQ : Q.IsHomogeneous e)
    (hPreg : ∀ x : Fin (n+3) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hQreg : ∀ x : Fin (n+3) → ℝ, eval x Q=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a Q)) ≠ 0)
    (hPL : P ∣ cubicOperator P) (hQL : Q ∣ cubicOperator Q)
    (hPne : ∃ x : Fin (n+3) → ℝ, eval x P=0 ∧ (∑ a, (x a)^2)=1)
    (hQne : ∃ x : Fin (n+3) → ℝ, eval x Q=0 ∧ (∑ a, (x a)^2)=1) :
    ∃ x : Fin (n+3) → ℝ, eval x P=0 ∧ eval x Q=0 ∧ (∑ a, (x a)^2)=1 := by
  let E : Fin (n+3) ≃ Option (Option (Fin (n+1))) := Fintype.equivOfCardEq (by simp)
  have hunit (x : Option (Option (Fin (n+1))) → ℝ) (hx : (∑ a, (x a)^2)=1) :
      (∑ a, ((x ∘ E) a)^2)=1 := by
    change (∑ a, (x (E a))^2)=1
    rwa [E.sum_comp (fun a ↦ (x a)^2)]
  have hreg (R : MvPolynomial (Fin (n+3)) ℝ)
      (hr : ∀ x : Fin (n+3) → ℝ, eval x R=0 → (∑ a, (x a)^2)=1 →
        (fun a ↦ eval x (pderiv a R)) ≠ 0)
      (x : Option (Option (Fin (n+1))) → ℝ) (hx : eval x (rename E R)=0)
      (hu : (∑ a, (x a)^2)=1) : (fun a ↦ eval x (pderiv a (rename E R))) ≠ 0 := by
    apply Source29PolynomialReindex.gradientAt_rename_ne_zero E R x
    exact hr (x ∘ E) (by simpa only [eval_rename] using hx) (hunit x hu)
  have hmin (R : MvPolynomial (Fin (n+3)) ℝ) (hr : R ∣ cubicOperator R)
      (x : Option (Option (Fin (n+1))) → ℝ) (hx : eval x (rename E R)=0)
      (_hu : (∑ a, (x a)^2)=1) : eval x (cubicOperator (rename E R))=0 := by
    obtain ⟨A,hA⟩ := hr
    rw [Source29PolynomialReindex.cubicOperator_rename,hA,map_mul,map_mul,hx,zero_mul]
  have hnonempty (R : MvPolynomial (Fin (n+3)) ℝ)
      (hr : ∃ x : Fin (n+3) → ℝ, eval x R=0 ∧ (∑ a, (x a)^2)=1) :
      ∃ x : Option (Option (Fin (n+1))) → ℝ, eval x (rename E R)=0 ∧ (∑ a, (x a)^2)=1 := by
    obtain ⟨x,hx,hu⟩ := hr
    refine ⟨x ∘ E.symm,?_,?_⟩
    · simpa only [eval_rename,Function.comp_assoc,E.symm_comp_self,Function.comp_id] using hx
    · change (∑ a, (x (E.symm a))^2)=1
      rwa [E.symm.sum_comp (fun a ↦ (x a)^2)]
  obtain ⟨x,hxP,hxQ,hxu⟩ := Source29RegularLinkIntersection.exists_common_unit_zero (rename E P) (rename E Q) d e hd he
    hP.rename_isHomogeneous hQ.rename_isHomogeneous (hreg P hPreg) (hreg Q hQreg)
    (hmin P hPL) (hmin Q hQL) (hnonempty P hPne) (hnonempty Q hQne) (0 : Fin (n+1))
  exact ⟨x ∘ E,by simpa only [eval_rename] using hxP,
    by simpa only [eval_rename] using hxQ,hunit x hxu⟩


end
end Source29HigherDimensionalLinkIntersection


/- Final component: HigherDimensionalPhaseStructure -/
