      (p : ℝ) Set.univ isOpen_univ (fun _ _ _ _ => Set.mem_univ _)
      (fun y _ => Source29PolynomialLinkChart.analyticAt_eval_real P y)
      (fun y _ t ht => by
        rw [Real.rpow_natCast]
        exact Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous P p hP y t)
      base (Set.mem_univ _) (Pi.single (some j) 1)
    change hess (fun y => eval y P) base (some none) (some j) =
      ((p : ℝ)-1)*coordPartial (fun y => eval y P) (some j) base at he
    rw [hess_eval, partial_eval, hpt, mul_zero] at he
