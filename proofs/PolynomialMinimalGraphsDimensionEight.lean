noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

variable (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (hf : AnalyticAt ℝ f base) (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (hthird : ∀ a b, third f base (some none) a b = (D-2)*hess f base a b)
    (hfourth : ∀ a b, fourth f base a b (some none) (some none) =
      (D-3)*(D-2)*hess f base a b)

