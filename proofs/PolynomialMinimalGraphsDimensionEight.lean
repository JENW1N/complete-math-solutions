noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def rotation (u v w : κ → ℝ) : κ → ℝ := reflect (u+v) (reflect u w)

def inverseRotation (u v w : κ → ℝ) : κ → ℝ := reflect u (reflect (u+v) w)

theorem rotation_dot (u v a b : κ → ℝ) : rotation u v a ⬝ᵥ rotation u v b = a ⬝ᵥ b := by
  simp only [rotation, reflect_dot]

theorem inverseRotation_dot (u v a b : κ → ℝ) : inverseRotation u v a ⬝ᵥ inverseRotation u v b = a ⬝ᵥ b := by
  simp only [inverseRotation, reflect_dot]

theorem rotation_inverse (u v w : κ → ℝ) : rotation u v (inverseRotation u v w) = w := by
  simp only [rotation, inverseRotation, reflect_involutive]

theorem inverse_rotation (u v w : κ → ℝ) : inverseRotation u v (rotation u v w) = w := by
  simp only [rotation, inverseRotation, reflect_involutive]

theorem rotation_move (u v : κ → ℝ) (h : u ⬝ᵥ u = v ⬝ᵥ v) : rotation u v u = v := by
  rw [rotation, reflect_self, reflect_sum u v h]

theorem rotation_self (u w : κ → ℝ) : rotation u u w = w := by
  have he : u+u = (2 : ℝ) • u := (two_smul ℝ u).symm
  rw [rotation, he, reflect_smul u _ 2 (by norm_num), reflect_involutive]

theorem inverseRotation_self (u w : κ → ℝ) : inverseRotation u u w = w := by
  have he := inverse_rotation u u w
  rwa [rotation_self] at he

theorem rotation_fix (u v w : κ → ℝ) (hu : u ⬝ᵥ w = 0) (hv : v ⬝ᵥ w = 0) :
    rotation u v w = w := by
  have hs : (u+v) ⬝ᵥ (-w) = 0 := by
    rw [dotProduct_neg, add_dotProduct, hu, hv]
    ring
  rw [rotation, reflect_orthogonal u w hu, reflect_orthogonal (u+v) (-w) hs, neg_neg]

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem rotation_analyticAt (u : κ → ℝ) (v w : E → κ → ℝ) (x : E)
    (hu : u ≠ 0) (hs : u + v x ≠ 0)
    (hv : ∀ a, AnalyticAt ℝ (fun y => v y a) x)
    (hw : ∀ a, AnalyticAt ℝ (fun y => w y a) x) :
    AnalyticAt ℝ (fun y => rotation u (v y) (w y)) x := by
  have hi := reflect_analyticAt (fun _ : E => u) w x (fun _ => analyticAt_const) hw hu
  exact reflect_analyticAt (fun y => u + v y) (fun y => reflect u (w y)) x
    (fun a => analyticAt_const.add (hv a)) (analyticAt_pi_iff.mp hi) hs

theorem inverseRotation_analyticAt (u : κ → ℝ) (v w : E → κ → ℝ) (x : E)
    (hu : u ≠ 0) (hs : u + v x ≠ 0)
    (hv : ∀ a, AnalyticAt ℝ (fun y => v y a) x)
    (hw : ∀ a, AnalyticAt ℝ (fun y => w y a) x) :
    AnalyticAt ℝ (fun y => inverseRotation u (v y) (w y)) x := by
  have hi := reflect_analyticAt (fun y => u + v y) w x
    (fun a => analyticAt_const.add (hv a)) hw hs
  exact reflect_analyticAt (fun _ : E => u) (fun y => reflect (u + v y) (w y)) x
    (fun _ => analyticAt_const) (analyticAt_pi_iff.mp hi) hu

end
end Source29AnalyticPairRotation

/- Component: AnalyticPairFrame.inc -/
namespace Source29AnalyticPairFrame

open Source29AnalyticPairRotation
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def frame (u v x y w : κ → ℝ) : κ → ℝ :=
  rotation u x (rotation v (inverseRotation u x y) w)

theorem frame_dot (u v x y a b : κ → ℝ) : frame u v x y a ⬝ᵥ frame u v x y b = a ⬝ᵥ b := by
  simp only [frame, rotation_dot]

theorem frame_self (u v w : κ → ℝ) : frame u v u v w = w := by
  simp only [frame, rotation_self, inverseRotation_self]

theorem frame_pair (u v x y : κ → ℝ)
    (hx : u ⬝ᵥ u = x ⬝ᵥ x) (hy : v ⬝ᵥ v = y ⬝ᵥ y)
    (huv : u ⬝ᵥ v = 0) (hxy : x ⬝ᵥ y = 0) :
    frame u v x y u = x ∧ frame u v x y v = y := by
  let m := inverseRotation u x y
  have hmnorm : v ⬝ᵥ v = m ⬝ᵥ m := by
    dsimp [m]
    rw [inverseRotation_dot]
    exact hy
  have hmu : m ⬝ᵥ u = 0 := by
    have he := rotation_dot u x m u
    rw [rotation_move u x hx, rotation_inverse] at he
    rw [← he, dotProduct_comm, hxy]
  have hvu : v ⬝ᵥ u = 0 := by rw [dotProduct_comm, huv]
  constructor
  · change rotation u x (rotation v m u) = x
    rw [rotation_fix v m u hvu hmu, rotation_move u x hx]
  · change rotation u x (rotation v m v) = y
    rw [rotation_move v m hmnorm]
    exact rotation_inverse u x y

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem frame_analyticAt (u v : κ → ℝ) (x y w : E → κ → ℝ) (p : E)
    (hu : u ≠ 0) (hv : v ≠ 0) (hx0 : x p = u) (hy0 : y p = v)
    (hx : ∀ a, AnalyticAt ℝ (fun q => x q a) p)
    (hy : ∀ a, AnalyticAt ℝ (fun q => y q a) p)
    (hw : ∀ a, AnalyticAt ℝ (fun q => w q a) p) :
    AnalyticAt ℝ (fun q => frame u v (x q) (y q) (w q)) p := by
  have hsu : u + x p ≠ 0 := by
    rw [hx0, ← two_smul ℝ u]
    exact smul_ne_zero (by norm_num) hu
  let m := fun q => inverseRotation u (x q) (y q)
  have hm : AnalyticAt ℝ m p := inverseRotation_analyticAt u x y p hu hsu hx hy
  have hm0 : m p = v := by simp only [m, hx0, hy0, inverseRotation_self]
  have hsv : v + m p ≠ 0 := by
    rw [hm0, ← two_smul ℝ v]
    exact smul_ne_zero (by norm_num) hv
  have hi := rotation_analyticAt v m w p hv hsv (analyticAt_pi_iff.mp hm) hw
  exact rotation_analyticAt u x (fun q => rotation v (m q) (w q)) p hu hsu hx
    (analyticAt_pi_iff.mp hi)

end
end Source29AnalyticPairFrame

/- Component: ReflectionCurveDerivative.inc -/
