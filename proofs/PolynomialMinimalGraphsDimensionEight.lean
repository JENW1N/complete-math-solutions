/-- Nullstellensatz in the divisibility form used by the complex obstruction. -/
theorem irreducible_dvd_of_vanishing {ι : Type*} [Fintype ι]
    (h p : MvPolynomial ι K) (hh : Irreducible h)
    (hvan : ∀ z : ι → K, eval z h = 0 → eval z p = 0) : h ∣ p := by
  let J : Ideal (MvPolynomial ι K) := Ideal.span {h}
  have : J.IsPrime := Ideal.isPrime_span_singleton_of_prime hh.prime
  have hp : p ∈ vanishingIdeal K (zeroLocus K J) := by
    intro z hz
    have hhmem : h ∈ J := Ideal.subset_span (Set.mem_singleton h)
    have hz' := hz h hhmem
    simpa using hvan z (by simpa using hz')
  rw [MvPolynomial.IsPrime.vanishingIdeal_zeroLocus] at hp
  exact Ideal.mem_span_singleton.mp hp

/-- An irreducible hypersurface over an algebraically closed field in at least two variables has a nonzero point. -/
theorem exists_nonzero_zero {ι : Type*} [Fintype ι] [Nontrivial ι]
    (h : MvPolynomial ι K) (hh : Irreducible h) :
    ∃ z : ι → K, z ≠ 0 ∧ eval z h = 0 := by
  classical
  by_contra hnone
  push Not at hnone
  have hdiv (i : ι) : h ∣ X i := by
    apply irreducible_dvd_of_vanishing h (X i) hh
    intro z hz
    have hz0 : z = 0 := by
      by_contra hne
      exact hnone z hne hz
    simp [hz0]
  obtain ⟨i, j, hij⟩ := exists_pair_ne ι
  have hback : X i ∣ h :=
    (hh.associated_of_dvd (X_prime (i := i)).irreducible (hdiv i)).symm.dvd
  exact hij (X_dvd_X.mp (dvd_trans hback (hdiv j)))

