/-- Multiplication by a unit complex scalar makes a nonzero quadratic value real
and positive. The scalar acts quadratically on the value. -/
theorem exists_quadratic_phase (a : ℂ) (ha : a ≠ 0) :
    ∃ c : ℂ, ‖c‖ = 1 ∧ c ^ 2 * a = (‖a‖ : ℂ) := by
  let b : ℂ := (‖a‖ : ℂ) / a
