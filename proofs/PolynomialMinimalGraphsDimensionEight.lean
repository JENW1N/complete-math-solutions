variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- One orthogonal change normalizes the factor and cofactor together while
preserving the equation only assumed for their product. -/
theorem exists_normalized_factors
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (p q k : ℕ)
    (hP : P.IsHomogeneous p) (hQ : Q.IsHomogeneous q)
    (hF : leadingOperator (P^k*Q) = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hpos : 0 < eval x Q) (hreg : (fun a => eval x (pderiv a P)) ≠ 0) :
    ∃ (a : ℝ) (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ),
      0 < a ∧ U.transpose * U = 1 ∧ U * U.transpose = 1 ∧ U *ᵥ base = x ∧
      (changeVariables U P).IsHomogeneous p ∧ (changeVariables U Q).IsHomogeneous q ∧
      leadingOperator ((changeVariables U P)^k * changeVariables U Q) = 0 ∧
      eval base (changeVariables U P) = 0 ∧ 0 < eval base (changeVariables U Q) ∧
      eval base (pderiv none (changeVariables U P)) = a ∧
      (∀ j, eval base (pderiv (some j) (changeVariables U P)) = 0) := by
  obtain ⟨a,U,ha,hUt,hcol,hgrad⟩ :=
    Source29RegularPolynomialLinkFrankel.exists_radial_normal_frame P p hP x hx hzero hreg
  have hU : U*U.transpose = 1 := mul_eq_one_comm.mp hUt
  have hbase : U *ᵥ base = x := by
    funext j
    have he := congrFun hcol j
    simpa [Matrix.mulVec, dotProduct, base, Pi.single_apply,
      Source29ClosestPairStationarity.column] using he
  have horth : ∀ j, (∑ b, U b none * U b j) = if none = j then 1 else 0 := by
    intro j
    have he := congrArg (fun M : Matrix (Option (Option ι)) (Option (Option ι)) ℝ => M none j) hUt
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  have hpartial : ∀ j, eval base (pderiv j (changeVariables U P)) =
      a * (if none = j then 1 else 0) := by
    intro j
    rw [pderiv_changeVariables, map_sum]
    simp only [map_mul, eval_C, eval_changeVariables, hbase]
    simp_rw [hgrad, mul_assoc]
    rw [← Finset.mul_sum, horth]
  refine ⟨a,U,ha,hUt,hU,hbase,isHomogeneous_changeVariables U P p hP,
    isHomogeneous_changeVariables U Q q hQ,?_,?_,?_,?_,?_⟩
  · simpa only [map_mul, map_pow] using leadingOperator_changeVariables_eq_zero U hU (P^k*Q) hF
  · rw [eval_changeVariables, hbase, hzero]
  · rwa [eval_changeVariables, hbase]
  · simpa using hpartial none
  · intro j
    simpa using hpartial (some j)

end
