noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def orthogonalPolynomialEquiv {κ : Type*} [Fintype κ] [DecidableEq κ]
    (U : Matrix κ κ ℝ) (hU : U * U.transpose = 1) (hUt : U.transpose * U = 1) :
    MvPolynomial κ ℝ ≃ₐ[ℝ] MvPolynomial κ ℝ :=
  AlgEquiv.ofBijective (changeVariables U) ⟨changeVariables_injective U hU, by
    intro P
    refine ⟨changeVariables U.transpose P, ?_⟩
    rw [changeVariables_comp, hUt, changeVariables_one]⟩

theorem exists_positive_curvature_on_link
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hirr : Irreducible P) (hd : 2 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hz : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) :
    ∃ y : Ambient ι, (eval y P = 0 ∧ (∑ a, (y a)^2) = 1) ∧
      0 < curvaturePotential P y := by
  obtain ⟨g, U, hg, hUt, hU, hbase, hQ, hLQ, hQzero, hgn, hgt⟩ :=
    Source29PolynomialNormalFrame.exists_normalized_polynomial P d hP hL x hx hz hreg
  let Q := changeVariables U P
  have hiQ : Irreducible Q :=
    (MulEquiv.irreducible_iff (orthogonalPolynomialEquiv U hU hUt)).mpr hirr
  have hdQ : 2 ≤ Q.totalDegree := by
    rw [hQ.totalDegree hiQ.ne_zero]
    exact hd
  have hS : {z : Ambient ι | z (some none) ≠ 0} ∈ 𝓝 (base : Ambient ι) :=
    (continuous_apply (some none)).continuousAt.eventually_ne (by simp [base])
  obtain ⟨z, hzcoord, hzQ, hzreg, hzK⟩ := Source29LocalFlatPolynomial.exists_positive_curvature_in_nhds
    Q hiQ hdQ base (by simp [base]) hQzero g hg.ne' hgn hgt _ hS
  have hzne : z ≠ 0 := by
    intro he
    exact hzcoord (congrFun he (some none))
  let r := Source29AnalyticTensorNorm.tensorNorm z
  have hr : 0 < r := Source29AnalyticTensorNorm.tensorNorm_pos hzne
  have hrsq : r^2 = ∑ a, (z a)^2 := Source29AnalyticTensorNorm.tensorNorm_sq z
  let w := r⁻¹ • z
  have hwunit : (∑ a, (w a)^2) = 1 := by
    simp only [w, Pi.smul_apply, smul_eq_mul, mul_pow, ← Finset.mul_sum]
    rw [← hrsq]
    field_simp
  have hwzero : eval w Q = 0 := by
    change eval (fun i => r⁻¹ * z i) Q = 0
    rw [eval_scale_of_isHomogeneous Q d hQ z r⁻¹, hzQ, mul_zero]
  have hwK : 0 < curvaturePotential Q w := by
    rw [Source29CurvatureScaling.curvaturePotential_scale Q d hQ hd z hzreg r⁻¹ (inv_ne_zero hr.ne')]
    exact div_pos hzK (sq_pos_of_pos (inv_pos.mpr hr))
  refine ⟨U *ᵥ w, ⟨?_, ?_⟩, ?_⟩
  · rwa [← eval_changeVariables]
  · have he := MatrixAlgebra.dot_transpose_mulVec U.transpose hUt w w
    have hww : w ⬝ᵥ w = 1 := by simpa only [dotProduct, pow_two] using hwunit
    simpa only [Matrix.transpose_transpose, dotProduct, ← pow_two] using he.trans hww
  · rwa [← curvaturePotential_changeVariables U hU]

theorem exists_positive_curvature_on_link_fin8
    (P : MvPolynomial (Fin 8) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hirr : Irreducible P) (hd : 2 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Fin 8 → ℝ) (hx : (∑ a, (x a)^2) = 1) (hz : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) :
    ∃ y : Fin 8 → ℝ, (eval y P = 0 ∧ (∑ a, (y a)^2) = 1) ∧
      0 < curvaturePotential P y := by
  let e := Source29FinEightDegreeBound.eightLinkEquiv
  let Q := rename e P
  have hQ : Q.IsHomogeneous d := hP.rename_isHomogeneous
  have hiQ : Irreducible Q := (MulEquiv.irreducible_iff (renameEquiv ℝ e)).mpr hirr
  have hQL : Source29FactorInheritance.cubicOperator Q = 0 := by
    change Source29FactorInheritance.cubicOperator (rename e P) = 0
    rw [Source29PolynomialReindex.cubicOperator_rename, hL, map_zero]
  have hx' : (∑ a, ((x ∘ e.symm) a)^2) = 1 := by
    change (∑ a, (x (e.symm a))^2) = 1
    rw [e.symm.sum_comp (fun a => (x a)^2)]
    exact hx
  have hz' : eval (x ∘ e.symm) Q = 0 := by
    simpa only [Q, eval_rename, Function.comp_assoc, e.symm_comp_self, Function.comp_id] using hz
  have hr' : gradientAt Q (x ∘ e.symm) ≠ 0 := by
    apply Source29PolynomialReindex.gradientAt_rename_ne_zero e P (x ∘ e.symm)
    simpa only [Function.comp_assoc, e.symm_comp_self, Function.comp_id] using hreg
  obtain ⟨y, hy, hK⟩ := exists_positive_curvature_on_link Q d hQ hiQ hd hQL
    (x ∘ e.symm) hx' hz' hr'
  refine ⟨y ∘ e, ⟨?_, ?_⟩, ?_⟩
  · simpa only [Q, eval_rename] using hy.1
  · change (∑ a, (y (e a))^2) = 1
    rw [e.sum_comp (fun a => (y a)^2)]
    exact hy.2
  · simpa only [Q, Source29CurvatureReindex.curvaturePotential_rename] using hK

end
end Source29PolynomialLinkNonflatness

/- Component: PuncturedIntermediateValue.inc -/
namespace Source29PuncturedIntermediateValue

open scoped Topology

noncomputable section

theorem segment_ne_zero_of_unit_not_antipodal
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (a b : E) (ha : ‖a‖ = 1) (hb : ‖b‖ = 1) (hab : b ≠ -a)
    (t : ℝ) (ht : t ∈ Set.Icc 0 1) : (1-t) • a + t • b ≠ 0 := by
  intro hz
  have he : (1-t) • a = -(t • b) := eq_neg_of_add_eq_zero_left hz
  have hn := congrArg norm he
  simp only [norm_smul, norm_neg, Real.norm_eq_abs, ha, hb, mul_one,
    abs_of_nonneg ht.1, abs_of_nonneg (sub_nonneg.mpr ht.2)] at hn
  have ht' : t = 1/2 := by linarith
  have hs : (1/2 : ℝ) • (a+b) = 0 := by
    rw [smul_add]
    simpa only [ht', show (1 : ℝ)-1/2 = 1/2 by norm_num] using hz
  have hab0 : a+b = 0 := (smul_eq_zero.mp hs).resolve_left (by norm_num)
  exact hab (eq_neg_of_add_eq_zero_right hab0)

theorem exists_nonzero_zero_between_unit_points
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : E → ℝ) (hf : Continuous f) (a b : E)
    (ha : ‖a‖ = 1) (hb : ‖b‖ = 1) (hab : b ≠ -a)
    (hfa : 0 < f a) (hfb : f b < 0) : ∃ x : E, x ≠ 0 ∧ f x = 0 := by
  let line : ℝ → E := fun t => (1-t) • a + t • b
  have hl : Continuous line :=
    ((continuous_const.sub continuous_id).smul continuous_const).add
      (continuous_id.smul continuous_const)
  have hrange := intermediate_value_Icc' (by norm_num : (0 : ℝ) ≤ 1) (hf.comp hl).continuousOn
  have hm : (0 : ℝ) ∈ Set.Icc (f (line 1)) (f (line 0)) := by
    simpa only [line, sub_self, zero_smul, one_smul, zero_add, sub_zero, add_zero] using
      (show (0 : ℝ) ∈ Set.Icc (f b) (f a) from ⟨hfb.le, hfa.le⟩)
  obtain ⟨t, ht, hft⟩ := hrange hm
  exact ⟨line t, segment_ne_zero_of_unit_not_antipodal a b ha hb hab t ht, hft⟩

theorem unit_orthogonal_not_antipodal
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (a b : E) (ha : ‖a‖ = 1) (hab : inner ℝ a b = 0) : b ≠ -a := by
  intro he
  rw [he, inner_neg_right, real_inner_self_eq_norm_sq, ha] at hab
  norm_num at hab

theorem exists_perpendicular_unit (a : EuclideanSpace ℝ (Fin 8)) (ha : ‖a‖ = 1) :
    ∃ c : EuclideanSpace ℝ (Fin 8), ‖c‖ = 1 ∧ inner ℝ a c = 0 := by
  let u := Source29OrthogonalFrame.coordinateUnit (0 : Fin 8)
  let v := Source29OrthogonalFrame.coordinateUnit (1 : Fin 8)
  let R := (ℝ ∙ (u-a))ᗮ.reflection
  have hRu : R u = a := Submodule.reflection_sub
    ((Source29OrthogonalFrame.coordinateUnit_norm (0 : Fin 8)).trans ha.symm)
  refine ⟨R v, ?_, ?_⟩
  · rw [R.norm_map]
    exact Source29OrthogonalFrame.coordinateUnit_norm (1 : Fin 8)
  · rw [← hRu, R.inner_map_map]
    norm_num [u, v, Source29OrthogonalFrame.coordinateUnit_inner]

theorem exists_nonzero_zero_of_unit_sign_change
    (f : EuclideanSpace ℝ (Fin 8) → ℝ) (hf : Continuous f)
    (a b : EuclideanSpace ℝ (Fin 8)) (ha : ‖a‖ = 1) (hb : ‖b‖ = 1)
    (hfa : 0 < f a) (hfb : f b < 0) :
    ∃ x : EuclideanSpace ℝ (Fin 8), x ≠ 0 ∧ f x = 0 := by
  by_cases hab : b = -a
  · obtain ⟨c, hc, hac⟩ := exists_perpendicular_unit a ha
    rcases lt_trichotomy (f c) 0 with hneg | hzero | hpos
    · exact exists_nonzero_zero_between_unit_points f hf a c ha hc
        (unit_orthogonal_not_antipodal a c ha hac) hfa hneg
    · exact ⟨c, by intro he; simp [he] at hc, hzero⟩
    · have hcb : inner ℝ c b = 0 := by
        rw [hab, inner_neg_right, real_inner_comm, hac, neg_zero]
      exact exists_nonzero_zero_between_unit_points f hf c b hc hb
        (unit_orthogonal_not_antipodal c b hc hcb) hpos hfb
  · exact exists_nonzero_zero_between_unit_points f hf a b ha hb hab hfa hfb

end
end Source29PuncturedIntermediateValue

/- Component: HomogeneousRealZero.inc -/
namespace Source29HomogeneousRealZero

open MvPolynomial Source29QuarticReuse.QuarticNormalization
open scoped BigOperators

noncomputable section

theorem exists_unit_zero_of_sign_change (P : MvPolynomial (Fin 8) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 1 ≤ d)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0) :
    ∃ x, eval x P = 0 ∧ (∑ a, (x a)^2) = 1 := by
  obtain ⟨xp, hxp⟩ := hpos
  obtain ⟨xn, hxn⟩ := hneg
  have hPs : P.IsHomogeneous ((d-1)+1) := by
    convert hP using 1
    omega
  obtain ⟨a, ha, hpa⟩ := exists_positive_sphere_value P (d-1) hPs xp hxp
  obtain ⟨b, hb, hnb⟩ := exists_positive_sphere_value (-P) (d-1) hPs.neg xn
    (by simpa only [map_neg] using neg_pos.mpr hxn)
  have hpb : eval b P < 0 := by
    simpa only [map_neg, neg_pos] using hnb
  let f : EuclideanSpace ℝ (Fin 8) → ℝ := fun x => eval (fun i => x i) P
  have hf : Continuous f := (Source29CompactPolynomialLink.continuous_eval P).comp
    (show Continuous (fun x : EuclideanSpace ℝ (Fin 8) => fun i => x i) by fun_prop)
  have hnorm (v : Fin 8 → ℝ) (hv : (∑ i, (v i)^2) = 1) :
      ‖(WithLp.toLp 2 v : EuclideanSpace ℝ (Fin 8))‖ = 1 := by
    have he : ‖(WithLp.toLp 2 v : EuclideanSpace ℝ (Fin 8))‖^2 = 1 := by
      simpa only [EuclideanSpace.real_norm_sq_eq] using hv
    nlinarith [norm_nonneg (WithLp.toLp 2 v : EuclideanSpace ℝ (Fin 8))]
  obtain ⟨z, hz, hpz⟩ := Source29PuncturedIntermediateValue.exists_nonzero_zero_of_unit_sign_change
    f hf (WithLp.toLp 2 a) (WithLp.toLp 2 b) (hnorm a ha) (hnorm b hb) hpa hpb
  let v : Fin 8 → ℝ := fun i => z i
  have hv : v ≠ 0 := by
    intro he
    apply hz
    ext i
    exact congrFun he i
  let r := Source29AnalyticTensorNorm.tensorNorm v
  have hr : 0 < r := Source29AnalyticTensorNorm.tensorNorm_pos hv
  have hrsq : r^2 = ∑ i, (v i)^2 := Source29AnalyticTensorNorm.tensorNorm_sq v
  refine ⟨fun i => r⁻¹ * v i, ?_, ?_⟩
  · rw [eval_scale_of_isHomogeneous P d hP v r⁻¹]
    change r⁻¹ ^ d * f z = 0
    rw [hpz, mul_zero]
  · simp only [mul_pow, ← Finset.mul_sum, ← hrsq]
    field_simp

end
end Source29HomogeneousRealZero

/- Component: RealLeadingFactor.inc -/
namespace Source29RealLeadingFactor

open MvPolynomial Source29FactorInheritance

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem exists_irreducible_sign_changing_divisor
    (F : MvPolynomial κ ℝ) (a b : κ → ℝ) (hF : eval a F * eval b F < 0) :
    ∃ p : MvPolynomial κ ℝ, Irreducible p ∧ p ∣ F ∧ eval a p * eval b p < 0 := by
  induction F using WfDvdMonoid.induction_on_irreducible with
  | zero => simp at hF
  | unit u hu =>
    have hd : u.totalDegree = 0 := by
      have he := totalDegree_le_of_dvd_of_isDomain (hu.dvd : u ∣ (1 : MvPolynomial κ ℝ))
        (one_ne_zero : (1 : MvPolynomial κ ℝ) ≠ 0)
      simpa using he
    have hc := totalDegree_eq_zero_iff_eq_C.mp hd
    rw [hc, eval_C, eval_C] at hF
    exact (not_lt_of_ge (mul_self_nonneg (u.coeff 0)) hF).elim
  | mul q p hq hp ih =>
    by_cases hps : eval a p * eval b p < 0
    · exact ⟨p, hp, dvd_mul_right p q, hps⟩
    · have hqs : eval a q * eval b q < 0 := by
        by_contra hqs
        have hn := mul_nonneg (le_of_not_gt hps) (le_of_not_gt hqs)
        have he : eval a (p*q) * eval b (p*q) =
            (eval a p * eval b p) * (eval a q * eval b q) := by
          simp only [map_mul]
          ring
        rw [he] at hF
        exact (not_lt_of_ge hn hF)
      obtain ⟨r, hr, hrd, hrs⟩ := ih hqs
      exact ⟨r, hr, dvd_mul_of_dvd_right hrd p, hrs⟩

theorem real_factor_inheritance (p Q : MvPolynomial κ ℝ) (k : ℕ) (hk : 1 ≤ k)
    (hp : Irreducible p) (hQ : ¬p ∣ Q) (hF : cubicOperator (p^k*Q) = 0) :
    p ∣ cubicOperator p := by
  obtain ⟨r, hr⟩ := scaled_cubicOperator_pow_mul p Q k
  have hz : (p^k)^3*p*((k : MvPolynomial κ ℝ)^3*Q^3*cubicOperator p+p*r) = 0 := by
    rw [← hr, hF, mul_zero]
  have hnz : (p^k)^3*p ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (pow_ne_zero _ hp.ne_zero)) hp.ne_zero
  have hb := (mul_eq_zero.mp hz).resolve_left hnz
  have hd : p ∣ (k : MvPolynomial κ ℝ)^3*Q^3*cubicOperator p := by
    refine ⟨-r, ?_⟩
    linear_combination hb
  have hu : IsUnit (k : MvPolynomial κ ℝ) := by
    have hu' : IsUnit (k : ℝ) := isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr (by omega))
    simpa using hu'.map (C : ℝ →+* MvPolynomial κ ℝ)
  rcases hp.prime.dvd_or_dvd hd with hleft | hright
  · rcases hp.prime.dvd_or_dvd hleft with hnat | hpow
    · exact (hp.not_dvd_isUnit (hu.pow 3) hnat).elim
    · exact (hQ (hp.prime.dvd_of_dvd_pow hpow)).elim
  · exact hright

theorem exists_sign_changing_homogeneous_factor
    (F : MvPolynomial κ ℝ) (d : ℕ) (hhom : F.IsHomogeneous d)
    (hL : cubicOperator F = 0) (hpos : ∃ a, 0 < eval a F) (hneg : ∃ b, eval b F < 0) :
    ∃ (p Q : MvPolynomial κ ℝ) (k : ℕ),
      1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
      Q.IsHomogeneous Q.totalDegree ∧ F = p^k*Q ∧ ¬p ∣ Q ∧
      (∃ a, 0 < eval a p) ∧ (∃ b, eval b p < 0) ∧ p ∣ cubicOperator p := by
  obtain ⟨a, ha⟩ := hpos
  obtain ⟨b, hb⟩ := hneg
  have hF : F ≠ 0 := by intro hz; simp [hz] at ha
  obtain ⟨p, hp, hpF, hab⟩ := exists_irreducible_sign_changing_divisor F a b (mul_neg_of_pos_of_neg ha hb)
  have hf : FiniteMultiplicity p F := FiniteMultiplicity.of_not_isUnit hp.not_isUnit hF
  obtain ⟨Q, hfactor, hnot⟩ := hf.exists_eq_pow_mul_and_not_dvd
  have hk : 1 ≤ multiplicity p F := by
    have hne := (multiplicity_ne_zero hf).mpr hpF
    omega
  have hpH := Source29HomogeneousFactor.divisor_isHomogeneous F p hF hhom hpF
  have hQH := Source29HomogeneousFactor.divisor_isHomogeneous F Q hF hhom
    (show Q ∣ F from ⟨p^(multiplicity p F), hfactor.trans (mul_comm _ _)⟩)
  have hpL := real_factor_inheritance p Q (multiplicity p F) hk hp hnot (by rwa [← hfactor])
  have hsign : (∃ a, 0 < eval a p) ∧ (∃ b, eval b p < 0) := by
    rcases mul_neg_iff.mp hab with h | h
    · exact ⟨⟨a, h.1⟩, ⟨b, h.2⟩⟩
    · exact ⟨⟨b, h.2⟩, ⟨a, h.1⟩⟩
  exact ⟨p, Q, multiplicity p F, hk, hp, hpH, hQH, hfactor, hnot, hsign.1, hsign.2, hpL⟩

theorem minimal_graph_leading_factor (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    ∃ (p Q : MvPolynomial (Fin 8) ℝ) (k : ℕ),
      1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
      Q.IsHomogeneous Q.totalDegree ∧ homogeneousComponent P.totalDegree P = p^k*Q ∧ ¬p ∣ Q ∧
      (∃ a, 0 < eval a p) ∧ (∃ b, eval b p < 0) ∧ p ∣ cubicOperator p := by
  obtain ⟨hne, hhom, hL⟩ := QuarticPolynomialBasics.leading_component_data P hmin hdeg
  obtain ⟨hneg, hpos⟩ := Source29QuarticReuse.FluxPolynomial.top_changes_sign P hmin hdeg
  exact exists_sign_changing_homogeneous_factor _ P.totalDegree hhom hL hpos hneg

end
end Source29RealLeadingFactor

/- Component: PositiveResidualSign.inc -/
namespace Source29PositiveResidualSign

open MvPolynomial Source29QuarticReuse.QuarticNormalization

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem factor_changes_sign_of_positive_residual
    (F p Q : MvPolynomial κ ℝ) (d k : ℕ)
    (hhom : F.IsHomogeneous d) (hd : 1 ≤ d) (hfactor : F = p^k*Q)
    (hQ : ∀ x : κ → ℝ, x ≠ 0 → 0 < eval x Q)
    (hpos : ∃ x, 0 < eval x F) (hneg : ∃ x, eval x F < 0) :
    Odd k ∧ (∃ x, 0 < eval x p) ∧ (∃ x, eval x p < 0) := by
  have hF0 : eval (0 : κ → ℝ) F = 0 := by
    have he := eval_scale_of_isHomogeneous F d hhom (0 : κ → ℝ) 0
    simpa only [zero_mul, zero_pow (by omega : d ≠ 0), Pi.zero_def] using he
  obtain ⟨a, ha⟩ := hpos
  obtain ⟨b, hb⟩ := hneg
  have ha0 : a ≠ 0 := by intro he; rw [he, hF0] at ha; exact (lt_irrefl _ ha)
  have hb0 : b ≠ 0 := by intro he; rw [he, hF0] at hb; exact (lt_irrefl _ hb)
  have hap : 0 < (eval a p)^k := by
    rw [hfactor, map_mul, map_pow] at ha
    exact (mul_pos_iff_of_pos_right (hQ a ha0)).mp ha
  have hbp : (eval b p)^k < 0 := by
    rw [hfactor, map_mul, map_pow] at hb
    by_contra h
    exact (not_lt_of_ge (mul_nonneg (le_of_not_gt h) (hQ b hb0).le) hb)
  have hk : Odd k := by
    rcases Nat.even_or_odd k with he | ho
    · exact (not_lt_of_ge (he.pow_nonneg (eval b p)) hbp).elim
    · exact ho
  exact ⟨hk, ⟨a, hk.pow_pos_iff.mp hap⟩, ⟨b, hk.pow_neg_iff.mp hbp⟩⟩

theorem minimal_graph_factor_changes_sign (P p Q : MvPolynomial (Fin 8) ℝ) (k : ℕ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (hfactor : homogeneousComponent P.totalDegree P = p^k*Q)
    (hQ : Source29Closing.PositiveAwayFromZero Q) :
    Odd k ∧ (∃ x, 0 < eval x p) ∧ (∃ x, eval x p < 0) := by
  obtain ⟨hneg, hpos⟩ := Source29QuarticReuse.FluxPolynomial.top_changes_sign P hmin hdeg
  exact factor_changes_sign_of_positive_residual _ p Q P.totalDegree k
    (homogeneousComponent_isHomogeneous _ _) (by omega) hfactor hQ hpos hneg

end
end Source29PositiveResidualSign

/- Component: NonlinearStructureReduction.inc -/
namespace Source29NonlinearStructureReduction

open MvPolynomial Source29Closing Source29PolynomialCurvaturePotential
open Source29RegularStructureReduction
open scoped BigOperators

noncomputable section

/-- The remaining structural data. Sign change, a real unit zero, and
nonflatness are derived from these hypotheses and the full equation. -/
def NonlinearRegularLeadingFactorData8 (P : Polynomial8) : Prop :=
  ∃ (p Q : Polynomial8) (k : ℕ),
    1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
    Q.IsHomogeneous Q.totalDegree ∧
    homogeneousComponent P.totalDegree P = p^k*Q ∧
    PositiveAwayFromZero Q ∧
    (∀ x, eval x p = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt p x ≠ 0) ∧
    2 ≤ p.totalDegree

theorem regular_data_of_nonlinear_data (P : Polynomial8)
    (hminimal : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdegree : 2 ≤ P.totalDegree) (hdata : NonlinearRegularLeadingFactorData8 P) :
    RegularLeadingFactorData8 P := by
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQpos, hregular, hpdegree⟩ := hdata
  obtain ⟨hkodd, hpos, hneg⟩ := Source29PositiveResidualSign.minimal_graph_factor_changes_sign
    P p Q k hminimal hdegree hfactor hQpos
  obtain ⟨x, hx⟩ := Source29HomogeneousRealZero.exists_unit_zero_of_sign_change
    p p.totalDegree hphom (by omega) hpos hneg
  obtain ⟨hne, hhom, hL⟩ := QuarticPolynomialBasics.leading_component_data P hminimal hdegree
  have hQdiv : Q ∣ homogeneousComponent P.totalDegree P :=
    ⟨p^k, hfactor.trans (mul_comm _ _)⟩
  have hQdegree := Source29ComplexObstruction.positive_divisor_obstruction
    (homogeneousComponent P.totalDegree P) Q P.totalDegree hne hhom hL hQhom hQpos hQdiv
  have hQconst : Q = C (Q.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hQdegree
  have ha : Q.coeff 0 ≠ 0 := by
    intro hz
    apply hne
    rw [hfactor, hQconst, hz, map_zero, mul_zero]
  have hpL : Source29FactorInheritance.cubicOperator p = 0 := by
    apply Source29PowerOperator.cubicOperator_pow_mul_C_zero_imp p hp.ne_zero k (by omega)
      (Q.coeff 0) ha
    change QuarticPolynomialBasics.cubicOperator (p^k*C (Q.coeff 0)) = 0
    rw [← hQconst, ← hfactor]
    exact hL
  have hnonflat := Source29PolynomialLinkNonflatness.exists_positive_curvature_on_link_fin8
    p p.totalDegree hphom hp hpdegree hpL x hx.2 hx.1 (hregular x hx)
  exact ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQpos, hpos, hneg, hregular, hnonflat⟩

theorem problem29_of_nonlinear_regular_leading_factor
    (hstructure : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → NonlinearRegularLeadingFactorData8 P) : Math30.Problem29 := by
  apply problem29_of_regular_leading_factor
  intro P hminimal hdegree
  exact regular_data_of_nonlinear_data P hminimal hdegree (hstructure P hminimal hdegree)

end
end Source29NonlinearStructureReduction

/- Component: WeakCalibrationLimits.inc -/
namespace Source29WeakCalibrationLimits

open MeasureTheory MeasureTheory.Measure Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.FluxPolynomial
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- A bounded field whose pairing with every test gradient vanishes. -/
def WeakCalibration (F : (Fin n → ℝ) → Fin n → ℝ) : Prop :=
  (∀ x i, ‖F x i‖ ≤ 1) ∧
  ∀ φ : (Fin n → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ →
    Integrable (testFlux (fun i ↦ Pi.single i 1) φ F) ∧
    (∫ x, testFlux (fun i ↦ Pi.single i 1) φ F x) = 0

/-- The weak identity is closed under almost-everywhere limits with the same bound. -/
theorem weakCalibration_limit {F : ℕ → (Fin n → ℝ) → Fin n → ℝ}
    {G : (Fin n → ℝ) → Fin n → ℝ}
    (hF : ∀ k, WeakCalibration (F k)) (hG : ∀ x i, ‖G x i‖ ≤ 1)
    (hlim : ∀ᵐ x, ∀ i, Tendsto (fun k ↦ F k x i) atTop (𝓝 (G x i))) :
    WeakCalibration G := by
  refine ⟨hG, ?_⟩
  intro φ hφ hcφ
  let v : Fin n → Fin n → ℝ := fun i ↦ Pi.single i 1
  have hl : ∀ᵐ x, Tendsto (fun k ↦ testFlux v φ (F k) x) atTop
      (𝓝 (testFlux v φ G x)) := by
    filter_upwards [hlim] with x hx
    exact testFlux_tendsto v φ hx
  have hm : ∀ k, AEStronglyMeasurable (testFlux v φ (F k)) :=
    fun k ↦ ((hF k).2 φ hφ hcφ).1.aestronglyMeasurable
  have hi : Integrable (testFlux v φ G) := by
    apply (testBound_integrable v hφ hcφ).mono'
      (aestronglyMeasurable_of_tendsto_ae atTop hm hl)
    exact Filter.Eventually.of_forall fun x ↦ norm_testFlux_le_testBound v φ G x (hG x)
  refine ⟨hi, ?_⟩
  have ht : Tendsto (fun k ↦ ∫ x, testFlux v φ (F k) x) atTop
      (𝓝 (∫ x, testFlux v φ G x)) := by
    apply tendsto_integral_of_dominated_convergence (testBound v φ) hm
      (testBound_integrable v hφ hcφ)
    · exact fun k ↦ Filter.Eventually.of_forall fun x ↦
        norm_testFlux_le_testBound v φ (F k) x ((hF k).1 x)
    · exact hl
  have hz : (fun k ↦ ∫ x, testFlux v φ (F k) x) = fun _ ↦ 0 := by
    funext k
    exact ((hF k).2 φ hφ hcφ).2
  rw [hz] at ht
  exact tendsto_nhds_unique ht tendsto_const_nhds

theorem leadingNormalizedField_bound (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ)
    (i : Fin n) : ‖leadingNormalizedField P x i‖ ≤ 1 := by
  unfold leadingNormalizedField
  rw [norm_div, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
  by_cases hg : evaluatedGradient P x = 0
  · simp [hg, radiusSq]
  · have hs := radiusSq_pos_of_ne_zero hg
    apply (div_le_one (Real.sqrt_pos.mpr hs)).2
    have hi : (evaluatedGradient P x i)^2 ≤ radiusSq (evaluatedGradient P x) :=
      Finset.single_le_sum (fun j _ ↦ sq_nonneg (evaluatedGradient P x j))
        (Finset.mem_univ i)
    exact Real.abs_le_sqrt hi

/-- Translations and scalar dilations preserve the classical divergence equation. -/
theorem divergence_affine {F : (Fin n → ℝ) → Fin n → ℝ}
    (hF : ∀ i, ContDiff ℝ 1 (fun x ↦ F x i)) (a : Fin n → ℝ) (r : ℝ) (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (fun y ↦ F (a + r • y)) x =
      r * divergence (fun i ↦ Pi.single i 1) F (a + r • x) := by
  unfold divergence
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  have hd := (((hF i).differentiable (by norm_num) (a + r • x)).hasFDerivAt).comp x
    (((hasFDerivAt_id x).const_smul r).const_add a)
  have he := congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) hd.fderiv
  simpa only [Function.comp_def, ContinuousLinearMap.comp_apply, _root_.smul_apply,
    ContinuousLinearMap.id_apply, map_smul, smul_eq_mul, Pi.smul_apply, id_eq] using he

/-- Every affine rescaling of the leading normalized gradient retains its weak identity. -/
theorem top_affine_weakCalibration (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (a : Fin n → ℝ) (r : ℝ) (hr : r ≠ 0) :
    WeakCalibration (fun x ↦
      leadingNormalizedField (homogeneousComponent P.totalDegree P) (a + r • x)) := by
  refine ⟨fun x i ↦ leadingNormalizedField_bound _ _ _, ?_⟩
  intro φ hφ hcφ
  have hg : ∀ i, ContDiff ℝ 1 (fun x ↦ evaluatedGradient P x i) :=
    fun i ↦ contDiff_eval (pderiv i P)
  have hn := normalizedField_contDiff hg
  let F : ℕ → (Fin n → ℝ) → Fin n → ℝ := fun k x ↦
    normalizedField (evaluatedGradient P) (dilationRadius k • (a + r • x))
  have hF : ∀ k i, ContDiff ℝ 1 (fun x ↦ F k x i) := by
    intro k i
    exact (hn i).comp (by fun_prop)
  have hdiv : ∀ k x, divergence (fun i ↦ Pi.single i 1) (F k) x = 0 := by
    intro k x
    have hd : ∀ i, ContDiff ℝ 1
        (fun y ↦ normalizedField (evaluatedGradient P) (dilationRadius k • y) i) := by
      intro i
      exact (hn i).comp (by fun_prop)
    change divergence (fun i ↦ Pi.single i 1)
      (fun y ↦ (fun z ↦ normalizedField (evaluatedGradient P) (dilationRadius k • z))
        (a + r • y)) x = 0
    rw [divergence_affine hd, divergence_dilate _ hn,
      Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin]
    ring
  have hb : ∀ k x i, ‖F k x i‖ ≤ 1 := fun k x i ↦ normalizedField_norm_le_one _ _ _
  have hq : QuasiMeasurePreserving (fun x : Fin n → ℝ ↦ a + r • x) volume volume :=
    (quasiMeasurePreserving_add_left volume a).comp (quasiMeasurePreserving_smul volume hr)
  have hl := hq.ae (Source29TopWeakCalibration.normalizedGradient_dilates_tendsto_ae P hdeg)
  exact ⟨testFlux_limit_integrable _ hφ hcφ (fun k i ↦ (hF k i).continuous) hb hl,
    integral_testFlux_limit_eq_zero _ hφ hcφ hF hdiv hb hl⟩

end
end Source29WeakCalibrationLimits

/- Component: RealLowestRescale.inc -/
/- A polynomial rescaling at its first homogeneous component. The rescaled
family is defined without division, so it is continuous even at parameter zero. -/

namespace Source29RealLowestRescale

open MvPolynomial Finset
open scoped Topology

noncomputable section

def rescale {n : ℕ} (P : MvPolynomial (Fin n) ℝ) (s : ℕ) (t : ℝ) :
    MvPolynomial (Fin n) ℝ :=
  ∑ k ∈ range (P.totalDegree + 1), C (t ^ (k - s)) * homogeneousComponent k P

theorem totalDegree_rescale_le {n : ℕ} (P : MvPolynomial (Fin n) ℝ)
    (s : ℕ) (t : ℝ) : (rescale P s t).totalDegree ≤ P.totalDegree := by
  apply totalDegree_finsetSum_le
  intro k hk
  have hcomp := (homogeneousComponent_isHomogeneous k P).totalDegree_le
  calc
    (C (t ^ (k - s)) * homogeneousComponent k P).totalDegree ≤
        (C (t ^ (k - s)) : MvPolynomial (Fin n) ℝ).totalDegree +
          (homogeneousComponent k P).totalDegree := totalDegree_mul _ _
    _ ≤ P.totalDegree := by
      rw [totalDegree_C, zero_add]
      exact le_trans hcomp (Nat.le_of_lt_succ (mem_range.mp hk))

theorem rescale_zero {n : ℕ} (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s, homogeneousComponent k P = 0) :
    rescale P s 0 = homogeneousComponent s P := by
  unfold rescale
  rw [Finset.sum_eq_single s]
  · simp
  · intro k hk hks
    by_cases hlt : k < s
    · simp [hlow k hlt]
    · have hpos : 0 < k - s := by omega
      simp [zero_pow hpos.ne']
  · intro hnot
    have hs : P.totalDegree < s := by
      simp only [mem_range, not_lt] at hnot
      omega
    simp [homogeneousComponent_eq_zero s P hs]

/-- Evaluating the rescaled family recovers the original polynomial under a
scalar dilation, with the lowest power removed. The equality holds at zero too. -/
theorem eval_rescale_mul {n : ℕ} (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s, homogeneousComponent k P = 0) (t : ℝ) (y : Fin n → ℝ) :
    t ^ s * eval y (rescale P s t) = eval (fun i => t * y i) P := by
  calc
    t ^ s * eval y (rescale P s t) =
        ∑ k ∈ range (P.totalDegree + 1),
          t ^ s * (t ^ (k - s) * eval y (homogeneousComponent k P)) := by
      simp only [rescale, map_sum, map_mul, eval_C, Finset.mul_sum]
    _ = ∑ k ∈ range (P.totalDegree + 1),
          t ^ k * eval y (homogeneousComponent k P) := by
      apply Finset.sum_congr rfl
      intro k hk
      by_cases hlt : k < s
      · simp [hlow k hlt]
      · rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le (Nat.le_of_not_gt hlt)]
    _ = eval (fun i => t * y i) P := by
      conv_rhs => rw [← sum_homogeneousComponent P]
      simp only [map_sum]
      apply Finset.sum_congr rfl
      intro k hk
      exact (Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous _ k
        (homogeneousComponent_isHomogeneous k P) y t).symm

theorem continuous_eval_rescale {n : ℕ} (P : MvPolynomial (Fin n) ℝ)
    (s : ℕ) (y : Fin n → ℝ) :
    Continuous (fun t : ℝ => eval y (rescale P s t)) := by
  simp only [rescale, map_sum, map_mul, eval_C]
  apply continuous_finsetSum
  intro k hk
  exact (continuous_id.pow (k - s)).mul continuous_const

end
end Source29RealLowestRescale

/- Component: InitialGradientLimit.inc -/
namespace Source29InitialGradientLimit

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29RealLowestRescale
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem pderiv_lowest_components (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s + 1, homogeneousComponent k P = 0) (i : Fin n) :
    ∀ k < s, homogeneousComponent k (pderiv i P) = 0 := by
  intro k hk
  rw [← pderiv_homogeneousComponent, hlow (k + 1) (by omega), map_zero]

/-- Dividing a gradient by its lowest dilation power leaves a family continuous at zero. -/
theorem rescaled_gradient_tendsto (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s + 1, homogeneousComponent k P = 0) (x : Fin n → ℝ) (i : Fin n) :
    Tendsto (fun t : ℝ ↦ eval x (rescale (pderiv i P) s t)) (𝓝 0)
      (𝓝 (evaluatedGradient (homogeneousComponent (s + 1) P) x i)) := by
  have hc := (continuous_eval_rescale (pderiv i P) s x).tendsto 0
  rw [rescale_zero _ _ (pderiv_lowest_components P s hlow i)] at hc
  simpa only [evaluatedGradient, pderiv_homogeneousComponent] using hc

theorem normalized_ratio_pos_scale (v : Fin n → ℝ) {a : ℝ} (ha : 0 < a) (i : Fin n) :
    (a * v i) / Real.sqrt (radiusSq (a • v)) = v i / Real.sqrt (radiusSq v) := by
  have he : radiusSq (a • v) = a ^ 2 * radiusSq v := by
    simp only [radiusSq, Pi.smul_apply, smul_eq_mul, mul_pow, Finset.mul_sum]
  rw [he, Real.sqrt_mul (sq_nonneg a), Real.sqrt_sq_eq_abs, abs_of_pos ha]
  exact mul_div_mul_left _ _ ha.ne'

/-- Normalized gradients converge to that of the first homogeneous component,
where the latter gradient is nonzero. -/
theorem normalized_gradient_initial_limit (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s + 1, homogeneousComponent k P = 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0))
    (x : Fin n → ℝ)
    (hx : evaluatedGradient (homogeneousComponent (s + 1) P) x ≠ 0) (i : Fin n) :
    Tendsto (fun k ↦ leadingNormalizedField P (t k • x) i) atTop
      (𝓝 (leadingNormalizedField (homogeneousComponent (s + 1) P) x i)) := by
  let g : ℕ → Fin n → ℝ := fun k j ↦ eval x (rescale (pderiv j P) s (t k))
  have hg : ∀ j, Tendsto (fun k ↦ g k j) atTop
      (𝓝 (evaluatedGradient (homogeneousComponent (s + 1) P) x j)) :=
    fun j ↦ (rescaled_gradient_tendsto P s hlow x j).comp ht0
  have hs : Tendsto (fun k ↦ radiusSq (g k)) atTop
      (𝓝 (radiusSq (evaluatedGradient (homogeneousComponent (s + 1) P) x))) := by
    exact tendsto_finsetSum _ (fun j _ ↦ (hg j).pow 2)
  have hd := hs.sqrt
  have hdn : Real.sqrt (radiusSq
      (evaluatedGradient (homogeneousComponent (s + 1) P) x)) ≠ 0 :=
    (Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hx)).ne'
  have hl := (hg i).div hd hdn
  have he : ∀ k, leadingNormalizedField P (t k • x) i =
      g k i / Real.sqrt (radiusSq (g k)) := by
    intro k
    have hgrad : evaluatedGradient P (t k • x) = t k ^ s • g k := by
      funext j
      exact (eval_rescale_mul (pderiv j P) s
        (pderiv_lowest_components P s hlow j) (t k) x).symm
    simp only [leadingNormalizedField, hgrad, Pi.smul_apply, smul_eq_mul]
    exact normalized_ratio_pos_scale (g k) (pow_pos (ht k) s) i
  have hf : (fun k ↦ leadingNormalizedField P (t k • x) i) =
      (fun k ↦ g k i / Real.sqrt (radiusSq (g k))) := funext he
  rw [hf]
  exact hl

theorem normalized_gradient_initial_limit_ae (P : MvPolynomial (Fin n) ℝ) (s : ℕ)
    (hlow : ∀ k < s + 1, homogeneousComponent k P = 0)
    (hne : homogeneousComponent (s + 1) P ≠ 0)
    {t : ℕ → ℝ} (ht : ∀ k, 0 < t k) (ht0 : Tendsto t atTop (𝓝 0)) :
    ∀ᵐ x, ∀ i, Tendsto (fun k ↦ leadingNormalizedField P (t k • x) i) atTop
      (𝓝 (leadingNormalizedField (homogeneousComponent (s + 1) P) x i)) := by
  filter_upwards [mvPolynomial_eval_ne_zero_ae n _ hne] with x hx
  apply normalized_gradient_initial_limit P s hlow ht ht0 x
  exact Source29TopWeakCalibration.evaluatedGradient_ne_zero_of_eval_ne_zero _
    (homogeneousComponent_isHomogeneous _ _) (by omega) hx

end
end Source29InitialGradientLimit

/- Component: WeakHomogeneousSign.inc -/
namespace Source29WeakHomogeneousSign

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem homogeneous_not_nonnegative
    (p : MvPolynomial (Fin n) ℝ) {d : ℕ} (hp : p.IsHomogeneous d)
    (hd : 0 < d) (hne : p ≠ 0) (hW : WeakCalibration (leadingNormalizedField p)) :
    ¬ ∀ x, 0 ≤ eval x p := by
  intro hnonneg
  have hflux_nonneg : ∀ᵐ x, 0 ≤
      testFlux (fun i ↦ Pi.single i 1) radialTest (leadingNormalizedField p) x := by
    apply Filter.Eventually.of_forall
    intro x
    rw [radial_flux_leadingNormalizedField p hp x]
    exact mul_nonneg (radialWeight_nonneg x)
      (div_nonneg (mul_nonneg (Nat.cast_nonneg d) (hnonneg x)) (Real.sqrt_nonneg _))
  have hpositive : ∀ᵐ x : Fin n → ℝ, 0 < MvPolynomial.eval x p := by
    filter_upwards [mvPolynomial_eval_ne_zero_ae n p hne] with x hx
    exact lt_of_le_of_ne (hnonneg x) hx.symm
  have hsupport : {x : Fin n → ℝ | radiusSq x < 1} ≤ᵐ[volume]
      Function.support (testFlux (fun i ↦ Pi.single i 1) radialTest
        (leadingNormalizedField p)) := by
    filter_upwards [hpositive] with x hx
    intro hr
    change testFlux (fun i ↦ Pi.single i 1) radialTest (leadingNormalizedField p) x ≠ 0
    rw [radial_flux_leadingNormalizedField p hp x]
    have hgradient := evaluatedGradient_ne_zero_of_pos p hp hd hx
    have hden : 0 < Real.sqrt (radiusSq (evaluatedGradient p x)) :=
      Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hgradient)
    exact (mul_pos (radialWeight_pos x hr)
      (div_pos (mul_pos (by exact_mod_cast hd) hx) hden)).ne'
  have hopen : IsOpen {x : Fin n → ℝ | radiusSq x < 1} :=
    isOpen_lt radiusSq_contDiff.continuous continuous_const
  have hball : 0 < volume {x : Fin n → ℝ | radiusSq x < 1} := by
    exact hopen.measure_pos volume ⟨0, by simp [radiusSq]⟩
  have hi := (hW.2 radialTest radialTest_contDiff radialTest_hasCompactSupport).1
  have hz := (hW.2 radialTest radialTest_contDiff radialTest_hasCompactSupport).2
  have hp := (integral_pos_iff_support_of_nonneg_ae hflux_nonneg hi).2
    (hball.trans_le (measure_mono_ae hsupport))
  rw [hz] at hp
  exact lt_irrefl _ hp

theorem weakCalibration_neg {F : (Fin n → ℝ) → Fin n → ℝ}
    (hF : WeakCalibration F) : WeakCalibration (fun x i ↦ -F x i) := by
  refine ⟨?_, ?_⟩
  · intro x i
    simpa only [norm_neg] using hF.1 x i
  · intro φ hφ hcφ
    have he : testFlux (fun i ↦ Pi.single i 1) φ (fun x i ↦ -F x i) =
        fun x ↦ -testFlux (fun i ↦ Pi.single i 1) φ F x := by
      funext x
      simp only [testFlux, mul_neg, Finset.sum_neg_distrib]
    rw [he]
    exact ⟨(hF.2 φ hφ hcφ).1.neg, by rw [integral_neg, (hF.2 φ hφ hcφ).2, neg_zero]⟩

theorem leadingNormalizedField_neg (p : MvPolynomial (Fin n) ℝ) :
    leadingNormalizedField (-p) = fun x i ↦ -leadingNormalizedField p x i := by
  funext x i
  simp only [leadingNormalizedField, evaluatedGradient, map_neg, radiusSq, neg_sq, neg_div]

theorem homogeneous_changes_sign
    (p : MvPolynomial (Fin n) ℝ) {d : ℕ} (hp : p.IsHomogeneous d)
    (hd : 0 < d) (hne : p ≠ 0) (hW : WeakCalibration (leadingNormalizedField p)) :
    (∃ x, eval x p < 0) ∧ (∃ x, 0 < eval x p) := by
  constructor
  · obtain ⟨x, hx⟩ := not_forall.mp (homogeneous_not_nonnegative p hp hd hne hW)
    exact ⟨x, lt_of_not_ge hx⟩
  · have hn : WeakCalibration (leadingNormalizedField (-p)) := by
      rw [leadingNormalizedField_neg]
      exact weakCalibration_neg hW
    obtain ⟨x, hx⟩ := not_forall.mp
      (homogeneous_not_nonnegative (-p) hp.neg hd (neg_ne_zero.mpr hne) hn)
    refine ⟨x, ?_⟩
    simpa only [map_neg, neg_lt_zero] using lt_of_not_ge hx

end
end Source29WeakHomogeneousSign

/- Component: TopLocalInitial.inc -/
namespace Source29TopLocalInitial

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.FluxPolynomial
open Source29PolynomialTranslation Source29WeakCalibrationLimits
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem leadingNormalizedField_translate (P : MvPolynomial (Fin n) ℝ) (a x : Fin n → ℝ) :
    leadingNormalizedField (translate P a) x = leadingNormalizedField P (a + x) := by
  have hg : evaluatedGradient (translate P a) x = evaluatedGradient P (a + x) := by
    funext i
    change eval x (pderiv i (translate P a)) = eval (a + x) (pderiv i P)
    rw [pderiv_translate, eval_translate]
    rfl
  funext i
  simp only [leadingNormalizedField, hg]

/-- At any point, the lowest positive-degree term of the leading polynomial
inherits its weak gradient calibration. -/
theorem top_initial_weakCalibration (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (a : Fin n → ℝ) (s : ℕ)
    (hlow : ∀ k < s + 1,
      homogeneousComponent k (translate (homogeneousComponent P.totalDegree P) a) = 0)
    (hne : homogeneousComponent (s + 1)
      (translate (homogeneousComponent P.totalDegree P) a) ≠ 0) :
    WeakCalibration (leadingNormalizedField (homogeneousComponent (s + 1)
      (translate (homogeneousComponent P.totalDegree P) a))) := by
  let t : ℕ → ℝ := fun k ↦ (dilationRadius k)⁻¹
  have ht : ∀ k, 0 < t k := fun k ↦ inv_pos.mpr (dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) := tendsto_inv_atTop_zero.comp dilationRadius_tendsto
  apply weakCalibration_limit
    (F := fun k x ↦ leadingNormalizedField (homogeneousComponent P.totalDegree P) (a + t k • x))
  · intro k
    exact top_affine_weakCalibration P hmin hdeg a (t k) (ht k).ne'
  · exact leadingNormalizedField_bound _
  · have hl := Source29InitialGradientLimit.normalized_gradient_initial_limit_ae
      (translate (homogeneousComponent P.totalDegree P) a) s hlow hne ht ht0
    simpa only [leadingNormalizedField_translate] using hl

end
end Source29TopLocalInitial

/- Component: TopLocalSign.inc -/
namespace Source29TopLocalSign

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.FluxPolynomial Source29QuarticReuse.QuarticPolynomialBasics
open Source29PolynomialTranslation Source29RealLowestRescale
open Source29WeakHomogeneousSign Source29TopLocalInitial
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- A strict sign of the initial term occurs arbitrarily close to its center. -/
theorem initial_sign_in_nhds (F : MvPolynomial (Fin n) ℝ) (a : Fin n → ℝ) (s : ℕ)
    (hlow : ∀ k < s, homogeneousComponent k (translate F a) = 0)
    (z : Fin n → ℝ) (c : ℝ) (hcz : 0 < c * eval z (homogeneousComponent s (translate F a)))
    (U : Set (Fin n → ℝ)) (hU : U ∈ 𝓝 a) :
    ∃ x ∈ U, 0 < c * eval x F := by
  let t : ℕ → ℝ := fun k ↦ (dilationRadius k)⁻¹
  have ht : ∀ k, 0 < t k := fun k ↦ inv_pos.mpr (dilationRadius_pos k)
  have ht0 : Tendsto t atTop (𝓝 0) := tendsto_inv_atTop_zero.comp dilationRadius_tendsto
  have hc := (continuous_eval_rescale (translate F a) s z).tendsto 0
  rw [rescale_zero _ _ hlow] at hc
  have hc' : Tendsto (fun k ↦ c * eval z (rescale (translate F a) s (t k))) atTop
      (𝓝 (c * eval z (homogeneousComponent s (translate F a)))) :=
    tendsto_const_nhds.mul (hc.comp ht0)
  have hpos : ∀ᶠ k in atTop, 0 < c * eval z (rescale (translate F a) s (t k)) :=
    (tendsto_order.1 hc').1 0 hcz
  have hp : Tendsto (fun k ↦ a + t k • z) atTop (𝓝 a) := by
    simpa only [zero_smul, add_zero] using
      ((tendsto_const_nhds (x := a)).add (ht0.smul (tendsto_const_nhds (x := z))))
  obtain ⟨k, hkU, hkpos⟩ := ((hp.eventually hU).and hpos).exists
  refine ⟨a + t k • z, hkU, ?_⟩
  have he := eval_rescale_mul (translate F a) s hlow (t k) z
  rw [eval_translate] at he
  have he' : t k ^ s * eval z (rescale (translate F a) s (t k)) =
      eval (a + t k • z) F := he
  rw [← he']
  have hprod := mul_pos (pow_pos (ht k) s) hkpos
  nlinarith [hprod]

/-- Every zero of the leading polynomial is approached by values of both signs. -/
theorem top_changes_sign_in_every_nhds (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (a : Fin n → ℝ)
    (ha : eval a (homogeneousComponent P.totalDegree P) = 0)
    (U : Set (Fin n → ℝ)) (hU : U ∈ 𝓝 a) :
    (∃ x ∈ U, eval x (homogeneousComponent P.totalDegree P) < 0) ∧
    (∃ x ∈ U, 0 < eval x (homogeneousComponent P.totalDegree P)) := by
  have hne : homogeneousComponent P.totalDegree P ≠ 0 :=
    top_homogeneousComponent_ne_zero P (by omega)
  obtain ⟨s, hs, hsdeg, hsne, hslow⟩ := exists_lowest_component_at_root _ hne a ha
  have he : s - 1 + 1 = s := by omega
  have hw := top_initial_weakCalibration P hmin hdeg a (s - 1)
    (by simpa only [he] using hslow) (by simpa only [he] using hsne)
  rw [he] at hw
  obtain ⟨⟨zneg, hzneg⟩, ⟨zpos, hzpos⟩⟩ := homogeneous_changes_sign _
    (homogeneousComponent_isHomogeneous _ _) hs hsne hw
  constructor
  · obtain ⟨x, hxU, hx⟩ := initial_sign_in_nhds _ a s hslow zneg (-1)
      (by simpa using hzneg) U hU
    exact ⟨x, hxU, by simpa using hx⟩
  · obtain ⟨x, hxU, hx⟩ := initial_sign_in_nhds _ a s hslow zpos 1
      (by simpa using hzpos) U hU
    exact ⟨x, hxU, by simpa using hx⟩

/-- A nonnegative factor cannot vanish where its cofactor is nonzero. -/
theorem nonnegative_factor_zero_subset_cofactor_zero
    (P A Q : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (hfactor : homogeneousComponent P.totalDegree P = A * Q)
    (hQnonneg : ∀ x, 0 ≤ eval x Q)
    (a : Fin n → ℝ) (hQzero : eval a Q = 0) : eval a A = 0 := by
  by_contra hA
  have hzero : eval a (homogeneousComponent P.totalDegree P) = 0 := by
    rw [hfactor, map_mul, hQzero, mul_zero]
  rcases lt_or_gt_of_ne hA with hneg | hpos
  · let U : Set (Fin n → ℝ) := {x | eval x A < 0}
    have hU : U ∈ 𝓝 a :=
      (isOpen_lt (contDiff_eval A).continuous continuous_const).mem_nhds hneg
    obtain ⟨x, hxU, hx⟩ := (top_changes_sign_in_every_nhds P hmin hdeg a hzero U hU).2
    rw [hfactor, map_mul] at hx
    exact (not_lt_of_ge (mul_nonpos_of_nonpos_of_nonneg (le_of_lt hxU) (hQnonneg x))) hx
  · let U : Set (Fin n → ℝ) := {x | 0 < eval x A}
    have hU : U ∈ 𝓝 a :=
      (isOpen_lt continuous_const (contDiff_eval A).continuous).mem_nhds hpos
    obtain ⟨x, hxU, hx⟩ := (top_changes_sign_in_every_nhds P hmin hdeg a hzero U hU).1
    rw [hfactor, map_mul] at hx
    exact (not_lt_of_ge (mul_nonneg (le_of_lt hxU) (hQnonneg x))) hx

/-- A factor visible at a real zero of the leading polynomial has odd multiplicity. -/
theorem odd_multiplicity_at_real_zero (P p Q : MvPolynomial (Fin n) ℝ) (k : ℕ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (hk : 1 ≤ k)
    (hfactor : homogeneousComponent P.totalDegree P = p ^ k * Q)
    (a : Fin n → ℝ) (hp : eval a p = 0) (hQ : eval a Q ≠ 0) : Odd k := by
  rcases Nat.even_or_odd k with heven | hodd
  · exfalso
    apply hQ
    apply nonnegative_factor_zero_subset_cofactor_zero P Q (p ^ k) hmin hdeg
    · simpa only [mul_comm] using hfactor
    · intro x
      rw [map_pow]
      exact heven.pow_nonneg _
    · rw [map_pow, hp, zero_pow (by omega)]
  · exact hodd

end
end Source29TopLocalSign

/- Component: RealAffineChart.inc -/

namespace Source29RealAffineChart

open MvPolynomial
open scoped BigOperators

noncomputable section

abbrev Vec (n : ℕ) := Fin n → ℝ
abbrev Poly (n : ℕ) := MvPolynomial (Fin n) ℝ

/-- Finite-variable polynomial extensionality over the real numbers.
This is the finite-variable induction underlying mathlib's MvPolynomial.Funext,
whose general theorem is outside the permitted import closure. -/
theorem eq_of_eval_eq {n : ℕ} (P Q : Poly n)
    (h : ∀ x : Vec n, eval x P = eval x Q) : P = Q := by
  induction n with
  | zero =>
    apply (MvPolynomial.isEmptyRingEquiv ℝ (Fin 0)).injective
    simpa only [isEmptyRingEquiv_eq_coeff_zero, eval_zero, constantCoeff_eq] using h 0
  | succ n ih =>
    apply (finSuccEquiv ℝ n).injective
    apply Polynomial.ext
    intro k
    apply ih
    intro x
    have hx : Polynomial.map (eval x) (finSuccEquiv ℝ n P) =
        Polynomial.map (eval x) (finSuccEquiv ℝ n Q) := by
      apply Polynomial.funext
      intro t
      rw [← eval_eq_eval_mv_eval', ← eval_eq_eval_mv_eval']
      exact h (Fin.cons t x)
    simpa only [Polynomial.coeff_map] using
      congrArg (fun p : Polynomial ℝ => p.coeff k) hx

/-- Polynomial for one coordinate of a linear transformation. -/
def linearCoordinate {n : ℕ} (A : Vec n →ₗ[ℝ] Vec n) (i : Fin n) : Poly n :=
  ∑ j, C (A (Pi.single j 1) i) * X j

theorem eval_linearCoordinate {n : ℕ} (A : Vec n →ₗ[ℝ] Vec n)
    (i : Fin n) (x : Vec n) : eval x (linearCoordinate A i) = A x i := by
  simp only [linearCoordinate, map_sum, map_mul, eval_C, eval_X]
  conv_rhs => rw [pi_eq_sum_univ' x]
  simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- Pull a polynomial back by the affine map x ↦ z+A x. -/
def affinePullback {n : ℕ} (A : Vec n →ₗ[ℝ] Vec n) (z : Vec n) :
    Poly n →ₐ[ℝ] Poly n :=
  aeval (fun i => C (z i) + linearCoordinate A i)

lemma affinePullback_X {n : ℕ} (A : Vec n →ₗ[ℝ] Vec n) (z : Vec n) (i : Fin n) :
    affinePullback A z (X i) = C (z i) + linearCoordinate A i := by
  simp [affinePullback]

theorem eval_affinePullback {n : ℕ} (A : Vec n →ₗ[ℝ] Vec n)
    (z x : Vec n) (P : Poly n) :
    eval x (affinePullback A z P) = eval (z+A x) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [affinePullback]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, affinePullback_X, map_add, eval_C, eval_linearCoordinate, eval_X,
      Pi.add_apply, hp]

theorem affinePullback_inverse_left {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n)
    (z : Vec n) (P : Poly n) :
    affinePullback A.symm.toLinearMap (-A.symm z) (affinePullback A.toLinearMap z P) = P := by
  apply eq_of_eval_eq
  intro x
  rw [eval_affinePullback, eval_affinePullback]
  simp

theorem affinePullback_inverse_right {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n)
    (z : Vec n) (P : Poly n) :
    affinePullback A.toLinearMap z (affinePullback A.symm.toLinearMap (-A.symm z) P) = P := by
  apply eq_of_eval_eq
  intro x
  rw [eval_affinePullback, eval_affinePullback]
  simp

/-- Invertible affine changes of variables act by algebra equivalences. -/
def affineEquiv {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n) (z : Vec n) : Poly n ≃ₐ[ℝ] Poly n :=
  AlgEquiv.ofAlgHom (affinePullback A.toLinearMap z)
    (affinePullback A.symm.toLinearMap (-A.symm z))
    (by apply DFunLike.ext; intro P; exact affinePullback_inverse_right A z P)
    (by apply DFunLike.ext; intro P; exact affinePullback_inverse_left A z P)

lemma affineEquiv_apply {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n) (z : Vec n) (P : Poly n) :
    affineEquiv A z P = affinePullback A.toLinearMap z P := rfl

lemma affineEquiv_symm_apply {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n) (z : Vec n) (P : Poly n) :
    (affineEquiv A z).symm P = affinePullback A.symm.toLinearMap (-A.symm z) P := rfl

theorem affine_irreducible {n : ℕ} (A : Vec n ≃ₗ[ℝ] Vec n) (z : Vec n)
    (P : Poly n) (hP : Irreducible P) : Irreducible (affineEquiv A z P) :=
  (MulEquiv.irreducible_iff (affineEquiv A z)).mpr hP

/-- First change coordinates, then distinguish the zeroth coordinate as the
univariate polynomial variable. There remain n parameter variables. -/
def curriedChart {n : ℕ} (A : Vec (n+1) ≃ₗ[ℝ] Vec (n+1)) (z : Vec (n+1)) :
    Poly (n+1) ≃ₐ[ℝ] Polynomial (Poly n) :=
  (affineEquiv A z).trans (finSuccEquiv ℝ n)

lemma curriedChart_apply {n : ℕ} (A : Vec (n+1) ≃ₗ[ℝ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) :
    curriedChart A z P = finSuccEquiv ℝ n (affinePullback A.toLinearMap z P) := rfl

theorem curried_irreducible {n : ℕ} (A : Vec (n+1) ≃ₗ[ℝ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) (hP : Irreducible P) :
    Irreducible (curriedChart A z P) :=
  (MulEquiv.irreducible_iff (curriedChart A z)).mpr hP

theorem eval_curriedChart {n : ℕ} (A : Vec (n+1) ≃ₗ[ℝ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) (ζ : Vec n) (w : ℝ) :
    Polynomial.eval w (Polynomial.map (eval ζ) (curriedChart A z P)) =
      eval (z+A (Fin.cons w ζ)) P := by
  rw [curriedChart_apply, ← eval_eq_eval_mv_eval', eval_affinePullback]
  rfl

/-- A positive-order root in a specialization ensures positive degree in
the distinguished variable before specialization. -/
theorem natDegree_ne_zero_of_specialization_factor
    {R F : Type*} [Semiring R] [Semiring F] [Nontrivial F]
    (p : Polynomial R) (f : R →+* F) (s : ℕ) (hs : 0 < s) (g : Polynomial F)
    (hg : g.coeff 0 ≠ 0) (hp : p.map f = Polynomial.X^s*g) : p.natDegree ≠ 0 := by
  have hc : (p.map f).coeff s ≠ 0 := by
    rw [hp]
    have hcs : (Polynomial.X^s*g).coeff s = g.coeff 0 := by
      simpa only [zero_add] using Polynomial.coeff_X_pow_mul g s 0
    rw [hcs]
    exact hg
  have hle := (Polynomial.le_natDegree_of_ne_zero hc).trans Polynomial.natDegree_map_le
  omega

end
end Source29RealAffineChart

/- Component: RealSliceBezout.inc -/
namespace Source29RealSliceBezout

open Polynomial MvPolynomial

noncomputable section

/-- A coprime cofactor has a nonzero parameter certificate, after clearing fractions. -/
theorem exists_coprime_certificate
    {R : Type*} [CommRing R] [IsDomain R] [IsGCDMonoid R]
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
    (p q : Polynomial R) (hp : Irreducible p) (hdegree : p.natDegree ≠ 0)
    (hpq : ¬ p ∣ q) :
    ∃ (D : R) (A B : Polynomial R), D ≠ 0 ∧ A*p+B*q = Polynomial.C D := by
  have hpprim := hp.isPrimitive hdegree
  have hpK : Irreducible (p.map (algebraMap R K)) :=
    hpprim.irreducible_iff_irreducible_map_fraction_map.mp hp
  have hnd : ¬ p.map (algebraMap R K) ∣ q.map (algebraMap R K) := by
    intro h
    exact hpq (hpprim.dvd_of_fraction_map_dvd_fraction_map h)
  apply Source29WholeSliceBezout.exists_nonzero_bezout_of_fraction_coprime K p q
  exact (hpK.isCoprime_or_dvd _).resolve_right hnd

/-- A specialized Bezout identity prevents simultaneous vanishing. -/
theorem cofactor_ne_zero_of_certificate
    {R : Type*} [CommRing R] (p q : Polynomial R) (D : R) (A B : Polynomial R)
    (hcert : A*p+B*q = Polynomial.C D)
    (f : R →+* ℝ) (hD : f D ≠ 0) (t : ℝ)
    (hp : (p.map f).eval t = 0) : (q.map f).eval t ≠ 0 := by
  intro hq
  have h := congrArg (fun u : Polynomial R ↦ (u.map f).eval t) hcert
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, hp, hq,
    mul_zero, add_zero] at h
  exact hD h.symm

end
end Source29RealSliceBezout

/- Component: RealSliceRegularZero.inc -/
namespace Source29RealSliceRegularZero

open MeasureTheory Filter MvPolynomial
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29RealSliceBezout
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem slice_eval_eq (p : Polynomial (MvPolynomial (Fin n) ℝ))
    (z : Fin n → ℝ) (t : ℝ) :
    (p.map (eval z)).eval t = eval (Fin.cons t z) ((finSuccEquiv ℝ n).symm p) := by
  rw [eval_eq_eval_mv_eval']
  simp

theorem continuous_slice_parameter (p : Polynomial (MvPolynomial (Fin n) ℝ)) (t : ℝ) :
    Continuous (fun z : Fin n → ℝ ↦ (p.map (eval z)).eval t) := by
  simp_rw [slice_eval_eq]
  exact (contDiff_eval _).continuous.comp (by fun_prop)

/-- A real sign-changing slice can be perturbed to a simple zero away from a coprime cofactor. -/
theorem exists_regular_root_away_cofactor
    (p q : Polynomial (MvPolynomial (Fin n) ℝ)) (hp : Irreducible p) (hpq : ¬ p ∣ q)
    (y : Fin n → ℝ) (r s : ℝ) (hrs : r ≤ s)
    (hneg : (p.map (eval y)).eval r < 0) (hpos : 0 < (p.map (eval y)).eval s) :
    ∃ (z : Fin n → ℝ) (t : ℝ),
      (p.map (eval z)).eval t = 0 ∧
      (p.map (eval z)).derivative.eval t ≠ 0 ∧
      (q.map (eval z)).eval t ≠ 0 := by
  have hd : p.natDegree ≠ 0 := by
    intro hd
    have he := Polynomial.eq_C_of_natDegree_eq_zero hd
    rw [he] at hneg hpos
    simp only [Polynomial.map_C, Polynomial.eval_C] at hneg hpos
    linarith
  obtain ⟨D, A, B, hD, hcertD⟩ :=
    Source29WholeSliceBezout.exists_nonzero_bezout_of_irreducible
      (FractionRing (MvPolynomial (Fin n) ℝ)) p hp hd
  obtain ⟨E, C, F, hE, hcertE⟩ := exists_coprime_certificate
    (FractionRing (MvPolynomial (Fin n) ℝ)) p q hp hd hpq
  let U : Set (Fin n → ℝ) := {z | (p.map (eval z)).eval r < 0 ∧ 0 < (p.map (eval z)).eval s}
  have hU : IsOpen U :=
    (isOpen_lt (continuous_slice_parameter p r) continuous_const).inter
      (isOpen_lt continuous_const (continuous_slice_parameter p s))
  have hUpos : 0 < volume U := hU.measure_pos volume ⟨y, hneg, hpos⟩
  obtain ⟨z, hzU, hz⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hUpos.ne'
    (ae_restrict_of_ae (mvPolynomial_eval_ne_zero_ae n (D * E) (mul_ne_zero hD hE)))
  have hzD : eval z D ≠ 0 := by
    rw [map_mul] at hz
    exact (mul_ne_zero_iff.mp hz).1
  have hzE : eval z E ≠ 0 := by
    rw [map_mul] at hz
    exact (mul_ne_zero_iff.mp hz).2
  have hrange := intermediate_value_Icc hrs (p.map (eval z)).continuous.continuousOn
  obtain ⟨t, ht, hroot⟩ := hrange ⟨hzU.1.le, hzU.2.le⟩
  refine ⟨z, t, hroot, ?_, ?_⟩
  · have he := cofactor_ne_zero_of_certificate p p.derivative D A B hcertD (eval z) hzD t hroot
    simpa only [Polynomial.derivative_map] using he
  · exact cofactor_ne_zero_of_certificate p q E C F hcertE (eval z) hzE t hroot

end
end Source29RealSliceRegularZero

/- Component: RealLineCoordinates.inc -/
namespace Source29RealLineCoordinates

open MvPolynomial
open Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticNormalization
open scoped BigOperators Matrix

noncomputable section

/-- An orthogonal coordinate change puts any nonzero displacement on the first axis. -/
theorem exists_axis_coordinates {n : ℕ} (v : Fin (n + 1) → ℝ) (hv : v ≠ 0) :
    ∃ (A : (Fin (n + 1) → ℝ) ≃ₗ[ℝ] (Fin (n + 1) → ℝ)) (r : ℝ),
      0 < r ∧ A (Fin.cons r (0 : Fin n → ℝ)) = v := by
  let r := Real.sqrt (radiusSq v)
  have hr : 0 < r := Real.sqrt_pos.mpr (radiusSq_pos_of_ne_zero hv)
  let e : Fin (n + 1) → ℝ := fun i ↦ v i / r
  have he : ∑ i, (e i)^2 = 1 := by
    simp only [e, div_pow, ← Finset.sum_div]
    change radiusSq v / r ^ 2 = 1
    rw [show r ^ 2 = radiusSq v from Real.sq_sqrt (le_of_lt (radiusSq_pos_of_ne_zero hv))]
    exact div_self (radiusSq_pos_of_ne_zero hv).ne'
  obtain ⟨U, hUt, hU, hcol⟩ := exists_orthogonal_with_column (0 : Fin (n + 1)) e he
  refine ⟨Matrix.toLin'OfInv hUt hU, r, hr, ?_⟩
  funext i
  change (∑ j, U i j * (Fin.cons r (0 : Fin n → ℝ) : Fin (n + 1) → ℝ) j) = v i
  rw [Fin.sum_univ_succ]
  simp only [Fin.cons_zero, Fin.cons_succ, Pi.zero_apply, mul_zero,
    Finset.sum_const_zero, add_zero, hcol]
  exact div_mul_cancel₀ (v i) hr.ne'

end
end Source29RealLineCoordinates

/- Component: RealRegularZero.inc -/
namespace Source29RealRegularZero

open MvPolynomial
open Source29RealAffineChart Source29RealSliceRegularZero Source29RealLineCoordinates
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29QuarticReuse.FluxObstruction
open scoped BigOperators

noncomputable section

/-- A sign-changing real irreducible polynomial has a regular real zero
outside the zero set of any cofactor not divisible by it. -/
theorem exists_regular_zero_away_cofactor {n : ℕ}
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (a b : Fin (n + 1) → ℝ) (ha : eval a P < 0) (hb : 0 < eval b P) :
    ∃ x, eval x P = 0 ∧ evaluatedGradient P x ≠ 0 ∧ eval x Q ≠ 0 := by
  have hv : b - a ≠ 0 := by
    intro h
    have hba : b = a := sub_eq_zero.mp h
    rw [hba] at hb
    linarith
  obtain ⟨A, r, hr, hAr⟩ := exists_axis_coordinates (b - a) hv
  let p := curriedChart A a P
  let q := curriedChart A a Q
  have hp : Irreducible p := curried_irreducible A a P hP
  have hpq : ¬ p ∣ q := by
    intro h
    apply hPQ
    exact (map_dvd_iff (curriedChart A a).toRingEquiv).mp h
  have hcons0 : (Fin.cons (0 : ℝ) (0 : Fin n → ℝ) : Fin (n + 1) → ℝ) = 0 := by
    funext i
    exact Fin.cases rfl (fun _ ↦ rfl) i
  have hneg : (p.map (eval (0 : Fin n → ℝ))).eval 0 < 0 := by
    simpa only [p, eval_curriedChart, hcons0, map_zero, add_zero] using ha
  have hpos : 0 < (p.map (eval (0 : Fin n → ℝ))).eval r := by
    simpa only [p, eval_curriedChart, hAr, add_sub_cancel] using hb
  obtain ⟨z, t, hroot, hder, hcofactor⟩ :=
    exists_regular_root_away_cofactor p q hp hpq 0 0 r hr.le hneg hpos
  let x := a + A (Fin.cons t z)
  refine ⟨x, ?_, ?_, ?_⟩
  · simpa only [p, eval_curriedChart] using hroot
  · intro hgrad
    have hzero : evalFDeriv P x = 0 := by
      ext v
      rw [evalFDeriv_apply]
      have hi : ∀ i, eval x (pderiv i P) = 0 := fun i ↦ congrFun hgrad i
      simp only [hi, zero_mul, Finset.sum_const_zero, zero_apply]
    have hline : Differentiable ℝ (fun u : ℝ ↦ (Fin.cons u z : Fin (n + 1) → ℝ)) := by
      apply differentiable_pi.mpr
      intro i
      exact Fin.cases differentiable_id (fun _ ↦ differentiable_const _) i
    have hcurve : Differentiable ℝ (fun u : ℝ ↦ a + A (Fin.cons u z)) :=
      (differentiable_const a).add (A.toContinuousLinearEquiv.differentiable.comp hline)
    have hc := (hasFDerivAt_eval P x).comp_hasDerivAt t ((hcurve t).hasDerivAt)
    rw [hzero] at hc
    have hd : HasDerivAt (fun u : ℝ ↦ eval (a + A (Fin.cons u z)) P)
        ((p.map (eval z)).derivative.eval t) t := by
      simpa only [p, eval_curriedChart] using (p.map (eval z)).hasDerivAt t
    exact hder (hd.unique hc)
  · simpa only [q, eval_curriedChart] using hcofactor

/-- Vanishing on the regular real locus of an irreducible sign-changing
polynomial already implies algebraic divisibility. -/
theorem dvd_of_vanishing_on_regular_real_zeros {n : ℕ}
    (P Q : MvPolynomial (Fin (n + 1)) ℝ) (hP : Irreducible P)
    (a b : Fin (n + 1) → ℝ) (ha : eval a P < 0) (hb : 0 < eval b P)
    (hQ : ∀ x, eval x P = 0 → evaluatedGradient P x ≠ 0 → eval x Q = 0) : P ∣ Q := by
  by_contra hnd
  obtain ⟨x, hx, hreg, hne⟩ := exists_regular_zero_away_cofactor P Q hP hnd a b ha hb
  exact hne (hQ x hx hreg)

end
end Source29RealRegularZero

/- Component: OddLeadingFactor.inc -/
namespace Source29OddLeadingFactor

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.FluxObstruction

noncomputable section

/-- Every sign-changing irreducible factor of a minimal graph's leading term
occurs with odd multiplicity once the cofactor is relatively prime to it. -/
theorem sign_changing_factor_has_odd_multiplicity
    (P p Q : MvPolynomial (Fin 8) ℝ) (k : ℕ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (hk : 1 ≤ k)
    (hp : Irreducible p) (hQ : ¬p ∣ Q)
    (hfactor : homogeneousComponent P.totalDegree P = p ^ k * Q)
    (hpos : ∃ b, 0 < eval b p) (hneg : ∃ a, eval a p < 0) :
    Odd k ∧ ∃ x, eval x p = 0 ∧ evaluatedGradient p x ≠ 0 ∧ eval x Q ≠ 0 := by
  obtain ⟨a, ha⟩ := hneg
  obtain ⟨b, hb⟩ := hpos
  obtain ⟨x, hx, hreg, hne⟩ :=
    Source29RealRegularZero.exists_regular_zero_away_cofactor p Q hp hQ a b ha hb
  exact ⟨Source29TopLocalSign.odd_multiplicity_at_real_zero
    P p Q k hmin hdeg hk hfactor x hx hne, x, hx, hreg, hne⟩

/-- The proved real leading factorization has odd multiplicity and an actual
regular real zero away from its cofactor. -/
theorem minimal_graph_leading_factor_odd (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    ∃ (p Q : MvPolynomial (Fin 8) ℝ) (k : ℕ),
      1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
      Q.IsHomogeneous Q.totalDegree ∧ homogeneousComponent P.totalDegree P = p^k*Q ∧ ¬p ∣ Q ∧
      (∃ a, 0 < eval a p) ∧ (∃ b, eval b p < 0) ∧ p ∣ cubicOperator p ∧ Odd k ∧
      ∃ x, eval x p = 0 ∧ evaluatedGradient p x ≠ 0 ∧ eval x Q ≠ 0 := by
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQ, hpos, hneg, hL⟩ :=
    Source29RealLeadingFactor.minimal_graph_leading_factor P hmin hdeg
  obtain ⟨hodd, hreal⟩ := sign_changing_factor_has_odd_multiplicity
    P p Q k hmin hdeg hk hp hQ hfactor hpos hneg
  exact ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQ, hpos, hneg, hL, hodd, hreal⟩

end
end Source29OddLeadingFactor

/- Component: ConnectedResidualSign.inc -/
namespace Source29ConnectedResidualSign

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open scoped Topology

noncomputable section

theorem constant_sign_on_preconnected {X : Type*} [TopologicalSpace X]
    {S : Set X} (hS : IsPreconnected S) {f : X → ℝ} (hf : ContinuousOn f S)
    (hn : ∀ x ∈ S, f x ≠ 0) :
    (∀ x ∈ S, 0 < f x) ∨ (∀ x ∈ S, f x < 0) := by
  by_cases hpos : ∀ x ∈ S, 0 < f x
  · exact Or.inl hpos
  · right
    push Not at hpos
    obtain ⟨a, ha, hfa⟩ := hpos
    have han : f a < 0 := lt_of_le_of_ne hfa (hn a ha)
    intro b hb
    by_contra hbn
    have hbp : 0 < f b := lt_of_le_of_ne (le_of_not_gt hbn) (hn b hb).symm
    obtain ⟨c, hc, hfc⟩ := hS.intermediate_value ha hb hf ⟨han.le, hbp.le⟩
    exact hn c hc hfc

variable {n : ℕ}

theorem nonneg_of_nonneg_on_polynomial_nonzero
    (F G : MvPolynomial (Fin n) ℝ) (hF : F ≠ 0)
    (hG : ∀ x, eval x F ≠ 0 → 0 ≤ eval x G) : ∀ x, 0 ≤ eval x G := by
  have hd : Dense {x : Fin n → ℝ | eval x F ≠ 0} :=
    Measure.dense_of_ae (μ := volume) (mvPolynomial_eval_ne_zero_ae n F hF)
  exact hd.induction hG (isClosed_le continuous_const (contDiff_eval G).continuous)

theorem nonpos_of_nonpos_on_polynomial_nonzero
    (F G : MvPolynomial (Fin n) ℝ) (hF : F ≠ 0)
    (hG : ∀ x, eval x F ≠ 0 → eval x G ≤ 0) : ∀ x, eval x G ≤ 0 := by
  have hd : Dense {x : Fin n → ℝ | eval x F ≠ 0} :=
    Measure.dense_of_ae (μ := volume) (mvPolynomial_eval_ne_zero_ae n F hF)
  exact hd.induction hG (isClosed_le (contDiff_eval G).continuous continuous_const)

/-- Connected positive and negative regions force the residual of an odd
sign-changing factor to have one weak sign throughout the space. -/
theorem residual_one_sign_of_preconnected
    (F p Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : Odd k) (hF : F ≠ 0)
    (hfactor : F = p^k*Q)
    (hp_pos : ∃ x, 0 < eval x p) (hp_neg : ∃ x, eval x p < 0)
    (hpos : IsPreconnected {x : Fin n → ℝ | 0 < eval x F})
    (hneg : IsPreconnected {x : Fin n → ℝ | eval x F < 0}) :
    (∀ x, 0 ≤ eval x Q) ∨ (∀ x, eval x Q ≤ 0) := by
  have hpne : ∀ x, eval x F ≠ 0 → eval x p ≠ 0 := by
    intro x hx hpz
    apply hx
    rw [hfactor, map_mul, map_pow, hpz, zero_pow (by obtain ⟨j, hj⟩ := hk; omega : k ≠ 0), zero_mul]
  have hsp := constant_sign_on_preconnected hpos (contDiff_eval p).continuous.continuousOn
    (fun x hx ↦ hpne x hx.ne')
  have hsn := constant_sign_on_preconnected hneg (contDiff_eval p).continuous.continuousOn
    (fun x hx ↦ hpne x hx.ne)
  rcases hsp with hpp | hpn <;> rcases hsn with hnp | hnn
  · have hglobal : ∀ x, 0 ≤ eval x p :=
      nonneg_of_nonneg_on_polynomial_nonzero F p hF (by
        intro x hx
        rcases lt_or_gt_of_ne hx with hlt | hgt
        · exact (hnp x hlt).le
        · exact (hpp x hgt).le)
    obtain ⟨x, hx⟩ := hp_neg
    exact (not_lt_of_ge (hglobal x) hx).elim
  · left
    apply nonneg_of_nonneg_on_polynomial_nonzero F Q hF
    intro x hx
    have he : eval x F = (eval x p)^k * eval x Q := by rw [hfactor, map_mul, map_pow]
    rcases lt_or_gt_of_ne hx with hlt | hgt
    · have hpk : (eval x p)^k < 0 := hk.pow_neg_iff.mpr (hnn x hlt)
      rw [he] at hlt
      rcases mul_neg_iff.mp hlt with h | h <;> linarith [h.1, h.2]
    · have hpk : 0 < (eval x p)^k := hk.pow_pos_iff.mpr (hpp x hgt)
      rw [he] at hgt
      exact ((mul_pos_iff_of_pos_left hpk).mp hgt).le
  · right
    apply nonpos_of_nonpos_on_polynomial_nonzero F Q hF
    intro x hx
    have he : eval x F = (eval x p)^k * eval x Q := by rw [hfactor, map_mul, map_pow]
    rcases lt_or_gt_of_ne hx with hlt | hgt
    · have hpk : 0 < (eval x p)^k := hk.pow_pos_iff.mpr (hnp x hlt)
      rw [he] at hlt
      rcases mul_neg_iff.mp hlt with h | h <;> linarith [h.1, h.2]
    · have hpk : (eval x p)^k < 0 := hk.pow_neg_iff.mpr (hpn x hgt)
      rw [he] at hgt
      rcases mul_pos_iff.mp hgt with h | h <;> linarith [h.1, h.2]
  · have hglobal : ∀ x, eval x p ≤ 0 :=
      nonpos_of_nonpos_on_polynomial_nonzero F p hF (by
        intro x hx
        rcases lt_or_gt_of_ne hx with hlt | hgt
        · exact (hnn x hlt).le
        · exact (hpn x hgt).le)
    obtain ⟨x, hx⟩ := hp_pos
    exact (not_lt_of_ge (hglobal x) hx).elim

end
end Source29ConnectedResidualSign

/- Component: ConnectedFactorStructure.inc -/
namespace Source29ConnectedFactorStructure

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.FluxObstruction

noncomputable section

variable {n : ℕ}

theorem irreducible_neg_of_irreducible (p : MvPolynomial (Fin n) ℝ) (hp : Irreducible p) :
    Irreducible (-p) := by
  have hunit : IsUnit (-1 : MvPolynomial (Fin n) ℝ) := by simp
  simpa only [neg_one_mul] using (irreducible_isUnit_mul hunit).mpr hp

/-- Once residual zeros lie on the factor, the factor and full polynomial
have exactly the same positive and negative regions. -/
theorem sign_regions_eq_of_nonnegative_residual
    (F p Q : MvPolynomial (Fin n) ℝ) (k : ℕ) (hk : Odd k)
    (hfactor : F = p^k*Q) (hQ : ∀ x, 0 ≤ eval x Q)
    (hzero : ∀ x, eval x Q = 0 → eval x p = 0) :
    {x | 0 < eval x F} = {x | 0 < eval x p} ∧
    {x | eval x F < 0} = {x | eval x p < 0} := by
  have he (x) : eval x F = (eval x p)^k * eval x Q := by rw [hfactor, map_mul, map_pow]
  have hQp (x) (hp : eval x p ≠ 0) : 0 < eval x Q :=
    lt_of_le_of_ne (hQ x) (Ne.symm (fun h ↦ hp (hzero x h)))
  have hQF (x) (hF : eval x F ≠ 0) : 0 < eval x Q := by
    apply lt_of_le_of_ne (hQ x)
    intro hz
    apply hF
    rw [he, ← hz, mul_zero]
  constructor
  · ext x
    change (0 < eval x F) ↔ (0 < eval x p)
    constructor
    · intro hx
      have hq := hQF x hx.ne'
      rw [he] at hx
      exact hk.pow_pos_iff.mp ((mul_pos_iff_of_pos_right hq).mp hx)
    · intro hx
      rw [he]
      exact mul_pos (hk.pow_pos_iff.mpr hx) (hQp x hx.ne')
  · ext x
    change (eval x F < 0) ↔ (eval x p < 0)
    constructor
    · intro hx
      have hq := hQF x hx.ne
      rw [he] at hx
      apply hk.pow_neg_iff.mp
      rcases mul_neg_iff.mp hx with h | h <;> linarith [h.1, h.2]
    · intro hx
      rw [he]
      exact mul_neg_of_neg_of_pos (hk.pow_neg_iff.mpr hx) (hQp x hx.ne)

/-- With connected sign regions, the leading factorization can be oriented so
that its residual is nonnegative and every residual zero is a factor zero. -/
theorem minimal_graph_nonnegative_leading_factor (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (hpos : IsPreconnected {x : Fin 8 → ℝ | 0 < eval x (homogeneousComponent P.totalDegree P)})
    (hneg : IsPreconnected {x : Fin 8 → ℝ | eval x (homogeneousComponent P.totalDegree P) < 0}) :
    ∃ (p Q : MvPolynomial (Fin 8) ℝ) (k : ℕ),
      1 ≤ k ∧ Odd k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
      Q.IsHomogeneous Q.totalDegree ∧ homogeneousComponent P.totalDegree P = p^k*Q ∧ ¬p ∣ Q ∧
      (∃ a, 0 < eval a p) ∧ (∃ b, eval b p < 0) ∧
      (∀ x, 0 ≤ eval x Q) ∧ (∀ x, eval x Q = 0 → eval x p = 0) ∧
      p ∣ cubicOperator p ∧ ∃ x, eval x p = 0 ∧ evaluatedGradient p x ≠ 0 ∧ eval x Q ≠ 0 := by
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hnot, hppos, hpneg, hpL, hodd, hreg⟩ :=
    Source29OddLeadingFactor.minimal_graph_leading_factor_odd P hmin hdeg
  obtain ⟨hFne, hFhom, hFL⟩ := QuarticPolynomialBasics.leading_component_data P hmin hdeg
  have hone := Source29ConnectedResidualSign.residual_one_sign_of_preconnected
    (homogeneousComponent P.totalDegree P) p Q k hodd hFne hfactor hppos hpneg hpos hneg
  have hnorm : ∃ p' Q' : MvPolynomial (Fin 8) ℝ,
      Irreducible p' ∧ p'.IsHomogeneous p'.totalDegree ∧ Q'.IsHomogeneous Q'.totalDegree ∧
      homogeneousComponent P.totalDegree P = p'^k*Q' ∧ ¬p' ∣ Q' ∧
      (∃ x, 0 < eval x p') ∧ (∃ x, eval x p' < 0) ∧ (∀ x, 0 ≤ eval x Q') := by
    rcases hone with hnonneg | hnonpos
    · exact ⟨p, Q, hp, hphom, hQhom, hfactor, hnot, hppos, hpneg, hnonneg⟩
    · refine ⟨-p, -Q, irreducible_neg_of_irreducible p hp, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · simpa only [totalDegree_neg] using hphom.neg
      · simpa only [totalDegree_neg] using hQhom.neg
      · rw [hodd.neg_pow, neg_mul_neg]
        exact hfactor
      · simpa using hnot
      · obtain ⟨x, hx⟩ := hpneg
        exact ⟨x, by simpa only [map_neg, neg_pos] using hx⟩
      · obtain ⟨x, hx⟩ := hppos
        exact ⟨x, by simpa only [map_neg, neg_lt_zero] using hx⟩
      · intro x
        simpa only [map_neg, neg_nonneg] using hnonpos x
  obtain ⟨p', Q', hp', hp'hom, hQ'hom, hfactor', hnot', hpos', hneg', hQnonneg⟩ := hnorm
  have hzero : ∀ x, eval x Q' = 0 → eval x p' = 0 := by
    intro x hx
    have hz := Source29TopLocalSign.nonnegative_factor_zero_subset_cofactor_zero
      P (p'^k) Q' hmin hdeg hfactor' hQnonneg x hx
    by_contra hpn
    exact pow_ne_zero k hpn (by simpa only [map_pow] using hz)
  have hL' : p' ∣ cubicOperator p' :=
    Source29RealLeadingFactor.real_factor_inheritance p' Q' k hk hp' hnot'
      (by rwa [← hfactor'])
  obtain ⟨a, ha⟩ := hneg'
  obtain ⟨b, hb⟩ := hpos'
  have hreal := Source29RealRegularZero.exists_regular_zero_away_cofactor p' Q' hp' hnot' a b ha hb
  exact ⟨p', Q', k, hk, hodd, hp', hp'hom, hQ'hom, hfactor', hnot',
    ⟨b, hb⟩, ⟨a, ha⟩, hQnonneg, hzero, hL', hreal⟩

end
end Source29ConnectedFactorStructure

/- Component: TopPhaseBoundary.inc -/
namespace Source29TopPhaseBoundary

open MvPolynomial Set
open Source29QuarticReuse.FluxPolynomial
open scoped Topology

noncomputable section

section Topology
variable {X : Type*} [TopologicalSpace X] {f : X → ℝ}

theorem positive_closure (hf : Continuous f)
    (hz : ∀ x, f x = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, 0 < f y) :
    closure {x | 0 < f x} = {x | 0 ≤ f x} := by
  apply Set.Subset.antisymm (closure_lt_subset_le continuous_const hf)
  intro x hx
  by_cases h0 : f x = 0
  · apply mem_closure_iff.mpr
    intro U hU hxU
    obtain ⟨y, hyU, hy⟩ := hz x h0 U (hU.mem_nhds hxU)
    exact ⟨y, hyU, hy⟩
  · exact subset_closure (lt_of_le_of_ne hx (Ne.symm h0))

theorem negative_closure (hf : Continuous f)
    (hz : ∀ x, f x = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, f y < 0) :
    closure {x | f x < 0} = {x | f x ≤ 0} := by
  have h := positive_closure hf.neg (by
    intro x hx U hU
    obtain ⟨y, hyU, hy⟩ := hz x (neg_eq_zero.mp hx) U hU
    exact ⟨y, hyU, neg_pos.mpr hy⟩)
  simpa only [Pi.neg_apply, neg_pos, neg_nonneg] using h

theorem positive_frontier (hf : Continuous f)
    (hc : closure {x | 0 < f x} = {x | 0 ≤ f x}) :
    frontier {x | 0 < f x} = {x | f x = 0} := by
  rw [frontier, hc, (isOpen_lt continuous_const hf).interior_eq]
  ext x
  simp only [Set.mem_sdiff, Set.mem_ofPred_eq, not_lt]
  exact ⟨fun h ↦ le_antisymm h.2 h.1, fun h ↦ by simp [h]⟩

theorem negative_frontier (hf : Continuous f)
    (hc : closure {x | f x < 0} = {x | f x ≤ 0}) :
    frontier {x | f x < 0} = {x | f x = 0} := by
  rw [frontier, hc, (isOpen_lt hf continuous_const).interior_eq]
  ext x
  simp only [Set.mem_sdiff, Set.mem_ofPred_eq, not_lt]
  exact ⟨fun h ↦ le_antisymm h.1 h.2, fun h ↦ by simp [h]⟩

theorem positive_regular_open (hf : Continuous f)
    (hc : closure {x | 0 < f x} = {x | 0 ≤ f x})
    (hz : ∀ x, f x = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, f y < 0) :
    interior (closure {x | 0 < f x}) = {x | 0 < f x} := by
  apply Set.Subset.antisymm
  · intro x hx
    have hnonneg : 0 ≤ f x := by
      have h := interior_subset hx
      rwa [hc] at h
    by_contra hn
    have hzero : f x = 0 := le_antisymm (le_of_not_gt hn) hnonneg
    obtain ⟨y, hy, hyneg⟩ := hz x hzero _ (isOpen_interior.mem_nhds hx)
    have hy' := interior_subset hy
    rw [hc] at hy'
    exact not_lt_of_ge hy' hyneg
  · exact (isOpen_lt continuous_const hf).subset_interior_closure

theorem negative_regular_open (hf : Continuous f)
    (hc : closure {x | f x < 0} = {x | f x ≤ 0})
    (hz : ∀ x, f x = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, 0 < f y) :
    interior (closure {x | f x < 0}) = {x | f x < 0} := by
  have h := positive_regular_open hf.neg (by simpa only [Pi.neg_apply, neg_pos, neg_nonneg] using hc) (by
    intro x hx U hU
    obtain ⟨y, hyU, hy⟩ := hz x (neg_eq_zero.mp hx) U hU
    exact ⟨y, hyU, neg_lt_zero.mpr hy⟩)
  simpa only [Pi.neg_apply, neg_pos] using h
end Topology

/-- The two leading sign regions are regular open sets with their common
boundary exactly the polynomial zero set. -/
theorem top_phase_boundaries {n : ℕ} (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    let F := homogeneousComponent P.totalDegree P
    closure {x | 0 < eval x F} = {x | 0 ≤ eval x F} ∧
    closure {x | eval x F < 0} = {x | eval x F ≤ 0} ∧
    frontier {x | 0 < eval x F} = {x | eval x F = 0} ∧
    frontier {x | eval x F < 0} = {x | eval x F = 0} ∧
    interior (closure {x | 0 < eval x F}) = {x | 0 < eval x F} ∧
    interior (closure {x | eval x F < 0}) = {x | eval x F < 0} := by
  let F := homogeneousComponent P.totalDegree P
  have hf : Continuous (fun x ↦ eval x F) := (contDiff_eval F).continuous
  have hpos : ∀ x, eval x F = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, 0 < eval y F := by
    intro x hx U hU
    exact (Source29TopLocalSign.top_changes_sign_in_every_nhds P hmin hdeg x hx U hU).2
  have hneg : ∀ x, eval x F = 0 → ∀ U ∈ 𝓝 x, ∃ y ∈ U, eval y F < 0 := by
    intro x hx U hU
    exact (Source29TopLocalSign.top_changes_sign_in_every_nhds P hmin hdeg x hx U hU).1
  have hcp := positive_closure hf hpos
  have hcn := negative_closure hf hneg
  exact ⟨hcp, hcn, positive_frontier hf hcp, negative_frontier hf hcn,
    positive_regular_open hf hcp hneg, negative_regular_open hf hcn hpos⟩

end
end Source29TopPhaseBoundary

/- Component: NonlinearCalibration.inc -/
namespace Source29NonlinearCalibration

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29VariationConvexity
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem gradient_pair_normalized (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    (∑ i, evaluatedGradient P x i * leadingNormalizedField P x i) =
      variationDensity (evaluatedGradient P x) := by
  simp only [leadingNormalizedField, ← mul_div_assoc, ← pow_two, ← Finset.sum_div]
  exact Real.div_sqrt

theorem composed_product_fderiv (P : MvPolynomial (Fin n) ℝ)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ ρ y * h (eval y P)) x (Pi.single i 1) =
      h (eval x P) * fderiv ℝ ρ x (Pi.single i 1) +
      ρ x * deriv h (eval x P) * evaluatedGradient P x i := by
  have hd := ((hh.differentiable (by norm_num) (eval x P)).hasDerivAt).comp_hasFDerivAt x
    (hasFDerivAt_eval P x)
  have hp := ((hρ.differentiable (by norm_num) x).hasFDerivAt).fun_mul hd
  have he := congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) hp.fderiv
  simpa only [ContinuousLinearMap.add_apply, _root_.smul_apply, smul_eq_mul,
    evalFDeriv_basis, evaluatedGradient, mul_assoc, add_comm, Function.comp_def] using he

theorem composed_product_flux (P : MvPolynomial (Fin n) ℝ)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (eval y P)) (leadingNormalizedField P) x =
      h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x +
      ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x) := by
  simp only [testFlux, composed_product_fderiv P hρ hh, add_mul, Finset.sum_add_distrib]
  simp_rw [mul_assoc, ← Finset.mul_sum]
  rw [gradient_pair_normalized]

theorem weighted_flux_integrable (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hb : ∀ t, ‖h t‖ ≤ 1) :
    Integrable (fun x ↦ h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x) := by
  apply (testBound_integrable (fun i ↦ Pi.single i 1) hρ hcρ).mono'
  · exact (hh.continuous.comp (contDiff_eval P).continuous).aestronglyMeasurable.mul
      ((hcal.2 ρ hρ hcρ).1.aestronglyMeasurable)
  · exact Filter.Eventually.of_forall fun x ↦ (by
      rw [norm_mul]
      calc
        ‖h (eval x P)‖ * ‖testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x‖ ≤
            1 * ‖testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x‖ :=
          mul_le_mul_of_nonneg_right (hb _) (norm_nonneg _)
        _ ≤ testBound (fun i ↦ Pi.single i 1) ρ x := by
          simpa only [one_mul] using norm_testFlux_le_testBound _ ρ _ x (hcal.1 x))

/-- A nonlinear test of the weak calibration converts a local gradient mass
into a flux through the cutoff. -/
theorem localized_gradient_mass_identity (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hb : ∀ t, ‖h t‖ ≤ 1) :
    Integrable (fun x ↦ ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) ∧
    (∫ x, ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) =
      -(∫ x, h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x) := by
  have hi : Integrable (fun x ↦ ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact (hρ.continuous.mul (hh.continuous_deriv_one.comp (contDiff_eval P).continuous)).mul
        (variationDensity_continuous _ (fun i ↦ (contDiff_eval (pderiv i P)).continuous))
    · exact hcρ.mul_right.mul_right
  refine ⟨hi, ?_⟩
  have htest : ContDiff ℝ 1 (fun x ↦ ρ x * h (eval x P)) := hρ.mul (hh.comp (contDiff_eval P))
  have hz := (hcal.2 _ htest hcρ.mul_right).2
  have he : (∫ x, testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (eval y P))
      (leadingNormalizedField P) x) =
      (∫ x, h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x) +
      (∫ x, ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) := by
    simp_rw [composed_product_flux P hρ hh]
    exact integral_add (weighted_flux_integrable P hcal hρ hcρ hh hb) hi
  linarith

/-- The localized mass bound is independent of the steepness of a bounded
monotone transition function. -/
theorem localized_gradient_mass_bound (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hb : ∀ t, ‖h t‖ ≤ 1)
    (hder : ∀ t, 0 ≤ deriv h t) :
    Integrable (fun x ↦ ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) ∧
    0 ≤ (∫ x, ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) ∧
    (∫ x, ρ x * deriv h (eval x P) * variationDensity (evaluatedGradient P x)) ≤
      ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x := by
  obtain ⟨hi, he⟩ := localized_gradient_mass_identity P hcal hρ hcρ hh hb
  refine ⟨hi, integral_nonneg (fun x ↦ mul_nonneg (mul_nonneg (hρpos x) (hder _)) (Real.sqrt_nonneg _)), ?_⟩
  rw [he, ← integral_neg]
  apply integral_mono (weighted_flux_integrable P hcal hρ hcρ hh hb).neg
    (testBound_integrable (fun i ↦ Pi.single i 1) hρ hcρ)
  intro x
  calc
    -(h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x) ≤
        ‖h (eval x P) * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x‖ :=
      by simpa only [Real.norm_eq_abs] using neg_le_abs _
    _ ≤ testBound (fun i ↦ Pi.single i 1) ρ x := by
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_right (hb _) (norm_nonneg _)).trans
        (by simpa only [one_mul] using norm_testFlux_le_testBound _ ρ _ x (hcal.1 x))

end
end Source29NonlinearCalibration

/- Component: SmoothPhaseTransition.inc -/
namespace Source29SmoothPhaseTransition

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open scoped Topology BigOperators

noncomputable section

def scalarField (t : ℝ) : ℝ := normalizedField (fun s (_ : Fin 1) ↦ s) t 0

def baseTransition (t : ℝ) : ℝ := (1 + scalarField t) / 2

def transition (k : ℕ) (t : ℝ) : ℝ := baseTransition (dilationRadius k * t)

theorem scalarField_contDiff : ContDiff ℝ 1 scalarField :=
  normalizedField_contDiff (fun _ ↦ contDiff_id) 0

theorem scalarField_eq (t : ℝ) : scalarField t = t / Real.sqrt (1 + t^2) := by
  simp [scalarField, normalizedField, radiusSq]

theorem scalarField_deriv (t : ℝ) : deriv scalarField t = 1 / (Real.sqrt (1 + t^2))^3 := by
  rw [← fderiv_apply_one_eq_deriv]
  have hd := normalizedField_fderiv (g := fun s : ℝ ↦ fun _ : Fin 1 ↦ s)
    (fun _ ↦ contDiff_id) t 1 0
  change fderiv ℝ scalarField t 1 = _
  have hid : fderiv ℝ (fun y : ℝ ↦ y) t 1 = 1 := by
    exact congrArg (fun L : ℝ →L[ℝ] ℝ ↦ L 1) (hasFDerivAt_id t).fderiv
  simp only [radiusSq, Fin.sum_univ_one, hid] at hd
  change fderiv ℝ scalarField t 1 = _ at hd
  rw [hd]
  ring

theorem baseTransition_contDiff : ContDiff ℝ 1 baseTransition :=
  (contDiff_const.add scalarField_contDiff).div_const 2

theorem baseTransition_bounds (t : ℝ) : 0 ≤ baseTransition t ∧ baseTransition t ≤ 1 := by
  have h := normalizedField_norm_le_one (fun s : ℝ ↦ fun _ : Fin 1 ↦ s) t 0
  change ‖scalarField t‖ ≤ 1 at h
  rw [Real.norm_eq_abs, abs_le] at h
  dsimp [baseTransition]
  constructor <;> linarith [h.1, h.2]

theorem baseTransition_deriv_nonneg (t : ℝ) : 0 ≤ deriv baseTransition t := by
  have hd := (((scalarField_contDiff.differentiable (by norm_num) t).hasDerivAt).const_add 1).div_const 2
  change HasDerivAt baseTransition (deriv scalarField t / 2) t at hd
  rw [hd.deriv, scalarField_deriv]
  positivity

theorem transition_contDiff (k : ℕ) : ContDiff ℝ 1 (transition k) :=
  baseTransition_contDiff.comp (contDiff_const.mul contDiff_id)

theorem transition_bounds (k : ℕ) (t : ℝ) : 0 ≤ transition k t ∧ transition k t ≤ 1 :=
  baseTransition_bounds _

theorem transition_norm_le_one (k : ℕ) (t : ℝ) : ‖transition k t‖ ≤ 1 := by
  rw [Real.norm_eq_abs, abs_of_nonneg (transition_bounds k t).1]
  exact (transition_bounds k t).2

theorem transition_deriv_nonneg (k : ℕ) (t : ℝ) : 0 ≤ deriv (transition k) t := by
  have hd := ((baseTransition_contDiff.differentiable (by norm_num) (dilationRadius k * t)).hasDerivAt).comp t
    ((hasDerivAt_id t).const_mul (dilationRadius k))
  change HasDerivAt (transition k) (deriv baseTransition (dilationRadius k * t) * (dilationRadius k * 1)) t at hd
  rw [hd.deriv]
  exact mul_nonneg (baseTransition_deriv_nonneg _) (mul_nonneg (dilationRadius_pos k).le zero_le_one)

theorem transition_tendsto {t : ℝ} (ht : t ≠ 0) :
    Tendsto (fun k ↦ transition k t) atTop (𝓝 (if 0 < t then 1 else 0)) := by
  have hz : (fun _ : Fin 1 ↦ t) ≠ 0 := by
    intro he
    exact ht (congrFun he 0)
  have hs := normalized_ratio_tendsto
    (g := fun k (_ : Fin 1) ↦ dilationRadius k * t)
    (r := fun k ↦ (dilationRadius k)⁻¹) (z := fun _ : Fin 1 ↦ t)
    (fun k ↦ inv_pos.mpr (dilationRadius_pos k))
    (tendsto_inv_atTop_zero.comp dilationRadius_tendsto)
    (by intro i; simpa only [← mul_assoc, inv_mul_cancel₀ (dilationRadius_pos _).ne', one_mul] using (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ t) atTop (𝓝 t)))
    hz 0
  have hs' : Tendsto (fun k ↦ scalarField (dilationRadius k * t)) atTop (𝓝 (t / |t|)) := by
    simpa only [scalarField, normalizedField, radiusSq, Fin.sum_univ_one, Real.sqrt_sq_eq_abs] using hs
  have hb := ((tendsto_const_nhds (x := (1 : ℝ))).add hs').div_const 2
  change Tendsto (fun k ↦ transition k t) atTop (𝓝 ((1 + t / |t|) / 2)) at hb
  convert hb using 1
  rcases lt_or_gt_of_ne ht with hn | hp
  · simp [not_lt_of_ge hn.le, abs_of_neg hn, div_neg, div_self ht]
  · simp [hp, abs_of_pos hp, div_self ht]

theorem polynomial_transition_tendsto_ae {n : ℕ} (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0) :
    ∀ᵐ x, Tendsto (fun k ↦ transition k (eval x P)) atTop
      (𝓝 (if 0 < eval x P then 1 else 0)) := by
  filter_upwards [mvPolynomial_eval_ne_zero_ae n P hP] with x hx
  exact transition_tendsto hx

end
end Source29SmoothPhaseTransition

/- Component: PhaseApproximation.inc -/
namespace Source29PhaseApproximation

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29SmoothPhaseTransition Source29NonlinearCalibration Source29VariationConvexity
open Source29WeakCalibrationLimits
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

/-- Smooth sign transitions converge locally in L1, and more generally after
multiplication by any integrable scalar weight. -/
theorem transition_weighted_L1 (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (w : (Fin n → ℝ) → ℝ) (hw : Integrable w) :
    Tendsto (fun k ↦ ∫ x, ‖w x * (transition k (eval x P) - if 0 < eval x P then 1 else 0)‖)
      atTop (𝓝 0) := by
  let I : (Fin n → ℝ) → ℝ := fun x ↦ if 0 < eval x P then 1 else 0
  have hc (k : ℕ) : Continuous (fun x ↦ transition k (eval x P)) :=
    (transition_contDiff k).continuous.comp (contDiff_eval P).continuous
  have hl := polynomial_transition_tendsto_ae P hP
  have hI : AEStronglyMeasurable I :=
    aestronglyMeasurable_of_tendsto_ae atTop (fun k ↦ (hc k).aestronglyMeasurable) hl
  have hib (x) : ‖I x‖ ≤ 1 := by
    dsimp [I]
    split_ifs <;> norm_num
  have ht : Tendsto (fun k ↦ ∫ x, ‖w x * (transition k (eval x P) - I x)‖)
      atTop (𝓝 (∫ _x : Fin n → ℝ, (0 : ℝ))) := by
    apply tendsto_integral_of_dominated_convergence (fun x ↦ 2 * ‖w x‖)
    · intro k
      exact (hw.aestronglyMeasurable.mul ((hc k).aestronglyMeasurable.sub hI)).norm
    · exact hw.norm.const_mul 2
    · intro k
      exact Filter.Eventually.of_forall fun x ↦ (by
        rw [norm_norm, norm_mul]
        calc
          ‖w x‖ * ‖transition k (eval x P) - I x‖ ≤
              ‖w x‖ * (‖transition k (eval x P)‖ + ‖I x‖) :=
            mul_le_mul_of_nonneg_left (norm_sub_le _ _) (norm_nonneg _)
          _ ≤ 2 * ‖w x‖ := by
            have ha := transition_norm_le_one k (eval x P)
            have hb := hib x
            nlinarith [norm_nonneg (w x)])
    · filter_upwards [hl] with x hx
      have h := ((tendsto_const_nhds (x := w x)).mul
        (hx.sub (tendsto_const_nhds (x := I x)))).norm
      simpa only [I, sub_self, mul_zero, norm_zero] using h
  simpa only [integral_zero] using ht

theorem transition_weighted_integral (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (w : (Fin n → ℝ) → ℝ) (hw : Integrable w) :
    Tendsto (fun k ↦ ∫ x, w x * transition k (eval x P)) atTop
      (𝓝 (∫ x, w x * (if 0 < eval x P then 1 else 0))) := by
  apply tendsto_integral_of_dominated_convergence (fun x ↦ ‖w x‖)
  · intro k
    exact hw.aestronglyMeasurable.mul
      ((transition_contDiff k).continuous.comp (contDiff_eval P).continuous).aestronglyMeasurable
  · exact hw.norm
  · intro k
    exact Filter.Eventually.of_forall fun x ↦ (by
      rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (transition_norm_le_one k _))
  · filter_upwards [polynomial_transition_tendsto_ae P hP] with x hx
    exact (tendsto_const_nhds (x := w x)).mul hx

theorem phase_weight_integrable (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (w : (Fin n → ℝ) → ℝ) (hw : Integrable w) :
    Integrable (fun x ↦ w x * (if 0 < eval x P then 1 else 0)) := by
  apply hw.mul_bdd
  · exact aestronglyMeasurable_of_tendsto_ae atTop
      (fun k ↦ ((transition_contDiff k).continuous.comp
        (contDiff_eval P).continuous).aestronglyMeasurable)
      (polynomial_transition_tendsto_ae P hP)
  · exact Filter.Eventually.of_forall fun x ↦ (show
      ‖(if 0 < eval x P then 1 else 0 : ℝ)‖ ≤ 1 by split_ifs <;> norm_num)

/-- Each smooth transition of the leading polynomial has a local gradient
mass bounded only by the cutoff, not by the transition parameter. -/
theorem top_transition_mass_bound (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) (k : ℕ) :
    let F := homogeneousComponent P.totalDegree P
    Integrable (fun x ↦ ρ x * deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x)) ∧
    0 ≤ (∫ x, ρ x * deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x)) ∧
    (∫ x, ρ x * deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x)) ≤
      ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x := by
  let F := homogeneousComponent P.totalDegree P
  have hcal : WeakCalibration (leadingNormalizedField F) := by
    refine ⟨leadingNormalizedField_bound F, ?_⟩
    intro φ hφ hcφ
    exact Source29TopWeakCalibration.top_weak_calibration P hmin hdeg hφ hcφ
  exact localized_gradient_mass_bound F hcal hρ hcρ hρpos
    (transition_contDiff k) (transition_norm_le_one k) (transition_deriv_nonneg k)

end
end Source29PhaseApproximation

/- Component: PhaseDivergence.inc -/
namespace Source29PhaseDivergence

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxPolynomial
open Source29SmoothPhaseTransition Source29NonlinearCalibration Source29VariationConvexity
open Source29WeakCalibrationLimits Source29PhaseApproximation
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem abs_pairing_le (a b : Fin n → ℝ) :
    |∑ i, a i * b i| ≤ variationDensity a * variationDensity b := by
  have hu := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ a b
  have hl := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ (fun i ↦ -a i) b
  simp only [neg_mul, Finset.sum_neg_distrib, neg_sq] at hl
  exact abs_le.mpr ⟨by dsimp [variationDensity]; linarith, hu⟩

theorem composed_fderiv (P : MvPolynomial (Fin n) ℝ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ h (eval y P)) x (Pi.single i 1) =
      deriv h (eval x P) * evaluatedGradient P x i := by
  have hd := ((hh.differentiable (by norm_num) (eval x P)).hasDerivAt).comp_hasFDerivAt x
    (hasFDerivAt_eval P x)
  simpa only [Function.comp_def, _root_.smul_apply, smul_eq_mul,
    evalFDeriv_basis, evaluatedGradient] using
    congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) hd.fderiv

theorem divergence_integrable (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    Integrable (divergence (fun i ↦ Pi.single i 1) X) := by
  apply integrable_finsetSum
  intro i _
  exact (((hX i).continuous_fderiv (by norm_num)).clm_apply continuous_const).integrable_of_hasCompactSupport ((hcX i).fderiv_apply ℝ (Pi.single i 1))

theorem composed_pairing_integrable (P : MvPolynomial (Fin n) ℝ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    Integrable (fun x ↦ deriv h (eval x P) * ∑ i, evaluatedGradient P x i * X x i) := by
  simp_rw [Finset.mul_sum]
  apply integrable_finsetSum
  intro i _
  exact ((hh.continuous_deriv_one.comp (contDiff_eval P).continuous).mul
    (((contDiff_eval (pderiv i P)).continuous).mul (hX i).continuous)).integrable_of_hasCompactSupport (((hcX i).mul_left).mul_left)

/-- Integration by parts for a smooth phase against a compactly supported vector field. -/
theorem composed_divergence_identity (P : MvPolynomial (Fin n) ℝ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    (∫ x, h (eval x P) * divergence (fun i ↦ Pi.single i 1) X x) =
      -(∫ x, deriv h (eval x P) * ∑ i, evaluatedGradient P x i * X x i) := by
  have hi i : Integrable (fun x ↦ h (eval x P) *
      fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1)) :=
    ((hh.continuous.comp (contDiff_eval P).continuous).mul
      (((hX i).continuous_fderiv (by norm_num)).clm_apply continuous_const)).integrable_of_hasCompactSupport ((hcX i).fderiv_apply ℝ (Pi.single i 1)).mul_left
  have hj i : Integrable (fun x ↦ deriv h (eval x P) *
      (evaluatedGradient P x i * X x i)) :=
    ((hh.continuous_deriv_one.comp (contDiff_eval P).continuous).mul
      (((contDiff_eval (pderiv i P)).continuous).mul (hX i).continuous)).integrable_of_hasCompactSupport (((hcX i).mul_left).mul_left)
  have he i : (∫ x, h (eval x P) * fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1)) =
      -(∫ x, deriv h (eval x P) * (evaluatedGradient P x i * X x i)) := by
    have hb := integral_mul_fderiv_eq_neg_of_compactSupport (μ := volume)
      (hX i) (hcX i) (hh.comp (contDiff_eval P)) (Pi.single i 1)
    change (∫ x, X x i * fderiv ℝ (fun y ↦ h (eval y P)) x (Pi.single i 1)) =
      -(∫ x, fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1) * h (eval x P)) at hb
    simp_rw [composed_fderiv P hh] at hb
    have ha : (∫ x, X x i * (deriv h (eval x P) * evaluatedGradient P x i)) =
        (∫ x, deriv h (eval x P) * (evaluatedGradient P x i * X x i)) := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall (fun x ↦ by ring)
    have hc : (∫ x, fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1) * h (eval x P)) =
        (∫ x, h (eval x P) * fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1)) := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall (fun x ↦ mul_comm _ _)
    rw [ha, hc] at hb
    linarith
  simp only [divergence, Finset.mul_sum]
  rw [integral_finsetSum _ (fun i _ ↦ hi i), integral_finsetSum _ (fun i _ ↦ hj i)]
  simp_rw [he]
  simp

/-- The divergence pairing of each smooth phase is bounded independently of its steepness. -/
theorem transition_divergence_bound (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i))
    (hbound : ∀ x, variationDensity (X x) ≤ ρ x) (k : ℕ) :
    |∫ x, transition k (eval x P) * divergence (fun i ↦ Pi.single i 1) X x| ≤
      ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x := by
  obtain ⟨hm, _, hb⟩ := localized_gradient_mass_bound P hcal hρ hcρ hρpos
    (transition_contDiff k) (transition_norm_le_one k) (transition_deriv_nonneg k)
  rw [composed_divergence_identity P (transition_contDiff k) X hX hcX, abs_neg]
  have hi := composed_pairing_integrable P (transition_contDiff k) X hX hcX
  have hp (x) : |deriv (transition k) (eval x P) *
      ∑ i, evaluatedGradient P x i * X x i| ≤
      ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) := by
    rw [abs_mul, abs_of_nonneg (transition_deriv_nonneg k _)]
    calc
      _ ≤ deriv (transition k) (eval x P) *
          (variationDensity (evaluatedGradient P x) * variationDensity (X x)) :=
        mul_le_mul_of_nonneg_left (abs_pairing_le _ _) (transition_deriv_nonneg k _)
      _ ≤ deriv (transition k) (eval x P) *
          (variationDensity (evaluatedGradient P x) * ρ x) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (hbound x) (Real.sqrt_nonneg _))
          (transition_deriv_nonneg k _)
      _ = _ := by ring
  calc
    _ ≤ ∫ x, |deriv (transition k) (eval x P) *
        ∑ i, evaluatedGradient P x i * X x i| := abs_integral_le_integral_abs
    _ ≤ ∫ x, ρ x * deriv (transition k) (eval x P) *
        variationDensity (evaluatedGradient P x) := integral_mono hi.abs hm hp
    _ ≤ _ := hb

/-- A local bound on the distributional derivative of the strict positive phase.
The cutoff controls all compactly supported C1 vector fields with norm below it. -/
theorem phase_divergence_bound (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i))
    (hbound : ∀ x, variationDensity (X x) ≤ ρ x) :
    |∫ x, (if 0 < eval x P then 1 else 0) * divergence (fun i ↦ Pi.single i 1) X x| ≤
      ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x := by
  have hl := transition_weighted_integral P hP
    (divergence (fun i ↦ Pi.single i 1) X) (divergence_integrable X hX hcX)
  simp_rw [mul_comm (divergence _ X _)] at hl
  exact le_of_tendsto hl.abs (Filter.Eventually.of_forall
    (transition_divergence_bound P hcal hρ hcρ hρpos X hX hcX hbound))

end
end Source29PhaseDivergence

/- Component: PhaseLocalVariation.inc -/
namespace Source29PhaseLocalVariation

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits Source29PhaseDivergence
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- On every compact set, the positive phase has a uniformly bounded distributional
variation. The bound is uniform over all C1 vector tests of pointwise norm at most one. -/
theorem locally_bounded_phase_variation (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ X : (Fin n → ℝ) → Fin n → ℝ,
      (∀ i, ContDiff ℝ 1 (fun x ↦ X x i)) →
      (∀ i, Function.support (fun x ↦ X x i) ⊆ K) →
      (∀ x, variationDensity (X x) ≤ 1) →
      |∫ x, (if 0 < eval x P then 1 else 0) * divergence (fun i ↦ Pi.single i 1) X x| ≤ C := by
  obtain ⟨R, hR, hKR⟩ := hK.isBounded.subset_closedBall_lt 0 (0 : Fin n → ℝ)
  let b : ContDiffBump (0 : Fin n → ℝ) :=
    { rIn := R, rOut := R + 1, rIn_pos := hR, rIn_lt_rOut := lt_add_one R }
  refine ⟨∫ x, testBound (fun i ↦ Pi.single i 1) b x, ?_, ?_⟩
  · exact integral_nonneg (fun x ↦ Finset.sum_nonneg (fun i _ ↦ norm_nonneg _))
  · intro X hX hsX hXb
    have hcX (i : Fin n) : HasCompactSupport (fun x ↦ X x i) :=
      HasCompactSupport.of_support_subset_isCompact hK (hsX i)
    apply phase_divergence_bound P hP hcal b.contDiff b.hasCompactSupport b.nonneg' X hX hcX
    intro x
    by_cases hx : x ∈ K
    · have hb : b x = 1 := b.one_of_mem_closedBall (hKR hx)
      rw [hb]
      exact hXb x
    · have hz : X x = 0 := by
        ext i
        by_contra hn
        exact hx (hsX i hn)
      rw [hz]
      simpa only [variationDensity, Pi.zero_apply, zero_pow (by norm_num : 2 ≠ 0),
        Finset.sum_const_zero, Real.sqrt_zero] using b.nonneg' x

/-- The actual leading positive phase of a polynomial minimal graph has the
local variation bound, without any regularity assumption on its zero set. -/
theorem top_locally_bounded_phase_variation (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ X : (Fin n → ℝ) → Fin n → ℝ,
      (∀ i, ContDiff ℝ 1 (fun x ↦ X x i)) →
      (∀ i, Function.support (fun x ↦ X x i) ⊆ K) →
      (∀ x, variationDensity (X x) ≤ 1) →
      |∫ x, (if 0 < eval x (homogeneousComponent P.totalDegree P) then 1 else 0) *
        divergence (fun i ↦ Pi.single i 1) X x| ≤ C := by
  apply locally_bounded_phase_variation _
    (Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P (by omega))
    _ K hK
  refine ⟨leadingNormalizedField_bound _, ?_⟩
  intro φ hφ hcφ
  exact Source29TopWeakCalibration.top_weak_calibration P hmin hdeg hφ hcφ

theorem top_negative_phase_locally_bounded_variation (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ X : (Fin n → ℝ) → Fin n → ℝ,
      (∀ i, ContDiff ℝ 1 (fun x ↦ X x i)) →
      (∀ i, Function.support (fun x ↦ X x i) ⊆ K) →
      (∀ x, variationDensity (X x) ≤ 1) →
      |∫ x, (if eval x (homogeneousComponent P.totalDegree P) < 0 then 1 else 0) *
        divergence (fun i ↦ Pi.single i 1) X x| ≤ C := by
  have hm : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (-P) := by
    change Source29QuarticReuse.QuarticPolynomialBasics.minimalGraphOperator (-P) = 0
    rw [minimalGraphOperator_neg]
    exact neg_eq_zero.mpr hmin
  have hd : 2 ≤ (-P).totalDegree := by simpa only [totalDegree_neg] using hdeg
  simpa only [totalDegree_neg, map_neg, neg_pos] using
    top_locally_bounded_phase_variation (-P) hm hd K hK

end
end Source29PhaseLocalVariation

/- Component: PhaseMassLimit.inc -/
namespace Source29PhaseMassLimit

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29WeakCalibrationLimits
open Source29SmoothPhaseTransition Source29NonlinearCalibration Source29PhaseApproximation
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- The calibrated limiting mass, tested against a scalar cutoff. -/
def phaseMass (P : MvPolynomial (Fin n) ℝ) (ρ : (Fin n → ℝ) → ℝ) : ℝ :=
  -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x *
    (if 0 < eval x P then 1 else 0))

theorem phaseMass_tendsto (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k ↦ ∫ x, ρ x * deriv (transition k) (eval x P) *
      variationDensity (evaluatedGradient P x)) atTop (𝓝 (phaseMass P ρ)) := by
  have ht := (transition_weighted_integral P hP
    (testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P))
    (hcal.2 ρ hρ hcρ).1).neg
  convert ht using 1
  funext k
  rw [(localized_gradient_mass_identity P hcal hρ hcρ
    (transition_contDiff k) (transition_norm_le_one k)).2]
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ mul_comm _ _
  rfl

theorem phaseMass_bounds (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    0 ≤ phaseMass P ρ ∧ phaseMass P ρ ≤ ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x := by
  have ht := phaseMass_tendsto P hP hcal hρ hcρ
  have hb k := (localized_gradient_mass_bound P hcal hρ hcρ hρpos
    (transition_contDiff k) (transition_norm_le_one k) (transition_deriv_nonneg k)).2
  exact ⟨ge_of_tendsto ht (Filter.Eventually.of_forall fun k ↦ (hb k).1),
    le_of_tendsto ht (Filter.Eventually.of_forall fun k ↦ (hb k).2)⟩

/-- The limiting scalar mass bounds every compact vector test dominated by the cutoff. -/
theorem phase_divergence_le_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i))
    (hbound : ∀ x, variationDensity (X x) ≤ ρ x) :
    |∫ x, (if 0 < eval x P then 1 else 0) * divergence (fun i ↦ Pi.single i 1) X x| ≤
      phaseMass P ρ := by
  have hl := transition_weighted_integral P hP
    (divergence (fun i ↦ Pi.single i 1) X) (Source29PhaseDivergence.divergence_integrable X hX hcX)
  simp_rw [mul_comm (divergence _ X _)] at hl
  apply le_of_tendsto_of_tendsto hl.abs (phaseMass_tendsto P hP hcal hρ hcρ)
  apply Filter.Eventually.of_forall
  intro k
  dsimp only
  rw [Source29PhaseDivergence.composed_divergence_identity P (transition_contDiff k) X hX hcX,
    abs_neg]
  have hi := Source29PhaseDivergence.composed_pairing_integrable P (transition_contDiff k) X hX hcX
  have hm := (localized_gradient_mass_identity P hcal hρ hcρ
    (transition_contDiff k) (transition_norm_le_one k)).1
  apply (abs_integral_le_integral_abs).trans (integral_mono hi.abs hm ?_)
  intro x
  dsimp only
  rw [abs_mul, abs_of_nonneg (transition_deriv_nonneg k _)]
  calc
    _ ≤ deriv (transition k) (eval x P) *
        (variationDensity (evaluatedGradient P x) * variationDensity (X x)) :=
      mul_le_mul_of_nonneg_left (Source29PhaseDivergence.abs_pairing_le _ _) (transition_deriv_nonneg k _)
    _ ≤ deriv (transition k) (eval x P) * (variationDensity (evaluatedGradient P x) * ρ x) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (hbound x) (Real.sqrt_nonneg _)) (transition_deriv_nonneg k _)
    _ = _ := by ring

end
end Source29PhaseMassLimit

/- Component: SmoothCalibrationRecovery.inc -/
namespace Source29SmoothCalibrationRecovery

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem variationDensity_const_mul (c : ℝ) (a : Fin n → ℝ) :
    variationDensity (fun i ↦ c * a i) = |c| * variationDensity a := by
  simp only [variationDensity, mul_pow, ← Finset.mul_sum]
  rw [Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq_eq_abs]

theorem coordinate_norm_le_variationDensity (a : Fin n → ℝ) (i : Fin n) :
    ‖a i‖ ≤ variationDensity a := by
  rw [Real.norm_eq_abs]
  exact Real.abs_le_sqrt (Finset.single_le_sum (fun j _ ↦ sq_nonneg (a j)) (Finset.mem_univ i))

theorem normalizedField_variationDensity_le_one {E : Type*}
    (g : E → Fin n → ℝ) (x : E) : variationDensity (normalizedField g x) ≤ 1 := by
  have hr : 0 ≤ radiusSq (g x) := Finset.sum_nonneg (fun i _ ↦ sq_nonneg (g x i))
  apply Real.sqrt_le_one.mpr
  simp only [normalizedField, div_pow, ← Finset.sum_div]
  rw [Real.sq_sqrt (by exact add_nonneg zero_le_one hr)]
  exact (div_le_one (by linarith)).mpr (by
    dsimp [radiusSq]
    linarith)

/-- Smooth divergence-free vector fields approximating a unit calibration. -/
structure Approximation (A : ℕ → (Fin n → ℝ) → Fin n → ℝ)
    (G : (Fin n → ℝ) → Fin n → ℝ) : Prop where
  smooth : ∀ k i, ContDiff ℝ 1 (fun x ↦ A k x i)
  div_zero : ∀ k x, divergence (fun i ↦ Pi.single i 1) (A k) x = 0
  norm_bound : ∀ k x, variationDensity (A k x) ≤ 1
  tendsto_ae : ∀ᵐ x, ∀ i, Tendsto (fun k ↦ A k x i) atTop (𝓝 (G x i))

def graphField (P : MvPolynomial (Fin n) ℝ) (k : ℕ) (x : Fin n → ℝ) : Fin n → ℝ :=
  normalizedField (evaluatedGradient P) (dilationRadius k • x)

theorem graphField_approximation (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    Approximation (graphField P) (leadingNormalizedField (homogeneousComponent P.totalDegree P)) := by
  have hg : ∀ i, ContDiff ℝ 1 (fun x ↦ normalizedField (evaluatedGradient P) x i) :=
    normalizedField_contDiff (fun i ↦ contDiff_eval (pderiv i P))
  refine ⟨?_, ?_, ?_, Source29TopWeakCalibration.normalizedGradient_dilates_tendsto_ae P hdeg⟩
  · intro k i
    exact (hg i).comp (by fun_prop)
  · intro k x
    change divergence (fun i ↦ Pi.single i 1)
      (fun y ↦ normalizedField (evaluatedGradient P) (dilationRadius k • y)) x = 0
    rw [divergence_dilate _ hg,
      Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin, mul_zero]
  · intro k x
    exact normalizedField_variationDensity_le_one _ _

def cutoffField (ρ : (Fin n → ℝ) → ℝ) (A : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) (i : Fin n) : ℝ := ρ x * A x i

theorem divergence_cutoffField {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ)
    {A : (Fin n → ℝ) → Fin n → ℝ} (hA : ∀ i, ContDiff ℝ 1 (fun x ↦ A x i))
    (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (cutoffField ρ A) x =
      testFlux (fun i ↦ Pi.single i 1) ρ A x +
      ρ x * divergence (fun i ↦ Pi.single i 1) A x := by
  have hd i : fderiv ℝ (fun y ↦ ρ y * A y i) x (Pi.single i 1) =
      A x i * fderiv ℝ ρ x (Pi.single i 1) +
      ρ x * fderiv ℝ (fun y ↦ A y i) x (Pi.single i 1) := by
    have hh := ((hρ.differentiable (by norm_num) x).hasFDerivAt).fun_mul
      ((hA i).differentiable (by norm_num) x).hasFDerivAt
    simpa only [add_apply, _root_.smul_apply, smul_eq_mul, add_comm] using
      congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) hh.fderiv
  simp only [divergence, cutoffField, hd, testFlux, Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  exact mul_comm _ _

/-- The divergence pairing of cutoff calibration fields converges by dominated convergence. -/
theorem cutoff_pairings_tendsto {A : ℕ → (Fin n → ℝ) → Fin n → ℝ}
    {G : (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A G)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {u : (Fin n → ℝ) → ℝ} (hu : AEStronglyMeasurable u) (hub : ∀ x, ‖u x‖ ≤ 1) :
    Tendsto (fun k ↦ ∫ x, u x * divergence (fun i ↦ Pi.single i 1) (cutoffField ρ (A k)) x)
      atTop (𝓝 (∫ x, u x * testFlux (fun i ↦ Pi.single i 1) ρ G x)) := by
  simp_rw [divergence_cutoffField hρ (ha.smooth _), ha.div_zero, mul_zero, add_zero]
  apply tendsto_integral_of_dominated_convergence (testBound (fun i ↦ Pi.single i 1) ρ)
  · intro k
    exact hu.mul (testFlux_continuous _ hρ (fun i ↦ (ha.smooth k i).continuous)).aestronglyMeasurable
  · exact testBound_integrable _ hρ hcρ
  · intro k
    exact Filter.Eventually.of_forall fun x ↦ (by
      rw [norm_mul]
      apply (mul_le_mul_of_nonneg_right (hub x) (norm_nonneg _)).trans
      simpa only [one_mul] using norm_testFlux_le_testBound _ ρ (A k) x
        (fun i ↦ (coordinate_norm_le_variationDensity (A k x) i).trans (ha.norm_bound k x)))
  · filter_upwards [ha.tendsto_ae] with x hx
    exact (tendsto_const_nhds (x := u x)).mul (testFlux_tendsto _ ρ hx)

end
end Source29SmoothCalibrationRecovery

/- Component: WeightedPhaseVariation.inc -/
namespace Source29WeightedPhaseVariation

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits Source29PhaseMassLimit
open Source29SmoothCalibrationRecovery
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

/-- Compact C1 vector tests for weighted distributional variation. -/
structure VariationTest (ρ : (Fin n → ℝ) → ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) : Prop where
  smooth : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i)
  compact : ∀ i, HasCompactSupport (fun x ↦ X x i)
  norm_bound : ∀ x, variationDensity (X x) ≤ ρ x

/-- Weighted distributional variation, defined by the usual divergence-test supremum.
For measurable set indicators this is the dual definition of weighted perimeter. -/
def weightedVariation (u ρ : (Fin n → ℝ) → ℝ) : ℝ≥0∞ :=
  ⨆ (X : (Fin n → ℝ) → Fin n → ℝ) (_ : VariationTest ρ X),
    ENNReal.ofReal |∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x|

def positivePhase (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) : ℝ :=
  if 0 < eval x P then 1 else 0

theorem positivePhase_bound (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    ‖positivePhase P x‖ ≤ 1 := by
  dsimp [positivePhase]
  split_ifs <;> norm_num

theorem positivePhase_aestronglyMeasurable (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0) :
    AEStronglyMeasurable (positivePhase P) :=
  aestronglyMeasurable_of_tendsto_ae atTop
    (fun k ↦ ((Source29SmoothPhaseTransition.transition_contDiff k).continuous.comp
      (contDiff_eval P).continuous).aestronglyMeasurable)
    (Source29SmoothPhaseTransition.polynomial_transition_tendsto_ae P hP)

theorem test_le_weightedVariation (u ρ : (Fin n → ℝ) → ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (hX : VariationTest ρ X) :
    ENNReal.ofReal |∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x| ≤
      weightedVariation u ρ :=
  le_iSup_of_le X (le_iSup_of_le hX le_rfl)

theorem cutoff_variationTest {A : ℕ → (Fin n → ℝ) → Fin n → ℝ}
    {G : (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A G)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) (k : ℕ) : VariationTest ρ (cutoffField ρ (A k)) := by
  refine ⟨fun i ↦ hρ.mul (ha.smooth k i), fun i ↦ hcρ.mul_right, ?_⟩
  intro x
  change variationDensity (fun i ↦ ρ x * A k x i) ≤ ρ x
  rw [variationDensity_const_mul, abs_of_nonneg (hρpos x)]
  exact mul_le_of_le_one_right (hρpos x) (ha.norm_bound k x)

theorem phase_variation_le_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    weightedVariation (positivePhase P) ρ ≤ ENNReal.ofReal (phaseMass P ρ) := by
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  exact ENNReal.ofReal_le_ofReal
    (phase_divergence_le_mass P hP hcal hρ hcρ X hX.smooth hX.compact hX.norm_bound)

theorem cutoff_phase_pairings_tendsto_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k ↦ ∫ x, positivePhase P x *
      divergence (fun i ↦ Pi.single i 1) (cutoffField ρ (A k)) x)
      atTop (𝓝 (-phaseMass P ρ)) := by
  have ht := cutoff_pairings_tendsto ha hρ hcρ
    (positivePhase_aestronglyMeasurable P hP) (positivePhase_bound P)
  have he : (∫ x, positivePhase P x * testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x) =
      -phaseMass P ρ := by
    simp only [phaseMass, neg_neg, positivePhase]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x ↦ mul_comm _ _
  rwa [he] at ht

/-- Smooth divergence-free approximants attain the full dual variation in the limit. -/
theorem phase_variation_eq_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    weightedVariation (positivePhase P) ρ = ENNReal.ofReal (phaseMass P ρ) := by
  apply le_antisymm (phase_variation_le_mass P hP hcal hρ hcρ)
  have ht := ENNReal.tendsto_ofReal (cutoff_phase_pairings_tendsto_mass P hP ha hρ hcρ).abs
  rw [abs_neg, abs_of_nonneg (phaseMass_bounds P hP hcal hρ hcρ hρpos).1] at ht
  apply le_of_tendsto ht
  exact Filter.Eventually.of_forall fun k ↦
    test_le_weightedVariation _ _ _ (cutoff_variationTest ha hρ hcρ hρpos k)

/-- A perturbation where the cutoff is locally constant leaves every recovering
calibration pairing unchanged, and therefore cannot decrease the dual variation. -/
theorem phase_variation_minimizing (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {A : ℕ → (Fin n → ℝ) → Fin n → ℝ} (ha : Approximation A (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) (v : (Fin n → ℝ) → ℝ)
    (hagree : ∀ᵐ x, v x = positivePhase P x ∨ fderiv ℝ ρ x = 0) :
    weightedVariation (positivePhase P) ρ ≤ weightedVariation v ρ := by
  rw [phase_variation_eq_mass P hP hcal ha hρ hcρ hρpos]
  have ht := ENNReal.tendsto_ofReal (cutoff_phase_pairings_tendsto_mass P hP ha hρ hcρ).abs
  rw [abs_neg, abs_of_nonneg (phaseMass_bounds P hP hcal hρ hcρ hρpos).1] at ht
  apply le_of_tendsto ht
  apply Filter.Eventually.of_forall
  intro k
  have he : (∫ x, positivePhase P x * divergence (fun i ↦ Pi.single i 1) (cutoffField ρ (A k)) x) =
      ∫ x, v x * divergence (fun i ↦ Pi.single i 1) (cutoffField ρ (A k)) x := by
    apply integral_congr_ae
    filter_upwards [hagree] with x hx
    rcases hx with he | hd
    · rw [he]
    · simp only [divergence_cutoffField hρ (ha.smooth k), ha.div_zero, mul_zero, add_zero]
      simp [testFlux, hd]
  rw [he]
  exact test_le_weightedVariation _ _ _ (cutoff_variationTest ha hρ hcρ hρpos k)

end
end Source29WeightedPhaseVariation

/- Component: TopPhasePerimeter.inc -/
namespace Source29TopPhasePerimeter

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29WeakCalibrationLimits Source29PhaseMassLimit
open Source29SmoothCalibrationRecovery Source29WeightedPhaseVariation
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

/-- Weighted perimeter in the divergence-test definition. -/
def weightedPerimeter (S : Set (Fin n → ℝ)) (ρ : (Fin n → ℝ) → ℝ) : ℝ≥0∞ := by
  classical
  exact weightedVariation (fun x ↦ if x ∈ S then 1 else 0) ρ

theorem top_weakCalibration (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    WeakCalibration (leadingNormalizedField (homogeneousComponent P.totalDegree P)) := by
  refine ⟨leadingNormalizedField_bound _, ?_⟩
  intro φ hφ hcφ
  exact Source29TopWeakCalibration.top_weak_calibration P hmin hdeg hφ hcφ

/-- The leading positive phase's dual perimeter equals the calibrated limiting mass. -/
theorem top_phase_perimeter_eq_mass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    weightedPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} ρ =
      ENNReal.ofReal (phaseMass (homogeneousComponent P.totalDegree P) ρ) := by
  exact phase_variation_eq_mass _ (top_homogeneousComponent_ne_zero P (by omega))
    (top_weakCalibration P hmin hdeg) (graphField_approximation P hmin hdeg) hρ hcρ hρpos

/-- Perimeter comparison with a set that differs from the leading phase only
where the cutoff has zero derivative. No smoothness of either boundary is assumed. -/
theorem top_phase_perimeter_comparison (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    (K V : Set (Fin n → ℝ))
    (hflat : ∀ x ∈ K, fderiv ℝ ρ x = 0)
    (hV : ∀ x ∉ K, (x ∈ V ↔ 0 < eval x (homogeneousComponent P.totalDegree P))) :
    weightedPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} ρ ≤
      weightedPerimeter V ρ := by
  classical
  apply phase_variation_minimizing _ (top_homogeneousComponent_ne_zero P (by omega))
    (top_weakCalibration P hmin hdeg) (graphField_approximation P hmin hdeg) hρ hcρ hρpos
  apply Filter.Eventually.of_forall
  intro x
  by_cases hx : x ∈ K
  · exact Or.inr (hflat x hx)
  · left
    change (if x ∈ V then (1 : ℝ) else 0) =
      if 0 < eval x (homogeneousComponent P.totalDegree P) then 1 else 0
    rw [hV x hx]

/-- Every compact perturbation admits a common smooth cutoff, identically one
on its support, for which the leading phase minimizes dual perimeter. -/
theorem top_phase_compact_perimeter_comparison (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ ρ : (Fin n → ℝ) → ℝ, ContDiff ℝ 1 ρ ∧ HasCompactSupport ρ ∧
      (∀ x, 0 ≤ ρ x) ∧ (∀ x ∈ K, ρ x = 1) ∧
      ∀ V : Set (Fin n → ℝ),
        (∀ x ∉ K, (x ∈ V ↔ 0 < eval x (homogeneousComponent P.totalDegree P))) →
        weightedPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} ρ ≤
          weightedPerimeter V ρ := by
  obtain ⟨R, hR, hKR⟩ := hK.isBounded.subset_closedBall_lt 0 (0 : Fin n → ℝ)
  let b : ContDiffBump (0 : Fin n → ℝ) :=
    { rIn := R + 1, rOut := R + 2, rIn_pos := by linarith, rIn_lt_rOut := by linarith }
  have hball (x) (hx : x ∈ K) : x ∈ Metric.ball (0 : Fin n → ℝ) b.rIn :=
    Metric.closedBall_subset_ball (by dsimp [b]; linarith) (hKR hx)
  have hflat (x) (hx : x ∈ K) : fderiv ℝ b x = 0 := by
    have he := b.eventuallyEq_one_of_mem_ball (hball x hx)
    have hd := he.fderiv_eq (𝕜 := ℝ)
    simpa using hd
  refine ⟨b, b.contDiff, b.hasCompactSupport, b.nonneg', ?_, ?_⟩
  · intro x hx
    exact b.one_of_mem_closedBall (Metric.ball_subset_closedBall (hball x hx))
  · intro V hV
    exact top_phase_perimeter_comparison P hmin hdeg b.contDiff b.hasCompactSupport
      b.nonneg' K V hflat hV

end
end Source29TopPhasePerimeter

/- Component: LocalPhasePerimeter.inc -/
namespace Source29LocalPhasePerimeter

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29SmoothCalibrationRecovery
open Source29WeightedPhaseVariation Source29TopPhasePerimeter
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

/-- A smooth compact cutoff inside an open region, equal to one near a prescribed compact set. -/
theorem exists_local_cutoff (K U : Set (Fin n → ℝ)) (hK : IsCompact K)
    (hU : IsOpen U) (hKU : K ⊆ U) :
    ∃ ρ : (Fin n → ℝ) → ℝ, ContDiff ℝ 1 ρ ∧ HasCompactSupport ρ ∧ tsupport ρ ⊆ U ∧
      (∀ x, 0 ≤ ρ x ∧ ρ x ≤ 1) ∧ (∀ x ∈ K, ρ x = 1) ∧
      (∀ x ∈ K, fderiv ℝ ρ x = 0) := by
  obtain ⟨W, hW, hKW, hWU, hcW⟩ := exists_open_between_and_isCompact_closure hK hU hKU
  obtain ⟨V, hV, hWV, hVU, hcV⟩ := exists_open_between_and_isCompact_closure hcW hU hWU
  obtain ⟨ρ, hρ, hrange, hsupp, hone⟩ :=
    exists_contDiff_support_eq_eq_one_iff (n := 1) hV isClosed_closure hWV
  have hts : tsupport ρ = closure V := by simp only [tsupport, hsupp]
  refine ⟨ρ, hρ, ?_, hts ▸ hVU, ?_, ?_, ?_⟩
  · change IsCompact (tsupport ρ)
    rwa [hts]
  · intro x
    exact hrange (Set.mem_range_self x)
  · intro x hx
    exact (hone x).mp (subset_closure (hKW hx))
  · intro x hx
    have he : ρ =ᶠ[𝓝 x] (fun _ ↦ (1 : ℝ)) :=
      Filter.eventually_of_mem (hW.mem_nhds (hKW hx))
        (fun y hy ↦ (hone y).mp (subset_closure hy))
    simpa using he.fderiv_eq (𝕜 := ℝ)

structure LocalVariationTest (U : Set (Fin n → ℝ))
    (X : (Fin n → ℝ) → Fin n → ℝ) : Prop where
  test : VariationTest (fun _ ↦ 1) X
  within : ∀ i, tsupport (fun x ↦ X x i) ⊆ U

/-- Variation in an open region via compactly supported unit vector tests. -/
def localVariation (u : (Fin n → ℝ) → ℝ) (U : Set (Fin n → ℝ)) : ℝ≥0∞ :=
  ⨆ (X : (Fin n → ℝ) → Fin n → ℝ) (_ : LocalVariationTest U X),
    ENNReal.ofReal |∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x|

def localPerimeter (S U : Set (Fin n → ℝ)) : ℝ≥0∞ := by
  classical
  exact localVariation (fun x ↦ if x ∈ S then 1 else 0) U

theorem weightedVariation_le_local (u ρ : (Fin n → ℝ) → ℝ)
    (U : Set (Fin n → ℝ)) (hρU : tsupport ρ ⊆ U) (hρle : ∀ x, ρ x ≤ 1) :
    weightedVariation u ρ ≤ localVariation u U := by
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  have hloc : LocalVariationTest U X := by
    refine ⟨⟨hX.smooth, hX.compact, fun x ↦ (hX.norm_bound x).trans (hρle x)⟩, ?_⟩
    intro i
    apply Set.Subset.trans _ hρU
    apply closure_mono
    intro x hx
    change ρ x ≠ 0
    intro hz
    have hb := (coordinate_norm_le_variationDensity (X x) i).trans (hX.norm_bound x)
    rw [hz] at hb
    exact hx (norm_le_zero_iff.mp hb)
  exact le_iSup_of_le X (le_iSup_of_le hloc le_rfl)

theorem local_test_weighted (K : Set (Fin n → ℝ)) (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : VariationTest (fun _ ↦ 1) X) (hsX : ∀ i, tsupport (fun x ↦ X x i) ⊆ K)
    (ρ : (Fin n → ℝ) → ℝ) (hρpos : ∀ x, 0 ≤ ρ x) (hρone : ∀ x ∈ K, ρ x = 1) :
    VariationTest ρ X := by
  refine ⟨hX.smooth, hX.compact, ?_⟩
  intro x
  by_cases hx : x ∈ K
  · rw [hρone x hx]
    exact hX.norm_bound x
  · have hz : X x = 0 := by
      ext i
      by_contra hne
      exact hx (hsX i (subset_tsupport _ hne))
    rw [hz]
    simpa [variationDensity] using hρpos x

/-- The leading phase minimizes local dual perimeter under every compact set change
inside an open region. The comparison permits nonsmooth competitor boundaries. -/
theorem top_phase_local_perimeter_minimizing (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (U K V : Set (Fin n → ℝ)) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (hV : ∀ x ∉ K, (x ∈ V ↔ 0 < eval x (homogeneousComponent P.totalDegree P))) :
    localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U ≤ localPerimeter V U := by
  classical
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  let L := K ∪ ⋃ i, tsupport (fun x ↦ X x i)
  have hcL : IsCompact L := hK.union (isCompact_iUnion (fun i ↦ hX.test.compact i))
  have hLU : L ⊆ U := Set.union_subset hKU (Set.iUnion_subset hX.within)
  obtain ⟨ρ, hρ, hcρ, hρU, hρb, hρone, hρflat⟩ := exists_local_cutoff L U hcL hU hLU
  have hXρ : VariationTest ρ X := local_test_weighted L X hX.test
    (fun i x hx ↦ Or.inr (Set.mem_iUnion.mpr ⟨i, hx⟩)) ρ (fun x ↦ (hρb x).1) hρone
  calc
    _ ≤ weightedPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} ρ :=
      test_le_weightedVariation _ _ _ hXρ
    _ ≤ weightedPerimeter V ρ := top_phase_perimeter_comparison P hmin hdeg hρ hcρ
      (fun x ↦ (hρb x).1) K V (fun x hx ↦ hρflat x (Or.inl hx)) hV
    _ ≤ localPerimeter V U := weightedVariation_le_local _ _ _ hρU (fun x ↦ (hρb x).2)

theorem top_phase_local_perimeter_finite (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (U : Set (Fin n → ℝ)) (hU : IsCompact (closure U)) :
    localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U < ⊤ := by
  obtain ⟨C, _, hC⟩ := Source29PhaseLocalVariation.top_locally_bounded_phase_variation
    P hmin hdeg (closure U) hU
  have hb : localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U ≤
      ENNReal.ofReal C := by
    apply iSup_le
    intro X
    apply iSup_le
    intro hX
    exact ENNReal.ofReal_le_ofReal (hC X hX.test.smooth
      (fun i ↦ (subset_tsupport _).trans ((hX.within i).trans subset_closure)) hX.test.norm_bound)
  exact hb.trans_lt ENNReal.ofReal_lt_top

/-- Local finiteness and comparison under compact perturbations, expressed
entirely in the divergence-test definition of perimeter. -/
def LocallyPerimeterMinimizing (S : Set (Fin n → ℝ)) : Prop :=
  (∀ U : Set (Fin n → ℝ), IsCompact (closure U) → localPerimeter S U < ⊤) ∧
  ∀ U K V : Set (Fin n → ℝ), IsOpen U → IsCompact K → K ⊆ U →
    (∀ x ∉ K, (x ∈ V ↔ x ∈ S)) → localPerimeter S U ≤ localPerimeter V U

theorem top_positive_phase_minimizing (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    LocallyPerimeterMinimizing {x | 0 < eval x (homogeneousComponent P.totalDegree P)} := by
  exact ⟨top_phase_local_perimeter_finite P hmin hdeg,
    top_phase_local_perimeter_minimizing P hmin hdeg⟩

theorem top_phases_locally_perimeter_minimizing (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) :
    LocallyPerimeterMinimizing {x | 0 < eval x (homogeneousComponent P.totalDegree P)} ∧
    LocallyPerimeterMinimizing {x | eval x (homogeneousComponent P.totalDegree P) < 0} := by
  refine ⟨top_positive_phase_minimizing P hmin hdeg, ?_⟩
  have hm : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (-P) := by
    change Source29QuarticReuse.QuarticPolynomialBasics.minimalGraphOperator (-P) = 0
    rw [Source29QuarticReuse.FluxPolynomial.minimalGraphOperator_neg]
    exact neg_eq_zero.mpr hmin
  have hd : 2 ≤ (-P).totalDegree := by simpa only [totalDegree_neg] using hdeg
  simpa only [totalDegree_neg, map_neg, neg_pos] using top_positive_phase_minimizing (-P) hm hd

end
end Source29LocalPhasePerimeter

/- Component: LocalPerimeterCalculus.inc -/
namespace Source29LocalPerimeterCalculus

open MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29PhaseDivergence Source29WeightedPhaseVariation Source29LocalPhasePerimeter
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

theorem bounded_pairing_integrable {u : (Fin n → ℝ) → ℝ}
    (hu : AEStronglyMeasurable u) {B : ℝ} (hb : ∀ x, ‖u x‖ ≤ B)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    Integrable (fun x ↦ u x * divergence (fun i ↦ Pi.single i 1) X x) :=
  (divergence_integrable X hX hcX).bdd_mul hu (Filter.Eventually.of_forall hb)

theorem integral_divergence_zero (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    (∫ x, divergence (fun i ↦ Pi.single i 1) X x) = 0 := by
  have hi i : Integrable (fun x ↦ fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1)) :=
    (((hX i).continuous_fderiv (by norm_num)).clm_apply continuous_const).integrable_of_hasCompactSupport ((hcX i).fderiv_apply ℝ (Pi.single i 1))
  have hz i : (∫ x, fderiv ℝ (fun y ↦ X y i) x (Pi.single i 1)) = 0 := by
    have h := integral_mul_fderiv_eq_neg_of_compactSupport (μ := volume)
      (g := fun _ : Fin n → ℝ ↦ (1 : ℝ)) (hX i) (hcX i) contDiff_const (Pi.single i 1)
    simpa using h.symm
  simp only [divergence, integral_finsetSum _ (fun i _ ↦ hi i), hz, Finset.sum_const_zero]

theorem divergence_zero_outside {U : Set (Fin n → ℝ)}
    {X : (Fin n → ℝ) → Fin n → ℝ} (hX : LocalVariationTest U X)
    {x : Fin n → ℝ} (hx : x ∉ U) : divergence (fun i ↦ Pi.single i 1) X x = 0 := by
  apply Finset.sum_eq_zero
  intro i _
  have hd : fderiv ℝ (fun y ↦ X y i) x = 0 :=
    fderiv_of_notMem_tsupport ℝ (fun h ↦ hx (hX.within i h))
  rw [hd, zero_apply]

theorem localVariation_congr_ae_on {u v : (Fin n → ℝ) → ℝ} (U : Set (Fin n → ℝ))
    (huv : ∀ᵐ x, x ∈ U → u x = v x) : localVariation u U = localVariation v U := by
  apply iSup_congr
  intro X
  apply iSup_congr
  intro hX
  congr 2
  apply integral_congr_ae
  filter_upwards [huv] with x hx
  by_cases hxu : x ∈ U
  · rw [hx hxu]
  · rw [divergence_zero_outside hX hxu, mul_zero, mul_zero]

theorem localVariation_mono (u : (Fin n → ℝ) → ℝ)
    {U V : Set (Fin n → ℝ)} (hUV : U ⊆ V) : localVariation u U ≤ localVariation u V := by
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  exact le_iSup_of_le X (le_iSup_of_le ⟨hX.test, fun i ↦ (hX.within i).trans hUV⟩ le_rfl)

theorem localVariation_neg (u : (Fin n → ℝ) → ℝ) (U : Set (Fin n → ℝ)) :
    localVariation (fun x ↦ -u x) U = localVariation u U := by
  unfold localVariation
  simp only [neg_mul, integral_neg, abs_neg]

theorem localVariation_add_const (u : (Fin n → ℝ) → ℝ)
    (c : ℝ) (U : Set (Fin n → ℝ)) :
    localVariation (fun x ↦ u x + c) U = localVariation u U := by
  apply iSup_congr
  intro X
  apply iSup_congr
  intro hX
  have hd := divergence_integrable X hX.test.smooth hX.test.compact
  have he : (∫ x, (u x + c) * divergence (fun i ↦ Pi.single i 1) X x) =
      ∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x := by
    by_cases hi : Integrable (fun x ↦ u x * divergence (fun i ↦ Pi.single i 1) X x)
    · simp only [add_mul, integral_add hi (hd.const_mul c), integral_const_mul,
        integral_divergence_zero X hX.test.smooth hX.test.compact, mul_zero, add_zero]
    · have hn : ¬ Integrable (fun x ↦ (u x + c) * divergence (fun i ↦ Pi.single i 1) X x) := by
        intro hj
        apply hi
        convert hj.sub (hd.const_mul c) using 1
        ext x
        simp only [Pi.sub_apply]
        ring
      rw [integral_undef hn, integral_undef hi]
  rw [he]

theorem localVariation_add_le {u v : (Fin n → ℝ) → ℝ}
    (hu : AEStronglyMeasurable u) (hv : AEStronglyMeasurable v)
    {B C : ℝ} (hb : ∀ x, ‖u x‖ ≤ B) (hc : ∀ x, ‖v x‖ ≤ C)
    (U : Set (Fin n → ℝ)) :
    localVariation (fun x ↦ u x + v x) U ≤ localVariation u U + localVariation v U := by
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  have hi := bounded_pairing_integrable hu hb X hX.test.smooth hX.test.compact
  have hj := bounded_pairing_integrable hv hc X hX.test.smooth hX.test.compact
  simp only [add_mul, integral_add hi hj]
  calc
    _ ≤ ENNReal.ofReal (|∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x| +
        |∫ x, v x * divergence (fun i ↦ Pi.single i 1) X x|) :=
      ENNReal.ofReal_le_ofReal (abs_add_le _ _)
    _ = ENNReal.ofReal |∫ x, u x * divergence (fun i ↦ Pi.single i 1) X x| +
        ENNReal.ofReal |∫ x, v x * divergence (fun i ↦ Pi.single i 1) X x| :=
      ENNReal.ofReal_add (abs_nonneg _) (abs_nonneg _)
    _ ≤ _ := by
      apply add_le_add
      · exact le_iSup_of_le X (le_iSup_of_le hX le_rfl)
      · exact le_iSup_of_le X (le_iSup_of_le hX le_rfl)

def setIndicator (S : Set (Fin n → ℝ)) : (Fin n → ℝ) → ℝ := by
  classical
  exact fun x ↦ if x ∈ S then 1 else 0

theorem localPerimeter_eq (S U : Set (Fin n → ℝ)) :
    localPerimeter S U = localVariation (setIndicator S) U := rfl

theorem set_indicator_measurable (S : Set (Fin n → ℝ)) (hS : MeasurableSet S) :
    AEStronglyMeasurable (setIndicator S) := by
  classical
  exact (measurable_const.ite hS measurable_const).aestronglyMeasurable

theorem set_indicator_bound (S : Set (Fin n → ℝ)) (x : Fin n → ℝ) :
    ‖setIndicator S x‖ ≤ 1 := by
  classical
  unfold setIndicator
  split_ifs <;> norm_num

theorem localPerimeter_compl (S U : Set (Fin n → ℝ)) :
    localPerimeter Sᶜ U = localPerimeter S U := by
  classical
  have he : setIndicator Sᶜ = fun x ↦ -setIndicator S x + 1 := by
    funext x
    by_cases hx : x ∈ S <;> simp [setIndicator, hx]
  rw [localPerimeter_eq, localPerimeter_eq]
  rw [he]
  have ha := localVariation_add_const (fun x ↦ -setIndicator S x) 1 U
  exact ha.trans (localVariation_neg (setIndicator S) U)

theorem localPerimeter_disjoint_union_le (S T U : Set (Fin n → ℝ))
    (hS : MeasurableSet S) (hT : MeasurableSet T) (hST : Disjoint S T) :
    localPerimeter (S ∪ T) U ≤ localPerimeter S U + localPerimeter T U := by
  classical
  have he : setIndicator (S ∪ T) = fun x ↦ setIndicator S x + setIndicator T x := by
    funext x
    by_cases hs : x ∈ S
    · have ht : x ∉ T := fun ht ↦ Set.disjoint_left.mp hST hs ht
      simp [setIndicator, hs, ht]
    · by_cases ht : x ∈ T <;> simp [setIndicator, hs, ht]
  rw [localPerimeter_eq, localPerimeter_eq, localPerimeter_eq]
  rw [he]
  exact localVariation_add_le (set_indicator_measurable S hS) (set_indicator_measurable T hT)
    (set_indicator_bound S) (set_indicator_bound T) U

end
end Source29LocalPerimeterCalculus

/- Component: LocalPerimeterLimits.inc -/
namespace Source29LocalPerimeterLimits

open MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29PhaseDivergence Source29LocalPhasePerimeter Source29LocalPerimeterCalculus
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

theorem pairing_tendsto_of_bounded_ae
    {u : ℕ → (Fin n → ℝ) → ℝ} {v : (Fin n → ℝ) → ℝ}
    (hu : ∀ k, AEStronglyMeasurable (u k)) {B : ℝ}
    (hb : ∀ k x, ‖u k x‖ ≤ B)
    (hl : ∀ᵐ x, Tendsto (fun k ↦ u k x) atTop (𝓝 (v x)))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ i, ContDiff ℝ 1 (fun x ↦ X x i))
    (hcX : ∀ i, HasCompactSupport (fun x ↦ X x i)) :
    Tendsto (fun k ↦ ∫ x, u k x * divergence (fun i ↦ Pi.single i 1) X x)
      atTop (𝓝 (∫ x, v x * divergence (fun i ↦ Pi.single i 1) X x)) := by
  have hd := divergence_integrable X hX hcX
  apply tendsto_integral_of_dominated_convergence
    (fun x ↦ B * ‖divergence (fun i ↦ Pi.single i 1) X x‖)
  · intro k
    exact (hu k).mul hd.aestronglyMeasurable
  · exact hd.norm.const_mul B
  · intro k
    exact Filter.Eventually.of_forall fun x ↦ (by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hb k x) (norm_nonneg _))
  · filter_upwards [hl] with x hx
    exact hx.mul (tendsto_const_nhds (x := divergence (fun i ↦ Pi.single i 1) X x))

/-- Lower semicontinuity follows directly from convergence against compact vector tests. -/
theorem localVariation_le_liminf_of_pairings
    (u : ℕ → (Fin n → ℝ) → ℝ) (v : (Fin n → ℝ) → ℝ) (U : Set (Fin n → ℝ))
    (hl : ∀ X : (Fin n → ℝ) → Fin n → ℝ, LocalVariationTest U X →
      Tendsto (fun k ↦ ∫ x, u k x * divergence (fun i ↦ Pi.single i 1) X x)
        atTop (𝓝 (∫ x, v x * divergence (fun i ↦ Pi.single i 1) X x))) :
    localVariation v U ≤ liminf (fun k ↦ localVariation (u k) U) atTop := by
  apply iSup_le
  intro X
  apply iSup_le
  intro hX
  have ht := ENNReal.tendsto_ofReal (hl X hX).abs
  rw [← ht.liminf_eq]
  exact liminf_le_liminf (Filter.Eventually.of_forall fun k ↦
    le_iSup_of_le X (le_iSup_of_le hX le_rfl))

/-- Perimeter bounds survive uniformly bounded almost-everywhere limits. -/
theorem localVariation_le_liminf_of_bounded_ae
    {u : ℕ → (Fin n → ℝ) → ℝ} {v : (Fin n → ℝ) → ℝ}
    (hu : ∀ k, AEStronglyMeasurable (u k)) {B : ℝ}
    (hb : ∀ k x, ‖u k x‖ ≤ B)
    (hl : ∀ᵐ x, Tendsto (fun k ↦ u k x) atTop (𝓝 (v x))) (U : Set (Fin n → ℝ)) :
    localVariation v U ≤ liminf (fun k ↦ localVariation (u k) U) atTop := by
  apply localVariation_le_liminf_of_pairings
  intro X hX
  exact pairing_tendsto_of_bounded_ae hu hb hl X hX.test.smooth hX.test.compact

theorem localPerimeter_le_liminf
    (S : ℕ → Set (Fin n → ℝ)) (T U : Set (Fin n → ℝ))
    (hS : ∀ k, MeasurableSet (S k))
    (hl : ∀ᵐ x, Tendsto (fun k ↦ setIndicator (S k) x) atTop (𝓝 (setIndicator T x))) :
    localPerimeter T U ≤ liminf (fun k ↦ localPerimeter (S k) U) atTop := by
  simpa only [localPerimeter_eq] using localVariation_le_liminf_of_bounded_ae
    (fun k ↦ set_indicator_measurable (S k) (hS k))
    (fun k ↦ set_indicator_bound (S k)) hl U

/-- Compactly supported tests exhaust a directed union of open regions. -/
theorem localVariation_directed_iUnion {ι : Type*} [Nonempty ι]
    (u : (Fin n → ℝ) → ℝ) (U : ι → Set (Fin n → ℝ))
    (hU : ∀ i, IsOpen (U i)) (hdir : Directed (· ⊆ ·) U) :
    localVariation u (⋃ i, U i) = ⨆ i, localVariation u (U i) := by
  apply le_antisymm
  · apply iSup_le
    intro X
    apply iSup_le
    intro hX
    let K := ⋃ i, tsupport (fun x ↦ X x i)
    have hK : IsCompact K := isCompact_iUnion (fun i ↦ hX.test.compact i)
    have hKU : K ⊆ ⋃ i, U i := Set.iUnion_subset hX.within
    obtain ⟨j, hj⟩ := hK.elim_directed_cover U hU hKU hdir
    have ht : LocalVariationTest (U j) X :=
      ⟨hX.test, fun i x hx ↦ hj (Set.mem_iUnion.mpr ⟨i, hx⟩)⟩
    calc
      _ ≤ localVariation u (U j) := le_iSup_of_le X (le_iSup_of_le ht le_rfl)
      _ ≤ _ := le_iSup (fun i ↦ localVariation u (U i)) j
  · apply iSup_le
    intro i
    exact localVariation_mono u (Set.subset_iUnion U i)

theorem localPerimeter_directed_iUnion {ι : Type*} [Nonempty ι]
    (S : Set (Fin n → ℝ)) (U : ι → Set (Fin n → ℝ))
    (hU : ∀ i, IsOpen (U i)) (hdir : Directed (· ⊆ ·) U) :
    localPerimeter S (⋃ i, U i) = ⨆ i, localPerimeter S (U i) :=
  localVariation_directed_iUnion (setIndicator S) U hU hdir

end
end Source29LocalPerimeterLimits

/- Component: PerimeterRepresentatives.inc -/
namespace Source29PerimeterRepresentatives

open MeasureTheory Filter
open Source29LocalPhasePerimeter Source29LocalPerimeterCalculus
open scoped Topology

noncomputable section
variable {n : ℕ}

theorem localPerimeter_congr_ae (S T U : Set (Fin n → ℝ))
    (he : ∀ᵐ x, x ∈ S ↔ x ∈ T) : localPerimeter S U = localPerimeter T U := by
  classical
  rw [localPerimeter_eq, localPerimeter_eq]
  apply localVariation_congr_ae_on
  filter_upwards [he] with x hx
  intro _
  simp only [setIndicator, hx]

/-- Complementing a locally perimeter-minimizing set preserves minimality. -/
theorem locallyPerimeterMinimizing_compl {S : Set (Fin n → ℝ)}
    (hS : LocallyPerimeterMinimizing S) : LocallyPerimeterMinimizing Sᶜ := by
  refine ⟨?_, ?_⟩
  · intro U hU
    rw [localPerimeter_compl]
    exact hS.1 U hU
  · intro U K V hU hK hKU hV
    rw [localPerimeter_compl]
    have he : ∀ x ∉ K, (x ∈ Vᶜ ↔ x ∈ S) := by
      intro x hx
      simpa only [Set.mem_compl_iff, not_not] using not_congr (hV x hx)
    have h := hS.2 U K Vᶜ hU hK hKU he
    rwa [localPerimeter_compl] at h

/-- Local minimality depends on the almost-everywhere representative only. -/
theorem locallyPerimeterMinimizing_congr_ae {S T : Set (Fin n → ℝ)}
    (he : ∀ᵐ x, x ∈ S ↔ x ∈ T) (hS : LocallyPerimeterMinimizing S) :
    LocallyPerimeterMinimizing T := by
  classical
  refine ⟨?_, ?_⟩
  · intro U hU
    rw [← localPerimeter_congr_ae S T U he]
    exact hS.1 U hU
  · intro U K V hU hK hKU hV
    let W := (V ∩ K) ∪ (S \ K)
    have hW : ∀ x ∉ K, (x ∈ W ↔ x ∈ S) := by
      intro x hx
      simp [W, hx]
    have hWV : ∀ᵐ x, x ∈ W ↔ x ∈ V := by
      filter_upwards [he] with x hx
      by_cases hk : x ∈ K
      · simp [W, hk]
      · simp [W, hk, hx, hV x hk]
    rw [← localPerimeter_congr_ae S T U he, ← localPerimeter_congr_ae W V U hWV]
    exact hS.2 U K W hU hK hKU hW

end
end Source29PerimeterRepresentatives

/- Component: LocalPerimeterMass.inc -/
namespace Source29LocalPerimeterMass

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29WeightedPhaseVariation Source29TopPhasePerimeter Source29LocalPhasePerimeter
open Source29PhaseMassLimit
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

structure LocalWeight (U : Set (Fin n → ℝ)) (ρ : (Fin n → ℝ) → ℝ) : Prop where
  smooth : ContDiff ℝ 1 ρ
  compact : HasCompactSupport ρ
  within : tsupport ρ ⊆ U
  bound : ∀ x, 0 ≤ ρ x ∧ ρ x ≤ 1

/-- Smooth scalar cutoffs recover the entire local variation, not merely a bound. -/
theorem localVariation_eq_iSup_weighted (u : (Fin n → ℝ) → ℝ)
    (U : Set (Fin n → ℝ)) (hU : IsOpen U) :
    localVariation u U = ⨆ (ρ : (Fin n → ℝ) → ℝ) (_ : LocalWeight U ρ),
      weightedVariation u ρ := by
  apply le_antisymm
  · apply iSup_le
    intro X
    apply iSup_le
    intro hX
    let K := ⋃ i, tsupport (fun x ↦ X x i)
    have hK : IsCompact K := isCompact_iUnion (fun i ↦ hX.test.compact i)
    have hKU : K ⊆ U := Set.iUnion_subset hX.within
    obtain ⟨ρ, hρ, hcρ, hρU, hρb, hρone, _⟩ := exists_local_cutoff K U hK hU hKU
    have ht : VariationTest ρ X := local_test_weighted K X hX.test
      (fun i ↦ Set.subset_iUnion (fun i ↦ tsupport (fun x ↦ X x i)) i)
      ρ (fun x ↦ (hρb x).1) hρone
    calc
      _ ≤ weightedVariation u ρ := test_le_weightedVariation u ρ X ht
      _ ≤ _ := by
        apply le_iSup_of_le ρ
        exact le_iSup (fun _ : LocalWeight U ρ ↦ weightedVariation u ρ)
          ⟨hρ, hcρ, hρU, hρb⟩
  · apply iSup_le
    intro ρ
    apply iSup_le
    intro hρ
    exact weightedVariation_le_local u ρ U hρ.within (fun x ↦ (hρ.bound x).2)

/-- The leading phase's local perimeter is exactly its positive calibrated mass
tested against all compact smooth weights between zero and one in the region. -/
theorem top_localPerimeter_eq_iSup_mass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree) (U : Set (Fin n → ℝ)) (hU : IsOpen U) :
    localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U =
      ⨆ (ρ : (Fin n → ℝ) → ℝ) (_ : LocalWeight U ρ),
        ENNReal.ofReal (phaseMass (homogeneousComponent P.totalDegree P) ρ) := by
  classical
  rw [localPerimeter, localVariation_eq_iSup_weighted _ U hU]
  apply iSup_congr
  intro ρ
  apply iSup_congr
  intro hρ
  exact top_phase_perimeter_eq_mass P hmin hdeg hρ.smooth hρ.compact
    (fun x ↦ (hρ.bound x).1)

end
end Source29LocalPerimeterMass

/- Component: PhaseMassFunctional.inc -/
namespace Source29PhaseMassFunctional

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29WeakCalibrationLimits
open Source29NonlinearCalibration Source29SmoothPhaseTransition Source29PhaseMassLimit
open Source29LocalPhasePerimeter
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem phaseMass_add (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ σ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : ContDiff ℝ 1 σ) (hcσ : HasCompactSupport σ) :
    phaseMass P (fun x ↦ ρ x + σ x) = phaseMass P ρ + phaseMass P σ := by
  apply tendsto_nhds_unique (phaseMass_tendsto P hP hcal (hρ.add hσ) (hcρ.add hcσ))
  convert (phaseMass_tendsto P hP hcal hρ hcρ).add
    (phaseMass_tendsto P hP hcal hσ hcσ) using 1
  funext k
  simp only [add_mul]
  exact integral_add
    (localized_gradient_mass_identity P hcal hρ hcρ
      (transition_contDiff k) (transition_norm_le_one k)).1
    (localized_gradient_mass_identity P hcal hσ hcσ
      (transition_contDiff k) (transition_norm_le_one k)).1

theorem phaseMass_const_mul (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) (c : ℝ) :
    phaseMass P (fun x ↦ c * ρ x) = c * phaseMass P ρ := by
  apply tendsto_nhds_unique
    (phaseMass_tendsto P hP hcal (contDiff_const.mul hρ) hcρ.mul_left)
  convert (phaseMass_tendsto P hP hcal hρ hcρ).const_mul c using 1
  funext k
  simp only [mul_assoc, integral_const_mul]

/-- Positivity also gives order preservation for signed smooth weights. -/
theorem phaseMass_mono (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ σ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : ContDiff ℝ 1 σ) (hcσ : HasCompactSupport σ) (hle : ∀ x, ρ x ≤ σ x) :
    phaseMass P ρ ≤ phaseMass P σ := by
  apply le_of_tendsto_of_tendsto (phaseMass_tendsto P hP hcal hρ hcρ)
    (phaseMass_tendsto P hP hcal hσ hcσ)
  apply Filter.Eventually.of_forall
  intro k
  apply integral_mono
    (localized_gradient_mass_identity P hcal hρ hcρ
      (transition_contDiff k) (transition_norm_le_one k)).1
    (localized_gradient_mass_identity P hcal hσ hcσ
      (transition_contDiff k) (transition_norm_le_one k)).1
  intro x
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right (hle x) (transition_deriv_nonneg k _)) (Real.sqrt_nonneg _)

theorem phaseMass_abs_le (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ σ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : ContDiff ℝ 1 σ) (hcσ : HasCompactSupport σ)
    (C : ℝ) (hb : ∀ x, |σ x| ≤ C * ρ x) :
    |phaseMass P σ| ≤ C * phaseMass P ρ := by
  apply abs_le.mpr
  constructor
  · have h := phaseMass_mono P hP hcal (contDiff_const.mul hρ) hcρ.mul_left hσ hcσ
      (fun x ↦ (show -C * ρ x ≤ σ x by nlinarith [abs_le.mp (hb x)]))
    rw [phaseMass_const_mul P hP hcal hρ hcρ] at h
    linarith
  · have h := phaseMass_mono P hP hcal hσ hcσ (contDiff_const.mul hρ) hcρ.mul_left
      (fun x ↦ (abs_le.mp (hb x)).2)
    rwa [phaseMass_const_mul P hP hcal hρ hcρ] at h

/-- On each compact support the mass functional is bounded in the uniform norm.
The same cutoff and constant work for all smooth weights supported there. -/
theorem phaseMass_bounded_on_compact (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ σ : (Fin n → ℝ) → ℝ,
      ContDiff ℝ 1 σ → HasCompactSupport σ → tsupport σ ⊆ K →
      ∀ C : ℝ, 0 ≤ C → (∀ x, |σ x| ≤ C) → |phaseMass P σ| ≤ C * M := by
  obtain ⟨ρ, hρ, hcρ, _, hρb, hρone, _⟩ :=
    exists_local_cutoff K Set.univ hK isOpen_univ (Set.subset_univ K)
  refine ⟨phaseMass P ρ, (phaseMass_bounds P hP hcal hρ hcρ (fun x ↦ (hρb x).1)).1, ?_⟩
  intro σ hσ hcσ hsσ C hC hb
  apply phaseMass_abs_le P hP hcal hρ hcρ hσ hcσ C
  intro x
  by_cases hx : x ∈ K
  · simpa only [hρone x hx, mul_one] using hb x
  · have hz : σ x = 0 := image_eq_zero_of_notMem_tsupport (fun ht ↦ hx (hsσ ht))
    rw [hz, abs_zero]
    exact mul_nonneg hC (hρb x).1

end
end Source29PhaseMassFunctional

/- Component: SmoothCompactApprox.inc -/
namespace Source29SmoothCompactApprox

open Source29LocalPhasePerimeter
open MeasureTheory Metric
open scoped Topology Convolution

noncomputable section
variable {n : ℕ}

theorem uniform_smooth_approximation {f : (Fin n → ℝ) → ℝ}
    (hf : UniformContinuous f) {ε : ℝ} (hε : 0 < ε) :
    ∃ g : (Fin n → ℝ) → ℝ, ContDiff ℝ 1 g ∧ ∀ x, dist (g x) (f x) < ε := by
  obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.mp hf (ε / 2) (half_pos hε)
  let φ : ContDiffBump (0 : Fin n → ℝ) := ⟨δ / 2, δ, half_pos hδ, half_lt_self hδ⟩
  have hi : Integrable φ := φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport
  have hp : 0 < ∫ x, φ x := by
    apply (integral_pos_iff_support_of_nonneg φ.nonneg' hi).mpr
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 φ.rOut_pos
  let ψ : (Fin n → ℝ) → ℝ := fun x ↦ φ x / ∫ y, φ y
  have hs : HasCompactSupport ψ := by
    dsimp [ψ]
    simp only [div_eq_mul_inv]
    exact φ.hasCompactSupport.mul_right
  have hc : ContDiff ℝ 1 ψ := φ.contDiff.div_const _
  have hψ : ∫ x, ψ x = 1 := by
    dsimp [ψ]
    rw [integral_div]
    exact div_self hp.ne'
  have hψs : Function.support ψ ⊆ ball 0 δ := by
    intro x hx
    apply φ.support_eq.subset
    change φ x ≠ 0
    intro hz
    exact hx (by simp [ψ, hz])
  refine ⟨convolution ψ f (ContinuousLinearMap.lsmul ℝ ℝ) volume,
    hs.contDiff_convolution_left _ hc hf.continuous.locallyIntegrable, ?_⟩
  intro x
  apply lt_of_le_of_lt _ (half_lt_self hε)
  exact dist_convolution_le (half_pos hε).le hψs
    (fun y ↦ div_nonneg φ.nonneg hp.le) hψ hf.continuous.aestronglyMeasurable
    (fun y hy ↦ (hfδ hy).le)

/-- A continuous compactly supported weight admits uniform smooth approximations
whose supports all lie in one fixed compact set. -/
theorem exists_uniform_approximation (f : (Fin n → ℝ) → ℝ)
    (hf : Continuous f) (hcf : HasCompactSupport f) :
    ∃ K : Set (Fin n → ℝ), IsCompact K ∧
      ∀ ε : ℝ, 0 < ε → ∃ g : (Fin n → ℝ) → ℝ,
        ContDiff ℝ 1 g ∧ HasCompactSupport g ∧ tsupport g ⊆ K ∧
        ∀ x, |g x - f x| < ε := by
  obtain ⟨ρ, hρ, hcρ, _, hρb, hρone, _⟩ := exists_local_cutoff (tsupport f) Set.univ
    hcf isOpen_univ (Set.subset_univ _)
  have hu : UniformContinuous f := hf.uniformContinuous_of_tendsto_cocompact hcf.is_zero_at_infty
  refine ⟨tsupport ρ, hcρ, ?_⟩
  intro ε hε
  obtain ⟨g, hg, hgf⟩ := uniform_smooth_approximation hu hε
  refine ⟨fun x ↦ ρ x * g x, hρ.mul hg, hcρ.mul_right,
    tsupport_mul_subset_left, ?_⟩
  intro x
  have he : ρ x * f x = f x := by
    by_cases hx : x ∈ tsupport f
    · rw [hρone x hx, one_mul]
    · rw [image_eq_zero_of_notMem_tsupport hx, mul_zero]
  calc
    |ρ x * g x - f x| = |ρ x| * |g x - f x| := by rw [← abs_mul]; congr 1; nlinarith [he]
    _ ≤ 1 * |g x - f x| := mul_le_mul_of_nonneg_right
      (by rw [abs_of_nonneg (hρb x).1]; exact (hρb x).2) (abs_nonneg _)
    _ < ε := by simpa only [one_mul, Real.dist_eq] using hgf x

end
end Source29SmoothCompactApprox

/- Component: SmoothMassLimits.inc -/
namespace Source29SmoothMassLimits

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PhaseMassLimit Source29PhaseMassFunctional
open scoped Topology

noncomputable section
variable {n : ℕ}

theorem phaseMass_sub (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ σ : (Fin n → ℝ) → ℝ}
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hσ : ContDiff ℝ 1 σ) (hcσ : HasCompactSupport σ) :
    phaseMass P (fun x ↦ ρ x - σ x) = phaseMass P ρ - phaseMass P σ := by
  have he : (fun x ↦ ρ x - σ x) = (fun x ↦ ρ x + (-1 : ℝ) * σ x) := by
    funext x
    ring
  rw [he, phaseMass_add P hP hcal hρ hcρ (contDiff_const.mul hσ) hcσ.mul_left,
    phaseMass_const_mul P hP hcal hσ hcσ]
  ring

/-- Uniformly converging smooth approximations supported in a common compact
set give a Cauchy sequence of masses. The limiting function need not be smooth. -/
theorem phaseMass_cauchy_of_uniform_error
    (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K)
    (g : ℕ → (Fin n → ℝ) → ℝ) (f : (Fin n → ℝ) → ℝ)
    (hg : ∀ k, ContDiff ℝ 1 (g k)) (hcg : ∀ k, HasCompactSupport (g k))
    (hsg : ∀ k, tsupport (g k) ⊆ K)
    (η : ℕ → ℝ) (hη : ∀ k, 0 ≤ η k) (htη : Tendsto η atTop (𝓝 0))
    (herr : ∀ k x, |g k x - f x| ≤ η k) :
    CauchySeq (fun k ↦ phaseMass P (g k)) := by
  obtain ⟨M, hM, hbound⟩ := phaseMass_bounded_on_compact P hP hcal K hK
  apply Metric.cauchySeq_iff.mpr
  intro ε hε
  have hd : 0 < ε / (2 * (M + 1)) := div_pos hε (by positivity)
  obtain ⟨N, hN⟩ := eventually_atTop.mp (htη.eventually (gt_mem_nhds hd))
  refine ⟨N, ?_⟩
  intro j hj k hk
  have he x : |g j x - g k x| ≤ η j + η k := by
    calc
      _ ≤ |g j x - f x| + |f x - g k x| := abs_sub_le _ _ _
      _ = |g j x - f x| + |g k x - f x| := by rw [abs_sub_comm (f x)]
      _ ≤ _ := add_le_add (herr j x) (herr k x)
  have hs : tsupport (fun x ↦ g j x - g k x) ⊆ K := by
    apply closure_minimal _ hK.isClosed
    intro x hx
    by_contra hn
    have hjz := image_eq_zero_of_notMem_tsupport (fun ht ↦ hn (hsg j ht))
    have hkz := image_eq_zero_of_notMem_tsupport (fun ht ↦ hn (hsg k ht))
    exact hx (by simp [hjz, hkz])
  have hb := hbound (fun x ↦ g j x - g k x) ((hg j).sub (hg k))
    ((hcg j).sub (hcg k)) hs (η j + η k) (add_nonneg (hη j) (hη k)) he
  rw [phaseMass_sub P hP hcal (hg j) (hcg j) (hg k) (hcg k)] at hb
  rw [Real.dist_eq]
  apply hb.trans_lt
  have hsum : η j + η k < ε / (M + 1) := by
    have hnj := hN j hj
    have hnk := hN k hk
    have heq : ε / (2 * (M + 1)) + ε / (2 * (M + 1)) = ε / (M + 1) := by
      rw [mul_comm 2 (M + 1), div_mul_eq_div_div]
      ring
    linarith
  have hmul : (η j + η k) * (M + 1) < ε := (lt_div_iff₀ (by positivity)).mp hsum
  nlinarith [add_nonneg (hη j) (hη k)]

theorem exists_phaseMass_limit_of_uniform_error
    (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K)
    (g : ℕ → (Fin n → ℝ) → ℝ) (f : (Fin n → ℝ) → ℝ)
    (hg : ∀ k, ContDiff ℝ 1 (g k)) (hcg : ∀ k, HasCompactSupport (g k))
    (hsg : ∀ k, tsupport (g k) ⊆ K)
    (η : ℕ → ℝ) (hη : ∀ k, 0 ≤ η k) (htη : Tendsto η atTop (𝓝 0))
    (herr : ∀ k x, |g k x - f x| ≤ η k) :
    ∃ m : ℝ, Tendsto (fun k ↦ phaseMass P (g k)) atTop (𝓝 m) :=
  cauchySeq_tendsto_of_complete
    (phaseMass_cauchy_of_uniform_error P hP hcal K hK g f hg hcg hsg η hη htη herr)

/-- Changing a smooth approximation by a uniformly vanishing error does not
change its limiting mass, provided the supports remain in a common compact set. -/
theorem phaseMass_sub_tendsto_zero
    (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K)
    (g h : ℕ → (Fin n → ℝ) → ℝ)
    (hg : ∀ k, ContDiff ℝ 1 (g k)) (hcg : ∀ k, HasCompactSupport (g k))
    (hsg : ∀ k, tsupport (g k) ⊆ K)
    (hh : ∀ k, ContDiff ℝ 1 (h k)) (hch : ∀ k, HasCompactSupport (h k))
    (hsh : ∀ k, tsupport (h k) ⊆ K)
    (η : ℕ → ℝ) (hη : ∀ k, 0 ≤ η k) (htη : Tendsto η atTop (𝓝 0))
    (herr : ∀ k x, |g k x - h k x| ≤ η k) :
    Tendsto (fun k ↦ phaseMass P (g k) - phaseMass P (h k)) atTop (𝓝 0) := by
  obtain ⟨M, _, hbound⟩ := phaseMass_bounded_on_compact P hP hcal K hK
  have hb k : |phaseMass P (g k) - phaseMass P (h k)| ≤ η k * M := by
    have hs : tsupport (fun x ↦ g k x - h k x) ⊆ K :=
      (tsupport_binop_subset (fun a b : ℝ ↦ a - b) (sub_self 0) (g k) (h k)).trans
        (Set.union_subset (hsg k) (hsh k))
    rw [← phaseMass_sub P hP hcal (hg k) (hcg k) (hh k) (hch k)]
    exact hbound _ ((hg k).sub (hh k)) ((hcg k).sub (hch k)) hs (η k) (hη k) (herr k)
  apply squeeze_zero_norm (fun k ↦ by simpa only [Real.norm_eq_abs] using hb k)
  simpa only [zero_mul] using htη.mul_const M

theorem phaseMass_limit_unique_of_uniform_error
    (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K : Set (Fin n → ℝ)) (hK : IsCompact K)
    (g h : ℕ → (Fin n → ℝ) → ℝ)
    (hg : ∀ k, ContDiff ℝ 1 (g k)) (hcg : ∀ k, HasCompactSupport (g k))
    (hsg : ∀ k, tsupport (g k) ⊆ K)
    (hh : ∀ k, ContDiff ℝ 1 (h k)) (hch : ∀ k, HasCompactSupport (h k))
    (hsh : ∀ k, tsupport (h k) ⊆ K)
    (η : ℕ → ℝ) (hη : ∀ k, 0 ≤ η k) (htη : Tendsto η atTop (𝓝 0))
    (herr : ∀ k x, |g k x - h k x| ≤ η k)
    {a b : ℝ} (ha : Tendsto (fun k ↦ phaseMass P (g k)) atTop (𝓝 a))
    (hb : Tendsto (fun k ↦ phaseMass P (h k)) atTop (𝓝 b)) : a = b := by
  exact sub_eq_zero.mp (tendsto_nhds_unique (ha.sub hb)
    (phaseMass_sub_tendsto_zero P hP hcal K hK g h hg hcg hsg hh hch hsh η hη htη herr))

end
end Source29SmoothMassLimits

/- Component: SmoothMassExtension.inc -/
namespace Source29SmoothMassExtension

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PhaseMassLimit Source29PhaseMassFunctional Source29SmoothMassLimits
open Source29SmoothCompactApprox
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Smooth approximations with one compact support bound and a vanishing uniform error. -/
structure Approximation (f : (Fin n → ℝ) → ℝ) where
  carrier : Set (Fin n → ℝ)
  compact_carrier : IsCompact carrier
  fn : ℕ → (Fin n → ℝ) → ℝ
  smooth : ∀ k, ContDiff ℝ 1 (fn k)
  compact : ∀ k, HasCompactSupport (fn k)
  within : ∀ k, tsupport (fn k) ⊆ carrier
  error : ℕ → ℝ
  nonneg : ∀ k, 0 ≤ error k
  tends : Tendsto error atTop (𝓝 0)
  bound : ∀ k x, |fn k x - f x| ≤ error k

theorem exists_approximation (f : (Fin n → ℝ) → ℝ)
    (hf : Continuous f) (hcf : HasCompactSupport f) : Nonempty (Approximation f) := by
  classical
  obtain ⟨K, hK, ha⟩ := exists_uniform_approximation f hf hcf
  have he (k : ℕ) : 0 < (1 : ℝ) / (k + 1) := by positivity
  choose g hg hcg hsg hbg using fun k : ℕ ↦ ha (1 / (k + 1)) (he k)
  exact ⟨⟨K, hK, g, hg, hcg, hsg, (fun k ↦ 1 / (k + 1)),
    (fun k ↦ (he k).le), tendsto_one_div_add_atTop_nhds_zero_nat,
    (fun k x ↦ (hbg k x).le)⟩⟩

def constantApproximation (f : (Fin n → ℝ) → ℝ)
    (hf : ContDiff ℝ 1 f) (hcf : HasCompactSupport f) : Approximation f where
  carrier := tsupport f
  compact_carrier := hcf
  fn := fun _ ↦ f
  smooth := fun _ ↦ hf
  compact := fun _ ↦ hcf
  within := fun _ ↦ Set.Subset.rfl
  error := fun _ ↦ 0
  nonneg := fun _ ↦ le_rfl
  tends := tendsto_const_nhds
  bound := fun _ _ ↦ by simp

theorem approximation_has_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (a : Approximation f) :
    ∃ m : ℝ, Tendsto (fun k ↦ phaseMass P (a.fn k)) atTop (𝓝 m) :=
  exists_phaseMass_limit_of_uniform_error P hP hcal a.carrier a.compact_carrier
    a.fn f a.smooth a.compact a.within a.error a.nonneg a.tends a.bound

theorem approximation_mass_unique (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (a b : Approximation f)
    {s t : ℝ} (hs : Tendsto (fun k ↦ phaseMass P (a.fn k)) atTop (𝓝 s))
    (ht : Tendsto (fun k ↦ phaseMass P (b.fn k)) atTop (𝓝 t)) : s = t := by
  apply phaseMass_limit_unique_of_uniform_error P hP hcal
    (a.carrier ∪ b.carrier) (a.compact_carrier.union b.compact_carrier)
    a.fn b.fn a.smooth a.compact (fun k ↦ (a.within k).trans Set.subset_union_left)
    b.smooth b.compact (fun k ↦ (b.within k).trans Set.subset_union_right)
    (fun k ↦ a.error k + b.error k) (fun k ↦ add_nonneg (a.nonneg k) (b.nonneg k))
    (by simpa using a.tends.add b.tends) ?_ hs ht
  intro k x
  calc
    _ ≤ |a.fn k x - f x| + |f x - b.fn k x| := abs_sub_le _ _ _
    _ = |a.fn k x - f x| + |b.fn k x - f x| := by rw [abs_sub_comm (f x)]
    _ ≤ _ := add_le_add (a.bound k x) (b.bound k x)

/-- The uniquely determined mass on functions admitting smooth compact approximations. -/
def continuousMass (P : MvPolynomial (Fin n) ℝ) (f : (Fin n → ℝ) → ℝ) : ℝ := by
  classical
  exact if h : ∃ m : ℝ, ∃ a : Approximation f,
      Tendsto (fun k ↦ phaseMass P (a.fn k)) atTop (𝓝 m)
    then Classical.choose h else 0

theorem continuousMass_tendsto (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (a : Approximation f) :
    Tendsto (fun k ↦ phaseMass P (a.fn k)) atTop (𝓝 (continuousMass P f)) := by
  classical
  obtain ⟨m, hm⟩ := approximation_has_mass P hP hcal a
  have he : ∃ m : ℝ, ∃ a : Approximation f,
      Tendsto (fun k ↦ phaseMass P (a.fn k)) atTop (𝓝 m) := ⟨m, a, hm⟩
  unfold continuousMass
  rw [dite_eq_left he]
  obtain ⟨b, hb⟩ := Classical.choose_spec he
  have hmt := approximation_mass_unique P hP hcal a b hm hb
  rwa [← hmt]

theorem continuousMass_eq_phaseMass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (hf : ContDiff ℝ 1 f) (hcf : HasCompactSupport f) :
    continuousMass P f = phaseMass P f := by
  exact tendsto_nhds_unique
    (continuousMass_tendsto P hP hcal (constantApproximation f hf hcf)) tendsto_const_nhds

end
end Source29SmoothMassExtension

/- Component: ContinuousMassAlgebra.inc -/
namespace Source29ContinuousMassAlgebra

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PhaseMassLimit Source29PhaseMassFunctional Source29SmoothMassExtension
open Source29LocalPhasePerimeter
open scoped Topology

noncomputable section
variable {n : ℕ}

def addApproximation {f g : (Fin n → ℝ) → ℝ}
    (a : Approximation f) (b : Approximation g) : Approximation (fun x ↦ f x + g x) where
  carrier := a.carrier ∪ b.carrier
  compact_carrier := a.compact_carrier.union b.compact_carrier
  fn := fun k x ↦ a.fn k x + b.fn k x
  smooth := fun k ↦ (a.smooth k).add (b.smooth k)
  compact := fun k ↦ (a.compact k).add (b.compact k)
  within := fun k ↦ (tsupport_binop_subset (fun a b : ℝ ↦ a + b) (zero_add 0) _ _).trans
    (Set.union_subset_union (a.within k) (b.within k))
  error := fun k ↦ a.error k + b.error k
  nonneg := fun k ↦ add_nonneg (a.nonneg k) (b.nonneg k)
  tends := by simpa using a.tends.add b.tends
  bound := by
    intro k x
    calc
      _ = |(a.fn k x - f x) + (b.fn k x - g x)| := by congr 1; ring
      _ ≤ |a.fn k x - f x| + |b.fn k x - g x| := abs_add_le _ _
      _ ≤ _ := add_le_add (a.bound k x) (b.bound k x)

def mulApproximation {f : (Fin n → ℝ) → ℝ} (a : Approximation f) (c : ℝ) :
    Approximation (fun x ↦ c * f x) where
  carrier := a.carrier
  compact_carrier := a.compact_carrier
  fn := fun k x ↦ c * a.fn k x
  smooth := fun k ↦ contDiff_const.mul (a.smooth k)
  compact := fun k ↦ (a.compact k).mul_left
  within := fun k ↦ tsupport_mul_subset_right.trans (a.within k)
  error := fun k ↦ |c| * a.error k
  nonneg := fun k ↦ mul_nonneg (abs_nonneg c) (a.nonneg k)
  tends := by simpa using a.tends.const_mul |c|
  bound := by
    intro k x
    rw [← mul_sub, abs_mul]
    exact mul_le_mul_of_nonneg_left (a.bound k x) (abs_nonneg c)

theorem continuousMass_add (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f g : (Fin n → ℝ) → ℝ}
    (hf : Continuous f) (hcf : HasCompactSupport f)
    (hg : Continuous g) (hcg : HasCompactSupport g) :
    continuousMass P (fun x ↦ f x + g x) = continuousMass P f + continuousMass P g := by
  obtain ⟨a⟩ := exists_approximation f hf hcf
  obtain ⟨b⟩ := exists_approximation g hg hcg
  have ht := continuousMass_tendsto P hP hcal (addApproximation a b)
  change Tendsto (fun k ↦ phaseMass P (fun x ↦ a.fn k x + b.fn k x)) _ _ at ht
  simp_rw [phaseMass_add P hP hcal (a.smooth _) (a.compact _) (b.smooth _) (b.compact _)] at ht
  exact tendsto_nhds_unique ht ((continuousMass_tendsto P hP hcal a).add
    (continuousMass_tendsto P hP hcal b))

theorem continuousMass_const_mul (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (hf : Continuous f) (hcf : HasCompactSupport f) (c : ℝ) :
    continuousMass P (fun x ↦ c * f x) = c * continuousMass P f := by
  obtain ⟨a⟩ := exists_approximation f hf hcf
  have ht := continuousMass_tendsto P hP hcal (mulApproximation a c)
  change Tendsto (fun k ↦ phaseMass P (fun x ↦ c * a.fn k x)) _ _ at ht
  simp_rw [phaseMass_const_mul P hP hcal (a.smooth _) (a.compact _) c] at ht
  exact tendsto_nhds_unique ht ((continuousMass_tendsto P hP hcal a).const_mul c)

theorem continuousMass_nonneg (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (hf : Continuous f) (hcf : HasCompactSupport f)
    (hpos : ∀ x, 0 ≤ f x) : 0 ≤ continuousMass P f := by
  obtain ⟨a⟩ := exists_approximation f hf hcf
  obtain ⟨ρ, hρ, hcρ, _, hbρ, honeρ, _⟩ := exists_local_cutoff a.carrier Set.univ
    a.compact_carrier isOpen_univ (Set.subset_univ _)
  have hb k : 0 ≤ phaseMass P (a.fn k) + a.error k * phaseMass P ρ := by
    have hpoint x : 0 ≤ a.fn k x + a.error k * ρ x := by
      by_cases hx : x ∈ a.carrier
      · rw [honeρ x hx, mul_one]
        have ha := (abs_le.mp (a.bound k x)).1
        linarith [hpos x]
      · have hz := image_eq_zero_of_notMem_tsupport (fun ht ↦ hx (a.within k ht))
        rw [hz, zero_add]
        exact mul_nonneg (a.nonneg k) (hbρ x).1
    have hm := (phaseMass_bounds P hP hcal ((a.smooth k).add (contDiff_const.mul hρ))
      ((a.compact k).add hcρ.mul_left) hpoint).1
    rwa [phaseMass_add P hP hcal (a.smooth k) (a.compact k) (contDiff_const.mul hρ) hcρ.mul_left,
      phaseMass_const_mul P hP hcal hρ hcρ] at hm
  have ht := (continuousMass_tendsto P hP hcal a).add (a.tends.mul_const (phaseMass P ρ))
  have hn := ge_of_tendsto ht (Filter.Eventually.of_forall hb)
  simpa only [zero_mul, add_zero] using hn

theorem continuousMass_sub (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f g : (Fin n → ℝ) → ℝ}
    (hf : Continuous f) (hcf : HasCompactSupport f)
    (hg : Continuous g) (hcg : HasCompactSupport g) :
    continuousMass P (fun x ↦ f x - g x) = continuousMass P f - continuousMass P g := by
  have he : (fun x ↦ f x - g x) = (fun x ↦ f x + (-1 : ℝ) * g x) := by
    funext x
    ring
  have hneg : Continuous (fun x ↦ (-1 : ℝ) * g x) := continuous_const.mul hg
  have hcneg : HasCompactSupport (fun x ↦ (-1 : ℝ) * g x) := hcg.mul_left
  rw [he, continuousMass_add P hP hcal hf hcf hneg hcneg,
    continuousMass_const_mul P hP hcal hg hcg]
  ring

theorem continuousMass_mono (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f g : (Fin n → ℝ) → ℝ}
    (hf : Continuous f) (hcf : HasCompactSupport f)
    (hg : Continuous g) (hcg : HasCompactSupport g) (hle : ∀ x, f x ≤ g x) :
    continuousMass P f ≤ continuousMass P g := by
  have hn := continuousMass_nonneg P hP hcal (hg.sub hf) (hcg.sub hcf)
    (fun x ↦ sub_nonneg.mpr (hle x))
  change 0 ≤ continuousMass P (fun x ↦ g x - f x) at hn
  rw [continuousMass_sub P hP hcal hg hcg hf hcf] at hn
  exact sub_nonneg.mp hn

end
end Source29ContinuousMassAlgebra

/- Component: ContinuousMassContent.inc -/
namespace Source29ContinuousMassContent

open MvPolynomial MeasureTheory Filter TopologicalSpace
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29SmoothMassExtension Source29ContinuousMassAlgebra Source29LocalPhasePerimeter
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

structure Majorant (K : Set (Fin n → ℝ)) (f : (Fin n → ℝ) → ℝ) : Prop where
  continuous : Continuous f
  compact : HasCompactSupport f
  nonneg : ∀ x, 0 ≤ f x
  one_le : ∀ x ∈ K, 1 ≤ f x

def compactMass (P : MvPolynomial (Fin n) ℝ) (K : Compacts (Fin n → ℝ)) : ℝ≥0 :=
  sInf ((fun f : (Fin n → ℝ) → ℝ ↦ (continuousMass P f).toNNReal) ''
    {f | Majorant (K : Set (Fin n → ℝ)) f})

theorem majorant_image_nonempty (P : MvPolynomial (Fin n) ℝ)
    (K : Compacts (Fin n → ℝ)) :
    ((fun f : (Fin n → ℝ) → ℝ ↦ (continuousMass P f).toNNReal) ''
      {f | Majorant (K : Set (Fin n → ℝ)) f}).Nonempty := by
  obtain ⟨ρ, hρ, hcρ, _, hb, hone, _⟩ := exists_local_cutoff (K : Set (Fin n → ℝ)) Set.univ
    K.isCompact isOpen_univ (Set.subset_univ _)
  exact ⟨_, ρ, ⟨hρ.continuous, hcρ, fun x ↦ (hb x).1, fun x hx ↦ (hone x hx).ge⟩, rfl⟩

theorem compactMass_le (P : MvPolynomial (Fin n) ℝ)
    {K : Compacts (Fin n → ℝ)} {f : (Fin n → ℝ) → ℝ} (hf : Majorant K f) :
    compactMass P K ≤ (continuousMass P f).toNNReal :=
  csInf_le (OrderBot.bddBelow _) ⟨f, hf, rfl⟩

theorem compactMass_mono (P : MvPolynomial (Fin n) ℝ)
    {K L : Compacts (Fin n → ℝ)} (hKL : (K : Set (Fin n → ℝ)) ⊆ L) :
    compactMass P K ≤ compactMass P L := by
  apply le_csInf (majorant_image_nonempty P L)
  rintro _ ⟨f, hf, rfl⟩
  exact compactMass_le P ⟨hf.continuous, hf.compact, hf.nonneg, fun x hx ↦ hf.one_le x (hKL hx)⟩

theorem exists_majorant_lt (P : MvPolynomial (Fin n) ℝ)
    (K : Compacts (Fin n → ℝ)) {ε : ℝ≥0} (hε : 0 < ε) :
    ∃ f : (Fin n → ℝ) → ℝ, Majorant K f ∧
      (continuousMass P f).toNNReal < compactMass P K + ε := by
  obtain ⟨a, ⟨f, hf, rfl⟩, ha⟩ := exists_lt_of_csInf_lt (majorant_image_nonempty P K)
    (lt_add_of_pos_right (compactMass P K) hε)
  exact ⟨f, hf, ha⟩

theorem compactMass_sup_le (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K L : Compacts (Fin n → ℝ)) :
    compactMass P (K ⊔ L) ≤ compactMass P K + compactMass P L := by
  apply _root_.le_of_forall_pos_le_add
  intro ε hε
  obtain ⟨f, hf, hfm⟩ := exists_majorant_lt P K (half_pos hε)
  obtain ⟨g, hg, hgm⟩ := exists_majorant_lt P L (half_pos hε)
  have hfg : Majorant (K ⊔ L : Compacts (Fin n → ℝ)) (fun x ↦ f x + g x) := by
    refine ⟨hf.continuous.add hg.continuous, hf.compact.add hg.compact,
      fun x ↦ add_nonneg (hf.nonneg x) (hg.nonneg x), ?_⟩
    intro x hx
    rcases hx with hx | hx
    · linarith [hf.one_le x hx, hg.nonneg x]
    · linarith [hg.one_le x hx, hf.nonneg x]
  have he : (continuousMass P (fun x ↦ f x + g x)).toNNReal =
      (continuousMass P f).toNNReal + (continuousMass P g).toNNReal := by
    rw [continuousMass_add P hP hcal hf.continuous hf.compact hg.continuous hg.compact]
    exact Real.toNNReal_add (continuousMass_nonneg P hP hcal hf.continuous hf.compact hf.nonneg)
      (continuousMass_nonneg P hP hcal hg.continuous hg.compact hg.nonneg)
  calc
    _ ≤ (continuousMass P (fun x ↦ f x + g x)).toNNReal := compactMass_le P hfg
    _ = (continuousMass P f).toNNReal + (continuousMass P g).toNNReal := he
    _ ≤ _ := by linarith

theorem compactMass_sup_disjoint (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (K L : Compacts (Fin n → ℝ)) (hKL : Disjoint (K : Set (Fin n → ℝ)) L) :
    compactMass P (K ⊔ L) = compactMass P K + compactMass P L := by
  apply le_antisymm (compactMass_sup_le P hP hcal K L)
  apply le_csInf (majorant_image_nonempty P (K ⊔ L))
  rintro _ ⟨f, hf, rfl⟩
  obtain ⟨ρ, hρ, hcρ, hρL, hbρ, honeρ, _⟩ := exists_local_cutoff (K : Set (Fin n → ℝ)) (L : Set (Fin n → ℝ))ᶜ
    K.isCompact L.isCompact.isClosed.isOpen_compl (Set.disjoint_left.mp hKL)
  have hzρ x (hx : x ∈ L) : ρ x = 0 :=
    image_eq_zero_of_notMem_tsupport (fun ht ↦ hρL ht hx)
  have ha : Majorant K (fun x ↦ ρ x * f x) := by
    refine ⟨hρ.continuous.mul hf.continuous, hf.compact.mul_left,
      fun x ↦ mul_nonneg (hbρ x).1 (hf.nonneg x), ?_⟩
    intro x hx
    rw [honeρ x hx, one_mul]
    exact hf.one_le x (Or.inl hx)
  have hb : Majorant L (fun x ↦ (1 - ρ x) * f x) := by
    refine ⟨(continuous_const.sub hρ.continuous).mul hf.continuous, hf.compact.mul_left,
      fun x ↦ mul_nonneg (sub_nonneg.mpr (hbρ x).2) (hf.nonneg x), ?_⟩
    intro x hx
    rw [hzρ x hx, sub_zero, one_mul]
    exact hf.one_le x (Or.inr hx)
  have he : (fun x ↦ ρ x * f x + (1 - ρ x) * f x) = f := by
    funext x
    ring
  have hm : continuousMass P (fun x ↦ ρ x * f x) +
      continuousMass P (fun x ↦ (1 - ρ x) * f x) = continuousMass P f := by
    rw [← continuousMass_add P hP hcal ha.continuous ha.compact hb.continuous hb.compact, he]
  calc
    _ ≤ (continuousMass P (fun x ↦ ρ x * f x)).toNNReal +
        (continuousMass P (fun x ↦ (1 - ρ x) * f x)).toNNReal :=
      add_le_add (compactMass_le P ha) (compactMass_le P hb)
    _ = _ := by
      rw [← Real.toNNReal_add
        (continuousMass_nonneg P hP hcal ha.continuous ha.compact ha.nonneg)
        (continuousMass_nonneg P hP hcal hb.continuous hb.compact hb.nonneg), hm]

def massContent (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) : Content (Fin n → ℝ) where
  toFun := compactMass P
  mono' := fun _ _ h ↦ compactMass_mono P h
  sup_le' := compactMass_sup_le P hP hcal
  sup_disjoint' := fun K L h _ _ ↦ compactMass_sup_disjoint P hP hcal K L h

end
end Source29ContinuousMassContent

/- Component: PhasePerimeterMeasure.inc -/
namespace Source29PhasePerimeterMeasure

open MvPolynomial MeasureTheory Filter TopologicalSpace
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29WeakCalibrationLimits Source29PhaseMassLimit
open Source29SmoothMassExtension Source29ContinuousMassAlgebra Source29ContinuousMassContent
open Source29LocalPhasePerimeter Source29LocalPerimeterMass Source29TopPhasePerimeter
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

def massMeasure (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) : Measure (Fin n → ℝ) :=
  (massContent P hP hcal).measure

theorem massMeasure_regular (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) :
    (massMeasure P hP hcal).Regular := by
  unfold massMeasure
  infer_instance

theorem continuousMass_le_compactMass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {f : (Fin n → ℝ) → ℝ} (hf : Continuous f) (hcf : HasCompactSupport f)
    (hle : ∀ x, f x ≤ 1) :
    (continuousMass P f).toNNReal ≤ compactMass P ⟨tsupport f, hcf⟩ := by
  apply le_csInf (majorant_image_nonempty P ⟨tsupport f, hcf⟩)
  rintro _ ⟨g, hg, rfl⟩
  apply Real.toNNReal_mono
  apply continuousMass_mono P hP hcal hf hcf hg.continuous hg.compact
  intro x
  by_cases hx : x ∈ tsupport f
  · exact (hle x).trans (hg.one_le x hx)
  · rw [image_eq_zero_of_notMem_tsupport hx]
    exact hg.nonneg x

/-- This regular measure has the calibrated scalar mass as its open-set supremum. -/
theorem massMeasure_eq_iSup_mass (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (U : Set (Fin n → ℝ)) (hU : IsOpen U) :
    massMeasure P hP hcal U =
      ⨆ (ρ : (Fin n → ℝ) → ℝ) (_ : LocalWeight U ρ), ENNReal.ofReal (phaseMass P ρ) := by
  rw [massMeasure, Content.measure_apply _ hU.measurableSet,
    Content.outerMeasure_of_isOpen _ U hU, Content.innerContent]
  apply le_antisymm
  · apply iSup_le
    intro K
    apply iSup_le
    intro hKU
    obtain ⟨ρ, hρ, hcρ, hρU, hbρ, honeρ, _⟩ :=
      exists_local_cutoff (K : Set (Fin n → ℝ)) U K.isCompact hU hKU
    have hm := compactMass_le P (K := K)
      (show Majorant K ρ from ⟨hρ.continuous, hcρ, fun x ↦ (hbρ x).1, fun x hx ↦ (honeρ x hx).ge⟩)
    change (compactMass P K : ℝ≥0∞) ≤ _
    calc
      _ ≤ ((continuousMass P ρ).toNNReal : ℝ≥0∞) := ENNReal.coe_le_coe.mpr hm
      _ = ENNReal.ofReal (phaseMass P ρ) := by
        rw [continuousMass_eq_phaseMass P hP hcal hρ hcρ]
        rfl
      _ ≤ _ := by
        apply le_iSup_of_le ρ
        exact le_iSup (fun _ : LocalWeight U ρ ↦ ENNReal.ofReal (phaseMass P ρ))
          ⟨hρ, hcρ, hρU, hbρ⟩
  · apply iSup_le
    intro ρ
    apply iSup_le
    intro hρ
    have hm := continuousMass_le_compactMass P hP hcal hρ.smooth.continuous hρ.compact
      (fun x ↦ (hρ.bound x).2)
    calc
      _ = ((continuousMass P ρ).toNNReal : ℝ≥0∞) := by
        rw [continuousMass_eq_phaseMass P hP hcal hρ.smooth hρ.compact]
        rfl
      _ ≤ (compactMass P ⟨tsupport ρ, hρ.compact⟩ : ℝ≥0∞) := ENNReal.coe_le_coe.mpr hm
      _ ≤ _ := by
        apply le_iSup_of_le (⟨tsupport ρ, hρ.compact⟩ : Compacts (Fin n → ℝ))
        exact le_iSup (fun _ : tsupport ρ ⊆ U ↦
          (massContent P hP hcal) ⟨tsupport ρ, hρ.compact⟩) hρ.within

/-- The actual leading positive phase has a regular perimeter measure, whose
value on every open region is its full divergence-test perimeter. -/
theorem top_phase_has_perimeter_measure (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree) :
    ∃ μ : Measure (Fin n → ℝ), μ.Regular ∧
      ∀ U : Set (Fin n → ℝ), IsOpen U →
        μ U = localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U := by
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hcal := top_weakCalibration P hmin hdeg
  refine ⟨massMeasure F hF hcal, massMeasure_regular F hF hcal, ?_⟩
  intro U hU
  rw [massMeasure_eq_iSup_mass F hF hcal U hU,
    top_localPerimeter_eq_iSup_mass P hmin hdeg U hU]

end
end Source29PhasePerimeterMeasure

/- Component: PhasePerimeterSupport.inc -/
namespace Source29PhasePerimeterSupport

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29LocalPhasePerimeter Source29LocalPerimeterCalculus
open Source29PerimeterRepresentatives Source29PhasePerimeterMeasure
open scoped Topology ENNReal

noncomputable section
variable {n : ℕ}

theorem localVariation_zero (U : Set (Fin n → ℝ)) :
    localVariation (fun _ ↦ 0) U = 0 := by
  unfold localVariation
  simp

theorem localVariation_const (c : ℝ) (U : Set (Fin n → ℝ)) :
    localVariation (fun _ ↦ c) U = 0 := by
  simpa only [zero_add] using
    (localVariation_add_const (fun _ ↦ 0) c U).trans (localVariation_zero U)

theorem localPerimeter_self (S : Set (Fin n → ℝ)) : localPerimeter S S = 0 := by
  classical
  rw [localPerimeter_eq]
  calc
    _ = localVariation (fun _ ↦ 1) S := by
      apply localVariation_congr_ae_on
      exact Filter.Eventually.of_forall fun x hx ↦ by simp [setIndicator, hx]
    _ = 0 := localVariation_const 1 S

theorem polynomial_phases_perimeter_eq (F : MvPolynomial (Fin n) ℝ) (hF : F ≠ 0)
    (U : Set (Fin n → ℝ)) :
    localPerimeter {x | eval x F < 0} U = localPerimeter {x | 0 < eval x F} U := by
  have he : ∀ᵐ x, x ∈ {x | eval x F < 0} ↔ x ∈ {x | 0 < eval x F}ᶜ := by
    filter_upwards [mvPolynomial_eval_ne_zero_ae n F hF] with x hx
    simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, not_lt]
    exact ⟨le_of_lt, fun h ↦ lt_of_le_of_ne h hx⟩
  rw [localPerimeter_congr_ae _ _ U he, localPerimeter_compl]

/-- The two leading phases have one common regular perimeter measure,
concentrated on the leading polynomial's real zero locus. -/
theorem top_phases_common_perimeter_measure (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree) :
    ∃ μ : Measure (Fin n → ℝ), μ.Regular ∧
      (∀ U : Set (Fin n → ℝ), IsOpen U →
        μ U = localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U ∧
        μ U = localPerimeter {x | eval x (homogeneousComponent P.totalDegree P) < 0} U) ∧
      μ {x | eval x (homogeneousComponent P.totalDegree P) ≠ 0} = 0 := by
  obtain ⟨μ, hμ, hpos⟩ := top_phase_has_perimeter_measure P hmin hdeg
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hneg (U : Set (Fin n → ℝ)) (hU : IsOpen U) :
      μ U = localPerimeter {x | eval x F < 0} U := by
    rw [polynomial_phases_perimeter_eq F hF U]
    exact hpos U hU
  refine ⟨μ, hμ, fun U hU ↦ ⟨hpos U hU, hneg U hU⟩, ?_⟩
  have hpopen : IsOpen {x | 0 < eval x F} := isOpen_lt continuous_const (contDiff_eval F).continuous
  have hnopen : IsOpen {x | eval x F < 0} := isOpen_lt (contDiff_eval F).continuous continuous_const
  have hpzero : μ {x | 0 < eval x F} = 0 := by
    rw [hpos _ hpopen]
    exact localPerimeter_self _
  have hnzero : μ {x | eval x F < 0} = 0 := by
    rw [hneg _ hnopen, localPerimeter_self]
  have he : {x | eval x F ≠ 0} = {x | 0 < eval x F} ∪ {x | eval x F < 0} := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_union]
    exact ne_iff_lt_or_gt.trans or_comm
  change μ {x | eval x F ≠ 0} = 0
  rw [he]
  apply le_antisymm _ bot_le
  calc
    _ ≤ μ {x | 0 < eval x F} + μ {x | eval x F < 0} := measure_union_le _ _
    _ = 0 := by rw [hpzero, hnzero, add_zero]

end
end Source29PhasePerimeterSupport

/- Component: ZeroVariationTests.inc -/
namespace Source29ZeroVariationTests

open MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29WeightedPhaseVariation Source29LocalPhasePerimeter
open scoped Topology BigOperators ENNReal

noncomputable section
variable {n : ℕ}

def coordinateField (ψ : (Fin n → ℝ) → ℝ) (j : Fin n) (x : Fin n → ℝ) (i : Fin n) : ℝ :=
  if i = j then ψ x else 0

theorem coordinateField_norm (ψ : (Fin n → ℝ) → ℝ) (j : Fin n) (x : Fin n → ℝ) :
    variationDensity (coordinateField ψ j x) = |ψ x| := by
  simp [variationDensity, coordinateField, Real.sqrt_sq_eq_abs]

theorem coordinateField_divergence (ψ : (Fin n → ℝ) → ℝ) (j : Fin n) (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (coordinateField ψ j) x =
      fderiv ℝ ψ x (Pi.single j 1) := by
  have he i : fderiv ℝ (fun y ↦ coordinateField ψ j y i) x (Pi.single i 1) =
      if i = j then fderiv ℝ ψ x (Pi.single i 1) else 0 := by
    by_cases h : i = j <;> simp [coordinateField, h]
  simp only [divergence, he]
  simp

theorem coordinateField_test {U : Set (Fin n → ℝ)} {ψ : (Fin n → ℝ) → ℝ}
    (hψ : ContDiff ℝ 1 ψ) (hcψ : HasCompactSupport ψ) (hsψ : tsupport ψ ⊆ U)
    (hbψ : ∀ x, |ψ x| ≤ 1) (j : Fin n) : LocalVariationTest U (coordinateField ψ j) := by
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · intro i
    by_cases h : i = j <;> simp only [coordinateField, h, ↓reduceIte]
    · exact hψ
    · exact contDiff_const
  · intro i
    by_cases h : i = j <;> simp only [coordinateField, h, ↓reduceIte]
    · exact hcψ
    · simp [HasCompactSupport]
  · intro x
    simpa only [coordinateField_norm] using hbψ x
  · intro i
    by_cases h : i = j
    · simpa only [coordinateField, h, ↓reduceIte] using hsψ
    · simp [coordinateField, h]

/-- Zero local variation annihilates the derivative of every bounded scalar test. -/
theorem scalar_pairing_zero {u : (Fin n → ℝ) → ℝ} {U : Set (Fin n → ℝ)}
    (hu : localVariation u U = 0) {ψ : (Fin n → ℝ) → ℝ}
    (hψ : ContDiff ℝ 1 ψ) (hcψ : HasCompactSupport ψ) (hsψ : tsupport ψ ⊆ U)
    (hbψ : ∀ x, |ψ x| ≤ 1) (j : Fin n) :
    (∫ x, u x * fderiv ℝ ψ x (Pi.single j 1)) = 0 := by
  have htest := coordinateField_test hψ hcψ hsψ hbψ j
  have hl : ENNReal.ofReal |∫ x, u x * divergence (fun i ↦ Pi.single i 1) (coordinateField ψ j) x| ≤
      localVariation u U := le_iSup_of_le _ (le_iSup_of_le htest le_rfl)
  simp_rw [coordinateField_divergence] at hl
  rw [hu] at hl
  exact abs_eq_zero.mp (le_antisymm (ENNReal.ofReal_eq_zero.mp (le_antisymm hl bot_le))
    (abs_nonneg _))

end
end Source29ZeroVariationTests

/- Component: MollifiedZeroVariation.inc -/
namespace Source29MollifiedZeroVariation

open MeasureTheory Filter ContinuousLinearMap
open Source29LocalPhasePerimeter Source29ZeroVariationTests
open scoped Topology BigOperators Convolution

noncomputable section
variable {n : ℕ}

theorem reflection_fderiv {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ)
    (y x v : Fin n → ℝ) :
    fderiv ℝ (fun z ↦ φ (y - z)) x v = -fderiv ℝ φ (y - x) v := by
  have hd := ((hφ.differentiable (by norm_num) (y - x)).hasFDerivAt).comp x
    ((hasFDerivAt_const y x).sub (hasFDerivAt_id x))
  have he := congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L v) hd.fderiv
  simpa [Function.comp_def] using he

theorem convolution_coordinate_zero {u φ : (Fin n → ℝ) → ℝ}
    (hu : LocallyIntegrable u) {U : Set (Fin n → ℝ)} (hzero : localVariation u U = 0)
    (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) (hbφ : ∀ x, |φ x| ≤ 1)
    (y : Fin n → ℝ) (hs : tsupport (fun x ↦ φ (y - x)) ⊆ U) (j : Fin n) :
    fderiv ℝ (u ⋆[lsmul ℝ ℝ, volume] φ) y (Pi.single j 1) = 0 := by
  have hψ : ContDiff ℝ 1 (fun x ↦ φ (y - x)) := hφ.comp (contDiff_const.sub contDiff_id)
  have hcψ : HasCompactSupport (fun x ↦ φ (y - x)) :=
    hcφ.comp_homeomorph (Homeomorph.subLeft y)
  have hz := scalar_pairing_zero hzero hψ hcψ hs (fun x ↦ hbφ (y - x)) j
  simp_rw [reflection_fderiv hφ y, mul_neg, integral_neg, neg_eq_zero] at hz
  have hd := hcφ.hasFDerivAt_convolution_right (lsmul ℝ ℝ) hu hφ y
  rw [hd.fderiv, convolution_precompR_apply (lsmul ℝ ℝ) hu (hcφ.fderiv ℝ)
    (hφ.continuous_fderiv (by norm_num))]
  simpa only [convolution_def, lsmul_apply, smul_eq_mul] using hz

theorem convolution_fderiv_zero {u φ : (Fin n → ℝ) → ℝ}
    (hu : LocallyIntegrable u) {U : Set (Fin n → ℝ)} (hzero : localVariation u U = 0)
    (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) (hbφ : ∀ x, |φ x| ≤ 1)
    (y : Fin n → ℝ) (hs : tsupport (fun x ↦ φ (y - x)) ⊆ U) :
    fderiv ℝ (u ⋆[lsmul ℝ ℝ, volume] φ) y = 0 := by
  apply ContinuousLinearMap.ext
  intro v
  have hv : v = ∑ j : Fin n, v j • Pi.single j (1 : ℝ) := by
    ext i
    simp [Pi.single_apply]
  rw [hv, map_sum]
  simp only [map_smul, convolution_coordinate_zero hu hzero hφ hcφ hbφ y hs,
    smul_zero, Finset.sum_const_zero, zero_apply]

theorem convolution_const_on_open {u φ : (Fin n → ℝ) → ℝ}
    (hu : LocallyIntegrable u) {U V : Set (Fin n → ℝ)} (hzero : localVariation u U = 0)
    (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) (hbφ : ∀ x, |φ x| ≤ 1)
    (hV : IsOpen V) (hVc : IsPreconnected V)
    (hs : ∀ y ∈ V, tsupport (fun x ↦ φ (y - x)) ⊆ U)
    {a b : Fin n → ℝ} (ha : a ∈ V) (hb : b ∈ V) :
    (u ⋆[lsmul ℝ ℝ, volume] φ) a = (u ⋆[lsmul ℝ ℝ, volume] φ) b := by
  apply hV.is_const_of_fderiv_eq_zero (𝕜 := ℝ) hVc
  · intro x _
    exact (hcφ.hasFDerivAt_convolution_right (lsmul ℝ ℝ) hu hφ x).differentiableAt.differentiableWithinAt
  · intro x hx
    exact convolution_fderiv_zero hu hzero hφ hcφ hbφ x (hs x hx)
  · exact ha
  · exact hb

end
end Source29MollifiedZeroVariation

/- Component: PositivePerimeterBalls.inc -/
namespace Source29PositivePerimeterBalls

open MeasureTheory Filter Metric ContinuousLinearMap
open Source29LocalPhasePerimeter Source29LocalPerimeterCalculus
open Source29MollifiedZeroVariation
open scoped Topology BigOperators Convolution ENNReal

noncomputable section
variable {n : ℕ}

theorem indicator_locallyIntegrable (S : Set (Fin n → ℝ)) (hS : MeasurableSet S) :
    LocallyIntegrable (setIndicator S) := by
  apply (locallyIntegrable_const (1 : ℝ)).mono (set_indicator_measurable S hS)
  exact Filter.Eventually.of_forall fun x ↦ by simpa using set_indicator_bound S x

theorem reflected_bump_support (c y : Fin n → ℝ) {R : ℝ} (hR : 0 < R)
    (hy : y ∈ ball c (R / 2)) (φ : ContDiffBump (0 : Fin n → ℝ)) (hφ : φ.rOut ≤ R / 2) :
    tsupport (fun x ↦ φ (y - x)) ⊆ ball c R := by
  intro x hx
  have hxy := tsupport_comp_subset_preimage (φ : (Fin n → ℝ) → ℝ)
    (continuous_const.sub continuous_id) hx
  change y - x ∈ tsupport φ at hxy
  rw [φ.tsupport_eq] at hxy
  have hd : dist x y ≤ φ.rOut := by
    simpa only [mem_closedBall, dist_zero_right, ← dist_eq_norm, dist_comm y x] using hxy
  change dist x c < R
  have hdy : dist y c < R / 2 := hy
  calc
    dist x c ≤ dist x y + dist y c := dist_triangle _ _ _
    _ < R := by linarith

/-- If a ball contains interior points of both a set and its complement, its
perimeter is positive. The proof uses only compact scalar tests and convolution. -/
theorem localPerimeter_ball_pos (S : Set (Fin n → ℝ)) (hS : MeasurableSet S)
    (c : Fin n → ℝ) {R : ℝ} (hR : 0 < R)
    {a b : Fin n → ℝ} (ha : a ∈ ball c (R / 2)) (hb : b ∈ ball c (R / 2))
    {ra rb : ℝ} (hra : 0 < ra) (hrb : 0 < rb)
    (hapos : ball a ra ⊆ S) (hbneg : ball b rb ⊆ Sᶜ) :
    0 < localPerimeter S (ball c R) := by
  classical
  by_contra hn
  have hz : localPerimeter S (ball c R) = 0 := le_antisymm (not_lt.mp hn) bot_le
  let r : ℝ := min (R / 2) (min ra rb)
  have hr : 0 < r := lt_min (half_pos hR) (lt_min hra hrb)
  let φ : ContDiffBump (0 : Fin n → ℝ) := ⟨r / 2, r, half_pos hr, half_lt_self hr⟩
  have hφR : φ.rOut ≤ R / 2 := min_le_left _ _
  have hφa : φ.rOut ≤ ra := (min_le_right _ _).trans (min_le_left _ _)
  have hφb : φ.rOut ≤ rb := (min_le_right _ _).trans (min_le_right _ _)
  have hi : Integrable φ := φ.continuous.integrable_of_hasCompactSupport φ.hasCompactSupport
  have hip : 0 < ∫ x, φ x := by
    apply (integral_pos_iff_support_of_nonneg φ.nonneg' hi).mpr
    rw [φ.support_eq]
    exact measure_ball_pos volume 0 φ.rOut_pos
  have he := convolution_const_on_open (indicator_locallyIntegrable S hS) hz
    φ.contDiff φ.hasCompactSupport (fun x ↦ by rw [abs_of_nonneg φ.nonneg]; exact φ.le_one)
    isOpen_ball (convex_ball c (R / 2)).isPreconnected
    (fun y hy ↦ reflected_bump_support c y hR hy φ hφR) ha hb
  have hca : (φ ⋆[lsmul ℝ ℝ, volume] setIndicator S) a = ∫ x, φ x := by
    rw [convolution_eq_right' (lsmul ℝ ℝ) φ.support_eq.subset]
    · have has : a ∈ S := hapos (mem_ball_self hra)
      simp [setIndicator, has, lsmul_apply]
    · intro x hx
      have hxs : x ∈ S := hapos (ball_subset_ball hφa hx)
      have has : a ∈ S := hapos (mem_ball_self hra)
      simp [setIndicator, hxs, has]
  have hcb : (φ ⋆[lsmul ℝ ℝ, volume] setIndicator S) b = 0 := by
    rw [convolution_eq_right' (lsmul ℝ ℝ) φ.support_eq.subset]
    · have hbs : b ∉ S := hbneg (mem_ball_self hrb)
      simp [setIndicator, hbs, lsmul_apply]
    · intro x hx
      have hxs : x ∉ S := hbneg (ball_subset_ball hφb hx)
      have hbs : b ∉ S := hbneg (mem_ball_self hrb)
      simp [setIndicator, hxs, hbs]
  have hcomm (x : Fin n → ℝ) :
      (setIndicator S ⋆[lsmul ℝ ℝ, volume] φ) x =
        (φ ⋆[lsmul ℝ ℝ, volume] setIndicator S) x := by
    rw [← convolution_flip]
    congr 2
    ext s t
    simp [lsmul_apply, mul_comm]
  rw [hcomm a, hcomm b, hca, hcb] at he
  exact (ne_of_gt hip) he

end
end Source29PositivePerimeterBalls

/- Component: TopPerimeterExactSupport.inc -/
namespace Source29TopPerimeterExactSupport

open MvPolynomial MeasureTheory Filter Metric
open Source29QuarticReuse.FluxPolynomial
open Source29LocalPhasePerimeter Source29PhasePerimeterSupport
open Source29TopLocalSign Source29PositivePerimeterBalls
open scoped Topology ENNReal

noncomputable section
variable {n : ℕ}

theorem top_localPerimeter_ball_pos (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (a : Fin n → ℝ) (ha : eval a (homogeneousComponent P.totalDegree P) = 0)
    (R : ℝ) (hR : 0 < R) :
    0 < localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} (ball a R) := by
  let F := homogeneousComponent P.totalDegree P
  have hop : IsOpen {x | 0 < eval x F} := isOpen_lt continuous_const (contDiff_eval F).continuous
  have hon : IsOpen {x | eval x F < 0} := isOpen_lt (contDiff_eval F).continuous continuous_const
  obtain ⟨⟨b, hb, hbn⟩, ⟨c, hc, hcp⟩⟩ := top_changes_sign_in_every_nhds P hmin hdeg a ha
    (ball a (R / 2)) (ball_mem_nhds a (half_pos hR))
  obtain ⟨rc, hrc, hrcS⟩ := Metric.mem_nhds_iff.mp (hop.mem_nhds hcp)
  obtain ⟨rb, hrb, hrbS⟩ := Metric.mem_nhds_iff.mp (hon.mem_nhds hbn)
  apply localPerimeter_ball_pos {x | 0 < eval x F} hop.measurableSet a hR hc hb hrc hrb hrcS
  intro x hx
  exact not_lt_of_ge (show eval x F < 0 from hrbS hx).le

theorem top_perimeter_positive_in_nhds (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (μ : Measure (Fin n → ℝ))
    (hμ : ∀ U : Set (Fin n → ℝ), IsOpen U →
      μ U = localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U)
    (a : Fin n → ℝ) (ha : eval a (homogeneousComponent P.totalDegree P) = 0)
    (U : Set (Fin n → ℝ)) (hU : U ∈ 𝓝 a) : 0 < μ U := by
  obtain ⟨R, hR, hRU⟩ := Metric.mem_nhds_iff.mp hU
  have hp : 0 < μ (ball a R) := by
    rw [hμ _ isOpen_ball]
    exact top_localPerimeter_ball_pos P hmin hdeg a ha R hR
  exact hp.trans_le (measure_mono hRU)

/-- The topological support of a measure, expressed by its positive neighborhoods.
The challenge imports do not include the library's bundled support API. -/
def measureSupport (μ : Measure (Fin n → ℝ)) : Set (Fin n → ℝ) :=
  {x | ∀ U : Set (Fin n → ℝ), U ∈ 𝓝 x → 0 < μ U}

/-- Every leading zero lies in the actual support, not merely in a set on which
the perimeter measure is concentrated. -/
theorem top_phases_exact_support (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree) :
    ∃ μ : Measure (Fin n → ℝ), μ.Regular ∧
      (∀ U : Set (Fin n → ℝ), IsOpen U →
        μ U = localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U ∧
        μ U = localPerimeter {x | eval x (homogeneousComponent P.totalDegree P) < 0} U) ∧
      μ {x | eval x (homogeneousComponent P.totalDegree P) ≠ 0} = 0 ∧
      measureSupport μ = {x | eval x (homogeneousComponent P.totalDegree P) = 0} := by
  obtain ⟨μ, hreg, hμ, hz⟩ := top_phases_common_perimeter_measure P hmin hdeg
  refine ⟨μ, hreg, hμ, hz, ?_⟩
  ext a
  constructor
  · intro ha
    by_contra hn
    have hopen : IsOpen {x | eval x (homogeneousComponent P.totalDegree P) ≠ 0} :=
      (isClosed_eq (contDiff_eval _).continuous continuous_const).isOpen_compl
    have hp := ha _ (hopen.mem_nhds hn)
    rw [hz] at hp
    exact (lt_irrefl 0) hp
  · intro ha
    exact fun U hU ↦ top_perimeter_positive_in_nhds P hmin hdeg μ
      (fun U hU ↦ (hμ U hU).1) a ha U hU

end
end Source29TopPerimeterExactSupport

/- Component: TransitionGradientBounds.inc -/
namespace Source29TransitionGradientBounds

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29SmoothCalibrationRecovery
open Source29SmoothPhaseTransition Source29NonlinearCalibration Source29WeakCalibrationLimits
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem norm_linear_le_coordinate_sum (L : (Fin n → ℝ) →L[ℝ] ℝ) :
    ‖L‖ ≤ ∑ i : Fin n, ‖L (Pi.single i 1)‖ := by
  apply L.opNorm_le_bound (Finset.sum_nonneg fun _ _ ↦ norm_nonneg _)
  intro v
  have hv : v = ∑ i : Fin n, v i • Pi.single i (1 : ℝ) := by
    ext j
    simp [Pi.single_apply]
  calc
    ‖L v‖ = ‖∑ i : Fin n, v i • L (Pi.single i 1)‖ := by
      simpa only [map_sum, map_smul] using congrArg (fun w ↦ ‖L w‖) hv
    _ ≤ ∑ i : Fin n, ‖v i • L (Pi.single i 1)‖ := norm_sum_le _ _
    _ ≤ ∑ i : Fin n, ‖L (Pi.single i 1)‖ * ‖v‖ := by
      apply Finset.sum_le_sum
      intro i _
      rw [norm_smul, mul_comm]
      exact mul_le_mul_of_nonneg_left (norm_le_pi_norm v i) (norm_nonneg _)
    _ = _ := by rw [Finset.sum_mul]

theorem transition_product_gradient_bound (P : MvPolynomial (Fin n) ℝ)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hρpos : ∀ x, 0 ≤ ρ x)
    (k : ℕ) (x : Fin n → ℝ) :
    ‖fderiv ℝ (fun y ↦ ρ y * transition k (eval y P)) x‖ ≤
      transition k (eval x P) * testBound (fun i ↦ Pi.single i 1) ρ x +
      n * (ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) := by
  apply (norm_linear_le_coordinate_sum _).trans
  calc
    _ ≤ ∑ i : Fin n, (transition k (eval x P) * ‖fderiv ℝ ρ x (Pi.single i 1)‖ +
        ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) := by
      apply Finset.sum_le_sum
      intro i _
      rw [composed_product_fderiv P hρ (transition_contDiff k)]
      apply (norm_add_le _ _).trans
      rw [norm_mul, Real.norm_eq_abs (transition k _), abs_of_nonneg (transition_bounds k _).1,
        norm_mul, Real.norm_eq_abs (ρ x * _), abs_of_nonneg (mul_nonneg (hρpos x) (transition_deriv_nonneg k _))]
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_left
        (coordinate_norm_le_variationDensity (evaluatedGradient P x) i)
        (mul_nonneg (hρpos x) (transition_deriv_nonneg k _)))
    _ = _ := by simp [testBound, Finset.sum_add_distrib, ← Finset.mul_sum]

theorem transition_product_gradient_integral_bound (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) (k : ℕ) :
    (∫ x, ‖fderiv ℝ (fun y ↦ ρ y * transition k (eval y P)) x‖) ≤
      (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * transition k (eval x P)) +
      n * (∫ x, ρ x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) := by
  have hs : ContDiff ℝ 1 (fun y ↦ ρ y * transition k (eval y P)) :=
    hρ.mul ((transition_contDiff k).comp (contDiff_eval P))
  have hi : Integrable (fun x ↦ ‖fderiv ℝ (fun y ↦ ρ y * transition k (eval y P)) x‖) :=
    (hs.continuous_fderiv (by norm_num)).norm.integrable_of_hasCompactSupport
      ((hcρ.mul_right).fderiv ℝ).norm
  have ht : Integrable (fun x ↦ testBound (fun i ↦ Pi.single i 1) ρ x * transition k (eval x P)) := by
    apply (testBound_integrable _ hρ hcρ).mul_bdd
    · exact ((transition_contDiff k).continuous.comp (contDiff_eval P).continuous).aestronglyMeasurable
    · exact Filter.Eventually.of_forall fun x ↦ transition_norm_le_one k (eval x P)
  have hm := (localized_gradient_mass_identity P hcal hρ hcρ
    (transition_contDiff k) (transition_norm_le_one k)).1
  rw [← integral_const_mul, ← integral_add ht (hm.const_mul (n : ℝ))]
  apply integral_mono hi (ht.add (hm.const_mul (n : ℝ)))
  intro x
  simpa only [Pi.add_apply, mul_comm (testBound _ _ x) (transition k _)] using
    transition_product_gradient_bound P hρ hρpos k x

end
end Source29TransitionGradientBounds

/- Component: SobolevLimit.inc -/
namespace Source29SobolevLimit

open MeasureTheory Filter
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

/-- A Sobolev bound survives almost-everywhere convergence when the smooth
approximants have a convergent bound on their total gradient. -/
theorem sobolev_of_smooth_approximation
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    (u : ℕ → (Fin n → ℝ) → ℝ) (hu : ∀ k, ContDiff ℝ 1 (u k))
    (hcu : ∀ k, HasCompactSupport (u k))
    (v : (Fin n → ℝ) → ℝ) (hv : AEStronglyMeasurable v)
    (hl : ∀ᵐ x, Tendsto (fun k ↦ u k x) atTop (𝓝 (v x)))
    (B : ℕ → ℝ) (b : ℝ) (hB : Tendsto B atTop (𝓝 b))
    (hbound : ∀ k, (∫ x, ‖fderiv ℝ (u k) x‖) ≤ B k) :
    eLpNorm v (p : ℝ≥0∞) volume ≤ ENNReal.ofReal
      ((eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) * b) := by
  let C := eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ)
  have hk (k : ℕ) : eLpNorm (u k) (p : ℝ≥0∞) volume ≤ ENNReal.ofReal ((C : ℝ) * B k) := by
    have hd : Integrable (fderiv ℝ (u k)) :=
      ((hu k).continuous_fderiv (by norm_num)).integrable_of_hasCompactSupport ((hcu k).fderiv ℝ)
    calc
      eLpNorm (u k) (p : ℝ≥0∞) volume ≤ (C : ℝ≥0∞) * eLpNorm (fderiv ℝ (u k)) 1 volume :=
        eLpNorm_le_eLpNorm_fderiv_one volume (hu k) (hcu k) hp
      _ = (C : ℝ≥0∞) * ENNReal.ofReal (∫ x, ‖fderiv ℝ (u k) x‖) := by
        rw [eLpNorm_one_eq_lintegral_enorm hd.aestronglyMeasurable,
          ofReal_integral_norm_eq_lintegral_enorm hd]
      _ ≤ (C : ℝ≥0∞) * ENNReal.ofReal (B k) :=
        by gcongr; exact hbound k
      _ = ENNReal.ofReal ((C : ℝ) * B k) := by
        rw [ENNReal.ofReal_mul C.coe_nonneg, ENNReal.ofReal_coe_nnreal]
  have ht : Tendsto (fun k ↦ ENNReal.ofReal ((C : ℝ) * B k)) atTop
      (𝓝 (ENNReal.ofReal ((C : ℝ) * b))) := ENNReal.tendsto_ofReal (hB.const_mul (C : ℝ))
  calc
    eLpNorm v (p : ℝ≥0∞) volume ≤ atTop.liminf (fun k ↦ eLpNorm (u k) (p : ℝ≥0∞) volume) :=
      Lp.eLpNorm_lim_le_liminf_eLpNorm (fun k ↦ (hu k).continuous.aestronglyMeasurable) v hv hl
    _ ≤ atTop.liminf (fun k ↦ ENNReal.ofReal ((C : ℝ) * B k)) :=
      liminf_le_liminf (Filter.Eventually.of_forall hk)
    _ = ENNReal.ofReal ((C : ℝ) * b) := ht.liminf_eq

end
end Source29SobolevLimit

/- Component: PhaseSobolev.inc -/
namespace Source29PhaseSobolev

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits
open Source29SmoothPhaseTransition Source29NonlinearCalibration Source29PhaseApproximation
open Source29PhaseMassLimit Source29TransitionGradientBounds Source29SobolevLimit
open scoped Topology NNReal ENNReal BigOperators

noncomputable section
variable {n : ℕ}

/-- Sobolev inequality for the positive phase of a weakly calibrated polynomial,
with a compact nonnegative cutoff. -/
theorem phase_sobolev (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    eLpNorm (fun x ↦ ρ x * (if 0 < eval x P then 1 else 0)) (p : ℝ≥0∞) volume ≤
      ENNReal.ofReal ((eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) *
        ((∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0)) +
          n * phaseMass P ρ)) := by
  let u : ℕ → (Fin n → ℝ) → ℝ := fun k x ↦ ρ x * transition k (eval x P)
  have hu (k) : ContDiff ℝ 1 (u k) := hρ.mul ((transition_contDiff k).comp (contDiff_eval P))
  have hcu (k) : HasCompactSupport (u k) := hcρ.mul_right
  have hv := (phase_weight_integrable P hP ρ
    (hρ.continuous.integrable_of_hasCompactSupport hcρ)).aestronglyMeasurable
  have hl : ∀ᵐ x, Tendsto (fun k ↦ u k x) atTop
      (𝓝 (ρ x * (if 0 < eval x P then 1 else 0))) := by
    filter_upwards [polynomial_transition_tendsto_ae P hP] with x hx
    exact (tendsto_const_nhds (x := ρ x)).mul hx
  have hB := (transition_weighted_integral P hP (testBound (fun i ↦ Pi.single i 1) ρ)
    (testBound_integrable _ hρ hcρ)).add ((phaseMass_tendsto P hP hcal hρ hcρ).const_mul (n : ℝ))
  exact sobolev_of_smooth_approximation p hp u hu hcu _ hv hl _ _ hB
    (transition_product_gradient_integral_bound P hcal hρ hcρ hρpos)

/-- The full polynomial minimal graph equation supplies the calibration needed
for the leading phase Sobolev estimate. -/
theorem top_phase_sobolev (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    let F := homogeneousComponent P.totalDegree P
    eLpNorm (fun x ↦ ρ x * (if 0 < eval x F then 1 else 0)) (p : ℝ≥0∞) volume ≤
      ENNReal.ofReal ((eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) *
        ((∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x F then 1 else 0)) +
          n * phaseMass F ρ)) := by
  exact phase_sobolev _ (Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P (by omega))
    (Source29TopPhasePerimeter.top_weakCalibration P hmin hdeg) p hp hρ hcρ hρpos

end
end Source29PhaseSobolev

/- Component: PhaseVolumeBound.inc -/
namespace Source29PhaseVolumeBound

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29PhaseMassLimit Source29PhaseSobolev
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

/-- The volume of a set on which a scalar function has norm at least one is
bounded by that function's Lp norm. -/
theorem measure_rpow_le_eLpNorm (A : Set (Fin n → ℝ)) (hA : MeasurableSet A)
    (f : (Fin n → ℝ) → ℝ) (hf : ∀ x ∈ A, 1 ≤ ‖f x‖)
    (p : ℝ≥0) (hp : p ≠ 0) :
    volume A ^ (1 / (p : ℝ)) ≤ eLpNorm f (p : ℝ≥0∞) volume := by
  classical
  have hI : AEStronglyMeasurable (A.indicator (fun _ ↦ (1 : ℝ))) :=
    aestronglyMeasurable_const.indicator hA
  have hle : eLpNorm (A.indicator (fun _ ↦ (1 : ℝ))) (p : ℝ≥0∞) volume ≤
      eLpNorm f (p : ℝ≥0∞) volume := by
    apply eLpNorm_mono hI
    intro x
    by_cases hx : x ∈ A
    · simpa only [Set.indicator_of_mem hx, norm_one] using hf x hx
    · simp only [Set.indicator_of_notMem hx, norm_zero, norm_nonneg]
  simpa only [eLpNorm_indicator_const hA.nullMeasurableSet
      (ENNReal.coe_ne_zero.mpr hp) ENNReal.coe_ne_top, enorm_one, one_mul,
      ENNReal.coe_toReal] using hle

/-- A cutoff equal to at least one on a measurable part of the positive phase
turns the phase Sobolev estimate into a quantitative volume estimate. -/
theorem phase_volume_bound (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    (A : Set (Fin n → ℝ)) (hA : MeasurableSet A)
    (hAP : ∀ x ∈ A, 0 < eval x P) (hAρ : ∀ x ∈ A, 1 ≤ ρ x) :
    volume A ^ (1 / (p : ℝ)) ≤
      ENNReal.ofReal ((eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) *
        ((∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0)) +
          n * phaseMass P ρ)) := by
  refine (measure_rpow_le_eLpNorm A hA _ ?_ p hp.symm.ne_zero).trans
    (phase_sobolev P hP hcal p hp hρ hcρ hρpos)
  intro x hx
  simp only [ite_eq_left (hAP x hx), mul_one, Real.norm_eq_abs, abs_of_nonneg (hρpos x)]
  exact hAρ x hx

end
end Source29PhaseVolumeBound

/- Component: LocalPhaseSobolev.inc -/
namespace Source29LocalPhaseSobolev

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse Source29QuarticReuse.FluxObstruction
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29PhaseMassLimit Source29PhaseSobolev Source29PhaseVolumeBound
open Source29TopPhasePerimeter Source29LocalPhasePerimeter Source29LocalPerimeterMass
open scoped Topology NNReal ENNReal BigOperators

noncomputable section
variable {n : ℕ}

/-- A phase-volume estimate in terms of local perimeter and a cutoff-gradient
integral. The weight is supported inside the region where perimeter is measured. -/
theorem top_phase_volume_le_local_perimeter (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    (U A : Set (Fin n → ℝ)) (hA : MeasurableSet A)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : LocalWeight U ρ)
    (hAP : ∀ x ∈ A, 0 < eval x (homogeneousComponent P.totalDegree P))
    (hAρ : ∀ x ∈ A, 1 ≤ ρ x) :
    let F := homogeneousComponent P.totalDegree P
    volume A ^ (1 / (p : ℝ)) ≤
      (eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ≥0∞) *
        (ENNReal.ofReal (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x F then 1 else 0)) +
          (n : ℝ≥0∞) * localPerimeter {x | 0 < eval x F} U) := by
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hcal := top_weakCalibration P hmin hdeg
  have hm : 0 ≤ phaseMass F ρ := (phaseMass_bounds F hF hcal hρ.smooth hρ.compact
    (fun x ↦ (hρ.bound x).1)).1
  have hg : 0 ≤ (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x F then 1 else 0)) := by
    apply integral_nonneg
    intro x
    apply mul_nonneg
    · exact Finset.sum_nonneg (fun _ _ ↦ norm_nonneg _)
    · split_ifs <;> norm_num
  have hmass : ENNReal.ofReal (phaseMass F ρ) ≤ localPerimeter {x | 0 < eval x F} U := by
    rw [← top_phase_perimeter_eq_mass P hmin hdeg hρ.smooth hρ.compact (fun x ↦ (hρ.bound x).1)]
    exact weightedVariation_le_local _ ρ U hρ.within (fun x ↦ (hρ.bound x).2)
  have hvol := phase_volume_bound F hF hcal p hp hρ.smooth hρ.compact
    (fun x ↦ (hρ.bound x).1) A hA hAP hAρ
  refine hvol.trans ?_
  rw [ENNReal.ofReal_mul (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.ofReal_add hg (mul_nonneg (Nat.cast_nonneg n) hm),
    ENNReal.ofReal_mul (Nat.cast_nonneg n), ENNReal.ofReal_natCast]
  gcongr

/-- The exponent required for the eight-dimensional source29 problem. -/
theorem holder_eight : NNReal.HolderConjugate (Module.finrank ℝ (Fin 8 → ℝ)) (8 / 7) := by
  norm_num [Module.finrank_pi, NNReal.holderConjugate_iff_eq_conjExponent]
  apply NNReal.coe_injective
  norm_num [NNReal.coe_sub (show (1 : ℝ≥0) ≤ 8 by norm_num)]

end
end Source29LocalPhaseSobolev

/- Component: PhaseCutoffInequality.inc -/
namespace Source29PhaseCutoffInequality

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits Source29PhaseMassLimit Source29PhaseApproximation
open Source29PhaseSobolev Source29PhaseVolumeBound
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

/-- Calibration bounds the phase mass by the cutoff gradient inside the phase,
so the estimate retains information about small phase volume. -/
theorem phaseMass_le_phase_gradient (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    phaseMass P ρ ≤ ∫ x, testBound (fun i ↦ Pi.single i 1) ρ x *
      (if 0 < eval x P then 1 else 0) := by
  rw [phaseMass, ← integral_neg]
  apply integral_mono
    (phase_weight_integrable P hP _ (hcal.2 ρ hρ hcρ).1).neg
    (phase_weight_integrable P hP _ (testBound_integrable _ hρ hcρ))
  intro x
  simp only [Pi.neg_apply]
  by_cases hx : 0 < eval x P
  · simp only [hx, ite_true, mul_one]
    exact (show -testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x ≤
        ‖testFlux (fun i ↦ Pi.single i 1) ρ (leadingNormalizedField P) x‖ by
      simpa only [Real.norm_eq_abs] using neg_le_abs _).trans
        (norm_testFlux_le_testBound _ ρ _ x (hcal.1 x))
  · simp only [hx, ite_false, mul_zero, neg_zero, le_refl]

/-- A calibrated phase satisfies an Lp cutoff inequality with no perimeter term. -/
theorem phase_cutoff_sobolev (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x) :
    eLpNorm (fun x ↦ ρ x * (if 0 < eval x P then 1 else 0)) (p : ℝ≥0∞) volume ≤
      ENNReal.ofReal (((n : ℝ) + 1) *
        (eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) *
        (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0))) := by
  refine (phase_sobolev P hP hcal p hp hρ hcρ hρpos).trans (ENNReal.ofReal_le_ofReal ?_)
  have hm := phaseMass_le_phase_gradient P hP hcal hρ hcρ
  have hc := NNReal.coe_nonneg (eLpNormLESNormFDerivOneConst
    (volume : Measure (Fin n → ℝ)) (p : ℝ))
  nlinarith [mul_nonneg (Nat.cast_nonneg (α := ℝ) n) (sub_nonneg.mpr hm),
    mul_nonneg hc (mul_nonneg (Nat.cast_nonneg (α := ℝ) n) (sub_nonneg.mpr hm))]

/-- The corresponding cutoff inequality for the volume of a measurable part
of the calibrated phase. -/
theorem phase_cutoff_volume (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (p : ℝ≥0) (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (hρpos : ∀ x, 0 ≤ ρ x)
    (A : Set (Fin n → ℝ)) (hA : MeasurableSet A)
    (hAP : ∀ x ∈ A, 0 < eval x P) (hAρ : ∀ x ∈ A, 1 ≤ ρ x) :
    volume A ^ (1 / (p : ℝ)) ≤
      ENNReal.ofReal (((n : ℝ) + 1) *
        (eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ) : ℝ) *
        (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0))) := by
  refine (measure_rpow_le_eLpNorm A hA _ ?_ p hp.symm.ne_zero).trans
    (phase_cutoff_sobolev P hP hcal p hp hρ hcρ hρpos)
  intro x hx
  simp only [ite_eq_left (hAP x hx), mul_one, Real.norm_eq_abs, abs_of_nonneg (hρpos x)]
  exact hAρ x hx

end
end Source29PhaseCutoffInequality

/- Component: ScaledBallCutoff.inc -/
namespace Source29ScaledBallCutoff

open MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open scoped Topology BigOperators

noncomputable section

/-- Uniform smooth cutoffs for concentric balls. Their coordinate derivative
sum is bounded by a dimension-dependent constant divided by the radius. -/
theorem exists_ball_cutoffs (n : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (c : Fin n → ℝ) (r : ℝ), 0 < r →
      ∃ ρ : (Fin n → ℝ) → ℝ, ContDiff ℝ 1 ρ ∧ HasCompactSupport ρ ∧
        (∀ x, 0 ≤ ρ x ∧ ρ x ≤ 1) ∧
        (∀ x ∈ Metric.closedBall c r, ρ x = 1) ∧
        tsupport ρ ⊆ Metric.closedBall c (2 * r) ∧
        (∀ x, testBound (fun i ↦ Pi.single i 1) ρ x ≤ C / r) := by
  let b : ContDiffBump (0 : Fin n → ℝ) :=
    { rIn := 1, rOut := 2, rIn_pos := by norm_num, rIn_lt_rOut := by norm_num }
  have hb : ContDiff ℝ 1 (b : (Fin n → ℝ) → ℝ) := b.contDiff
  obtain ⟨D, hD⟩ := (b.hasCompactSupport.fderiv ℝ).exists_bound_of_continuous
    (hb.continuous_fderiv (by norm_num))
  have hD0 : 0 ≤ D := (norm_nonneg _).trans (hD 0)
  refine ⟨n * D + 1, by positivity, ?_⟩
  intro c r hr
  let ρ : (Fin n → ℝ) → ℝ := fun x ↦ b (r⁻¹ • (x - c))
  have hρ : ContDiff ℝ 1 ρ := hb.comp ((contDiff_id.sub contDiff_const).const_smul (r⁻¹))
  have hdist (x : Fin n → ℝ) : dist (r⁻¹ • (x - c)) 0 = dist x c / r := by
    rw [dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr),
      ← dist_eq_norm, div_eq_mul_inv, mul_comm]
  have hout (x : Fin n → ℝ) (hx : x ∉ Metric.closedBall c (2 * r)) : ρ x = 0 := by
    apply b.zero_of_le_dist
    rw [hdist]
    dsimp [b]
    apply (le_div_iff₀ hr).2
    exact (not_le.mp hx).le
  have ht : tsupport ρ ⊆ Metric.closedBall c (2 * r) := by
    apply closure_minimal _ Metric.isClosed_closedBall
    intro x hx
    by_contra hn
    exact hx (hout x hn)
  have hcρ : HasCompactSupport ρ :=
    (isCompact_closedBall c (2 * r)).of_isClosed_subset isClosed_closure ht
  refine ⟨ρ, hρ, hcρ, (fun x ↦ ⟨b.nonneg, b.le_one⟩), ?_, ht, ?_⟩
  · intro x hx
    apply b.one_of_mem_closedBall
    change dist (r⁻¹ • (x - c)) 0 ≤ 1
    rw [hdist]
    exact (div_le_one hr).2 hx
  · intro x
    have he : fderiv ℝ ρ x = r⁻¹ • fderiv ℝ (b : (Fin n → ℝ) → ℝ) (r⁻¹ • (x - c)) := by
      change fderiv ℝ (fun y ↦ b (r⁻¹ • (y - c))) x = _
      rw [fderiv_comp_sub c (f := fun y ↦ b (r⁻¹ • y)), fderiv_comp_smul]
    have hi (i : Fin n) : ‖fderiv ℝ ρ x (Pi.single i 1)‖ ≤ r⁻¹ * D := by
      rw [he, ContinuousLinearMap.smul_apply, norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr hr)]
      apply mul_le_mul_of_nonneg_left _ (inv_pos.mpr hr).le
      calc
        _ ≤ ‖fderiv ℝ (b : (Fin n → ℝ) → ℝ) (r⁻¹ • (x - c))‖ * ‖(Pi.single i (1 : ℝ) : Fin n → ℝ)‖ :=
          ContinuousLinearMap.le_opNorm _ _
        _ ≤ ‖fderiv ℝ (b : (Fin n → ℝ) → ℝ) (r⁻¹ • (x - c))‖ := by
          apply mul_le_of_le_one_right (norm_nonneg _)
          exact (pi_norm_le_iff_of_nonneg (by norm_num)).2 (fun j ↦ by
            by_cases h : j = i
            · subst j; simp
            · simp [Pi.single_apply, h, Ne.symm h])
        _ ≤ D := hD _
    calc
      testBound (fun i ↦ Pi.single i 1) ρ x ≤ ∑ _i : Fin n, r⁻¹ * D :=
        Finset.sum_le_sum (fun i _ ↦ hi i)
      _ = (n : ℝ) * D / r := by simp [div_eq_mul_inv]; ring
      _ ≤ (n * D + 1) / r := (div_le_div_iff_of_pos_right hr).2 (by linarith)

end
end Source29ScaledBallCutoff

/- Component: PhaseBallGrowth.inc -/
namespace Source29PhaseBallGrowth

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29WeakCalibrationLimits Source29PhaseApproximation Source29PhaseCutoffInequality
open Source29ScaledBallCutoff
open scoped Topology NNReal ENNReal

noncomputable section
variable {n : ℕ}

theorem phase_gradient_integral_le_volume (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    (B : Set (Fin n → ℝ)) (hB : MeasurableSet B) (hBfin : volume B ≠ ∞)
    (hs : tsupport ρ ⊆ B) (C : ℝ) (hC : ∀ x, testBound (fun i ↦ Pi.single i 1) ρ x ≤ C) :
    (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0)) ≤
      C * (volume (B ∩ {x | 0 < eval x P})).toReal := by
  classical
  let A := B ∩ {x | 0 < eval x P}
  have hA : MeasurableSet A := hB.inter
    (isOpen_lt continuous_const (contDiff_eval P).continuous).measurableSet
  have hAfin : volume A ≠ ∞ := ne_top_of_le_ne_top hBfin (measure_mono Set.inter_subset_left)
  have hI : Integrable (A.indicator (fun _ ↦ C)) :=
    (integrable_indicator_iff hA).2 (integrableOn_const hAfin)
  have hle : (∫ x, testBound (fun i ↦ Pi.single i 1) ρ x * (if 0 < eval x P then 1 else 0)) ≤
      ∫ x, A.indicator (fun _ ↦ C) x := by
    apply integral_mono (phase_weight_integrable P hP _ (testBound_integrable _ hρ hcρ)) hI
    intro x
    by_cases hx : x ∈ A
    · simp only [Set.indicator_of_mem hx, ite_eq_left (show 0 < eval x P from hx.2), mul_one]
      exact hC x
    · rw [Set.indicator_of_notMem hx]
      by_cases hp : 0 < eval x P
      · have hxb : x ∉ B := fun hb ↦ hx ⟨hb, hp⟩
        have hd : fderiv ℝ ρ x = 0 := fderiv_of_notMem_tsupport ℝ (fun h ↦ hxb (hs h))
        simp [testBound, hd]
      · simp [hp]
  simpa only [integral_indicator_const C hA, smul_eq_mul, measureReal_def, mul_comm] using hle

/-- A scale-independent volume-growth inequality for every calibrated polynomial
phase. This is the quantitative input for the density iteration. -/
theorem exists_phase_ball_growth_constant (n : ℕ) (p : ℝ≥0)
    (hp : NNReal.HolderConjugate (Module.finrank ℝ (Fin n → ℝ)) p) :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : MvPolynomial (Fin n) ℝ), P ≠ 0 →
      WeakCalibration (leadingNormalizedField P) → ∀ (c : Fin n → ℝ) (r : ℝ), 0 < r →
      volume (Metric.closedBall c r ∩ {x | 0 < eval x P}) ^ (1 / (p : ℝ)) ≤
        ENNReal.ofReal (K / r * (volume (Metric.closedBall c (2 * r) ∩ {x | 0 < eval x P})).toReal) := by
  obtain ⟨C, hCpos, hC⟩ := exists_ball_cutoffs n
  let S : ℝ := eLpNormLESNormFDerivOneConst (volume : Measure (Fin n → ℝ)) (p : ℝ)
  have hS : 0 ≤ S := NNReal.coe_nonneg _
  refine ⟨((n : ℝ) + 1) * (S + 1) * C, by positivity, ?_⟩
  intro P hP hcal c r hr
  obtain ⟨ρ, hρ, hcρ, hρb, hρone, hρs, hρC⟩ := hC c r hr
  have hphase : MeasurableSet {x | 0 < eval x P} :=
    (isOpen_lt continuous_const (contDiff_eval P).continuous).measurableSet
  have hv := phase_cutoff_volume P hP hcal p hp hρ hcρ (fun x ↦ (hρb x).1)
    (Metric.closedBall c r ∩ {x | 0 < eval x P}) (Metric.isClosed_closedBall.measurableSet.inter hphase)
    (fun x hx ↦ hx.2) (fun x hx ↦ (hρone x hx.1).ge)
  have hg := phase_gradient_integral_le_volume P hP hρ hcρ (Metric.closedBall c (2 * r))
    Metric.isClosed_closedBall.measurableSet (isCompact_closedBall c (2 * r)).measure_ne_top hρs (C / r) hρC
  refine hv.trans (ENNReal.ofReal_le_ofReal ?_)
  change ((n : ℝ) + 1) * S * _ ≤ _
  calc
    _ ≤ ((n : ℝ) + 1) * S * (C / r *
        (volume (Metric.closedBall c (2 * r) ∩ {x | 0 < eval x P})).toReal) :=
      mul_le_mul_of_nonneg_left hg (mul_nonneg (by positivity) hS)
    _ ≤ ((n : ℝ) + 1) * (S + 1) * (C / r *
        (volume (Metric.closedBall c (2 * r) ∩ {x | 0 < eval x P})).toReal) := by
      gcongr
      linarith
    _ = _ := by ring

/-- The volume-growth estimate specialized to the exact dimension in source29. -/
theorem top_phase_ball_growth_eight :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r →
      let F := homogeneousComponent P.totalDegree P
      volume (Metric.closedBall c r ∩ {x | 0 < eval x F}) ^ (7 / 8 : ℝ) ≤
        ENNReal.ofReal (K / r * (volume (Metric.closedBall c (2 * r) ∩ {x | 0 < eval x F})).toReal) := by
  obtain ⟨K, hK, h⟩ := exists_phase_ball_growth_constant 8 (8 / 7)
    Source29LocalPhaseSobolev.holder_eight
  refine ⟨K, hK, ?_⟩
  intro P hmin hdeg c r hr
  simpa only [NNReal.coe_div, NNReal.coe_ofNat, one_div_div] using
    h (homogeneousComponent P.totalDegree P)
      (Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P (by omega))
      (Source29TopPhasePerimeter.top_weakCalibration P hmin hdeg) c r hr

end
end Source29PhaseBallGrowth

/- Component: DyadicDensity.inc -/
namespace Source29DyadicDensity

open Filter
open scoped Topology

noncomputable section

theorem eighth_power_rpow (x : ℝ) (hx : 0 ≤ x) :
    (x ^ 8) ^ (7 / 8 : ℝ) = x ^ 7 := by
  rw [← Real.rpow_natCast_mul hx 8]
  norm_num

/-- The density barrier propagates from a ball to its doubled ball. -/
theorem density_step {K t r v w : ℝ} (hK : 0 < K) (ht : 0 < t) (hr : 0 < r)
    (hsmall : 256 * K * t ≤ 1)
    (hv : (t * r) ^ 8 ≤ v) (hg : v ^ (7 / 8 : ℝ) ≤ K / r * w) :
    (t * (2 * r)) ^ 8 ≤ w := by
  have hp : (t * r) ^ 7 ≤ K / r * w := by
    rw [← eighth_power_rpow (t * r) (by positivity)]
    exact (Real.rpow_le_rpow (by positivity) hv (by norm_num)).trans hg
  have hp' : (t * r) ^ 7 * r ≤ K * w := by
    calc
      _ ≤ (K / r * w) * r := mul_le_mul_of_nonneg_right hp hr.le
      _ = K * w := by field_simp
  have hb : K * (t * (2 * r)) ^ 8 ≤ (t * r) ^ 7 * r := by
    have h := mul_le_mul_of_nonneg_right hsmall
      (mul_nonneg (pow_nonneg ht.le 7) (pow_nonneg hr.le 8))
    convert h using 1 <;> ring
  exact (mul_le_mul_iff_right₀ hK).mp (hb.trans hp')

/-- A suitable positive barrier parameter exists for every positive growth constant. -/
theorem exists_density_parameter {K : ℝ} (hK : 0 < K) :
    ∃ t : ℝ, 0 < t ∧ t ≤ 1 ∧ 256 * K * t ≤ 1 := by
  refine ⟨min 1 (1 / (256 * K)), lt_min (by norm_num) (by positivity), min_le_left _ _, ?_⟩
  have h := mul_le_mul_of_nonneg_left (min_le_right (1 : ℝ) (1 / (256 * K)))
    (show 0 ≤ 256 * K by positivity)
  calc
    256 * K * min 1 (1 / (256 * K)) ≤ 256 * K * (1 / (256 * K)) := h
    _ = 1 := by field_simp

/-- A lower bound valid at sufficiently small radii extends to every radius
by finitely many applications of the doubling inequality. -/
theorem density_all_radii {K t : ℝ} (hK : 0 < K) (ht : 0 < t)
    (hsmall : 256 * K * t ≤ 1) (v : ℝ → ℝ)
    (hg : ∀ r, 0 < r → v r ^ (7 / 8 : ℝ) ≤ K / r * v (2 * r))
    (hbase : ∃ ε : ℝ, 0 < ε ∧ ∀ r, 0 < r → r < ε → (t * r) ^ 8 ≤ v r) :
    ∀ R : ℝ, 0 < R → (t * R) ^ 8 ≤ v R := by
  obtain ⟨ε, hε, hbase⟩ := hbase
  intro R hR
  have hlim : Tendsto (fun k : ℕ ↦ R * ((1 / 2 : ℝ) ^ k)) atTop (𝓝 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (by norm_num : (1 / 2 : ℝ) < 1)).const_mul R
  obtain ⟨m, hm⟩ := (hlim.eventually (gt_mem_nhds hε)).exists
  have hpositive : 0 < R * ((1 / 2 : ℝ) ^ m) := by positivity
  have hs := hbase _ hpositive hm
  have hd (r : ℝ) (hr : 0 < r) (hrb : (t * r) ^ 8 ≤ v r) (j : ℕ) :
      (t * ((2 : ℝ) ^ j * r)) ^ 8 ≤ v ((2 : ℝ) ^ j * r) := by
    induction j with
    | zero => simpa using hrb
    | succ j ih =>
      have hz : 0 < (2 : ℝ) ^ j * r := by positivity
      have hh := density_step hK ht hz hsmall ih (hg _ hz)
      have he : (2 : ℝ) ^ (j + 1) * r = 2 * ((2 : ℝ) ^ j * r) := by
        rw [pow_succ]
        ring
      rw [he]
      exact hh
  have he : (2 : ℝ) ^ m * (R * ((1 / 2 : ℝ) ^ m)) = R := by
    rw [one_div, inv_pow]
    field_simp
  simpa only [he] using hd _ hpositive hs m

end
end Source29DyadicDensity

/- Component: PhaseVolumeDensity.inc -/
namespace Source29PhaseVolumeDensity

open MvPolynomial MeasureTheory Filter
open Source29DyadicDensity
open scoped Topology ENNReal

noncomputable section

/-- Real volume in a closed coordinate ball. The intersection has finite measure. -/
def ballVolume (S : Set (Fin 8 → ℝ)) (c : Fin 8 → ℝ) (r : ℝ) : ℝ :=
  (volume (Metric.closedBall c r ∩ S)).toReal

theorem ballVolume_nonneg (S : Set (Fin 8 → ℝ)) (c : Fin 8 → ℝ) (r : ℝ) :
    0 ≤ ballVolume S c r := ENNReal.toReal_nonneg

theorem ballVolume_mono {S T : Set (Fin 8 → ℝ)} {c d : Fin 8 → ℝ} {r s : ℝ}
    (h : Metric.closedBall c r ∩ S ⊆ Metric.closedBall d s ∩ T) :
    ballVolume S c r ≤ ballVolume T d s := by
  apply ENNReal.toReal_mono _ (measure_mono h)
  exact ne_top_of_le_ne_top (isCompact_closedBall d s).measure_ne_top
    (measure_mono Set.inter_subset_left)

theorem ballVolume_of_subset {S : Set (Fin 8 → ℝ)} {c : Fin 8 → ℝ} {r : ℝ}
    (hr : 0 ≤ r) (h : Metric.closedBall c r ⊆ S) : ballVolume S c r = (2 * r) ^ 8 := by
  rw [ballVolume, Set.inter_eq_left.mpr h, Real.volume_pi_closedBall c hr]
  simp only [Fintype.card_fin, ENNReal.toReal_ofReal (by positivity : 0 ≤ (2 * r) ^ 8)]

/-- Disjoint pieces of a ball have total real volume at most the ball volume. -/
theorem disjoint_ballVolumes_le {S T : Set (Fin 8 → ℝ)} (hT : MeasurableSet T)
    (hST : Disjoint S T) (c : Fin 8 → ℝ) (r : ℝ) (hr : 0 ≤ r) :
    ballVolume S c r + ballVolume T c r ≤ (2 * r) ^ 8 := by
  have hf (U : Set (Fin 8 → ℝ)) : volume (Metric.closedBall c r ∩ U) ≠ ∞ :=
    ne_top_of_le_ne_top (isCompact_closedBall c r).measure_ne_top
      (measure_mono Set.inter_subset_left)
  have hd : Disjoint (Metric.closedBall c r ∩ S) (Metric.closedBall c r ∩ T) :=
    hST.mono Set.inter_subset_right Set.inter_subset_right
  have hm : volume (Metric.closedBall c r ∩ S) + volume (Metric.closedBall c r ∩ T) ≤
      volume (Metric.closedBall c r) := by
    rw [← measure_union hd (Metric.isClosed_closedBall.measurableSet.inter hT)]
    exact measure_mono (Set.union_subset Set.inter_subset_left Set.inter_subset_left)
  have h := ENNReal.toReal_mono (isCompact_closedBall c r).measure_ne_top hm
  rw [ENNReal.toReal_add (hf S) (hf T), Real.volume_pi_closedBall c hr] at h
  simpa only [ballVolume, Fintype.card_fin, ENNReal.toReal_ofReal
    (by positivity : 0 ≤ (2 * r) ^ 8)] using h

theorem ballVolume_growth_real {S : Set (Fin 8 → ℝ)} {K : ℝ} (hK : 0 ≤ K)
    (hg : ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r →
      volume (Metric.closedBall c r ∩ S) ^ (7 / 8 : ℝ) ≤
        ENNReal.ofReal (K / r * (volume (Metric.closedBall c (2 * r) ∩ S)).toReal))
    (c : Fin 8 → ℝ) (r : ℝ) (hr : 0 < r) :
    ballVolume S c r ^ (7 / 8 : ℝ) ≤ K / r * ballVolume S c (2 * r) := by
  have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top (hg c r hr)
  rw [← ENNReal.toReal_rpow, ENNReal.toReal_ofReal (by positivity)] at h
  exact h

/-- Every interior point of an open set with the uniform ball-growth estimate
has a uniform positive volume density at every radius. -/
theorem open_set_density {K t : ℝ} (hK : 0 < K) (ht : 0 < t) (ht1 : t ≤ 1)
    (hsmall : 256 * K * t ≤ 1) (S : Set (Fin 8 → ℝ)) (hS : IsOpen S)
    (hg : ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r →
      ballVolume S c r ^ (7 / 8 : ℝ) ≤ K / r * ballVolume S c (2 * r)) :
    ∀ c ∈ S, ∀ R : ℝ, 0 < R → (t * R) ^ 8 ≤ ballVolume S c R := by
  intro c hc
  apply density_all_radii hK ht hsmall (ballVolume S c) (hg c)
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hS c hc
  refine ⟨ε, hε, ?_⟩
  intro r hr hrε
  have hsub : Metric.closedBall c r ⊆ S :=
    (Metric.closedBall_subset_ball hrε).trans hball
  rw [ballVolume_of_subset hr.le hsub]
  gcongr
  linarith

/-- The same estimate at closure points, with the radius halved. -/
theorem closure_density {t : ℝ} (ht : 0 < t) (S : Set (Fin 8 → ℝ))
    (hinterior : ∀ c ∈ S, ∀ R : ℝ, 0 < R → (t * R) ^ 8 ≤ ballVolume S c R) :
    ∀ a ∈ closure S, ∀ R : ℝ, 0 < R → (t * (R / 2)) ^ 8 ≤ ballVolume S a R := by
  intro a ha R hR
  obtain ⟨c, hc, hca⟩ := Metric.mem_closure_iff.mp ha (R / 2) (by positivity)
  have hsub : Metric.closedBall c (R / 2) ∩ S ⊆ Metric.closedBall a R ∩ S := by
    intro x hx
    refine ⟨?_, hx.2⟩
    have hx' : dist x c ≤ R / 2 := hx.1
    have hc' : dist c a < R / 2 := by simpa only [dist_comm] using hca
    change dist x a ≤ R
    calc
      dist x a ≤ dist x c + dist c a := dist_triangle _ _ _
      _ ≤ R := by linarith
  exact (hinterior c hc (R / 2) (by positivity)).trans (ballVolume_mono hsub)

end
end Source29PhaseVolumeDensity

/- Component: TopPhaseDensity.inc -/
namespace Source29TopPhaseDensity

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial Source29DyadicDensity Source29PhaseVolumeDensity
open Source29PhaseBallGrowth
open scoped Topology ENNReal

noncomputable section

/-- Every point in the closure of a leading positive phase has uniformly
positive volume density, with one constant for all nonaffine solutions. -/
theorem top_positive_phase_density :
    ∃ d : ℝ, 0 < d ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ), 0 ≤ eval c (homogeneousComponent P.totalDegree P) →
      ∀ (R : ℝ), 0 < R →
      d * R ^ 8 ≤ ballVolume {x | 0 < eval x (homogeneousComponent P.totalDegree P)} c R := by
  obtain ⟨K, hK, hg⟩ := top_phase_ball_growth_eight
  obtain ⟨t, ht, ht1, hsmall⟩ := exists_density_parameter hK
  refine ⟨(t / 2) ^ 8, by positivity, ?_⟩
  intro P hmin hdeg c hc R hR
  let S : Set (Fin 8 → ℝ) := {x | 0 < eval x (homogeneousComponent P.totalDegree P)}
  have hS : IsOpen S := isOpen_lt continuous_const (contDiff_eval _).continuous
  have hgr : ∀ (a : Fin 8 → ℝ) (r : ℝ), 0 < r →
      ballVolume S a r ^ (7 / 8 : ℝ) ≤ K / r * ballVolume S a (2 * r) :=
    ballVolume_growth_real hK.le (hg P hmin hdeg)
  have hd := open_set_density hK ht ht1 hsmall S hS hgr
  have hcl : c ∈ closure S := by
    rw [(Source29TopPhaseBoundary.top_phase_boundaries P hmin hdeg).1]
    exact hc
  calc
    (t / 2) ^ 8 * R ^ 8 = (t * (R / 2)) ^ 8 := by ring
    _ ≤ ballVolume S c R := closure_density ht S hd c hcl R hR

/-- Uniform two-sided density for the leading polynomial zero set. -/
theorem top_two_sided_density :
    ∃ d : ℝ, 0 < d ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ), eval c (homogeneousComponent P.totalDegree P) = 0 →
      ∀ (R : ℝ), 0 < R →
      d * R ^ 8 ≤ ballVolume {x | 0 < eval x (homogeneousComponent P.totalDegree P)} c R ∧
      d * R ^ 8 ≤ ballVolume {x | eval x (homogeneousComponent P.totalDegree P) < 0} c R := by
  obtain ⟨d, hd, h⟩ := top_positive_phase_density
  refine ⟨d, hd, ?_⟩
  intro P hmin hdeg c hc R hR
  refine ⟨h P hmin hdeg c hc.ge R hR, ?_⟩
  have hm : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (-P) := by
    change Source29QuarticReuse.QuarticPolynomialBasics.minimalGraphOperator (-P) = 0
    rw [minimalGraphOperator_neg]
    exact neg_eq_zero.mpr hmin
  have hdeg' : 2 ≤ (-P).totalDegree := by simpa only [totalDegree_neg] using hdeg
  have hc' : 0 ≤ eval c (homogeneousComponent (-P).totalDegree (-P)) := by
    simp only [totalDegree_neg, map_neg, hc, neg_zero, le_refl]
  simpa only [totalDegree_neg, map_neg, neg_pos] using h (-P) hm hdeg' c hc' R hR

/-- At every leading zero both phase fractions stay uniformly away from zero
and from the full ball volume. -/
theorem top_two_sided_volume_bounds :
    ∃ d : ℝ, 0 < d ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ), eval c (homogeneousComponent P.totalDegree P) = 0 →
      ∀ (R : ℝ), 0 < R →
      d * R ^ 8 ≤ ballVolume {x | 0 < eval x (homogeneousComponent P.totalDegree P)} c R ∧
      ballVolume {x | 0 < eval x (homogeneousComponent P.totalDegree P)} c R ≤ (256 - d) * R ^ 8 ∧
      d * R ^ 8 ≤ ballVolume {x | eval x (homogeneousComponent P.totalDegree P) < 0} c R ∧
      ballVolume {x | eval x (homogeneousComponent P.totalDegree P) < 0} c R ≤ (256 - d) * R ^ 8 := by
  obtain ⟨d, hd, h⟩ := top_two_sided_density
  refine ⟨d, hd, ?_⟩
  intro P hmin hdeg c hc R hR
  obtain ⟨hpos, hneg⟩ := h P hmin hdeg c hc R hR
  have hdisj : Disjoint {x | 0 < eval x (homogeneousComponent P.totalDegree P)}
      {x | eval x (homogeneousComponent P.totalDegree P) < 0} := by
    apply Set.disjoint_left.mpr
    intro x hx hy
    exact (not_lt_of_ge (show 0 < eval x (homogeneousComponent P.totalDegree P) from hx).le) hy
  have hsum := disjoint_ballVolumes_le
    (isOpen_lt (contDiff_eval _).continuous continuous_const).measurableSet hdisj c R hR.le
  have hpow : (2 * R) ^ 8 = 256 * R ^ 8 := by ring
  rw [hpow] at hsum
  exact ⟨hpos, by nlinarith, hneg, by nlinarith⟩

end
end Source29TopPhaseDensity

/- Component: PerimeterBallUpper.inc -/
namespace Source29PerimeterBallUpper

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxPolynomial
open Source29PhaseMassLimit Source29PhaseMassFunctional Source29PhaseCutoffInequality
open Source29LocalPhasePerimeter Source29LocalPerimeterMass Source29TopPhasePerimeter
open Source29ScaledBallCutoff Source29PhaseBallGrowth Source29PhaseVolumeDensity
open scoped Topology ENNReal

noncomputable section

/-- Uniform upper growth of the leading phase perimeter on every ball. -/
theorem top_positive_perimeter_ball_upper :
    ∃ A : ℝ, 0 < A ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r →
      localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} (Metric.ball c r) ≤
        ENNReal.ofReal (A * r ^ 7) := by
  obtain ⟨C, hCpos, hC⟩ := exists_ball_cutoffs 8
  refine ⟨(4 : ℝ) ^ 8 * C, by positivity, ?_⟩
  intro P hmin hdeg c r hr
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hcal := top_weakCalibration P hmin hdeg
  obtain ⟨η, hη, hcη, hηb, hηone, hηs, hηC⟩ := hC c r hr
  have hmass : phaseMass F η ≤ (4 : ℝ) ^ 8 * C * r ^ 7 := by
    have hi := phase_gradient_integral_le_volume F hF hη hcη (Metric.closedBall c (2 * r))
      Metric.isClosed_closedBall.measurableSet (isCompact_closedBall c (2 * r)).measure_ne_top hηs (C / r) hηC
    have hv : ballVolume {x | 0 < eval x F} c (2 * r) ≤ (4 * r) ^ 8 := by
      have hm : ballVolume {x | 0 < eval x F} c (2 * r) ≤ ballVolume Set.univ c (2 * r) :=
        ballVolume_mono (fun _ hx ↦ ⟨hx.1, Set.mem_univ _⟩)
      rw [ballVolume_of_subset (by positivity) (Set.subset_univ _)] at hm
      convert hm using 1 <;> ring
    calc
      phaseMass F η ≤ _ := phaseMass_le_phase_gradient F hF hcal hη hcη
      _ ≤ C / r * ballVolume {x | 0 < eval x F} c (2 * r) := hi
      _ ≤ C / r * (4 * r) ^ 8 := mul_le_mul_of_nonneg_left hv (by positivity)
      _ = (4 : ℝ) ^ 8 * C * r ^ 7 := by field_simp
  rw [top_localPerimeter_eq_iSup_mass P hmin hdeg _ Metric.isOpen_ball]
  apply iSup_le
  intro ρ
  apply iSup_le
  intro hρ
  apply ENNReal.ofReal_le_ofReal
  refine (phaseMass_mono F hF hcal hρ.smooth hρ.compact hη hcη ?_).trans hmass
  intro x
  by_cases hx : x ∈ Metric.ball c r
  · rw [hηone x (Metric.ball_subset_closedBall hx)]
    exact (hρ.bound x).2
  · have hz : ρ x = 0 := image_eq_zero_of_notMem_tsupport (fun h ↦ hx (hρ.within h))
    rw [hz]
    exact (hηb x).1

/-- The same growth constant works for both strict leading phases. -/
theorem top_both_perimeters_ball_upper :
    ∃ A : ℝ, 0 < A ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r →
      localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} (Metric.ball c r) ≤
        ENNReal.ofReal (A * r ^ 7) ∧
      localPerimeter {x | eval x (homogeneousComponent P.totalDegree P) < 0} (Metric.ball c r) ≤
        ENNReal.ofReal (A * r ^ 7) := by
  obtain ⟨A, hA, h⟩ := top_positive_perimeter_ball_upper
  refine ⟨A, hA, ?_⟩
  intro P hmin hdeg c r hr
  refine ⟨h P hmin hdeg c r hr, ?_⟩
  have hm : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (-P) := by
    change minimalGraphOperator (-P) = 0
    rw [minimalGraphOperator_neg]
    exact neg_eq_zero.mpr hmin
  have hd : 2 ≤ (-P).totalDegree := by simpa only [totalDegree_neg] using hdeg
  simpa only [totalDegree_neg, map_neg, neg_pos] using h (-P) hm hd c r hr

end
end Source29PerimeterBallUpper

/- Component: IntervalOscillation.inc -/
namespace Source29IntervalOscillation

open MeasureTheory Set
open scoped Topology

noncomputable section

theorem ordered_oscillation_le_derivative_integral {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) {a b x y : ℝ} (hax : a ≤ x) (hxy : x ≤ y) (hyb : y ≤ b) :
    ‖f y - f x‖ ≤ ∫ t in Icc a b, ‖deriv f t‖ := by
  have hd : Continuous (deriv f) := hf.continuous_deriv_one
  rw [← intervalIntegral.integral_deriv_eq_sub
    (fun z _ ↦ hf.differentiable (by norm_num) z) (hd.intervalIntegrable x y)]
  calc
    ‖∫ t in x..y, deriv f t‖ ≤ ∫ t in x..y, ‖deriv f t‖ :=
      intervalIntegral.norm_integral_le_integral_norm hxy
    _ = ∫ t in Icc x y, ‖deriv f t‖ := by
      rw [intervalIntegral.integral_of_le hxy, restrict_Ioc_eq_restrict_Icc]
    _ ≤ ∫ t in Icc a b, ‖deriv f t‖ := by
      apply setIntegral_mono_set (hd.norm.integrableOn_Icc)
        (Filter.Eventually.of_forall fun _ ↦ norm_nonneg _)
      exact Filter.Eventually.of_forall fun z hz ↦ ⟨hax.trans hz.1, hz.2.trans hyb⟩

/-- Any two values on an interval differ by at most the integral of the
absolute derivative over that interval. -/
theorem oscillation_le_derivative_integral {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) {a b x y : ℝ} (hx : x ∈ Icc a b) (hy : y ∈ Icc a b) :
    ‖f x - f y‖ ≤ ∫ t in Icc a b, ‖deriv f t‖ := by
  rcases le_total x y with h | h
  · rw [norm_sub_rev]
    exact ordered_oscillation_le_derivative_integral hf hx.1 h hy.2
  · exact ordered_oscillation_le_derivative_integral hf hy.1 h hx.2

end
end Source29IntervalOscillation

/- Component: CoordinateOscillation.inc -/
namespace Source29CoordinateOscillation

open MeasureTheory Set
open Source29IntervalOscillation
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def bridge (x y : Fin n → ℝ) (k : ℕ) (i : Fin n) : ℝ :=
  if (i : ℕ) < k then y i else x i

theorem bridge_zero (x y : Fin n → ℝ) : bridge x y 0 = x := by
  ext i
  simp [bridge]

theorem bridge_end (x y : Fin n → ℝ) : bridge x y n = y := by
  ext i
  simp [bridge, i.isLt]

theorem bridge_step (x y : Fin n → ℝ) (i : Fin n) :
    bridge x y ((i : ℕ) + 1) = Function.update (bridge x y i) i (y i) := by
  ext j
  by_cases h : j = i
  · subst j
    simp [bridge]
  · have hne : (j : ℕ) ≠ (i : ℕ) := fun he ↦ h (Fin.ext he)
    simp only [bridge, Function.update_of_ne h]
    by_cases hj : (j : ℕ) < (i : ℕ)
    · simp [hj, show (j : ℕ) < (i : ℕ) + 1 by omega]
    · simp [hj, show ¬ (j : ℕ) < (i : ℕ) + 1 by omega]

theorem bridge_current (x y : Fin n → ℝ) (i : Fin n) : bridge x y i i = x i := by
  simp [bridge]

theorem deriv_update_comp (f : (Fin n → ℝ) → ℝ) (hf : ContDiff ℝ 1 f)
    (x : Fin n → ℝ) (i : Fin n) (t : ℝ) :
    deriv (fun s ↦ f (Function.update x i s)) t =
      fderiv ℝ f (Function.update x i t) (Pi.single i 1) := by
  exact (((hf.differentiable (by norm_num) (Function.update x i t)).hasFDerivAt).comp_hasDerivAt t
    (hasDerivAt_update x i t)).deriv

/-- Change coordinates one at a time and apply the interval derivative bound. -/
theorem box_pointwise_oscillation (f : (Fin n → ℝ) → ℝ) (hf : ContDiff ℝ 1 f)
    (a b x y : Fin n → ℝ) (hx : ∀ i, x i ∈ Icc (a i) (b i)) (hy : ∀ i, y i ∈ Icc (a i) (b i)) :
    ‖f x - f y‖ ≤ ∑ i : Fin n, ∫ t in Icc (a i) (b i),
      ‖fderiv ℝ f (Function.update (bridge x y i) i t) (Pi.single i 1)‖ := by
  have htri := dist_le_range_sum_dist (fun k ↦ f (bridge x y k)) n
  rw [bridge_zero, bridge_end, ← Fin.sum_univ_eq_sum_range] at htri
  simp only [dist_eq_norm] at htri
  refine htri.trans (Finset.sum_le_sum ?_)
  intro i _
  have hs : ContDiff ℝ 1 (fun t ↦ f (Function.update (bridge x y i) i t)) :=
    hf.comp (contDiff_update 1 (bridge x y i) i)
  have h := oscillation_le_derivative_integral hs (hx i) (hy i)
  have hstart : Function.update (bridge x y i) i (x i) = bridge x y i := by
    rw [← bridge_current x y i, Function.update_eq_self]
  rw [hstart, ← bridge_step] at h
  simpa only [deriv_update_comp f hf] using h

end
end Source29CoordinateOscillation

/- Component: CoordinateRecombination.inc -/
namespace Source29CoordinateRecombination

open MeasureTheory
open Source29CoordinateOscillation
open scoped Topology

noncomputable section
variable {n : ℕ}

def prefixSwap (k : ℕ) : ((Fin n → ℝ) × (Fin n → ℝ)) ≃ᵐ ((Fin n → ℝ) × (Fin n → ℝ)) where
  toFun p := (bridge p.1 p.2 k, bridge p.2 p.1 k)
  invFun p := (bridge p.1 p.2 k, bridge p.2 p.1 k)
  left_inv p := by
    ext i <;> simp only [bridge] <;> split_ifs <;> rfl
  right_inv p := by
    ext i <;> simp only [bridge] <;> split_ifs <;> rfl
  measurable_toFun := by
    apply Measurable.prodMk
    all_goals
      apply measurable_pi_lambda
      intro i
      dsimp [bridge]
      split_ifs <;> fun_prop
  measurable_invFun := by
    apply Measurable.prodMk
    all_goals
      apply measurable_pi_lambda
      intro i
      dsimp [bridge]
      split_ifs <;> fun_prop

/-- Exchanging the same selected coordinates between two independent vectors
preserves their joint product measure. -/
theorem prefixSwap_measurePreserving (μ : Fin n → Measure ℝ) [∀ i, SigmaFinite (μ i)] (k : ℕ) :
    MeasurePreserving (prefixSwap (n := n) k) ((Measure.pi μ).prod (Measure.pi μ))
      ((Measure.pi μ).prod (Measure.pi μ)) := by
  let e := MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ (Fin n)
  have he := measurePreserving_arrowProdEquivProdArrow ℝ ℝ (Fin n) μ μ
  let s : Fin n → ℝ × ℝ → ℝ × ℝ := fun i p ↦ if (i : ℕ) < k then p.swap else p
  have hs (i : Fin n) : MeasurePreserving (s i) ((μ i).prod (μ i)) ((μ i).prod (μ i)) := by
    dsimp [s]
    split_ifs
    · exact Measure.measurePreserving_swap
    · exact MeasurePreserving.id _
  have h := he.comp ((measurePreserving_pi _ _ hs).comp he.symm)
  have hh : e ∘ (fun p i ↦ s i (p i)) ∘ e.symm = prefixSwap (n := n) k := by
    funext p
    apply Prod.ext
    all_goals
      funext i
      simp only [Function.comp_def, e, s, prefixSwap, bridge,
        MeasurableEquiv.arrowProdEquivProdArrow, MeasurableEquiv.coe_mk,
        MeasurableEquiv.symm, Equiv.arrowProdEquivProdArrow, Equiv.coe_fn_mk, Equiv.coe_fn_symm_mk]
      split_ifs <;> rfl
  rw [hh] at h
  exact h

/-- A mixed coordinate vector has the same distribution as the original first
vector, with the unused vector contributing its total mass. -/
theorem integral_bridge (μ : Fin n → Measure ℝ) [∀ i, SigmaFinite (μ i)]
    (k : ℕ) (f : (Fin n → ℝ) → ℝ) :
    (∫ p, f (bridge p.1 p.2 k) ∂((Measure.pi μ).prod (Measure.pi μ))) =
      (Measure.pi μ).real Set.univ * ∫ x, f x ∂Measure.pi μ := by
  have h := (prefixSwap_measurePreserving μ k).integral_comp' (fun p ↦ f p.1)
  change (∫ p, f (bridge p.1 p.2 k) ∂((Measure.pi μ).prod (Measure.pi μ))) = _ at h
  rw [h, integral_fun_fst, smul_eq_mul]

end
end Source29CoordinateRecombination

/- Component: CoordinateAveraging.inc -/
namespace Source29CoordinateAveraging

open MeasureTheory
open scoped Topology

noncomputable section

/-- Integrating a coordinate resampling over both the original vector and the
new coordinate multiplies the original integral by the coordinate's mass. -/
theorem integral_update_average {n : ℕ} (μ : Fin (n + 1) → Measure ℝ)
    [∀ i, SigmaFinite (μ i)] (i : Fin (n + 1))
    (f : (Fin (n + 1) → ℝ) → ℝ) (hf : Integrable f (Measure.pi μ)) :
    (∫ x, ∫ t, f (Function.update x i t) ∂μ i ∂Measure.pi μ) =
      (μ i).real Set.univ * ∫ x, f x ∂Measure.pi μ := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) i
  let ν := Measure.pi (fun j : Fin n ↦ μ (i.succAbove j))
  have he := measurePreserving_piFinSuccAbove μ i
  let g : ℝ × (Fin n → ℝ) → ℝ := fun p ↦ f (e.symm p)
  have hg : Integrable g ((μ i).prod ν) := he.symm.integrable_comp_of_integrable hf
  have hupdate (p : ℝ × (Fin n → ℝ)) (t : ℝ) :
      f (Function.update (e.symm p) i t) = g (t, p.2) := by
    simp only [g, e, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv,
      Equiv.coe_fn_mk, Fin.update_insertNth]
  calc
    (∫ x, ∫ t, f (Function.update x i t) ∂μ i ∂Measure.pi μ) =
        ∫ p, ∫ t, f (Function.update (e.symm p) i t) ∂μ i ∂(μ i).prod ν :=
      (he.symm.integral_comp' _).symm
    _ = ∫ p : ℝ × (Fin n → ℝ), ∫ t, g (t, p.2) ∂μ i ∂(μ i).prod ν := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun p ↦ integral_congr_ae (Filter.Eventually.of_forall (hupdate p))
    _ = (μ i).real Set.univ * (∫ z, ∫ t, g (t, z) ∂μ i ∂ν) := by
      simpa only [smul_eq_mul] using
        (integral_fun_snd (μ := μ i) (ν := ν) (fun z ↦ ∫ t, g (t, z) ∂μ i))
    _ = (μ i).real Set.univ * (∫ p, g p ∂(μ i).prod ν) := by
      rw [integral_prod_symm g hg]
    _ = (μ i).real Set.univ * ∫ x, f x ∂Measure.pi μ := by
      rw [he.symm.integral_comp' f]

/-- The coordinate-averaged function remains integrable for finite coordinate measures. -/
theorem integrable_update_average {n : ℕ} (μ : Fin (n + 1) → Measure ℝ)
    [∀ i, IsFiniteMeasure (μ i)] (i : Fin (n + 1))
    (f : (Fin (n + 1) → ℝ) → ℝ) (hf : Integrable f (Measure.pi μ)) :
    Integrable (fun x ↦ ∫ t, f (Function.update x i t) ∂μ i) (Measure.pi μ) := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) i
  let ν := Measure.pi (fun j : Fin n ↦ μ (i.succAbove j))
  have he := measurePreserving_piFinSuccAbove μ i
  let g : ℝ × (Fin n → ℝ) → ℝ := fun p ↦ f (e.symm p)
  have hg : Integrable g ((μ i).prod ν) := he.symm.integrable_comp_of_integrable hf
  have hG := hg.integral_prod_right.comp_snd (μ i)
  have hcomp : Integrable ((fun x ↦ ∫ t, f (Function.update x i t) ∂μ i) ∘ e.symm)
      ((μ i).prod ν) := by
    convert hG using 1
    funext p
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun t ↦ (by
      simp only [Function.comp_def, g, e, MeasurableEquiv.piFinSuccAbove_symm_apply,
        Fin.insertNthEquiv, Equiv.coe_fn_mk, Fin.update_insertNth])
  exact (he.symm.integrable_comp_emb e.symm.measurableEmbedding).mp hcomp

end
end Source29CoordinateAveraging

/- Component: CubePoincare.inc -/
namespace Source29CubePoincare

open MeasureTheory Set
open Source29CoordinateOscillation Source29CoordinateRecombination Source29CoordinateAveraging
open scoped Topology BigOperators

noncomputable section

/-- An L1 Poincare estimate on a cube, expressed as mean pairwise oscillation. -/
theorem box_poincare {n : ℕ} (f : (Fin (n + 1) → ℝ) → ℝ) (hf : ContDiff ℝ 1 f)
    (a b : Fin (n + 1) → ℝ) (hab : a ≤ b) :
    let Q := Icc a b
    (∫ p, ‖f p.1 - f p.2‖ ∂((volume.restrict Q).prod (volume.restrict Q))) ≤
      (∏ i, (b i - a i)) * ∑ i : Fin (n + 1), (b i - a i) *
        ∫ x in Q, ‖fderiv ℝ f x (Pi.single i 1)‖ := by
  let Q := Icc a b
  let μ : Fin (n + 1) → Measure ℝ := fun i ↦ volume.restrict (Icc (a i) (b i))
  let ν := Measure.pi μ
  have hν : ν = volume.restrict Q := by
    simpa only [ν, μ, Q, pi_univ_Icc, ← volume_pi] using
      (Measure.restrict_pi_pi (fun _ : Fin (n + 1) ↦ (volume : Measure ℝ)) (fun i ↦ Icc (a i) (b i))).symm
  have hνmass : ν.real univ = ∏ i, (b i - a i) := by
    simp [hν, Q, measureReal_def, Real.volume_Icc_pi, ENNReal.toReal_ofReal (sub_nonneg.mpr (hab _))]
  have hμmass (i : Fin (n + 1)) : (μ i).real univ = b i - a i := by
    simp [μ, measureReal_def, Real.volume_Icc, ENNReal.toReal_ofReal (sub_nonneg.mpr (hab _))]
  let g : Fin (n + 1) → (Fin (n + 1) → ℝ) → ℝ :=
    fun i x ↦ ‖fderiv ℝ f x (Pi.single i 1)‖
  have hg (i) : Integrable (g i) ν := by
    rw [hν]
    exact ((hf.continuous_fderiv (by norm_num)).clm_apply continuous_const).norm.integrableOn_Icc
  let G : Fin (n + 1) → (Fin (n + 1) → ℝ) → ℝ :=
    fun i x ↦ ∫ t, g i (Function.update x i t) ∂μ i
  have hG (i) : Integrable (G i) ν := integrable_update_average μ i (g i) (hg i)
  have hGb (i : Fin (n + 1)) : Integrable (fun p ↦ G i (bridge p.1 p.2 i)) (ν.prod ν) := by
    have h := (prefixSwap_measurePreserving μ i).integrable_comp_of_integrable ((hG i).comp_fst ν)
    exact h
  have hfI : Integrable f ν := by rw [hν]; exact hf.continuous.integrableOn_Icc
  have hpair : Integrable (fun p ↦ ‖f p.1 - f p.2‖) (ν.prod ν) :=
    ((hfI.comp_fst ν).sub (hfI.comp_snd ν)).norm
  have hmem : ∀ᵐ p ∂ν.prod ν, p.1 ∈ Q ∧ p.2 ∈ Q := by
    rw [hν, Measure.prod_restrict]
    exact ae_restrict_mem (measurableSet_Icc.prod measurableSet_Icc)
  have hosc : (∫ p, ‖f p.1 - f p.2‖ ∂ν.prod ν) ≤
      ∫ p, ∑ i : Fin (n + 1), G i (bridge p.1 p.2 i) ∂ν.prod ν := by
    apply integral_mono_ae hpair (integrable_finset_sum _ (fun i _ ↦ hGb i))
    filter_upwards [hmem] with p hp
    exact box_pointwise_oscillation f hf a b p.1 p.2
      (fun i ↦ ⟨hp.1.1 i, hp.1.2 i⟩) (fun i ↦ ⟨hp.2.1 i, hp.2.2 i⟩)
  have he : (∫ p, ∑ i : Fin (n + 1), G i (bridge p.1 p.2 i) ∂ν.prod ν) =
      (∏ i, (b i - a i)) * ∑ i : Fin (n + 1), (b i - a i) * ∫ x, g i x ∂ν := by
    rw [integral_finset_sum _ (fun i _ ↦ hGb i)]
    have hi (i : Fin (n + 1)) : (∫ p, G i (bridge p.1 p.2 i) ∂ν.prod ν) =
        ν.real univ * ((μ i).real univ * ∫ x, g i x ∂ν) := by
      calc
        _ = ν.real univ * ∫ x, G i x ∂ν := integral_bridge μ i (G i)
        _ = _ := by
          congr 1
          exact integral_update_average μ i (g i) (hg i)
    simp_rw [hi, hμmass, hνmass]
    rw [← Finset.mul_sum]
  change (∫ p, ‖f p.1 - f p.2‖ ∂((volume.restrict Q).prod (volume.restrict Q))) ≤ _
  rw [← hν]
  exact hosc.trans_eq he

/-- The coordinate-ball version, with side length twice the radius. -/
theorem cube_poincare {n : ℕ} (f : (Fin (n + 1) → ℝ) → ℝ) (hf : ContDiff ℝ 1 f)
    (c : Fin (n + 1) → ℝ) (r : ℝ) (hr : 0 ≤ r) :
    (∫ p, ‖f p.1 - f p.2‖ ∂((volume.restrict (Metric.closedBall c r)).prod
      (volume.restrict (Metric.closedBall c r)))) ≤
      (2 * r) ^ (n + 2) * ∑ i : Fin (n + 1),
        ∫ x in Metric.closedBall c r, ‖fderiv ℝ f x (Pi.single i 1)‖ := by
  have hQ : Metric.closedBall c r = Icc (fun i ↦ c i - r) (fun i ↦ c i + r) := by
    rw [closedBall_pi c hr]
    simp_rw [Real.closedBall_eq_Icc]
    rw [pi_univ_Icc]
  have h := box_poincare f hf (fun i ↦ c i - r) (fun i ↦ c i + r) (fun i ↦ by linarith)
  dsimp only at h
  simp_rw [show ∀ i, c i + r - (c i - r) = 2 * r from fun i ↦ by ring] at h
  rw [← hQ] at h
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h
  rw [← Finset.mul_sum] at h
  refine h.trans_eq ?_
  rw [← mul_assoc, ← pow_succ]

end
end Source29CubePoincare

/- Component: PairOscillation.inc -/
namespace Source29PairOscillation

open MeasureTheory Filter
open scoped Topology

noncomputable section

variable {α : Type*} [MeasurableSpace α] (μ : Measure α) [IsFiniteMeasure μ]

/-- Pairwise oscillation integrals converge under bounded ae convergence. -/
theorem oscillation_tendsto (u : ℕ → α → ℝ) (v : α → ℝ)
    (hu : ∀ k, AEStronglyMeasurable (u k) μ)
    (hb : ∀ k x, ‖u k x‖ ≤ 1)
    (hl : ∀ᵐ x ∂μ, Tendsto (fun k ↦ u k x) atTop (𝓝 (v x))) :
    Tendsto (fun k ↦ ∫ p, ‖u k p.1 - u k p.2‖ ∂μ.prod μ) atTop
      (𝓝 (∫ p, ‖v p.1 - v p.2‖ ∂μ.prod μ)) := by
  apply tendsto_integral_of_dominated_convergence (fun _ ↦ (2 : ℝ))
  · intro k
    exact ((hu k).comp_fst.sub (hu k).comp_snd).norm
  · exact integrable_const 2
  · intro k
    exact Filter.Eventually.of_forall fun p ↦ (by
      rw [norm_norm]
      exact (norm_sub_le _ _).trans (by linarith [hb k p.1, hb k p.2]))
  · have hleft : ∀ᵐ p ∂μ.prod μ, Tendsto (fun k ↦ u k p.1) atTop (𝓝 (v p.1)) :=
      Measure.quasiMeasurePreserving_fst.tendsto_ae.eventually hl
    have hright : ∀ᵐ p ∂μ.prod μ, Tendsto (fun k ↦ u k p.2) atTop (𝓝 (v p.2)) :=
      Measure.quasiMeasurePreserving_snd.tendsto_ae.eventually hl
    filter_upwards [hleft, hright] with p hp hq
    exact (hp.sub hq).norm

/-- For an indicator, pairwise oscillation is twice the product of the two
complementary volumes. -/
theorem indicator_oscillation (A : Set α) (hA : MeasurableSet A) :
    (∫ p, ‖(A.indicator (fun _ ↦ (1 : ℝ))) p.1 - (A.indicator (fun _ ↦ (1 : ℝ))) p.2‖ ∂μ.prod μ) =
      2 * μ.real A * μ.real Aᶜ := by
  classical
  let f := A.indicator (fun _ ↦ (1 : ℝ))
  let g := Aᶜ.indicator (fun _ ↦ (1 : ℝ))
  have hf : Integrable f μ := (integrable_const 1).indicator hA
  have hg : Integrable g μ := (integrable_const 1).indicator hA.compl
  have he (p : α × α) : ‖f p.1 - f p.2‖ = f p.1 * g p.2 + g p.1 * f p.2 := by
    dsimp [f, g]
    by_cases hx : p.1 ∈ A <;> by_cases hy : p.2 ∈ A <;> simp [hx, hy]
  change (∫ p, ‖f p.1 - f p.2‖ ∂μ.prod μ) = _
  simp_rw [he]
  rw [integral_add (hf.mul_prod hg) (hg.mul_prod hf), integral_prod_mul, integral_prod_mul]
  have hfi : (∫ x, f x ∂μ) = μ.real A := by simp [f, integral_indicator_const, hA]
  have hgi : (∫ x, g x ∂μ) = μ.real Aᶜ := by simp [g, integral_indicator_const, hA.compl]
  rw [hfi, hgi]
  ring

end
end Source29PairOscillation

/- Component: PhasePoincare.inc -/
namespace Source29PhasePoincare

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29WeakCalibrationLimits Source29NonlinearCalibration
open Source29SmoothPhaseTransition Source29SmoothCalibrationRecovery Source29PhaseMassLimit
open Source29CubePoincare Source29PairOscillation
open scoped Topology BigOperators

noncomputable section

variable {n : ℕ}

theorem transition_fderiv (P : MvPolynomial (Fin n) ℝ) (k : ℕ) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ transition k (eval y P)) x (Pi.single i 1) =
      deriv (transition k) (eval x P) * evaluatedGradient P x i := by
  simpa using composed_product_fderiv P (ρ := fun _ ↦ 1) contDiff_const (transition_contDiff k) x i

/-- The total coordinate gradient on a compact set is bounded by the smooth
calibrated mass against a cutoff equal to one there. -/
theorem transition_gradient_sum_le_mass (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (Q : Set (Fin n → ℝ)) (hQ : IsCompact Q)
    {η : (Fin n → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Q, η x = 1) (k : ℕ) :
    (∑ i : Fin n, ∫ x in Q, ‖fderiv ℝ (fun y ↦ transition k (eval y P)) x (Pi.single i 1)‖) ≤
      n * (∫ x, η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) := by
  have hu : ContDiff ℝ 1 (fun y ↦ transition k (eval y P)) := (transition_contDiff k).comp (contDiff_eval P)
  have hm := (localized_gradient_mass_identity P hcal hη hcη (transition_contDiff k)
    (transition_norm_le_one k)).1
  have hn (x : Fin n → ℝ) : 0 ≤ η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) :=
    mul_nonneg (mul_nonneg (hηpos x) (transition_deriv_nonneg k _)) (Real.sqrt_nonneg _)
  have hi (i : Fin n) :
      (∫ x in Q, ‖fderiv ℝ (fun y ↦ transition k (eval y P)) x (Pi.single i 1)‖) ≤
        ∫ x, η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) := by
    calc
      _ ≤ ∫ x in Q, η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) := by
        apply setIntegral_mono_on
          (((hu.continuous_fderiv (by norm_num)).clm_apply continuous_const).norm.continuousOn.integrableOn_compact hQ)
          hm.integrableOn hQ.measurableSet
        intro x hx
        rw [transition_fderiv, hηone x hx, one_mul, norm_mul, Real.norm_eq_abs,
          abs_of_nonneg (transition_deriv_nonneg k _)]
        exact mul_le_mul_of_nonneg_left (coordinate_norm_le_variationDensity (evaluatedGradient P x) i)
          (transition_deriv_nonneg k _)
      _ ≤ _ := setIntegral_le_integral hm (Filter.Eventually.of_forall hn)
  calc
    _ ≤ ∑ _i : Fin n, ∫ x, η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) :=
      Finset.sum_le_sum (fun i _ ↦ hi i)
    _ = _ := by simp

/-- Pairwise phase oscillation is controlled by calibrated mass on a larger
cutoff. This is the relative estimate needed for a lower perimeter bound. -/
theorem phase_pair_volume_le_mass (P : MvPolynomial (Fin 8) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) (c : Fin 8 → ℝ) (r : ℝ) (hr : 0 ≤ r)
    {η : (Fin 8 → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Metric.closedBall c r, η x = 1) :
    let μ := volume.restrict (Metric.closedBall c r)
    let A := {x | 0 < eval x P}
    2 * μ.real A * μ.real Aᶜ ≤ (2 * r) ^ 9 * 8 * phaseMass P η := by
  classical
  let μ := volume.restrict (Metric.closedBall c r)
  let A := {x | 0 < eval x P}
  letI : IsFiniteMeasure μ := ⟨by
    dsimp [μ]
    rw [Measure.restrict_apply_univ]
    exact (isCompact_closedBall c r).measure_lt_top⟩
  have hA : MeasurableSet A := (isOpen_lt continuous_const (contDiff_eval P).continuous).measurableSet
  have hl := oscillation_tendsto μ (fun k x ↦ transition k (eval x P)) (A.indicator (fun _ ↦ (1 : ℝ)))
    (fun k ↦ ((transition_contDiff k).continuous.comp (contDiff_eval P).continuous).aestronglyMeasurable)
    (fun k x ↦ transition_norm_le_one k _) (by
      simpa only [A, Set.indicator, Set.mem_setOf_eq] using
        (ae_restrict_of_ae (polynomial_transition_tendsto_ae P hP) :
          ∀ᵐ x ∂μ, Tendsto (fun k ↦ transition k (eval x P)) atTop (𝓝 (if 0 < eval x P then 1 else 0))))
  rw [indicator_oscillation μ A hA] at hl
  apply le_of_tendsto_of_tendsto hl ((phaseMass_tendsto P hP hcal hη hcη).const_mul ((2 * r) ^ 9 * 8))
  apply Filter.Eventually.of_forall
  intro k
  have hp := cube_poincare (n := 7) (fun x ↦ transition k (eval x P))
    ((transition_contDiff k).comp (contDiff_eval P)) c r hr
  have hg := transition_gradient_sum_le_mass P hcal (Metric.closedBall c r) (isCompact_closedBall c r)
    hη hcη hηpos hηone k
  calc
    _ ≤ (2 * r) ^ 9 * _ := hp
    _ ≤ (2 * r) ^ 9 * (8 * (∫ x, η x * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x))) :=
      mul_le_mul_of_nonneg_left hg (by positivity)
    _ = _ := by ring

end
end Source29PhasePoincare

/- Component: PerimeterBallLower.inc -/
namespace Source29PerimeterBallLower

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.FluxObstruction
open Source29WeakCalibrationLimits Source29PhaseMassLimit Source29PhasePoincare
open Source29LocalPhasePerimeter Source29LocalPerimeterMass Source29TopPhasePerimeter
open Source29TopPhaseDensity Source29PhaseVolumeDensity
open scoped Topology ENNReal

noncomputable section

/-- The relative oscillation estimate in terms of the two strict phase volumes. -/
theorem phase_volume_product_le_mass (P : MvPolynomial (Fin 8) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P)) (c : Fin 8 → ℝ) (r : ℝ) (hr : 0 ≤ r)
    {η : (Fin 8 → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Metric.closedBall c r, η x = 1) :
    2 * ballVolume {x | 0 < eval x P} c r * ballVolume {x | eval x P < 0} c r ≤
      (2 * r) ^ 9 * 8 * phaseMass P η := by
  have h := phase_pair_volume_le_mass P hP hcal c r hr hη hcη hηpos hηone
  have hA : MeasurableSet {x | 0 < eval x P} :=
    (isOpen_lt continuous_const (contDiff_eval P).continuous).measurableSet
  dsimp only at h
  rw [measureReal_restrict_apply hA, measureReal_restrict_apply hA.compl] at h
  have hneg : ballVolume {x | eval x P < 0} c r ≤
      ballVolume {x | 0 < eval x P}ᶜ c r := by
    apply ballVolume_mono
    intro x hx
    refine ⟨hx.1, ?_⟩
    exact not_lt_of_ge (show eval x P < 0 from hx.2).le
  rw [Set.inter_comm {x | 0 < eval x P}, Set.inter_comm {x | 0 < eval x P}ᶜ] at h
  change 2 * ballVolume _ c r * ballVolume _ c r ≤ _ at h
  exact (mul_le_mul_of_nonneg_left hneg
    (mul_nonneg (by norm_num) (ballVolume_nonneg _ c r))).trans h

/-- A numerical cancellation for the eight-dimensional relative estimate. -/
theorem mass_lower_of_density {d r v w m : ℝ} (hd : 0 < d) (hr : 0 < r)
    (hv : d * r ^ 8 ≤ v) (hw : d * r ^ 8 ≤ w)
    (hm : 2 * v * w ≤ (2 * r) ^ 9 * 8 * m) :
    d ^ 2 / 2048 * r ^ 7 ≤ m := by
  have hp : 0 ≤ d * r ^ 8 := by positivity
  have hh : (d * r ^ 8) * (d * r ^ 8) ≤ v * w :=
    mul_le_mul hv hw hp (hp.trans hv)
  have h : (4096 * r ^ 9) * (d ^ 2 / 2048 * r ^ 7) ≤ (4096 * r ^ 9) * m := by
    calc
      _ = 2 * ((d * r ^ 8) * (d * r ^ 8)) := by ring
      _ ≤ 2 * (v * w) := mul_le_mul_of_nonneg_left hh (by norm_num)
      _ ≤ _ := by nlinarith [hm]
  exact (mul_le_mul_iff_right₀ (by positivity : 0 < 4096 * r ^ 9)).mp h

/-- Uniform lower growth of the leading phase perimeter, at every leading zero. -/
theorem top_positive_perimeter_ball_lower :
    ∃ a : ℝ, 0 < a ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ), eval c (homogeneousComponent P.totalDegree P) = 0 →
      ∀ (R : ℝ), 0 < R →
      ENNReal.ofReal (a * R ^ 7) ≤
        localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} (Metric.ball c R) := by
  obtain ⟨d, hd, hdensity⟩ := top_two_sided_density
  refine ⟨d ^ 2 / 262144, by positivity, ?_⟩
  intro P hmin hdeg c hc R hR
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hcal := top_weakCalibration P hmin hdeg
  obtain ⟨η, hη, hcη, hηs, hηb, hηone, _⟩ :=
    exists_local_cutoff (Metric.closedBall c (R / 2)) (Metric.ball c R)
      (isCompact_closedBall c (R / 2)) Metric.isOpen_ball
      (Metric.closedBall_subset_ball (by linarith))
  obtain ⟨hv, hw⟩ := hdensity P hmin hdeg c hc (R / 2) (by positivity)
  have hm := phase_volume_product_le_mass F hF hcal c (R / 2) (by positivity)
    hη hcη (fun x ↦ (hηb x).1) hηone
  have hl := mass_lower_of_density hd (show 0 < R / 2 by positivity) hv hw hm
  have hl' : d ^ 2 / 262144 * R ^ 7 ≤ phaseMass F η := by
    convert hl using 1 <;> ring
  rw [top_localPerimeter_eq_iSup_mass P hmin hdeg _ Metric.isOpen_ball]
  exact (ENNReal.ofReal_le_ofReal hl').trans
    (le_iSup_of_le η (le_iSup_of_le (show LocalWeight (Metric.ball c R) η from
      ⟨hη, hcη, hηs, hηb⟩) le_rfl))

/-- The same positive lower constant works for both strict leading phases. -/
theorem top_both_perimeters_ball_lower :
    ∃ a : ℝ, 0 < a ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ (c : Fin 8 → ℝ), eval c (homogeneousComponent P.totalDegree P) = 0 →
      ∀ (R : ℝ), 0 < R →
      ENNReal.ofReal (a * R ^ 7) ≤
        localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} (Metric.ball c R) ∧
      ENNReal.ofReal (a * R ^ 7) ≤
        localPerimeter {x | eval x (homogeneousComponent P.totalDegree P) < 0} (Metric.ball c R) := by
  obtain ⟨a, ha, h⟩ := top_positive_perimeter_ball_lower
  refine ⟨a, ha, ?_⟩
  intro P hmin hdeg c hc R hR
  refine ⟨h P hmin hdeg c hc R hR, ?_⟩
  have hm : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (-P) := by
    change minimalGraphOperator (-P) = 0
    rw [minimalGraphOperator_neg]
    exact neg_eq_zero.mpr hmin
  have hd : 2 ≤ (-P).totalDegree := by simpa only [totalDegree_neg] using hdeg
  have hc' : eval c (homogeneousComponent (-P).totalDegree (-P)) = 0 := by
    simp only [totalDegree_neg, map_neg, hc, neg_zero]
  simpa only [totalDegree_neg, map_neg, neg_pos] using h (-P) hm hd c hc' R hR

end
end Source29PerimeterBallLower

/- Component: PerimeterMeasureGrowth.inc -/
namespace Source29PerimeterMeasureGrowth

open MvPolynomial MeasureTheory Filter Metric
open Source29LocalPhasePerimeter Source29TopPerimeterExactSupport
open Source29PerimeterBallLower Source29PerimeterBallUpper
open scoped Topology ENNReal

noncomputable section

/-- Positive power upper growth rules out atoms, without any boundary regularity
assumption. -/
theorem singleton_eq_zero_of_ball_upper (μ : Measure (Fin 8 → ℝ)) (A : ℝ)
    (h : ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r → μ (ball c r) ≤ ENNReal.ofReal (A * r ^ 7))
    (c : Fin 8 → ℝ) : μ {c} = 0 := by
  have ht : Tendsto (fun r : ℝ ↦ ENNReal.ofReal (A * r ^ 7)) (𝓝[>] 0) (𝓝 0) := by
    have ht' : Tendsto (fun r : ℝ ↦ A * r ^ 7) (𝓝[>] 0) (𝓝 (A * (0 : ℝ) ^ 7)) :=
      ((continuous_const.mul (continuous_id.pow 7)).tendsto 0).mono_left nhdsWithin_le_nhds
    simpa [Function.comp_def] using ENNReal.continuous_ofReal.continuousAt.tendsto.comp ht'
  apply le_antisymm _ bot_le
  apply ge_of_tendsto ht
  filter_upwards [self_mem_nhdsWithin] with r hr
  exact (measure_mono (Set.singleton_subset_iff.mpr (mem_ball_self hr))).trans (h c r hr)

/-- The common perimeter measure has uniform order-seven growth, with a positive
lower bound at every point of its support. The constants work for all nonaffine
solutions of the full eight-variable minimal graph equation. -/
theorem top_perimeter_measure_growth :
    ∃ a A : ℝ, 0 < a ∧ 0 < A ∧ ∀ (P : MvPolynomial (Fin 8) ℝ),
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∃ μ : Measure (Fin 8 → ℝ), μ.Regular ∧
        (∀ U : Set (Fin 8 → ℝ), IsOpen U →
          μ U = localPerimeter {x | 0 < eval x (homogeneousComponent P.totalDegree P)} U ∧
          μ U = localPerimeter {x | eval x (homogeneousComponent P.totalDegree P) < 0} U) ∧
        μ {x | eval x (homogeneousComponent P.totalDegree P) ≠ 0} = 0 ∧
        measureSupport μ = {x | eval x (homogeneousComponent P.totalDegree P) = 0} ∧
        (∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r → μ (ball c r) ≤ ENNReal.ofReal (A * r ^ 7)) ∧
        (∀ c ∈ measureSupport μ, ∀ r : ℝ, 0 < r → ENNReal.ofReal (a * r ^ 7) ≤ μ (ball c r)) ∧
        (∀ c : Fin 8 → ℝ, μ {c} = 0) := by
  obtain ⟨a, ha, hl⟩ := top_positive_perimeter_ball_lower
  obtain ⟨A, hA, hu⟩ := top_positive_perimeter_ball_upper
  refine ⟨a, A, ha, hA, ?_⟩
  intro P hmin hdeg
  obtain ⟨μ, hreg, hμ, hz, hs⟩ := top_phases_exact_support P hmin hdeg
  have hupper : ∀ (c : Fin 8 → ℝ) (r : ℝ), 0 < r → μ (ball c r) ≤ ENNReal.ofReal (A * r ^ 7) := by
    intro c r hr
    rw [(hμ _ isOpen_ball).1]
    exact hu P hmin hdeg c r hr
  refine ⟨μ, hreg, hμ, hz, hs, hupper, ?_, singleton_eq_zero_of_ball_upper μ A hupper⟩
  intro c hc r hr
  rw [(hμ _ isOpen_ball).1]
  apply hl P hmin hdeg c _ r hr
  rwa [hs] at hc

end
end Source29PerimeterMeasureGrowth

/- Component: RegularizedGradientNorm.inc -/
namespace Source29RegularizedGradientNorm

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.FluxObstruction Source29VariationConvexity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def density (ε : ℝ) (a : Fin n → ℝ) : ℝ := Real.sqrt (ε ^ 2 + ∑ i, a i ^ 2)
def field (ε : ℝ) (a : Fin n → ℝ) (i : Fin n) : ℝ := a i / density ε a

theorem density_pos (ε : ℝ) (hε : 0 < ε) (a : Fin n → ℝ) : 0 < density ε a := by
  apply Real.sqrt_pos.mpr
  exact add_pos_of_pos_of_nonneg (sq_pos_of_pos hε) (Finset.sum_nonneg (fun i _ ↦ sq_nonneg _))

theorem density_bounds (ε : ℝ) (hε : 0 ≤ ε) (a : Fin n → ℝ) :
    variationDensity a ≤ density ε a ∧ density ε a ≤ ε + variationDensity a := by
  have hnon : 0 ≤ ∑ i, a i ^ 2 := Finset.sum_nonneg (fun i _ ↦ sq_nonneg _)
  have hs := Real.sq_sqrt (add_nonneg (sq_nonneg ε) hnon)
  have hv := variationDensity_sq a
  have hdn : 0 ≤ density ε a := Real.sqrt_nonneg _
  have hvn : 0 ≤ variationDensity a := Real.sqrt_nonneg _
  change density ε a ^ 2 = _ at hs
  constructor <;> nlinarith

theorem field_bound (ε : ℝ) (hε : 0 < ε) (a : Fin n → ℝ) (i : Fin n) :
    ‖field ε a i‖ ≤ 1 := by
  rw [field, norm_div, Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_pos (density_pos ε hε a)]
  apply (div_le_one (density_pos ε hε a)).mpr
  exact (Source29SmoothCalibrationRecovery.coordinate_norm_le_variationDensity a i).trans
    (density_bounds ε hε.le a).1

theorem density_contDiff (ε : ℝ) (hε : 0 < ε) (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) :
    ContDiff ℝ 1 (fun x ↦ density ε (g x)) := by
  apply (contDiff_const.add (ContDiff.sum (fun i _ ↦ (hg i).pow 2))).sqrt
  intro x
  exact (add_pos_of_pos_of_nonneg (sq_pos_of_pos hε)
    (Finset.sum_nonneg (fun i _ ↦ sq_nonneg (g x i)))).ne'

theorem field_contDiff (ε : ℝ) (hε : 0 < ε) (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) (i : Fin n) :
    ContDiff ℝ 1 (fun x ↦ field ε (g x) i) :=
  (hg i).div (density_contDiff ε hε g hg) (fun x ↦ (density_pos ε hε (g x)).ne')

theorem density_fderiv (ε : ℝ) (hε : 0 < ε) (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) (x v : Fin n → ℝ) :
    fderiv ℝ (fun y ↦ density ε (g y)) x v =
      ∑ i, field ε (g x) i * fderiv ℝ (fun y ↦ g y i) x v := by
  have hn : 0 < ε ^ 2 + ∑ i, g x i ^ 2 :=
    add_pos_of_pos_of_nonneg (sq_pos_of_pos hε) (Finset.sum_nonneg (fun i _ ↦ sq_nonneg _))
  have hd : HasFDerivAt (fun y ↦ ε ^ 2 + ∑ i, g y i ^ 2)
      (∑ i, (2 * g x i) • fderiv ℝ (fun y ↦ g y i) x) x := by
    have hs : HasFDerivAt (fun y ↦ ∑ i, g y i ^ 2)
        (∑ i, (2 * g x i) • fderiv ℝ (fun y ↦ g y i) x) x := by
      apply HasFDerivAt.fun_sum
      intro i _
      convert ((hg i).differentiable (by norm_num) x).hasFDerivAt.pow 2 using 1 <;> simp
    exact hs.const_add (ε ^ 2)
  have he := congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L v)
    ((Real.hasDerivAt_sqrt hn.ne').comp_hasFDerivAt x hd).fderiv
  change _ = _ at he
  rw [show fderiv ℝ (fun y ↦ density ε (g y)) x v =
    (1 / (2 * density ε (g x))) * ∑ i, (2 * g x i) * fderiv ℝ (fun y ↦ g y i) x v by
      simpa only [density, Function.comp_def, _root_.smul_apply, smul_eq_mul,
        ContinuousLinearMap.sum_apply] using he]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  dsimp only [field]
  ring

def parameter (k : ℕ) : ℝ := (dilationRadius k)⁻¹

theorem parameter_pos (k : ℕ) : 0 < parameter k := inv_pos.mpr (dilationRadius_pos k)
theorem parameter_le_one (k : ℕ) : parameter k ≤ 1 := by
  apply inv_le_one_of_one_le₀
  simp only [dilationRadius, Nat.cast_add, Nat.cast_one]
  linarith [Nat.cast_nonneg (α := ℝ) k]

theorem parameter_tendsto : Tendsto parameter atTop (𝓝 0) :=
  tendsto_inv_atTop_zero.comp dilationRadius_tendsto

theorem density_tendsto (a : Fin n → ℝ) :
    Tendsto (fun k ↦ density (parameter k) a) atTop (𝓝 (variationDensity a)) := by
  have h := (parameter_tendsto.pow 2).add_const (∑ i, a i ^ 2)
  simpa only [zero_pow (by decide : 2 ≠ 0), zero_add, density, variationDensity, Function.comp_def] using
    Real.continuous_sqrt.continuousAt.tendsto.comp h

theorem field_tendsto (a : Fin n → ℝ) (i : Fin n) :
    Tendsto (fun k ↦ field (parameter k) a i) atTop (𝓝 (a i / variationDensity a)) := by
  by_cases ha : a = 0
  · subst a
    simpa only [field, Pi.zero_apply, zero_div] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0 : ℝ)) atTop (𝓝 0))
  · exact tendsto_const_nhds.div (density_tendsto a) (variationDensity_pos ha).ne'

end
end Source29RegularizedGradientNorm

/- Component: GradientNormWeakDerivative.inc -/
namespace Source29GradientNormWeakDerivative

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29VariationConvexity
open Source29RegularizedGradientNorm
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem norm_pair_le (a b : Fin n → ℝ) (ha : ∀ i, ‖a i‖ ≤ 1) :
    ‖∑ i, a i * b i‖ ≤ ∑ i, ‖b i‖ := by
  apply (norm_sum_le _ _).trans
  apply Finset.sum_le_sum
  intro i _
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (ha i)

theorem weighted_density_tendsto (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    {ψ : (Fin n → ℝ) → ℝ} (hψ : Continuous ψ) (hcψ : HasCompactSupport ψ) :
    Tendsto (fun k ↦ ∫ x, ψ x * density (parameter k) (g x)) atTop
      (𝓝 (∫ x, ψ x * variationDensity (g x))) := by
  have hv := variationDensity_continuous g (fun i ↦ (hg i).continuous)
  apply tendsto_integral_of_dominated_convergence
    (fun x ↦ ‖ψ x‖ * (1 + variationDensity (g x)))
  · intro k
    exact (hψ.mul (density_contDiff _ (parameter_pos k) g hg).continuous).aestronglyMeasurable
  · exact (hψ.norm.mul (continuous_const.add hv)).integrable_of_hasCompactSupport hcψ.norm.mul_right
  · intro k
    apply Filter.Eventually.of_forall
    intro x
    rw [norm_mul, Real.norm_eq_abs (density _ _), abs_of_pos (density_pos _ (parameter_pos k) _)]
    exact mul_le_mul_of_nonneg_left
      ((density_bounds _ (parameter_pos k).le _).2.trans
        (add_le_add (parameter_le_one k) le_rfl)) (norm_nonneg _)
  · exact Filter.Eventually.of_forall fun x ↦ tendsto_const_nhds.mul (density_tendsto (g x))

/-- Bounded regularized normal fields may be passed through compact weighted
integrals, even where the limiting gradient vanishes. -/
theorem weighted_pair_tendsto (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (b : (Fin n → ℝ) → Fin n → ℝ) (hb : ∀ i, Continuous (fun x ↦ b x i))
    {ψ : (Fin n → ℝ) → ℝ} (hψ : Continuous ψ) (hcψ : HasCompactSupport ψ) :
    Integrable (fun x ↦ ψ x * ∑ i, (g x i / variationDensity (g x)) * b x i) ∧
    Tendsto (fun k ↦ ∫ x, ψ x * ∑ i, field (parameter k) (g x) i * b x i) atTop
      (𝓝 (∫ x, ψ x * ∑ i, (g x i / variationDensity (g x)) * b x i)) := by
  let f : ℕ → (Fin n → ℝ) → ℝ := fun k x ↦ ψ x * ∑ i, field (parameter k) (g x) i * b x i
  let f0 : (Fin n → ℝ) → ℝ := fun x ↦ ψ x * ∑ i, (g x i / variationDensity (g x)) * b x i
  let B : (Fin n → ℝ) → ℝ := fun x ↦ ‖ψ x‖ * ∑ i, ‖b x i‖
  have hm (k : ℕ) : AEStronglyMeasurable (f k) :=
    (hψ.mul (continuous_finsetSum _ (fun i _ ↦
      ((field_contDiff _ (parameter_pos k) g hg i).continuous).mul (hb i)))).aestronglyMeasurable
  have hB : Integrable B :=
    (hψ.norm.mul (continuous_finsetSum _ (fun i _ ↦ (hb i).norm))).integrable_of_hasCompactSupport
      hcψ.norm.mul_right
  have hf (k : ℕ) (x : Fin n → ℝ) : ‖f k x‖ ≤ B x := by
    dsimp only [f, B]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_pair_le _ _ (field_bound _ (parameter_pos k) _)) (norm_nonneg _)
  have ht (x : Fin n → ℝ) : Tendsto (fun k ↦ f k x) atTop (𝓝 (f0 x)) := by
    apply tendsto_const_nhds.mul
    apply tendsto_finsetSum
    intro i _
    exact (field_tendsto (g x) i).mul_const (b x i)
  have hi : Integrable f0 := hB.mono'
    (aestronglyMeasurable_of_tendsto_ae atTop hm (Filter.Eventually.of_forall ht))
    (Filter.Eventually.of_forall fun x ↦ le_of_tendsto (ht x).norm (Filter.Eventually.of_forall fun k ↦ hf k x))
  refine ⟨hi, ?_⟩
  exact tendsto_integral_of_dominated_convergence B hm hB
    (fun k ↦ Filter.Eventually.of_forall (hf k)) (Filter.Eventually.of_forall ht)

/-- Weak differentiation of the Euclidean norm of a C1 vector field. The
normal vector is assigned zero at zeros of the field. -/
theorem norm_integration_by_parts (g : (Fin n → ℝ) → Fin n → ℝ)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ)
    (v : Fin n → ℝ) :
    Integrable (fun x ↦ φ x * ∑ i, (g x i / variationDensity (g x)) *
      fderiv ℝ (fun y ↦ g y i) x v) ∧
    (∫ x, φ x * ∑ i, (g x i / variationDensity (g x)) * fderiv ℝ (fun y ↦ g y i) x v) =
      -(∫ x, fderiv ℝ φ x v * variationDensity (g x)) := by
  have hd (i : Fin n) : Continuous (fun x ↦ fderiv ℝ (fun y ↦ g y i) x v) :=
    ((hg i).continuous_fderiv (by norm_num)).clm_apply continuous_const
  obtain ⟨hi, ht⟩ := weighted_pair_tendsto g hg
    (fun x i ↦ fderiv ℝ (fun y ↦ g y i) x v) hd hφ.continuous hcφ
  refine ⟨hi, ?_⟩
  have ht' := weighted_density_tendsto g hg
    ((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const) (hcφ.fderiv_apply ℝ v)
  have he (k : ℕ) :
      (∫ x, φ x * ∑ i, field (parameter k) (g x) i * fderiv ℝ (fun y ↦ g y i) x v) =
      -(∫ x, fderiv ℝ φ x v * density (parameter k) (g x)) := by
    simp_rw [← density_fderiv _ (parameter_pos k) g hg]
    exact integral_mul_fderiv_eq_neg_of_compactSupport hφ hcφ
      (density_contDiff _ (parameter_pos k) g hg) v
  have he' : (fun k ↦ ∫ x, φ x * ∑ i, field (parameter k) (g x) i * fderiv ℝ (fun y ↦ g y i) x v) =
      (fun k ↦ -(∫ x, fderiv ℝ φ x v * density (parameter k) (g x))) := funext he
  rw [he'] at ht
  exact tendsto_nhds_unique ht ht'.neg

end
end Source29GradientNormWeakDerivative

/- Component: PolynomialStress.inc -/
namespace Source29PolynomialStress

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29VariationConvexity Source29WeakCalibrationLimits Source29GradientNormWeakDerivative
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem gradient_fderiv_symm (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i j : Fin n) :
    fderiv ℝ (fun y ↦ evaluatedGradient P y i) x (Pi.single j 1) =
      fderiv ℝ (fun y ↦ evaluatedGradient P y j) x (Pi.single i 1) := by
  simp only [evaluatedGradient, fderiv_eval, evalFDeriv_basis]
  rw [second_partial_comm]

/-- The product test isolates one column of the stress tensor. -/
theorem gradient_product_flux (P : MvPolynomial (Fin n) ℝ)
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (j : Fin n) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ φ y * evaluatedGradient P y j) (leadingNormalizedField P) x =
      evaluatedGradient P x j * testFlux (fun i ↦ Pi.single i 1) φ (leadingNormalizedField P) x +
      φ x * ∑ i, leadingNormalizedField P x i * fderiv ℝ (fun y ↦ evaluatedGradient P y i) x (Pi.single j 1) := by
  have hg : ContDiff ℝ 1 (fun y ↦ evaluatedGradient P y j) := contDiff_eval (pderiv j P)
  have hd (i : Fin n) : fderiv ℝ (fun y ↦ φ y * evaluatedGradient P y j) x (Pi.single i 1) =
      evaluatedGradient P x j * fderiv ℝ φ x (Pi.single i 1) +
      φ x * fderiv ℝ (fun y ↦ evaluatedGradient P y j) x (Pi.single i 1) := by
    have hh := ((hφ.differentiable (by norm_num) x).hasFDerivAt).fun_mul
      ((hg.differentiable (by norm_num) x).hasFDerivAt)
    simpa only [add_apply, _root_.smul_apply, smul_eq_mul, add_comm] using
      congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) hh.fderiv
  simp only [testFlux, hd, add_mul, Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    ring
  · apply Finset.sum_congr rfl
    intro i _
    rw [gradient_fderiv_symm P x j i]
    ring

def stressColumn (P : MvPolynomial (Fin n) ℝ) (φ : (Fin n → ℝ) → ℝ)
    (j : Fin n) (x : Fin n → ℝ) : ℝ :=
  variationDensity (evaluatedGradient P x) * fderiv ℝ φ x (Pi.single j 1) -
    evaluatedGradient P x j * testFlux (fun i ↦ Pi.single i 1) φ (leadingNormalizedField P) x

/-- A weak unit-gradient calibration forces the polynomial stress tensor to
have zero distributional divergence, including across its critical set. -/
theorem stress_column_integral_zero (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ) (hcφ : HasCompactSupport φ) (j : Fin n) :
    Integrable (stressColumn P φ j) ∧ (∫ x, stressColumn P φ j x) = 0 := by
  have hg (i : Fin n) : ContDiff ℝ 1 (fun x ↦ evaluatedGradient P x i) := contDiff_eval (pderiv i P)
  obtain ⟨hi, he⟩ := norm_integration_by_parts (evaluatedGradient P) hg hφ hcφ (Pi.single j 1)
  change Integrable (fun x ↦ φ x * ∑ i, leadingNormalizedField P x i *
    fderiv ℝ (fun y ↦ evaluatedGradient P y i) x (Pi.single j 1)) at hi
  change (∫ x, φ x * ∑ i, leadingNormalizedField P x i *
    fderiv ℝ (fun y ↦ evaluatedGradient P y i) x (Pi.single j 1)) = _ at he
  obtain ⟨hp, hz⟩ := hcal.2 (fun y ↦ φ y * evaluatedGradient P y j) (hφ.mul (hg j)) hcφ.mul_right
  change Integrable (fun x ↦ testFlux (fun i ↦ Pi.single i 1)
    (fun y ↦ φ y * evaluatedGradient P y j) (leadingNormalizedField P) x) at hp
  simp_rw [gradient_product_flux P hφ j] at hp hz
  have hq : Integrable (fun x ↦ evaluatedGradient P x j *
      testFlux (fun i ↦ Pi.single i 1) φ (leadingNormalizedField P) x) := by
    simpa only [Pi.sub_def, add_sub_cancel_right] using hp.sub hi
  have hl : Integrable (fun x ↦ variationDensity (evaluatedGradient P x) * fderiv ℝ φ x (Pi.single j 1)) :=
    ((variationDensity_continuous _ (fun i ↦ (hg i).continuous)).mul
      ((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const)).integrable_of_hasCompactSupport
        (hcφ.fderiv_apply ℝ (Pi.single j 1)).mul_left
  refine ⟨hl.sub hq, ?_⟩
  rw [integral_add hq hi] at hz
  change (∫ x, variationDensity (evaluatedGradient P x) * fderiv ℝ φ x (Pi.single j 1) -
    evaluatedGradient P x j * testFlux (fun i ↦ Pi.single i 1) φ (leadingNormalizedField P) x) = 0
  rw [integral_sub hl hq]
  have he' : (∫ x, fderiv ℝ φ x (Pi.single j 1) * variationDensity (evaluatedGradient P x)) =
      (∫ x, variationDensity (evaluatedGradient P x) * fderiv ℝ φ x (Pi.single j 1)) := by
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x ↦ mul_comm _ _
  rw [he'] at he
  linarith

/-- The first-variation integrand for the diffuse level-set area measure. -/
def stressPair (P : MvPolynomial (Fin n) ℝ) (X : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) : ℝ := ∑ j, stressColumn P (fun y ↦ X y j) j x

theorem stress_integral_zero (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j)) :
    Integrable (stressPair P X) ∧ (∫ x, stressPair P X x) = 0 := by
  have h (j : Fin n) := stress_column_integral_zero P hcal (hX j) (hcX j) j
  refine ⟨integrable_finsetSum _ (fun j _ ↦ (h j).1), ?_⟩
  change (∫ x, ∑ j, stressColumn P (fun y ↦ X y j) j x) = 0
  rw [integral_finsetSum _ (fun j _ ↦ (h j).1)]
  simp only [(h _).2, Finset.sum_const_zero]

/-- Tangential divergence along the normalized polynomial gradient. -/
def tangentialDivergence (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  divergence (fun i ↦ Pi.single i 1) X x -
    ∑ j, ∑ i, leadingNormalizedField P x i * leadingNormalizedField P x j *
      fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)

theorem norm_mul_normal (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i : Fin n) :
    variationDensity (evaluatedGradient P x) * leadingNormalizedField P x i = evaluatedGradient P x i := by
  by_cases hz : evaluatedGradient P x = 0
  · simp only [leadingNormalizedField, hz, Pi.zero_apply, zero_div, mul_zero]
  · have hn := (variationDensity_pos hz).ne'
    change variationDensity (evaluatedGradient P x) *
      (evaluatedGradient P x i / variationDensity (evaluatedGradient P x)) = _
    field_simp

theorem stressPair_eq_tangentialDivergence (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    stressPair P X x = variationDensity (evaluatedGradient P x) * tangentialDivergence P X x := by
  have he (i j : Fin n) : variationDensity (evaluatedGradient P x) *
      (leadingNormalizedField P x i * leadingNormalizedField P x j *
        fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)) =
      evaluatedGradient P x j *
        (fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1) * leadingNormalizedField P x i) := by
    calc
      _ = (variationDensity (evaluatedGradient P x) * leadingNormalizedField P x j) *
          (fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1) * leadingNormalizedField P x i) := by ring
      _ = _ := by rw [norm_mul_normal]
  simp only [stressPair, stressColumn, tangentialDivergence, divergence, testFlux,
    Finset.sum_sub_distrib, mul_sub, Finset.mul_sum, he]

end
end Source29PolynomialStress

/- Component: LevelStressStationarity.inc -/
namespace Source29LevelStressStationarity

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29VariationConvexity Source29WeakCalibrationLimits Source29PolynomialStress
open Source29NonlinearCalibration Source29SmoothPhaseTransition Source29TopPhasePerimeter
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Multiplication by a function of the level leaves the stress pairing
unchanged apart from that scalar weight. The normal derivative cancels. -/
theorem stressColumn_level_mul (P : MvPolynomial (Fin n) ℝ)
    {φ : (Fin n → ℝ) → ℝ} (hφ : ContDiff ℝ 1 φ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (j : Fin n) (x : Fin n → ℝ) :
    stressColumn P (fun y ↦ φ y * h (eval y P)) j x =
      h (eval x P) * stressColumn P φ j x := by
  simp only [stressColumn, composed_product_fderiv P hφ hh,
    composed_product_flux P hφ hh]
  ring

theorem stressPair_level_mul (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (x : Fin n → ℝ) :
    stressPair P (fun y j ↦ X y j * h (eval y P)) x = h (eval x P) * stressPair P X x := by
  simp only [stressPair, stressColumn_level_mul P (hX _) hh, Finset.mul_sum]

/-- Each smooth level weight of a weakly calibrated polynomial is stationary
against compactly supported C1 vector fields. -/
theorem weighted_stress_integral_zero (P : MvPolynomial (Fin n) ℝ)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) :
    Integrable (fun x ↦ h (eval x P) * stressPair P X x) ∧
    (∫ x, h (eval x P) * stressPair P X x) = 0 := by
  have he : stressPair P (fun y j ↦ X y j * h (eval y P)) =
      (fun x ↦ h (eval x P) * stressPair P X x) :=
    funext (stressPair_level_mul P X hX hh)
  rw [← he]
  exact stress_integral_zero P hcal _
    (fun j ↦ (hX j).mul (hh.comp (contDiff_eval P))) (fun j ↦ (hcX j).mul_right)

theorem transition_deriv_contDiff (k : ℕ) : ContDiff ℝ 1 (deriv (transition k)) := by
  have hs : ContDiff ℝ 2 scalarField := by
    have he : scalarField = (fun t : ℝ ↦ t / Real.sqrt (1 + t ^ 2)) := funext scalarField_eq
    rw [he]
    apply contDiff_id.div ((contDiff_const.add (contDiff_id.pow 2)).sqrt _)
    · intro t
      positivity
    · intro t
      positivity
  have ht : ContDiff ℝ (1 + 1) (transition k) :=
    (contDiff_const.add (hs.comp (contDiff_const.mul contDiff_id))).div_const 2
  exact ht.deriv'

/-- The measures defined by smooth phase transitions satisfy the
full ambient first-variation identity, before any limit is taken. -/
theorem top_transition_stress_integral_zero (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j)) (k : ℕ) :
    Integrable (fun x ↦ deriv (transition k) (eval x (homogeneousComponent P.totalDegree P)) *
      stressPair (homogeneousComponent P.totalDegree P) X x) ∧
    (∫ x, deriv (transition k) (eval x (homogeneousComponent P.totalDegree P)) *
      stressPair (homogeneousComponent P.totalDegree P) X x) = 0 :=
  weighted_stress_integral_zero _ (top_weakCalibration P hmin hdeg) X hX hcX (transition_deriv_contDiff k)

/-- Stationarity written as the integral of tangential divergence against the
phase-transition measures whose masses converge to the leading phase perimeter. -/
theorem top_transition_tangential_integral_zero (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j)) (k : ℕ) :
    let F := homogeneousComponent P.totalDegree P
    Integrable (fun x ↦ deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x) *
      tangentialDivergence F X x) ∧
    (∫ x, deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x) *
      tangentialDivergence F X x) = 0 := by
  let F := homogeneousComponent P.totalDegree P
  have he : (fun x ↦ deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x) *
      tangentialDivergence F X x) = (fun x ↦ deriv (transition k) (eval x F) * stressPair F X x) := by
    funext x
    rw [stressPair_eq_tangentialDivergence]
    ring
  dsimp only
  change Integrable (fun x ↦ deriv (transition k) (eval x F) * variationDensity (evaluatedGradient F x) *
      tangentialDivergence F X x) ∧ _
  rw [he]
  exact top_transition_stress_integral_zero P hmin hdeg X hX hcX k

end
end Source29LevelStressStationarity

/- Component: StressBarrier.inc -/
namespace Source29StressBarrier

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29VariationConvexity Source29WeakCalibrationLimits Source29PolynomialStress
open Source29NonlinearCalibration Source29SmoothPhaseTransition Source29LevelStressStationarity
open Source29PhaseMassLimit Source29TopPhasePerimeter Source29TopPhaseDensity
open Source29PerimeterBallLower
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- A pointwise lower bound on tangential divergence forces the corresponding
phase mass to be nonpositive. This is a barrier-obstruction interface; it does
not assert the existence of any geometric barrier. -/
theorem phaseMass_nonpos_of_tangential_lower (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin n → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hlower : ∀ x, η x ≤ tangentialDivergence P X x) : phaseMass P η ≤ 0 := by
  apply le_of_tendsto (phaseMass_tendsto P hP hcal hη hcη)
  apply Filter.Eventually.of_forall
  intro k
  obtain ⟨hi, hz⟩ := weighted_stress_integral_zero P hcal X hX hcX (transition_deriv_contDiff k)
  have hm := (localized_gradient_mass_identity P hcal hη hcη (transition_contDiff k)
    (transition_norm_le_one k)).1
  calc
    _ ≤ ∫ x, deriv (transition k) (eval x P) * stressPair P X x := by
      apply integral_mono hm hi
      intro x
      dsimp only
      rw [stressPair_eq_tangentialDivergence]
      calc
        _ = (deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) * η x := by ring
        _ ≤ (deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x)) *
            tangentialDivergence P X x :=
          mul_le_mul_of_nonneg_left (hlower x)
            (mul_nonneg (transition_deriv_nonneg k _) (Real.sqrt_nonneg _))
        _ = _ := by ring
    _ = 0 := hz

/-- A nonnegative test equal to one on a ball about a leading zero has strictly
positive phase mass. This uses the proved uniform density and relative estimate. -/
theorem top_phaseMass_pos_at_zero (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (r : ℝ) (hr : 0 < r)
    {η : (Fin 8 → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Metric.closedBall c r, η x = 1) :
    0 < phaseMass (homogeneousComponent P.totalDegree P) η := by
  obtain ⟨d, hd, hdensity⟩ := top_two_sided_density
  obtain ⟨hv, hw⟩ := hdensity P hmin hdeg c hc r hr
  have hF : homogeneousComponent P.totalDegree P ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hpair := phase_volume_product_le_mass _ hF (top_weakCalibration P hmin hdeg) c r hr.le
    hη hcη hηpos hηone
  exact (show 0 < d ^ 2 / 2048 * r ^ 7 by positivity).trans_le
    (mass_lower_of_density hd hr hv hw hpair)

/-- No compactly supported vector field can have nonnegative tangential
divergence everywhere and dominate a positive cutoff about a leading zero. -/
theorem top_no_positive_tangential_barrier (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (r : ℝ) (hr : 0 < r)
    (X : (Fin 8 → ℝ) → Fin 8 → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin 8 → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Metric.closedBall c r, η x = 1)
    (hlower : ∀ x, η x ≤ tangentialDivergence (homogeneousComponent P.totalDegree P) X x) : False := by
  have hp := top_phaseMass_pos_at_zero P hmin hdeg c hc r hr hη hcη hηpos hηone
  have hn := phaseMass_nonpos_of_tangential_lower _
    (top_homogeneousComponent_ne_zero P (by omega)) (top_weakCalibration P hmin hdeg)
    X hX hcX hη hcη hlower
  exact (not_lt_of_ge hn) hp

end
end Source29StressBarrier

/- Component: TransitionDerivativeDecay.inc -/
namespace Source29TransitionDerivativeDecay

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial Source29SmoothPhaseTransition
open scoped Topology BigOperators

noncomputable section

theorem baseTransition_deriv_eq (t : ℝ) :
    deriv baseTransition t = 1 / (2 * (Real.sqrt (1 + t ^ 2)) ^ 3) := by
  have hd := (((scalarField_contDiff.differentiable (by norm_num) t).hasDerivAt).const_add 1).div_const 2
  change HasDerivAt baseTransition (deriv scalarField t / 2) t at hd
  rw [hd.deriv, scalarField_deriv]
  ring

theorem transition_deriv_eq (k : ℕ) (t : ℝ) :
    deriv (transition k) t = dilationRadius k /
      (2 * (Real.sqrt (1 + (dilationRadius k * t) ^ 2)) ^ 3) := by
  have hd := ((baseTransition_contDiff.differentiable (by norm_num) (dilationRadius k * t)).hasDerivAt).comp t
    ((hasDerivAt_id t).const_mul (dilationRadius k))
  change HasDerivAt (transition k)
    (deriv baseTransition (dilationRadius k * t) * (dilationRadius k * 1)) t at hd
  rw [hd.deriv, baseTransition_deriv_eq]
  ring

/-- The factor that kills errors proportional to distance in polynomial value
is bounded by a decaying rational kernel. -/
theorem abs_mul_transition_deriv_le (k : ℕ) (t : ℝ) :
    |t| * deriv (transition k) t ≤ 1 / (2 * (1 + (dilationRadius k * t) ^ 2)) := by
  let u := dilationRadius k * t
  let w := Real.sqrt (1 + u ^ 2)
  have hw : 0 < w := Real.sqrt_pos.mpr (by positivity)
  have hs : w ^ 2 = 1 + u ^ 2 := Real.sq_sqrt (by positivity)
  have ha : |u| ≤ w := Real.abs_le_sqrt (by linarith [sq_nonneg u])
  have he : |t| * deriv (transition k) t = (|u| / w) * (1 / (2 * w ^ 2)) := by
    rw [transition_deriv_eq]
    dsimp only [u, w]
    rw [abs_mul, abs_of_pos (dilationRadius_pos k)]
    field_simp
  rw [he]
  calc
    _ ≤ 1 * (1 / (2 * w ^ 2)) := mul_le_mul_of_nonneg_right ((div_le_one hw).mpr ha) (by positivity)
    _ = _ := by rw [one_mul, hs]

theorem abs_mul_transition_deriv_bound (k : ℕ) (t : ℝ) :
    0 ≤ |t| * deriv (transition k) t ∧ |t| * deriv (transition k) t ≤ 1 / 2 := by
  refine ⟨mul_nonneg (abs_nonneg _) (transition_deriv_nonneg _ _), (abs_mul_transition_deriv_le k t).trans ?_⟩
  apply one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2)
  nlinarith [sq_nonneg (dilationRadius k * t)]

theorem abs_mul_transition_deriv_le_inverse (k : ℕ) {t : ℝ} (ht : t ≠ 0) :
    |t| * deriv (transition k) t ≤ (dilationRadius k)⁻¹ ^ 2 / (2 * t ^ 2) := by
  have hr := dilationRadius_pos k
  have ht2 : 0 < t ^ 2 := sq_pos_of_ne_zero ht
  calc
    _ ≤ 1 / (2 * (1 + (dilationRadius k * t) ^ 2)) := abs_mul_transition_deriv_le k t
    _ ≤ 1 / (2 * (dilationRadius k * t) ^ 2) := by
      apply one_div_le_one_div_of_le (by positivity)
      linarith
    _ = _ := by field_simp

theorem abs_mul_transition_deriv_tendsto (t : ℝ) :
    Tendsto (fun k ↦ |t| * deriv (transition k) t) atTop (𝓝 0) := by
  by_cases ht : t = 0
  · subst t
    simpa only [abs_zero, zero_mul] using (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0 : ℝ)) atTop (𝓝 0))
  · apply squeeze_zero (fun k ↦ (abs_mul_transition_deriv_bound k t).1)
      (fun k ↦ abs_mul_transition_deriv_le_inverse k ht)
    simpa using ((tendsto_inv_atTop_zero.comp dilationRadius_tendsto).pow 2).div_const (2 * t ^ 2)

end
end Source29TransitionDerivativeDecay

/- Component: TransitionLevelError.inc -/
namespace Source29TransitionLevelError

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxPolynomial Source29QuarticReuse.FluxObstruction
open Source29VariationConvexity Source29SmoothPhaseTransition Source29LevelStressStationarity
open Source29TransitionDerivativeDecay
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem level_error_integrable (P : MvPolynomial (Fin n) ℝ)
    {b : (Fin n → ℝ) → ℝ} (hb : Continuous b) (hcb : HasCompactSupport b) (k : ℕ) :
    Integrable (fun x ↦ b x * |eval x P| * deriv (transition k) (eval x P) *
      variationDensity (evaluatedGradient P x)) := by
  apply Continuous.integrable_of_hasCompactSupport
  · exact ((hb.mul (contDiff_eval P).continuous.abs).mul
      ((transition_deriv_contDiff k).continuous.comp (contDiff_eval P).continuous)).mul
        (variationDensity_continuous _ (fun i ↦ (contDiff_eval (pderiv i P)).continuous))
  · exact hcb.mul_right.mul_right.mul_right

/-- Compactly weighted errors proportional to the polynomial value disappear
in the phase-boundary limit, including at critical points. -/
theorem level_error_tendsto_zero (P : MvPolynomial (Fin n) ℝ)
    {b : (Fin n → ℝ) → ℝ} (hb : Continuous b) (hcb : HasCompactSupport b) :
    Tendsto (fun k ↦ ∫ x, b x * |eval x P| * deriv (transition k) (eval x P) *
      variationDensity (evaluatedGradient P x)) atTop (𝓝 0) := by
  have hv := variationDensity_continuous (evaluatedGradient P)
    (fun i ↦ (contDiff_eval (pderiv i P)).continuous)
  have h : Tendsto (fun k ↦ ∫ x, b x * |eval x P| * deriv (transition k) (eval x P) *
      variationDensity (evaluatedGradient P x)) atTop (𝓝 (∫ _x : Fin n → ℝ, (0 : ℝ))) := by
    apply tendsto_integral_of_dominated_convergence
      (fun x ↦ ‖b x‖ * (1 / 2) * variationDensity (evaluatedGradient P x))
    · intro k
      exact (level_error_integrable P hb hcb k).aestronglyMeasurable
    · exact ((hb.norm.mul continuous_const).mul hv).integrable_of_hasCompactSupport
        hcb.norm.mul_right.mul_right
    · intro k
      apply Filter.Eventually.of_forall
      intro x
      calc
        _ = ‖b x‖ * (|eval x P| * deriv (transition k) (eval x P)) *
            variationDensity (evaluatedGradient P x) := by
          simp only [norm_mul, Real.norm_eq_abs, abs_abs, abs_of_nonneg (transition_deriv_nonneg k _),
            abs_of_nonneg (show 0 ≤ variationDensity (evaluatedGradient P x) from Real.sqrt_nonneg _)]
          ring
        _ ≤ _ := mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (abs_mul_transition_deriv_bound k _).2 (norm_nonneg _))
          (Real.sqrt_nonneg _)
    · apply Filter.Eventually.of_forall
      intro x
      simpa only [mul_zero, zero_mul, mul_assoc] using
        (tendsto_const_nhds.mul (abs_mul_transition_deriv_tendsto (eval x P))).mul_const
          (variationDensity (evaluatedGradient P x))
  simpa only [integral_zero] using h

end
end Source29TransitionLevelError

/- Component: TangentialDivergenceBound.inc -/
namespace Source29TangentialDivergenceBound

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29VariationConvexity
open Source29WeakCalibrationLimits Source29PolynomialStress Source29GradientNormWeakDerivative
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def tangentialBound (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  (∑ j, ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single j 1)‖) +
    ∑ j, ∑ i, ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)‖

theorem tangentialBound_nonneg (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    0 ≤ tangentialBound X x := by
  unfold tangentialBound
  positivity

theorem tangentialBound_continuous (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j)) : Continuous (tangentialBound X) := by
  have hc (i j : Fin n) : Continuous (fun x ↦ ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)‖) :=
    (((hX j).continuous_fderiv (by norm_num)).clm_apply continuous_const).norm
  exact (continuous_finsetSum _ (fun j _ ↦ hc j j)).add
    (continuous_finsetSum _ (fun j _ ↦ continuous_finsetSum _ (fun i _ ↦ hc i j)))

theorem tangentialBound_compact (X : (Fin n → ℝ) → Fin n → ℝ)
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j)) : HasCompactSupport (tangentialBound X) := by
  have hc (i j : Fin n) : HasCompactSupport (fun x ↦ ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)‖) :=
    ((hcX j).fderiv_apply ℝ (Pi.single i 1)).norm
  have h1 : HasCompactSupport (fun x ↦ ∑ j, ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single j 1)‖) := by
    convert (HasCompactSupport.finset_sum (s := Finset.univ) (fun j _ ↦ hc j j)) using 1
    ext x
    simp only [Finset.sum_apply]
  have h2 (j : Fin n) : HasCompactSupport (fun x ↦ ∑ i, ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)‖) := by
    convert (HasCompactSupport.finset_sum (s := Finset.univ) (fun i _ ↦ hc i j)) using 1
    ext x
    simp only [Finset.sum_apply]
  have h3 : HasCompactSupport (fun x ↦ ∑ j, ∑ i, ‖fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)‖) := by
    convert (HasCompactSupport.finset_sum (s := Finset.univ) (fun j _ ↦ h2 j)) using 1
    ext x
    simp only [Finset.sum_apply]
  exact h1.add h3

/-- A continuous compact envelope controls tangential divergence even where
the normalized polynomial gradient is discontinuous. -/
theorem norm_tangentialDivergence_le (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    ‖tangentialDivergence P X x‖ ≤ tangentialBound X x := by
  unfold tangentialDivergence tangentialBound
  apply (norm_sub_le _ _).trans
  apply add_le_add
  · exact norm_sum_le _ _
  · apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro j _
    apply norm_pair_le
    intro i
    rw [norm_mul]
    simpa only [one_mul] using mul_le_mul
      (leadingNormalizedField_bound P x i) (leadingNormalizedField_bound P x j) (norm_nonneg _) zero_le_one

/-- A tangential-divergence inequality in a fixed polynomial strip extends to
a global inequality with a compact error proportional to the polynomial value. -/
theorem exists_level_error_of_strip (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin n → ℝ) → ℝ} (hη : Continuous η) (hcη : HasCompactSupport η)
    {δ : ℝ} (hδ : 0 < δ)
    (hlower : ∀ x, |eval x P| < δ → η x ≤ tangentialDivergence P X x) :
    ∃ b : (Fin n → ℝ) → ℝ, Continuous b ∧ HasCompactSupport b ∧
      (∀ x, 0 ≤ b x) ∧ (∀ x, η x ≤ tangentialDivergence P X x + |eval x P| * b x) := by
  let E := fun x ↦ |η x| + tangentialBound X x
  let b := fun x ↦ E x / δ
  have hE (x : Fin n → ℝ) : 0 ≤ E x := add_nonneg (abs_nonneg _) (tangentialBound_nonneg X x)
  have hb (x : Fin n → ℝ) : 0 ≤ b x := div_nonneg (hE x) hδ.le
  have hcE : HasCompactSupport E := hcη.abs.add (tangentialBound_compact X hcX)
  have hcb : HasCompactSupport b := by
    simpa only [b, div_eq_mul_inv, Pi.mul_def] using (hcE.mul_right (f' := fun _ ↦ δ⁻¹))
  refine ⟨b, (hη.abs.add (tangentialBound_continuous X hX)).div_const δ, hcb, hb, ?_⟩
  intro x
  by_cases hx : |eval x P| < δ
  · exact (hlower x hx).trans (le_add_of_nonneg_right (mul_nonneg (abs_nonneg _) (hb x)))
  · have hδx : δ ≤ |eval x P| := le_of_not_gt hx
    have he : E x ≤ |eval x P| * b x := by
      calc
        E x = δ * b x := by dsimp only [b]; field_simp
        _ ≤ _ := mul_le_mul_of_nonneg_right hδx (hb x)
    have hd := norm_tangentialDivergence_le P X x
    rw [Real.norm_eq_abs] at hd
    have hη' := le_abs_self (η x)
    have ht := neg_le_abs (tangentialDivergence P X x)
    dsimp only [E] at he
    linarith

end
end Source29TangentialDivergenceBound

/- Component: LocalizedStressBarrier.inc -/
namespace Source29LocalizedStressBarrier

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.QuarticPolynomialBasics
open Source29VariationConvexity Source29WeakCalibrationLimits Source29PolynomialStress
open Source29NonlinearCalibration Source29SmoothPhaseTransition Source29LevelStressStationarity
open Source29PhaseMassLimit Source29TopPhasePerimeter Source29StressBarrier
open Source29TransitionLevelError Source29TangentialDivergenceBound
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem phaseMass_nonpos_of_level_error (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin n → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    {b : (Fin n → ℝ) → ℝ} (hb : Continuous b) (hcb : HasCompactSupport b)
    (hlower : ∀ x, η x ≤ tangentialDivergence P X x + |eval x P| * b x) :
    phaseMass P η ≤ 0 := by
  apply le_of_tendsto_of_tendsto (phaseMass_tendsto P hP hcal hη hcη) (level_error_tendsto_zero P hb hcb)
  apply Filter.Eventually.of_forall
  intro k
  obtain ⟨hi, hz⟩ := weighted_stress_integral_zero P hcal X hX hcX (transition_deriv_contDiff k)
  have hm := (localized_gradient_mass_identity P hcal hη hcη (transition_contDiff k)
    (transition_norm_le_one k)).1
  have he := level_error_integrable P hb hcb k
  calc
    _ ≤ ∫ x, deriv (transition k) (eval x P) * stressPair P X x +
        b x * |eval x P| * deriv (transition k) (eval x P) * variationDensity (evaluatedGradient P x) := by
      apply integral_mono hm (hi.add he)
      intro x
      have h := mul_le_mul_of_nonneg_right (hlower x)
        (mul_nonneg (transition_deriv_nonneg k (eval x P)) (show 0 ≤ variationDensity (evaluatedGradient P x) from Real.sqrt_nonneg _))
      dsimp only [Pi.add_apply]
      rw [stressPair_eq_tangentialDivergence]
      convert h using 1 <;> ring
    _ = _ := by rw [integral_add hi he, hz, zero_add]

/-- The barrier inequality is needed only in an arbitrary fixed strip around
the zero level. Compactness controls its failure outside the strip. -/
theorem phaseMass_nonpos_of_strip (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    (hcal : WeakCalibration (leadingNormalizedField P))
    (X : (Fin n → ℝ) → Fin n → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin n → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    {δ : ℝ} (hδ : 0 < δ)
    (hlower : ∀ x, |eval x P| < δ → η x ≤ tangentialDivergence P X x) :
    phaseMass P η ≤ 0 := by
  obtain ⟨b, hb, hcb, _, hl⟩ := exists_level_error_of_strip P X hX hcX hη.continuous hcη hδ hlower
  exact phaseMass_nonpos_of_level_error P hP hcal X hX hcX hη hcη hb hcb hl

/-- A leading zero cannot admit a positive tangential-divergence barrier even
when its inequality is only assumed near the zero level. -/
theorem top_no_positive_strip_barrier (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (r : ℝ) (hr : 0 < r)
    (X : (Fin 8 → ℝ) → Fin 8 → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    {η : (Fin 8 → ℝ) → ℝ} (hη : ContDiff ℝ 1 η) (hcη : HasCompactSupport η)
    (hηpos : ∀ x, 0 ≤ η x) (hηone : ∀ x ∈ Metric.closedBall c r, η x = 1)
    {δ : ℝ} (hδ : 0 < δ)
    (hlower : ∀ x, |eval x (homogeneousComponent P.totalDegree P)| < δ →
      η x ≤ tangentialDivergence (homogeneousComponent P.totalDegree P) X x) : False := by
  have hp := top_phaseMass_pos_at_zero P hmin hdeg c hc r hr hη hcη hηpos hηone
  have hn := phaseMass_nonpos_of_strip _ (top_homogeneousComponent_ne_zero P (by omega))
    (top_weakCalibration P hmin hdeg) X hX hcX hη hcη hδ hlower
  exact (not_lt_of_ge hn) hp

end
end Source29LocalizedStressBarrier

/- Component: CompactPenalty.inc -/
namespace Source29CompactPenalty

open Set
open scoped Topology

noncomputable section

/-- If a continuous quantity is positive where a nonnegative penalty vanishes,
then one finite penalty coefficient makes it uniformly positive on a compact set. -/
theorem exists_uniform_positive_penalty {E : Type*} [TopologicalSpace E]
    (K : Set E) (hK : IsCompact K) (a b : E → ℝ)
    (ha : Continuous a) (hb : Continuous b)
    (hbnonneg : ∀ x ∈ K, 0 ≤ b x) (hzero : ∀ x ∈ K, b x = 0 → 0 < a x) :
    ∃ L ε : ℝ, 0 ≤ L ∧ 0 < ε ∧ ∀ x ∈ K, ε ≤ a x + L * b x := by
  classical
  let U : ℕ → Set E := fun k ↦ {x | 0 < a x + (k : ℝ) * b x}
  have hop (k : ℕ) : IsOpen (U k) :=
    isOpen_lt continuous_const (ha.add (continuous_const.mul hb))
  have hcover : K ⊆ ⋃ k, U k := by
    intro x hx
    apply Set.mem_iUnion.mpr
    by_cases hz : b x = 0
    · exact ⟨0, by simpa only [U, Set.mem_ofPred_eq, Nat.cast_zero, zero_mul, add_zero] using hzero x hx hz⟩
    · have hp : 0 < b x := lt_of_le_of_ne (hbnonneg x hx) (Ne.symm hz)
      obtain ⟨k, hk⟩ := exists_nat_gt (-a x / b x)
      refine ⟨k, ?_⟩
      have hm := (div_lt_iff₀ hp).mp hk
      change 0 < a x + (k : ℝ) * b x
      linarith
  obtain ⟨s, hs⟩ := hK.elim_finite_subcover U hop hcover
  let M : ℕ := s.sup id
  have hpos : ∀ x ∈ K, 0 < a x + (M : ℝ) * b x := by
    intro x hx
    obtain ⟨k, hk⟩ := Set.mem_iUnion.mp (hs hx)
    obtain ⟨hks, hku⟩ := Set.mem_iUnion.mp hk
    have hle : k ≤ M := Finset.le_sup (f := id) hks
    have hle' : (k : ℝ) ≤ (M : ℝ) := by exact_mod_cast hle
    exact (show 0 < a x + (k : ℝ) * b x from hku).trans_le
      (add_le_add le_rfl (mul_le_mul_of_nonneg_right hle' (hbnonneg x hx)))
  obtain ⟨ε, hε, he⟩ := hK.exists_forall_le'
    (ha.add (continuous_const.mul hb)).continuousOn hpos
  exact ⟨M, ε, Nat.cast_nonneg _, hε, he⟩

end
end Source29CompactPenalty

/- Component: NormalBall.inc -/
namespace Source29NormalBall

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29VariationConvexity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def sqNorm (v : Fin n → ℝ) : ℝ := ∑ i, v i ^ 2
def normalBall (n : ℕ) : Set (Fin n → ℝ) := {v | sqNorm v ≤ 1}

theorem sqNorm_nonneg (v : Fin n → ℝ) : 0 ≤ sqNorm v := Finset.sum_nonneg (fun i _ ↦ sq_nonneg _)

theorem sqNorm_pos {v : Fin n → ℝ} (hv : v ≠ 0) : 0 < sqNorm v := by
  have h := variationDensity_pos hv
  have hs := variationDensity_sq v
  change variationDensity v ^ 2 = sqNorm v at hs
  nlinarith

theorem sqNorm_continuous : Continuous (sqNorm : (Fin n → ℝ) → ℝ) :=
  continuous_finsetSum _ (fun i _ ↦ (continuous_apply i).pow 2)

theorem normalBall_compact (n : ℕ) : IsCompact (normalBall n) := by
  have hc : IsClosed (normalBall n) := isClosed_le sqNorm_continuous continuous_const
  apply (isCompact_Icc : IsCompact (Set.Icc (fun _ : Fin n ↦ (-1 : ℝ)) (fun _ ↦ (1 : ℝ)))).of_isClosed_subset hc
  intro v hv
  have hvi (i : Fin n) : v i ^ 2 ≤ 1 :=
    (Finset.single_le_sum (fun j _ ↦ sq_nonneg (v j)) (Finset.mem_univ i)).trans hv
  constructor <;> intro i <;> nlinarith [hvi i]

/-- The actual normalized polynomial gradient belongs to the Euclidean closed
unit ball, including at its critical points. -/
theorem leadingNormalizedField_mem (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    leadingNormalizedField P x ∈ normalBall n := by
  by_cases hz : evaluatedGradient P x = 0
  · simp only [normalBall, Set.mem_ofPred_eq, sqNorm, leadingNormalizedField, hz, Pi.zero_apply,
      zero_div, zero_pow (by decide : 2 ≠ 0), Finset.sum_const_zero]
    norm_num
  · have hp := sqNorm_pos hz
    have hs := Real.sq_sqrt hp.le
    change sqNorm (leadingNormalizedField P x) ≤ 1
    simp only [sqNorm, leadingNormalizedField, div_pow, ← Finset.sum_div]
    change sqNorm (evaluatedGradient P x) / (Real.sqrt (sqNorm (evaluatedGradient P x))) ^ 2 ≤ 1
    rw [hs, div_self hp.ne']

end
end Source29NormalBall

/- Component: NormalPenalty.inc -/
namespace Source29NormalPenalty

open Source29NormalBall
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def dot (v w : Fin n → ℝ) : ℝ := ∑ i, v i * w i
def quad (H : Fin n → Fin n → ℝ) (v : Fin n → ℝ) : ℝ := ∑ i, ∑ j, H i j * v i * v j
def trace (H : Fin n → Fin n → ℝ) : ℝ := ∑ i, H i i
def projectedTrace (H : Fin n → Fin n → ℝ) (N : Fin n → ℝ) : ℝ := trace H - quad H N
def penalty (v N : Fin n → ℝ) : ℝ := sqNorm v - (dot N v) ^ 2

theorem penalty_nonneg (v : Fin n → ℝ) {N : Fin n → ℝ} (hN : N ∈ normalBall n) :
    0 ≤ penalty v N := by
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ N v
  change (dot N v) ^ 2 ≤ sqNorm N * sqNorm v at hcs
  have hm := mul_le_mul_of_nonneg_right (show sqNorm N ≤ 1 from hN) (sqNorm_nonneg v)
  dsimp only [penalty]
  nlinarith

theorem residual_sq (v N : Fin n → ℝ) (c : ℝ) :
    (∑ i, (v i - c * N i) ^ 2) = sqNorm v - 2 * c * dot N v + c ^ 2 * sqNorm N := by
  calc
    _ = ∑ i, (v i ^ 2 - (2 * c) * (N i * v i) + c ^ 2 * N i ^ 2) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = _ := by
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, sqNorm, dot]

theorem coordinates_of_penalty_zero (v : Fin n → ℝ) {N : Fin n → ℝ}
    (hN : N ∈ normalBall n) (hz : penalty v N = 0) :
    ∀ i, v i = dot N v * N i := by
  let c := dot N v
  have he : c ^ 2 = sqNorm v := by dsimp [penalty] at hz; dsimp [c]; linarith
  have hr := residual_sq v N c
  have hm := mul_le_mul_of_nonneg_left (show sqNorm N ≤ 1 from hN) (sq_nonneg c)
  have hn : (∑ i, (v i - c * N i) ^ 2) ≤ 0 := by
    change _ = sqNorm v - 2 * c * c + c ^ 2 * sqNorm N at hr
    nlinarith
  intro i
  have hi := Finset.single_le_sum (fun j _ ↦ sq_nonneg (v j - c * N j)) (Finset.mem_univ i)
  have hs : (v i - c * N i) ^ 2 = 0 := le_antisymm (hi.trans hn) (sq_nonneg _)
  exact sub_eq_zero.mp (sq_eq_zero_iff.mp hs)

theorem quad_smul (H : Fin n → Fin n → ℝ) (v : Fin n → ℝ) (c : ℝ) :
    quad H (fun i ↦ c * v i) = c ^ 2 * quad H v := by
  simp only [quad, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- Vanishing penalty identifies the trace with the trace on the hyperplane
orthogonal to the nonzero vector v. No sign choice for N is needed. -/
theorem projectedTrace_of_penalty_zero (H : Fin n → Fin n → ℝ) (v : Fin n → ℝ)
    (hv : v ≠ 0) {N : Fin n → ℝ} (hN : N ∈ normalBall n) (hz : penalty v N = 0) :
    projectedTrace H N = trace H - quad H v / sqNorm v := by
  have hpos := sqNorm_pos hv
  have hc : (dot N v) ^ 2 = sqNorm v := by dsimp only [penalty] at hz; linarith
  have he : v = (fun i ↦ dot N v * N i) := funext (coordinates_of_penalty_zero v hN hz)
  have hq : quad H v = (dot N v) ^ 2 * quad H N := by
    calc
      quad H v = quad H (fun i ↦ dot N v * N i) := congrArg (quad H) he
      _ = _ := quad_smul H N _
  rw [hq, hc]
  unfold projectedTrace
  field_simp

theorem quad_continuous (H : Fin n → Fin n → ℝ) : Continuous (quad H) := by
  apply continuous_finsetSum
  intro i _
  apply continuous_finsetSum
  intro j _
  exact (continuous_const.mul (continuous_apply i)).mul (continuous_apply j)

theorem projectedTrace_continuous (H : Fin n → Fin n → ℝ) : Continuous (projectedTrace H) :=
  continuous_const.sub (quad_continuous H)

theorem penalty_continuous (v : Fin n → ℝ) : Continuous (penalty v) :=
  continuous_const.sub ((continuous_finsetSum _ (fun i _ ↦ (continuous_apply i).mul continuous_const)).pow 2)

end
end Source29NormalPenalty

/- Component: CurvaturePenalty.inc -/
namespace Source29CurvaturePenalty

open Filter Source29NormalBall Source29NormalPenalty Source29CompactPenalty
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- Positive curvature in the hyperplane normal to v gives a uniform corrected
trace estimate over every candidate unit normal. -/
theorem exists_normal_penalty (H : Fin n → Fin n → ℝ) (v : Fin n → ℝ)
    (hv : v ≠ 0) (hcurv : 0 < trace H - quad H v / sqNorm v) :
    ∃ L ε : ℝ, 0 ≤ L ∧ 0 < ε ∧
      ∀ N ∈ normalBall n, ε ≤ projectedTrace H N + L * penalty v N := by
  apply exists_uniform_positive_penalty (normalBall n) (normalBall_compact n)
    (projectedTrace H) (penalty v) (projectedTrace_continuous H) (penalty_continuous v)
    (fun _ hN ↦ penalty_nonneg v hN)
  intro N hN hz
  rw [projectedTrace_of_penalty_zero H v hv hN hz]
  exact hcurv

theorem projectedTrace_joint_continuous {E : Type*} [TopologicalSpace E]
    (H : E → Fin n → Fin n → ℝ) (hH : ∀ i j, Continuous (fun x ↦ H x i j)) :
    Continuous (fun z : E × (Fin n → ℝ) ↦ projectedTrace (H z.1) z.2) := by
  apply Continuous.sub
  · exact continuous_finsetSum _ (fun i _ ↦ (hH i i).comp continuous_fst)
  · apply continuous_finsetSum
    intro i _
    apply continuous_finsetSum
    intro j _
    exact (((hH i j).comp continuous_fst).mul ((continuous_apply i).comp continuous_snd)).mul
      ((continuous_apply j).comp continuous_snd)

theorem penalty_joint_continuous {E : Type*} [TopologicalSpace E]
    (v : E → Fin n → ℝ) (hv : ∀ i, Continuous (fun x ↦ v x i)) :
    Continuous (fun z : E × (Fin n → ℝ) ↦ penalty (v z.1) z.2) := by
  apply Continuous.sub
  · exact continuous_finsetSum _ (fun i _ ↦ ((hv i).comp continuous_fst).pow 2)
  · apply Continuous.pow
    apply continuous_finsetSum
    intro i _
    exact ((continuous_apply i).comp continuous_snd).mul ((hv i).comp continuous_fst)

/-- The corrected trace remains uniformly positive near the contact point,
with the same correction coefficient for all candidate normals. -/
theorem exists_local_normal_penalty {E : Type*} [TopologicalSpace E]
    (H : E → Fin n → Fin n → ℝ) (v : E → Fin n → ℝ)
    (hH : ∀ i j, Continuous (fun x ↦ H x i j)) (hv : ∀ i, Continuous (fun x ↦ v x i))
    (c : E) (hne : v c ≠ 0) (hcurv : 0 < trace (H c) - quad (H c) (v c) / sqNorm (v c)) :
    ∃ L ε : ℝ, 0 ≤ L ∧ 0 < ε ∧
      ∀ᶠ x in 𝓝 c, ∀ N ∈ normalBall n, ε ≤ projectedTrace (H x) N + L * penalty (v x) N := by
  obtain ⟨L, ε, hL, hε, hpos⟩ := exists_normal_penalty (H c) (v c) hne hcurv
  have hf : Continuous (fun z : E × (Fin n → ℝ) ↦ projectedTrace (H z.1) z.2 + L * penalty (v z.1) z.2) :=
    (projectedTrace_joint_continuous H hH).add (continuous_const.mul (penalty_joint_continuous v hv))
  have he : ∀ᶠ x in 𝓝 c, ∀ N ∈ normalBall n,
      ε / 2 < projectedTrace (H x) N + L * penalty (v x) N := by
    apply (normalBall_compact n).eventually_forall_of_forall_eventually
    intro N hN
    exact (isOpen_lt continuous_const hf).mem_nhds (by
      have hp := hpos N hN
      change ε / 2 < projectedTrace (H c) N + L * penalty (v c) N
      linarith)
  exact ⟨L, ε / 2, hL, by positivity, he.mono fun x hx N hN ↦ (hx N hN).le⟩

end
end Source29CurvaturePenalty

/- Component: ProjectedTraceAlgebra.inc -/
namespace Source29ProjectedTraceAlgebra

open Source29NormalBall Source29NormalPenalty
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem projectedTrace_add (A B : Fin n → Fin n → ℝ) (N : Fin n → ℝ) :
    projectedTrace (fun i j ↦ A i j + B i j) N = projectedTrace A N + projectedTrace B N := by
  simp only [projectedTrace, trace, quad, add_mul, Finset.sum_add_distrib]
  ring

theorem projectedTrace_smul (a : ℝ) (H : Fin n → Fin n → ℝ) (N : Fin n → ℝ) :
    projectedTrace (fun i j ↦ a * H i j) N = a * projectedTrace H N := by
  simp only [projectedTrace, trace, quad, mul_assoc, ← Finset.mul_sum]
  ring

theorem projectedTrace_rank_one (v w N : Fin n → ℝ) :
    projectedTrace (fun i j ↦ v i * w j) N = dot v w - dot N v * dot N w := by
  have hq : quad (fun i j ↦ v i * w j) N = dot N v * dot N w := by
    calc
      _ = ∑ i, (N i * v i) * (∑ j, N j * w j) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = _ := by rw [← Finset.sum_mul]; rfl
  rw [projectedTrace, hq]
  rfl

theorem projectedTrace_square (v N : Fin n → ℝ) :
    projectedTrace (fun i j ↦ v i * v j) N = penalty v N := by
  rw [projectedTrace_rank_one]
  simp only [penalty, dot, sqNorm, pow_two]

end
end Source29ProjectedTraceAlgebra

/- Component: GradientBarrierCalculus.inc -/
namespace Source29GradientBarrierCalculus

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29PolynomialStress
open Source29NormalBall Source29NormalPenalty Source29CurvaturePenalty Source29ProjectedTraceAlgebra
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def coordinateGradient (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i : Fin n) : ℝ :=
  fderiv ℝ u x (Pi.single i 1)

def coordinateJacobian (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) (i j : Fin n) : ℝ :=
  fderiv ℝ (fun y ↦ X y j) x (Pi.single i 1)

def coordinateHessian (u : (Fin n → ℝ) → ℝ) := coordinateJacobian (coordinateGradient u)

theorem gradient_contDiff {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u) (i : Fin n) :
    ContDiff ℝ 1 (fun x ↦ coordinateGradient u x i) := by
  have hd : ContDiff ℝ 1 (fderiv ℝ u) := hu.fderiv_right (by norm_num)
  exact hd.clm_apply contDiff_const

theorem hessian_continuous {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u) (i j : Fin n) :
    Continuous (fun x ↦ coordinateHessian u x i j) :=
  ((gradient_contDiff hu j).continuous_fderiv (by norm_num)).clm_apply continuous_const

theorem tangentialDivergence_eq_projectedTrace (P : MvPolynomial (Fin n) ℝ)
    (X : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    tangentialDivergence P X x = projectedTrace (coordinateJacobian X x) (leadingNormalizedField P x) := by
  unfold tangentialDivergence projectedTrace trace quad divergence coordinateJacobian
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The local uniform normal estimate, applied to an actual C2 scalar test. -/
theorem test_local_normal_penalty {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin n → ℝ) (hne : coordinateGradient u c ≠ 0)
    (hcurv : 0 < trace (coordinateHessian u c) -
      quad (coordinateHessian u c) (coordinateGradient u c) / sqNorm (coordinateGradient u c)) :
    ∃ L ε : ℝ, 0 ≤ L ∧ 0 < ε ∧ ∀ᶠ x in 𝓝 c, ∀ N ∈ normalBall n,
      ε ≤ projectedTrace (coordinateHessian u x) N + L * penalty (coordinateGradient u x) N :=
  exists_local_normal_penalty _ _ (hessian_continuous hu)
    (fun i ↦ (gradient_contDiff hu i).continuous) c hne hcurv

def barrierField (u χ : (Fin n → ℝ) → ℝ) (h : ℝ → ℝ)
    (x : Fin n → ℝ) (j : Fin n) : ℝ := χ x * h (u x) * coordinateGradient u x j

theorem barrierField_contDiff {u χ : (Fin n → ℝ) → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 2 u) (hχ : ContDiff ℝ 1 χ) (hh : ContDiff ℝ 1 h) (j : Fin n) :
    ContDiff ℝ 1 (fun x ↦ barrierField u χ h x j) :=
  (hχ.mul (hh.comp (hu.of_le (by norm_num)))).mul (gradient_contDiff hu j)

theorem barrierField_compact {u χ : (Fin n → ℝ) → ℝ} {h : ℝ → ℝ}
    (hcχ : HasCompactSupport χ) (j : Fin n) :
    HasCompactSupport (fun x ↦ barrierField u χ h x j) := hcχ.mul_right.mul_right

theorem barrierField_jacobian {u χ : (Fin n → ℝ) → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 2 u) (hχ : ContDiff ℝ 1 χ) (hh : ContDiff ℝ 1 h)
    (x : Fin n → ℝ) (i j : Fin n) :
    coordinateJacobian (barrierField u χ h) x i j =
      (χ x * h (u x)) * coordinateHessian u x i j +
      (χ x * deriv h (u x)) * (coordinateGradient u x i * coordinateGradient u x j) +
      h (u x) * (coordinateGradient χ x i * coordinateGradient u x j) := by
  have hu1 : ContDiff ℝ 1 u := hu.of_le (by norm_num)
  have dh := ((hh.differentiable (by norm_num) (u x)).hasDerivAt).comp_hasFDerivAt x
    ((hu1.differentiable (by norm_num) x).hasFDerivAt)
  have dp := ((hχ.differentiable (by norm_num) x).hasFDerivAt).fun_mul dh
  have dt := dp.fun_mul (((gradient_contDiff hu j).differentiable (by norm_num) x).hasFDerivAt)
  have he := congrArg (fun L : (Fin n → ℝ) →L[ℝ] ℝ ↦ L (Pi.single i 1)) dt.fderiv
  have he' : coordinateJacobian (barrierField u χ h) x i j =
      coordinateGradient u x j * (h (u x) * coordinateGradient χ x i +
        χ x * (deriv h (u x) * coordinateGradient u x i)) +
      (χ x * h (u x)) * coordinateHessian u x i j := by
    simpa only [coordinateJacobian, barrierField, coordinateGradient, coordinateHessian,
      ContinuousLinearMap.add_apply, _root_.smul_apply, smul_eq_mul, Function.comp_def, add_comm] using he
  rw [he']
  ring

/-- Exact tangential-divergence formula for the cutoff gradient field used in
geometric touching barriers. -/
theorem barrierField_tangentialDivergence (P : MvPolynomial (Fin n) ℝ)
    {u χ : (Fin n → ℝ) → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 2 u) (hχ : ContDiff ℝ 1 χ) (hh : ContDiff ℝ 1 h) (x : Fin n → ℝ) :
    let N := leadingNormalizedField P x
    tangentialDivergence P (barrierField u χ h) x =
      (χ x * h (u x)) * projectedTrace (coordinateHessian u x) N +
      (χ x * deriv h (u x)) * penalty (coordinateGradient u x) N +
      h (u x) * (dot (coordinateGradient χ x) (coordinateGradient u x) -
        dot N (coordinateGradient χ x) * dot N (coordinateGradient u x)) := by
  have hj : coordinateJacobian (barrierField u χ h) x =
      (fun i j ↦ (χ x * h (u x)) * coordinateHessian u x i j +
        (χ x * deriv h (u x)) * (coordinateGradient u x i * coordinateGradient u x j) +
        h (u x) * (coordinateGradient χ x i * coordinateGradient u x j)) :=
    funext fun i ↦ funext fun j ↦ barrierField_jacobian hu hχ hh x i j
  rw [tangentialDivergence_eq_projectedTrace, hj]
  simp only [projectedTrace_add, projectedTrace_smul, projectedTrace_square, projectedTrace_rank_one]

/-- Where the spatial cutoff is constant, the normal penalty and profile slope
turn the curvature estimate into a quantitative positive divergence. -/
theorem barrierField_lower_at_flat_cutoff (P : MvPolynomial (Fin n) ℝ)
    {u χ : (Fin n → ℝ) → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 2 u) (hχ : ContDiff ℝ 1 χ) (hh : ContDiff ℝ 1 h)
    (x : Fin n → ℝ) (hχpos : 0 ≤ χ x) (hflat : coordinateGradient χ x = 0)
    (hhpos : 0 ≤ h (u x)) (L ε : ℝ)
    (hslope : L * h (u x) ≤ deriv h (u x))
    (htrace : ε ≤ projectedTrace (coordinateHessian u x) (leadingNormalizedField P x) +
      L * penalty (coordinateGradient u x) (leadingNormalizedField P x)) :
    χ x * h (u x) * ε ≤ tangentialDivergence P (barrierField u χ h) x := by
  have hp := penalty_nonneg (coordinateGradient u x) (leadingNormalizedField_mem P x)
  have h1 := mul_le_mul_of_nonneg_left htrace (mul_nonneg hχpos hhpos)
  have h2 := mul_nonneg (mul_nonneg hχpos (sub_nonneg.mpr hslope)) hp
  rw [barrierField_tangentialDivergence P hu hχ hh]
  simp only [hflat, dot, Pi.zero_apply, zero_mul, mul_zero, Finset.sum_const_zero,
    sub_self, mul_zero, add_zero]
  nlinarith

end
end Source29GradientBarrierCalculus

/- Component: RisingBarrierProfile.inc -/
namespace Source29RisingBarrierProfile

open Source29QuarticReuse.FluxObstruction
open scoped Topology

noncomputable section

def profile (δ t : ℝ) : ℝ := expNegInvGlue (t + δ)

theorem profile_contDiff (δ : ℝ) : ContDiff ℝ 1 (profile δ) :=
  expNegInvGlue.contDiff.comp (contDiff_id.add contDiff_const)

theorem profile_nonneg (δ t : ℝ) : 0 ≤ profile δ t := expNegInvGlue.nonneg _

theorem profile_zero (δ t : ℝ) (ht : t ≤ -δ) : profile δ t = 0 :=
  expNegInvGlue.zero_of_nonpos (by linarith)

theorem profile_pos (δ t : ℝ) (ht : -δ < t) : 0 < profile δ t :=
  expNegInvGlue.pos_of_pos (by linarith)

theorem profile_deriv (δ t : ℝ) : deriv (profile δ) t = (t + δ)⁻¹ ^ 2 * profile δ t := by
  have h := (expNegInvGlue_hasDerivAt (t + δ)).comp t ((hasDerivAt_id t).add_const δ)
  change deriv (fun s ↦ expNegInvGlue (s + δ)) t = (t + δ)⁻¹ ^ 2 * expNegInvGlue (t + δ)
  simpa only [Function.comp_def, mul_one, id_eq] using h.deriv

theorem profile_deriv_zero (δ t : ℝ) (ht : t ≤ -δ) : deriv (profile δ) t = 0 := by
  rw [profile_deriv, profile_zero δ t ht, mul_zero]

/-- The profile is flat on one side and has arbitrarily large relative slope
on a sufficiently short interval about zero. -/
theorem profile_deriv_lower {L δ : ℝ} (hL : 0 ≤ L) (hδ : 0 < δ)
    (hsmall : L * (2 * δ) ^ 2 ≤ 1) (t : ℝ) (ht : t ≤ δ) :
    L * profile δ t ≤ deriv (profile δ) t := by
  rw [profile_deriv]
  by_cases hs : 0 < t + δ
  · have hsq : (t + δ) ^ 2 ≤ (2 * δ) ^ 2 := by nlinarith
    have hmul : L * (t + δ) ^ 2 ≤ 1 := (mul_le_mul_of_nonneg_left hsq hL).trans hsmall
    have hi : L ≤ (t + δ)⁻¹ ^ 2 := by
      have h := (le_div_iff₀ (sq_pos_of_pos hs)).mpr hmul
      simpa only [one_div, inv_pow] using h
    exact mul_le_mul_of_nonneg_right hi (profile_nonneg δ t)
  · have hz := profile_zero δ t (by linarith)
    rw [hz, mul_zero, mul_zero]

/-- The width may be chosen below any prescribed positive geometric margin. -/
theorem exists_small_profile (L : ℝ) (hL : 0 ≤ L) (r : ℝ) (hr : 0 < r) :
    ∃ δ : ℝ, 0 < δ ∧ δ < r ∧
      (∀ t, 0 ≤ profile δ t) ∧ (∀ t, t ≤ -δ → profile δ t = 0) ∧
      0 < profile δ 0 ∧ (∀ t, t ≤ δ → L * profile δ t ≤ deriv (profile δ) t) := by
  let δ := min (r / 2) (1 / (2 * (L + 1)))
  have hδ : 0 < δ := lt_min (by positivity) (by positivity)
  have hd1 : δ ≤ r / 2 := min_le_left _ _
  have hd2 : δ ≤ 1 / (2 * (L + 1)) := min_le_right _ _
  have hm : 2 * (L + 1) * δ ≤ 1 := by
    have h := (le_div_iff₀ (by positivity : 0 < 2 * (L + 1))).mp hd2
    nlinarith
  have hLd : 0 ≤ L * δ := mul_nonneg hL hδ.le
  have ht : 2 * δ ≤ 1 := by nlinarith
  have hs : (2 * δ) ^ 2 ≤ 2 * δ := by nlinarith
  have hsmall : L * (2 * δ) ^ 2 ≤ 1 := by
    have h := mul_le_mul_of_nonneg_left hs hL
    nlinarith
  refine ⟨δ, hδ, by linarith, profile_nonneg δ, profile_zero δ, profile_pos δ 0 (by linarith), ?_⟩
  exact profile_deriv_lower hL hδ hsmall

end
end Source29RisingBarrierProfile

/- Component: CompactZeroSeparation.inc -/
namespace Source29CompactZeroSeparation

open Set
open scoped Topology

noncomputable section

/-- A strict inequality on the zero set extends to a uniform level strip
inside a compact set. -/
theorem strip_of_zero_inequality {E : Type*} [TopologicalSpace E]
    (K : Set E) (hK : IsCompact K) (F u : E → ℝ) (hF : Continuous F) (hu : Continuous u)
    (a : ℝ) (hzero : ∀ x ∈ K, F x = 0 → u x < a) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ K, |F x| < δ → u x < a := by
  let B := K ∩ {x | a ≤ u x}
  have hB : IsCompact B := hK.inter_right (isClosed_le continuous_const hu)
  have hpos : ∀ x ∈ B, 0 < |F x| := by
    intro x hx
    apply abs_pos.mpr
    intro hz
    exact (not_lt_of_ge hx.2) (hzero x hx.1 hz)
  obtain ⟨δ, hδ, hb⟩ := hB.exists_forall_le' hF.abs.continuousOn hpos
  refine ⟨δ, hδ, ?_⟩
  intro x hx hfx
  by_contra hux
  exact (not_lt_of_ge (hb x ⟨hx, le_of_not_gt hux⟩)) hfx

/-- Strict negativity on the compact zero locus supplies both a uniform
negative margin and a uniform strip on which it persists. -/
theorem negative_margin_strip {E : Type*} [TopologicalSpace E]
    (K : Set E) (hK : IsCompact K) (F u : E → ℝ) (hF : Continuous F) (hu : Continuous u)
    (hzero : ∀ x ∈ K, F x = 0 → u x < 0) :
    ∃ a δ : ℝ, 0 < a ∧ 0 < δ ∧ ∀ x ∈ K, |F x| < δ → u x ≤ -a := by
  let Z := K ∩ {x | F x = 0}
  have hZ : IsCompact Z := hK.inter_right (isClosed_eq hF continuous_const)
  have hp : ∀ x ∈ Z, 0 < -u x := by
    intro x hx
    exact neg_pos.mpr (hzero x hx.1 hx.2)
  obtain ⟨a, ha, hbound⟩ := hZ.exists_forall_le' hu.neg.continuousOn hp
  have hs : ∀ x ∈ K, F x = 0 → u x < -(a / 2) := by
    intro x hx hz
    have h := hbound x ⟨hx, hz⟩
    change a ≤ -u x at h
    linarith
  obtain ⟨δ, hδ, he⟩ := strip_of_zero_inequality K hK F u hF hu (-(a / 2)) hs
  exact ⟨a / 2, δ, by positivity, hδ, fun x hx hfx ↦ (he x hx hfx).le⟩

end
end Source29CompactZeroSeparation

/- Component: StrictTouchingField.inc -/
namespace Source29StrictTouchingField

open MvPolynomial Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial Source29PolynomialStress
open Source29NormalBall Source29NormalPenalty Source29GradientBarrierCalculus
open Source29RisingBarrierProfile Source29CompactZeroSeparation Source29LocalPhasePerimeter
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- A strict contact and a uniform corrected curvature estimate produce a
compact vector field whose tangential divergence is nonnegative near the
polynomial zero level and uniformly positive near the contact point. -/
theorem exists_strict_touching_field (F : MvPolynomial (Fin n) ℝ)
    {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin n → ℝ) (huc : u c = 0) (R : ℝ) (hR : 0 < R)
    (hcontact : ∀ x ∈ Metric.closedBall c R, eval x F = 0 → x ≠ c → u x < 0)
    (L ε : ℝ) (hL : 0 ≤ L) (hε : 0 < ε)
    (htrace : ∀ x ∈ Metric.closedBall c R, ∀ N ∈ normalBall n,
      ε ≤ projectedTrace (coordinateHessian u x) N + L * penalty (coordinateGradient u x) N) :
    ∃ (X : (Fin n → ℝ) → Fin n → ℝ) (δ s C : ℝ),
      (∀ j, ContDiff ℝ 1 (fun x ↦ X x j)) ∧
      (∀ j, HasCompactSupport (fun x ↦ X x j)) ∧
      0 < δ ∧ 0 < s ∧ 0 < C ∧
      (∀ x, |eval x F| < δ → 0 ≤ tangentialDivergence F X x) ∧
      (∀ x ∈ Metric.closedBall c s, |eval x F| < δ → C ≤ tangentialDivergence F X x) := by
  have hhalf : 0 < R / 2 := by positivity
  have hhalfR : R / 2 < R := by linarith
  obtain ⟨χ, hχ, hcχ, hsχ, hbχ, honeχ, hflatχ⟩ :=
    exists_local_cutoff (Metric.closedBall c (R / 2)) (Metric.ball c R)
      (isCompact_closedBall _ _) Metric.isOpen_ball (Metric.closedBall_subset_ball hhalfR)
  let A := Metric.closedBall c R \ Metric.ball c (R / 2)
  have hA : IsCompact A := (isCompact_closedBall c R).diff Metric.isOpen_ball
  have hzeroA : ∀ x ∈ A, eval x F = 0 → u x < 0 := by
    intro x hx hz
    apply hcontact x hx.1 hz
    intro he
    subst x
    exact hx.2 (Metric.mem_ball_self hhalf)
  obtain ⟨a, δa, ha, hδa, hmargin⟩ := negative_margin_strip A hA
    (fun x ↦ eval x F) u (contDiff_eval F).continuous hu.continuous hzeroA
  obtain ⟨d, hd, hda, hnonneg, _, hpos, hslope⟩ := exists_small_profile L hL a ha
  have hzeroB : ∀ x ∈ Metric.closedBall c R, eval x F = 0 → u x < d := by
    intro x hx hz
    by_cases he : x = c
    · simpa only [he, huc] using hd
    · exact (hcontact x hx hz he).trans hd
  obtain ⟨δb, hδb, hsmall⟩ := strip_of_zero_inequality (Metric.closedBall c R)
    (isCompact_closedBall _ _) (fun x ↦ eval x F) u (contDiff_eval F).continuous
    hu.continuous d hzeroB
  let δ := min δa δb
  have hδ : 0 < δ := lt_min hδa hδb
  let X := barrierField u χ (profile d)
  have hinner : ∀ x ∈ Metric.closedBall c (R / 2), |eval x F| < δ →
      profile d (u x) * ε ≤ tangentialDivergence F X x := by
    intro x hx hfx
    have hxR : x ∈ Metric.closedBall c R :=
      Metric.closedBall_subset_closedBall hhalfR.le hx
    have hux := hsmall x hxR (hfx.trans_le (min_le_right _ _))
    have hflat : coordinateGradient χ x = 0 := by
      ext i
      simp only [coordinateGradient, hflatχ x hx, ContinuousLinearMap.zero_apply, Pi.zero_apply]
    have h := barrierField_lower_at_flat_cutoff F hu hχ (profile_contDiff d) x
      (hbχ x).1 hflat (hnonneg _) L ε (hslope _ hux.le)
      (htrace x hxR _ (leadingNormalizedField_mem F x))
    simpa only [honeχ x hx, one_mul] using h
  have hnonnegative : ∀ x, |eval x F| < δ → 0 ≤ tangentialDivergence F X x := by
    intro x hfx
    by_cases hx : x ∈ Metric.closedBall c (R / 2)
    · exact (mul_nonneg (hnonneg _) hε.le).trans (hinner x hx hfx)
    · by_cases hxR : x ∈ Metric.closedBall c R
      · have hxA : x ∈ A := ⟨hxR, fun hb ↦ hx (Metric.ball_subset_closedBall hb)⟩
        have hux : u x ≤ -d := by
          have hm := hmargin x hxA (hfx.trans_le (min_le_left _ _))
          linarith
        change 0 ≤ tangentialDivergence F (barrierField u χ (profile d)) x
        rw [barrierField_tangentialDivergence F hu hχ (profile_contDiff d)]
        simp only [profile_zero d (u x) hux, profile_deriv_zero d (u x) hux,
          mul_zero, zero_mul, add_zero, le_refl]
      · have hxt : x ∉ tsupport χ :=
          fun ht ↦ hxR (Metric.ball_subset_closedBall (hsχ ht))
        have hχzero := image_eq_zero_of_notMem_tsupport hxt
        have hflat : coordinateGradient χ x = 0 := by
          ext i
          simp only [coordinateGradient, fderiv_of_notMem_tsupport ℝ hxt,
            ContinuousLinearMap.zero_apply, Pi.zero_apply]
        change 0 ≤ tangentialDivergence F (barrierField u χ (profile d)) x
        rw [barrierField_tangentialDivergence F hu hχ (profile_contDiff d)]
        simp only [hχzero, hflat, dot, Pi.zero_apply, mul_zero, zero_mul,
          Finset.sum_const_zero, sub_self, add_zero, le_refl]
  have hnear : ∀ᶠ x in 𝓝 c, profile d 0 / 2 < profile d (u x) := by
    have hc : ContinuousAt (fun x ↦ profile d (u x)) c :=
      ((profile_contDiff d).continuous.comp hu.continuous).continuousAt
    apply hc.eventually
    change ∀ᶠ y in 𝓝 (profile d (u c)), profile d 0 / 2 < y
    rw [huc]
    exact Ioi_mem_nhds (by linarith)
  obtain ⟨t, ht, htb⟩ := Metric.mem_nhds_iff.mp hnear
  let s := min (R / 2) (t / 2)
  have hs : 0 < s := lt_min hhalf (by positivity)
  let C := profile d 0 / 2 * ε
  have hC : 0 < C := mul_pos (by linarith) hε
  refine ⟨X, δ, s, C, barrierField_contDiff hu hχ (profile_contDiff d),
    barrierField_compact hcχ, hδ, hs, hC, hnonnegative, ?_⟩
  intro x hx hfx
  have hxi : x ∈ Metric.closedBall c (R / 2) :=
    Metric.closedBall_subset_closedBall (min_le_left _ _) hx
  have hxt : x ∈ Metric.ball c t :=
    Metric.closedBall_subset_ball (lt_of_le_of_lt (min_le_right _ _) (by linarith)) hx
  exact (mul_le_mul_of_nonneg_right (htb hxt).le hε.le).trans (hinner x hxi hfx)

end
end Source29StrictTouchingField

/- Component: StrictTouchingObstruction.inc -/
namespace Source29StrictTouchingObstruction

open MvPolynomial Filter Set
open Source29QuarticReuse.QuarticPolynomialBasics Source29QuarticReuse.FluxObstruction
open Source29PolynomialStress Source29NormalBall Source29NormalPenalty
open Source29GradientBarrierCalculus Source29StrictTouchingField
open Source29LocalPhasePerimeter Source29LocalizedStressBarrier Source29StressBarrier
open Source29TopPhasePerimeter Source29PhaseMassFunctional Source29PhaseMassLimit
open scoped Topology BigOperators

noncomputable section

/-- A leading zero admits no compact field with nonnegative tangential
divergence on a level strip and strictly positive divergence near that zero. -/
theorem top_no_positive_local_field (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (X : (Fin 8 → ℝ) → Fin 8 → ℝ)
    (hX : ∀ j, ContDiff ℝ 1 (fun x ↦ X x j))
    (hcX : ∀ j, HasCompactSupport (fun x ↦ X x j))
    (δ s C : ℝ) (hδ : 0 < δ) (hs : 0 < s) (hC : 0 < C)
    (hnonneg : ∀ x, |eval x (homogeneousComponent P.totalDegree P)| < δ →
      0 ≤ tangentialDivergence (homogeneousComponent P.totalDegree P) X x)
    (hpositive : ∀ x ∈ Metric.closedBall c s,
      |eval x (homogeneousComponent P.totalDegree P)| < δ →
      C ≤ tangentialDivergence (homogeneousComponent P.totalDegree P) X x) : False := by
  let F := homogeneousComponent P.totalDegree P
  have hF : F ≠ 0 := top_homogeneousComponent_ne_zero P (by omega)
  have hcal := top_weakCalibration P hmin hdeg
  obtain ⟨η, hη, hcη, hsη, hbη, honeη, _⟩ :=
    exists_local_cutoff (Metric.closedBall c (s / 2)) (Metric.ball c s)
      (isCompact_closedBall _ _) Metric.isOpen_ball
      (Metric.closedBall_subset_ball (by linarith))
  have hweight : ∀ x, |eval x F| < δ → C * η x ≤ tangentialDivergence F X x := by
    intro x hfx
    by_cases hx : x ∈ Metric.closedBall c s
    · exact (mul_le_of_le_one_right hC.le (hbη x).2).trans (hpositive x hx hfx)
    · have hzero : η x = 0 := image_eq_zero_of_notMem_tsupport
        (fun ht ↦ hx (Metric.ball_subset_closedBall (hsη ht)))
      simpa only [hzero, mul_zero] using hnonneg x hfx
  have hn := phaseMass_nonpos_of_strip F hF hcal X hX hcX
    (contDiff_const.mul hη) hcη.mul_left hδ hweight
  rw [phaseMass_const_mul F hF hcal hη hcη C] at hn
  have hp := top_phaseMass_pos_at_zero P hmin hdeg c hc (s / 2)
    (by positivity) hη hcη (fun x ↦ (hbη x).1) honeη
  exact (not_lt_of_ge hn) (mul_pos hC hp)

/-- The leading zero set cannot be touched strictly from above by a C2 test
whose level hypersurface has strictly positive tangential Hessian trace. -/
theorem top_no_strict_touching (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {u : (Fin 8 → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (huc : u c = 0) (hgrad : coordinateGradient u c ≠ 0)
    (r : ℝ) (hr : 0 < r)
    (hcontact : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → x ≠ c → u x < 0)
    (hcurv : 0 < trace (coordinateHessian u c) -
      quad (coordinateHessian u c) (coordinateGradient u c) / sqNorm (coordinateGradient u c)) :
    False := by
  obtain ⟨L, ε, hL, hε, hnear⟩ := test_local_normal_penalty hu c hgrad hcurv
  obtain ⟨t, ht, htb⟩ := Metric.mem_nhds_iff.mp hnear
  let R := min r (t / 2)
  have hR : 0 < R := lt_min hr (by positivity)
  have hRr : Metric.closedBall c R ⊆ Metric.closedBall c r :=
    Metric.closedBall_subset_closedBall (min_le_left _ _)
  have hRt : Metric.closedBall c R ⊆ Metric.ball c t :=
    Metric.closedBall_subset_ball (lt_of_le_of_lt (min_le_right _ _) (by linarith))
  obtain ⟨X, δ, s, C, hX, hcX, hδ, hs, hC, hnonneg, hpositive⟩ :=
    exists_strict_touching_field (homogeneousComponent P.totalDegree P) hu c huc R hR
      (fun x hx ↦ hcontact x (hRr hx)) L ε hL hε (fun x hx ↦ htb (hRt hx))
  exact top_no_positive_local_field P hmin hdeg c hc X hX hcX δ s C hδ hs hC hnonneg hpositive

end
end Source29StrictTouchingObstruction

/- Component: QuadraticStrictification.inc -/
namespace Source29QuadraticStrictification

open Source29QuarticReuse.FluxObstruction Source29NormalBall Source29NormalPenalty
open Source29GradientBarrierCalculus
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

def distanceSq (c x : Fin n → ℝ) : ℝ := ∑ i, (x i - c i) ^ 2

theorem distanceSq_contDiff (c : Fin n → ℝ) : ContDiff ℝ 2 (distanceSq c) := by
  unfold distanceSq
  fun_prop

theorem distanceSq_self (c : Fin n → ℝ) : distanceSq c c = 0 := by
  simp only [distanceSq, sub_self, zero_pow (by norm_num : 2 ≠ 0), Finset.sum_const_zero]

theorem distanceSq_pos (c x : Fin n → ℝ) (hx : x ≠ c) : 0 < distanceSq c x := by
  apply sqNorm_pos (v := x - c)
  exact sub_ne_zero.mpr hx

theorem distanceSq_hasFDerivAt (c x : Fin n → ℝ) :
    HasFDerivAt (distanceSq c)
      (∑ i, (2 * (x i - c i)) • (ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ)) x := by
  unfold distanceSq
  apply HasFDerivAt.fun_sum
  intro i _
  convert ((hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) i x).sub_const (c i)).pow 2
    using 1 <;> simp

theorem gradient_distanceSq (c x : Fin n → ℝ) (i : Fin n) :
    coordinateGradient (distanceSq c) x i = 2 * (x i - c i) := by
  unfold coordinateGradient
  rw [(distanceSq_hasFDerivAt c x).fderiv]
  simp [Pi.single_apply]

def strictify (u : (Fin n → ℝ) → ℝ) (c : Fin n → ℝ) (γ : ℝ) (x : Fin n → ℝ) : ℝ :=
  u x - γ * distanceSq c x

theorem strictify_contDiff {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin n → ℝ) (γ : ℝ) : ContDiff ℝ 2 (strictify u c γ) :=
  hu.sub (contDiff_const.mul (distanceSq_contDiff c))

theorem strictify_self (u : (Fin n → ℝ) → ℝ) (c : Fin n → ℝ) (γ : ℝ) :
    strictify u c γ c = u c := by
  simp only [strictify, distanceSq_self, mul_zero, sub_zero]

theorem gradient_strictify {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c x : Fin n → ℝ) (γ : ℝ) (i : Fin n) :
    coordinateGradient (strictify u c γ) x i = coordinateGradient u x i -
      (2 * γ) * (x i - c i) := by
  have hu1 : ContDiff ℝ 1 u := hu.of_le (by norm_num)
  have hd := ((hu1.differentiable (by norm_num) x).hasFDerivAt).sub
    ((distanceSq_hasFDerivAt c x).const_mul γ)
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  change fderiv ℝ (strictify u c γ) x (Pi.single i 1) = _ at he
  unfold coordinateGradient
  simp [Pi.single_apply] at he
  rw [he]
  ring

theorem gradient_strictify_self {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin n → ℝ) (γ : ℝ) : coordinateGradient (strictify u c γ) c = coordinateGradient u c := by
  ext i
  simp only [gradient_strictify hu, sub_self, mul_zero, sub_zero]

theorem hessian_strictify {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c x : Fin n → ℝ) (γ : ℝ) (i j : Fin n) :
    coordinateHessian (strictify u c γ) x i j = coordinateHessian u x i j -
      (if i = j then 2 * γ else 0) := by
  change fderiv ℝ (fun y ↦ coordinateGradient (strictify u c γ) y j) x (Pi.single i 1) = _
  simp_rw [gradient_strictify hu]
  have hd := (((gradient_contDiff hu j).differentiable (by norm_num) x).hasFDerivAt).sub
    (((hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) j x).sub_const (c j)).const_mul (2 * γ))
  change HasFDerivAt (fun y ↦ coordinateGradient u y j - (2 * γ) * (y j - c j)) _ x at hd
  rw [hd.fderiv]
  simp [coordinateHessian, coordinateJacobian, Pi.single_apply, eq_comm]

/-- The tangential Hessian trace loses exactly twice the perturbation size
for each tangent dimension. -/
theorem curvature_strictify {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin n → ℝ) (γ : ℝ) (hv : coordinateGradient u c ≠ 0) :
    trace (coordinateHessian (strictify u c γ) c) -
        quad (coordinateHessian (strictify u c γ) c) (coordinateGradient (strictify u c γ) c) /
          sqNorm (coordinateGradient (strictify u c γ) c) =
      trace (coordinateHessian u c) - quad (coordinateHessian u c) (coordinateGradient u c) /
        sqNorm (coordinateGradient u c) - 2 * γ * ((n : ℝ) - 1) := by
  have htr : trace (coordinateHessian (strictify u c γ) c) =
      trace (coordinateHessian u c) - (n : ℝ) * (2 * γ) := by
    unfold trace
    simp only [hessian_strictify hu, ite_true, Finset.sum_sub_distrib,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hq (v : Fin n → ℝ) : quad (coordinateHessian (strictify u c γ) c) v =
      quad (coordinateHessian u c) v - (2 * γ) * sqNorm v := by
    unfold quad sqNorm
    simp_rw [hessian_strictify hu, sub_mul, Finset.sum_sub_distrib]
    congr 1
    simp [Finset.mul_sum, Pi.single_apply, pow_two, mul_assoc]
  rw [gradient_strictify_self hu, htr, hq]
  have hs := ne_of_gt (sqNorm_pos hv)
  field_simp
  <;> ring

end
end Source29QuadraticStrictification

/- Component: TouchingMaximumPrinciple.inc -/
namespace Source29TouchingMaximumPrinciple

open MvPolynomial
open Source29NormalBall Source29NormalPenalty Source29GradientBarrierCalculus
open Source29StrictTouchingObstruction Source29QuadraticStrictification
open scoped Topology BigOperators

noncomputable section

/-- A smooth test attaining a local maximum on the leading zero set has
nonpositive tangential Hessian trace whenever its gradient is nonzero.
No regularity of the polynomial zero set at the contact point is assumed. -/
theorem top_touching_trace_nonpos (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {u : (Fin 8 → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (huc : u c = 0) (hgrad : coordinateGradient u c ≠ 0)
    (r : ℝ) (hr : 0 < r)
    (hcontact : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → u x ≤ 0) :
    trace (coordinateHessian u c) - quad (coordinateHessian u c) (coordinateGradient u c) /
      sqNorm (coordinateGradient u c) ≤ 0 := by
  by_contra hn
  have hk : 0 < trace (coordinateHessian u c) -
      quad (coordinateHessian u c) (coordinateGradient u c) / sqNorm (coordinateGradient u c) :=
    lt_of_not_ge hn
  let κ := trace (coordinateHessian u c) -
    quad (coordinateHessian u c) (coordinateGradient u c) / sqNorm (coordinateGradient u c)
  let γ := κ / 28
  have hγ : 0 < γ := div_pos hk (by norm_num)
  have hcurv : 0 < trace (coordinateHessian (strictify u c γ) c) -
      quad (coordinateHessian (strictify u c γ) c) (coordinateGradient (strictify u c γ) c) /
        sqNorm (coordinateGradient (strictify u c γ) c) := by
    rw [curvature_strictify hu c γ hgrad]
    change 0 < κ - 2 * (κ / 28) * ((8 : ℝ) - 1)
    change 0 < κ at hk
    linarith
  apply top_no_strict_touching P hmin hdeg (strictify_contDiff hu c γ) c hc
    (by rw [strictify_self, huc])
    (by rwa [gradient_strictify_self hu]) r hr _ hcurv
  intro x hx hz hxc
  have hux := hcontact x hx hz
  have hq := mul_pos hγ (distanceSq_pos c x hxc)
  change u x - γ * distanceSq c x < 0
  linarith

end
end Source29TouchingMaximumPrinciple

/- Component: TouchingExtrema.inc -/
namespace Source29TouchingExtrema

open MvPolynomial
open Source29NormalBall Source29NormalPenalty Source29GradientBarrierCalculus
open Source29TouchingMaximumPrinciple
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem gradient_sub_const (u : (Fin n → ℝ) → ℝ) (a : ℝ) (x : Fin n → ℝ) :
    coordinateGradient (fun y ↦ u y - a) x = coordinateGradient u x := by
  ext i
  simp only [coordinateGradient, fderiv_sub_const]

theorem hessian_sub_const (u : (Fin n → ℝ) → ℝ) (a : ℝ) (x : Fin n → ℝ) :
    coordinateHessian (fun y ↦ u y - a) x = coordinateHessian u x := by
  unfold coordinateHessian coordinateJacobian
  simp only [gradient_sub_const]

theorem gradient_neg (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i : Fin n) :
    coordinateGradient (fun y ↦ -u y) x i = -coordinateGradient u x i := by
  simp only [coordinateGradient, fderiv_fun_neg, ContinuousLinearMap.neg_apply]

theorem hessian_neg (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) (i j : Fin n) :
    coordinateHessian (fun y ↦ -u y) x i j = -coordinateHessian u x i j := by
  unfold coordinateHessian coordinateJacobian
  simp only [gradient_neg, fderiv_fun_neg, ContinuousLinearMap.neg_apply]

theorem curvature_neg (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) :
    trace (coordinateHessian (fun y ↦ -u y) x) -
        quad (coordinateHessian (fun y ↦ -u y) x) (coordinateGradient (fun y ↦ -u y) x) /
          sqNorm (coordinateGradient (fun y ↦ -u y) x) =
      -(trace (coordinateHessian u x) - quad (coordinateHessian u x) (coordinateGradient u x) /
        sqNorm (coordinateGradient u x)) := by
  simp only [trace, quad, sqNorm, hessian_neg, gradient_neg, neg_sq, neg_mul, mul_neg,
    neg_neg, Finset.sum_neg_distrib, neg_div]
  ring

/-- The local maximum principle without a normalization on the test value. -/
theorem top_local_maximum_trace_nonpos (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {u : (Fin 8 → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (hgrad : coordinateGradient u c ≠ 0) (r : ℝ) (hr : 0 < r)
    (hcontact : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → u x ≤ u c) :
    trace (coordinateHessian u c) - quad (coordinateHessian u c) (coordinateGradient u c) /
      sqNorm (coordinateGradient u c) ≤ 0 := by
  have h := top_touching_trace_nonpos P hmin hdeg (hu.sub contDiff_const) c hc
    (sub_self (u c)) (by rwa [gradient_sub_const]) r hr
    (fun x hx hz ↦ sub_nonpos.mpr (hcontact x hx hz))
  simpa only [gradient_sub_const, hessian_sub_const] using h

/-- The dual local minimum principle on the same, possibly singular, zero set. -/
theorem top_local_minimum_trace_nonneg (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {u : (Fin 8 → ℝ) → ℝ} (hu : ContDiff ℝ 2 u)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (hgrad : coordinateGradient u c ≠ 0) (r : ℝ) (hr : 0 < r)
    (hcontact : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → u c ≤ u x) :
    0 ≤ trace (coordinateHessian u c) - quad (coordinateHessian u c) (coordinateGradient u c) /
      sqNorm (coordinateGradient u c) := by
  have hneg : coordinateGradient (fun y ↦ -u y) c ≠ 0 := by
    intro hz
    apply hgrad
    ext i
    have hi := congrFun hz i
    simpa only [gradient_neg, Pi.zero_apply, neg_eq_zero] using hi
  have h := top_local_maximum_trace_nonpos P hmin hdeg hu.neg c hc hneg r hr
    (fun x hx hz ↦ neg_le_neg (hcontact x hx hz))
  rw [curvature_neg] at h
  linarith

end
end Source29TouchingExtrema

/- Component: SquarePerturbation.inc -/
namespace Source29SquarePerturbation

open Source29NormalBall Source29NormalPenalty Source29GradientBarrierCalculus
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem gradient_square {g : (Fin n → ℝ) → ℝ} (hg : ContDiff ℝ 2 g)
    (x : Fin n → ℝ) (i : Fin n) :
    coordinateGradient (fun y ↦ (g y) ^ 2) x i = 2 * g x * coordinateGradient g x i := by
  have hg1 : ContDiff ℝ 1 g := hg.of_le (by norm_num)
  have hd := ((hg1.differentiable (by norm_num) x).hasFDerivAt).pow 2
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  simpa [coordinateGradient] using he

theorem hessian_square {g : (Fin n → ℝ) → ℝ} (hg : ContDiff ℝ 2 g)
    (x : Fin n → ℝ) (i j : Fin n) :
    coordinateHessian (fun y ↦ (g y) ^ 2) x i j =
      2 * coordinateGradient g x i * coordinateGradient g x j +
        2 * g x * coordinateHessian g x i j := by
  change fderiv ℝ (fun y ↦ coordinateGradient (fun z ↦ (g z) ^ 2) y j) x (Pi.single i 1) = _
  simp_rw [gradient_square hg]
  have hg1 : ContDiff ℝ 1 g := hg.of_le (by norm_num)
  have hd := (((hg1.differentiable (by norm_num) x).hasFDerivAt).const_mul 2).fun_mul
    (((gradient_contDiff hg j).differentiable (by norm_num) x).hasFDerivAt)
  rw [hd.fderiv]
  simp only [ContinuousLinearMap.add_apply, _root_.smul_apply, smul_eq_mul]
  change (2 * g x) * coordinateHessian g x i j +
    coordinateGradient g x j * (2 * coordinateGradient g x i) = _
  ring

theorem gradient_add {f g : (Fin n → ℝ) → ℝ} (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g)
    (x : Fin n → ℝ) (i : Fin n) :
    coordinateGradient (fun y ↦ f y + g y) x i = coordinateGradient f x i + coordinateGradient g x i := by
  have hf1 : ContDiff ℝ 1 f := hf.of_le (by norm_num)
  have hg1 : ContDiff ℝ 1 g := hg.of_le (by norm_num)
  unfold coordinateGradient
  rw [fderiv_fun_add (hf1.differentiable (by norm_num) x) (hg1.differentiable (by norm_num) x)]
  rfl

theorem hessian_add {f g : (Fin n → ℝ) → ℝ} (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g)
    (x : Fin n → ℝ) (i j : Fin n) :
    coordinateHessian (fun y ↦ f y + g y) x i j = coordinateHessian f x i j + coordinateHessian g x i j := by
  change fderiv ℝ (fun y ↦ coordinateGradient (fun z ↦ f z + g z) y j) x (Pi.single i 1) = _
  simp_rw [gradient_add hf hg]
  rw [fderiv_fun_add ((gradient_contDiff hf j).differentiable (by norm_num) x)
    ((gradient_contDiff hg j).differentiable (by norm_num) x)]
  rfl

theorem gradient_add_square_at_zero {f g : (Fin n → ℝ) → ℝ}
    (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g) (c : Fin n → ℝ) (hgc : g c = 0) :
    coordinateGradient (fun x ↦ f x + (g x) ^ 2) c = coordinateGradient f c := by
  ext i
  simp only [gradient_add hf (hg.pow 2), gradient_square hg, hgc, mul_zero, zero_mul, add_zero]

theorem curvature_add_square_at_zero {f g : (Fin n → ℝ) → ℝ}
    (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g) (c : Fin n → ℝ) (hgc : g c = 0) :
    trace (coordinateHessian (fun x ↦ f x + (g x) ^ 2) c) -
        quad (coordinateHessian (fun x ↦ f x + (g x) ^ 2) c)
          (coordinateGradient (fun x ↦ f x + (g x) ^ 2) c) /
        sqNorm (coordinateGradient (fun x ↦ f x + (g x) ^ 2) c) =
      (trace (coordinateHessian f c) - quad (coordinateHessian f c) (coordinateGradient f c) /
        sqNorm (coordinateGradient f c)) +
      2 * (sqNorm (coordinateGradient g c) -
        (dot (coordinateGradient f c) (coordinateGradient g c)) ^ 2 / sqNorm (coordinateGradient f c)) := by
  let v := coordinateGradient f c
  let w := coordinateGradient g c
  have hj (i j : Fin n) : coordinateHessian (fun x ↦ f x + (g x) ^ 2) c i j =
      coordinateHessian f c i j + 2 * w i * w j := by
    simp only [hessian_add hf (hg.pow 2), hessian_square hg, hgc, mul_zero, zero_mul, add_zero]
    rfl
  have htr : trace (coordinateHessian (fun x ↦ f x + (g x) ^ 2) c) =
      trace (coordinateHessian f c) + 2 * sqNorm w := by
    unfold trace
    simp_rw [hj]
    simp only [Finset.sum_add_distrib, sqNorm, pow_two, Finset.mul_sum, mul_assoc]
  have hq : quad (coordinateHessian (fun x ↦ f x + (g x) ^ 2) c) v =
      quad (coordinateHessian f c) v + 2 * (dot v w) ^ 2 := by
    have hr : (∑ i, ∑ j, (2 * w i * w j) * v i * v j) = 2 * (dot v w) ^ 2 := by
      calc
        _ = ∑ i, (2 * (v i * w i)) * (∑ j, v j * w j) := by
          apply Finset.sum_congr rfl
          intro i _
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro j _
          ring
        _ = _ := by rw [← Finset.sum_mul, ← Finset.mul_sum]; unfold dot; ring
    simpa only [quad, hj, add_mul, Finset.sum_add_distrib, hr]
  rw [gradient_add_square_at_zero hf hg c hgc, htr]
  change trace (coordinateHessian f c) + 2 * sqNorm w -
    quad (coordinateHessian (fun x ↦ f x + (g x) ^ 2) c) v / sqNorm v = _
  rw [hq]
  dsimp only [v, w]
  ring

end
end Source29SquarePerturbation

/- Component: VanishingGradientRigidity.inc -/
namespace Source29VanishingGradientRigidity

open MvPolynomial
open Source29NormalBall Source29NormalPenalty Source29GradientBarrierCalculus
open Source29TouchingExtrema Source29SquarePerturbation
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

/-- The transverse squared norm is positive unless the second vector is a
scalar multiple of the first. This is the strict Cauchy equality case. -/
theorem transverse_part_pos (v w : Fin n → ℝ) (hv : v ≠ 0)
    (hn : ¬∃ a : ℝ, w = fun i ↦ a * v i) :
    0 < sqNorm w - (dot v w) ^ 2 / sqNorm v := by
  let a := dot v w / sqNorm v
  have hr : (fun i ↦ w i - a * v i) ≠ 0 := by
    intro he
    apply hn
    refine ⟨a, funext fun i ↦ ?_⟩
    have hi := congrFun he i
    exact sub_eq_zero.mp hi
  have hs := ne_of_gt (sqNorm_pos hv)
  have he : sqNorm (fun i ↦ w i - a * v i) = sqNorm w - (dot v w) ^ 2 / sqNorm v := by
    change (∑ i, (w i - a * v i) ^ 2) = _
    rw [residual_sq]
    dsimp only [a]
    field_simp
    <;> ring
  rw [← he]
  exact sqNorm_pos hr

/-- Two C2 functions vanishing on the leading zero set near a point cannot
have independent gradients there. In particular, that zero set cannot lie
locally in a regular codimension-two intersection. -/
theorem vanishing_gradients_parallel (P : MvPolynomial (Fin 8) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {f g : (Fin 8 → ℝ) → ℝ} (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g)
    (c : Fin 8 → ℝ) (hc : eval c (homogeneousComponent P.totalDegree P) = 0)
    (hv : coordinateGradient f c ≠ 0) (r : ℝ) (hr : 0 < r)
    (hfzero : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → f x = 0)
    (hgzero : ∀ x ∈ Metric.closedBall c r,
      eval x (homogeneousComponent P.totalDegree P) = 0 → g x = 0) :
    ∃ a : ℝ, coordinateGradient g c = fun i ↦ a * coordinateGradient f c i := by
  by_contra hn
  have hp := transverse_part_pos (coordinateGradient f c) (coordinateGradient g c) hv hn
  have hfc := hfzero c (Metric.mem_closedBall_self hr.le) hc
  have hgc := hgzero c (Metric.mem_closedBall_self hr.le) hc
  have hupper := top_local_maximum_trace_nonpos P hmin hdeg hf c hc hv r hr (by
    intro x hx hz
    rw [hfzero x hx hz, hfc])
  have hlower := top_local_minimum_trace_nonneg P hmin hdeg hf c hc hv r hr (by
    intro x hx hz
    rw [hfzero x hx hz, hfc])
  have hgrad : coordinateGradient (fun x ↦ f x + (g x) ^ 2) c ≠ 0 := by
    rwa [gradient_add_square_at_zero hf hg c hgc]
  have hpert := top_local_maximum_trace_nonpos P hmin hdeg (hf.add (hg.pow 2)) c hc hgrad r hr (by
    intro x hx hz
    simp only [hfzero x hx hz, hgzero x hx hz, hfc, hgc, zero_pow (by norm_num : 2 ≠ 0), add_zero]
    exact le_rfl)
  rw [curvature_add_square_at_zero hf hg c hgc] at hpert
  linarith

end
end Source29VanishingGradientRigidity

/- Component: CriticalHessian.inc -/
namespace Source29CriticalHessian

open MvPolynomial Source29FactorInheritance Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- At a critical point of a polynomial solving the homogeneous minimal
operator, the quadratic Hessian terms satisfy the polarized cubic relation. -/
theorem critical_second_trace (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hL : cubicOperator P = 0) (hg : gradientAt P x = 0) (a b : ι) :
    (∑ i, realHessian P x a i * realHessian P x b i) * (∑ j, realHessian P x j j) =
      ∑ i, ∑ j, realHessian P x a i * realHessian P x b j * realHessian P x i j := by
  have hz (i : ι) : eval x (pderiv i P) = 0 := congrFun hg i
  have htwo : pderiv a (2 : MvPolynomial ι ℝ) = 0 := by
    simpa only [map_ofNat] using (pderiv_C (i := a) (a := (2 : ℝ)))
  have he := congrArg (eval x) (congrArg (pderiv a) (congrArg (pderiv b) hL))
  simp [cubicOperator, pderiv_mul, pderiv_pow, hz, htwo] at he
  have hswap : (∑ i, ∑ j, realHessian P x b i * realHessian P x a j * realHessian P x i j) =
      ∑ i, ∑ j, realHessian P x a i * realHessian P x b j * realHessian P x i j := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    have hs := realHessian_symmetric P x
    have hij : realHessian P x j i = realHessian P x i j := congrFun (congrFun hs i) j
    rw [hij]
    ring
  simp only [← realHessian_apply, mul_add, add_mul, Finset.sum_add_distrib,
    ← Finset.mul_sum, ← Finset.sum_mul] at he
  simp only [mul_comm, mul_left_comm, mul_assoc] at he hswap ⊢
  rw [hswap] at he
  linarith

/-- The critical Hessian satisfies H cubed = trace(H) times H squared. -/
theorem critical_hessian_cubic (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hL : cubicOperator P = 0) (hg : gradientAt P x = 0) :
    let H := realHessian P x
    H * (H * H) = Matrix.trace H • (H * H) := by
  let H := realHessian P x
  change H * (H * H) = Matrix.trace H • (H * H)
  have hs (i j : ι) : H i j = H j i := ((realHessian_symmetric P x).apply i j).symm
  ext a b
  calc
    (H * (H * H)) a b = ∑ i, ∑ j, H a i * H b j * H i j := by
      simp only [Matrix.mul_apply, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      rw [hs j b]
      ring
    _ = (∑ i, H a i * H b i) * Matrix.trace H := (critical_second_trace P x hL hg a b).symm
    _ = (Matrix.trace H • (H * H)) a b := by
      change _ = Matrix.trace H * ∑ i, H a i * H i b
      rw [mul_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [hs b i]

/-- Symmetry removes a factor from the critical cubic matrix identity. -/
theorem symmetric_square_of_cubic (H : Matrix ι ι ℝ) (hH : H.IsSymm)
    (hc : H * (H * H) = Matrix.trace H • (H * H)) :
    H * H = Matrix.trace H • H := by
  have hh : H.conjTranspose = H := by
    rw [Matrix.conjTranspose_eq_transpose_of_trivial]
    exact hH
  have hz : (H.conjTranspose * H) * (H - Matrix.trace H • 1) = 0 := by
    rw [hh, Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, Matrix.mul_assoc, hc, sub_self]
  have hn := (Matrix.conjTranspose_mul_self_mul_eq_zero H (H - Matrix.trace H • 1)).mp hz
  simpa only [Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, sub_eq_zero] using hn

theorem critical_hessian_square (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hL : cubicOperator P = 0) (hg : gradientAt P x = 0) :
    let H := realHessian P x
    H * H = Matrix.trace H • H :=
  symmetric_square_of_cubic _ (realHessian_symmetric P x) (critical_hessian_cubic P x hL hg)

end
end Source29CriticalHessian

/- Component: CriticalCurvatureAlgebra.inc -/
namespace Source29CriticalCurvatureAlgebra

open Source29CurvaturePotentialAlgebra Source29CurvatureScaling
open Source29QuarticReuse.CubicMatrix
open scoped BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def normalCurvatureSq (H : Matrix ι ι ℝ) (N : ι → ℝ) : ℝ :=
  matrixSq H - 2 * vectorSq (H *ᵥ N) + (N ⬝ᵥ (H *ᵥ N)) ^ 2

def normalTrace (H : Matrix ι ι ℝ) (N : ι → ℝ) : ℝ :=
  Matrix.trace H - N ⬝ᵥ (H *ᵥ N)

theorem matrixSq_eq_trace_square (H : Matrix ι ι ℝ) (hH : H.IsSymm) :
    matrixSq H = Matrix.trace (H * H) := by
  simp only [matrixSq, Matrix.trace, Matrix.diag, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [hH.apply i j]
  ring

/-- A critical Hessian's normal curvature expression is exactly the square
of its normal trace, uniformly over all normal vectors. -/
theorem normalCurvatureSq_eq_trace_sq (H : Matrix ι ι ℝ) (hH : H.IsSymm)
    (hs : H * H = Matrix.trace H • H) (N : ι → ℝ) :
    normalCurvatureSq H N = (normalTrace H N) ^ 2 := by
  have hm : matrixSq H = (Matrix.trace H) ^ 2 := by
    rw [matrixSq_eq_trace_square H hH, hs, Matrix.trace_smul]
    simp only [smul_eq_mul, pow_two]
  have hv : vectorSq (H *ᵥ N) = Matrix.trace H * (N ⬝ᵥ (H *ᵥ N)) := by
    unfold vectorSq
    rw [dot_move H hH, Matrix.mulVec_mulVec, hs, Matrix.smul_mulVec, dotProduct_smul]
    rfl
  unfold normalCurvatureSq normalTrace
  rw [hm, hv]
  ring

theorem normalCurvatureSq_normalize (H : Matrix ι ι ℝ) (v : ι → ℝ)
    (t : ℝ) (ht : t ≠ 0) (hs : t ^ 2 = vectorSq v) :
    normalCurvatureSq H (t⁻¹ • v) = vectorSq v * potential v H := by
  have hv : vectorSq v ≠ 0 := by rw [← hs]; exact pow_ne_zero _ ht
  unfold normalCurvatureSq potential
  rw [Matrix.mulVec_smul, vectorSq_smul, smul_dotProduct, dotProduct_smul]
  simp only [smul_eq_mul]
  rw [← hs]
  field_simp
  <;> ring

theorem normalTrace_normalize (H : Matrix ι ι ℝ) (v : ι → ℝ)
    (t : ℝ) (ht : t ≠ 0) (hs : t ^ 2 = vectorSq v) :
    normalTrace H (t⁻¹ • v) = Matrix.trace H - (v ⬝ᵥ (H *ᵥ v)) / vectorSq v := by
  unfold normalTrace
  rw [Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul]
  simp only [smul_eq_mul]
  rw [← hs]
  field_simp
  <;> ring

end
end Source29CriticalCurvatureAlgebra

/- Component: WeightedCurvatureContinuity.inc -/
namespace Source29WeightedCurvatureContinuity

open MvPolynomial Filter
open Source29PolynomialCurvaturePotential Source29CurvaturePotentialAlgebra
open Source29CriticalHessian Source29CriticalCurvatureAlgebra Source29AnalyticTensorNorm
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic Source29QuarticReuse.FluxPolynomial
open scoped BigOperators Matrix Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def normalized (v : ι → ℝ) : ι → ℝ := (tensorNorm v)⁻¹ • v

theorem tensorNorm_sq_eq (v : ι → ℝ) : (tensorNorm v) ^ 2 = vectorSq v := by
  simpa only [vectorSq, dotProduct, pow_two] using tensorNorm_sq v

theorem normalized_mem_cube (v : ι → ℝ) :
    normalized v ∈ Set.Icc (fun _ ↦ (-1 : ℝ)) (fun _ ↦ (1 : ℝ)) := by
  by_cases hv : v = 0
  · subst v
    simp only [normalized, smul_zero, Set.mem_Icc]
    exact ⟨fun _ ↦ by norm_num, fun _ ↦ by norm_num⟩
  have ht := tensorNorm_pos hv
  have hb (i : ι) : |normalized v i| ≤ 1 := by
    have hi : |v i| ≤ tensorNorm v := Real.abs_le_sqrt
      (Finset.single_le_sum (fun j _ ↦ sq_nonneg (v j)) (Finset.mem_univ i))
    change |(tensorNorm v)⁻¹ * v i| ≤ 1
    rw [abs_mul, abs_inv, abs_of_pos ht, ← div_eq_inv_mul]
    exact (div_le_one ht).mpr hi
  exact ⟨fun i ↦ (abs_le.mp (hb i)).1, fun i ↦ (abs_le.mp (hb i)).2⟩

def weightedCurvatureSq (P : MvPolynomial ι ℝ) (x : ι → ℝ) : ℝ :=
  vectorSq (gradientAt P x) * curvaturePotential P x

theorem weightedCurvatureSq_zero (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hg : gradientAt P x = 0) : weightedCurvatureSq P x = 0 := by
  simp only [weightedCurvatureSq, hg, vectorSq, dotProduct_zero, zero_mul]

theorem weightedCurvatureSq_normal (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hg : gradientAt P x ≠ 0) :
    weightedCurvatureSq P x = normalCurvatureSq (realHessian P x) (normalized (gradientAt P x)) :=
  (normalCurvatureSq_normalize _ _ _ (tensorNorm_pos hg).ne' (tensorNorm_sq_eq _)).symm

theorem normalTrace_zero (P : MvPolynomial ι ℝ) (x : ι → ℝ)
    (hL : Source29FactorInheritance.cubicOperator P = 0) (hg : gradientAt P x ≠ 0) :
    normalTrace (realHessian P x) (normalized (gradientAt P x)) = 0 := by
  rw [normalized, normalTrace_normalize _ _ _ (tensorNorm_pos hg).ne' (tensorNorm_sq_eq _)]
  have hv : vectorSq (gradientAt P x) ≠ 0 := by
    rw [← tensorNorm_sq_eq]
    exact pow_ne_zero _ (tensorNorm_pos hg).ne'
  have he := congrArg (eval x) hL
  simp only [Source29FactorInheritance.cubicOperator, map_sub, map_mul, map_sum, map_pow, map_zero] at he
  have hq : (gradientAt P x) ⬝ᵥ (realHessian P x *ᵥ gradientAt P x) =
      ∑ i, ∑ j, eval x (pderiv i P) * eval x (pderiv j P) * eval x (pderiv i (pderiv j P)) := by
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum, gradientAt, realHessian_apply]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [hq]
  unfold vectorSq gradientAt Matrix.trace Matrix.diag
  simp only [dotProduct, ← pow_two, realHessian_apply]
  apply sub_eq_zero.mpr
  have hv' : (∑ i, (eval x (pderiv i P)) ^ 2) ≠ 0 := by
    simpa only [vectorSq, gradientAt, dotProduct, pow_two] using hv
  apply (eq_div_iff hv').mpr
  nlinarith [he]

/-- Compactness of the normal cube makes the critical Hessian identity
uniform in the possibly discontinuous choice of normalized gradient. -/
theorem residual_eventually_small {E : Type*} [TopologicalSpace E]
    (H : E → Matrix ι ι ℝ) (hH : ∀ i j, Continuous (fun x ↦ H x i j))
    (c : E) (hsym : (H c).IsSymm) (hs : H c * H c = Matrix.trace (H c) • H c)
    (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ x in 𝓝 c, ∀ N ∈ Set.Icc (fun _ : ι ↦ (-1 : ℝ)) (fun _ ↦ (1 : ℝ)),
      |normalCurvatureSq (H x) N - (normalTrace (H x) N) ^ 2| < ε := by
  have hf : Continuous (fun z : E × (ι → ℝ) ↦
      |normalCurvatureSq (H z.1) z.2 - (normalTrace (H z.1) z.2) ^ 2|) := by
    unfold normalCurvatureSq normalTrace matrixSq vectorSq Matrix.trace Matrix.diag dotProduct Matrix.mulVec
    fun_prop
  apply (isCompact_Icc : IsCompact (Set.Icc (fun _ : ι ↦ (-1 : ℝ)) (fun _ ↦ (1 : ℝ)))).eventually_forall_of_forall_eventually
  intro N hN
  apply (isOpen_lt hf continuous_const).mem_nhds
  change |normalCurvatureSq (H c) N - (normalTrace (H c) N) ^ 2| < ε
  rw [normalCurvatureSq_eq_trace_sq _ hsym hs, sub_self, abs_zero]
  exact hε

/-- Multiplying curvature squared by gradient squared removes its apparent
singularity at every critical point of a polynomial satisfying L(P)=0. -/
theorem weightedCurvatureSq_continuousAt_critical (P : MvPolynomial ι ℝ)
    (hL : Source29FactorInheritance.cubicOperator P = 0) (c : ι → ℝ)
    (hc : gradientAt P c = 0) : ContinuousAt (weightedCurvatureSq P) c := by
  rw [ContinuousAt, weightedCurvatureSq_zero P c hc]
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  have hh (i j : ι) : Continuous (fun x ↦ realHessian P x i j) :=
    (contDiff_eval (pderiv i (pderiv j P))).continuous
  filter_upwards [residual_eventually_small (realHessian P) hh c (realHessian_symmetric P c)
    (critical_hessian_square P c hL hc) ε hε] with x hx
  rw [Real.dist_eq, sub_zero]
  by_cases hg : gradientAt P x = 0
  · simpa only [weightedCurvatureSq_zero P x hg, abs_zero] using hε
  · have hn := hx (normalized (gradientAt P x)) (normalized_mem_cube _)
    rwa [normalTrace_zero P x hL hg, zero_pow (by norm_num : 2 ≠ 0), sub_zero,
      ← weightedCurvatureSq_normal P x hg] at hn

theorem weightedCurvatureSq_continuous (P : MvPolynomial ι ℝ)
    (hL : Source29FactorInheritance.cubicOperator P = 0) : Continuous (weightedCurvatureSq P) := by
  apply continuous_iff_continuousAt.mpr
  intro c
  by_cases hc : gradientAt P c = 0
  · exact weightedCurvatureSq_continuousAt_critical P hL c hc
  · apply ContinuousAt.mul
    · exact (continuous_finsetSum _ (fun i _ ↦
        (contDiff_eval (pderiv i P)).continuous.mul (contDiff_eval (pderiv i P)).continuous)).continuousAt
    · exact (Source29PolynomialCurvatureRegularity.curvaturePotential_analyticAt P c hc).continuousAt

end
end Source29WeightedCurvatureContinuity

/- Component: SingularLinkDegreeBound.inc -/
namespace Source29SingularLinkDegreeBound

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialCurvatureRegularity
open Source29WeightedCurvatureContinuity Source29CurvaturePotentialAlgebra Source29AnalyticTensorNorm
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem ratio_eq_sqrt_weighted (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι) :
    curvatureNorm P x / jacobiProfile P x = Real.sqrt (weightedCurvatureSq P x) := by
  have hv : 0 ≤ vectorSq (gradientAt P x) := by
    rw [← tensorNorm_sq_eq]
    exact sq_nonneg _
  rw [weightedCurvatureSq, Real.sqrt_mul hv]
  unfold curvatureNorm jacobiProfile tensorNorm gradientAt vectorSq
  simp only [div_inv_eq_mul, dotProduct, ← pow_two]
  ring

theorem ratio_continuous (P : MvPolynomial (Option (Option ι)) ℝ)
    (hL : Source29FactorInheritance.cubicOperator P = 0) :
    Continuous (fun x : Ambient ι => curvatureNorm P x / jacobiProfile P x) := by
  have he : (fun x : Ambient ι => curvatureNorm P x / jacobiProfile P x) =
      (fun x => Real.sqrt (weightedCurvatureSq P x)) := funext (ratio_eq_sqrt_weighted P)
  rw [he]
  exact Real.continuous_sqrt.comp (weightedCurvatureSq_continuous P hL)

/-- The weighted curvature is continuous across critical points, so compact
comparison needs no global regularity assumption. -/
theorem homogeneous_degree_eigenvalue_bound
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hnonflat : ∃ x : Ambient ι, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)) ≤ -(Fintype.card ι : ℝ) := by
  let s : Set (Ambient ι) := {x | eval x P = 0 ∧ (∑ a, (x a)^2) = 1}
  have hs : IsCompact s := Source29CompactPolynomialLink.isCompact_link P
  obtain ⟨b, hb, hpb⟩ := hnonflat
  have hbr : gradientAt P b ≠ 0 := by
    intro hz
    have hp : curvaturePotential P b = 0 := by
      simp [curvaturePotential, potential, hz, vectorSq]
    rw [hp] at hpb
    exact (lt_irrefl 0) hpb
  have hhb : 0 < curvatureNorm P b := Real.sqrt_pos.mpr hpb
  have hφb : 0 < jacobiProfile P b := jacobiProfile_positive P b hbr
  have hrc : ContinuousOn (fun x => curvatureNorm P x / jacobiProfile P x) s :=
    (ratio_continuous P hL).continuousOn
  obtain ⟨a, ha, hmax⟩ := hs.exists_isMaxOn ⟨b, hb⟩ hrc
  have hratio : 0 < curvatureNorm P a / jacobiProfile P a :=
    (div_pos hhb hφb).trans_le (hmax hb)
  have har : gradientAt P a ≠ 0 := by
    intro hz
    have hzφ : jacobiProfile P a = 0 := by
      change (tensorNorm (gradientAt P a))⁻¹ = 0
      simp [hz, tensorNorm]
    rw [hzφ, div_zero] at hratio
    exact (lt_irrefl 0) hratio
  have hφa : 0 < jacobiProfile P a := jacobiProfile_positive P a har
  have hha : 0 < curvatureNorm P a := by
    have he := (lt_div_iff₀ hφa).mp hratio
    simpa only [zero_mul] using he
  have hpa : 0 < curvaturePotential P a := Real.sqrt_pos.mp hha
  obtain ⟨C, hC, hC0, hmem, hCφ, hCh, hJac, hSimons⟩ :=
    Source29RegularLinkSimons.exists_regular_link_simons_curves
      P d hP hd hL a ha.2 ha.1 har hpa
  apply Source29LocalEigenvalueComparison.eigenvalue_bound_at_ratio_maximum
    (fun i t => curvatureNorm P (C i t)) (fun i t => jacobiProfile P (C i t))
    (curvatureNorm P a) (jacobiProfile P a) (curvaturePotential P a)
    (Fintype.card ι : ℝ) (((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))
    hCh hCφ (fun i => congrArg (curvatureNorm P) (hC0 i))
    (fun i => congrArg (jacobiProfile P) (hC0 i)) hha hφa _ hSimons hJac
  intro i
  change ∀ᶠ t in 𝓝 (0 : ℝ), curvatureNorm P (C i t) / jacobiProfile P (C i t) ≤
    curvatureNorm P (C i 0) / jacobiProfile P (C i 0)
  filter_upwards [hmem i] with t ht
  simpa only [hC0, Set.mem_setOf_eq] using hmax ht

/-- In ambient dimension eight, a homogeneous solution of Lp=0 with degree
at least three and a nonflat unit zero link, allowing singular points, has degree at most four. -/
theorem degree_interval_ambient_eight
    (P : MvPolynomial (Option (Option (Fin 6))) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hnonflat : ∃ x : Ambient (Fin 6), (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    3 ≤ d ∧ d ≤ 4 := by
  have he := homogeneous_degree_eigenvalue_bound P d hP hd hL hnonflat
  have hb : ((d : ℝ)-1)*((d : ℝ)-6) ≤ -(6 : ℝ) := by simpa using he
  have hi := Source29LocalEigenvalueComparison.degree_interval_eight (d : ℝ)
    (((d : ℝ)-1)*((d : ℝ)-6)) (by ring) hb
  exact ⟨hd, by exact_mod_cast hi.2⟩

end
end Source29SingularLinkDegreeBound

/- Component: SingularFinEightDegreeBound.inc -/
namespace Source29SingularFinEightDegreeBound

open MvPolynomial Source29PolynomialCurvaturePotential Source29FactorInheritance
open scoped BigOperators

noncomputable section

open Source29FinEightDegreeBound (eightLinkEquiv)

/-- The checked compact-link degree bound in the original Fin 8 coordinates. -/
theorem nonflat_degree_le_four (P : MvPolynomial (Fin 8) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d) (hL : cubicOperator P = 0)
    (hnonflat : ∃ x, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    d ≤ 4 := by
  let e := eightLinkEquiv
  let Q := rename e P
  have hQ : Q.IsHomogeneous d := hP.rename_isHomogeneous
  have hQL : cubicOperator Q = 0 := by
    change cubicOperator (rename e P) = 0
    rw [Source29PolynomialReindex.cubicOperator_rename, hL, map_zero]
  obtain ⟨x, hx, hp⟩ := hnonflat
  have hqn : ∃ y, (eval y Q = 0 ∧ (∑ a, (y a)^2) = 1) ∧ 0 < curvaturePotential Q y := by
    refine ⟨x ∘ e.symm, ⟨?_, ?_⟩, ?_⟩
    · simpa only [Q, eval_rename, Function.comp_assoc, e.symm_comp_self, Function.comp_id] using hx.1
    · change (∑ a, (x (e.symm a))^2) = 1
      rw [e.symm.sum_comp (fun a => (x a)^2)]
      exact hx.2
    · simpa only [Q, Source29CurvatureReindex.curvaturePotential_rename, Function.comp_assoc,
        e.symm_comp_self, Function.comp_id] using hp
  exact (Source29SingularLinkDegreeBound.degree_interval_ambient_eight Q d hQ hd hQL hqn).2

end
end Source29SingularFinEightDegreeBound

/- Component: IrreducibleHomogeneousRigidity.inc -/
namespace Source29IrreducibleHomogeneousRigidity

open MvPolynomial Source29FactorInheritance Source29PolynomialCurvaturePotential
open Source29RegularFactorObstruction Source29CurvatureScaling Source29AnalyticTensorNorm
open Source29QuarticReuse.QuarticNormalization
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open Source29QuarticReuse.QuarticCompatibility (homogeneous_pderiv)
open scoped BigOperators

noncomputable section

/-- All degrees are excluded for an irreducible sign-changing factor once
its link has positive curvature somewhere, allowing singular points. -/
theorem no_nonflat_sign_changing_factor
    (P : MvPolynomial (Fin 8) ℝ) (hirr : Irreducible P)
    (hP : P.IsHomogeneous P.totalDegree) (hL : cubicOperator P = 0)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0)
    (hnonflat : ∃ x, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) : False := by
  have hd2 : 2 ≤ P.totalDegree := by
    by_contra hh
    have hd : P.totalDegree ≤ 1 := by omega
    obtain ⟨x, hx, hp⟩ := hnonflat
    rw [curvaturePotential_zero_of_affine P hd x] at hp
    exact (lt_irrefl 0) hp
  have hd3 : 3 ≤ P.totalDegree := by
    by_contra hh
    have hd : P.totalDegree = 2 := by omega
    exact Source29QuadraticSignObstruction.no_sign_changing_quadratic P (hd ▸ hP) hL hpos hneg
  have hd4 := Source29SingularFinEightDegreeBound.nonflat_degree_le_four
    P P.totalDegree hP hd3 hL hnonflat
  exact Source29LowDegreeEndpoints.no_irreducible_sign_changing_degree_three_or_four
    P hirr hP hL hd3 hd4 hpos hneg

/-- An irreducible sign-changing homogeneous solution of L(P)=0 in eight
variables is linear; no smoothness hypothesis on its zero set is needed. -/
theorem degree_le_one (P : MvPolynomial (Fin 8) ℝ) (hirr : Irreducible P)
    (hP : P.IsHomogeneous P.totalDegree) (hL : cubicOperator P = 0)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0) : P.totalDegree ≤ 1 := by
  by_contra hn
  have hd : 2 ≤ P.totalDegree := by omega
  obtain ⟨a, ha⟩ := hneg
  obtain ⟨b, hb⟩ := hpos
  have hunit : ¬P ∣ 1 := fun h ↦ hirr.not_isUnit (isUnit_of_dvd_one h)
  obtain ⟨x, hx, hreg, _⟩ := Source29RealRegularZero.exists_regular_zero_away_cofactor
    P 1 hirr hunit a b ha hb
  have hxne : x ≠ 0 := by
    intro hzero
    apply hreg
    ext i
    change eval x (pderiv i P) = 0
    rw [hzero]
    exact eval_zero_of_homogeneous (pderiv i P) (homogeneous_pderiv hP) (by omega)
  let r := tensorNorm x
  have hr : 0 < r := tensorNorm_pos hxne
  let y := r⁻¹ • x
  have hyunit : (∑ i, (y i) ^ 2) = 1 := by
    simp only [y, Pi.smul_apply, smul_eq_mul, mul_pow, ← Finset.mul_sum]
    rw [← tensorNorm_sq x]
    change r⁻¹ ^ 2 * r ^ 2 = 1
    field_simp
  have hyzero : eval y P = 0 := by
    change eval (fun i ↦ r⁻¹ * x i) P = 0
    rw [eval_scale_of_isHomogeneous P P.totalDegree hP x r⁻¹, hx, mul_zero]
  have hyreg : gradientAt P y ≠ 0 := by
    rw [show y = r⁻¹ • x from rfl, gradientAt_scale P P.totalDegree hP]
    exact smul_ne_zero (pow_ne_zero _ (inv_ne_zero hr.ne')) hreg
  have hnf := Source29PolynomialLinkNonflatness.exists_positive_curvature_on_link_fin8
    P P.totalDegree hP hirr hd hL y hyunit hyzero hyreg
  exact no_nonflat_sign_changing_factor P hirr hP hL ⟨b, hb⟩ ⟨a, ha⟩ hnf

end
end Source29IrreducibleHomogeneousRigidity

/- Component: NonlinearPositiveStructureReduction.inc -/
namespace Source29NonlinearPositiveStructureReduction

open MvPolynomial Source29Closing

noncomputable section

/-- Sufficient factor data with no regularity assumption on the real zero set. -/
def NonlinearPositiveLeadingFactorData8 (P : Polynomial8) : Prop :=
  ∃ (p Q : Polynomial8) (k : ℕ),
    1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
    Q.IsHomogeneous Q.totalDegree ∧
    homogeneousComponent P.totalDegree P = p ^ k * Q ∧
    PositiveAwayFromZero Q ∧ 2 ≤ p.totalDegree

/-- Weighted curvature continuity removes the former global regularity
hypothesis from the exact source29 closing reduction. -/
theorem problem29_of_nonlinear_positive_leading_factor
    (hstructure : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → NonlinearPositiveLeadingFactorData8 P) : Math30.Problem29 := by
  intro P hminimal
  change P.totalDegree ≤ 1
  by_contra hn
  have hd : 2 ≤ P.totalDegree := by omega
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQpos, hpdegree⟩ := hstructure P hminimal hd
  obtain ⟨_, hpos, hneg⟩ :=
    Source29PositiveResidualSign.minimal_graph_factor_changes_sign P p Q k hminimal hd hfactor hQpos
  obtain ⟨hne, hhom, hL⟩ := QuarticPolynomialBasics.leading_component_data P hminimal hd
  have hQdiv : Q ∣ homogeneousComponent P.totalDegree P := ⟨p ^ k, hfactor.trans (mul_comm _ _)⟩
  have hQdegree := Source29ComplexObstruction.positive_divisor_obstruction
    (homogeneousComponent P.totalDegree P) Q P.totalDegree hne hhom hL hQhom hQpos hQdiv
  have hQconst : Q = C (Q.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hQdegree
  have ha : Q.coeff 0 ≠ 0 := by
    intro hz
    apply hne
    rw [hfactor, hQconst, hz, map_zero, mul_zero]
  have hpL : Source29FactorInheritance.cubicOperator p = 0 := by
    apply Source29PowerOperator.cubicOperator_pow_mul_C_zero_imp p hp.ne_zero k (by omega)
      (Q.coeff 0) ha
    change QuarticPolynomialBasics.cubicOperator (p ^ k * C (Q.coeff 0)) = 0
    rw [← hQconst, ← hfactor]
    exact hL
  have hpd := Source29IrreducibleHomogeneousRigidity.degree_le_one p hp hphom hpL hpos hneg
  omega

end
end Source29NonlinearPositiveStructureReduction

/- Component: GraphMassIdentity.inc -/
namespace Source29GraphMassIdentity

open MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29GraphAreaConvexity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem gradient_pair_normalized (g : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) :
    (∑ i, g x i * normalizedField g x i) = areaDensity (g x) - 1 / areaDensity (g x) := by
  have hw := areaDensity_pos (g x)
  have hs := areaDensity_sq (g x)
  change (∑ i, g x i * (g x i / areaDensity (g x))) = _
  simp only [← mul_div_assoc, ← pow_two, ← Finset.sum_div]
  apply (eq_sub_iff_add_eq).mpr
  rw [← add_div]
  apply (div_eq_iff hw.ne').mpr
  nlinarith

theorem composed_product_fderiv {u ρ : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hρ : ContDiff ℝ 1 ρ) (hh : ContDiff ℝ 1 h)
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ ρ y * h (u y)) x (Pi.single i 1) =
      h (u x) * fderiv ℝ ρ x (Pi.single i 1) + ρ x * deriv h (u x) * g x i := by
  have hd := ((hh.differentiable (by norm_num) (u x)).hasDerivAt).comp_hasFDerivAt x
    ((hu.differentiable (by norm_num) x).hasFDerivAt)
  have hp := ((hρ.differentiable (by norm_num) x).hasFDerivAt).fun_mul hd
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hp.fderiv
  simpa only [add_apply, _root_.smul_apply, smul_eq_mul,
    hdu, mul_assoc, add_comm, Function.comp_def] using he

theorem composed_product_flux {u ρ : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hρ : ContDiff ℝ 1 ρ) (hh : ContDiff ℝ 1 h)
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (u y)) (normalizedField g) x =
      h (u x) * testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField g) x +
      ρ x * deriv h (u x) * (areaDensity (g x) - 1 / areaDensity (g x)) := by
  simp only [testFlux, composed_product_fderiv hu hρ hh hdu, add_mul, Finset.sum_add_distrib]
  simp_rw [mul_assoc, ← Finset.mul_sum]
  rw [gradient_pair_normalized]

/-- Separable graph-area weights can be integrated using only the normal
field and a primitive in the height variable. This is exact for every
smooth graph whose normalized gradient is divergence-free. -/
theorem separable_mass_identity {u ρ : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {h : ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) (hh : ContDiff ℝ 1 h) :
    (∫ x, ρ x * deriv h (u x) * areaDensity (g x)) =
      (∫ x, ρ x * deriv h (u x) / areaDensity (g x)) -
      (∫ x, h (u x) * testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField g) x) := by
  have hw : Continuous (fun x ↦ areaDensity (g x)) := areaDensity_continuous g (fun i ↦ (hg i).continuous)
  have hf := normalizedField_contDiff hg
  have hd : Continuous (fun x ↦ deriv h (u x)) := hh.continuous_deriv_one.comp hu.continuous
  have hi : Integrable (fun x ↦ ρ x * deriv h (u x) * areaDensity (g x)) :=
    ((hρ.continuous.mul hd).mul hw).integrable_of_hasCompactSupport hcρ.mul_right.mul_right
  have he : Integrable (fun x ↦ ρ x * deriv h (u x) / areaDensity (g x)) :=
    ((hρ.continuous.mul hd).div hw (fun x ↦ (areaDensity_pos (g x)).ne')).integrable_of_hasCompactSupport
      (by
        have hs : HasCompactSupport (fun x ↦ ρ x * (deriv h (u x) / areaDensity (g x))) :=
          hcρ.mul_right
        have heq : (fun x ↦ ρ x * deriv h (u x) / areaDensity (g x)) =
            (fun x ↦ ρ x * (deriv h (u x) / areaDensity (g x))) := by
          funext x
          ring
        change HasCompactSupport (fun x ↦ ρ x * deriv h (u x) / areaDensity (g x))
        rw [heq]
        exact hs)
  have ht : ContDiff ℝ 1 (fun x ↦ ρ x * h (u x)) := hρ.mul (hh.comp hu)
  have hz := integral_testFlux_eq_zero (μ := volume) (fun i ↦ Pi.single i 1) ht hcρ.mul_right hf hdiv
  have hflux : Integrable (fun x ↦ h (u x) * testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField g) x) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact (hh.continuous.comp hu.continuous).mul (testFlux_continuous _ hρ (fun i ↦ (hf i).continuous))
    · exact (testFlux_hasCompactSupport _ hcρ).mul_left
  have hid : (fun x ↦ testFlux (fun i ↦ Pi.single i 1) (fun y ↦ ρ y * h (u y)) (normalizedField g) x) =
      (fun x ↦ h (u x) * testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField g) x +
        (ρ x * deriv h (u x) * areaDensity (g x) - ρ x * deriv h (u x) / areaDensity (g x))) := by
    funext x
    rw [composed_product_flux hu hρ hh hdu]
    ring
  have ha := integral_add hflux (hi.sub he)
  have hs := integral_sub hi he
  simp only [Pi.sub_apply] at ha hs
  rw [hid, ha, hs] at hz
  linarith

end
end Source29GraphMassIdentity

/- Component: GraphDilationFields.inc -/
namespace Source29GraphDilationFields

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics Source29GraphCalibration Source29GraphMassIdentity
open scoped BigOperators Topology

noncomputable section
variable {n : ℕ}

def height (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ := eval (r • x) P / r
def gradient (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (x : Fin n → ℝ) := evaluatedGradient P (r • x)

theorem height_contDiff (P : MvPolynomial (Fin n) ℝ) (r : ℝ) : ContDiff ℝ 1 (height P r) := by
  unfold height
  exact ((contDiff_eval P).comp (by fun_prop)).div_const r

theorem gradient_contDiff (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (i : Fin n) :
    ContDiff ℝ 1 (fun x ↦ gradient P r x i) := by
  unfold gradient evaluatedGradient
  exact (contDiff_eval (pderiv i P)).comp (by fun_prop)

theorem height_fderiv (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (hr : r ≠ 0)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (height P r) x (Pi.single i 1) = gradient P r x i := by
  have hd := ((hasFDerivAt_eval P (r • x)).comp x ((hasFDerivAt_id x).const_smul r)).const_smul r⁻¹
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  have heq : (r⁻¹ • ((fun y : Fin n → ℝ ↦ eval y P) ∘ HSMul.hSMul r)) = height P r := by
    funext y
    simp only [height, Pi.smul_apply, Function.comp_apply, smul_eq_mul, div_eq_mul_inv, mul_comm]
  rw [heq] at he
  simpa only [ContinuousLinearMap.comp_apply, _root_.smul_apply, ContinuousLinearMap.id_apply,
    map_smul, smul_eq_mul, evalFDeriv_basis, gradient, evaluatedGradient,
    inv_mul_cancel_left₀ hr] using he

theorem normalized_gradient_eq (P : MvPolynomial (Fin n) ℝ) (r : ℝ) (x : Fin n → ℝ) :
    normalizedField (gradient P r) x = normalizedField (evaluatedGradient P) (r • x) := rfl

theorem normalized_gradient_divergence (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (r : ℝ) (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (normalizedField (gradient P r)) x = 0 := by
  change divergence (fun i ↦ Pi.single i 1)
    (fun y ↦ normalizedField (evaluatedGradient P) (r • y)) x = 0
  have hg : ∀ i, ContDiff ℝ 1 (fun x ↦ evaluatedGradient P x i) :=
    fun i ↦ contDiff_eval (pderiv i P)
  rw [divergence_dilate _ (normalizedField_contDiff hg),
    polynomial_normalizedGradient_divergence_zero P hmin, mul_zero]

theorem dilated_graph_mass_identity (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (r : ℝ) (hr : r ≠ 0)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) :
    (∫ x, ρ x * deriv h (height P r x) * Source29GraphAreaConvexity.areaDensity (gradient P r x)) =
      (∫ x, ρ x * deriv h (height P r x) / Source29GraphAreaConvexity.areaDensity (gradient P r x)) -
      (∫ x, h (height P r x) * testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField (gradient P r)) x) :=
  separable_mass_identity (height_contDiff P r) (gradient_contDiff P r)
    (height_fderiv P r hr) (normalized_gradient_divergence P hmin r) hρ hcρ hh

end
end Source29GraphDilationFields

/- Component: GraphHeightLimits.inc -/
namespace Source29GraphHeightLimits

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29GraphDilationFields
open scoped Topology

noncomputable section
variable {n : ℕ}

theorem height_eq_scaled (P : MvPolynomial (Fin n) ℝ) (hdeg : 1 ≤ P.totalDegree)
    (r : ℝ) (hr : r ≠ 0) (x : Fin n → ℝ) :
    height P r x = (eval (r • x) P / r ^ P.totalDegree) * r ^ (P.totalDegree - 1) := by
  have he : P.totalDegree = (P.totalDegree - 1) + 1 := by omega
  unfold height
  have hpow : r ^ P.totalDegree = r ^ (P.totalDegree - 1) * r := by
    conv_lhs => rw [he]
    exact pow_succ r (P.totalDegree - 1)
  rw [hpow]
  have hp : r ^ (P.totalDegree - 1) ≠ 0 := pow_ne_zero _ hr
  field_simp

theorem height_tendsto_atTop (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    (x : Fin n → ℝ) (hx : 0 < eval x (homogeneousComponent P.totalDegree P)) :
    Tendsto (fun k ↦ height P (dilationRadius k) x) atTop atTop := by
  have hf := (eval_dilate_div_pow_tendsto P (by omega : 0 < P.totalDegree) le_rfl x).comp
    dilationRadius_tendsto
  have hg := (tendsto_pow_atTop (by omega : P.totalDegree - 1 ≠ 0)).comp dilationRadius_tendsto
  have ht := hf.pos_mul_atTop hx hg
  convert ht using 1
  funext k
  exact height_eq_scaled P (by omega) _ (dilationRadius_pos k).ne' x

theorem height_tendsto_atBot (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    (x : Fin n → ℝ) (hx : eval x (homogeneousComponent P.totalDegree P) < 0) :
    Tendsto (fun k ↦ height P (dilationRadius k) x) atTop atBot := by
  have hf := (eval_dilate_div_pow_tendsto P (by omega : 0 < P.totalDegree) le_rfl x).comp
    dilationRadius_tendsto
  have hg := (tendsto_pow_atTop (by omega : P.totalDegree - 1 ≠ 0)).comp dilationRadius_tendsto
  have ht := hf.neg_mul_atTop hx hg
  convert ht using 1
  funext k
  exact height_eq_scaled P (by omega) _ (dilationRadius_pos k).ne' x

theorem height_profile_tendsto_ae (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {h : ℝ → ℝ} {a b : ℝ} (hp : Tendsto h atTop (𝓝 a)) (hm : Tendsto h atBot (𝓝 b)) :
    ∀ᵐ x : Fin n → ℝ, Tendsto (fun k ↦ h (height P (dilationRadius k) x)) atTop
      (𝓝 (if 0 < eval x (homogeneousComponent P.totalDegree P) then a else b)) := by
  have hne := Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P
    (by omega : 0 < P.totalDegree)
  filter_upwards [mvPolynomial_eval_ne_zero_ae n _ hne] with x hx
  by_cases hs : 0 < eval x (homogeneousComponent P.totalDegree P)
  · simp only [ite_eq_left hs]
    exact hp.comp (height_tendsto_atTop P hdeg x hs)
  · simp only [ite_eq_right hs]
    exact hm.comp (height_tendsto_atBot P hdeg x (lt_of_le_of_ne (le_of_not_gt hs) hx))

end
end Source29GraphHeightLimits

/- Component: GraphMassLimits.inc -/
namespace Source29GraphMassLimits

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29GraphDilationFields Source29GraphHeightLimits Source29GraphAreaConvexity
open scoped BigOperators Topology

noncomputable section
variable {n : ℕ}

theorem areaDensity_ge_one (v : Fin n → ℝ) : 1 ≤ areaDensity v := by
  have hs := areaDensity_sq v
  have hp := areaDensity_pos v
  have hn : 0 ≤ ∑ i, v i ^ 2 := Finset.sum_nonneg (fun i _ ↦ sq_nonneg _)
  nlinarith

theorem norm_div_areaDensity_le (a : ℝ) (v : Fin n → ℝ) :
    ‖a / areaDensity v‖ ≤ ‖a‖ := by
  rw [norm_div, Real.norm_eq_abs (areaDensity v), abs_of_pos (areaDensity_pos v)]
  exact div_le_self (norm_nonneg _) (areaDensity_ge_one v)

theorem height_error_integral_tendsto_zero
    (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : Continuous ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) {M : ℝ}
    (hb : ∀ t, ‖deriv h t‖ ≤ M)
    (hp : Tendsto (deriv h) atTop (𝓝 0)) (hm : Tendsto (deriv h) atBot (𝓝 0)) :
    Tendsto (fun k ↦ ∫ x, ρ x * deriv h (height P (dilationRadius k) x) /
      areaDensity (gradient P (dilationRadius k) x)) atTop (𝓝 0) := by
  have hl : ∀ᵐ x : Fin n → ℝ, Tendsto (fun k ↦ deriv h (height P (dilationRadius k) x))
      atTop (𝓝 0) := by
    simpa only [ite_self] using height_profile_tendsto_ae P hdeg hp hm
  have hc : ∀ k, Continuous (fun x ↦ ρ x * deriv h (height P (dilationRadius k) x) /
      areaDensity (gradient P (dilationRadius k) x)) := by
    intro k
    exact (hρ.mul (hh.continuous_deriv_one.comp (height_contDiff P _).continuous)).div
      (areaDensity_continuous _ (fun i ↦ (gradient_contDiff P _ i).continuous))
      (fun x ↦ (areaDensity_pos _).ne')
  have ht : Tendsto (fun k ↦ ∫ x, ρ x * deriv h (height P (dilationRadius k) x) /
      areaDensity (gradient P (dilationRadius k) x)) atTop (𝓝 (∫ _x : Fin n → ℝ, (0 : ℝ))) := by
    apply tendsto_integral_of_dominated_convergence (fun x ↦ ‖ρ x‖ * M)
    · exact fun k ↦ (hc k).aestronglyMeasurable
    · exact (hρ.integrable_of_hasCompactSupport hcρ).norm.mul_const M
    · intro k
      exact Filter.Eventually.of_forall fun x ↦ (norm_div_areaDensity_le _ _).trans
        (by rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hb _) (norm_nonneg _))
    · filter_upwards [hl] with x hx
      apply squeeze_zero_norm (fun k ↦ norm_div_areaDensity_le _ _)
      simpa only [mul_zero, norm_zero] using (tendsto_const_nhds.mul hx).norm
  simpa only [integral_zero] using ht

theorem height_flux_integral_tendsto
    (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : Continuous h) (hb : ∀ t, ‖h t‖ ≤ 1)
    (hp : Tendsto h atTop (𝓝 1)) (hm : Tendsto h atBot (𝓝 0)) :
    Tendsto (fun k ↦ ∫ x, h (height P (dilationRadius k) x) *
      testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField (gradient P (dilationRadius k))) x)
      atTop (𝓝 (-Source29PhaseMassLimit.phaseMass (homogeneousComponent P.totalDegree P) ρ)) := by
  have hn := Source29TopWeakCalibration.normalizedGradient_dilates_tendsto_ae P hdeg
  have hl := height_profile_tendsto_ae P hdeg hp hm
  have ht : Tendsto (fun k ↦ ∫ x, h (height P (dilationRadius k) x) *
      testFlux (fun i ↦ Pi.single i 1) ρ (normalizedField (gradient P (dilationRadius k))) x)
      atTop (𝓝 (∫ x, (if 0 < eval x (homogeneousComponent P.totalDegree P) then 1 else 0) *
        testFlux (fun i ↦ Pi.single i 1) ρ
          (leadingNormalizedField (homogeneousComponent P.totalDegree P)) x)) := by
    apply tendsto_integral_of_dominated_convergence (testBound (fun i ↦ Pi.single i 1) ρ)
    · intro k
      exact ((hh.comp (height_contDiff P _).continuous).mul
        (testFlux_continuous _ hρ (fun i ↦ (normalizedField_contDiff
          (gradient_contDiff P _) i).continuous))).aestronglyMeasurable
    · exact testBound_integrable _ hρ hcρ
    · intro k
      apply Filter.Eventually.of_forall
      intro x
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_right (hb _) (norm_nonneg _)).trans
        (by
          simpa only [one_mul] using norm_testFlux_le_testBound (fun i ↦ Pi.single i 1) ρ
            (normalizedField (gradient P (dilationRadius k))) x
            (fun i ↦ normalizedField_norm_le_one _ _ _))
    · filter_upwards [hl, hn] with x hx hnx
      apply hx.mul
      apply testFlux_tendsto
      exact hnx
  convert ht using 1
  simp only [Source29PhaseMassLimit.phaseMass, neg_neg]
  congr 1
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun x ↦ mul_comm _ _

theorem graph_mass_tendsto_phaseMass
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ)
    {h : ℝ → ℝ} (hh : ContDiff ℝ 1 h) (hb : ∀ t, ‖h t‖ ≤ 1)
    (hp : Tendsto h atTop (𝓝 1)) (hm : Tendsto h atBot (𝓝 0))
    {M : ℝ} (hdb : ∀ t, ‖deriv h t‖ ≤ M)
    (hdp : Tendsto (deriv h) atTop (𝓝 0)) (hdm : Tendsto (deriv h) atBot (𝓝 0)) :
    Tendsto (fun k ↦ ∫ x, ρ x * deriv h (height P (dilationRadius k) x) *
      areaDensity (gradient P (dilationRadius k) x))
      atTop (𝓝 (Source29PhaseMassLimit.phaseMass (homogeneousComponent P.totalDegree P) ρ)) := by
  have he := height_error_integral_tendsto_zero P hdeg hρ.continuous hcρ hh hdb hdp hdm
  have hf := height_flux_integral_tendsto P hdeg hρ hcρ hh.continuous hb hp hm
  have ht := he.sub hf
  simp only [zero_sub, neg_neg] at ht
  convert ht using 1
  funext k
  exact dilated_graph_mass_identity P hmin _ (dilationRadius_pos k).ne' hρ hcρ hh

end
end Source29GraphMassLimits

/- Component: GraphHeightProfile.inc -/
namespace Source29GraphHeightProfile

open MvPolynomial MeasureTheory Filter Set
open Source29GraphDilationFields Source29GraphAreaConvexity
open Source29QuarticReuse.FluxPolynomial
open scoped Topology

noncomputable section

theorem profile_norm_le_one (t : ℝ) : ‖Real.smoothTransition t‖ ≤ 1 := by
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.smoothTransition.nonneg t)]
  exact Real.smoothTransition.le_one t

theorem profile_tendsto_atTop : Tendsto Real.smoothTransition atTop (𝓝 1) := by
  apply (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ (1 : ℝ)) atTop (𝓝 1)).congr'
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with t ht
  exact (Real.smoothTransition.one_of_one_le ht).symm

theorem profile_tendsto_atBot : Tendsto Real.smoothTransition atBot (𝓝 0) := by
  apply (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ (0 : ℝ)) atBot (𝓝 0)).congr'
  filter_upwards [eventually_le_atBot (0 : ℝ)] with t ht
  exact (Real.smoothTransition.zero_of_nonpos ht).symm

theorem profile_deriv_zero_left {t : ℝ} (ht : t < 0) : deriv Real.smoothTransition t = 0 := by
  have he : Real.smoothTransition =ᶠ[𝓝 t] fun _ ↦ 0 := by
    filter_upwards [gt_mem_nhds ht] with s hs
    exact Real.smoothTransition.zero_of_nonpos hs.le
  rw [he.deriv_eq, deriv_const]

theorem profile_deriv_zero_right {t : ℝ} (ht : 1 < t) : deriv Real.smoothTransition t = 0 := by
  have he : Real.smoothTransition =ᶠ[𝓝 t] fun _ ↦ 1 := by
    filter_upwards [lt_mem_nhds ht] with s hs
    exact Real.smoothTransition.one_of_one_le hs.le
  rw [he.deriv_eq, deriv_const]

theorem profile_deriv_hasCompactSupport : HasCompactSupport (deriv Real.smoothTransition) := by
  apply HasCompactSupport.of_support_subset_isCompact (K := Icc (0 : ℝ) 1) isCompact_Icc
  intro t ht
  by_contra hn
  simp only [mem_Icc, not_and_or, not_le] at hn
  rcases hn with hleft | hright
  · exact ht (profile_deriv_zero_left hleft)
  · exact ht (profile_deriv_zero_right hright)

theorem profile_deriv_bounded : ∃ M : ℝ, ∀ t, ‖deriv Real.smoothTransition t‖ ≤ M :=
  profile_deriv_hasCompactSupport.exists_bound_of_continuous
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv_one

theorem profile_deriv_tendsto_atTop : Tendsto (deriv Real.smoothTransition) atTop (𝓝 0) := by
  apply (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ (0 : ℝ)) atTop (𝓝 0)).congr'
  filter_upwards [eventually_gt_atTop (1 : ℝ)] with t ht
  exact (profile_deriv_zero_right ht).symm

theorem profile_deriv_tendsto_atBot : Tendsto (deriv Real.smoothTransition) atBot (𝓝 0) := by
  apply (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ (0 : ℝ)) atBot (𝓝 0)).congr'
  filter_upwards [eventually_lt_atBot (0 : ℝ)] with t ht
  exact (profile_deriv_zero_left ht).symm

/-- An explicit nonnegative, compactly supported height weight gives the
leading phase perimeter as the limit of rescaled graph area. -/
theorem smooth_weight_graph_mass_tendsto {n : ℕ}
    (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {ρ : (Fin n → ℝ) → ℝ} (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    Tendsto (fun k ↦ ∫ x, ρ x * deriv Real.smoothTransition (height P (dilationRadius k) x) *
      areaDensity (gradient P (dilationRadius k) x))
      atTop (𝓝 (Source29PhaseMassLimit.phaseMass (homogeneousComponent P.totalDegree P) ρ)) := by
  obtain ⟨M, hM⟩ := profile_deriv_bounded
  exact Source29GraphMassLimits.graph_mass_tendsto_phaseMass P hmin hdeg hρ hcρ
    Real.smoothTransition.contDiff profile_norm_le_one profile_tendsto_atTop profile_tendsto_atBot
    hM profile_deriv_tendsto_atTop profile_deriv_tendsto_atBot

end
end Source29GraphHeightProfile

/- Component: GraphRadialCurrent.inc -/
namespace Source29GraphRadialCurrent

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29GraphAreaConvexity
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def defect (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  u x - ∑ i, x i * g x i

def current (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) (i : Fin n) : ℝ :=
  areaDensity (g x) * x i + defect u g x * normalizedField g x i

theorem areaDensity_contDiff {g : (Fin n → ℝ) → Fin n → ℝ}
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) : ContDiff ℝ 1 (fun x ↦ areaDensity (g x)) := by
  simpa only [Source29RegularizedGradientNorm.density, one_pow, areaDensity] using
    Source29RegularizedGradientNorm.density_contDiff 1 (by norm_num) g hg

theorem areaDensity_fderiv {g : (Fin n → ℝ) → Fin n → ℝ}
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) (x v : Fin n → ℝ) :
    fderiv ℝ (fun y ↦ areaDensity (g y)) x v =
      ∑ i, normalizedField g x i * fderiv ℝ (fun y ↦ g y i) x v := by
  simpa only [Source29RegularizedGradientNorm.density, Source29RegularizedGradientNorm.field,
    one_pow, areaDensity, normalizedField, radiusSq] using
    Source29RegularizedGradientNorm.density_fderiv 1 (by norm_num) g hg x v

theorem defect_contDiff {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) :
    ContDiff ℝ 1 (defect u g) := by
  exact hu.sub (ContDiff.sum (fun i _ ↦ (contDiff_apply ℝ ℝ i).mul (hg i)))

theorem defect_fderiv {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (defect u g) x (Pi.single i 1) =
      -(∑ j, x j * fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1)) := by
  have hs : HasFDerivAt (fun y ↦ ∑ j, y j * g y j)
      (∑ j, (x j • fderiv ℝ (fun y ↦ g y j) x +
        g x j • (ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ))) x := by
    apply HasFDerivAt.fun_sum
    intro j _
    exact (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) j x).fun_mul
      ((hg j).differentiable (by norm_num) x).hasFDerivAt
  have hd := ((hu.differentiable (by norm_num) x).hasFDerivAt).sub hs
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  change fderiv ℝ (defect u g) x (Pi.single i 1) = _ at he
  simp [Finset.sum_add_distrib, Pi.single_apply, hdu, eq_comm] at he
  exact he

theorem current_contDiff {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) (i : Fin n) :
    ContDiff ℝ 1 (fun x ↦ current u g x i) :=
  ((areaDensity_contDiff hg).mul (contDiff_apply ℝ ℝ i)).add
    ((defect_contDiff hu hg).mul (normalizedField_contDiff hg i))

theorem current_diagonal_fderiv {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ current u g y i) x (Pi.single i 1) = areaDensity (g x) +
      x i * (∑ j, normalizedField g x j * fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1)) -
      (∑ j, x j * fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1)) * normalizedField g x i +
      defect u g x * fderiv ℝ (fun y ↦ normalizedField g y i) x (Pi.single i 1) := by
  have ha := ((areaDensity_contDiff hg).differentiable (by norm_num) x).hasFDerivAt.fun_mul
    (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) i x)
  have hb := ((defect_contDiff hu hg).differentiable (by norm_num) x).hasFDerivAt.fun_mul
    ((normalizedField_contDiff hg i).differentiable (by norm_num) x).hasFDerivAt
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) (ha.add hb).fderiv
  change fderiv ℝ (fun y ↦ current u g y i) x (Pi.single i 1) = _ at he
  simp only [add_apply, _root_.smul_apply, smul_eq_mul, ContinuousLinearMap.proj_apply,
    Pi.single_eq_same, mul_one, areaDensity_fderiv hg, defect_fderiv hu hg hdu] at he
  rw [he]
  ring

/-- The tangential radial current has divergence equal to dimension times
graph area density. This is the local identity underlying monotonicity. -/
theorem current_divergence {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (current u g) x = (n : ℝ) * areaDensity (g x) := by
  have hcancel : (∑ i, x i * (∑ j, normalizedField g x j *
      fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1))) =
      ∑ i, (∑ j, x j * fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1)) * normalizedField g x i := by
    simp_rw [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hsym x j i]
    ring
  simp only [divergence, current_diagonal_fderiv hu hg hdu, Finset.sum_add_distrib,
    Finset.sum_sub_distrib]
  rw [hcancel]
  have hz := hdiv x
  unfold divergence at hz
  simp only [add_sub_cancel_right, ← Finset.mul_sum, hz, mul_zero, add_zero,
    Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

theorem weighted_current_identity {u ρ : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    (hρ : ContDiff ℝ 1 ρ) (hcρ : HasCompactSupport ρ) :
    (∫ x, ρ x * ((n : ℝ) * areaDensity (g x))) =
      -(∫ x, testFlux (fun i ↦ Pi.single i 1) ρ (current u g) x) := by
  have he := integral_mul_divergence_eq_neg_testFlux (μ := volume)
    (fun i ↦ Pi.single i 1) hρ hcρ (current_contDiff hu hg)
  simpa only [current_divergence hu hg hdu hsym hdiv] using he


theorem polynomial_current_divergence (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (x : Fin n → ℝ) :
    divergence (fun i ↦ Pi.single i 1) (current (fun y ↦ eval y P) (evaluatedGradient P)) x =
      (n : ℝ) * areaDensity (evaluatedGradient P x) := by
  apply current_divergence (Source29QuarticReuse.FluxPolynomial.contDiff_eval P)
    (fun i ↦ Source29QuarticReuse.FluxPolynomial.contDiff_eval (pderiv i P))
  · intro y i
    exact congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1))
      (Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval P y) |>.trans
        (Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis P y i)
  · intro y i j
    change fderiv ℝ (fun z ↦ eval z (pderiv j P)) y (Pi.single i 1) =
      fderiv ℝ (fun z ↦ eval z (pderiv i P)) y (Pi.single j 1)
    rw [Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval,
      Source29QuarticReuse.QuarticPolynomialBasics.fderiv_eval,
      Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis,
      Source29QuarticReuse.QuarticPolynomialBasics.evalFDeriv_basis,
      Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
  · exact Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin

end
end Source29GraphRadialCurrent

/- Component: GraphRadialGeometry.inc -/
namespace Source29GraphRadialGeometry

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29GraphAreaConvexity Source29GraphRadialCurrent
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def graphRadiusSq (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) : ℝ :=
  (∑ i, x i ^ 2) + u x ^ 2

theorem graphRadiusSq_contDiff {u : (Fin n → ℝ) → ℝ} (hu : ContDiff ℝ 1 u) :
    ContDiff ℝ 1 (graphRadiusSq u) :=
  (ContDiff.sum (fun i _ ↦ (contDiff_apply ℝ ℝ i).pow 2)).add (hu.pow 2)

theorem graphRadiusSq_fderiv {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (graphRadiusSq u) x (Pi.single i 1) = 2 * (x i + u x * g x i) := by
  have hs : HasFDerivAt (fun y : Fin n → ℝ ↦ ∑ j, y j ^ 2)
      (∑ j, (2 * x j) • (ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ)) x := by
    apply HasFDerivAt.fun_sum
    intro j _
    convert (hasFDerivAt_apply (𝕜 := ℝ) (F' := fun _ : Fin n ↦ ℝ) j x).pow 2 using 1 <;> simp
  have he := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1))
    (hs.add (((hu.differentiable (by norm_num) x).hasFDerivAt).pow 2)).fderiv
  change fderiv ℝ (graphRadiusSq u) x (Pi.single i 1) = _ at he
  simp [Pi.single_apply, hdu, eq_comm] at he
  linarith

theorem radial_pairing_algebra (x v : Fin n → ℝ) (z : ℝ) :
    (∑ i, (x i + z * v i) *
      (areaDensity v * x i + (z - ∑ j, x j * v j) * (v i / areaDensity v))) =
      areaDensity v * ((∑ i, x i ^ 2) + z ^ 2) - (z - ∑ j, x j * v j) ^ 2 / areaDensity v := by
  let b := ∑ j, x j * v j
  have he i : (x i + z * v i) *
      (areaDensity v * x i + (z - b) * (v i / areaDensity v)) =
      areaDensity v * x i ^ 2 + (z * areaDensity v + (z - b) / areaDensity v) * (x i * v i) +
        (z * (z - b) / areaDensity v) * v i ^ 2 := by ring
  change (∑ i, (x i + z * v i) * (areaDensity v * x i + (z - b) * (v i / areaDensity v))) = _
  simp_rw [he]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
    ← Finset.mul_sum]
  change areaDensity v * (∑ i, x i ^ 2) + (z * areaDensity v + (z - b) / areaDensity v) * b +
    z * (z - b) / areaDensity v * (∑ i, v i ^ 2) =
      areaDensity v * ((∑ i, x i ^ 2) + z ^ 2) - (z - b) ^ 2 / areaDensity v
  have hw := (areaDensity_pos v).ne'
  have hs := areaDensity_sq v
  field_simp
  linear_combination -z * (z - b) * hs

theorem graphRadiusSq_current_pairing {u : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (graphRadiusSq u) (current u g) x =
      2 * (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x)) := by
  simp only [testFlux, graphRadiusSq_fderiv hu hdu, current, normalizedField]
  change (∑ i, (2 * (x i + u x * g x i)) *
      (areaDensity (g x) * x i + defect u g x * (g x i / areaDensity (g x)))) = _
  simp_rw [mul_assoc, ← Finset.mul_sum]
  rw [defect, radial_pairing_algebra]
  unfold graphRadiusSq
  ring

theorem radial_cutoff_pairing {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ f (graphRadiusSq u y)) (current u g) x =
      2 * deriv f (graphRadiusSq u x) *
        (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x)) := by
  have hd := ((hf.differentiable (by norm_num) (graphRadiusSq u x)).hasDerivAt).comp_hasFDerivAt x
    (((graphRadiusSq_contDiff hu).differentiable (by norm_num) x).hasFDerivAt)
  have he i := congrArg (fun D : (Fin n → ℝ) →L[ℝ] ℝ ↦ D (Pi.single i 1)) hd.fderiv
  simp only [_root_.smul_apply, smul_eq_mul] at he
  unfold testFlux
  simp_rw [show (fun y ↦ f (graphRadiusSq u y)) = f ∘ graphRadiusSq u from rfl, he,
    mul_assoc, ← Finset.mul_sum]
  change deriv f (graphRadiusSq u x) * testFlux (fun i ↦ Pi.single i 1)
    (graphRadiusSq u) (current u g) x = _
  rw [graphRadiusSq_current_pairing hu hdu]
  ring

/-- Exact integrated radial first variation, with the nonnegative normal
radial defect term kept explicit. Compact support is required only after
pulling the scalar radial test back to the graph. -/
theorem radial_first_variation {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (hcf : HasCompactSupport (fun x ↦ f (graphRadiusSq u x))) :
    (∫ x, f (graphRadiusSq u x) * ((n : ℝ) * areaDensity (g x))) =
      -(∫ x, 2 * deriv f (graphRadiusSq u x) *
        (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x))) := by
  have he := weighted_current_identity hu hg hdu hsym hdiv (hf.comp (graphRadiusSq_contDiff hu)) hcf
  change (∫ x, f (graphRadiusSq u x) * ((n : ℝ) * areaDensity (g x))) =
    -(∫ x, testFlux (fun i ↦ Pi.single i 1) (fun y ↦ f (graphRadiusSq u y)) (current u g) x) at he
  simpa only [radial_cutoff_pairing hu hdu hf] using he

end
end Source29GraphRadialGeometry

/- Component: CompactParameterIntegral.inc -/
namespace Source29CompactParameterIntegral

open MeasureTheory Filter Set
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Differentiation under the integral when a compact parameter interval has
a common compact spatial support and a jointly continuous derivative. -/
theorem hasDerivAt_integral {F F' : ℝ → (Fin n → ℝ) → ℝ}
    {a b r : ℝ} (har : a < r) (hrb : r < b) {K : Set (Fin n → ℝ)} (hK : IsCompact K)
    (hF : ∀ t ∈ Icc a b, Continuous (F t))
    (hF' : ∀ t ∈ Icc a b, Continuous (F' t))
    (hjoint : ContinuousOn (fun p : ℝ × (Fin n → ℝ) ↦ F' p.1 p.2) (Icc a b ×ˢ K))
    (hz : ∀ t ∈ Icc a b, ∀ x ∉ K, F t x = 0)
    (hz' : ∀ t ∈ Icc a b, ∀ x ∉ K, F' t x = 0)
    (hd : ∀ x t, t ∈ Icc a b → HasDerivAt (fun s ↦ F s x) (F' t x) t) :
    Integrable (F' r) ∧ HasDerivAt (fun t ↦ ∫ x, F t x) (∫ x, F' r x) r := by
  classical
  have hr : r ∈ Icc a b := ⟨har.le, hrb.le⟩
  have hs : Icc a b ∈ 𝓝 r := Icc_mem_nhds har hrb
  obtain ⟨M, hM⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn hjoint
  have hcompact : HasCompactSupport (F r) := by
    apply HasCompactSupport.of_support_subset_isCompact hK
    intro x hx
    by_contra hn
    exact hx (hz r hr x hn)
  apply hasDerivAt_integral_of_dominated_loc_of_deriv_le (s := Icc a b)
    (bound := K.indicator (fun _ ↦ M)) hs
  · filter_upwards [hs] with t ht
    exact (hF t ht).aestronglyMeasurable
  · exact (hF r hr).integrable_of_hasCompactSupport hcompact
  · exact (hF' r hr).aestronglyMeasurable
  · apply Filter.Eventually.of_forall
    intro x t ht
    by_cases hx : x ∈ K
    · rw [Set.indicator_of_mem hx]
      exact hM (t,x) ⟨ht,hx⟩
    · rw [Set.indicator_of_notMem hx, hz' t ht x hx, norm_zero]
  · exact (integrable_indicator_iff hK.measurableSet).2
      (integrableOn_const hK.measure_lt_top.ne)
  · exact Filter.Eventually.of_forall hd

end
end Source29CompactParameterIntegral

/- Component: GraphRadialSupport.inc -/
namespace Source29GraphRadialSupport

open Set
open Source29GraphRadialGeometry
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def supportBox (n : ℕ) (B : ℝ) : Set (Fin n → ℝ) :=
  Icc (fun _ ↦ -(B+1)) (fun _ ↦ B+1)

theorem supportBox_compact (n : ℕ) (B : ℝ) : IsCompact (supportBox n B) := isCompact_Icc

theorem graphRadiusSq_nonneg (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) :
    0 ≤ graphRadiusSq u x := add_nonneg (Finset.sum_nonneg fun i _ ↦ sq_nonneg _) (sq_nonneg _)

theorem mem_supportBox_of_radius_le (u : (Fin n → ℝ) → ℝ) (x : Fin n → ℝ)
    {B : ℝ} (hB : 0 ≤ B) (hx : graphRadiusSq u x ≤ B) : x ∈ supportBox n B := by
  have hs (i : Fin n) : x i ^ 2 ≤ B := by
    have hi : x i ^ 2 ≤ ∑ j, x j ^ 2 :=
      Finset.single_le_sum (fun j _ ↦ sq_nonneg _) (Finset.mem_univ i)
    unfold graphRadiusSq at hx
    nlinarith [sq_nonneg (u x)]
  constructor <;> intro i <;> dsimp only <;>
    nlinarith [hs i, sq_nonneg (x i - 1), sq_nonneg (x i + 1)]

theorem scaled_radius_large_outside_box (u : (Fin n → ℝ) → ℝ) {R b r : ℝ}
    (hR : 0 ≤ R) (hr : 0 < r) (hrb : r ≤ b) (x : Fin n → ℝ)
    (hx : x ∉ supportBox n (R*b^2)) : R ≤ graphRadiusSq u x / r^2 := by
  have hb : 0 < b := hr.trans_le hrb
  have hrl : R*b^2 < graphRadiusSq u x := lt_of_not_ge fun hle ↦
    hx (mem_supportBox_of_radius_le u x (mul_nonneg hR (sq_nonneg b)) hle)
  apply (le_div_iff₀ (sq_pos_of_pos hr)).2
  have hr2 : r^2 ≤ b^2 := by nlinarith
  exact (mul_le_mul_of_nonneg_left hr2 hR).trans hrl.le

theorem scaled_cutoff_zero_outside_box (u : (Fin n → ℝ) → ℝ) {f : ℝ → ℝ}
    {R b r : ℝ} (hR : 0 ≤ R) (hr : 0 < r) (hrb : r ≤ b)
    (hf : ∀ t, R ≤ t → f t = 0) (x : Fin n → ℝ) (hx : x ∉ supportBox n (R*b^2)) :
    f (graphRadiusSq u x / r^2) = 0 :=
  hf _ (scaled_radius_large_outside_box u hR hr hrb x hx)

theorem scaled_cutoff_compact (u : (Fin n → ℝ) → ℝ) {f : ℝ → ℝ}
    {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r) (hf : ∀ t, R ≤ t → f t = 0) :
    HasCompactSupport (fun x ↦ f (graphRadiusSq u x / r^2)) := by
  apply HasCompactSupport.of_support_subset_isCompact (supportBox_compact n (R*r^2))
  intro x hx
  by_contra hn
  exact hx (scaled_cutoff_zero_outside_box u hR hr le_rfl hf x hn)

end
end Source29GraphRadialSupport

/- Component: GraphMassDerivative.inc -/
namespace Source29GraphMassDerivative

open MeasureTheory Set
open Source29GraphRadialGeometry Source29GraphRadialSupport Source29GraphAreaConvexity
open scoped Topology

noncomputable section
variable {n : ℕ}

def massDensity (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ :=
  f (graphRadiusSq u x / r^2) * areaDensity (g x)

def massDensityDeriv (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ :=
  (-2 * graphRadiusSq u x / r^3) * deriv f (graphRadiusSq u x / r^2) * areaDensity (g x)

def mass (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (f : ℝ → ℝ) (r : ℝ) : ℝ := ∫ x, massDensity u g f r x

theorem massDensity_hasDerivAt (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {r : ℝ} (hr : r ≠ 0) (x : Fin n → ℝ) :
    HasDerivAt (fun t ↦ massDensity u g f t x) (massDensityDeriv u g f r x) r := by
  have ha : HasDerivAt (fun t : ℝ ↦ graphRadiusSq u x / t^2) (-2 * graphRadiusSq u x / r^3) r := by
    convert (hasDerivAt_const r (graphRadiusSq u x)).div ((hasDerivAt_id r).pow 2) (pow_ne_zero 2 hr) using 1
    · funext t
      rfl
    · simp only [Pi.pow_apply, id_eq]
      field_simp
      <;> ring
  have hd := ((hf.differentiable (by norm_num) (graphRadiusSq u x / r^2)).hasDerivAt.comp r ha).mul_const
    (areaDensity (g x))
  convert hd using 1
  · funext t
    rfl
  · unfold massDensityDeriv
    ring

theorem massDensity_continuous {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, Continuous (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : Continuous f) (r : ℝ) : Continuous (massDensity u g f r) :=
  (hf.comp ((graphRadiusSq_contDiff hu).continuous.div_const _)).mul (areaDensity_continuous g hg)

theorem massDensityDeriv_continuous {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, Continuous (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) (r : ℝ) : Continuous (massDensityDeriv u g f r) :=
  ((((graphRadiusSq_contDiff hu).continuous.const_mul (-2)).div_const _).mul
    (hf.continuous_deriv_one.comp ((graphRadiusSq_contDiff hu).continuous.div_const _))).mul
    (areaDensity_continuous g hg)

theorem massDensityDeriv_continuousAt {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, Continuous (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) (p : ℝ × (Fin n → ℝ)) (hp : p.1 ≠ 0) :
    ContinuousAt (fun q : ℝ × (Fin n → ℝ) ↦ massDensityDeriv u g f q.1 q.2) p := by
  have hs := ((graphRadiusSq_contDiff hu).continuous.comp continuous_snd).continuousAt (x := p)
  have harg := hs.div ((continuous_fst.pow 2).continuousAt) (pow_ne_zero 2 hp)
  exact ((((hs.const_mul (-2)).div ((continuous_fst.pow 3).continuousAt) (pow_ne_zero 3 hp)).mul
    (hf.continuous_deriv_one.continuousAt.comp harg)).mul
    ((areaDensity_continuous g hg).comp continuous_snd).continuousAt)

theorem massDensity_integrable {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, Continuous (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : Continuous f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) : Integrable (massDensity u g f r) :=
  (massDensity_continuous hu hg hf r).integrable_of_hasCompactSupport
    (scaled_cutoff_compact u hR hr hz).mul_right

theorem mass_hasDerivAt {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, Continuous (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    Integrable (massDensityDeriv u g f r) ∧
      HasDerivAt (mass u g f) (∫ x, massDensityDeriv u g f r x) r := by
  apply Source29CompactParameterIntegral.hasDerivAt_integral
    (a := r/2) (b := 2*r) (K := supportBox n (R*(2*r)^2))
    (by linarith) (by linarith) (supportBox_compact _ _)
  · intro t ht
    exact massDensity_continuous hu hg hf.continuous t
  · intro t ht
    exact massDensityDeriv_continuous hu hg hf t
  · intro p hp
    exact (massDensityDeriv_continuousAt hu hg hf p (by linarith [hp.1.1])).continuousWithinAt
  · intro t ht x hx
    unfold massDensity
    rw [scaled_cutoff_zero_outside_box u hR (by linarith [ht.1]) ht.2 hz x hx, zero_mul]
  · intro t ht x hx
    unfold massDensityDeriv
    rw [scaled_cutoff_zero_outside_box u hR (by linarith [ht.1]) ht.2 hdz x hx, mul_zero, zero_mul]
  · intro x t ht
    exact massDensity_hasDerivAt u g hf (by linarith [ht.1]) x

end
end Source29GraphMassDerivative

/- Component: GraphScaledStationarity.inc -/
namespace Source29GraphScaledStationarity

open MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29GraphRadialGeometry Source29GraphRadialSupport Source29GraphAreaConvexity
open Source29GraphRadialCurrent Source29GraphMassDerivative
open scoped Topology

noncomputable section
variable {n : ℕ}

def defectDensity (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (f : ℝ → ℝ) (r : ℝ) (x : Fin n → ℝ) : ℝ :=
  deriv f (graphRadiusSq u x / r^2) * defect u g x ^ 2 / areaDensity (g x)

theorem defectDensity_integrable {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hdz : ∀ t, R ≤ t → deriv f t = 0) : Integrable (defectDensity u g f r) := by
  have hc : Continuous (defectDensity u g f r) :=
    ((hf.continuous_deriv_one.comp ((graphRadiusSq_contDiff hu).continuous.div_const _)).mul
      ((defect_contDiff hu hg).continuous.pow 2)).div
      (areaDensity_continuous g (fun i ↦ (hg i).continuous)) (fun x ↦ (areaDensity_pos _).ne')
  apply hc.integrable_of_hasCompactSupport
  apply HasCompactSupport.of_support_subset_isCompact (supportBox_compact n (R*r^2))
  intro x hx
  by_contra hn
  apply hx
  unfold defectDensity
  rw [scaled_cutoff_zero_outside_box u hR hr le_rfl hdz x hn, zero_mul, zero_div]

theorem scaled_profile_deriv {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r s : ℝ) :
    deriv (fun t ↦ f (t/r^2)) s = deriv f (s/r^2) / r^2 := by
  have hd := ((hf.differentiable (by norm_num) (s/r^2)).hasDerivAt).comp s
    ((hasDerivAt_id s).div_const (r^2))
  simpa only [Function.comp_def, one_div, mul_one, div_eq_mul_inv, id_eq, one_mul] using hd.deriv

/-- Radial stationarity in the form needed to differentiate the normalized
mass. The defect integral is nonpositive for a decreasing radial cutoff. -/
theorem mass_stationarity {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    (n : ℝ) * mass u g f r = r * (∫ x, massDensityDeriv u g f r x) +
      (2/r^2) * (∫ x, defectDensity u g f r x) := by
  have hfs : ContDiff ℝ 1 (fun t : ℝ ↦ f (t/r^2)) := hf.comp (contDiff_id.div_const _)
  have he := radial_first_variation hu hg hdu hsym hdiv hfs (scaled_cutoff_compact u hR hr hz)
  have hi := (mass_hasDerivAt hu (fun i ↦ (hg i).continuous) hf hR hr hz hdz).1
  have hj := defectDensity_integrable hu hg hf hR hr hdz
  have hl : (∫ x, f (graphRadiusSq u x / r^2) * ((n : ℝ) * areaDensity (g x))) =
      (n : ℝ) * mass u g f r := by
    calc
      _ = ∫ x, (n : ℝ) * massDensity u g f r x := by
        apply integral_congr_ae
        exact Filter.Eventually.of_forall fun x ↦ by unfold massDensity; ring
      _ = _ := integral_const_mul _ _
  have hp x : 2 * deriv (fun t ↦ f (t/r^2)) (graphRadiusSq u x) *
      (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x)) =
      (-r) * massDensityDeriv u g f r x - (2/r^2) * defectDensity u g f r x := by
    rw [scaled_profile_deriv hf]
    unfold massDensityDeriv defectDensity
    have hnr := hr.ne'
    have hnw := (areaDensity_pos (g x)).ne'
    field_simp
    <;> ring
  have hri : (∫ x, 2 * deriv (fun t ↦ f (t/r^2)) (graphRadiusSq u x) *
      (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x))) =
      (-r) * (∫ x, massDensityDeriv u g f r x) - (2/r^2) * (∫ x, defectDensity u g f r x) := by
    simp_rw [hp]
    calc
      _ = (∫ x, (-r) * massDensityDeriv u g f r x) -
          (∫ x, (2/r^2) * defectDensity u g f r x) :=
        integral_sub (hi.const_mul (-r)) (hj.const_mul (2/r^2))
      _ = _ := by rw [integral_const_mul, integral_const_mul]
  change (∫ x, f (graphRadiusSq u x / r^2) * ((n : ℝ) * areaDensity (g x))) =
    -(∫ x, 2 * deriv (fun t ↦ f (t/r^2)) (graphRadiusSq u x) *
      (graphRadiusSq u x * areaDensity (g x) - defect u g x ^ 2 / areaDensity (g x))) at he
  rw [hl, hri] at he
  linarith

end
end Source29GraphScaledStationarity

/- Component: GraphMassMonotonicity.inc -/
namespace Source29GraphMassMonotonicity

open MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction
open Source29GraphRadialGeometry Source29GraphRadialCurrent Source29GraphMassDerivative
open Source29GraphScaledStationarity Source29GraphAreaConvexity
open scoped Topology

noncomputable section
variable {n : ℕ}

def normalizedMass (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (f : ℝ → ℝ) (r : ℝ) : ℝ := mass u g f r / r^n

theorem normalized_hasDerivAt {I : ℝ → ℝ} {I' r : ℝ} (hI : HasDerivAt I I' r)
    (hr : r ≠ 0) (n : ℕ) :
    HasDerivAt (fun t ↦ I t / t^n) ((r*I' - (n : ℝ)*I r)/r^(n+1)) r := by
  have hd := hI.div ((hasDerivAt_id r).pow n) (pow_ne_zero n hr)
  convert hd using 1
  · funext t
    rfl
  · cases n with
    | zero => simp [id_eq, hr]
    | succ m =>
      simp only [Pi.pow_apply, id_eq, Nat.succ_eq_add_one, Nat.add_sub_cancel, mul_one]
      simp only [pow_succ]
      have hp : r^m ≠ 0 := pow_ne_zero m hr
      field_simp
      <;> ring

/-- Exact derivative of smoothed normalized graph area. -/
theorem normalizedMass_hasDerivAt {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R r : ℝ} (hR : 0 ≤ R) (hr : 0 < r)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0) :
    HasDerivAt (normalizedMass u g f)
      ((-2/r^(n+3)) * (∫ x, defectDensity u g f r x)) r := by
  have hd := normalized_hasDerivAt (mass_hasDerivAt hu (fun i ↦ (hg i).continuous) hf hR hr hz hdz).2 hr.ne' n
  have hs := mass_stationarity hu hg hdu hsym hdiv hf hR hr hz hdz
  convert hd using 1
  · rfl
  · rw [hs]
    have hn := hr.ne'
    have hp := pow_ne_zero n hn
    simp only [pow_add, pow_one]
    field_simp
    <;> ring

/-- Smoothed normalized graph area is nondecreasing in the positive radius. -/
theorem normalizedMass_monotoneOn {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (hdec : ∀ t, deriv f t ≤ 0) : MonotoneOn (normalizedMass u g f) (Ioi 0) := by
  have hd (r : ℝ) (hr : 0 < r) := normalizedMass_hasDerivAt hu hg hdu hsym hdiv hf hR hr hz hdz
  apply monotoneOn_of_deriv_nonneg (convex_Ioi (0 : ℝ))
  · intro r hr
    exact (hd r hr).continuousAt.continuousWithinAt
  · intro r hr
    exact (hd r (by simpa only [interior_Ioi, mem_Ioi] using hr)).differentiableAt.differentiableWithinAt
  · intro r hr
    have hr' : 0 < r := by simpa only [interior_Ioi, mem_Ioi] using hr
    rw [(hd r hr').deriv]
    have hj : (∫ x, defectDensity u g f r x) ≤ 0 := by
      apply integral_nonpos
      intro x
      exact div_nonpos_of_nonpos_of_nonneg
        (mul_nonpos_of_nonpos_of_nonneg (hdec _) (sq_nonneg _)) (areaDensity_pos _).le
    exact mul_nonneg_of_nonpos_of_nonpos (div_nonpos_of_nonpos_of_nonneg (by norm_num) (pow_pos hr' _).le) hj

end
end Source29GraphMassMonotonicity

/- Component: PolynomialGraphMonotonicity.inc -/
namespace Source29PolynomialGraphMonotonicity

open MvPolynomial MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29QuarticReuse.QuarticPolynomialBasics
open Source29GraphMassMonotonicity

noncomputable section
variable {n : ℕ}

def radialCutoff (s : ℝ) : ℝ := 1 - Real.smoothTransition s

theorem radialCutoff_contDiff : ContDiff ℝ 1 radialCutoff :=
  contDiff_const.sub Real.smoothTransition.contDiff

theorem radialCutoff_deriv (s : ℝ) : deriv radialCutoff s = -deriv Real.smoothTransition s := by
  exact (((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num) s).hasDerivAt.const_sub 1).deriv

theorem radialCutoff_bounds (s : ℝ) : 0 ≤ radialCutoff s ∧ radialCutoff s ≤ 1 := by
  have hl := Real.smoothTransition.nonneg s
  have hu := Real.smoothTransition.le_one s
  unfold radialCutoff
  constructor <;> linarith

theorem radialCutoff_deriv_nonpos (s : ℝ) : deriv radialCutoff s ≤ 0 := by
  rw [radialCutoff_deriv]
  exact neg_nonpos.mpr Real.smoothTransition.monotone.deriv_nonneg

theorem radialCutoff_zero (s : ℝ) (hs : 2 ≤ s) : radialCutoff s = 0 := by
  unfold radialCutoff
  rw [Real.smoothTransition.one_of_one_le (by linarith), sub_self]

theorem radialCutoff_deriv_zero (s : ℝ) (hs : 2 ≤ s) : deriv radialCutoff s = 0 := by
  rw [radialCutoff_deriv, Source29GraphHeightProfile.profile_deriv_zero_right (by linarith), neg_zero]

theorem polynomial_gradient_fderiv (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ eval y P) x (Pi.single i 1) = evaluatedGradient P x i := by
  rw [fderiv_eval, evalFDeriv_basis]
  rfl

theorem polynomial_gradient_symmetric (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) (i j : Fin n) :
    fderiv ℝ (fun y ↦ evaluatedGradient P y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ evaluatedGradient P y i) x (Pi.single j 1) := by
  change fderiv ℝ (fun y ↦ eval y (pderiv j P)) x (Pi.single i 1) =
    fderiv ℝ (fun y ↦ eval y (pderiv i P)) x (Pi.single j 1)
  rw [fderiv_eval, fderiv_eval, evalFDeriv_basis, evalFDeriv_basis, second_partial_comm]

/-- Smoothed area monotonicity for every full polynomial minimal graph. -/
theorem polynomial_normalizedMass_monotoneOn (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) (hdz : ∀ t, R ≤ t → deriv f t = 0)
    (hdec : ∀ t, deriv f t ≤ 0) :
    MonotoneOn (normalizedMass (fun x ↦ eval x P) (evaluatedGradient P) f) (Ioi 0) :=
  normalizedMass_monotoneOn (contDiff_eval P) (fun i ↦ contDiff_eval (pderiv i P))
    (polynomial_gradient_fderiv P) (polynomial_gradient_symmetric P)
    (Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin) hf hR hz hdz hdec

theorem polynomial_radialMass_monotoneOn (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) :
    MonotoneOn (normalizedMass (fun x ↦ eval x P) (evaluatedGradient P) radialCutoff) (Ioi 0) :=
  polynomial_normalizedMass_monotoneOn P hmin radialCutoff_contDiff (R := 2) (by norm_num)
    radialCutoff_zero radialCutoff_deriv_zero radialCutoff_deriv_nonpos

end
end Source29PolynomialGraphMonotonicity

/- Component: GraphMassRigidity.inc -/
namespace Source29GraphMassRigidity

open MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction
open Source29GraphRadialGeometry Source29GraphRadialCurrent Source29GraphRadialSupport
open Source29GraphMassMonotonicity Source29GraphScaledStationarity Source29GraphAreaConvexity
open Source29PolynomialGraphMonotonicity
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem radialCutoff_deriv_half : deriv radialCutoff (1/2) = -2 := by
  let A := expNegInvGlue (1/2)
  have hA : 0 < A := expNegInvGlue.pos_of_pos (by norm_num)
  have ha : HasDerivAt expNegInvGlue (4*A) (1/2) := by
    convert expNegInvGlue_hasDerivAt (1/2) using 1 <;> norm_num [A]
  have hb : HasDerivAt (fun t : ℝ ↦ expNegInvGlue (1-t)) (-4*A) (1/2) := by
    have h := (expNegInvGlue_hasDerivAt (1-(1/2))).comp (1/2) ((hasDerivAt_id (1/2)).const_sub 1)
    convert h using 1
    · rfl
    · norm_num [A]
  have hden : expNegInvGlue (1/2) + expNegInvGlue (1-(1/2)) ≠ 0 :=
    (Real.smoothTransition.pos_denom _).ne'
  have hd := (ha.fun_div (ha.add hb) hden).deriv
  change deriv Real.smoothTransition (1/2) = _ at hd
  rw [radialCutoff_deriv, hd]
  norm_num [show (1 : ℝ) - 1/2 = 1/2 by norm_num]
  change 4*A*(A+A)/(A+A)^2 = 2
  have hdenA : A+A ≠ 0 := (add_pos hA hA).ne'
  field_simp
  <;> ring

theorem defectDensity_continuous {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f) (r : ℝ) : Continuous (defectDensity u g f r) :=
  ((hf.continuous_deriv_one.comp ((graphRadiusSq_contDiff hu).continuous.div_const _)).mul
    ((defect_contDiff hu hg).continuous.pow 2)).div
    (areaDensity_continuous g (fun i ↦ (hg i).continuous)) (fun x ↦ (areaDensity_pos _).ne')

theorem radius_pos_of_defect_ne_zero (u : (Fin n → ℝ) → ℝ) (g : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) (hne : defect u g x ≠ 0) : 0 < graphRadiusSq u x := by
  by_contra hn
  have hsum : 0 ≤ ∑ i, x i ^ 2 := Finset.sum_nonneg fun i _ ↦ sq_nonneg _
  have hzero : graphRadiusSq u x ≤ 0 := le_of_not_gt hn
  unfold graphRadiusSq at hzero
  have hu : u x = 0 := by nlinarith [sq_nonneg (u x)]
  have hx (i : Fin n) : x i = 0 := by
    have hi : x i ^ 2 ≤ ∑ j, x j ^ 2 :=
      Finset.single_le_sum (fun j _ ↦ sq_nonneg _) (Finset.mem_univ i)
    nlinarith [sq_nonneg (x i)]
  apply hne
  simp only [defect, hu, hx, zero_mul, Finset.sum_const_zero, sub_self]

/-- Constancy of the explicit smoothed normalized area forces the radial
normal defect to vanish everywhere. -/
theorem defect_zero_of_normalizedMass_constant {u : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hsym : ∀ x i j, fderiv ℝ (fun y ↦ g y j) x (Pi.single i 1) =
      fderiv ℝ (fun y ↦ g y i) x (Pi.single j 1))
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    {C : ℝ} (hc : ∀ r, 0 < r → normalizedMass u g radialCutoff r = C) :
    ∀ x, defect u g x = 0 := by
  intro x
  by_contra hne
  have hs := radius_pos_of_defect_ne_zero u g x hne
  let r := Real.sqrt (2*graphRadiusSq u x)
  have hr : 0 < r := Real.sqrt_pos.mpr (by positivity)
  have hr2 : r^2 = 2*graphRadiusSq u x := Real.sq_sqrt (by positivity)
  have harg : graphRadiusSq u x / r^2 = 1/2 := by rw [hr2]; field_simp
  have hd := normalizedMass_hasDerivAt hu hg hdu hsym hdiv radialCutoff_contDiff
    (R := 2) (by norm_num) hr radialCutoff_zero radialCutoff_deriv_zero
  have he : normalizedMass u g radialCutoff =ᶠ[𝓝 r] fun _ ↦ C := by
    filter_upwards [lt_mem_nhds hr] with t ht
    exact hc t ht
  have hzder : deriv (normalizedMass u g radialCutoff) r = 0 := by
    rw [he.deriv_eq, deriv_const]
  rw [hd.deriv] at hzder
  have hcoef : (-2 : ℝ)/r^(n+3) ≠ 0 := div_ne_zero (by norm_num) (pow_ne_zero _ hr.ne')
  have hjzero : (∫ y, defectDensity u g radialCutoff r y) = 0 :=
    (mul_eq_zero.mp hzder).resolve_left hcoef
  have hj := defectDensity_integrable hu hg radialCutoff_contDiff (R := 2) (by norm_num)
    hr radialCutoff_deriv_zero
  have hneg : 0 < ∫ y, -defectDensity u g radialCutoff r y := by
    apply integral_pos_of_integrable_nonneg_nonzero (x := x)
      (defectDensity_continuous hu hg radialCutoff_contDiff r).neg hj.neg
    · intro y
      apply neg_nonneg.mpr
      exact div_nonpos_of_nonpos_of_nonneg
        (mul_nonpos_of_nonpos_of_nonneg (radialCutoff_deriv_nonpos _) (sq_nonneg _)) (areaDensity_pos _).le
    · apply ne_of_gt
      change 0 < -(defectDensity u g radialCutoff r x)
      unfold defectDensity
      rw [harg, radialCutoff_deriv_half]
      have hsq : 0 < defect u g x ^ 2 := sq_pos_of_ne_zero hne
      have hw := areaDensity_pos (g x)
      exact neg_pos.mpr (div_neg_of_neg_of_pos (by nlinarith) hw)
  rw [integral_neg, hjzero, neg_zero] at hneg
  exact lt_irrefl _ hneg

end
end Source29GraphMassRigidity

/- Component: PolynomialEulerRigidity.inc -/
namespace Source29PolynomialEulerRigidity

open MvPolynomial
open Source29QuarticReuse.FluxObstruction Source29GraphRadialCurrent
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem coeff_X_pderiv (P : MvPolynomial (Fin n) ℝ) (i : Fin n) (m : Fin n →₀ ℕ) :
    (X i * pderiv i P).coeff m = (m i : ℝ) * P.coeff m := by
  classical
  induction P using MvPolynomial.induction_on' with
  | add P Q hP hQ =>
    simp only [map_add, mul_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hP, hQ]
  | monomial d a =>
    rw [X_mul_pderiv_monomial, AddMonoidAlgebra.coeff_smul_apply]
    simp only [nsmul_eq_mul, coeff_monomial]
    by_cases hm : d = m
    · subst d
      simp
    · simp [hm]

theorem degree_le_one_of_euler_identity (P : MvPolynomial (Fin n) ℝ)
    (hP : P = ∑ i, X i * pderiv i P) : P.totalDegree ≤ 1 := by
  classical
  apply Finset.sup_le
  intro m hm
  have hn : P.coeff m ≠ 0 := mem_support_iff.mp hm
  have he := congrArg (fun Q : MvPolynomial (Fin n) ℝ ↦ Q.coeff m) hP
  simp only [coeff_sum, coeff_X_pderiv, ← Finset.sum_mul, ← Nat.cast_sum] at he
  have hs : (∑ i, m i : ℝ) = 1 := by
    apply (mul_right_cancel₀ hn)
    simpa only [one_mul, Nat.cast_sum] using he.symm
  have hnat : ∑ i, m i = 1 := by exact_mod_cast hs
  change (m.sum fun _ e ↦ e) ≤ 1
  rw [Finsupp.sum_fintype _ _ (by simp)]
  exact hnat.le

theorem degree_le_one_of_defect_zero (P : MvPolynomial (Fin n) ℝ)
    (hz : ∀ x, defect (fun y ↦ eval y P) (evaluatedGradient P) x = 0) :
    P.totalDegree ≤ 1 := by
  apply degree_le_one_of_euler_identity
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro x
  have he := hz x
  unfold defect evaluatedGradient at he
  simpa only [map_sum, map_mul, eval_X] using sub_eq_zero.mp he

end
end Source29PolynomialEulerRigidity

/- Component: PolynomialRadialRigidity.inc -/
namespace Source29PolynomialRadialRigidity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29PolynomialGraphMonotonicity Source29GraphMassMonotonicity
open scoped Topology

noncomputable section
variable {n : ℕ}

theorem affine_of_constant_normalizedMass (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    {C : ℝ} (hc : ∀ r, 0 < r → normalizedMass (fun x ↦ eval x P) (evaluatedGradient P) radialCutoff r = C) :
    Math30.MinimalGraphs.IsAffine P := by
  apply Source29PolynomialEulerRigidity.degree_le_one_of_defect_zero
  exact Source29GraphMassRigidity.defect_zero_of_normalizedMass_constant
    (contDiff_eval P) (fun i ↦ contDiff_eval (pderiv i P))
    (polynomial_gradient_fderiv P) (polynomial_gradient_symmetric P)
    (Source29GraphCalibration.polynomial_normalizedGradient_divergence_zero P hmin) hc

theorem constant_of_monotone_equal_limits {f : ℝ → ℝ} {C : ℝ}
    (hm : MonotoneOn f (Ioi 0)) (hz : Tendsto f (𝓝[>] 0) (𝓝 C))
    (hi : Tendsto f atTop (𝓝 C)) : ∀ r, 0 < r → f r = C := by
  intro r hr
  apply le_antisymm
  · apply ge_of_tendsto hi
    filter_upwards [eventually_ge_atTop r] with t ht
    exact hm hr (hr.trans_le ht) ht
  · apply le_of_tendsto hz
    filter_upwards [self_mem_nhdsWithin, mem_nhdsWithin_of_mem_nhds (gt_mem_nhds hr)] with t ht htr
    exact hm ht hr htr.le

/-- Matching finite density limits at the origin and infinity force an
actual polynomial minimal graph to be affine. Establishing those limits in
the linear-leading-factor case remains a separate obligation. -/
theorem affine_of_equal_radial_limits (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) {C : ℝ}
    (hz : Tendsto (normalizedMass (fun x ↦ eval x P) (evaluatedGradient P) radialCutoff)
      (𝓝[>] 0) (𝓝 C))
    (hi : Tendsto (normalizedMass (fun x ↦ eval x P) (evaluatedGradient P) radialCutoff)
      atTop (𝓝 C)) : Math30.MinimalGraphs.IsAffine P := by
  exact affine_of_constant_normalizedMass P hmin
    (constant_of_monotone_equal_limits (polynomial_radialMass_monotoneOn P hmin) hz hi)

end
end Source29PolynomialRadialRigidity

/- Component: GraphMassDilation.inc -/
namespace Source29GraphMassDilation

