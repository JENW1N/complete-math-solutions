  unfold Source29PolynomialCurvaturePotential.curvaturePotential
  rw [hg, Source29CurvaturePotentialAxis.potential_axis_link _ a ha hs hr]
  rfl

/-- The analytic defining root and the original polynomial have the same
base curvature potential, with no equation assumed for the original factor. -/
theorem normSq_normalized_hessian_eq_curvaturePotential
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (p k : ℕ) (hk : 0 < k)
    (hPhom : P.IsHomogeneous p) (hP : eval base P = 0) (hQ : 0 < eval base Q)
    (a : ℝ) (ha : a ≠ 0) (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0) :
    Source29GaussSimonsAlgebra.normSq
      (A (definingRoot P Q k) ((eval base Q)^((k : ℝ)⁻¹)*a)) =
      Source29PolynomialCurvaturePotential.curvaturePotential P base := by
  rw [curvaturePotential_at_base P p hPhom a ha hpn hpt]
  simp only [Source29GaussSimonsAlgebra.normSq, normalized_hessian_eq P Q k hk hP hQ a hpt,
    div_pow, ← Finset.sum_div]

end
end Source29AnalyticPositiveRootCurvature

