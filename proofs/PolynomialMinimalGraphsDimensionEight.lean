      simp only [pow_succ, Nat.cast_succ]
      by_cases hij : i = j
      · subst j; simp; ring
      · simp [hij, Ne.symm hij]; ring

lemma polynomial_second_partial_comm (g : MvPolynomial ι R) (i j : ι) :
    pderiv i (pderiv j g) = pderiv j (pderiv i g) := by
  classical
  ext r
  simp only [coeff_pderiv]
  by_cases h : i = j
  · subst j; rfl
  · simp [h, Ne.symm h, add_right_comm, mul_right_comm]

/- This Euler proof is adapted from Mathlib/RingTheory/MvPolynomial/EulerIdentity.lean.
Copyright (c) 2024 Junyan Xu. Apache 2.0 license. -/
lemma weighted_euler {g : MvPolynomial ι R} {w : ι → ℕ} {d : ℕ}
    (h : g.IsWeightedHomogeneous w d) :
    ∑ i : ι, w i • (X i * pderiv i g) = d • g := by
  rw [← mem_weightedHomogeneousSubmodule, weightedHomogeneousSubmodule_eq_finsupp_supported,
    AddMonoidAlgebra.supported_eq_span_single] at h
  refine Submodule.span_induction ?_ ?_ (fun p q _ _ hp hq ↦ ?_) (fun r p _ h ↦ ?_) h
  · rintro _ ⟨m, hm, rfl⟩
    simp_rw [single_eq_monomial, X_mul_pderiv_monomial, smul_smul, ← sum_smul, mul_comm (w _)]
    congr
    rwa [Set.mem_ofPred, Finsupp.weight_apply, Finsupp.sum_fintype] at hm
    intro; apply zero_smul
  · simp
  · simp_rw [map_add, left_distrib, smul_add, sum_add_distrib, hp, hq]
  · simp_rw [(pderiv _).map_smul, nsmul_eq_mul, mul_smul_comm, ← Finset.smul_sum,
      ← nsmul_eq_mul, h]

lemma homogeneous_euler {g : MvPolynomial ι R} {d : ℕ} (h : g.IsHomogeneous d) :
    dot X (fun i => pderiv i g) = (d : MvPolynomial ι R) * g := by
  have he := weighted_euler h
  simpa [dot, nsmul_eq_mul] using he

lemma differentiated_euler {g : MvPolynomial ι R} {d : ℕ}
    (h : dot X (fun i => pderiv i g) = (d : MvPolynomial ι R) * g) (i : ι) :
    (∑ j, pderiv i (pderiv j g) * X j) =
      ((d : MvPolynomial ι R) - 1) * pderiv i g := by
  have hd := congrArg (pderiv i) h
  simp only [dot, map_sum, pderiv_mul, pderiv_X] at hd
  have hc : pderiv i (d : MvPolynomial ι R) = 0 := by
    simpa only [map_natCast] using (pderiv_C (a := (d : R)) (i := i))
  rw [hc, zero_mul, zero_add] at hd
  simp only [Finset.sum_add_distrib, Pi.single_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] at hd
  calc
    (∑ j, pderiv i (pderiv j g) * X j) = ∑ j, X j * pderiv i (pderiv j g) := by
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ = ((d : MvPolynomial ι R) - 1) * pderiv i g := by
      linear_combination hd

lemma radialPolynomial_ne_zero [IsDomain R] [Nonempty ι] :
    (radialPolynomial : MvPolynomial ι R) ≠ 0 := by
  classical
  obtain ⟨i⟩ := ‹Nonempty ι›
  intro h
  have he := congrArg (eval (Pi.single i (1 : R))) h
  simpa [radialPolynomial, Pi.single_apply] using he

theorem radial_polynomial_identity [IsDomain R] [Nonempty ι]
    (a d : ℕ) (ha : 1 ≤ a) (g : MvPolynomial ι R) (hg : g.IsHomogeneous d) :
    polynomialL (radialPolynomial^a * g) =
      radialPolynomial^(3*a-2) * (radialPolynomial^2 * polynomialL g +
        2 * (a : MvPolynomial ι R) *
          ((Fintype.card ι : MvPolynomial ι R) - 2 * (d : MvPolynomial ι R) - 1 - 2 * (a : MvPolynomial ι R)) *
          radialPolynomial * g * dot (fun i => pderiv i g) (fun i => pderiv i g) +
        4 * (a : MvPolynomial ι R) * ((a : MvPolynomial ι R) + (d : MvPolynomial ι R)) *
          radialPolynomial * g^2 * trace (fun i j => pderiv i (pderiv j g)) +
        4 * (a : MvPolynomial ι R) * ((a : MvPolynomial ι R) + (d : MvPolynomial ι R)) *
          (2 * (a : MvPolynomial ι R) * ((Fintype.card ι : MvPolynomial ι R) - 1) + (d : MvPolynomial ι R)) * g^3) := by
  let q : MvPolynomial ι R := radialPolynomial
  let u : ι → MvPolynomial ι R := fun i => pderiv i g
  let H : ι → ι → MvPolynomial ι R := fun i j => pderiv i (pderiv j g)
  let F : MvPolynomial ι R := q^a * g
  have hgrad : (fun i => q * pderiv i F) =
      (fun i => q^a * radialGradient (a : MvPolynomial ι R) q g X u i) := by
    funext i
    exact scaled_first_partial a g i
  have hhess : (fun i j => q^2 * pderiv i (pderiv j F)) =
      (fun i j => q^a * radialHessian (a : MvPolynomial ι R) q g X u H i j) := by
    funext i j
    exact scaled_second_partial a g i j
  have heuler : dot X u = (d : MvPolynomial ι R) * g := homogeneous_euler hg
  have hformula := radial_jet_identity (a : MvPolynomial ι R) q g
    (d : MvPolynomial ι R) X u H (by simp [dot, q, radialPolynomial, pow_two]) heuler
    (polynomial_second_partial_comm g) (differentiated_euler heuler)
  have hscaled :
      q^4 * polynomialL F = q^(3*a) *
        jetL (radialGradient (a : MvPolynomial ι R) q g X u)
          (radialHessian (a : MvPolynomial ι R) q g X u H) := by
    calc
      q^4 * polynomialL F =
          jetL (fun i => q * pderiv i F) (fun i j => q^2 * pderiv i (pderiv j F)) := by
        rw [jetL_scale]
        unfold polynomialL
        ring
      _ = jetL (fun i => q^a * radialGradient (a : MvPolynomial ι R) q g X u i)
          (fun i j => q^a * radialHessian (a : MvPolynomial ι R) q g X u H i j) := by
        rw [hgrad, hhess]
      _ = q^(3*a) * jetL (radialGradient (a : MvPolynomial ι R) q g X u)
          (radialHessian (a : MvPolynomial ι R) q g X u H) := by
        rw [jetL_scale, show 3*a = a*3 by omega, pow_mul]
        ring
  have hpower : q^(3*a) * q^2 = q^4 * q^(3*a-2) := by
    rw [← pow_add, ← pow_add]
    congr 1
    omega
  apply mul_left_cancel₀ (pow_ne_zero 4 (radialPolynomial_ne_zero (R := R) (ι := ι)))
  change q^4 * polynomialL F = _
  rw [hscaled, hformula]
  rw [← mul_assoc, hpower, mul_assoc]
  rfl

noncomputable def radialCoefficient (a d : ℕ) : MvPolynomial ι R :=
  4 * (a : MvPolynomial ι R) * ((a : MvPolynomial ι R) + (d : MvPolynomial ι R)) *
    (2 * (a : MvPolynomial ι R) * ((Fintype.card ι : MvPolynomial ι R) - 1) +
      (d : MvPolynomial ι R))

/-- Reduction of the radial identity modulo the prime radial polynomial. -/
theorem radial_factor_descent [IsDomain R] [Nonempty ι]
    (a d : ℕ) (ha : 1 ≤ a) (g : MvPolynomial ι R) (hg : g.IsHomogeneous d)
    (hqPrime : Prime (radialPolynomial : MvPolynomial ι R))
    (hcUnit : IsUnit (radialCoefficient (R := R) (ι := ι) a d))
    (hL : polynomialL (radialPolynomial^a * g) = 0) :
    (radialPolynomial : MvPolynomial ι R) ∣ g := by
  let q : MvPolynomial ι R := radialPolynomial
  let c : MvPolynomial ι R := radialCoefficient a d
  let t : MvPolynomial ι R := q * polynomialL g +
    2 * (a : MvPolynomial ι R) *
      ((Fintype.card ι : MvPolynomial ι R) - 2 * (d : MvPolynomial ι R) - 1 - 2 * (a : MvPolynomial ι R)) *
      g * dot (fun i => pderiv i g) (fun i => pderiv i g) +
    4 * (a : MvPolynomial ι R) * ((a : MvPolynomial ι R) + (d : MvPolynomial ι R)) *
      g^2 * trace (fun i j => pderiv i (pderiv j g))
  have hmul : q^(3*a-2) * (q*t+c*g^3) = 0 := by
    calc
      q^(3*a-2) * (q*t+c*g^3) = polynomialL (radialPolynomial^a * g) := by
        rw [radial_polynomial_identity a d ha g hg]
        dsimp only [q, t, c, radialCoefficient]
        ring
      _ = 0 := hL
  have hzero : q*t+c*g^3 = 0 :=
    (mul_eq_zero.mp hmul).resolve_left (pow_ne_zero _ radialPolynomial_ne_zero)
  have hdiv : q ∣ c*g^3 := by
    use -t
    linear_combination hzero
  rcases hqPrime.dvd_mul.mp hdiv with hc | hpow
  · exact False.elim (hqPrime.not_isUnit (isUnit_of_dvd_unit hc hcUnit))
  · exact hqPrime.dvd_of_dvd_pow hpow

end Polynomial

section Field

open MvPolynomial

variable {K : Type*} [Field K] [CharZero K]

lemma radialCoefficient_isUnit (hn : 2 ≤ Fintype.card ι) (a d : ℕ) (ha : 1 ≤ a) :
    IsUnit (radialCoefficient (R := K) (ι := ι) a d) := by
  let N : ℕ := 4*a*(a+d)*(2*a*(Fintype.card ι-1)+d)
  have hNpos : 0 < N := by
    dsimp [N]
    apply Nat.mul_pos
    · apply Nat.mul_pos
      · exact Nat.mul_pos (by decide) (by omega)
      · omega
    · have : 0 < 2*a*(Fintype.card ι-1) :=
        Nat.mul_pos (Nat.mul_pos (by decide) (by omega)) (by omega)
      omega
  have hNnz : (N : K) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hNpos)
  have hu : IsUnit (C (N : K) : MvPolynomial ι K) :=
    (isUnit_iff_ne_zero.mpr hNnz).map C
  convert hu using 1
  dsimp only [radialCoefficient, N]
  simp only [Nat.cast_mul, Nat.cast_add, Nat.cast_sub (show 1 ≤ Fintype.card ι by omega),
    Nat.cast_ofNat, Nat.cast_one, map_mul, map_add, map_sub, map_natCast, map_ofNat, map_one]

/-- No positive power of the radial polynomial times a radial-primitive homogeneous
polynomial can solve L(F)=0. Irreducibility of the radial polynomial is supplied separately. -/
theorem no_radial_factor_primitive (hn : 2 ≤ Fintype.card ι)
    (hqPrime : Prime (radialPolynomial : MvPolynomial ι K))
    (a d : ℕ) (ha : 1 ≤ a) (g : MvPolynomial ι K) (hg : g.IsHomogeneous d)
    (hprimitive : ¬(radialPolynomial : MvPolynomial ι K) ∣ g) :
    polynomialL (radialPolynomial^a * g) ≠ 0 := by
  haveI : Nonempty ι := Fintype.card_pos_iff.mp (by omega)
  intro hL
  exact hprimitive (radial_factor_descent a d ha g hg hqPrime
    (radialCoefficient_isUnit hn a d ha) hL)

/-- The full radial obstruction, with the standard homogeneous-divisor theorem
provided as the quotient-homogeneity hypothesis. -/
theorem no_radial_factor_of_homogeneous_quotients (hn : 2 ≤ Fintype.card ι)
    (hqPrime : Prime (radialPolynomial : MvPolynomial ι K))
    (F : MvPolynomial ι K) (hF : F ≠ 0) (hL : polynomialL F = 0)
    (hquot : ∀ (a : ℕ) (g : MvPolynomial ι K),
      F = radialPolynomial^a * g → ∃ d : ℕ, g.IsHomogeneous d) :
    ¬(radialPolynomial : MvPolynomial ι K) ∣ F := by
  intro hdiv
  obtain ⟨a, g, hprimitive, hfactor⟩ := WfDvdMonoid.max_power_factor' hF hqPrime.not_isUnit
  have ha : 1 ≤ a := by
    by_contra hh
    have haz : a = 0 := by omega
    subst a
    simp only [pow_zero, one_mul] at hfactor
    exact hprimitive (hfactor ▸ hdiv)
  obtain ⟨d, hg⟩ := hquot a g hfactor
  exact (no_radial_factor_primitive hn hqPrime a d ha g hg hprimitive) (hfactor ▸ hL)

end Field

end Source29Radial

