/- Component: ClosingReduction.inc -/
/-!
# Conditional closing reduction for Math30Catalog.source29

This fragment is appended to LeadingReduction.lean for compilation. It proves
the final implication from two explicitly stated geometric inputs. Neither
input is established here; this fragment does not solve the challenge.
-/

namespace Source29Closing

open MvPolynomial

abbrev Polynomial8 := MvPolynomial (Fin 8) ℝ

/-- Strict positivity at every nonzero real point. -/
def PositiveAwayFromZero (Q : Polynomial8) : Prop :=
  ∀ x : Fin 8 → ℝ, x ≠ 0 → 0 < eval x Q

/-- The precise leading-term structure and degree bounds needed by the final
argument. Establishing this data from minimality remains a geometric obligation.
The positivity clause incorporates the dimension-eight zero-set argument. -/
def GuoData8 (P : Polynomial8) : Prop :=
  ∃ (p Q : Polynomial8) (k : ℕ),
    1 ≤ k ∧
    Q.IsHomogeneous Q.totalDegree ∧
    homogeneousComponent P.totalDegree P = p ^ k * Q ∧
    PositiveAwayFromZero Q ∧
    (3 : ℝ) < (p.totalDegree : ℝ) + (Q.totalDegree : ℝ) / (k : ℝ) ∧
    (p.totalDegree : ℝ) + (Q.totalDegree : ℝ) / (k : ℝ) < 4

/-- A positive homogeneous divisor of a nonzero homogeneous solution of the
cubic minimal-graph equation must be constant. This geometric obstruction is
an explicit assumption, not an axiom or an asserted established theorem. -/
def PositiveHomogeneousDivisorObstruction8 : Prop :=
  ∀ (F Q : Polynomial8) (m : ℕ),
    F ≠ 0 →
    F.IsHomogeneous m →
    QuarticPolynomialBasics.cubicOperator F = 0 →
    Q.IsHomogeneous Q.totalDegree →
    PositiveAwayFromZero Q →
    Q ∣ F →
    Q.totalDegree = 0

/-- Once the two geometric inputs are supplied, the all-degree leading-term
reduction and the strict integer-degree contradiction prove the exact target. -/
theorem problem29_of_geometric_inputs
    (hGuo : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → GuoData8 P)
    (hDivisor : PositiveHomogeneousDivisorObstruction8) :
    Math30.Problem29 := by
  intro P hminimal
  change P.totalDegree ≤ 1
  by_contra hnonaffine
  have hdegree : 2 ≤ P.totalDegree := by omega
  obtain ⟨p, Q, k, _hk, hQhom, hfactor, hQpos, hlower, hupper⟩ :=
    hGuo P hminimal hdegree
  obtain ⟨hne, hhom, hleading⟩ :=
    QuarticPolynomialBasics.leading_component_data P hminimal hdegree
  have hdiv : Q ∣ homogeneousComponent P.totalDegree P :=
    ⟨p ^ k, hfactor.trans (mul_comm _ _)⟩
  have hQdegree : Q.totalDegree = 0 :=
    hDivisor (homogeneousComponent P.totalDegree P) Q P.totalDegree
      hne hhom hleading hQhom hQpos hdiv
  apply QuarticPolynomialBasics.no_integer_degree_between_three_and_four p.totalDegree
  · simpa only [hQdegree, Nat.cast_zero, zero_div, add_zero] using hlower
  · simpa only [hQdegree, Nat.cast_zero, zero_div, add_zero] using hupper

end Source29Closing

/- Component: PositiveDivisor.inc -/
/-!
# Conditional positive-divisor obstruction in dimension eight

The complex geometric obstruction is an explicit hypothesis. All algebraic
steps from it to the positive-divisor obstruction and the closing implication
are established here. This fragment does not assert the geometric hypothesis.
-/

namespace Source29PositiveDivisor

open MvPolynomial
open scoped BigOperators

noncomputable section

abbrev ComplexPolynomial8 := MvPolynomial (Fin 8) ℂ

/-- The geometric complex-hypersurface input still to be proved. -/
def ComplexObstruction8 : Prop :=
  ∀ h : ComplexPolynomial8,
    Irreducible h →
    h.IsHomogeneous h.totalDegree →
    h ∣ Source29FactorInheritance.cubicOperator h →
    (∀ x : Fin 8 → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0) →
    Source29Quadric.quadric ∣ h

lemma complexify_totalDegree {ι : Type*} (Q : MvPolynomial ι ℝ) :
    (Source29RealComplex.complexify Q).totalDegree = Q.totalDegree := by
  simp only [totalDegree, Source29RealComplex.complexify,
    MvPolynomial.support_map_of_injective _ (algebraMap ℝ ℂ).injective]

lemma radialOperator_eq_cubic (F : ComplexPolynomial8) :
    Source29Radial.polynomialL F = Source29FactorInheritance.cubicOperator F := by
  simp only [Source29Radial.polynomialL, Source29Radial.jetL, Source29Radial.dot,
    Source29Radial.trace, Source29Radial.contract,
    Source29FactorInheritance.cubicOperator, pow_two]

/-- Homogeneity of polynomial factors supplies the quotient hypothesis of the
radial descent theorem. -/
theorem homogeneous_cubic_no_radial_factor (F : ComplexPolynomial8) (m : ℕ)
    (hF : F ≠ 0) (hhom : F.IsHomogeneous m)
    (hL : Source29FactorInheritance.cubicOperator F = 0) :
    ¬Source29Quadric.quadric ∣ F := by
  apply Source29Radial.no_radial_factor_of_homogeneous_quotients
    (K := ℂ) (ι := Fin 8) (by decide)
    (show Prime (Source29Radial.radialPolynomial : ComplexPolynomial8) from
      Source29Quadric.quadric_irreducible.prime) F hF
  · rwa [radialOperator_eq_cubic]
  · intro a g hfactor
    refine ⟨g.totalDegree, ?_⟩
    apply Source29HomogeneousFactor.divisor_isHomogeneous F g hF hhom
    exact ⟨Source29Radial.radialPolynomial^a, hfactor.trans (mul_comm _ _)⟩

/-- The complex obstruction implies the real positive homogeneous divisor
obstruction used in the final degree argument. -/
theorem positive_divisor_obstruction_of_complex_obstruction
    (hcomplex : ComplexObstruction8) :
    Source29Closing.PositiveHomogeneousDivisorObstruction8 := by
  intro F Q m hF hhom hL _hQhom hQpos hQdiv
  by_contra hdegree
  have hFc : Source29RealComplex.complexify F ≠ 0 :=
    Source29RealComplex.complexify_ne_zero F hF
  have hQne : Q ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hQdiv
    exact hF hQdiv
  have hQc : Source29RealComplex.complexify Q ≠ 0 :=
    Source29RealComplex.complexify_ne_zero Q hQne
  have hQunit : ¬ IsUnit (Source29RealComplex.complexify Q) := by
    intro hu
    apply hdegree
    rw [← complexify_totalDegree Q]
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have hprod : Source29RealComplex.complexify Q * v ≠ 0 := by
      rw [hv]
      exact one_ne_zero
    have hd := congrArg MvPolynomial.totalDegree hv
    rw [MvPolynomial.totalDegree_mul_of_isDomain hQc (right_ne_zero_of_mul hprod),
      MvPolynomial.totalDegree_one] at hd
    omega
  obtain ⟨h, hh, hhQ⟩ := WfDvdMonoid.exists_irreducible_factor hQunit hQc
  have hQFc : Source29RealComplex.complexify Q ∣ Source29RealComplex.complexify F := by
    obtain ⟨v, hv⟩ := hQdiv
    refine ⟨Source29RealComplex.complexify v, ?_⟩
    simp only [Source29RealComplex.complexify, hv, map_mul]
  have hhF := dvd_trans hhQ hQFc
  have hFhom := Source29RealComplex.complexify_isHomogeneous F m hhom
  have hFzero : Source29FactorInheritance.cubicOperator
      (Source29RealComplex.complexify F) = 0 := by
    apply Source29RealComplex.complexify_cubic_zero
    exact hL
  have hhirredHom := Source29HomogeneousFactor.divisor_isHomogeneous
    (Source29RealComplex.complexify F) h hFc hFhom hhF
  have hhinherit := Source29RealComplex.irreducible_divisor_inherits
    (Source29RealComplex.complexify F) h hFc hFzero hh hhF
  have hhnozeros := Source29RealComplex.factor_no_nonzero_real_zero Q h hQpos hhQ
  have hqh := hcomplex h hh hhirredHom hhinherit hhnozeros
  exact homogeneous_cubic_no_radial_factor (Source29RealComplex.complexify F) m
    hFc hFhom hFzero (dvd_trans hqh hhF)

/-- Conditional closing theorem: the exact challenge follows from the stated
Guo input and complex geometric obstruction. -/
theorem problem29_of_Guo_and_complex_obstruction
    (hGuo : ∀ P : Source29Closing.Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → Source29Closing.GuoData8 P)
    (hcomplex : ComplexObstruction8) : Math30.Problem29 := by
  exact Source29Closing.problem29_of_geometric_inputs hGuo
    (positive_divisor_obstruction_of_complex_obstruction hcomplex)

end
end Source29PositiveDivisor

/- Component: LocalMaximumBound.lean -/

namespace Source29LocalMaximumBound

noncomputable section

abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

variable {n : ℕ}

def dot (z w : CSpace n) : ℂ := ∑ i, z i * w i

def quadric (z : CSpace n) : ℂ := ∑ i, (z i)^2

def conjugate (z : CSpace n) : CSpace n := WithLp.toLp 2 (fun i => star (z i))

def normal (z : CSpace n) (κ : ℝ) : CSpace n := z - (κ : ℂ) • conjugate z

lemma dot_comm (z w : CSpace n) : dot z w = dot w z := by
  simp [dot, mul_comm]

lemma dot_add_right (z v w : CSpace n) : dot z (v + w) = dot z v + dot z w := by
  simp [dot, mul_add, Finset.sum_add_distrib]

lemma dot_smul_right (c : ℂ) (z w : CSpace n) : dot z (c • w) = c * dot z w := by
  simp [dot, mul_left_comm, Finset.mul_sum]

lemma dot_normal (z δ : CSpace n) (κ : ℝ) :
    dot (normal z κ) δ = dot z δ - (κ : ℂ) * dot (conjugate z) δ := by
  simp [dot, normal, sub_mul, Finset.sum_sub_distrib, mul_assoc, Finset.mul_sum]

lemma quadric_add (z δ : CSpace n) :
    quadric (z + δ) = quadric z + 2 * dot z δ + quadric δ := by
  unfold quadric dot
  simp only [PiLp.add_apply, add_sq, Finset.sum_add_distrib]
  congr 1
  congr 1
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

lemma dot_conjugate_eq_inner (z δ : CSpace n) :
    dot (conjugate z) δ = inner ℂ z δ := by
  simp [dot, conjugate, PiLp.inner_apply, mul_comm]

lemma norm_add_sq_expansion (z δ : CSpace n) :
    ‖z + δ‖^2 = ‖z‖^2 + 2 * (dot (conjugate z) δ).re + ‖δ‖^2 := by
  rw [dot_conjugate_eq_inner]
  exact norm_add_sq (𝕜 := ℂ) z δ

lemma quadric_norm_le (δ : CSpace n) : ‖quadric δ‖ ≤ ‖δ‖^2 := by
  calc
    ‖quadric δ‖ ≤ ∑ i : Fin n, ‖(δ i)^2‖ := norm_sum_le _ _
    _ = ‖δ‖^2 := by simp only [norm_pow, EuclideanSpace.norm_sq_eq]

lemma neg_norm_sq_le_quadric_re (δ : CSpace n) : -‖δ‖^2 ≤ (quadric δ).re := by
  have h := (abs_le.mp (Complex.abs_re_le_norm (quadric δ))).1
  have hb := quadric_norm_le δ
  linarith

/-- The global projective maximum inequality directly bounds the real normal
component of any displacement. No local remainder or smallness assumption is needed. -/
theorem normal_displacement_bound_sharp (z δ : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ))
    (hmaximum : ‖quadric (z + δ)‖ ≤ κ * ‖z + δ‖^2) :
    (dot (normal z κ) δ).re ≤ ((κ + 1) / 2) * ‖δ‖^2 := by
  have hr := (Complex.re_le_norm (quadric (z + δ))).trans hmaximum
  rw [quadric_add, hq] at hr
  norm_num [Complex.add_re, Complex.mul_re] at hr
  rw [norm_add_sq_expansion, hz, one_pow] at hr
  rw [dot_normal]
  simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  have hl := neg_norm_sq_le_quadric_re δ
  nlinarith

/-- In the range relevant to the normalized maximum, the bound has constant one. -/
theorem normal_displacement_bound (z δ : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) (hκ : κ ≤ 1)
    (hmaximum : ‖quadric (z + δ)‖ ≤ κ * ‖z + δ‖^2) :
    (dot (normal z κ) δ).re ≤ ‖δ‖^2 := by
  have h := normal_displacement_bound_sharp z δ κ hz hq hmaximum
  have hk := mul_le_mul_of_nonneg_right hκ (sq_nonneg ‖δ‖)
  nlinarith

/-- A tangent plus normal decomposition identifies the controlled component
with the normal coefficient times the bilinear square of the normal. -/
theorem normal_coefficient_bound (z ζ : CSpace n) (w : ℂ) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) (hκ : κ ≤ 1)
    (hζ : dot (normal z κ) ζ = 0)
    (hmaximum : ‖quadric (z + (ζ + w • normal z κ))‖ ≤
      κ * ‖z + (ζ + w • normal z κ)‖^2) :
    (dot (normal z κ) (normal z κ) * w).re ≤ ‖ζ + w • normal z κ‖^2 := by
  have h := normal_displacement_bound z (ζ + w • normal z κ) κ hz hq hκ hmaximum
  rw [dot_add_right, dot_smul_right, hζ, zero_add] at h
  simpa only [mul_comm] using h

lemma norm_conjugate (z : CSpace n) : ‖conjugate z‖ = ‖z‖ := by
  have h : ‖conjugate z‖^2 = ‖z‖^2 := by
    simp [EuclideanSpace.norm_sq_eq, conjugate]
  nlinarith [norm_nonneg (conjugate z), norm_nonneg z]

lemma inner_conjugate (z : CSpace n) :
    inner ℂ z (conjugate z) = star (quadric z) := by
  simp [PiLp.inner_apply, conjugate, quadric, pow_two]

/-- The normal's Hermitian squared norm at a normalized real phase maximum. -/
lemma norm_normal_sq (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) :
    ‖normal z κ‖^2 = 1 - κ^2 := by
  unfold normal
  rw [norm_sub_sq (𝕜 := ℂ), norm_smul, inner_smul_right, inner_conjugate,
    hq, norm_conjugate, hz]
  simp [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  ring

lemma norm_normal_le_one (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) :
    ‖normal z κ‖ ≤ 1 := by
  have h := norm_normal_sq z κ hz hq
  nlinarith [norm_nonneg (normal z κ), sq_nonneg κ]

/-- A form suitable for estimates in the tangent and normal coordinates. -/
theorem normal_coefficient_bound_coordinates (z ζ : CSpace n) (w : ℂ) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) (hκ : κ ≤ 1)
    (hζ : dot (normal z κ) ζ = 0)
    (hmaximum : ‖quadric (z + (ζ + w • normal z κ))‖ ≤
      κ * ‖z + (ζ + w • normal z κ)‖^2) :
    (dot (normal z κ) (normal z κ) * w).re ≤ 2 * (‖ζ‖^2 + ‖w‖^2) := by
  have h := normal_coefficient_bound z ζ w κ hz hq hκ hζ hmaximum
  have hN := norm_normal_le_one z κ hz hq
  have hwN : ‖w • normal z κ‖ ≤ ‖w‖ := by
    rw [norm_smul]
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hN (norm_nonneg w)
  have hs : ‖ζ + w • normal z κ‖ ≤ ‖ζ‖ + ‖w‖ :=
    (norm_add_le ζ (w • normal z κ)).trans (add_le_add le_rfl hwN)
  have hs2 := sq_le_sq₀ (norm_nonneg (ζ + w • normal z κ))
    (add_nonneg (norm_nonneg ζ) (norm_nonneg w))
  have hsq := hs2.mpr hs
  nlinarith [sq_nonneg (‖ζ‖ - ‖w‖)]

end

end Source29LocalMaximumBound

/- Component: SmallSlope.inc -/
/- Uniform tangent control near a polynomial zero, obtained by compactness of
normalized directions rather than a choice of analytic branches. -/

namespace Source29SmallSlope

open MvPolynomial Finset
open scoped Topology

noncomputable section

abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

lemma continuous_eval_rescale_joint {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ) :
    Continuous (fun p : ℂ × CSpace n =>
      eval (fun i => p.2 i) (Source29LowestRescale.rescale P s p.1)) := by
  simp only [Source29LowestRescale.rescale, map_sum, map_mul, eval_C]
  apply continuous_finsetSum
  intro k hk
  exact (continuous_fst.pow (k - s)).mul
    ((Source29ProjectiveMaximum.continuous_polynomial_eval _).comp continuous_snd)

lemma uniform_nonzero_near_zero {n : ℕ} (F : ℂ × CSpace n → ℂ)
    (hF : Continuous F) (K : Set (CSpace n)) (hK : IsCompact K)
    (hzero : ∀ y ∈ K, F (0, y) ≠ 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ t : ℂ, ‖t‖ < r → ∀ y ∈ K, F (t, y) ≠ 0 := by
  have he : ∀ᶠ t : ℂ in 𝓝 0, ∀ y ∈ K, F (t, y) ≠ 0 := by
    apply hK.eventually_forall_of_forall_eventually
    intro y hy
    exact hF.continuousAt.eventually_ne (hzero y hy)
  obtain ⟨r, hr, hrsub⟩ := Metric.mem_nhds_iff.mp he
  refine ⟨r, hr, ?_⟩
  intro t ht y hy
  exact hrsub (by simpa only [Metric.mem_ball, dist_zero_right] using ht) y hy

/-- Every nearby zero approaches the kernel of the initial form, uniformly in
the direction of approach. This statement only needs containment of the initial
zero set in a linear hyperplane. -/
theorem exists_small_linear_bound {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (L : CSpace n →L[ℂ] ℂ)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 → L v = 0)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ ∀ x : CSpace n, ‖x‖ < r →
      eval (fun i => x i) P = 0 → ‖L x‖ ≤ ε * ‖x‖ := by
  let K : Set (CSpace n) := {v | ‖v‖ = 1 ∧ ε ≤ ‖L v‖}
  have hKclosed : IsClosed K :=
    (isClosed_eq continuous_norm continuous_const).inter
      (isClosed_le continuous_const L.continuous.norm)
  have hK : IsCompact K := (isCompact_sphere (0 : CSpace n) 1).of_isClosed_subset
    hKclosed (by intro v hv; simpa [Metric.mem_sphere] using hv.1)
  let F : ℂ × CSpace n → ℂ := fun p =>
    eval (fun i => p.2 i) (Source29LowestRescale.rescale P s p.1)
  have hF : Continuous F := continuous_eval_rescale_joint P s
  have hFzero : ∀ v ∈ K, F (0, v) ≠ 0 := by
    intro v hv heq
    have hvzero : eval (fun i => v i) (homogeneousComponent s P) = 0 := by
      simpa only [F, Source29LowestRescale.rescale_zero P s hs hlow] using heq
    have hvL := hinitial v hvzero
    have hh := hv.2
    rw [hvL, norm_zero] at hh
    linarith
  obtain ⟨r, hr, hrF⟩ := uniform_nonzero_near_zero F hF K hK hFzero
  refine ⟨r, hr, ?_⟩
  intro x hx hzero
  by_cases hx0 : x = 0
  · simp [hx0]
  have hxnorm : 0 < ‖x‖ := norm_pos_iff.mpr hx0
  let t : ℂ := (‖x‖ : ℂ)
  let v : CSpace n := t⁻¹ • x
  have htne : t ≠ 0 := by
    dsimp only [t]
    exact_mod_cast hxnorm.ne'
  have htnorm : ‖t‖ = ‖x‖ := by simp [t]
  have hvnorm : ‖v‖ = 1 := by
    simp only [v, norm_smul, norm_inv, htnorm]
    exact inv_mul_cancel₀ hxnorm.ne'
  have htv : ∀ i, t * v i = x i := by
    intro i
    simp [v, htne]
  have hscaled := Source29LowestRescale.eval_rescale_mul P s hlow t (fun i => v i)
  have hres : F (t, v) = 0 := by
    have ht : (fun i => t * v i) = (fun i => x i) := funext htv
    rw [ht, hzero] at hscaled
    exact (mul_eq_zero.mp hscaled).resolve_left (pow_ne_zero _ htne)
  have hvLnorm : ‖L v‖ = ‖t‖⁻¹ * ‖L x‖ := by
    simp [v]
  by_contra hnot
  have hstrict : ε * ‖x‖ < ‖L x‖ := lt_of_not_ge hnot
  have hvK : v ∈ K := by
    refine ⟨hvnorm, ?_⟩
    rw [hvLnorm, htnorm, ← div_eq_inv_mul]
    exact le_of_lt ((lt_div_iff₀ hxnorm).mpr hstrict)
  exact hrF t (by simpa [htnorm] using hx) v hvK hres

/-- Control of a linear form relative to the ambient displacement controls the
normal coordinate relative to the tangential coordinate. -/
lemma exists_linear_tolerance {n : ℕ} (L : CSpace n →L[ℂ] ℂ)
    (N : CSpace n) (hN : L N ≠ 0) (ε : ℝ) (hε : 0 < ε) :
    ∃ η : ℝ, 0 < η ∧ ∀ (ζ : CSpace n) (w : ℂ), L ζ = 0 →
      ‖L (ζ + w • N)‖ ≤ η * ‖ζ + w • N‖ → ‖w‖ ≤ ε * ‖ζ‖ := by
  let c : ℝ := ‖L N‖
  let b : ℝ := ‖N‖
  have hc : 0 < c := norm_pos_iff.mpr hN
  have hb : 0 ≤ b := norm_nonneg N
  let η := min (c / (2 * (b + 1))) (ε * c / 2)
  have hden : 0 < 2 * (b + 1) := by positivity
  have hη : 0 < η := lt_min (div_pos hc hden) (by positivity)
  have hηb : 2 * η * b ≤ c := by
    have hd : η * (2 * (b + 1)) ≤ c :=
      (le_div_iff₀ hden).mp (min_le_left _ _)
    nlinarith
  have hηε : 2 * η ≤ ε * c := by
    have hh : η ≤ ε * c / 2 := min_le_right _ _
    linarith
  refine ⟨η, hη, ?_⟩
  intro ζ w hζ hbound
  have hL : ‖L (ζ + w • N)‖ = ‖w‖ * c := by
    simp [map_add, map_smul, hζ, c]
  rw [hL] at hbound
  have htriangle : ‖ζ + w • N‖ ≤ ‖ζ‖ + ‖w‖ * b := by
    simpa only [norm_smul, b] using norm_add_le ζ (w • N)
  have hh := hbound.trans (mul_le_mul_of_nonneg_left htriangle hη.le)
  have he := mul_le_mul_of_nonneg_right hηε (norm_nonneg ζ)
  have hn := mul_le_mul_of_nonneg_right hηb (norm_nonneg w)
  apply (mul_le_mul_iff_left₀ hc).mp
  nlinarith

/-- Uniform small slope of polynomial zeros follows from the initial zero set
lying in the tangential hyperplane. -/
theorem exists_small_slope {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (L : CSpace n →L[ℂ] ℂ)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 → L v = 0)
    (N : CSpace n) (hN : L N ≠ 0) (ε : ℝ) (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ ∀ (ζ : CSpace n) (w : ℂ), L ζ = 0 →
      ‖ζ + w • N‖ < r → eval (fun i => (ζ + w • N) i) P = 0 →
      ‖w‖ ≤ ε * ‖ζ‖ := by
  obtain ⟨η, hη, hηbound⟩ := exists_linear_tolerance L N hN ε hε
  obtain ⟨r, hr, hrbound⟩ := exists_small_linear_bound P s hs hlow L hinitial η hη
  refine ⟨r, hr, ?_⟩
  intro ζ w hζ hsmall hzero
  exact hηbound ζ w hζ (hrbound (ζ + w • N) hsmall hzero)

/-- The pure initial normal power obtained at a singular maximum supplies the
uniform small-slope estimate without using a Weierstrass preparation theorem. -/
theorem exists_small_slope_of_initial_power {n : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (L : CSpace n →L[ℂ] ℂ) (a : ℂ) (ha : a ≠ 0)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = a * (L v)^s)
    (N : CSpace n) (hN : L N ≠ 0) (ε : ℝ) (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ ∀ (ζ : CSpace n) (w : ℂ), L ζ = 0 →
      ‖ζ + w • N‖ < r → eval (fun i => (ζ + w • N) i) P = 0 →
      ‖w‖ ≤ ε * ‖ζ‖ := by
  apply exists_small_slope P s hs hlow L _ N hN ε hε
  intro v hv
  by_contra hLv
  rw [hinitial] at hv
  exact mul_ne_zero ha (pow_ne_zero _ hLv) hv

end
end Source29SmallSlope

/- Component: OneSidedOrder.lean -/

namespace Source29OneSidedOrder

open Filter
open scoped Topology

noncomputable section

/-- A one-sided real-part bound excludes a smaller positive vanishing order.
The phase choice is essential: the leading complex coefficient becomes positive
on a suitable complex ray. Only continuity of the nonvanishing factor is used. -/
theorem order_ge_of_one_sided_bound (g : ℂ → ℂ)
    (hg : ContinuousAt g 0) (hg0 : g 0 ≠ 0) (d k : ℕ) (hd : 0 < d)
    (C : ℝ)
    (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), (z ^ d * g z).re ≤ C * ‖z‖ ^ k) :
    k ≤ d := by
  by_contra hnot
  have hdk : d < k := Nat.lt_of_not_ge hnot
  let c : ℂ := (star (g 0)) ^ ((d : ℂ)⁻¹)
  have hc : c ^ d = star (g 0) := Complex.cpow_nat_inv_pow _ hd.ne'
  have hpath : Tendsto (fun t : ℝ => (t : ℂ) * c) (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℂ)) := by
    have hcont : Continuous (fun t : ℝ => (t : ℂ) * c) :=
      Complex.continuous_ofReal.mul_const c
    simpa using (hcont.continuousAt (x := 0)).tendsto.mono_left
      (show 𝓝[>] (0 : ℝ) ≤ 𝓝 (0 : ℝ) from nhdsWithin_le_nhds)
  have hleft : Tendsto (fun t : ℝ => (c ^ d * g ((t : ℂ) * c)).re)
      (𝓝[>] (0 : ℝ)) (𝓝 ((star (g 0) * g 0).re)) := by
    have hm : Tendsto (fun t : ℝ => c ^ d * g ((t : ℂ) * c))
        (𝓝[>] (0 : ℝ)) (𝓝 (c ^ d * g 0)) :=
      tendsto_const_nhds.mul (hg.tendsto.comp hpath)
    simpa only [hc, Function.comp_def] using Complex.continuous_re.continuousAt.tendsto.comp hm
  have hright : Tendsto (fun t : ℝ => C * ‖c‖ ^ k * t ^ (k - d))
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
    have hcont : Continuous (fun t : ℝ => C * ‖c‖ ^ k * t ^ (k - d)) :=
      continuous_const.mul (continuous_id.pow _)
    simpa [zero_pow (by omega : k - d ≠ 0)] using
      (hcont.continuousAt (x := 0)).tendsto.mono_left
        (show 𝓝[>] (0 : ℝ) ≤ 𝓝 (0 : ℝ) from nhdsWithin_le_nhds)
  have hle : ∀ᶠ (t : ℝ) in 𝓝[>] (0 : ℝ),
      (c ^ d * g ((t : ℂ) * c)).re ≤ C * ‖c‖ ^ k * t ^ (k - d) := by
    have hpositive : ∀ᶠ (t : ℝ) in 𝓝[>] (0 : ℝ), 0 < t := self_mem_nhdsWithin
    filter_upwards [hpath.eventually hbound, hpositive] with t ht htpos
    have hpos : 0 < t := htpos
    have hL : (((t : ℂ) * c) ^ d * g ((t : ℂ) * c)).re =
        t ^ d * (c ^ d * g ((t : ℂ) * c)).re := by
      calc
        _ = (((t ^ d : ℝ) : ℂ) * (c ^ d * g ((t : ℂ) * c))).re := by
          congr 1
          push_cast
          ring
        _ = _ := by
          simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    have hR : C * ‖(t : ℂ) * c‖ ^ k =
        t ^ d * (C * ‖c‖ ^ k * t ^ (k - d)) := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos, mul_pow]
      have hp : t ^ k = t ^ d * t ^ (k - d) := by
        rw [← pow_add, Nat.add_sub_of_le hdk.le]
      rw [hp]
      ring
    rw [hL, hR] at ht
    exact (mul_le_mul_iff_right₀ (pow_pos hpos d)).mp ht
  have hlim := le_of_tendsto_of_tendsto hleft hright hle
  have hid : (star (g 0) * g 0).re = ‖g 0‖ ^ 2 := by
    simp [Complex.mul_re, Complex.sq_norm, Complex.normSq_apply]
  rw [hid] at hlim
  exact (not_le_of_gt (sq_pos_of_pos (norm_pos_iff.mpr hg0))) hlim

/-- For an analytic function vanishing at the origin, a one-sided real-part
bound forces a holomorphic factor of the same order. -/
theorem exists_analytic_factor_of_one_sided_bound (f : ℂ → ℂ)
    (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (k : ℕ) (C : ℝ)
    (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), (f z).re ≤ C * ‖z‖ ^ k) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧
      ∀ᶠ z in 𝓝 (0 : ℂ), f z = z ^ k * g z := by
  by_cases hzero : ∀ᶠ z in 𝓝 (0 : ℂ), f z = 0
  · refine ⟨fun _ => 0, analyticAt_const, ?_⟩
    simpa using hzero
  obtain ⟨d, g, hg, hg0, hfactor⟩ := hf.exists_eventuallyEq_pow_smul_nonzero_iff.mpr hzero
  have hfactor' : ∀ᶠ z in 𝓝 (0 : ℂ), f z = z ^ d * g z := by
    simpa only [sub_zero, smul_eq_mul] using hfactor
  have hd : 0 < d := by
    by_contra hnot
    have hd0 : d = 0 := by omega
    have h0 := hfactor'.self_of_nhds
    rw [hd0, pow_zero, one_mul, hf0] at h0
    exact hg0 h0.symm
  have hgbound : ∀ᶠ z in 𝓝 (0 : ℂ), (z ^ d * g z).re ≤ C * ‖z‖ ^ k := by
    filter_upwards [hfactor', hbound] with z hz hb
    rwa [hz] at hb
  have hkd := order_ge_of_one_sided_bound g hg.continuousAt hg0 d k hd C hgbound
  refine ⟨fun z => z ^ (d - k) * g z, (analyticAt_id.pow _).mul hg, ?_⟩
  filter_upwards [hfactor'] with z hz
  rw [hz, ← mul_assoc, ← pow_add, Nat.add_sub_of_le hkd]

/-- The one-sided estimate also yields the two-sided norm estimate used in
the sheet-bound argument. This statement is local in one complex variable. -/
theorem norm_bound_of_one_sided_bound (f : ℂ → ℂ)
    (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (k : ℕ) (C : ℝ)
    (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), (f z).re ≤ C * ‖z‖ ^ k) :
    ∃ A : ℝ, 0 < A ∧ ∀ᶠ z in 𝓝 (0 : ℂ), ‖f z‖ ≤ A * ‖z‖ ^ k := by
  obtain ⟨g, hg, hfactor⟩ := exists_analytic_factor_of_one_sided_bound f hf hf0 k C hbound
  let A : ℝ := ‖g 0‖ + 1
  have hA : 0 < A := by dsimp [A]; positivity
  have hsmall : ∀ᶠ z in 𝓝 (0 : ℂ), ‖g z‖ < A :=
    hg.continuousAt.norm.tendsto.eventually (eventually_lt_nhds (by dsimp [A]; linarith))
  refine ⟨A, hA, ?_⟩
  filter_upwards [hfactor, hsmall] with z hz hb
  rw [hz, norm_mul, norm_pow]
  calc
    ‖z‖ ^ k * ‖g z‖ ≤ ‖z‖ ^ k * A :=
      mul_le_mul_of_nonneg_left hb.le (pow_nonneg (norm_nonneg z) k)
    _ = A * ‖z‖ ^ k := mul_comm _ _

end
end Source29OneSidedOrder

/- Component: OneSidedMultivariate.inc -/
namespace Source29OneSidedMultivariate

open Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Complex homogeneity upgrades a one-sided higher-order bound to vanishing
of the homogeneous form, by restricting to each complex line. -/
theorem diagonal_zero_of_one_sided_bound {d : ℕ} (p : E [×d]→L[ℂ] ℂ)
    (hd : 0 < d) (C : ℝ)
    (hbound : ∀ᶠ y in 𝓝 (0 : E), (p (fun _ => y)).re ≤ C * ‖y‖ ^ (d + 1))
    (y : E) : p (fun _ => y) = 0 := by
  by_contra hne
  have hpath : Tendsto (fun z : ℂ => z • y) (𝓝 0) (𝓝 (0 : E)) := by
    have hc : Continuous (fun z : ℂ => z • y) := continuous_id.smul continuous_const
    simpa using (hc.continuousAt (x := (0 : ℂ))).tendsto
  have hline : ∀ᶠ z in 𝓝 (0 : ℂ),
      (z ^ d * p (fun _ => y)).re ≤ (C * ‖y‖ ^ (d + 1)) * ‖z‖ ^ (d + 1) := by
    filter_upwards [hpath.eventually hbound] with z hz
    have hp : p (fun _ => z • y) = z ^ d * p (fun _ => y) := by
      simpa [Finset.prod_const, Finset.card_fin, smul_eq_mul] using
        p.map_smul_univ (fun _ : Fin d => z) (fun _ : Fin d => y)
    rw [hp, norm_smul, mul_pow] at hz
    convert hz using 1 <;> ring
  have himpossible := Source29OneSidedOrder.order_ge_of_one_sided_bound
    (fun _ : ℂ => p (fun _ => y)) continuousAt_const hne d (d + 1) hd
    (C * ‖y‖ ^ (d + 1)) hline
  omega

/-- In any complex normed space, the one-sided real-part bound forces every
lower Taylor form to vanish on the diagonal. -/
theorem lower_coefficients_zero (f : E → ℂ) (p : FormalMultilinearSeries ℂ E ℂ)
    (hf : HasFPowerSeriesAt f p 0) (hf0 : f 0 = 0) (k : ℕ) (C : ℝ)
    (hbound : ∀ᶠ y in 𝓝 (0 : E), (f y).re ≤ C * ‖y‖ ^ k) :
    ∀ d < k, ∀ y : E, p d (fun _ => y) = 0 := by
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
    intro hdk y
    by_cases hd0 : d = 0
    · subst d
      rw [hf.coeff_zero, hf0]
    have hd : 0 < d := Nat.pos_of_ne_zero hd0
    have hpsum : p.partialSum (d + 1) = fun v => p d (fun _ => v) := by
      funext v
      apply Finset.sum_eq_single d
      · intro b hb hbd
        have hbd' : b < d := by
          have hb' := Finset.mem_range.mp hb
          omega
        exact ih b hbd' (lt_trans hbd' hdk) v
      · intro hn
        exact False.elim (hn (Finset.mem_range.mpr (Nat.lt_succ_self d)))
    obtain ⟨M, hM, hrest⟩ := (hf.isBigO_sub_partialSum_pow (d + 1)).exists_pos
    have hrem : ∀ᶠ v in 𝓝 (0 : E),
        ‖f v - p d (fun _ => v)‖ ≤ M * ‖v‖ ^ (d + 1) := by
      simpa only [zero_add, hpsum, norm_pow, norm_norm] using
        (Asymptotics.isBigOWith_iff.mp hrest)
    have hsmall : ∀ᶠ v in 𝓝 (0 : E), ‖v‖ < 1 := by
      have hball := Metric.ball_mem_nhds (0 : E) (by norm_num : (0 : ℝ) < 1)
      filter_upwards [hball] with v hv
      simpa only [Metric.mem_ball, dist_zero_right] using hv
    apply diagonal_zero_of_one_sided_bound (p d) hd (|C| + M) _ y
    filter_upwards [hbound, hrem, hsmall] with v hv hr hs
    have hpow : ‖v‖ ^ k ≤ ‖v‖ ^ (d + 1) :=
      pow_le_pow_of_le_one (norm_nonneg v) hs.le (by omega)
    have hc : C * ‖v‖ ^ k ≤ |C| * ‖v‖ ^ (d + 1) := by
      calc
        C * ‖v‖ ^ k ≤ |C| * ‖v‖ ^ k :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (pow_nonneg (norm_nonneg v) k)
        _ ≤ |C| * ‖v‖ ^ (d + 1) := mul_le_mul_of_nonneg_left hpow (abs_nonneg C)
    have hre := (abs_le.mp (Complex.abs_re_le_norm (f v - p d (fun _ => v)))).1
    simp only [Complex.sub_re] at hre
    nlinarith

/-- A one-sided bound for a complex analytic function vanishing at zero implies
a uniform norm bound of the same order, also in several variables. -/
theorem norm_bound_of_one_sided_bound (f : E → ℂ)
    (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (k : ℕ) (C : ℝ)
    (hbound : ∀ᶠ y in 𝓝 (0 : E), (f y).re ≤ C * ‖y‖ ^ k) :
    ∃ A : ℝ, 0 < A ∧ ∀ᶠ y in 𝓝 (0 : E), ‖f y‖ ≤ A * ‖y‖ ^ k := by
  obtain ⟨p, hp⟩ := hf
  have hvan := lower_coefficients_zero f p hp hf0 k C hbound
  have hpsum : p.partialSum k = 0 := by
    funext y
    apply Finset.sum_eq_zero
    intro d hd
    exact hvan d (Finset.mem_range.mp hd) y
  obtain ⟨A, hA, hrest⟩ := (hp.isBigO_sub_partialSum_pow k).exists_pos
  refine ⟨A, hA, ?_⟩
  simpa only [zero_add, hpsum, Pi.zero_apply, sub_zero, norm_pow, norm_norm] using
    (Asymptotics.isBigOWith_iff.mp hrest)

end
end Source29OneSidedMultivariate

/- Component: QuadraticSheetBound.inc -/
/- A finite family of roots needs only analytic first and second power sums:
individual roots need not admit continuous or analytic labels. -/

namespace Source29QuadraticSheetBound

open Filter Finset
open scoped Topology

noncomputable section

lemma finite_real_part_bound {ι : Type*} [Fintype ι] (w : ι → ℂ)
    (A B t : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) (ht : 0 ≤ t)
    (hupper : ∀ j, (w j).re ≤ B * t)
    (hsum : ‖∑ j, w j‖ ≤ A * t) (j : ι) :
    |(w j).re| ≤ (A + ((Fintype.card ι : ℝ) + 1) * B) * t := by
  classical
  have hm : (0 : ℝ) ≤ Fintype.card ι := Nat.cast_nonneg _
  have hD : B ≤ A + ((Fintype.card ι : ℝ) + 1) * B := by nlinarith
  have hupper' : (w j).re ≤ (A + ((Fintype.card ι : ℝ) + 1) * B) * t :=
    (hupper j).trans (mul_le_mul_of_nonneg_right hD ht)
  have hlower : -(A * t) ≤ (∑ i, w i).re := by
    have hh := (abs_le.mp (Complex.abs_re_le_norm (∑ i, w i))).1
    linarith
  have hdeficit : B * t - (w j).re ≤ ∑ i, (B * t - (w i).re) := by
    exact single_le_sum (fun i _ => sub_nonneg.mpr (hupper i)) (mem_univ j)
  have hsumdef : (∑ i, (B * t - (w i).re)) =
      (Fintype.card ι : ℝ) * (B * t) - (∑ i, w i).re := by
    simp [Finset.sum_sub_distrib, Complex.re_sum]
  rw [hsumdef] at hdeficit
  apply abs_le.mpr
  constructor
  · nlinarith [mul_nonneg hB ht]
  · exact hupper'

lemma finite_norm_square_bound {ι : Type*} [Fintype ι] (w : ι → ℂ)
    (D B t : ℝ)
    (hre : ∀ j, (w j).re^2 ≤ D * t)
    (hpower : ‖∑ j, (w j)^2‖ ≤ B * t) (j : ι) :
    ‖w j‖^2 ≤ (((Fintype.card ι : ℝ) + 1) * D + B) * t := by
  have hresum : (∑ i, (w i).re^2) ≤ (Fintype.card ι : ℝ) * D * t := by
    calc
      (∑ i, (w i).re^2) ≤ ∑ i : ι, D * t := sum_le_sum (fun i _ => hre i)
      _ = _ := by simp [mul_assoc]
  have hlower : -(B * t) ≤ (∑ i, (w i)^2).re := by
    have hh := (abs_le.mp (Complex.abs_re_le_norm (∑ i, (w i)^2))).1
    linarith
  have him := Source29ComplexMaximum.imaginary_square_le w
    ((Fintype.card ι : ℝ) * D * t) (B * t) hresum hlower j
  have hj := hre j
  rw [Complex.sq_norm, Complex.normSq_apply]
  nlinarith

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Analytic first and second power sums upgrade one-sided quadratic real-part
bounds to uniform quadratic norm bounds on every root. -/
theorem quadratic_sheet_bound {ι : Type*} [Fintype ι]
    (w : E → ι → ℂ) (hzero : ∀ j, w 0 j = 0)
    (hS1 : AnalyticAt ℂ (fun x => ∑ j, w x j) 0)
    (hS2 : AnalyticAt ℂ (fun x => ∑ j, (w x j)^2) 0)
    (C : ℝ)
    (hupper : ∀ᶠ x in 𝓝 (0 : E), ∀ j, (w x j).re ≤ C * ‖x‖^2) :
    ∃ A : ℝ, 0 < A ∧ ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ A * ‖x‖^2 := by
  let m : ℝ := Fintype.card ι
  have hm : 0 ≤ m := Nat.cast_nonneg _
  have hupperB : ∀ᶠ x in 𝓝 (0 : E), ∀ j, (w x j).re ≤ |C| * ‖x‖^2 := by
    filter_upwards [hupper] with x hx j
    exact (hx j).trans (mul_le_mul_of_nonneg_right (le_abs_self C) (sq_nonneg ‖x‖))
  have hsumUpper : ∀ᶠ x in 𝓝 (0 : E),
      (∑ j, w x j).re ≤ (m * |C|) * ‖x‖^2 := by
    filter_upwards [hupperB] with x hx
    rw [Complex.re_sum]
    calc
      (∑ j, (w x j).re) ≤ ∑ j : ι, |C| * ‖x‖^2 := sum_le_sum (fun j _ => hx j)
      _ = _ := by simp [m, mul_assoc]
  obtain ⟨A1, hA1, hsumBound⟩ :=
    Source29OneSidedMultivariate.norm_bound_of_one_sided_bound
      (fun x => ∑ j, w x j) hS1 (by simp [hzero]) 2 (m * |C|) hsumUpper
  let D : ℝ := A1 + (m + 1) * |C|
  have hD : 0 < D := by dsimp [D]; positivity
  have hreal : ∀ᶠ x in 𝓝 (0 : E), ∀ j, |(w x j).re| ≤ D * ‖x‖^2 := by
    filter_upwards [hupperB, hsumBound] with x hx hs j
    exact finite_real_part_bound (w x) A1 |C| (‖x‖^2)
      hA1.le (abs_nonneg C) (sq_nonneg ‖x‖) hx hs j
  have hrealSq : ∀ᶠ x in 𝓝 (0 : E), ∀ j, (w x j).re^2 ≤ D^2 * ‖x‖^4 := by
    filter_upwards [hreal] with x hx j
    have hh := (sq_le_sq₀ (abs_nonneg ((w x j).re))
      (mul_nonneg hD.le (sq_nonneg ‖x‖))).mpr (hx j)
    nlinarith [sq_abs ((w x j).re)]
  have hS2upper : ∀ᶠ x in 𝓝 (0 : E),
      (∑ j, (w x j)^2).re ≤ (m * D^2) * ‖x‖^4 := by
    filter_upwards [hrealSq] with x hx
    rw [Complex.re_sum]
    calc
      (∑ j, ((w x j)^2).re) ≤ ∑ j, (w x j).re^2 := by
        apply sum_le_sum
        intro j hj
        simp only [pow_two, Complex.mul_re]
        nlinarith [sq_nonneg ((w x j).im)]
      _ ≤ ∑ j : ι, D^2 * ‖x‖^4 := sum_le_sum (fun j _ => hx j)
      _ = _ := by simp [m, mul_assoc]
  obtain ⟨A2, hA2, hS2bound⟩ :=
    Source29OneSidedMultivariate.norm_bound_of_one_sided_bound
      (fun x => ∑ j, (w x j)^2) hS2 (by simp [hzero]) 4 (m * D^2) hS2upper
  let K : ℝ := (m + 1) * D^2 + A2
  have hK : 0 < K := by dsimp [K]; positivity
  have hKsq : K ≤ (K + 1)^2 := by nlinarith [sq_nonneg K]
  refine ⟨K + 1, by positivity, ?_⟩
  filter_upwards [hrealSq, hS2bound] with x hx hs j
  have hj : ‖w x j‖^2 ≤ K * ‖x‖^4 :=
    finite_norm_square_bound (w x) (D^2) A2 (‖x‖^4) hx hs j
  have hsq : ‖w x j‖^2 ≤ ((K + 1) * ‖x‖^2)^2 := by
    calc
      ‖w x j‖^2 ≤ K * ‖x‖^4 := hj
      _ ≤ (K + 1)^2 * ‖x‖^4 :=
        mul_le_mul_of_nonneg_right hKsq (pow_nonneg (norm_nonneg x) 4)
      _ = _ := by ring
  exact (sq_le_sq₀ (norm_nonneg (w x j)) (by positivity)).mp hsq

/-- The version directly matching a one-sided estimate on the normal linear
form, with a fixed nonzero normal-square coefficient. -/
theorem quadratic_sheet_bound_scaled {ι : Type*} [Fintype ι]
    (w : E → ι → ℂ) (hzero : ∀ j, w 0 j = 0)
    (hS1 : AnalyticAt ℂ (fun x => ∑ j, w x j) 0)
    (hS2 : AnalyticAt ℂ (fun x => ∑ j, (w x j)^2) 0)
    (c : ℂ) (hc : c ≠ 0) (C : ℝ)
    (hupper : ∀ᶠ x in 𝓝 (0 : E), ∀ j, (c * w x j).re ≤ C * ‖x‖^2) :
    ∃ A : ℝ, 0 < A ∧ ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ A * ‖x‖^2 := by
  have h1 : AnalyticAt ℂ (fun x => ∑ j, c * w x j) 0 := by
    simpa only [Pi.mul_def, Finset.mul_sum] using
      (analyticAt_const.mul hS1 : AnalyticAt ℂ (fun x => c * ∑ j, w x j) 0)
  have h2 : AnalyticAt ℂ (fun x => ∑ j, (c * w x j)^2) 0 := by
    simpa only [Pi.mul_def, Finset.mul_sum, mul_pow] using
      (analyticAt_const.mul hS2 : AnalyticAt ℂ (fun x => c^2 * ∑ j, (w x j)^2) 0)
  obtain ⟨A, hA, hbound⟩ := quadratic_sheet_bound
    (fun x j => c * w x j) (by intro j; simp [hzero]) h1 h2 C hupper
  have hcpos : 0 < ‖c‖ := norm_pos_iff.mpr hc
  refine ⟨A / ‖c‖, div_pos hA hcpos, ?_⟩
  filter_upwards [hbound] with x hx j
  have hj := hx j
  rw [norm_mul] at hj
  calc
    ‖w x j‖ ≤ (A * ‖x‖^2) / ‖c‖ :=
      (le_div_iff₀ hcpos).mpr (by simpa only [mul_comm] using hj)
    _ = (A / ‖c‖) * ‖x‖^2 := by ring

end
end Source29QuadraticSheetBound

/- Component: LocalFactorLinear.lean -/

/-!
The finite dimensional linear algebra behind local polynomial preparation.
This file proves no analytic factorization or convergence assertion.
-/

namespace Source29LocalFactorLinear

open Polynomial

noncomputable section

variable {K : Type*} [Field K]

/-- Finite coefficient vectors as polynomials. -/
def coeffPolynomial (k : ℕ) (v : Fin k → K) : K[X] :=
  ((degreeLTEquiv K k).symm v : degreeLT K k).val

/-- The finite coefficient multiplication map used for local preparation. -/
def factorMap (s r : ℕ) (ab : (Fin s → K) × (Fin (r+1) → K)) : Fin (s+r+1) → K :=
  fun i => ((X^s + coeffPolynomial s ab.1) * coeffPolynomial (r+1) ab.2).coeff i

lemma degree_coeffPolynomial_lt (k : ℕ) (v : Fin k → K) :
    (coeffPolynomial k v).degree < k :=
  mem_degreeLT.mp ((degreeLTEquiv K k).symm v).property

lemma degree_factorPolynomial_lt (s r : ℕ)
    (ab : (Fin s → K) × (Fin (r+1) → K)) :
    ((X^s + coeffPolynomial s ab.1) * coeffPolynomial (r+1) ab.2).degree < (s+r+1 : WithBot ℕ) := by
  have hA : (X^s + coeffPolynomial s ab.1).degree ≤ (s : WithBot ℕ) :=
    (degree_add_le _ _).trans (max_le (by simp) (degree_coeffPolynomial_lt _ _).le)
  by_cases h0 : X^s + coeffPolynomial s ab.1 = 0
  · simp [h0]
  apply (degree_mul_le _ _).trans_lt
  have h := WithBot.add_lt_add_of_le_of_lt (by simpa using h0) hA
    (degree_coeffPolynomial_lt (r+1) ab.2)
  simpa only [Nat.cast_add, Nat.cast_one, add_assoc] using h

/-- Equality in the finite coefficient space is exact polynomial equality. -/
theorem factorMap_eq_iff (s r : ℕ)
    (ab : (Fin s → K) × (Fin (r+1) → K)) (P : K[X])
    (hP : P.degree < (s+r+1 : WithBot ℕ)) :
    factorMap s r ab = (fun i : Fin (s+r+1) => P.coeff i) ↔
      (X^s + coeffPolynomial s ab.1) * coeffPolynomial (r+1) ab.2 = P := by
  constructor
  · intro h
    ext i
    by_cases hi : i < s+r+1
    · exact congrFun h ⟨i, hi⟩
    · have hle : (s+r+1 : WithBot ℕ) ≤ i := by exact_mod_cast (Nat.le_of_not_gt hi)
      rw [coeff_eq_zero_of_degree_lt ((degree_factorPolynomial_lt s r ab).trans_le hle),
        coeff_eq_zero_of_degree_lt (hP.trans_le hle)]
  · intro h
    funext i
    exact congrArg (fun p : K[X] => p.coeff i) h

/-- The derivative of `(A,B) ↦ (X^s+A)B` at `(0,g)`, on the indicated
degree bounded polynomial spaces. -/
def factorDerivative (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r) :
    (degreeLT K s × degreeLT K (r+1)) →ₗ[K] degreeLT K (s+r+1) where
  toFun ab := ⟨g * (ab.1 : K[X]) + X^s * (ab.2 : K[X]), by
    apply mem_degreeLT.mpr
    apply (degree_add_le _ _).trans_lt
    apply max_lt
    · by_cases hg0 : g = 0
      · simp [hg0]
      have hga := degree_mul_le g (ab.1 : K[X])
      have ha := mem_degreeLT.mp ab.1.property
      have hg' := degree_le_of_natDegree_le hg
      have h := WithBot.add_lt_add_of_le_of_lt (by simpa using hg0) hg' ha
      exact hga.trans_lt (h.trans_le (by norm_cast; omega))
    · have hxb := degree_mul_le (X^s : K[X]) (ab.2 : K[X])
      rw [degree_X_pow] at hxb
      have hb := mem_degreeLT.mp ab.2.property
      have h := WithBot.add_lt_add_of_le_of_lt (by simp : (s : WithBot ℕ) ≠ ⊥) le_rfl hb
      exact hxb.trans_lt (h.trans_eq (by simp [Nat.add_assoc]))⟩
  map_add' ab cd := by ext1; dsimp; ring
  map_smul' c ab := by ext1; simp [smul_eq_C_mul]; ring

lemma coprime_X_pow_of_coeff_zero_ne (s : ℕ) (g : K[X]) (hg : g.coeff 0 ≠ 0) :
    IsCoprime (X^s) g := by
  apply IsCoprime.pow_left
  apply IsRelPrime.isCoprime
  apply (irreducible_X (R := K)).isRelPrime_iff_not_dvd.mpr
  simpa only [X_dvd_iff] using hg

theorem factorDerivative_injective (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r)
    (hg0 : g.coeff 0 ≠ 0) : Function.Injective (factorDerivative s r g hg) := by
  apply (LinearMap.ker_eq_bot).mp
  apply LinearMap.ker_eq_bot'.mpr
  intro ab hab
  have heq : g * (ab.1 : K[X]) + X^s * (ab.2 : K[X]) = 0 := congrArg Subtype.val hab
  have hdiv : (X^s : K[X]) ∣ g * (ab.1 : K[X]) := by
    refine ⟨-(ab.2 : K[X]), ?_⟩
    linear_combination heq
  have haDiv := (coprime_X_pow_of_coeff_zero_ne s g hg0).dvd_of_dvd_mul_left hdiv
  have ha : (ab.1 : K[X]) = 0 := eq_zero_of_dvd_of_degree_lt haDiv (by
    rw [degree_X_pow]
    exact mem_degreeLT.mp ab.1.property)
  have hb : (ab.2 : K[X]) = 0 := by
    rw [ha, mul_zero, zero_add] at heq
    exact (mul_eq_zero.mp heq).resolve_left (pow_ne_zero _ X_ne_zero)
  exact Prod.ext (Subtype.ext ha) (Subtype.ext hb)

/-- The same derivative written in finite coefficient coordinates. -/
def factorDerivativeCoeff (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r) :
    ((Fin s → K) × (Fin (r+1) → K)) →ₗ[K] (Fin (s+r+1) → K) :=
  (degreeLTEquiv K (s+r+1)).toLinearMap.comp
    ((factorDerivative s r g hg).comp
      (((degreeLTEquiv K s).symm.prodCongr
        (degreeLTEquiv K (r+1)).symm).toLinearMap))

lemma factorDerivativeCoeff_apply (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r)
    (ab : (Fin s → K) × (Fin (r+1) → K)) (i : Fin (s+r+1)) :
    factorDerivativeCoeff s r g hg ab i =
      (g * coeffPolynomial s ab.1 + X^s * coeffPolynomial (r+1) ab.2).coeff i := rfl

theorem factorDerivativeCoeff_injective (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r)
    (hg0 : g.coeff 0 ≠ 0) : Function.Injective (factorDerivativeCoeff s r g hg) :=
  (degreeLTEquiv K (s+r+1)).injective.comp
    ((factorDerivative_injective s r g hg hg0).comp
      ((degreeLTEquiv K s).symm.prodCongr (degreeLTEquiv K (r+1)).symm).injective)

/-- Coprimality makes the coefficient derivative an isomorphism. -/
def factorDerivativeEquiv (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r)
    (hg0 : g.coeff 0 ≠ 0) :
    ((Fin s → K) × (Fin (r+1) → K)) ≃ₗ[K] (Fin (s+r+1) → K) :=
  (factorDerivativeCoeff s r g hg).linearEquivOfInjective
    (factorDerivativeCoeff_injective s r g hg hg0) (by
      simp [Module.finrank_prod, Nat.add_assoc])

lemma factorDerivativeEquiv_apply (s r : ℕ) (g : K[X]) (hg : g.natDegree ≤ r)
    (hg0 : g.coeff 0 ≠ 0) (ab : (Fin s → K) × (Fin (r+1) → K)) :
    factorDerivativeEquiv s r g hg hg0 ab = factorDerivativeCoeff s r g hg ab := rfl

end

end Source29LocalFactorLinear

/- Component: LocalFactorAnalytic.inc -/

namespace Source29LocalFactorAnalytic

open Polynomial Source29LocalFactorLinear
open scoped BigOperators

noncomputable section

/-- Each coefficient of a finite coefficient vector is a continuous linear
functional, including coefficients beyond its truncation length. -/
def coefficientCLM (k n : ℕ) : (Fin k → ℂ) →L[ℂ] ℂ :=
  ((Polynomial.lcoeff ℂ n).comp
    ((degreeLT ℂ k).subtype.comp (degreeLTEquiv ℂ k).symm.toLinearMap)).toContinuousLinearMap

lemma coefficientCLM_apply (k n : ℕ) (v : Fin k → ℂ) :
    coefficientCLM k n v = (coeffPolynomial k v).coeff n := rfl

theorem analyticAt_coeffPolynomial (k n : ℕ) (v : Fin k → ℂ) :
    AnalyticAt ℂ (fun x => (coeffPolynomial k x).coeff n) v :=
  (coefficientCLM k n).analyticAt v

/-- Multiplication of finite coefficient vectors is analytic. This supplies
analytic regularity for the local polynomial factorization construction. -/
theorem analyticAt_factorMap (s r : ℕ)
    (ab : (Fin s → ℂ) × (Fin (r+1) → ℂ)) :
    AnalyticAt ℂ (factorMap s r) ab := by
  apply AnalyticAt.pi
  intro i
  simp only [factorMap, coeff_mul, coeff_add]
  apply Finset.analyticAt_fun_sum
  intro q hq
  exact (analyticAt_const.add ((analyticAt_coeffPolynomial s q.1 ab.1).comp
    analyticAt_fst)).mul ((analyticAt_coeffPolynomial (r+1) q.2 ab.2).comp analyticAt_snd)

end
end Source29LocalFactorAnalytic

/- Component: LocalFactorDerivative.inc -/

namespace Source29LocalFactorAnalytic

open Polynomial Source29LocalFactorLinear
open scoped BigOperators

noncomputable section

lemma coeffPolynomial_zero (k : ℕ) : coeffPolynomial k (0 : Fin k → ℂ) = 0 := by
  simp [coeffPolynomial]

/-- The derivative of coefficient multiplication at a separated factorization
is precisely the algebraic coefficient derivative. -/
theorem hasFDerivAt_factorMap (s r : ℕ) (g : ℂ[X]) (hg : g.natDegree ≤ r)
    (b : Fin (r+1) → ℂ) (hb : coeffPolynomial (r+1) b = g) :
    HasFDerivAt (factorMap s r)
      (factorDerivativeCoeff s r g hg).toContinuousLinearMap (0, b) := by
  let D := (Fin s → ℂ) × (Fin (r+1) → ℂ)
  let A (n : ℕ) : D →L[ℂ] ℂ :=
    (coefficientCLM s n).comp (ContinuousLinearMap.fst ℂ _ _)
  let B (n : ℕ) : D →L[ℂ] ℂ :=
    (coefficientCLM (r+1) n).comp (ContinuousLinearMap.snd ℂ _ _)
  have hA (n : ℕ) (ab : D) : A n ab = (coeffPolynomial s ab.1).coeff n := rfl
  have hB (n : ℕ) (ab : D) : B n ab = (coeffPolynomial (r+1) ab.2).coeff n := rfl
  apply hasFDerivAt_pi''
  intro i
  have hterm (q : ℕ × ℕ) :
      HasFDerivAt (fun ab : D => ((X^s : ℂ[X]).coeff q.1 + A q.1 ab) * B q.2 ab)
        ((((X^s : ℂ[X]).coeff q.1 + A q.1 (0, b)) • B q.2) +
          B q.2 (0, b) • A q.1) (0, b) := by
    convert! ((hasFDerivAt_const ((X^s : ℂ[X]).coeff q.1) ((0, b) : D)).add
      (A q.1).hasFDerivAt).mul (B q.2).hasFDerivAt using 1 <;> simp
  have hsum := HasFDerivAt.sum (u := Finset.antidiagonal (i : ℕ))
    (fun q _ => hterm q)
  convert hsum using 1
  · funext ab
    simp [factorMap, coeff_mul, coeff_add, hA, hB]
  · apply ContinuousLinearMap.ext
    intro ab
    change (g * coeffPolynomial s ab.1 + X^s * coeffPolynomial (r+1) ab.2).coeff (i : ℕ) = _
    have hswap :
        (∑ q ∈ Finset.antidiagonal (i : ℕ), g.coeff q.1 * (coeffPolynomial s ab.1).coeff q.2) =
          ∑ q ∈ Finset.antidiagonal (i : ℕ), g.coeff q.2 * (coeffPolynomial s ab.1).coeff q.1 := by
      simpa using (Finset.Nat.sum_antidiagonal_swap
        (n := (i : ℕ)) (f := fun q => g.coeff q.1 * (coeffPolynomial s ab.1).coeff q.2)).symm
    simp only [sum_apply, add_apply, smul_apply]
    simp [hA, hB, coeffPolynomial_zero, hb, coeff_mul, coeff_add,
      Finset.sum_add_distrib, mul_comm, add_comm, hswap]

/-- Analytic coefficient multiplication has the same strict derivative, so the
finite-dimensional inverse function theorem applies to the separated factors. -/
theorem hasStrictFDerivAt_factorMap (s r : ℕ) (g : ℂ[X]) (hg : g.natDegree ≤ r)
    (b : Fin (r+1) → ℂ) (hb : coeffPolynomial (r+1) b = g) :
    HasStrictFDerivAt (factorMap s r)
      (factorDerivativeCoeff s r g hg).toContinuousLinearMap (0, b) := by
  have h := (analyticAt_factorMap s r (0, b)).hasStrictFDerivAt
  rw [(hasFDerivAt_factorMap s r g hg b hb).fderiv] at h
  exact h

end
end Source29LocalFactorAnalytic

/- Component: LocalPolynomialPreparation.inc -/

namespace Source29LocalPreparation

open Polynomial Source29LocalFactorLinear Source29LocalFactorAnalytic
open scoped Topology BigOperators

noncomputable section

/-- The analytic inverse theorem, packaged as a local right inverse. -/
theorem exists_analytic_local_inverse
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    [NormedAddCommGroup F] [NormedSpace ℂ F]
    (f : E → F) (a : E) (e : E ≃L[ℂ] F)
    (ha : AnalyticAt ℂ f a) (hd : HasStrictFDerivAt f (e : E →L[ℂ] F) a) :
    ∃ u : F → E, AnalyticAt ℂ u (f a) ∧ u (f a) = a ∧
      ∀ᶠ y in 𝓝 (f a), f (u y) = y := by
  let L := hd.toOpenPartialHomeomorph f
  have hL : (L : E → F) = f := hd.toOpenPartialHomeomorph_coe
  have hLa : a ∈ L.source := hd.mem_toOpenPartialHomeomorph_source
  refine ⟨L.symm, ?_, ?_, ?_⟩
  · have h := L.analyticAt_symm' (i := e) hLa
      (show AnalyticAt ℂ L a by simpa only [hL] using ha)
      (show fderiv ℂ L a = e by simpa only [hL] using hd.hasFDerivAt.fderiv)
    simpa only [hL] using h
  · simpa only [hL] using L.left_inv hLa
  · have ht := L.open_target.mem_nhds (L.map_source hLa)
    have hright : ∀ᶠ y in 𝓝 (L a), L (L.symm y) = y :=
      Filter.Eventually.mono ht (fun _ hy => L.right_inv hy)
    simpa only [hL] using hright

/-- A uniformly degree bounded family with analytic coefficients has analytic
joint evaluation in its parameter and polynomial variable. -/
theorem analyticAt_joint_eval
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (B : E → ℂ[X]) (a : E) (w : ℂ) (k : ℕ)
    (hdegree : ∀ x, (B x).degree < (k : WithBot ℕ))
    (hcoeff : ∀ n, AnalyticAt ℂ (fun x => (B x).coeff n) a) :
    AnalyticAt ℂ (fun y : E × ℂ => (B y.1).eval y.2) (a,w) := by
  have heq : (fun y : E × ℂ => (B y.1).eval y.2) =
      (fun y => ∑ i : Fin k, (B y.1).coeff i * y.2^(i : ℕ)) := by
    funext y
    exact eval_eq_sum_degreeLTEquiv (mem_degreeLT.mpr (hdegree y.1)) y.2
  rw [heq]
  apply Finset.analyticAt_fun_sum
  intro i _
  have hf : AnalyticAt ℂ (fun y : E × ℂ => (B y.1).coeff i) (a,w) :=
    AnalyticAt.comp (g := fun x : E => (B x).coeff (i : ℕ))
      (f := fun y : E × ℂ => y.1) (x := (a,w)) (hcoeff (i : ℕ)) analyticAt_fst
  have hw : AnalyticAt ℂ (fun y : E × ℂ => y.2) (a,w) := analyticAt_snd
  exact hf.mul (hw.pow (i : ℕ))

theorem eventually_joint_eval_ne_zero
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (B : E → ℂ[X]) (a : E) (k : ℕ)
    (hdegree : ∀ x, (B x).degree < (k : WithBot ℕ))
    (hcoeff : ∀ n, AnalyticAt ℂ (fun x => (B x).coeff n) a)
    (hzero : (B a).coeff 0 ≠ 0) :
    ∀ᶠ y : E × ℂ in 𝓝 (a,0), (B y.1).eval y.2 ≠ 0 := by
  apply (analyticAt_joint_eval B a 0 k hdegree hcoeff).continuousAt.eventually_ne
  simpa only [← coeff_zero_eq_eval_zero] using hzero

/-- Local polynomial preparation obtained from a finite coefficient inverse.
The degree bound is uniform, but the leading coefficient need not be nonzero
at the base point. -/
theorem local_polynomial_preparation
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (P : E → ℂ[X]) (a : E) (s r : ℕ) (g : ℂ[X])
    (hg : g.natDegree ≤ r) (hg0 : g.coeff 0 ≠ 0)
    (hbase : P a = X^s * g)
    (hdegree : ∀ᶠ x in 𝓝 a, (P x).degree < (s+r+1 : WithBot ℕ))
    (hcoeff : ∀ i : Fin (s+r+1), AnalyticAt ℂ (fun x => (P x).coeff i) a) :
    ∃ W B : E → ℂ[X],
      (∀ x, (W x).Monic ∧ (W x).natDegree = s) ∧
      W a = X^s ∧ B a = g ∧
      (∀ n, AnalyticAt ℂ (fun x => (W x).coeff n) a) ∧
      (∀ n, AnalyticAt ℂ (fun x => (B x).coeff n) a) ∧
      (∀ x, (B x).degree < (r+1 : WithBot ℕ)) ∧
      (∀ᶠ y : E × ℂ in 𝓝 (a,0), (B y.1).eval y.2 ≠ 0) ∧
      ∀ᶠ x in 𝓝 a, W x * B x = P x := by
  let b : Fin (r+1) → ℂ := fun i => g.coeff i
  have hgmem : g ∈ degreeLT ℂ (r+1) := by
    apply mem_degreeLT.mpr
    exact (degree_le_of_natDegree_le hg).trans_lt (by exact_mod_cast Nat.lt_succ_self r)
  have hb : coeffPolynomial (r+1) b = g :=
    congrArg Subtype.val ((degreeLTEquiv ℂ (r+1)).symm_apply_apply ⟨g, hgmem⟩)
  let e := (factorDerivativeEquiv s r g hg hg0).toContinuousLinearEquiv
  have hd : HasStrictFDerivAt (factorMap s r) (e : _ →L[ℂ] _) (0,b) := by
    have he : (e : _ →L[ℂ] _) = (factorDerivativeCoeff s r g hg).toContinuousLinearMap := by
      apply ContinuousLinearMap.ext
      intro x
      rfl
    rw [he]
    exact hasStrictFDerivAt_factorMap s r g hg b hb
  obtain ⟨u, hu, hubase, hulocal⟩ := exists_analytic_local_inverse
    (factorMap s r) (0,b) e (analyticAt_factorMap s r (0,b)) hd
  let Q : E → (Fin (s+r+1) → ℂ) := fun x i => (P x).coeff i
  have hQ : AnalyticAt ℂ Q a := AnalyticAt.pi hcoeff
  have hQbase : Q a = factorMap s r (0,b) := by
    funext i
    change (P a).coeff i = ((X^s+coeffPolynomial s 0)*coeffPolynomial (r+1) b).coeff i
    have hz : coeffPolynomial s (0 : Fin s → ℂ) = 0 := by
      simp [coeffPolynomial]
    rw [hbase, hb, hz, add_zero]
  have hua : AnalyticAt ℂ (fun x => u (Q x)) a := by
    apply AnalyticAt.comp _ hQ
    simpa only [hQbase] using hu
  have hua0 : u (Q a) = (0,b) := by simpa only [hQbase] using hubase
  let W : E → ℂ[X] := fun x => X^s + coeffPolynomial s (u (Q x)).1
  let B : E → ℂ[X] := fun x => coeffPolynomial (r+1) (u (Q x)).2
  refine ⟨W, B, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    refine ⟨monic_X_pow_add (degree_coeffPolynomial_lt _ _), ?_⟩
    dsimp [W]
    rw [natDegree_add_eq_left_of_degree_lt]
    · simp
    · simpa only [degree_X_pow] using degree_coeffPolynomial_lt s (u (Q x)).1
  · change X^s + coeffPolynomial s (u (Q a)).1 = X^s
    rw [hua0]
    simp [coeffPolynomial]
  · change coeffPolynomial (r+1) (u (Q a)).2 = g
    simpa only [hua0] using hb
  · intro n
    change AnalyticAt ℂ (fun x => (X^s+coeffPolynomial s (u (Q x)).1).coeff n) a
    simp only [coeff_add]
    exact analyticAt_const.add ((analyticAt_coeffPolynomial s n _).comp (analyticAt_fst.comp hua))
  · intro n
    exact (analyticAt_coeffPolynomial (r+1) n _).comp (analyticAt_snd.comp hua)
  · intro x
    exact degree_coeffPolynomial_lt (r+1) (u (Q x)).2
  · apply eventually_joint_eval_ne_zero B a (r+1)
    · intro x
      exact degree_coeffPolynomial_lt (r+1) (u (Q x)).2
    · intro n
      exact (analyticAt_coeffPolynomial (r+1) n _).comp (analyticAt_snd.comp hua)
    · change (coeffPolynomial (r+1) (u (Q a)).2).coeff 0 ≠ 0
      simpa only [hua0, hb] using hg0
  · have hev : ∀ᶠ x in 𝓝 a, factorMap s r (u (Q x)) = Q x :=
      hQ.continuousAt.tendsto.eventually (by simpa only [← hQbase] using hulocal)
    filter_upwards [hdegree, hev] with x hx hux
    exact (factorMap_eq_iff s r (u (Q x)) (P x) hx).mp hux

end
end Source29LocalPreparation

/- Component: SliceAnalytic.inc -/

namespace Source29SliceAnalytic

open Polynomial MvPolynomial Source29SlicePolynomial
open scoped BigOperators

noncomputable section

lemma analyticAt_affine_coeff
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (v : E → ℂ) (a : E) (u : ℂ) (k : ℕ) (hv : AnalyticAt ℂ v a) :
    AnalyticAt ℂ (fun x => (Polynomial.C (v x)+Polynomial.X*Polynomial.C u).coeff k) a := by
  have hC : AnalyticAt ℂ (fun x => (Polynomial.C (v x)).coeff k) a := by
    simp only [Polynomial.coeff_C]
    split_ifs
    · exact hv
    · exact analyticAt_const
  simpa only [Polynomial.coeff_add, Pi.add_def] using
    hC.add (show AnalyticAt ℂ (fun _ : E => (Polynomial.X*Polynomial.C u).coeff k) a from
      analyticAt_const)

/-- A polynomial restricted to moving affine complex lines has analytic
coefficients whenever the base point coordinates vary analytically. -/
theorem analyticAt_lineSlice_coeff
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (v : E → Fin n → ℂ) (u : Fin n → ℂ) (a : E)
    (hv : ∀ i, AnalyticAt ℂ (fun x => v x i) a) (k : ℕ) :
    AnalyticAt ℂ (fun x => (lineSlice P (v x) u).coeff k) a := by
  induction P using MvPolynomial.induction_on generalizing k with
  | C c =>
    simpa only [lineSlice, MvPolynomial.eval₂_C] using
      (show AnalyticAt ℂ (fun _ : E => (Polynomial.C c).coeff k) a from analyticAt_const)
  | add p q hp hq =>
    simpa only [lineSlice, MvPolynomial.eval₂_add, Polynomial.coeff_add, Pi.add_def] using
      (hp k).add (hq k)
  | mul_X p i hp =>
    simp only [lineSlice, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, Polynomial.coeff_mul]
    apply Finset.analyticAt_fun_sum
    intro q _
    exact (hp q.1).mul (analyticAt_affine_coeff (fun x => v x i) a (u i) q.2 (hv i))

end
end Source29SliceAnalytic

/- Component: SlicePreparation.inc -/

namespace Source29SlicePreparation

open Polynomial Source29SlicePolynomial Source29SliceAnalytic Source29LocalPreparation
open scoped Topology

noncomputable section

/-- Polynomial-specific preparation for moving affine slices of a fixed
multivariate polynomial. -/
theorem lineSlice_preparation
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (v : E → Fin n → ℂ) (u : Fin n → ℂ) (a : E)
    (hv : ∀ i, AnalyticAt ℂ (fun x => v x i) a)
    (s r : ℕ) (g : ℂ[X]) (hg : g.natDegree ≤ r) (hg0 : g.coeff 0 ≠ 0)
    (hdegree : P.totalDegree ≤ s+r) (hbase : lineSlice P (v a) u = X^s*g) :
    ∃ W B : E → ℂ[X],
      (∀ x, (W x).Monic ∧ (W x).natDegree = s) ∧
      W a = X^s ∧ B a = g ∧
      (∀ k, AnalyticAt ℂ (fun x => (W x).coeff k) a) ∧
      (∀ k, AnalyticAt ℂ (fun x => (B x).coeff k) a) ∧
      (∀ x, (B x).degree < (r+1 : WithBot ℕ)) ∧
      (∀ᶠ y : E × ℂ in 𝓝 (a,0), (B y.1).eval y.2 ≠ 0) ∧
      ∀ᶠ x in 𝓝 a, W x * B x = lineSlice P (v x) u := by
  apply local_polynomial_preparation (fun x => lineSlice P (v x) u) a s r g hg hg0 hbase
  · apply Filter.Eventually.of_forall
    intro x
    have h := degree_le_of_natDegree_le ((natDegree_lineSlice_le P (v x) u).trans hdegree)
    exact h.trans_lt (by exact_mod_cast Nat.lt_succ_self (s+r))
  · intro i
    exact analyticAt_lineSlice_coeff P v u a hv i

end
end Source29SlicePreparation

/- Component: RootCluster.lean -/

namespace Source29RootCluster

open Polynomial Filter
open scoped BigOperators Topology

noncomputable section

/-- At a root of a monic polynomial, the leading power is bounded by the
contributions of the lower coefficients. -/
theorem root_power_le (p : ℂ[X]) (s : ℕ) (hp : p.Monic) (hs : p.natDegree = s)
    (w : ℂ) (hw : p.eval w = 0) :
    ‖w‖ ^ s ≤ ∑ i ∈ Finset.range s, ‖p.coeff i‖ * ‖w‖ ^ i := by
  have hc : p.coeff s = 1 := by rw [← hs, coeff_natDegree, hp.leadingCoeff]
  have he : (∑ i ∈ Finset.range s, p.coeff i * w ^ i) = -(w ^ s) := by
    rw [eval_eq_sum_range, hs, Finset.sum_range_succ, hc, one_mul] at hw
    exact eq_neg_of_add_eq_zero_left hw
  calc
    ‖w‖ ^ s = ‖∑ i ∈ Finset.range s, p.coeff i * w ^ i‖ := by rw [he, norm_neg, norm_pow]
    _ ≤ ∑ i ∈ Finset.range s, ‖p.coeff i * w ^ i‖ := norm_sum_le _ _
    _ = ∑ i ∈ Finset.range s, ‖p.coeff i‖ * ‖w‖ ^ i := by simp only [norm_mul, norm_pow]

/-- A small sum of lower coefficients forces every root into a prescribed
small disk. This elementary estimate needs no root enumeration or continuity
of a chosen root. -/
theorem root_norm_lt_of_coeff_sum_lt (p : ℂ[X]) (s : ℕ) (hp : p.Monic)
    (hs : p.natDegree = s) (ρ : ℝ) (hρ : 0 < ρ) (hρone : ρ ≤ 1)
    (hc : (∑ i ∈ Finset.range s, ‖p.coeff i‖) < ρ ^ s)
    (w : ℂ) (hw : p.eval w = 0) : ‖w‖ < ρ := by
  have hroot := root_power_le p s hp hs w hw
  by_contra hn
  have hlarge : ρ ≤ ‖w‖ := le_of_not_gt hn
  by_cases hwone : ‖w‖ ≤ 1
  · have hsum : (∑ i ∈ Finset.range s, ‖p.coeff i‖ * ‖w‖ ^ i) ≤
        ∑ i ∈ Finset.range s, ‖p.coeff i‖ := by
      apply Finset.sum_le_sum
      intro i hi
      exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hwone)
    have hpow : ρ ^ s ≤ ‖w‖ ^ s := pow_le_pow_left₀ hρ.le hlarge s
    exact (not_lt_of_ge (hpow.trans (hroot.trans hsum))) hc
  · have hwpos : 0 < ‖w‖ := hρ.trans_le hlarge
    have hsum : (∑ i ∈ Finset.range s, ‖p.coeff i‖ * ‖w‖ ^ i) ≤
        (∑ i ∈ Finset.range s, ‖p.coeff i‖) * ‖w‖ ^ s := by
      rw [Finset.sum_mul]
      apply Finset.sum_le_sum
      intro i hi
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_right₀ (le_of_lt (lt_of_not_ge hwone)) (Nat.le_of_lt (Finset.mem_range.mp hi)))
        (norm_nonneg _)
    have hmass : (∑ i ∈ Finset.range s, ‖p.coeff i‖) < 1 :=
      hc.trans_le (pow_le_one₀ hρ.le hρone)
    have hstrict := mul_lt_mul_of_pos_right hmass (pow_pos hwpos s)
    simp only [one_mul] at hstrict
    exact (not_lt_of_ge (hroot.trans hsum)) hstrict

/-- In any filter, a monic fixed-degree family with lower coefficients tending
to zero has all its roots tending uniformly to zero. -/
theorem eventually_roots_norm_lt_of_coeff_tendsto {α : Type*} {l : Filter α}
    (W : α → ℂ[X]) (s : ℕ)
    (hmonic : ∀ᶠ x in l, (W x).Monic)
    (hdegree : ∀ᶠ x in l, (W x).natDegree = s)
    (hcoeff : ∀ i < s, Tendsto (fun x => (W x).coeff i) l (𝓝 0))
    (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ x in l, ∀ w : ℂ, (W x).eval w = 0 → ‖w‖ < ε := by
  let ρ := min ε 1
  have hρ : 0 < ρ := lt_min hε zero_lt_one
  have hmass : Tendsto (fun x => ∑ i ∈ Finset.range s, ‖(W x).coeff i‖) l (𝓝 0) := by
    simpa using tendsto_finset_sum (Finset.range s)
      (fun i hi => (hcoeff i (Finset.mem_range.mp hi)).norm)
  have hsmall := hmass.eventually_lt_const (pow_pos hρ s)
  filter_upwards [hmonic, hdegree, hsmall] with x hm hd hc
  intro w hw
  exact (root_norm_lt_of_coeff_sum_lt (W x) s hm hd ρ hρ (min_le_right _ _) hc w hw).trans_le
    (min_le_left _ _)

/-- Continuity-at-a-point version for a locally monic family specializing to
`X^s`. Only continuity of the lower `s` coefficient functions is required. -/
theorem eventually_roots_norm_lt {E : Type*} [TopologicalSpace E]
    (W : E → ℂ[X]) (a : E) (s : ℕ) (ha : W a = X ^ s)
    (hmonic : ∀ᶠ x in 𝓝 a, (W x).Monic)
    (hdegree : ∀ᶠ x in 𝓝 a, (W x).natDegree = s)
    (hcoeff : ∀ i < s, ContinuousAt (fun x => (W x).coeff i) a)
    (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ x in 𝓝 a, ∀ w : ℂ, (W x).eval w = 0 → ‖w‖ < ε := by
  apply eventually_roots_norm_lt_of_coeff_tendsto W s hmonic hdegree _ ε hε
  intro i hi
  simpa [ha, coeff_X_pow, ne_of_lt hi] using (hcoeff i hi).tendsto

end
end Source29RootCluster

/- Component: RootEnumeration.lean -/

namespace Source29RootEnumeration

open Polynomial
open scoped BigOperators

noncomputable section

/-- Enumerate a multiset with multiplicity, without imposing any regularity on
the chosen order. -/
theorem exists_multiset_enumeration {α : Type*} (m : Multiset α) :
    ∃ w : Fin m.card → α, (List.ofFn w : Multiset α) = m := by
  refine Quotient.inductionOn m ?_
  intro l
  change ∃ w : Fin l.length → α, (List.ofFn w : Multiset α) = (l : Multiset α)
  exact ⟨l.get, by rw [List.ofFn_get]⟩

variable {K : Type*} [Field K]

lemma esymm_two_cons (a : K) (m : Multiset K) :
    (a ::ₘ m).esymm 2 = m.esymm 2 + a * m.sum := by
  simp only [Multiset.esymm, Multiset.powersetCard_cons, Multiset.map_add,
    Multiset.sum_add, Multiset.powersetCard_one, Multiset.map_map,
    Function.comp_def, Multiset.prod_cons, Multiset.prod_singleton]
  congr 1
  simpa using (Multiset.sum_map_mul_left (s := m) (a := a) (f := id))

/-- The second Newton identity in a form that does not require a choice of
root labels. -/
theorem sum_squares_eq (m : Multiset K) :
    (m.map (fun x => x ^ 2)).sum = m.sum ^ 2 - 2 * m.esymm 2 := by
  induction m using Multiset.induction_on with
  | empty =>
    have he : (0 : Multiset K).esymm 2 = 0 :=
      Multiset.esymm_of_card_lt (by simp)
    simp [he]
  | @cons a m ih =>
    rw [Multiset.map_cons, Multiset.sum_cons, Multiset.sum_cons, esymm_two_cons, ih]
    ring

/-- The second upper coefficient is zero in degrees zero and one. -/
def secondUpperCoeff (p : K[X]) (s : ℕ) : K :=
  if 2 ≤ s then p.coeff (s - 2) else 0

lemma roots_esymm_two (p : K[X]) (s : ℕ) (hp : p.Monic)
    (hs : p.natDegree = s) (hsplit : p.Splits) :
    p.roots.esymm 2 = secondUpperCoeff p s := by
  by_cases htwo : 2 ≤ s
  · have he := coeff_eq_esymm_roots_of_splits hsplit (k := s - 2) (by omega)
    have hn : s - (s - 2) = 2 := by omega
    simpa [hs, hp.leadingCoeff, hn, secondUpperCoeff, htwo] using he.symm
  · have hc : p.roots.card < 2 := by rw [splits_iff_card_roots.mp hsplit, hs]; omega
    simp [Multiset.esymm_of_card_lt hc, secondUpperCoeff, htwo]

lemma roots_sum (p : K[X]) (s : ℕ) (hp : p.Monic)
    (hs : p.natDegree = s) (hpos : 0 < s) (hsplit : p.Splits) :
    p.roots.sum = -p.coeff (s - 1) := by
  have he := hsplit.nextCoeff_eq_neg_sum_roots_of_monic hp
  have hn : p.nextCoeff = p.coeff (s - 1) := by simp [Polynomial.nextCoeff, hs, hpos.ne']
  rw [hn] at he
  exact (neg_eq_iff_eq_neg.mpr he).symm

/-- Every monic split polynomial admits a full root tuple whose first two power
sums are its upper coefficient expressions. -/
theorem exists_root_tuple (p : K[X]) (s : ℕ) (hp : p.Monic)
    (hs : p.natDegree = s) (hpos : 0 < s) (hsplit : p.Splits) :
    ∃ w : Fin s → K,
      (List.ofFn w : Multiset K) = p.roots ∧
      (∀ i, p.eval (w i) = 0) ∧
      (∑ i, w i) = -p.coeff (s - 1) ∧
      (∑ i, (w i)^2) = p.coeff (s - 1)^2 - 2 * secondUpperCoeff p s := by
  have hcard : p.roots.card = s := (splits_iff_card_roots.mp hsplit).trans hs
  obtain ⟨w, hw⟩ : ∃ w : Fin s → K, (List.ofFn w : Multiset K) = p.roots := by
    cases hcard
    exact exists_multiset_enumeration p.roots
  refine ⟨w, hw, ?_, ?_, ?_⟩
  · intro i
    apply isRoot_of_mem_roots
    rw [← hw]
    exact List.mem_ofFn.mpr ⟨i, rfl⟩
  · have he := roots_sum p s hp hs hpos hsplit
    rw [← hw] at he
    simpa [List.sum_ofFn] using he
  · have he := sum_squares_eq p.roots
    rw [roots_sum p s hp hs hpos hsplit, roots_esymm_two p s hp hs hsplit, ← hw] at he
    simpa [Multiset.map_coe, List.map_ofFn, List.sum_ofFn, Function.comp_def] using he

end
end Source29RootEnumeration

/- Component: RootFamily.inc -/

namespace Source29RootEnumeration

open Polynomial Filter
open scoped BigOperators Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The root labels can be chosen arbitrarily pointwise. Their first two power
sums are nevertheless analytic because they are coefficient expressions. -/
theorem exists_analytic_power_sum_root_family (W : E → Polynomial ℂ)
    (a : E) (s : ℕ) (hs : 0 < s) (ha : W a = X ^ s)
    (hmonic : ∀ x, (W x).Monic) (hdegree : ∀ x, (W x).natDegree = s)
    (hsplit : ∀ x, (W x).Splits)
    (hcoeff : ∀ i, AnalyticAt ℂ (fun x => (W x).coeff i) a) :
    ∃ w : E → Fin s → ℂ,
      (∀ x, (List.ofFn (w x) : Multiset ℂ) = (W x).roots) ∧
      (∀ x i, (W x).eval (w x i) = 0) ∧
      (∀ i, w a i = 0) ∧
      AnalyticAt ℂ (fun x => ∑ i, w x i) a ∧
      AnalyticAt ℂ (fun x => ∑ i, (w x i) ^ 2) a := by
  choose w hw hroot hsum hsquare using
    fun x => exists_root_tuple (W x) s (hmonic x) (hdegree x) hs (hsplit x)
  refine ⟨w, hw, hroot, ?_, ?_, ?_⟩
  · intro i
    have hz := hroot a i
    rw [ha, eval_pow, eval_X] at hz
    exact eq_zero_of_pow_eq_zero hz
  · have he : (fun x => ∑ i, w x i) = fun x => -(W x).coeff (s - 1) :=
      funext hsum
    rw [he]
    exact (hcoeff (s - 1)).neg
  · have he : (fun x => ∑ i, (w x i) ^ 2) =
        fun x => (W x).coeff (s - 1)^2 - 2 * secondUpperCoeff (W x) s :=
      funext hsquare
    rw [he]
    have hsecond : AnalyticAt ℂ (fun x => secondUpperCoeff (W x) s) a := by
      by_cases htwo : 2 ≤ s
      · simpa only [secondUpperCoeff, if_pos htwo] using hcoeff (s - 2)
      · simp only [secondUpperCoeff, if_neg htwo]
        exact analyticAt_const
    exact ((hcoeff (s - 1)).pow 2).sub (analyticAt_const.mul hsecond)

end
end Source29RootEnumeration

/- Component: SliceInitialFactor.inc -/

namespace Source29SliceInitialFactor

open MvPolynomial Source29SlicePolynomial
open scoped BigOperators Topology

noncomputable section

/-- Restriction through the origin records precisely the homogeneous pieces. -/
theorem lineSlice_zero_eq_sum {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (N : Fin n → ℂ) :
    lineSlice P 0 N = ∑ k ∈ Finset.range (P.totalDegree+1),
      Polynomial.C (eval N (homogeneousComponent k P)) * Polynomial.X^k := by
  apply Polynomial.funext
  intro t
  rw [eval_lineSlice]
  simp only [Pi.zero_apply, zero_add]
  conv_lhs => rw [← sum_homogeneousComponent P]
  simp only [map_sum, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_pow, Polynomial.eval_X]
  apply Finset.sum_congr rfl
  intro k hk
  rw [Source29ProjectiveMaximum.eval_scale_of_isHomogeneous _ k
    (homogeneousComponent_isHomogeneous k P) N t]
  ring

theorem coeff_lineSlice_zero {n : ℕ} (P : MvPolynomial (Fin n) ℂ) (N : Fin n → ℂ)
    (k : ℕ) : (lineSlice P 0 N).coeff k = eval N (homogeneousComponent k P) := by
  classical
  rw [lineSlice_zero_eq_sum, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow]
  by_cases hk : k < P.totalDegree+1
  · simp [hk]
  · have hdeg : P.totalDegree < k := by omega
    simp [hk, homogeneousComponent_eq_zero k P hdeg]

/-- A nonzero lowest homogeneous coefficient in direction N gives the exact
power of X in the normal slice, with a nonzero constant coefficient remaining. -/
theorem exists_slice_factor_of_lowest {n : ℕ} (P : MvPolynomial (Fin n) ℂ)
    (N : Fin n → ℂ) (s : ℕ)
    (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (hs : eval N (homogeneousComponent s P) ≠ 0) :
    ∃ g : Polynomial ℂ,
      lineSlice P 0 N = Polynomial.X^s*g ∧
      g.coeff 0 = eval N (homogeneousComponent s P) ∧
      g.coeff 0 ≠ 0 ∧ s+g.natDegree ≤ P.totalDegree := by
  have hd : (Polynomial.X^s : Polynomial ℂ) ∣ lineSlice P 0 N := by
    apply Polynomial.X_pow_dvd_iff.mpr
    intro k hk
    rw [coeff_lineSlice_zero, hlow k hk, map_zero]
  obtain ⟨g, hg⟩ := hd
  have hc : g.coeff 0 = eval N (homogeneousComponent s P) := by
    rw [← coeff_lineSlice_zero P N s, hg]
    simpa only [zero_add] using (Polynomial.coeff_X_pow_mul g s 0).symm
  have hgc : g.coeff 0 ≠ 0 := by
    rw [hc]
    exact hs
  have hgn : g ≠ 0 := by
    intro h
    exact hgc (by simp [h])
  have hdegree := natDegree_lineSlice_le P 0 N
  rw [hg, Polynomial.natDegree_mul (pow_ne_zero s Polynomial.X_ne_zero) hgn,
    Polynomial.natDegree_X_pow] at hdegree
  exact ⟨g, hg, hc, hgc, hdegree⟩

/-- In particular the initial normal-power conclusion supplies the base
factorization needed by polynomial preparation. -/
theorem exists_slice_factor_of_initial_power {n : ℕ} (P L : MvPolynomial (Fin n) ℂ)
    (N : Fin n → ℂ) (s : ℕ) (a : ℂ) (ha : a ≠ 0)
    (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (hinit : homogeneousComponent s P = C a * L^s) (hLN : eval N L ≠ 0) :
    ∃ g : Polynomial ℂ,
      lineSlice P 0 N = Polynomial.X^s*g ∧
      g.coeff 0 = a*(eval N L)^s ∧
      g.coeff 0 ≠ 0 ∧ s+g.natDegree ≤ P.totalDegree := by
  have heval : eval N (homogeneousComponent s P) = a*(eval N L)^s := by
    rw [hinit, map_mul, eval_C, map_pow]
  simpa only [heval] using exists_slice_factor_of_lowest P N s hlow
    (by rw [heval]; exact mul_ne_zero ha (pow_ne_zero s hLN))

/-- Applying local preparation after the initial-power calculation. The
parameter map may in particular be the inclusion of the tangent hyperplane. -/
theorem preparation_of_initial_power
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}
    (P L : MvPolynomial (Fin n) ℂ) (N : Fin n → ℂ)
    (s : ℕ) (c : ℂ) (hc : c ≠ 0)
    (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (hinit : homogeneousComponent s P = C c * L^s) (hLN : eval N L ≠ 0)
    (v : E → Fin n → ℂ) (a : E) (hv0 : v a = 0)
    (hv : ∀ i, AnalyticAt ℂ (fun x => v x i) a) :
    ∃ W B : E → Polynomial ℂ,
      (∀ x, (W x).Monic ∧ (W x).natDegree = s) ∧
      W a = Polynomial.X^s ∧ (B a).coeff 0 = c*(eval N L)^s ∧
      (∀ k, AnalyticAt ℂ (fun x => (W x).coeff k) a) ∧
      (∀ k, AnalyticAt ℂ (fun x => (B x).coeff k) a) ∧
      (∀ x, (B x).degree < (P.totalDegree+1 : WithBot ℕ)) ∧
      (∀ᶠ y : E × ℂ in 𝓝 (a,0), (B y.1).eval y.2 ≠ 0) ∧
      ∀ᶠ x in 𝓝 a, W x * B x = lineSlice P (v x) N := by
  obtain ⟨g, hg, hg0, hgne, hgdegree⟩ :=
    exists_slice_factor_of_initial_power P L N s c hc hlow hinit hLN
  have hgr : g.natDegree ≤ P.totalDegree := by omega
  have hb : lineSlice P (v a) N = Polynomial.X^s*g := by simpa only [hv0] using hg
  obtain ⟨W, B, hW, hWa, hBa, hWana, hBana, hBdegree, hBunit, hWB⟩ :=
    Source29SlicePreparation.lineSlice_preparation P v N a hv s P.totalDegree g hgr hgne
      (by omega) hb
  refine ⟨W, B, hW, hWa, ?_, hWana, hBana, hBdegree, hBunit, hWB⟩
  rw [hBa]
  exact hg0

/-- The preceding preparation applies on any linear parameter subspace, in
particular the kernel of the initial normal linear form. -/
theorem preparation_on_subspace
    {n : ℕ} (P L : MvPolynomial (Fin n) ℂ) (N : Fin n → ℂ)
    (s : ℕ) (c : ℂ) (hc : c ≠ 0)
    (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (hinit : homogeneousComponent s P = C c * L^s) (hLN : eval N L ≠ 0)
    (T : Submodule ℂ (Fin n → ℂ)) :
    ∃ W B : T → Polynomial ℂ,
      (∀ x, (W x).Monic ∧ (W x).natDegree = s) ∧
      W 0 = Polynomial.X^s ∧ (B 0).coeff 0 = c*(eval N L)^s ∧
      (∀ k, AnalyticAt ℂ (fun x => (W x).coeff k) 0) ∧
      (∀ k, AnalyticAt ℂ (fun x => (B x).coeff k) 0) ∧
      (∀ x, (B x).degree < (P.totalDegree+1 : WithBot ℕ)) ∧
      (∀ᶠ y : T × ℂ in 𝓝 (0,0), (B y.1).eval y.2 ≠ 0) ∧
      ∀ᶠ x in 𝓝 (0 : T), W x * B x = lineSlice P (x : Fin n → ℂ) N := by
  apply preparation_of_initial_power P L N s c hc hlow hinit hLN
    (fun x : T => (x : Fin n → ℂ)) 0 (by rfl)
  intro i
  exact ((ContinuousLinearMap.proj i).comp T.subtypeL).analyticAt 0

end
end Source29SliceInitialFactor

/- Component: RootMaximumBridge.inc -/
/- From a local polynomial root family to the quadratic sheet bound at a
normalized maximum. Tangent coordinates are represented by a linear isometry. -/

namespace Source29RootMaximumBridge

open MvPolynomial Filter
open scoped Topology

noncomputable section

abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

/-- The local polynomial root-cluster theorem applies to any choice of labels. -/
lemma root_family_clusters {E : Type*} [TopologicalSpace E] [Zero E] {ι : Type*} (W : E → Polynomial ℂ) (d : ℕ)
    (hW0 : W 0 = Polynomial.X^d)
    (hmonic : ∀ᶠ x in 𝓝 (0 : E), (W x).Monic)
    (hdegree : ∀ᶠ x in 𝓝 (0 : E), (W x).natDegree = d)
    (hcoeff : ∀ i < d, ContinuousAt (fun x => (W x).coeff i) 0)
    (w : E → ι → ℂ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j, (W x).eval (w x j) = 0) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ < ε := by
  intro ε hε
  have hcluster := Source29RootCluster.eventually_roots_norm_lt
    W (0 : E) d hW0 hmonic hdegree hcoeff ε hε
  filter_upwards [hcluster, hroot] with x hx hr j
  exact hx (w x j) (hr j)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

lemma eventually_displacement_small {n : ℕ} {ι : Type*}
    (T : E →ₗᵢ[ℂ] CSpace n) (N : CSpace n) (w : E → ι → ℂ)
    (hcluster : ∀ ε : ℝ, 0 < ε → ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ < ε)
    (r : ℝ) (hr : 0 < r) :
    ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖T x + w x j • N‖ < r := by
  let δ : ℝ := r / (2 * (‖N‖ + 1))
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hsmall : ∀ᶠ x in 𝓝 (0 : E), ‖x‖ < r / 2 := by
    filter_upwards [Metric.ball_mem_nhds (0 : E) (half_pos hr)] with x hx
    simpa only [Metric.mem_ball, dist_zero_right] using hx
  filter_upwards [hsmall, hcluster δ hδ] with x hx hw j
  have hprod := mul_lt_mul_of_pos_right (hw j) (by positivity : 0 < ‖N‖ + 1)
  have hδeq : δ * (‖N‖ + 1) = r / 2 := by
    dsimp [δ]
    field_simp
  rw [hδeq] at hprod
  have htri := norm_add_le (T x) (w x j • N)
  rw [T.norm_map, norm_smul] at htri
  nlinarith [norm_nonneg (w x j)]

/-- Uniform clustering brings every root into the small-slope neighborhood. -/
theorem eventually_small_slope {n : ℕ} {ι : Type*}
    (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (L : CSpace n →L[ℂ] ℂ)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 → L v = 0)
    (N : CSpace n) (hN : L N ≠ 0) (T : E →ₗᵢ[ℂ] CSpace n)
    (hT : ∀ x, L (T x) = 0) (w : E → ι → ℂ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j, eval (fun i => (T x + w x j • N) i) P = 0)
    (hcluster : ∀ ε : ℝ, 0 < ε → ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ < ε)
    (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ ε * ‖x‖ := by
  obtain ⟨r, hr, hrbound⟩ :=
    Source29SmallSlope.exists_small_slope P s hs hlow L hinitial N hN ε hε
  have hsmall := eventually_displacement_small T N w hcluster r hr
  filter_upwards [hsmall, hroot] with x hx hzero j
  simpa only [T.norm_map] using hrbound (T x) (w x j) (hT x) (hx j) (hzero j)

lemma normal_form_eq_dot {n : ℕ} (z v : CSpace n) (κ : ℝ) :
    Source29ComplexTangent.normalCLM κ z v =
      Source29LocalMaximumBound.dot (Source29LocalMaximumBound.normal z κ) v := by
  rw [Source29ComplexTangent.normalCLM_apply]
  simp [Source29LocalMaximumBound.dot, Source29LocalMaximumBound.normal,
    Source29LocalMaximumBound.conjugate]

lemma normal_square_ne_zero {n : ℕ} (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : Source29LocalMaximumBound.quadric z = (κ : ℂ))
    (hk : 0 < κ) (hk1 : κ < 1) :
    Source29LocalMaximumBound.dot (Source29LocalMaximumBound.normal z κ)
      (Source29LocalMaximumBound.normal z κ) ≠ 0 := by
  have hq' : Source29ComplexMaximum.bilinear (fun i => z i) (fun i => z i) = (κ : ℂ) := by
    simpa only [Source29ComplexMaximum.bilinear, Source29LocalMaximumBound.quadric,
      pow_two] using hq
  have hnorm : Source29ComplexMaximum.bilinear (fun i => star (z i)) (fun i => z i) = 1 := by
    change Source29LocalMaximumBound.dot (Source29LocalMaximumBound.conjugate z) z = 1
    rw [Source29LocalMaximumBound.dot_conjugate_eq_inner, inner_self_eq_norm_sq_to_K, hz]
    norm_num
  have hsq := Source29ComplexMaximum.normal_square (fun i => z i) κ hq' hnorm
  have hne := Source29ComplexMaximum.normal_square_ne_zero κ hk hk1
  rw [← hsq] at hne
  simpa [Source29ComplexMaximum.bilinear, Source29LocalMaximumBound.dot,
    Source29LocalMaximumBound.normal, Source29LocalMaximumBound.conjugate] using hne

/-- Every sufficiently small sheet root satisfies a quadratic one-sided bound
in tangent coordinates, with the explicit constant four. -/
theorem eventually_root_real_bound {n : ℕ} {ι : Type*}
    (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (z : CSpace n) (κ : ℝ) (hz : ‖z‖ = 1)
    (hq : Source29LocalMaximumBound.quadric z = (κ : ℂ)) (hk : 0 < κ) (hk1 : κ < 1)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 →
        Source29ComplexTangent.normalCLM κ z v = 0)
    (hmaximum : ∀ δ : CSpace n, eval (fun i => δ i) P = 0 →
      ‖Source29LocalMaximumBound.quadric (z + δ)‖ ≤ κ * ‖z + δ‖^2)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (hT : ∀ x, Source29ComplexTangent.normalCLM κ z (T x) = 0)
    (w : E → ι → ℂ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j,
      eval (fun i => (T x + w x j • Source29LocalMaximumBound.normal z κ) i) P = 0)
    (hcluster : ∀ ε : ℝ, 0 < ε → ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ < ε) :
    ∀ᶠ x in 𝓝 (0 : E), ∀ j,
      (Source29LocalMaximumBound.dot (Source29LocalMaximumBound.normal z κ)
        (Source29LocalMaximumBound.normal z κ) * w x j).re ≤ 4 * ‖x‖^2 := by
  have hN : Source29ComplexTangent.normalCLM κ z
      (Source29LocalMaximumBound.normal z κ) ≠ 0 := by
    rw [normal_form_eq_dot]
    exact normal_square_ne_zero z κ hz hq hk hk1
  have hslope := eventually_small_slope P s hs hlow
    (Source29ComplexTangent.normalCLM κ z) hinitial
    (Source29LocalMaximumBound.normal z κ) hN T hT w hroot hcluster 1 (by norm_num)
  filter_upwards [hslope, hroot] with x hx hzero j
  have hTx : Source29LocalMaximumBound.dot (Source29LocalMaximumBound.normal z κ) (T x) = 0 := by
    rw [← normal_form_eq_dot]
    exact hT x
  have hb := Source29LocalMaximumBound.normal_coefficient_bound_coordinates z (T x) (w x j) κ
    hz hq hk1.le hTx (hmaximum _ (hzero j))
  rw [T.norm_map] at hb
  have hs := hx j
  simp only [one_mul] at hs
  have hsq := (sq_le_sq₀ (norm_nonneg (w x j)) (norm_nonneg x)).mpr hs
  linarith

/-- The concrete geometric root-family hypotheses give a uniform quadratic
bound as soon as the first two power sums are analytic. -/
theorem quadratic_root_bound {n : ℕ} {ι : Type*} [Fintype ι]
    (P : MvPolynomial (Fin n) ℂ) (s : ℕ)
    (hs : s ≤ P.totalDegree) (hlow : ∀ k < s, homogeneousComponent k P = 0)
    (z : CSpace n) (κ : ℝ) (hz : ‖z‖ = 1)
    (hq : Source29LocalMaximumBound.quadric z = (κ : ℂ)) (hk : 0 < κ) (hk1 : κ < 1)
    (hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 →
        Source29ComplexTangent.normalCLM κ z v = 0)
    (hmaximum : ∀ δ : CSpace n, eval (fun i => δ i) P = 0 →
      ‖Source29LocalMaximumBound.quadric (z + δ)‖ ≤ κ * ‖z + δ‖^2)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (hT : ∀ x, Source29ComplexTangent.normalCLM κ z (T x) = 0)
    (w : E → ι → ℂ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j,
      eval (fun i => (T x + w x j • Source29LocalMaximumBound.normal z κ) i) P = 0)
    (hcluster : ∀ ε : ℝ, 0 < ε → ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ < ε)
    (hS1 : AnalyticAt ℂ (fun x => ∑ j, w x j) 0)
    (hS2 : AnalyticAt ℂ (fun x => ∑ j, (w x j)^2) 0) :
    ∃ A : ℝ, 0 < A ∧ ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ A * ‖x‖^2 := by
  have hzero : ∀ j, w 0 j = 0 := by
    intro j
    by_contra hj
    have hp : 0 < ‖w 0 j‖ := norm_pos_iff.mpr hj
    have hbad := (hcluster _ hp).self_of_nhds j
    exact (lt_irrefl _) hbad
  have hreal := eventually_root_real_bound P s hs hlow z κ hz hq hk hk1
    hinitial hmaximum T hT w hroot hcluster
  exact Source29QuadraticSheetBound.quadratic_sheet_bound_scaled w hzero hS1 hS2
    (Source29LocalMaximumBound.dot (Source29LocalMaximumBound.normal z κ)
      (Source29LocalMaximumBound.normal z κ))
    (normal_square_ne_zero z κ hz hq hk hk1) 4 hreal

end
end Source29RootMaximumBridge

/- Component: LocalQuadraticPreparation.inc -/
/- The analytic preparation and the geometric maximum estimates are assembled
here without assuming any regularity of the individual root labels. -/
namespace Source29LocalQuadratic

open MvPolynomial Filter
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}

abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

structure PreparedRoots (P : MvPolynomial (Fin n) ℂ)
    (T : E →ₗᵢ[ℂ] CSpace n) (N : CSpace n) where
  s : ℕ
  s_pos : 0 < s
  W : E → Polynomial ℂ
  B : E → Polynomial ℂ
  roots : E → Fin s → ℂ
  monic_degree : ∀ x, (W x).Monic ∧ (W x).natDegree = s
  base : W 0 = Polynomial.X^s
  coefficients_analytic : ∀ k, AnalyticAt ℂ (fun x => (W x).coeff k) 0
  unit_coefficients_analytic : ∀ k, AnalyticAt ℂ (fun x => (B x).coeff k) 0
  unit_degree : ∀ x, (B x).degree < (P.totalDegree+1 : WithBot ℕ)
  unit_nonzero : ∀ᶠ y : E × ℂ in 𝓝 (0,0), (B y.1).eval y.2 ≠ 0
  factorization : ∀ᶠ x in 𝓝 (0 : E),
    W x * B x = Source29SlicePolynomial.lineSlice P (fun i => T x i) (fun i => N i)
  root_multiset : ∀ x, (List.ofFn (roots x) : Multiset ℂ) = (W x).roots
  root_polynomial : ∀ x j, (W x).eval (roots x j) = 0
  root_original : ∀ᶠ x in 𝓝 (0 : E), ∀ j,
    eval (fun i => (T x + roots x j • N) i) P = 0
  base_roots : ∀ j, roots 0 j = 0
  sum_analytic : AnalyticAt ℂ (fun x => ∑ j, roots x j) 0
  sum_squares_analytic : AnalyticAt ℂ (fun x => ∑ j, (roots x j)^2) 0
  quadratic_bound : ∃ A : ℝ, 0 < A ∧
    ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖roots x j‖ ≤ A * ‖x‖^2

/-- At a possibly singular normalized maximum, preparation and a uniform
quadratic bound hold on any isometrically parameterized tangent subspace. -/
theorem exists_prepared_roots_at_maximum
    (h : MvPolynomial (Fin n) ℂ) (hne : h ≠ 0) (z : CSpace n)
    (hzero : eval (fun i => z i) h = 0)
    (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hzunit : ‖z‖ = 1)
    (hzq : (∑ i : Fin n, (z i)^2) = (κ : ℂ))
    (hbound : ∀ v : CSpace n, eval (fun i => v i) h = 0 →
      Source29ProjectiveMaximum.quadricNorm v ≤ κ * ‖v‖^2)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (hT : ∀ x, Source29ComplexTangent.normalCLM κ z (T x) = 0) :
    Nonempty (PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      T (Source29LocalMaximumBound.normal z κ)) := by
  letI : IsAlgClosed ℂ := Source29FTA.complex_isAlgClosed
  let P := Source29PolynomialTranslation.translate h (fun i => z i)
  let N := Source29LocalMaximumBound.normal z κ
  let L := Source29LinearForm.linearForm (fun i => z i - (κ : ℂ) * star (z i))
  obtain ⟨s, a, hs, hsdegree, ha, hlow, hinit⟩ :=
    Source29InitialNormalPower.exists_normal_power_initial h hne z hzero
      κ hk hk1 hzunit hzq hbound
  have hLeval (v : CSpace n) : eval (fun i => v i) L =
      Source29ComplexTangent.normalCLM κ z v := by
    rw [Source29ComplexTangent.normalCLM_apply]
    exact Source29LinearForm.eval_linearForm _ _
  have hLN : eval (fun i => N i) L ≠ 0 := by
    rw [hLeval, Source29RootMaximumBridge.normal_form_eq_dot]
    exact Source29RootMaximumBridge.normal_square_ne_zero z κ hzunit hzq hk hk1
  have hv : ∀ i, AnalyticAt ℂ (fun x : E => T x i) 0 := by
    intro i
    exact ((EuclideanSpace.proj i).comp T.toContinuousLinearMap).analyticAt 0
  obtain ⟨W, B, hW, hW0, hB0, hWa, hBa, hBd, hBu, hWB⟩ :=
    Source29SliceInitialFactor.preparation_of_initial_power P L (fun i => N i)
      s a ha hlow hinit hLN (fun x : E => fun i => T x i) 0
      (by ext i; simp) hv
  obtain ⟨w, hwtuple, hwroot, hw0, hw1, hw2⟩ :=
    Source29RootEnumeration.exists_analytic_power_sum_root_family W (0 : E) s hs hW0
      (fun x => (hW x).1) (fun x => (hW x).2) (fun x => IsAlgClosed.splits _) hWa
  have hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j,
      eval (fun i => (T x + w x j • N) i) P = 0 := by
    filter_upwards [hWB] with x hx j
    have he := congrArg (fun p : Polynomial ℂ => p.eval (w x j)) hx
    rw [Polynomial.eval_mul, hwroot x j, zero_mul,
      Source29SlicePolynomial.eval_lineSlice] at he
    exact he.symm
  have hcluster := Source29RootMaximumBridge.root_family_clusters W s hW0
    (Filter.Eventually.of_forall fun x => (hW x).1)
    (Filter.Eventually.of_forall fun x => (hW x).2)
    (fun i _ => (hWa i).continuousAt) w (Filter.Eventually.of_forall hwroot)
  have hinitial : ∀ v : CSpace n,
      eval (fun i => v i) (homogeneousComponent s P) = 0 →
      Source29ComplexTangent.normalCLM κ z v = 0 := by
    intro v hvzero
    change homogeneousComponent s P = C a * L^s at hinit
    rw [hinit, map_mul, eval_C, map_pow, hLeval] at hvzero
    exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp hvzero).resolve_left ha)
  have hmaximum : ∀ δ : CSpace n, eval (fun i => δ i) P = 0 →
      ‖Source29LocalMaximumBound.quadric (z + δ)‖ ≤ κ * ‖z + δ‖^2 := by
    intro δ hδ
    apply hbound (z + δ)
    exact (Source29PolynomialTranslation.eval_translate h (fun i => z i) (fun i => δ i)).symm.trans hδ
  have hquad := Source29RootMaximumBridge.quadratic_root_bound P s hsdegree hlow
    z κ hzunit hzq hk hk1 hinitial hmaximum T hT w hroot hcluster hw1 hw2
  exact ⟨{
    s := s, s_pos := hs, W := W, B := B, roots := w,
    monic_degree := hW, base := hW0, coefficients_analytic := hWa,
    unit_coefficients_analytic := hBa, unit_degree := hBd, unit_nonzero := hBu,
    factorization := hWB, root_multiset := hwtuple, root_polynomial := hwroot, root_original := hroot,
    base_roots := hw0, sum_analytic := hw1, sum_squares_analytic := hw2,
    quadratic_bound := hquad }⟩

end
end Source29LocalQuadratic

/- Component: AnalyticMaximum.inc -/
/- Scalar maximum principles derived from the finite-order phase argument.
This avoids adding complex integration to the challenge import closure. -/

namespace Source29AnalyticMaximum

open Filter
open scoped Topology

noncomputable section

theorem eventually_zero_of_re_nonpos (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0)
    (hf0 : f 0 = 0) (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), (f z).re ≤ 0) :
    ∀ᶠ z in 𝓝 (0 : ℂ), f z = 0 := by
  by_contra hnot
  obtain ⟨d, g, hg, hg0, hfactor⟩ := hf.exists_eventuallyEq_pow_smul_nonzero_iff.mpr hnot
  have hfactor' : ∀ᶠ z in 𝓝 (0 : ℂ), f z = z ^ d * g z := by
    simpa only [sub_zero, smul_eq_mul] using hfactor
  have hd : 0 < d := by
    by_contra hnotd
    have hd0 : d = 0 := by omega
    have h0 := hfactor'.self_of_nhds
    rw [hd0, pow_zero, one_mul, hf0] at h0
    exact hg0 h0.symm
  have hgbound : ∀ᶠ z in 𝓝 (0 : ℂ),
      (z ^ d * g z).re ≤ (0 : ℝ) * ‖z‖ ^ (d + 1) := by
    filter_upwards [hfactor', hbound] with z hz hb
    simpa only [hz, zero_mul] using hb
  have himpossible := Source29OneSidedOrder.order_ge_of_one_sided_bound
    g hg.continuousAt hg0 d (d + 1) hd 0 hgbound
  omega

theorem eventually_constant_of_norm_max_zero (f : ℂ → ℂ)
    (hf : AnalyticAt ℂ f 0)
    (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), ‖f z‖ ≤ ‖f 0‖) :
    ∀ᶠ z in 𝓝 (0 : ℂ), f z = f 0 := by
  by_cases hf0 : f 0 = 0
  · filter_upwards [hbound] with z hz
    simpa only [hf0, norm_zero, norm_le_zero_iff] using hz
  let F : ℂ → ℂ := fun z => star (f 0) * (f z - f 0)
  have hF : AnalyticAt ℂ F 0 := analyticAt_const.mul (hf.sub analyticAt_const)
  have hF0 : F 0 = 0 := by simp [F]
  have hFbound : ∀ᶠ z in 𝓝 (0 : ℂ), (F z).re ≤ 0 := by
    filter_upwards [hbound] with z hz
    have hr := Complex.re_le_norm (star (f 0) * f z)
    have hn := mul_le_mul_of_nonneg_left hz (norm_nonneg (f 0))
    have hsq : (star (f 0) * f 0).re = ‖f 0‖ ^ 2 := by
      simp [Complex.mul_re, Complex.sq_norm, Complex.normSq_apply]
    rw [norm_mul, norm_star] at hr
    change (star (f 0) * (f z - f 0)).re ≤ 0
    rw [mul_sub, Complex.sub_re, hsq]
    nlinarith
  have hzero := eventually_zero_of_re_nonpos F hF hF0 hFbound
  filter_upwards [hzero] with z hz
  change star (f 0) * (f z - f 0) = 0 at hz
  have hn : star (f 0) ≠ 0 := by simpa using hf0
  exact sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left hn)

/-- Scalar analytic maximum modulus principle, in its local form. -/
theorem eventually_constant_of_norm_max (f : ℂ → ℂ) (c : ℂ)
    (hf : AnalyticAt ℂ f c)
    (hbound : ∀ᶠ z in 𝓝 c, ‖f z‖ ≤ ‖f c‖) :
    ∀ᶠ z in 𝓝 c, f z = f c := by
  let F : ℂ → ℂ := fun z => f (c + z)
  have hF : AnalyticAt ℂ F 0 := by
    have hg : AnalyticAt ℂ (fun z : ℂ => c + z) 0 :=
      analyticAt_const.add analyticAt_id
    have hf' : AnalyticAt ℂ f ((fun z : ℂ => c + z) 0) := by simpa using hf
    exact hf'.comp hg
  have hpath : Tendsto (fun z : ℂ => c + z) (𝓝 0) (𝓝 c) := by
    simpa using tendsto_const_nhds.add (tendsto_id (x := (𝓝 (0 : ℂ))))
  have hFbound : ∀ᶠ z in 𝓝 (0 : ℂ), ‖F z‖ ≤ ‖F 0‖ := by
    simpa only [F, add_zero] using hpath.eventually hbound
  have hFconstant := eventually_constant_of_norm_max_zero F hF hFbound
  have hback : Tendsto (fun z : ℂ => z - c) (𝓝 c) (𝓝 0) := by
    simpa using (tendsto_id (x := 𝓝 c)).sub
      (tendsto_const_nhds : Tendsto (fun _ : ℂ => c) (𝓝 c) (𝓝 c))
  simpa only [F, add_sub_cancel, add_zero] using hback.eventually hFconstant

end
end Source29AnalyticMaximum

/- Component: AnalyticDerivativeBounds.inc -/

/- Maximum and derivative bounds obtained from the local analytic maximum
principle, the identity theorem, and removable divided differences. No complex
integration theorem is required. -/
namespace Source29AnalyticDerivativeBounds

open Filter Set
open scoped Topology

noncomputable section

/-- The scalar maximum modulus principle on a closed complex ball. -/
theorem norm_le_of_sphere_bound (f : ℂ → ℂ) (c : ℂ) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ z ∈ Metric.sphere c R, ‖f z‖ ≤ M) :
    ∀ z ∈ Metric.closedBall c R, ‖f z‖ ≤ M := by
  obtain ⟨z, hz, hmax⟩ := (isCompact_closedBall c R).exists_isMaxOn
    ⟨c, Metric.mem_closedBall_self hR.le⟩ hf.continuousOn.norm
  have hzM : ‖f z‖ ≤ M := by
    by_cases hze : dist z c = R
    · exact hbound z hze
    have hzi : z ∈ Metric.ball c R :=
      lt_of_le_of_ne (show dist z c ≤ R from hz) hze
    have hlocal : ∀ᶠ w in 𝓝 z, ‖f w‖ ≤ ‖f z‖ := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hzi] with w hw
      exact hmax (Metric.ball_subset_closedBall hw)
    have he := Source29AnalyticMaximum.eventually_constant_of_norm_max f z (hf z hz) hlocal
    have hall : EqOn f (fun _ => f z) (Metric.closedBall c R) :=
      hf.eqOn_of_preconnected_of_eventuallyEq (fun _ _ => analyticAt_const)
        (convex_closedBall c R).isPreconnected hz he
    have hb : c + (R : ℂ) ∈ Metric.sphere c R := by
      simp [Metric.mem_sphere, dist_eq_norm, hR.le]
    calc
      ‖f z‖ = ‖f (c + (R : ℂ))‖ := congrArg norm (hall (Metric.sphere_subset_closedBall hb)).symm
      _ ≤ M := hbound _ hb
  intro w hw
  exact (hmax hw).trans hzM

/-- A divided difference is analytic at its removable central singularity
and at every other point where the original function is analytic. -/
theorem analyticAt_dslope (f : ℂ → ℂ) (c z : ℂ) (hf : AnalyticAt ℂ f z) :
    AnalyticAt ℂ (dslope f c) z := by
  by_cases hzc : z = c
  · subst z
    obtain ⟨p, hp⟩ := hf
    exact hp.has_fpower_series_dslope_fslope.analyticAt
  · have hq : AnalyticAt ℂ (fun w => (f w - f c) / (w - c)) z :=
      (hf.sub analyticAt_const).div (analyticAt_id.sub analyticAt_const) (sub_ne_zero.mpr hzc)
    apply hq.congr
    filter_upwards [eventually_ne_nhds hzc] with w hw
    rw [dslope_of_ne f hw, slope_def_module, smul_eq_mul]
    ring

/-- Schwarz's divided-difference estimate, stated using the oscillation from
the centre on the boundary. -/
theorem norm_deriv_le_of_sphere_oscillation (f : ℂ → ℂ) (c : ℂ) (R B : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ z ∈ Metric.sphere c R, ‖f z - f c‖ ≤ B) :
    ‖deriv f c‖ ≤ B / R := by
  have hg : AnalyticOnNhd ℂ (dslope f c) (Metric.closedBall c R) :=
    fun z hz => analyticAt_dslope f c z (hf z hz)
  have hb : ∀ z ∈ Metric.sphere c R, ‖dslope f c z‖ ≤ B / R := by
    intro z hz
    have hdist : dist z c = R := hz
    have hne : z ≠ c := by
      intro he
      subst z
      simp only [dist_self] at hdist
      linarith
    rw [dslope_of_ne f hne, slope_def_module, norm_smul, norm_inv,
      ← dist_eq_norm, hdist, mul_comm]
    exact div_le_div_of_nonneg_right (hbound z hz) hR.le
  simpa only [dslope_same] using
    norm_le_of_sphere_bound (dslope f c) c R (B / R) hR hg hb c
      (Metric.mem_closedBall_self hR.le)

/-- A convenient derivative bound from a uniform bound on a closed ball. -/
theorem norm_deriv_le_of_sphere_bound (f : ℂ → ℂ) (c : ℂ) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ z ∈ Metric.sphere c R, ‖f z‖ ≤ M) :
    ‖deriv f c‖ ≤ 2 * M / R := by
  apply norm_deriv_le_of_sphere_oscillation f c R (2 * M) hR hf
  have hc := norm_le_of_sphere_bound f c R M hR hf hbound c
    (Metric.mem_closedBall_self hR.le)
  intro z hz
  calc
    ‖f z - f c‖ ≤ ‖f z‖ + ‖f c‖ := norm_sub_le _ _
    _ ≤ 2 * M := by linarith [hbound z hz]

end
end Source29AnalyticDerivativeBounds

/- Component: AnalyticHigherBounds.inc -/

namespace Source29AnalyticDerivativeBounds

open Filter Set
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Scalar restriction to a complex line gives a directional derivative bound.
The direction need only have norm at most one. -/
theorem norm_fderiv_apply_le (f : E → ℂ) (c : E) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ x ∈ Metric.closedBall c R, ‖f x‖ ≤ M)
    (v : E) (hv : ‖v‖ ≤ 1) :
    ‖fderiv ℂ f c v‖ ≤ 2 * M / R := by
  let g : ℂ → ℂ := fun z => f (c + z • v)
  have hmap : ∀ z ∈ Metric.closedBall (0 : ℂ) R, c + z • v ∈ Metric.closedBall c R := by
    intro z hz
    change dist (c + z • v) c ≤ R
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul]
    calc
      ‖z‖ * ‖v‖ ≤ ‖z‖ * 1 := mul_le_mul_of_nonneg_left hv (norm_nonneg z)
      _ ≤ R := by simpa only [mul_one, Metric.mem_closedBall, dist_zero_right] using hz
  have hg : AnalyticOnNhd ℂ g (Metric.closedBall (0 : ℂ) R) := by
    intro z hz
    have hc : AnalyticAt ℂ (fun _ : ℂ => c) z := analyticAt_const
    have hi : AnalyticAt ℂ (fun a : ℂ => a) z := analyticAt_id
    have hv' : AnalyticAt ℂ (fun _ : ℂ => v) z := analyticAt_const
    have hp : AnalyticAt ℂ (fun a : ℂ => c + a • v) z := by
      convert! hc.add (hi.smul hv') using 1
    exact AnalyticAt.comp (f := fun a : ℂ => c + a • v) (g := f)
      (hf _ (hmap z hz)) hp
  have hgb : ∀ z ∈ Metric.sphere (0 : ℂ) R, ‖g z‖ ≤ M := by
    intro z hz
    exact hbound _ (hmap z (Metric.sphere_subset_closedBall hz))
  have hpath : HasDerivAt (fun z : ℂ => c + z • v) v 0 := by
    convert! ((hasDerivAt_id (0 : ℂ)).smul_const v).const_add c using 1 <;> simp
  have hcomp : HasDerivAt g (fderiv ℂ f c v) 0 := by
    have hd := (hf c (Metric.mem_closedBall_self hR.le)).differentiableAt.hasFDerivAt
    have hd' : HasFDerivAt f (fderiv ℂ f c) (c + (0 : ℂ) • v) := by
      simpa only [zero_smul, add_zero] using hd
    convert! hd'.comp_hasDerivAt 0 hpath using 1
  rw [← hcomp.deriv]
  exact norm_deriv_le_of_sphere_bound g 0 R M hR hg hgb

/-- Applying the first estimate to a directional derivative on a half-radius
ball bounds every mixed second directional derivative. -/
theorem norm_second_fderiv_apply_le (f : E → ℂ) (c : E) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ x ∈ Metric.closedBall c R, ‖f x‖ ≤ M)
    (u v : E) (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) :
    ‖fderiv ℂ (fun x => fderiv ℂ f x v) c u‖ ≤ 16 * M / R ^ 2 := by
  have hhalf : 0 < R / 2 := half_pos hR
  have hsub : ∀ z ∈ Metric.closedBall c (R / 2),
      Metric.closedBall z (R / 2) ⊆ Metric.closedBall c R := by
    intro z hz x hx
    change dist x c ≤ R
    have h1 : dist x z ≤ R / 2 := hx
    have h2 : dist z c ≤ R / 2 := hz
    linarith [dist_triangle x z c]
  have hcenter : Metric.closedBall c (R / 2) ⊆ Metric.closedBall c R := by
    intro z hz
    have hh : dist z c ≤ R / 2 := hz
    change dist z c ≤ R
    linarith
  let g : E → ℂ := fun x => fderiv ℂ f x v
  have hg : AnalyticOnNhd ℂ g (Metric.closedBall c (R / 2)) := by
    intro x hx
    have he : AnalyticAt ℂ (fun L : E →L[ℂ] ℂ => L v) (fderiv ℂ f x) :=
      (ContinuousLinearMap.apply ℂ ℂ v).analyticAt _
    exact AnalyticAt.comp (f := fderiv ℂ f) (g := fun L : E →L[ℂ] ℂ => L v)
      he (hf x (hcenter hx)).fderiv
  have hgb : ∀ x ∈ Metric.closedBall c (R / 2), ‖g x‖ ≤ 4 * M / R := by
    intro x hx
    have hh := norm_fderiv_apply_le f x (R / 2) M hhalf
      (hf.mono (hsub x hx)) (fun z hz => hbound z (hsub x hx hz)) v hv
    convert hh using 1 <;> ring
  have hh := norm_fderiv_apply_le g c (R / 2) (4 * M / R) hhalf hg hgb u hu
  convert hh using 1 <;> ring

/-- The scalar second derivative is a special case of the mixed bound. -/
theorem norm_deriv_deriv_le (f : ℂ → ℂ) (c : ℂ) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ x ∈ Metric.closedBall c R, ‖f x‖ ≤ M) :
    ‖deriv (deriv f) c‖ ≤ 16 * M / R ^ 2 := by
  convert! norm_second_fderiv_apply_le f c R M hR hf hbound (1 : ℂ) 1
      (by simp) (by simp) using 1

end
end Source29AnalyticDerivativeBounds

/- Component: AnalyticScaledBounds.inc -/

namespace Source29AnalyticDerivativeBounds

open Filter Set
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The mixed bound also applies directly to the iterated Fréchet derivative. -/
theorem norm_iterated_fderiv_apply_le (f : E → ℂ) (c : E) (R M : ℝ)
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (Metric.closedBall c R))
    (hbound : ∀ x ∈ Metric.closedBall c R, ‖f x‖ ≤ M)
    (u v : E) (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) :
    ‖fderiv ℂ (fderiv ℂ f) c u v‖ ≤ 16 * M / R ^ 2 := by
  have hd := (hf c (Metric.mem_closedBall_self hR.le)).fderiv.differentiableAt.hasFDerivAt
  have heval := (ContinuousLinearMap.apply ℂ ℂ v).hasFDerivAt.comp c hd
  have heq : fderiv ℂ (fun x => fderiv ℂ f x v) c u =
      fderiv ℂ (fderiv ℂ f) c u v := by
    exact congrArg (fun L : E →L[ℂ] ℂ => L u) heval.fderiv
  rw [← heq]
  exact norm_second_fderiv_apply_le f c R M hR hf hbound u v hu hv

/-- A quadratic bound on a ball whose radius is linear in a positive scale
implies linear first derivative bounds and bounded second derivatives. -/
theorem directional_bounds_scaled_ball (f : E → ℂ) (c : E) (ε M t : ℝ)
    (hε : 0 < ε) (ht : 0 < t)
    (hf : AnalyticOnNhd ℂ f (Metric.closedBall c (ε * t)))
    (hbound : ∀ x ∈ Metric.closedBall c (ε * t), ‖f x‖ ≤ M * t ^ 2)
    (u v : E) (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) :
    ‖fderiv ℂ f c u‖ ≤ (2 * M / ε) * t ∧
      ‖fderiv ℂ (fderiv ℂ f) c u v‖ ≤ 16 * M / ε ^ 2 := by
  have hR : 0 < ε * t := mul_pos hε ht
  constructor
  · have hh := norm_fderiv_apply_le f c (ε * t) (M * t ^ 2) hR hf hbound u hu
    have he : 2 * (M * t ^ 2) / (ε * t) = (2 * M / ε) * t := by
      field_simp [hε.ne', ht.ne']
      <;> ring
    rwa [he] at hh
  · have hh := norm_iterated_fderiv_apply_le f c (ε * t) (M * t ^ 2) hR hf hbound u v hu hv
    have he : 16 * (M * t ^ 2) / (ε * t) ^ 2 = 16 * M / ε ^ 2 := by
      field_simp [hε.ne', ht.ne']
      <;> ring
    rwa [he] at hh

end
end Source29AnalyticDerivativeBounds

/- Component: AnalyticFamilyBounds.inc -/

namespace Source29AnalyticDerivativeBounds

open Filter Set
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {α : Type*} {l : Filter α}

/-- No regularity of the root labels in the external scale parameter is needed:
analyticity on each shrinking ball and a common quadratic bound suffice. -/
theorem scaled_family_derivative_limits (f : α → E → ℂ) (c : α → E)
    (scale : α → ℝ) (ε M : ℝ) (hε : 0 < ε)
    (hscale : Tendsto scale l (𝓝 0))
    (hpos : ∀ᶠ a in l, 0 < scale a)
    (hf : ∀ᶠ a in l, AnalyticOnNhd ℂ (f a) (Metric.closedBall (c a) (ε * scale a)))
    (hbound : ∀ᶠ a in l, ∀ x ∈ Metric.closedBall (c a) (ε * scale a),
      ‖f a x‖ ≤ M * scale a ^ 2)
    (u v : E) (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) :
    Tendsto (fun a => fderiv ℂ (f a) (c a) u) l (𝓝 0) ∧
      ∀ᶠ a in l, ‖fderiv ℂ (fderiv ℂ (f a)) (c a) u v‖ ≤ 16 * M / ε ^ 2 := by
  have hb : ∀ᶠ a in l,
      ‖fderiv ℂ (f a) (c a) u‖ ≤ (2 * M / ε) * scale a ∧
      ‖fderiv ℂ (fderiv ℂ (f a)) (c a) u v‖ ≤ 16 * M / ε ^ 2 := by
    filter_upwards [hpos, hf, hbound] with a ha hfa hba
    exact directional_bounds_scaled_ball (f a) (c a) ε M (scale a)
      hε ha hfa hba u v hu hv
  constructor
  · apply squeeze_zero_norm' (hb.mono fun _ ha => ha.1)
    simpa using (tendsto_const_nhds (x := 2 * M / ε) (f := l)).mul hscale
  · exact hb.mono fun _ ha => ha.2

end
end Source29AnalyticDerivativeBounds

/- Component: GraphTraceLimit.inc -/
/- Passing from the graph PDE to the trace limit uses only a vanishing
first derivative and bounded second derivatives. -/
namespace Source29GraphTraceLimit

open Filter Source29MetricJet
open scoped Topology BigOperators

noncomputable section

variable {α ι : Type*} [Fintype ι] {l : Filter α}

lemma bounded_mul_tendsto_zero (a b : α → ℂ) (C : ℝ)
    (ha : ∀ᶠ x in l, ‖a x‖ ≤ C) (hb : Tendsto b l (𝓝 0)) :
    Tendsto (fun x => a x * b x) l (𝓝 0) := by
  have hbound : ∀ᶠ x in l, ‖a x * b x‖ ≤ C * ‖b x‖ := by
    filter_upwards [ha] with x hx
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right hx (norm_nonneg _)
  apply squeeze_zero_norm' hbound
  simpa using (tendsto_const_nhds (x := C) (f := l)).mul hb.norm

lemma metricPair_tendsto_zero (M : ι → ι → ℂ) (g : α → ι → ℂ)
    (hg : ∀ i, Tendsto (fun x => g x i) l (𝓝 0)) :
    Tendsto (fun x => metricPair M (g x) (g x)) l (𝓝 0) := by
  unfold metricPair
  have ht (i j : ι) : Tendsto (fun x => M i j * g x i * g x j) l (𝓝 0) := by
    simpa using ((tendsto_const_nhds (x := M i j) (f := l)).mul (hg i)).mul (hg j)
  simpa using tendsto_finsetSum Finset.univ (fun i _ =>
    tendsto_finsetSum Finset.univ (fun j _ => ht i j))

lemma raiseIndex_tendsto_zero (M : ι → ι → ℂ) (g : α → ι → ℂ)
    (hg : ∀ i, Tendsto (fun x => g x i) l (𝓝 0)) (i : ι) :
    Tendsto (fun x => raiseIndex M (g x) i) l (𝓝 0) := by
  unfold raiseIndex
  simpa using tendsto_finsetSum Finset.univ (fun j _ => tendsto_const_nhds.mul (hg j))

lemma bounded_contract_tendsto_zero (H : α → ι → ι → ℂ)
    (v : α → ι → ℂ)
    (hH : ∀ i j, ∃ C : ℝ, ∀ᶠ x in l, ‖H x i j‖ ≤ C)
    (hv : ∀ i, Tendsto (fun x => v x i) l (𝓝 0)) :
    Tendsto (fun x => contract (H x) (v x) (v x)) l (𝓝 0) := by
  have ht (i j : ι) : Tendsto (fun x => H x i j * v x i * v x j) l (𝓝 0) := by
    obtain ⟨C, hC⟩ := hH i j
    have hh := bounded_mul_tendsto_zero (fun x => H x i j)
      (fun x => v x i * v x j) C hC (by simpa using (hv i).mul (hv j))
    simpa only [mul_assoc] using hh
  simpa only [contract, Finset.sum_const_zero] using
    tendsto_finsetSum Finset.univ (fun i _ =>
      tendsto_finsetSum Finset.univ (fun j _ => ht i j))

lemma vanishing_mul_metricTrace (M : ι → ι → ℂ) (H : α → ι → ι → ℂ)
    (a : α → ℂ) (ha : Tendsto a l (𝓝 0))
    (hH : ∀ i j, ∃ C : ℝ, ∀ᶠ x in l, ‖H x i j‖ ≤ C) :
    Tendsto (fun x => a x * metricTrace M (H x)) l (𝓝 0) := by
  have ht (i j : ι) : Tendsto (fun x => a x * (M i j * H x i j)) l (𝓝 0) := by
    obtain ⟨C, hC⟩ := hH i j
    have hh := bounded_mul_tendsto_zero (fun x => H x i j)
      (fun x => a x * M i j) C hC (by simpa using ha.mul tendsto_const_nhds)
    convert hh using 1 <;> ext x <;> ring
  simpa only [metricTrace, Finset.mul_sum, Finset.sum_const_zero] using
    tendsto_finsetSum Finset.univ (fun i _ =>
      tendsto_finsetSum Finset.univ (fun j _ => ht i j))

/-- The graph PDE forces its metric trace to vanish in the limit, even when
the individual Hessian entries have no limit. -/
theorem metricTrace_tendsto_zero (M : ι → ι → ℂ) (c : ℂ)
    (g : α → ι → ℂ) (H : α → ι → ι → ℂ)
    (hg : ∀ i, Tendsto (fun x => g x i) l (𝓝 0))
    (hH : ∀ i j, ∃ C : ℝ, ∀ᶠ x in l, ‖H x i j‖ ≤ C)
    (hPDE : ∀ᶠ x in l,
      (1+c*metricPair M (g x) (g x))*metricTrace M (H x) -
        c*contract (H x) (raiseIndex M (g x)) (raiseIndex M (g x)) = 0) :
    Tendsto (fun x => metricTrace M (H x)) l (𝓝 0) := by
  have hA := metricPair_tendsto_zero M g hg
  have hB := bounded_contract_tendsto_zero H (fun x => raiseIndex M (g x))
    hH (raiseIndex_tendsto_zero M g hg)
  have hAT := vanishing_mul_metricTrace M H _ hA hH
  have ht : Tendsto (fun x => c*contract (H x) (raiseIndex M (g x))
      (raiseIndex M (g x)) - c*(metricPair M (g x) (g x)*metricTrace M (H x)))
      l (𝓝 0) := by
    simpa using (tendsto_const_nhds.mul hB).sub (tendsto_const_nhds.mul hAT)
  apply ht.congr'
  filter_upwards [hPDE] with x hx
  linear_combination -hx

/-- A continuous trace of a finite sheet mean is zero at the limiting point
once each sheet satisfies the PDE and derivative bounds. -/
theorem sum_trace_limit_eq_zero {σ : Type*} [Fintype σ] [NeBot l]
    (M : ι → ι → ℂ) (c : ℂ)
    (g : σ → α → ι → ℂ) (H : σ → α → ι → ι → ℂ)
    (hg : ∀ j i, Tendsto (fun x => g j x i) l (𝓝 0))
    (hH : ∀ j i k, ∃ C : ℝ, ∀ᶠ x in l, ‖H j x i k‖ ≤ C)
    (hPDE : ∀ j, ∀ᶠ x in l,
      (1+c*metricPair M (g j x) (g j x))*metricTrace M (H j x) -
        c*contract (H j x) (raiseIndex M (g j x)) (raiseIndex M (g j x)) = 0)
    (L : ℂ) (hL : Tendsto (fun x => ∑ j, metricTrace M (H j x)) l (𝓝 L)) :
    L = 0 := by
  have hz : Tendsto (fun x => ∑ j, metricTrace M (H j x)) l (𝓝 0) := by
    simpa using tendsto_finsetSum Finset.univ
      (fun j _ => metricTrace_tendsto_zero M c (g j) (H j) (hg j) (hH j) (hPDE j))
  exact tendsto_nhds_unique hL hz

end
end Source29GraphTraceLimit

/- Component: WholeSliceBezout.lean -/

namespace Source29WholeSliceBezout

open Polynomial

noncomputable section

/-- Clearing denominators of a fraction-field Bezout identity yields a
nonzero constant-polynomial certificate over the coefficient domain. -/
theorem exists_nonzero_bezout_of_fraction_coprime
    {R : Type*} [CommRing R] [IsDomain R]
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
    (p q : R[X])
    (h : IsCoprime (p.map (algebraMap R K)) (q.map (algebraMap R K))) :
    ∃ (D : R) (A B : R[X]), D ≠ 0 ∧ A*p+B*q = C D := by
  obtain ⟨a,b,hab⟩ := h
  obtain ⟨c,hc,hca⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) a
  obtain ⟨d,hd,hdb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) b
  let A := C d * IsLocalization.integerNormalization (nonZeroDivisors R) a
  let B := C c * IsLocalization.integerNormalization (nonZeroDivisors R) b
  refine ⟨c*d, A, B, mul_ne_zero (nonZeroDivisors.ne_zero hc)
    (nonZeroDivisors.ne_zero hd), ?_⟩
  apply Polynomial.map_injective (algebraMap R K) (IsFractionRing.injective R K)
  rw [Algebra.smul_def, Polynomial.algebraMap_apply] at hca hdb
  simp only [A, B, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
    hca, hdb, map_mul]
  calc
    _ = C (algebraMap R K c) * C (algebraMap R K d) *
        (a * p.map (algebraMap R K) + b * q.map (algebraMap R K)) := by ring
    _ = C (algebraMap R K c) * C (algebraMap R K d) := by rw [hab, mul_one]

/-- A nonconstant irreducible polynomial over a GCD domain has a nonzero
coefficient-domain certificate for its polynomial and derivative. -/
theorem exists_nonzero_bezout_of_irreducible
    {R : Type*} [CommRing R] [IsDomain R] [IsGCDMonoid R]
    (K : Type*) [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    (p : R[X]) (hp : Irreducible p) (hdegree : p.natDegree ≠ 0) :
    ∃ (D : R) (A B : R[X]), D ≠ 0 ∧ A*p+B*p.derivative = C D := by
  have hpK : Irreducible (p.map (algebraMap R K)) :=
    (hp.isPrimitive hdegree).irreducible_iff_irreducible_map_fraction_map.mp hp
  apply exists_nonzero_bezout_of_fraction_coprime K p p.derivative
  simpa only [Polynomial.Separable, ← Polynomial.derivative_map] using hpK.separable

/-- Away from the certificate's zero locus, specialization preserves
separability of the whole polynomial slice. -/
theorem separable_map_of_bezout
    {R : Type*} [CommRing R] {F : Type*} [Field F]
    (p : R[X]) (D : R) (A B : R[X]) (h : A*p+B*p.derivative = C D)
    (f : R →+* F) (hD : f D ≠ 0) : (p.map f).Separable := by
  have hm := congrArg (Polynomial.map f) h
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C] at hm
  refine ⟨C ((f D)⁻¹)*A.map f, C ((f D)⁻¹)*B.map f, ?_⟩
  rw [Polynomial.derivative_map]
  calc
    _ = C ((f D)⁻¹)*(A.map f*p.map f+B.map f*p.derivative.map f) := by ring
    _ = 1 := by rw [hm, ← C_mul, inv_mul_cancel₀ hD, C_1]

/-- Every local factor is simple wherever the whole specialized slice is
certified simple; no analytic reduced-germ theorem is involved. -/
theorem separable_factor_of_bezout
    {R : Type*} [CommRing R] {F : Type*} [Field F]
    (p : R[X]) (D : R) (A B : R[X]) (h : A*p+B*p.derivative = C D)
    (f : R →+* F) (hD : f D ≠ 0)
    (W U : F[X]) (hWU : p.map f = W*U) : W.Separable :=
  (separable_map_of_bezout p D A B h f hD).of_dvd ⟨U,hWU⟩

/-- Every root of the local factor has nonzero derivative away from the
exceptional polynomial. -/
theorem factor_root_derivative_ne_zero
    {R : Type*} [CommRing R] {F : Type*} [Field F]
    (p : R[X]) (D : R) (A B : R[X]) (h : A*p+B*p.derivative = C D)
    (f : R →+* F) (hD : f D ≠ 0)
    (W U : F[X]) (hWU : p.map f = W*U) (w : F) (hw : W.eval w = 0) :
    W.derivative.eval w ≠ 0 := by
  have hs := separable_factor_of_bezout p D A B h f hD W U hWU
  simpa only [Polynomial.eval₂_id] using hs.eval₂_derivative_ne_zero (RingHom.id F)
    (by simpa only [Polynomial.eval₂_id] using hw)

/-- In polynomial parameter space the exceptional certificate is itself a
nonzero multivariate polynomial. -/
theorem exists_exceptional_polynomial {n : ℕ}
    (p : Polynomial (MvPolynomial (Fin n) ℂ)) (hp : Irreducible p)
    (hdegree : p.natDegree ≠ 0) :
    ∃ (D : MvPolynomial (Fin n) ℂ) (A B : Polynomial (MvPolynomial (Fin n) ℂ)),
      D ≠ 0 ∧ A*p+B*p.derivative = C D :=
  exists_nonzero_bezout_of_irreducible (FractionRing (MvPolynomial (Fin n) ℂ)) p hp hdegree

end
end Source29WholeSliceBezout

/- Component: AffinePolynomialChart.lean -/

namespace Source29AffinePolynomialChart

open MvPolynomial
open scoped BigOperators

noncomputable section

abbrev Vec (n : ℕ) := Fin n → ℂ
abbrev Poly (n : ℕ) := MvPolynomial (Fin n) ℂ

/-- Finite-variable polynomial extensionality over the complex numbers.
This is the finite-variable induction underlying mathlib's MvPolynomial.Funext,
whose general theorem is outside the permitted import closure. -/
theorem eq_of_eval_eq {n : ℕ} (P Q : Poly n)
    (h : ∀ x : Vec n, eval x P = eval x Q) : P = Q := by
  induction n with
  | zero =>
    apply (MvPolynomial.isEmptyRingEquiv ℂ (Fin 0)).injective
    simpa only [isEmptyRingEquiv_eq_coeff_zero, eval_zero, constantCoeff_eq] using h 0
  | succ n ih =>
    apply (finSuccEquiv ℂ n).injective
    apply Polynomial.ext
    intro k
    apply ih
    intro x
    have hx : Polynomial.map (eval x) (finSuccEquiv ℂ n P) =
        Polynomial.map (eval x) (finSuccEquiv ℂ n Q) := by
      apply Polynomial.funext
      intro t
      rw [← eval_eq_eval_mv_eval', ← eval_eq_eval_mv_eval']
      exact h (Fin.cons t x)
    simpa only [Polynomial.coeff_map] using
      congrArg (fun p : Polynomial ℂ => p.coeff k) hx

/-- Polynomial for one coordinate of a linear transformation. -/
def linearCoordinate {n : ℕ} (A : Vec n →ₗ[ℂ] Vec n) (i : Fin n) : Poly n :=
  ∑ j, C (A (Pi.single j 1) i) * X j

theorem eval_linearCoordinate {n : ℕ} (A : Vec n →ₗ[ℂ] Vec n)
    (i : Fin n) (x : Vec n) : eval x (linearCoordinate A i) = A x i := by
  simp only [linearCoordinate, map_sum, map_mul, eval_C, eval_X]
  conv_rhs => rw [pi_eq_sum_univ' x]
  simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- Pull a polynomial back by the affine map x ↦ z+A x. -/
def affinePullback {n : ℕ} (A : Vec n →ₗ[ℂ] Vec n) (z : Vec n) :
    Poly n →ₐ[ℂ] Poly n :=
  aeval (fun i => C (z i) + linearCoordinate A i)

lemma affinePullback_X {n : ℕ} (A : Vec n →ₗ[ℂ] Vec n) (z : Vec n) (i : Fin n) :
    affinePullback A z (X i) = C (z i) + linearCoordinate A i := by
  simp [affinePullback]

theorem eval_affinePullback {n : ℕ} (A : Vec n →ₗ[ℂ] Vec n)
    (z x : Vec n) (P : Poly n) :
    eval x (affinePullback A z P) = eval (z+A x) P := by
  induction P using MvPolynomial.induction_on with
  | C c => simp [affinePullback]
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, affinePullback_X, map_add, eval_C, eval_linearCoordinate, eval_X,
      Pi.add_apply, hp]

theorem affinePullback_inverse_left {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n)
    (z : Vec n) (P : Poly n) :
    affinePullback A.symm.toLinearMap (-A.symm z) (affinePullback A.toLinearMap z P) = P := by
  apply eq_of_eval_eq
  intro x
  rw [eval_affinePullback, eval_affinePullback]
  simp

theorem affinePullback_inverse_right {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n)
    (z : Vec n) (P : Poly n) :
    affinePullback A.toLinearMap z (affinePullback A.symm.toLinearMap (-A.symm z) P) = P := by
  apply eq_of_eval_eq
  intro x
  rw [eval_affinePullback, eval_affinePullback]
  simp

/-- Invertible affine changes of variables act by algebra equivalences. -/
def affineEquiv {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n) (z : Vec n) : Poly n ≃ₐ[ℂ] Poly n :=
  AlgEquiv.ofAlgHom (affinePullback A.toLinearMap z)
    (affinePullback A.symm.toLinearMap (-A.symm z))
    (by apply DFunLike.ext; intro P; exact affinePullback_inverse_right A z P)
    (by apply DFunLike.ext; intro P; exact affinePullback_inverse_left A z P)

lemma affineEquiv_apply {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n) (z : Vec n) (P : Poly n) :
    affineEquiv A z P = affinePullback A.toLinearMap z P := rfl

lemma affineEquiv_symm_apply {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n) (z : Vec n) (P : Poly n) :
    (affineEquiv A z).symm P = affinePullback A.symm.toLinearMap (-A.symm z) P := rfl

theorem affine_irreducible {n : ℕ} (A : Vec n ≃ₗ[ℂ] Vec n) (z : Vec n)
    (P : Poly n) (hP : Irreducible P) : Irreducible (affineEquiv A z P) :=
  (MulEquiv.irreducible_iff (affineEquiv A z)).mpr hP

/-- First change coordinates, then distinguish the zeroth coordinate as the
univariate polynomial variable. There remain n parameter variables. -/
def curriedChart {n : ℕ} (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1)) (z : Vec (n+1)) :
    Poly (n+1) ≃ₐ[ℂ] Polynomial (Poly n) :=
  (affineEquiv A z).trans (finSuccEquiv ℂ n)

lemma curriedChart_apply {n : ℕ} (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) :
    curriedChart A z P = finSuccEquiv ℂ n (affinePullback A.toLinearMap z P) := rfl

theorem curried_irreducible {n : ℕ} (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) (hP : Irreducible P) :
    Irreducible (curriedChart A z P) :=
  (MulEquiv.irreducible_iff (curriedChart A z)).mpr hP

theorem eval_curriedChart {n : ℕ} (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1))
    (z : Vec (n+1)) (P : Poly (n+1)) (ζ : Vec n) (w : ℂ) :
    Polynomial.eval w (Polynomial.map (eval ζ) (curriedChart A z P)) =
      eval (z+A (Fin.cons w ζ)) P := by
  rw [curriedChart_apply, ← eval_eq_eval_mv_eval', eval_affinePullback]
  rfl

/-- A positive-order root in a specialization ensures positive degree in
the distinguished variable before specialization. -/
theorem natDegree_ne_zero_of_specialization_factor
    {R F : Type*} [Semiring R] [Semiring F] [Nontrivial F]
    (p : Polynomial R) (f : R →+* F) (s : ℕ) (hs : 0 < s) (g : Polynomial F)
    (hg : g.coeff 0 ≠ 0) (hp : p.map f = Polynomial.X^s*g) : p.natDegree ≠ 0 := by
  have hc : (p.map f).coeff s ≠ 0 := by
    rw [hp]
    have hcs : (Polynomial.X^s*g).coeff s = g.coeff 0 := by
      simpa only [zero_add] using Polynomial.coeff_X_pow_mul g s 0
    rw [hcs]
    exact hg
  have hle := (Polynomial.le_natDegree_of_ne_zero hc).trans Polynomial.natDegree_map_le
  omega

end
end Source29AffinePolynomialChart

/- Component: AffinePolynomialChartSlice.inc -/

namespace Source29AffinePolynomialChart

open MvPolynomial Source29SlicePolynomial Source29PolynomialTranslation

noncomputable section

theorem cons_split {n : ℕ} (w : ℂ) (ζ : Vec n) :
    Fin.cons w ζ = Fin.cons 0 ζ + w • Fin.cons 1 (0 : Vec n) := by
  funext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp

/-- Specializing the parameter coefficients of the curried chart gives the
actual affine line through z+A(0,zeta) in direction A(1,0). -/
theorem specialize_curriedChart_eq_lineSlice {n : ℕ}
    (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1)) (z : Vec (n+1)) (P : Poly (n+1)) (ζ : Vec n) :
    Polynomial.map (eval ζ) (curriedChart A z P) =
      lineSlice P (z+A (Fin.cons 0 ζ)) (A (Fin.cons 1 (0 : Vec n))) := by
  apply Polynomial.funext
  intro w
  rw [eval_curriedChart, eval_lineSlice, cons_split, map_add, map_smul]
  apply congrArg (fun x : Vec (n+1) => eval x P)
  funext i
  simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_assoc]

theorem lineSlice_translate {n : ℕ} (P : Poly n) (z v N : Vec n) :
    lineSlice (translate P z) v N = lineSlice P (z+v) N := by
  apply Polynomial.funext
  intro w
  rw [eval_lineSlice, eval_lineSlice, eval_translate]
  apply congrArg (fun x : Vec n => eval x P)
  funext i
  simp [Pi.add_apply, add_assoc]

theorem specialize_zero_eq_translatedSlice {n : ℕ}
    (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1)) (z : Vec (n+1)) (P : Poly (n+1)) :
    Polynomial.map (eval (0 : Vec n)) (curriedChart A z P) =
      lineSlice (translate P z) 0 (A (Fin.cons 1 (0 : Vec n))) := by
  rw [specialize_curriedChart_eq_lineSlice, lineSlice_translate]
  have h0 : (Fin.cons 0 (0 : Vec n) : Vec (n+1)) = 0 := by
    funext i
    exact Fin.cases rfl (fun _ => rfl) i
  simp only [h0, map_zero, add_zero]

/-- An irreducible polynomial and an invertible affine chart produce a
nonzero exceptional parameter polynomial once the normal slice has positive
order. This instantiates the whole-slice Bezout certificate for the chart. -/
theorem exists_chart_exceptional_polynomial {n : ℕ}
    (A : Vec (n+1) ≃ₗ[ℂ] Vec (n+1)) (z : Vec (n+1)) (P : Poly (n+1))
    (hP : Irreducible P) (s : ℕ) (hs : 0 < s) (g : Polynomial ℂ)
    (hg : g.coeff 0 ≠ 0)
    (hbase : lineSlice (translate P z) 0 (A (Fin.cons 1 (0 : Vec n))) = Polynomial.X^s*g) :
    ∃ (D : Poly n) (B C : Polynomial (Poly n)), D ≠ 0 ∧
      B*curriedChart A z P+C*(curriedChart A z P).derivative = Polynomial.C D := by
  apply Source29WholeSliceBezout.exists_exceptional_polynomial
    (curriedChart A z P) (curried_irreducible A z P hP)
  apply natDegree_ne_zero_of_specialization_factor
    (curriedChart A z P) (eval (0 : Vec n)) s hs g hg
  rw [specialize_zero_eq_translatedSlice, hbase]

end
end Source29AffinePolynomialChart

/- Component: PolynomialNonvanishingCone.inc -/

/- A polynomial is uniformly nonzero in a sufficiently narrow cone around any
ray where its first nonzero homogeneous component is nonzero. The rescaling is
polynomial in the scale variable, including at scale zero. -/
namespace Source29PolynomialNonvanishingCone

open MvPolynomial Filter Finset
open scoped Topology

noncomputable section

abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

/-- Nonvanishing of the initial homogeneous form in one direction persists on
closed balls of radius proportional to the distance along that ray. -/
theorem nonzero_on_shrinking_balls_of_initial {n : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (d : ℕ)
    (hd : d ≤ P.totalDegree)
    (hlow : ∀ k < d, homogeneousComponent k P = 0)
    (v : CSpace n) (hv : eval (fun i => v i) (homogeneousComponent d P) ≠ 0) :
    ∃ ε δ : ℝ, 0 < ε ∧ 0 < δ ∧ ∀ t : ℝ, 0 < t → t < δ →
      ∀ x : CSpace n, ‖x - (t : ℂ) • v‖ ≤ ε * t →
        eval (fun i => x i) P ≠ 0 := by
  let F : ℂ × CSpace n → ℂ := fun p =>
    eval (fun i => p.2 i) (Source29LowestRescale.rescale P d p.1)
  have hF : Continuous F := Source29SmallSlope.continuous_eval_rescale_joint P d
  have hF0 : F (0, v) ≠ 0 := by
    simpa only [F, Source29LowestRescale.rescale_zero P d hd hlow] using hv
  have hevent : ∀ᶠ p in 𝓝 (0, v), F p ≠ 0 := hF.continuousAt.eventually_ne hF0
  obtain ⟨r, hr, hrF⟩ := Metric.mem_nhds_iff.mp hevent
  refine ⟨r / 2, r / 2, half_pos hr, half_pos hr, ?_⟩
  intro t ht htδ x hx
  have htne : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  have htnorm : ‖(t : ℂ)‖ = t := by simp [ht.le]
  let y : CSpace n := (t : ℂ)⁻¹ • x
  have hdiff : y - v = (t : ℂ)⁻¹ • (x - (t : ℂ) • v) := by
    simp only [y, smul_sub, smul_smul, inv_mul_cancel₀ htne, one_smul]
  have hy : ‖y - v‖ ≤ r / 2 := by
    rw [hdiff, norm_smul, norm_inv, htnorm]
    calc
      t⁻¹ * ‖x - (t : ℂ) • v‖ ≤ t⁻¹ * (r / 2 * t) :=
        mul_le_mul_of_nonneg_left hx (inv_nonneg.mpr ht.le)
      _ = r / 2 := by field_simp
  have hpair : ((t : ℂ), y) ∈ Metric.ball (0, v) r := by
    simp only [Metric.mem_ball, Prod.dist_eq, dist_zero_right, max_lt_iff, htnorm]
    exact ⟨lt_trans htδ (by linarith), lt_of_le_of_lt (by simpa [dist_eq_norm] using hy) (by linarith)⟩
  have hres : F ((t : ℂ), y) ≠ 0 := hrF hpair
  have hxy : (fun i => (t : ℂ) * y i) = (fun i => x i) := by
    funext i
    simp [y, htne]
  have heval := Source29LowestRescale.eval_rescale_mul P d hlow (t : ℂ) (fun i => y i)
  rw [hxy] at heval
  rw [← heval]
  exact mul_ne_zero (pow_ne_zero d htne) hres

/-- A nonzero polynomial has some initial form and direction to which the
shrinking-ball nonvanishing result applies, including the constant-term case. -/
theorem exists_nonzero_shrinking_balls {n : ℕ}
    (P : MvPolynomial (Fin n) ℂ) (hP : P ≠ 0) :
    ∃ v : CSpace n, ∃ ε δ : ℝ, 0 < ε ∧ 0 < δ ∧
      ∀ t : ℝ, 0 < t → t < δ → ∀ x : CSpace n,
        ‖x - (t : ℂ) • v‖ ≤ ε * t → eval (fun i => x i) P ≠ 0 := by
  have hex : ∃ d : ℕ, homogeneousComponent d P ≠ 0 := by
    by_contra h
    push Not at h
    apply hP
    rw [← sum_homogeneousComponent P]
    simp only [h, Finset.sum_const_zero]
  let d := Nat.find hex
  have hdne : homogeneousComponent d P ≠ 0 := Nat.find_spec hex
  have hlow : ∀ k < d, homogeneousComponent k P = 0 := by
    intro k hk
    exact not_not.mp (Nat.find_min hex hk)
  have hd : d ≤ P.totalDegree := by
    by_contra h
    exact hdne (homogeneousComponent_eq_zero d P (by omega))
  have hv : ∃ v : CSpace n, eval (fun i => v i) (homogeneousComponent d P) ≠ 0 := by
    by_contra h
    push Not at h
    apply hdne
    apply (homogeneousComponent_isHomogeneous d P).eq_zero_of_forall_eval_eq_zero
    intro x
    simpa only [PiLp.toLp_apply] using h (WithLp.toLp 2 x)
  obtain ⟨v, hv⟩ := hv
  obtain ⟨ε, δ, hε, hδ, hb⟩ := nonzero_on_shrinking_balls_of_initial P d hd hlow v hv
  exact ⟨v, ε, δ, hε, hδ, hb⟩

end
end Source29PolynomialNonvanishingCone

/- Component: TransverseTraceBound.inc -/
/- A real transverse path suffices for the final trace contradiction. -/

namespace Source29TransverseTraceBound

open Filter Finset
open scoped Topology

noncomputable section

def mean {ι : Type*} [Fintype ι] (w : ι → ℂ) : ℂ :=
  (∑ j, w j) / ((Fintype.card ι : ℝ) : ℂ)

lemma mean_ratio_real {ι : Type*} [Fintype ι] (w : ι → ℂ) (c t : ℝ) :
    2 * ((c : ℂ) * (mean w / ((t^2 : ℝ) : ℂ))).re =
      (∑ j, 2 * ((c : ℂ) * w j).re / t^2) / (Fintype.card ι : ℝ) := by
  simp only [mean, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero, Complex.div_ofReal_re, Complex.re_sum,
    ← Finset.sum_div, ← Finset.mul_sum]
  ring

/-- Exact transverse maximum algebra; the remainder is bounded by a fourth
power using only the quadratic root bound. -/
lemma transverse_scalar_bound (κ b A t : ℝ) (w : ℂ)
    (hb : 0 ≤ b) (hA : 0 ≤ A) (hroot : ‖w‖ ≤ A * t^2)
    (hmax : κ + t^2 + (((-b : ℝ) : ℂ) * w^2).re ≤
      κ + κ*t^2 + 2*b*w.re + b*‖w‖^2) :
    2 * (((-b : ℝ) : ℂ) * w).re ≤ (κ - 1)*t^2 + 2*b*A^2*t^4 := by
  have hsq := (sq_le_sq₀ (norm_nonneg w) (mul_nonneg hA (sq_nonneg t))).mpr hroot
  have hre : w.re^2 ≤ A^2*t^4 := by
    rw [Complex.sq_norm, Complex.normSq_apply] at hsq
    nlinarith [sq_nonneg w.im]
  have hbr := mul_le_mul_of_nonneg_left hre (by positivity : 0 ≤ 2*b)
  rw [Complex.sq_norm, Complex.normSq_apply] at hmax
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    pow_two] at hmax ⊢
  nlinarith

/-- Taking the average and the real limit produces the desired diagonal
second-derivative inequality. No complex-phase limit is required. -/
theorem transverse_mean_limit {ι : Type*} [Fintype ι] [Nonempty ι]
    (w : ℝ → ι → ℂ) (κ A : ℝ) (hκ : 0 ≤ κ) (hκ1 : κ < 1) (hA : 0 ≤ A)
    (hroot : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ j, ‖w t j‖ ≤ A*t^2)
    (hmax : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ j,
      κ + t^2 + (((-κ*(1-κ^2) : ℝ) : ℂ) * (w t j)^2).re ≤
        κ * (1 + t^2 + 2*(1-κ^2)*(w t j).re + (1-κ^2)*‖w t j‖^2))
    (μ : ℂ)
    (hmean : Tendsto (fun t : ℝ => mean (w t) / ((t^2 : ℝ) : ℂ))
      (𝓝[≠] (0 : ℝ)) (𝓝 (μ / 2))) :
    (((-κ*(1-κ^2) : ℝ) : ℂ) * μ).re ≤ κ - 1 := by
  let b : ℝ := κ*(1-κ^2)
  have hb : 0 ≤ b := by dsimp [b]; nlinarith
  have hm : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.mpr Fintype.card_pos
  have hevent : ∀ᶠ t in 𝓝[≠] (0 : ℝ),
      2 * (((-b : ℝ) : ℂ) * (mean (w t) / ((t^2 : ℝ) : ℂ))).re ≤
        κ - 1 + 2*b*A^2*t^2 := by
    filter_upwards [hroot.filter_mono nhdsWithin_le_nhds,
      hmax.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t hr hx ht
    have ht0 : t ≠ 0 := by simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using ht
    have ht2 : 0 < t^2 := sq_pos_of_ne_zero ht0
    have hpoint (j : ι) : 2 * (((-b : ℝ) : ℂ) * w t j).re / t^2 ≤
        κ - 1 + 2*b*A^2*t^2 := by
      have hmx : κ + t^2 + (((-b : ℝ) : ℂ) * (w t j)^2).re ≤
          κ + κ*t^2 + 2*b*(w t j).re + b*‖w t j‖^2 := by
        convert hx j using 1 <;> dsimp [b] <;> ring
      have hh := transverse_scalar_bound κ b A t (w t j) hb hA (hr j) hmx
      apply (div_le_iff₀ ht2).mpr
      nlinarith
    rw [mean_ratio_real]
    apply (div_le_iff₀ hm).mpr
    calc
      (∑ j, 2 * (((-b : ℝ) : ℂ) * w t j).re / t^2) ≤
          ∑ j : ι, (κ - 1 + 2*b*A^2*t^2) := sum_le_sum (fun j _ => hpoint j)
      _ = (κ - 1 + 2*b*A^2*t^2) * (Fintype.card ι : ℝ) := by
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        ring
  have hleftC : Tendsto
      (fun t : ℝ => (2 : ℂ) * (((-b : ℝ) : ℂ) * (mean (w t) / ((t^2 : ℝ) : ℂ))))
      (𝓝[≠] (0 : ℝ)) (𝓝 (((-b : ℝ) : ℂ) * μ)) := by
    convert (tendsto_const_nhds.mul (tendsto_const_nhds.mul hmean)) using 1 <;> ring
  have hleft : Tendsto
      (fun t : ℝ => 2 * (((-b : ℝ) : ℂ) * (mean (w t) / ((t^2 : ℝ) : ℂ))).re)
      (𝓝[≠] (0 : ℝ)) (𝓝 (((-b : ℝ) : ℂ) * μ).re) := by
    simpa [Function.comp_def, Complex.mul_re] using (Complex.continuous_re.tendsto _).comp hleftC
  have ht : Tendsto (fun t : ℝ => t) (𝓝[≠] (0 : ℝ)) (𝓝 0) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hright : Tendsto (fun t : ℝ => κ - 1 + 2*b*A^2*t^2)
      (𝓝[≠] (0 : ℝ)) (𝓝 (κ - 1)) := by
    simpa using tendsto_const_nhds.add (tendsto_const_nhds.mul (ht.pow 2))
  have hh := le_of_tendsto_of_tendsto hleft hright hevent
  simpa only [b, neg_mul] using hh

/-- Strictly negative real diagonal contributions are incompatible with a
zero complex trace. -/
theorem trace_contradiction_of_real_bounds {ι : Type*} [Fintype ι] [Nonempty ι]
    (u : ι → ℂ) (c : ℂ) (κ : ℝ) (hκ : κ < 1)
    (hbound : ∀ i, (c * u i).re ≤ κ - 1) (htrace : ∑ i, u i = 0) : False := by
  have hneg : ∀ i, (c * u i).re < 0 := fun i => (hbound i).trans_lt (by linarith)
  have hs : (∑ i, (c * u i).re) < 0 :=
    Finset.sum_neg (fun i _ => hneg i) Finset.univ_nonempty
  have hz : (∑ i, (c * u i).re) = 0 := by
    rw [← Complex.re_sum, ← Finset.mul_sum, htrace, mul_zero, Complex.zero_re]
  linarith

end
end Source29TransverseTraceBound

/- Component: TransverseCoordinates.inc -/
/- Exact bilinear and Hermitian formulas in a real unit transverse direction. -/

namespace Source29TransverseCoordinates

open Source29LocalMaximumBound

noncomputable section

variable {n : ℕ}

lemma dot_add_left (z v w : CSpace n) : dot (z + v) w = dot z w + dot v w := by
  simp [dot, add_mul, Finset.sum_add_distrib]

lemma dot_smul_left (a : ℂ) (z w : CSpace n) : dot (a • z) w = a * dot z w := by
  simp [dot, mul_assoc, Finset.mul_sum]

lemma quadric_eq_dot_self (z : CSpace n) : quadric z = dot z z := by
  simp [quadric, dot, pow_two]

lemma quadric_smul (a : ℂ) (z : CSpace n) : quadric (a • z) = a^2 * quadric z := by
  simp [quadric, mul_pow, Finset.mul_sum]

lemma conjugate_eq_self_of_real (e : CSpace n) (hreal : ∀ i, (e i).im = 0) :
    conjugate e = e := by
  ext i : 1
  exact Complex.conj_eq_iff_im.mpr (hreal i)

lemma dot_conjugate_real_right (z e : CSpace n) (hreal : ∀ i, (e i).im = 0) :
    dot (conjugate z) e = star (dot z e) := by
  have he : ∀ i, star (e i) = e i := fun i => Complex.conj_eq_iff_im.mpr (hreal i)
  simp [dot, conjugate, he]

lemma quadric_real_unit (e : CSpace n) (hreal : ∀ i, (e i).im = 0) (he : ‖e‖ = 1) :
    quadric e = 1 := by
  calc
    quadric e = dot e e := quadric_eq_dot_self e
    _ = dot (conjugate e) e := by rw [conjugate_eq_self_of_real e hreal]
    _ = inner ℂ e e := dot_conjugate_eq_inner e e
    _ = 1 := by rw [inner_self_eq_norm_sq_to_K, he]; norm_num

lemma dot_normal_point (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) : dot z (normal z κ) = 0 := by
  rw [dot_comm, dot_normal, ← quadric_eq_dot_self, hq, dot_conjugate_eq_inner,
    inner_self_eq_norm_sq_to_K, hz]
  norm_num

lemma quadric_normal (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) :
    quadric (normal z κ) = ((-κ * (1-κ^2) : ℝ) : ℂ) := by
  have hq' : Source29ComplexMaximum.bilinear (fun i => z i) (fun i => z i) = (κ : ℂ) := by
    simpa only [Source29ComplexMaximum.bilinear, quadric, pow_two] using hq
  have hn : Source29ComplexMaximum.bilinear (fun i => star (z i)) (fun i => z i) = 1 := by
    change dot (conjugate z) z = 1
    rw [dot_conjugate_eq_inner, inner_self_eq_norm_sq_to_K, hz]
    norm_num
  have hs := Source29ComplexMaximum.normal_square (fun i => z i) κ hq' hn
  rw [quadric_eq_dot_self]
  convert hs using 1
  · simp [Source29ComplexMaximum.bilinear, dot, normal, conjugate]
  · push_cast
    ring

lemma inner_point_normal (z : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ)) :
    inner ℂ z (normal z κ) = ((1-κ^2 : ℝ) : ℂ) := by
  unfold normal
  rw [inner_sub_right, inner_smul_right, inner_conjugate, hq,
    inner_self_eq_norm_sq_to_K, hz]
  simp [Complex.ofReal_sub, pow_two]

lemma transverse_orthogonality (z e : CSpace n) (κ : ℝ)
    (hreal : ∀ i, (e i).im = 0) (hze : dot z e = 0) :
    dot e (normal z κ) = 0 ∧ inner ℂ z e = 0 ∧ inner ℂ e (normal z κ) = 0 := by
  have hbar : dot (conjugate z) e = 0 := by
    rw [dot_conjugate_real_right z e hreal, hze, star_zero]
  have heN : dot e (normal z κ) = 0 := by
    rw [dot_comm, dot_normal, hze, hbar]
    ring
  refine ⟨heN, ?_, ?_⟩
  · rw [← dot_conjugate_eq_inner, hbar]
  · rw [← dot_conjugate_eq_inner, conjugate_eq_self_of_real e hreal, heN]

/-- The bilinear quadric has no mixed terms in these three directions. -/
theorem transverse_quadric (z e : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ))
    (hreal : ∀ i, (e i).im = 0) (he : ‖e‖ = 1) (hze : dot z e = 0)
    (t w : ℂ) :
    quadric (z + t • e + w • normal z κ) =
      (κ : ℂ) + t^2 + ((-κ*(1-κ^2) : ℝ) : ℂ) * w^2 := by
  have hqE := quadric_real_unit e hreal he
  have hqN := quadric_normal z κ hz hq
  have hzN := dot_normal_point z κ hz hq
  have heN := (transverse_orthogonality z e κ hreal hze).1
  simp only [quadric_add, quadric_smul, dot_add_left, dot_smul_left, dot_smul_right,
    hq, hqE, hqN, hzN, heN, hze, mul_zero, add_zero, mul_one]
  ring

/-- The Hermitian norm retains exactly the real normal displacement term. -/
theorem transverse_norm_sq (z e : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ))
    (hreal : ∀ i, (e i).im = 0) (he : ‖e‖ = 1) (hze : dot z e = 0)
    (t w : ℂ) :
    ‖z + t • e + w • normal z κ‖^2 =
      1 + ‖t‖^2 + 2*(1-κ^2)*w.re + (1-κ^2)*‖w‖^2 := by
  have horth := transverse_orthogonality z e κ hreal hze
  have hzN := inner_point_normal z κ hz hq
  have hNnorm := norm_normal_sq z κ hz hq
  simp only [norm_add_sq (𝕜 := ℂ), inner_add_left, inner_smul_left, inner_smul_right,
    norm_smul, mul_pow, hz, he, hNnorm, horth.2.1, horth.2.2, hzN,
    mul_zero, add_zero, mul_one, one_pow]
  simp only [RCLike.re_eq_complex_re, Complex.zero_re, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  ring

/-- A pointwise instance of the global maximum inequality supplies exactly
the scalar hypothesis used by the real transverse trace limit. -/
theorem transverse_real_maximum (z e : CSpace n) (κ : ℝ)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ))
    (hreal : ∀ i, (e i).im = 0) (he : ‖e‖ = 1) (hze : dot z e = 0)
    (t : ℝ) (w : ℂ)
    (hmaximum : ‖quadric (z + (t : ℂ) • e + w • normal z κ)‖ ≤
      κ * ‖z + (t : ℂ) • e + w • normal z κ‖^2) :
    κ + t^2 + (((-κ*(1-κ^2) : ℝ) : ℂ) * w^2).re ≤
      κ * (1 + t^2 + 2*(1-κ^2)*w.re + (1-κ^2)*‖w‖^2) := by
  have hr := (Complex.re_le_norm (quadric (z + (t : ℂ) • e + w • normal z κ))).trans hmaximum
  rw [transverse_quadric z e κ hz hq hreal he hze,
    transverse_norm_sq z e κ hz hq hreal he hze] at hr
  simpa only [Complex.add_re, ← Complex.ofReal_pow, Complex.ofReal_re,
    Complex.norm_real, Real.norm_eq_abs, sq_abs] using hr

end
end Source29TransverseCoordinates

/- Component: AnalyticSimpleRoot.inc -/
/- Local analytic roots follow from degree-one polynomial preparation. -/
namespace Source29AnalyticSimpleRoot

open Polynomial Filter Source29LocalFactorLinear
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

lemma analyticAt_linear_polynomial_functional
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (F : Polynomial ℂ →ₗ[ℂ] ℂ) : AnalyticAt ℂ (fun x => F (P x)) a := by
  let v : E → Fin (D+1) → ℂ := fun x i => (P x).coeff i
  let L : (Fin (D+1) → ℂ) →L[ℂ] ℂ :=
    (F.comp ((degreeLT ℂ (D+1)).subtype.comp
      (degreeLTEquiv ℂ (D+1)).symm.toLinearMap)).toContinuousLinearMap
  have hv : AnalyticAt ℂ v a := AnalyticAt.pi (fun i => hcoeff i)
  have heq (x : E) : coeffPolynomial (D+1) (v x) = P x := by
    have hm : P x ∈ degreeLT ℂ (D+1) := mem_degreeLT.mpr
      ((degree_le_of_natDegree_le (hdegree x)).trans_lt (by exact_mod_cast Nat.lt_succ_self D))
    exact congrArg Subtype.val ((degreeLTEquiv ℂ (D+1)).symm_apply_apply ⟨P x, hm⟩)
  have h := (L.analyticAt (v a)).comp hv
  change AnalyticAt ℂ (fun x => F (coeffPolynomial (D+1) (v x))) a at h
  simpa only [heq] using h

lemma simple_root_at_zero
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hzero : (P a).coeff 0 = 0) (hsimple : (P a).coeff 1 ≠ 0) :
    ∃ f : E → ℂ, AnalyticAt ℂ f a ∧ f a = 0 ∧
      (∀ᶠ x in 𝓝 a, (P x).eval (f x) = 0) ∧
      ∀ᶠ y : E × ℂ in 𝓝 (a,0), (P y.1).eval y.2 = 0 ↔ y.2 = f y.1 := by
  have hdiv : (X : Polynomial ℂ) ∣ P a := X_dvd_iff.mpr hzero
  obtain ⟨g, hg⟩ := hdiv
  have hg0 : g.coeff 0 ≠ 0 := by
    have he : (P a).coeff 1 = g.coeff 0 := by rw [hg]; simp
    rwa [he] at hsimple
  have hgn : g ≠ 0 := by intro hz; exact hg0 (by simp [hz])
  have hgd : g.natDegree ≤ D := by
    have hh := hdegree a
    rw [hg, natDegree_mul X_ne_zero hgn, natDegree_X] at hh
    omega
  have hd : ∀ᶠ x in 𝓝 a, (P x).degree < (1+D+1 : WithBot ℕ) := by
    apply Filter.Eventually.of_forall
    intro x
    exact (degree_le_of_natDegree_le (hdegree x)).trans_lt (by exact_mod_cast (show D < 1+D+1 by omega))
  obtain ⟨W, B, hW, hWa, hBa, hWcoeff, hBcoeff, hBdeg, hBunit, hWB⟩ :=
    Source29LocalPreparation.local_polynomial_preparation P a 1 D g hgd hg0
      (by simpa using hg) hd (fun i => hcoeff i)
  let f : E → ℂ := fun x => -(W x).coeff 0
  have hf : AnalyticAt ℂ f a := (hWcoeff 0).neg
  have hfa : f a = 0 := by simp [f, hWa]
  have hwlin (x : E) : W x = X + C ((W x).coeff 0) :=
    (hW x).1.eq_X_add_C (hW x).2
  have hroot : ∀ᶠ x in 𝓝 a, (P x).eval (f x) = 0 := by
    filter_upwards [hWB] with x hx
    rw [← hx, eval_mul, hwlin]
    simp [f]
  refine ⟨f, hf, hfa, hroot, ?_⟩
  have hp : Tendsto (fun y : E × ℂ => y.1) (𝓝 (a,0)) (𝓝 a) := continuous_fst.tendsto _
  filter_upwards [hBunit, hp.eventually hWB] with y hy he
  rw [← he, eval_mul, hwlin, eval_add, eval_X, eval_C]
  simp only [mul_eq_zero, hy, or_false, f]
  exact add_eq_zero_iff_eq_neg

/-- A simple root in a bounded-degree analytic polynomial family has a unique
local analytic branch. The uniqueness is joint in the parameter and root. -/
theorem exists_local_analytic_root
    (P : E → Polynomial ℂ) (a : E) (D : ℕ) (r : ℂ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hroot : (P a).eval r = 0) (hsimple : (P a).derivative.eval r ≠ 0) :
    ∃ f : E → ℂ, AnalyticAt ℂ f a ∧ f a = r ∧
      (∀ᶠ x in 𝓝 a, (P x).eval (f x) = 0) ∧
      ∀ᶠ y : E × ℂ in 𝓝 (a,r), (P y.1).eval y.2 = 0 ↔ y.2 = f y.1 := by
  let Q : E → Polynomial ℂ := fun x => taylor r (P x)
  have hQd : ∀ x, (Q x).natDegree ≤ D := by
    intro x
    simpa only [Q, natDegree_taylor] using hdegree x
  have hQa : ∀ k, AnalyticAt ℂ (fun x => (Q x).coeff k) a := by
    intro k
    exact analyticAt_linear_polynomial_functional P a D hdegree hcoeff
      ((Polynomial.lcoeff ℂ k).comp (taylor r))
  obtain ⟨g, hg, hga, hgr, hgu⟩ := simple_root_at_zero Q a D hQd hQa
    (by simpa only [Q, taylor_coeff_zero] using hroot)
    (by simpa only [Q, taylor_coeff_one] using hsimple)
  refine ⟨fun x => g x + r, hg.add analyticAt_const, by simp [hga], ?_, ?_⟩
  · simpa only [Q, taylor_eval] using hgr
  · have ht : Tendsto (fun y : E × ℂ => (y.1, y.2-r)) (𝓝 (a,r)) (𝓝 (a,0)) := by
      have ht := continuous_fst.continuousAt.tendsto.prodMk
        (continuous_snd.continuousAt.tendsto.sub
          (tendsto_const_nhds : Tendsto (fun _ : E × ℂ => r) (𝓝 (a,r)) (𝓝 r)))
      simpa only [sub_self, nhds_prod_eq] using ht
    filter_upwards [ht.eventually hgu] with y hy
    simpa only [Q, taylor_eval, sub_add_cancel, sub_eq_iff_eq_add] using hy

end
end Source29AnalyticSimpleRoot

/- Component: AnalyticSimpleRootFamily.inc -/
namespace Source29AnalyticSimpleRoot

open Polynomial Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Bounded degree turns the infinitely stated coefficient hypothesis into a
finite one, so all coefficients are analytic on one common neighborhood. -/
theorem eventually_analytic_coefficients
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a) :
    ∀ᶠ x in 𝓝 a, ∀ k, AnalyticAt ℂ (fun y => (P y).coeff k) x := by
  let v : E → Fin (D+1) → ℂ := fun x i => (P x).coeff i
  have hv : AnalyticAt ℂ v a := AnalyticAt.pi (fun i => hcoeff i)
  filter_upwards [hv.eventually_analyticAt] with x hx k
  by_cases hk : k < D+1
  · exact ((ContinuousLinearMap.proj (⟨k, hk⟩ : Fin (D+1))).analyticAt (v x)).comp hx
  · have he : (fun y => (P y).coeff k) = fun _ : E => (0 : ℂ) := by
      funext y
      exact coeff_eq_zero_of_natDegree_lt (by have := hdegree y; omega)
    rw [he]
    exact analyticAt_const

/-- Every simple root over a nearby parameter has a locally unique analytic
branch, with a common parameter neighborhood for the coefficient regularity. -/
theorem eventually_local_analytic_roots
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a) :
    ∀ᶠ x in 𝓝 a, ∀ r : ℂ, (P x).eval r = 0 → (P x).derivative.eval r ≠ 0 →
      ∃ f : E → ℂ, AnalyticAt ℂ f x ∧ f x = r ∧
        (∀ᶠ y in 𝓝 x, (P y).eval (f y) = 0) ∧
        ∀ᶠ y : E × ℂ in 𝓝 (x,r), (P y.1).eval y.2 = 0 ↔ y.2 = f y.1 := by
  filter_upwards [eventually_analytic_coefficients P a D hdegree hcoeff] with x hx r hr hs
  exact exists_local_analytic_root P x D r hdegree hx hr hs

end
end Source29AnalyticSimpleRoot

/- Component: AnalyticMeanHessian.inc -/

namespace Source29AnalyticMeanHessian

open Filter Source29MetricJet
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

theorem fderiv_fderiv_sum {σ : Type*} [Fintype σ]
    (f : σ → E → ℂ) (x : E) (hf : ∀ j, AnalyticAt ℂ (f j) x) :
    fderiv ℂ (fderiv ℂ (fun y => ∑ j, f j y)) x =
      ∑ j, fderiv ℂ (fderiv ℂ (f j)) x := by
  have he : ∀ᶠ y in 𝓝 x, ∀ j, AnalyticAt ℂ (f j) y :=
    Filter.eventually_all.mpr (fun j => (hf j).eventually_analyticAt)
  have hd : fderiv ℂ (fun y => ∑ j, f j y) =ᶠ[𝓝 x]
      (fun y => ∑ j, fderiv ℂ (f j) y) := by
    filter_upwards [he] with y hy
    exact fderiv_fun_sum (fun j _ => (hy j).differentiableAt)
  rw [hd.fderiv_eq]
  exact fderiv_fun_sum (fun j _ => (hf j).fderiv.differentiableAt)

/-- A local identity for the finite sum of sheets passes to their complete
second derivative. No labeling regularity in an external parameter is used. -/
theorem sum_second_derivative {σ : Type*} [Fintype σ]
    (f : σ → E → ℂ) (μ : E → ℂ) (c : ℂ) (x : E)
    (hf : ∀ j, AnalyticAt ℂ (f j) x) (hμ : AnalyticAt ℂ μ x)
    (hsum : (fun y => ∑ j, f j y) =ᶠ[𝓝 x] (fun y => c*μ y)) :
    ∑ j, fderiv ℂ (fderiv ℂ (f j)) x = c • fderiv ℂ (fderiv ℂ μ) x := by
  have hs : (fun y => ∑ j, f j y) =ᶠ[𝓝 x] c • μ := hsum
  have hsecond := (hs.fderiv (𝕜 := ℂ)).fderiv_eq (𝕜 := ℂ)
  rw [fderiv_fderiv_sum f x hf] at hsecond
  rw [fderiv_const_smul_field] at hsecond
  rw [fderiv_const_smul hμ.fderiv.differentiableAt c] at hsecond
  exact hsecond

theorem sum_hessian_entries {σ : Type*} [Fintype σ]
    (f : σ → E → ℂ) (μ : E → ℂ) (c : ℂ) (x u v : E)
    (hf : ∀ j, AnalyticAt ℂ (f j) x) (hμ : AnalyticAt ℂ μ x)
    (hsum : (fun y => ∑ j, f j y) =ᶠ[𝓝 x] (fun y => c*μ y)) :
    ∑ j, fderiv ℂ (fderiv ℂ (f j)) x u v =
      c * fderiv ℂ (fderiv ℂ μ) x u v := by
  have h := congrArg (fun D : E →L[ℂ] E →L[ℂ] ℂ => D u v)
    (sum_second_derivative f μ c x hf hμ hsum)
  simpa only [sum_apply, smul_apply, smul_eq_mul] using h

theorem continuousAt_hessian_entry (μ : E → ℂ) (x u v : E)
    (hμ : AnalyticAt ℂ μ x) :
    ContinuousAt (fun y => fderiv ℂ (fderiv ℂ μ) y u v) x :=
  (hμ.fderiv.fderiv.continuousAt.clm_apply continuousAt_const).clm_apply continuousAt_const

theorem tendsto_hessian_entry {α : Type*} {l : Filter α}
    (μ : E → ℂ) (x u v : E) (hμ : AnalyticAt ℂ μ x)
    (p : α → E) (hp : Tendsto p l (𝓝 x)) :
    Tendsto (fun a => fderiv ℂ (fderiv ℂ μ) (p a) u v) l
      (𝓝 (fderiv ℂ (fderiv ℂ μ) x u v)) :=
  (continuousAt_hessian_entry μ x u v hμ).tendsto.comp hp

/-- Metric trace of the analytic Hessian in a fixed family of directions. -/
def hessianTrace {ι : Type*} [Fintype ι] (M : ι → ι → ℂ) (e : ι → E)
    (f : E → ℂ) (x : E) : ℂ :=
  metricTrace M (fun i k => fderiv ℂ (fderiv ℂ f) x (e i) (e k))

lemma metricTrace_sum {σ ι : Type*} [Fintype σ] [Fintype ι]
    (M : ι → ι → ℂ) (H : σ → ι → ι → ℂ) :
    metricTrace M (fun i k => ∑ j, H j i k) = ∑ j, metricTrace M (H j) := by
  simp only [metricTrace, Finset.mul_sum]
  calc
    _ = ∑ i, ∑ j, ∑ k, M i k * H j i k := by
      apply Finset.sum_congr rfl
      intro i _
      rw [Finset.sum_comm]
    _ = _ := by rw [Finset.sum_comm]

theorem sum_hessianTrace {σ ι : Type*} [Fintype σ] [Fintype ι]
    (M : ι → ι → ℂ) (e : ι → E)
    (f : σ → E → ℂ) (μ : E → ℂ) (c : ℂ) (x : E)
    (hf : ∀ j, AnalyticAt ℂ (f j) x) (hμ : AnalyticAt ℂ μ x)
    (hsum : (fun y => ∑ j, f j y) =ᶠ[𝓝 x] (fun y => c*μ y)) :
    ∑ j, hessianTrace M e (f j) x = c*hessianTrace M e μ x := by
  unfold hessianTrace
  rw [← metricTrace_sum]
  simp_rw [sum_hessian_entries f μ c x _ _ hf hμ hsum]
  exact metricTrace_scale M _ c

theorem tendsto_hessianTrace {α ι : Type*} [Fintype ι] {l : Filter α}
    (M : ι → ι → ℂ) (e : ι → E)
    (μ : E → ℂ) (x : E) (hμ : AnalyticAt ℂ μ x)
    (p : α → E) (hp : Tendsto p l (𝓝 x)) :
    Tendsto (fun a => hessianTrace M e μ (p a)) l (𝓝 (hessianTrace M e μ x)) := by
  unfold hessianTrace metricTrace
  apply tendsto_finsetSum Finset.univ
  intro i _
  apply tendsto_finsetSum Finset.univ
  intro k _
  exact tendsto_const_nhds.mul (tendsto_hessian_entry μ x (e i) (e k) hμ p hp)

/-- Sheet labels may vary arbitrarily with the external parameter. Local
analyticity and the local sum identity at each center suffice to pass to the
Hessian trace of the analytic mean at the limiting point. -/
theorem tendsto_sum_sheet_traces
    {α σ ι : Type*} [Fintype σ] [Fintype ι] {l : Filter α}
    (M : ι → ι → ℂ) (e : ι → E) (f : α → σ → E → ℂ)
    (μ : E → ℂ) (c : ℂ) (x : E) (hμ : AnalyticAt ℂ μ x)
    (p : α → E) (hp : Tendsto p l (𝓝 x))
    (hf : ∀ᶠ a in l, ∀ j, AnalyticAt ℂ (f a j) (p a))
    (hsum : ∀ᶠ a in l,
      (fun y => ∑ j, f a j y) =ᶠ[𝓝 (p a)] (fun y => c*μ y)) :
    Tendsto (fun a => ∑ j, hessianTrace M e (f a j) (p a)) l
      (𝓝 (c*hessianTrace M e μ x)) := by
  have ht := (tendsto_const_nhds (x := c) (f := l)).mul
    (tendsto_hessianTrace M e μ x hμ p hp)
  have hμa : ∀ᶠ a in l, AnalyticAt ℂ μ (p a) := hp.eventually hμ.eventually_analyticAt
  apply ht.congr'
  filter_upwards [hf, hsum, hμa] with a hfa hsa hμa
  exact (sum_hessianTrace M e (f a) μ c (p a) hfa hμa hsa).symm

end
end Source29AnalyticMeanHessian

/- Component: AnalyticSheetMeanTrace.inc -/
/- Final trace step for analytic sheets with a uniform quadratic bound.
The labels may depend arbitrarily on the external parameter. All geometric
inputs are explicit: the balls, the mean identity, and the graph equation. -/
namespace Source29AnalyticSheetMeanTrace

open Filter Source29MetricJet Source29AnalyticMeanHessian
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {α σ ι : Type*} [Fintype σ] [Fintype ι] {l : Filter α} [NeBot l]

/-- The metric trace of the mean Hessian vanishes. Gradient convergence and
boundedness of the sheet Hessians follow from the shrinking-ball bound and
are not additional hypotheses. No continuity of the labeling is required. -/
theorem mean_hessianTrace_eq_zero
    (M : ι → ι → ℂ) (e : ι → E) (he : ∀ i, ‖e i‖ ≤ 1)
    (f : α → σ → E → ℂ) (p : α → E) (scale : α → ℝ)
    (ε B : ℝ) (hε : 0 < ε)
    (hscale : Tendsto scale l (𝓝 0)) (hpos : ∀ᶠ a in l, 0 < scale a)
    (hp : Tendsto p l (𝓝 0))
    (hf : ∀ᶠ a in l, ∀ j,
      AnalyticOnNhd ℂ (f a j) (Metric.closedBall (p a) (ε * scale a)))
    (hbound : ∀ᶠ a in l, ∀ j, ∀ y ∈ Metric.closedBall (p a) (ε * scale a),
      ‖f a j y‖ ≤ B * scale a ^ 2)
    (μ : E → ℂ) (hμ : AnalyticAt ℂ μ 0) (c : ℂ) (hc : c ≠ 0)
    (hsum : ∀ᶠ a in l,
      (fun y => ∑ j, f a j y) =ᶠ[𝓝 (p a)] (fun y => c * μ y))
    (q : ℂ)
    (hPDE : ∀ j, ∀ᶠ a in l,
      let g := fun i => fderiv ℂ (f a j) (p a) (e i)
      let H := fun i k => fderiv ℂ (fderiv ℂ (f a j)) (p a) (e i) (e k)
      (1 + q * metricPair M g g) * metricTrace M H -
        q * contract H (raiseIndex M g) (raiseIndex M g) = 0) :
    hessianTrace M e μ 0 = 0 := by
  let g : σ → α → ι → ℂ := fun j a i => fderiv ℂ (f a j) (p a) (e i)
  let H : σ → α → ι → ι → ℂ :=
    fun j a i k => fderiv ℂ (fderiv ℂ (f a j)) (p a) (e i) (e k)
  have hb (j : σ) (i k : ι) :=
    Source29AnalyticDerivativeBounds.scaled_family_derivative_limits
      (fun a => f a j) p scale ε B hε hscale hpos
      (hf.mono fun _ ha => ha j) (hbound.mono fun _ ha => ha j)
      (e i) (e k) (he i) (he k)
  have hg : ∀ j i, Tendsto (fun a => g j a i) l (𝓝 0) :=
    fun j i => (hb j i i).1
  have hH : ∀ j i k, ∃ C : ℝ, ∀ᶠ a in l, ‖H j a i k‖ ≤ C :=
    fun j i k => ⟨16 * B / ε ^ 2, (hb j i k).2⟩
  have hcenter : ∀ᶠ a in l, ∀ j, AnalyticAt ℂ (f a j) (p a) := by
    filter_upwards [hf, hpos] with a hfa hpa
    intro j
    apply hfa j
    exact Metric.mem_closedBall_self (le_of_lt (mul_pos hε hpa))
  have hlimit := tendsto_sum_sheet_traces M e f μ c 0 hμ p hp hcenter hsum
  have hz : c * hessianTrace M e μ 0 = 0 :=
    Source29GraphTraceLimit.sum_trace_limit_eq_zero M q g H hg hH hPDE
      (c * hessianTrace M e μ 0) hlimit
  exact (mul_eq_zero.mp hz).resolve_left hc

end
end Source29AnalyticSheetMeanTrace

/- Component: RadialLift.lean -/

/- The parametric lift-continuity proofs below are adapted from
Mathlib/Topology/Homotopy/Lifting.lean, copyright (c) 2025 Junyan Xu,
released under Apache 2.0. Only the interval-local lifting core is used;
no fundamental group, homotopy classes, or covering-space imports are added. -/
namespace Source29RadialLift

open Function Topology unitInterval

noncomputable section

variable {E X A : Type*} [TopologicalSpace E] [TopologicalSpace X]
  [TopologicalSpace A] {p : E → X}

variable (homeo : IsLocalHomeomorph p)
include homeo

theorem exists_lift_nhds {f : C(I × A, X)} {g : I × A → E} (g_lifts : p ∘ g = f)
    (cont_0 : Continuous (g ⟨0, ·⟩)) (a : A) (cont_a : Continuous (g ⟨·, a⟩)) :
    ∃ N ∈ 𝓝 a, ∃ g' : I × A → E, ContinuousOn g' (Set.univ ×ˢ N) ∧ p ∘ g' = f ∧
      (∀ a, g' (0, a) = g (0, a)) ∧ ∀ t, g' (t, a) = g (t, a) := by
  -- For every `e : E`, upgrade `p` to a LocalHomeomorph `q e` around `e`.
  choose q mem_source hpq using homeo
  /- Using the hypothesis `cont_a`, we partition the unit interval so that for each
    subinterval `[tₙ, tₙ₊₁]`, the image `g ([tₙ, tₙ₊₁] × {a})` is contained in the
    domain of some local homeomorphism `q e`. -/
  obtain ⟨t, t_0, t_mono, ⟨n_max, h_max⟩, t_sub⟩ :=
    exists_monotone_Icc_subset_open_cover_unitInterval
      (fun e ↦ (q e).open_source.preimage cont_a)
      fun t _ ↦ Set.mem_iUnion.mpr ⟨g (t, a), mem_source _⟩
  /- We aim to inductively prove the existence of Nₙ and g' continuous on [0, tₙ] × Nₙ for each n,
    and get the desired result by taking some n with tₙ = 1. -/
  suffices ∀ n, ∃ N, a ∈ N ∧ IsOpen N ∧ ∃ g' : I × A → E, ContinuousOn g' (Set.Icc 0 (t n) ×ˢ N) ∧
      p ∘ g' = f ∧ (∀ a, g' (0, a) = g (0, a)) ∧ ∀ t' ≤ t n, g' (t', a) = g (t', a) by
    obtain ⟨N, haN, N_open, hN⟩ := this n_max
    simp_rw [h_max _ le_rfl] at hN
    refine ⟨N, N_open.mem_nhds haN, ?_⟩; convert! hN
    · rw [eq_comm, Set.eq_univ_iff_forall]; exact fun t ↦ ⟨bot_le, le_top⟩
    · rw [imp_iff_right]; exact le_top
  refine Nat.rec ⟨_, Set.mem_univ a, isOpen_univ, g, ?_, g_lifts, fun a ↦ rfl, fun _ _ ↦ rfl⟩
    (fun n ⟨N, haN, N_open, g', cont_g', g'_lifts, g'_0, g'_a⟩ ↦ ?_)
  · -- the n = 0 case is covered by the hypothesis cont_0.
    refine (cont_0.comp continuous_snd).continuousOn.congr (fun ta ⟨ht, _⟩ ↦ ?_)
    rw [t_0, Set.Icc_self, Set.mem_singleton_iff] at ht; rw [← ta.eta, ht]; rfl
  /- Since g ([tₙ, tₙ₊₁] × {a}) is contained in the domain of some local homeomorphism `q e` and
    g lifts f, f ([tₙ, tₙ₊₁] × {a}) is contained in the codomain (`target`) of `q e`. -/
  obtain ⟨e, h_sub⟩ := t_sub n
  have : Set.Icc (t n) (t (n + 1)) ×ˢ {a} ⊆ f ⁻¹' (q e).target := by
    rintro ⟨t0, a'⟩ ⟨ht, ha⟩
    rw [Set.mem_singleton_iff] at ha; dsimp only at ha
    rw [← g_lifts, hpq e, ha]
    exact (q e).map_source (h_sub ht)
  /- Using compactness of [tₙ, tₙ₊₁], we can find a neighborhood v of a such that
    f ([tₙ, tₙ₊₁] × v) is contained in the codomain of `q e`. -/
  obtain ⟨u, v, -, v_open, hu, hav, huv⟩ := generalized_tube_lemma isClosed_Icc.isCompact
    isCompact_singleton ((q e).open_target.preimage f.continuous) this
  classical
  /- Use the inverse of `q e` to extend g' from [0, tₙ] × Nₙ₊₁ to [0, tₙ₊₁] × Nₙ₊₁, where
    Nₙ₊₁ ⊆ v ∩ Nₙ is such that {tₙ} × Nₙ₊₁ is mapped to the domain (`source`) of `q e` by `g'`. -/
  refine ⟨_, ?_, v_open.inter <| (cont_g'.comp (Continuous.prodMk_right <| t n).continuousOn
      fun a ha ↦ ⟨?_, ha⟩).isOpen_inter_preimage N_open (q e).open_source,
    fun ta ↦ if ta.1 ≤ t n then g' ta else if f ta ∈ (q e).target then (q e).symm (f ta) else g ta,
    .if (fun ta ⟨⟨_, hav, _, ha⟩, hfr⟩ ↦ ?_) (cont_g'.mono fun ta ⟨hta, ht⟩ ↦ ?_) ?_,
    ?_, fun a ↦ ?_, fun t0 htn1 ↦ ?_⟩
  · refine ⟨Set.singleton_subset_iff.mp hav, haN, ?_⟩
    change g' (t n, a) ∈ (q e).source; rw [g'_a _ le_rfl]
    exact h_sub ⟨le_rfl, t_mono n.le_succ⟩
  · rw [← t_0]; exact ⟨t_mono n.zero_le, le_rfl⟩
  · have ht := Set.mem_ofPred.mp (frontier_le_subset_eq continuous_fst continuous_const hfr)
    have : f ta ∈ (q e).target := huv ⟨hu (by rw [ht]; exact ⟨le_rfl, t_mono n.le_succ⟩), hav⟩
    rw [ite_eq_left this]
    -- here we use that {tₙ} × Nₙ₊₁ is mapped to the domain of `q e`
    apply (q e).injOn (by rwa [← ta.eta, ht]) ((q e).map_target this)
    rw [(q e).right_inv this, ← hpq e]; exact congr($g'_lifts ta)
  · rw [closure_le_eq continuous_fst continuous_const] at ht
    exact ⟨⟨hta.1.1, ht⟩, hta.2.2.1⟩
  · simp_rw [not_le]; exact (ContinuousOn.congr ((q e).continuousOn_invFun.comp f.2.continuousOn
      fun _ h ↦ huv ⟨hu ⟨h.2, h.1.1.2⟩, h.1.2.1⟩)
      fun _ h ↦ ite_eq_left <| huv ⟨hu ⟨h.2, h.1.1.2⟩, h.1.2.1⟩).mono
        (Set.inter_subset_inter_right _ <| closure_lt_subset_le continuous_const continuous_fst)
  · ext ta; rw [Function.comp_apply]; split_ifs with _ hv
    · exact congr($g'_lifts ta)
    · rw [hpq e, (q e).right_inv hv]
    · exact congr($g_lifts ta)
  · rw [← g'_0]; exact ite_eq_left bot_le
  · dsimp only; split_ifs with htn hf
    · exact g'_a t0 htn
    · apply (q e).injOn ((q e).map_target hf) (h_sub ⟨le_of_not_ge htn, htn1⟩)
      rw [(q e).right_inv hf, ← hpq e]; exact congr($g_lifts _).symm
    · rfl

variable (sep : IsSeparatedMap p)
include sep

theorem continuous_lift (f : C(I × A, X)) {g : I × A → E} (g_lifts : p ∘ g = f)
    (cont_0 : Continuous (g ⟨0, ·⟩)) (cont_A : ∀ a, Continuous (g ⟨·, a⟩)) : Continuous g := by
  rw [continuous_iff_continuousAt]
  intro ⟨t, a⟩
  obtain ⟨N, haN, g', cont_g', g'_lifts, g'_0, -⟩ :=
    exists_lift_nhds homeo g_lifts cont_0 a (cont_A a)
  refine (cont_g'.congr fun ⟨t, a⟩ ⟨_, ha⟩ ↦ ?_).continuousAt (prod_mem_nhds Filter.univ_mem haN)
  refine congr_fun (sep.eq_of_comp_eq homeo.isLocallyInjective (cont_A a)
    (cont_g'.comp_continuous (.prodMk_left a) fun _ ↦ ⟨⟨⟩, ha⟩) ?_ 0 (g'_0 a).symm) t
  ext t; apply congr_fun (g_lifts.trans g'_lifts.symm)


end
end Source29RadialLift

/- Component: LocalSectionsPathLift.inc -/

namespace Source29RadialLift

open Function Topology unitInterval

noncomputable section

variable {E X A : Type*} [TopologicalSpace E] [TopologicalSpace X]
  [TopologicalSpace A] {p : E → X}

/-- A common base neighborhood supports a local continuous section through
any point above it. A finite collection of exhaustive root charts provides
this property directly, without introducing the general covering-map API. -/
def HasLocalSections (p : E → X) : Prop :=
  ∀ x : X, ∃ U : Set X, x ∈ U ∧ IsOpen U ∧
    ∀ e : E, p e ∈ U → ∃ q : X → E,
      ContinuousOn q U ∧ (∀ y ∈ U, p (q y) = y) ∧ q (p e) = e

/-- Finite-subdivision path lifting. Adapted from Junyan Xu's
`IsCoveringMap.exists_path_lifts` in Mathlib/Topology/Homotopy/Lifting.lean
(Apache 2.0); local sections replace the general bundle trivialization. -/
theorem exists_path_lifts (cover : HasLocalSections p)
    (γ : C(I, X)) (e : E) (γ_0 : γ 0 = p e) :
    ∃ Γ : C(I, E), p ∘ Γ = γ ∧ Γ 0 = e := by
  choose U mem_base U_open sections using cover
  obtain ⟨t, t_0, t_mono, ⟨n_max, h_max⟩, t_sub⟩ :=
    exists_monotone_Icc_subset_open_cover_unitInterval
      (fun x => (U_open x).preimage γ.continuous)
      (fun t _ => Set.mem_iUnion.2 ⟨γ t, mem_base _⟩)
  suffices ∀ n, ∃ Γ : I → E, ContinuousOn Γ (Set.Icc 0 (t n)) ∧
      (Set.Icc 0 (t n)).EqOn (p ∘ Γ) γ ∧ Γ 0 = e by
    obtain ⟨Γ, cont, eqOn, Γ_0⟩ := this n_max
    rw [h_max _ le_rfl] at cont eqOn
    exact ⟨⟨Γ, continuousOn_univ.mp
      (by convert! cont; rw [eq_comm, Set.eq_univ_iff_forall]; exact fun t => ⟨bot_le, le_top⟩)⟩,
      funext (fun _ => eqOn ⟨bot_le, le_top⟩), Γ_0⟩
  intro n
  induction n with
  | zero =>
    refine ⟨fun _ => e, continuous_const.continuousOn, ?_, rfl⟩
    intro t ht
    rw [t_0, Set.Icc_self, Set.mem_singleton_iff] at ht
    subst t
    exact γ_0.symm
  | succ n ih =>
    obtain ⟨Γ, cont, eqOn, Γ_0⟩ := ih
    obtain ⟨x, t_sub⟩ := t_sub n
    have pΓtn : p (Γ (t n)) = γ (t n) := eqOn ⟨t_0 ▸ t_mono n.zero_le, le_rfl⟩
    obtain ⟨q, hqcont, hqlift, hqstart⟩ := sections x (Γ (t n))
      (by rw [pΓtn]; exact t_sub ⟨le_rfl, t_mono n.le_succ⟩)
    refine ⟨fun s => if s ≤ t n then Γ s else q (γ s),
      .if (fun s hs => ?_) (cont.mono fun _ h => ?_) ?_, ?_, ?_⟩
    · cases frontier_Iic_subset _ hs.2
      rw [← pΓtn]
      exact hqstart.symm
    · rw [closure_le_eq continuous_id' continuous_const] at h
      exact ⟨h.1.1, h.2⟩
    · apply hqcont.comp γ.2.continuousOn
      simp_rw [not_le]
      intro s h
      exact t_sub ⟨closure_lt_subset_le continuous_const continuous_subtype_val h.2, h.1.2⟩
    · intro s hs
      simp only [Function.comp_apply]
      split_ifs with h
      · exact eqOn ⟨hs.1, h⟩
      · exact hqlift _ (t_sub ⟨le_of_not_ge h, hs.2⟩)
    · dsimp only
      rwa [ite_eq_left (t_0 ▸ t_mono n.zero_le)]

end
end Source29RadialLift

/- Component: ContractedSection.inc -/

namespace Source29RadialLift

open Function Topology unitInterval

noncomputable section

variable {E X : Type*} [TopologicalSpace E] [TopologicalSpace X]
  [T2Space E] {p : E → X}

/-- Lifting an explicit strong contraction gives a continuous section through
any prescribed point of the central fiber. No simply-connected-space or
homotopy-group interface is needed. -/
theorem exists_continuous_section_of_contraction
    (homeo : IsLocalHomeomorph p) (cover : HasLocalSections p)
    (H : C(I × X, X)) (x₀ : X)
    (hzero : ∀ x, H (0, x) = x₀) (hone : ∀ x, H (1, x) = x)
    (hfix : ∀ t, H (t, x₀) = x₀)
    (e₀ : E) (he₀ : p e₀ = x₀) :
    ∃ S : C(X, E), p ∘ S = id ∧ S x₀ = e₀ := by
  let γ (x : X) : C(I, X) :=
    ⟨fun t => H (t, x), H.continuous.comp (continuous_id.prodMk continuous_const)⟩
  have hγ0 (x : X) : γ x 0 = p e₀ := (hzero x).trans he₀.symm
  choose Γ hΓlift hΓzero using fun x => exists_path_lifts cover (γ x) e₀ (hγ0 x)
  let F : I × X → E := fun tx => Γ tx.2 tx.1
  have hFlift : p ∘ F = H := by
    funext tx
    exact congrFun (hΓlift tx.2) tx.1
  have hFzero : Continuous (F ⟨0, ·⟩) := by
    have he : (fun x : X => F (0, x)) = (fun _ : X => e₀) := funext hΓzero
    rw [he]
    exact continuous_const
  have hFcont : Continuous F :=
    continuous_lift homeo (T2Space.isSeparatedMap p) H hFlift hFzero (fun x => (Γ x).continuous)
  let S : C(X, E) :=
    ⟨fun x => F (1, x), hFcont.comp (continuous_const.prodMk continuous_id)⟩
  refine ⟨S, ?_, ?_⟩
  · funext x
    exact (congrFun hFlift (1, x)).trans (hone x)
  · have he : Γ x₀ = (fun _ : I => e₀) := by
      apply (T2Space.isSeparatedMap p).eq_of_comp_eq homeo.isLocallyInjective
        (Γ x₀).continuous continuous_const _ 0 (hΓzero x₀)
      funext t
      exact (congrFun (hΓlift x₀) t).trans ((hfix t).trans he₀.symm)
    exact congrFun he 1


/-- Continuous sections through different initial fiber points stay distinct
on a connected base. -/
theorem sections_ne_of_ne_at [PreconnectedSpace X]
    (homeo : IsLocalHomeomorph p) (S T : C(X, E))
    (hS : p ∘ S = id) (hT : p ∘ T = id) (x₀ : X)
    (hneq : S x₀ ≠ T x₀) (x : X) : S x ≠ T x := by
  intro he
  have heq := (T2Space.isSeparatedMap p).eq_of_comp_eq homeo.isLocallyInjective
    S.continuous T.continuous (hS.trans hT.symm) x he
  exact hneq (congrFun heq x₀)

end
end Source29RadialLift

/- Component: BallSection.inc -/

namespace Source29RadialLift

open Function Topology unitInterval

noncomputable section

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
variable {E : Type*} [TopologicalSpace E] [T2Space E]

/-- The radial contraction supplies continuous sections over an open ball. -/
theorem exists_continuous_section_on_ball (c : V) (R : ℝ) (hR : 0 < R)
    (p : E → Metric.ball c R)
    (homeo : IsLocalHomeomorph p) (cover : HasLocalSections p)
    (e₀ : E) (he₀ : p e₀ = ⟨c, Metric.mem_ball_self hR⟩) :
    ∃ S : C(Metric.ball c R, E), p ∘ S = id ∧
      S ⟨c, Metric.mem_ball_self hR⟩ = e₀ := by
  let H : C(I × Metric.ball c R, Metric.ball c R) :=
    { toFun := fun tx => ⟨c + (tx.1 : ℝ) • ((tx.2 : V) - c), by
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul,
          Real.norm_eq_abs, abs_of_nonneg tx.1.2.1]
        calc
          (tx.1 : ℝ) * ‖(tx.2 : V) - c‖ ≤ 1 * ‖(tx.2 : V) - c‖ :=
            mul_le_mul_of_nonneg_right tx.1.2.2 (norm_nonneg _)
          _ < R := by simpa only [one_mul, ← dist_eq_norm, Metric.mem_ball] using tx.2.2⟩
      continuous_toFun := by fun_prop }
  apply exists_continuous_section_of_contraction homeo cover H
    ⟨c, Metric.mem_ball_self hR⟩ _ _ _ e₀ he₀
  · intro x
    apply Subtype.ext
    simp [H]
  · intro x
    apply Subtype.ext
    simp [H]
  · intro t
    apply Subtype.ext
    simp [H]

end
end Source29RadialLift

/- Component: RootSectionAnalytic.lean -/

namespace Source29RootSectionAnalytic

open Filter
open scoped Topology

noncomputable section

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V]

/-- A continuous root choice agrees locally with the unique analytic branch.
This upgrades the section obtained by radial lifting to an analytic label. -/
theorem analyticAt_of_continuous_root_choice
    (P : V → Polynomial ℂ) (w : V → ℂ) (a : V)
    (hw : ContinuousAt w a)
    (hroot : ∀ᶠ x in 𝓝 a, (P x).eval (w x) = 0)
    (hlocal : ∃ f : V → ℂ, AnalyticAt ℂ f a ∧
      ∀ᶠ p : V × ℂ in 𝓝 (a, w a), (P p.1).eval p.2 = 0 ↔ p.2 = f p.1) :
    AnalyticAt ℂ w a := by
  obtain ⟨f, hf, huniq⟩ := hlocal
  apply hf.congr
  have hp : Tendsto (fun x => (x, w x)) (𝓝 a) (𝓝 (a, w a)) :=
    (continuousAt_id.prodMk hw).tendsto
  filter_upwards [hp.eventually huniq, hroot] with x hx hr
  exact (hx.mp hr).symm

end
end Source29RootSectionAnalytic

/- Component: TransverseBasis.inc -/
/- The real transverse space and its orthonormal basis at a normalized point. -/

namespace Source29TransverseBasis

open scoped BigOperators Matrix

noncomputable section

abbrev RSpace (n : ℕ) := EuclideanSpace ℝ (Fin n)
abbrev CSpace (n : ℕ) := EuclideanSpace ℂ (Fin n)

variable {n : ℕ}

def realVector (z : CSpace n) : RSpace n := WithLp.toLp 2 (fun i => (z i).re)
def imagVector (z : CSpace n) : RSpace n := WithLp.toLp 2 (fun i => (z i).im)
def normalPlane (z : CSpace n) : Submodule ℝ (RSpace n) :=
  Submodule.span ℝ (Set.range ![realVector z, imagVector z])
def transverseSpace (z : CSpace n) : Submodule ℝ (RSpace n) := (normalPlane z)ᗮ

def complexify (v : RSpace n) : CSpace n := WithLp.toLp 2 (fun i => (v i : ℂ))

lemma real_imag_inner (z : CSpace n) (κ : ℝ) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    inner ℝ (realVector z) (imagVector z) = 0 := by
  have h := (Source29NormalCoordinates.real_imag_normalization z κ hz hq).1
  simpa [PiLp.inner_apply, realVector, imagVector, mul_comm] using h

lemma real_imag_ne_zero (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    realVector z ≠ 0 ∧ imagVector z ≠ 0 := by
  obtain ⟨hx, hy⟩ := Source29NormalCoordinates.real_imag_nonzero z κ hk hk1 hz hq
  constructor
  · intro h
    apply hx
    funext i
    exact congrArg (fun v : RSpace n => v i) h
  · intro h
    apply hy
    funext i
    exact congrArg (fun v : RSpace n => v i) h

lemma real_imag_independent (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    LinearIndependent ℝ ![realVector z, imagVector z] := by
  obtain ⟨hx, hy⟩ := real_imag_ne_zero z κ hk hk1 hz hq
  have hxy := real_imag_inner z κ hz hq
  have hyx : inner ℝ (imagVector z) (realVector z) = 0 := by
    rw [real_inner_comm, hxy]
  apply linearIndependent_of_ne_zero_of_inner_eq_zero
  · intro i
    fin_cases i <;> simp [hx, hy]
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all

lemma normalPlane_finrank (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    Module.finrank ℝ (normalPlane z) = 2 := by
  unfold normalPlane
  have h := finrank_span_eq_card (real_imag_independent z κ hk hk1 hz hq)
  norm_num at h
  exact h

/-- The real transverse space has codimension two. -/
theorem transverseSpace_finrank (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    Module.finrank ℝ (transverseSpace z) = n - 2 := by
  have h := (normalPlane z).finrank_add_finrank_orthogonal
  rw [normalPlane_finrank z κ hk hk1 hz hq, finrank_euclideanSpace_fin] at h
  change 2 + Module.finrank ℝ (transverseSpace z) = n at h
  omega

def transverseBasis (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    OrthonormalBasis (Fin (n-2)) ℝ (transverseSpace z) :=
  (stdOrthonormalBasis ℝ (transverseSpace z)).reindex
    (finCongr (transverseSpace_finrank z κ hk hk1 hz hq))

lemma mem_transverse_inner (z : CSpace n) (v : RSpace n) (hv : v ∈ transverseSpace z) :
    inner ℝ (realVector z) v = 0 ∧ inner ℝ (imagVector z) v = 0 := by
  have hx : realVector z ∈ normalPlane z :=
    Submodule.subset_span (Set.mem_range.mpr ⟨(0 : Fin 2), rfl⟩)
  have hy : imagVector z ∈ normalPlane z :=
    Submodule.subset_span (Set.mem_range.mpr ⟨(1 : Fin 2), rfl⟩)
  exact ⟨hv _ hx, hv _ hy⟩

lemma complexify_real (v : RSpace n) (i : Fin n) : (complexify v i).im = 0 := by
  simp [complexify]

lemma complexify_norm (v : RSpace n) : ‖complexify v‖ = ‖v‖ := by
  have hs : ‖complexify v‖^2 = ‖v‖^2 := by
    simp [EuclideanSpace.norm_sq_eq, complexify]
  nlinarith [norm_nonneg (complexify v), norm_nonneg v]

lemma complexify_inner (v w : RSpace n) :
    inner ℂ (complexify v) (complexify w) = (inner ℝ v w : ℂ) := by
  simp [PiLp.inner_apply, complexify, mul_comm]

lemma complexify_transverse_dot (z : CSpace n) (v : RSpace n)
    (hv : v ∈ transverseSpace z) :
    (∑ i : Fin n, z i * complexify v i) = 0 := by
  obtain ⟨hx, hy⟩ := mem_transverse_inner z v hv
  have hr : (∑ i : Fin n, (z i).re * v i) = 0 := by
    simpa [PiLp.inner_apply, realVector, mul_comm] using hx
  have hi : (∑ i : Fin n, (z i).im * v i) = 0 := by
    simpa [PiLp.inner_apply, imagVector, mul_comm] using hy
  apply Complex.ext <;> simp [Complex.re_sum, Complex.im_sum, complexify,
    Complex.mul_re, Complex.mul_im, hr, hi]

def complexBasisVector (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) (j : Fin (n-2)) : CSpace n :=
  complexify ((transverseBasis z κ hk hk1 hz hq j : transverseSpace z) : RSpace n)

lemma complexBasisVector_real (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) (j : Fin (n-2)) (i : Fin n) :
    (complexBasisVector z κ hk hk1 hz hq j i).im = 0 := by
  exact complexify_real _ i

lemma complexBasisVector_norm (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) (j : Fin (n-2)) :
    ‖complexBasisVector z κ hk hk1 hz hq j‖ = 1 := by
  unfold complexBasisVector
  rw [complexify_norm]
  exact (transverseBasis z κ hk hk1 hz hq).orthonormal.norm_eq_one j

lemma complexBasisVector_dot (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) (j : Fin (n-2)) :
    (∑ i : Fin n, z i * complexBasisVector z κ hk hk1 hz hq j i) = 0 := by
  exact complexify_transverse_dot _ _ (transverseBasis z κ hk hk1 hz hq j).property

/-- The lifted real basis is also an orthonormal complex family. -/
theorem complexBasisVector_orthonormal (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin n, (z i)^2 = (κ : ℂ)) :
    Orthonormal ℂ (complexBasisVector z κ hk hk1 hz hq) := by
  rw [orthonormal_iff_ite]
  intro i j
  unfold complexBasisVector
  rw [complexify_inner]
  have h := (orthonormal_iff_ite.mp (transverseBasis z κ hk hk1 hz hq).orthonormal) i j
  change inner ℝ ((transverseBasis z κ hk hk1 hz hq i : transverseSpace z) : RSpace n)
    ((transverseBasis z κ hk hk1 hz hq j : transverseSpace z) : RSpace n) = _ at h
  rw [h]
  split_ifs <;> norm_num

/-- In dimension eight, the constructed real transverse basis supplies exactly
six real, unit, complex-orthonormal transverse vectors. -/
theorem exists_six_transverse_vectors (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    ∃ e : Fin 6 → CSpace 8, Orthonormal ℂ e ∧
      (∀ j i, (e j i).im = 0) ∧ (∀ j, ‖e j‖ = 1) ∧
      (∀ j, ∑ i : Fin 8, z i * e j i = 0) := by
  exact ⟨complexBasisVector z κ hk hk1 hz hq,
    complexBasisVector_orthonormal z κ hk hk1 hz hq,
    complexBasisVector_real z κ hk hk1 hz hq,
    complexBasisVector_norm z κ hk hk1 hz hq,
    complexBasisVector_dot z κ hk hk1 hz hq⟩

end
end Source29TransverseBasis

/- Component: TangentBasis.inc -/
/- A concrete orthonormal basis of the complex tangent hyperplane. -/

namespace Source29TangentBasis

open Source29LocalMaximumBound
open Source29TransverseBasis (complexBasisVector)
open scoped BigOperators Matrix

noncomputable section

abbrev Tangent (z : CSpace 8) (κ : ℝ) := (Source29ComplexTangent.normalCLM κ z).ker

lemma normalCLM_eq_dot (z v : CSpace 8) (κ : ℝ) :
    Source29ComplexTangent.normalCLM κ z v = dot (normal z κ) v := by
  rw [Source29ComplexTangent.normalCLM_apply]
  rfl

lemma normalCLM_normal (z : CSpace 8) (κ : ℝ) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    Source29ComplexTangent.normalCLM κ z (normal z κ) =
      ((-κ*(1-κ^2) : ℝ) : ℂ) := by
  rw [normalCLM_eq_dot, ← Source29TransverseCoordinates.quadric_eq_dot_self]
  exact Source29TransverseCoordinates.quadric_normal z κ hz hq

lemma tangent_finrank (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    Module.finrank ℂ (Tangent z κ) = 7 := by
  have hcR : -κ*(1-κ^2) ≠ 0 := by nlinarith [sq_nonneg κ]
  have hc : ((-κ*(1-κ^2) : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hcR
  have hsurj : Function.Surjective (Source29ComplexTangent.normalCLM κ z) := by
    intro a
    refine ⟨(a / ((-κ*(1-κ^2) : ℝ) : ℂ)) • normal z κ, ?_⟩
    rw [map_smul, normalCLM_normal z κ hz hq, smul_eq_mul, div_mul_cancel₀ _ hc]
  have hrange : LinearMap.range (Source29ComplexTangent.normalCLM κ z).toLinearMap = ⊤ :=
    LinearMap.range_eq_top.mpr hsurj
  have hdim := (Source29ComplexTangent.normalCLM κ z).toLinearMap.finrank_range_add_finrank_ker
  rw [hrange, finrank_top, Module.finrank_self, finrank_euclideanSpace_fin] at hdim
  change 1 + Module.finrank ℂ (Tangent z κ) = 8 at hdim
  omega

def ambientVector (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) : Fin 7 → CSpace 8 :=
  Matrix.vecCons z (complexBasisVector z κ hk hk1 hz hq)

lemma ambientVector_mem (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (j : Fin 7) :
    ambientVector z κ hk hk1 hz hq j ∈ Tangent z κ := by
  change Source29ComplexTangent.normalCLM κ z _ = 0
  rw [normalCLM_eq_dot]
  refine Fin.cases ?_ (fun i => ?_) j
  · change dot (normal z κ) z = 0
    rw [dot_comm]
    exact Source29TransverseCoordinates.dot_normal_point z κ hz hq
  · change dot (normal z κ) (complexBasisVector z κ hk hk1 hz hq i) = 0
    rw [dot_comm]
    exact (Source29TransverseCoordinates.transverse_orthogonality z _ κ
      (Source29TransverseBasis.complexBasisVector_real z κ hk hk1 hz hq i)
      (Source29TransverseBasis.complexBasisVector_dot z κ hk hk1 hz hq i)).1

lemma ambientVector_orthonormal (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    Orthonormal ℂ (ambientVector z κ hk hk1 hz hq) := by
  rw [ambientVector, orthonormal_vecCons_iff]
  refine ⟨hz, ?_, Source29TransverseBasis.complexBasisVector_orthonormal z κ hk hk1 hz hq⟩
  intro i
  exact (Source29TransverseCoordinates.transverse_orthogonality z _ κ
    (Source29TransverseBasis.complexBasisVector_real z κ hk hk1 hz hq i)
    (Source29TransverseBasis.complexBasisVector_dot z κ hk hk1 hz hq i)).2.1

def tangentVector (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (j : Fin 7) : Tangent z κ :=
  ⟨ambientVector z κ hk hk1 hz hq j, ambientVector_mem z κ hk hk1 hz hq j⟩

lemma tangentVector_orthonormal (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    Orthonormal ℂ (tangentVector z κ hk hk1 hz hq) := by
  rw [orthonormal_iff_ite]
  exact orthonormal_iff_ite.mp (ambientVector_orthonormal z κ hk hk1 hz hq)

/-- Coordinate zero is the radial direction; the other six are the real transverse basis. -/
def tangentBasis (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    OrthonormalBasis (Fin 7) ℂ (Tangent z κ) :=
  let b := basisOfOrthonormalOfCardEqFinrank (tangentVector_orthonormal z κ hk hk1 hz hq)
    (by simpa using (tangent_finrank z κ hk hk1 hz hq).symm)
  b.toOrthonormalBasis (by simpa only [b, coe_basisOfOrthonormalOfCardEqFinrank]
    using tangentVector_orthonormal z κ hk hk1 hz hq)

lemma tangentBasis_apply (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (j : Fin 7) :
    (tangentBasis z κ hk hk1 hz hq j : CSpace 8) = ambientVector z κ hk hk1 hz hq j := by
  simp [tangentBasis, tangentVector]

/-- The isometric coordinate map used for the affine tangent chart. -/
def tangentCoordinates (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    EuclideanSpace ℂ (Fin 7) ≃ₗᵢ[ℂ] Tangent z κ :=
  (tangentBasis z κ hk hk1 hz hq).repr.symm

/-- The corresponding linear isometric embedding into the ambient space. -/
def tangentEmbedding (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    EuclideanSpace ℂ (Fin 7) →ₗᵢ[ℂ] CSpace 8 :=
  (Tangent z κ).subtypeₗᵢ.comp (tangentCoordinates z κ hk hk1 hz hq).toLinearIsometry

lemma tangentEmbedding_normal (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (x : EuclideanSpace ℂ (Fin 7)) :
    Source29ComplexTangent.normalCLM κ z (tangentEmbedding z κ hk hk1 hz hq x) = 0 :=
  (tangentCoordinates z κ hk hk1 hz hq x).property

lemma tangentEmbedding_range (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    LinearMap.range (tangentEmbedding z κ hk hk1 hz hq).toLinearMap = Tangent z κ := by
  ext v
  constructor
  · rintro ⟨x, rfl⟩
    exact tangentEmbedding_normal z κ hk hk1 hz hq x
  · intro hv
    refine ⟨(tangentCoordinates z κ hk hk1 hz hq).symm ⟨v, hv⟩, ?_⟩
    exact congrArg Subtype.val ((tangentCoordinates z κ hk hk1 hz hq).apply_symm_apply ⟨v, hv⟩)

lemma tangentEmbedding_single (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (j : Fin 7) :
    tangentEmbedding z κ hk hk1 hz hq (EuclideanSpace.single j 1) =
      ambientVector z κ hk hk1 hz hq j := by
  change ((tangentBasis z κ hk hk1 hz hq).repr.symm (EuclideanSpace.single j 1) : CSpace 8) = _
  rw [OrthonormalBasis.repr_symm_single, tangentBasis_apply]

lemma dot_real_left (v w : CSpace 8) (hv : ∀ i, (v i).im = 0) :
    dot v w = inner ℂ v w := by
  rw [← dot_conjugate_eq_inner, Source29TransverseCoordinates.conjugate_eq_self_of_real v hv]

lemma ambientVector_metric (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (i j : Fin 7) :
    dot (ambientVector z κ hk hk1 hz hq i) (ambientVector z κ hk hk1 hz hq j) =
      if i = j then (if i = 0 then (κ : ℂ) else 1) else 0 := by
  refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
  · simpa [ambientVector, dot, pow_two] using hq
  · simpa [ambientVector, dot, Fin.succ_ne_zero, eq_comm] using
      Source29TransverseBasis.complexBasisVector_dot z κ hk hk1 hz hq b
  · rw [dot_comm]
    simpa [ambientVector, dot, Fin.succ_ne_zero, eq_comm] using
      Source29TransverseBasis.complexBasisVector_dot z κ hk hk1 hz hq a
  · change dot (complexBasisVector z κ hk hk1 hz hq a)
      (complexBasisVector z κ hk hk1 hz hq b) = _
    rw [dot_real_left _ _ (Source29TransverseBasis.complexBasisVector_real z κ hk hk1 hz hq a)]
    simpa using (orthonormal_iff_ite.mp
      (Source29TransverseBasis.complexBasisVector_orthonormal z κ hk hk1 hz hq)) a b

/-- The complex bilinear metric has diagonal entries κ,1,1,1,1,1,1. -/
theorem tangentBasis_metric (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (i j : Fin 7) :
    dot (tangentBasis z κ hk hk1 hz hq i : CSpace 8)
      (tangentBasis z κ hk hk1 hz hq j : CSpace 8) =
      if i = j then (if i = 0 then (κ : ℂ) else 1) else 0 := by
  rw [tangentBasis_apply, tangentBasis_apply]
  exact ambientVector_metric z κ hk hk1 hz hq i j

end
end Source29TangentBasis

/- Component: FullNormalChart.inc -/
/- The full affine coordinate chart: normal first, then radial and six transverse directions. -/

namespace Source29FullNormalChart

open Source29LocalMaximumBound Source29TangentBasis Matrix
open scoped BigOperators

noncomputable section

abbrev Vec (n : ℕ) := Fin n → ℂ

def normalWeight (κ : ℝ) : ℂ := ((-κ*(1-κ^2) : ℝ) : ℂ)
def metricWeights (κ : ℝ) : Fin 8 → ℂ :=
  Fin.cons (normalWeight κ) (fun i : Fin 7 => if i = 0 then (κ : ℂ) else 1)

lemma normalWeight_ne_zero (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) :
    normalWeight κ ≠ 0 := by
  have h : -κ*(1-κ^2) ≠ 0 := by nlinarith [sq_nonneg κ]
  dsimp [normalWeight]
  exact_mod_cast h

lemma metricWeights_ne_zero (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (i : Fin 8) :
    metricWeights κ i ≠ 0 := by
  refine Fin.cases (normalWeight_ne_zero κ hk hk1) (fun j => ?_) i
  change (if j = 0 then (κ : ℂ) else 1) ≠ 0
  split_ifs
  · exact_mod_cast ne_of_gt hk
  · exact one_ne_zero

def tailVector (x : Vec 8) : CSpace 7 := WithLp.toLp 2 (fun i => x i.succ)

def chartMap (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) : Vec 8 →ₗ[ℂ] Vec 8 where
  toFun x := fun i => (tangentEmbedding z κ hk hk1 hz hq (tailVector x) + x 0 • normal z κ) i
  map_add' x y := by
    have ht : tailVector (x+y) = tailVector x + tailVector y := rfl
    funext i
    simp only [ht, map_add, Pi.add_apply, add_smul, PiLp.add_apply]
    ring
  map_smul' a x := by
    have ht : tailVector (a • x) = a • tailVector x := rfl
    funext i
    simp only [ht, map_smul, Pi.smul_apply, PiLp.smul_apply, smul_add, smul_smul,
      PiLp.add_apply, smul_eq_mul, RingHom.id_apply]
    ring

lemma chartMap_eq_zero (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (x : Vec 8)
    (hx : chartMap z κ hk hk1 hz hq x = 0) : x = 0 := by
  have hzero : tangentEmbedding z κ hk hk1 hz hq (tailVector x) + x 0 • normal z κ = 0 := by
    ext i
    exact congrFun hx i
  have hL := congrArg (Source29ComplexTangent.normalCLM κ z) hzero
  simp only [map_add, tangentEmbedding_normal, map_smul, normalCLM_normal z κ hz hq,
    map_zero, zero_add, smul_eq_mul] at hL
  have hx0 : x 0 = 0 := (mul_eq_zero.mp hL).resolve_right (normalWeight_ne_zero κ hk hk1)
  have ht : tailVector x = 0 := by
    apply (tangentEmbedding z κ hk hk1 hz hq).injective
    simpa only [hx0, zero_smul, add_zero, map_zero] using hzero
  funext i
  refine Fin.cases hx0 (fun j => ?_) i
  exact congrArg (fun v : CSpace 7 => v j) ht

lemma chartMap_injective (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    Function.Injective (chartMap z κ hk hk1 hz hq) := by
  intro x y hxy
  apply sub_eq_zero.mp
  apply chartMap_eq_zero z κ hk hk1 hz hq
  rw [map_sub, hxy, sub_self]

/-- The invertible finite-coordinate linear map underlying the affine polynomial chart. -/
def chart (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) : Vec 8 ≃ₗ[ℂ] Vec 8 :=
  LinearEquiv.ofInjectiveEndo (chartMap z κ hk hk1 hz hq) (chartMap_injective z κ hk hk1 hz hq)

/-- The distinguished polynomial variable is precisely the normal displacement. -/
theorem chart_cons (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (w : ℂ) (ζ : Vec 7) :
    chart z κ hk hk1 hz hq (Fin.cons w ζ) =
      fun i => (tangentEmbedding z κ hk hk1 hz hq (WithLp.toLp 2 ζ) + w • normal z κ) i := by
  rfl

lemma chart_cons_zero (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (ζ : Vec 7) :
    chart z κ hk hk1 hz hq (Fin.cons 0 ζ) =
      fun i => tangentEmbedding z κ hk hk1 hz hq (WithLp.toLp 2 ζ) i := by
  rw [chart_cons]
  simp

lemma chart_normal (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    chart z κ hk hk1 hz hq (Fin.cons 1 (0 : Vec 7)) = fun i => normal z κ i := by
  rw [chart_cons]
  simp

def direction (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) : Fin 8 → CSpace 8 :=
  Fin.cons (normal z κ) (ambientVector z κ hk hk1 hz hq)

lemma chart_single (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (j : Fin 8) :
    chart z κ hk hk1 hz hq (Pi.single j 1) = fun i => direction z κ hk hk1 hz hq j i := by
  refine Fin.cases ?_ (fun a => ?_) j
  · have hs : (Pi.single (0 : Fin 8) (1 : ℂ)) = (Fin.cons (1 : ℂ) (0 : Vec 7) : Vec 8) := by
      funext i
      refine Fin.cases (by simp) (fun a => ?_) i
      simp [Pi.single_apply, Fin.succ_ne_zero]
    rw [hs, chart_normal]
    rfl
  · have hs : (Pi.single a.succ (1 : ℂ)) = (Fin.cons (0 : ℂ) (Pi.single a (1 : ℂ) : Vec 7) : Vec 8) := by
      funext i
      refine Fin.cases (by simp [Pi.single_apply, Fin.succ_ne_zero, eq_comm]) (fun b => ?_) i
      simp [Pi.single_apply]
    rw [hs, chart_cons_zero]
    change (fun i => tangentEmbedding z κ hk hk1 hz hq (EuclideanSpace.single a 1) i) = _
    rw [tangentEmbedding_single]
    rfl

lemma direction_metric (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (i j : Fin 8) :
    dot (direction z κ hk hk1 hz hq i) (direction z κ hk hk1 hz hq j) =
      if i = j then metricWeights κ i else 0 := by
  refine Fin.cases ?_ (fun a => ?_) i <;> refine Fin.cases ?_ (fun b => ?_) j
  · change dot (normal z κ) (normal z κ) = _
    rw [← normalCLM_eq_dot, normalCLM_normal z κ hz hq]
    simp [metricWeights, normalWeight]
  · have h := ambientVector_mem z κ hk hk1 hz hq b
    change Source29ComplexTangent.normalCLM κ z (ambientVector z κ hk hk1 hz hq b) = 0 at h
    rw [normalCLM_eq_dot] at h
    simpa [direction, metricWeights, Fin.succ_ne_zero, eq_comm] using h
  · rw [dot_comm]
    have h := ambientVector_mem z κ hk hk1 hz hq a
    change Source29ComplexTangent.normalCLM κ z (ambientVector z κ hk hk1 hz hq a) = 0 at h
    rw [normalCLM_eq_dot] at h
    simpa [direction, metricWeights, Fin.succ_ne_zero, eq_comm] using h
  · simpa [direction, metricWeights] using ambientVector_metric z κ hk hk1 hz hq a b

def chartMatrix (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) : Matrix (Fin 8) (Fin 8) ℂ :=
  (chart z κ hk hk1 hz hq).toLinearMap.toMatrix'

lemma chartMatrix_apply (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (i j : Fin 8) :
    chartMatrix z κ hk hk1 hz hq i j = direction z κ hk hk1 hz hq j i := by
  change chart z κ hk hk1 hz hq (Pi.single j 1) i = _
  rw [chart_single]

/-- The full covariant metric is diag(c,κ,1,...,1), where c=-κ(1-κ²). -/
theorem chartMatrix_gram (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    (chartMatrix z κ hk hk1 hz hq)ᵀ * chartMatrix z κ hk hk1 hz hq =
      Matrix.diagonal (metricWeights κ) := by
  ext i j
  simpa only [Matrix.mul_apply, Matrix.transpose_apply, chartMatrix_apply, Matrix.diagonal_apply, Source29LocalMaximumBound.dot]
    using direction_metric z κ hk hk1 hz hq i j

lemma chartMatrix_isUnit_det (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    IsUnit (chartMatrix z κ hk hk1 hz hq).det := by
  apply (Matrix.isUnit_iff_isUnit_det _).mp
  apply LinearMap.isUnit_toMatrix'_iff.mpr
  apply (LinearMap.isUnit_iff_ker_eq_bot _).mpr
  exact LinearMap.ker_eq_bot.mpr (chart z κ hk hk1 hz hq).injective

def inverseMetric (κ : ℝ) : Matrix (Fin 8) (Fin 8) ℂ :=
  Matrix.diagonal (fun i => (metricWeights κ i)⁻¹)

/-- The inverse metric is diag(c⁻¹,κ⁻¹,1,...,1). -/
theorem chartMatrix_inverseMetric (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    (chartMatrix z κ hk hk1 hz hq)⁻¹ * ((chartMatrix z κ hk hk1 hz hq)⁻¹)ᵀ =
      inverseMetric κ := by
  rw [Matrix.transpose_nonsing_inv, ← Matrix.mul_inv_rev, chartMatrix_gram]
  apply Matrix.inv_eq_right_inv
  rw [inverseMetric, Matrix.diagonal_mul_diagonal]
  ext i j
  simp [Matrix.diagonal_apply, Matrix.one_apply, metricWeights_ne_zero κ hk hk1]

lemma metric_mul_inverseMetric (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) :
    Matrix.diagonal (metricWeights κ) * inverseMetric κ = 1 := by
  rw [inverseMetric, Matrix.diagonal_mul_diagonal]
  ext i j
  simp [Matrix.diagonal_apply, Matrix.one_apply, metricWeights_ne_zero κ hk hk1]

lemma inverseMetric_symmetric (κ : ℝ) (i j : Fin 8) : inverseMetric κ i j = inverseMetric κ j i := by
  by_cases hij : i = j
  · subst j; rfl
  · simp [inverseMetric, Matrix.diagonal_apply, hij, Ne.symm hij]

lemma inverseMetric_zero_zero (κ : ℝ) : inverseMetric κ 0 0 = (normalWeight κ)⁻¹ := by
  simp [inverseMetric, metricWeights]

lemma inverseMetric_tail (κ : ℝ) (i j : Fin 7) :
    inverseMetric κ i.succ j.succ = if i = j then (if i = 0 then (κ : ℂ)⁻¹ else 1) else 0 := by
  simp only [inverseMetric, Matrix.diagonal_apply, Fin.succ_inj, metricWeights, Fin.cons_succ]
  split_ifs <;> simp_all

end
end Source29FullNormalChart

/- Component: MetricCoordinateChange.inc -/
/- Coordinate covariance of the cubic metric operator. These are identities
of derivative arrays; the analytic chain rule is a separate statement. -/
namespace Source29MetricCoordinateChange

open Source29MetricJet Matrix
open scoped BigOperators

noncomputable section

variable {R ι : Type*} [CommRing R] [Fintype ι]

lemma metricPair_eq_dotProduct (M : Matrix ι ι R) (g b : ι → R) :
    metricPair M g b = g ⬝ᵥ (M *ᵥ b) :=
  (dot_raiseIndex M g b).symm

lemma contract_eq_dotProduct (H : Matrix ι ι R) (v w : ι → R) :
    contract H v w = v ⬝ᵥ (H *ᵥ w) :=
  metricPair_eq_dotProduct H v w

lemma metricTrace_eq_trace (M H : Matrix ι ι R) :
    metricTrace M H = (M * Hᵀ).trace := by
  simp only [metricTrace, Matrix.trace, Matrix.diag, Matrix.mul_apply,
    Matrix.transpose_apply]

lemma transpose_mulVec_dotProduct (A : Matrix ι ι R) (u v : ι → R) :
    (Aᵀ *ᵥ u) ⬝ᵥ v = u ⬝ᵥ (A *ᵥ v) := by
  rw [dotProduct_comm, Matrix.dotProduct_transpose_mulVec]

lemma contract_coordinate_change (A H : Matrix ι ι R) (v w : ι → R) :
    contract (Aᵀ * H * A) v w = contract H (A *ᵥ v) (A *ᵥ w) := by
  rw [contract_eq_dotProduct, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [Matrix.dotProduct_transpose_mulVec, dotProduct_comm,
    contract_eq_dotProduct]

lemma inverseMetric_symmetric (B : Matrix ι ι R) (i j : ι) :
    (B * Bᵀ) i j = (B * Bᵀ) j i := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, mul_comm]

variable [DecidableEq ι]

lemma inverse_transpose_cancel (A B : Matrix ι ι R) (hAB : A * B = 1) :
    Bᵀ * Aᵀ = 1 := by
  rw [← Matrix.transpose_mul, hAB, Matrix.transpose_one]

lemma raiseIndex_coordinate_change (A B M : Matrix ι ι R)
    (hAB : A * B = 1) (g : ι → R) :
    raiseIndex (B * M * Bᵀ) (Aᵀ *ᵥ g) = B *ᵥ (M *ᵥ g) := by
  change (B * M * Bᵀ) *ᵥ (Aᵀ *ᵥ g) = B *ᵥ (M *ᵥ g)
  rw [Matrix.mulVec_mulVec, Matrix.mul_assoc (B * M),
    inverse_transpose_cancel A B hAB, Matrix.mul_one, Matrix.mulVec_mulVec]

lemma metricPair_coordinate_change (A B M : Matrix ι ι R)
    (hAB : A * B = 1) (g b : ι → R) :
    metricPair (B * M * Bᵀ) (Aᵀ *ᵥ g) (Aᵀ *ᵥ b) = metricPair M g b := by
  have hr : (B * M * Bᵀ) *ᵥ (Aᵀ *ᵥ b) = B *ᵥ (M *ᵥ b) :=
    raiseIndex_coordinate_change A B M hAB b
  rw [metricPair_eq_dotProduct, hr]
  rw [transpose_mulVec_dotProduct, Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec,
    metricPair_eq_dotProduct]

lemma metricTrace_coordinate_change (A B M H : Matrix ι ι R)
    (hAB : A * B = 1) :
    metricTrace (B * M * Bᵀ) (Aᵀ * H * A) = metricTrace M H := by
  rw [metricTrace_eq_trace, metricTrace_eq_trace]
  simp only [Matrix.transpose_mul, Matrix.transpose_transpose]
  calc
    ((B * M * Bᵀ) * (Aᵀ * (Hᵀ * A))).trace =
        (B * M * (Bᵀ * Aᵀ) * Hᵀ * A).trace := by
      simp only [Matrix.mul_assoc]
    _ = (B * M * Hᵀ * A).trace := by
      rw [inverse_transpose_cancel A B hAB, Matrix.mul_one]
    _ = (A * (B * M * Hᵀ)).trace := Matrix.trace_mul_comm _ _
    _ = (M * Hᵀ).trace := by
      simp only [← Matrix.mul_assoc, hAB, Matrix.one_mul]

/-- Under x=A y the covector is Aᵀ g and the Hessian is Aᵀ H A.
The inverse metric is B M Bᵀ, where B is an inverse of A. The cubic
operator is unchanged. Symmetry of either input matrix is unnecessary. -/
theorem operator_coordinate_change (A B M : Matrix ι ι R)
    (hAB : A * B = 1) (g : ι → R) (H : Matrix ι ι R) :
    operator (B * M * Bᵀ) (Aᵀ *ᵥ g) (Aᵀ * H * A) = operator M g H := by
  unfold operator
  rw [metricPair_coordinate_change A B M hAB,
    metricTrace_coordinate_change A B M H hAB,
    raiseIndex_coordinate_change A B M hAB,
    contract_coordinate_change]
  rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]
  rfl

/-- Euclidean specialization: the inverse metric in the y coordinates is
A⁻¹ A⁻ᵀ. Over the complex numbers the transpose is bilinear, with no conjugation. -/
theorem operator_euclidean_coordinate_change (A : Matrix ι ι R)
    (hA : IsUnit A.det) (g : ι → R) (H : Matrix ι ι R) :
    operator (A⁻¹ * (A⁻¹)ᵀ) (Aᵀ *ᵥ g) (Aᵀ * H * A) =
      operator (1 : Matrix ι ι R) g H := by
  simpa only [Matrix.mul_one] using
    operator_coordinate_change A A⁻¹ 1 (Matrix.mul_nonsing_inv A hA) g H

lemma operator_identity (g : ι → R) (H : Matrix ι ι R) :
    operator (1 : Matrix ι ι R) g H =
      (∑ i, g i ^ 2) * (∑ i, H i i) - ∑ i, ∑ j, H i j * g i * g j := by
  simp [operator, metricPair, metricTrace, raiseIndex, contract, Matrix.one_apply,
    pow_two]

/-- The transformed operator is the usual Euclidean cubic polynomial in the
original gradient and Hessian entries. -/
theorem operator_euclidean_coordinate_formula (A : Matrix ι ι R)
    (hA : IsUnit A.det) (g : ι → R) (H : Matrix ι ι R) :
    operator (A⁻¹ * (A⁻¹)ᵀ) (Aᵀ *ᵥ g) (Aᵀ * H * A) =
      (∑ i, g i ^ 2) * (∑ i, H i i) - ∑ i, ∑ j, H i j * g i * g j := by
  rw [operator_euclidean_coordinate_change A hA, operator_identity]

end
end Source29MetricCoordinateChange

/- Component: AnalyticJetRules.inc -/
/- Analytic chain and product rules for the first two derivative arrays. -/
namespace Source29AnalyticJetRules

open Filter Source29MetricJet
open scoped Topology BigOperators

noncomputable section

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F]

lemma analyticAt_directional (f : E → ℂ) (x v : E) (hf : AnalyticAt ℂ f x) :
    AnalyticAt ℂ (fun y => fderiv ℂ f y v) x :=
  AnalyticAt.comp (f := fderiv ℂ f) (g := fun L : E →L[ℂ] ℂ => L v)
    ((ContinuousLinearMap.apply ℂ ℂ v).analyticAt _) hf.fderiv

lemma directional_second (f : E → ℂ) (x u v : E) (hf : AnalyticAt ℂ f x) :
    fderiv ℂ (fun y => fderiv ℂ f y v) x u =
      fderiv ℂ (fderiv ℂ f) x u v := by
  have h := (ContinuousLinearMap.apply ℂ ℂ v).hasFDerivAt.comp x
    hf.fderiv.differentiableAt.hasFDerivAt
  exact congrArg (fun L : E →L[ℂ] ℂ => L u) h.fderiv

lemma fderiv_affine (f : F → ℂ) (A : E →L[ℂ] F) (z : F) (x u : E)
    (hf : AnalyticAt ℂ f (z + A x)) :
    fderiv ℂ (fun y => f (z + A y)) x u = fderiv ℂ f (z + A x) (A u) := by
  have hA : HasFDerivAt (fun y => z + A y) A x := A.hasFDerivAt.const_add z
  exact congrArg (fun L : E →L[ℂ] ℂ => L u)
    (hf.differentiableAt.hasFDerivAt.comp x hA).fderiv

theorem hessian_affine (f : F → ℂ) (A : E →L[ℂ] F) (z : F) (x u v : E)
    (hf : AnalyticAt ℂ f (z + A x)) :
    fderiv ℂ (fderiv ℂ (fun y => f (z + A y))) x u v =
      fderiv ℂ (fderiv ℂ f) (z + A x) (A u) (A v) := by
  have hA : AnalyticAt ℂ (fun y => z + A y) x := analyticAt_const.add (A.analyticAt x)
  have hc : AnalyticAt ℂ (fun y => f (z + A y)) x :=
    AnalyticAt.comp (f := fun y => z + A y) (g := f) hf hA
  rw [← directional_second _ x u v hc]
  have heq : (fun y => fderiv ℂ (fun t => f (z + A t)) y v) =ᶠ[𝓝 x]
      (fun y => fderiv ℂ f (z + A y) (A v)) := by
    filter_upwards [hA.continuousAt.tendsto.eventually hf.eventually_analyticAt] with y hy
    exact fderiv_affine f A z y v hy
  rw [heq.fderiv_eq]
  rw [fderiv_affine _ A z x u (analyticAt_directional f _ (A v) hf),
    directional_second f _ (A u) (A v) hf]

lemma fderiv_product (U f : E → ℂ) (x v : E)
    (hU : AnalyticAt ℂ U x) (hf : AnalyticAt ℂ f x) :
    fderiv ℂ (fun y => U y * f y) x v =
      U x * fderiv ℂ f x v + f x * fderiv ℂ U x v := by
  rw [fderiv_fun_mul hU.differentiableAt hf.differentiableAt]
  rfl

theorem hessian_product (U f : E → ℂ) (x u v : E)
    (hU : AnalyticAt ℂ U x) (hf : AnalyticAt ℂ f x) :
    fderiv ℂ (fderiv ℂ (fun y => U y * f y)) x u v =
      U x * fderiv ℂ (fderiv ℂ f) x u v +
      f x * fderiv ℂ (fderiv ℂ U) x u v +
      fderiv ℂ f x u * fderiv ℂ U x v +
      fderiv ℂ U x u * fderiv ℂ f x v := by
  rw [← directional_second (fun y => U y * f y) x u v (hU.mul hf)]
  have heq : (fun y => fderiv ℂ (fun t => U t * f t) y v) =ᶠ[𝓝 x]
      (fun y => U y * fderiv ℂ f y v + f y * fderiv ℂ U y v) := by
    filter_upwards [hU.eventually_analyticAt, hf.eventually_analyticAt] with y hyU hyf
    exact fderiv_product U f y v hyU hyf
  rw [heq.fderiv_eq]
  have hDf := analyticAt_directional f x v hf
  have hDU := analyticAt_directional U x v hU
  rw [fderiv_fun_add (f := fun y => U y * fderiv ℂ f y v)
    (g := fun y => f y * fderiv ℂ U y v)
    (hU.mul hDf).differentiableAt (hf.mul hDU).differentiableAt]
  simp only [add_apply]
  rw [fderiv_product U _ x u hU hDf, fderiv_product f _ x u hf hDU,
    directional_second f x u v hf, directional_second U x u v hU]
  ring

variable {ι : Type*} [Fintype ι]

/-- Cubic metric expression evaluated on the actual derivatives in fixed
directions. The directions need not be a basis. -/
def jetOperator (M : ι → ι → ℂ) (e : ι → E) (f : E → ℂ) (x : E) : ℂ :=
  operator M (fun i => fderiv ℂ f x (e i))
    (fun i j => fderiv ℂ (fderiv ℂ f) x (e i) (e j))

theorem jetOperator_affine (M : ι → ι → ℂ) (e : ι → E)
    (f : F → ℂ) (A : E →L[ℂ] F) (z : F) (x : E)
    (hf : AnalyticAt ℂ f (z + A x)) :
    jetOperator M e (fun y => f (z + A y)) x =
      jetOperator M (fun i => A (e i)) f (z + A x) := by
  unfold jetOperator
  simp_rw [fderiv_affine f A z x _ hf, hessian_affine f A z x _ _ hf]

/-- Multiplication of a local defining function by an analytic factor scales
its cubic metric expression by the cube of the factor at a zero. -/
theorem jetOperator_product_at_zero (M : ι → ι → ℂ)
    (hM : ∀ i j, M i j = M j i) (e : ι → E)
    (U f : E → ℂ) (x : E) (hU : AnalyticAt ℂ U x) (hf : AnalyticAt ℂ f x)
    (hf0 : f x = 0) :
    jetOperator M e (fun y => U y * f y) x = U x ^ 3 * jetOperator M e f x := by
  unfold jetOperator
  simp_rw [fderiv_product U f x _ hU hf, hessian_product U f x _ _ hU hf,
    hf0, zero_mul, add_zero]
  exact defining_function_unit_identity M hM _ _ _ (U x)

theorem jetOperator_congr (M : ι → ι → ℂ) (e : ι → E) (f g : E → ℂ) (x : E)
    (hfg : f =ᶠ[𝓝 x] g) : jetOperator M e f x = jetOperator M e g x := by
  unfold jetOperator
  rw [hfg.fderiv_eq, (hfg.fderiv (𝕜 := ℂ)).fderiv_eq]

/-- A local analytic unit can be removed from a defining equation at a zero.
The factorization is needed only as an equality of germs near the point. -/
theorem jetOperator_zero_of_analytic_unit (M : ι → ι → ℂ)
    (hM : ∀ i j, M i j = M j i) (e : ι → E)
    (h U f : E → ℂ) (x : E) (hU : AnalyticAt ℂ U x) (hf : AnalyticAt ℂ f x)
    (hf0 : f x = 0) (hU0 : U x ≠ 0)
    (hlocal : h =ᶠ[𝓝 x] (fun y => U y * f y)) (hL : jetOperator M e h x = 0) :
    jetOperator M e f x = 0 := by
  rw [jetOperator_congr M e h _ x hlocal,
    jetOperator_product_at_zero M hM e U f x hU hf hf0] at hL
  exact (mul_eq_zero.mp hL).resolve_left (pow_ne_zero _ hU0)

end
end Source29AnalyticJetRules

/- Component: AnalyticMetricCoordinate.inc -/
/- Coordinate covariance for actual analytic derivatives. -/
namespace Source29AnalyticMetricCoordinate

open Matrix Source29MetricJet Source29MetricCoordinateChange Source29AnalyticJetRules
open scoped BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {ι : Type*} [Fintype ι]

def coordinateDirections (e : ι → E) (A : Matrix ι ι ℂ) (j : ι) : E :=
  ∑ i, A i j • e i

lemma gradient_coordinateDirections (e : ι → E) (A : Matrix ι ι ℂ)
    (D : E →L[ℂ] ℂ) :
    (fun j => D (coordinateDirections e A j)) = Aᵀ *ᵥ (fun i => D (e i)) := by
  funext j
  simp [coordinateDirections, Matrix.mulVec, dotProduct, map_sum, map_smul]

lemma hessian_coordinateDirections (e : ι → E) (A : Matrix ι ι ℂ)
    (D : E →L[ℂ] E →L[ℂ] ℂ) :
    (fun i j => D (coordinateDirections e A i) (coordinateDirections e A j)) =
      Aᵀ * (show Matrix ι ι ℂ from fun i j => D (e i) (e j)) * A := by
  funext i j
  change D (coordinateDirections e A i) (coordinateDirections e A j) =
    ∑ l, (∑ k, A k i * D (e k) (e l)) * A l j
  simp only [coordinateDirections, map_sum, map_smul, _root_.sum_apply, _root_.smul_apply,
    smul_eq_mul, Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  apply Finset.sum_congr rfl
  intro l _
  ring

variable [DecidableEq ι]

/-- Covariance for actual Fréchet derivatives in any fixed finite family of
directions. Analyticity is unnecessary for this purely linear step. -/
theorem jetOperator_coordinateDirections (e : ι → E) (A B M : Matrix ι ι ℂ)
    (hAB : A * B = 1) (f : E → ℂ) (x : E) :
    jetOperator (B * M * Bᵀ) (coordinateDirections e A) f x =
      jetOperator M e f x := by
  unfold jetOperator
  rw [gradient_coordinateDirections, hessian_coordinateDirections]
  exact operator_coordinate_change A B M hAB _ _

def coordinateMatrix (A : (ι → ℂ) →L[ℂ] (ι → ℂ)) : Matrix ι ι ℂ :=
  fun i j => A (Pi.single j 1) i

lemma coordinateMatrix_directions (A : (ι → ℂ) →L[ℂ] (ι → ℂ)) :
    coordinateDirections (fun i => Pi.single i 1) (coordinateMatrix A) =
      fun i => A (Pi.single i 1) := by
  funext j
  exact (pi_eq_sum_univ' (A (Pi.single j 1))).symm

/-- The analytic affine chain rule and matrix covariance combined. The
inverse relation is stated for the concrete matrix of the coordinate map. -/
theorem jetOperator_affine_coordinates
    (A : (ι → ℂ) →L[ℂ] (ι → ℂ)) (B M : Matrix ι ι ℂ)
    (hAB : coordinateMatrix A * B = 1) (f : (ι → ℂ) → ℂ) (z x : ι → ℂ)
    (hf : AnalyticAt ℂ f (z + A x)) :
    jetOperator (B * M * Bᵀ) (fun i => Pi.single i 1)
      (fun y => f (z + A y)) x =
      jetOperator M (fun i => Pi.single i 1) f (z + A x) := by
  calc
    _ = jetOperator (B * M * Bᵀ) (fun i => A (Pi.single i 1)) f (z + A x) :=
      jetOperator_affine (B * M * Bᵀ) _ f A z x hf
    _ = _ := by
      simpa only [coordinateMatrix_directions] using
        jetOperator_coordinateDirections (fun i => Pi.single i 1)
          (coordinateMatrix A) B M hAB f (z + A x)

theorem jetOperator_euclidean_affine_coordinates
    (A : (ι → ℂ) →L[ℂ] (ι → ℂ))
    (hA : IsUnit (coordinateMatrix A).det) (f : (ι → ℂ) → ℂ) (z x : ι → ℂ)
    (hf : AnalyticAt ℂ f (z + A x)) :
    jetOperator ((coordinateMatrix A)⁻¹ * ((coordinateMatrix A)⁻¹)ᵀ)
      (fun i => Pi.single i 1) (fun y => f (z + A y)) x =
      jetOperator (1 : Matrix ι ι ℂ) (fun i => Pi.single i 1) f (z + A x) := by
  simpa only [Matrix.mul_one] using
    jetOperator_affine_coordinates A (coordinateMatrix A)⁻¹ 1
      (Matrix.mul_nonsing_inv (coordinateMatrix A) hA) f z x hf

end
end Source29AnalyticMetricCoordinate

/- Component: AnalyticGraphEquation.inc -/
/- Deriving the metric graph PDE from an analytic local defining equation. -/
namespace Source29AnalyticGraphEquation

open Filter Source29MetricJet Source29AnalyticJetRules
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

def graphFunction (f : E → ℂ) (p : ℂ × E) : ℂ := p.1 - f p.2

lemma analyticAt_graphFunction (f : E → ℂ) (x : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) : AnalyticAt ℂ (graphFunction f) x := by
  exact ((ContinuousLinearMap.fst ℂ ℂ E).analyticAt x).sub
    (AnalyticAt.comp (f := fun p : ℂ × E => p.2) (g := f) hf
      ((ContinuousLinearMap.snd ℂ ℂ E).analyticAt x))

lemma fderiv_graphFunction (f : E → ℂ) (x v : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) :
    fderiv ℂ (graphFunction f) x v = v.1 - fderiv ℂ f x.2 v.2 := by
  have hd := hf.differentiableAt.hasFDerivAt.comp x
    (ContinuousLinearMap.snd ℂ ℂ E).hasFDerivAt
  exact congrArg (fun L : (ℂ × E) →L[ℂ] ℂ => L v)
    ((ContinuousLinearMap.fst ℂ ℂ E).hasFDerivAt.sub hd).fderiv

lemma hessian_graphFunction (f : E → ℂ) (x u v : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) :
    fderiv ℂ (fderiv ℂ (graphFunction f)) x u v =
      -fderiv ℂ (fderiv ℂ f) x.2 u.2 v.2 := by
  rw [← directional_second _ x u v (analyticAt_graphFunction f x hf)]
  have heq : (fun y => fderiv ℂ (graphFunction f) y v) =ᶠ[𝓝 x]
      (fun y : ℂ × E => v.1 - fderiv ℂ f y.2 v.2) := by
    filter_upwards [((ContinuousLinearMap.snd ℂ ℂ E).continuous.continuousAt.tendsto.eventually
      hf.eventually_analyticAt)] with y hy
    exact fderiv_graphFunction f y v hy
  rw [heq.fderiv_eq, fderiv_const_sub]
  have hd := (analyticAt_directional f x.2 v.2 hf).differentiableAt.hasFDerivAt.comp x
    (ContinuousLinearMap.snd ℂ ℂ E).hasFDerivAt
  have hv := congrArg (fun L : (ℂ × E) →L[ℂ] ℂ => L u) hd.fderiv
  have hv' : fderiv ℂ (fun y : ℂ × E => fderiv ℂ f y.2 v.2) x u =
      fderiv ℂ (fun y : E => fderiv ℂ f y v.2) x.2 u.2 := hv
  change -(fderiv ℂ (fun y : ℂ × E => fderiv ℂ f y.2 v.2) x u) = _
  rw [hv']
  rw [directional_second f x.2 u.2 v.2 hf]

variable {ι : Type*}

def graphDirections (e : ι → E) : Option ι → ℂ × E
  | none => (1, 0)
  | some i => (0, e i)

lemma graph_gradient (e : ι → E) (f : E → ℂ) (x : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) :
    (fun i => fderiv ℂ (graphFunction f) x (graphDirections e i)) =
      graphCovector (fun i => fderiv ℂ f x.2 (e i)) := by
  funext i
  cases i <;> simp [fderiv_graphFunction f x _ hf, graphDirections, graphCovector]

lemma graph_hessian (e : ι → E) (f : E → ℂ) (x : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) :
    (fun i j => fderiv ℂ (fderiv ℂ (graphFunction f)) x
      (graphDirections e i) (graphDirections e j)) =
      graphHessian (fun i j => fderiv ℂ (fderiv ℂ f) x.2 (e i) (e j)) := by
  funext i j
  cases i <;> cases j <;>
    simp [hessian_graphFunction f x _ _ hf, graphDirections, graphHessian]

variable [Fintype ι]

/-- A zero of the metric implicit operator yields the exact graph equation
for actual derivatives of an analytic graph. -/
theorem graph_equation_of_jetOperator_zero
    (M : ι → ι → ℂ) (c d : ℂ) (hcd : c * d = 1)
    (e : ι → E) (f : E → ℂ) (x : ℂ × E) (hf : AnalyticAt ℂ f x.2)
    (hL : jetOperator (blockMetric M d) (graphDirections e) (graphFunction f) x = 0) :
    let g := fun i => fderiv ℂ f x.2 (e i)
    let H := fun i j => fderiv ℂ (fderiv ℂ f) x.2 (e i) (e j)
    (1 + c * metricPair M g g) * metricTrace M H -
      c * contract H (raiseIndex M g) (raiseIndex M g) = 0 := by
  unfold jetOperator at hL
  rw [graph_gradient e f x hf, graph_hessian e f x hf] at hL
  exact graph_equation_of_operator_zero M c d hcd _ _ hL

/-- If an analytic local equation is a nonzero analytic unit times w-f, its
zero implicit operator gives the graph PDE. No derivative-array assumptions
are required. -/
theorem graph_equation_of_local_unit
    (M : ι → ι → ℂ) (hM : ∀ i j, M i j = M j i)
    (c d : ℂ) (hcd : c * d = 1) (e : ι → E)
    (h U : (ℂ × E) → ℂ) (f : E → ℂ) (x : ℂ × E)
    (hf : AnalyticAt ℂ f x.2) (hU : AnalyticAt ℂ U x)
    (hx : x.1 = f x.2) (hU0 : U x ≠ 0)
    (hlocal : h =ᶠ[𝓝 x] (fun y => U y * graphFunction f y))
    (hL : jetOperator (blockMetric M d) (graphDirections e) h x = 0) :
    let g := fun i => fderiv ℂ f x.2 (e i)
    let H := fun i j => fderiv ℂ (fderiv ℂ f) x.2 (e i) (e j)
    (1 + c * metricPair M g g) * metricTrace M H -
      c * contract H (raiseIndex M g) (raiseIndex M g) = 0 := by
  have hblock : ∀ i j, blockMetric M d i j = blockMetric M d j i := by
    intro i j
    cases i <;> cases j <;> simp [blockMetric, hM]
  apply graph_equation_of_jetOperator_zero M c d hcd e f x hf
  exact jetOperator_zero_of_analytic_unit (blockMetric M d) hblock (graphDirections e)
    h U (graphFunction f) x hU (analyticAt_graphFunction f x hf)
    (by simp [graphFunction, hx]) hU0 hlocal hL

end
end Source29AnalyticGraphEquation

/- Component: MvPolynomialJet.inc -/
/- Identifying polynomial partial derivatives with analytic derivatives. -/
namespace Source29MvPolynomialJet

open MvPolynomial Source29MetricJet Source29MetricCoordinateChange Source29AnalyticJetRules
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem analyticAt_eval (P : MvPolynomial ι ℂ) (x : ι → ℂ) :
    AnalyticAt ℂ (fun y => eval y P) x := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa only [eval_C] using (analyticAt_const : AnalyticAt ℂ (fun _ : ι → ℂ => c) x)
  | add p q hp hq => simpa only [eval_add, Pi.add_def] using hp.add hq
  | mul_X p j hp =>
    have hq : AnalyticAt ℂ (fun y : ι → ℂ => y j) x := (ContinuousLinearMap.proj j : (ι → ℂ) →L[ℂ] ℂ).analyticAt x
    simpa only [eval_mul, eval_X, Pi.mul_def] using hp.mul hq

theorem fderiv_eval_single (P : MvPolynomial ι ℂ) (x : ι → ℂ) (i : ι) :
    fderiv ℂ (fun y => eval y P) x (Pi.single i 1) = eval x (pderiv i P) := by
  induction P using MvPolynomial.induction_on with
  | C c => simp
  | add p q hp hq =>
    simp only [eval_add, map_add]
    rw [fderiv_fun_add (analyticAt_eval p x).differentiableAt
      (analyticAt_eval q x).differentiableAt]
    simpa only [add_apply] using congrArg₂ (· + ·) hp hq
  | mul_X p j hp =>
    have hc : fderiv ℂ (fun y : ι → ℂ => y j) x (Pi.single i 1) =
        (Pi.single i (1 : ℂ) : ι → ℂ) j := by
      exact congrArg (fun L : (ι → ℂ) →L[ℂ] ℂ => L (Pi.single i (1 : ℂ) : ι → ℂ))
        (ContinuousLinearMap.proj j : (ι → ℂ) →L[ℂ] ℂ).fderiv
    simp only [eval_mul, eval_X]
    rw [fderiv_product (fun y => eval y p) (fun y => y j) x (Pi.single i 1)
      (analyticAt_eval p x) ((ContinuousLinearMap.proj j : (ι → ℂ) →L[ℂ] ℂ).analyticAt x), hp, hc]
    by_cases hij : i = j
    · subst j
      simp [pderiv_mul, mul_comm, add_comm]
    · simp [pderiv_mul, pderiv_X, hij, Ne.symm hij, Pi.single_apply]

theorem hessian_eval_single (P : MvPolynomial ι ℂ) (x : ι → ℂ) (i j : ι) :
    fderiv ℂ (fderiv ℂ (fun y => eval y P)) x (Pi.single i 1) (Pi.single j 1) =
      eval x (pderiv i (pderiv j P)) := by
  rw [← directional_second _ x (Pi.single i 1) (Pi.single j 1) (analyticAt_eval P x)]
  simp_rw [fderiv_eval_single P _ j]
  exact fderiv_eval_single (pderiv j P) x i

/-- Evaluation of the polynomial cubic operator is precisely the Euclidean
analytic derivative expression, with the same order of partial derivatives. -/
theorem jetOperator_eval (P : MvPolynomial ι ℂ) (x : ι → ℂ) :
    jetOperator (1 : Matrix ι ι ℂ) (fun i => Pi.single i 1) (fun y => eval y P) x =
      eval x (Source29FactorInheritance.cubicOperator P) := by
  change operator (1 : Matrix ι ι ℂ)
    (fun i => fderiv ℂ (fun y => eval y P) x (Pi.single i (1 : ℂ)))
    (show Matrix ι ι ℂ from fun i j => fderiv ℂ (fderiv ℂ (fun y => eval y P)) x
      (Pi.single i (1 : ℂ)) (Pi.single j (1 : ℂ))) = _
  rw [operator_identity]
  simp_rw [fderiv_eval_single, hessian_eval_single]
  simp only [Source29FactorInheritance.cubicOperator, map_sub, map_mul, map_sum, map_pow]
  simp only [mul_comm, mul_left_comm, mul_assoc]

theorem jetOperator_eval_zero_of_dvd (P : MvPolynomial ι ℂ)
    (hP : P ∣ Source29FactorInheritance.cubicOperator P) (x : ι → ℂ)
    (hx : eval x P = 0) :
    jetOperator (1 : Matrix ι ι ℂ) (fun i => Pi.single i 1) (fun y => eval y P) x = 0 := by
  rw [jetOperator_eval]
  obtain ⟨Q, hQ⟩ := hP
  rw [hQ, map_mul, hx, zero_mul]

end
end Source29MvPolynomialJet

/- Component: RootLocalChartsAlgebra.lean -/

namespace Source29RootLocalCharts

open Polynomial

noncomputable section

lemma roots_nodup_of_simple (P : Polynomial ℂ) (hP : P ≠ 0)
    (hsimple : ∀ z, P.eval z = 0 → P.derivative.eval z ≠ 0) : P.roots.Nodup := by
  classical
  apply Multiset.nodup_iff_count_le_one.mpr
  intro z
  rw [Polynomial.count_roots]
  by_contra h
  have hm : 1 < P.rootMultiplicity z := Nat.lt_of_not_ge h
  have hh := (Polynomial.one_lt_rootMultiplicity_iff_isRoot hP).mp hm
  exact hsimple z hh.1 hh.2

/-- A full set of distinct roots determines the entire root multiset. -/
lemma roots_eq_of_distinct_full_tuple (P : Polynomial ℂ) (s : ℕ)
    (hP : P ≠ 0) (hdegree : P.natDegree ≤ s)
    (r : Fin s → ℂ) (hinj : Function.Injective r)
    (hroot : ∀ i, P.eval (r i) = 0) :
    (List.ofFn r : Multiset ℂ) = P.roots := by
  classical
  let S : Finset ℂ := Finset.univ.map ⟨r, hinj⟩
  have hc : S.card = s := by simp [S]
  have hr : ∀ z ∈ S, P.eval z = 0 := by
    intro z hz
    obtain ⟨i, _, rfl⟩ := Finset.mem_map.mp hz
    exact hroot i
  have he : P.roots = S.val :=
    Polynomial.roots_eq_of_natDegree_le_card_of_ne_zero hr (by simpa only [hc] using hdegree) hP
  rw [he]
  symm
  change Finset.univ.val.map r = (List.ofFn r : Multiset ℂ)
  exact Fin.univ_val_map r

lemma exhaustive_of_root_multiset (P : Polynomial ℂ) (s : ℕ)
    (hP : P ≠ 0) (r : Fin s → ℂ) (hr : (List.ofFn r : Multiset ℂ) = P.roots) (z : ℂ) :
    P.eval z = 0 ↔ ∃ i, r i = z := by
  change P.IsRoot z ↔ ∃ i, r i = z
  rw [← Polynomial.mem_roots hP, ← hr]
  exact List.mem_ofFn

end
end Source29RootLocalCharts

/- Component: RootLocalCharts.inc -/

namespace Source29RootLocalCharts

open Polynomial Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- All simple roots of the initial polynomial extend to a single finite
analytic chart. Distinctness and exhaustiveness hold on one open neighborhood. -/
theorem exists_local_root_charts_of_split
    (P : E → Polynomial ℂ) (a : E) (s : ℕ) (hs : 0 < s)
    (hmonic : ∀ x, (P x).Monic) (hdegree : ∀ x, (P x).natDegree = s)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsplit : (P a).Splits)
    (hsimple : ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    ∃ f : Fin s → E → ℂ, ∃ U : Set E, IsOpen U ∧ a ∈ U ∧
      (∀ i, AnalyticOnNhd ℂ (f i) U) ∧
      (∀ x ∈ U, Function.Injective (fun i => f i x)) ∧
      (∀ x ∈ U, (List.ofFn (fun i => f i x) : Multiset ℂ) = (P x).roots) ∧
      (∀ x ∈ U, ∀ z, (P x).eval z = 0 ↔ ∃ i, f i x = z) := by
  classical
  obtain ⟨r, hr, hroot, -, -⟩ := Source29RootEnumeration.exists_root_tuple
    (P a) s (hmonic a) (hdegree a) hs hsplit
  have hrinj : Function.Injective r := by
    apply List.nodup_ofFn.mp
    apply Multiset.coe_nodup.mp
    rw [hr]
    exact roots_nodup_of_simple (P a) (hmonic a).ne_zero hsimple
  have hlocal (i : Fin s) := Source29AnalyticSimpleRoot.exists_local_analytic_root
    P a s (r i) (fun x => (hdegree x).le) hcoeff (hroot i) (hsimple (r i) (hroot i))
  choose f hf hfa hfroot hfuniq using hlocal
  have han : ∀ᶠ x in 𝓝 a, ∀ i, AnalyticAt ℂ (f i) x :=
    Filter.eventually_all.mpr (fun i => (hf i).eventually_analyticAt)
  have hroots : ∀ᶠ x in 𝓝 a, ∀ i, (P x).eval (f i x) = 0 :=
    Filter.eventually_all.mpr hfroot
  have hpairs (i j : Fin s) : ∀ᶠ x in 𝓝 a, f i x = f j x → i = j := by
    by_cases hij : i = j
    · exact Filter.Eventually.of_forall (fun _ _ => hij)
    have hne : f i a - f j a ≠ 0 := by
      rw [hfa i, hfa j]
      exact sub_ne_zero.mpr (hrinj.ne hij)
    have he := ((hf i).continuousAt.sub (hf j).continuousAt).eventually_ne hne
    filter_upwards [he] with x hx heq
    exact False.elim (hx (sub_eq_zero.mpr heq))
  have hinj : ∀ᶠ x in 𝓝 a, Function.Injective (fun i => f i x) :=
    Filter.eventually_all.mpr (fun i => Filter.eventually_all.mpr (hpairs i))
  obtain ⟨U, hU, hUopen, haU⟩ := mem_nhds_iff.mp (han.and (hinj.and hroots))
  refine ⟨f, U, hUopen, haU, ?_, ?_, ?_, ?_⟩
  · intro i x hx
    exact (hU hx).1 i
  · intro x hx
    exact (hU hx).2.1
  · intro x hx
    exact roots_eq_of_distinct_full_tuple (P x) s (hmonic x).ne_zero
      (hdegree x).le (fun i => f i x) (hU hx).2.1 (hU hx).2.2
  · intro x hx z
    apply exhaustive_of_root_multiset (P x) s (hmonic x).ne_zero (fun i => f i x)
    exact roots_eq_of_distinct_full_tuple (P x) s (hmonic x).ne_zero
      (hdegree x).le (fun i => f i x) (hU hx).2.1 (hU hx).2.2

/-- Over the complex numbers no splitting hypothesis is needed. -/
theorem exists_local_root_charts
    (P : E → Polynomial ℂ) (a : E) (s : ℕ) (hs : 0 < s)
    (hmonic : ∀ x, (P x).Monic) (hdegree : ∀ x, (P x).natDegree = s)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsimple : ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    ∃ f : Fin s → E → ℂ, ∃ U : Set E, IsOpen U ∧ a ∈ U ∧
      (∀ i, AnalyticOnNhd ℂ (f i) U) ∧
      (∀ x ∈ U, Function.Injective (fun i => f i x)) ∧
      (∀ x ∈ U, (List.ofFn (fun i => f i x) : Multiset ℂ) = (P x).roots) ∧
      (∀ x ∈ U, ∀ z, (P x).eval z = 0 ↔ ∃ i, f i x = z) := by
  letI : IsAlgClosed ℂ := Source29FTA.complex_isAlgClosed
  exact exists_local_root_charts_of_split P a s hs hmonic hdegree hcoeff
    (IsAlgClosed.splits _) hsimple

end
end Source29RootLocalCharts

/- Component: RootCover.inc -/

namespace Source29RootCover

open Filter Topology
open scoped Topology

noncomputable section

variable {X : Type*} [TopologicalSpace X]

abbrev RootSpace (R : X → ℂ → Prop) := {p : X × ℂ // R p.1 p.2}

def projection (R : X → ℂ → Prop) : RootSpace R → X := fun p => p.1.1

lemma continuous_projection (R : X → ℂ → Prop) : Continuous (projection R) := by
  exact continuous_fst.comp continuous_subtype_val

/-- Extend one local root branch to a total section-valued function by a
fixed root-space point outside its domain. Only its local values are used. -/
def localSection (R : X → ℂ → Prop) (U : Set X) (f : X → ℂ)
    (hroot : ∀ x ∈ U, R x (f x)) (e : RootSpace R) : X → RootSpace R := by
  classical
  exact fun x => if hx : x ∈ U then ⟨(x, f x), hroot x hx⟩ else e

lemma localSection_apply (R : X → ℂ → Prop) (U : Set X) (f : X → ℂ)
    (hroot : ∀ x ∈ U, R x (f x)) (e : RootSpace R) (x : X) (hx : x ∈ U) :
    (localSection R U f hroot e x).1 = (x, f x) := by
  simp [localSection, hx]

lemma continuousOn_localSection (R : X → ℂ → Prop) (U : Set X) (f : X → ℂ)
    (hroot : ∀ x ∈ U, R x (f x)) (e : RootSpace R)
    (hf : ContinuousOn f U) : ContinuousOn (localSection R U f hroot e) U := by
  rw [continuousOn_iff_continuous_domRestrict]
  have hfU : Continuous (fun x : U => f x) := continuousOn_iff_continuous_domRestrict.mp hf
  have hc : Continuous (fun x : U => (⟨((x : X), f x), hroot x x.2⟩ : RootSpace R)) := by
    apply continuous_induced_rng.mpr
    exact continuous_subtype_val.prodMk hfU
  convert hc using 1
  funext x
  simp [Set.domRestrict, localSection, x.2]

/-- Exhaustive local root charts provide the common-neighborhood sections
needed by the interval-lifting theorem. Distinctness is not needed here. -/
theorem hasLocalSections_of_charts (R : X → ℂ → Prop) (s : ℕ)
    (hcharts : ∀ a : X, ∃ f : Fin s → X → ℂ, ∃ U : Set X,
      IsOpen U ∧ a ∈ U ∧ (∀ i, ContinuousOn (f i) U) ∧
      ∀ x ∈ U, ∀ z, R x z ↔ ∃ i, f i x = z) :
    Source29RadialLift.HasLocalSections (projection R) := by
  intro a
  obtain ⟨f, U, hUopen, haU, hf, hex⟩ := hcharts a
  refine ⟨U, haU, hUopen, ?_⟩
  intro e he
  obtain ⟨i, hi⟩ := (hex (projection R e) he e.1.2).mp e.2
  have hroot : ∀ x ∈ U, R x (f i x) := fun x hx => (hex x hx _).mpr ⟨i, rfl⟩
  refine ⟨localSection R U (f i) hroot e,
    continuousOn_localSection R U (f i) hroot e (hf i), ?_, ?_⟩
  · intro x hx
    simp [projection, localSection_apply R U (f i) hroot e x hx]
  · apply Subtype.ext
    rw [localSection_apply R U (f i) hroot e _ he]
    exact Prod.ext rfl hi

/-- A local graph description gives an open partial homeomorphism of the
root space with the parameter space. -/
def graphChart (R : X → ℂ → Prop) (U : Set X) (V : Set ℂ)
    (hU : IsOpen U) (hV : IsOpen V) (f : X → ℂ) (hf : ContinuousOn f U)
    (hgraph : ∀ x ∈ U, ∀ z ∈ V, R x z ↔ z = f x)
    (himage : ∀ x ∈ U, f x ∈ V) (e : RootSpace R) :
    OpenPartialHomeomorph (RootSpace R) X :=
  let hroot : ∀ x ∈ U, R x (f x) := fun x hx => (hgraph x hx _ (himage x hx)).mpr rfl
  { toFun := projection R
    invFun := localSection R U f hroot e
    source := {q | projection R q ∈ U ∧ q.1.2 ∈ V}
    target := U
    map_source' := fun _ hq => hq.1
    map_target' := by
      intro x hx
      simp only [Set.mem_setOf_eq]
      rw [show projection R (localSection R U f hroot e x) = x from
        congrArg Prod.fst (localSection_apply R U f hroot e x hx)]
      exact ⟨hx, by rw [show (localSection R U f hroot e x).1.2 = f x from
        congrArg Prod.snd (localSection_apply R U f hroot e x hx)]; exact himage x hx⟩
    left_inv' := by
      intro q hq
      apply Subtype.ext
      rw [localSection_apply R U f hroot e _ hq.1]
      exact Prod.ext rfl ((hgraph _ hq.1 _ hq.2).mp q.2).symm
    right_inv' := by
      intro x hx
      exact congrArg Prod.fst (localSection_apply R U f hroot e x hx)
    open_source := (hU.preimage (continuous_projection R)).inter
      (hV.preimage (continuous_snd.comp continuous_subtype_val))
    open_target := hU
    continuousOn_toFun := (continuous_projection R).continuousOn
    continuousOn_invFun := continuousOn_localSection R U f hroot e hf }

/-- A local unique-root graph at every point makes root projection a local
homeomorphism. -/
theorem isLocalHomeomorph_of_graphs (R : X → ℂ → Prop)
    (hgraphs : ∀ e : RootSpace R, ∃ U : Set X, ∃ V : Set ℂ,
      IsOpen U ∧ IsOpen V ∧ projection R e ∈ U ∧ e.1.2 ∈ V ∧
      ∃ f : X → ℂ, ContinuousOn f U ∧ (∀ x ∈ U, f x ∈ V) ∧
        ∀ x ∈ U, ∀ z ∈ V, R x z ↔ z = f x) :
    IsLocalHomeomorph (projection R) := by
  intro e
  obtain ⟨U, V, hU, hV, heU, heV, f, hf, himage, hgraph⟩ := hgraphs e
  exact ⟨graphChart R U V hU hV f hf hgraph himage e, ⟨heU, heV⟩, rfl⟩

end
end Source29RootCover

/- Component: PolynomialRootCover.inc -/

namespace Source29RootCover

open Filter Topology
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Joint uniqueness of an analytic root branch gives an open graph chart. -/
lemma exists_open_root_graph (P : E → Polynomial ℂ) (a : E) (r : ℂ)
    (hlocal : ∃ f : E → ℂ, AnalyticAt ℂ f a ∧ f a = r ∧
      ∀ᶠ p : E × ℂ in 𝓝 (a,r), (P p.1).eval p.2 = 0 ↔ p.2 = f p.1) :
    ∃ U : Set E, ∃ V : Set ℂ, IsOpen U ∧ IsOpen V ∧ a ∈ U ∧ r ∈ V ∧
      ∃ f : E → ℂ, ContinuousOn f U ∧ (∀ x ∈ U, f x ∈ V) ∧
        ∀ x ∈ U, ∀ z ∈ V, (P x).eval z = 0 ↔ z = f x := by
  obtain ⟨f, hf, hfa, huniq⟩ := hlocal
  obtain ⟨U, V, hU, ha, hV, hr, hgraph⟩ := mem_nhds_prod_iff'.mp huniq
  have hpre : ∀ᶠ x in 𝓝 a, f x ∈ V := hf.continuousAt.eventually (by rw [hfa]; exact hV.mem_nhds hr)
  obtain ⟨W, hWsub, hW, haW⟩ := mem_nhds_iff.mp (hf.eventually_analyticAt.and hpre)
  refine ⟨U ∩ W, V, hU.inter hW, hV, ⟨ha,haW⟩, hr, f, ?_, ?_, ?_⟩
  · intro x hx
    exact ((hWsub hx.2).1.continuousAt).continuousWithinAt
  · intro x hx
    exact (hWsub hx.2).2
  · intro x hx z hz
    exact hgraph (show (x,z) ∈ U ×ˢ V from ⟨hx.1,hz⟩)

/-- The root projection has common-neighborhood sections on any parameter
subset on which all roots are simple and the coefficients are analytic. -/
theorem polynomial_hasLocalSections
    (P : E → Polynomial ℂ) (s : ℕ) (hs : 0 < s) (B : Set E)
    (hmonic : ∀ x, (P x).Monic) (hdegree : ∀ x, (P x).natDegree = s)
    (hcoeff : ∀ a ∈ B, ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsimple : ∀ a ∈ B, ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    Source29RadialLift.HasLocalSections
      (projection (fun (a : B) z => (P a).eval z = 0)) := by
  apply hasLocalSections_of_charts _ s
  intro a
  obtain ⟨f,U,hU,ha,hf,-,-,hex⟩ := Source29RootLocalCharts.exists_local_root_charts
    P a s hs hmonic hdegree (hcoeff a a.2) (hsimple a a.2)
  refine ⟨fun i x => f i x, Subtype.val ⁻¹' U, hU.preimage continuous_subtype_val, ha, ?_, ?_⟩
  · intro i
    exact ((hf i).continuousOn).comp continuous_subtype_val.continuousOn (fun _ hx => hx)
  · intro x hx z
    exact hex x hx z

/-- Local unique analytic branches identify root projection as a local
homeomorphism, including after restriction to a parameter subset. -/
theorem polynomial_isLocalHomeomorph
    (P : E → Polynomial ℂ) (s : ℕ) (B : Set E)
    (hdegree : ∀ x, (P x).natDegree ≤ s)
    (hcoeff : ∀ a ∈ B, ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsimple : ∀ a ∈ B, ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    IsLocalHomeomorph (projection (fun (a : B) z => (P a).eval z = 0)) := by
  apply isLocalHomeomorph_of_graphs
  intro e
  obtain ⟨f,hf,hfa,-,huniq⟩ := Source29AnalyticSimpleRoot.exists_local_analytic_root
    P e.1.1 s e.1.2 hdegree (hcoeff _ e.1.1.2) e.2 (hsimple _ e.1.1.2 _ e.2)
  obtain ⟨U,V,hU,hV,ha,hr,f,hf,himage,hgraph⟩ :=
    exists_open_root_graph P e.1.1 e.1.2 ⟨f,hf,hfa,huniq⟩
  refine ⟨Subtype.val ⁻¹' U, V, hU.preimage continuous_subtype_val, hV, ha, hr,
    fun x => f x, ?_, ?_, ?_⟩
  · exact hf.comp continuous_subtype_val.continuousOn (fun _ hx => hx)
  · intro x hx
    exact himage x hx
  · intro x hx z hz
    exact hgraph x hx z hz

end
end Source29RootCover

/- Component: RootBallLabels.inc -/

namespace Source29RootCover

open Filter Topology Function
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- Radial lifting labels all roots continuously on a ball without requiring
any individual root formula. Distinctness follows from uniqueness of lifts. -/
theorem exists_continuous_root_labels_on_ball
    (P : E → Polynomial ℂ) (s : ℕ) (hs : 0 < s) (c : E) (R : ℝ) (hR : 0 < R)
    (hmonic : ∀ x, (P x).Monic) (hdegree : ∀ x, (P x).natDegree = s)
    (hcoeff : ∀ a ∈ Metric.ball c R, ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsimple : ∀ a ∈ Metric.ball c R, ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    ∃ w : Fin s → C(Metric.ball c R, ℂ),
      (∀ x : Metric.ball c R, Function.Injective (fun i => w i x)) ∧
      (∀ x : Metric.ball c R, (List.ofFn (fun i => w i x) : Multiset ℂ) = (P x).roots) ∧
      (∀ (x : Metric.ball c R) z, (P x).eval z = 0 ↔ ∃ i, w i x = z) := by
  classical
  let B := Metric.ball c R
  let rel : B → ℂ → Prop := fun a z => (P a).eval z = 0
  let cB : B := ⟨c, Metric.mem_ball_self hR⟩
  have hhomeo : IsLocalHomeomorph (projection rel) :=
    polynomial_isLocalHomeomorph P s B (fun x => (hdegree x).le) hcoeff hsimple
  have hcover : Source29RadialLift.HasLocalSections (projection rel) :=
    polynomial_hasLocalSections P s hs B hmonic hdegree hcoeff hsimple
  obtain ⟨r,U,hU,hcU,-,hrinj,hrroots,hrex⟩ :=
    Source29RootLocalCharts.exists_local_root_charts P c s hs hmonic hdegree
      (hcoeff c cB.2) (hsimple c cB.2)
  let e (i : Fin s) : RootSpace rel := ⟨(cB,r i c), (hrex c hcU (r i c)).mpr ⟨i,rfl⟩⟩
  have hlift (i : Fin s) := Source29RadialLift.exists_continuous_section_on_ball
    c R hR (projection rel) hhomeo hcover (e i) rfl
  choose S hS hS0 using hlift
  let w (i : Fin s) : C(B,ℂ) :=
    ⟨fun x => (S i x).1.2, continuous_snd.comp (continuous_subtype_val.comp (S i).continuous)⟩
  have hproj (i : Fin s) (x : B) : (S i x).1.1 = x := congrFun (hS i) x
  have hroot (i : Fin s) (x : B) : (P x).eval (w i x) = 0 := by
    have h := (S i x).2
    change (P (S i x).1.1).eval (w i x) = 0 at h
    simpa only [hproj i x] using h
  have hinj (x : B) : Function.Injective (fun i => w i x) := by
    letI : PreconnectedSpace B := Subtype.preconnectedSpace (convex_ball c R).isPreconnected
    intro i j hij
    by_contra hne
    have hseed : S i cB ≠ S j cB := by
      rw [hS0 i, hS0 j]
      intro heq
      have heq' : r i c = r j c := congrArg (fun q : RootSpace rel => q.1.2) heq
      exact hne (hrinj c hcU heq')
    apply Source29RadialLift.sections_ne_of_ne_at hhomeo (S i) (S j) (hS i) (hS j) cB hseed x
    apply Subtype.ext
    exact Prod.ext ((hproj i x).trans (hproj j x).symm) hij
  have hmult (x : B) : (List.ofFn (fun i => w i x) : Multiset ℂ) = (P x).roots :=
    Source29RootLocalCharts.roots_eq_of_distinct_full_tuple (P x) s (hmonic x).ne_zero
      (hdegree x).le (fun i => w i x) (hinj x) (fun i => hroot i x)
  exact ⟨w, hinj, hmult, fun x =>
    Source29RootLocalCharts.exhaustive_of_root_multiset (P x) s (hmonic x).ne_zero
      (fun i => w i x) (hmult x)⟩

/-- Give a root label an arbitrary total extension outside its parameter set. -/
def extendLabel (B : Set E) (w : C(B,ℂ)) : E → ℂ := by
  classical
  exact fun x => if hx : x ∈ B then w ⟨x,hx⟩ else 0

lemma extendLabel_apply (B : Set E) (w : C(B,ℂ)) (x : B) :
    extendLabel B w x = w x := by
  simp [extendLabel, x.2]

lemma continuousOn_extendLabel (B : Set E) (w : C(B,ℂ)) :
    ContinuousOn (extendLabel B w) B := by
  rw [continuousOn_iff_continuous_domRestrict]
  convert w.continuous using 1
  funext x
  exact extendLabel_apply B w x

/-- A monic analytic family with simple roots on a ball has globally defined
analytic labels there, with every root represented exactly once. -/
theorem exists_analytic_root_labels_on_ball
    (P : E → Polynomial ℂ) (s : ℕ) (hs : 0 < s) (c : E) (R : ℝ) (hR : 0 < R)
    (hmonic : ∀ x, (P x).Monic) (hdegree : ∀ x, (P x).natDegree = s)
    (hcoeff : ∀ a ∈ Metric.ball c R, ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (hsimple : ∀ a ∈ Metric.ball c R, ∀ z, (P a).eval z = 0 → (P a).derivative.eval z ≠ 0) :
    ∃ f : Fin s → E → ℂ,
      (∀ i, AnalyticOnNhd ℂ (f i) (Metric.ball c R)) ∧
      (∀ x ∈ Metric.ball c R, Function.Injective (fun i => f i x)) ∧
      (∀ x ∈ Metric.ball c R,
        (List.ofFn (fun i => f i x) : Multiset ℂ) = (P x).roots) ∧
      (∀ x ∈ Metric.ball c R, ∀ z, (P x).eval z = 0 ↔ ∃ i, f i x = z) := by
  classical
  obtain ⟨w,hinj,hmult,hex⟩ := exists_continuous_root_labels_on_ball
    P s hs c R hR hmonic hdegree hcoeff hsimple
  let f (i : Fin s) := extendLabel (Metric.ball c R) (w i)
  have heq (i : Fin s) (x : Metric.ball c R) : f i x = w i x :=
    extendLabel_apply _ _ x
  have hroot (i : Fin s) (x : E) (hx : x ∈ Metric.ball c R) : (P x).eval (f i x) = 0 := by
    rw [heq i ⟨x,hx⟩]
    exact (hex ⟨x,hx⟩ _).mpr ⟨i,rfl⟩
  refine ⟨f, ?_, ?_, ?_, ?_⟩
  · intro i a ha
    apply Source29RootSectionAnalytic.analyticAt_of_continuous_root_choice P (f i) a
    · exact (continuousOn_extendLabel _ _).continuousAt (Metric.isOpen_ball.mem_nhds ha)
    · filter_upwards [Metric.isOpen_ball.mem_nhds ha] with x hx
      exact hroot i x hx
    · obtain ⟨g,hg,-,-,huniq⟩ := Source29AnalyticSimpleRoot.exists_local_analytic_root
        P a s (f i a) (fun x => (hdegree x).le) (hcoeff a ha)
        (hroot i a ha) (hsimple a ha _ (hroot i a ha))
      exact ⟨g,hg,huniq⟩
  · intro x hx
    have heqx (i : Fin s) : f i x = w i ⟨x,hx⟩ := heq i ⟨x,hx⟩
    simpa only [heqx] using hinj ⟨x,hx⟩
  · intro x hx
    have heqx (i : Fin s) : f i x = w i ⟨x,hx⟩ := heq i ⟨x,hx⟩
    simpa only [heqx] using hmult ⟨x,hx⟩
  · intro x hx z
    have heqx (i : Fin s) : f i x = w i ⟨x,hx⟩ := heq i ⟨x,hx⟩
    simpa only [heqx] using hex ⟨x,hx⟩ z

end
end Source29RootCover

/- Component: QuadraticTaylorLimit.inc -/
/- Recover the actual second derivative in the transverse ratio limit. -/
namespace Source29QuadraticTaylorLimit

open Filter
open scoped Topology

noncomputable section

lemma second_deriv_of_quadratic_factor (f g : ℂ → ℂ)
    (hg : AnalyticAt ℂ g 0)
    (hfg : f =ᶠ[𝓝 (0 : ℂ)] (fun z => z^2 * g z)) :
    deriv (deriv f) 0 = 2*g 0 := by
  let K : ℂ → ℂ := fun z => 2*(z*g z) + z^2*deriv g z
  have hfirst : deriv f =ᶠ[𝓝 (0 : ℂ)] K := by
    filter_upwards [hfg.deriv, hg.eventually_analyticAt] with z hz hgz
    rw [hz]
    have hd := ((hasDerivAt_id z).pow 2).mul hgz.differentiableAt.hasDerivAt
    simpa [K, mul_assoc, Pi.mul_def, Pi.pow_def] using hd.deriv
  have hsecond : HasDerivAt K (2*g 0) 0 := by
    have h1 := ((hasDerivAt_id (0 : ℂ)).mul hg.differentiableAt.hasDerivAt).const_mul 2
    have h2 := ((hasDerivAt_id (0 : ℂ)).pow 2).mul hg.deriv.differentiableAt.hasDerivAt
    simpa [K, Pi.add_def, Pi.mul_def, Pi.pow_def] using h1.add h2
  rw [hfirst.deriv_eq]
  exact hsecond.deriv

/-- A quadratic analytic bound determines the normalized real-path limit
as half of the complex second derivative. -/
theorem real_quadratic_ratio_limit (f : ℂ → ℂ)
    (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (C : ℝ)
    (hbound : ∀ᶠ z in 𝓝 (0 : ℂ), ‖f z‖ ≤ C*‖z‖^2) :
    Tendsto (fun t : ℝ => f (t : ℂ) / ((t^2 : ℝ) : ℂ))
      (𝓝[≠] (0 : ℝ)) (𝓝 (deriv (deriv f) 0 / 2)) := by
  have hreal : ∀ᶠ z in 𝓝 (0 : ℂ), (f z).re ≤ C*‖z‖^2 :=
    hbound.mono (fun z hz => (Complex.re_le_norm (f z)).trans hz)
  obtain ⟨g, hg, hfg⟩ := Source29OneSidedOrder.exists_analytic_factor_of_one_sided_bound
    f hf hf0 2 C hreal
  have hsecond := second_deriv_of_quadratic_factor f g hg hfg
  have hpath : Tendsto (fun t : ℝ => (t : ℂ)) (𝓝[≠] (0 : ℝ)) (𝓝 (0 : ℂ)) := by
    simpa using (Complex.continuous_ofReal.tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
  have heq : (fun t : ℝ => f (t : ℂ) / ((t^2 : ℝ) : ℂ)) =ᶠ[𝓝[≠] (0 : ℝ)]
      (fun t => g (t : ℂ)) := by
    filter_upwards [hpath.eventually hfg, self_mem_nhdsWithin] with t ht hne
    have htne : t ≠ 0 := by simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using hne
    have hcn : (t : ℂ) ≠ 0 := by exact_mod_cast htne
    rw [ht]
    push_cast
    field_simp
  have hlim := hg.continuousAt.tendsto.comp hpath
  rw [hsecond]
  convert hlim.congr' heq.symm using 1 <;> ring

end
end Source29QuadraticTaylorLimit

/- Component: QuadraticDirectionalLimit.inc -/
namespace Source29QuadraticTaylorLimit

open Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

lemma second_deriv_line (f : E → ℂ) (hf : AnalyticAt ℂ f 0) (v : E) :
    deriv (deriv (fun z : ℂ => f (z • v))) 0 =
      fderiv ℂ (fderiv ℂ f) 0 v v := by
  let g : E → ℂ := fun x => fderiv ℂ f x v
  have hpath : Tendsto (fun z : ℂ => z • v) (𝓝 0) (𝓝 (0 : E)) := by
    have hc : Continuous (fun z : ℂ => z • v) := continuous_id.smul continuous_const
    simpa using hc.tendsto (0 : ℂ)
  have hfirst : deriv (fun z : ℂ => f (z • v)) =ᶠ[𝓝 (0 : ℂ)]
      (fun z => g (z • v)) := by
    filter_upwards [hpath.eventually hf.eventually_analyticAt] with z hz
    have hl : HasDerivAt (fun z : ℂ => z • v) v z := by
      simpa using (hasDerivAt_id z).smul_const v
    exact (hz.differentiableAt.hasFDerivAt.comp_hasDerivAt z hl).deriv
  let ev : (E →L[ℂ] ℂ) →L[ℂ] ℂ := ContinuousLinearMap.apply ℂ ℂ v
  have hg : HasFDerivAt g (ev.comp (fderiv ℂ (fderiv ℂ f) 0)) 0 :=
    ev.hasFDerivAt.comp 0 hf.fderiv.differentiableAt.hasFDerivAt
  have hl : HasDerivAt (fun z : ℂ => z • v) v 0 := by
    simpa using (hasDerivAt_id (0 : ℂ)).smul_const v
  have hd : HasDerivAt (fun z : ℂ => g (z • v))
      (fderiv ℂ (fderiv ℂ f) 0 v v) 0 := by
    have hg' : HasFDerivAt g (ev.comp (fderiv ℂ (fderiv ℂ f) 0)) ((0 : ℂ) • v) := by
      simpa using hg
    exact hg'.comp_hasDerivAt 0 hl
  rw [hfirst.deriv_eq]
  exact hd.deriv

/-- Quadratic analytic growth gives the transverse limit with the actual
iterated Fréchet derivative, in any complex direction. -/
theorem directional_quadratic_ratio_limit (f : E → ℂ)
    (hf : AnalyticAt ℂ f 0) (hf0 : f 0 = 0) (C : ℝ)
    (hbound : ∀ᶠ x in 𝓝 (0 : E), ‖f x‖ ≤ C*‖x‖^2) (v : E) :
    Tendsto (fun t : ℝ => f ((t : ℂ) • v) / ((t^2 : ℝ) : ℂ))
      (𝓝[≠] (0 : ℝ)) (𝓝 (fderiv ℂ (fderiv ℂ f) 0 v v / 2)) := by
  let F : ℂ → ℂ := fun z => f (z • v)
  have hl : AnalyticAt ℂ (fun z : ℂ => z • v) 0 :=
    analyticAt_id.smul analyticAt_const
  have hF : AnalyticAt ℂ F 0 := by
    have hf' : AnalyticAt ℂ f ((0 : ℂ) • v) := by simpa using hf
    exact AnalyticAt.comp (g := f) (f := fun z : ℂ => z • v) (x := 0) hf' hl
  have hF0 : F 0 = 0 := by simpa [F] using hf0
  have hpath : Tendsto (fun z : ℂ => z • v) (𝓝 0) (𝓝 (0 : E)) := by
    simpa using hl.continuousAt.tendsto
  have hb : ∀ᶠ z in 𝓝 (0 : ℂ), ‖F z‖ ≤ (C*‖v‖^2)*‖z‖^2 := by
    filter_upwards [hpath.eventually hbound] with z hz
    simpa only [F, norm_smul, mul_pow, mul_assoc, mul_left_comm, mul_comm] using hz
  have hr := real_quadratic_ratio_limit F hF hF0 (C*‖v‖^2) hb
  rwa [second_deriv_line f hf v] at hr

end
end Source29QuadraticTaylorLimit

/- Component: RadialRootVanishing.inc -/
/- Homogeneity forces the local roots along the radial tangent direction
to vanish, without choosing analytic root labels. -/
namespace Source29RadialRootVanishing

open MvPolynomial Filter
open scoped Topology

noncomputable section

lemma radial_eval_scaling {n : ℕ} (h : MvPolynomial (Fin n) ℂ) (d : ℕ)
    (hh : h.IsHomogeneous d) (z N : Fin n → ℂ) (a w : ℂ) (ha : 1+a ≠ 0) :
    eval (fun i => (1+a)*z i+w*N i) h =
      (1+a)^d * (Source29SlicePolynomial.lineSlice h z N).eval (w/(1+a)) := by
  rw [Source29SlicePolynomial.eval_lineSlice]
  have ht := Source29ProjectiveMaximum.eval_scale_of_isHomogeneous h d hh
    (fun i => z i + w/(1+a)*N i) (1+a)
  have he : (fun i => (1+a)*z i+w*N i) =
      (fun i => (1+a)*(z i+w/(1+a)*N i)) := by
    funext i
    field_simp
    <;> ring
  rw [he]
  exact ht

/-- A small root in a homogeneous radial family must be zero once its fixed
normal-slice complementary factor is nonzero. -/
lemma radial_root_eq_zero {n : ℕ} (h : MvPolynomial (Fin n) ℂ) (d : ℕ)
    (hh : h.IsHomogeneous d) (z N : Fin n → ℂ) (s : ℕ) (g : Polynomial ℂ)
    (hfactor : Source29SlicePolynomial.lineSlice h z N = Polynomial.X^s*g)
    (a w : ℂ) (ha : 1+a ≠ 0) (hg : g.eval (w/(1+a)) ≠ 0)
    (hroot : eval (fun i => (1+a)*z i+w*N i) h = 0) : w = 0 := by
  rw [radial_eval_scaling h d hh z N a w ha, hfactor,
    Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X] at hroot
  have h1 := (mul_eq_zero.mp hroot).resolve_left (pow_ne_zero d ha)
  have h2 := (mul_eq_zero.mp h1).resolve_right hg
  have h3 : w/(1+a) = 0 := eq_zero_of_pow_eq_zero h2
  have h4 := (div_eq_iff ha).mp h3
  simpa using h4

/-- Any finite choice of roots tending to zero vanishes identically near the
origin along the radial line. No regularity of the root labels is required. -/
theorem eventually_radial_roots_zero {n : ℕ} {ι : Type*} [Fintype ι]
    (h : MvPolynomial (Fin n) ℂ) (d : ℕ) (hh : h.IsHomogeneous d)
    (z N : Fin n → ℂ) (s : ℕ) (g : Polynomial ℂ)
    (hfactor : Source29SlicePolynomial.lineSlice h z N = Polynomial.X^s*g)
    (hg0 : g.coeff 0 ≠ 0) (w : ℂ → ι → ℂ)
    (hw : ∀ j, Tendsto (fun a => w a j) (𝓝 (0 : ℂ)) (𝓝 0))
    (hroot : ∀ᶠ a in 𝓝 (0 : ℂ), ∀ j,
      eval (fun i => (1+a)*z i+w a j*N i) h = 0) :
    ∀ᶠ a in 𝓝 (0 : ℂ), ∀ j, w a j = 0 := by
  have ha : ∀ᶠ a in 𝓝 (0 : ℂ), 1+a ≠ 0 := by
    have hc : ContinuousAt (fun a : ℂ => 1+a) 0 := continuousAt_const.add continuousAt_id
    simpa using hc.eventually_ne (by norm_num : (1 : ℂ)+0 ≠ 0)
  have hgne (j : ι) : ∀ᶠ a in 𝓝 (0 : ℂ), g.eval (w a j/(1+a)) ≠ 0 := by
    have hden : Tendsto (fun a : ℂ => 1+a) (𝓝 0) (𝓝 1) := by
      simpa using (tendsto_const_nhds (x := (1 : ℂ)) (f := 𝓝 (0 : ℂ))).add tendsto_id
    have hratio : Tendsto (fun a : ℂ => w a j/(1+a)) (𝓝 0) (𝓝 0) := by
      simpa only [Pi.div_def, zero_div] using (hw j).div hden one_ne_zero
    have hcont : Continuous (fun b : ℂ => g.eval b) := g.continuous
    have hne : ∀ᶠ b in 𝓝 (0 : ℂ), g.eval b ≠ 0 :=
      hcont.continuousAt.eventually_ne (by simpa only [← Polynomial.coeff_zero_eq_eval_zero] using hg0)
    exact hratio.eventually hne
  filter_upwards [ha, hroot, Filter.eventually_all.mpr hgne] with a ha hr hg j
  exact radial_root_eq_zero h d hh z N s g hfactor a (w a j) ha (hg j) (hr j)

end
end Source29RadialRootVanishing

/- Component: RootMeanBounds.inc -/
namespace Source29RootMean

open Filter Finset Source29TransverseTraceBound
open scoped Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [Nonempty ι]

lemma norm_mean_le (w : ι → ℂ) (B : ℝ) (hw : ∀ j, ‖w j‖ ≤ B) :
    ‖mean w‖ ≤ B := by
  have hc : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.mpr Fintype.card_pos
  have hn : ‖(((Fintype.card ι : ℝ) : ℂ))‖ = (Fintype.card ι : ℝ) := by simp
  rw [mean, norm_div, hn]
  apply (div_le_iff₀ hc).mpr
  calc
    ‖∑ j, w j‖ ≤ ∑ j, ‖w j‖ := norm_sum_le _ _
    _ ≤ ∑ _j : ι, B := sum_le_sum (fun j _ => hw j)
    _ = B * (Fintype.card ι : ℝ) := by simp [mul_comm]

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

lemma analyticAt_mean (w : E → ι → ℂ) (a : E)
    (hsum : AnalyticAt ℂ (fun x => ∑ j, w x j) a) :
    AnalyticAt ℂ (fun x => mean (w x)) a := by
  exact hsum.div_const

theorem mean_quadratic_bound (w : E → ι → ℂ) (A : ℝ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ A*‖x‖^2) :
    ∀ᶠ x in 𝓝 (0 : E), ‖mean (w x)‖ ≤ A*‖x‖^2 :=
  hroot.mono (fun x hx => norm_mean_le (w x) _ hx)

/-- The analytic mean automatically has the exact second-order directional
limit required by the transverse maximum argument. -/
theorem mean_directional_ratio_limit (w : E → ι → ℂ) (A : ℝ)
    (hroot : ∀ᶠ x in 𝓝 (0 : E), ∀ j, ‖w x j‖ ≤ A*‖x‖^2)
    (hsum : AnalyticAt ℂ (fun x => ∑ j, w x j) 0) (v : E) :
    Tendsto (fun t : ℝ => mean (w ((t : ℂ) • v)) / ((t^2 : ℝ) : ℂ))
      (𝓝[≠] (0 : ℝ))
      (𝓝 (fderiv ℂ (fderiv ℂ (fun x => mean (w x))) 0 v v / 2)) := by
  have hb := mean_quadratic_bound w A hroot
  have hz : mean (w 0) = 0 := by
    have hh := hb.self_of_nhds
    simpa only [norm_zero, zero_pow (by decide : 2 ≠ 0), mul_zero, norm_le_zero_iff] using hh
  exact Source29QuadraticTaylorLimit.directional_quadratic_ratio_limit
    (fun x => mean (w x)) (analyticAt_mean w 0 hsum) hz A hb v

end
end Source29RootMean

/- Component: PreparedRadialMean.inc -/
/- The radial identity for the actual prepared root family. -/
namespace Source29PreparedRadialMean

open MvPolynomial Filter Source29LocalQuadratic Source29TransverseTraceBound
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}

/-- The prepared polynomial at the base point is the normal slice of h. -/
lemma base_slice_factorization (h : MvPolynomial (Fin n) ℂ)
    (z N : CSpace n) (T : E →ₗᵢ[ℂ] CSpace n)
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i)) T N) :
    Source29SlicePolynomial.lineSlice h (fun i => z i) (fun i => N i) =
      Polynomial.X ^ data.s * data.B 0 := by
  have hb := data.factorization.self_of_nhds
  rw [data.base] at hb
  simpa only [map_zero, PiLp.zero_apply,
    Source29AffinePolynomialChart.lineSlice_translate, Pi.add_def, add_zero] using hb.symm

/-- Homogeneity forces every prepared root on the radial tangent line to be
zero, even when the chosen root functions are not individually analytic. -/
theorem eventually_radial_roots_zero (h : MvPolynomial (Fin n) ℂ)
    (d : ℕ) (hh : h.IsHomogeneous d) (z N : CSpace n)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i)) T N)
    (u : E) (hu : T u = z) :
    ∀ᶠ a in 𝓝 (0 : ℂ), ∀ j, data.roots (a • u) j = 0 := by
  have hpath : Tendsto (fun a : ℂ => a • u) (𝓝 0) (𝓝 (0 : E)) := by
    have hc : Continuous (fun a : ℂ => a • u) := continuous_id.smul continuous_const
    simpa using hc.tendsto (0 : ℂ)
  obtain ⟨A, -, hquad⟩ := data.quadratic_bound
  have hroots (j : Fin data.s) :
      Tendsto (fun a : ℂ => data.roots (a • u) j) (𝓝 0) (𝓝 0) := by
    apply squeeze_zero_norm' ((hpath.eventually hquad).mono (fun a ha => ha j))
    simpa using (tendsto_const_nhds (x := A) (f := 𝓝 (0 : ℂ))).mul (hpath.norm.pow 2)
  have hunit : (data.B 0).coeff 0 ≠ 0 := by
    simpa only [Polynomial.coeff_zero_eq_eval_zero] using data.unit_nonzero.self_of_nhds
  have hactual : ∀ᶠ a in 𝓝 (0 : ℂ), ∀ j,
      eval (fun i => (1+a)*z i + data.roots (a • u) j*N i) h = 0 := by
    filter_upwards [hpath.eventually data.root_original] with a ha j
    have hz := ha j
    rw [Source29PolynomialTranslation.eval_translate] at hz
    have he : (fun i => (1+a)*z i + data.roots (a • u) j*N i) =
        (fun i => z i + (T (a • u) + data.roots (a • u) j • N) i) := by
      rw [map_smul, hu]
      funext i
      change (1+a)*z i + data.roots (a • u) j*N i =
        z i + (a*z i + data.roots (a • u) j*N i)
      ring
    rwa [he]
  exact Source29RadialRootVanishing.eventually_radial_roots_zero h d hh
    (fun i => z i) (fun i => N i) data.s (data.B 0)
    (base_slice_factorization h z N T data) hunit
    (fun a j => data.roots (a • u) j) hroots hactual

/-- The radial entry of the analytic mean's Hessian vanishes. -/
theorem radial_mean_hessian_zero (h : MvPolynomial (Fin n) ℂ)
    (d : ℕ) (hh : h.IsHomogeneous d) (z N : CSpace n)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i)) T N)
    (u : E) (hu : T u = z) :
    fderiv ℂ (fderiv ℂ (fun x => mean (data.roots x))) 0 u u = 0 := by
  letI : NeZero data.s := ⟨Nat.ne_of_gt data.s_pos⟩
  have hf := Source29RootMean.analyticAt_mean data.roots 0 data.sum_analytic
  have hzero : (fun a : ℂ => mean (data.roots (a • u))) =ᶠ[𝓝 (0 : ℂ)]
      (fun _ => (0 : ℂ)) := by
    filter_upwards [eventually_radial_roots_zero h d hh z N T data u hu] with a ha
    simp only [mean, ha, Finset.sum_const_zero, zero_div]
  rw [← Source29QuadraticTaylorLimit.second_deriv_line _ hf u,
    hzero.deriv.deriv_eq]
  simp

end
end Source29PreparedRadialMean

/- Component: PreparedMaximumTrace.inc -/
/- The actual prepared mean has negative transverse contributions at a
strict normalized maximum. Combined with radial homogeneity, its metric
trace cannot vanish. -/
namespace Source29PreparedMaximumTrace

open MvPolynomial Filter Source29TransverseTraceBound
open Source29LocalQuadratic (PreparedRoots)
open Source29LocalMaximumBound
open scoped Topology BigOperators

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] {n : ℕ}

theorem transverse_hessian_bound (h : MvPolynomial (Fin n) ℂ)
    (z : CSpace n) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : quadric z = (κ : ℂ))
    (hbound : ∀ v : CSpace n, eval (fun i => v i) h = 0 →
      Source29ProjectiveMaximum.quadricNorm v ≤ κ * ‖v‖^2)
    (T : E →ₗᵢ[ℂ] CSpace n)
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      T (normal z κ))
    (u : E) (hu : ‖u‖ = 1) (hreal : ∀ i, (T u i).im = 0)
    (hdot : dot z (T u) = 0) :
    (((-κ*(1-κ^2) : ℝ) : ℂ) *
      fderiv ℂ (fderiv ℂ (fun x => mean (data.roots x))) 0 u u).re ≤ κ - 1 := by
  letI : NeZero data.s := ⟨Nat.ne_of_gt data.s_pos⟩
  obtain ⟨A, hA, hquad⟩ := data.quadratic_bound
  have hpath : Tendsto (fun t : ℝ => (t : ℂ) • u) (𝓝 0) (𝓝 (0 : E)) := by
    have hc : Continuous (fun t : ℝ => (t : ℂ) • u) :=
      Complex.continuous_ofReal.smul continuous_const
    simpa using hc.tendsto (0 : ℝ)
  have hr : ∀ᶠ t : ℝ in 𝓝 (0 : ℝ), ∀ j,
      ‖data.roots ((t : ℂ) • u) j‖ ≤ A*t^2 := by
    filter_upwards [hpath.eventually hquad] with t ht j
    simpa only [norm_smul, hu, mul_one, Complex.norm_real, Real.norm_eq_abs,
      sq_abs] using ht j
  have hm : ∀ᶠ t : ℝ in 𝓝 (0 : ℝ), ∀ j,
      κ + t^2 + (((-κ*(1-κ^2) : ℝ) : ℂ) * (data.roots ((t : ℂ) • u) j)^2).re ≤
      κ * (1 + t^2 + 2*(1-κ^2)*(data.roots ((t : ℂ) • u) j).re +
        (1-κ^2)*‖data.roots ((t : ℂ) • u) j‖^2) := by
    filter_upwards [hpath.eventually data.root_original] with t ht j
    have hroot := ht j
    rw [Source29PolynomialTranslation.eval_translate] at hroot
    have hv : eval (fun i => (z + (t : ℂ) • T u +
        data.roots ((t : ℂ) • u) j • normal z κ) i) h = 0 := by
      simpa only [map_smul, PiLp.add_apply, add_assoc] using hroot
    apply Source29TransverseCoordinates.transverse_real_maximum z (T u) κ hz hq hreal
      (by simpa only [T.norm_map] using hu) hdot t (data.roots ((t : ℂ) • u) j)
    exact hbound _ hv
  exact transverse_mean_limit (fun t j => data.roots ((t : ℂ) • u) j)
    κ A hk.le hk1 hA.le hr hm _
    (Source29RootMean.mean_directional_ratio_limit data.roots A hquad data.sum_analytic u)

def tangentMetric (κ : ℝ) : Matrix (Fin 7) (Fin 7) ℂ :=
  fun i j => Source29FullNormalChart.inverseMetric κ i.succ j.succ

lemma tangent_metric_trace (κ : ℝ) (H : Fin 7 → Fin 7 → ℂ) :
    Source29MetricJet.metricTrace (tangentMetric κ) H =
      (κ : ℂ)⁻¹ * H 0 0 + ∑ i : Fin 6, H i.succ i.succ := by
  unfold Source29MetricJet.metricTrace tangentMetric
  simp only [Source29FullNormalChart.inverseMetric_tail, ite_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [Fin.sum_univ_succ]
  simp

/-- For the concrete seven-dimensional tangent chart, the analytic mean
cannot have zero inverse-metric Hessian trace at a strict maximum. -/
theorem prepared_mean_trace_ne_zero (h : MvPolynomial (Fin 8) ℂ)
    (d : ℕ) (hh : h.IsHomogeneous d) (z : CSpace 8)
    (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : quadric z = (κ : ℂ))
    (hbound : ∀ v : CSpace 8, eval (fun i => v i) h = 0 →
      Source29ProjectiveMaximum.quadricNorm v ≤ κ * ‖v‖^2)
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (Source29TangentBasis.tangentEmbedding z κ hk hk1 hz hq) (normal z κ)) :
    Source29AnalyticMeanHessian.hessianTrace (tangentMetric κ)
      (fun i : Fin 7 => EuclideanSpace.single i 1)
      (fun x => mean (data.roots x)) 0 ≠ 0 := by
  let T := Source29TangentBasis.tangentEmbedding z κ hk hk1 hz hq
  let e : Fin 7 → CSpace 7 := fun i => EuclideanSpace.single i 1
  let H : Fin 7 → Fin 7 → ℂ := fun i j =>
    fderiv ℂ (fderiv ℂ (fun x => mean (data.roots x))) 0 (e i) (e j)
  have hradial : H 0 0 = 0 := by
    apply Source29PreparedRadialMean.radial_mean_hessian_zero h d hh z (normal z κ) T data
      (e 0)
    exact Source29TangentBasis.tangentEmbedding_single z κ hk hk1 hz hq 0
  have hneg (i : Fin 6) :
      (((-κ*(1-κ^2) : ℝ) : ℂ) * H i.succ i.succ).re ≤ κ - 1 := by
    apply transverse_hessian_bound h z κ hk hk1 hz hq hbound T data (e i.succ)
    · simp [e, EuclideanSpace.norm_single]
    · have he : T (e i.succ) = Source29TransverseBasis.complexBasisVector z κ hk hk1 hz hq i :=
        Source29TangentBasis.tangentEmbedding_single z κ hk hk1 hz hq i.succ
      rw [he]
      exact Source29TransverseBasis.complexBasisVector_real z κ hk hk1 hz hq i
    · have he : T (e i.succ) = Source29TransverseBasis.complexBasisVector z κ hk hk1 hz hq i :=
        Source29TangentBasis.tangentEmbedding_single z κ hk hk1 hz hq i.succ
      rw [he]
      exact Source29TransverseBasis.complexBasisVector_dot z κ hk hk1 hz hq i
  intro hzero
  have htrace : Source29MetricJet.metricTrace (tangentMetric κ) H = 0 := hzero
  rw [tangent_metric_trace, hradial, mul_zero, zero_add] at htrace
  exact trace_contradiction_of_real_bounds (fun i : Fin 6 => H i.succ i.succ)
    (((-κ*(1-κ^2) : ℝ) : ℂ)) κ hk1 hneg htrace

end
end Source29PreparedMaximumTrace

/- Component: AnalyticSimpleRootUnit.inc -/
/- Factorization at a simple root with its actual nonvanishing analytic unit. -/
namespace Source29AnalyticSimpleRootUnit

open Polynomial Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- A given analytic simple root has a local equation equal to a nonzero
analytic unit times the graph equation w-f(x). The variables are normal first. -/
theorem exists_analytic_unit_at_simple_root
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (f : E → ℂ) (hf : AnalyticAt ℂ f a)
    (hroot : ∀ᶠ x in 𝓝 a, (P x).eval (f x) = 0)
    (hsimple : (P a).derivative.eval (f a) ≠ 0) :
    ∃ U : (ℂ × E) → ℂ, AnalyticAt ℂ U (f a, a) ∧ U (f a, a) ≠ 0 ∧
      (fun y : ℂ × E => (P y.2).eval y.1) =ᶠ[𝓝 (f a, a)]
        (fun y => U y * (y.1 - f y.2)) := by
  let r := f a
  let Q : E → Polynomial ℂ := fun x => taylor r (P x)
  have hQd : ∀ x, (Q x).natDegree ≤ D := by
    intro x
    simpa only [Q, natDegree_taylor] using hdegree x
  have hQa : ∀ k, AnalyticAt ℂ (fun x => (Q x).coeff k) a := by
    intro k
    exact Source29AnalyticSimpleRoot.analyticAt_linear_polynomial_functional P a D
      hdegree hcoeff ((Polynomial.lcoeff ℂ k).comp (taylor r))
  have hzero : (Q a).coeff 0 = 0 := by
    simpa only [Q, taylor_coeff_zero, r] using hroot.self_of_nhds
  have hsimpleQ : (Q a).coeff 1 ≠ 0 := by
    simpa only [Q, taylor_coeff_one, r] using hsimple
  obtain ⟨g, hg⟩ := X_dvd_iff.mpr hzero
  have hg0 : g.coeff 0 ≠ 0 := by
    have he : (Q a).coeff 1 = g.coeff 0 := by rw [hg]; simp
    rwa [he] at hsimpleQ
  have hgn : g ≠ 0 := by intro hz; exact hg0 (by simp [hz])
  have hgd : g.natDegree ≤ D := by
    have hh := hQd a
    rw [hg, natDegree_mul X_ne_zero hgn, natDegree_X] at hh
    omega
  have hd : ∀ᶠ x in 𝓝 a, (Q x).degree < (1+D+1 : WithBot ℕ) := by
    apply Filter.Eventually.of_forall
    intro x
    exact (degree_le_of_natDegree_le (hQd x)).trans_lt
      (by exact_mod_cast (show D < 1+D+1 by omega))
  obtain ⟨W, B, hW, hWa, hBa, hWcoeff, hBcoeff, hBdeg, hBunit, hWB⟩ :=
    Source29LocalPreparation.local_polynomial_preparation Q a 1 D g hgd hg0
      (by simpa using hg) hd (fun i => hQa i)
  have hwlin (x : E) : W x = X + C ((W x).coeff 0) :=
    (hW x).1.eq_X_add_C (hW x).2
  have hpath : Tendsto (fun x : E => (x, f x-r)) (𝓝 a) (𝓝 (a,0)) := by
    simpa only [id_eq, r, sub_self, nhds_prod_eq] using
      tendsto_id.prodMk (hf.continuousAt.tendsto.sub (tendsto_const_nhds (x := r)))
  have hrelation : ∀ᶠ x in 𝓝 a, f x-r+(W x).coeff 0 = 0 := by
    filter_upwards [hroot, hWB, hpath.eventually hBunit] with x hx he hu
    have hqx : (Q x).eval (f x-r) = 0 := by
      simpa only [Q, taylor_eval, sub_add_cancel] using hx
    rw [← he, eval_mul, hwlin, eval_add, eval_X, eval_C] at hqx
    exact (mul_eq_zero.mp hqx).resolve_right hu
  let U : (ℂ × E) → ℂ := fun y => (B y.2).eval (y.1-r)
  have hmap : AnalyticAt ℂ (fun y : ℂ × E => (y.2, y.1-r)) (r,a) :=
    analyticAt_snd.prod (analyticAt_fst.sub analyticAt_const)
  have hU : AnalyticAt ℂ U (r,a) := by
    have hb : AnalyticAt ℂ (fun y : E × ℂ => (B y.1).eval y.2) (a,r-r) := by
      simpa only [sub_self] using
        Source29LocalPreparation.analyticAt_joint_eval B a 0 (D+1) hBdeg hBcoeff
    exact AnalyticAt.comp (g := fun y : E × ℂ => (B y.1).eval y.2)
      (f := fun y : ℂ × E => (y.2, y.1-r)) (x := (r,a)) hb hmap
  refine ⟨U, hU, ?_, ?_⟩
  · simpa only [U, r, sub_self] using hBunit.self_of_nhds
  · have hp : Tendsto (fun y : ℂ × E => y.2) (𝓝 (f a,a)) (𝓝 a) :=
      continuous_snd.tendsto _
    filter_upwards [hp.eventually hWB, hp.eventually hrelation] with y he hr
    have hv := congrArg (fun p : Polynomial ℂ => p.eval (y.1-r)) he
    rw [eval_mul, hwlin, eval_add, eval_X, eval_C] at hv
    have hw : y.1-r+(W y.2).coeff 0 = y.1-f y.2 := by
      linear_combination hr
    rw [hw] at hv
    simpa only [Q, taylor_eval, sub_add_cancel, U, mul_comm] using hv.symm

end
end Source29AnalyticSimpleRootUnit

/- Component: SimpleRootGraphEquation.inc -/
namespace Source29SimpleRootGraphEquation

open Filter Source29MetricJet Source29AnalyticJetRules Source29AnalyticGraphEquation
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
variable {ι : Type*} [Fintype ι]

/-- The graph PDE for an actual analytic simple root of a polynomial family.
The local unit is constructed from polynomial preparation. -/
theorem graph_equation_of_simple_root
    (P : E → Polynomial ℂ) (a : E) (D : ℕ)
    (hdegree : ∀ x, (P x).natDegree ≤ D)
    (hcoeff : ∀ k, AnalyticAt ℂ (fun x => (P x).coeff k) a)
    (f : E → ℂ) (hf : AnalyticAt ℂ f a)
    (hroot : ∀ᶠ x in 𝓝 a, (P x).eval (f x) = 0)
    (hsimple : (P a).derivative.eval (f a) ≠ 0)
    (M : ι → ι → ℂ) (hM : ∀ i j, M i j = M j i)
    (c d : ℂ) (hcd : c*d = 1) (e : ι → E)
    (hL : jetOperator (blockMetric M d) (graphDirections e)
      (fun y : ℂ × E => (P y.2).eval y.1) (f a,a) = 0) :
    let g := fun i => fderiv ℂ f a (e i)
    let H := fun i j => fderiv ℂ (fderiv ℂ f) a (e i) (e j)
    (1 + c * metricPair M g g) * metricTrace M H -
      c * contract H (raiseIndex M g) (raiseIndex M g) = 0 := by
  obtain ⟨U, hU, hU0, hlocal⟩ :=
    Source29AnalyticSimpleRootUnit.exists_analytic_unit_at_simple_root
      P a D hdegree hcoeff f hf hroot hsimple
  exact graph_equation_of_local_unit M hM c d hcd e _ U f (f a,a)
    hf hU rfl hU0 hlocal hL

end
end Source29SimpleRootGraphEquation

/- Component: ChartPolynomialJet.inc -/
/- The polynomial divisibility hypothesis gives the zero implicit operator
in the actual full normal chart. -/
namespace Source29ChartPolynomialJet

open Source29FullNormalChart Source29AnalyticMetricCoordinate Source29AnalyticJetRules
open Source29LocalMaximumBound
open scoped BigOperators

noncomputable section

def chartCLM (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    (Fin 8 → ℂ) →L[ℂ] (Fin 8 → ℂ) :=
  (chart z κ hk hk1 hz hq).toContinuousLinearEquiv.toContinuousLinearMap

lemma coordinateMatrix_chartCLM (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) :
    coordinateMatrix (chartCLM z κ hk hk1 hz hq) = chartMatrix z κ hk hk1 hz hq := by
  rfl

theorem chart_jetOperator_zero (h : MvPolynomial (Fin 8) ℂ)
    (hdiv : h ∣ Source29FactorInheritance.cubicOperator h)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (x : Fin 8 → ℂ)
    (hx : MvPolynomial.eval ((fun i => z i) + chartCLM z κ hk hk1 hz hq x) h = 0) :
    jetOperator (inverseMetric κ) (fun i => Pi.single i 1)
      (fun y => MvPolynomial.eval ((fun i => z i) + chartCLM z κ hk hk1 hz hq y) h) x = 0 := by
  have hA : IsUnit (coordinateMatrix (chartCLM z κ hk hk1 hz hq)).det := by
    rw [coordinateMatrix_chartCLM]
    exact chartMatrix_isUnit_det z κ hk hk1 hz hq
  have he := jetOperator_euclidean_affine_coordinates
    (chartCLM z κ hk hk1 hz hq) hA (fun v => MvPolynomial.eval v h)
    (fun i => z i) x (Source29MvPolynomialJet.analyticAt_eval h _)
  rw [coordinateMatrix_chartCLM, chartMatrix_inverseMetric] at he
  rw [he]
  exact Source29MvPolynomialJet.jetOperator_eval_zero_of_dvd h hdiv _ hx

end
end Source29ChartPolynomialJet

/- Component: MetricReindex.inc -/
namespace Source29MetricReindex

open Source29MetricJet Source29AnalyticJetRules
open scoped BigOperators

noncomputable section

variable {ι η R : Type*} [Fintype ι] [Fintype η] [CommRing R]

lemma sum_two_reindex (e : η ≃ ι) (F : ι → ι → R) :
    (∑ i : η, ∑ j : η, F (e i) (e j)) = ∑ i : ι, ∑ j : ι, F i j := by
  calc
    _ = ∑ i : η, ∑ j : ι, F (e i) j :=
      Finset.sum_congr rfl (fun i _ => e.sum_comp (F (e i)))
    _ = _ := e.sum_comp (fun i => ∑ j : ι, F i j)

lemma raiseIndex_reindex (e : η ≃ ι) (M : ι → ι → R) (g : ι → R) (i : η) :
    raiseIndex (fun i j => M (e i) (e j)) (fun i => g (e i)) i =
      raiseIndex M g (e i) :=
  e.sum_comp (fun j => M (e i) j * g j)

lemma metricPair_reindex (e : η ≃ ι) (M : ι → ι → R) (g b : ι → R) :
    metricPair (fun i j => M (e i) (e j)) (fun i => g (e i)) (fun i => b (e i)) =
      metricPair M g b := sum_two_reindex e (fun i j => M i j * g i * b j)

lemma metricTrace_reindex (e : η ≃ ι) (M H : ι → ι → R) :
    metricTrace (fun i j => M (e i) (e j)) (fun i j => H (e i) (e j)) =
      metricTrace M H := sum_two_reindex e (fun i j => M i j * H i j)

lemma contract_reindex (e : η ≃ ι) (H : ι → ι → R) (g b : ι → R) :
    contract (fun i j => H (e i) (e j)) (fun i => g (e i)) (fun i => b (e i)) =
      contract H g b := sum_two_reindex e (fun i j => H i j * g i * b j)

lemma operator_reindex (e : η ≃ ι) (M H : ι → ι → R) (g : ι → R) :
    operator (fun i j => M (e i) (e j)) (fun i => g (e i))
      (fun i j => H (e i) (e j)) = operator M g H := by
  have hr : raiseIndex (fun i j => M (e i) (e j)) (fun i => g (e i)) =
      (fun i => raiseIndex M g (e i)) := funext (raiseIndex_reindex e M g)
  have hc : contract (fun i j => H (e i) (e j))
      (raiseIndex (fun i j => M (e i) (e j)) (fun i => g (e i)))
      (raiseIndex (fun i j => M (e i) (e j)) (fun i => g (e i))) =
      contract H (raiseIndex M g) (raiseIndex M g) := by
    rw [hr]
    exact contract_reindex e H (raiseIndex M g) (raiseIndex M g)
  exact congrArg₂ (· - ·)
    (congrArg₂ (· * ·) (metricPair_reindex e M g g) (metricTrace_reindex e M H)) hc

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

theorem jetOperator_reindex (e : η ≃ ι) (M : ι → ι → ℂ)
    (v : ι → E) (f : E → ℂ) (x : E) :
    jetOperator (fun i j => M (e i) (e j)) (fun i => v (e i)) f x =
      jetOperator M v f x := by
  unfold jetOperator
  exact operator_reindex (R := ℂ) e M
    (fun i j => fderiv ℂ (fderiv ℂ f) x (v i) (v j))
    (fun i => fderiv ℂ f x (v i))

end
end Source29MetricReindex

/- Component: NormalProductCoordinates.inc -/
namespace Source29NormalProductCoordinates

open Source29FullNormalChart Source29AnalyticGraphEquation Source29MetricJet
open Source29LocalMaximumBound

noncomputable section

def normalIndex : Option (Fin 7) ≃ Fin 8 := (finSuccEquiv' 0).symm

lemma normalIndex_none : normalIndex none = 0 := by simp [normalIndex]

lemma normalIndex_some (i : Fin 7) : normalIndex (some i) = i.succ := by
  simp [normalIndex]

def pack : (ℂ × CSpace 7) →L[ℂ] (Fin 8 → ℂ) :=
  LinearMap.toContinuousLinearMap {
    toFun := fun x => Fin.cons x.1 (fun i => x.2 i)
    map_add' := by
      intro x y
      funext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
    map_smul' := by
      intro a x
      funext i
      refine Fin.cases ?_ (fun j => ?_) i <;> simp
  }

lemma pack_apply (x : ℂ × CSpace 7) : pack x = Fin.cons x.1 (fun i => x.2 i) := rfl

lemma pack_graphDirections (i : Option (Fin 7)) :
    pack (graphDirections (fun j : Fin 7 => EuclideanSpace.single j 1) i) =
      Pi.single (normalIndex i) 1 := by
  cases i with
  | none =>
    rw [normalIndex_none]
    funext j
    refine Fin.cases ?_ (fun k => ?_) j <;>
      simp [pack_apply, graphDirections, Pi.single_apply, Fin.succ_ne_zero]
  | some i =>
    rw [normalIndex_some]
    funext j
    refine Fin.cases ?_ (fun k => ?_) j <;>
      simp [pack_apply, graphDirections, Pi.single_apply, Fin.succ_ne_zero, eq_comm]

lemma inverseMetric_block (κ : ℝ) :
    (fun i j => inverseMetric κ (normalIndex i) (normalIndex j)) =
      blockMetric (Source29PreparedMaximumTrace.tangentMetric κ) (normalWeight κ)⁻¹ := by
  funext i j
  cases i <;> cases j <;>
    simp [normalIndex_none, normalIndex_some, blockMetric,
      Source29PreparedMaximumTrace.tangentMetric, inverseMetric, metricWeights,
      Fin.succ_ne_zero, eq_comm]

end
end Source29NormalProductCoordinates

/- Component: NormalSliceGraphEquation.inc -/
/- The graph equation for actual simple roots in the normalized tangent chart. -/
namespace Source29NormalSliceGraphEquation

open Source29LocalMaximumBound Source29TangentBasis Source29FullNormalChart
open Source29ChartPolynomialJet Source29NormalProductCoordinates
open Source29AnalyticJetRules Source29AnalyticGraphEquation Source29MetricJet
open Filter
open scoped Topology BigOperators

noncomputable section

def normalSlice (h : MvPolynomial (Fin 8) ℂ) (z : CSpace 8) (κ : ℝ)
    (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (x : CSpace 7) : Polynomial ℂ :=
  Source29SlicePolynomial.lineSlice
    (Source29PolynomialTranslation.translate h (fun i => z i))
    (fun i => tangentEmbedding z κ hk hk1 hz hq x i) (fun i => normal z κ i)

lemma normalSlice_eval (h : MvPolynomial (Fin 8) ℂ) (z : CSpace 8) (κ : ℝ)
    (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (y : ℂ × CSpace 7) :
    (normalSlice h z κ hk hk1 hz hq y.2).eval y.1 =
      MvPolynomial.eval ((fun i => z i) + chartCLM z κ hk hk1 hz hq (pack y)) h := by
  unfold normalSlice
  rw [Source29SlicePolynomial.eval_lineSlice, Source29PolynomialTranslation.eval_translate]
  have hp : chartCLM z κ hk hk1 hz hq (pack y) =
      fun i => (tangentEmbedding z κ hk hk1 hz hq y.2 + y.1 • normal z κ) i := by
    change chart z κ hk hk1 hz hq (Fin.cons y.1 (fun i => y.2 i)) = _
    exact chart_cons z κ hk hk1 hz hq y.1 (fun i => y.2 i)
  rw [hp]
  rfl

lemma normalSlice_coeff_analytic (h : MvPolynomial (Fin 8) ℂ) (z : CSpace 8) (κ : ℝ)
    (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (a : CSpace 7) (k : ℕ) :
    AnalyticAt ℂ (fun x => (normalSlice h z κ hk hk1 hz hq x).coeff k) a := by
  apply Source29SliceAnalytic.analyticAt_lineSlice_coeff
  intro i
  exact ((EuclideanSpace.proj i).comp
    (tangentEmbedding z κ hk hk1 hz hq).toContinuousLinearMap).analyticAt a

theorem normalSlice_jet_zero (h : MvPolynomial (Fin 8) ℂ)
    (hdiv : h ∣ Source29FactorInheritance.cubicOperator h)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (y : ℂ × CSpace 7)
    (hy : (normalSlice h z κ hk hk1 hz hq y.2).eval y.1 = 0) :
    jetOperator (blockMetric (Source29PreparedMaximumTrace.tangentMetric κ) (normalWeight κ)⁻¹)
      (graphDirections (fun i : Fin 7 => EuclideanSpace.single i 1))
      (fun p : ℂ × CSpace 7 => (normalSlice h z κ hk hk1 hz hq p.2).eval p.1) y = 0 := by
  let F : (Fin 8 → ℂ) → ℂ := fun x =>
    MvPolynomial.eval ((fun i => z i) + chartCLM z κ hk hk1 hz hq x) h
  have hF : AnalyticAt ℂ F (pack y) := by
    exact AnalyticAt.comp (g := fun v => MvPolynomial.eval v h)
      (f := fun x => (fun i => z i) + chartCLM z κ hk hk1 hz hq x) (x := pack y)
      (Source29MvPolynomialJet.analyticAt_eval h _)
      (analyticAt_const.add ((chartCLM z κ hk hk1 hz hq).analyticAt _))
  have hfuneq : (fun p : ℂ × CSpace 7 => (normalSlice h z κ hk hk1 hz hq p.2).eval p.1) =
      (fun p => F (pack p)) := funext (normalSlice_eval h z κ hk hk1 hz hq)
  rw [hfuneq]
  have he := jetOperator_affine
    (blockMetric (Source29PreparedMaximumTrace.tangentMetric κ) (normalWeight κ)⁻¹)
    (graphDirections (fun i : Fin 7 => EuclideanSpace.single i 1)) F pack 0 y
    (by simpa only [zero_add] using hF)
  simp only [zero_add, pack_graphDirections] at he
  rw [he, ← inverseMetric_block κ,
    Source29MetricReindex.jetOperator_reindex normalIndex (inverseMetric κ)
      (fun i => Pi.single i 1) F (pack y)]
  apply chart_jetOperator_zero h hdiv z κ hk hk1 hz hq (pack y)
  rwa [normalSlice_eval] at hy

/-- The implicit polynomial equation itself supplies the PDE for any local
analytic simple root; no graph-PDE premise is assumed. -/
theorem normalSlice_graph_equation (h : MvPolynomial (Fin 8) ℂ)
    (hdiv : h ∣ Source29FactorInheritance.cubicOperator h)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (f : CSpace 7 → ℂ) (a : CSpace 7) (hf : AnalyticAt ℂ f a)
    (hroot : ∀ᶠ x in 𝓝 a, (normalSlice h z κ hk hk1 hz hq x).eval (f x) = 0)
    (hsimple : (normalSlice h z κ hk hk1 hz hq a).derivative.eval (f a) ≠ 0) :
    let M := Source29PreparedMaximumTrace.tangentMetric κ
    let e := fun i : Fin 7 => EuclideanSpace.single i 1
    let g := fun i => fderiv ℂ f a (e i)
    let H := fun i j => fderiv ℂ (fderiv ℂ f) a (e i) (e j)
    (1 + normalWeight κ * metricPair M g g) * metricTrace M H -
      normalWeight κ * contract H (raiseIndex M g) (raiseIndex M g) = 0 := by
  apply Source29SimpleRootGraphEquation.graph_equation_of_simple_root
    (normalSlice h z κ hk hk1 hz hq) a
    (Source29PolynomialTranslation.translate h (fun i => z i)).totalDegree
    (fun x => Source29SlicePolynomial.natDegree_lineSlice_le _ _ _)
    (normalSlice_coeff_analytic h z κ hk hk1 hz hq a) f hf hroot hsimple
    (Source29PreparedMaximumTrace.tangentMetric κ)
    (fun i j => inverseMetric_symmetric κ i.succ j.succ)
    (normalWeight κ) (normalWeight κ)⁻¹
    (mul_inv_cancel₀ (normalWeight_ne_zero κ hk hk1))
    (fun i : Fin 7 => EuclideanSpace.single i 1)
  exact normalSlice_jet_zero h hdiv z κ hk hk1 hz hq (f a,a) hroot.self_of_nhds

end
end Source29NormalSliceGraphEquation

/- Component: NormalSliceExceptional.inc -/
/- Discriminant-free shrinking balls for the actual normal polynomial family. -/
namespace Source29NormalSliceExceptional

open MvPolynomial Source29LocalMaximumBound Source29TangentBasis Source29FullNormalChart
open Source29NormalSliceGraphEquation Source29AffinePolynomialChart
open Source29LocalQuadratic (PreparedRoots)

noncomputable section

lemma specialized_chart_eq_normalSlice (h : MvPolynomial (Fin 8) ℂ)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1) (hz : ‖z‖ = 1)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ)) (x : CSpace 7) :
    Polynomial.map (eval (fun i => x i))
      (curriedChart (chart z κ hk hk1 hz hq) (fun i => z i) h) =
        normalSlice h z κ hk hk1 hz hq x := by
  rw [specialize_curriedChart_eq_lineSlice, chart_cons_zero, chart_normal]
  unfold normalSlice
  rw [lineSlice_translate]

theorem exists_exceptional_polynomial (h : MvPolynomial (Fin 8) ℂ)
    (hirr : Irreducible h) (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (tangentEmbedding z κ hk hk1 hz hq) (normal z κ)) :
    ∃ D : MvPolynomial (Fin 7) ℂ, D ≠ 0 ∧ ∀ x : CSpace 7,
      eval (fun i => x i) D ≠ 0 → ∀ w : ℂ,
      (normalSlice h z κ hk hk1 hz hq x).eval w = 0 →
      (normalSlice h z κ hk hk1 hz hq x).derivative.eval w ≠ 0 := by
  have hunit : (data.B 0).coeff 0 ≠ 0 := by
    simpa only [Polynomial.coeff_zero_eq_eval_zero] using data.unit_nonzero.self_of_nhds
  have hbase : Source29SlicePolynomial.lineSlice
      (Source29PolynomialTranslation.translate h (fun i => z i)) 0
      (chart z κ hk hk1 hz hq (Fin.cons 1 (0 : Fin 7 → ℂ))) =
        Polynomial.X^data.s * data.B 0 := by
    rw [chart_normal]
    have he := data.factorization.self_of_nhds
    simpa only [map_zero, PiLp.zero_apply, Pi.zero_def, data.base] using he.symm
  obtain ⟨D, B, C, hD, hcert⟩ := exists_chart_exceptional_polynomial
    (chart z κ hk hk1 hz hq) (fun i => z i) h hirr data.s data.s_pos (data.B 0) hunit hbase
  refine ⟨D, hD, ?_⟩
  intro x hx w hw
  have hs := Source29WholeSliceBezout.separable_map_of_bezout _ D B C hcert
    (eval (fun i => x i)) hx
  rw [specialized_chart_eq_normalSlice] at hs
  simpa only [Polynomial.eval₂_id] using
    hs.eval₂_derivative_ne_zero (RingHom.id ℂ) (by simpa only [Polynomial.eval₂_id] using hw)

/-- Every strict maximum with an irreducible defining polynomial admits a
ray and shrinking balls where every normal-slice root is simple. -/
theorem exists_simple_slice_balls (h : MvPolynomial (Fin 8) ℂ)
    (hirr : Irreducible h) (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (tangentEmbedding z κ hk hk1 hz hq) (normal z κ)) :
    ∃ v : CSpace 7, ∃ ε δ : ℝ, 0 < ε ∧ 0 < δ ∧
      ∀ t : ℝ, 0 < t → t < δ → ∀ x : CSpace 7,
      ‖x - (t : ℂ) • v‖ ≤ ε*t → ∀ w : ℂ,
      (normalSlice h z κ hk hk1 hz hq x).eval w = 0 →
      (normalSlice h z κ hk hk1 hz hq x).derivative.eval w ≠ 0 := by
  obtain ⟨D, hD, hs⟩ := exists_exceptional_polynomial h hirr z κ hk hk1 hz hq data
  obtain ⟨v, ε, δ, hε, hδ, hballs⟩ :=
    Source29PolynomialNonvanishingCone.exists_nonzero_shrinking_balls D hD
  exact ⟨v, ε, δ, hε, hδ, fun t ht htδ x hx => hs x (hballs t ht htδ x hx)⟩

end
end Source29NormalSliceExceptional

/- Component: ShrinkingBallControl.inc -/
namespace Source29ShrinkingBallControl

open Filter
open scoped Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

lemma norm_le_on_shrinking_ball (v x : E) (ε t : ℝ) (ht : 0 ≤ t)
    (hx : ‖x - (t : ℂ) • v‖ ≤ ε*t) : ‖x‖ ≤ (‖v‖+ε)*t := by
  have hnorm : ‖(t : ℂ) • v‖ = t * ‖v‖ := by
    rw [norm_smul]
    simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht]
  calc
    ‖x‖ = ‖(x - (t : ℂ) • v) + (t : ℂ) • v‖ := by rw [sub_add_cancel]
    _ ≤ ‖x - (t : ℂ) • v‖ + ‖(t : ℂ) • v‖ := norm_add_le _ _
    _ ≤ ε*t + t*‖v‖ := by
      rw [hnorm]
      exact add_le_add hx le_rfl
    _ = (‖v‖+ε)*t := by ring

/-- Every neighborhood property holds uniformly on sufficiently small
balls whose radius and center are both proportional to a positive scale. -/
theorem eventually_on_shrinking_balls (v : E) (ε : ℝ) (hε : 0 < ε)
    (P : E → Prop) (hP : ∀ᶠ x in 𝓝 (0 : E), P x) :
    ∀ᶠ t : ℝ in 𝓝 0, 0 < t → ∀ x : E,
      ‖x - (t : ℂ) • v‖ ≤ ε*t → P x := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hP
  have hb : 0 < ‖v‖+ε := add_pos_of_nonneg_of_pos (norm_nonneg v) hε
  have hδ : 0 < r/(‖v‖+ε) := div_pos hr hb
  filter_upwards [eventually_lt_nhds hδ] with t ht htpos x hx
  apply hball
  rw [Metric.mem_ball, dist_zero_right]
  exact (norm_le_on_shrinking_ball v x ε t htpos.le hx).trans_lt
    (by simpa [mul_comm] using (lt_div_iff₀ hb).mp ht)

theorem quadratic_bound_on_shrinking_ball (v x : E) (ε t A : ℝ)
    (hε : 0 ≤ ε) (ht : 0 ≤ t) (hA : 0 ≤ A)
    (hx : ‖x - (t : ℂ) • v‖ ≤ ε*t) (w : ℂ) (hw : ‖w‖ ≤ A*‖x‖^2) :
    ‖w‖ ≤ (A*(‖v‖+ε)^2)*t^2 := by
  have hn := norm_le_on_shrinking_ball v x ε t ht hx
  have hs := (sq_le_sq₀ (norm_nonneg x)
    (mul_nonneg (add_nonneg (norm_nonneg v) hε) ht)).mpr hn
  calc
    ‖w‖ ≤ A*‖x‖^2 := hw
    _ ≤ A*((‖v‖+ε)*t)^2 := mul_le_mul_of_nonneg_left hs hA
    _ = (A*(‖v‖+ε)^2)*t^2 := by ring

end
end Source29ShrinkingBallControl

/- Component: PreparedBallSheets.inc -/
namespace Source29PreparedBallSheets

open Source29LocalMaximumBound Source29TangentBasis Source29NormalSliceGraphEquation
open Source29LocalQuadratic (PreparedRoots)
open scoped BigOperators

noncomputable section

/-- On any ball where preparation holds and the full slice has simple roots,
the prepared roots admit analytic labels with their original mean and bound. -/
theorem exists_analytic_sheets_on_ball (h : MvPolynomial (Fin 8) ℂ)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (tangentEmbedding z κ hk hk1 hz hq) (normal z κ))
    (a : CSpace 7) (R A : ℝ) (hR : 0 < R)
    (hcoeff : ∀ x ∈ Metric.ball a R, ∀ k,
      AnalyticAt ℂ (fun y => (data.W y).coeff k) x)
    (hfactor : ∀ x ∈ Metric.ball a R,
      data.W x * data.B x = normalSlice h z κ hk hk1 hz hq x)
    (hquad : ∀ x ∈ Metric.ball a R, ∀ j, ‖data.roots x j‖ ≤ A*‖x‖^2)
    (hsimple : ∀ x ∈ Metric.ball a R, ∀ w : ℂ,
      (normalSlice h z κ hk hk1 hz hq x).eval w = 0 →
      (normalSlice h z κ hk hk1 hz hq x).derivative.eval w ≠ 0) :
    ∃ f : Fin data.s → CSpace 7 → ℂ,
      (∀ j, AnalyticOnNhd ℂ (f j) (Metric.ball a R)) ∧
      (∀ x ∈ Metric.ball a R, (∑ j, f j x) = ∑ j, data.roots x j) ∧
      (∀ x ∈ Metric.ball a R, ∀ j, ‖f j x‖ ≤ A*‖x‖^2) ∧
      (∀ x ∈ Metric.ball a R, ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).eval (f j x) = 0) ∧
      (∀ x ∈ Metric.ball a R, ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).derivative.eval (f j x) ≠ 0) := by
  have hfull (x : CSpace 7) (hx : x ∈ Metric.ball a R) (w : ℂ)
      (hw : (data.W x).eval w = 0) :
      (normalSlice h z κ hk hk1 hz hq x).eval w = 0 := by
    rw [← hfactor x hx, Polynomial.eval_mul, hw, zero_mul]
  have hsimpleW : ∀ x ∈ Metric.ball a R, ∀ w : ℂ,
      (data.W x).eval w = 0 → (data.W x).derivative.eval w ≠ 0 := by
    intro x hx w hw hd
    apply hsimple x hx w (hfull x hx w hw)
    rw [← hfactor x hx, Polynomial.derivative_mul, Polynomial.eval_add,
      Polynomial.eval_mul, Polynomial.eval_mul, hd, hw]
    ring
  obtain ⟨f, hf, hinj, hmult, hex⟩ :=
    Source29RootCover.exists_analytic_root_labels_on_ball data.W data.s data.s_pos a R hR
      (fun x => (data.monic_degree x).1) (fun x => (data.monic_degree x).2) hcoeff hsimpleW
  have hrootW (x : CSpace 7) (hx : x ∈ Metric.ball a R) (j : Fin data.s) :
      (data.W x).eval (f j x) = 0 := (hex x hx (f j x)).mpr ⟨j,rfl⟩
  refine ⟨f, hf, ?_, ?_, ?_, ?_⟩
  · intro x hx
    have he := congrArg Multiset.sum ((hmult x hx).trans (data.root_multiset x).symm)
    simpa only [Multiset.sum_coe, List.sum_ofFn] using he
  · intro x hx j
    have hm : f j x ∈ (List.ofFn (data.roots x) : Multiset ℂ) := by
      rw [data.root_multiset, ← hmult x hx]
      exact List.mem_ofFn.mpr ⟨j,rfl⟩
    obtain ⟨k, hk⟩ := List.mem_ofFn.mp hm
    rw [← hk]
    exact hquad x hx k
  · intro x hx j
    exact hfull x hx (f j x) (hrootW x hx j)
  · intro x hx j
    exact hsimple x hx (f j x) (hfull x hx (f j x) (hrootW x hx j))

end
end Source29PreparedBallSheets

/- Component: PreparedShrinkingSheets.inc -/
namespace Source29PreparedShrinkingSheets

open Source29LocalMaximumBound Source29TangentBasis Source29NormalSliceGraphEquation
open Source29LocalQuadratic (PreparedRoots)
open Filter
open scoped Topology BigOperators

noncomputable section

theorem exists_shrinking_sheet_family (h : MvPolynomial (Fin 8) ℂ)
    (hirr : Irreducible h) (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (tangentEmbedding z κ hk hk1 hz hq) (normal z κ)) :
    ∃ (v : CSpace 7) (ε A : ℝ) (f : ℝ → Fin data.s → CSpace 7 → ℂ),
      0 < ε ∧ 0 < A ∧ ∀ᶠ t : ℝ in 𝓝[>] 0,
      (∀ j, AnalyticOnNhd ℂ (f t j) (Metric.ball ((t : ℂ) • v) (ε*t))) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), (∑ j, f t j x) = ∑ j, data.roots x j) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j, ‖f t j x‖ ≤ A*‖x‖^2) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).eval (f t j x) = 0) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).derivative.eval (f t j x) ≠ 0) := by
  obtain ⟨v, ε, δ, hε, hδ, hsimple⟩ :=
    Source29NormalSliceExceptional.exists_simple_slice_balls h hirr z κ hk hk1 hz hq data
  obtain ⟨A, hA, hquad⟩ := data.quadratic_bound
  have hcoeff := Source29AnalyticSimpleRoot.eventually_analytic_coefficients data.W 0 data.s
    (fun x => (data.monic_degree x).2.le) data.coefficients_analytic
  have hcb := Source29ShrinkingBallControl.eventually_on_shrinking_balls v ε hε _ hcoeff
  have hfb := Source29ShrinkingBallControl.eventually_on_shrinking_balls v ε hε _ data.factorization
  have hqb := Source29ShrinkingBallControl.eventually_on_shrinking_balls v ε hε _ hquad
  have hex : ∀ᶠ t : ℝ in 𝓝[>] 0, ∃ g : Fin data.s → CSpace 7 → ℂ,
      (∀ j, AnalyticOnNhd ℂ (g j) (Metric.ball ((t : ℂ) • v) (ε*t))) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), (∑ j, g j x) = ∑ j, data.roots x j) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j, ‖g j x‖ ≤ A*‖x‖^2) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).eval (g j x) = 0) ∧
      (∀ x ∈ Metric.ball ((t : ℂ) • v) (ε*t), ∀ j,
        (normalSlice h z κ hk hk1 hz hq x).derivative.eval (g j x) ≠ 0) := by
    filter_upwards [self_mem_nhdsWithin,
      (eventually_lt_nhds hδ).filter_mono nhdsWithin_le_nhds,
      hcb.filter_mono nhdsWithin_le_nhds, hfb.filter_mono nhdsWithin_le_nhds,
      hqb.filter_mono nhdsWithin_le_nhds] with t ht htδ hc hf hqbnd
    have htpos : 0 < t := ht
    apply Source29PreparedBallSheets.exists_analytic_sheets_on_ball
      h z κ hk hk1 hz hq data ((t : ℂ) • v) (ε*t) A (mul_pos hε htpos)
    · intro x hx
      exact hc htpos x (by simpa only [dist_eq_norm] using (Metric.mem_ball.mp hx).le)
    · intro x hx
      exact hf htpos x (by simpa only [dist_eq_norm] using (Metric.mem_ball.mp hx).le)
    · intro x hx
      exact hqbnd htpos x (by simpa only [dist_eq_norm] using (Metric.mem_ball.mp hx).le)
    · intro x hx
      exact hsimple t htpos htδ x (by simpa only [dist_eq_norm] using (Metric.mem_ball.mp hx).le)
  obtain ⟨f, hf⟩ := hex.choice
  exact ⟨v, ε, A, f, hε, hA, hf⟩

end
end Source29PreparedShrinkingSheets

/- Component: PreparedMeanTraceZero.inc -/
namespace Source29PreparedMeanTraceZero

open Source29LocalMaximumBound Source29TangentBasis Source29NormalSliceGraphEquation
open Source29PreparedMaximumTrace Source29TransverseTraceBound
open Source29LocalQuadratic (PreparedRoots)
open Filter
open scoped Topology BigOperators

noncomputable section

theorem prepared_mean_trace_zero (h : MvPolynomial (Fin 8) ℂ)
    (hirr : Irreducible h) (hdiv : h ∣ Source29FactorInheritance.cubicOperator h)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (data : PreparedRoots (Source29PolynomialTranslation.translate h (fun i => z i))
      (tangentEmbedding z κ hk hk1 hz hq) (normal z κ)) :
    Source29AnalyticMeanHessian.hessianTrace (tangentMetric κ)
      (fun i : Fin 7 => EuclideanSpace.single i 1)
      (fun x => mean (data.roots x)) 0 = 0 := by
  letI : NeZero data.s := ⟨Nat.ne_of_gt data.s_pos⟩
  obtain ⟨v, ε, A, f, hε, hA, hfamily⟩ :=
    Source29PreparedShrinkingSheets.exists_shrinking_sheet_family h hirr z κ hk hk1 hz hq data
  let p : ℝ → CSpace 7 := fun t => (t : ℂ) • v
  let e : Fin 7 → CSpace 7 := fun i => EuclideanSpace.single i 1
  let μ : CSpace 7 → ℂ := fun x => mean (data.roots x)
  let B := A*(‖v‖+ε/2)^2
  have hpos : ∀ᶠ t : ℝ in 𝓝[>] 0, 0 < t := self_mem_nhdsWithin
  have hscale : Tendsto (fun t : ℝ => t) (𝓝[>] 0) (𝓝 0) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hp : Tendsto p (𝓝[>] 0) (𝓝 0) := by
    have hp' : Continuous p := Complex.continuous_ofReal.smul continuous_const
    simpa only [p, Complex.ofReal_zero, zero_smul] using
      (hp'.tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
  have hsub (t : ℝ) (ht : 0 < t) :
      Metric.closedBall (p t) ((ε/2)*t) ⊆ Metric.ball (p t) (ε*t) := by
    intro x hx
    apply Metric.mem_ball.mpr
    exact (Metric.mem_closedBall.mp hx).trans_lt
      (mul_lt_mul_of_pos_right (by linarith : ε/2 < ε) ht)
  have hcenter (t : ℝ) (ht : 0 < t) : p t ∈ Metric.ball (p t) (ε*t) :=
    Metric.mem_ball_self (mul_pos hε ht)
  have hf : ∀ᶠ t : ℝ in 𝓝[>] 0, ∀ j,
      AnalyticOnNhd ℂ (f t j) (Metric.closedBall (p t) ((ε/2)*t)) := by
    filter_upwards [hfamily, hpos] with t ht htpos
    intro j x hx
    exact ht.1 j x (hsub t htpos hx)
  have hb : ∀ᶠ t : ℝ in 𝓝[>] 0, ∀ j, ∀ x ∈ Metric.closedBall (p t) ((ε/2)*t),
      ‖f t j x‖ ≤ B*t^2 := by
    filter_upwards [hfamily, hpos] with t ht htpos j x hx
    exact Source29ShrinkingBallControl.quadratic_bound_on_shrinking_ball
      v x (ε/2) t A (half_pos hε).le htpos.le hA.le
      (by simpa only [p, Metric.mem_closedBall, dist_eq_norm] using hx)
      (f t j x) (ht.2.2.1 x (hsub t htpos hx) j)
  have hμ : AnalyticAt ℂ μ 0 := Source29RootMean.analyticAt_mean data.roots 0 data.sum_analytic
  have hc : (data.s : ℂ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt data.s_pos
  have hsum : ∀ᶠ t : ℝ in 𝓝[>] 0,
      (fun x => ∑ j, f t j x) =ᶠ[𝓝 (p t)] (fun x => (data.s : ℂ)*μ x) := by
    filter_upwards [hfamily, hpos] with t ht htpos
    filter_upwards [Metric.isOpen_ball.mem_nhds (hcenter t htpos)] with x hx
    rw [ht.2.1 x hx]
    simp only [μ, mean, Fintype.card_fin, Complex.ofReal_natCast]
    field_simp
  have hPDE : ∀ j, ∀ᶠ t : ℝ in 𝓝[>] 0,
      let g := fun i => fderiv ℂ (f t j) (p t) (e i)
      let H := fun i k => fderiv ℂ (fderiv ℂ (f t j)) (p t) (e i) (e k)
      (1 + Source29FullNormalChart.normalWeight κ * Source29MetricJet.metricPair (tangentMetric κ) g g) *
        Source29MetricJet.metricTrace (tangentMetric κ) H -
        Source29FullNormalChart.normalWeight κ * Source29MetricJet.contract H
          (Source29MetricJet.raiseIndex (tangentMetric κ) g)
          (Source29MetricJet.raiseIndex (tangentMetric κ) g) = 0 := by
    intro j
    filter_upwards [hfamily, hpos] with t ht htpos
    apply normalSlice_graph_equation h hdiv z κ hk hk1 hz hq (f t j) (p t)
      (ht.1 j (p t) (hcenter t htpos))
    · filter_upwards [Metric.isOpen_ball.mem_nhds (hcenter t htpos)] with x hx
      exact ht.2.2.2.1 x hx j
    · exact ht.2.2.2.2 (p t) (hcenter t htpos) j
  exact Source29AnalyticSheetMeanTrace.mean_hessianTrace_eq_zero (tangentMetric κ) e
    (fun i => by simp [e]) f p (fun t => t) (ε/2) B (half_pos hε)
    hscale hpos hp hf hb μ hμ (data.s : ℂ) hc hsum
    (Source29FullNormalChart.normalWeight κ) hPDE

end
end Source29PreparedMeanTraceZero

/- Component: ComplexDichotomy.inc -/
/- The algebraic and compactness part of the complex obstruction. The positive
maximum alternative still needs the local hypersurface argument. -/

namespace Source29ComplexDichotomy

open MvPolynomial
open Source29ProjectiveMaximum
open scoped BigOperators

noncomputable section

/-- Unless the irreducible hypersurface is the null quadric, it has a zero at
which the quadric is nonzero. This is the precise Nullstellensatz step. -/
theorem exists_nonisotropic_zero (h : MvPolynomial (Fin 8) ℂ)
    (hh : Irreducible h) (hnq : ¬Source29Quadric.quadric ∣ h) :
    ∃ x : Fin 8 → ℂ, eval x h = 0 ∧ eval x Source29Quadric.quadric ≠ 0 := by
  letI : IsAlgClosed ℂ := Source29FTA.complex_isAlgClosed
  by_contra hnone
  push Not at hnone
  have hd := Source29ZeroLocus.irreducible_dvd_of_vanishing
    h Source29Quadric.quadric hh hnone
  exact hnq (hh.associated_of_dvd Source29Quadric.quadric_irreducible hd).symm.dvd

/-- The maximum is positive whenever the hypersurface is not the null quadric. -/
theorem exists_positive_maximum (h : MvPolynomial (Fin 8) ℂ) (d : ℕ)
    (hh : Irreducible h) (hhom : h.IsHomogeneous d)
    (hreal : ∀ x : Fin 8 → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0)
    (hnq : ¬Source29Quadric.quadric ∣ h) :
    ∃ (κ : ℝ) (z : CSpace 8),
      0 < κ ∧ κ < 1 ∧ ‖z‖ = 1 ∧ eval (fun i => z i) h = 0 ∧
      quadricNorm z = κ ∧
      ∀ w : CSpace 8, eval (fun i => w i) h = 0 →
        quadricNorm w ≤ κ * ‖w‖ ^ 2 := by
  obtain ⟨x, hxh, hxq⟩ := exists_nonisotropic_zero h hh hnq
  have hxne : x ≠ 0 := by
    intro he
    apply hxq
    simp [Source29Quadric.quadric, he]
  let w : CSpace 8 := WithLp.toLp 2 x
  have hwne : w ≠ 0 := by
    intro he
    apply hxne
    funext i
    exact congrArg (fun u : CSpace 8 => u i) he
  obtain ⟨κ, z, hk0, hk1, hzunit, hzh, hzq, hmax⟩ :=
    exists_strict_spherical_maximum h hhom hreal w hwne hxh
  have hglobal := global_quadric_bound h hhom κ hmax
  have hwqpos : 0 < quadricNorm w := by
    apply norm_pos_iff.mpr
    simpa [Source29Quadric.quadric, w] using hxq
  have hkpos : 0 < κ := by
    by_contra hnot
    have hkneg : κ ≤ 0 := le_of_not_gt hnot
    have hbound := hglobal w hxh
    have hnonpos := mul_nonpos_of_nonpos_of_nonneg hkneg (sq_nonneg ‖w‖)
    linarith
  exact ⟨κ, z, hkpos, hk1, hzunit, hzh, hzq, hglobal⟩

/-- The complete global reduction used before the local analytic argument:
either the desired divisibility holds, or there is a strictly positive,
phase-normalized maximum. No differential equation has yet been used. -/
theorem quadric_dvd_or_normalized_maximum (h : MvPolynomial (Fin 8) ℂ) (d : ℕ)
    (hh : Irreducible h) (hhom : h.IsHomogeneous d)
    (hreal : ∀ x : Fin 8 → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0) :
    Source29Quadric.quadric ∣ h ∨
    ∃ (κ : ℝ) (z : CSpace 8),
      0 < κ ∧ κ < 1 ∧ ‖z‖ = 1 ∧ eval (fun i => z i) h = 0 ∧
      (∑ i : Fin 8, (z i)^2) = (κ : ℂ) ∧
      ∀ w : CSpace 8, eval (fun i => w i) h = 0 →
        quadricNorm w ≤ κ * ‖w‖ ^ 2 := by
  by_cases hq : Source29Quadric.quadric ∣ h
  · exact Or.inl hq
  right
  obtain ⟨κ, z, hk0, hk1, hzunit, hzh, hzq, hglobal⟩ :=
    exists_positive_maximum h d hh hhom hreal hq
  have hnonzero : (∑ i : Fin 8, (z i)^2) ≠ 0 := by
    apply norm_pos_iff.mp
    change 0 < quadricNorm z
    rwa [hzq]
  obtain ⟨c, hcunit, hcq⟩ :=
    Source29ComplexPhase.exists_quadratic_phase _ hnonzero
  refine ⟨κ, c • z, hk0, hk1, ?_, ?_, ?_, hglobal⟩
  · rw [norm_smul, hcunit, hzunit, one_mul]
  · change eval (fun i => c * z i) h = 0
    rw [eval_scale_of_isHomogeneous h d hhom, hzh, mul_zero]
  · change (∑ i : Fin 8, (c * z i)^2) = (κ : ℂ)
    simp only [mul_pow, ← Finset.mul_sum]
    rw [hcq]
    exact congrArg Complex.ofReal hzq

end
end Source29ComplexDichotomy

/- Component: ComplexObstruction.inc -/
/- The local trace argument completes the complex hypersurface obstruction. -/
namespace Source29ComplexObstruction

open MvPolynomial Source29LocalMaximumBound Source29TangentBasis
open scoped BigOperators

noncomputable section

theorem no_positive_strict_maximum (h : MvPolynomial (Fin 8) ℂ)
    (hirr : Irreducible h) (d : ℕ) (hhom : h.IsHomogeneous d)
    (hdiv : h ∣ Source29FactorInheritance.cubicOperator h)
    (z : CSpace 8) (κ : ℝ) (hk : 0 < κ) (hk1 : κ < 1)
    (hz : ‖z‖ = 1) (hzero : eval (fun i => z i) h = 0)
    (hq : ∑ i : Fin 8, (z i)^2 = (κ : ℂ))
    (hbound : ∀ v : CSpace 8, eval (fun i => v i) h = 0 →
      Source29ProjectiveMaximum.quadricNorm v ≤ κ * ‖v‖^2) : False := by
  obtain ⟨data⟩ := Source29LocalQuadratic.exists_prepared_roots_at_maximum h hirr.ne_zero
    z hzero κ hk hk1 hz hq hbound (tangentEmbedding z κ hk hk1 hz hq)
    (tangentEmbedding_normal z κ hk hk1 hz hq)
  exact Source29PreparedMaximumTrace.prepared_mean_trace_ne_zero
    h d hhom z κ hk hk1 hz hq hbound data
    (Source29PreparedMeanTraceZero.prepared_mean_trace_zero h hirr hdiv z κ hk hk1 hz hq data)

/-- An irreducible homogeneous complex polynomial satisfying the divisor
equation and having no nonzero real zero is divisible by the null quadric. -/
theorem complex_obstruction : Source29PositiveDivisor.ComplexObstruction8 := by
  intro h hirr hhom hdiv hreal
  rcases Source29ComplexDichotomy.quadric_dvd_or_normalized_maximum h h.totalDegree
      hirr hhom hreal with hquad | ⟨κ, z, hk, hk1, hz, hzero, hq, hbound⟩
  · exact hquad
  · exact (no_positive_strict_maximum h hirr h.totalDegree hhom hdiv
      z κ hk hk1 hz hzero hq hbound).elim

/-- The complex obstruction gives the positive homogeneous divisor result
needed for the final all-degree argument. -/
theorem positive_divisor_obstruction : Source29Closing.PositiveHomogeneousDivisorObstruction8 :=
  Source29PositiveDivisor.positive_divisor_obstruction_of_complex_obstruction complex_obstruction

/-- The only remaining input here is the separately stated Guo leading-term
theorem. This conditional result is not the requested submission target. -/
theorem problem29_of_Guo
    (hGuo : ∀ P : Source29Closing.Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → Source29Closing.GuoData8 P) : Math30.Problem29 :=
  Source29Closing.problem29_of_geometric_inputs hGuo positive_divisor_obstruction

end
end Source29ComplexObstruction

