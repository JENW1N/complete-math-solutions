    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a - A P g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (K lam : ℝ)
    (hJac : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) + (K+lam)*g⁻¹ = 0)

include hP hd hg hL hgn hgt hC hC0 hC1 hC2 hJac

theorem normalizedHessian_second_trace (a b : ι) :
    (∑ i, deriv (deriv (normalizedHessian P (C i) (tangent a) (tangent b))) 0) =
      (∑ i, Q P g a b i i) - 2 * (∑ i, w P g i * S P g i a b) -
      (K+lam+(Fintype.card ι : ℝ)*((d : ℝ)-2)) * A P g a b := by
  simp_rw [normalizedHessian_second_tangent P g hg hgn hgt (C _) (hC _) (hC0 _)
    d hP hd _ (hC1 _) (hC2 _)]
  simp only [mul_assoc, Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
    ← Finset.sum_mul, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    Source29NormalizedLinkTraces.A_trace P d hP hd g hg.ne' hL hgn hgt,
    zero_mul, sub_zero]
  have hj : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) = -(K+lam)*g⁻¹ := by linarith
  rw [hj]
  field_simp
  ring

theorem normalizedHessian_second_trace_reduced (a b : ι) :
    (∑ i, deriv (deriv (normalizedHessian P (C i) (tangent a) (tangent b))) 0) =
      2 * matrixCube (A P g) b a - 2 * z P g * matrixSquare (A P g) a b +
      2 * (∑ i, (A P g i a * V P g i b + A P g i b * V P g i a)) -
      2 * w P g a * (∑ i, A P g b i * w P g i) -
      2 * w P g b * (∑ i, A P g a i * w P g i) +
      ((d : ℝ)*((d : ℝ)-1)-2-K-lam-(Fintype.card ι : ℝ)*((d : ℝ)-2)) * A P g a b := by
  rw [normalizedHessian_second_trace P d hP hd g hg hL hgn hgt C hC hC0 hC1 hC2 K lam hJac,
    Source29NormalizedLinkTraces.Q_trace_natural P d hP hd g hg.ne' hL hgn hgt,
    Source29PolynomialSimonsTensor.cubic_contraction (A P g) (A_symm P g),
    Source29PolynomialSimonsTensor.square_contraction (A P g) (A_symm P g)]
  have hS : ∀ i, S P g a b i = S P g i a b := by
    intro i
    rw [S_swap23, S_swap12]
  simp only [Finset.sum_add_distrib, hS, A_symm P g, V_symm P g]
  have hm : (∑ i, S P g i a b * w P g i) = ∑ i, w P g i * S P g i a b := by
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hm]
  ring

end
end Source29NormalizedHessianTrace

/- Component: BilinearFrameJet.inc -/
namespace Source29BilinearFrameJet

open Source29AnalyticDotSecond
open scoped BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- Product differentiation with two-axis frame velocities, keeping the
actual accelerations explicit. No frame second derivatives are assumed. -/
theorem second_deriv_two_axis
    (u v : ℝ → κ → ℝ) (Z : ℝ → κ → κ → ℝ)
    (hu : ∀ a, AnalyticAt ℝ (fun t => u t a) 0)
    (hv : ∀ a, AnalyticAt ℝ (fun t => v t a) 0)
    (hZ : ∀ a b, AnalyticAt ℝ (fun t => Z t a b) 0)
    (r n a b : κ) (p q s c : ℝ)
    (hu0 : u 0 = Pi.single a 1) (hv0 : v 0 = Pi.single b 1)
    (hu1 : ∀ k, deriv (fun t => u t k) 0 =
      -p * Pi.single (M := fun _ => ℝ) r 1 k - q * Pi.single (M := fun _ => ℝ) n 1 k)
    (hv1 : ∀ k, deriv (fun t => v t k) 0 =
      -s * Pi.single (M := fun _ => ℝ) r 1 k - c * Pi.single (M := fun _ => ℝ) n 1 k) :
    deriv (deriv (fun t => ∑ y, ∑ x, u t x * Z t x y * v t y)) 0 =
      deriv (deriv (fun t => Z t a b)) 0 +
      (∑ k, acceleration u k * Z 0 k b) + (∑ k, Z 0 a k * acceleration v k) +
      2 * (p*s*Z 0 r r + p*c*Z 0 r n + q*s*Z 0 n r + q*c*Z 0 n n) -
      2 * (p*deriv (fun t => Z t r b) 0 + q*deriv (fun t => Z t n b) 0 +
        s*deriv (fun t => Z t a r) 0 + c*deriv (fun t => Z t a n) 0) := by
  rw [Source29AnalyticBilinearDerivative.second_deriv_bilinear u v Z hu hv hZ]
  simp only [hu0, hv0, hu1, hv1, Pi.single_apply, mul_sub, sub_mul, mul_ite, ite_mul,
    mul_one, one_mul, mul_zero, zero_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_ite_irrel, Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.sum_const_zero,
    Finset.mem_univ, if_true, acceleration]
  ring

end
end Source29BilinearFrameJet

/- Component: MovingSecondFormJets.inc -/
namespace Source29MovingSecondFormJets

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29PolynomialTangentFrameJets
open Source29PolynomialMovingCurvature Source29NormalizedHessianCurve Source29NormalizedHessianBlocks
open Source29AnalyticDotSecond
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Second derivatives of the actual moving second form, with the unknown
tangential frame accelerations still explicit. -/
theorem secondForm_second_deriv
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j k : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (deriv (tangentSecondForm P C j k)) 0 =
      deriv (deriv (normalizedHessian P C (tangent j) (tangent k))) 0 +
      acceleration (tangentFrame P C j) none * w P g k +
      acceleration (tangentFrame P C k) none * w P g j +
      (∑ l, acceleration (tangentFrame P C j) (tangent l) * A P g l k) +
      (∑ l, acceleration (tangentFrame P C k) (tangent l) * A P g l j) +
      2 * (if i = j then 1 else 0) * A P g i k +
      2 * (if i = k then 1 else 0) * A P g i j +
      2 * z P g * A P g i j * A P g i k -
      2 * A P g i j * V P g i k - 2 * A P g i k * V P g i j +
      2 * w P g i * (A P g i j * w P g k + A P g i k * w P g j) := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame P d hP g hg hgn hgt C hC hC0 hmem
  have hN := normalizedHessian_analyticAt P g hg hgn hgt C hC hC0
  have hj := Source29BilinearFrameJet.second_deriv_two_axis
    (tangentFrame P C j) (tangentFrame P C k) (fun t a b => normalizedHessian P C a b t)
    (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp (hE k)) hN
    (some none) none (tangent j) (tangent k)
    (if i=j then 1 else 0) (A P g i j) (if i=k then 1 else 0) (A P g i k)
    (hE0 j) (hE0 k)
    (tangentFrame_first_deriv P g hg hgn hgt C hC hC0 i j hC1)
    (tangentFrame_first_deriv P g hg hgn hgt C hC hC0 i k hC1)
  have hacc : ∀ a b,
      (∑ l, acceleration (tangentFrame P C a) l * normalizedHessian P C l (tangent b) 0) =
      acceleration (tangentFrame P C a) none * w P g b +
      ∑ l, acceleration (tangentFrame P C a) (tangent l) * A P g l b := by
    intro a b
    rw [Fintype.sum_option, Fintype.sum_option]
    have hr : normalizedHessian P C (some none) (tangent b) 0 = 0 :=
      zero_radial_some P d hP hd g hg hgn hgt C hC0 (some b)
    simp only [zero_normal_tangent P g hg hgn hgt C hC0, hr, mul_zero, zero_add]
    change _ + (∑ l, acceleration (tangentFrame P C a) (tangent l) *
      normalizedHessian P C (tangent l) (tangent b) 0) = _
    simp only [zero_tangent P g hg hgn hgt C hC0]
  have haccR : (∑ l, normalizedHessian P C (tangent j) l 0 * acceleration (tangentFrame P C k) l) =
      acceleration (tangentFrame P C k) none * w P g j +
      ∑ l, acceleration (tangentFrame P C k) (tangent l) * A P g l j := by
    rw [← hacc k j]
    apply Finset.sum_congr rfl
    intro l _
    rw [normalizedHessian_symm P C (tangent j) l]
    ring
  have hnr : normalizedHessian P C none (some none) 0 = (d : ℝ)-1 := by
    rw [normalizedHessian_symm, zero_radial_normal P d hP hd g hg hgn hgt C hC0]
  have hjr : deriv (normalizedHessian P C (tangent j) (some none)) 0 = ((d : ℝ)-2)*A P g i j := by
    rw [normalizedHessian_symm, first_radial_tangent P d hP hd g hg hgn hgt C hC hC0 i j hC1]
  have hjn : deriv (normalizedHessian P C (tangent j) none) 0 = V P g i j - w P g i * w P g j := by
    rw [normalizedHessian_symm, first_normal_tangent P g hg hgn hgt C hC hC0 i j hC1]
  rw [secondForm_eq_normalized_bilinear, hj, hacc, haccR,
    zero_radial_some P d hP hd g hg hgn hgt C hC0 none,
    zero_radial_normal P d hP hd g hg hgn hgt C hC0, hnr,
    zero_normal P g hg hgn hgt C hC0,
    first_radial_tangent P d hP hd g hg hgn hgt C hC hC0 i k hC1,
    first_normal_tangent P g hg hgn hgt C hC hC0 i k hC1, hjr, hjn]
  ring

end
end Source29MovingSecondFormJets

