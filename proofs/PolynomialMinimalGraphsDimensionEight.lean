/- Component: MetricJet.lean -/

/-!
# Metric algebra for local defining functions

These are identities of covectors and Hessian arrays. No assertion about the
existence or regularity of analytic defining functions is assumed or proved.
-/

namespace Source29MetricJet

open scoped BigOperators

variable {R ι : Type*} [CommRing R] [Fintype ι]

noncomputable def dot (v w : ι → R) : R := ∑ i, v i*w i

noncomputable def raiseIndex (M : ι → ι → R) (g : ι → R) (i : ι) : R :=
  ∑ j, M i j*g j

noncomputable def metricPair (M : ι → ι → R) (g b : ι → R) : R :=
  ∑ i, ∑ j, M i j*g i*b j

noncomputable def metricTrace (M H : ι → ι → R) : R :=
  ∑ i, ∑ j, M i j*H i j

noncomputable def contract (H : ι → ι → R) (v w : ι → R) : R :=
  ∑ i, ∑ j, H i j*v i*w j

noncomputable def operator (M : ι → ι → R) (g : ι → R) (H : ι → ι → R) : R :=
  metricPair M g g * metricTrace M H - contract H (raiseIndex M g) (raiseIndex M g)

lemma raiseIndex_scale (M : ι → ι → R) (g : ι → R) (u : R) :
    raiseIndex M (fun i => u*g i) = fun i => u*raiseIndex M g i := by
  funext i
  simp only [raiseIndex, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma metricPair_scale (M : ι → ι → R) (g b : ι → R) (u v : R) :
    metricPair M (fun i => u*g i) (fun i => v*b i) = u*v*metricPair M g b := by
  simp only [metricPair, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma metricPair_symm (M : ι → ι → R) (hM : ∀ i j, M i j = M j i)
    (g b : ι → R) : metricPair M g b = metricPair M b g := by
  unfold metricPair
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [hM j i]
  ring

lemma dot_raiseIndex (M : ι → ι → R) (g b : ι → R) :
    dot g (raiseIndex M b) = metricPair M g b := by
  simp only [dot, raiseIndex, metricPair, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma metricTrace_add (M H K : ι → ι → R) :
    metricTrace M (fun i j => H i j+K i j) = metricTrace M H+metricTrace M K := by
  simp only [metricTrace, mul_add, Finset.sum_add_distrib]

lemma metricTrace_scale (M H : ι → ι → R) (u : R) :
    metricTrace M (fun i j => u*H i j) = u*metricTrace M H := by
  simp only [metricTrace, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma metricTrace_outer (M : ι → ι → R) (g b : ι → R) :
    metricTrace M (fun i j => g i*b j) = metricPair M g b := by
  simp only [metricTrace, metricPair, mul_assoc]

lemma contract_add (H K : ι → ι → R) (v w : ι → R) :
    contract (fun i j => H i j+K i j) v w = contract H v w+contract K v w := by
  simp only [contract, add_mul, Finset.sum_add_distrib]

lemma contract_scale (H : ι → ι → R) (u : R) (v w : ι → R) :
    contract (fun i j => u*H i j) v w = u*contract H v w := by
  simp only [contract, Finset.mul_sum, mul_assoc]

lemma contract_scale_vectors (H : ι → ι → R) (u v : R) (g b : ι → R) :
    contract H (fun i => u*g i) (fun i => v*b i) = u*v*contract H g b := by
  simp only [contract, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

lemma contract_outer (g b v w : ι → R) :
    contract (fun i j => g i*b j) v w = dot g v*dot b w := by
  simp only [contract, dot, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

/-- At a zero of a defining function, multiplication by a scalar function has
these gradient/Hessian jets. Their cubic metric operator scales by u^3.
This algebraic identity does not require u to be invertible or H symmetric. -/
theorem defining_function_unit_identity (M : ι → ι → R)
    (hM : ∀ i j, M i j = M j i) (g b : ι → R) (H : ι → ι → R) (u : R) :
    operator M (fun i => u*g i)
      (fun i j => u*H i j+g i*b j+b i*g j) = u^3*operator M g H := by
  unfold operator
  rw [raiseIndex_scale, metricPair_scale, metricTrace_add, metricTrace_add,
    metricTrace_scale, metricTrace_outer, metricTrace_outer,
    contract_scale_vectors, contract_add, contract_add, contract_scale,
    contract_outer, contract_outer, dot_raiseIndex, dot_raiseIndex]
  rw [metricPair_symm M hM b g]
  ring


/-- Block inverse metric, with the normal coordinate indexed by `none`. -/
def blockMetric (M : ι → ι → R) (d : R) : Option ι → Option ι → R
  | none, none => d
  | some i, some j => M i j
  | _, _ => 0

/-- The covector of the formal defining function w-f. -/
def graphCovector (g : ι → R) : Option ι → R
  | none => 1
  | some i => -g i

/-- The Hessian array of the formal defining function w-f. -/
def graphHessian (H : ι → ι → R) : Option ι → Option ι → R
  | some i, some j => -H i j
  | _, _ => 0

lemma raiseIndex_graph_none (M : ι → ι → R) (d : R) (g : ι → R) :
    raiseIndex (blockMetric M d) (graphCovector g) none = d := by
  simp [raiseIndex, blockMetric, graphCovector, Fintype.sum_option]

lemma raiseIndex_graph_some (M : ι → ι → R) (d : R) (g : ι → R) (i : ι) :
    raiseIndex (blockMetric M d) (graphCovector g) (some i) = -raiseIndex M g i := by
  simp [raiseIndex, blockMetric, graphCovector, Fintype.sum_option]

lemma metricPair_graph (M : ι → ι → R) (d : R) (g : ι → R) :
    metricPair (blockMetric M d) (graphCovector g) (graphCovector g) =
      d+metricPair M g g := by
  simp [metricPair, blockMetric, graphCovector, Fintype.sum_option]

lemma metricTrace_graph (M H : ι → ι → R) (d : R) :
    metricTrace (blockMetric M d) (graphHessian H) = -metricTrace M H := by
  simp [metricTrace, blockMetric, graphHessian, Fintype.sum_option]

lemma contract_graph (M H : ι → ι → R) (d : R) (g : ι → R) :
    contract (graphHessian H) (raiseIndex (blockMetric M d) (graphCovector g))
      (raiseIndex (blockMetric M d) (graphCovector g)) =
      -contract H (raiseIndex M g) (raiseIndex M g) := by
  simp [contract, graphHessian, Fintype.sum_option, raiseIndex_graph_some]

lemma graph_operator (M : ι → ι → R) (d : R) (g : ι → R) (H : ι → ι → R) :
    operator (blockMetric M d) (graphCovector g) (graphHessian H) =
      -(d+metricPair M g g)*metricTrace M H +
        contract H (raiseIndex M g) (raiseIndex M g) := by
  rw [operator, metricPair_graph, metricTrace_graph, contract_graph]
  ring

/-- Multiplying the implicit operator by -c, where c*d=1, gives precisely
(1+c*A)*trace(M*H)-c*H(M*g,M*g), the graph expression in the PDF's equation (2).
All inputs are derivative arrays; analytic product/chain rules are separate. -/
theorem graph_equation_identity (M : ι → ι → R) (c d : R) (hcd : c*d=1)
    (g : ι → R) (H : ι → ι → R) :
    -c*operator (blockMetric M d) (graphCovector g) (graphHessian H) =
      (1+c*metricPair M g g)*metricTrace M H -
        c*contract H (raiseIndex M g) (raiseIndex M g) := by
  rw [graph_operator]
  linear_combination (metricTrace M H)*hcd

/-- Zero implicit operator gives the graph PDE for the same derivative data. -/
theorem graph_equation_of_operator_zero (M : ι → ι → R) (c d : R) (hcd : c*d=1)
    (g : ι → R) (H : ι → ι → R)
    (hL : operator (blockMetric M d) (graphCovector g) (graphHessian H) = 0) :
    (1+c*metricPair M g g)*metricTrace M H -
      c*contract H (raiseIndex M g) (raiseIndex M g) = 0 := by
  rw [← graph_equation_identity M c d hcd g H, hL, mul_zero]

end Source29MetricJet

/- Component: RealComplexBridge.inc -/
namespace Source29RealComplex

open MvPolynomial

noncomputable section

theorem cubicOperator_map {R S ι : Type*} [CommRing R] [CommRing S] [Fintype ι]
    (f : R →+* S) (P : MvPolynomial ι R) :
    map f (Source29FactorInheritance.cubicOperator P) =
      Source29FactorInheritance.cubicOperator (map f P) := by
  simp only [Source29FactorInheritance.cubicOperator, map_sub, map_mul, map_sum,
    map_pow, pderiv_map]

def complexify {ι : Type*} (P : MvPolynomial ι ℝ) : MvPolynomial ι ℂ :=
  map (algebraMap ℝ ℂ) P

theorem complexify_ne_zero {ι : Type*} (P : MvPolynomial ι ℝ) (hP : P ≠ 0) :
    complexify P ≠ 0 := by
  intro h
  apply hP
  apply map_injective (algebraMap ℝ ℂ) (algebraMap ℝ ℂ).injective
  simpa [complexify] using h

theorem eval_complexify {ι : Type*} (P : MvPolynomial ι ℝ) (x : ι → ℝ) :
    eval (fun i => (x i : ℂ)) (complexify P) = (eval x P : ℂ) := by
  exact (MvPolynomial.map_eval (algebraMap ℝ ℂ) x P).symm

theorem complexify_isHomogeneous {ι : Type*} (P : MvPolynomial ι ℝ) (m : ℕ)
    (hP : P.IsHomogeneous m) : (complexify P).IsHomogeneous m :=
  hP.map (algebraMap ℝ ℂ)

theorem complexify_cubic_zero {ι : Type*} [Fintype ι]
    (P : MvPolynomial ι ℝ) (hP : Source29FactorInheritance.cubicOperator P = 0) :
    Source29FactorInheritance.cubicOperator (complexify P) = 0 := by
  rw [complexify, ← cubicOperator_map, hP, map_zero]

/-- Every complex factor of a strictly positive real polynomial has no nonzero real zero. -/
theorem factor_no_nonzero_real_zero {ι : Type*}
    (Q : MvPolynomial ι ℝ) (h : MvPolynomial ι ℂ)
    (hQ : ∀ x : ι → ℝ, x ≠ 0 → 0 < eval x Q)
    (hdiv : h ∣ complexify Q) :
    ∀ x : ι → ℝ, x ≠ 0 → eval (fun i => (x i : ℂ)) h ≠ 0 := by
  obtain ⟨v, hv⟩ := hdiv
  intro x hx he
  have hz : eval (fun i => (x i : ℂ)) (complexify Q) = 0 := by
    rw [hv, map_mul, he, zero_mul]
  rw [eval_complexify] at hz
  have hz' : eval x Q = 0 := by exact_mod_cast hz
  exact (ne_of_gt (hQ x hx)) hz'

/-- The maximal multiplicity of an arbitrary irreducible divisor supplies
the factorization required by the operator-inheritance identity. -/
theorem irreducible_divisor_inherits {ι : Type*} [Fintype ι]
    (F h : MvPolynomial ι ℂ) (hF : F ≠ 0)
    (hL : Source29FactorInheritance.cubicOperator F = 0)
    (hh : Irreducible h) (hdiv : h ∣ F) :
    h ∣ Source29FactorInheritance.cubicOperator h := by
  have hf : FiniteMultiplicity h F :=
    FiniteMultiplicity.of_not_isUnit hh.not_isUnit hF
  obtain ⟨v, hv, hnot⟩ := hf.exists_eq_pow_mul_and_not_dvd
  have ha : 1 ≤ multiplicity h F := by
    have hne := (multiplicity_ne_zero hf).mpr hdiv
    omega
  apply Source29FactorInheritance.factor_inheritance h v (multiplicity h F) ha hh hnot
  rwa [← hv]

end
