variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def velocity (f : ℝ → κ → ℝ) : κ → ℝ := fun a => deriv (fun t => f t a) 0

theorem inverseRotation_deriv (u : κ → ℝ) (v w : ℝ → κ → ℝ)
    (hunit : u ⬝ᵥ u = 1) (hv0 : v 0 = u)
    (hv : ∀ a, AnalyticAt ℝ (fun t => v t a) 0)
    (hw : ∀ a, AnalyticAt ℝ (fun t => w t a) 0) (a : κ) :
    deriv (fun t => inverseRotation u (v t) (w t) a) 0 =
      velocity w a - (u ⬝ᵥ w 0)*velocity v a + (velocity v ⬝ᵥ w 0)*u a := by
  have hu : u ≠ 0 := by intro he; rw [he, zero_dotProduct] at hunit; norm_num at hunit
  have hs : u + v 0 ≠ 0 := by
    rw [hv0, ← two_smul ℝ u]
    exact smul_ne_zero (by norm_num) hu
  let m := fun t => inverseRotation u (v t) (w t)
  have hm := inverseRotation_analyticAt u v w 0 hu hs hv hw
  have hm0 : m 0 = w 0 := by simp only [m, hv0, inverseRotation_self]
  have hd := hasDerivAt_rotation u v m (velocity v) (velocity m) hunit hv0
    (fun b => (hv b).differentiableAt.hasDerivAt)
    (fun b => (analyticAt_pi_iff.mp hm b).differentiableAt.hasDerivAt) a
  have hf : (fun t => rotation u (v t) (m t) a) = (fun t => w t a) := by
    funext t
    exact congrFun (rotation_inverse u (v t) (w t)) a
  rw [hf] at hd
  have he := hd.unique (hw a).differentiableAt.hasDerivAt
  rw [hm0] at he
  change velocity m a + (u ⬝ᵥ w 0)*velocity v a - (velocity v ⬝ᵥ w 0)*u a = velocity w a at he
  change velocity m a = _
  linarith

/-- The frame's derivative on the orthogonal complement has no tangential
rotation at its base point. This follows from the actual reflection formula. -/
theorem frame_deriv (u v e : κ → ℝ) (x y : ℝ → κ → ℝ)
    (hu : u ⬝ᵥ u = 1) (hv : v ⬝ᵥ v = 1) (huv : u ⬝ᵥ v = 0)
    (hue : u ⬝ᵥ e = 0) (hve : v ⬝ᵥ e = 0)
    (hx0 : x 0 = u) (hy0 : y 0 = v)
    (hx : ∀ a, AnalyticAt ℝ (fun t => x t a) 0)
    (hy : ∀ a, AnalyticAt ℝ (fun t => y t a) 0) (a : κ) :
    deriv (fun t => frame u v (x t) (y t) e a) 0 =
      -(velocity x ⬝ᵥ e)*u a - (velocity y ⬝ᵥ e)*v a := by
  have hun : u ≠ 0 := by intro he; rw [he, zero_dotProduct] at hu; norm_num at hu
  have hs : u + x 0 ≠ 0 := by
    rw [hx0, ← two_smul ℝ u]
    exact smul_ne_zero (by norm_num) hun
  let m := fun t => inverseRotation u (x t) (y t)
  have hm := inverseRotation_analyticAt u x y 0 hun hs hx hy
  have hm0 : m 0 = v := by simp only [m, hx0, hy0, inverseRotation_self]
  have hdm : velocity m = velocity y + (velocity x ⬝ᵥ v) • u := by
    funext b
    have he := inverseRotation_deriv u x y hu hx0 hx hy b
    simpa only [velocity, m, hy0, huv, zero_mul, sub_zero, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using he
  have hdot : velocity m ⬝ᵥ e = velocity y ⬝ᵥ e := by
    rw [hdm, add_dotProduct, smul_dotProduct, hue, smul_zero, add_zero]
  let b := fun t => rotation v (m t) e
  have hb0 : b 0 = e := by simp only [b, hm0, rotation_self]
  have hb : ∀ j, HasDerivAt (fun t => b t j) (-(velocity y ⬝ᵥ e)*v j) 0 := by
    intro j
    have he := hasDerivAt_rotation v m (fun _ => e) (velocity m) 0 hv hm0
      (fun j => (analyticAt_pi_iff.mp hm j).differentiableAt.hasDerivAt)
      (fun j => hasDerivAt_const 0 (e j)) j
    simpa only [Pi.zero_apply, hve, zero_mul, hdot, zero_add, zero_sub, neg_mul] using he
  have he := hasDerivAt_rotation u x b (velocity x) (fun j => -(velocity y ⬝ᵥ e)*v j) hu hx0
    (fun j => (hx j).differentiableAt.hasDerivAt) hb a
  have hh := he.deriv
  rw [hb0, hue, zero_mul, add_zero] at hh
  change deriv (fun t => frame u v (x t) (y t) e a) 0 = _ at hh
  rw [hh]
  ring

end
end Source29PairFrameDerivative

/- Component: PolynomialUnitNormal.inc -/
namespace Source29PolynomialUnitNormal

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialJacobiCurves
open Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticPolynomialBasics (evalFDeriv_self_of_isHomogeneous evalFDeriv_apply)
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def unitNormal (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι) : Ambient ι :=
  fun a => jacobiProfile P x * eval x (pderiv a P)

theorem unitNormal_analyticAt (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (hreg : gradientAt P x ≠ 0) : AnalyticAt ℝ (unitNormal P) x := by
  apply AnalyticAt.pi
  intro a
  exact (jacobiProfile_analyticAt P x hreg).mul (analyticAt_eval_real (pderiv a P) x)

theorem unitNormal_dot_self (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (hreg : gradientAt P x ≠ 0) : unitNormal P x ⬝ᵥ unitNormal P x = 1 := by
  let v := gradientAt P x
  let q := Source29AnalyticTensorNorm.tensorNorm v
  have hq : q ≠ 0 := (Source29AnalyticTensorNorm.tensorNorm_pos hreg).ne'
  have hs : q^2 = ∑ a, (v a)^2 := Source29AnalyticTensorNorm.tensorNorm_sq v
  change (∑ a, (q⁻¹ * v a) * (q⁻¹ * v a)) = 1
  calc
    _ = q⁻¹^2 * (∑ a, (v a)^2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = 1 := by rw [← hs]; field_simp

theorem radial_dot_unitNormal (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (x : Ambient ι) (hzero : eval x P = 0) :
    x ⬝ᵥ unitNormal P x = 0 := by
  have he := evalFDeriv_self_of_isHomogeneous P d hP x
  rw [hzero, mul_zero] at he
  have ht : (∑ a, x a * eval x (pderiv a P)) = 0 := by
    simpa only [evalFDeriv_apply, mul_comm] using he
  calc
    _ = jacobiProfile P x * (∑ a, x a * eval x (pderiv a P)) := by
      simp only [unitNormal, dotProduct, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = 0 := by rw [ht, mul_zero]

theorem unitNormal_at_base (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0) :
    unitNormal P base = Pi.single none 1 := by
  funext a
  cases a with
  | none => simp [unitNormal, jacobiProfile_at_base P g hg hgn hgt, hgn, hg.ne']
  | some a => simp [unitNormal, hgt]

end
end Source29PolynomialUnitNormal

/- Component: PolynomialTangentFrame.inc -/
namespace Source29PolynomialTangentFrame

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialUnitNormal Source29AnalyticPairFrame Source29NormalizedLinkJets
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem single_dot_single (a b : Option (Option ι)) :
    (Pi.single a 1 : Ambient ι) ⬝ᵥ Pi.single b 1 = if a = b then 1 else 0 := by
  simp [dotProduct, Pi.single_apply, eq_comm]

def tangentFrame (P : MvPolynomial (Option (Option ι)) ℝ) (C : ℝ → Ambient ι)
    (j : ι) (t : ℝ) : Ambient ι :=
  frame base (Pi.single none 1) (C t) (unitNormal P (C t)) (Pi.single (tangent j) 1)

/-- Actual analytic orthonormal tangent frames along any analytic link curve
through the normalized regular point. Derivative formulas are not assumed. -/
theorem exists_analytic_tangent_frame
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1) :
    ∃ E : ι → ℝ → Ambient ι, E = tangentFrame P C ∧
      (∀ j, AnalyticAt ℝ (E j) 0) ∧
      (∀ j, E j 0 = Pi.single (tangent j) 1) ∧
      (∀ t j k, E j t ⬝ᵥ E k t = if j = k then 1 else 0) ∧
      (∀ᶠ t in 𝓝 (0 : ℝ), ∀ j, E j t ⬝ᵥ C t = 0 ∧ E j t ⬝ᵥ unitNormal P (C t) = 0) := by
  let n : Ambient ι := Pi.single none 1
  let e : ι → Ambient ι := fun j => Pi.single (tangent j) 1
  let E : ι → ℝ → Ambient ι := tangentFrame P C
  have hreg : gradientAt P base ≠ 0 := by
    intro he
    have hn := congrFun he none
    simp only [gradientAt, hgn, Pi.zero_apply] at hn
    exact hg.ne' hn
  have hN0 : unitNormal P (C 0) = n := by
    rw [hC0]
    exact unitNormal_at_base P g hg hgn hgt
  have hN : AnalyticAt ℝ (fun t => unitNormal P (C t)) 0 := by
    have hr : gradientAt P (C 0) ≠ 0 := by simpa only [hC0] using hreg
    exact (unitNormal_analyticAt P (C 0) hr).comp hC
  have hu : (base : Ambient ι) ≠ 0 := by simp [base]
  have hn : n ≠ 0 := by simp [n]
  have hE : ∀ j, AnalyticAt ℝ (E j) 0 := by
    intro j
    exact frame_analyticAt base n C (fun t => unitNormal P (C t)) (fun _ => e j) 0 hu hn
      hC0 hN0 (analyticAt_pi_iff.mp hC) (analyticAt_pi_iff.mp hN) (fun _ => analyticAt_const)
  have hE0 : ∀ j, E j 0 = e j := by
    intro j
    simp only [E, tangentFrame, hC0, unitNormal_at_base P g hg hgn hgt, n, e, frame_self]
  have hca : AnalyticAt ℝ (fun t => eval (C t) (pderiv none P)) 0 :=
    (analyticAt_eval_real (pderiv none P) (C 0)).comp hC
  have hcp : 0 < eval (C 0) (pderiv none P) := by simpa only [hC0, hgn] using hg
  have hnear : ∀ᶠ t in 𝓝 (0 : ℝ), gradientAt P (C t) ≠ 0 := by
    filter_upwards [hca.continuousAt.eventually (eventually_gt_nhds hcp)] with t ht
    intro he
    have hz := congrFun he none
    exact ht.ne' (by simpa only [gradientAt, Pi.zero_apply] using hz)
  refine ⟨E, rfl, hE, hE0, ?_, ?_⟩
  · intro t j k
    change frame base n (C t) (unitNormal P (C t)) (e j) ⬝ᵥ
      frame base n (C t) (unitNormal P (C t)) (e k) = _
    rw [frame_dot]
    simpa only [e, single_dot_single, tangent, Option.some.injEq] using
      (single_dot_single (tangent j) (tangent k))
  · filter_upwards [hmem, hnear] with t ht hr
    have hx : (base : Ambient ι) ⬝ᵥ base = C t ⬝ᵥ C t := by
      have hb : (base : Ambient ι) ⬝ᵥ base = 1 := by simp [base, single_dot_single]
      rw [hb]
      simpa only [dotProduct, pow_two] using ht.2.symm
    have hy : n ⬝ᵥ n = unitNormal P (C t) ⬝ᵥ unitNormal P (C t) := by
      rw [unitNormal_dot_self P (C t) hr]
      simp [n, single_dot_single]
    have huv : (base : Ambient ι) ⬝ᵥ n = 0 := by simp [base, n, single_dot_single]
    have hxy : C t ⬝ᵥ unitNormal P (C t) = 0 := radial_dot_unitNormal P d hP (C t) ht.1
    have hp := frame_pair base n (C t) (unitNormal P (C t)) hx hy huv hxy
    intro j
    constructor
    · calc
        E j t ⬝ᵥ C t = E j t ⬝ᵥ frame base n (C t) (unitNormal P (C t)) base :=
          congrArg (fun z => E j t ⬝ᵥ z) hp.1.symm
        _ = e j ⬝ᵥ base := frame_dot base n (C t) (unitNormal P (C t)) (e j) base
        _ = 0 := by simp [e, base, tangent, single_dot_single]
    · calc
        E j t ⬝ᵥ unitNormal P (C t) = E j t ⬝ᵥ frame base n (C t) (unitNormal P (C t)) n :=
          congrArg (fun z => E j t ⬝ᵥ z) hp.2.symm
        _ = e j ⬝ᵥ n := frame_dot base n (C t) (unitNormal P (C t)) (e j) n
        _ = 0 := by simp [e, n, tangent, single_dot_single]

end
end Source29PolynomialTangentFrame

/- Component: PolynomialTangentFrameJets.inc -/
namespace Source29PolynomialTangentFrameJets

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialUnitNormal Source29PolynomialTangentFrame
open Source29NormalizedLinkJets Source29PairFrameDerivative
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem unitNormal_tangent_deriv
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g) (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base) (i j : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (fun t => unitNormal P (C t) (tangent j)) 0 = A P g i j := by
  have hr : gradientAt P (C 0) ≠ 0 := by
    rw [hC0]
    intro he
    have hn := congrFun he none
    exact hg.ne' (by simpa only [gradientAt, hgn, Pi.zero_apply] using hn)
  have hφ := (jacobiProfile_analyticAt P (C 0) hr).comp hC
  have hv := (analyticAt_eval_real (pderiv (tangent j) P) (C 0)).comp hC
  have hd := Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv (tangent j) P)
    (fun a t => C t a) base (tangent i) (analyticAt_pi_iff.mp hC)
    (fun a => congrFun hC0 a) hC1
  have he := (hφ.differentiableAt.hasDerivAt.mul hv.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  change deriv (fun t => jacobiProfile P (C t) * eval (C t) (pderiv (tangent j) P)) 0 = _
  rw [he, hC0, jacobiProfile_at_base P g hg hgn hgt, hd]
  have hj : eval base (pderiv (tangent j) P) = 0 := hgt (some j)
  rw [hj]
  simp only [A, Source29PolynomialTangentialDerivative.hessian]
  ring

/-- The actual analytic tangent frame has zero tangential connection at the
base point and the prescribed normal and radial first derivatives. -/
theorem tangentFrame_first_deriv
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g) (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base) (i j : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (a : Option (Option ι)) :
    deriv (fun t => tangentFrame P C j t a) 0 =
      -(if i = j then 1 else 0) * base a - A P g i j * Pi.single (M := fun _ => ℝ) none 1 a := by
  let n : Ambient ι := Pi.single none 1
  let e : Ambient ι := Pi.single (tangent j) 1
  let N := fun t => unitNormal P (C t)
  have hr : gradientAt P (C 0) ≠ 0 := by
    rw [hC0]
    intro he
    have hn := congrFun he none
    exact hg.ne' (by simpa only [gradientAt, hgn, Pi.zero_apply] using hn)
  have hN := (unitNormal_analyticAt P (C 0) hr).comp hC
  have hN0 : N 0 = n := by
    change unitNormal P (C 0) = n
    rw [hC0]
    exact unitNormal_at_base P g hg hgn hgt
  have he := frame_deriv base n e C N
    (by simp [base, single_dot_single]) (by simp [n, single_dot_single])
    (by simp [base, n, single_dot_single])
    (by simp [base, e, tangent, single_dot_single]) (by simp [n, e, tangent, single_dot_single])
    hC0 hN0 (analyticAt_pi_iff.mp hC) (analyticAt_pi_iff.mp hN) a
  have hdx : velocity C ⬝ᵥ e = if i = j then 1 else 0 := by
    simp [velocity, e, dotProduct, Pi.single_apply, hC1, tangent, eq_comm]
  have hdy : velocity N ⬝ᵥ e = A P g i j := by
    simpa only [velocity, e, N, dotProduct, Pi.single_apply, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ite_true] using
      unitNormal_tangent_deriv P g hg hgn hgt C hC hC0 i j hC1
  rw [hdx, hdy] at he
  exact he

end
end Source29PolynomialTangentFrameJets

/- Component: PairFrameMatrix.inc -/
namespace Source29PairFrameMatrix

open Source29AnalyticPairFrame
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

/-- Matrix with columns supplied by the actual reflection frame. -/
def frameMatrix (u v x y : κ → ℝ) : Matrix κ κ ℝ :=
  fun a b => frame u v x y (Pi.single b 1) a

theorem frameMatrix_transpose_mul (u v x y : κ → ℝ) :
    (frameMatrix u v x y).transpose * frameMatrix u v x y = 1 := by
  ext i j
  change frame u v x y (Pi.single i 1) ⬝ᵥ frame u v x y (Pi.single j 1) = _
  rw [frame_dot]
  simp [dotProduct, Pi.single_apply, Matrix.one_apply, eq_comm]

theorem frameMatrix_mul_transpose (u v x y : κ → ℝ) :
    frameMatrix u v x y * (frameMatrix u v x y).transpose = 1 :=
  mul_eq_one_comm.mp (frameMatrix_transpose_mul u v x y)

theorem frameMatrix_mul_single (u v x y : κ → ℝ) (b : κ) :
    frameMatrix u v x y *ᵥ Pi.single b 1 = frame u v x y (Pi.single b 1) := by
  ext a
  simp [Matrix.mulVec, dotProduct, Pi.single_apply, frameMatrix]

end
end Source29PairFrameMatrix

/- Component: PolynomialFramedCurvature.inc -/
namespace Source29PolynomialFramedCurvature

open MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialUnitNormal Source29NormalizedLinkJets
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The second fundamental form expressed in the tangent columns of U. -/
def framedSecondForm (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ) (i j : ι) : ℝ :=
  jacobiProfile P x * (U.transpose * realHessian P x * U) (tangent i) (tangent j)

/-- A frame with radial column x and normal column the unit gradient
normalizes the polynomial without imposing its minimal equation. -/
theorem frame_normalizes_gradient
    (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι)
    (hreg : gradientAt P x ≠ 0)
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hUt : U.transpose * U = 1) (hbase : U *ᵥ base = x)
    (hUn : ∀ a, U a none = unitNormal P x a) :
    eval base (pderiv none (changeVariables U P)) =
        Source29AnalyticTensorNorm.tensorNorm (gradientAt P x) ∧
      (∀ j, eval base (pderiv (some j) (changeVariables U P)) = 0) := by
  let g := Source29AnalyticTensorNorm.tensorNorm (gradientAt P x)
  have hg : g ≠ 0 := (Source29AnalyticTensorNorm.tensorNorm_pos hreg).ne'
  have hgrad : ∀ a, eval x (pderiv a P) = g * U a none := by
    intro a
    rw [hUn]
    change eval x (pderiv a P) = g * (g⁻¹ * eval x (pderiv a P))
    rw [← mul_assoc, mul_inv_cancel₀ hg, one_mul]
  have hcol : ∀ j, (∑ a, U a none * U a j) = if none = j then 1 else 0 := by
    intro j
    have he := congrArg (fun M : Matrix (Option (Option ι)) (Option (Option ι)) ℝ => M none j) hUt
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] using he
  have hpartial : ∀ j, eval base (pderiv j (changeVariables U P)) =
      g * (if none = j then 1 else 0) := by
    intro j
    rw [pderiv_changeVariables, map_sum]
    simp only [map_mul, eval_C, eval_changeVariables, hbase]
    simp_rw [hgrad, mul_assoc]
    rw [← Finset.mul_sum, hcol]
  constructor
  · simpa using hpartial none
  · intro j
    simpa using hpartial (some j)

/-- The invariant curvature potential is the squared norm of the Hessian
in every orthonormal frame with the prescribed radial and normal columns. -/
theorem framedSecondForm_norm_sq
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (x : Ambient ι) (hreg : gradientAt P x ≠ 0)
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hUt : U.transpose * U = 1) (hbase : U *ᵥ base = x)
    (hUn : ∀ a, U a none = unitNormal P x a) :
    (∑ i, ∑ j, (framedSecondForm P x U i j)^2) = curvaturePotential P x := by
  let g := Source29AnalyticTensorNorm.tensorNorm (gradientAt P x)
  have hg : g ≠ 0 := (Source29AnalyticTensorNorm.tensorNorm_pos hreg).ne'
  obtain ⟨hgn, hgt⟩ := frame_normalizes_gradient P x hreg U hUt hbase hUn
  have hU : U * U.transpose = 1 := mul_eq_one_comm.mp hUt
  have he := curvaturePotential_changeVariables U hU P base
  rw [hbase, curvaturePotential_at_base _ d (isHomogeneous_changeVariables U P d hP)
    hd g hg hgn hgt] at he
  rw [← he]
  have hH := realHessian_changeVariables U P base
  rw [hbase] at hH
  change (∑ i, ∑ j, (g⁻¹ * (U.transpose * realHessian P x * U) (tangent i) (tangent j))^2) = _
  rw [← hH]
  simp only [realHessian_apply, mul_pow, ← Finset.mul_sum]
  rw [Finset.sum_comm]
  simp only [inv_pow, div_eq_mul_inv, mul_comm, tangent]

end
end Source29PolynomialFramedCurvature

/- Component: PolynomialMovingCurvature.inc -/
namespace Source29PolynomialMovingCurvature

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialUnitNormal Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29AnalyticPairFrame Source29PairFrameMatrix
open Source29PolynomialFramedCurvature Source29CurvaturePotentialAnalytic
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def linkFrameMatrix (P : MvPolynomial (Option (Option ι)) ℝ) (x : Ambient ι) :
    Matrix (Option (Option ι)) (Option (Option ι)) ℝ :=
  frameMatrix base (Pi.single none 1) x (unitNormal P x)

/-- Actual Hessian components along the constructed analytic tangent frame. -/
def tangentSecondForm (P : MvPolynomial (Option (Option ι)) ℝ) (C : ℝ → Ambient ι)
    (i j : ι) (t : ℝ) : ℝ :=
  jacobiProfile P (C t) *
    (∑ b, ∑ a, tangentFrame P C i t a * realHessian P (C t) a b * tangentFrame P C j t b)

theorem tangentSecondForm_eq_framed (P : MvPolynomial (Option (Option ι)) ℝ)
    (C : ℝ → Ambient ι) (i j : ι) (t : ℝ) :
    tangentSecondForm P C i j t = framedSecondForm P (C t) (linkFrameMatrix P (C t)) i j := by
  simp only [tangentSecondForm, framedSecondForm, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_mul, tangentFrame, linkFrameMatrix, frameMatrix]

theorem linkFrameMatrix_pair
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hz : eval x P = 0)
    (hr : gradientAt P x ≠ 0) :
    linkFrameMatrix P x *ᵥ base = x ∧
      (∀ a, linkFrameMatrix P x a none = unitNormal P x a) := by
  have hxx : (base : Ambient ι) ⬝ᵥ base = x ⬝ᵥ x := by
    have hb : (base : Ambient ι) ⬝ᵥ base = 1 := by simp [base, single_dot_single]
    rw [hb]
    simpa only [dotProduct, pow_two] using hx.symm
  have hnn : (Pi.single none 1 : Ambient ι) ⬝ᵥ Pi.single none 1 =
      unitNormal P x ⬝ᵥ unitNormal P x := by
    rw [unitNormal_dot_self P x hr]
    simp [single_dot_single]
  have hrn : (base : Ambient ι) ⬝ᵥ Pi.single none 1 = 0 := by
    simp [base, single_dot_single]
  have hp := frame_pair base (Pi.single none 1) x (unitNormal P x) hxx hnn hrn
    (radial_dot_unitNormal P d hP x hz)
  constructor
  · simpa only [linkFrameMatrix, base, frameMatrix_mul_single] using hp.1
  · intro a
    exact congrFun hp.2 a

theorem tangentSecondForm_norm_sq_at
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (C : ℝ → Ambient ι) (t : ℝ)
    (hx : (∑ a, (C t a)^2) = 1) (hz : eval (C t) P = 0)
    (hr : gradientAt P (C t) ≠ 0) :
    (∑ i, ∑ j, (tangentSecondForm P C i j t)^2) = curvaturePotential P (C t) := by
  simp_rw [tangentSecondForm_eq_framed]
  obtain ⟨hbase, hnormal⟩ := linkFrameMatrix_pair P d hP (C t) hx hz hr
  exact framedSecondForm_norm_sq P d hP hd (C t) hr (linkFrameMatrix P (C t))
    (frameMatrix_transpose_mul _ _ _ _) hbase hnormal

variable (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)

include hg hgn hgt hC0 in
theorem regular_at_curve_zero : gradientAt P (C 0) ≠ 0 := by
  rw [hC0]
  intro he
  have hn := congrFun he none
  exact hg.ne' (by simpa only [gradientAt, hgn, Pi.zero_apply] using hn)

include hP hg hgn hgt hC hC0 hmem in
theorem tangentSecondForm_analyticAt (i j : ι) : AnalyticAt ℝ (tangentSecondForm P C i j) 0 := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame P d hP g hg hgn hgt C hC hC0 hmem
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  have hH : ∀ a b, AnalyticAt ℝ (fun t => realHessian P (C t) a b) 0 := by
    intro a b
    exact (analyticAt_eval_real (pderiv a (pderiv b P)) (C 0)).comp hC
  apply hφ.mul
  apply analytic_sum
  intro b
  apply analytic_sum
  intro a
  exact (((analyticAt_pi_iff.mp (hE i)) a).mul (hH a b)).mul
    ((analyticAt_pi_iff.mp (hE j)) b)

include hg hgn hgt hC0 in
theorem tangentSecondForm_zero (i j : ι) : tangentSecondForm P C i j 0 = A P g i j := by
  simp only [tangentSecondForm, tangentFrame, hC0, unitNormal_at_base P g hg hgn hgt,
    frame_self, jacobiProfile_at_base P g hg hgn hgt]
  simp [Pi.single_apply, A, Source29PolynomialTangentialDerivative.hessian,
    realHessian_apply, div_eq_mul_inv, mul_comm]

include hP hg hgn hgt hC hC0 hmem in
theorem tangentSecondForm_local_norm (hd : 2 ≤ d) :
    (fun t => (curvatureNorm P (C t))^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => ∑ i, ∑ j, (tangentSecondForm P C i j t)^2) := by
  have hgrad : AnalyticAt ℝ (fun t => gradientAt P (C t)) 0 := by
    apply AnalyticAt.pi
    intro a
    exact (analyticAt_eval_real (pderiv a P) (C 0)).comp hC
  have hnear := hgrad.continuousAt.eventually_ne (regular_at_curve_zero P g hg hgn hgt C hC0)
  filter_upwards [hmem, hnear] with t ht hr
  have he := tangentSecondForm_norm_sq_at P d hP hd C t ht.2 ht.1 hr
  have hn : 0 ≤ curvaturePotential P (C t) := by
    rw [← he]
    exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => sq_nonneg _))
  exact (Real.sq_sqrt hn).trans he.symm

end
end Source29PolynomialMovingCurvature

/- Component: PolynomialProfileFirst.inc -/
namespace Source29PolynomialProfileFirst

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29NormalizedLinkJets
open Source29AnalyticTensorNorm Source29PolynomialMovingCurvature
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem jacobiProfile_tangent_deriv
    (P : MvPolynomial (Option (Option ι)) ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (fun t => jacobiProfile P (C t)) 0 = -w P g i / g := by
  let G := fun a t => eval (C t) (pderiv a P)
  let q := fun t => tensorNorm (fun a => G a t)
  have hG : ∀ a, AnalyticAt ℝ (G a) 0 := fun a =>
    (analyticAt_eval_real (pderiv a P) (C 0)).comp hC
  have hq0 : q 0 = g := by
    simp [q, G, hC0, tensorNorm, Fintype.sum_option, hgn, hgt, Real.sqrt_sq hg.le]
  have hq : AnalyticAt ℝ q 0 := tensorNorm_analyticAt _ _ hG
    (regular_at_curve_zero P g hg hgn hgt C hC0)
  have hnorm := (Source29AnalyticNormDerivatives.norm_first_second q G hq hG
    (Eventually.of_forall (fun t => tensorNorm_sq (fun a => G a t)))).1
  have hgrad : ∀ a, G a 0 = eval base (pderiv a P) := by intro a; simp only [G, hC0]
  simp only [hq0, hgrad, Fintype.sum_option, hgn, hgt, zero_mul,
    Finset.sum_const_zero, add_zero] at hnorm
  have hq1 : deriv q 0 = eval base (pderiv (tangent i) (pderiv none P)) := by
    have he := mul_left_cancel₀ hg.ne' hnorm
    rw [he]
    exact Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv none P)
      (fun a t => C t a) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun a => congrFun hC0 a) hC1
  have he := (hq.differentiableAt.hasDerivAt.inv (by simpa only [hq0] using hg.ne')).deriv
  simp only [Pi.inv_def] at he
  change deriv (fun t => (q t)⁻¹) 0 = _
  rw [he, hq0, hq1]
  simp only [w, Source29PolynomialTangentialDerivative.hessian]
  rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
  ring

end
end Source29PolynomialProfileFirst

/- Component: AnalyticBilinearDerivative.inc -/
namespace Source29AnalyticBilinearDerivative

open scoped BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ]

theorem hasDerivAt_bilinear
    (u v : ℝ → κ → ℝ) (H : ℝ → κ → κ → ℝ)
    (du dv : κ → ℝ) (dH : κ → κ → ℝ)
    (hu : ∀ a, HasDerivAt (fun t => u t a) (du a) 0)
    (hv : ∀ a, HasDerivAt (fun t => v t a) (dv a) 0)
    (hH : ∀ a b, HasDerivAt (fun t => H t a b) (dH a b) 0) :
    HasDerivAt (fun t => ∑ b, ∑ a, u t a * H t a b * v t b)
      ((∑ b, ∑ a, du a * H 0 a b * v 0 b) +
       (∑ b, ∑ a, u 0 a * dH a b * v 0 b) +
       (∑ b, ∑ a, u 0 a * H 0 a b * dv b)) 0 := by
  have he := HasDerivAt.fun_sum (u := Finset.univ) (fun b _ =>
    HasDerivAt.fun_sum (u := Finset.univ) (fun a _ => ((hu a).mul (hH a b)).mul (hv b)))
  convert he using 1
  simp only [add_mul, Finset.sum_add_distrib, Pi.mul_def]

/-- The actual second derivative of a matrix bilinear form along analytic
vector and matrix curves, including all frame-derivative terms. -/
theorem second_deriv_bilinear
    (u v : ℝ → κ → ℝ) (H : ℝ → κ → κ → ℝ)
    (hu : ∀ a, AnalyticAt ℝ (fun t => u t a) 0)
    (hv : ∀ a, AnalyticAt ℝ (fun t => v t a) 0)
    (hH : ∀ a b, AnalyticAt ℝ (fun t => H t a b) 0) :
    deriv (deriv (fun t => ∑ b, ∑ a, u t a * H t a b * v t b)) 0 =
      ∑ b, ∑ a,
        (deriv (deriv (fun t => u t a)) 0 * H 0 a b * v 0 b +
        u 0 a * deriv (deriv (fun t => H t a b)) 0 * v 0 b +
        u 0 a * H 0 a b * deriv (deriv (fun t => v t b)) 0 +
        2 * deriv (fun t => u t a) 0 * deriv (fun t => H t a b) 0 * v 0 b +
        2 * deriv (fun t => u t a) 0 * H 0 a b * deriv (fun t => v t b) 0 +
        2 * u 0 a * deriv (fun t => H t a b) 0 * deriv (fun t => v t b) 0) := by
  classical
  have ha : ∀ a b, AnalyticAt ℝ (fun t => u t a * H t a b * v t b) 0 :=
    fun a b => ((hu a).mul (hH a b)).mul (hv b)
  rw [Source29AnalyticNormDerivatives.second_deriv_sum _
    (fun b => Source29CurvaturePotentialAnalytic.analytic_sum _ 0 (fun a => ha a b))]
  apply Finset.sum_congr rfl
  intro b _
  rw [Source29AnalyticNormDerivatives.second_deriv_sum _ (fun a => ha a b)]
  apply Finset.sum_congr rfl
  intro a _
  rw [Source29AnalyticInverseNorm.second_deriv_product
    (fun t => u t a * H t a b) (fun t => v t b) ((hu a).mul (hH a b)) (hv b),
    Source29AnalyticInverseNorm.second_deriv_product
    (fun t => u t a) (fun t => H t a b) (hu a) (hH a b)]
  have hd := ((hu a).differentiableAt.hasDerivAt.mul (hH a b).differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def] at hd
  rw [hd]
  ring

end
end Source29AnalyticBilinearDerivative

/- Component: PolynomialSecondFormFirst.inc -/
namespace Source29PolynomialSecondFormFirst

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialUnitNormal Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29PolynomialTangentFrameJets Source29PolynomialMovingCurvature
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem tangentSecondForm_first_deriv
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j k : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (tangentSecondForm P C j k) 0 = B P g i j k := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame P d hP g hg hgn hgt C hC hC0 hmem
  let H := fun t a b => eval (C t) (pderiv a (pderiv b P))
  let T := fun a b => eval base (pderiv (tangent i) (pderiv a (pderiv b P)))
  let J := fun t => ∑ b, ∑ a, tangentFrame P C j t a * H t a b * tangentFrame P C k t b
  have hH : ∀ a b, HasDerivAt (fun t => H t a b) (T a b) 0 := by
    intro a b
    have ha := (analyticAt_eval_real (pderiv a (pderiv b P)) (C 0)).comp hC
    have he := Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv a (pderiv b P))
      (fun c t => C t c) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun c => congrFun hC0 c) hC1
    have hh : HasDerivAt (fun t => H t a b) (deriv (fun t => H t a b) 0) 0 :=
      ha.differentiableAt.hasDerivAt
    rw [show deriv (fun t => H t a b) 0 = T a b from he] at hh
    exact hh
  have hdE : ∀ l a, HasDerivAt (fun t => tangentFrame P C l t a)
      (-(if i = l then 1 else 0) * base a - A P g i l * Pi.single (M := fun _ => ℝ) none 1 a) 0 := by
    intro l a
    have he := tangentFrame_first_deriv P g hg hgn hgt C hC hC0 i l hC1 a
    exact he ▸ ((analyticAt_pi_iff.mp (hE l)) a).differentiableAt.hasDerivAt
  have hJ := Source29AnalyticBilinearDerivative.hasDerivAt_bilinear
    (tangentFrame P C j) (tangentFrame P C k) H
    (fun a => -(if i = j then 1 else 0) * base a - A P g i j * Pi.single (M := fun _ => ℝ) none 1 a)
    (fun a => -(if i = k then 1 else 0) * base a - A P g i k * Pi.single (M := fun _ => ℝ) none 1 a)
    T (hdE j) (hdE k) hH
  have hrad : ∀ l, realHessian P base (some none) (tangent l) = 0 := by
    intro l
    have he := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
      (some none) (tangent l)).1
    change realHessian P base (some none) (tangent l) = ((d : ℝ)-1)*eval base (pderiv (tangent l) P) at he
    rw [show eval base (pderiv (tangent l) P) = 0 from hgt (some l), mul_zero] at he
    exact he
  have hsym : ∀ a b, realHessian P base a b = realHessian P base b a := by
    intro a b
    simp only [realHessian_apply, Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
  have hJd : deriv J 0 = T (tangent j) (tangent k) -
      A P g i j * eval base (pderiv none (pderiv (tangent k) P)) -
      A P g i k * eval base (pderiv none (pderiv (tangent j) P)) := by
    have he := hJ.deriv
    change deriv J 0 = _ at he
    rw [he]
    have hb : ∀ a, (base : Ambient ι) a = if a = some none then 1 else 0 := by
      intro a
      simp [base, Pi.single_apply]
    simp only [H, hC0, hE0, hb, Pi.single_apply, sub_mul, mul_sub, mul_ite, ite_mul,
      mul_one, one_mul, mul_zero, zero_mul, Finset.sum_sub_distrib,
      Finset.sum_ite_irrel, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.sum_const_zero, Finset.mem_univ, if_true]
    have hrj : eval base (pderiv (tangent j) (pderiv (some none) P)) = 0 := by
      rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
      exact hrad j
    rw [show eval base (pderiv (some none) (pderiv (tangent k) P)) = 0 from hrad k, hrj]
    rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm (i := tangent j) (j := none)]
    ring
  have hJ0 : J 0 = eval base (pderiv (tangent j) (pderiv (tangent k) P)) := by
    simp only [J, H, hC0, hE0, Pi.single_apply, mul_ite, ite_mul,
      mul_one, one_mul, mul_zero, zero_mul, Finset.sum_ite_irrel,
      Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.sum_const_zero, Finset.mem_univ, if_true]
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  have hφd := Source29PolynomialProfileFirst.jacobiProfile_tangent_deriv P g hg hgn hgt C hC hC0 i hC1
  have hJhas : HasDerivAt J (deriv J 0) 0 := hJ.differentiableAt.hasDerivAt
  have he : deriv (fun t => jacobiProfile P (C t) * J t) 0 =
      deriv (fun t => jacobiProfile P (C t)) 0 * J 0 +
        jacobiProfile P (C 0) * deriv J 0 :=
    (hφ.differentiableAt.hasDerivAt.mul hJhas).deriv
  change deriv (fun t => jacobiProfile P (C t) * J t) 0 = _
  rw [he, hφd, hJd, hJ0, hC0, jacobiProfile_at_base P g hg hgn hgt]
  simp only [B, S, w, A, T, Source29PolynomialTangentialDerivative.hessian,
    Source29PolynomialTangentialDerivative.third, realHessian_apply]
  ring

end
end Source29PolynomialSecondFormFirst

/- Component: AnalyticDotSecond.inc -/
namespace Source29AnalyticDotSecond

open Source29PairFrameDerivative
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ]

def acceleration (f : ℝ → κ → ℝ) : κ → ℝ :=
  fun a => deriv (deriv (fun t => f t a)) 0

theorem second_deriv_dot (u v : ℝ → κ → ℝ)
    (hu : ∀ a, AnalyticAt ℝ (fun t => u t a) 0)
    (hv : ∀ a, AnalyticAt ℝ (fun t => v t a) 0) :
    deriv (deriv (fun t => u t ⬝ᵥ v t)) 0 =
      acceleration u ⬝ᵥ v 0 + 2 * (velocity u ⬝ᵥ velocity v) + u 0 ⬝ᵥ acceleration v := by
  simp only [dotProduct]
  rw [Source29AnalyticNormDerivatives.second_deriv_sum (fun a t => u t a * v t a) (fun a => (hu a).mul (hv a))]
  simp_rw [Source29AnalyticInverseNorm.second_deriv_product
    (fun t => u t _) (fun t => v t _) (hu _) (hv _)]
  simp only [acceleration, velocity, Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]

end
end Source29AnalyticDotSecond

/- Component: PolynomialTangentFrameSecond.inc -/
namespace Source29PolynomialTangentFrameSecond

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29PolynomialTangentFrameJets
open Source29PairFrameDerivative Source29AnalyticDotSecond
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Orthonormality determines the symmetric tangential part of the actual
frame acceleration. It leaves only a skew rotation, which can be contracted out. -/
theorem tangentFrame_second_symmetric
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j k : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    acceleration (tangentFrame P C j) (tangent k) +
      acceleration (tangentFrame P C k) (tangent j) =
      -2 * ((if i = j then 1 else 0) * (if i = k then 1 else 0) + A P g i j * A P g i k) := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame P d hP g hg hgn hgt C hC hC0 hmem
  have he : (fun t => tangentFrame P C j t ⬝ᵥ tangentFrame P C k t) =
      (fun _ : ℝ => if j = k then (1 : ℝ) else 0) := funext (fun t => horth t j k)
  have hz : deriv (deriv (fun t => tangentFrame P C j t ⬝ᵥ tangentFrame P C k t)) 0 = 0 := by
    rw [he]
    simp only [deriv_const', deriv_const]
  rw [second_deriv_dot _ _ (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp (hE k)),
    hE0, hE0, dotProduct_single_one, single_one_dotProduct] at hz
  have hd : ∀ l a, velocity (tangentFrame P C l) a =
      -(if i = l then 1 else 0) * base a - A P g i l * Pi.single (M := fun _ => ℝ) none 1 a := by
    intro l a
    exact tangentFrame_first_deriv P g hg hgn hgt C hC hC0 i l hC1 a
  have hv : velocity (tangentFrame P C j) ⬝ᵥ velocity (tangentFrame P C k) =
      (if i = j then 1 else 0) * (if i = k then 1 else 0) + A P g i j * A P g i k := by
    simp only [dotProduct, hd, Fintype.sum_option, base, Pi.single_apply]
    simp only [Option.some.injEq, reduceCtorEq, ite_true, ite_false, mul_one, mul_zero,
      sub_zero, zero_sub, neg_mul_neg, zero_mul, Finset.sum_const_zero, add_zero]
    ring
  rw [hv] at hz
  linarith

end
end Source29PolynomialTangentFrameSecond

/- Component: PolynomialNormalSecond.inc -/
namespace Source29PolynomialNormalSecond

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialUnitNormal Source29PolynomialJacobiCurves Source29PolynomialMovingCurvature
open Source29PairFrameDerivative Source29AnalyticDotSecond
open Source29QuarticReuse.QuarticPolynomialBasics (second_partial_comm)
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

variable (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)

include hg hgn hgt hC hC0 hC1 in
theorem unitNormal_first_coordinate (a : Option (Option ι)) :
    velocity (fun t => unitNormal P (C t)) a =
      -w P g i / g * eval base (pderiv a P) +
        g⁻¹ * eval base (pderiv (tangent i) (pderiv a P)) := by
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  have hG := (analyticAt_eval_real (pderiv a P) (C 0)).comp hC
  have he := (hφ.differentiableAt.hasDerivAt.mul hG.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  change deriv (fun t => jacobiProfile P (C t) * eval (C t) (pderiv a P)) 0 = _
  rw [he, Source29PolynomialProfileFirst.jacobiProfile_tangent_deriv P g hg hgn hgt C hC hC0 i hC1,
    Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv a P)
      (fun b t => C t b) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun b => congrFun hC0 b) hC1, hC0, jacobiProfile_at_base P g hg hgn hgt]

include hP hd hg hgn hgt hC hC0 hC1 in
theorem unitNormal_first_radial_normal :
    velocity (fun t => unitNormal P (C t)) (some none) = 0 ∧
      velocity (fun t => unitNormal P (C t)) none = 0 := by
  have hr := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
    (some none) (tangent i)).1
  change eval base (pderiv (some none) (pderiv (tangent i) P)) =
    ((d : ℝ)-1)*eval base (pderiv (tangent i) P) at hr
  rw [show eval base (pderiv (tangent i) P) = 0 from hgt (some i), mul_zero] at hr
  constructor
  · rw [unitNormal_first_coordinate P g hg hgn hgt C hC hC0 i hC1,
      hgt none, mul_zero, zero_add, second_partial_comm, hr, mul_zero]
  · rw [unitNormal_first_coordinate P g hg hgn hgt C hC hC0 i hC1, hgn]
    simp only [w, Source29PolynomialTangentialDerivative.hessian]
    rw [second_partial_comm]
    field_simp
    ring

include hP hd hg hgn hgt hC hC0 hC1 in
theorem unitNormal_second_tangent
    (hC2 : ∀ a, acceleration C a = -base a -
      A P g i i * Pi.single (M := fun _ => ℝ) none 1 a) (j : ι) :
    acceleration (fun t => unitNormal P (C t)) (tangent j) =
      S P g i i j - A P g i i * w P g j - 2 * w P g i * A P g i j := by
  let G := fun t => eval (C t) (pderiv (tangent j) P)
  have hG : AnalyticAt ℝ G 0 :=
    (analyticAt_eval_real (pderiv (tangent j) P) (C 0)).comp hC
  have hG0 : G 0 = 0 := by simpa only [G, hC0, tangent] using hgt (some j)
  have hG1 : deriv G 0 = eval base (pderiv (tangent i) (pderiv (tangent j) P)) :=
    Source29PolynomialCurveCoordinateJets.coordinate_velocity_first (pderiv (tangent j) P)
      (fun a t => C t a) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun a => congrFun hC0 a) hC1
  have hG2 : deriv (deriv G) 0 =
      eval base (pderiv (tangent i) (pderiv (tangent i) (pderiv (tangent j) P))) -
        A P g i i * eval base (pderiv none (pderiv (tangent j) P)) := by
    have he := Source29PolynomialCurveCoordinateJets.coordinate_velocity_second (pderiv (tangent j) P)
      (fun a t => C t a) base (tangent i) (analyticAt_pi_iff.mp hC)
      (fun a => congrFun hC0 a) hC1
    change deriv (deriv G) 0 = _ at he
    rw [he]
    have hr := (Source29HomogeneousRadialJets.radial_coordinate_jets P d hP hd
      (some none) (tangent j)).1
    change eval base (pderiv (some none) (pderiv (tangent j) P)) =
      ((d : ℝ)-1)*eval base (pderiv (tangent j) P) at hr
    rw [show eval base (pderiv (tangent j) P) = 0 from hgt (some j), mul_zero] at hr
    have hb : ∀ a, (base : Ambient ι) a = if a = some none then 1 else 0 := by
      intro a
      simp [base, Pi.single_apply]
    change _ + (∑ a, eval base (pderiv a (pderiv (tangent j) P)) * acceleration C a) = _
    simp only [hC2, hb, Pi.single_apply, mul_sub, mul_neg, mul_ite, mul_one, mul_zero,
      Finset.sum_sub_distrib, Finset.sum_neg_distrib, Finset.sum_ite_eq', Finset.sum_ite_eq,
      Finset.mem_univ, if_true, hr]
    ring
  have hφ := (jacobiProfile_analyticAt P (C 0)
    (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  change deriv (deriv (fun t => jacobiProfile P (C t) * G t)) 0 = _
  rw [Source29AnalyticInverseNorm.second_deriv_product (fun t => jacobiProfile P (C t)) G hφ hG, hG0, mul_zero, zero_add,
    Source29PolynomialProfileFirst.jacobiProfile_tangent_deriv P g hg hgn hgt C hC hC0 i hC1,
    hG1, hG2, hC0, jacobiProfile_at_base P g hg hgn hgt]
  simp only [S, w, A, Source29PolynomialTangentialDerivative.third,
    Source29PolynomialTangentialDerivative.hessian]
  ring

end
end Source29PolynomialNormalSecond

/- Component: PolynomialFrameNormalAcceleration.inc -/
namespace Source29PolynomialFrameNormalAcceleration

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialTangentFrame Source29PolynomialTangentFrameJets
open Source29PolynomialUnitNormal Source29PolynomialMovingCurvature
open Source29PairFrameDerivative Source29AnalyticDotSecond Source29PolynomialNormalSecond
open scoped BigOperators Matrix Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Differentiating the actual tangency relation determines the normal
component of the frame acceleration, without choosing its skew tangent part. -/
theorem tangentFrame_second_normal
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, acceleration C a = -base a -
      A P g i i * Pi.single (M := fun _ => ℝ) none 1 a) :
    acceleration (tangentFrame P C j) none =
      -S P g i i j + A P g i i * w P g j + 2 * w P g i * A P g i j := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame P d hP g hg hgn hgt C hC hC0 hmem
  have hN : AnalyticAt ℝ (fun t => unitNormal P (C t)) 0 :=
    (unitNormal_analyticAt P (C 0) (regular_at_curve_zero P g hg hgn hgt C hC0)).comp hC
  have hN0 : unitNormal P (C 0) = Pi.single none 1 := by
    rw [hC0, unitNormal_at_base P g hg hgn hgt]
  have hz : (fun t => tangentFrame P C j t ⬝ᵥ unitNormal P (C t)) =ᶠ[𝓝 (0 : ℝ)]
      (fun _ => (0 : ℝ)) := by
    filter_upwards [htan] with t ht
    exact (ht j).2
  have he := hz.deriv.deriv_eq
  simp only [deriv_const', deriv_const] at he
  rw [second_deriv_dot _ _ (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp hN),
    hE0, hN0, dotProduct_single_one, single_one_dotProduct] at he
  have hdE : ∀ a, velocity (tangentFrame P C j) a =
      -(if i = j then 1 else 0) * base a - A P g i j * Pi.single (M := fun _ => ℝ) none 1 a := by
    intro a
    exact tangentFrame_first_deriv P g hg hgn hgt C hC hC0 i j hC1 a
  have hN1 := unitNormal_first_radial_normal P d hP hd g hg hgn hgt C hC hC0 i hC1
  have hv : velocity (tangentFrame P C j) ⬝ᵥ velocity (fun t => unitNormal P (C t)) = 0 := by
    simp only [dotProduct, hdE, Fintype.sum_option, base, Pi.single_apply]
    simp only [Option.some.injEq, reduceCtorEq, ite_true, ite_false, mul_one, mul_zero,
      sub_zero, zero_sub, zero_mul, Finset.sum_const_zero, add_zero, hN1.1, hN1.2]
  rw [hv, mul_zero, add_zero,
    unitNormal_second_tangent P d hP hd g hg hgn hgt C hC hC0 i hC1 hC2 j] at he
  linarith

/-- The normal frame acceleration is exactly the negative of the first
covariant tensor, evaluated twice in the curve direction. -/
theorem tangentFrame_second_normal_eq_neg_B
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d)
    (g : ℝ) (hg : 0 < g)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, acceleration C a = -base a -
      A P g i i * Pi.single (M := fun _ => ℝ) none 1 a) :
    acceleration (tangentFrame P C j) none = -B P g i i j := by
  rw [tangentFrame_second_normal P d hP hd g hg hgn hgt C hC hC0 hmem i j hC1 hC2]
  unfold B
  ring

/-- The normal acceleration disappears when summed over all link directions. -/
theorem tangentFrame_normal_acceleration_trace
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g) (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a -
      A P g i i * Pi.single (M := fun _ => ℝ) none 1 a) (j : ι) :
    (∑ i, acceleration (tangentFrame P (C i) j) none) = 0 := by
  simp_rw [tangentFrame_second_normal_eq_neg_B P d hP (by omega) g hg hgn hgt
    (C _) (hC _) (hC0 _) (hmem _) _ j (hC1 _) (hC2 _)]
  rw [Finset.sum_neg_distrib, Source29NormalizedLinkTraces.B_trace P d hP hd g hg.ne' hL hgn hgt,
    neg_zero]

end
end Source29PolynomialFrameNormalAcceleration

/- Component: SymmetricFrameContraction.inc -/
namespace Source29SymmetricFrameContraction

open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι]

/-- A symmetric tensor sees only the symmetric part of the frame acceleration;
the undetermined skew rotation contributes zero to the contraction. -/
theorem contract_of_symmetric_part (W E M : ι → ι → ℝ)
    (hW : ∀ a b, W a b = W b a)
    (hE : ∀ a b, E a b + E b a = -2 * M a b) :
    (∑ a, ∑ b, W a b * E a b) = -(∑ a, ∑ b, W a b * M a b) := by
  have hs : (∑ a, ∑ b, W a b * E b a) = ∑ a, ∑ b, W a b * E a b := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro a _
    apply Finset.sum_congr rfl
    intro b _
    rw [hW b a]
  have he : (∑ a, ∑ b, W a b * (E a b + E b a)) =
      -2 * (∑ a, ∑ b, W a b * M a b) := by
    simp_rw [hE]
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    apply Finset.sum_congr rfl
    intro b _
    ring
  simp only [mul_add, Finset.sum_add_distrib, hs] at he
  linarith

end
end Source29SymmetricFrameContraction

/- Component: NormalizedHessianCurve.inc -/
namespace Source29NormalizedHessianCurve

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
