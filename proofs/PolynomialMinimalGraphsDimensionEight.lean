  have hzero (t : ℝ) : radialTest f (x,t) = 0 :=
    Source29GraphSmallDensity.cutoff_zero_outside_box (fun _ ↦ t) (by norm_num) hz x hx
  unfold primitive
  simp_rw [hzero]
  simp

