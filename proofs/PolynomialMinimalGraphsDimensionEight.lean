noncomputable section
variable {n : ℕ}

def planeMass (n : ℕ) (f : ℝ → ℝ) : ℝ := ∫ x : Fin n → ℝ, f (∑ i, x i ^ 2)

theorem tangentHeight_eq (P : MvPolynomial (Fin n) ℝ) (x : Fin n → ℝ) :
    tangentHeight P x = evaluatedGradient P 0 ⬝ᵥ x := by
  rw [tangentHeight, evalFDeriv_apply]
  rfl

theorem tangent_integral (P : MvPolynomial (Fin n) ℝ) {f : ℝ → ℝ} (hf : Continuous f) :
    (∫ x, f (graphRadiusSq (tangentHeight P) x) * areaDensity (evaluatedGradient P 0)) =
      planeMass n f := by
  simp_rw [graphRadiusSq, tangentHeight_eq]
  exact Source29PlaneRadialIntegral.tilted_integral _ hf

/-- Every centered polynomial graph has the same small-radius density as a plane. -/
theorem small_radius_limit (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    {f : ℝ → ℝ} (hf : Continuous f) (hb : ∀ t, ‖f t‖ ≤ 1) {R : ℝ} (hR : 0 ≤ R)
    (hz : ∀ t, R ≤ t → f t = 0) :
    Tendsto (normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) f) (𝓝[>] 0)
      (𝓝 (planeMass n f)) := by
  have ht := Source29GraphSmallDensity.small_radius_limit P hP hf hb hR hz
  rwa [tangent_integral P hf] at ht

theorem radial_small_radius_limit (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0) :
    Tendsto (normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) radialCutoff) (𝓝[>] 0)
      (𝓝 (planeMass n radialCutoff)) := by
  apply small_radius_limit P hP radialCutoff_contDiff.continuous _ (R := 2) (by norm_num) radialCutoff_zero
  intro t
  rw [Real.norm_eq_abs, abs_of_nonneg (radialCutoff_bounds t).1]
  exact (radialCutoff_bounds t).2

/-- Only the density at infinity remains to be supplied in this rigidity criterion. -/
theorem affine_of_radial_limit_atTop (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hi : Tendsto (normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) radialCutoff)
      atTop (𝓝 (planeMass n radialCutoff))) : Math30.MinimalGraphs.IsAffine P :=
  Source29PolynomialRadialRigidity.affine_of_equal_radial_limits P hmin
    (radial_small_radius_limit P hP) hi

end
end Source29PolynomialSmallDensity

/- Component: PolynomialCentering.inc -/
namespace Source29PolynomialCentering

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction
open Source29GraphMassMonotonicity Source29PolynomialGraphMonotonicity
open Source29PolynomialSmallDensity
open scoped Topology

noncomputable section
variable {n : ℕ}

def centered (P : MvPolynomial (Fin n) ℝ) : MvPolynomial (Fin n) ℝ := P - C (eval 0 P)

theorem centered_eval_zero (P : MvPolynomial (Fin n) ℝ) : eval 0 (centered P) = 0 := by
  simp [centered]

theorem centered_gradient (P : MvPolynomial (Fin n) ℝ) :
    evaluatedGradient (centered P) = evaluatedGradient P := by
  funext x i
  simp [evaluatedGradient, centered]

theorem centered_minimal_iff (P : MvPolynomial (Fin n) ℝ) :
    Math30.MinimalGraphs.SatisfiesMinimalGraphEquation (centered P) ↔
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P := by
  simp [Math30.MinimalGraphs.SatisfiesMinimalGraphEquation,
    Math30.MinimalGraphs.minimalGraphOperator, centered]

theorem centered_affine_iff (P : MvPolynomial (Fin n) ℝ) :
    Math30.MinimalGraphs.IsAffine (centered P) ↔ Math30.MinimalGraphs.IsAffine P := by
  change (P - C (eval 0 P)).totalDegree ≤ 1 ↔ P.totalDegree ≤ 1
  constructor
  · intro h
    have he : P = (P - C (eval 0 P)) + C (eval 0 P) := by ring
    calc
      P.totalDegree = ((P - C (eval 0 P)) + C (eval 0 P)).totalDegree := congrArg _ he
      _ ≤ max (P - C (eval 0 P)).totalDegree (C (eval 0 P) : MvPolynomial (Fin n) ℝ).totalDegree := totalDegree_add _ _
      _ ≤ 1 := by simp only [totalDegree_C, max_le_iff]; exact ⟨h, by omega⟩
  · exact fun h ↦ (totalDegree_sub_C_le P (eval 0 P)).trans h

/-- Centering reduces rigidity for any polynomial solution to its radial
mass limit at infinity. No limit at infinity is assumed to hold automatically. -/
theorem affine_of_centered_radial_limit (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hi : Tendsto (normalizedMass (fun y ↦ eval y (centered P)) (evaluatedGradient P) radialCutoff)
      atTop (𝓝 (planeMass n radialCutoff))) : Math30.MinimalGraphs.IsAffine P := by
  apply (centered_affine_iff P).mp
  apply affine_of_radial_limit_atTop (centered P) (centered_eval_zero P) ((centered_minimal_iff P).mpr hmin)
  rwa [centered_gradient]

end
end Source29PolynomialCentering

/- Component: PolynomialSequentialRigidity.inc -/
namespace Source29PolynomialSequentialRigidity

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction
open Source29GraphMassMonotonicity Source29PolynomialGraphMonotonicity
open Source29PolynomialSmallDensity Source29PolynomialCentering
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- For a monotone radial mass, convergence along any unbounded sequence
suffices for the upper bound needed by rigidity. -/
theorem affine_of_radial_sequence_limit (P : MvPolynomial (Fin n) ℝ) (hP : eval 0 P = 0)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    {r : ℕ → ℝ} (hr : Tendsto r atTop atTop)
    (hi : Tendsto (fun k ↦ normalizedMass (fun y ↦ eval y P) (evaluatedGradient P) radialCutoff (r k))
      atTop (𝓝 (planeMass n radialCutoff))) : Math30.MinimalGraphs.IsAffine P := by
  have hmono := polynomial_radialMass_monotoneOn P hmin
  have hz := radial_small_radius_limit P hP
  apply Source29PolynomialRadialRigidity.affine_of_constant_normalizedMass P hmin (C := planeMass n radialCutoff)
  intro s hs
  apply le_antisymm
  · apply ge_of_tendsto hi
    filter_upwards [hr.eventually (eventually_ge_atTop s)] with k hk
    exact hmono hs (hs.trans_le hk) hk
  · apply le_of_tendsto hz
    filter_upwards [self_mem_nhdsWithin, mem_nhdsWithin_of_mem_nhds (gt_mem_nhds hs)] with t ht hts
    exact hmono ht hs hts.le

theorem affine_of_centered_radial_sequence_limit (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    {r : ℕ → ℝ} (hr : Tendsto r atTop atTop)
    (hi : Tendsto (fun k ↦ normalizedMass (fun y ↦ eval y (centered P)) (evaluatedGradient P) radialCutoff (r k))
      atTop (𝓝 (planeMass n radialCutoff))) : Math30.MinimalGraphs.IsAffine P := by
  apply (centered_affine_iff P).mp
  apply affine_of_radial_sequence_limit (centered P) (centered_eval_zero P) ((centered_minimal_iff P).mpr hmin) hr
  simpa only [centered_gradient] using hi

end
end Source29PolynomialSequentialRigidity

/- Component: AmbientGraphCalculus.inc -/
namespace Source29AmbientGraphCalculus

open MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29GraphAreaConvexity
open scoped BigOperators Topology

noncomputable section
variable {n : ℕ}

def verticalDerivative (H : (Fin n → ℝ) × ℝ → ℝ) (x : Fin n → ℝ) (z : ℝ) : ℝ :=
  fderiv ℝ H (x,z) (0,1)

def baseDerivative (H : (Fin n → ℝ) × ℝ → ℝ) (x : Fin n → ℝ) (z : ℝ) (i : Fin n) : ℝ :=
  fderiv ℝ H (x,z) (Pi.single i 1,0)

theorem graph_composition_fderiv {u : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {H : (Fin n → ℝ) × ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hH : ContDiff ℝ 1 H)
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (x : Fin n → ℝ) (i : Fin n) :
    fderiv ℝ (fun y ↦ H (y,u y)) x (Pi.single i 1) =
      baseDerivative H x (u x) i + verticalDerivative H x (u x) * g x i := by
  have hc := (hasFDerivAt_id x).prodMk ((hu.differentiable (by norm_num) x).hasFDerivAt)
  have hd := ((hH.differentiable (by norm_num) (x,u x)).hasFDerivAt).comp x hc
  simp only [Function.comp_def, id_eq] at hd
  rw [hd.fderiv]
  change fderiv ℝ H (x,u x) (Pi.single i 1, fderiv ℝ u x (Pi.single i 1)) = _
  rw [hdu]
  have he : (Pi.single i 1, g x i) =
      (Pi.single i 1, (0 : ℝ)) + g x i • ((0 : Fin n → ℝ), (1 : ℝ)) := by
    simp
  rw [he, map_add, map_smul]
  change baseDerivative H x (u x) i + g x i * verticalDerivative H x (u x) = _
  ring

theorem graph_composition_flux {u : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {H : (Fin n → ℝ) × ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hH : ContDiff ℝ 1 H)
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i) (x : Fin n → ℝ) :
    testFlux (fun i ↦ Pi.single i 1) (fun y ↦ H (y,u y)) (normalizedField g) x =
      (∑ i, baseDerivative H x (u x) i * normalizedField g x i) +
      verticalDerivative H x (u x) * (areaDensity (g x) - 1 / areaDensity (g x)) := by
  simp only [testFlux, graph_composition_fderiv hu hH hdu, add_mul, Finset.sum_add_distrib]
  simp_rw [mul_assoc, ← Finset.mul_sum]
  rw [Source29GraphMassIdentity.gradient_pair_normalized]

theorem fderiv_zero_outside_base {H : (Fin n → ℝ) × ℝ → ℝ} {K : Set (Fin n → ℝ)}
    (hK : IsClosed K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0)
    {x : Fin n → ℝ} (hx : x ∉ K) (z : ℝ) : fderiv ℝ H (x,z) = 0 := by
  have he : H =ᶠ[𝓝 (x,z)] (fun _ ↦ (0 : ℝ)) := by
    have hn : {p : (Fin n → ℝ) × ℝ | p.1 ∉ K} ∈ 𝓝 (x,z) :=
      (hK.isOpen_compl.preimage continuous_fst).mem_nhds hx
    filter_upwards [hn] with p hp
    exact hz p.1 hp p.2
  rw [he.fderiv_eq]
  simp

theorem graph_composition_compact {H : (Fin n → ℝ) × ℝ → ℝ} {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) (u : (Fin n → ℝ) → ℝ) :
    HasCompactSupport (fun x ↦ H (x,u x)) := by
  apply HasCompactSupport.of_support_subset_isCompact (K := K) hK
  intro x hx
  by_contra hnot
  exact hx (hz x hnot (u x))

theorem graph_derivative_compact {H : (Fin n → ℝ) × ℝ → ℝ} {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0)
    (u : (Fin n → ℝ) → ℝ) (v : (Fin n → ℝ) × ℝ) :
    HasCompactSupport (fun x ↦ fderiv ℝ H (x,u x) v) := by
  apply HasCompactSupport.of_support_subset_isCompact (K := K) hK
  intro x hx
  by_contra hnot
  apply hx
  change fderiv ℝ H (x,u x) v = 0
  rw [fderiv_zero_outside_base hK.isClosed hz hnot, zero_apply]

end
end Source29AmbientGraphCalculus

/- Component: AmbientGraphMass.inc -/
namespace Source29AmbientGraphMass

open MeasureTheory Set
open Source29QuarticReuse.FluxObstruction Source29GraphAreaConvexity Source29AmbientGraphCalculus
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def baseFlux (H : (Fin n → ℝ) × ℝ → ℝ) (u : (Fin n → ℝ) → ℝ)
    (g : (Fin n → ℝ) → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∑ i, baseDerivative H x (u x) i * normalizedField g x i

theorem graph_derivative_continuous {u : (Fin n → ℝ) → ℝ} {H : (Fin n → ℝ) × ℝ → ℝ}
    (hu : Continuous u) (hH : ContDiff ℝ 1 H) (v : (Fin n → ℝ) × ℝ) :
    Continuous (fun x ↦ fderiv ℝ H (x,u x) v) :=
  ((hH.continuous_fderiv (by norm_num)).comp (continuous_id.prodMk hu)).clm_apply continuous_const

theorem baseFlux_continuous {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    {H : (Fin n → ℝ) × ℝ → ℝ} (hu : Continuous u)
    (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i)) (hH : ContDiff ℝ 1 H) : Continuous (baseFlux H u g) := by
  apply continuous_finsetSum
  intro i hi
  exact (graph_derivative_continuous hu hH _).mul ((normalizedField_contDiff hg i).continuous)

theorem baseFlux_compact {u : (Fin n → ℝ) → ℝ} {g : (Fin n → ℝ) → Fin n → ℝ}
    {H : (Fin n → ℝ) × ℝ → ℝ} {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) :
    HasCompactSupport (baseFlux H u g) := by
  apply HasCompactSupport.of_support_subset_isCompact (K := K) hK
  intro x hx
  by_contra hnot
  apply hx
  unfold baseFlux baseDerivative
  simp only [fderiv_zero_outside_base hK.isClosed hz hnot, zero_apply, zero_mul, Finset.sum_const_zero]

/-- An arbitrary ambient height primitive gives an exact graph-area identity.
Its base support is compact; no compactness in the height variable is needed. -/
theorem ambient_mass_identity {u : (Fin n → ℝ) → ℝ}
    {g : (Fin n → ℝ) → Fin n → ℝ} {H : (Fin n → ℝ) × ℝ → ℝ}
    (hu : ContDiff ℝ 1 u) (hg : ∀ i, ContDiff ℝ 1 (fun x ↦ g x i))
    (hdu : ∀ x i, fderiv ℝ u x (Pi.single i 1) = g x i)
    (hdiv : ∀ x, divergence (fun i ↦ Pi.single i 1) (normalizedField g) x = 0)
    (hH : ContDiff ℝ 1 H) {K : Set (Fin n → ℝ)} (hK : IsCompact K)
    (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) :
    (∫ x, verticalDerivative H x (u x) * areaDensity (g x)) =
      (∫ x, verticalDerivative H x (u x) / areaDensity (g x)) - ∫ x, baseFlux H u g x := by
  have hw : Continuous (fun x ↦ areaDensity (g x)) := areaDensity_continuous g (fun i ↦ (hg i).continuous)
  have hv : Continuous (fun x ↦ verticalDerivative H x (u x)) := graph_derivative_continuous hu.continuous hH _
  have hcv : HasCompactSupport (fun x ↦ verticalDerivative H x (u x)) := graph_derivative_compact hK hz u _
  have hi : Integrable (fun x ↦ verticalDerivative H x (u x) * areaDensity (g x)) :=
    (hv.mul hw).integrable_of_hasCompactSupport hcv.mul_right
  have he : Integrable (fun x ↦ verticalDerivative H x (u x) / areaDensity (g x)) := by
    apply (hv.div hw (fun x ↦ (areaDensity_pos (g x)).ne')).integrable_of_hasCompactSupport
    have hc : HasCompactSupport (fun x ↦ verticalDerivative H x (u x) * (areaDensity (g x))⁻¹) := hcv.mul_right
    change HasCompactSupport (fun x ↦ verticalDerivative H x (u x) / areaDensity (g x))
    simpa only [div_eq_mul_inv] using hc
  have hb : Integrable (baseFlux H u g) :=
    (baseFlux_continuous hu.continuous hg hH).integrable_of_hasCompactSupport (baseFlux_compact hK hz)
  have ht : ContDiff ℝ 1 (fun x ↦ H (x,u x)) := hH.comp (contDiff_id.prodMk hu)
  have hzero := integral_testFlux_eq_zero (μ := volume) (fun i ↦ Pi.single i 1) ht
    (graph_composition_compact hK hz u) (normalizedField_contDiff hg) hdiv
  have hid : (fun x ↦ testFlux (fun i ↦ Pi.single i 1) (fun y ↦ H (y,u y)) (normalizedField g) x) =
      (fun x ↦ baseFlux H u g x + (verticalDerivative H x (u x) * areaDensity (g x) -
        verticalDerivative H x (u x) / areaDensity (g x))) := by
    funext x
    rw [graph_composition_flux hu hH hdu]
    unfold baseFlux
    ring
  have ha := integral_add hb (hi.sub he)
  have hs := integral_sub hi he
  simp only [Pi.sub_apply] at ha hs
  rw [hid, ha, hs] at hzero
  linarith

end
end Source29AmbientGraphMass

/- Component: GraphHeightFamilyLimits.inc -/
namespace Source29GraphHeightFamilyLimits

open MvPolynomial MeasureTheory Filter
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29GraphDilationFields Source29GraphHeightLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- Height-profile convergence also holds for a different profile at each base point. -/
theorem height_family_tendsto_ae (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {h : (Fin n → ℝ) → ℝ → ℝ} {a b : (Fin n → ℝ) → ℝ}
    (hp : ∀ x, Tendsto (h x) atTop (𝓝 (a x)))
    (hm : ∀ x, Tendsto (h x) atBot (𝓝 (b x))) :
    ∀ᵐ x : Fin n → ℝ, Tendsto (fun k ↦ h x (height P (dilationRadius k) x)) atTop
      (𝓝 (if 0 < eval x (homogeneousComponent P.totalDegree P) then a x else b x)) := by
  have hne := Source29QuarticReuse.QuarticPolynomialBasics.top_homogeneousComponent_ne_zero P
    (by omega : 0 < P.totalDegree)
  filter_upwards [mvPolynomial_eval_ne_zero_ae n _ hne] with x hx
  by_cases hs : 0 < eval x (homogeneousComponent P.totalDegree P)
  · simp only [ite_eq_left hs]
    exact (hp x).comp (height_tendsto_atTop P hdeg x hs)
  · simp only [ite_eq_right hs]
    exact (hm x).comp (height_tendsto_atBot P hdeg x (lt_of_le_of_ne (le_of_not_gt hs) hx))

end
end Source29GraphHeightFamilyLimits

/- Component: AmbientGraphLimits.inc -/
namespace Source29AmbientGraphLimits

open MvPolynomial MeasureTheory Filter Set
open Source29QuarticReuse.FluxObstruction Source29QuarticReuse.FluxPolynomial
open Source29GraphDilationFields Source29GraphAreaConvexity Source29GraphMassLimits
open Source29AmbientGraphCalculus Source29AmbientGraphMass Source29GraphHeightFamilyLimits
open scoped Topology BigOperators

noncomputable section
variable {n : ℕ}

theorem ambient_error_tendsto_zero (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {H : (Fin n → ℝ) × ℝ → ℝ} (hH : ContDiff ℝ 1 H) {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) {M : ℝ}
    (hb : ∀ x z, ‖verticalDerivative H x z‖ ≤ M)
    (hp : ∀ x, Tendsto (verticalDerivative H x) atTop (𝓝 0))
    (hm : ∀ x, Tendsto (verticalDerivative H x) atBot (𝓝 0)) :
    Tendsto (fun k ↦ ∫ x, verticalDerivative H x (height P (dilationRadius k) x) /
      areaDensity (gradient P (dilationRadius k) x)) atTop (𝓝 0) := by
  have hl : ∀ᵐ x, Tendsto (fun k ↦ verticalDerivative H x (height P (dilationRadius k) x)) atTop (𝓝 0) := by
    simpa only [ite_self] using height_family_tendsto_ae P hdeg hp hm
  have ht : Tendsto (fun k ↦ ∫ x, verticalDerivative H x (height P (dilationRadius k) x) /
      areaDensity (gradient P (dilationRadius k) x)) atTop (𝓝 (∫ _x : Fin n → ℝ, (0 : ℝ))) := by
    apply tendsto_integral_of_dominated_convergence (K.indicator (fun _ ↦ M))
    · intro k
      exact ((graph_derivative_continuous (height_contDiff P _).continuous hH _).div
        (areaDensity_continuous _ (fun i ↦ (gradient_contDiff P _ i).continuous))
        (fun x ↦ (areaDensity_pos _).ne')).aestronglyMeasurable
    · exact (integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hK.measure_lt_top.ne)
    · intro k
      apply Filter.Eventually.of_forall
      intro x
      by_cases hx : x ∈ K
      · rw [Set.indicator_of_mem hx]
        exact (norm_div_areaDensity_le _ _).trans (hb _ _)
      · rw [Set.indicator_of_notMem hx]
        simp only [verticalDerivative, fderiv_zero_outside_base hK.isClosed hz hx, zero_apply, zero_div, norm_zero, le_refl]
    · filter_upwards [hl] with x hx
      exact squeeze_zero_norm (fun k ↦ norm_div_areaDensity_le _ _) (by simpa only [norm_zero] using hx.norm)
  simpa only [integral_zero] using ht

theorem ambient_flux_tendsto (P : MvPolynomial (Fin n) ℝ) (hdeg : 2 ≤ P.totalDegree)
    {H : (Fin n → ℝ) × ℝ → ℝ} (hH : ContDiff ℝ 1 H) {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) {M : ℝ}
    (hb : ∀ x z i, ‖baseDerivative H x z i‖ ≤ M)
    {a b : (Fin n → ℝ) → Fin n → ℝ}
    (hp : ∀ x i, Tendsto (fun z ↦ baseDerivative H x z i) atTop (𝓝 (a x i)))
    (hm : ∀ x i, Tendsto (fun z ↦ baseDerivative H x z i) atBot (𝓝 (b x i))) :
    Tendsto (fun k ↦ ∫ x, baseFlux H (height P (dilationRadius k)) (gradient P (dilationRadius k)) x)
      atTop (𝓝 (∫ x, ∑ i, (if 0 < eval x (homogeneousComponent P.totalDegree P) then a x i else b x i) *
        leadingNormalizedField (homogeneousComponent P.totalDegree P) x i)) := by
  have hl i := height_family_tendsto_ae P hdeg (fun x ↦ hp x i) (fun x ↦ hm x i)
  have hn := Source29TopWeakCalibration.normalizedGradient_dilates_tendsto_ae P hdeg
  apply tendsto_integral_of_dominated_convergence (K.indicator (fun _ ↦ (n : ℝ)*M))
  · intro k
    exact (baseFlux_continuous (height_contDiff P _).continuous (gradient_contDiff P _) hH).aestronglyMeasurable
  · exact (integrable_indicator_iff hK.measurableSet).2 (integrableOn_const hK.measure_lt_top.ne)
  · intro k
    apply Filter.Eventually.of_forall
    intro x
    by_cases hx : x ∈ K
    · rw [Set.indicator_of_mem hx]
      unfold baseFlux
      calc
        ‖∑ i, baseDerivative H x (height P (dilationRadius k) x) i * normalizedField (gradient P (dilationRadius k)) x i‖
          ≤ ∑ i, ‖baseDerivative H x (height P (dilationRadius k) x) i * normalizedField (gradient P (dilationRadius k)) x i‖ := norm_sum_le _ _
        _ ≤ ∑ _i : Fin n, M := by
          apply Finset.sum_le_sum
          intro i hi
          rw [norm_mul]
          exact (mul_le_mul_of_nonneg_left (normalizedField_norm_le_one _ _ _) (norm_nonneg _)).trans (by simpa only [mul_one] using hb x (height P (dilationRadius k) x) i)
        _ = (n : ℝ)*M := by simp
    · rw [Set.indicator_of_notMem hx]
      simp only [baseFlux, baseDerivative, fderiv_zero_outside_base hK.isClosed hz hx, zero_apply, zero_mul, Finset.sum_const_zero, norm_zero, le_refl]
  · filter_upwards [ae_all_iff.mpr hl, hn] with x hx hnx
    exact tendsto_finsetSum _ (fun i _ ↦ (hx i).mul (hnx i))

/-- The ambient weighted graph mass converges to a flux determined by the
leading phase and the two endpoint values of the primitive's base derivatives. -/
theorem ambient_mass_tendsto (P : MvPolynomial (Fin n) ℝ)
    (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P) (hdeg : 2 ≤ P.totalDegree)
    {H : (Fin n → ℝ) × ℝ → ℝ} (hH : ContDiff ℝ 1 H) {K : Set (Fin n → ℝ)}
    (hK : IsCompact K) (hz : ∀ x, x ∉ K → ∀ z, H (x,z) = 0) {M N : ℝ}
    (hv : ∀ x z, ‖verticalDerivative H x z‖ ≤ M)
    (hvp : ∀ x, Tendsto (verticalDerivative H x) atTop (𝓝 0))
    (hvm : ∀ x, Tendsto (verticalDerivative H x) atBot (𝓝 0))
    (hb : ∀ x z i, ‖baseDerivative H x z i‖ ≤ N)
    {a b : (Fin n → ℝ) → Fin n → ℝ}
    (hp : ∀ x i, Tendsto (fun z ↦ baseDerivative H x z i) atTop (𝓝 (a x i)))
    (hm : ∀ x i, Tendsto (fun z ↦ baseDerivative H x z i) atBot (𝓝 (b x i))) :
    Tendsto (fun k ↦ ∫ x, verticalDerivative H x (height P (dilationRadius k) x) *
      areaDensity (gradient P (dilationRadius k) x)) atTop
      (𝓝 (-(∫ x, ∑ i, (if 0 < eval x (homogeneousComponent P.totalDegree P) then a x i else b x i) *
        leadingNormalizedField (homogeneousComponent P.totalDegree P) x i))) := by
  have he := ambient_error_tendsto_zero P hdeg hH hK hz hv hvp hvm
  have hf := ambient_flux_tendsto P hdeg hH hK hz hb hp hm
  have ht := he.sub hf
  simp only [zero_sub] at ht
  convert ht using 1
  funext k
  exact ambient_mass_identity (height_contDiff P _) (gradient_contDiff P _)
    (height_fderiv P _ (dilationRadius_pos k).ne') (normalized_gradient_divergence P hmin _)
    hH hK hz

end
end Source29AmbientGraphLimits

/- Component: CompactIntervalParameter.inc -/
namespace Source29CompactIntervalParameter

open MeasureTheory Filter Set Metric
open scoped Topology Interval

noncomputable section
variable {E G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
  [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]

theorem continuous_intervalIntegral {F : E × ℝ → G} (hF : Continuous F) (a b : ℝ) :
    Continuous (fun x ↦ ∫ t in a..b, F (x,t)) := by
  rw [continuous_iff_continuousAt]
  intro x
