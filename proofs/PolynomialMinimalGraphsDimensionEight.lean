/- Component: OddPowerNormalizedField.inc -/
namespace Source29OddPowerNormalizedField

open MvPolynomial
open Source29QuarticReuse.FluxObstruction
open scoped BigOperators

noncomputable section
variable {n : ℕ}

theorem normalized_mul_pos (v : Fin n → ℝ) {c : ℝ} (hc : 0 < c) (i : Fin n) :
    (c*v i) / Real.sqrt (radiusSq (fun j ↦ c*v j)) = v i / Real.sqrt (radiusSq v) := by
  have hs : radiusSq (fun j ↦ c*v j) = c^2 * radiusSq v := by
    simp only [radiusSq, mul_pow, Finset.mul_sum]
  rw [hs, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq_eq_abs, abs_of_pos hc]
  exact mul_div_mul_left _ _ hc.ne'

theorem normalized_neg (v : Fin n → ℝ) (i : Fin n) :
    (-v i) / Real.sqrt (radiusSq (fun j ↦ -v j)) = -(v i / Real.sqrt (radiusSq v)) := by
  simp only [radiusSq, neg_sq, neg_div]

theorem normalized_mul_neg (v : Fin n → ℝ) {c : ℝ} (hc : c < 0) (i : Fin n) :
    (c*v i) / Real.sqrt (radiusSq (fun j ↦ c*v j)) = -(v i / Real.sqrt (radiusSq v)) := by
  have he : (fun j ↦ c*v j) = fun j ↦ (-c)*(-v j) := by funext j; ring
  rw [show c*v i = (-c)*(-v i) by ring, he]
  rw [normalized_mul_pos (fun j ↦ -v j) (by linarith), normalized_neg]

theorem evaluatedGradient_C_pow (P : MvPolynomial (Fin n) ℝ) (c : ℝ) (k : ℕ)
    (x : Fin n → ℝ) (i : Fin n) :
    evaluatedGradient (C c * P^k) x i = (c*(k:ℝ)*(eval x P)^(k-1))*evaluatedGradient P x i := by
  simp [evaluatedGradient, pderiv_C_mul, pderiv_pow, mul_assoc]

theorem odd_gradient_factor_pos {k : ℕ} (hk : Odd k) {a : ℝ} (ha : a ≠ 0) :
    0 < (k:ℝ)*a^(k-1) := by
  have hkp : 0 < k := by obtain ⟨m,hm⟩ := hk; omega
  have he : Even (k-1) := by obtain ⟨m,hm⟩ := hk; exact ⟨m, by omega⟩
  exact mul_pos (by exact_mod_cast hkp) (he.pow_pos ha)

theorem normalizedField_C_pow_pos (P : MvPolynomial (Fin n) ℝ) {c : ℝ} (hc : 0 < c)
    {k : ℕ} (hk : Odd k) (x : Fin n → ℝ) (hx : eval x P ≠ 0) (i : Fin n) :
    leadingNormalizedField (C c * P^k) x i = leadingNormalizedField P x i := by
  have hs : 0 < c*(k:ℝ)*(eval x P)^(k-1) := by
    simpa only [mul_assoc] using mul_pos hc (odd_gradient_factor_pos hk hx)
  have hg : evaluatedGradient (C c * P^k) x = fun j ↦ (c*(k:ℝ)*(eval x P)^(k-1))*evaluatedGradient P x j := by
    funext j
    exact evaluatedGradient_C_pow P c k x j
  unfold leadingNormalizedField
  rw [hg]
  exact normalized_mul_pos _ hs i

theorem normalizedField_C_pow_neg (P : MvPolynomial (Fin n) ℝ) {c : ℝ} (hc : c < 0)
    {k : ℕ} (hk : Odd k) (x : Fin n → ℝ) (hx : eval x P ≠ 0) (i : Fin n) :
    leadingNormalizedField (C c * P^k) x i = -leadingNormalizedField P x i := by
  have hs : c*(k:ℝ)*(eval x P)^(k-1) < 0 := by
    simpa only [mul_assoc] using mul_neg_of_neg_of_pos hc (odd_gradient_factor_pos hk hx)
  have hg : evaluatedGradient (C c * P^k) x = fun j ↦ (c*(k:ℝ)*(eval x P)^(k-1))*evaluatedGradient P x j := by
    funext j
    exact evaluatedGradient_C_pow P c k x j
  unfold leadingNormalizedField
  rw [hg]
  exact normalized_mul_neg _ hs i

end
end Source29OddPowerNormalizedField

/- Component: OddPowerRadialFlux.inc -/
namespace Source29OddPowerRadialFlux

open MvPolynomial MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29OddPowerNormalizedField
open Source29PolynomialRadialLimit Source29RadialPrimitiveBounds
open scoped BigOperators

noncomputable section
variable {n : ℕ}

/-- Odd powers and a nonzero scalar do not change the unoriented radial phase flux. -/
theorem radialPhaseFlux_C_pow (P : MvPolynomial (Fin n) ℝ) (hP : P ≠ 0)
    {c : ℝ} (hc : c ≠ 0) {k : ℕ} (hk : Odd k) (f : ℝ → ℝ) :
    radialPhaseFlux (C c * P^k) f = radialPhaseFlux P f := by
  unfold radialPhaseFlux
  congr 1
  apply integral_congr_ae
  filter_upwards [mvPolynomial_eval_ne_zero_ae n P hP] with x hx
  apply Finset.sum_congr rfl
  intro i hi
  have hev : eval x (C c * P^k) = c*(eval x P)^k := by simp
  rcases hc.lt_or_gt with hc | hc
  · rw [normalizedField_C_pow_neg P hc hk x hx i, hev]
    by_cases hp : 0 < eval x P
    · have hq : c*(eval x P)^k < 0 := mul_neg_of_neg_of_pos hc (hk.pow_pos_iff.mpr hp)
      simp only [ite_eq_right (not_lt_of_ge hq.le), ite_eq_left hp, neg_mul_neg]
    · have hpneg : eval x P < 0 := lt_of_le_of_ne (le_of_not_gt hp) hx
      have hq : 0 < c*(eval x P)^k := mul_pos_of_neg_of_neg hc (hk.pow_neg hpneg)
      simp only [ite_eq_left hq, ite_eq_right hp, mul_neg, neg_mul]
  · rw [normalizedField_C_pow_pos P hc hk x hx i, hev]
    by_cases hp : 0 < eval x P
    · have hq : 0 < c*(eval x P)^k := mul_pos hc (hk.pow_pos_iff.mpr hp)
      simp only [ite_eq_left hq, ite_eq_left hp]
    · have hpneg : eval x P < 0 := lt_of_le_of_ne (le_of_not_gt hp) hx
      have hq : c*(eval x P)^k < 0 := mul_neg_of_pos_of_neg hc (hk.pow_neg hpneg)
      simp only [ite_eq_right (not_lt_of_ge hq.le), ite_eq_right hp]

end
end Source29OddPowerRadialFlux

/- Component: LinearNormalRotation.inc -/
namespace Source29LinearNormalRotation

open Matrix MeasureTheory
open Source29QuarticReuse.FluxObstruction Source29OrthogonalFrame
open scoped BigOperators

noncomputable section
variable {n : ℕ}

def unitVector (a : Fin (n+1) → ℝ) (i : Fin (n+1)) : ℝ := a i / Real.sqrt (radiusSq a)

theorem exists_rotation (a : Fin (n+1) → ℝ) (ha : a ≠ 0) :
    ∃ U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ,
      U.transpose * U = 1 ∧ U * U.transpose = 1 ∧ (∀ i, U i 0 = unitVector a i) := by
  let v : EuclideanSpace ℝ (Fin (n+1)) := WithLp.toLp 2 (unitVector a)
  have hR := radiusSq_pos_of_ne_zero ha
  have hv : ‖v‖ = 1 := by
    have hs : ‖v‖^2 = 1 := by
      rw [EuclideanSpace.real_norm_sq_eq]
      change (∑ i, (a i / Real.sqrt (radiusSq a))^2) = 1
      simp only [div_pow, ← Finset.sum_div]
      rw [Real.sq_sqrt hR.le]
      exact div_self hR.ne'
    nlinarith [norm_nonneg v]
  obtain ⟨T,hT,_⟩ := exists_isometry_of_orthogonal_pairs (coordinateUnit (0 : Fin (n+1))) 0 v 0
    ((coordinateUnit_norm 0).trans hv.symm) (by simp) (by simp) (by simp)
  let U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ := fun i j ↦ T (coordinateUnit j) i
  have hU : U.transpose * U = 1 := by
    ext i j
    change (∑ k, T (coordinateUnit i) k * T (coordinateUnit j) k) = if i = j then 1 else 0
    have he := T.inner_map_map (coordinateUnit i) (coordinateUnit j)
    rw [coordinateUnit_inner] at he
    simpa only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial, mul_comm] using he
  exact ⟨U,hU,mul_eq_one_comm.mp hU,fun i ↦ congrArg (fun z : EuclideanSpace ℝ (Fin (n+1)) ↦ z i) hT⟩

theorem radiusSq_mulVec (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) (x : Fin (n+1) → ℝ) : radiusSq (U *ᵥ x) = radiusSq x := by
  have he := Source29QuarticReuse.QuarticMinimal.MatrixAlgebra.dot_transpose_mulVec U.transpose
    (by simpa only [Matrix.transpose_transpose] using hU) x x
  simpa only [Matrix.transpose_transpose, dotProduct, ← pow_two, radiusSq] using he

theorem abs_det_rotation (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) : |U.det| = 1 := by
  have hd := congrArg Matrix.det hU
  rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hd
  have hs : |U.det|^2 = 1 := by rw [sq_abs, pow_two, hd]
  nlinarith [abs_nonneg U.det]

theorem integral_comp_rotation (U : Matrix (Fin (n+1)) (Fin (n+1)) ℝ)
    (hU : U.transpose * U = 1) {f : (Fin (n+1) → ℝ) → ℝ} (hf : AEStronglyMeasurable f volume) :
    (∫ x, f (U *ᵥ x)) = ∫ x, f x := by
  have hd := abs_det_rotation U hU
  have hn : U.det ≠ 0 := by intro h; simpa [h] using hd
  have hm := Real.map_matrix_volume_pi_eq_smul_volume_pi (M := U) hn
  rw [abs_inv, hd, inv_one, ENNReal.ofReal_one, one_smul] at hm
  have hc : Continuous (Matrix.toLin' U) := (Matrix.toLin' U).continuous_on_pi
  have hi := integral_map (μ := (volume : Measure (Fin (n+1) → ℝ))) hc.aemeasurable
    (show AEStronglyMeasurable f (Measure.map (Matrix.toLin' U) volume) from hm.symm ▸ hf)
  rw [hm] at hi
  exact hi.symm

end
end Source29LinearNormalRotation

/- Component: LinearEndpointRotation.inc -/
namespace Source29LinearEndpointRotation

open Matrix MvPolynomial MeasureTheory
