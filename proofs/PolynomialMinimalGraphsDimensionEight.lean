theorem normalizedHessian_second_tangent
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, deriv (deriv (fun t => C t a)) 0 =
      -base a - A f g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (a b : ι) :
    deriv (deriv (normalizedHessian f C (tangent a) (tangent b))) 0 =
      g * A f g a b * deriv (deriv (fun t => profile f (C t))) 0 -
        2 * w f g i * S f g i a b + Q f g a b i i -
        (D-2) * A f g a b - A f g i i * V f g a b := by
  rw [normalizedHessian_second f D g hg hf hgn hgt C hC hC0 i hC1 hC2
    (tangent a) (tangent b) (hthird _ _)]
  have ht : ∀ j : ι, Source29NormalizedLinkJets.tangent j = tangent j := fun _ => rfl
  simp only [ht]
  have h4 : coordPartial (fun x => third f x (tangent i) (tangent a) (tangent b))
      (tangent i) base = fourth f base (tangent a) (tangent b) (tangent i) (tangent i) := by
    change fourth f base (tangent i) (tangent i) (tangent a) (tangent b) = _
    rw [fourth_swap23 f base hf (tangent i) (tangent i) (tangent a) (tangent b),
      fourth_swap12 f base hf (tangent i) (tangent a) (tangent i) (tangent b),
      fourth_swap34 f base hf (tangent a) (tangent i) (tangent i) (tangent b),
      fourth_swap23 f base hf (tangent a) (tangent i) (tangent b) (tangent i)]
  rw [h4, hess_symm f base hf (tangent i) none]
  simp only [A, w, S, Q, V]
  field_simp
  ring

variable (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, deriv (deriv (fun t => C i t a)) 0 =
      -base a - A f g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (K lam : ℝ)
    (hJac : (∑ i, deriv (deriv (fun t => profile f (C i t))) 0) + (K+lam)*g⁻¹ = 0)

include hg hf hL hgn hgt hrad hthird hC hC0 hC1 hC2 hJac in
theorem normalizedHessian_second_trace (a b : ι) :
    (∑ i, deriv (deriv (normalizedHessian f (C i) (tangent a) (tangent b))) 0) =
      (∑ i, Q f g a b i i) - 2 * (∑ i, w f g i * S f g i a b) -
      (K+lam+(Fintype.card ι : ℝ)*(D-2)) * A f g a b := by
  simp_rw [normalizedHessian_second_tangent f D g hg hf hgn hgt hthird
    (C _) (hC _) (hC0 _) _ (hC1 _) (hC2 _)]
  simp only [mul_assoc, Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
    ← Finset.sum_mul, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    Source29AnalyticNormalizedLinkTraces.A_trace f D g hg.ne' hL hgn hgt hrad,
    zero_mul, sub_zero]
  have hj : (∑ i, deriv (deriv (fun t => profile f (C i t))) 0) = -(K+lam)*g⁻¹ := by linarith
  rw [hj]
  field_simp
  ring

include hg hf hL hgn hgt hrad hthird hfourth hC hC0 hC1 hC2 hJac in
theorem normalizedHessian_second_trace_reduced (a b : ι) :
    (∑ i, deriv (deriv (normalizedHessian f (C i) (tangent a) (tangent b))) 0) =
      2 * matrixCube (A f g) b a - 2 * z f g * matrixSquare (A f g) a b +
      2 * (∑ i, (A f g i a * V f g i b + A f g i b * V f g i a)) -
      2 * w f g a * (∑ i, A f g b i * w f g i) -
      2 * w f g b * (∑ i, A f g a i * w f g i) +
      (D*(D-1)-2-K-lam-(Fintype.card ι : ℝ)*(D-2)) * A f g a b := by
  rw [normalizedHessian_second_trace f D g hg hf hL hgn hgt hrad hthird C hC hC0 hC1 hC2 K lam hJac,
    Source29AnalyticNormalizedLinkTraces.Q_trace_natural f D g hg.ne' hf hL hgn hgt hrad hthird hfourth,
    Source29PolynomialSimonsTensor.cubic_contraction (A f g) (A_symm f g hf),
    Source29PolynomialSimonsTensor.square_contraction (A f g) (A_symm f g hf)]
  have hS : ∀ i, S f g a b i = S f g i a b := by
    intro i
    rw [S_swap23 f g hf, S_swap12 f g hf]
  simp only [Finset.sum_add_distrib, hS, A_symm f g hf, V_symm f g hf]
  have hm : (∑ i, S f g i a b * w f g i) = ∑ i, w f g i * S f g i a b := by
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hm]
  ring

end
end Source29AnalyticNormalizedHessianTrace

/- Component: AnalyticTangentFrame.inc -/
namespace Source29AnalyticTangentFrame

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedHessianCurve
open Source29AnalyticTensorNorm Source29AnalyticPairFrame Source29NormalizedLinkJets
open Source29PolynomialLinkChart (Ambient base)
open Source29PolynomialTangentFrame (single_dot_single)
open Source29PairFrameDerivative
open scoped BigOperators Matrix Topology

noncomputable section

section Normal
variable {I : Type*} [Fintype I] [DecidableEq I]

def unitNormal (f : (I → ℝ) → ℝ) (x : I → ℝ) : I → ℝ :=
  fun a => profile f x * grad f x a

theorem unitNormal_analyticAt (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x) (hreg : grad f x ≠ 0) : AnalyticAt ℝ (unitNormal f) x := by
  apply AnalyticAt.pi
  intro a
  exact (profile_analyticAt f x hf hreg).mul (partial_analyticAt f x hf a)

theorem unitNormal_dot_self (f : (I → ℝ) → ℝ) (x : I → ℝ)
    (hreg : grad f x ≠ 0) : unitNormal f x ⬝ᵥ unitNormal f x = 1 := by
  let v := grad f x
  let q := tensorNorm v
  have hq : q ≠ 0 := (tensorNorm_pos hreg).ne'
  have hs : q^2 = ∑ a, (v a)^2 := tensorNorm_sq v
  change (∑ a, (q⁻¹ * v a) * (q⁻¹ * v a)) = 1
  calc
    _ = q⁻¹^2 * (∑ a, (v a)^2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = 1 := by rw [← hs]; field_simp

/-- Positive real-degree homogeneity makes the unit normal orthogonal to the
radial vector along the zero level. -/
theorem radial_dot_unitNormal (f : (I → ℝ) → ℝ) (D : ℝ) (x : I → ℝ)
    (hf : AnalyticAt ℝ f x)
    (hhom : ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x) (hzero : f x = 0) :
    x ⬝ᵥ unitNormal f x = 0 := by
  have he := Source29AnalyticHomogeneousRadialJets.euler f D x hf hhom
  rw [Source29AnalyticCurveCoordinateJets.linear_apply_eq_sum, hzero, mul_zero] at he
  have ht : (∑ a, x a * grad f x a) = 0 := by
    simpa only [grad, coordPartial, mul_comm] using he
  calc
    _ = profile f x * (∑ a, x a * grad f x a) := by
      simp only [unitNormal, dotProduct, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = 0 := by rw [ht, mul_zero]

end Normal

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem unitNormal_at_base (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0) :
    unitNormal f base = Pi.single none 1 := by
  funext a
  cases a with
  | none => simp [unitNormal, profile_at_base f g hg hgn hgt, hgn, hg.ne']
  | some a => simp [unitNormal, hgt]

def tangentFrame (f : Ambient ι → ℝ) (C : ℝ → Ambient ι) (j : ι) (t : ℝ) : Ambient ι :=
  frame base (Pi.single none 1) (C t) (unitNormal f (C t)) (Pi.single (tangent j) 1)

/-- The analytic pair-frame construction gives actual orthonormal frames
along a homogeneous analytic zero link. -/
theorem exists_analytic_tangent_frame
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), f (C t) = 0 ∧ (∑ a, (C t a)^2) = 1) :
    ∃ E : ι → ℝ → Ambient ι, E = tangentFrame f C ∧
      (∀ j, AnalyticAt ℝ (E j) 0) ∧
      (∀ j, E j 0 = Pi.single (tangent j) 1) ∧
      (∀ t j k, E j t ⬝ᵥ E k t = if j = k then 1 else 0) ∧
      (∀ᶠ t in 𝓝 (0 : ℝ), ∀ j, E j t ⬝ᵥ C t = 0 ∧ E j t ⬝ᵥ unitNormal f (C t) = 0) := by
  let n : Ambient ι := Pi.single none 1
  let e : ι → Ambient ι := fun j => Pi.single (tangent j) 1
  let E : ι → ℝ → Ambient ι := tangentFrame f C
  have hreg : grad f base ≠ 0 := regular_at_base f g hg.ne' hgn
  have hN0 : unitNormal f (C 0) = n := by
    rw [hC0]
    exact unitNormal_at_base f g hg hgn hgt
  have hN : AnalyticAt ℝ (fun t => unitNormal f (C t)) 0 := by
    have hr : grad f (C 0) ≠ 0 := by simpa only [hC0] using hreg
    exact (unitNormal_analyticAt f (C 0) (hC0.symm ▸ hf base hx) hr).comp hC
  have hu : (base : Ambient ι) ≠ 0 := by simp [base]
  have hn : n ≠ 0 := by simp [n]
  have hE : ∀ j, AnalyticAt ℝ (E j) 0 := by
    intro j
    exact frame_analyticAt base n C (fun t => unitNormal f (C t)) (fun _ => e j) 0 hu hn
      hC0 hN0 (analyticAt_pi_iff.mp hC) (analyticAt_pi_iff.mp hN) (fun _ => analyticAt_const)
  have hE0 : ∀ j, E j 0 = e j := by
    intro j
    simp only [E, tangentFrame, hC0, unitNormal_at_base f g hg hgn hgt, e, frame_self]
  have hca : AnalyticAt ℝ (fun t => grad f (C t) none) 0 :=
    (partial_analyticAt f (C 0) (hC0.symm ▸ hf base hx) none).comp hC
  have hcp : 0 < grad f (C 0) none := by simpa only [hC0, hgn] using hg
  have hnear : ∀ᶠ t in 𝓝 (0 : ℝ), grad f (C t) ≠ 0 := by
    filter_upwards [hca.continuousAt.eventually (eventually_gt_nhds hcp)] with t ht
    intro he
    have hz := congrFun he none
    exact ht.ne' hz
  have hwithin : ∀ᶠ t in 𝓝 (0 : ℝ), C t ∈ U := by
    apply hC.continuousAt.eventually
    change U ∈ 𝓝 (C 0)
    rw [hC0]
    exact hU.mem_nhds hx
  refine ⟨E, rfl, hE, hE0, ?_, ?_⟩
  · intro t j k
    change frame base n (C t) (unitNormal f (C t)) (e j) ⬝ᵥ
      frame base n (C t) (unitNormal f (C t)) (e k) = _
    rw [frame_dot]
    simp only [e, single_dot_single, tangent, Option.some.injEq]
  · filter_upwards [hmem, hnear, hwithin] with t ht hr htu
    have hxx : (base : Ambient ι) ⬝ᵥ base = C t ⬝ᵥ C t := by
      have hb : (base : Ambient ι) ⬝ᵥ base = 1 := by simp [base]
      rw [hb]
      simpa only [dotProduct, pow_two] using ht.2.symm
    have hyy : n ⬝ᵥ n = unitNormal f (C t) ⬝ᵥ unitNormal f (C t) := by
      rw [unitNormal_dot_self f (C t) hr]
      simp [n]
    have huv : (base : Ambient ι) ⬝ᵥ n = 0 := by simp [base, n]
    have hxy : C t ⬝ᵥ unitNormal f (C t) = 0 :=
      radial_dot_unitNormal f D (C t) (hf _ htu) (hhom _ htu) ht.1
    have hp := frame_pair base n (C t) (unitNormal f (C t)) hxx hyy huv hxy
    intro j
    constructor
    · calc
        E j t ⬝ᵥ C t = E j t ⬝ᵥ frame base n (C t) (unitNormal f (C t)) base :=
          congrArg (fun z => E j t ⬝ᵥ z) hp.1.symm
        _ = e j ⬝ᵥ base := frame_dot base n (C t) (unitNormal f (C t)) (e j) base
        _ = 0 := by simp [e, base, tangent]
    · calc
        E j t ⬝ᵥ unitNormal f (C t) = E j t ⬝ᵥ frame base n (C t) (unitNormal f (C t)) n :=
          congrArg (fun z => E j t ⬝ᵥ z) hp.2.symm
        _ = e j ⬝ᵥ n := frame_dot base n (C t) (unitNormal f (C t)) (e j) n
        _ = 0 := by simp [e, n, tangent]

theorem unitNormal_tangent_deriv
    (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g) (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base) (i j : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (fun t => unitNormal f (C t) (tangent j)) 0 = hess f base (tangent i) (tangent j)/g := by
  have hr : grad f (C 0) ≠ 0 := by
    rw [hC0]
    exact regular_at_base f g hg.ne' hgn
  have hφ := (profile_analyticAt f (C 0) (hC0.symm ▸ hf) hr).comp hC
  have hv := (partial_analyticAt f (C 0) (hC0.symm ▸ hf) (tangent j)).comp hC
  have hd := Source29AnalyticCurveCoordinateJets.coordinate_velocity_first (coordPartial f (tangent j))
    (fun a t => C t a) base (tangent i) (partial_analyticAt f base hf (tangent j))
    (analyticAt_pi_iff.mp hC) (fun a => congrFun hC0 a) hC1
  have he := (hφ.differentiableAt.hasDerivAt.mul hv.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  change deriv (fun t => profile f (C t) * coordPartial f (tangent j) (C t)) 0 = _
  change deriv (fun t => coordPartial f (tangent j) (C t)) 0 = _ at hd
  rw [he, hC0, profile_at_base f g hg hgn hgt, hd]
  have hj : coordPartial f (tangent j) base = 0 := hgt (some j)
  rw [hj]
  change _ = coordPartial (coordPartial f (tangent j)) (tangent i) base / g
  dsimp only [coordPartial]
  rw [div_eq_mul_inv]
  ring

/-- The frame has zero tangential connection at the base, with the required
radial and normal first derivatives. -/
theorem tangentFrame_first_deriv
    (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g) (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base) (i j : ι)
    (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (a : Option (Option ι)) :
    deriv (fun t => tangentFrame f C j t a) 0 =
      -(if i = j then 1 else 0) * base a -
        (hess f base (tangent i) (tangent j)/g) * Pi.single (M := fun _ => ℝ) none 1 a := by
  let n : Ambient ι := Pi.single none 1
  let e : Ambient ι := Pi.single (tangent j) 1
  let N := fun t => unitNormal f (C t)
  have hr : grad f (C 0) ≠ 0 := by
    rw [hC0]
    exact regular_at_base f g hg.ne' hgn
  have hN := (unitNormal_analyticAt f (C 0) (hC0.symm ▸ hf) hr).comp hC
  have hN0 : N 0 = n := by
    change unitNormal f (C 0) = n
    rw [hC0]
    exact unitNormal_at_base f g hg hgn hgt
  have he := frame_deriv base n e C N
    (by simp [base]) (by simp [n])
    (by simp [base, n])
    (by simp [base, e, tangent]) (by simp [n, e, tangent])
    hC0 hN0 (analyticAt_pi_iff.mp hC) (analyticAt_pi_iff.mp hN) a
  have hdx : velocity C ⬝ᵥ e = if i = j then 1 else 0 := by
    simp [velocity, e, dotProduct, Pi.single_apply, hC1, tangent, eq_comm]
  have hdy : velocity N ⬝ᵥ e = hess f base (tangent i) (tangent j)/g := by
    simpa only [velocity, e, N, dotProduct, Pi.single_apply, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ite_true] using
      unitNormal_tangent_deriv f g hg hf hgn hgt C hC hC0 i j hC1
  rw [hdx, hdy] at he
  exact he

end
end Source29AnalyticTangentFrame

/- Component: PhaseChartNormalMultiplicity.inc -/
namespace Source29PhaseChartNormalMultiplicity

open MvPolynomial Filter Source29NormalShiftDerivatives Source29NormalShiftAlgebra
open Source29NewtonShiftedFactorCoefficient
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped Topology

noncomputable section
variable {n : ℕ}

/-- A flat analytic minimal phase chart has constant positive odd normal
multiplicity. No polynomial factor is selected in this statement. -/
theorem exists_normal_multiplicity
    (F : MvPolynomial (Fin (n+1)) ℝ) (hFne : F ≠ 0) (hF0 : eval 0 F=0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F=0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0=0)
    (hgrad : gradient g 0=0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y)=0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    ∃ d : ℕ, Odd d ∧ 0 < (shiftedSlice F (g 0) 0).coeff d ∧
      ∀ j : Fin d, ∀ᶠ y in 𝓝 0, (shiftedSlice F (g y) y).coeff (j:ℕ)=0 := by
  have hD := Source29FlatRegularGraph.fderiv_eq_zero_of_gradient_eq_zero g 0 hgrad
  obtain ⟨d,c,hc,hodd,hlow,hpure⟩ :=
    Source29CalibratedFlatGraphInitial.exists_pure_initial F hFne hF0 hcal
      g hg.differentiableAt hg0 hD hpos hneg
  have hinitial := Source29PolynomialPureInitialShift.analytic_normal_shift_pure_initial_limit
    F d c hlow hpure hg hg0 hD
  have htop := Source29NewtonInitialCenterCoefficient.center_coefficient_of_pure_initial
    F g d c hinitial
  exact ⟨d,hodd,by rwa [htop],Source29NewtonRegularObstruction.lower_coefficient_germs_zero
    F g hg hgrad hF hbg d c hc.ne' hinitial hpos hneg⟩

/-- At a point where a selected full factor has nonzero residual, every
vanishing irreducible divisor divides that selected factor. -/
theorem divides_selected_factor {κ : Type*}
    (F P R S : MvPolynomial κ ℝ) (k : ℕ) (hfac : F=R^k*S)
    (hP : Irreducible P) (hPF : P ∣ F) (a : κ → ℝ)
    (hPa : eval a P=0) (hSa : eval a S ≠ 0) : P ∣ R := by
  rw [hfac] at hPF
  rcases hP.prime.dvd_mul.mp hPF with hp | hp
  · exact hP.prime.dvd_of_dvd_pow hp
  · obtain ⟨T,hT⟩ := hp
    apply False.elim
    apply hSa
    rw [hT,map_mul,hPa,zero_mul]

/-- Every vanishing full irreducible factor in the phase chart is simple
there, and its residual is nonzero. No sign of that residual is assumed. -/
theorem factor_regularity_at_zero
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F=P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hP0 : eval (0 : Fin (n+1) → ℝ) P=0)
    (hF : Source29QuarticReuse.QuarticMinimal.leadingOperator F=0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (g : (Fin n → ℝ) → ℝ) (hg : AnalyticAt ℝ g 0) (hg0 : g 0=0)
    (hgrad : gradient g 0=0)
    (hbg : ∀ᶠ y in 𝓝 0, backgroundGraphOperator (gradient g y) (hessian g y)=0)
    (hrootF : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) F=0)
    (hpos : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      0 < z.1 → 0 ≤ eval (Fin.cons (g z.2+z.1) z.2) F)
    (hneg : ∀ᶠ z : ℝ × (Fin n → ℝ) in 𝓝 0,
      z.1 < 0 → eval (Fin.cons (g z.2+z.1) z.2) F ≤ 0) :
    eval (0 : Fin (n+1) → ℝ) (pderiv 0 P) ≠ 0 ∧
      eval (0 : Fin (n+1) → ℝ) Q ≠ 0 ∧ Odd k := by
  have hQne : Q ≠ 0 := fun h ↦ hPQ (h ▸ dvd_zero P)
  have hFne : F ≠ 0 := by rw [hfac]; exact mul_ne_zero (pow_ne_zero k hP.ne_zero) hQne
  have hF0 : eval (0 : Fin (n+1) → ℝ) F=0 := by
    rw [hfac,map_mul,map_pow,hP0,zero_pow hk.ne',zero_mul]
  have hbase : (Fin.cons (g 0) 0 : Fin (n+1) → ℝ)=0 := by
    rw [hg0]
    ext i
    exact Fin.cases rfl (fun j ↦ rfl) i
  obtain ⟨d,hd,htop,hlower⟩ := exists_normal_multiplicity F hFne hF0 hF hcal
    g hg hg0 hgrad hbg hpos hneg
  obtain ⟨R,S,l,hl,hR,hFR,hRS,hrootR⟩ :=
    Source29AnalyticGraphFactor.exists_full_graph_factor F hFne g 0 hg hrootF
  obtain ⟨hld,hRn,hSne⟩ := Source29GraphRootMultiplicity.regularity_and_cofactor_nonzero
    F R S l d hl hFR hR hRS g 0 hrootR htop.ne' hlower
  rw [hbase] at hSne
  have hPF : P ∣ F := (dvd_pow_self P hk.ne').trans ⟨Q,hfac⟩
  have hPR : P ∣ R := divides_selected_factor F P R S l hFR hP hPF 0 hP0 hSne
  obtain ⟨A,hPA⟩ := hP.dvd_symm hR hPR
  have hrootP : ∀ᶠ y in 𝓝 0, eval (Fin.cons (g y) y) P=0 := by
    filter_upwards [hrootR] with y hy
    rw [hPA,map_mul,hy,zero_mul]
  obtain ⟨hdk,hPn,hQ0⟩ := Source29GraphRootMultiplicity.regularity_and_cofactor_nonzero
    F P Q k d hk hfac hP hPQ g 0 hrootP htop.ne' hlower
  rw [hbase] at hPn hQ0
  exact ⟨hPn,hQ0,hdk ▸ hd⟩

end
end Source29PhaseChartNormalMultiplicity

/- Component: PhaseChartFactorRegularity.inc -/
namespace Source29PhaseChartFactorRegularity

open MvPolynomial Filter Source29AffinePolynomialTransport Source29GeometricPhaseChart
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open Source29QuarticReuse.QuarticMinimal Source29PolynomialTranslation
open scoped Topology Matrix

noncomputable section
variable {n : ℕ}

/-- A full irreducible factor through a flat minimal phase chart is regular
there and has nonvanishing cofactor. Neither conclusion is assumed in the
chart, and no global or local sign of the cofactor is required. -/
theorem regularity_and_cofactor_nonzero
    (F P Q : MvPolynomial (Fin (n+1)) ℝ) (k : ℕ) (hk : 0 < k)
    (hfac : F=P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hF : leadingOperator F=0) (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (ha : eval a P=0) (hchart : HasFlatMinimalPhaseChart F a) :
    evaluatedGradient P a ≠ 0 ∧ eval a Q ≠ 0 ∧ Odd k := by
  obtain ⟨U,hU,g,hg,hg0,hgrad,hbg,hroot,hpos,hneg⟩ := hchart
  let E := affineEquiv a U hU
  have hfac' : E F=(E P)^k*E Q := by rw [hfac,map_mul,map_pow]
  have hP' : Irreducible (E P) := (MulEquiv.irreducible_iff E).mpr hP
  have hPQ' : ¬ E P ∣ E Q := fun h ↦ hPQ ((map_dvd_iff E).mp h)
  have hP0 : eval (0 : Fin (n+1) → ℝ) (E P)=0 := by
    dsimp only [E]
    rwa [eval_zero_affineEquiv]
  have hF' : leadingOperator (E F)=0 := by
    dsimp only [E]
    rw [leadingOperator_affineEquiv,hF,map_zero]
  obtain ⟨hn,hQne,hodd⟩ := Source29PhaseChartNormalMultiplicity.factor_regularity_at_zero
    (E F) (E P) (E Q) k hk hfac' hP' hPQ' hP0 hF'
    (affine_weakCalibration F hcal a U hU) g hg hg0 hgrad hbg hroot hpos hneg
  refine ⟨?_,?_,hodd⟩
  · intro hzero
    have hi (i : Fin (n+1)) : eval a (pderiv i P)=0 := congrFun hzero i
    apply hn
    dsimp only [E]
    rw [affineEquiv_apply,pderiv_changeVariables,map_sum]
    simp only [map_mul,eval_C,eval_changeVariables,Matrix.mulVec_zero,
      pderiv_translate,eval_zero_translate,hi,zero_mul,Finset.sum_const_zero]
  · simpa only [E,eval_zero_affineEquiv] using hQne

/-- In particular every irreducible divisor through such a chart is
regular, without first choosing a full factorization in the statement. -/
theorem irreducible_factor_regular
    (F P : MvPolynomial (Fin (n+1)) ℝ) (hFne : F ≠ 0)
    (hP : Irreducible P) (hPF : P ∣ F)
    (hF : leadingOperator F=0) (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (ha : eval a P=0) (hchart : HasFlatMinimalPhaseChart F a) :
    evaluatedGradient P a ≠ 0 := by
  have hf : FiniteMultiplicity P F := FiniteMultiplicity.of_not_isUnit hP.not_isUnit hFne
  obtain ⟨Q,hfac,hPQ⟩ := hf.exists_eq_pow_mul_and_not_dvd
  have hk : 0 < multiplicity P F := Nat.pos_of_ne_zero ((multiplicity_ne_zero hf).mpr hPF)
  exact (regularity_and_cofactor_nonzero F P Q (multiplicity P F) hk hfac hP hPQ
    hF hcal a ha hchart).1

/-- Two irreducible factors meeting at a chart point must divide one another.
Consequently distinct irreducible factor components cannot cross there. -/
theorem mutual_divisibility_of_common_zero
    (F P R : MvPolynomial (Fin (n+1)) ℝ) (hFne : F ≠ 0)
    (hP : Irreducible P) (hR : Irreducible R) (hPF : P ∣ F) (hRF : R ∣ F)
    (hF : leadingOperator F=0) (hcal : WeakCalibration (leadingNormalizedField F))
    (a : Fin (n+1) → ℝ) (hPa : eval a P=0) (hRa : eval a R=0)
    (hchart : HasFlatMinimalPhaseChart F a) : P ∣ R ∧ R ∣ P := by
  have hf : FiniteMultiplicity P F := FiniteMultiplicity.of_not_isUnit hP.not_isUnit hFne
  obtain ⟨Q,hfac,hPQ⟩ := hf.exists_eq_pow_mul_and_not_dvd
  have hk : 0 < multiplicity P F := Nat.pos_of_ne_zero ((multiplicity_ne_zero hf).mpr hPF)
  have hQ := (regularity_and_cofactor_nonzero F P Q (multiplicity P F) hk hfac hP hPQ
    hF hcal a hPa hchart).2.1
  have hRP : R ∣ P := Source29PhaseChartNormalMultiplicity.divides_selected_factor
    F R P Q (multiplicity P F) hfac hR hRF a hRa hQ
  exact ⟨hR.dvd_symm hP hRP,hRP⟩

/-- Charts away from the vertex derive regularity on every factor's full
nonvertex zero set; this is not an assumption on the chosen factor. -/
theorem irreducible_factor_regular_away_zero
    (F P : MvPolynomial (Fin (n+1)) ℝ) (hFne : F ≠ 0)
    (hP : Irreducible P) (hPF : P ∣ F)
    (hF : leadingOperator F=0) (hcal : WeakCalibration (leadingNormalizedField F))
    (hcharts : ∀ a : Fin (n+1) → ℝ, a ≠ 0 → eval a F=0 → HasFlatMinimalPhaseChart F a) :
    ∀ a : Fin (n+1) → ℝ, a ≠ 0 → eval a P=0 → evaluatedGradient P a ≠ 0 := by
  intro a hane ha
  have hFa : eval a F=0 := by
    obtain ⟨Q,hQ⟩ := hPF
    rw [hQ,map_mul,ha,zero_mul]
  exact irreducible_factor_regular F P hFne hP hPF hF hcal a ha (hcharts a hane hFa)

end
end Source29PhaseChartFactorRegularity

/- Component: RegularLinkIntersection.inc -/
namespace Source29RegularLinkIntersection

open MvPolynomial Filter Source29FactorInheritance
open scoped Topology BigOperators

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Two nonempty regular homogeneous minimal unit links intersect. Their
closest points exist by compactness and coincide by the local Frankel theorem. -/
theorem exists_common_unit_zero
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d e : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e)
    (hP : P.IsHomogeneous d) (hQ : Q.IsHomogeneous e)
    (hPreg : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hQreg : ∀ x : (Option (Option ι)) → ℝ, eval x Q=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a Q)) ≠ 0)
    (hPL : ∀ x : (Option (Option ι)) → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 → eval x (cubicOperator P)=0)
    (hQL : ∀ x : (Option (Option ι)) → ℝ, eval x Q=0 → (∑ a, (x a)^2)=1 → eval x (cubicOperator Q)=0)
    (hPne : ∃ x : (Option (Option ι)) → ℝ, eval x P=0 ∧ (∑ a, (x a)^2)=1)
    (hQne : ∃ x : (Option (Option ι)) → ℝ, eval x Q=0 ∧ (∑ a, (x a)^2)=1) (i0 : ι) :
    ∃ x : (Option (Option ι)) → ℝ, eval x P=0 ∧ eval x Q=0 ∧ (∑ a, (x a)^2)=1 := by
  let S : Set ((Option (Option ι)) → ℝ) := {x | eval x P=0 ∧ (∑ a, (x a)^2)=1}
  let T : Set ((Option (Option ι)) → ℝ) := {x | eval x Q=0 ∧ (∑ a, (x a)^2)=1}
  obtain ⟨x,hx,y,hy,hclosest⟩ := Source29CompactRegularLinkConnectedness.exists_closest_pair
    S T (Source29CompactPolynomialLink.isCompact_link P)
    (Source29CompactPolynomialLink.isCompact_link Q) hPne hQne
  have hxy := Source29RegularPolynomialLinkFrankel.eq_of_regular_closest_pair P Q d e hd he hP hQ
    S T x y hx hy hclosest hx.2 hy.2 hx.1 hy.1 (hPreg x hx.1 hx.2) (hQreg y hy.1 hy.2)
    (hPL x hx.1 hx.2) (hQL y hy.1 hy.2)
    (Filter.Eventually.of_forall (fun z hp hs ↦ ⟨hp,hs⟩))
    (Filter.Eventually.of_forall (fun z hp hs ↦ ⟨hp,hs⟩)) i0
  exact ⟨x,hx.1,hxy.symm ▸ hy.1,hx.2⟩

/-- The intersection theorem in the original eight polynomial coordinates. -/
theorem exists_common_unit_zero_fin8
    (P Q : MvPolynomial (Fin 8) ℝ) (d e : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e)
    (hP : P.IsHomogeneous d) (hQ : Q.IsHomogeneous e)
    (hPreg : ∀ x : Fin 8 → ℝ, eval x P=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a P)) ≠ 0)
    (hQreg : ∀ x : Fin 8 → ℝ, eval x Q=0 → (∑ a, (x a)^2)=1 →
      (fun a ↦ eval x (pderiv a Q)) ≠ 0)
    (hPL : P ∣ cubicOperator P) (hQL : Q ∣ cubicOperator Q)
    (hPne : ∃ x : Fin 8 → ℝ, eval x P=0 ∧ (∑ a, (x a)^2)=1)
    (hQne : ∃ x : Fin 8 → ℝ, eval x Q=0 ∧ (∑ a, (x a)^2)=1) :
    ∃ x : Fin 8 → ℝ, eval x P=0 ∧ eval x Q=0 ∧ (∑ a, (x a)^2)=1 := by
  let E := Source29FinEightDegreeBound.eightLinkEquiv
  have hunit (x : Option (Option (Fin 6)) → ℝ) (hx : (∑ a, (x a)^2)=1) :
      (∑ a, ((x ∘ E) a)^2)=1 := by
    change (∑ a, (x (E a))^2)=1
    rwa [E.sum_comp (fun a ↦ (x a)^2)]
  have hreg (R : MvPolynomial (Fin 8) ℝ)
      (hr : ∀ x : Fin 8 → ℝ, eval x R=0 → (∑ a, (x a)^2)=1 →
        (fun a ↦ eval x (pderiv a R)) ≠ 0)
      (x : Option (Option (Fin 6)) → ℝ) (hx : eval x (rename E R)=0)
      (hu : (∑ a, (x a)^2)=1) : (fun a ↦ eval x (pderiv a (rename E R))) ≠ 0 := by
    apply Source29PolynomialReindex.gradientAt_rename_ne_zero E R x
    exact hr (x ∘ E) (by simpa only [eval_rename] using hx) (hunit x hu)
  have hmin (R : MvPolynomial (Fin 8) ℝ) (hr : R ∣ cubicOperator R)
      (x : Option (Option (Fin 6)) → ℝ) (hx : eval x (rename E R)=0)
      (_hu : (∑ a, (x a)^2)=1) : eval x (cubicOperator (rename E R))=0 := by
    obtain ⟨A,hA⟩ := hr
    rw [Source29PolynomialReindex.cubicOperator_rename,hA,map_mul,map_mul,hx,zero_mul]
  have hnonempty (R : MvPolynomial (Fin 8) ℝ)
      (hr : ∃ x : Fin 8 → ℝ, eval x R=0 ∧ (∑ a, (x a)^2)=1) :
      ∃ x : Option (Option (Fin 6)) → ℝ, eval x (rename E R)=0 ∧ (∑ a, (x a)^2)=1 := by
    obtain ⟨x,hx,hu⟩ := hr
    refine ⟨x ∘ E.symm,?_,?_⟩
    · simpa only [eval_rename,Function.comp_assoc,E.symm_comp_self,Function.comp_id] using hx
    · change (∑ a, (x (E.symm a))^2)=1
      rwa [E.symm.sum_comp (fun a ↦ (x a)^2)]
  obtain ⟨x,hxP,hxQ,hxu⟩ := exists_common_unit_zero (rename E P) (rename E Q) d e hd he
    hP.rename_isHomogeneous hQ.rename_isHomogeneous (hreg P hPreg) (hreg Q hQreg)
    (hmin P hPL) (hmin Q hQL) (hnonempty P hPne) (hnonempty Q hQne) (0 : Fin 6)
  exact ⟨x ∘ E,by simpa only [eval_rename] using hxP,
    by simpa only [eval_rename] using hxQ,hunit x hxu⟩

end
end Source29RegularLinkIntersection

/- Component: GlobalPhaseFactor.inc -/
namespace Source29GlobalPhaseFactor

open MvPolynomial Source29FactorInheritance Source29GeometricPhaseChart
open Source29QuarticReuse.FluxObstruction Source29WeakCalibrationLimits
open scoped BigOperators

noncomputable section

/-- A nonzero polynomial's zero is a zero of an irreducible divisor. -/
theorem exists_irreducible_zero {κ : Type*} (F : MvPolynomial κ ℝ) (hF : F ≠ 0)
    (a : κ → ℝ) (ha : eval a F=0) :
    ∃ R : MvPolynomial κ ℝ, Irreducible R ∧ R ∣ F ∧ eval a R=0 := by
  induction F using WfDvdMonoid.induction_on_irreducible with
  | zero => exact (hF rfl).elim
  | unit u hu =>
      exact (isUnit_iff_ne_zero.mp (hu.map (eval a)) ha).elim
  | mul q p hq hp ih =>
      rw [map_mul] at ha
      rcases mul_eq_zero.mp ha with hz | hz
      · exact ⟨p,hp,dvd_mul_right p q,hz⟩
      · obtain ⟨R,hR,hRq,hRa⟩ := ih hq hz
        exact ⟨R,hR,dvd_mul_of_dvd_right hRq p,hRa⟩

/-- Full multiplicity extracts the pointwise minimality of any irreducible divisor. -/
theorem irreducible_divisor_cubic_dvd {κ : Type*} [Fintype κ] [DecidableEq κ]
    (F R : MvPolynomial κ ℝ) (hFne : F ≠ 0) (hR : Irreducible R) (hRF : R ∣ F)
    (hF : cubicOperator F=0) : R ∣ cubicOperator R := by
  have hf : FiniteMultiplicity R F := FiniteMultiplicity.of_not_isUnit hR.not_isUnit hFne
  obtain ⟨Q,hfac,hRQ⟩ := hf.exists_eq_pow_mul_and_not_dvd
  have hk : 1 ≤ multiplicity R F :=
    Nat.pos_of_ne_zero ((multiplicity_ne_zero hf).mpr hRF)
  exact Source29RealLeadingFactor.real_factor_inheritance R Q (multiplicity R F) hk hR hRQ
    (by rwa [← hfac])

/-- A nonzero real zero of a homogeneous polynomial normalizes to a unit zero. -/
theorem exists_unit_zero {κ : Type*} [Fintype κ]
    (P : MvPolynomial κ ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (a : κ → ℝ) (ha : a ≠ 0) (hzero : eval a P=0) :
    ∃ x : κ → ℝ, eval x P=0 ∧ (∑ j, (x j)^2)=1 := by
  let r := Source29AnalyticTensorNorm.tensorNorm a
  have hr : 0 < r := Source29AnalyticTensorNorm.tensorNorm_pos ha
  have hrsq : r^2=∑ j, (a j)^2 := Source29AnalyticTensorNorm.tensorNorm_sq a
  refine ⟨fun j ↦ r⁻¹*a j,?_,?_⟩
  · rw [Source29QuarticReuse.QuarticNormalization.eval_scale_of_isHomogeneous P d hP a r⁻¹,
      hzero,mul_zero]
  · simp only [mul_pow,← Finset.mul_sum,← hrsq]
    field_simp

/-- A nonzero polynomial having a zero has positive total degree. -/
lemma totalDegree_pos_of_zero {κ : Type*} (P : MvPolynomial κ ℝ) (hP : P ≠ 0)
    (a : κ → ℝ) (ha : eval a P=0) : 1 ≤ P.totalDegree := by
  by_contra hn
  have hd : P.totalDegree=0 := by omega
  have he := totalDegree_eq_zero_iff_eq_C.mp hd
  have hc : P.coeff 0=0 := by
    rw [he,eval_C] at ha
    exact ha
  exact hP (by rw [he,hc,map_zero])

/-- Flat minimal phase charts away from the vertex force the full residual
of every real irreducible factor to have no nonvertex zero. Global regularity
of all factors is derived from the charts before applying spherical Frankel. -/
theorem cofactor_ne_zero_away_zero
    (F P Q : MvPolynomial (Fin 8) ℝ) (D k : ℕ) (hk : 0 < k)
    (hfac : F=P^k*Q) (hP : Irreducible P) (hPQ : ¬ P ∣ Q)
    (hhom : F.IsHomogeneous D) (hF : cubicOperator F=0)
    (hcal : WeakCalibration (leadingNormalizedField F))
    (hcharts : ∀ a : Fin 8 → ℝ, a ≠ 0 → eval a F=0 → HasFlatMinimalPhaseChart F a)
    (hPunit : ∃ x : Fin 8 → ℝ, eval x P=0 ∧ (∑ j, (x j)^2)=1) :
    ∀ a : Fin 8 → ℝ, a ≠ 0 → eval a Q ≠ 0 := by
  have hQne : Q ≠ 0 := fun h ↦ hPQ (h ▸ dvd_zero P)
  have hFne : F ≠ 0 := by rw [hfac]; exact mul_ne_zero (pow_ne_zero k hP.ne_zero) hQne
  have hPF : P ∣ F := (dvd_pow_self P hk.ne').trans ⟨Q,hfac⟩
  have hPhom := Source29HomogeneousFactor.divisor_isHomogeneous F P hFne hhom hPF
  have hPL := irreducible_divisor_cubic_dvd F P hFne hP hPF hF
  have hPreg := Source29PhaseChartFactorRegularity.irreducible_factor_regular_away_zero
    F P hFne hP hPF hF hcal hcharts
  have hunit_ne_zero (x : Fin 8 → ℝ) (hx : (∑ j, (x j)^2)=1) : x ≠ 0 := by
    intro he
    simp only [he,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at hx
    norm_num at hx
  have hdP : 1 ≤ P.totalDegree := by
    obtain ⟨x,hx,_⟩ := hPunit
    exact totalDegree_pos_of_zero P hP.ne_zero x hx
  intro a hane hQa
  obtain ⟨R,hR,hRQ,hRa⟩ := exists_irreducible_zero Q hQne a hQa
  have hRF : R ∣ F := hRQ.trans ⟨P^k,hfac.trans (mul_comm _ _)⟩
  have hRhom := Source29HomogeneousFactor.divisor_isHomogeneous F R hFne hhom hRF
  have hRL := irreducible_divisor_cubic_dvd F R hFne hR hRF hF
  have hRreg := Source29PhaseChartFactorRegularity.irreducible_factor_regular_away_zero
    F R hFne hR hRF hF hcal hcharts
  have hRunit := exists_unit_zero R R.totalDegree hRhom a hane hRa
  obtain ⟨x,hxP,hxR,hxu⟩ := Source29RegularLinkIntersection.exists_common_unit_zero_fin8 P R
    P.totalDegree R.totalDegree hdP (totalDegree_pos_of_zero R hR.ne_zero a hRa) hPhom hRhom
    (fun x hx hu ↦ hPreg x (hunit_ne_zero x hu) hx)
    (fun x hx hu ↦ hRreg x (hunit_ne_zero x hu) hx) hPL hRL hPunit hRunit
  have hxF : eval x F=0 := by rw [hfac,map_mul,map_pow,hxP,zero_pow hk.ne',zero_mul]
  have hxQ := (Source29PhaseChartFactorRegularity.regularity_and_cofactor_nonzero
    F P Q k hk hfac hP hPQ hF hcal x hxP (hcharts x (hunit_ne_zero x hxu) hxF)).2.1
  apply hxQ
  obtain ⟨A,hA⟩ := hRQ
  rw [hA,map_mul,hxR,zero_mul]

end
end Source29GlobalPhaseFactor

/- Component: PhaseChartsPositiveStructure.inc -/
namespace Source29PhaseChartsPositiveStructure

open MvPolynomial Source29GeometricPhaseChart Source29Closing
open Source29QuarticReuse.FluxObstruction Source29PositiveLeadingStructureReduction

noncomputable section

/-- A homogeneous polynomial without a nonvertex zero has one strict
sign. Opposite signs would give a unit zero by the proved real IVT argument. -/
theorem constant_sign_away_zero (Q : MvPolynomial (Fin 8) ℝ)
    (hhom : Q.IsHomogeneous Q.totalDegree)
    (hQ : ∀ x : Fin 8 → ℝ, x ≠ 0 → eval x Q ≠ 0) :
    (∀ x : Fin 8 → ℝ, x ≠ 0 → 0 < eval x Q) ∨
      (∀ x : Fin 8 → ℝ, x ≠ 0 → eval x Q < 0) := by
  by_cases hpos : ∀ x : Fin 8 → ℝ, x ≠ 0 → 0 < eval x Q
  · exact Or.inl hpos
  right
  push Not at hpos
  obtain ⟨a,ha,hale⟩ := hpos
  have hneg : eval a Q < 0 := lt_of_le_of_ne hale (hQ a ha)
  intro b hb
  by_contra hnb
  have hposb : 0 < eval b Q := lt_of_le_of_ne (le_of_not_gt hnb) (hQ b hb).symm
  by_cases hd : Q.totalDegree=0
  · have hc := totalDegree_eq_zero_iff_eq_C.mp hd
    rw [hc,eval_C] at hneg hposb
    linarith
  · obtain ⟨x,hx,hu⟩ := Source29HomogeneousRealZero.exists_unit_zero_of_sign_change
      Q Q.totalDegree hhom (Nat.pos_of_ne_zero hd) ⟨b,hposb⟩ ⟨a,hneg⟩
    have hxne : x ≠ 0 := by
      intro he
      simp only [he,Pi.zero_apply,zero_pow (by decide : 2 ≠ 0),Finset.sum_const_zero] at hu
      norm_num at hu
    exact hQ x hxne hx

/-- Once the leading polynomial has phase charts at every nonvertex zero,
its sign-changing irreducible factor has a positive homogeneous residual
after orientation. No connectedness of either strict phase is assumed. -/
theorem positive_leading_factor_of_phase_charts
    (P : Polynomial8) (hmin : Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P)
    (hdeg : 2 ≤ P.totalDegree)
    (hcharts : ∀ a : Fin 8 → ℝ, a ≠ 0 →
      eval a (homogeneousComponent P.totalDegree P)=0 →
      HasFlatMinimalPhaseChart (homogeneousComponent P.totalDegree P) a) :
    PositiveLeadingFactorData8 P := by
  obtain ⟨p,Q,k,hk,hp,hphom,hQhom,hfac,hpQ,hpos,hneg,hpL,hodd,hreal⟩ :=
    Source29OddLeadingFactor.minimal_graph_leading_factor_odd P hmin hdeg
  have hdp : 1 ≤ p.totalDegree := by
    by_contra hn
    have he : p.totalDegree=0 := by omega
    have hc := totalDegree_eq_zero_iff_eq_C.mp he
    obtain ⟨x,hx⟩ := hpos
    obtain ⟨y,hy⟩ := hneg
    rw [hc,eval_C] at hx hy
    linarith
  have hunit := Source29HomogeneousRealZero.exists_unit_zero_of_sign_change p p.totalDegree
    hphom hdp hpos hneg
  obtain ⟨hFne,hFhom,hFL⟩ := QuarticPolynomialBasics.leading_component_data P hmin hdeg
  have hcal := Source29TopPhasePerimeter.top_weakCalibration P hmin hdeg
  have hQnonzero := Source29GlobalPhaseFactor.cofactor_ne_zero_away_zero
    (homogeneousComponent P.totalDegree P) p Q P.totalDegree k (by omega)
    hfac hp hpQ hFhom hFL hcal hcharts hunit
  rcases constant_sign_away_zero Q hQhom hQnonzero with hpositive | hnegative
  · exact ⟨p,Q,k,hk,hp,hphom,hQhom,hfac,hpositive⟩
  · refine ⟨-p,-Q,k,hk,Source29ConnectedFactorStructure.irreducible_neg_of_irreducible p hp,
      ?_,?_,?_,?_⟩
    · simpa only [totalDegree_neg] using hphom.neg
    · simpa only [totalDegree_neg] using hQhom.neg
    · rw [hodd.neg_pow,neg_mul_neg]
      exact hfac
    · intro x hx
      simpa only [map_neg,neg_pos] using hnegative x hx

/-- The global remaining hypothesis is now only phase charts away from the
vertex. The former separate strict-phase connectedness hypothesis is removed. -/
theorem problem29_of_phase_charts_away_zero
    (hcharts : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P → 2 ≤ P.totalDegree →
      ∀ a : Fin 8 → ℝ, a ≠ 0 → eval a (homogeneousComponent P.totalDegree P)=0 →
      HasFlatMinimalPhaseChart (homogeneousComponent P.totalDegree P) a) :
    Math30.Problem29 := by
  apply problem29_of_positive_leading_factor
  intro P hmin hdeg
  exact positive_leading_factor_of_phase_charts P hmin hdeg (hcharts P hmin hdeg)

end
end Source29PhaseChartsPositiveStructure

/- Component: AnalyticTangentFrameSecond.inc -/
namespace Source29AnalyticTangentFrameSecond

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (Ambient base)
open Source29AnalyticTangentFrame Source29PairFrameDerivative Source29AnalyticDotSecond
open scoped BigOperators Matrix Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Orthonormality fixes the symmetric tangential frame acceleration. -/
theorem tangentFrame_second_symmetric
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), f (C t) = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j k : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    acceleration (tangentFrame f C j) (tangent k) +
      acceleration (tangentFrame f C k) (tangent j) =
      -2 * ((if i = j then 1 else 0) * (if i = k then 1 else 0) + A f g i j * A f g i k) := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame f D g hg U hU hx hf hhom hgn hgt C hC hC0 hmem
  have he : (fun t => tangentFrame f C j t ⬝ᵥ tangentFrame f C k t) =
      (fun _ : ℝ => if j = k then (1 : ℝ) else 0) := funext (fun t => horth t j k)
  have hz : deriv (deriv (fun t => tangentFrame f C j t ⬝ᵥ tangentFrame f C k t)) 0 = 0 := by
    rw [he]
    simp only [deriv_const', deriv_const]
  rw [second_deriv_dot _ _ (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp (hE k)),
    hE0, hE0, dotProduct_single_one, single_one_dotProduct] at hz
  have hd : ∀ l a, velocity (tangentFrame f C l) a =
      -(if i = l then 1 else 0) * base a - A f g i l * Pi.single (M := fun _ => ℝ) none 1 a := by
    intro l a
    exact tangentFrame_first_deriv f g hg (hf base hx) hgn hgt C hC hC0 i l hC1 a
  have hv : velocity (tangentFrame f C j) ⬝ᵥ velocity (tangentFrame f C k) =
      (if i = j then 1 else 0) * (if i = k then 1 else 0) + A f g i j * A f g i k := by
    simp only [dotProduct, hd, Fintype.sum_option, base, Pi.single_apply]
    simp only [Option.some.injEq, reduceCtorEq, ite_true, ite_false, mul_one, mul_zero,
      sub_zero, zero_sub, neg_mul_neg, Finset.sum_const_zero, add_zero]
    ring
  rw [hv] at hz
  simp only [Source29NormalizedLinkJets.tangent, tangent] at hz ⊢
  linarith

end
end Source29AnalyticTangentFrameSecond

/- Component: AnalyticNormalSecond.inc -/
namespace Source29AnalyticNormalSecond

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (Ambient base)
open Source29AnalyticTangentFrame Source29AnalyticNormalizedHessianCurve
open Source29PairFrameDerivative Source29AnalyticDotSecond
open scoped BigOperators Matrix Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

variable (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g) (hf : AnalyticAt ℝ f base)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (i : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a)

include hg hf hgn hgt hC hC0 hC1 in
theorem unitNormal_first_coordinate (a : Option (Option ι)) :
    velocity (fun t => unitNormal f (C t)) a =
      -w f g i / g * grad f base a + g⁻¹ * hess f base (tangent i) a := by
  have hr : grad f (C 0) ≠ 0 := hC0.symm ▸ regular_at_base f g hg.ne' hgn
  have hφ := (profile_analyticAt f (C 0) (hC0.symm ▸ hf) hr).comp hC
  have hG := (partial_analyticAt f (C 0) (hC0.symm ▸ hf) a).comp hC
  have he := (hφ.differentiableAt.hasDerivAt.mul hG.differentiableAt.hasDerivAt).deriv
  simp only [Pi.mul_def, Function.comp_def] at he
  have hd := Source29AnalyticCurveCoordinateJets.coordinate_velocity_first (coordPartial f a)
    (fun b t => C t b) base (tangent i) (partial_analyticAt f base hf a)
    (analyticAt_pi_iff.mp hC) (fun b => congrFun hC0 b) hC1
  change deriv (fun t => coordPartial f a (C t)) 0 = _ at hd
  change deriv (fun t => profile f (C t) * coordPartial f a (C t)) 0 = _
  rw [he, profile_tangent_deriv f g hg hf hgn hgt C hC hC0 i hC1,
    hd, hC0, profile_at_base f g hg hgn hgt]
  change -hess f base (tangent i) none / g^2 * grad f base a +
    g⁻¹ * hess f base (tangent i) a = _
  rw [hess_symm f base hf (tangent i) none]
  simp only [w]
  field_simp

include hg hf hgn hgt hrad hC hC0 hC1 in
theorem unitNormal_first_radial_normal :
    velocity (fun t => unitNormal f (C t)) (some none) = 0 ∧
      velocity (fun t => unitNormal f (C t)) none = 0 := by
  have hr : hess f base (some none) (tangent i) = 0 := by
    rw [hrad, show grad f base (tangent i) = 0 from hgt (some i), mul_zero]
  constructor
  · rw [unitNormal_first_coordinate f g hg hf hgn hgt C hC hC0 i hC1,
      hgt none, mul_zero, zero_add, hess_symm f base hf, hr, mul_zero]
  · rw [unitNormal_first_coordinate f g hg hf hgn hgt C hC hC0 i hC1, hgn]
    rw [hess_symm f base hf (tangent i) none]
    simp only [w]
    field_simp
    ring

include hg hf hgn hgt hrad hC hC0 hC1 in
theorem unitNormal_second_tangent
    (hC2 : ∀ a, acceleration C a = -base a - A f g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (j : ι) :
    acceleration (fun t => unitNormal f (C t)) (tangent j) =
      S f g i i j - A f g i i * w f g j - 2 * w f g i * A f g i j := by
  let G := fun t => coordPartial f (tangent j) (C t)
  have hG : AnalyticAt ℝ G 0 := (partial_analyticAt f (C 0) (hC0.symm ▸ hf) (tangent j)).comp hC
  have hG0 : G 0 = 0 := by
    change coordPartial f (tangent j) (C 0) = 0
    rw [hC0]
    exact hgt (some j)
  have hG1 : deriv G 0 = hess f base (tangent i) (tangent j) :=
    Source29AnalyticCurveCoordinateJets.coordinate_velocity_first (coordPartial f (tangent j))
      (fun a t => C t a) base (tangent i) (partial_analyticAt f base hf (tangent j))
      (analyticAt_pi_iff.mp hC) (fun a => congrFun hC0 a) hC1
  have hG2 : deriv (deriv G) 0 = third f base (tangent i) (tangent i) (tangent j) -
      A f g i i * hess f base none (tangent j) := by
    have he := Source29AnalyticCurveCoordinateJets.coordinate_velocity_second (coordPartial f (tangent j))
      (fun a t => C t a) base (tangent i) (partial_analyticAt f base hf (tangent j))
      (analyticAt_pi_iff.mp hC) (fun a => congrFun hC0 a) hC1
    change deriv (deriv G) 0 = third f base (tangent i) (tangent i) (tangent j) +
      (∑ a, hess f base a (tangent j) * acceleration C a) at he
    rw [he]
    have hr : hess f base (some none) (tangent j) = 0 := by
      rw [hrad, show grad f base (tangent j) = 0 from hgt (some j), mul_zero]
    have hb : ∀ a, (base : Ambient ι) a = if a = some none then 1 else 0 := by
      intro a
      simp [base, Pi.single_apply]
    simp only [hC2, hb, Pi.single_apply, mul_sub, mul_neg, mul_ite, mul_one, mul_zero,
      Finset.sum_sub_distrib, Finset.sum_neg_distrib, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true, hr]
    ring
  have hr : grad f (C 0) ≠ 0 := hC0.symm ▸ regular_at_base f g hg.ne' hgn
  have hφ := (profile_analyticAt f (C 0) (hC0.symm ▸ hf) hr).comp hC
  change deriv (deriv (fun t => profile f (C t) * G t)) 0 = _
  rw [Source29AnalyticInverseNorm.second_deriv_product (fun t => profile f (C t)) G hφ hG,
    hG0, mul_zero, zero_add, profile_tangent_deriv f g hg hf hgn hgt C hC hC0 i hC1,
    hG1, hG2, hC0, profile_at_base f g hg hgn hgt]
  rw [show Source29NormalizedLinkJets.tangent i = tangent i from rfl,
    hess_symm f base hf (tangent i) none]
  simp only [S, w, A]
  field_simp
  ring

end
end Source29AnalyticNormalSecond

/- Component: AnalyticFrameNormalAcceleration.inc -/
namespace Source29AnalyticFrameNormalAcceleration

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (Ambient base)
open Source29AnalyticTangentFrame Source29AnalyticNormalSecond
open Source29AnalyticNormalizedHessianCurve
open Source29PairFrameDerivative Source29AnalyticDotSecond
open scoped BigOperators Matrix Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The normal frame acceleration is the negative covariant derivative of
its second fundamental form, obtained by differentiating actual tangency. -/
theorem tangentFrame_second_normal_eq_neg_B
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), f (C t) = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ a, acceleration C a = -base a - A f g i i * Pi.single (M := fun _ => ℝ) none 1 a) :
    acceleration (tangentFrame f C j) none = -B f g i i j := by
  have hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j := by
    intro j
    exact Source29AnalyticHomogeneousRadialJets.radial_hessian f D U hU hcone hf hhom
      base hx (Pi.single j 1)
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame f D g hg U hU hx hf hhom hgn hgt C hC hC0 hmem
  change ∀ j, tangentFrame f C j 0 = Pi.single (tangent j) 1 at hE0
  have hr : grad f (C 0) ≠ 0 := hC0.symm ▸ regular_at_base f g hg.ne' hgn
  have hN : AnalyticAt ℝ (fun t => unitNormal f (C t)) 0 :=
    (unitNormal_analyticAt f (C 0) (hC0.symm ▸ hf base hx) hr).comp hC
  have hN0 : unitNormal f (C 0) = Pi.single none 1 := by
    rw [hC0, unitNormal_at_base f g hg hgn hgt]
  have hz : (fun t => tangentFrame f C j t ⬝ᵥ unitNormal f (C t)) =ᶠ[𝓝 (0 : ℝ)]
      (fun _ => (0 : ℝ)) := by
    filter_upwards [htan] with t ht
    exact (ht j).2
  have he := hz.deriv.deriv_eq
  simp only [deriv_const', deriv_const] at he
  rw [second_deriv_dot _ _ (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp hN),
    hE0, hN0, dotProduct_single_one, single_one_dotProduct] at he
  have hdE : ∀ a, velocity (tangentFrame f C j) a =
      -(if i = j then 1 else 0) * base a - A f g i j * Pi.single (M := fun _ => ℝ) none 1 a := by
    intro a
    exact tangentFrame_first_deriv f g hg (hf base hx) hgn hgt C hC hC0 i j hC1 a
  have hN1 := unitNormal_first_radial_normal f D g hg (hf base hx) hgn hgt hrad C hC hC0 i hC1
  have hv : velocity (tangentFrame f C j) ⬝ᵥ velocity (fun t => unitNormal f (C t)) = 0 := by
    simp only [dotProduct, hdE, Fintype.sum_option, base, Pi.single_apply]
    simp only [Option.some.injEq, reduceCtorEq, ite_true, ite_false, mul_one, mul_zero,
      sub_zero, zero_sub, zero_mul, Finset.sum_const_zero, add_zero, hN1.1, hN1.2]
  rw [hv, mul_zero, add_zero,
    unitNormal_second_tangent f D g hg (hf base hx) hgn hgt hrad C hC hC0 i hC1 hC2 j] at he
  unfold B
  nlinarith [he]

/-- The normal acceleration vanishes after summing over link directions. -/
theorem tangentFrame_normal_acceleration_trace
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), f (C i t) = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a -
      A f g i i * Pi.single (M := fun _ => ℝ) none 1 a) (j : ι) :
    (∑ i, acceleration (tangentFrame f (C i) j) none) = 0 := by
  have hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j := by
    intro j
    exact Source29AnalyticHomogeneousRadialJets.radial_hessian f D U hU hcone hf hhom
      base hx (Pi.single j 1)
  have hthird : ∀ a b, third f base (some none) a b = (D-2)*hess f base a b := by
    intro a b
    exact Source29AnalyticHomogeneousRadialJets.radial_third_derivative f D U hU hcone hf hhom
      base hx (Pi.single a 1) (Pi.single b 1)
  simp_rw [tangentFrame_second_normal_eq_neg_B f D g hg U hU hx hcone hf hhom hgn hgt
    (C _) (hC _) (hC0 _) (hmem _) _ j (hC1 _) (hC2 _)]
  rw [Finset.sum_neg_distrib,
    Source29AnalyticNormalizedLinkTraces.B_trace f D g hg.ne' (hf base hx) hL hgn hgt hrad hthird,
    neg_zero]

end
end Source29AnalyticFrameNormalAcceleration

/- Component: AnalyticFrameLaplacian.inc -/
namespace Source29AnalyticFrameLaplacian

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedLinkJets
open Source29PolynomialLinkChart (Ambient base)
open Source29AnalyticTangentFrame Source29AnalyticDotSecond Source29SimonsJetCorrection
open scoped BigOperators Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def frameLaplacian (f : Ambient ι → ℝ) (C : ι → ℝ → Ambient ι) (a b : ι) : ℝ :=
  ∑ i, acceleration (tangentFrame f (C i) a) (tangent b)

/-- Summing the frame acceleration determines its symmetric matrix part. -/
theorem frameLaplacian_symmetric_part
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), f (C i t) = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (a b : ι) :
    frameLaplacian f C a b + frameLaplacian f C b a =
      -2 * ((if a=b then 1 else 0) + matrixSquare (A f g) a b) := by
  unfold frameLaplacian
  rw [← Finset.sum_add_distrib]
  simp_rw [Source29AnalyticTangentFrameSecond.tangentFrame_second_symmetric
    f D g hg U hU hx hf hhom hgn hgt (C _) (hC _) (hC0 _) (hmem _) _ a b (hC1 _)]
  rw [← Finset.mul_sum, Finset.sum_add_distrib]
  congr 1
  congr 1
  · simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  · unfold matrixSquare
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm f g (hf base hx) i a]

end
end Source29AnalyticFrameLaplacian

/- Component: AnalyticMovingSecondForm.inc -/
namespace Source29AnalyticMovingSecondForm

open Filter Source29AnalyticNormalTrace Source29AnalyticNormalizedLinkJets
open Source29AnalyticTangentFrame Source29AnalyticNormalizedHessianCurve
open Source29AnalyticNormalizedHessianBlocks Source29AnalyticDotSecond
open Source29PolynomialLinkChart (Ambient base)
open scoped BigOperators Topology

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def tangentSecondForm (f : Ambient ι → ℝ) (C : ℝ → Ambient ι) (j k : ι) (t : ℝ) : ℝ :=
  ∑ b, ∑ a, tangentFrame f C j t a * normalizedHessian f C a b t * tangentFrame f C k t b

theorem tangentSecondForm_analyticAt
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), f (C t) = 0 ∧ (∑ a, (C t a)^2) = 1)
    (j k : ι) : AnalyticAt ℝ (tangentSecondForm f C j k) 0 := by
  obtain ⟨E, rfl, hE, _, _, _⟩ :=
    exists_analytic_tangent_frame f D g hg U hU hx hf hhom hgn hgt C hC hC0 hmem
  have hreg : grad f (C 0) ≠ 0 := hC0.symm ▸ regular_at_base f g hg.ne' hgn
  have hN := normalizedHessian_analyticAt f C (hC0.symm ▸ hf base hx) hC hreg
  exact Finset.analyticAt_fun_sum _ (fun b _ => Finset.analyticAt_fun_sum _
    (fun a _ => (((analyticAt_pi_iff.mp (hE j)) a).mul (hN a b)).mul
      ((analyticAt_pi_iff.mp (hE k)) b)))

theorem tangentSecondForm_zero
    (f : Ambient ι → ℝ) (g : ℝ) (hg : 0 < g)
    (hgn : grad f base none = g) (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC0 : C 0 = base) (j k : ι) :
    tangentSecondForm f C j k 0 = A f g j k := by
  have hE0 : ∀ j, tangentFrame f C j 0 = Pi.single (tangent j) 1 := by
    intro j
    simp only [tangentFrame, hC0, unitNormal_at_base f g hg hgn hgt,
      Source29AnalyticPairFrame.frame_self]
    rfl
  simp only [tangentSecondForm, hE0, Pi.single_apply, ite_mul, one_mul, zero_mul,
    mul_ite, mul_one, mul_zero, Finset.sum_ite_irrel, Finset.sum_const_zero,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  exact normalizedHessian_zero f g hg hgn hgt C hC0 (tangent j) (tangent k)

/-- Second derivatives of the actual moving second form, with the unknown
tangential frame accelerations still explicit. -/
theorem secondForm_second_deriv
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hrad : ∀ j, hess f base (some none) j = (D-1)*grad f base j)
    (hthird : ∀ a b, third f base (some none) a b = (D-2)*hess f base a b)
    (hgn : grad f base none = g)
    (hgt : ∀ j, grad f base (some j) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), f (C t) = 0 ∧ (∑ a, (C t a)^2) = 1)
    (i j k : ι) (hC1 : ∀ a, deriv (fun t => C t a) 0 =
      Pi.single (M := fun _ => ℝ) (tangent i) 1 a) :
    deriv (deriv (tangentSecondForm f C j k)) 0 =
      deriv (deriv (normalizedHessian f C (tangent j) (tangent k))) 0 +
      acceleration (tangentFrame f C j) none * w f g k +
      acceleration (tangentFrame f C k) none * w f g j +
      (∑ l, acceleration (tangentFrame f C j) (tangent l) * A f g l k) +
      (∑ l, acceleration (tangentFrame f C k) (tangent l) * A f g l j) +
      2 * (if i = j then 1 else 0) * A f g i k +
      2 * (if i = k then 1 else 0) * A f g i j +
      2 * z f g * A f g i j * A f g i k -
      2 * A f g i j * V f g i k - 2 * A f g i k * V f g i j +
      2 * w f g i * (A f g i j * w f g k + A f g i k * w f g j) := by
  obtain ⟨E, rfl, hE, hE0, horth, htan⟩ :=
    exists_analytic_tangent_frame f D g hg U hU hx hf hhom hgn hgt C hC hC0 hmem
  have hfa := hf base hx
  have hreg : grad f (C 0) ≠ 0 := hC0.symm ▸ regular_at_base f g hg.ne' hgn
  have hN := normalizedHessian_analyticAt f C (hC0.symm ▸ hfa) hC hreg
  have hj := Source29BilinearFrameJet.second_deriv_two_axis
    (tangentFrame f C j) (tangentFrame f C k) (fun t a b => normalizedHessian f C a b t)
    (analyticAt_pi_iff.mp (hE j)) (analyticAt_pi_iff.mp (hE k)) hN
    (some none) none (tangent j) (tangent k)
    (if i=j then 1 else 0) (A f g i j) (if i=k then 1 else 0) (A f g i k)
    (hE0 j) (hE0 k)
    (tangentFrame_first_deriv f g hg hfa hgn hgt C hC hC0 i j hC1)
    (tangentFrame_first_deriv f g hg hfa hgn hgt C hC hC0 i k hC1)
  have hacc : ∀ a b,
      (∑ l, acceleration (tangentFrame f C a) l * normalizedHessian f C l (tangent b) 0) =
      acceleration (tangentFrame f C a) none * w f g b +
      ∑ l, acceleration (tangentFrame f C a) (tangent l) * A f g l b := by
    intro a b
    rw [Fintype.sum_option, Fintype.sum_option]
    have hr : normalizedHessian f C (some none) (tangent b) 0 = 0 :=
      zero_radial_some f D g hg hgn hgt hrad C hC0 (some b)
    simp only [zero_normal_tangent f g hg hgn hgt C hC0, hr, mul_zero, zero_add]
    change _ + (∑ l, acceleration (tangentFrame f C a) (tangent l) *
      normalizedHessian f C (tangent l) (tangent b) 0) = _
    simp only [zero_tangent f g hg hgn hgt C hC0]
  have haccR : (∑ l, normalizedHessian f C (tangent j) l 0 * acceleration (tangentFrame f C k) l) =
      acceleration (tangentFrame f C k) none * w f g j +
      ∑ l, acceleration (tangentFrame f C k) (tangent l) * A f g l j := by
    rw [← hacc k j]
    apply Finset.sum_congr rfl
    intro l _
    rw [(normalizedHessian_symm_germ f hfa C hC hC0 (tangent j) l).self_of_nhds]
    ring
  have hnr : normalizedHessian f C none (some none) 0 = D-1 := by
    rw [(normalizedHessian_symm_germ f hfa C hC hC0 none (some none)).self_of_nhds, zero_radial_normal f D g hg hgn hgt hrad C hC0]
  have hjr : deriv (normalizedHessian f C (tangent j) (some none)) 0 = (D-2)*A f g i j := by
    rw [(normalizedHessian_symm_germ f hfa C hC hC0 (tangent j) (some none)).deriv_eq, first_radial_tangent f D g hg hfa hgn hgt hrad hthird C hC hC0 i j hC1]
  have hjn : deriv (normalizedHessian f C (tangent j) none) 0 = V f g i j - w f g i * w f g j := by
    rw [(normalizedHessian_symm_germ f hfa C hC hC0 (tangent j) none).deriv_eq, first_normal_tangent f g hg hfa hgn hgt C hC hC0 i j hC1]
  change deriv (deriv (fun t => ∑ b, ∑ a, tangentFrame f C j t a *
    normalizedHessian f C a b t * tangentFrame f C k t b)) 0 = _
  rw [hj, hacc, haccR,
    zero_radial_some f D g hg hgn hgt hrad C hC0 none,
    zero_radial_normal f D g hg hgn hgt hrad C hC0, hnr,
    zero_normal f g hg hgn hgt C hC0,
    first_radial_tangent f D g hg hfa hgn hgt hrad hthird C hC hC0 i k hC1,
    first_normal_tangent f g hg hfa hgn hgt C hC hC0 i k hC1, hjr, hjn]
  ring

end
end Source29AnalyticMovingSecondForm

/- Component: PositiveRootTangentTransport.inc -/
namespace Source29PositiveRootTangentTransport

open MvPolynomial Source29AnalyticNormalTrace Source29FinitePositiveCofactorRoot
open Source29AnalyticNormalizedHessianCurve Source29AnalyticTensorNorm
open scoped Topology BigOperators Matrix

noncomputable section
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Full Hessian product rule on the zero set, before restricting to tangent vectors. -/
theorem definingRoot_hess (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q) (i j : I) :
    hess (definingRoot P Q k) x i j =
      (eval x Q)^((k : ℝ)⁻¹) * eval x (pderiv i (pderiv j P)) +
      eval x (pderiv i P) * coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) j x +
      coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) i x * eval x (pderiv j P) := by
  have he := Source29FiniteJetConvergence.second_mul (fun y => eval y P)
    (fun y => (eval y Q)^((k : ℝ)⁻¹)) x (Pi.single i 1) (Pi.single j 1)
    (Source29PolynomialLinkChart.analyticAt_eval_real P x) (rootUnit_analyticAt Q k hk x hQ)
  change hess (definingRoot P Q k) x i j =
    eval x P * hess (fun y => (eval y Q)^((k : ℝ)⁻¹)) x i j +
    (eval x Q)^((k : ℝ)⁻¹) * hess (fun y => eval y P) x i j +
    coordPartial (fun y => eval y P) i x * coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) j x +
    coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) i x * coordPartial (fun y => eval y P) j x at he
  simpa only [hP, partial_eval, hess_eval, zero_mul, zero_add] using he

/-- Derivatives of the positive unit cancel after restriction to two tangent vectors. -/
theorem hess_contraction (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q)
    (v w : I → ℝ) (hv : (∑ a, v a * eval x (pderiv a P)) = 0)
    (hw : (∑ a, w a * eval x (pderiv a P)) = 0) :
    (∑ b, ∑ a, v a * hess (definingRoot P Q k) x a b * w b) =
      (eval x Q)^((k : ℝ)⁻¹) * (∑ b, ∑ a, v a * eval x (pderiv a (pderiv b P)) * w b) := by
  have hb (b : I) : (∑ a, v a * hess (definingRoot P Q k) x a b * w b) =
      (eval x Q)^((k : ℝ)⁻¹) * (∑ a, v a * eval x (pderiv a (pderiv b P)) * w b) +
      (coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) b x * w b) *
        (∑ a, v a * eval x (pderiv a P)) +
      (eval x (pderiv b P) * w b) *
        (∑ a, v a * coordPartial (fun y => (eval y Q)^((k : ℝ)⁻¹)) a x) := by
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro a _
    rw [definingRoot_hess P Q k hk x hP hQ a b]
    ring
  have hw' : (∑ b, eval x (pderiv b P) * w b) = 0 := by
    simpa only [mul_comm] using hw
  simp_rw [hb, hv, mul_zero, add_zero]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul, hw', zero_mul, add_zero]

theorem profile_mul_unit (P Q : MvPolynomial I ℝ) (k : ℕ) (hk : 0 < k)
    (x : I → ℝ) (hP : eval x P = 0) (hQ : 0 < eval x Q) :
    profile (definingRoot P Q k) x * (eval x Q)^((k : ℝ)⁻¹) =
      (tensorNorm (fun i => eval x (pderiv i P)))⁻¹ := by
  unfold profile
  rw [definingRoot_gradient P Q k hk x hP hQ,
    Source29PositiveCofactorRoot.tensorNorm_scale_pos _ _ (Real.rpow_pos_of_pos hQ _)]
  rw [mul_inv_rev, mul_assoc, inv_mul_cancel₀ (Real.rpow_pos_of_pos hQ _).ne', mul_one]

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
open Source29PolynomialLinkChart (Ambient base)

/-- The positive defining root has the same oriented unit normal on the zero set. -/
theorem unitNormal_eq (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (hk : 0 < k)
    (x : Ambient ι) (hP : eval x P = 0) (hQ : 0 < eval x Q) :
    Source29AnalyticTangentFrame.unitNormal (definingRoot P Q k) x =
      Source29PolynomialUnitNormal.unitNormal P x := by
  funext a
  unfold Source29AnalyticTangentFrame.unitNormal
  rw [definingRoot_gradient P Q k hk x hP hQ, ← mul_assoc, profile_mul_unit P Q k hk x hP hQ]
  rfl

theorem tangentFrame_eq (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (hk : 0 < k)
    (C : ℝ → Ambient ι) (t : ℝ) (hP : eval (C t) P = 0) (hQ : 0 < eval (C t) Q) (j : ι) :
    Source29AnalyticTangentFrame.tangentFrame (definingRoot P Q k) C j t =
      Source29PolynomialTangentFrame.tangentFrame P C j t := by
  unfold Source29AnalyticTangentFrame.tangentFrame Source29PolynomialTangentFrame.tangentFrame
  rw [unitNormal_eq P Q k hk (C t) hP hQ]

omit [DecidableEq ι] in
/-- An arbitrary tangent vector to the polynomial normal annihilates its gradient. -/
theorem gradient_contraction_zero (P : MvPolynomial (Option (Option ι)) ℝ)
    (x v : Ambient ι) (hreg : Source29PolynomialCurvaturePotential.gradientAt P x ≠ 0)
    (hv : v ⬝ᵥ Source29PolynomialUnitNormal.unitNormal P x = 0) :
    (∑ a, v a * eval x (pderiv a P)) = 0 := by
  have hn : (tensorNorm (fun a => eval x (pderiv a P)))⁻¹ ≠ 0 :=
    inv_ne_zero (tensorNorm_pos hreg).ne'
  have he : (tensorNorm (fun a => eval x (pderiv a P)))⁻¹ *
      (∑ a, v a * eval x (pderiv a P)) = 0 := by
    calc
      _ = v ⬝ᵥ Source29PolynomialUnitNormal.unitNormal P x := by
        simp only [Source29PolynomialUnitNormal.unitNormal, Source29PolynomialJacobiCurves.jacobiProfile,
          dotProduct, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro a _
        ring
      _ = 0 := hv
  exact (mul_eq_zero.mp he).resolve_left hn

end
end Source29PositiveRootTangentTransport

/- Component: AnalyticPositiveRootMovingCurvature.inc -/
namespace Source29AnalyticPositiveRootMovingCurvature

open Filter MvPolynomial Source29PolynomialLinkChart
open Source29PolynomialCurvaturePotential Source29PolynomialJacobiCurves
open Source29PolynomialFramedCurvature Source29PolynomialMovingCurvature
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open Source29PositiveRootTangentTransport Source29FinitePositiveCofactorRoot
open Source29AnalyticNormalizedHessianCurve
open scoped Topology BigOperators Matrix

noncomputable section
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The frame norm formula needs no lower bound on the homogeneous degree. -/
theorem framedSecondForm_norm_sq_all_degrees
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (x : Ambient ι) (hreg : gradientAt P x ≠ 0)
    (U : Matrix (Option (Option ι)) (Option (Option ι)) ℝ)
    (hUt : U.transpose * U = 1) (hbase : U *ᵥ base = x)
    (hUn : ∀ a, U a none = Source29PolynomialUnitNormal.unitNormal P x a) :
    (∑ i, ∑ j, (framedSecondForm P x U i j)^2) = curvaturePotential P x := by
  let g := Source29AnalyticTensorNorm.tensorNorm (gradientAt P x)
  have hg : g ≠ 0 := (Source29AnalyticTensorNorm.tensorNorm_pos hreg).ne'
  obtain ⟨hgn, hgt⟩ := frame_normalizes_gradient P x hreg U hUt hbase hUn
  have hU : U * U.transpose = 1 := mul_eq_one_comm.mp hUt
  have he := curvaturePotential_changeVariables U hU P base
  rw [hbase, Source29AnalyticPositiveRootCurvature.curvaturePotential_at_base _ d
    (isHomogeneous_changeVariables U P d hP) g hg hgn hgt] at he
  rw [← he]
  have hH := realHessian_changeVariables U P base
  rw [hbase] at hH
  change (∑ i, ∑ j, (g⁻¹ * (U.transpose * realHessian P x * U)
    (Source29NormalizedLinkJets.tangent i) (Source29NormalizedLinkJets.tangent j))^2) = _
  rw [← hH]
  simp only [realHessian_apply, mul_pow, ← Finset.mul_sum, inv_pow,
    div_eq_mul_inv, mul_comm, Source29NormalizedLinkJets.tangent, Source29AnalyticNormalizedLinkJets.tangent]

/-- Along the zero link the polynomial moving form has the invariant curvature norm,
including when its homogeneous degree is zero or one. -/
theorem polynomial_tangentSecondForm_norm_sq_at
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (C : ℝ → Ambient ι) (t : ℝ) (hx : (∑ a, (C t a)^2) = 1)
    (hz : eval (C t) P = 0) (hr : gradientAt P (C t) ≠ 0) :
    (∑ i, ∑ j, (Source29PolynomialMovingCurvature.tangentSecondForm P C i j t)^2) =
      curvaturePotential P (C t) := by
  simp_rw [Source29PolynomialMovingCurvature.tangentSecondForm_eq_framed]
  obtain ⟨hbase, hnormal⟩ := linkFrameMatrix_pair P d hP (C t) hx hz hr
  exact framedSecondForm_norm_sq_all_degrees P d hP (C t) hr (linkFrameMatrix P (C t))
    (Source29PairFrameMatrix.frameMatrix_transpose_mul _ _ _ _) hbase hnormal

/-- The two moving forms agree at every regular zero where the positive root exists. -/
theorem tangentSecondForm_eq_at
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (k : ℕ) (hk : 0 < k)
    (C : ℝ → Ambient ι) (t : ℝ) (hP : eval (C t) P = 0) (hQ : 0 < eval (C t) Q)
    (hreg : gradientAt P (C t) ≠ 0)
    (htan : ∀ j, Source29PolynomialTangentFrame.tangentFrame P C j t ⬝ᵥ
      Source29PolynomialUnitNormal.unitNormal P (C t) = 0) (i j : ι) :
    Source29AnalyticMovingSecondForm.tangentSecondForm (definingRoot P Q k) C i j t =
      Source29PolynomialMovingCurvature.tangentSecondForm P C i j t := by
  have hv := gradient_contraction_zero P (C t)
    (Source29PolynomialTangentFrame.tangentFrame P C i t) hreg (htan i)
  have hw := gradient_contraction_zero P (C t)
    (Source29PolynomialTangentFrame.tangentFrame P C j t) hreg (htan j)
  have he := hess_contraction P Q k hk (C t) hP hQ _ _ hv hw
  unfold Source29AnalyticMovingSecondForm.tangentSecondForm normalizedHessian
  simp only [tangentFrame_eq P Q k hk C t hP hQ]
  calc
    _ = profile (definingRoot P Q k) (C t) * (∑ b, ∑ a,
      Source29PolynomialTangentFrame.tangentFrame P C i t a *
      Source29AnalyticNormalTrace.hess (definingRoot P Q k) (C t) a b *
      Source29PolynomialTangentFrame.tangentFrame P C j t b) := by
      simp only [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro b _
      apply Finset.sum_congr rfl
      intro a _
      ring
    _ = _ := by
      rw [he, ← mul_assoc, profile_mul_unit P Q k hk (C t) hP hQ]
      rfl

/-- The moving analytic root form has the polynomial curvature potential along
any actual analytic zero-link curve through a normalized regular point. -/
theorem tangentSecondForm_local_norm_sq
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d k : ℕ) (hP : P.IsHomogeneous d)
    (hk : 0 < k) (hQ : 0 < eval base Q) (a : ℝ) (ha : 0 < a)
    (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), definingRoot P Q k (C t) = 0 ∧ (∑ a, (C t a)^2) = 1) :
    (fun t => ∑ i, ∑ j,
      (Source29AnalyticMovingSecondForm.tangentSecondForm (definingRoot P Q k) C i j t)^2)
      =ᶠ[𝓝 (0 : ℝ)] (fun t => curvaturePotential P (C t)) := by
  have hQ0 : 0 < eval (C 0) Q := by simpa only [hC0] using hQ
  have hQnear : ∀ᶠ t in 𝓝 (0 : ℝ), 0 < eval (C t) Q :=
    ((analyticAt_eval_real Q (C 0)).comp hC).continuousAt.eventually (eventually_gt_nhds hQ0)
  have hPmem : ∀ᶠ t in 𝓝 (0 : ℝ), eval (C t) P = 0 ∧ (∑ a, (C t a)^2) = 1 := by
    filter_upwards [hmem, hQnear] with t ht hqt
    exact ⟨(mul_eq_zero.mp ht.1).resolve_right (Real.rpow_pos_of_pos hqt _).ne', ht.2⟩
  obtain ⟨E, rfl, _, _, _, htan⟩ := Source29PolynomialTangentFrame.exists_analytic_tangent_frame
    P d hP a ha hpn hpt C hC hC0 hPmem
  have hgrad : AnalyticAt ℝ (fun t => gradientAt P (C t)) 0 := by
    apply AnalyticAt.pi
    intro b
    exact (analyticAt_eval_real (pderiv b P) (C 0)).comp hC
  have hreg0 : gradientAt P (C 0) ≠ 0 := by
    rw [hC0]
    intro hz
    have he := congrFun hz none
    exact ha.ne' (by simpa only [gradientAt, hpn, Pi.zero_apply] using he)
  have hnear := hgrad.continuousAt.eventually_ne hreg0
  filter_upwards [hPmem, hQnear, htan, hnear] with t ht hqt htan hr
  simp_rw [tangentSecondForm_eq_at P Q k hk C t ht.1 hqt hr (fun j => (htan j).2)]
  exact polynomial_tangentSecondForm_norm_sq_at P d hP C t ht.2 ht.1 hr

/-- The squared polynomial curvature is the sum of squared moving form entries. -/
theorem curvatureNorm_sq_local
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d k : ℕ) (hP : P.IsHomogeneous d)
    (hk : 0 < k) (hQ : 0 < eval base Q) (a : ℝ) (ha : 0 < a)
    (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), definingRoot P Q k (C t) = 0 ∧ (∑ a, (C t a)^2) = 1) :
    (fun t => (curvatureNorm P (C t))^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => ∑ i, ∑ j,
        (Source29AnalyticMovingSecondForm.tangentSecondForm (definingRoot P Q k) C i j t)^2) := by
  filter_upwards [tangentSecondForm_local_norm_sq P Q d k hP hk hQ a ha hpn hpt C hC hC0 hmem]
    with t ht
  have hn : 0 ≤ curvaturePotential P (C t) := by
    rw [← ht]
    exact Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => sq_nonneg _))
  exact (Real.sq_sqrt hn).trans ht.symm

/-- Equality of the nonnegative curvature norms, rather than only their squares. -/
theorem tangentSecondForm_local_norm
    (P Q : MvPolynomial (Option (Option ι)) ℝ) (d k : ℕ) (hP : P.IsHomogeneous d)
    (hk : 0 < k) (hQ : 0 < eval base Q) (a : ℝ) (ha : 0 < a)
    (hpn : eval base (pderiv none P) = a)
    (hpt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ℝ → Ambient ι) (hC : AnalyticAt ℝ C 0) (hC0 : C 0 = base)
    (hmem : ∀ᶠ t in 𝓝 (0 : ℝ), definingRoot P Q k (C t) = 0 ∧ (∑ a, (C t a)^2) = 1) :
    (fun t => Real.sqrt (∑ i, ∑ j,
      (Source29AnalyticMovingSecondForm.tangentSecondForm (definingRoot P Q k) C i j t)^2))
      =ᶠ[𝓝 (0 : ℝ)] (fun t => curvatureNorm P (C t)) := by
  filter_upwards [tangentSecondForm_local_norm_sq P Q d k hP hk hQ a ha hpn hpt C hC hC0 hmem]
    with t ht
  exact congrArg Real.sqrt ht

end
end Source29AnalyticPositiveRootMovingCurvature

