variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem actual_second_derivative_contraction
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g) (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a - A P g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (hJac : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
      (normSq (A P g)+((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))*g⁻¹ = 0) :
    (∑ i, ∑ a, ∑ b, A P g a b * deriv (deriv (tangentSecondForm P (C i) a b)) 0) =
      ((Fintype.card ι : ℝ)-normSq (A P g))*normSq (A P g) := by
  calc
    _ = ∑ a, ∑ b, A P g a b * (∑ i, deriv (deriv (tangentSecondForm P (C i) a b)) 0) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro a _
      rw [Finset.sum_comm]
      simp only [Finset.mul_sum]
    _ = _ := Source29FrameContractionAlgebra.contracted_trace (A P g) (frameLaplacian P C)
      (fun a b => ∑ i, deriv (deriv (tangentSecondForm P (C i) a b)) 0)
      (Fintype.card ι : ℝ) (normSq (A P g)) (A_symm P g)
      (frameLaplacian_symmetric_part P d hP g hg hgn hgt C hC hC0 hmem hC1)
      (Source29MovingSecondFormTrace.secondForm_trace_with_frameLaplacian
        P d hP hd g hg hL hgn hgt C hC hC0 hmem hC1 hC2 (normSq (A P g)) hJac)

end
end Source29MovingSecondFormContraction

/- Component: NormalizedScalarSimons.inc -/
namespace Source29NormalizedScalarSimons

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialMovingCurvature Source29PolynomialJacobiCurves Source29PolynomialCurvaturePotential
open Source29AnalyticDotSecond Source29GaussSimonsAlgebra
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Scalar Simons along actual analytic link curves. All geometric derivative
identities are derived from the polynomial and the constructed frame. -/
theorem scalar_simons_for_link_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g) (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a - A P g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (hJac : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
      (normSq (A P g)+((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))*g⁻¹ = 0)
    (hpos : 0 < curvaturePotential P base) :
    ((Fintype.card ι : ℝ)-curvaturePotential P base) * curvatureNorm P base ≤
      ∑ i, deriv (deriv (fun t => curvatureNorm P (C i t))) 0 := by
  have hK := Source29PolynomialSimonsTensor.normSq_A_eq_curvaturePotential
    P d hP hd g hg.ne' hL hgn hgt
  have hsq : (curvatureNorm P base)^2 = normSq (A P g) := by
    rw [hK]
    exact Real.sq_sqrt hpos.le
  have hp : 0 < curvatureNorm P base := Real.sqrt_pos.mpr hpos
  have hreg : gradientAt P base ≠ 0 := by
    intro he
    have hn := congrFun he none
    exact hg.ne' (by simpa only [gradientAt, hgn, Pi.zero_apply] using hn)
  have hcurv : AnalyticAt ℝ (curvatureNorm P) base :=
    Source29PolynomialCurvatureRegularity.curvatureNorm_analyticAt P base hreg hpos
  have hh : ∀ i, AnalyticAt ℝ (fun t => curvatureNorm P (C i t)) 0 := by
    intro i
    have ha : AnalyticAt ℝ (curvatureNorm P) (C i 0) := by simpa only [hC0] using hcurv
    exact ha.comp (hC i)
  have hA : ∀ i (j : ι × ι), AnalyticAt ℝ (tangentSecondForm P (C i) j.1 j.2) 0 := by
    intro i j
    exact tangentSecondForm_analyticAt P d hP g hg hgn hgt (C i) (hC i) (hC0 i) (hmem i) j.1 j.2
  have hzero : (curvatureNorm P base)^2 = ∑ j : ι × ι, (A P g j.1 j.2)^2 := by
    simpa only [normSq, Fintype.sum_prod_type] using hsq
  have hnorm : ∀ i, (fun t => (curvatureNorm P (C i t))^2) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => ∑ j : ι × ι, (tangentSecondForm P (C i) j.1 j.2 t)^2) := by
    intro i
    simpa only [Fintype.sum_prod_type] using
      tangentSecondForm_local_norm P d hP g hg hgn hgt (C i) (hC i) (hC0 i) (hmem i) (by omega)
  have hcontract := Source29MovingSecondFormContraction.actual_second_derivative_contraction
    P d hP hd g hg hL hgn hgt C hC hC0 hmem hC1 hC2 hJac
  have he := Source29ContractedSimonsNorm.scalar_simons_for_analytic_components
    (fun i (j : ι × ι) => tangentSecondForm P (C i) j.1 j.2)
    (fun i t => curvatureNorm P (C i t)) (fun j : ι × ι => A P g j.1 j.2)
    (curvatureNorm P base) (Fintype.card ι : ℝ) hh hA
    (fun i => congrArg (curvatureNorm P) (hC0 i))
    (fun i j => tangentSecondForm_zero P g hg hgn hgt (C i) (hC0 i) j.1 j.2)
    hp hzero hnorm (by simpa only [Fintype.sum_prod_type, hsq] using hcontract)
  simpa only [hsq, hK] using he

end
end Source29NormalizedScalarSimons

/- Component: PolynomialSimonsCurves.inc -/
namespace Source29PolynomialSimonsCurves

open Filter MvPolynomial Source29PolynomialLinkChart Source29NormalizedLinkJets
open Source29PolynomialJacobiCurves Source29PolynomialCurvaturePotential Source29GaussSimonsAlgebra
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Actual local link curves satisfy both Jacobi and scalar Simons. The
Jacobi identity and all moving-frame identities are derived, not assumed. -/
theorem exists_simons_jacobi_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ) (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (g : ℝ) (hg : 0 < g) (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hzero : eval base P = 0) (hgn : eval base (pderiv none P) = g)
    (hgt : ∀ j, eval base (pderiv (some j) P) = 0)
    (hpos : 0 < curvaturePotential P base) :
    ∃ C : ι → ℝ → Ambient ι,
      (∀ i, AnalyticAt ℝ (C i) 0) ∧ (∀ i, C i 0 = base) ∧
      (∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1) ∧
      (∀ i, AnalyticAt ℝ (fun t => jacobiProfile P (C i t)) 0) ∧
      (∀ i, AnalyticAt ℝ (fun t => curvatureNorm P (C i t)) 0) ∧
      ((∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
        (curvaturePotential P base + ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) *
          jacobiProfile P base = 0) ∧
      (((Fintype.card ι : ℝ)-curvaturePotential P base)*curvatureNorm P base ≤
        ∑ i, deriv (deriv (fun t => curvatureNorm P (C i t))) 0) := by
  obtain ⟨γ, hγ, hγ0, hγ1, hγ2, hmem, hprofile, hJac⟩ :=
    exists_jacobi_curves P d hP (by omega) g hg hL hzero hgn hgt
  let C : ι → ℝ → Ambient ι := fun i t a => γ i a t
  have hC : ∀ i, AnalyticAt ℝ (C i) 0 := fun i => AnalyticAt.pi (hγ i)
  have hC0 : ∀ i, C i 0 = base := fun i => funext (hγ0 i)
  have hC2 : ∀ i a, Source29AnalyticDotSecond.acceleration (C i) a = -base a -
      A P g i i * Pi.single (M := fun _ => ℝ) none 1 a := by
    intro i a
    exact hγ2 i a
  rw [← curvaturePotential_at_base P d hP (by omega) g hg.ne' hgn hgt] at hJac
  have hJ : (∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
      (normSq (A P g)+((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))*g⁻¹ = 0 := by
    rw [Source29PolynomialSimonsTensor.normSq_A_eq_curvaturePotential P d hP hd g hg.ne' hL hgn hgt]
    simpa only [C, jacobiProfile_at_base P g hg hgn hgt] using hJac
  have hreg : gradientAt P base ≠ 0 := by
    intro he
    have hn := congrFun he none
    exact hg.ne' (by simpa only [gradientAt, hgn, Pi.zero_apply] using hn)
  have hc : ∀ i, AnalyticAt ℝ (fun t => curvatureNorm P (C i t)) 0 := by
    intro i
    have he : AnalyticAt ℝ (curvatureNorm P) (C i 0) := by
      rw [hC0]
      exact Source29PolynomialCurvatureRegularity.curvatureNorm_analyticAt P base hreg hpos
    exact he.comp (hC i)
  refine ⟨C, hC, hC0, hmem, hprofile, hc, hJac, ?_⟩
  exact Source29NormalizedScalarSimons.scalar_simons_for_link_curves
    P d hP hd g hg hL hgn hgt C hC hC0 hmem hγ1 hC2 hJ hpos

end
end Source29PolynomialSimonsCurves

/- Component: RegularLinkSimons.inc -/
namespace Source29RegularLinkSimons

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialJacobiCurves
open Source29PolynomialCurvaturePotential Source29PolynomialJacobiTransport
open Source29QuarticReuse.QuarticMinimal
open scoped Topology BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Jacobi and scalar Simons at every regular link point with positive
curvature, transported from the normalized polynomial to its original coordinates. -/
theorem exists_regular_link_simons_curves
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (x : Ambient ι) (hx : (∑ a, (x a)^2) = 1) (hzero : eval x P = 0)
    (hreg : gradientAt P x ≠ 0) (hpos : 0 < curvaturePotential P x) :
    ∃ C : ι → ℝ → Ambient ι,
      (∀ i, AnalyticAt ℝ (C i) 0) ∧ (∀ i, C i 0 = x) ∧
      (∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), eval (C i t) P = 0 ∧ (∑ a, (C i t a)^2) = 1) ∧
      (∀ i, AnalyticAt ℝ (fun t => jacobiProfile P (C i t)) 0) ∧
      (∀ i, AnalyticAt ℝ (fun t => curvatureNorm P (C i t)) 0) ∧
      ((∑ i, deriv (deriv (fun t => jacobiProfile P (C i t))) 0) +
        (curvaturePotential P x + ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ))) *
          jacobiProfile P x = 0) ∧
      (((Fintype.card ι : ℝ)-curvaturePotential P x)*curvatureNorm P x ≤
        ∑ i, deriv (deriv (fun t => curvatureNorm P (C i t))) 0) := by
  obtain ⟨g, U, hg, hUt, hU, hbase, hQ, hLQ, hQzero, hgn, hgt⟩ :=
    Source29PolynomialNormalFrame.exists_normalized_polynomial P d hP hL x hx hzero hreg
  have hp : 0 < curvaturePotential (changeVariables U P) base := by
    rwa [curvaturePotential_changeVariables U hU, hbase]
  obtain ⟨γ, hγ, hγ0, hγmem, hγφ, hγh, hJ, hS⟩ :=
    Source29PolynomialSimonsCurves.exists_simons_jacobi_curves
      (changeVariables U P) d hQ hd g hg hLQ hQzero hgn hgt hp
  let C : ι → ℝ → Ambient ι := fun i t => U *ᵥ γ i t
  have hC : ∀ i, AnalyticAt ℝ (C i) 0 := fun i =>
    Source29LinearCurveTransport.analytic_mulVec U (fun a t => γ i t a) (analyticAt_pi_iff.mp (hγ i))
  have hC0 : ∀ i, C i 0 = x := by
    intro i
    change U *ᵥ γ i 0 = x
    rw [hγ0, hbase]
  refine ⟨C, hC, hC0, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    filter_upwards [hγmem i] with t ht
    constructor
    · change eval (U *ᵥ γ i t) P = 0
      rw [← eval_changeVariables]
      exact ht.1
    · change (∑ a, (U *ᵥ γ i t) a ^ 2) = 1
      rw [norm_square_mulVec U hUt]
      exact ht.2
  · simpa only [jacobiProfile_changeVariables U hU] using hγφ
  · simpa only [curvatureNorm_changeVariables U hU] using hγh
  · simpa only [jacobiProfile_changeVariables U hU, curvaturePotential_changeVariables U hU, hbase] using hJ
  · simpa only [curvatureNorm_changeVariables U hU, curvaturePotential_changeVariables U hU, hbase] using hS

end
end Source29RegularLinkSimons

/- Component: CompactLinkDegreeBound.inc -/
namespace Source29CompactLinkDegreeBound

open Filter MvPolynomial Source29PolynomialLinkChart Source29PolynomialCurvaturePotential
open Source29PolynomialJacobiCurves Source29PolynomialCurvatureRegularity
open scoped BigOperators Topology

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Compact comparison with the now-derived Jacobi and scalar Simons
inequalities. Global regularity and nonflatness are the remaining inputs. -/
theorem homogeneous_degree_eigenvalue_bound
    (P : MvPolynomial (Option (Option ι)) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hregular : ∀ x : Ambient ι, eval x P = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt P x ≠ 0)
    (hnonflat : ∃ x : Ambient ι, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    ((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)) ≤ -(Fintype.card ι : ℝ) := by
  let s : Set (Ambient ι) := {x | eval x P = 0 ∧ (∑ a, (x a)^2) = 1}
  have hs : IsCompact s := Source29CompactPolynomialLink.isCompact_link P
  have hr : ∀ x ∈ s, gradientAt P x ≠ 0 := hregular
  have hc : ContinuousOn (curvatureNorm P) s := curvatureNorm_continuousOn P s hr
  have hφ : ContinuousOn (jacobiProfile P) s := fun x hx =>
    (jacobiProfile_analyticAt P x (hr x hx)).continuousAt.continuousWithinAt
  have hφpos : ∀ x ∈ s, 0 < jacobiProfile P x := fun x hx => jacobiProfile_positive P x (hr x hx)
  obtain ⟨b, hb, hpb⟩ := hnonflat
  have hhb : 0 < curvatureNorm P b := Real.sqrt_pos.mpr hpb
  have hrc : ContinuousOn (fun x => curvatureNorm P x / jacobiProfile P x) s :=
    hc.div hφ (fun x hx => (hφpos x hx).ne')
  obtain ⟨a, ha, hmax⟩ := hs.exists_isMaxOn ⟨b, hb⟩ hrc
  have hratio : 0 < curvatureNorm P a / jacobiProfile P a :=
    (div_pos hhb (hφpos b hb)).trans_le (hmax hb)
  have hha : 0 < curvatureNorm P a := by
    have he := (lt_div_iff₀ (hφpos a ha)).mp hratio
    simpa only [zero_mul] using he
  have hpa : 0 < curvaturePotential P a := Real.sqrt_pos.mp hha
  obtain ⟨C, hC, hC0, hmem, hCφ, hCh, hJac, hSimons⟩ :=
    Source29RegularLinkSimons.exists_regular_link_simons_curves
      P d hP hd hL a ha.2 ha.1 (hr a ha) hpa
  apply Source29LocalEigenvalueComparison.eigenvalue_bound_at_ratio_maximum
    (fun i t => curvatureNorm P (C i t)) (fun i t => jacobiProfile P (C i t))
    (curvatureNorm P a) (jacobiProfile P a) (curvaturePotential P a)
    (Fintype.card ι : ℝ) (((d : ℝ)-1)*((d : ℝ)-(Fintype.card ι : ℝ)))
    hCh hCφ (fun i => congrArg (curvatureNorm P) (hC0 i))
    (fun i => congrArg (jacobiProfile P) (hC0 i)) hha (hφpos a ha) _ hSimons hJac
  intro i
  change ∀ᶠ t in 𝓝 (0 : ℝ), curvatureNorm P (C i t) / jacobiProfile P (C i t) ≤
    curvatureNorm P (C i 0) / jacobiProfile P (C i 0)
  filter_upwards [hmem i] with t ht
  simpa only [hC0, Set.mem_setOf_eq] using hmax ht

/-- In ambient dimension eight, a homogeneous solution of Lp=0 with degree
at least three and a globally regular nonflat unit zero link has degree at most four. -/
theorem degree_interval_ambient_eight
    (P : MvPolynomial (Option (Option (Fin 6))) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d)
    (hL : Source29FactorInheritance.cubicOperator P = 0)
    (hregular : ∀ x : Ambient (Fin 6), eval x P = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt P x ≠ 0)
    (hnonflat : ∃ x : Ambient (Fin 6), (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    3 ≤ d ∧ d ≤ 4 := by
  have he := homogeneous_degree_eigenvalue_bound P d hP hd hL hregular hnonflat
  have hb : ((d : ℝ)-1)*((d : ℝ)-6) ≤ -(6 : ℝ) := by simpa using he
  have hi := Source29LocalEigenvalueComparison.degree_interval_eight (d : ℝ)
    (((d : ℝ)-1)*((d : ℝ)-6)) (by ring) hb
  exact ⟨hd, by exact_mod_cast hi.2⟩

end
end Source29CompactLinkDegreeBound

/- Component: PolynomialReindex.inc -/
namespace Source29PolynomialReindex

open MvPolynomial Source29FactorInheritance Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix

noncomputable section

variable {κ η : Type*} [Fintype κ] [Fintype η] [DecidableEq κ] [DecidableEq η]

theorem cubicOperator_rename (e : κ ≃ η) (P : MvPolynomial κ ℝ) :
    cubicOperator (rename e P) = rename e (cubicOperator P) := by
  unfold cubicOperator
  rw [← e.sum_comp (fun i => (pderiv i (rename e P))^2),
    ← e.sum_comp (fun i => pderiv i (pderiv i (rename e P))),
    ← Source29MetricReindex.sum_two_reindex e (fun i j =>
      pderiv i (rename e P) * pderiv j (rename e P) * pderiv i (pderiv j (rename e P)))]
  simp only [pderiv_rename e.injective, map_sub, map_mul, map_pow, map_sum]

theorem gradientAt_rename (e : κ ≃ η) (P : MvPolynomial κ ℝ) (x : η → ℝ) (a : κ) :
    gradientAt (rename e P) x (e a) = gradientAt P (x ∘ e) a := by
  simp only [gradientAt, pderiv_rename e.injective, eval_rename]

theorem realHessian_rename (e : κ ≃ η) (P : MvPolynomial κ ℝ) (x : η → ℝ) (a b : κ) :
    realHessian (rename e P) x (e a) (e b) = realHessian P (x ∘ e) a b := by
  simp only [realHessian_apply, pderiv_rename e.injective, eval_rename]

theorem gradientAt_rename_ne_zero (e : κ ≃ η) (P : MvPolynomial κ ℝ) (x : η → ℝ)
    (hr : gradientAt P (x ∘ e) ≠ 0) : gradientAt (rename e P) x ≠ 0 := by
  intro he
  apply hr
  funext a
  have hz := congrFun he (e a)
  simpa only [gradientAt_rename, Pi.zero_apply] using hz

end
end Source29PolynomialReindex

/- Component: CurvatureReindex.inc -/
namespace Source29CurvatureReindex

open MvPolynomial Source29CurvaturePotentialAlgebra Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix

noncomputable section

variable {κ η : Type*} [Fintype κ] [Fintype η] [DecidableEq κ] [DecidableEq η]

theorem dot_reindex (e : κ ≃ η) (v w : η → ℝ) :
    (fun a => v (e a)) ⬝ᵥ (fun a => w (e a)) = v ⬝ᵥ w :=
  e.sum_comp (fun a => v a * w a)

theorem potential_reindex (e : κ ≃ η) (v : η → ℝ) (H : Matrix η η ℝ) :
    potential (fun a => v (e a)) (fun a b => H (e a) (e b)) = potential v H := by
  have hH : matrixSq (fun a b => H (e a) (e b)) = matrixSq H :=
    Source29MetricReindex.sum_two_reindex e (fun a b => (H a b)^2)
  have hm : (fun a b => H (e a) (e b)) *ᵥ (fun a => v (e a)) =
      fun a => (H *ᵥ v) (e a) := by
    funext a
    exact e.sum_comp (fun b => H (e a) b * v b)
  simp only [potential, hm, hH, vectorSq, dot_reindex]

theorem curvaturePotential_rename (e : κ ≃ η) (P : MvPolynomial κ ℝ) (x : η → ℝ) :
    curvaturePotential (rename e P) x = curvaturePotential P (x ∘ e) := by
  have he := potential_reindex e (gradientAt (rename e P) x) (realHessian (rename e P) x)
  have hg : (fun a => gradientAt (rename e P) x (e a)) = gradientAt P (x ∘ e) := by
    funext a
    exact Source29PolynomialReindex.gradientAt_rename e P x a
  have hH : (fun a b => realHessian (rename e P) x (e a) (e b)) = realHessian P (x ∘ e) := by
    funext a b
    exact Source29PolynomialReindex.realHessian_rename e P x a b
  rw [hg, hH] at he
  exact he.symm

end
end Source29CurvatureReindex

/- Component: FinEightDegreeBound.inc -/
namespace Source29FinEightDegreeBound

open MvPolynomial Source29PolynomialCurvaturePotential Source29FactorInheritance
open scoped BigOperators

noncomputable section

def eightLinkEquiv : Fin 8 ≃ Option (Option (Fin 6)) :=
  Fintype.equivOfCardEq (by simp)

/-- The checked compact-link degree bound in the original Fin 8 coordinates. -/
theorem regular_nonflat_degree_le_four (P : MvPolynomial (Fin 8) ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 3 ≤ d) (hL : cubicOperator P = 0)
    (hregular : ∀ x, eval x P = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt P x ≠ 0)
    (hnonflat : ∃ x, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) :
    d ≤ 4 := by
  let e := eightLinkEquiv
  let Q := rename e P
  have hQ : Q.IsHomogeneous d := hP.rename_isHomogeneous
  have hQL : cubicOperator Q = 0 := by
    change cubicOperator (rename e P) = 0
    rw [Source29PolynomialReindex.cubicOperator_rename, hL, map_zero]
  have hqr : ∀ x, eval x Q = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt Q x ≠ 0 := by
    intro x hx
    apply Source29PolynomialReindex.gradientAt_rename_ne_zero e P x
    apply hregular
    constructor
    · simpa only [Q, eval_rename] using hx.1
    · change (∑ a, (x (e a))^2) = 1
      rw [e.sum_comp (fun a => (x a)^2)]
      exact hx.2
  obtain ⟨x, hx, hp⟩ := hnonflat
  have hqn : ∃ y, (eval y Q = 0 ∧ (∑ a, (y a)^2) = 1) ∧ 0 < curvaturePotential Q y := by
    refine ⟨x ∘ e.symm, ⟨?_, ?_⟩, ?_⟩
    · simpa only [Q, eval_rename, Function.comp_assoc, e.symm_comp_self, Function.comp_id] using hx.1
    · change (∑ a, (x (e.symm a))^2) = 1
      rw [e.symm.sum_comp (fun a => (x a)^2)]
      exact hx.2
    · simpa only [Q, Source29CurvatureReindex.curvaturePotential_rename, Function.comp_assoc,
        e.symm_comp_self, Function.comp_id] using hp
  exact (Source29CompactLinkDegreeBound.degree_interval_ambient_eight Q d hQ hd hQL hqr hqn).2

end
end Source29FinEightDegreeBound

/- Component: QuadraticSignObstruction.inc -/
namespace Source29QuadraticSignObstruction

open MvPolynomial Source29FactorInheritance
open Source29QuarticReuse.QuarticMinimal Source29QuarticReuse.QuarticNormalization
open Source29QuarticReuse.QuarticPolynomialBasics (gradient_at_homogeneous_sphere_extremum)
open scoped BigOperators Matrix

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def hessianTrace (P : MvPolynomial ι ℝ) : ℝ := ∑ i, hessianCoeff P i i

theorem quadratic_trace_at_critical
    (P : MvPolynomial ι ℝ) (hP : P.IsHomogeneous 2) (hL : cubicOperator P = 0)
    (x : ι → ℝ) (hx : (∑ i, (x i)^2) = 1) (c : ℝ) (hc : c ≠ 0)
    (hgrad : ∀ i, eval x (pderiv i P) = c*x i) : hessianTrace P = c := by
  have hH : ∀ i j, eval x (pderiv i (pderiv j P)) = hessianCoeff P i j := by
    intro i j
    rw [second_partial_eq_C_of_totalDegree_le_two P hP.totalDegree_le, eval_C]
  have hMx : ∀ i, (∑ j, hessianCoeff P i j * x j) = c*x i := by
    intro i
    have he := eval_quadratic_gradient P hP.totalDegree_le x i
    have hz : (pderiv i P).coeff 0 = 0 :=
      (Source29QuarticReuse.QuarticCompatibility.homogeneous_pderiv (i := i) hP).coeff_eq_zero (by simp)
    rw [hz, add_zero, hgrad] at he
    exact he.symm
  have hfirst : (∑ i, (c*x i)^2) = c^2 := by
    simp only [mul_pow, ← Finset.mul_sum, hx, mul_one]
  have hsecond : (∑ i, ∑ j, (c*x i)*(c*x j)*hessianCoeff P i j) = c^3 := by
    calc
      _ = c^2 * (∑ i, x i * (∑ j, hessianCoeff P i j * x j)) := by
        simp only [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = c^3 := by
        simp only [hMx]
        have hs : (∑ i, x i * (c*x i)) = c := by
          calc
            _ = c * (∑ i, (x i)^2) := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro i _
              ring
            _ = c := by rw [hx, mul_one]
        rw [hs]
        ring
  have he := congrArg (eval x) hL
  simp only [cubicOperator, map_sub, map_mul, map_pow, map_sum, map_zero, hgrad, hH,
    hfirst, hsecond] at he
  have hz : c^2 * (hessianTrace P-c) = 0 := by
    change c^2 * (∑ i, hessianCoeff P i i) - c^3 = 0 at he
    dsimp [hessianTrace]
    nlinarith [he]
  exact sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left (pow_ne_zero 2 hc))

theorem positive_trace_of_positive_value
    (P : MvPolynomial ι ℝ) (hP : P.IsHomogeneous 2) (hL : cubicOperator P = 0)
    (hpos : ∃ x, 0 < eval x P) : 0 < hessianTrace P := by
  obtain ⟨x, hx⟩ := hpos
  obtain ⟨y, hy, hpy⟩ := exists_positive_sphere_value P 1 hP x hx
  obtain ⟨a, ha, hpa, hmax⟩ := exists_positive_sphere_maximum P y hy hpy
  have hgrad := gradient_at_homogeneous_sphere_extremum P 2 hP a ha hmax
  have he := quadratic_trace_at_critical P hP hL a ha (2*eval a P) (by positivity) (by simpa using hgrad)
  rw [he]
  positivity

theorem cubicOperator_neg (P : MvPolynomial ι ℝ) : cubicOperator (-P) = -cubicOperator P := by
  simp only [cubicOperator, map_neg, neg_sq, neg_mul_neg, mul_neg, Finset.sum_neg_distrib]
  ring

theorem no_sign_changing_quadratic
    (P : MvPolynomial ι ℝ) (hP : P.IsHomogeneous 2) (hL : cubicOperator P = 0)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0) : False := by
  have hp := positive_trace_of_positive_value P hP hL hpos
  have hn := positive_trace_of_positive_value (-P) hP.neg
    (by rw [cubicOperator_neg, hL, neg_zero]) (by
      obtain ⟨x, hx⟩ := hneg
      exact ⟨x, by simpa only [map_neg, neg_pos] using hx⟩)
  have he : hessianTrace (-P) = -hessianTrace P := by
    simp [hessianTrace, hessianCoeff]
  rw [he] at hn
  linarith

end
end Source29QuadraticSignObstruction

/- Component: RegularFactorObstruction.inc -/
namespace Source29RegularFactorObstruction

open MvPolynomial Source29FactorInheritance Source29PolynomialCurvaturePotential
open Source29CurvaturePotentialAlgebra Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem curvaturePotential_zero_of_affine (P : MvPolynomial ι ℝ)
    (hP : P.totalDegree ≤ 1) (x : ι → ℝ) : curvaturePotential P x = 0 := by
  have hH : realHessian P x = 0 := by
    ext i j
    simp only [realHessian_apply, Source29QuarticReuse.QuarticPolynomialBasics.second_partials_zero_of_totalDegree_le_one P hP i j, map_zero, Matrix.zero_apply]
  simp [curvaturePotential, hH, potential, matrixSq, vectorSq, Matrix.mulVec, dotProduct]

/-- All degrees are excluded for an irreducible sign-changing factor once
its whole link is regular and has positive curvature somewhere. -/
theorem no_regular_nonflat_sign_changing_factor
    (P : MvPolynomial (Fin 8) ℝ) (hirr : Irreducible P)
    (hP : P.IsHomogeneous P.totalDegree) (hL : cubicOperator P = 0)
    (hpos : ∃ x, 0 < eval x P) (hneg : ∃ x, eval x P < 0)
    (hregular : ∀ x, eval x P = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt P x ≠ 0)
    (hnonflat : ∃ x, (eval x P = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential P x) : False := by
  have hd2 : 2 ≤ P.totalDegree := by
    by_contra hh
    have hd : P.totalDegree ≤ 1 := by omega
    obtain ⟨x, hx, hp⟩ := hnonflat
    rw [curvaturePotential_zero_of_affine P hd x] at hp
    exact (lt_irrefl 0) hp
  have hd3 : 3 ≤ P.totalDegree := by
    by_contra hh
    have hd : P.totalDegree = 2 := by omega
    exact Source29QuadraticSignObstruction.no_sign_changing_quadratic P (hd ▸ hP) hL hpos hneg
  have hd4 := Source29FinEightDegreeBound.regular_nonflat_degree_le_four
    P P.totalDegree hP hd3 hL hregular hnonflat
  exact Source29LowDegreeEndpoints.no_irreducible_sign_changing_degree_three_or_four
    P hirr hP hL hd3 hd4 hpos hneg

end
end Source29RegularFactorObstruction

/- Component: RegularStructureReduction.inc -/
namespace Source29RegularStructureReduction

open MvPolynomial Source29Closing Source29PolynomialCurvaturePotential
open scoped BigOperators

noncomputable section

/-- Remaining structural input from the full minimal equation. The degree
estimate and all local differential identities are consequences, not inputs. -/
def RegularLeadingFactorData8 (P : Polynomial8) : Prop :=
  ∃ (p Q : Polynomial8) (k : ℕ),
    1 ≤ k ∧ Irreducible p ∧ p.IsHomogeneous p.totalDegree ∧
    Q.IsHomogeneous Q.totalDegree ∧
    homogeneousComponent P.totalDegree P = p^k*Q ∧
    PositiveAwayFromZero Q ∧
    (∃ x, 0 < eval x p) ∧ (∃ x, eval x p < 0) ∧
    (∀ x, eval x p = 0 ∧ (∑ a, (x a)^2) = 1 → gradientAt p x ≠ 0) ∧
    (∃ x, (eval x p = 0 ∧ (∑ a, (x a)^2) = 1) ∧ 0 < curvaturePotential p x)

/-- Exact Problem29 follows once the explicitly listed structural data are
derived from the full equation. This is a conditional reduction, not target. -/
theorem problem29_of_regular_leading_factor
    (hstructure : ∀ P : Polynomial8,
      Math30.MinimalGraphs.SatisfiesMinimalGraphEquation P →
      2 ≤ P.totalDegree → RegularLeadingFactorData8 P) : Math30.Problem29 := by
  intro P hminimal
  change P.totalDegree ≤ 1
  by_contra hnonaffine
  have hdegree : 2 ≤ P.totalDegree := by omega
  obtain ⟨p, Q, k, hk, hp, hphom, hQhom, hfactor, hQpos, hpos, hneg, hregular, hnonflat⟩ :=
    hstructure P hminimal hdegree
  obtain ⟨hne, hhom, hL⟩ := QuarticPolynomialBasics.leading_component_data P hminimal hdegree
  have hQdiv : Q ∣ homogeneousComponent P.totalDegree P :=
    ⟨p^k, hfactor.trans (mul_comm _ _)⟩
  have hQdegree := Source29ComplexObstruction.positive_divisor_obstruction
    (homogeneousComponent P.totalDegree P) Q P.totalDegree hne hhom hL hQhom hQpos hQdiv
  have hQconst : Q = C (Q.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hQdegree
  have hQne : Q ≠ 0 := by
    intro hQzero
    apply hne
    rw [hfactor, hQzero, mul_zero]
  have ha : Q.coeff 0 ≠ 0 := by
    intro hz
    apply hQne
    exact hQconst.trans (by simp only [hz, map_zero])
  have hpL : Source29FactorInheritance.cubicOperator p = 0 := by
    apply Source29PowerOperator.cubicOperator_pow_mul_C_zero_imp p hp.ne_zero k (by omega)
      (Q.coeff 0) ha
    change QuarticPolynomialBasics.cubicOperator (p^k*C (Q.coeff 0)) = 0
    rw [← hQconst, ← hfactor]
    exact hL
  exact Source29RegularFactorObstruction.no_regular_nonflat_sign_changing_factor
    p hp hphom hpL hpos hneg hregular hnonflat

end
end Source29RegularStructureReduction

/- Component: CurvatureProjection.inc -/
namespace Source29CurvatureProjection

open Source29CurvaturePotentialAlgebra
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def pair (A B : Matrix κ κ ℝ) : ℝ := ∑ i, ∑ j, A i j * B i j

def outer (u v : κ → ℝ) : Matrix κ κ ℝ := fun i j => u i * v j

theorem pair_comm (A B : Matrix κ κ ℝ) : pair A B = pair B A := by
  simp only [pair, mul_comm]

theorem pair_add_left (A B C : Matrix κ κ ℝ) :
    pair (A + B) C = pair A C + pair B C := by
  simp [pair, add_mul, Finset.sum_add_distrib]

theorem pair_sub_left (A B C : Matrix κ κ ℝ) :
    pair (A - B) C = pair A C - pair B C := by
  simp [pair, sub_mul, Finset.sum_sub_distrib]

theorem pair_smul_left (a : ℝ) (A B : Matrix κ κ ℝ) :
    pair (a • A) B = a * pair A B := by
  simp [pair, mul_assoc, Finset.mul_sum]

theorem pair_add_right (A B C : Matrix κ κ ℝ) :
    pair A (B + C) = pair A B + pair A C := by
  rw [pair_comm, pair_add_left, pair_comm B A, pair_comm C A]

theorem pair_sub_right (A B C : Matrix κ κ ℝ) :
    pair A (B - C) = pair A B - pair A C := by
  rw [pair_comm, pair_sub_left, pair_comm B A, pair_comm C A]

theorem pair_smul_right (a : ℝ) (A B : Matrix κ κ ℝ) :
    pair A (a • B) = a * pair A B := by
  rw [pair_comm, pair_smul_left, pair_comm B A]

theorem pair_outer (A : Matrix κ κ ℝ) (u v : κ → ℝ) :
    pair A (outer u v) = u ⬝ᵥ (A *ᵥ v) := by
  simp only [pair, outer, dotProduct, Matrix.mulVec, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem pair_outer_outer (u v w z : κ → ℝ) :
    pair (outer u v) (outer w z) = (u ⬝ᵥ w) * (v ⬝ᵥ z) := by
  simp only [pair, outer, dotProduct, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem dot_mulVec_symm (H : Matrix κ κ ℝ) (hH : ∀ i j, H i j = H j i)
    (u v : κ → ℝ) : u ⬝ᵥ (H *ᵥ v) = v ⬝ᵥ (H *ᵥ u) := by
  simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [hH j i]
  ring

def tangentHessian (v : κ → ℝ) (H : Matrix κ κ ℝ) : Matrix κ κ ℝ :=
  H - (vectorSq v)⁻¹ • outer v (H *ᵥ v) -
    (vectorSq v)⁻¹ • outer (H *ᵥ v) v +
    ((v ⬝ᵥ (H *ᵥ v)) / (vectorSq v)^2) • outer v v

theorem matrixSq_tangentHessian (v : κ → ℝ) (H : Matrix κ κ ℝ)
    (hH : ∀ i j, H i j = H j i) (hv : vectorSq v ≠ 0) :
    matrixSq (tangentHessian v H) = vectorSq v * potential v H := by
  have hsq (A : Matrix κ κ ℝ) : matrixSq A = pair A A := by
    simp only [matrixSq, pair, pow_two]
  rw [hsq]
  unfold tangentHessian
  simp only [pair_add_left, pair_sub_left, pair_smul_left,
    pair_add_right, pair_sub_right, pair_smul_right]
  simp only [pair_outer_outer]
  simp only [pair_comm (outer _ _) H, pair_outer]
  rw [dot_mulVec_symm H hH v (H *ᵥ v)]
  rw [dotProduct_comm (H *ᵥ v) v]
  rw [← hsq]
  unfold potential vectorSq at *
  field_simp
  <;> ring

theorem tangentHessian_zero_of_potential_zero (v : κ → ℝ) (H : Matrix κ κ ℝ)
    (hH : ∀ i j, H i j = H j i) (hv : vectorSq v ≠ 0)
    (hzero : potential v H = 0) : tangentHessian v H = 0 := by
  have hs := matrixSq_tangentHessian v H hH hv
  rw [hzero, mul_zero] at hs
  have hi (i : κ) : ∑ j, (tangentHessian v H i j)^2 = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun i _ =>
      Finset.sum_nonneg (fun j _ => sq_nonneg _))).mp hs i (Finset.mem_univ _)
  ext i j
  have hij := (Finset.sum_eq_zero_iff_of_nonneg
    (fun j _ => sq_nonneg (tangentHessian v H i j))).mp (hi i) j (Finset.mem_univ _)
  exact (sq_eq_zero_iff).mp hij

theorem vectorSq_pos (v : κ → ℝ) (hv : v ≠ 0) : 0 < vectorSq v := by
  have hn : 0 ≤ vectorSq v := by
    exact Finset.sum_nonneg (fun i _ => mul_self_nonneg (v i))
  exact lt_of_le_of_ne hn (Ne.symm (fun h => hv (dotProduct_self_eq_zero.mp h)))

theorem potential_nonneg (v : κ → ℝ) (H : Matrix κ κ ℝ)
    (hH : ∀ i j, H i j = H j i) (hv : v ≠ 0) : 0 ≤ potential v H := by
  have hs := vectorSq_pos v hv
  have he := matrixSq_tangentHessian v H hH hs.ne'
  have hn : 0 ≤ matrixSq (tangentHessian v H) :=
    Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => sq_nonneg _))
  rw [he] at hn
  exact nonneg_of_mul_nonneg_right hn hs

theorem tangent_contraction (v u w : κ → ℝ) (H : Matrix κ κ ℝ)
    (hu : u ⬝ᵥ v = 0) (hw : v ⬝ᵥ w = 0) :
    u ⬝ᵥ (tangentHessian v H *ᵥ w) = u ⬝ᵥ (H *ᵥ w) := by
  rw [← pair_outer, ← pair_outer]
  unfold tangentHessian
  simp only [pair_add_left, pair_sub_left, pair_smul_left, pair_outer_outer]
  rw [dotProduct_comm v u, hu, hw]
  simp

theorem tangent_contraction_zero (v u w : κ → ℝ) (H : Matrix κ κ ℝ)
    (hH : ∀ i j, H i j = H j i) (hv : v ≠ 0)
    (hzero : potential v H = 0) (hu : u ⬝ᵥ v = 0) (hw : v ⬝ᵥ w = 0) :
    u ⬝ᵥ (H *ᵥ w) = 0 := by
  rw [← tangent_contraction v u w H hu hw,
    tangentHessian_zero_of_potential_zero v H hH (vectorSq_pos v hv).ne' hzero]
  simp

theorem tangent_mulVec_parallel (v w : κ → ℝ) (H : Matrix κ κ ℝ)
    (hH : ∀ i j, H i j = H j i) (hv : v ≠ 0)
    (hzero : potential v H = 0) (hw : v ⬝ᵥ w = 0) :
    H *ᵥ w = fun i => (v ⬝ᵥ (H *ᵥ w)) / vectorSq v * v i := by
  have hs := (vectorSq_pos v hv).ne'
  funext i
  let u : κ → ℝ := Pi.single i 1 - (v i / vectorSq v) • v
  have hu : u ⬝ᵥ v = 0 := by
    simp only [u, sub_dotProduct, smul_dotProduct, single_dotProduct, one_mul,
      smul_eq_mul]
    change v i - (v i / vectorSq v) * vectorSq v = 0
    field_simp
    <;> ring
  have he := tangent_contraction_zero v u w H hH hv hzero hu hw
  simp only [u, sub_dotProduct, smul_dotProduct, single_dotProduct, one_mul,
    smul_eq_mul] at he
  calc
    _ = v i / vectorSq v * (v ⬝ᵥ (H *ᵥ w)) := sub_eq_zero.mp he
    _ = _ := by ring

end
end Source29CurvatureProjection

/- Component: LocalHyperplaneDivisor.inc -/
namespace Source29LocalHyperplaneDivisor

open MvPolynomial Filter
open scoped Topology

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem polynomial_eq_zero_of_locally_zero (P : MvPolynomial κ ℝ) (a : κ → ℝ)
    (hzero : ∀ᶠ y in 𝓝 a, eval y P = 0) : P = 0 := by
  have ha : AnalyticOnNhd ℝ (fun y => eval y P) Set.univ :=
    fun x _ => Source29PolynomialLinkChart.analyticAt_eval_real P x
  have hb : AnalyticOnNhd ℝ (fun _ : κ → ℝ => (0 : ℝ)) Set.univ :=
    fun _ _ => analyticAt_const
  have he := ha.eq_of_eventuallyEq hb hzero
  apply Source29QuarticReuse.QuarticCompatibility.polynomial_funext
  intro x
  simpa using congrFun he x

theorem X_dvd_of_locally_zero_on_hyperplane
    (P : MvPolynomial (Option κ) ℝ) (a : κ → ℝ)
    (hzero : ∀ᶠ y in 𝓝 a, eval (fun j => j.elim 0 y) P = 0) :
    X none ∣ P := by
  let e := optionEquivLeft ℝ κ
  have heval (y : κ → ℝ) :
      eval (fun j => j.elim 0 y) P = eval y ((e P).coeff 0) := by
    rw [optionEquivLeft_elim_eval]
    simp [e, ← Polynomial.coeff_zero_eq_eval_zero]
  have hc : (e P).coeff 0 = 0 :=
    polynomial_eq_zero_of_locally_zero _ a (hzero.mono (fun y hy => by
      rwa [heval] at hy))
  obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr hc
  refine ⟨e.symm Q, ?_⟩
  apply e.injective
  simpa [e] using hQ

theorem degree_le_one_of_irreducible_locally_zero_on_hyperplane
    (P : MvPolynomial (Option κ) ℝ) (hP : Irreducible P) (a : κ → ℝ)
    (hzero : ∀ᶠ y in 𝓝 a, eval (fun j => j.elim 0 y) P = 0) :
    P.totalDegree ≤ 1 := by
  have hd := X_dvd_of_locally_zero_on_hyperplane P a hzero
  have hpX : P ∣ X (none : Option κ) :=
    ((X_prime (R := ℝ) (i := (none : Option κ))).irreducible.associated_of_dvd hP hd).symm.dvd
  have hle := totalDegree_le_of_dvd_of_isDomain hpX (X_ne_zero (s := (none : Option κ)))
  simpa using hle

end
end Source29LocalHyperplaneDivisor

/- Component: FlatPolynomialCurve.inc -/
namespace Source29FlatPolynomialCurve

open MvPolynomial Filter
open Source29RealPolynomialCurveJets Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open Source29CurvatureProjection
open scoped Topology BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem second_deriv_eval_curve_at (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ)
    (s : ℝ) (hγ : ∀ j, AnalyticAt ℝ (γ j) s) :
    deriv (deriv (fun t => eval (fun j => γ j t) P)) s =
      (∑ j, ∑ k, eval (fun a => γ a s) (pderiv k (pderiv j P)) *
        deriv (γ k) s * deriv (γ j) s) +
      ∑ j, eval (fun a => γ a s) (pderiv j P) * deriv (deriv (γ j)) s := by
  have he : deriv (fun t => eval (fun j => γ j t) P) =ᶠ[𝓝 s]
      (fun t => ∑ j, eval (fun k => γ k t) (pderiv j P) * deriv (γ j) t) := by
    have hn := Filter.eventually_all.mpr (fun j => (hγ j).eventually_analyticAt)
    filter_upwards [hn] with t ht
    exact first_deriv_eval_curve P γ t ht
  rw [he.deriv_eq]
  have hd := (HasDerivAt.fun_sum (fun j (_ : j ∈ Finset.univ) =>
    ((analytic_eval_curve (pderiv j P) γ s hγ).differentiableAt.hasDerivAt.mul
      (hγ j).deriv.differentiableAt.hasDerivAt))).deriv
  simp only [Pi.mul_apply] at hd
  rw [hd]
  simp only [first_deriv_eval_curve _ γ s hγ, Finset.sum_add_distrib, Finset.sum_mul]

theorem gradient_dot_acceleration_zero
    (P : MvPolynomial κ ℝ) (γ : κ → ℝ → ℝ) (s : ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) s)
    (hzero : ∀ᶠ t in 𝓝 s, eval (fun j => γ j t) P = 0)
    (hreg : gradientAt P (fun j => γ j s) ≠ 0)
    (hflat : curvaturePotential P (fun j => γ j s) = 0) :
    ∑ j, eval (fun a => γ a s) (pderiv j P) * deriv (deriv (γ j)) s = 0 := by
  change (fun t => eval (fun j => γ j t) P) =ᶠ[𝓝 s] (fun _ => 0) at hzero
  let x : κ → ℝ := fun j => γ j s
  let v : κ → ℝ := fun j => deriv (γ j) s
  have hfirst : gradientAt P x ⬝ᵥ v = 0 := by
    have he := first_deriv_eval_curve P γ s hγ
    rw [hzero.deriv_eq, deriv_const] at he
    exact he.symm
  have hH : ∀ i j, realHessian P x i j = realHessian P x j i := by
    intro i j
    simp only [realHessian_apply]
    rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
  have ht := tangent_contraction_zero (gradientAt P x) v v (realHessian P x)
    hH hreg hflat (by rwa [dotProduct_comm]) hfirst
  have hquadratic : (∑ j, ∑ k, eval x (pderiv k (pderiv j P)) * v k * v j) = 0 := by
    convert ht using 1
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum, realHessian_apply]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm P i j]
    ring
  have he := second_deriv_eval_curve_at P γ s hγ
  rw [hzero.deriv.deriv_eq] at he
  simp only [deriv_const'] at he
  change 0 = (∑ j, ∑ k, eval x (pderiv k (pderiv j P)) * v k * v j) + _ at he
  rw [hquadratic, zero_add] at he
  exact he.symm

theorem graph_normal_acceleration_zero
    (P : MvPolynomial (Option κ) ℝ) (γ : Option κ → ℝ → ℝ) (s : ℝ)
    (hγ : ∀ j, AnalyticAt ℝ (γ j) s)
    (hzero : ∀ᶠ t in 𝓝 s, eval (fun j => γ j t) P = 0)
    (hreg : eval (fun j => γ j s) (pderiv none P) ≠ 0)
    (hflat : curvaturePotential P (fun j => γ j s) = 0)
    (hlinear : ∀ i, deriv (deriv (γ (some i))) s = 0) :
    deriv (deriv (γ none)) s = 0 := by
  have hg : gradientAt P (fun j => γ j s) ≠ 0 := by
    intro hz
    exact hreg (congrFun hz none)
  have he := gradient_dot_acceleration_zero P γ s hγ hzero hg hflat
  simp only [Fintype.sum_option, hlinear, mul_zero, Finset.sum_const_zero, add_zero] at he
  exact (mul_eq_zero.mp he).resolve_left hreg

end
end Source29FlatPolynomialCurve

/- Component: PolynomialHypersurfaceChart.inc -/
namespace Source29PolynomialHypersurfaceChart

open MvPolynomial Filter Source29PolynomialLinkChart
open Source29QuarticReuse.QuarticPolynomialBasics
open scoped Topology BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

def coordinatePolynomial (P : MvPolynomial (Option κ) ℝ) :
    Option κ → MvPolynomial (Option κ) ℝ
  | none => P
  | some i => X (some i)

def coordinateMap (P : MvPolynomial (Option κ) ℝ) (x : Option κ → ℝ) : Option κ → ℝ :=
  fun j => eval x (coordinatePolynomial P j)

def zeroEmbed (y : κ → ℝ) : Option κ → ℝ := fun j => j.elim 0 y

theorem zeroEmbed_analytic (y : κ → ℝ) : AnalyticAt ℝ zeroEmbed y := by
  apply AnalyticAt.pi
  intro j
  cases j with
  | none => exact analyticAt_const
  | some j => exact (ContinuousLinearMap.proj j : (κ → ℝ) →L[ℝ] ℝ).analyticAt y

theorem exists_hypersurface_chart (P : MvPolynomial (Option κ) ℝ)
    (a : Option κ → ℝ) (g : ℝ) (hg : g ≠ 0) (hP : eval a P = 0)
    (hgn : eval a (pderiv none P) = g)
    (hgt : ∀ j, eval a (pderiv (some j) P) = 0) :
    ∃ φ : (κ → ℝ) → (Option κ → ℝ),
      AnalyticAt ℝ φ (fun j => a (some j)) ∧
      φ (fun j => a (some j)) = a ∧
      ∀ᶠ y in 𝓝 (fun j => a (some j)),
        eval (φ y) P = 0 ∧ ∀ j, φ y (some j) = y j := by
  let scale : Option κ → ℝ := fun j => j.elim g (fun _ => 1)
  have hscale : ∀ j, scale j ≠ 0 := by
    intro j
    cases j with
    | none => exact hg
    | some j => exact one_ne_zero
  let e := diagonalEquiv scale hscale
  have ha : AnalyticAt ℝ (coordinateMap P) a :=
    AnalyticAt.pi (fun j => analyticAt_eval_real (coordinatePolynomial P j) a)
  have hd : HasStrictFDerivAt (coordinateMap P) (e : _ →L[ℝ] _) a := by
    apply hasStrictFDerivAt_pi'.mpr
    intro j
    change HasStrictFDerivAt (fun z => eval z (coordinatePolynomial P j)) _ _
    convert hasStrictFDerivAt_eval (coordinatePolynomial P j) a using 1
    ext v
    change e v j = evalFDeriv (coordinatePolynomial P j) a v
    rw [diagonalEquiv_apply]
    cases j with
    | none => simp [coordinatePolynomial, evalFDeriv_apply, Fintype.sum_option, hgn, hgt, scale]
    | some j => simp [coordinatePolynomial, evalFDeriv_X, scale]
  obtain ⟨u, hu, hua, hnear⟩ :=
    Source29RealAnalyticInverse.exists_analytic_local_inverse (coordinateMap P) a e ha hd
  have hbase : coordinateMap P a = zeroEmbed (fun j => a (some j)) := by
    ext j
    cases j with
    | none => exact hP
    | some j => simp [coordinateMap, coordinatePolynomial, zeroEmbed]
  rw [hbase] at hu hua hnear
  refine ⟨fun y => u (zeroEmbed y), hu.comp (zeroEmbed_analytic _), hua, ?_⟩
  have hn := (zeroEmbed_analytic (fun j => a (some j))).continuousAt.tendsto.eventually hnear
  filter_upwards [hn] with y hy
  refine ⟨congrFun hy none, ?_⟩
  intro j
  simpa [coordinateMap, coordinatePolynomial, zeroEmbed] using congrFun hy (some j)

end
end Source29PolynomialHypersurfaceChart

/- Component: AnalyticLocalConstancy.inc -/
namespace Source29AnalyticLocalConstancy

open Filter
open scoped Topology

noncomputable section

theorem eventually_eq_of_deriv_zero (f : ℝ → ℝ) (a : ℝ)
    (hf : AnalyticAt ℝ f a) (hd : ∀ᶠ t in 𝓝 a, deriv f t = 0) :
    f =ᶠ[𝓝 a] (fun _ => f a) := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp (hf.eventually_analyticAt.and hd)
  have ha : a ∈ Metric.ball a r := Metric.mem_ball_self hr
  filter_upwards [Metric.ball_mem_nhds a hr] with t ht
  exact Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball a r).isPreconnected
    (fun z hz => (hball hz).1.differentiableAt.differentiableWithinAt)
    (fun z hz => (hball hz).2) ht ha

theorem eventually_eq_of_second_deriv_zero (f : ℝ → ℝ) (a : ℝ)
    (hf : AnalyticAt ℝ f a) (hd : deriv f a = 0)
    (hdd : ∀ᶠ t in 𝓝 a, deriv (deriv f) t = 0) :
    f =ᶠ[𝓝 a] (fun _ => f a) := by
  have hfirst := eventually_eq_of_deriv_zero (deriv f) a hf.deriv hdd
  simp only [hd] at hfirst
  exact eventually_eq_of_deriv_zero f a hf hfirst

end
end Source29AnalyticLocalConstancy

/- Component: LocalFlatPolynomial.inc -/
namespace Source29LocalFlatPolynomial

open MvPolynomial Filter Source29PolynomialCurvaturePotential
open Source29PolynomialHypersurfaceChart
open scoped Topology BigOperators

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem degree_le_one_of_flat_near_normalized_zero
    (P : MvPolynomial (Option κ) ℝ) (hP : Irreducible P)
    (a : Option κ → ℝ) (ha : a none = 0) (hzero : eval a P = 0)
    (g : ℝ) (hg : g ≠ 0) (hgn : eval a (pderiv none P) = g)
    (hgt : ∀ j, eval a (pderiv (some j) P) = 0)
    (hflat : ∀ᶠ x in 𝓝 a, eval x P = 0 → curvaturePotential P x = 0) :
    P.totalDegree ≤ 1 := by
  obtain ⟨φ, hφ, hφ0, hchart⟩ :=
    exists_hypersurface_chart P a g hg hzero hgn hgt
  have hhyper : ∀ y : κ → ℝ, eval (zeroEmbed y) P = 0 := by
    intro y
    let b : κ → ℝ := fun j => a (some j)
    let line : ℝ → (κ → ℝ) := fun t j => b j + t * (y j - b j)
    have hline (t : ℝ) : AnalyticAt ℝ line t := by
      apply AnalyticAt.pi
      intro j
      exact analyticAt_const.add (analyticAt_id.mul analyticAt_const)
    let Γ : ℝ → (Option κ → ℝ) := fun t => φ (line t)
    let γ : Option κ → ℝ → ℝ := fun j t => Γ t j
    have hΓ : AnalyticAt ℝ Γ 0 := by
      have hp : AnalyticAt ℝ φ (line 0) := by simpa [line, b] using hφ
      exact hp.comp (hline 0)
    have hΓ0 : Γ 0 = a := by simpa [Γ, line, b] using hφ0
    have hγ : ∀ j, AnalyticAt ℝ (γ j) 0 := by
      intro j
      exact (ContinuousLinearMap.proj j : (Option κ → ℝ) →L[ℝ] ℝ).analyticAt _ |>.comp hΓ
    have hc : ∀ᶠ t in 𝓝 (0 : ℝ),
        eval (Γ t) P = 0 ∧ ∀ j, Γ t (some j) = line t j := by
      have hl : Tendsto line (𝓝 0) (𝓝 b) := by
        simpa [line] using (hline 0).continuousAt.tendsto
      exact hl.eventually hchart
    have hz : (fun t => eval (Γ t) P) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0) := hc.mono (fun _ h => h.1)
    have hflatΓ : ∀ᶠ t in 𝓝 (0 : ℝ), curvaturePotential P (Γ t) = 0 := by
      have hlim : Tendsto Γ (𝓝 0) (𝓝 a) := by
        simpa only [hΓ0] using hΓ.continuousAt.tendsto
      filter_upwards [hlim.eventually hflat, hc] with t ht he
      exact ht he.1
    have hregΓ : ∀ᶠ t in 𝓝 (0 : ℝ), eval (Γ t) (pderiv none P) ≠ 0 := by
      have hp := (Source29PolynomialLinkChart.analyticAt_eval_real (pderiv none P) (Γ 0)).comp hΓ
      apply hp.continuousAt.eventually_ne
      simpa only [Function.comp_def, hΓ0, hgn] using hg
    have hlin : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ j, deriv (deriv (γ (some j))) t = 0 := by
      apply Filter.eventually_all.mpr
      intro j
      have he : γ (some j) =ᶠ[𝓝 (0 : ℝ)] (fun t => line t j) := hc.mono (fun t ht => ht.2 j)
      have hd : deriv (fun t => line t j) = fun _ => y j - b j := by
        funext t
        simpa only [line, id_eq, one_mul] using
          (((hasDerivAt_id t).mul_const (y j - b j)).const_add (b j)).deriv
      filter_upwards [he.deriv.deriv] with t ht
      rw [ht, hd]
      simp
    have hsecond : ∀ᶠ t in 𝓝 (0 : ℝ), deriv (deriv (γ none)) t = 0 := by
      filter_upwards [Filter.eventually_all.mpr (fun j => (hγ j).eventually_analyticAt),
        hz.eventually_nhds, hflatΓ, hregΓ, hlin] with t ht hz' hf hr hl
      exact Source29FlatPolynomialCurve.graph_normal_acceleration_zero P γ t ht hz' hr hf hl
    have hfirst : deriv (γ none) 0 = 0 := by
      have he := Source29RealPolynomialCurveJets.first_deriv_eval_curve P γ 0 hγ
      have hpoint : (fun j => γ j 0) = a := hΓ0
      change deriv (fun t => eval (Γ t) P) 0 = _ at he
      rw [hz.deriv_eq, deriv_const, hpoint] at he
      simp only [Fintype.sum_option, hgn, hgt, zero_mul, Finset.sum_const_zero, add_zero] at he
      exact (mul_eq_zero.mp he.symm).resolve_left hg
    have hnormal := Source29AnalyticLocalConstancy.eventually_eq_of_second_deriv_zero
      (γ none) 0 (hγ none) hfirst hsecond
    have hn0 : γ none 0 = 0 := (congrFun hΓ0 none).trans ha
    have heq : Γ =ᶠ[𝓝 (0 : ℝ)] (fun t => zeroEmbed (line t)) := by
      filter_upwards [hnormal, hc] with t ht hc'
      funext j
      cases j with
      | none => exact ht.trans hn0
      | some j => exact hc'.2 j
    have hzline : (fun t => eval (zeroEmbed (line t)) P) =ᶠ[𝓝 (0 : ℝ)] (fun _ => 0) := by
      filter_upwards [heq, hz] with t ht hz'
      rw [← ht]
      exact hz'
    have han : AnalyticOnNhd ℝ (fun t => eval (zeroEmbed (line t)) P) Set.univ := by
      intro t _
      exact (Source29PolynomialLinkChart.analyticAt_eval_real P _).comp
        ((zeroEmbed_analytic _).comp (hline t))
    have hevery := han.eq_of_eventuallyEq (fun _ _ => analyticAt_const) hzline
    simpa [line] using congrFun hevery 1
  exact Source29LocalHyperplaneDivisor.degree_le_one_of_irreducible_locally_zero_on_hyperplane
    P hP (fun j => a (some j)) (Filter.Eventually.of_forall hhyper)

theorem exists_positive_curvature_in_nhds
    (P : MvPolynomial (Option κ) ℝ) (hP : Irreducible P) (hdeg : 2 ≤ P.totalDegree)
    (a : Option κ → ℝ) (ha : a none = 0) (hzero : eval a P = 0)
    (g : ℝ) (hg : g ≠ 0) (hgn : eval a (pderiv none P) = g)
    (hgt : ∀ j, eval a (pderiv (some j) P) = 0)
    (S : Set (Option κ → ℝ)) (hS : S ∈ 𝓝 a) :
    ∃ x ∈ S, eval x P = 0 ∧ gradientAt P x ≠ 0 ∧ 0 < curvaturePotential P x := by
  by_contra h
  push_neg at h
  have hreg : ∀ᶠ x in 𝓝 a, eval x (pderiv none P) ≠ 0 :=
    (Source29PolynomialLinkChart.analyticAt_eval_real (pderiv none P) a).continuousAt.eventually_ne
      (by rwa [hgn])
  have hflat : ∀ᶠ x in 𝓝 a, eval x P = 0 → curvaturePotential P x = 0 := by
    filter_upwards [hS, hreg] with x hx hr
    intro hz
    have hr' : gradientAt P x ≠ 0 := by
      intro he
      exact hr (congrFun he none)
    have hn : 0 ≤ curvaturePotential P x := by
      apply Source29CurvatureProjection.potential_nonneg _ _ _ hr'
      intro i j
      simp only [Source29QuarticReuse.QuarticMinimal.AmbientQuartic.realHessian_apply]
      rw [Source29QuarticReuse.QuarticPolynomialBasics.second_partial_comm]
    exact le_antisymm (h x hx hz hr') hn
  have hle := degree_le_one_of_flat_near_normalized_zero P hP a ha hzero g hg hgn hgt hflat
  omega

end
end Source29LocalFlatPolynomial

/- Component: CurvatureScaling.inc -/
namespace Source29CurvatureScaling

open MvPolynomial Source29CurvaturePotentialAlgebra Source29PolynomialCurvaturePotential
open Source29QuarticReuse.QuarticCompatibility (homogeneous_pderiv)
open Source29QuarticReuse.QuarticNormalization (eval_scale_of_isHomogeneous)
open Source29QuarticReuse.QuarticMinimal.AmbientQuartic
open scoped BigOperators Matrix

noncomputable section

variable {κ : Type*} [Fintype κ] [DecidableEq κ]

theorem vectorSq_smul (a : ℝ) (v : κ → ℝ) : vectorSq (a • v) = a^2 * vectorSq v := by
  simp only [vectorSq, smul_dotProduct, dotProduct_smul, smul_eq_mul]
  ring

theorem potential_smul (a b : ℝ) (v : κ → ℝ) (H : Matrix κ κ ℝ)
    (ha : a ≠ 0) (hv : vectorSq v ≠ 0) :
    potential (a • v) (b • H) = (b/a)^2 * potential v H := by
  have hsq : matrixSq (b • H) = b^2 * matrixSq H := by
    simp only [matrixSq, Matrix.smul_apply, smul_eq_mul, mul_pow, Finset.mul_sum]
  have hmv : (b • H) *ᵥ (a • v) = (a*b) • (H *ᵥ v) := by
    simp only [Matrix.smul_mulVec, Matrix.mulVec_smul, smul_smul, mul_comm a b]
  have hdot : (a • v) ⬝ᵥ ((a*b) • (H *ᵥ v)) = a^2*b*(v ⬝ᵥ (H *ᵥ v)) := by
    simp only [smul_dotProduct, dotProduct_smul, smul_eq_mul]
    ring
  unfold potential
  rw [hsq, hmv, hdot, vectorSq_smul, vectorSq_smul]
  field_simp
  <;> ring

theorem gradientAt_scale (P : MvPolynomial κ ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (x : κ → ℝ) (r : ℝ) :
    gradientAt P (r • x) = r^(d-1) • gradientAt P x := by
  ext i
  exact eval_scale_of_isHomogeneous (pderiv i P) (d-1) (homogeneous_pderiv hP) x r

theorem realHessian_scale (P : MvPolynomial κ ℝ) (d : ℕ) (hP : P.IsHomogeneous d)
    (x : κ → ℝ) (r : ℝ) :
    realHessian P (r • x) = r^(d-2) • realHessian P x := by
  ext i j
  have hh := homogeneous_pderiv (i := i) (homogeneous_pderiv (i := j) hP)
  have he := eval_scale_of_isHomogeneous (pderiv i (pderiv j P)) (d-2)
    (by simpa only [Nat.sub_sub] using hh) x r
  exact he

theorem curvaturePotential_scale (P : MvPolynomial κ ℝ) (d : ℕ)
    (hP : P.IsHomogeneous d) (hd : 2 ≤ d) (x : κ → ℝ)
    (hx : gradientAt P x ≠ 0) (r : ℝ) (hr : r ≠ 0) :
    curvaturePotential P (r • x) = curvaturePotential P x / r^2 := by
  unfold curvaturePotential
  rw [gradientAt_scale P d hP, realHessian_scale P d hP,
    potential_smul _ _ _ _ (pow_ne_zero _ hr) (Source29CurvatureProjection.vectorSq_pos _ hx).ne']
  have he : r^(d-1) = r^(d-2)*r := by
    rw [← pow_succ]
    congr 1
    omega
  rw [he]
  field_simp

end
end Source29CurvatureScaling

/- Component: PolynomialLinkNonflatness.inc -/
namespace Source29PolynomialLinkNonflatness

open MvPolynomial Source29PolynomialCurvaturePotential Source29PolynomialLinkChart
open Source29QuarticReuse.QuarticMinimal
