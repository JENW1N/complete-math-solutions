variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem secondForm_trace_with_frameLaplacian
    (f : Ambient ι → ℝ) (D g : ℝ) (hg : 0 < g)
    (U : Set (Ambient ι)) (hU : IsOpen U) (hx : base ∈ U)
    (hcone : ∀ x ∈ U, ∀ t : ℝ, 0 < t → t • x ∈ U)
    (hf : ∀ x ∈ U, AnalyticAt ℝ f x)
    (hhom : ∀ x ∈ U, ∀ t : ℝ, 0 < t → f (t • x) = t^D * f x)
    (hL : ∀ᶠ y in 𝓝 base, levelOperator f y = 0)
    (hgn : grad f base none = g)
    (hgt : ∀ j, grad f base (some j) = 0)
    (C : ι → ℝ → Ambient ι) (hC : ∀ i, AnalyticAt ℝ (C i) 0)
    (hC0 : ∀ i, C i 0 = base)
    (hmem : ∀ i, ∀ᶠ t in 𝓝 (0 : ℝ), f (C i t) = 0 ∧ (∑ a, (C i t a)^2) = 1)
    (hC1 : ∀ i a, deriv (fun t => C i t a) 0 = Pi.single (M := fun _ => ℝ) (tangent i) 1 a)
    (hC2 : ∀ i a, acceleration (C i) a = -base a - A f g i i * Pi.single (M := fun _ => ℝ) none 1 a)
    (K : ℝ)
    (hJac : (∑ i, deriv (deriv (fun t => profile f (C i t))) 0) +
      (K+(D-1)*(D-(Fintype.card ι : ℝ)))*g⁻¹ = 0)
    (a b : ι) :
    (∑ i, deriv (deriv (tangentSecondForm f (C i) a b)) 0) =
      ((Fintype.card ι : ℝ)+2-K)*A f g a b + 2*matrixCube (A f g) b a +
      (∑ l, frameLaplacian f C a l * A f g l b) +
      (∑ l, frameLaplacian f C b l * A f g l a) := by
  obtain ⟨hrad,hthird,hfourth⟩ :=
    Source29AnalyticHomogeneousSimonsTensor.radial_coordinate_jets f D U hU hx hcone hf hhom
  have hG : ∀ j k, (∑ i, ∑ l, acceleration (tangentFrame f (C i) j) (tangent l) * A f g l k) =
      ∑ l, frameLaplacian f C j l * A f g l k := by
    intro j k
    rw [Finset.sum_comm]
    simp only [frameLaplacian, Finset.sum_mul]
  have hN : ∀ j, (∑ i, acceleration (tangentFrame f (C i) j) none) = 0 := fun j =>
    Source29AnalyticFrameNormalAcceleration.tangentFrame_normal_acceleration_trace
      f D g hg U hU hx hcone hf hhom hL hgn hgt C hC hC0 hmem hC1 hC2 j
  have hsq : (∑ i, A f g i a * A f g i b) = matrixSquare (A f g) a b := by
    unfold matrixSquare
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm f g (hf base hx) i a]
  have hab := A_symm f g (hf base hx) b a
  have hwa : (∑ i, w f g i * A f g i a) = ∑ i, A f g a i * w f g i := by
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm f g (hf base hx) i a]
    ring
  have hwb : (∑ i, w f g i * A f g i b) = ∑ i, A f g b i * w f g i := by
    apply Finset.sum_congr rfl
    intro i _
    rw [A_symm f g (hf base hx) i b]
    ring
  simp_rw [Source29AnalyticMovingSecondForm.secondForm_second_deriv f D g hg U hU hx hf hhom hrad hthird hgn hgt
    (C _) (hC _) (hC0 _) (hmem _) _ a b (hC1 _)]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, hG,
    ← Finset.sum_mul, hN, zero_mul, add_zero]
  rw [Source29AnalyticNormalizedHessianTrace.normalizedHessian_second_trace_reduced f D g hg
    (hf base hx) hL hgn hgt hrad hthird hfourth C hC hC0 hC1 hC2 K ((D-1)*(D-(Fintype.card ι : ℝ))) hJac]
  simp only [mul_add, mul_assoc, Finset.sum_add_distrib, ← Finset.mul_sum,
    ite_mul, zero_mul, mul_ite, mul_one, hsq]
  ring_nf
  simp only [Finset.sum_ite_eq', Finset.mem_univ, ite_true, mul_assoc,
    ← Finset.mul_sum, hwa, hwb, hab]
  ring

end
end Source29AnalyticMovingSecondFormTrace

