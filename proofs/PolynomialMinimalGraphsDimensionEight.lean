      (C i) (hC i) (hC0 i) (hmem i) j.1 j.2
  have hAA0 : ∀ i j, AA i j 0 = A0 j := by
    intro i j
    exact tangentSecondForm_zero f g hg hgn hgt (C i) (hC0 i) j.1 j.2
  have hnorm : tensorNorm A0 = Real.sqrt (normSq (A f g)) := by
    simp only [tensorNorm, A0, normSq, Fintype.sum_prod_type]
  have hs : (tensorNorm A0)^2 = normSq (A f g) := by
    rw [hnorm, Real.sq_sqrt hpos.le]
  have hp : 0 < tensorNorm A0 := by rw [hnorm]; exact Real.sqrt_pos.mpr hpos
  have hne : A0 ≠ 0 := by
    intro he
    simp only [he, tensorNorm, Pi.zero_apply, zero_pow (by decide : 2 ≠ 0),
      Finset.sum_const_zero, Real.sqrt_zero] at hp
    exact lt_irrefl _ hp
  have hh : ∀ i, AnalyticAt ℝ (movingCurvatureNorm f (C i)) 0 := by
    intro i
    apply tensorNorm_analyticAt (fun t j => AA i j t) 0 (hAA i)
    simpa only [hAA0] using hne
  have hcontract := Source29AnalyticMovingSecondFormContraction.actual_second_derivative_contraction
    f D g hg U hU hx hcone hf hhom hL hgn hgt C hC hC0 hmem hC1 hC2 hJac
  have he := Source29ContractedSimonsNorm.scalar_simons_for_analytic_components
    AA (fun i => movingCurvatureNorm f (C i)) A0 (tensorNorm A0) (Fintype.card ι : ℝ)
    hh hAA (fun i => congrArg tensorNorm (funext (hAA0 i))) hAA0 hp
    (tensorNorm_sq A0) (fun i => Eventually.of_forall (fun t => tensorNorm_sq (fun j => AA i j t)))
    (by simpa only [AA, A0, Fintype.sum_prod_type, hs] using hcontract)
  simpa only [hs, hnorm, Real.sq_sqrt hpos.le] using he

end
end Source29AnalyticScalarSimons

